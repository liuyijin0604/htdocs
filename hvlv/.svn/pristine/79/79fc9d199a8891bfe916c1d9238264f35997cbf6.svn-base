<?php

/**
 * This is the model class for table "manifest".
 *
 * The followings are the available columns in table 'manifest':
 * @property string $id
 * @property string $fwd_id
 * @property string $dpt_id
 * @property string $by_id
 * @property string $consol_id
 * @property integer $type
 * @property integer $status
 * @property string $created
 * @property string $ref
 * @property string $total
 * @property string $meta
 * @property string $bwf
 */
class Manifest extends CActiveRecord
{
	public static $states = array(
		10 => 'New',
        11 => 'PayWaiting', // not paid or client credit limit or terms not available
        12 => 'ConsolWaiting', // can be put into console
		20 => 'Consolidated',

        60 => 'Pending', // for gate pass only
        65 => 'Confirmed', // fot gate pass only

		80 => 'Error',
		100 => 'Deleted',
	);
	
	public static $types = array(
		10 => 'Import Lodgement',
		20 => 'Import Depot Receipt',
		30 => 'Courier Dispatch',
		32 => 'eParcel Lodgement',
		33 => 'eLMS Lodgement',
		40 => 'Pickup List',
		50 => 'Gate Pass',
		60 => 'Pallet List',
        70 => 'RTS Reshipping List',
        80 => 'RTS RTC List',
        110 => 'Export Lodgement',
        111 => 'Export Lodgement CloundChain',
        120 => 'Export Depot Receipt',
        130 => 'Export Air Freight',
        210 => 'Courier Lodgement',
        220 => 'Courier Depot Receipt',
        90 => 'Auspost Manifest Time',
        320 => '3rd party manifest',
        340 => 'Packages Data Import',
        360 => '3pl拆单分单导入',
        380 => 'AUK Barcodes Import',
        400 => 'AUK Manifest Template',
		420 => 'Cargo wise manifest',
		430 => 'FAK simple manifest',
	);

	protected static $subs = array(
		//10 => 'ImpLodgement',
		//110 => 'ExpLodgement',
		//120 => 'ExpReceipt',
		40 => 'PickupList',
		50 => 'GatePass',
	);

	public static $my_type = 0;
	
	public $file, $warns, $mtype, $convert_of, $fwd_name,$allshipments, $totalWeight,$totalCBM,$isArchive;

	public $_mkv = [];
	public $mdata = [];
	public $imCover = false;
	public $bagTagIdentify = false;
	public $noAddrVeri = false;

	public $nolog = false;
	public $custom_log_note = '';
	public $exclude_lines = [];
	public $pref = "";
	
	public function __construct($scenario='insert'){
		parent::__construct($scenario);
		if(static::$my_type > 0) $this->type = static::$my_type;
	}

	public function __get($name){
		if(isset($this->_mkv[$name])) return $this->_mkv[$name];
		return parent::__get($name);
	}

	public function __set($name, $value){
		if(isset($this->_mkv[$name])) return $this->_mkv[$name] = $value;
		return parent::__set($name, $value);
	}
	
	protected function instantiate($attr){
		$cls = isset(self::$subs[$attr['type']])? self::$subs[$attr['type']] : get_class($this);
		return new $cls(null);
	}

	public function defaultScope(){
		return empty(static::$my_type)? [] : ['condition' => $this->dbConnection->quoteColumnName($this->getTableAlias(false, false).'.type').'='.static::$my_type];
	}

	public function setAttributes($values,$safeOnly=true){
		foreach($values as $k=>$v){
			if(isset($this->_mkv[$k])){
				$this->_mkv[$k] = $v;
				unset($values[$k]);
			}
		}
		return parent::setAttributes($values,$safeOnly);
	}

	public function unsetAttributes($names = NULL){
		parent::unsetAttributes($names = NULL);
		if(static::$my_type > 0) $this->type = static::$my_type;
	}

	/**
	 * @return string the associated database table name
	 */
	public function tableName(){
		return 'manifest';
	}

    public function statusList(){
        $r = Manifest::$states;
        return $r;
    }

	/**
	 * @return array validation rules for model attributes.
	 */
	public function rules(){
		// NOTE: you should only define rules for those attributes that
		// will receive user inputs.
		return array(
			array('type', 'required'),
			array('fwd_id, by_id, dpt_id, consol_id, created, status, ref, total, meta, bwf', 'safe'),
			array('type, status', 'numerical', 'integerOnly'=>true),
            array('fwd_id, by_id, consol_id', 'length', 'max'=>11),
			array('file', 'validFile', 'on' => 'upload'),
            // The following rule is used by search().
            // @todo Please remove those attributes that should not be searched.
            array('id, fwd_id, by_id, consol_id, type, created, status, ref, total, meta, fwd_name, bwf, pref', 'safe', 'on'=>'search'),
		);
	}

	/**
	 * @return array relational rules.
	 */
	public function relations(){
		// NOTE: you may need to adjust the relation name and the related
		// class name for the relations automatically generated below.
		return array(
			'owner' => array(self::BELONGS_TO, 'Org', 'fwd_id'),
			'dpt' => array(self::BELONGS_TO, 'Org', 'dpt_id'),
			'creator' => array(self::BELONGS_TO, 'User', 'by_id'),
			'rfile' => array(self::HAS_ONE, 'FileRepo', 'fid', 'on'=>'rfile.type=10'),
			'man_shipments' => array(self::HAS_MANY, 'Shipment', 'man_id'),
			'rec_shipments' => array(self::HAS_MANY, 'Shipment', 'rec_id'),
			'lines' => array(self::HAS_MANY, 'ManiMap', 'mani_id'),
			'invoice' => array(self::HAS_ONE, 'Invoice', 'man_id'),
			'consol' => array(self::BELONGS_TO, 'Consol', 'consol_id'),
		);
	}

	public function map($model){
		$attr = array(
			'mani_id' => $this->id,
			'model' => get_class($model),
			'fid' => $model->id,
		);
		$mm = ManiMap::model()->findByAttributes($attr);
		if(!$mm){
			$mm = new ManiMap;
			$mm->attributes = $attr;
			$mm->status = 10;
			$mm->save();
		}
		
		return $mm;
	}

	public function hasMap($model, $b=true){
		$attr = array(
			'mani_id' => $this->id,
			'model' => get_class($model),
			'fid' => $model->id,
		);
		return $b? (ManiMap::model()->countByAttributes($attr) > 0) : ManiMap::model()->findByAttributes($attr);
	}

	public function countLines(){
		$db = Yii::app()->db;
		$sql = 'SELECT COUNT(fid) AS t FROM mani_map WHERE mani_id = '.$this->id;
		$c = $db->createCommand($sql);
		return $c->queryScalar();
	}
	
	public function totPacks($wid = 0){
		return $this->totQuery('COUNT(s.pkg)', $wid);
	}
	
	public function totWeight($wid = 0){
		return $this->totQuery('SUM(s.weight)', $wid);
	}

	public function totExShipWeight($wid = 0){
		$w = 0;
		foreach($this->getFids() as $pid){
			$p = ExParcel::model()->findByPk($pid);
			$w += $p->shipWeight();
		}
		return $w;
	}
	
	public function totCBM($wid = 0){

        // for import manifest , if total cbm set by operator in China warehouse
        // we use setting directly
        if ( $this->type == 10 ) { // import lodgement
            if ( isset($this->mdata['cbm']) && $this->mdata['cbm'] > 0.0 )
            {
                $cbm = $this->mdata['cbm'];
            } else {
                $cbm = $this->totQuery('SUM(s.cbm)', $wid);
            }
        }  else {
            $cbm = $this->totQuery('SUM(s.cbm)', $wid);
        }

		return round($cbm * 1000) / 1000;
	}

	protected function totQuery($s, $wid = 0){
		// if($this->type == 30) return 0;
		$db = Yii::app()->db;
		if(in_array($this->type, [30, 40, 60])){
			$sql = 'SELECT '.$s.' AS t FROM shipment s INNER JOIN mani_map m ON s.id = m.fid WHERE s.status !=100 and m.mani_id = '.$this->id;
			if(!empty($wid)) $sql .= ' AND s.odpt_id = '.$wid;
		}else{
			$fid = in_array($this->type, [10,110,210])? 'man_id' : 'rec_id';
			$sql = 'SELECT '.$s.' AS t FROM shipment s WHERE s.status !=100 and '.$fid.' = '.$this->id;
			if(!empty($wid)) $sql .= ' AND s.odpt_id = '.$wid;
		}
		$c = $db->createCommand($sql);
		return $c->queryScalar();
	}

    /**
     * create total charge for all shipments
     * if testing all done, we should get rid of function : totCharge()
     * @return float|int|string
     */
    public function totChargePro(){
        if($this->type == 30) return 0;
        if(in_array($this->type, [10,210])){
            $rs = $this->man_shipments;
        }elseif(in_array($this->type, [20,220])){
            $rs = $this->rec_shipments;
        }
        $t = 0;
        $orgRate = OrgRate::model()->find('org_id = :oid AND type = 40', [':oid' => $this->owner->id]);
        foreach($rs as $r){
            $t += $r->getChargePro($this->owner,$orgRate,false);
        }
        return round($t*100)/100;
    }

	public function totCharge(){
		if($this->type == 30) return 0;
		if(in_array($this->type, [10,210])){
			$rs = $this->man_shipments;
		}elseif(in_array($this->type, [20,220])){
			$rs = $this->rec_shipments;
		}
		$t = 0;
		if ( empty($this->owner->extra['rate_base_1']) ) return 'No Rate!';

		foreach($rs as $r){
			$t += $r->getCharge($this->owner);
		}
		return round($t*100)/100;
	}
	
	public function getCurrency(){
		return empty($this->owner->extra['currency'])? '': Invoice::$currencies[$this->owner->extra['currency']];
	}
	
	public function getTotal($rs, $c){
		$t = 0;
        $currency = '';
		foreach ($rs as $r) {
			switch($c){
				case 'packs':
					$t += $r->totPacks();
				break;
				case 'weight':
					$t += $r->totWeight();
				break;
				case 'cbm':
					$t += $r->totCBM();
				break;
				case 'charge':
					$t += $r->totCharge();
				break;
                case 'chargepro':
                    $t += $r->totChargePro();
                    if ( empty($currency) )  $currency = $r->getCurrency();
                    break;
			}
		}

        if ( $c == 'chargepro' ) {
            return $currency . ' ' . AppHelper::money_format("%i", $t);
        } else {
            return $t;
        }
    }

    public function getDriver(){
    	if(!empty($this->by_id)){
    		return $this->creator->name;
    	}elseif(!empty($this->mdata['scanner'])){
    		$sc = Scanner::model()->findByPk($this->mdata['scanner']);
    		return $sc->ref;
    	}
    	return 'unkown';
    }
	
	public function genInvoice($up = false){
		if($this->type != 20) return false;
		if(empty($this->owner->extra['rate_base_1'])) return false;
		if($up){
			if(empty($this->invoice)) return;
			$inv = $this->invoice;
		}else{
			$inv= new Invoice;
		}
		$inv->type = 10;
		$inv->dpmt = Invoice::DPMT_IMPORT;
		$inv->currency = $this->owner->extra['currency'];
		$inv->to_id = $this->fwd_id;
		$inv->man_id = $this->id;
		$inv->status =1;
		$inv->date = $this->created;
		
		$items = array();
		$tot = 0;
		$term = '';
		foreach($this->rec_shipments as $p){
			$amt = $p->getCharge($this->owner);
			$items[] = array($p->hbn, $p->getDesc(), $p->pkg, $p->weight, $p->cbm, $amt,$p->cnee->postcode);
			$tot += $amt;
		}
		$inv->mdata['name'] = $this->owner->name;
		$inv->mdata['address'] = $this->owner->getAddress();
		$inv->mdata['items'] = $items;
		$inv->mdata['payterm'] = empty($this->owner->extra['payterm'])? '2 days' : $this->owner->extra['payterm'].' days';
		$inv->due = Invoice::calcDue($inv->date, $inv->mdata['payterm']);
		$inv->total = $tot;
		$inv->save();
	}

