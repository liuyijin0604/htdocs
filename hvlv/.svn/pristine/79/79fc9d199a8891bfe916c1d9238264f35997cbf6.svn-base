	public function getFids(){
		$ids = [];
		$sql = 'SELECT fid FROM mani_map WHERE mani_id = '.$this->id;
		$c = Yii::app()->db->createCommand($sql);
		$rs = $c->queryAll();
		foreach($rs as $r){
			$ids[] = $r['fid'];
		}
		return $ids;
	}
	
	public function validFile(){
		$err = array();
		if(empty($this->file)) $this->file = empty($_FILES['manifest'])? array() : $_FILES['manifest'];
		if(empty($this->file['tmp_name']) || !is_file($this->file['tmp_name'])){
			$err[] = 'Manifest File Required.';
		}else{
			if($this->type == 130) return true;
			
			$hash = hash_file('crc32b', $this->file['tmp_name']).hash('crc32b', filesize($this->file['tmp_name']));
			if(FileRepo::model()->count('hash = :h AND type = 10', [':h' => $hash]) > 0){
				$this->addError('file', 'This Manifest file already uploaded.');
				return false;
			}

            ini_set('precision', 12);

			$xls = new oExcel;
			if(!$xls->supported($this->file['name'])){
				foreach($xls->getError() as $e){
					$err[] = $e;
				}
			}else{
				$xls->load($this->file['tmp_name']);
				$service = new Service();
				$allData = $service->getFileData($this->file);
				$data = $xls->getAll();

				switch($this->type){
					case 10:
                        $hdr = ['m0' => 'TYPE,CONNOTE NO.,WEIGHT,CNEE,TEL,ADDRESS,SUBURB,STATE,P/C,DESTINATION,,PCS,COMMODITY,INNER ITEMS,UNIT VALUE,TTL VALUE,CMETER,SHIPPER,SHIPPER ADD,SHIPPER STATE,SHIPPER PC,SHIPPER COUNTRY CODE,SHIPPER CONTACT',
                            'm1' => '序号,运单号,参考号,发货人,电话,地址,区,市,省,邮编,国家,收货人,电话,地址,市/区,洲/省,邮编,国家,箱数,毛重(kg),体积(m3),英文品名,申报货币,申报单价,数量'];

                        break;

                    case 210:
						$hdr = 'TYPE,CONNOTE NO.,WEIGHT,CNEE,TEL,ADDRESS,SUBURB,STATE,P/C,DESTINATION,,PCS,COMMODITY,INNER ITEMS,UNIT VALUE,TTL VALUE,CMETER,SHIPPER,SHIPPER ADD,SHIPPER STATE,SHIPPER PC,SHIPPER COUNTRY CODE,SHIPPER CONTACT';
					break;
					case 20: case 220:
						$hdr = array('20m' => 'TYPE,CONNOTE NO.,WEIGHT,CNEE,TEL,ADDRESS,SUBURB,STATE,P/C,DESTINATION,,PCS,COMMODITY,INNER ITEMS,UNIT VALUE,TTL VALUE,CMETER,SHIPPER,SHIPPER ADD,SHIPPER STATE,SHIPPER PC,SHIPPER COUNTRY CODE,SHIPPER CONTACT,SAC', '20r' => 'Waybill No.,Item No.,Weight,Comments');
					break;
					case 30:
						if($this->fwd_id == 101){
							$hdr = 'M,'.rtrim(implode(',', array_slice($data[1],1)),', ');
						}elseif($this->fwd_id == 102){
							$hdr = 'Consignment,Date,Style,Address 1,Address 2,Address 3,Address 4,Suburb,Postcode,Items,Coupons,References,Deadweight,Volume';
						}
					break;
					case 110:
						$hdr = array('110s' => '包（箱）号,运单号,发货人,电话,收货人,地址,邮编,电话,品名,件数,重量(KG),保费,备注', '110n' => '序号,运单号,参考号,发货人,电话,地址,市/区,洲/省,邮编,国家,收货人,电话,地址,区,市,洲/省,邮编,国家,包裹数量,毛重(kg),体积(m3),分类,中文品名,品牌,规格,申报货币,申报单价,件数,HS编码,保费,备注,身份证号码,商品SKU');
						if(in_array(rtrim(implode(',', $data[2]),', '), $hdr)){
							$data[1] = $data[2];
							unset($data[2]);
						}
					break;
					case 320:
						$hdr = array('m0' => 'WBN,Ref,Items,Packages,Weight,CBM,Status,Cnee Name,Cnee Tel,Address,Suburb,State,Postcode');
						break;
					case 340:
						$hdr = array('m0' => '客户单号,件数,件重量,长,宽,高,客户单号,件数,数量,件实重,材积重(没有则为空),长,宽,高,备注,客户单号(cref),件数,件实重,长,宽,高,客户单号(cref),件数,件重量,长,宽,高');
					break;
					case 360:
						$hdr = array('m0' => '主单号Customer_ref,LB贴标顺序,蓝标号,分单号,重量,单箱体积,件数,收件公司,地址,城市region,邮编,收件联系人,电话,chargecode,state,Email,FBA PO,FBA shipment ID,主单号Customer_ref,LB贴标顺序,蓝标号,分单号,重量,单箱体积,件数,收件公司,地址,城市suburb,邮编,收件联系人,电话,chargecode,state,Email,FBA PO,FBA shipment ID');
						if(!empty($allData[0][2])&&$allData[0][1][1]=='主单号Customer_ref')
						{
							$data = $allData[0];
						}else
						{
							$data = $allData[1];
						}
					break;
					case 380:
						$hdr = array('m0' => 'HBL,Barcode,Courier,Connote');
					break;
					case 400:
						$hdr = array('m0' => 'HWBN,Ref,C Ref,Customer Name,Phone,Customer Address,City,State,Postcode,Marks & Numbers,Pkgs,cbm,kg,Description of goods');
					break;
					case 420:
						$hdr = array('m0' => 'Shipment ID,Consignee,Consignor,Origin,Dest.,Release,INCO,House Bill Number,Packs,Type,Weight,UW,Volume,UV,Service Level,ETD,ETA,Inspection,Inners,Type,ACI Cargo Status,ACI Msg. Status,AFR Bill Status,AFR Bill Status Desc.,Customs Cargo Status,Customs Message Status,Spot Rate,Curr.,Mode,Cost,Curr.,Mode,Gateway Sell,Curr.,Mode,HBL Dlv. Mode,VW,UVW,Trans.,Cont.,Type,CN Override,CN Address Line 1,CN Address Line 2,CN City,CN State,CN Country,CN Postcode,Chargeable,Unit,Goods Description,Value,Curr.,Booked,Receipt,Shipper\'s Ref,CFS Ref.,Consol Ref.,Chargeable,Client Volume,Client Weight,Has Prohibited Packaging,Interim Rcpt,Booking,Coload Master House Bill,Packing Order,Payment Term,Marks And Numbers,Exp Broker,Pickup L.Trn.,Imp Broker,Dlv. L.Trn.,Dlv. Agent,Pickup Agent,Is Domestic,Order Refs,Est Pickup,Pic. Req. By,Trn. Booking Requested,Trn. Booking Requested,Act. Pickup,Est. Delivery,Dlv. Req. By,Act. Delivery,Customs Entry Num.,Customs Entry Number Type,Pickup CFS Org.,Pickup CFS Address,Delivery CFS Org.,Delivery CFS Address,CR Override,CR Address Line 1,CR Address Line 2,CR City,CR State,CR Country,CR Postcode,Ctrl. Customer,Ctrl. Agent,SCP Override,SCP Address Line 1,SCP Address 2,SCP City,SCP State,SCP Country,CA Override,CA Address Line 1,CA Address Line 2,CA City,CA State,CA Country,Consignee Full Name,Consignor Full Name,Insured Val,Curr.,Additional Terms,Phase,Consol ID,Possible Oversize,Branch,Department,Sales Rep,Operator,Local Client,Overseas Agent,LDM,LC Address Short Code,Issue Date,Estimated Export Clearance Date,VR,Density Remark,Density Factor,Excess VW,UVW,HBL Booking Status,Additional Reference,Planned Load,Planned Discharge,Rate Origin,Rate Destination,Is Temperature Controlled,Is Hazardous,Is Perishable,Is Timber,Is Flammable,Is Container Vent Required,Commodity,PSA Group,Hazardous Waste Code,Permit Issue Date,Permit Number,Salvage packaging,Residue Contained,Last Known Transit Warehouse Status,Master / Lead,First BKG Ref.,Sales Rep (Full Name),Operator (Full Name)');
					break;
					case 430:
						$hdr = array('6m' => 'CONNOTE NO.,WEIGHT,CMETER,PCS,CNOR,CNEE,Marks and number,MEMO,Consol Number');
						break;
				}
				$this->mtype = $this->type;
				$dl1 = rtrim(implode(',', $data[1]),', ');
				if(is_array($hdr)){
					$m = false;
					foreach($hdr as $t=>$h){
						if($dl1 == $h|| mb_strpos($dl1, $h) === 0 || count(explode($dl1, $h))>=2){
							$m = true;
							$this->mtype = $t;
							break;
						}
					}
					if(!$m) $err[] = 'Manifest Column Mismatch!';
				}else{
					if($dl1 != $hdr) $err[] = 'Manifest Column Mismatch!'.$hdr;
				}
				//check data
				unset($data[1]);
                if ( $this->mtype == 'm1' ) {
                    unset($data[2]) ; // in case import m1 type template ,we need remove english title as well
                }
				$this->warns = array();
				foreach($data as $l=>$r){
					if (array_unique(array_values($r)) == ['']) continue;
					$this->checkData($l, $r);
				}
			}
			unset($xls);
		}
		
		if(!empty($err)){
			foreach($err as $e){
				$this->addError('file', $e);
			}
		}

        $merros  = $this->getErrors();

		return empty($err) && empty($merros);
	}

    private function checkDataForImParcelM1(&$l,&$r){

        $p = ImParcel::model()->find('hbn = :h', array(':h' => $r[2]));
        if (empty($p)) {
            $p = new ImParcel;
            $ar = new Addr;
            $ae = new Addr;
        } else {
            $ar = $p->cnor;
            $ae = $p->cnee;
        }
        $cur = Invoice::getCurID($r[23]);
        if ($cur === false) $this->addError('file', 'Line ' . $l . ': Missing currency.');

        // validate shipper address information
        $ar->name =  $r[4];
        $ar->tel = preg_replace('/[^\d]+/', '', $r[5]);
        $ar->address = $r[6];
        $ar->suburb =  $r[7];
        $ar->city = $r[8];
        $ar->state = $r[9];
        $ar->postcode = $r[10];
        $ar->country =  empty($r[11]) ? 'PR China' : $r[11];
        if (!$ar->validate()) $this->cascadeError($l, $ar);

        // validate consignee address information
        $ae->name = $r[12];
        $ae->tel = preg_replace('/[^\d]+/', '', $r[13]);
        $ae->address = $r[14];
        $ae->suburb = $r[15];
        $ae->state = strtoupper($r[16]);
        $ae->postcode =  $r[17];
        $ae->country = empty($r[18]) ? 'Australia' : $r[18];
        if (!$ae->validate()) $this->cascadeError($l, $ae);

        // check for consignee postcode
        if ( !$this->validPostcode($ae->state,$ae->suburb,$ae->postcode) ) {
            $this->addError('file', 'Line '.$l.': postcode does not match with state and suburb.');
        }

        $p->setAttributes(array(
            'consol_id' => 0,
            'zr_id' => 0,
            'agent_id' => $this->fwd_id,
            'status' => $this->type == 10 ? 10 : 20,
            'type' => 10,
            'hbn' => $r[2],
            'pkg' => $r[19],
            'cnor_id' => $ar->id,
            'cnee_id' => $ae->id,
            'state' => strtoupper($r[16]),
            'postcode' => $r[17],
            'value' => number_format((float)$r[24] * $r[25], 2, '.', '') ,
            'dvalue' => number_format((float)$r[24] * $r[25], 2, '.', '') ,
            'cbm' => number_format( empty($r[21]) ? round($r[21] / 600 * 1000000) / 1000000 : round($r[21] * 1000000) / 1000000, 6, '.', ''),
            'currency' => empty($cur) ? 1 : $cur,
            'weight' =>  sprintf('%0.2f', ($r[20] * 100) / 100),
        ));
        if (!empty($errs)) $this->cascadeError($l, $p);
        $p->man_id = $this->id;
        if (!$p->validate()) $this->cascadeError($l, $p);

        if(empty($r[19]) || intval($r[19]) < 1 ) $this->addError('file', 'Line '.$l.': inner items is invalid.');
        if(empty($r[20]) || floatval($r[20]) == 0 ) $this->addError('file', 'Line '.$l.': Missing package weight.');

        // check to see if item name , value and quantity number are matched
        // because multiple items are separated by comma
        $nameValueQty = true;
        if(empty($r[22])) {
            $nameValueQty = false;
            $this->addError('file', 'Line '.$l.': Missing goods name.');
        }
        if(floatval($r[24]) == 0) {
            $nameValueQty = false;
            $this->addError('file', 'Line '.$l.': Missing goods value.');
        }
        if(floatval($r[25]) == 0) {
            $nameValueQty = false;
            $this->addError('file', 'Line '.$l.': Missing goods quantity.');
        };
        if ( $nameValueQty ) {
            $allNames = explode(';', $r[22]);
            $allValues = explode(';', $r[24]);
            $allQtys = explode(';', $r[25]);
            if ( count($allNames) != count($allValues) ) {
                $this->addError('file', 'Line '.$l.': goods name does not match with goods value.');
            } else if ( count($allValues) != count($allQtys) ) {
                $this->addError('file', 'Line '.$l.': goods value does not match with goods quantity.');
            }
        }

    }

    /**
     * check to see if postcode is correct by suburb and state
     * search postcode in au_postcode table then compare with destination postcode
     * @param $sate
     * @param $suburb
     * @param $postcode
     * @return bool
     */
    private function validPostcode($state,$suburb,$postcode){

        $isValid = false;
        $state = strtoupper(trim($state));
        $suburb = strtoupper(trim($suburb));
        // remove all more than one space in the suburb
        $suburbWords = explode(' ', $suburb);
        $suburb = '';
        foreach ( $suburbWords as $w ) {
            if ( !empty($w) ) $suburb .= ' ' . $w;
        }
        $suburb = trim($suburb);
        $postcode = trim($postcode);

        // try to find postcode from au_postcode
        $postcodes = Postcode::model()->findAll('state = :state AND suburb = :suburb AND country = "AU"',array(':state' =>$state,':suburb' => $suburb));
        if ( !empty($postcodes) ) {
            foreach ( $postcodes as $post ) {
                if ( $postcode == $post->postcode ) {
                    $isValid = true;
                    break;
                }
            }
        }

        return $isValid;
    }

	public function checkData($l, $r){
		if(in_array($this->type, array(10,210,220)) || $this->mtype == '20m'){

            if ( $this->mtype == 'm1') { // for import parcels from china template
                $this->checkDataForImParcelM1($l,$r);
            } else {
                $p = ImParcel::model()->find('hbn = :h', array(':h' => $r[2]));
                if (empty($p)) {
                    $p = new ImParcel('create');
                    $ar = new Addr;
                    $ae = new Addr;
                } else {
                    $ar = $p->cnor;
                    $ae = $p->cnee;
                }

                $ar->name = $r[18];
                $ar->tel = preg_replace('/[^\d]+/', '', $r[23]);
                $ar->address = $r[19];
                $ar->state = $r[20];
                $ar->postcode = $r[21];
                $ar->country = $r[22];
                if (!$ar->validate()) $this->cascadeError($l, $ar);

                $ae->name = $r[4];
                $ae->tel = preg_replace('/[^\d]+/', '', $r[5]);
                $ae->address = $r[6];
                $ae->suburb = $r[7];
                $ae->state = $r[8];
                $ae->postcode = $r[9];
                $ae->country = 'Australia';
                if (!$ae->validate()) $this->cascadeError($l, $ae);

                preg_match('/(.+)(?:[,\s]+hs[:\s]+(.+))$/i', $r[13], $gd);
                $p->setAttributes(array(
                    'consol_id' => 0,
                    'zr_id' => 0,
                    'agent_id' => $this->fwd_id,
                    'cnor_id' => $ar->id,
                    'cnee_id' => $ae->id,
                    'status' => in_array($this->type, [10, 210]) == 10 ? 10 : 20,
                    'hbn' => $r[2],
                    'pkg' => $r[12],
                    'state' => $r[8],
                    'postcode' => $r[9],
                    'value' => number_format((float)$r[15], 2, '.', '') ,
                    'dvalue' => number_format((float)$r[16], 2, '.', ''),
                    'cbm' => number_format((floatval($r[17]) * 1000000) / 1000000, 6, '.', ''),
                    'currency' => 1,
                    'weight' => sprintf('%0.2f', (floatval($r[3]) * 100) / 100),
                ));
                //if(in_array($this->type, [20,220]) && empty($p->hbn)) $this->addError('file', 'Line '.$l.': CONNOTE NO. missing');
                $errs = $p->importMultiItems(empty($gd[1]) ? $r[13] : $gd[1], $r[14], $r[15], empty($gd[3]) ? '' : $gd[3]);
                if (!empty($errs)) $this->cascadeError($l, $p);

                if (in_array($this->type, [10, 210])) {
                    $p->man_id = $this->id;
                } elseif (in_array($this->type, [20, 220])) {
                    $p->rec_id = $this->id;
                }
                if ( empty($errs) && !$p->validate()) $this->cascadeError($l, $p);

                return true;
            }
		}elseif($this->mtype == '20r'){
			if(empty($r[1])) return true;
			$p = ImParcel::model()->find('hbn = :h', array(':h' => $r[1]));
			if(empty($p)){
				$this->addError('file', 'Line '.$l.': House Bill No. '.$r[1].' not found.');
			}
		}elseif($this->type == 30){
			if($this->fwd_id == 101){
				if($r[1] != 'C') return true;
				$tn = $r[2];
				$hbn = $r[25];
			}elseif($this->fwd_id == 102){
				$tn = $r[1];
				$hbn = $r[12];
			}
			if(empty($tn)){
				$this->addError('file', 'Line '.$l.': Tracking No. empty');
			}
			
			$hbn = preg_replace('/[ ="\\\\]+/', '', $hbn);
			$p = Shipment::model()->find('hbn = :h', array(':h' => $hbn));
			if(empty($p)){
				$this->addError('file', 'Line '.$l.': House Bill No. '.$hbn.' not found.');
			}else{
				if($p->status < 60){
					$this->warns[] = 'Line '.$l.': Parcel '.$hbn.' not cleared.';
				}elseif(!empty($p->trans)){
					foreach($p->trans as $t){
						if($t->org_id == $this->fwd_id && $t->connote == $tn){
							$this->warns[] = 'Line '.$l.': '.$tn.' already matched.';
						}
					}
				}
			}
		}elseif($this->mtype == '110s'){
			if(empty($r[2])) return false;
			if(ExParcel::model()->count('hbn = :h AND status > 15', array(':h' => $r[2])) > 0){
				$this->addError('file', 'Line '.$l.': Consigment '.$r[2].' already in the system');
			}
			if(empty($r[3])){
				$this->addError('file', 'Line '.$l.': Consignor Name not found');
			}
			/*if(empty($r[4])){
				$this->addError('file', 'Line '.$l.': Consignor Phone not found');
			}*/
			if(empty($r[5])){
				$this->addError('file', 'Line '.$l.': Consignee Name not found');
			}
			if(empty($r[6])){
				$this->addError('file', 'Line '.$l.': Consignee Address not found');
			}
			if(!preg_match('/\d+/', $r[8])){
				$this->addError('file', 'Line '.$l.': Consignee Phone not found');
			}
			if(!preg_match_all('/([BMO])\(([^\)]+)\)/i', AppHelper::semiAngle($r[9]), $m, PREG_SET_ORDER)){
				$this->addError('file', 'Line '.$l.': Goods Detail invalid');
			}else{
				foreach($m as $g){
					$g[2] = preg_replace('/(\s*)x(\d+)/', '*\\2', $g[2]);
					$gs = preg_split('/[, ]+/', $g[2]);
					foreach($gs as $itm){
						$ic = explode('*', $itm);
						if(sizeof($ic) > 2) $ic = array_slice($ic, 0, 2);
						if(sizeof($ic) != 2){
							$this->addError('file', 'Line '.$l.': Goods Detail invalid');
							break;
						}
						if(!is_numeric($ic[1])){
							$this->addError('file', 'Line '.$l.': Item Qty invalid');
							break;
						}
					}
				}
			}
			if(empty($r[11])){
				$this->addError('file', 'Line '.$l.': Weight not found');
			}
		}elseif(in_array($this->mtype, ['110n'])){
			if(!empty($r[1])){// main line
				if(!empty($r[2])){
					$p = ExParcel::model()->find('hbn = :hbn AND (agent_id = :a OR agent_id = 0)', array(':hbn' => $r[2], ':a' => $this->fwd_id));
				}

				if(empty($p)){
					$p = new ExParcel('create');
					$ar = new Addr;
					$ae = new Addr;
				}else{
					if($p->status >= 20) return;
					$ar = &$p->cnor;
					$ae = &$p->cnee;
				}
				
				$ar->name = $r[4];
				$ar->tel = preg_replace('/[^\d]+/','',$r[5]);
				$ar->address = $r[6];
				$ar->suburb = $r[7];
				$ar->state = $r[8];
				$ar->postcode = $r[9];
				$ar->country = empty($r[10])? 'Australia' : $r[10];
				$ar->ExportValidate(3, true);
				if(!$ae->validate() || $ar->hasErrors()) $this->cascadeError($l, $ar);
				
				$ae->name = $r[11];
				$ae->tel = preg_replace('/[^\d]+/','',$r[12]);
				$ae->address = $r[13];
				$ae->suburb = $r[14];
				$ae->city = $r[15];
				$ae->state = $r[16];
				$ae->postcode = $r[17];
				$ae->ExportValidate(4, true);
				$ae->country = empty($r[18])? 'PR China' : $r[18];
				if(!$ae->validate() || $ae->hasErrors()) $this->cascadeError($l, $ae);

				$p->setAttributes(array(
					'consol_id' => 0,
					'zr_id' => 0,
					'agent_id' => $this->fwd_id,
					'status' => 10,
					'type' => 20,
					'hbn' => empty($r[2])? 'AUTO' : $r[2],
					'pkg' => $r[19],
					'state' => $r[16],
					'postcode' => $r[17],
					'cbm' => sprintf('%0.6f', empty($r[21])? round(floatval($r[20])/600*1000000)/1000000 : round(floatval($r[21])*1000000)/1000000),
					'weight' => sprintf('%0.2f', round(floatval($r[20])*100)/100),
				));
				if(!empty($errs)) $this->cascadeError($l, $p);
				$p->cref = $r[3];
				$p->man_id = $this->id;
				if(!$p->validate()) $this->cascadeError($l, $p);
			}
			if(empty($r[22])) $this->addError('file', 'Line '.$l.': Missing goods category.');
			if(empty($r[23])) $this->addError('file', 'Line '.$l.': Missing goods name.');
			if(floatval($r[28]) == 0) $this->addError('file', 'Line '.$l.': Missing goods quantity.');
		} elseif ($this->mtype == '6m') {
			// use FAC simple manifest create shipment
			if(empty($r[4]) || $r[4] == 0){
				$this->addError('file', 'Line '.$l.': PCS cannot be null or 0.');
				return false;
			}
			$p = ImParcel::model()->find('hbn = :h', array(':h' => $r[1]));
			if (empty($p)) {
				$p = new ImParcel('create');
			}
			// cnee is optional, if not empty, create cnee
			$ae = new Addr;
			$ar = new Addr;
			$ar->name = empty($r[5])?'unknown':$r[5];
			$ae->name = empty($r[6])?'unknown':$r[6];
			$ae->save();
			$ar->save();
			// Consol number and marks and number are optional, if not empty, set consol's marks and number
			if (!empty($r[9])) {
				$consol = Consol::model()->find('no = :n', array(':n' => $r[9]));
				if (!empty($consol) && !empty($r[7])){
					$consol->mdata['sea_mark_number'] = $r[7];
					$consol->save();
				}
			}

			$p->setAttributes(array(
				'consol_id' => !empty($consol)?$consol->id:0,
				'zr_id' => 0,
				'agent_id' => $this->fwd_id,
				'cnee_id' => $ae->id,
				'cnor_id' => $ar->id,
				'status' => 10,
				'hbn' => $r[1],
				'pkg' => $r[4],
				'cbm' => number_format(((floatval($r[3]) * 1000000) / 1000000)/$r[4], 6, '.', ''),
				'currency' => 1,
				'weight' => sprintf('%0.2f', (floatval($r[2]) * 100) / 100),
				'can' => !empty($r[8])?$r[8]:'',
			));
			$errs = $p->importMultiItems('unknown item', 1, 1, '');
			if(!$p->validate()) $this->cascadeError($l, $p);
			$p->save();
			return true;
		}
	}

	public function cascadeError($l, $o){
		foreach($o->getErrors() as $e){
			$this->addError('file', 'Line '.$l.' error: '. $e[0]);
		}
	}
	
	public function beforeSave(){
		if(empty($this->created)) $this->created = date('Y-m-d H:i:s');
		if(!empty($this->mdata)) $this->meta = json_encode($this->mdata);
		if(empty($this->status)) $this->status = 10;
		if(empty($this->by_id) && !empty(Yii::app()->user)) $this->by_id = Yii::app()->user->id;
		return parent::beforeSave();
	}
	
	public function afterSave(){
		if(!$this->checkShipmentStates())
		{
			return;
		}
		if(!empty($this->file)){

			if(in_array($this->type, [10,20,210,220])){//save parcels
                if ( $this->mtype == 'm1' ) {
                    $this->saveImParcels();
                } else {
                    $this->saveParcels();
                }
			}elseif(in_array($this->type, [320])){//save parcels
                $this->savePCAETemplateParcels();
			}elseif(in_array($this->type, [340])){//save AUK packages
                $this->saveAUKPackagesParcels();
			}elseif(in_array($this->type,[360])){
				$this->save3PLSubShipments();
			}elseif(in_array($this->type,[380])){
				$this->saveAukBarcodes();
			}elseif(in_array($this->type,[400])){
				$this->saveAukManifestTemplate();
			}elseif($this->type == 420){
				$this->saveCargoWise();
			}elseif($this->type == 30){
				$this->addTranship();
			}elseif($this->type == 110){
				$trans = Yii::app()->db->beginTransaction();
				try{
					$this->saveExParcels();
					$trans->commit();
				} catch (Exception $ex) {
					$trans->rollback();
					throw $ex;
				}
			}
			
			//save file
			FileRepo::storeFile($this->file['tmp_name'], $this->file['name'], 10, $this->id);
		}
		Meta::saveAll($this);
		
		if(!$this->nolog && !empty($this)){
			$extra = empty($this->custom_log_note)? array() : array('note' => $this->custom_log_note);
			Log::add($this, $this->isNewRecord? 3 : 4, array_merge(array('status' => $this->getStatus()), $extra));
		}
	}

	public function checkShipmentStates()
	{
		$check = true;
		if(!$this->imCover)
		{
			if(!empty($this->file)){
				if(in_array($this->type, [10,20,210,220])){//save parcels
	                    $check = $this->checkParcels();
				}
			}
		}
		return $check;
	}
	
	public function afterFind(){
		if(!empty($this->meta)) $this->mdata = json_decode($this->meta, true);
		Meta::getAll($this);
		return true;
	}

    /**
     * save import parcels
     */
    private function saveImParcels(){

        // read all parcels data from excel template file
        $xls = new oExcel;
        $xls->supported($this->file['name']);
        $xls->load($this->file['tmp_name']);
        $data = $xls->getAll();
        ini_set('precision', 12);
        unset($xls); // release memory right now

        // remove common header
        unset($data[1]);
        unset($data[2]);

        // try to get default shipper address if existing
        $user = User::model()->findByPk(Yii::app()->user->id);

        $defShipperAddress = NULL;
        if(!empty($user->org->contacts)){
            $shipperAddress = $user->org->contacts[0]; // always use first one which should be shipper address currently
            if ( $shipperAddress && $shipperAddress->status == 1 ) {
                $defShipperAddress = array(
                        'name' => $shipperAddress->name,
                        'tel' => $shipperAddress->phone,
                        'address' => $shipperAddress->address,
                        'suburb' => $shipperAddress->suburb,
                        'city' => $shipperAddress->city,
                        'state' => $shipperAddress->state,
                        'postcode' => $shipperAddress->postcode,
                        'country' => $shipperAddress->country,
                        'email' => $shipperAddress->email
                );
            }
        }

        $ss = new OrgRate('search');
        $ss->org_id = $this->fwd_id;
        $cus_services = $ss->getCustomerServicePlans($ss->org_id);
        $dlMode = 1; // default as eParcel service
        if ( isset($cus_services['services']->DR->dl_mode) ) $dlMode = $cus_services['services']->DR->dl_mode;
		$trans = Yii::app()->db->beginTransaction();
		try{
        foreach($data as $l=>$r){
            if(empty($r[1])) continue; //  parcel No. column at 1 :  save real parcel ( one parcel number maybe include multiple goods lines)
            if(empty($r[20])) break; // goods weight column at 10 :  goods must have weight value

            // if parcel existing just update it
            // otherwise will create a new one
            $p = ImParcel::model()->find('status <= 25  AND hbn = :hbn AND owner_id = :oid', array(':hbn' => $r[2], ':oid' => Yii::app()->user->id));
            if(empty($p)) {
                $p = new ImParcel;
                $ar = new Addr;
                $ae = new Addr;
            } else {
                $ar = &$p->cnor;
                $ae = &$p->cnee;
            }

            // get currency ID
            $cur = Invoice::getCurID($r[23]);

            // save or update shipper address information
            $ar->name =  $r[4];
            $shipperName = trim($ar->name);
            if ( empty( $shipperName ) ) {
                // in case no shipper name , we will try to use org's default shipper address if existing
                if (!empty($defShipperAddress) ) {
                    $ar->attributes = $defShipperAddress;
                }
            } else {
                $ar->tel = preg_replace('/[^\d]+/', '', $r[5]);
                $ar->address = $r[6];
                $ar->suburb = $r[7];
                $ar->city = $r[8];
                $ar->state = $r[9];
                $ar->postcode = $r[10];
                $ar->country = empty($r[11]) ? 'PR China' : $r[11];
            }
            $ar->save();

            // update or save consignee address information
            $ae->name = $r[12];
            $ae->tel = preg_replace('/[^\d]+/', '', $r[13]);
            $ae->address = $r[14];
            $ae->suburb = $r[15];
            $ae->state = strtoupper($r[16]);
            $ae->postcode =  $r[17];
            $ae->country = empty($r[18]) ? 'Australia' : $r[18];
            $ae->save();

            $p->setAttributes(array(
                'consol_id' => 0,
                'zr_id' => 0,
                'agent_id' => $this->fwd_id,
                'cnor_id' => $ar->id,
                'cnee_id' => $ae->id,
                'status' => $this->type == 10 ? 10 : 20,
                'type' => 10,
                'hbn' => $r[2],
                'cref' => $r[3],
                'pkg' => $r[19],
                'state' => strtoupper($r[16]),
                'postcode' => $r[17],

               // 'value' => number_format((float)$r[27] * $r[28], 2, '.', '') ,
               // 'dvalue' => number_format((float)$r[27] * $r[28], 2, '.', '') ,
                'cbm' => number_format( empty($r[21]) ? round($r[21] / 600 * 1000000) / 1000000 : round($r[21] * 1000000) / 1000000, 6, '.', ''),
                'currency' => empty($cur) ? 1 : $cur,
                'weight' =>  sprintf('%0.2f', ($r[20] * 100) / 100),

            ));
            
            if($p->weight<0.01) $p->weight = 0.01;

           // get all goods , currently only support maximum 100 items for one parcel
            $items = array('g' => [], 'g_zh' => [], 'b' => [], 'm' => [], 'v' => [], 'q' => [], 'hs' => []);
            $names = explode(';',$r[22]);
            $values = explode(';',$r[24]);
            $qtys = explode(';',$r[25]);
            $allValues = 0.0;
            $itemCounts = sizeof($names);
            for ( $index = 0 ; $index < $itemCounts ; $index++){
                $items['g'][$index] = $names[$index];
                $items['g_zh'][$index] = '';
                $items['b'][$index] = '';
                $items['m'][$index] = '';
                $items['v'][$index] = $values[$index];
                $items['q'][$index] = $qtys[$index];
                $items['hs'][$index] = '';
                $allValues += $values[$index] * $qtys[$index];
            }
            $p->setAttribute('value',number_format((float)$allValues, 2, '.', '') );
            $p->setAttribute('dvalue',number_format((float)$allValues, 2, '.', '') );

            $p->eitems = $items;
            $p->man_id = $this->id;

            // if no hbn we create import parcel one
            if ( empty($p->hbn) ) {
                $p->hbn = 'ICN' . sprintf('%03s', $p->agent_id) . sprintf('%06s', $p->agent->getLabelNumber());
                $p->ref = $p->hbn; // avoid creating AMQ label by shipment after save logic
            }

            $p->save();

            // check to see if we should tracking the parcel by AUPOST
            // if client select this service and having this service we create barcode by AUPOST　rule
            //  as : AMQ + 7 digital numbers
            $this->updateBarcodeByDlService($p,$dlMode);
        }
        	$trans->commit();
		} catch (Exception $ex) {
			$trans->rollback();
			throw $ex;
		}
    }

    /**
     * @param $p
     * @param $dlMode
     */
    private function updateBarcodeByDlService(&$p,$dlMode){
        switch ($dlMode) {
            case 1: // eParcel
            case 2: // BPA no tracking
            case 3: // BPA with tracking
            case 4: // Mixed select economical one ( eParcel or BPA with tracking)
                $this->updateBarcodeWithAMQ($p);
                break;
        }

        // Mixed select economical one ( eParcel or BPA with tracking)
        // check to see which one is cheaper
        // in case $dlMode should be one of ( 1 or 3)
        if ( $dlMode == 4 ) {
            $dlMode = 1; // default as eParcel
            $costByeParcel = $p->getCostByeParcel();
            $costByBpaTracking = $p->getCostByBPATracking();
            if ( $costByeParcel > $costByBpaTracking ) {
                $dlMode = 3; // ok, BPA with tracking is cheap
            }
        }

        switch ($dlMode) {
            case 1: // eParcel
            case 2: // BPA no tracking
            case 3: { // BPA with tracking
                $p->mdata['au_lbl_type'] = $dlMode; // save what kind of label we should use
                $p->save();
                if ( $dlMode == 3 ) {
                    // in case BPA with tracking , we should change ref with stored label ID which we get from AU post
                    if ( !$this->updateBarcodeWithBPATracking($p) ) {
                        // in case no more BPA tracking No. available
                        // we set as eParcel
                        $p->mdata['au_lbl_type'] = 1; // convert to eParcel mode
                        $p->save();
                    }
                }
                break;
            }
        }
    }

    /**
     * @param $p
     */
    private function updateBarcodeWithBPATracking(&$p){
        $newNo = $this->getNewBPATrackingNo();
        if ( empty($newNo) ) return false;

        $p->hbn = '57' . $newNo . '13';
        $p->hbn .= AusPostAPI::aidChkDgt($p->hbn);
        $p->nolog = true;
        $p->ref = $p->hbn;
        $p->update(['hbn','ref']);
        $p->nolog = false;

        return true;
    }


    private  function newBpaTrackingNo(&$pool){
        $n = '';
        foreach($pool as $k=>$rg){
            if($rg[0] == $rg[1]) continue;
            $n = $rg[0];
            $pool[$k][0]++;
            break;
        }
        return $n;
    }

    private function getNewBPATrackingNo(){
        $confile = Yii::app()->basePath.DIRECTORY_SEPARATOR.'data'.DIRECTORY_SEPARATOR .'ap_receipted.php';
        if(function_exists('opcache_invalidate')) opcache_invalidate($confile);
        $sinc = include($confile);
        $newNo = $this->newBpaTrackingNo($sinc);
        if(!empty($sinc) && !empty($confile)) file_put_contents($confile, "<?php\nreturn ".var_export($sinc, true).';');

        if ( empty($newNo) ) {
            // not enough BPA tracking No.
            // we should send a email to manager maybe ...
            // TODO soon

        }
        return $newNo;
    }

    /**
     * @param $p
     */
    private function updateBarcodeWithAMQ(&$p){
        $p->hbn = ImParcel::genEparcelNo();
        $p->nolog = true;
        $p->ref = $p->hbn;

        // currently we use 2014 format short label
        $p->mdata['test_aupost_2017'] = 1;
        // save long aupost tracking number in note field
        if ( isset($p->mdata['test_aupost_2014']) ) {
            $aid = $p->ref.sprintf('%02s', 1).'50'.'2';
            $aid .= AusPostAPI::aidChkDgt($aid).'0'.sprintf('%04s', $p->cnee->postcode);

        } else
        {
            $aid = $shipment->ref.sprintf('%02s', 1).'00093'.'50'.'0';
	    $aid .= AusPostAPI::aidChkDgt($aid);
//            $aid = $p->ref . sprintf('%02s', 1) . '00093' . '02' . '0'; // latest format
//            $aid .= AusPostAPI::aidChkDgt($aid);
        }
        $p->note = $aid;
        $p->updateMeta();
        $p->update(['hbn','ref','note']);
        $p->nolog = false;
    }

	public function saveParcels(){

        ini_set('precision', 12);

		$xls = new oExcel;
		$xls->supported($this->file['name']);
		$xls->load($this->file['tmp_name']);
		$data = $xls->getAll();

		unset($xls);
		$hdr = $data[1];
		unset($data[1]);
		if($this->type == 20 && $this->mtype == '20r'){//save receipts
			foreach($data as $l=>$r){
				if(empty($r[1])) continue;
				$p = ImParcel::model()->find('hbn = :h AND agent_id = :aid', array(':h' => $r[1], ':aid' => $this->fwd_id));
				$p->status = 25;
				$p->rec_id = $this->id;
				$p->save();
			}
			return;
		}
		$trans = Yii::app()->db->beginTransaction();
		try{
		foreach($data as $l=>$r){
			if(empty($r[1])) break;
			if($this->type > 200){
				$p = CoParcel::model()->find('status <= 25 AND hbn = :hbn AND agent_id = :aid', array(':hbn' => $r[2], ':aid' => $this->fwd_id));
			}else{
				$p = ImParcel::model()->find('status <= 25 AND hbn = :hbn AND agent_id = :aid', array(':hbn' => $r[2], ':aid' => $this->fwd_id));
			}
			if(empty($p)){
				$p = $this->type > 200? new CoParcel('create') : new ImParcel('create');
				$ar = new Addr;
				$ae = new Addr;
			}else{
				$ar = &$p->cnor;
				$ae = &$p->cnee;
			}
			
			$ar->name = $r[18];
			$ar->tel = preg_replace('/[^\d]+/','',$r[23]);
			$ar->address = $r[19];
			$ar->state = $r[20];
			$ar->postcode = $r[21];
			$ar->country = $r[22];
			$ar->save();
			
			$ae->name = $r[4];
			$ae->tel = preg_replace('/[^\d]+/','',$r[5]);
			$ae->address = $r[6];
			$ae->suburb = $r[7];
			$ae->state = $r[8];
			$ae->postcode = $r[9];
			$ae->country = 'Australia';
			$ae->save();
			
			preg_match('/(.+)(?:[,\s]+hs[:\s]+(.+))$/i',$r[13],$gd);
            $uv = preg_split('/[;,\/]+/', $r[15]);
			$p->setAttributes(array(
				'agent_id' => $this->fwd_id,
				'consol_id' => 0,
				'zr_id' => 0,
				'cnor_id' => $ar->id,
				'cnee_id' => $ae->id,
				'status' => in_array($this->type, [10, 210])? 10 : 25,
				'hbn' => $r[2],
				'pkg' => $r[12],
				//'goods' => empty($gd[1])? $r[13] : $gd[1],
				//'hs' => empty($gd[3])? '' : $gd[3],
				//'item' => $r[14],
				'state' => $r[8],
				'postcode' => $r[9],
                'value' => number_format((float)$uv[0], 2, '.', '') ,
                'dvalue' => number_format((float)$r[16], 2, '.', ''),
                'cbm' => number_format( (floatval($r[17]) * 1000000) / 1000000, 6, '.', ''),
                'currency' =>  $this->mdata['edi_currency'],
                'weight' => number_format( (floatval($r[3]) * 100) / 100, 2, '.', '')
			));
			if($p->weight<0.01) $p->weight = 0.01;

			$p->importMultiItems(empty($gd[1])? $r[13] : $gd[1], $r[14], $r[15], empty($gd[3])? '' : $gd[3]);

			if(in_array($this->type, [10, 210])){
				$p->man_id = $this->id;
			}elseif(in_array($this->type, [20, 220])){
				$p->rec_id = $this->id;
			}

            // save USA/AUD exchange rate
            $p->mdata['exchange_rate'] = $this->mdata['exchange_rate'];

            // save SAC flag
            // if set as zero which means do not set SAC anyway
            // others value will be set SAC flag based on value
            // for example over 1000 AUD will not set SAC otherwise set SAC
            if ( isset($r[24]) && $r[24] === '0') {
                $p->mdata['ignore_sac'] = true;
            }
            if (!empty($r[25])) {
            	if($r[25]=='DDU')
            	{
            		$p->bwf = $p->bwf|ImParcel::CUSTOM_DDU;
            	}elseif($r[25]=='DDP')
            	{
            		$p->bwf = $p->bwf|ImParcel::CUSTOM_DDP;
            	}
            }

            if (!empty($r[27])) {
                $p->can = $r[27];
            }

            if (!empty($r[26])&&$this->bagTagIdentify) {
            	$destination = empty($r[28])?"":$r[28];
            	if(empty($p->ref))
            	{
            		$p->ref = $p->hbn;
            	}
	            if(preg_match('/UBA1050032SKU0/i', $r[26]))
				{
					$p->ref="SYD".$p->ref;
				}else if(preg_match('/UBA1050034SKU0/i', $r[26]))
				{
					$p->ref="MEL".$p->ref;
				}else if(preg_match('/UBA1050033SKU0/i', $r[26]))
				{
					$p->ref="BNE".$p->ref;
				}else if(preg_match('/UBA1050035SKU0/i', $r[26]))
				{
					$p->ref="ADL".$p->ref;
				}else
				{
					$p->ref=$destination.$p->ref;
				}
			}

			$isLetter = empty($r[29])?"":$r[29];
			if(!empty($isLetter))
			{
				$p->mdata['is_manual_letter'] = $isLetter;
				$p->save();
			}
			$subBarcodes = empty($r[30])?"":$r[30];
			$allBarcode = [];
			if(!empty($subBarcodes))
			{
				$barcodes = explode(';', $subBarcodes);
				$hasMain = false;
				if(!in_array($p->hbn, $barcodes)&&!empty($barcodes))
				{
					$allBarcode[] = $p->hbn;
				}

				foreach ($barcodes as $key => $barcode) {
					if(empty($barcode)) continue;
					$allBarcode[] = $barcode;
				}
				
				if(count($allBarcode)>$p->pkg)
				{
					unset($allBarcode[0]);
				}

				if(!empty($allBarcode))
				{
					$p->mdata['barcode'] = join(',',$allBarcode);
				}
			}
			
			$p->save();


			if(!empty($allBarcode))
			{
				$kk = 0;
				foreach ($allBarcode as $key => $barcode) {
					$pb = new ParcelBarcode();
					$pb->main_ref = $p->hbn;
					$pb->fid = $p->id;
					$pb->sub_ref = $barcode;
					$pb->sn = $kk+1;
					$pb->save();
					$kk++;
				}
			}



			if (!empty($r[26])) {
                $bagTagLabel = $r[26];

                $importBag = ImportBag::model()->find('bag_tag = :bag_tag',[':bag_tag'=>$bagTagLabel]);
				if(empty($importBag))
				{
					$destination = empty($r[28])?"":$r[28];
					$importBag = new ImportBag();
					$importBag->user_id= User::currentUserID();
					$importBag->bag_tag = $bagTagLabel;
					$importBag->created = date("Y-m-d H:i:s");
					if(!empty($destination))
					{
						$importBag->mdata['destination'] = $destination;
					}
					if(!empty($isLetter))
					{
						$importBag->mdata['is_manual_letter'] = 1;
					}
					$importBag->save();
				}else
				{
					$destination = empty($r[28])?"":$r[28];
					if(!empty($destination))
					{
						$importBag->mdata['destination'] = $destination;
					}
					if(!empty($isLetter))
					{
						$importBag->mdata['is_manual_letter'] = 1;
					}
					$importBag->save();
				}

				$bagTag = ImportBagTag::model()->find('shipment_id = :shipment_id',[':shipment_id'=>$p->id]);
				if(empty($bagTag))
				{
					$bagTag = new ImportBagTag();
				}

				$bagTag->bag_tag = $bagTagLabel;
				$bagTag->import_bag_id = $importBag->id;
				$bagTag->shipment_id = $p->id;
				$bagTag->save();
			}
		}
			$trans->commit();
		} catch (Exception $ex) {
			$trans->rollback();
			throw $ex;
		}
	}

	public function savePCAETemplateParcels(){

        ini_set('precision', 12);

		$xls = new oExcel;
		$xls->supported($this->file['name']);
		$xls->load($this->file['tmp_name']);
		$data = $xls->getAll();

		unset($xls);
		$hdr = $data[1];
		unset($data[1]);
		$trans = Yii::app()->db->beginTransaction();
		try{
		foreach($data as $l=>$r){
				if(empty($r[1])) break;
				$p = null;
				if(!$this->imCover)
				{
					$p = ImParcel::model()->find('hbn = :hbn AND status!=100', array(':hbn' => $r[1]));
					if(!empty($p))
					{
						$this->addError($p->hbn." Exist","Line ".$l.": ".$p->hbn." is existed");
						continue;
					}
				}

				if(empty($p)){
					$p = new ImParcel('create');
					$ar = new Addr;
					$ae = new Addr;
				}else{
					$ar = &$p->cnor;
					$ae = &$p->cnee;
				}
				
				$ar->name = '';
				$ar->tel = '';
				$ar->address = '';
				$ar->state = '';
				$ar->postcode = '';
				$ar->country = '';
				$ar->save();
				
				$ae->name = $r[8];
				$ae->tel = $r[9];
				$ae->address = $r[10];
				$ae->suburb = $r[11];
				$ae->state = $r[12];
				$ae->postcode = $r[13];
				$ae->country = 'Australia';
				$ae->save();
				
				preg_match('/(.+)(?:[,\s]+hs[:\s]+(.+))$/i',$r[3],$gd);
	            $uv = preg_split('/[;,\/]+/', 1);
				$p->setAttributes(array(
					'agent_id' => $this->fwd_id,
					'consol_id' => 0,
					'zr_id' => 0,
					'cnor_id' => $ar->id,
					'cnee_id' => $ae->id,
					'status' => ImParcel::NEW_STATUS,
					'hbn' => $r[1],
					'ref' => $r[2],
					'pkg' => $r[4],
					//'goods' => empty($gd[1])? $r[13] : $gd[1],
					//'hs' => empty($gd[3])? '' : $gd[3],
					//'item' => $r[14],
					'state' => $r[12],
					'postcode' => $r[13],
	                'value' => number_format((float)$uv[0], 2, '.', '') ,
	                'dvalue' => number_format((float)$uv[0], 2, '.', ''),
	                'cbm' => number_format( ((floatval($r[6])/floatval($r[4])) * 1000000) / 1000000, 6, '.', ''),
	                'currency' =>  $this->mdata['edi_currency'],
	                'weight' => number_format( (floatval($r[5]) * 100) / 100, 2, '.', '')
				));
				$arritems = preg_split('/[;,\/]+/', $r[3]);
				$arrvalues = [];
				$arrunits = [];
				foreach ($arritems as $key => $value) {
					$arrvalues[] = 1;
					$arrunits[] = 1;
				}
				$p->importMultiItems($r[3], join(';',$arrunits), join(';',$arrvalues), '');

				$p->man_id = $this->id;

	            // save USA/AUD exchange rate
	            $p->mdata['exchange_rate'] = $this->mdata['exchange_rate'];
	            $p->mdata['total_cbm'] = $r[6];
	           
				
				if(!$p->save())
				{
					$this->addError($p->hbn." import error","Line ".$l.": ".json_encode($p->getErrors()));
				}

			}
			$trans->commit();
		} catch (Exception $ex) {
			$trans->rollback();
			throw $ex;
		}
	}

