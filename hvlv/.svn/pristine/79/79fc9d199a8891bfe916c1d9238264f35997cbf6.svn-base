	public function saveCargoWise(){
		ini_set('precision', 12);

		$xls = new oExcel;
		$xls->supported($this->file['name']);
		$xls->load($this->file['tmp_name']);
		$data = $xls->getAll();

		unset($xls);
		$hdr = $data[1];
		unset($data[1]);

		$trans = Yii::app()->db->beginTransaction();
		try{
			foreach($data as $l=>$r){
				if(empty($r[1])) break;

				$p = ImParcel::model()->find('status <= 25 AND hbn = :hbn AND agent_id = :aid', array(':hbn' => $r[8], ':aid' => $this->fwd_id));
				
				if(empty($p)){
					$p = new ImParcel('create');
					$ar = new Addr;
					$ae = new Addr;
				}else{
					$ar = &$p->cnor;
					$ae = &$p->cnee;
				}
				
				$ar->name = $r[113];
				$ar->tel = "0000000000";
				$ar->address = $r[92]." ".$r[93];
				$ar->state = $r[95];
				$ar->postcode = $r[97];
				$ar->country = $r[96];
				$ar->save();
				
				$ae->name = $r[112];
				$ae->tel = "0000000000";
				$ae->address = $r[43]." ".$r[44];
				$ae->suburb = trim($r[45]);
				$ae->state = trim($r[46]);
				$ae->postcode = trim($r[48]);
				$ae->country = 'Australia';
				$ae->save();
				
				$preCbm = trim($r[13])/trim($r[9]);

				$p->setAttributes(array(
					'agent_id' => $this->fwd_id,
					'consol_id' => 0,
					'cnor_id' => $ar->id,
					'cnee_id' => $ae->id,
					'status' => 10,
					'hbn' => trim($r[8]),
					'ref' => trim($r[8]),
					'pkg' => trim($r[9]),
					'odpt_id' => $this->dpt_id,
                    'ddpt_id' => $this->dpt_id,

					'state' => trim($r[46]),
					'postcode' => trim($r[48]),
					'cbm' => !empty($preCbm)?$preCbm:0.001,
					'currency' =>  $this->mdata['edi_currency'],
					'weight' => !empty(trim($r[11])) ? trim($r[11]):1,
				));
				//(goods name , 1 , 0 )
				$p->importMultiItems(trim($r[51]),'1','1','');
				// save USA/AUD exchange rate
				$p->mdata['exchange_rate'] = $this->mdata['exchange_rate'];
				$p->mdata['sea_mark_number']=$r[68];
				$p->save();
				
			}
				$trans->commit();
			} catch (Exception $ex) {
				$trans->rollback();
				throw $ex;
			}
	}

	public function saveAUKPackagesParcels(){

        ini_set('precision', 12);

		$xls = new oExcel;
		$xls->supported($this->file['name']);
		$xls->load($this->file['tmp_name']);
		$data = $xls->getAll();

		unset($xls);
		$hdr = $data[1];
		$type = 0;
		if(!empty($hdr[9]))
		{
			$type=1;
		}
		unset($data[1]);
		foreach ($data as $key => $d)
        {
            if(empty($d[1])) continue;
            $qty = $d[2];

            if($type==0)
            {
	            $weight = number_format(floatval($d[3]),2, '.', '');
	            $length = $d[4];
	            $width = $d[5];
	            $height = $d[6];
        	}else
        	{
        		$weight = number_format(floatval($d[4]),2, '.', '');
	            $length = $d[6];
	            $width = $d[7];
	            $height = $d[8];
        	}

            for ($i=0; $i < $qty; $i++)
            {
                if(empty($shipmentDatas[$d[1]]))
                {
                    $shipmentDatas[$d[1]] = [['weight'=>$weight,'length'=>$length,'width'=>$width,'height'=>$height,'reference'=>0,'cbm'=>0]];
                }else
                {
                    $shipmentDatas[$d[1]][] = ['weight'=>$weight,'length'=>$length,'width'=>$width,'height'=>$height,'reference'=>0,'cbm'=>0];
                }
            }

            if(empty($weight)||empty($length)||empty($width)||empty($height))
            {
                $errors[] = 'cref '.$d[1] .'： line '.$key.' empty package data';
            }
        }

        foreach ($shipmentDatas as $cref => $s)
        {
                $pkg = count($s);
                $p = Shipment::model()->find('(cref = :cref or ref=:cref or can=:cref) and status!=100 and agent_id = :agentId',[":cref"=>$cref,":agentId"=>$this->fwd_id]);

                $shipmentPackage = ShipmentPackage::model()->find('cref = :cref',[":cref"=>"".$cref]);
                if(empty($p))
                {
                    $totalWeight =0;
                    $cbm=0;
                    $calculateCbm=0;

                    foreach ($s as $index=>$pack){
                        $totalWeight += $pack['weight'];
                        $cbm += $pack['cbm'];
                        $calculateCbm += number_format($pack['length']*$pack['width']*$pack['height']/1000000, 6, '.', '');
                    }
                    $pkg = count($s);
                    $cbm=number_format(max($cbm, $calculateCbm)/$pkg, 6, '.', '');
                    $weight= max(round($totalWeight*100)/100, 0.01);
                    if(empty($shipmentPackage))
                    {
                        $shipmentPackage = new ShipmentPackage();
                    }
                    $shipmentPackage->cref = $cref;
                    $shipmentPackage->packages = json_encode($s);
                    $shipmentPackage->cbm = $cbm;
                    $shipmentPackage->weight = $weight;
                    $shipmentPackage->pkg = $pkg;
                    $shipmentPackage->user_id = User::CurrentUserID();
                    $shipmentPackage->create = date('Y-m-d H:i:s');
                    $shipmentPackage->save();
                    $errors[] = 'cref '.$cref .': not found,the data is saved in system and waiting for shipment import';
                    unset($shipmentDatas[$cref]);
                    continue;
                }


                if(!empty($p))
                {
                	if(!empty($p->trans))
	                {
	                	$tran = end($p->trans);
	                	if($tran->org_id != Org::ORGID_COURIER_TOLL_IPEC&&$tran->org_id != Org::ORGID_COURIER_UBI&&$tran->org_id != Org::ORGID_COURIER_TNT_TOP&&$tran->org_id != Org::ORGID_COURIER_BORDER)
	                	{
		                    $errors[] = 'cref '.$cref .': can not be updated';
		                    unset($shipmentDatas[$cref]);
	                	}
	                }

	                if($pkg!=$p->pkg)
	                {
	                    $errors[] = 'cref '.$cref .': number of packages is '.$pkg.', but system recording is '.$p->pkg;
	                    unset($shipmentDatas[$cref]);
	                }
            	}else
            	{
            		$errors[] = 'cref '.$cref .': is not existed';
            		 unset($shipmentDatas[$cref]);
            	}
        }
        if(!empty($errors))
        {
        	$this->warns = $errors;
        }

		$trans = Yii::app()->db->beginTransaction();
		try{
			foreach ($shipmentDatas as $cref => $s)
            {
                $pkg = count($s);
                $p = ImParcel::model()->find('(cref = :cref or ref=:cref or can=:cref) and status!=100',[":cref"=>$cref]);
                $shipmentPackages = ShipmentPackage::model()->findAll('cref = :cref',[":cref"=>$cref]);
                foreach ($shipmentPackages as $key => $shipmentPackage) {
                	$shipmentPackage->delete();
                }

                $totalWeight =0;
                $cbm=0;
                $calculateCbm=0;
                $opacks = $p->packs;
                $p->packs = [];

                foreach ($s as $index=>$pack){
                    $p->packs[$index] = $pack;
                    $totalWeight += $pack['weight'];
                    $cbm += $p->packs[$index]['cbm'];
                    $calculateCbm += number_format($p->packs[$index]['length']*$p->packs[$index]['width']*$p->packs[$index]['height']/1000000, 6, '.', '');
                }
                $cbm=number_format(max($cbm, $calculateCbm)/$p->pkg, 6, '.', '');
                $p->cbm = max($p->cbm, $cbm);
                $p->weight= number_format($totalWeight, 2, '.', '');
				$p->save();

                if(empty($shipmentPackage))
                {
                    $shipmentPackage = new ShipmentPackage();
                    $shipmentPackage->p_packages = $opacks;
                }
                $shipmentPackage->cref = $cref;
                $shipmentPackage->packages = json_encode($s);
                $shipmentPackage->cbm = $p->cbm;
                $shipmentPackage->weight = $p->weight;
                $shipmentPackage->user_id = User::CurrentUserID();
                $shipmentPackage->create = date('Y-m-d H:i:s');
                $shipmentPackage->save();
            }
			$trans->commit();
		} catch (Exception $ex) {
			$trans->rollback();
			throw $ex;
		}
	}

	public function saveAukBarcodes(){

        ini_set('precision', 12);

		$xls = new oExcel;
		$xls->supported($this->file['name']);
		$xls->load($this->file['tmp_name']);
		$data = $xls->getAll();

		unset($xls);
		$hdr = $data[1];
		unset($data[1]);
		$shipmentDatas = [];
		foreach ($data as $key => $d)
        {
            if(empty($d[1])) continue;
            $hbn = $d[1];
            $barcode = $d[2];
            $ref = $d[4];
            $sn = $d[5];
            if(!empty($shipmentDatas[$hbn]))
            {
            	$shipmentDatas[$hbn][] = [$hbn,$barcode,$ref,$sn];
            }else
            {
            	$shipmentDatas[$hbn] = [[$hbn,$barcode,$ref,$sn]];
            }
        }

        foreach ($shipmentDatas as $hbn => $s)
        {
                $pkg = count($s);
                $p = ImParcel::model()->find('hbn = :hbn and status!=100 and agent_id = :agentId',[":hbn"=>$hbn,":agentId"=>$this->fwd_id]);
                if(!empty($p))
                {
                	if($p->status>=ImParcel::STATE_LOCAL_ARRIVAL&&$p->status!=55&&$p->status!=58&&$p->status!=60&&$p->scanCount()==0)
                	{
                		$errors[] = 'hbn '.$hbn .': status is '.$p->getStatus().', only import shipment can be updated';
	                    unset($shipmentDatas[$hbn]);
                	}
	                if($pkg!=$p->pkg)
	                {
	                    $errors[] = 'hbn '.$hbn .': number of barcodes is '.$pkg.', but system recording is '.$p->pkg;
	                    unset($shipmentDatas[$hbn]);
	                }
            	}else
            	{
            		$errors[] = 'hbn '.$hbn .': is not existed';
            		 unset($shipmentDatas[$hbn]);
            	}
        }
        if(!empty($errors))
        {
        	$this->warns = $errors;
        }

		$trans = Yii::app()->db->beginTransaction();
		try{
			foreach ($shipmentDatas as $hbn => $sArr)
	        {
	        	$p = ImParcel::model()->find('hbn = :hbn and status!=100 and agent_id = :agentId',[":hbn"=>$hbn,":agentId"=>$this->fwd_id]);
	        	$pbs = ParcelBarcode::model()->findAll('fid = :fid',[":fid"=>$p->id]);
	        	foreach ($pbs as $key => $pb) {
	        		$pb->delete();
	        	}
	        	$change = false;
	        	foreach ($sArr as $key => $s) {
	        		$pb = new ParcelBarcode();
	        		$pb->main_ref = $s[2];
	        		$pb->fid = $p->id;
	        		$pb->sub_ref = str_replace("'", '', $s[1]);
	        		$pb->sn = $s[3];
	        		if(!$pb->save())
	        		{
	        			print_r($pb);
	        		}
	        		if(!$change)
	        		{
	        			$p->ref = $s[2];
	        			$p->save();
	        			$change = true;
	        		}
	        	}
	        }
			$trans->commit();
		} catch (Exception $ex) {
			$trans->rollback();
			throw $ex;
		}
	}

	

	public function save3PLSubShipments(){

        ini_set('precision', 12);
        $xls = new oExcel;
		$xls->load($this->file['tmp_name']);
		$service = new Service();
		$allData = $service->getFileData($this->file);
		if(!empty($allData[0][2])&&$allData[0][1][1]=='主单号Customer_ref')
		{
			$index = 0;
		}else
		{
			$index = 1;
		}


		$imParcelService = new ImParcelService();
		[$subShipmentErrors,$successes] = $imParcelService->import3PLSubShipments($this->file,true,$this->id,$index,false);
        if(!empty($subShipmentErrors))
        {
        	$this->warns = $subShipmentErrors;
        }else
        {
        	[$subShipmentErrors,$successes] = $imParcelService->import3PLSubShipments($this->file,false,$this->id,$index,false);
        	if(!empty($subShipmentErrors))
	        {
	        	$this->warns = $subShipmentErrors;
	        }
	    }

	}

	private function NumToStr($num){
	    if (stripos($num,'e')===false) return $num;
	    $num = trim(preg_replace('/[=\'"]/','',$num,1),'"');//出现科学计数法，还原成字符串
	    $result = "";
	    while ($num > 0){
	        $v = $num - floor($num / 10)*10;
	        $num = floor($num / 10);
	        $result   =   $v . $result;
	    }
	    return $result;
	}
	public function checkParcels(){
		$xls = new oExcel;
		$xls->supported($this->file['name']);
		$xls->load($this->file['tmp_name']);
		$data = $xls->getAll();

		unset($xls);
		$hdr = $data[1];
		unset($data[1]);
		$hbns = [];
		$check = true;
		if($this->type == 20 && $this->mtype == '20r'){//save receipts
			foreach($data as $l=>$r){
				if(empty($r[1])) continue;
				$hbns[] = $r[1];
			}
		}else
		{
			foreach($data as $l=>$r){
				if(empty($r[2])) continue;
					$hbns[] = $r[2];
			}
		}

		$criteria = new CDbCriteria();
		$criteria->addInCondition('hbn',$hbns);
		$data = ImParcel::model()->findAll($criteria);
		foreach ($data as $key => $value) {
			$this->addError('existing', 'Hbn existing please click the create checkbox '.$value->hbn);
			$check = false;
		}
		return $check;
	}
	
	public function saveExParcels(){
		$xls = new oExcel;
		$xls->supported($this->file['name']);
		$xls->load($this->file['tmp_name']);
		$data = $xls->getAll();
		ini_set('precision', 12);
		unset($xls);
		if($this->mtype == '110s'){
			unset($data[1]);
			unset($data[2]);
			
			foreach($data as $l=>$r){
				if(empty($r[2]) && empty($r[5])) break;
				$p = ExParcel::model()->find('`hbn` = :hbn AND (`agent_id` = :a OR `agent_id` = 0 OR `agent_id` IN (SELECT id FROM `org` WHERE `status` = 1 AND `type` = 65 AND `by` = :a))', array(':hbn' => $r[2], ':a' => $this->fwd_id));
				if(empty($r[2]) || empty($p)){
					$p = new ExParcel('create');
					$ar = new Addr;
					$ae = new Addr;
				}else{
					if($p->status >= 20) continue;
					$ar = &$p->cnor;
					$ae = &$p->cnee;
				}
				
				$ar->name = $r[3];
				$ar->tel = preg_replace('/[^\d]+/','',$r[4]);
				$ar->country = 'Australia';
				$ar->save();
				
				$ae->name = $r[5];
				$ae->tel = preg_replace('/[^\d]+/','',$r[8]);
				$ae->setCnAddr($r[6], $r[7]);
				$ae->country = 'PR China';
				$ae->save();
				
				$p->setAttributes(array(
					'agent_id' => empty($p->agent_id)? $this->fwd_id : $p->agent_id,
					'consol_id' => 0,
					'odpt_id' => $this->dpt_id,
					'zr_id' => 0,
					'cnor_id' => $ar->id,
					'cnee_id' => $ae->id,
					'status' => empty($p->status)? 10 : ($p->status == 14? 15 : $p->status),
					'state' => $ae->state,
					'postcode' => $ae->postcode,
					'hbn' => $r[2],
					'pkg' => 1, //empty($r[10])? 1 : $r[10]
					'insurance' => $r[12],
					'currency' => 1,
					'weight' => sprintf('%0.2f', round(floatval($r[11])*100)/100),
					'bwf' => $p->bwf | empty($ae->city)? 4 : 0,
					'cbwf' => empty($this->owner->extra['mark_print'])? 0 : 1,
				));

				if(empty($r[2])) $p->hbn = $p->genHbn();

				//save items
				preg_match_all('/([BMO])\(([^\)]+)\)/i', AppHelper::semiAngle($r[9]), $m, PREG_SET_ORDER);
				$p->eitems = array('type' => array(), 'g' => array(), 'q' => array());
				foreach($m as $g){
					$g[2] = preg_replace('/(\s*)x(\d+)/', '*\\2', $g[2]);
					$gs = preg_split('/[, ]+/', $g[2]);
					foreach($gs as $itm){
						$ic = explode('*', $itm);
						if(sizeof($ic) > 2) $ic = array_slice($ic, 0, 2);
						$p->eitems['type'][] = strtoupper($g[1]);
						$p->eitems['g'][] = trim($ic[0]);
						$p->eitems['q'][] = $ic[1];
						$p->eitems['v'][] = null;
					}
				}
				$p->mdata['client_entry'] = ['items'=> $p->eitems];
				$p->man_id = $this->id;
				$p->save();

				//add notes
				if(!empty($r[13])) Log::add($p, 6, array('notes' => $r[13]));
				Log::add($p, 6, array('notes' => 'Goods: '.$r[9]));
			}
		}elseif(in_array($this->mtype, ['110n'])){
			unset($data[1]);
			foreach($data as $l=>$r){
				if(empty($r[1]) || in_array($l, $this->exclude_lines)) continue;
				if(empty($r[22]) && empty($r[23])) break;
				$p = ExParcel::model()->find('hbn = :hbn AND (agent_id = :a OR agent_id = 0)', array(':hbn' => $r[2], ':a' => $this->fwd_id));

				if(empty($r[2]) || empty($p)){
					$p = new ExParcel('create');
					$ar = new Addr;
					$ae = new Addr;
				}else{
					if($p->status >= 20) continue;
					$ar = &$p->cnor;
					$ae = &$p->cnee;
				}
				
				$ar->name = $r[4];
				$ar->tel = preg_replace('/[^\d]+/','',$r[5]);
				$ar->address = $r[6];
				$ar->suburb = $r[7];
				$ar->state = $r[8];
				$ar->postcode = $r[9];
				$ar->country = empty($r[10])? 'Australia' : $r[10];
				$ar->save();
				
				$ae->name = $r[11];
				$ae->tel = preg_replace('/[^\d]+/','',$r[12]);
				$ae->address = $r[13];
				$ae->suburb = $r[14];
				$ae->city = $r[15];
				$ae->state = $r[16];
				$ae->postcode = $r[17];
				$ae->country = 'PR China';
				//$ae->setCnAddr($r[13], $r[17]);
				if(!empty($r[32]) && preg_match('/^(\d{15}|[\dx]{18})$/i',$r[32])){
					$ae->cnid_no = $r[32];
				}
				if(empty($ae->postcode)){
					$ae->postcode = CnArea::getZip($ae->state, $ae->city);
				}
				if(!$ae->save()) Yii::log($ae->id.' '.json_encode($ae->getErrors()), 'error');

				/*if(preg_match('/DAU(\d{3})/', $r[2], $hm)){
					$org = Org::model()->findByPk($hm[1]);
					if($org) $p->agent_id = $org->id;
				}*/
				$styp = 0;
				if(!empty($r[34])){
					foreach(ExParcel::$styps as $ti=>$tv){
						if($tv == $r[34]){
							$styp = $ti;
							break;
						}
					}
				}
				
				$p->setAttributes(array(
					'agent_id' => empty($p->agent_id)? $this->fwd_id : $p->agent_id,
					'consol_id' => 0,
					'odpt_id' => $this->dpt_id,
					'zr_id' => 0,
					'cnor_id' => $ar->id,
					'cnee_id' => $ae->id,
					'status' => empty($p->status)? 10 : ($p->status == 14? 15 : $p->status),
					'hbn' => $r[2],
					'cref' => $r[3],
					'pkg' => $r[19],
					'state' => $ae->state,
					'postcode' => $r[17],
					'insurance' => $r[30],
					'note' => $r[31],
					'cbm' => empty($r[21])? round(floatval($r[20])/600*1000000)/1000000 : round(floatval($r[20])*1000000)/1000000,
					'weight' => sprintf('%0.2f', round(floatval($r[20])*100)/100),
					'cbwf' => empty($this->owner->extra['mark_print'])? 0 : 1,
					'styp' => $styp,
				));

				$ptyp = array_flip(ExProdb::$rtypes);
				$items = array('type' => [], 'g' => [], 'b' => [], 'm' => [], 'v' => [], 'q' => [], 'hs' => [],);
				for($j = 0; $j < 100; $j++){
					if($j > 0 && (empty($data[$l+$j]) || !empty($data[$l+$j][1]))) break;
					if(!empty($data[$l+$j][33])){
						$pd = ExProdb::model()->find('sku = :sku', [':sku' => $data[$l+$j][33]]);
					}else{
						$pd = ExProdb::model()->find('name_zh LIKE :n OR sku = :nt', [':n' => '%'.$data[$l+$j][23].'%', ':nt' => $data[$l+$j][23]]);
					}
					if(empty($pd)){
						$items['type'][$j] = strtoupper($data[$l+$j][22]);
						$items['g'][$j] = $data[$l+$j][23];
						$items['b'][$j] = $data[$l+$j][24];
						$items['m'][$j] = $data[$l+$j][25];
						$items['v'][$j] = $data[$l+$j][27];
						$items['q'][$j] = $data[$l+$j][28];
						$items['hs'][$j] = $data[$l+$j][29];
					}else{
						$items['type'][$j] = $ptyp[$pd->type];
						$items['g'][$j] = $pd->name_zh;
						$items['b'][$j] = $pd->brand;
						$items['m'][$j] = $pd->model;
						$items['v'][$j] = $pd->price;
						$items['q'][$j] = $data[$l+$j][28];
						$items['hs'][$j] = $pd->hs;
					}
				}
				$p->eitems = $items;
				$p->mdata['client_entry'] = ['items'=> $items];
				if(empty($p->hbn)) $p->hbn = $p->genHbn();
				$p->man_id = $this->id;
				$p->save();
			}
		}
	}
	
	public function addTranship(){
		$xls = new oExcel;
		$xls->supported($this->file['name']);
		$xls->load($this->file['tmp_name']);
		$data = $xls->getAll();
		unset($data[1]);
		foreach($data as $l=>$r){
			if($this->fwd_id == 101){
				if($r[1] != 'C') continue;
				$tn = $r[2];
				$hbn = $r[25];
			}elseif($this->fwd_id == 102){
				$tn = $r[1];
				$hbn = $r[12];
			}
			$hbn = preg_replace('/[ ="\\\\]+/', '', $hbn);
			$p = Shipment::model()->find('hbn = :h', array(':h' => $hbn));
			if($p){
				$ts = new Tranship;
				$ts->pid = $p->id;
				$ts->org_id = $this->fwd_id;
				$ts->man_id = $this->id;
				$ts->type = 80;
				$ts->status = 19;
				$ts->connote = $tn;
				$ts->time = date('Y-m-d H:i:s');
				$ts->save();
			}
		}
	}
	
	public function getType(){
		return Yii::t(strtolower(__CLASS__), empty(self::$types[$this->type])? '' : self::$types[$this->type]);
	}
	
	public function getStatus(){
		return Yii::t(strtolower(__CLASS__), empty(self::$states[$this->status])? '' : self::$states[$this->status]);
	}

	/**
	 * Retrieves a list of models based on the current search/filter conditions.
	 *
	 * Typical usecase:
	 * - Initialize the model fields with values from filter form.
	 * - Execute this method to get CActiveDataProvider instance which will filter
	 * models according to data in model fields.
	 * - Pass data provider to CGridView, CListView or any similar widget.
	 *
	 * @return CActiveDataProvider the data provider that can return the models
	 * based on the search/filter conditions.
	 */
	public function search($pgn=true, $ps = 30, $ec = false,$paidonly = false){
		// @todo Please modify the following code to remove attributes that should not be searched.

		$criteria=new CDbCriteria;
		
		if(empty($this->status)) $this->status = '<90';

		$criteria->compare('t.id',$this->id);
		$criteria->compare('fwd_id',$this->fwd_id);
		$criteria->compare('t.dpt_id',$this->dpt_id);
		$criteria->compare('t.by_id',$this->by_id);
		$criteria->compare('t.consol_id',$this->consol_id);
		$criteria->compare('t.created',$this->created,true);
		$criteria->compare('t.type',$this->type);
		$criteria->compare('t.status',$this->status);
		$criteria->compare('t.ref',$this->ref,true);
		$criteria->compare('t.total',$this->total,true);
		$criteria->compare('t.bwf',$this->bwf,true);

		$with = array();
		if(!empty($this->fwd_name)){
			$with[] = 'owner';
			$criteria->compare('owner.name', $this->fwd_name, true);
		}

        // in case only search for paid manifest
        if ( $paidonly ) {
            $with[] = 'invoice';
            $criteria->compare('invoice.status',9,true);
        }

		if(!empty($this->pref))
		{
			$with[] = 'man_shipments';
			$criteria->addCondition('man_shipments.ref = "'.$this->pref.'" or '.'man_shipments.hbn = "'.$this->pref.'" or '.'man_shipments.cref = "'.$this->pref.'" ' );
		}
		
		if(!empty($with)){
			$criteria->with = array_unique($with);
			$criteria->together = true;
		}

		if($ec){
			$criteria->mergeWith($ec);
		}

		if($this->isArchive==1)
		{
			$criteria->compare('t.created',">2021-01-01",true);
		}

		return new CActiveDataProvider($this, array(
			'criteria'=>$criteria,
			'sort'=>array(
    			'defaultOrder'=>'t.created DESC',
  			),
			'pagination'=>$pgn? array(
				'pageSize' => $ps,
			) : false,
		));
	}

    /**
     * @param bool $pgn
     * @param int $ps
     * @return CActiveDataProvider
     */
    public function searchPaidManifest($pgn=true, $ps = 30){

        // create a criteria condition
        $criteria=new CDbCriteria;
        if ( empty($this->status) ) $this->status = '<90';
        $criteria->compare('dpt_id',$this->dpt_id);
        $criteria->compare('consol_id',$this->consol_id);
        $criteria->compare('type',$this->type);
        $criteria->compare('status',$this->status);

        // create raw data
        $allPaidManifests = array();

        return new CActiveDataProvider($allPaidManifests, array(
            'criteria'=>$criteria,
            'sort'=>array(
                'defaultOrder'=>'t.created DESC',
            ),
            'pagination'=>array(
                'pageSize' => $ps,
            ),
        ));
    }

	public function getFileName(){
		return empty($this->rfile)? '' : (empty($this->rfile->name)? 'unknown' : $this->rfile->name);
	}
	
	public function getFileLink(){
		return empty($this->rfile)? '' : $this->rfile->getUrl();
	}
	
	public function getDptName(){
		return empty($this->dpt_id)? '' : $this->dpt->name;
	}
	
	public function rSearch($criteria){
		$rs = self::model()->findAll($criteria);
		$ra = array();
		$i = 0;
		foreach($rs as $r){
			$o = $r->attributes;
			$o['rfile_link'] = $r->getFileLink();
			$o['rfile_name'] = $r->getFileName();
			$o['dpt_name'] = $r->getDptName();
			$ra[] = $o;
		}
		return $ra;
	}

    /**
     * @param $consoleId
     */
    public static function recreateEpsInvoice($consoleId,$invoiceId = 0){
        //invoice
        $rates = [
            'N0' => ['4.95', '4.95', '0.00'],
            'N1' => ['6.18', '6.48', '0.00'],
            'GF' => ['6.18', '6.48', '0.50'],
            'WG' => ['6.18', '6.48', '0.50'],
            'NC' => ['6.18', '7.32', '0.64'],
            'CB' => ['6.18', '7.32', '0.64'],
            'N3' => ['6.18', '8.07', '1.35'],
            'N4' => ['6.18', '8.07', '1.35'],
            'N2' => ['6.18', '8.07', '1.35'],
            'V0' => ['6.18', '6.70', '0.90'],
            'V1' => ['6.18', '6.70', '0.90'],
            'GL' => ['6.18', '8.00', '1.29'],
            'BR' => ['6.18', '9.06', '1.76'],
            'V3' => ['6.18', '7.14', '1.23'],
            'V2' => ['6.18', '9.06', '1.76'],
            'Q0' => ['6.18', '6.70', '0.90'],
            'Q1' => ['6.18', '6.70', '0.90'],
            'IP' => ['6.18', '8.00', '1.65'],
            'GC' => ['6.18', '6.70', '1.56'],
            'Q5' => ['6.18', '7.14', '1.23'],
            'SC' => ['6.18', '8.00', '1.65'],
            'Q2' => ['6.18', '9.06', '2.23'],
            'Q3' => ['6.18', '9.06', '3.43'],
            'Q4' => ['6.18', '9.06', '3.94'],
            'S0' => ['6.18', '6.70', '1.19'],
            'S1' => ['6.18', '6.70', '1.19'],
            'S2' => ['6.18', '9.06', '3.06'],
            'W0' => ['6.18', '8.00', '2.77'],
            'W1' => ['6.18', '8.00', '2.77'],
            'W2' => ['6.18', '9.06', '6.49'],
            'W3' => ['6.18', '9.06', '6.69'],
            'T0' => ['6.18', '8.00', '2.20'],
            'T1' => ['6.18', '8.00', '2.20'],
            'NT1' => ['6.18', '9.06', '6.62'],
            'NT2' => ['6.18', '9.06', '6.62'],
            'NF' => ['6.18', '8.29', '4.60'],
            'W4' => ['6.18', '9.06', '6.07'],
            'AAT' => ['6.18', '8.29', '2.70'],
        ];

        $consol = ImcoConsol::model()->findByPk($consoleId);
        $owner = Org::model()->findByPk(1002);
        if ( $invoiceId > 0 ) $inv = Invoice::model()->findByPk($invoiceId);
        if ( empty($inv) ) {
            $inv = new Invoice;
            $inv->type = 10;
			$inv->dpmt = Invoice::DPMT_IMPORT;
            $inv->to_id = 1002;
            $inv->dpt_id = Org::PCAE_DEPARTMENT_SYDNEY; // default set Sydney as warehouse
            $inv->ref = 'ck1-ep'.date('Ymd', strtotime($consol->created));
            $inv->currency = 1;
            $inv->status = 1;
            $inv->date = date('Y-m-d', strtotime($consol->created));
            $inv->due = $inv->date;
            $inv->save();
        }
        $items = [];
        $tot = 0;

        foreach($consol->shipments as $i=>$p){
            $pc = trim($p->cnee->postcode);
            $zm = ZoneMap::model()->find('org_id = 100 AND pc_lo <= :p AND pc_hi >= :p', [':p' => $pc]);
            if(!empty($rates[$zm->z2])){
                $z = $zm->z2;
            }elseif(!empty($rates[$zm->z1])){
                $z = $zm->z1;
            }else{
                echo $zm->z1.'/'.$zm->z2." has no rate<br />";
                continue;
            }
            $amt = $p->weight > 0.5? $rates[$z][1] + $rates[$z][2] * $p->weight : $rates[$z][0];
            $items[] = [$p->ref, $p->getDesc().'    '.$z, $p->pkg, $p->weight, $p->cbm, $amt];
            $tot += $amt;
        }
        $inv = Invoice::model()->findByPk($inv->id);
        InvLine::model()->deleteAll('inv_id = :invid',[':invid' => $inv->id]);
        $il = new InvLine;
        $il->inv_id = $inv->id;
        $il->ccode = 'EPA';
        $il->mdata['items'] = $items;
        $il->det = $consol->no;
        $il->amount = round($tot * 100) / 100;
        $il->qty = 1;
        $il->save();
        $inv->total = $tot;
        $inv->consol_id = $consol->id;

        $il->fid = $consol->id;
        $il->model = 'ImcoConsol'; // invoice connected with console directly

        $inv->mdata['name'] = $owner->name;
        $inv->mdata['address'] = $owner->getAddress();
        $inv->mdata['payterm'] = empty($owner->extra['payterm'])? 'COD' : $owner->extra['payterm'].' days';
        $inv->save();

    }

    public function getRTS()
    {
    	$shipment = Shipment::model()->find('hbn = :ref OR ref = :ref', [':ref' => $this->ref]);
    	return !empty($shipment->mdata["used_location"]) ? "Already Picked" : @$shipment->mdata["location"];
    }

    public function isWDT()
    {
    	$shipments = $this->man_shipments;
    	foreach ($shipments as $key => $s) {
    		if(!empty($s->consol)&&preg_match('/WDT/i', $s->consol->no))
			{
				return true;
			}
    		
    	}
    	
    	return false;
    }


    public function showPacksWithoutPackages()
    {
    	$shipments = $this->man_shipments;
    	$tld = 0;
    	$courier = 0;
    	$str = '';
    	foreach ($shipments as $key => $s) {
    		if($s->checkIsCargoProcessWithRef())
    		{
    			if(empty($s->packs))
    			{
    				$tld += 1;
    			}
    		}else
    		{
    			if(!empty($s->mdata['org_rate_id']))
    			{
    				$orgRate = OrgRate::model()->findByPk($s->mdata['org_rate_id']);
					if(in_array($orgRate->org_id,SiReconcile::$cbmCourier))
					{
						if(empty($s->packs))
    					{
							$courier += 1;
						}
					}
    			}
    		}
    	}
    	if($tld>0)
    	{
    		$str .= "TLD-".$tld."票未导入箱</br>";
    	}
    	if($courier>0)
    	{
    		$str .= "Others-".$courier."票未导入箱";
    	}

    	return $str;
    }

	/**
	 * Returns the static model of the specified AR class.
	 * Please note that you should have this exact method in all your CActiveRecord descendants!
	 * @param string $className active record class name.
	 * @return Consol the static model class
	 */
	public static function model($className=__CLASS__){
		return parent::model(get_called_class());
	}
}
