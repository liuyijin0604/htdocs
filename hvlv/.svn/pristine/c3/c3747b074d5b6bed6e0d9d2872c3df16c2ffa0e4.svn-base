        'postcode',
        'weight',
        ['name' => 'scan_no', 'header' => 'unScan', 'value' => '$data->pkg - $data->getOutPkg()'],

        ['name' => 'rack', 'type' => 'raw', 'value' => '$data->getRackName(false,true)'],
        ['name' => 'bag_tag', 'value' => '@$data->bag_tag->bag_tag', 'filter' => CHtml::textField(get_class($model).'[bagTag]', $model->bagTag)],
        ['name' => 'created', 'value' => 'substr($data->created,0,10)'],
        ['header' => 'ChargeCode', 'value' => '$data->getChargecode()', 'filter' => CHtml::textField(get_class($model).'[chargecode]', $model->chargecode)],

        ['header' => 'value', 'value' => '$data->dvalue'],
        ['header' => 'goods available address', 'type' => 'raw', 'value' => '$data->getAvailabelLabel()', 'filter' => CHtml::dropDownList(get_class($model).'[goodsAvailableAddress]', @$model->goodsAvailableAddress, $this->t(DmawbConsol::$available_address_name), ['prompt' => 'All'])],
        ['header' => 'extra Info', 'type' => 'raw', 'value' => '$data->getWarnings().$data->getDGWarnings()', 'filter' => CHtml::dropDownList(get_class($model).'[bwf]', $model->bwf, $this->t(ImParcel::$bwfs), ['prompt' => 'All']).CHtml::dropDownList(get_class($model).'[exInfo]', $model->exInfo, $this->t(ImParcel::$exInfos), ['prompt' => 'All'])],
