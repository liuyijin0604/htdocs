$this->widget('zii.widgets.grid.CGridView', [
    'id' => 'im-parcel-grid' . @$modelType,
    'cssFile' => false,
    'dataProvider' => $model->search(true, 10, false, false),
    'filter' => $model,
    'columns' => [
        ['name' => 'hbn', 'type' => 'raw', 'value' => '"<a href=\"" . Yii::app()->createURL("imParcel/update", array("id" => $data->id)) . "\" class=\"tab_link\" title=\"" . $data->hbn . "\">" . $data->getHbn() . "</a>"'],
        'ref',
        'can',
        'agent_id',
        ['name' => 'awb_name', 'header' => 'awb', 'type' => 'raw', 'value' => '@$data->consol->service==10?@$data->consol->awb:@$data->consol->mdata["container_no"]'],
        'pkg',
        $consolNoColumn,
        ['name' => 'status', 'value' => '$data->getStatus()', 'filter' => CHtml::dropDownList(get_class($model).'[status]', $model->status, $this->t(ImParcel::$states), ['prompt' => $this->t('All')])],
        ['name' => 'ddpt_id', 'value' => '@$data->ddepot->name', 'filter' => CHtml::dropDownList(get_class($model).'[ddpt_id]', $model->ddpt_id, $this->t(Org::dptList()), ['prompt' => $this->t('All')])],
