<script type="text/javascript">
$(function(){
	var tab = $('#<?=$_GET["tabid"];?>');
	var panel = tab.data('panel');
	

	var resetFilters = function(){
		$('#<?=$_GET['tabid']?>search-form form', panel).trigger('reset');
		$('#im-parcel-grid<?=@$modelType?>', panel).yiiGridView('update', {data: 'CoParcel=reset'});
	};

	$('#<?=$_GET['tabid']?>search-button', panel).click(function(){
		$('#<?=$_GET['tabid']?>search-form', panel).toggle();
		return false;
	});

	$('#<?=$_GET['tabid']?>search-form form', panel).on('submit', function(){
		$('#im-parcel-grid<?=@$modelType?>', panel).yiiGridView('update', {data: $('.filters input, .filters select', panel).serialize() + '&' + $(this).serialize()});
		return false;
	}).find('.reset_btn').click(resetFilters);

	tab.bind('onOpen', function(){
		$('#im-parcel-grid<?=@$modelType?>', panel).yiiGridView('update');
	});

	tab.on('gridUpdated', function(){
		$('tr.filters td:last-child', panel).empty().append($('<input type="button" id="reset_filter" value="Reset" />').on('click', resetFilters));
	}).trigger('gridUpdated');

	$('a.export_search', panel).on('mousedown', function(){
		var q = $('.filters input, .filters select', panel).serialize()+'&'+$('#<?=$_GET['tabid']?>search-form form', panel).serialize();
		$(this).attr('href', $(this).attr('href') + '&' + q);
	});

	$('#ecl', panel).on('mousedown', function(){
		var q = $('.filters input, .filters select', panel).serialize()+'&'+$('#<?=$_GET['tabid']?>search-form form', panel).serialize();
		$(this).attr('href', $(this).attr('href') + '&' + q);
	});
	$('#epl', panel).on('mousedown', function(){
		var q = $('.filters input, .filters select', panel).serialize()+'&'+$('#<?=$_GET['tabid']?>search-form form', panel).serialize();
		$(this).attr('href', $(this).attr('href') + '&' + q);
	});
	$('#edd', panel).on('mousedown', function(){
		var q = $('.filters input, .filters select', panel).serialize()+'&'+$('#<?=$_GET['tabid']?>search-form form', panel).serialize();
		$(this).attr('href', $(this).attr('href') + '&' + q);
	});
	$('#eso', panel).on('mousedown', function(){
		var q = $('.filters input, .filters select', panel).serialize()+'&'+$('#<?=$_GET['tabid']?>search-form form', panel).serialize();
		$(this).attr('href', $(this).attr('href') + '&' + q);
	});
	$('#amio', panel).on('mousedown', function(){
		var q = $('.filters input, .filters select', panel).serialize()+'&'+$('#<?=$_GET['tabid']?>search-form form', panel).serialize();
		$(this).attr('href', $(this).attr('href') + '&' + q);
	});
	var dfeHref = $('#dfe').attr('href');
	$('#dfe', panel).on('mousedown', function(){
		var q = $('.filters input, .filters select', panel).serialize()+'&'+$('#<?=$_GET['tabid']?>search-form form', panel).serialize();
		$(this).attr('href', dfeHref+ '&' + q);
	});

	$('input[name="yt0"]',panel).click(function(){
		if ($('input[name="ImParcel[ref]"]', panel).length){
			$('input[name="ImParcel[ref]"]', panel).val("");
		}
		if ($('input[name="TplParcel[ref]"]', panel).length){
			$('input[name="TplParcel[ref]"]', panel).val("");
		}
		if ($('input[name="ImParcel[hbn]"]', panel).length){
			$('input[name="ImParcel[hbn]"]', panel).val("");
		}
		if ($('input[name="TplParcel[hbn]"]', panel).length){
			$('input[name="TplParcel[hbn]"]', panel).val("");
		}
	});

	$('.pane', panel).on('focus', 'input[name="ImParcel[ref]"]', function()
	{
		if ($('input[name="ImParcel[ref]"]', panel).val() == "searching"){
			$('input[name="ImParcel[ref]"]', panel).val("");
		}
	});

	$('.pane', panel).on('focus', 'input[name="TplParcel[ref]"]', function()
	{
		if ($('input[name="TplParcel[ref]"]', panel).val() == "searching"){
			$('input[name="TplParcel[ref]"]', panel).val("");
		}
	});

	$('.pane', panel).on('focus', 'input[name="ImParcelArchive[ref]"]', function()
	{
		if ($('input[name="ImParcelArchive[ref]"]', panel).val() == "searching"){
			$('input[name="ImParcelArchive[ref]"]', panel).val("");
		}
	});


});



</script>
