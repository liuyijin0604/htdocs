    public function actionGetNotProcessed(){
        $objModalSmsNoticeCollection = new ModalSmsNoticeCollection;
        $objModalSmsNoticeCollection->funcGetNotProcessed();
        $listCollection = $objModalSmsNoticeCollection->funcCollection2StdClass();
        $objModalSmsNoticeCollection->funcBatchSetIsPricessedTrue();
        $this->funcRestResponse(true,$listCollection,'');
    }

    public function actionGetNotProcessedRealTimeSms(){
        $isCheck = @$_GET['isCheck'];
        $objModalRealTimeSmsNoticeCollection = new ModalRealTimeSmsNoticeCollection;
        $objModalRealTimeSmsNoticeCollection->funcGetNotProcessed($isCheck);
        $listCollection = $objModalRealTimeSmsNoticeCollection->funcCollection2StdClass();
        //$objModalRealTimeSmsNoticeCollection->funcBatchSetIsPricessedTrue();
        $this->funcRestResponse(true,$listCollection,'');
    }



    public function actionPostStatus(){
        foreach ($_POST as $key => $value) {
            $arr = explode(",", $key);
            break;
        }
        $id = $arr[0];
        $status = $arr[1];
        $model = OrmSmsNotice::model()->findByPk($id);
        $model->is_processed = $status;
        $model->sent_time = date("Y-m-d H:i:s");
        $model->save();

    }
    
