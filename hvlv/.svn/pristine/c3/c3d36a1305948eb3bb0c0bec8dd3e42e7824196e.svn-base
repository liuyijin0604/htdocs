    public function actionTest(){
        $strPhone = $_GET['phone'];
        $strMessage = $_GET['message'];
        
        if($strPhone !== null &&  $strMessage != null){
            ModalSmsNotice::Create($strPhone,$strMessage );
            $this->funcRestResponse(true,null,'success');
        }
        else{
            $this->funcRestResponse(false,null,'?phone=12345&message=string');
        }
        
    }
    
