    public function actionCustomerSubmit(){
        if (!empty($_GET['id'])){
            // echo $_GET['id'];
            // Yii::app()->end();            
            $salesFunnelService = new SalesfunnelRequirementsService;                        
            $requirementRecordModels = SalesfunnelRequirementsRecords::model()->with('question','answer')->findAll(["condition"=>'submit_id =  '.($_GET['id']),"order"=>"t.question_id ASC"]);
            $submissionModel = SalesfunnelRequirementsSubmission::model()->findBypk($_GET['id']);                        
            if ($submissionModel->status != 1){
                $password = $salesFunnelService->randomPassword();
                $submissionModel->password = md5($password);
                $subjectStr = 'New Sales Funnel Requirement from '.$submissionModel->company_name; 
                $salesFunnelService->sendRequirementEmail($submissionModel, $requirementRecordModels, "ray.tang@toplogistics.com.au", $subjectStr, "weijt133@gmail.com");
                $submissionModel->status = 1;
                $submissionModel->save();
                $submissionModel->refresh();                       
                $this->renderPartial('successfully_submit_page', ['submissionModel' => $submissionModel, 'password' => $password]);
            }
            else{
                $this->renderPartial('customer_detail_page');
            }
        }
        else{
            print_r("Submitted unsuccessfully.");
        }
    }

}
