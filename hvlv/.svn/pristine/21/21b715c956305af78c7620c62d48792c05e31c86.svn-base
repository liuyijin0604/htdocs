                        }
                        if($numPostcode==3175){
                            $arrPreMEL1[] = [$dateEta,$strhbn,$refstatus,$numCbm,$strPos,$arrAmazonPo];
                        }elseif($numPostcode==3023){
                            $arrPreMEL5[] = [$dateEta,$strhbn,$refstatus,$numCbm,$strPos,$arrAmazonPo];
                        }
                    }
                }
