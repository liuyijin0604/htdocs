                }
                $xls->addRow($i++,[" "]);
            }
        }


        $xls->createSheet("BWU1&2");
        $xls->goSheet(1);
        $xls->addRow($j++,['Est. delivery date','TLA HBN No','TLA Ref No. + Customs Status','Total CBM','Amazon Shipment Id','Amazon PO']); //,'Total CBM','Pallet','Ctn','Unit'
        $filtersForm = new FiltersForm();
        $reportService = new ReportService();
        $report = $reportService->getFbaReport(106,1,date('Y-m-d'),date('Y-m-d',strtotime("14 day")),$filtersForm,1,0);
        $datas = $report[0]->data;

        foreach($datas as $key=>$data){
            $arrAmazonPo=[];
            if(!empty($data["hbnsOnly"])){

