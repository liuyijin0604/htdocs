<?php 
class TopCourierService extends Service
{
    public function createCargoJob($data,$jobName,$driverId,$description,$dptId,$type,$vehicleId,$region='',$directionforcustomer='',$distance='',$time='',$created='',$destination='',$isCommand = false)
    {
        $model = new CargoProcessJob();
        $errors = [];
        $newCBM = 0;
        foreach ($data as $key => $d) {
            $ca = CargoProcess::model()->findByPk($d[0]);
            $newCBM+= $ca->getTotalCBM();
            $c = CargoProcessJobRelations::model()->count('cargo_process_id=:cId and active = 1',[":cId"=>$d[0]]);
            if($c>0)
            {
                return $model;
            }
        }
        $vehicle= CargoProcessVehicle::model()->findByPk($vehicleId);

        if($newCBM>$vehicle->max_cbm)
        {
            $model->addError('Max CBM:'.$vehicle->max_cbm,'Max CBM:'.$vehicle->max_cbm);
            return $model;
        }

        if(!empty($data))//when there are data transmitted from outside
        {
            $model->job_name = $jobName;
            $model->vehicle_id = $vehicleId;
            $model->region = $region;

            $cdls = CargoProcessJob::$cargoDirectionList;
            $directions = explode(',',$directionforcustomer);
            foreach($cdls as $k => $cdl){
                if(in_array($k,$directions)){
                    $model->mdata[$cdls[$k]] = 1;
                }else{
                    $model->mdata[$cdls[$k]] = 0;
                }
            }

            if(!empty($distance)){
                $model->mdata['distance']=$distance;
            }

            if(!empty($destination)){
                $model->mdata['destination']=$destination;
            }

            if(!empty($time)){
                $model->mdata['time']=$time;
            }

            $model->description = $description;
            if($isCommand)
            {
                $model->status = CargoProcessJob::STATE_NEW;
            }else
            {
                $model->status = CargoProcessJob::STATE_WAITING_WAREHOUSE_PREPARATION;
            }
            $model->dpt_id = $dptId;
            $model->user_id = User::currentUserID();
            if(!empty($created)){
                $model->created = $created;
            }else{
                $model->created = date('Y-m-d H:i:s');
            }
            
            $model->type = $type;

            if(!empty($driverId))
            {
                $model->driver_id = $driverId;
            }
            $model->save();

            if($type == CargoProcessJob::FBA_JOB)
            {
                $ai = AmazonInfo::model()->find('fid = :fid',[':fid'=>$data[0][0]]);
                $newAi = new AmazonInfo();
                if(!empty($ai))
                {
                    $newAi->fid = $model->id;
                    $newAi->model='CargoProcessJob';
                    $newAi->booking_ref = $ai->booking_ref;
                    $newAi->amazon_booking_time = $ai->amazon_booking_time;
                    $newAi->save();
                }
            }

            foreach ($data as $key => $d) {
                $c = CargoProcess::model()->findByPk($d[0]);
                if(empty($c)) continue;
                $re = new CargoProcessJobRelations();
                $re->cargo_process_id = $d[0];
                $re->sequence = $d[1];
                $re->created = date('Y-m-d H:i:s');
                $re->job_id = $model->id;
                $re->save();

                if(($c->mdata['PreB2c']==1 && $c->mdata['PreB2cSendSMS'] ==0)){
                    if($c->shipment->scanCount()>0){
						if(!empty($c->job_relation->job)){
							EmailService::sendScanAndCjobSms($c);
							$time = date('d-m-Y',strtotime($c->job_relation->job->created));
							$c->shipment->addTrackingLimited(105,'Scand. Your delivery is '.$time);
							$c->mdata['PreB2cSendSMS'] = 1;
							$c->save();
						}
					}

                }
            }
        }

        return $model;
    }

    public function saveCargoJob($data,$jobName,$driverId,$description,$jobId,$vehicleId,$directionforcustomer="",$distance="",$time="",$created="",$destination="")
    {
        $model = CargoProcessJob::model()->findByPk($jobId);
        $errors = [];
        if(!empty($data))
        {
            $model->vehicle_id = $vehicleId;
            $model->job_name = $jobName;
            $model->description = $description;
            $model->created = $created;
            $cdls = CargoProcessJob::$cargoDirectionList;
            $directions = explode(',',$directionforcustomer);
            foreach($cdls as $k => $cdl){
                if(in_array($k,$directions)){
                    $model->mdata[$cdls[$k]] = 1;
                }else{
                    $model->mdata[$cdls[$k]] = 0;
                }
            }

            if(!empty($distance)){
                $model->mdata['distance']=$distance;
            }

            if(!empty($destination)){
                $model->mdata['destination']=$destination;
            }

            if(!empty($time)){
                $model->mdata['time']=$time;
            }
            
            if(!empty($driverId))
            {
                $model->driver_id = $driverId;
            }
            
            $model->save();

            foreach ($data as $key => $d) {
                $re = CargoProcessJobRelations::model()->findByPk($d[0]);
                $re->sequence = $d[1];
                $re->cargo_process->mdata['job_pallet_no'] = $d[2];
                $re->cargo_process->mdata['pickup_booking_time'] = $model->created;
                $re->cargo_process->save();
                $re->save();
            }
        }
        return $model;
    }

    public function saveCargoRelationSequence($data,$jobId){
        $model = CargoProcessJob::model()->findByPk($jobId);
