        }

        $arrMelPreWarehouses = ["MEL1"=>$arrPreMEL1,"MEL2"=>$arrPreMEL5];

        foreach ($arrMelPreWarehouses as $name => $arrPreWarehouse) 
		{
            if(!empty($arrPreWarehouse)){
                $xls->addRow($k++,[$name]);
                foreach($arrPreWarehouse as $record){
                    if(!empty($record[5])){
                        foreach($record[5] as $key => $value){
                            if($key==0){
                                $xls->addRow($k++,[$record[0],$record[1],$record[2],$record[3],$record[4],$value]);
                            }else{
                                $xls->addRow($k++,[" "," "," "," "," ",$value]);
                            }
                        }
                    }else{
                        $xls->addRow($k++,[$record[0],$record[1],$record[2],$record[3],$record[4]]);
                    }
                }
            }
		}



        $xls->createSheet("PLAN");
        $xls->goSheet(3);
        $arrTotalCbmEachAddresses = ["BWU1"=>$numOnhandBWU1TotalCbm,"BWU2"=>$numOnhandBWU2TotalCbm,"MEL1"=>$numOnhandMEL1TotalCbm,"MEL5"=>$numOnhandMEL5TotalCbm];

        
        foreach($arrSydPreWarehouses as $name => $arrPreWarehouse){
            $dateThisSunday = date("Y-m-d",strtotime("next Sunday"));
            $numWeek = "WK".date('W',strtotime($dateThisSunday));
            $arrDatePeriod = [date("Y-m-d",strtotime("next Sunday")),date("Y-m-d",strtotime("+1 day",strtotime("next Sunday"))),date("Y-m-d",strtotime("+2 day",strtotime("next Sunday"))),date("Y-m-d",strtotime("+3 day",strtotime("next Sunday"))),date("Y-m-d",strtotime("+4 day",strtotime("next Sunday"))),date("Y-m-d",strtotime("+5 day",strtotime("next Sunday"))),date("Y-m-d",strtotime("+6 day",strtotime("next Sunday")))];
            $arrCbmDaily = [];
            $arrPlt = [];
            $arrUnit = [];
            
            $arrTotalCbmEachAddresses;

            foreach($arrDatePeriod as $key => $date){
                $arrCbmDaily[$key]= self::getTotalCbmOfForcast($date,$arrPreWarehouse);
            }

            $arrtemp = self::setPltPreDay($arrDatePeriod,$arrCbmDaily,$arrTotalCbmEachAddresses[$name]);
            $arrPlt = $arrtemp[0];
            $arrLeft = $arrtemp[1];
            foreach($arrPlt as $strPlt){
                $arrUnit[] = self::PltToUnit($strPlt);
            }

            $xls->addRow($l++,[$numWeek,'Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday']);
            $xls->addRow($l++,['TLA']);
            
            $xls->addRow($l++,[$name,date("d-M",strtotime($dateThisSunday)),date("d-M",strtotime("+1 day",strtotime($dateThisSunday))),date("d-M",strtotime("+2 day",strtotime($dateThisSunday))),date("d-M",strtotime("+3 day",strtotime($dateThisSunday))),date("d-M",strtotime("+4 day",strtotime($dateThisSunday))),date("d-M",strtotime("+5 day",strtotime($dateThisSunday))),date("d-M",strtotime("+6 day",strtotime($dateThisSunday)))]);
            $xls->addRow($l++,['Plt',self::getDescription($arrPlt[0]),self::getDescription($arrPlt[1]),self::getDescription($arrPlt[2]),self::getDescription($arrPlt[3]),self::getDescription($arrPlt[4]),self::getDescription($arrPlt[5]),self::getDescription($arrPlt[6])]);
            $xls->addRow($l++,['Unit',$arrUnit[0],$arrUnit[1],$arrUnit[2],$arrUnit[3],$arrUnit[4],$arrUnit[5],$arrUnit[6]]);
            $xls->addRow($l++,['Total Left',"","","","","","",$arrLeft[6]]);
            $xls->addRow($l++,['']);
            $xls->addRow($l++,['On Hand Plt',self::CbmToPlt($arrTotalCbmEachAddresses[$name])]);
            $xls->addRow($l++,['Forcast Plt',self::CbmToPlt($arrCbmDaily[0]),self::CbmToPlt($arrCbmDaily[1]),self::CbmToPlt($arrCbmDaily[2]),self::CbmToPlt($arrCbmDaily[3]),self::CbmToPlt($arrCbmDaily[4]),self::CbmToPlt($arrCbmDaily[5]),self::CbmToPlt($arrCbmDaily[6])]);
            $xls->addRow($l++,['']);
        }
       
        $xls->goSheet(0);
        return $xls;
    }

    public static function setPltPreDay($arrDatePeriod,$arrCbmDaily,$numTotalCbmOnHand){
        $numleft = 0;
        $arrPlt = [0,0,0,0,0,0,0];
        $arrLeft = [0,0,0,0,0,0,0];
       
        foreach($arrDatePeriod as $key => $arrDate){
            if($key==0){
                $tempTotalPlt = max(self::CbmToPlt($numTotalCbmOnHand) + self::CbmToPlt($arrCbmDaily[$key]),0);
            }else{
                $tempTotalPlt = max(self::CbmToPlt($arrCbmDaily[$key]),0) + max($numleft,0);
            }
            if($tempTotalPlt > 44){
                $arrPlt[$key] = 44;
                $numleft = $tempTotalPlt - 44;
                $arrLeft[$key] = $numleft;
                continue;
            }elseif($tempTotalPlt >=40 && $tempTotalPlt <= 44){
                $arrPlt[$key] = $tempTotalPlt;
                $numleft = 0;
                $arrLeft[$key] = $numleft;
                continue;
            }elseif($tempTotalPlt > 36){
                $arrPlt[$key] = 36;
                $numleft = $tempTotalPlt - 36;
                $arrLeft[$key] = $numleft;
                continue;
            }elseif($tempTotalPlt >= 32 && $tempTotalPlt <= 36){
                $arrPlt[$key] = $tempTotalPlt;
                $numleft = 0;
                $arrLeft[$key] = $numleft;
                continue;
            }elseif($tempTotalPlt > 22){
                $arrPlt[$key] = 22;
                $numleft = $tempTotalPlt - 22;
                $arrLeft[$key] = $numleft;
                continue;
            }elseif($tempTotalPlt >= 19 && $tempTotalPlt <= 22){
                $arrPlt[$key] = $tempTotalPlt;
                $numleft = 0;
                $arrLeft[$key] = $numleft;
                continue;
            }elseif($tempTotalPlt > 14){
                $arrPlt[$key] = 14;
                $numleft = $tempTotalPlt - 14;
                $arrLeft[$key] = $numleft;
                continue;
            }elseif($tempTotalPlt >= 10 && $tempTotalPlt <= 14){
                $arrPlt[$key] = $tempTotalPlt;
                $numleft = 0;
                $arrLeft[$key] = $numleft;
                continue;
            }elseif($tempTotalPlt>0){
                $numleft = $tempTotalPlt;
                $arrLeft[$key] = $numleft;
                continue;
            }
        }
        return [$arrPlt,$arrLeft];
    }

    public static function PltToUnit($plt){
        if($plt>28){
            return 10000;
        }elseif($plt>0){
            return 5000;
        } else{
            return 0;
        }
    }

    public static function getDescription($plt){
        if($plt>22){
            return "(22+".($plt-22).")";
        }elseif($plt>0){
            return "(".$plt.")";
        }else{
            return 0;
        }
    }

    public static function CbmToPlt($cbm){
        return max(ceil($cbm/2),0);
    }

    public static function getTotalCbmOfForcast($date,$arrs){
        if(!empty($date)){
            $numCbm = 0;
            $numWeekday=date("w",strtotime($date));
            if($numWeekday == 0){
                foreach($arrs as $arr){
                    if($arr[0]<=$date){
                        $numCbm += $arr[3];
                    }
                }
            }else{
                foreach($arrs as $arr){
                    if($arr[0]==$date){
                        $numCbm += $arr[3];
                    }
                }
            }
            return $numCbm;
        }
        return 0 ;
    }
}
