    public function saveCargoIntoJob($ids,$jobId)
    {
        $model = CargoProcessJob::model()->findByPk($jobId);
        $errors = [];
        $newCBM = 0;
        $oldCBM = 0;
        foreach ($model->job_relations as $key => $jr) {
            $oldCBM += $jr->cargo_process->getTotalCBM();
        }
        foreach ($ids as $key => $d) {
            $ca = CargoProcess::model()->findByPk($d);
            $newCBM+= $ca->getTotalCBM();
            $c = CargoProcessJobRelations::model()->count('cargo_process_id=:cId and active = 1',[":cId"=>$d]);
            if($c>0)
            {
                return $model;
            }
        }

        // if(($oldCBM+$newCBM)>$model->vehicle->max_cbm)
        // {
        //     $model->addError('Max CBM:'.$model->vehicle->max_cbm,'Max CBM:'.$model->vehicle->max_cbm);
        //     return $model;
        // }
        if(!empty($ids))
        {
            foreach ($ids as $key => $d) {
                $c = CargoProcess::model()->findByPk($d);
                if(empty($c)) continue;
                $c->updateStatus(CargoProcess::WAITINGDELIVERY);

                $re = new CargoProcessJobRelations();
                $re->cargo_process_id = $d;
                $re->sequence = 0;
                $re->created = date('Y-m-d H:i:s');
                $re->job_id = $model->id;
                $re->save();

                if(($c->mdata['PreB2c']==1 && $c->mdata['PreB2cSendSMS'] ==0)){
                    if($c->shipment->scanCount()>0){
						if(!empty($c->job_relation->job)){
							EmailService::sendScanAndCjobSms($c);
							$time = date('d-m-Y',strtotime($c->job_relation->job->created));
							$c->shipment->addTrackingLimited(105,'Scand. Your delivery is '.$time);
							$c->mdata['PreB2cSendSMS'] = 1;
							$c->save();
						}
					}

                }
            }
        }

        return $model;
    }

    public function removeCargoJob($id)
    {
        $cargoRe = CargoProcessJobRelations::model()->findByPk($id);
        $cargoRe->cargo_process->updateStatus(CargoProcess::WAITINGASSIGNDRIVER);
        $model = $cargoRe->job;
        $cargoRe->active = 0;
        $cargoRe->save();
        if( $cargoRe->cargo_process->mdata['AutoIntoJob']==1){
            $emailService = new EmailService();
            $emailService->sendRescheduleSms($cargoRe->cargo_process);
            $cargoRe->cargo_process->mdata['AutoIntoJob']=0;
            $cargoRe->cargo_process->save();
            $cargoRe->cargo_process->shipment->addTrackingLimited(87,'Delivery delayed. waiting for reschedule.');
        }
       
        //$cargoRe->delete();
        return $model;
    }

    public function updateJobStatus($id,$newState)
    {
        $model = CargoProcessJob::model()->findByPk($id);
        if($newState==CargoProcessJob::STATE_WAITING_WAREHOUSE_PREPARATION)
        {
            if($model->status==CargoProcessJob::STATE_NEW)
            {

            }else
            {
                 $jres = CargoProcessJobRelations::model()->findAll(['condition'=>'job_id = :jobId and active = 1','params'=>[":jobId"=>$model->id],'order'=>'sequence']);
                foreach ($jres as $key => $jre)
                {
                     $jre->cargo_process->updateStatus(CargoProcess::WAITINGASSIGNDRIVER);
                }
            }
        }else if($newState==CargoProcessJob::STATE_WAITING_FOR_DELIVERY)
        {
            $jres = CargoProcessJobRelations::model()->findAll(['condition'=>'job_id = :jobId and active = 1','params'=>[":jobId"=>$model->id],'order'=>'sequence']);
            foreach ($jres as $key => $jre)
            {
                $jre->cargo_process->updateStatus(CargoProcess::WAITINGDELIVERY);
                $jre->cargo_process->shipment->addTrackingLimited(73,'Warehouse preparation done. Delivery date is '.date('d-m-Y',strtotime($model->created)));
                $emailService = new EmailService();
                $emailService->sendprepareCargoSms($jre->cargo_process);
                if($model->status==CargoProcessJob::STATE_WAITING_WAREHOUSE_PREPARATION)
                {
                    $jre->cargo_process->addAmazonBookingTime();
                    //$jre->cargo_process->addWaitingPreparationTracking();
                }
            }
        }else if($newState==CargoProcessJob::PROCESSDONE)
        {
            $jres = CargoProcessJobRelations::model()->findAll(['condition'=>'job_id = :jobId and active = 1','params'=>[":jobId"=>$model->id],'order'=>'sequence']);
            foreach ($jres as $key => $jre)
            {
                if($model->type == CargoProcessJob::INTERSTATE_JOB &&  $jre->cargo_process->isOurWarehouse() && !empty($model->mdata['destination']) ){
                    $jre->cargo_process->status = CargoProcess::COLLECTINFO;
                    $jre->cargo_process->mdata["InterstateJobId"] = $id;
                    $jre->cargo_process->setCargoType();
                    $jre->cargo_process->dpt_id = $model->mdata['destination'];
                    $jre->cargo_process->save();
                    $jre->active = 0 ;
                    // $jre->was_interstate = 1 ;
                    $jre->save();
                    $jre->cargo_process->shipment->ddpt_id = $model->mdata['destination'];
                    $jre->cargo_process->shipment->save();
                    $jre->cargo_process->shipment->addTrackingLimited(86,"Arrival to ". Cargoprocess::$Depot[$model->mdata['destination']]." Depot");
                }else{
                    if($model->status==CargoProcessJob::STATE_WAITING_FOR_DELIVERY)
                    {
                        $jre->cargo_process->processDone();
                    }else
                    {
                        $jre->cargo_process->updateStatus(CargoProcess::PROCESSDONE);
                    }
                }
            }
            $model->comp_date = date('Y-m-d H:i:s');
        }else if($newState==CargoProcessJob::DELETED)
        {
            foreach ($model->job_relations as $key => $jr)
            {
               $jr->cargo_process->updateStatus(CargoProcess::WAITINGASSIGNDRIVER);
               $jr->delete();
            }
        }
        $model->status = $newState;
        $model->save();
    }

    public function noticeWarehouseToPrepareCargosByJob($id)
    {
        $job = CargoProcessJob::model()->findByPk($id);
        $cpModels = [];
        $jres = CargoProcessJobRelations::model()->findAll(['condition'=>'job_id = :jobId and active = 1','params'=>[":jobId"=>$job->id],'order'=>'sequence']);
        foreach ($jres as $key => $jre) {
              $jre->cargo_process->noticeWarehouseToPrepare();
        }
        $job->mdata["canBePrepared"]=1;
        $job->save();
        $job->log("noticeWarehouseToPrepare");
        return $job;
    }

    public static function getTruckDeliveryRegions($podId)
    {
        $initDeliveryZone = [];
        $orgRate = OrgRate::model()->find("code = :code and json_value(meta,'$.ddpt_id') = :dptId",[":code"=>ImportChargeCode::AUSTWAY_TRUCK_ZONE_CODE,":dptId"=>$podId]);
        if(!empty($orgRate))
        {
            $zoneMaps = ZoneMap::model()->findAll("org_id = :orgId and zone_id = :zoneId",[":orgId"=>$orgRate->org_id,":zoneId"=>$orgRate->zone_id]);
            foreach ($zoneMaps as $key => $z)
            {
                if(empty($initDeliveryZone[$z->z1]))
                {
                    $initDeliveryZone[$z->z1] = $z->z1;
                }
            }
        }

        return $initDeliveryZone;
    }

    public static function getDriverList($podId)
    {
        $driverType = CargoProcess::getPodDriverType($podId);
        $orgModel= new Org();
        $drivers =[];
        $orgs = $orgModel->findAll(["condition"=>"(cargo_driver_type & ".$driverType.") > 0 and status = 1 ","order"=>'`by` desc']);
        foreach ($orgs as $key => $org) {
            if($org->by!=1)
            {
                $oname = 'A';
            }else
            {
                $oname = 'system';
            }
            $drivers[$org->id] = "(".$oname.")".$org->name;
        }
        return $drivers;
    }

    public static function getVehicleList()
    {
        $vs = CargoProcessVehicle::model()->findAll('status = :status',[':status'=>CargoProcessVehicle::ACTIVE]);
        $vehicles =[];
        foreach ($vs as $key => $v) {
            $vehicles[$v->id] = $v->vehicle_name;
        }
        return $vehicles;
    }

    public function generateCargoProcessJobAuto()
    {
        $initItems = CargoProcess::model()->with(['job_relation','shipment'])->findAll('t.status = :status and job_relation.id is null and t.type=:type and agent_id = 3551',[':status'=>CargoProcess::WAITINGASSIGNDRIVER,':type'=>CargoProcess::NORMAL_CARGO]);
        //putting buttle algorithm
        $orgRate = OrgRate::model()->findByPk(928);
        $zoneMaps = ZoneMap::model()->findAll("org_id = :orgId and zone_id = :zoneId",[":orgId"=>$orgRate->org_id,":zoneId"=>$orgRate->zone_id]);

        $used = true;
        while($used)
        {
            $initButtles = [];
            $initDeliveryZone = [];
            foreach ($zoneMaps as $key => $z)
            {
                if(empty($initDeliveryZone[$z->z1]))
                {
                    $initDeliveryZone[$z->z1] = [$z->pc_lo];
                }else
                {
                    $initDeliveryZone[$z->z1][] = $z->pc_lo;
                }
            }

            foreach ($initDeliveryZone as $key => $dz)
            {
                $initButtles[$key] = CargoProcessVehicle::model()->findByPk(1);
                $initButtles[$key]->dptId = $orgRate->mdata['ddpt_id'];
                $initButtles[$key]->region = $key;
                $initButtles[$key]->deliveryZone = $dz;
            }
            $savedVehicle = [0];
            foreach($initButtles as $k1 => $vehicle)
            {
                foreach($initItems as $k2 => $cargo)
                {
                    if($vehicle->isFull($cargo))
                    {
                        continue;
                    }else
                    {
                        if($vehicle->canDeliver($cargo))
                        {
                            $vehicle->myCargos[] = [$cargo->shipment->getDeliveryDistance(),$cargo];
                            unset($initItems[$k2]);
                        }
                    }
                }

                if($vehicle->canBeSaveToJob())
                {
                    $data =[];
                    $cargos = $vehicle->myCargos;
                    $distance = [];
                    foreach ($cargos as $key => $row)
                    {
                        $distance[$key] = $row[0];
                    }
                    array_multisort($distance, SORT_DESC, $cargos);
                    foreach ($cargos as $kc => $ca) {
                        $data[$kc] = [$ca[1]->id,$kc+1];
                    }
                    $jobName = $vehicle->region.date('YmdHis');
                    $job = $this->createCargoJob($data,$jobName,0,'',$vehicle->dptId,CargoProcessJob::NORMAL_JOB,$vehicle->id,$vehicle->region,"","","",true);
                    if(!empty($job->id))
                    {
                        $savedVehicle[] = $job->id;
                    }
                }
            }
            $size = count($savedVehicle);
            if(($size-1)==0)
            {
                break;
            }
        }
    }

    public function getCargoProcessDeliveryDate($p)
    {
        $cargoProcess = $p->cargo_process;
        if(!empty($cargoProcess))
        {
           $t =  Tracking::model()->find(['condition'=>'type = 90 and pid = :pid','params'=>[":pid"=>$cargoProcess->shipment_id],'order'=>'dt desc']);
           if(!empty($t))
           {
             return $t->dt;
           }
        }

        return '2090-01-01';
    }

