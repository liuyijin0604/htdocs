                    }else{
                        $xls->addRow($j++,[$record[0],$record[1],$record[2],$record[3],$record[4]]);
                    }
                }
            }
		}

        $xls->createSheet("MEL1&5");
        $xls->goSheet(2);
        $xls->addRow($k++,['Est. delivery date','TLA HBN No','TLA Ref No. + Customs Status','Total CBM','Amazon Shipment Id','Amazon PO']);
        $report = $reportService->getFbaReport(218,1,date('Y-m-d'),date('Y-m-d',strtotime("14 day")),$filtersForm,1,0);
        $datas = $report[0]->data;

        foreach($datas as $key=>$data){
            $arrAmazonPo=[];
            if(!empty($data["hbnsOnly"])){

                $strhbns = explode(",",$data["hbnsOnly"]);
                foreach($strhbns as $strhbn){
                    $objImParcel = ImParcel::model()->find('hbn=:hbn',[':hbn'=>$strhbn]);
                    if(!empty($objImParcel)){
                        $numPostcode = $objImParcel->cnee->postcode;
                        if(!empty($objImParcel->consol)){
                            $strState = ImParcel::$states[$objImParcel->status]."/".@Consol::$services[$objImParcel->consol->service];
                        }
                        $hbnstatus = $objImParcel->hbn.":".$strState;
                        $refstatus = $objImParcel->ref.":".$strState;
