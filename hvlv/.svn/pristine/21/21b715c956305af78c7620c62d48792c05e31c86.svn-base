    public function cacheTLDLimitCBM($depot,$cargoType,$reportType)
    {
        $model = new ImParcel('search');
        $model->unsetAttributes();
        $model->cargoProcessPreAlert = ["podId"=>$depot,"cargoType"=>$cargoType];
        $preCargoProcessShipments = $model->search(false, 30, false, false,false,true)->data;
        $cargo=new CargoProcess('search');
        $cargo->unsetAttributes();
        $onListCargoProcessShipments = $cargo->search(false, 30, false, true, $depot, $cargoType,true)->data;

        $provide = [];
        $totalCBM = 0;
        $totalCBMPreAlert3=0;
        $totalCBMPreAlert37=0;
        $totalCBMPreAlert7=0;
        $totalCBMOnHand=0;
        foreach ($preCargoProcessShipments as $key => $value) {
            if(in_array($value->status,[ImParcel::STATE_COURIER,ImParcel::DELIVERED])) continue;
            if(empty($provide[$value->id]))
            {
                $provide[$value->id] = $value->id;
                $etadiff = number_format(HolidayHelper::diffBetweenTwoDays($value->consol->eta,date('Y-m-d')),0,'.','');
                if($etadiff<=3)
                {
                    $totalCBMPreAlert3 += $value->cbm*$value->pkg;

                }elseif($etadiff>3&&$etadiff<=7)
                {
                    $totalCBMPreAlert37 += $value->cbm*$value->pkg;
                }else
                {
                    $totalCBMPreAlert7 += $value->cbm*$value->pkg;
                }
            }
        }

        foreach ($onListCargoProcessShipments as $key => $value) {
            if(in_array($value->shipment->status,[ImParcel::STATE_COURIER,ImParcel::DELIVERED])) continue;
            if(empty($provide[$value->shipment_id]))
            {
                $provide[$value->shipment_id] = $value->shipment_id;
                $totalCBMOnHand += $value->getTotalCBM();
            }
        }
        $totalCBM = $totalCBMPreAlert3+$totalCBMPreAlert37+$totalCBMPreAlert7+$totalCBMOnHand;

        $service = new Service();
        $service->setCacheDataForever($depot."TLDLimitCBM".$cargoType,[$cargoType=>$totalCBM]);
        $reportCache = ReportCache::model()->find('type=:type',[":type"=>$reportType]);
        if(empty($reportCache))
        {
            $reportCache = new ReportCache();
        }
        
        $reportCache->type = $reportType;
        $reportCache->status = 1;
        $reportCache->meta = json_encode($provide);
        $reportCache->create_time = date('Y-m-d H:i:s');
        $reportCache->creater = 1;
        $reportCache->modify_time =  date('Y-m-d H:i:s');
        $reportCache->modifyer = 1;
        $reportCache->save();

        return [$totalCBM,$totalCBMPreAlert7,$totalCBMPreAlert37,$totalCBMPreAlert3,$totalCBMOnHand];

    }

    public static function getFBAPlanBook(){
        $arrDepots = [106,218];
        $arrBWU1 = $arrBWU2 = $arrMEL1 = $arrMEL5 = [];
        $arrPreBWU1 = $arrPreBWU2 = $arrPreMEL1 = $arrPreMEL5 = [];
        $numOnhandBWU1TotalCbm = $numOnhandBWU2TotalCbm = $numOnhandMEL1TotalCbm = $numOnhandMEL5TotalCbm = 0;
