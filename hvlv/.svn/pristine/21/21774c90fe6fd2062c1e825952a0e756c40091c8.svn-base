		// $shipmentHbnStr = "'TMN1474027968','TMN1474028042','TSN1474027884'";		
		$criteria->addCondition("t.	status != ".ImParcel::STATE_CANCELLED);
		$criteria->addCondition(" hbn in ({$shipmentHbnStr}) ");
