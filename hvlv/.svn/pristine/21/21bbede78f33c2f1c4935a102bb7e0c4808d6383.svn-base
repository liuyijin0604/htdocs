<?php 
class ImConsolService extends Service
{
	public function doUbiManifest($ss)
	{
		$err = [];
		$mani = null;
		if (!empty($ss)) {
			$tempShipments = [];
			foreach ($ss as $key => $s) {
				$tempShipments[$s->ref] = $s;
			}

			foreach ($ss as $key => $sObj)
			{
				$ubi=new UbiAPI(false, false);
				$re = $ubi->updateShipmentWeight([$sObj]);
				if (is_object($re))
				{
					if ($re->status=="Succeeded")
					{
						$sObj->mdata['updated_ubi_weight'] = 1;
						$sObj->save();
						$result=$ubi->manifest([$sObj]);
						if (is_object($result)) {
							if ($result->status=="Failure"||$result->status=='Failed'||$result->status=="Partial Success") {
								$err[]=$result->message;
							}else
							{
								$shipmentRef = $result->data[0];
								$transaction = Yii::app()->db->beginTransaction();
								try {
									$ref= substr($shipmentRef->trackingNo, 0, -11);
									$s=$tempShipments[$ref];
									$trans = $s->trans;
									$tranship = end($trans);
									$orgId = $tranship->org_id;
									$tranship->mdata['oid'] = Org::ORGID_COURIER_UBI;
									$tranship->cost= number_format($ubi->getCost($s), 2, '.', '');
									$tranship->save();

									if(empty($mani))
									{
										$mani = new Manifest;
										$mani->type = 90;
										$mani->fwd_id = $orgId;
										$mani->ref = date('Y-m-d');
										$mani->save();
									}
									$mm = new ManiMap;
									$mm->mani_id = $mani->id;
									$mm->fid = $s->id;
									$mm->model = 'ImParcel';
									$mm->status = 10;
									$mm->mdata['mani_time'] = date('Y-m-d H:i:s');
									$mm->save();
									$s->mdata['manifest_weight'] = ceil($s->weight);
									$s->save();
									$transaction->commit();
								} catch (Exception $ex) {
									$transaction->rollback();
									Log::log2file("UBI".$cn->no."=>".$ex->getMessage(), "transaction_err_log", "transaction");
									throw $ex;
								}
							}
						}
					}
				}
			}
		}
		return $err;
	}

	public function doUbiAupostManifest($ssa)
	{
		$ss = [];
		$err = [];
		foreach ($ssa as $s) {
			$isRTS = ShipmentRtsRecordConfirm::model()->count("new_id = :nid",[":nid"=>$s->id]);
			if ((((in_array($s->status, ImParcel::$allow_manifest_states)&&$s->getOutPkg() > 0)|| $cn->owner_id == Org::ORGID_CLIENT_TLA)&&!empty($s->trans)) ||$isRTS>0)
			{
				$trans = $s->trans;
				$tran = end($trans);

			  if ($tran->connote==$s->ref&&!isset($tran->mdata['oid'])&&($tran->org_id==Org::ORGID_COURIER_UBI)) { // if upload manifest before, we don't send again
					$orgRate = OrgRate::model()->findByPk($s->mdata['org_rate_id']);
					if(preg_match('/TOLL/i', $orgRate->code)) continue;
				  	$ss[] = $s;
			  }
		  	}
		}
		$max_ppg = 300;
		$pgs = ceil(count($ss) / $max_ppg);
		for($pg = 0; $pg < $pgs; $pg++){
			$shipments = array_slice($ss, $pg * $max_ppg, $max_ppg);
			$err = array_merge($err, $this->doUbiManifest($shipments));
		}
		return $err;
	}

	public function doFLHunterManifest($ssa){
		if(empty($ssa)) return [];
		$err = [];
		if(!empty($ssa)){
			$tempShipments = [];
			$ss = [];
			foreach ($ssa as $key => $s) {
				if(!empty($s->trans))
				{
					$trans = $s->trans;
					$endTrans = end($trans);
					if($endTrans->org_id ==Org::ORGID_COURIER_FL)
					{
						$tempShipments[$s->ref] = $s;
						$ss[] = $s;
					}
				}
			}
			if(empty($ss)) return [];
			try{
				$transaction = Yii::app()->db->beginTransaction();
				$flhunter = new FLHunterFTP();
				$csvNamePath = $flhunter->manifest($ss);
				if(!empty($csvNamePath)){
					$flhunter->connect();
					//$strUrlPrefix = 'https://' . $_SERVER['HTTP_HOST'];
					$strCsvFile = 'FLLPTL'.date('Y-m-dH-i-s').'.csv';
					if($flhunter->put($strCsvFile,$csvNamePath)){
						foreach($ss as $key =>$s){
							$orgId = $s->trans[0]->org_id;
							$orgRate = OrgRate::model()->findByPk($s->mdata['org_rate_id']);
							//$code = $orgRate->code;
							if(empty($mani)){
								$mani = new Manifest;
								$mani->type = 90;
								$mani->fwd_id = $orgId;
								$mani->ref = date('Y-m-d');
								$mani->save();
							}
							$mm = new ManiMap;
							$mm->mani_id = $mani->id;
							$mm->fid = $s->id;
							$mm->model = 'ImParcel';
							$mm->status = 10;
							$mm->mdata['mani_time'] = date('Y-m-d H:i:s');
							$mm->save();
							$trans = $s->trans;
							$tranship = end($trans);
							$tranship->mdata['oid'] = $strCsvFile;
							$tranship->status = 11;
							$tranship->save();
							//$tranship->cost= number_format($mytollAPI->getCost($s->mdata['org_rate_id'], $s->cnee->suburb, $s->cnee->postcode, $s->weight)->data, 2, '.', '');
							$s->mdata['manifest_weight'] = ceil($s->weight);
							$s->save();
						}
						$transaction->commit();
						return [];
					}else{
						return [$flhunter->get_error()];
					}
				}	
			}catch(Exception $ex){
				$transaction->rollback();
				Log::log2file("FLHunter =>".$ex->getMessage(), "transaction_err_log", "transaction");
				Emailog::sendEmailTo(Emailog::NOTIFY_OP_EMAIL, "FLHunter =>".$ex->getMessage(), "FL Hunter Manifest ERROR");
			}
		}
		return $err;
	}

	public function doUbiTollManifest($ss)
	{
		return $this->doUbiCourierManifest($ss);
	}
	public function doUbiCourierManifest($ssa)
	{
		$err = [];
		if (!empty($ssa)) {
			$tempShipments = [];
			$ss = [];
			foreach ($ssa as $key => $s) {
				if(!empty($s->trans))
				{
					$trans = $s->trans;
					$endTrans = end($trans);
					if($endTrans->org_id ==Org::ORGID_COURIER_UBI_TOLL)
					{
						$orgRate = OrgRate::model()->findByPk($s->mdata['org_rate_id']);
						if(preg_match('/LOCAL/i', $orgRate->code)) continue;
						$tempShipments[$s->ref] = $s;
						$ss[] = $s;
					}
				}
			}
			if(empty($ss)) return $err;
			$ubi=new EtowerAPI(false, false);
			// $ubi->updateShipment($ss);
			$result=$ubi->manifest($ss);
			if (is_object($result)) {
				if ($result->status=="Failure"||$result->status=="Partial Success") {
					$err[]=$result->message;
				}else
				{
					$result = $result->data;
					$transaction = Yii::app()->db->beginTransaction();
					try {
						
						foreach ($result as $shipmentRef) {
							$ref= $shipmentRef->trackingNo;
							$pb = ParcelBarcode::model()->find('sub_ref=:subRef',[":subRef"=>$ref]);
							if(empty($pb))
							{
								$s=$tempShipments[$ref];
							}else
							{
								$s=$tempShipments[$pb->main_ref];
							}
							$trans = $s->trans;
							$tranship = end($trans);
							$orgId = $tranship->org_id;
							$tranship->mdata['oid'] = Org::ORGID_COURIER_UBI;
							$cost = $ubi->getCost($s->mdata['org_rate_id'], $s->cnee->suburb, $s->cnee->postcode, $s->getCubeWeight());
							if($cost->code == 0)
							{
								$tranship->cost= number_format($cost->data, 2, '.', '');
							}
							$tranship->save();

							if(empty($mani))
							{
								$mani = new Manifest;
								$mani->type = 90;
								$mani->fwd_id = $orgId;
								$mani->ref = date('Y-m-d');
								$mani->save();
							}
							$mm = new ManiMap;
							$mm->mani_id = $mani->id;
							$mm->fid = $s->id;
							$mm->model = 'ImParcel';
							$mm->status = 10;
							$mm->mdata['mani_time'] = date('Y-m-d H:i:s');
							$mm->save();
							$s->mdata['manifest_weight'] = ceil($s->weight);
							$s->save();



						}
						$transaction->commit();
					} catch (Exception $ex) {
						$transaction->rollback();
						Log::log2file("UBI".$cn->no."=>".$ex->getMessage(), "transaction_err_log", "transaction");
						Emailog::sendEmailTo(Emailog::NOTIFY_OP_EMAIL, "UBI".$cn->no."=>".$ex->getMessage(), "UBI COURIER Manifest ERROR");
						throw $ex;
					}
				}
			}
		}
		if(!empty($err))
		{
			Emailog::sendEmailTo(Emailog::NOTIFY_OP_EMAIL, join(',',$err), "UBI COURIER Manifest ERROR");
		}
		return $err;
	}

	public function doMyTollManifest($ss)
	{
		$ssSyd = [];
		$ssMel = [];
		$ssBne = [];
		$ssPer = [];
		$err = [];
		if (!empty($ss)) {
			foreach ($ss as $key => $s) {
				foreach ($s->trans as $key => $t) {
					if(in_array($t->org_id,[Org::ORGID_COURIER_TOLL_IPEC]))
					{
						$orgRate = OrgRate::model()->findByPk($s->mdata['org_rate_id']);
						$code = $orgRate->code;
						switch ($code) {
							case ImportChargeCode::MYTOLL_SYD_CODE:
								$ssSyd[] = $s;
								break;
							case ImportChargeCode::MYTOLL_MEL_CODE:
								$ssMel[] = $s;
								break;
							case ImportChargeCode::MYTOLL_BNE_CODE:
								$ssBne[] = $s;
								break;
							case ImportChargeCode::MYTOLL_PER_CODE:
								$ssPer[] = $s;
								break;
							default:
								break;
						}

						break;
					}
					# code...
				}
			}
			if(!empty($ssSyd))
			{
				$thisErr = $this->doMyTollManifestSS($ssSyd);
				$err = array_merge($err,$thisErr);
			}

			if(!empty($ssMel))
			{
				$thisErr = $this->doMyTollManifestSS($ssMel);
				$err = array_merge($err,$thisErr);
			}

			if(!empty($ssBne))
			{
				$thisErr = $this->doMyTollManifestSS($ssBne);
				$err = array_merge($err,$thisErr);
			}

			if(!empty($ssPer))
			{
				$thisErr = $this->doMyTollManifestSS($ssPer);
				$err = array_merge($err,$thisErr);
			}

		}
		return $err;
	}
	
	public function doMyTollManifestSS($ss)
	{
		$err = [];
		foreach ($ss as $key => $s) {
			$orgId = $s->trans[0]->org_id;
			$orgRate = OrgRate::model()->findByPk($s->mdata['org_rate_id']);
			$code = $orgRate->code;
			$mytollAPI=MyTollAPI::getAPIInstanceByCode($code);
			$result=$mytollAPI->manifestShipment([$s]);
			foreach ([$s] as $key => $s) {
				if(empty($result->TollMessage->ResponseMessages)||empty($result->TollMessage->ResponseMessages->ResponseMessage[0])||empty($result->TollMessage->ResponseMessages->ResponseMessage[0]->ResponseID)||empty($result->TollMessage->ResponseMessages->ResponseMessage[0]->ResponseID->Value)||$result->TollMessage->ResponseMessages->ResponseMessage[0]->ResponseID->Value!="200"||!empty($result->TollMessage->ErrorMessages))
				{
					$err[]=$s->ref.json_encode($result->TollMessage->ErrorMessages)."Failed";
				}else
				{   
					if(empty($mani))
					{
						$mani = new Manifest;
						$mani->type = 90;
						$mani->fwd_id = $orgId;
						$mani->ref = date('Y-m-d');
						$mani->save();
					}
					$transaction = Yii::app()->db->beginTransaction();
					try {
							$mm = new ManiMap;
							$mm->mani_id = $mani->id;
							$mm->fid = $s->id;
							$mm->model = 'ImParcel';
							$mm->status = 10;
							$mm->mdata['mani_time'] = date('Y-m-d H:i:s');
							$mm->save();
							$trans = $s->trans;
							$tranship = end($trans);
							$tranship->mdata['oid'] = Org::ORGID_COURIER_TOLL_IPEC;
							$tranship->status = 11;
							$tranship->cost= number_format($mytollAPI->getCost($s->mdata['org_rate_id'], $s->cnee->suburb, $s->cnee->postcode, $s->weight)->data, 2, '.', '');
							$s->mdata['manifest_weight'] = ceil($s->weight);
							$s->save();
							$tranship->save();
							$transaction->commit();
					} catch (Exception $ex) {
						$transaction->rollback();
						Log::log2file("MyToll".$cn->no."=>".$ex->getMessage(), "transaction_err_log", "transaction");
						Emailog::sendEmailTo(Emailog::NOTIFY_OP_EMAIL, "MyToll".$cn->no."=>".$ex->getMessage(), "My TOLL Manifest ERROR");
						throw $ex;
					}
				}
			}
		}
		
		if(!empty($err))
		{
			Emailog::sendEmailTo(Emailog::NOTIFY_OP_EMAIL, join(',',$err), "My TOLL Manifest ERROR");
		}
			
		return $err;
	}

	public function doMyBorderManifest($ssr)
	{
		$ss = [];
		foreach ($ssr as $key1 => $s)
		{
			$trans = $s->trans;
			$endTrans = end($trans);
			if(in_array($endTrans->org_id,[Org::ORGID_COURIER_BORDER]))
			{
				$ss[] = $s;
			}
		}

		if(!empty($ss))
		{
			[$sftp,$loginResult] = BorderAPI::getSFTP();
		}
		$err = [];
		foreach ($ss as $index => $s) {
			$myborderAPI=BorderAPI::getAPIInstance($s->mdata['org_rate_id']);
			$man_no=$myborderAPI->ftpManifest($s,$index,$sftp,$loginResult);
			if(!empty($man_no))
			{
				//update tranship
				$transaction = Yii::app()->db->beginTransaction();
				try{
					$trans = $s->trans;
					$endTrans = end($trans);
					if($endTrans->status == 10) $endTrans->status = 19;
					$endTrans->mdata['oid'] = $man_no;
					$endTrans->save();

					$mani = new Manifest;
					$mani->type = 90;
					$mani->fwd_id = Org::ORGID_COURIER_BORDER;
					$mani->ref = $man_no;
					$mani->save();

					$mm = new ManiMap;
					$mm->mani_id = $mani->id;
					$mm->fid = $s->id;
					$mm->model = 'ImParcel';
					$mm->save();


					$transaction->commit();
				} catch (Exception $ex) {
					$transaction->rollback();
					throw $ex;
				}

			}else
			{
				$err[] = $s->ref." unknown manifest error";
			}
		}
		
		if(!empty($err))
		{
			Emailog::sendEmailTo(Emailog::NOTIFY_OP_EMAIL, join(',',$err), "My Border Manifest ERROR");
		}
			
		return $err;
	}

	public function doHvlvJavaManifest($ssr)
	{
		$err = [];
		$ssArr = [];
		foreach ($ssr as $key1 => $s)
		{
			$trans = $s->trans;
			$endTrans = end($trans);
			if(!empty($endTrans->mdata['java_gen']))
			{
				$orgRate = OrgRate::model()->findByPk($s->mdata['org_rate_id']);
				$type = HvlvJavaAPI::RATE_TYPE[$orgRate->mdata['ddpt_id']];
				$courier = $orgRate->mdata['courier'];
				$ssArr[$type."_".$courier][] = $s;
			}
		}

		$err = [];
		$mani = null;
		foreach ($ssArr as $key => $ss) {
			$type = explode("_",$key)[0];
			$courier = explode("_",$key)[1];
			$javaApi = new HvlvJavaAPI($type,$courier);
			foreach ($ss as $i => $s) {
				$result=$javaApi->manifestShipment($s);
				if($result['code']!="60000")
				{
					$err[] = $s->ref." unknown manifest error:".join(',',$result['data']);
				}else
				{
					$trans = $s->trans;
					$endTrans = end($trans);
					if($endTrans->status == 10) $endTrans->status = 19;
					if(!empty($result['data']['jobNumber']))
					{
						$endTrans->mdata['oid'] = $result['data']['jobNumber'];
					}else
					{
						$endTrans->mdata['oid'] = $courier."_java_manifest";
					}
					$endTrans->save();

					if(empty($mani))
					{
						$mani = new Manifest;
						$mani->type = 90;
						$mani->fwd_id = Org::ORGID_COURIER_ALLIED_TOP;
						$mani->ref = "YmdHis".$key;
						$mani->save();
					}
				}
			}

		}
		
		if(!empty($err))
		{
			//Emailog::sendEmailTo(Emailog::NOTIFY_OP_EMAIL, join(',',$err), "My Allied Manifest ERROR");
		}
			
		return $err;
	}


