<?php


class BookingController extends Controller
{
	public $skipAcl = ['deliveryBooking', 'generateUUid', 'cancelBooking', 'editBooking', 'deliveryBooking', 'checkList', 'createBooking', 'selectTime', 'winitBooking', 'cargoConfirm','cargoConfirmValidate', 'makeSupay', 'changeAddressFee', 'availableJob', 'customerView', 'checkAddressBook'];

	public $defaultAction = 'deliveryBooking';

	public function actionGetDeliveryRecordList()
	{
		$model = new DeliveryRecord('search');
		$model->unsetAttributes();
		$this->render('deliveryRecordList', ["model" => $model]);
	}

	public function actionDeliveryBooking()
	{
		$this->layout = 'wmaBooking';
		$model = new DeliveryRecord('search');
		$model->unsetAttributes();
		if (!empty($_GET['DeliveryRecord'])) {
			$model->setAttributes($_GET['DeliveryRecord']);
		}

		$model->uuid = empty($_GET['DeliveryRecord']['uuid']) ? "undefined" : $_GET['DeliveryRecord']['uuid'];
		$this->render('deliveryBooking', ["model" => $model]);
	}

	public function actionWinitBooking()
	{
		if (!empty($_POST['caref'])) {
			$caref = $_POST['caref'];
			$p = ImParcel::model()->find('ref = :ref', [":ref" => $caref]);
			if (!empty($p)) {
				$cargoProcess = $p->cargo_process;
			} else {
				$cargoProcess = CargoProcess::model()->find("json_value(t.meta,'$.caref') = :caref", [":caref" => $caref]);
			}
			if (!empty($cargoProcess) && empty($cargoProcess->mdata['confirm_winit_booking'])) {
				$cargoProcess->mdata['confirm_winit_booking'] = 1;;
				$cargoProcess->save();
				echo '<script>alert("Done");</script>';
				return;
			} else {
				echo '<script>alert("Done");</script>';
				return;
			}
		}

		if (!empty($_GET['caref'])) {
			$caref = $_GET['caref'];
			$this->layout = 'wmaWinitBooking';
			$p = ImParcel::model()->find('ref = :ref', [":ref" => $caref]);
			if (!empty($p)) {
				$cargoProcess = $p->cargo_process;
			} else {
				$cargoProcess = CargoProcess::model()->find("json_value(t.meta,'$.caref') = :caref", [":caref" => $caref]);
			}

			if (!empty($cargoProcess)) {

				$warehouseCName = SystemSetting::getWarehouseCNameArr();

				if (in_array($cargoProcess->shipment->mdata['delivery_address'], SystemSetting::getWinitDeliveryAddressArr())) {
					$this->render('winitBooking', ["model" => $cargoProcess, "CNAME" => $warehouseCName[0]->CName, "NAME" => $warehouseCName[0]->Name]);
				} elseif (in_array($cargoProcess->shipment->mdata['delivery_address'], SystemSetting::get4PXDeliveryAddressArr())) {
					$this->render('winitBooking', ["model" => $cargoProcess, "CNAME" => $warehouseCName[1]->CName, "NAME" => $warehouseCName[1]->Name]);
				} elseif (in_array($cargoProcess->shipment->mdata['delivery_address'], SystemSetting::getPadstowDeliveryAddressArr())) {
					$this->render('winitBooking', ["model" => $cargoProcess, "CNAME" => $warehouseCName[2]->CName, "NAME" => $warehouseCName[2]->Name]);
				} elseif (in_array($cargoProcess->shipment->mdata['delivery_address'], SystemSetting::getGoodCangDeliveryAddressArr())) {
					$this->render('winitBooking', ["model" => $cargoProcess, "CNAME" => $warehouseCName[3]->CName, "NAME" => $warehouseCName[3]->Name]);
				} else {
					$this->render('winitBooking', ["model" => $cargoProcess, "CNAME" => $warehouseCName[4]->CName, "NAME" => $warehouseCName[4]->Name]);
				}
				//$this->render('winitBooking', ["model" => $cargoProcess]);
			}
		}
	}

	public function actionAvailableJob()
	{
		if (isset($_POST['delivery_time'])) {
			$caref = $_GET['caref'];
			$p = ImParcel::model()->find('ref = :ref', [":ref" => $caref]);
			$cargoProcess = $p->cargo_process;
			// C-job Delivery Time
			if (!isset($cargoProcess->mdata['customer_confirmed']['catgo_process_job'])) {
				$numJobId = $_POST['delivery_time'];
				$objJob = CargoProcessJob::model()->findByPk($numJobId);
				$objVehicle = CargoProcessVehicle::model()->findByPk($objJob->vehicle_id);
				$numMaxCbm = $objVehicle->max_cbm;

				$numCurrentCbm = $cargoProcess->getTotalCBM();
				$listRelation = CargoProcessJobRelations::model()->findAll('job_id = :job_id and active = 1', [':job_id' => $objJob->id]);

				foreach ($listRelation as $objRelation) {
					$objCargoProcess = $objRelation->cargo_process;
					$numCurrentCbm += $objCargoProcess->getTotalCBM();
				}

				if ($numCurrentCbm > $numMaxCbm) {
					echo json_encode(['isSuccess' => false, 'strMessage' => 'delivery_time']);
					return;
				}

				// save to relation
				$objCargoProcessJobRelations = new CargoProcessJobRelations;
				$objCargoProcessJobRelations->job_id = $objJob->id;
				$objCargoProcessJobRelations->cargo_process_id = $cargoProcess->id;
				$objCargoProcessJobRelations->created = date('Y-m-d h:i:s');
				$objCargoProcessJobRelations->sequence = 1;
				$objCargoProcessJobRelations->save();

				$cargoProcess->mdata['customer_confirmed']['catgo_process_job'] = $objJob->job_no;
				$cargoProcess->mdata['pickup_booking_time']= $objJob->created;
				$cargoProcess->status = CargoProcess::WAITINGDELIVERY;
				$cargoProcess->save();
				echo json_encode(['isSuccess' => true,]);
			}
			return;
		}

		$caref = $_GET['caref'];
		$p = ImParcel::model()->find('ref = :ref', [":ref" => $caref]);
		$cargoProcess = $p->cargo_process;

		$objCargoProcessJob = new CargoProcessJob;
		$listJob = $objCargoProcessJob->getAvailableJob($cargoProcess->id);
		echo json_encode(['isSuccess' => true, 'listJob' => $listJob]);
	}

	public function actionCustomerView()
	{

		$this->layout = 'wmaCustomerCheck';

		if (!empty($_POST['postcode'])) {
			$caref = $_GET['caref'];
			$p = ImParcel::model()->find('ref = :ref', [":ref" => $caref]);
			if (!empty($p)) {
				//4352
				if ($p->postcode == $_POST['postcode']) {
					$cargoProcess = $p->cargo_process;
					if (!empty($cargoProcess)) {
						// already manually add to c job
						if (CargoProcessJobRelations::model()->find('cargo_process_id=:cid and active = 1', [':cid' => $cargoProcess->id]) != null) {
							$this->render('cargo_customer_check', ["caref" => $caref, "model" => $cargoProcess]);
							return;
						}
					}
				} else {
					$message = 'The postcode you provided is not matching. Please input the correct one.';
					$this->render('cargo_customer_check', ["caref" => $caref, "message" => $message]);
					return;
				}
			} else {
				$message = 'The tracking number you provided is not found.';
				$this->render('cargo_customer_check', ["caref" => $caref, "message" => $message, "inputpostcode" => 'false']);
				return;
			}
		}

		if (!empty($_GET['caref'])) {
			$caref = $_GET['caref'];
			$p = ImParcel::model()->find('ref = :ref', [":ref" => $caref]);
			if (!empty($p)) {
				$cargoProcess = $p->cargo_process;
			} else {
				$cargoProcess = CargoProcess::model()->find("json_value(t.meta,'$.caref') = :caref", [":caref" => $caref]);
			}

			if (!empty($cargoProcess)) {
				// already manually add to c job
				if (CargoProcessJobRelations::model()->find('cargo_process_id=:cid and active = 1', [':cid' => $cargoProcess->id]) != null) {
					$this->render('cargo_customer_check', ["caref" => $caref]);
					return;
				}
			} else {
				$message = 'The tracking number you provided is not found.';
				$this->render('cargo_customer_check', ["caref" => $caref, "message" => $message, "inputpostcode" => 'false']);
				return;
			}
		}
	}
	public function actionCargoConfirmValidate()
	{
		$this->layout = 'wmaWinitBooking';
		$caref = $_GET['caref'];
		$p = ImParcel::model()->find('ref = :ref', [":ref" => $caref]);
		echo "<script>function postcodeVeryfi() {
        var postcode;
        var systempostcode = '{$p->cnee->postcode}'
        postcode = prompt('Enter Your Postcode.')
        if (systempostcode == postcode) {
            window.location.href='https://book.toplogistics.com.au/cargoConfirm?caref={$caref}';
        } else {
            return false;
        }
        return false;
    }
    postcodeVeryfi();</script>";
	}

	public function actionCargoConfirm()
	{
		$this->layout = 'wmaWinitBooking';

		if (!empty($_POST['caref'])) {
			$caref = $_POST['caref'];
			$p = ImParcel::model()->find('ref = :ref', [":ref" => $caref]);
			if (!empty($p)) {
				$cargoProcess = $p->cargo_process;
			} else {
				$cargoProcess = CargoProcess::model()->find("json_value(t.meta,'$.caref') = :caref", [":caref" => $caref]);
			}

			$shipment = ImParcel::model()->findByPk($cargoProcess->shipment_id);
			if (!empty($shipment) && !empty($shipment->cnee)) {
				$tel = Addr::auPhoneValid($shipment->cnee->tel);
				if (!empty($tel)) {
					$addressBook = CargoAddressBook::model()->findByAttributes(array('tel' => $tel, 'status' => 1));
					if (empty($addressBook)) {
						$addressBook = new CargoAddressBook();
					}
					$addressBook->tel = $tel;
					$addressBook->status = 1;
					switch ($_POST['address_type']) {
						case 'apartment':
							$addressBook->type = CargoAddressBook::ADDRESS_TYPE_APARTMENT;
							$addressBook->mdata['address_type'] = CargoAddressBook::ADDRESS_TYPE_APARTMENT;
							break;
						case 'house/townhouse':
							$addressBook->type = CargoAddressBook::ADDRESS_TYPE_HOUSE;
							$addressBook->mdata['address_type'] = CargoAddressBook::ADDRESS_TYPE_HOUSE;
							break;
						case 'warehouse/logistic/storagecenter':
							$addressBook->type = CargoAddressBook::ADDRESS_TYPE_WAREHOUSE;
							$addressBook->mdata['address_type'] = CargoAddressBook::ADDRESS_TYPE_WAREHOUSE;
							break;
						case 'shoproadside':
							$addressBook->type = CargoAddressBook::ADDRESS_TYPE_SHOP_ROADSIDE;
							$addressBook->mdata['address_type'] = CargoAddressBook::ADDRESS_TYPE_SHOP_ROADSIDE;
							break;
						case 'shop':
							$addressBook->type = CargoAddressBook::ADDRESS_TYPE_SHOP_SHOPPING_CENTRE;
							$addressBook->mdata['address_type'] = CargoAddressBook::ADDRESS_TYPE_SHOP_SHOPPING_CENTRE;
							break;
						case 'office':
							$addressBook->type = CargoAddressBook::ADDRESS_TYPE_OFFICE_BUILDING;
							$addressBook->mdata['address_type'] = CargoAddressBook::ADDRESS_TYPE_OFFICE_BUILDING;
							break;
					}
					if (!empty($_POST['leave_at_address']) && $_POST['leave_at_address'] == 'yes') {
						$addressBook->mdata['authorize_to_leave'] = 1;
					} else {
						$addressBook->mdata['authorize_to_leave'] = 0;
					}
					if ($_POST['inputIsUnloadingBusiness']) {
						if ($_POST['business_unloading_0'] == 'fork') {
							$addressBook->mdata['has_folklift'] = 1;
							$addressBook->mdata['need_unloading_service'] = 0;
						} else if ($_POST['business_unloading_1'] == 'self') {
							$addressBook->mdata['has_folklift'] = 0;
							$addressBook->mdata['need_unloading_service'] = 0;
						} else if ($_POST['business_unloading_1'] == 'hand_unloading_service') {
							$addressBook->mdata['has_folklift'] = 0;
							$addressBook->mdata['need_unloading_service'] = 1;
						} else if ($_POST['business_unloading_1'] == 'unloading_service_overweight') {
							$addressBook->mdata['has_folklift'] = 0;
							$addressBook->mdata['need_unloading_service'] = 1;
						} else if ($_POST['business_unloading_1'] == 'hand_unloading_service_oversize'){
							$addressBook->mdata['has_folklift'] = 0;
							$addressBook->mdata['need_unloading_service'] = 1;
						}
					}
					if (!empty($_POST['business_open']) && !empty($_POST['business_close'])) {
						$addressBook->mdata['open'] = $_POST['business_open'];
						$addressBook->mdata['close'] = $_POST['business_close'];
					}
					$addressBook->save();
				}
			}

			if (empty($cargoProcess->mdata['customer_confirmed'])) {
				$cargoProcess->mdata['customer_confirmed'] = [];
				$cargoProcess->mdata['customer_confirmed']['address_type'] = $_POST['address_type'];

				if(!empty($_POST['preferred_date'])){
					$cargoProcess->mdata['customer_confirmed']['preferred_date'] = $_POST['preferred_date'];
				}
				if(!empty($_POST['preferred_time'])){
					$cargoProcess->mdata['customer_confirmed']['preferred_time'] = $_POST['preferred_time'];
				}

				// if ($_POST['inputIsUnloadingResidentialWeight']) {
				// 	if ($_POST['residential_unloading'] == 'hand_unloading_service') {
				// 		$cargoProcess->mdata['customer_confirmed']['residential_unloading'] = 'We need hand unloading service';
				// 	} else if ($_POST['residential_unloading'] == 'self') {
				// 		$cargoProcess->mdata['customer_confirmed']['residential_unloading'] = 'We can unload ourselves';
				// 	} else if ($_POST['residential_unloading'] == 'unloading_service_overweight') {
				// 		$cargoProcess->mdata['customer_confirmed']['residential_unloading'] = 'We need hand unloading service, over weight';
				// 	}
				// }

				if ($_POST['inputIsUnloadingResidential']) {
					$cargoProcess->mdata['customer_confirmed']['leave_at_address'] = 'Leave at address : ' . $_POST['leave_at_address'];
				}

				if ($_POST['inputIsUnloadingBusiness']) {
					if ($_POST['business_unloading_0'] == 'fork') {
						$cargoProcess->mdata['customer_confirmed']['business_unloading'] = 'We have forklift';
					} else if ($_POST['business_unloading_1'] == 'self') {
						$cargoProcess->mdata['customer_confirmed']['business_unloading'] = 'We can unload ourselves';
					} else if ($_POST['business_unloading_1'] == 'hand_unloading_service') {
						$cargoProcess->mdata['customer_confirmed']['business_unloading'] = 'We need hand unloading service';
					} else if ($_POST['business_unloading_1'] == 'unloading_service_overweight') {
						$cargoProcess->mdata['customer_confirmed']['business_unloading'] = 'We need hand unloading service, over weight';
					} else if ($_POST['business_unloading_1'] == 'hand_unloading_service_oversize'){
						$cargoProcess->mdata['customer_confirmed']['business_unloading'] = 'We need hand unloading service, over size';
						$cargoProcess->sub_type = 8192;
					}
				}

				if (isset($_POST['cb_unloading_street'])) {
					$cargoProcess->mdata['customer_confirmed']['unloading_street'] = 'Manually unloading only to street level';
				}
				if (isset($_POST['cb_unloading_unpack'])) {
					$cargoProcess->mdata['customer_confirmed']['unloading_unpack'] = 'Unpack boxes';
				}
				if (isset($_POST['cb_unloading_rabbish'])) {
					$cargoProcess->mdata['customer_confirmed']['unloading_rabbish'] = 'Dumping rabbish';
				}

				if (!empty($_POST['other_inquery'])) {
					$cargoProcess->mdata['customer_confirmed']['OtherInquery'] = $_POST['other_inquery'];
					$cargoProcess->mdata['other_inquery'] = $_POST['other_inquery'];
				}

				if (isset($_POST['current_delivery_time'])) {
					$cargoProcess->mdata['customer_confirmed']['current_delivery_time'] = $_POST['current_delivery_time'];
				}


				$cargoProcess->mdata['customer_confirmed_summary'] = $_POST['summary'];

				// create invoice if surcharge
				if (
					$_POST['inputIsChangeAddress'] ||
					isset($_POST['cb_unloading_street']) ||
					isset($_POST['cb_unloading_unpack']) ||
					isset($_POST['cb_unloading_rabbish']
					)
				) {
					$objInvoice = new Invoice;
					$objInvoice->to_id = Org::ORGID_IMPORT_CASUAL_CUSTOMER; //Org TLA casual
					$objInvoice->dpt_id = $p->ddpt_id;
					$objInvoice->dpmt = Invoice::DPMT_COURIER_SERVICE;
					$objInvoice->status = Invoice::INVOICE_STATUS_POSTED;
					$objInvoice->type = Invoice::INVOICE_TYPE_OTHERS;
					$objInvoice->currency = Invoice::CURRENCY_AUD;

					// paypal redirect
					$strUrlPrefix = 'https://' . $_SERVER['HTTP_HOST'];
					if ($strUrlPrefix == 'https://localhost:82') {
						$strUrlPrefix = 'http://localhost:82/wma/booking';
					}
					$strUrl = $strUrlPrefix . '/cargoConfirm?caref=' . $_POST['caref'];
					$objInvoice->setPaypalRedirect($strUrl);

					$objInvoice->save();
					$objInvoice->refresh();

					$numTotal = 0;

					if ($_POST['inputIsChangeAddress']) {
						$numPostcode = $p->receiver->postcode;
						$strState = $p->receiver->state;
						$numchange_address_weight = $p->chargeWeight();

						$numChargecode = $p->mdata['chargecode'];
						$numPostcodeNew = $_POST['address_postcode'];

						$objResult = $this->funcChangeAddress($numChargecode, $strState, $numPostcode, $numPostcodeNew,$numchange_address_weight);

						$objInvLine = new InvLine;
						$objInvLine->inv_id = $objInvoice->id;
						$objInvLine->ccode = 'Change Address';
						$numFee = $objResult['numFee'];
						$objInvLine->amount = $numFee + round($numFee / 10, 2);
						$objInvLine->gst = round($numFee / 10, 2);
						$objInvLine->det = $p->hbn . ' Change Address';
						$objInvLine->qty = 1;
						$objInvLine->tax = Invoice::Tax_Rate_Output;
						$objInvLine->linkto = $cargoProcess->shipment->ref;
						$objInvLine->save();

						$numTotal += $numFee;

						// set change info to invoice
						$objInvoice->mdata['change_address'] = [];
						$objInvoice->mdata['change_address']['address'] = $_POST['address_line'] . ' ' . $_POST['address_street'];
						$objInvoice->mdata['change_address']['suburb'] = $_POST['address_suburb'];
						$objInvoice->mdata['change_address']['postcode'] =  $_POST['address_postcode'];
						$objInvoice->mdata['change_address']['ip'] =  $_SERVER['REMOTE_ADDR'];
						$objInvoice->mdata['change_address']['shipment_id'] =  $p->id;
						$objInvoice->mdata['change_address']['cargo_process_id'] =  $cargoProcess->id;
					}


					if (isset($_POST['cb_unloading_street'])) {
						$objInvLine = new InvLine;
						$objInvLine->inv_id = $objInvoice->id;
						$objInvLine->ccode = 'Unloading Service';
						$numFee = $this->funcUnloadingFee($p);
						$objInvLine->amount = $numFee + round($numFee / 10, 2);
						$objInvLine->gst = round($numFee / 10, 2);
						$objInvLine->det = $p->hbn . ' Unloading Service';
						$objInvLine->qty = 1;
						$objInvLine->tax = Invoice::Tax_Rate_Output;
						$objInvLine->linkto = $cargoProcess->shipment->ref;
						$objInvLine->save();

						$numTotal += $numFee;
					}

					if (isset($_POST['cb_unloading_unpack'])) {
						$objInvLine = new InvLine;
						$objInvLine->inv_id = $objInvoice->id;
						$objInvLine->ccode = 'Unpacking Boxes';
						$numFee = $this->funcUnpackFee($p);
						$objInvLine->amount = $numFee + round($numFee / 10, 2);
						$objInvLine->gst = round($numFee / 10, 2);
						$objInvLine->det = $p->hbn . ' Unpacking Boxes';
						$objInvLine->qty = 1;
						$objInvLine->tax = Invoice::Tax_Rate_Output;
						$objInvLine->linkto = $cargoProcess->shipment->ref;
						$objInvLine->save();

						$numTotal += $numFee;
					}

					if (isset($_POST['cb_unloading_rabbish'])) {
						$objInvLine = new InvLine;
						$objInvLine->inv_id = $objInvoice->id;
						$objInvLine->ccode = 'Dumping Rabbish';
						$numFee = $this->funcRabbishFee($p);
						$objInvLine->amount = $numFee + round($numFee / 10, 2);
						$objInvLine->gst = round($numFee / 10, 2);
						$objInvLine->det = $p->hbn . ' Dumping Rabbish';
						$objInvLine->qty = 1;
						$objInvLine->tax = Invoice::Tax_Rate_Output;
						$objInvLine->linkto = $cargoProcess->shipment->ref;
						$objInvLine->save();

						$numTotal += $numFee;
					}

					$numGst = round($numTotal / 10, 2);
					$numAmount = $numTotal + $numGst;
					$objInvoice->total = $numAmount;
					$objInvoice->gst = $numGst;

					$objInvoice->date = date('Y-m-d');
					$objInvoice->due = date('Y-m-d');
					$objInvoice->mdata['payterm'] = 'COD';

					$objInvoice->save();


					$strFolder = Yii::app()->basePath . DIRECTORY_SEPARATOR . 'runtime' . DIRECTORY_SEPARATOR . 'temp';
					if (!file_exists($strFolder)) {
						mkdir($strFolder);
					}
					$strFile = $strFolder . DIRECTORY_SEPARATOR . $objInvoice->no . '.pdf';
					oPDF::renderPDF('invoice', ['inv' => $objInvoice], 2, $strFile);

					$numId = FileRepo::storeFile($strFile, $objInvoice->no, FileRepo::CARGOPROCESSFILETYPE, $cargoProcess->id);
					$objFileRepo = FileRepo::model()->findByPk($numId);

					$strUrlPrefix = 'https://os.toplogistics.com.au';
					if ($_SERVER['HTTP_HOST'] == 'localhost:82') {
						$strUrlPrefix = 'http://localhost:82';
					}
					$strUrl = $strUrlPrefix . '/filerepo/' . $objFileRepo->hash . '/' . $objFileRepo->name;

					$cargoProcess->mdata['customer_confirmed']['surcharge_invoice_download'] = $strUrl;

					$cargoProcess->mdata['customer_confirmed']['surcharge_invoice'] = $objInvoice->id;
				}

				$cargoProcess->log('old sub_type = ' . $cargoProcess->sub_type);
				
				if ($_POST['business_unloading_1'] == 'hand_unloading_service_oversize'){
					$cargoProcess->sub_type = CargoProcess::OVERSIZE_SERVICE;
				}else{
					$cargoProcess->sub_type = CargoProcess::RECEIVED_SMS_STYPE;
				}

				//customer confirm has forklift
				if ($_POST['business_unloading_1'] == 'self' || $_POST['business_unloading_0'] == 'fork'){
					$cargoProcess->mdata['custconfirmforklift'] = 1;
				}

				$cargoProcess->mdata['responsed_notice'] = 1;
				$cargoProcess->status = 20;
				$cargoProcess->save();

				echo json_encode(['isSuccess' => true]);
				return;

				// // echo '<script>alert("Done");</script>'; 
				// if(isset($cargoProcess->mdata['customer_confirmed']['surcharge_invoice'])){
				// 	$this->render('cargo_confirm_surcharge',["model"=>$cargoProcess,'numUnloadingFee'=>$this->funcUnloadingFee($p)]);
				// 	return;
				// }
				// else{
				// 	$this->render('cargo_confirm_summary',["model"=>$cargoProcess]);
				// 	return;
				// }

			}
		}

		if (!empty($_GET['caref'])) {
			$caref = $_GET['caref'];
			$p = ImParcel::model()->find('ref = :ref', [":ref" => $caref]);
			if (!empty($p)) {
				$cargoProcess = $p->cargo_process;
			} else {
				$cargoProcess = CargoProcess::model()->find("json_value(t.meta,'$.caref') = :caref", [":caref" => $caref]);
			}

			if (!empty($cargoProcess)) {
				// already manually add to c job
				if (CargoProcessJobRelations::model()->find('cargo_process_id=:cid and active = 1', [':cid' => $cargoProcess->id]) != null) {
					$this->render('cargo_confirm_summary', ["model" => $cargoProcess]);
					return;
				}
				if (empty($cargoProcess->mdata['customer_confirmed'])) {
					// $this->render('cargoConfirm', [
					$this->render('cargo_confirm', [
						"model" => $cargoProcess,
						'numUnloadingFee' => $this->funcUnloadingFee($p),
						'numUnpackFee' => $this->funcUnpackFee($p),
						'numRabbishFee' => $this->funcRabbishFee($p),
					]);
					return;
				}
				if (isset($cargoProcess->mdata['customer_confirmed']['surcharge_invoice'])) {
					$objInvoice = Invoice::model()->findByPk($cargoProcess->mdata['customer_confirmed']['surcharge_invoice']);
					if ($objInvoice->status != Invoice::INVOICE_STATUS_PAID&&$objInvoice->status != Invoice::INVOICE_STATUS_PENDING_PAID) {
						$this->render('cargo_confirm_surcharge', ["model" => $cargoProcess, 'numUnloadingFee' => $this->funcUnloadingFee($p)]);
						return;
					}
				}
				$objCargoProcessJob = new CargoProcessJob;
				$listJob = $objCargoProcessJob->getAvailableJob($cargoProcess->id);
				if (!isset($cargoProcess->mdata['customer_confirmed']['catgo_process_job']) && $cargoProcess->dpt_id == Org::TLA_DEPARTMENT_SYDNEY && !empty($listJob) && $cargoProcess->mdata['customer_confirmed']['business_unloading'] != 'We need hand unloading service, over size') {
					$numCurrentJobId = $cargoProcess->mdata['customer_confirmed']['current_delivery_time'];
					$objJob = CargoProcessJob::model()->findByPk($numCurrentJobId);

					$objCargoProcessJob = new CargoProcessJob;
					$listJob = $objCargoProcessJob->getAvailableJob($cargoProcess->id);

					if (!isset($listJob[$numCurrentJobId]) && $cargoProcess->shipment->scanCount()>0) {
						$this->render('cargo_confirm_job', ["ref" => $_GET['caref'], 'strDeliveryNote' => 'time slot has been taken,please select another one.<br/><br/>']);
						return;
					}else{
						$this->render('cargo_confirm_summary', ["model" => $cargoProcess]);
						return;
					}

					// save to relation
					$objCargoProcessJobRelations = new CargoProcessJobRelations;
					$objCargoProcessJobRelations->job_id = $objJob->id;
					$objCargoProcessJobRelations->cargo_process_id = $cargoProcess->id;
					$objCargoProcessJobRelations->created = date('Y-m-d h:i:s');
					$objCargoProcessJobRelations->sequence = 1;
					$objCargoProcessJobRelations->save();

					$cargoProcess->mdata['customer_confirmed']['catgo_process_job'] = $objJob->job_no;
					$cargoProcess->mdata['AutoIntoJob']=1;
					$cargoProcess->status = CargoProcess::WAITINGDELIVERY;
					$cargoProcess->save();

					$cargoProcess->shipment->addTracking(19, 'Received your reply. You booked delivery: '.$objJob->funcParseDeliveryTime($objJob->created,$objJob->mdata['time'],''), Org::model()->findByPk($cargoProcess->dpt_id)->name, date('Y-m-d h:i:s', time()));
					$emailService = new EmailService();
					$emailService->sendReceivedConfirm($cargoProcess);
				}else{
					$cargoProcess->shipment->addTrackingLimited(72, 'Received your reply. Waiting for assign driver.');
					$emailService = new EmailService();
					$emailService->sendReceiveConfirm($cargoProcess);
				}
				$this->render('cargo_confirm_summary', ["model" => $cargoProcess]);
			}
		}
	}

	private function funcUnloadingFee($objShipment)
	{
		//use chargecode to calculate unload fee. fixed chargecode.  need change if the chargecode change.
		$numHasFork = $objShipment->getChargeByChargecode(8888);
		$numNoFork = $objShipment->getChargeByChargecode(2563);
		return max($numHasFork-$numNoFork,10);

		// $numWeightCBM = $objShipment->weight / 250;
