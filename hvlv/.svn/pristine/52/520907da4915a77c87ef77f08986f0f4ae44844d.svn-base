		// }

		// $objUnloadingPrice->funcPostcode2ZoneLevel('4237', $strPostcode);
		// $numPriceMin = $objUnloadingPrice->funcPriceMin();
		// $numPriceCBM = $objUnloadingPrice->funcPricePerCBM($numMaxCBM);
		// return max($numPriceMin, $numPriceCBM);
	}

	private function funcUnpackFee($objShipment)
	{
		$numPkg = $objShipment->pkg;
		$numUnpackFee = $numPkg * 30;
		return $numUnpackFee;
	}

	private function funcRabbishFee($objShipment)
	{
		$numWeight = $objShipment->weight;
		$numRabbishFee = 35 + $numWeight * 0.8;
		return $numRabbishFee;
	}

	public function actionChangeAddressFee()
	{
		$strRef = $_POST['caref'];
		$numPostcodeNew = $_POST['numPostcodeNew'];
		$strSuburb = $_POST['strSuburb'];

		$objPostcode = Postcode::model()->find('postcode=:postcode and suburb=:suburb', [':postcode' => $numPostcodeNew, ':suburb' => strtoupper($strSuburb)]);
		if ($objPostcode == null) {
			$objResponce = [
				'isSuccess' => false,
				'strMessage' => 'postcode and suburb not match',
			];
			echo json_encode($objResponce);
			return;
		}

		$objShipment = ImParcel::model()->find('ref=:ref', [':ref' => $strRef]);

		$numWeight = $objShipment->weight;
		$numPostcode = $objShipment->cnee->postcode;
		$strState = $objShipment->cnee->state;
		$numchange_address_weight = $objShipment->chargeWeight();

		$numChargecode = $objShipment->mdata['chargecode'];

		$objResult = $this->funcChangeAddress($numChargecode, $strState, $numPostcode, $numPostcodeNew,$numchange_address_weight);

		if ($objResult['isError']) {
			$objResponce = [
				'isSuccess' => false,
				'strMessage' => $objResult['strMessage']
			];
			echo json_encode($objResponce);
			return;
		} else {
			$objResponce = [
				'isSuccess' => true,
				'strMessage' => $objResult['strMessage'],
				'numFee' => $objResult['numFee'],
			];
			echo json_encode($objResponce);
			return;
		}
	}

	private function funcChangeAddress($strChargecode, $strState, $numPostcodeOrigin, $numPostcodeNew,$numchange_address_weight)
	{
		$objResult = [
			'isError' => false,
			'numFee' => 30,
			'strMessage' => '',
		];

		if (substr($numPostcodeOrigin, 0, 1) != substr($numPostcodeNew, 0, 1)) {
			$objResult['isError'] = true;
			$objResult['strMessage'] = 'new address is in another state';
			return $objResult;
		}
		$chargecodeInfo = ImportChargeCode::model()->find('chargecode = :cid', [':cid' => $strChargecode]);
		$objZonMapNew = ZoneMap::model()->find('chargecode_id = :cid AND pc_lo <= :pc AND pc_hi >= :pc', [':cid' => $chargecodeInfo['id'], ':pc' => $numPostcodeNew]);

		if ($objZonMapNew == null) {
			$objResult['isError'] = true;
			$objResult['strMessage'] = 'new address is not in delivery zone';

			return $objResult;
		}

		$objZoneMap = ZoneMap::model()->find('chargecode_id = :cid AND pc_lo <= :pc AND pc_hi >= :pc', [':cid' => $chargecodeInfo['id'], ':pc' => $numPostcodeOrigin]);


		$dicStr2Num = [
			'N1' => 1,
			'N2' => 2,
			'N3' => 3,
			'N4' => 4,
			'V1' => 5,
			'V2' => 6,
			'V3' => 7,
			'Q1' => 8,
			'Q2' => 9,
			'Q3' => 10,
		];
		$strZone = $objZoneMap->z1;
		$strZoneNew = $objZonMapNew->z1;

		if ($strZoneNew == 'N4') {
			$objResult['isError'] = true;
			$objResult['strMessage'] = 'new address is not in delivery zone';
			return $objResult;
		}

		$numGap = $dicStr2Num[$strZoneNew] - $dicStr2Num[$strZone];


		// $dicState2Gap2Fee = [
		// 	'NSW' => [
		// 		1 => 30,
		// 		2 => 60,
		// 	],
		// 	'VIC' => [
		// 		1 => 30,
		// 		2 => 60,
		// 	],
		// 	'QLD' => [
		// 		1 => 80,
		// 		2 => 120,
		// 	]
		// ];

		// if ($numGap > 0 && $numGap < 3) {
		// 	$objResult['numFee'] += $dicState2Gap2Fee[$strState][$numGap];
		// }

		$numTempCost = 0;
		$numAmountNew = self::calculateNormalByWeight($numchange_address_weight,$chargecodeInfo,$numPostcodeNew);
		$numAmountOld = self::calculateNormalByWeight($numchange_address_weight,$chargecodeInfo,$numPostcodeOrigin);

		$numTempCost = $numAmountNew - $numAmountOld;
		if($numTempCost<=0){
			$objResult['numFee'] = 30;
		}else{
			$objResult['numFee'] = 30 + round($numTempCost,2);
		}

		return $objResult;
	}

	private function calculateNormalByWeight($myWeight, $chargecodeInfo,$postcode, &$selectedRate = null){
		$zoneMaps = ZoneMap::model()->findAll('chargecode_id = :cid AND pc_lo <= :pc AND pc_hi >= :pc', [':cid' => $chargecodeInfo['id'], ':pc' => $postcode]);
		$amount = 0;
		foreach ($zoneMaps as $zoneMapKey => $zoneMap) 
		{
			$amount = 0;
			$checkWeight = $myWeight;

			if ($checkWeight<0.5) {
				$checkWeight = ceil($checkWeight * 1000) / 1000;
			} else {
				$checkWeight = ceil($checkWeight * 10) / 10;
			}

			if (!empty($zoneMap)) {
				$zoneRates = ZoneRate::model()->findAll('chargecode_id = :cid AND weight_lo <:w AND weight_hi >= :w AND zone = :z AND base+item+perkg > 0', [':cid' => $chargecodeInfo['id'], ':w' => $checkWeight, ':z' => $zoneMap['z1']]);
				if (empty($zoneRates)) {
					$zoneRates = ZoneRate::model()->findAll('chargecode_id = :cid AND weight_lo <=:w AND weight_hi >= :w AND zone = :z AND base+item+perkg > 0', [':cid' => $chargecodeInfo['id'], ':w' => $checkWeight, ':z' => $zoneMap['z1']]);
				}
			}
			foreach ($zoneRates as $zoneRate) {
				$itemPrice = $zoneRate['item'];

				if ($zoneRate['nkg'] > 0) {
					$temp = $zoneRate['base'] + $itemPrice+ $zoneRate['perkg'] * ($zoneRate['nkg'] - fmod($myWeight, $zoneRate['nkg']) + $myWeight);
				} else {
					$temp = $zoneRate['base'] + $itemPrice + $zoneRate['perkg'] * $myWeight;
				}
				if ($zoneRate['minimum'] > 0) {
					$temp = max($temp, $zoneRate['minimum']);
				}
				if ($temp>$amount) {
					//$tempAmount = $temp;
					$selectedRate = $zoneRate;
				}
				$amount = max($amount, $temp);
			}
			if($amount>0)
			{
				break;
			}
		}
		return $amount;
	}

	public function actionEditBooking($id)
	{
		$this->layout = 'wmaBooking';
		$model = DeliveryRecord::model()->findByPk($id);
		if (!empty($_POST['name'])) {
			if (!empty($_POST['uuid'])) {
				$bookingDate = date('Y-m-d', strtotime($_POST['bookingDate']));
				if (!empty($_POST['bookingTime'])) {
					$model->booking_time = $bookingDate . " " . $_POST['bookingTime'];
				}

				if (empty($_POST['mdata']['company_name'])) {
					$model->addError('please input company name', 'please input company name');
					$this->ajaxResult($model);
					return "";
				}

				if (!isset($_POST['mdata']['booking_type'])) {
					$model->addError('please select booking type', 'please select booking type');
					$this->ajaxResult($model);
					return "";
				}

				if (!empty($model->booking_time)) {
					$day = date("Y-m-d", strtotime($model->booking_time));

					$regoSameDayRecords = DeliveryRecord::model()->findAll(' booking_time like "%' . $day . '%" and rego = :rego and status != :status and id != :pid', [":rego" => $model->rego, ":status" => DeliveryRecord::CANCELSTATE, ":pid" => $model->id]);
					if (!empty($regoSameDayRecords)) {
						$timeNow = strtotime($model->booking_time);
						foreach ($regoSameDayRecords as $key => $regoSameDayRecord) {
							$thisTime = strtotime($regoSameDayRecord->booking_time);
							$timeBegin = strtotime("-118 minute", $thisTime);
							$timeEnd = strtotime("+118 minute", $thisTime);
							if ($timeBegin <= $timeNow && $timeEnd >= $timeNow) {
								$model->addError("Your rego is allocated in this time period", "Your Rego is allocated in this time period");
								$this->ajaxResult($model);
							}
						}
					}
				}

				$deliveryBooking = DeliveryRecord::model()->findAll(' booking_time = :booking_type and status != :status and id != :id', [":booking_type" => $model->booking_time, ":status" => DeliveryRecord::CANCELSTATE, ":id" => $model->id]);
				if (!empty($deliveryBooking)) {
					if (sizeof($deliveryBooking) >= 2) {
						$model->addError("Booking is full", "Booking is full");
					} else {
						foreach ($deliveryBooking as $key => $db) {
							if ($db->rego == @$_POST['rego'] || $db->uuid == @$_POST['uuid']) {
								$model->addError("You have booked this time", "You have booked this time");
								$this->ajaxResult($model);
							}
						}
					}
				}


				$model->mobile = @$_POST['mobile'];
				$model->rego = @$_POST['rego'];
				$model->plt =  empty($_POST['plt']) ? 0 : $_POST['plt'];
				$model->pkg = empty($_POST['pkg']) ? 0 : $_POST['pkg'];
				$model->name = @$_POST['name'];
				$model->note = @$_POST['note'];
				$model->task = 'deliveryBooking';
				$model->created = date('Y-m-d H:i:s');
				$model->op_id = 0;
				$model->damage = 0;
				$model->status = DeliveryRecord::NEWSTATE;
				$model->savePOSTMeta($_POST);
				$model->save();
			}
			$this->ajaxResult($model);
		}

		$this->render('_form', ["model" => $model]);
	}

