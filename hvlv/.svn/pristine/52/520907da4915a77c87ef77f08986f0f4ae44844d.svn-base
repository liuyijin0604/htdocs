	public function actionSelectTime()
	{
		$filtersForm = new FiltersForm;
		$this->layout = 'wmaBooking';
		$model = new DeliveryRecord('search');
		$model->unsetAttributes();
		if (!empty($_GET['date'])) {
			$provide = $model->getTimeSelectArr($_GET['date']);
		} else {
			$provide = $model->getTimeSelectArr(date('Y-m-d'));
		}
		$filteredData = $filtersForm->filter($provide);
		$dataprovider = new CArrayDataProvider($filteredData);
		$dataprovider->pagination = ['pageSize' => 3000,];
		$sort = new CSort();
		$sort->attributes = [
			'datetime' => [
				'asc' => 'datetime ASC',
				'desc' => 'datetime DESC',
			]
		];
		$sort->defaultOrder = "datetime ASC";
		$dataprovider->sort = $sort;

		$this->render('timeSelector', ['dataProvider' => [$dataprovider, $filtersForm]]);
	}



	public function actionMakeSupay($id, $act)
	{
		Yii::app()->name = 'TLA';

		$invoice = Invoice::model()->findByPk($id);
		$strUrlPrefix = 'https://os.toplogistics.com.au';
		if ($_SERVER['HTTP_HOST'] == 'localhost:82') {
			$strUrlPrefix = 'http://localhost:82';
		}
		$callback_notification_url = $strUrlPrefix . '/top/supay/supay.app';

		if (Yii::app()->name == 'TLA') {
			$supay = new SupayAPI(
				$callback_notification_url,
				'',
				'72795',
				'lkjh678jGQDJokl9XQHaHIyfuytttqqq'
			);
		} else {
			$supay = new SupayAPI(
				$callback_notification_url
			);
		}
		if ($act == 'Wechat') {
			$url = $supay->checkoutByWechatPay('invoice ' . $invoice->no, $invoice->no, 'AUD', round($invoice->total * 1, 2));
		} elseif ($act == 'Alipay') {
			$url = $supay->checkoutByAliPay('invoice ' . $invoice->no, $invoice->no, 'AUD', round($invoice->total * 1, 2));
		} elseif ($act == 'Poli') {
			$url = $this->createPaylink(['invoice_id' => $invoice->id]);
		} elseif ($act == 'Paypal') {
			$url = $this->createPaypallink(['invoice_id' => $invoice->id]);
		}
		echo json_encode(['success' => true, 'msg' => 'success', 'url' => $url]);
	}

	private function createPaylink($data)
	{
		$strUrlPrefix = 'https://os.toplogistics.com.au';
		if ($_SERVER['HTTP_HOST'] == 'localhost:82') {
			$strUrlPrefix = 'http://localhost:82';
		}
		$paylink = $strUrlPrefix . '/top/payInvoice/pay.app?token=';
		$iv = str_repeat("\x00", openssl_cipher_iv_length('AES-256-CBC'));
		$token = base64_encode(openssl_encrypt(json_encode($data), 'AES-128-CBC', md5(PoliPaymentApi::PAYLINK_KEY), 0, $iv));
		$paylink .= trim($this->safe_b64encode($token));
		return $paylink;
	}

	private function createPaypallink($data)
	{
		$strUrlPrefix = 'https://os.toplogistics.com.au';
		if ($_SERVER['HTTP_HOST'] == 'localhost:82') {
			$strUrlPrefix = 'http://localhost:82';
		}
		$paylink = $strUrlPrefix . '/top/payInvoice/paypal.app?token=';
		$iv = str_repeat("\x00", openssl_cipher_iv_length('AES-256-CBC'));
		$token = base64_encode(openssl_encrypt(json_encode($data), 'AES-128-CBC', md5(PoliPaymentApi::PAYLINK_KEY), 0, $iv));
		$paylink .= trim($this->safe_b64encode($token));
		return $paylink;
	}

	private function safe_b64encode($string)
	{
		$data = base64_encode($string);
		$data = str_replace(['+', '/', '='], ['-', '_', ''], $data);
		return $data;
	}

	public function actionCheckAddressBook()
	{
		if (!empty($_POST['tel'])) {
			$tel = Addr::auPhoneValid($_POST['tel']);
			$response = new stdClass;
			$response->success = false;
			if (!empty($tel)) {
				$addressBook = CargoAddressBook::model()->findByAttributes(array('tel' => $tel, 'status' => 1));
				if (!empty($addressBook)) {
					$response->success = true;
					/* $response->address_type = $addressBook->mdata['address_type'];
					$response->has_folklift = $addressBook->mdata['has_folklift'];
					$response->open = !empty($addressBook->mdata['open']) ? $addressBook->mdata['open'] : '';
					$response->close = !empty($addressBook->mdata['close']) ? $addressBook->mdata['close'] : '';
					$response->authorize_to_leave = $addressBook->mdata['authorize_to_leave']; */
					$response->addressBook = $addressBook;
				}
			}

			echo json_encode($response);
		}
	}
}
