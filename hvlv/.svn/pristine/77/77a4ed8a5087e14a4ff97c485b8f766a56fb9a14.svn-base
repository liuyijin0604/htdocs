<?php 
class WarehouseProcessService extends Service
{

	public function __construct()
	{
		
	}

	public function getCheckInReport($wid,$isBackend= false,$saveDetail = false)
	{
		$cache = $this->getCacheData("checkInReportConsols:".$wid.date("Ymd"));
		$consol=new Consol('search');
		$consol->unsetAttributes();
		if($wid==Org::TLA_DEPARTMENT_PERTH)
		{
			$wid = [Org::TLA_DEPARTMENT_PERTH,Org::TLA_DEPARTMENT_FREMANTLE];
		}
		$consol->dpt_id=$wid;
		$consol->isBackend = $isBackend;
		$consol->process_statuses=[ConsolProcess::STATE_WAITING_WH_SCAN];
		$consol->process_types=[ConsolProcess::TYPE_FULL_PROCESS, ConsolProcess::TYPE_LOCAL_PROCESS,ConsolProcess::TYPE_DIRECT_AIR_CONSOL];// ConsolProcess::TYPE_DIRECT_SEA_CONSOL, ConsolProcess::TYPE_CONSOL_SEA];
		$dataArr = $consol->search(false, 30)->data;
		$resultArr = [];
		$totalConsol = 0;
		$totalShipment = 0;
		$totalPkg = 0;
		$totalScanCount = 0;

		if(!empty($cache))
		{
			$cachedConsols = Consol::model()->findAll("id in (".join(',',$cache).")");
			$dataArr = array_merge($dataArr,$cachedConsols);
		}

		foreach($dataArr as $key => $d)
		{
			$d= $d->getReal();
			if($wid==Org::TLA_DEPARTMENT_BRISBANE)
			{
				if(strtotime($d->process->to_warehouse)>strtotime(date('Y-m-d 23:59:00'))) continue;
			}else
			{
				if(strtotime($d->process->to_warehouse)>strtotime(date('Y-m-d 16:00:00'))) continue;
			}
			if(!empty($resultArr[$d->id])) continue;
			$sql = 'SELECT sum(IF((pkg-scan_no) > 0, 0, 1)*(pkg-scan_no)) as heldPkg,sum(IF((pkg-scan_no) > 0, 0, 1)) as heldShipments FROM shipment WHERE consol_id = '.$d->id.' AND status in (55)';
			$c = Yii::app()->db->createCommand($sql);
			$held = $c->queryAll()[0];

			$sql = 'SELECT count(1) as shipments,status FROM shipment WHERE consol_id = '.$d->id.' and status not in (55,60) group by status order by status';
			$c = Yii::app()->db->createCommand($sql);
			$allStatusData = $c->queryAll();


			$sql = 'SELECT count(1) as shipments, sum(pkg) as pkg, sum(IF((pkg-scan_no) > 0, 1, 0)) AS scanshipments, sum(pkg-scan_no) as scanCount,sum(IF((pkg-scan_no) > 0, 0, 1)) AS unscanshipments,sum(scan_no) as unscan FROM shipment WHERE consol_id = '.$d->id;
			$c = Yii::app()->db->createCommand($sql);
			$scanCount = $c->queryAll()[0];
			$awb = $d->service==10?$d->awb:@$d->mdata["container_no"];
			$resultArr[$d->id] = [(empty($awb)?$d->no:$awb),$scanCount['shipments'],$scanCount['pkg'],$scanCount['scanshipments'],$scanCount['scanCount'],$scanCount['unscanshipments'],$scanCount['unscan'],(empty($held['heldPkg'])?0:$held['heldPkg']),(empty($held['heldShipments'])?0:$held['heldShipments']),$allStatusData];
			$totalConsol+=1;
			$totalShipment+=$resultArr[$d->id][1];
			$totalPkg+=$resultArr[$d->id][2];
			$totalScanCount+=$resultArr[$d->id][4];
		}

		if(!empty($dataArr))
		{
			if($saveDetail)
			{
				$consolIds = array_unique(array_column($dataArr, "id"));
				$result= [];
				$result['header'] = ["ref","no scan quantity"];
				$result['totalData'] = [];
				foreach($consolIds as $key => $d)
				{
					$noScanShipments = ImParcel::model()->findAll("consol_id = :cid and scan_no != 0 ",[":cid"=>$d]);
					foreach ($noScanShipments as $key => $p) {
						$result['totalData'][] = [$p->ref,$p->pkg-$p->scan_no];
					}
		    	}

		    	$this->saveDailyReportDetail(ReportCache::CheckInReportDaily,$result,$wid);
		    	return;
			}
			

			$this->setCacheData("checkInReportConsols:".$wid.date("Ymd"),array_column($dataArr, "id"),86400);
		}
		$totalLeft = $totalPkg-$totalScanCount;
		if(!empty($totalPkg))
		{
			$scanPercent = number_format(($totalScanCount*100/$totalPkg),1,'.','')."%";
			$leftPercent = number_format((($totalPkg-$totalScanCount)*100/$totalPkg),1,'.','')."%";
		}else
		{
			$scanPercent = "0%";
			$leftPercent = "0%";
		}
		$totalArr = ['consols'=>$totalConsol,'shipments'=>$totalShipment,'pkg'=>$totalPkg,'scanCount'=>$totalScanCount,'left'=>$totalLeft,'scanPercent'=>$scanPercent,'leftPercent'=>$leftPercent];
		return [$totalArr,$resultArr];
	}

	public function saveDailyReportDetail($type,$result,$dptId)
	{
		$rc = ReportCache::model()->find("create_time = :createTime and type =:type and dpt_id = :dptId",[":createTime"=>date('Y-m-d 00:00:00'),":type"=>$type,":dptId"=>$dptId]);
		if(empty($rc))
		{
			$rc = new ReportCache();
		    $rc->type = $type;
		    $rc->status = 1;
		    $rc->mdata=$result;
		    $rc->create_time = date("Y-m-d 00:00:00");
		    $rc->creater = 1;
		    $rc->modify_time = date('Y-m-d H:i:s');
		    $rc->dpt_id = $dptId;
		    $rc->save();
		}else
		{
		 	$rc->mdata  = $result;
		 	$rc->update(['meta']);
		}
	}

	public function ajaxPLchart($header,$rows,$percent=null)
	{
		$headerStr="";
		if(empty($percent))
		{
			foreach ($header as $key => $value) {
				$headerStr.="<th>{$value}</th>";
			}
		}else
		{
			foreach ($header as $key => $value) {
				$headerStr.="<th width='".$percent[$key]."'>{$value}</th>";
			}
		}

		$t = '<div class="grid-view"><table class="items"><thead><tr>'.$headerStr.'</tr></thead><tbody>';

		foreach ($rows as $key2 => $r)
		{
			$str = "";
			if(isset($r[0])&&preg_match('/held/i', $r[0]))
			{
				foreach ($r as $k => $value) {
					if(empty($percent))
					{
						$percentStr = "";
					}else
					{
						$percentStr = "width='".$percent[$k]."'";
					}
					$str.= "<td {$percentStr}><font color='red'>{$value}</font></td>";
				}
			}else
			{
				foreach ($r as $k => $value) {
					if(empty($percent))
					{
						$percentStr = "";
					}else
					{
						$percentStr = "width='".$percent[$k]."'";
					}
					$str.= "<td {$percentStr}>{$value}</td>";
				}
			}
			$t .= "<tr>{$str}</tr>";
		}

		return $t . '</tbody></div>';
	}

	public function getCheckInReportForConsol($consolId)
	{
		$consol = Consol::model()->findByPk($consolId);
		$rows = [];
		$shipments = $consol->shipments;
		foreach ($shipments as $key => $shipment){
			$orgId = @$shipment->mdata['org_id'];
			$total = $shipment->pkg;
			$scanCount = 0;
			$unscanCount = 0;
			$oversizeCount = 0;
			$scanedHeldCount = 0; 
			$totalHeldCount = 0;
			if($shipment->scan_no<$shipment->pkg)
			{
				$scanCount = $shipment->scanCount();
				$unscanCount = $shipment->pkg-$shipment->scanCount();
			}else
			{
				$type = 'unscan';
				$unscanCount = $shipment->pkg;
			}
			if(in_array($shipment->status, [ImParcel::STATE_HELD,ImParcel::STATE_DUTY_HELD]))
			{
				$totalHeldCount = $shipment->pkg;
				if($shipment->scan_no<$shipment->pkg)
				{
					$scanedHeldCount = $shipment->scanCount();
				}
			}

			if(empty($rows[$orgId]))
			{
				$org = Org::model()->findByPk($orgId);
				$rows[$orgId] = ["courierId"=>@$org->id,"Courier"=>@$org->name,"Total"=>$total,"Scaned"=>$scanCount,"Unscaned"=>$unscanCount,"Oversize"=>$oversizeCount,'Held_Scan'=>$scanedHeldCount,'Held_Total'=>$totalHeldCount];
			}else
			{
				$rows[$orgId]['Total'] +=$total;
				$rows[$orgId]['Scaned'] +=$scanCount;
				$rows[$orgId]['Unscaned'] +=$unscanCount;
				$rows[$orgId]['Oversize'] +=$oversizeCount;
				$rows[$orgId]['Held_Scan'] +=$scanedHeldCount;
				$rows[$orgId]['Held_Total'] +=$totalHeldCount;
			}
		}
		array_multisort(array_column($rows, 'Unscaned'),SORT_DESC,$rows);
		return $rows;
	}

	public function getCheckInReportForConsolCourier($consolId,$orgId,$cstatus=null)
	{
		$consol = Consol::model()->findByPk($consolId);
		$rows = [];
		$shipments = $consol->shipments;
		foreach ($shipments as $key => $shipment){
			if($cstatus==ImParcel::STATE_HELD&&$shipment->status!=ImParcel::STATE_HELD)
			{
				continue;
			}

			if($cstatus==ImParcel::STATE_CLEAR&&$shipment->status==ImParcel::STATE_HELD)
			{
				continue;
			}

			$thisOrgId = @$shipment->mdata['org_id'];
			if($orgId!=$thisOrgId)
			{
				continue;
			}
			$total = $shipment->pkg;
			$scanCount = 0;
			$unscanCount = 0;
			$oversizeCount = 0;
			$scanedHeldCount = 0; 
			$totalHeldCount = 0;
			if($shipment->scan_no<$shipment->pkg)
			{
				$scanCount = $shipment->scanCount();
				$unscanCount = $shipment->pkg-$shipment->scanCount();
			}else
			{
				$type = 'unscan';
				$unscanCount = $shipment->pkg;
			}
			if(in_array($shipment->status, [ImParcel::STATE_HELD,ImParcel::STATE_DUTY_HELD]))
			{
				$totalHeldCount = $shipment->pkg;
				if($shipment->scan_no<$shipment->pkg)
				{
					$scanedHeldCount = $shipment->scanCount();
				}
			}else
			{
				if($unscanCount==0)
				{
					continue;
				}
			}
			$status = $shipment->getStatus();
			$rows[$shipment->id] = [$shipment->ref,$status,$scanCount.'/'.$unscanCount,number_format($shipment->cbm,2,'.','')."/".$shipment->weight];
		}
		$header = ["Ref","Status","Done/</br>Left","CBM/KG"];
		$percent = ["45%","20%","15%","20%"];
		return [$header,$rows,$percent];
	}
