	public function getOnBoardConsolShipments($dptId)
	{
		$onRoad = 0;
		$model=new Consol('search');
		$model->unsetAttributes();
		$model->dpt_id=$dptId;
		$model->service=ImcoConsol::AIRCONSOL;
		$model->process_statuses=[ConsolProcess::STATE_WAITING_NOTIFY_DRIVER_PICKUP, ConsolProcess::STATE_NOTIFIED_DRIVER];
		$model->process_types=[ConsolProcess::TYPE_FULL_PROCESS, ConsolProcess::TYPE_LOCAL_PROCESS,ConsolProcess::TYPE_DIRECT_AIR_CONSOL, ConsolProcess::TYPE_DIRECT_SEA_CONSOL];
		$consols = $model->search(false,30,false,false,false)->data;
		foreach ($consols as $key => $consol) {
			$onRoad+=$consol->totPacks();
			$logs = Log::model()->count(" lid = :lid and model ='ConsolProcess' and meta like '%Notified Driver%' and time<:time",[":lid"=>$consol->process->id,":time"=>date("Y-m-d 17:00:00")]);
		}
		return $onRoad;
	}
	public function getCheckinDashboardReport($depot,$userDptId)
	{
		$sydneyReport = $this->getCheckInReport(Org::TLA_DEPARTMENT_SYDNEY,true,false);
		$melbourneReport = $this->getCheckInReport(Org::TLA_DEPARTMENT_MELBOURNE,true,false);
		$brisbaneReport = $this->getCheckInReport(Org::TLA_DEPARTMENT_BRISBANE,true,false);
		$checkDepotId = 0;
		if(empty($depot))
		{
			$checkDepotId = $userDptId;
		}else
		{
			$checkDepotId = Org::$warehouse_list_re[$depot];
		}
		$provide = [];

		switch($checkDepotId)
		{
			case Org::TLA_DEPARTMENT_SYDNEY:
				$onRoad = $this->getOnBoardConsolShipments($checkDepotId);
				$provide = ["left"=>$sydneyReport[0]['left'],'done'=>$sydneyReport[0]['scanCount'],'scanPercent'=>$sydneyReport[0]['scanPercent'],'leftPercent'=>$sydneyReport[0]['leftPercent'],'onRoad'=>$onRoad,'depot'=>'Sydney'];
			break;
			case Org::TLA_DEPARTMENT_MELBOURNE:
				$onRoad = $this->getOnBoardConsolShipments($checkDepotId);
				$provide = ["left"=>$melbourneReport[0]['left'],'done'=>$melbourneReport[0]['scanCount'],'scanPercent'=>$melbourneReport[0]['scanPercent'],'leftPercent'=>$melbourneReport[0]['leftPercent'],'onRoad'=>$onRoad,'depot'=>'Melbourne'];
			break;
			case Org::TLA_DEPARTMENT_BRISBANE:
				$onRoad = $this->getOnBoardConsolShipments($checkDepotId);
				$provide = ["left"=>$brisbaneReport[0]['left'],'done'=>$brisbaneReport[0]['scanCount'],'scanPercent'=>$brisbaneReport[0]['scanPercent'],'leftPercent'=>$brisbaneReport[0]['leftPercent'],'onRoad'=>$onRoad,'depot'=>'Brisbane'];
			break;
			case Org::TLA_DEPARTMENT_PERTH:
				$onRoad = $this->getOnBoardConsolShipments($checkDepotId);
				$provide = ["left"=>0,'done'=>0,'scanPercent'=>"0%",'leftPercent'=>"0%",'onRoad'=>0,'depot'=>'Perth'];
			break;
		}

		$provide['total'] = $provide['left']+$provide['done']+$provide['onRoad'];
		$provide['onHand'] = $provide['left']+$provide['done'];

		$provide['rightData'] = [
								"BNE(".$brisbaneReport[0]['scanPercent'].")"=>explode("%",$brisbaneReport[0]['scanPercent'])[0],
								"MEL(".$melbourneReport[0]['scanPercent'].")"=>explode("%",$melbourneReport[0]['scanPercent'])[0],
								"SYD(".$sydneyReport[0]['scanPercent'].")"=>explode("%",$sydneyReport[0]['scanPercent'])[0]];
		$provide['checkDepotId'] = $checkDepotId;


		return $provide;
	}

	public function getCheckinDashboardReportDetail($dptId)
	{
		$provide = $this->getWhscanDetailReport(date("Y-m-d"),date("Y-m-d"),$dptId,true,Consol::AIRCONSOL);
		foreach ($provide as $key => $value) {
			$provide[$key]['total_weight'] = join('',explode(',',$provide[$key]['total_weight']));
		}
		usort($provide, function($a, $b) {
		    return $b['total_weight']<=>$a['total_weight'];
		});
		return $provide;
	}

	public function getWhscanDetailReport($start_time,$end_time,$dptId = 0,$onlyFirstName=false,$service=0)
	{
		$depotMapping = Org::$warehouse_list;
		$cache = $this->getCacheData("wdr".$dptId.$service.$start_time.$end_time);
		if(!empty($cache))
		{
			return $cache;
		}
		$provide= [];
		$criteria = new CDbCriteria;
			$criteria->addCondition('t.type IN (0,5)');
			$criteria->addCondition('scan_time > :start');
			$criteria->addCondition('scan_time < :end');
			if(!empty($dptId))
			{
				$criteria->addCondition('warehouse = '.$dptId);
			}
			$criteria->addCondition('pid NOT IN (
			    SELECT shipment_id 
			    FROM import_bag_tag 
			    WHERE shipment_id IN (
			        SELECT pid 
			        FROM shipment_scan 
			        WHERE scan_time > :substart
			        AND scan_time < :subend
			        AND t.type = 0
			    )
			)');

			$criteria->params = [
			    ':start' => $start_time. ' 00:00:00',
			    ':end' => $end_time. ' 23:59:59',
			    ':substart' => $start_time. ' 00:00:00',
			    ':subend' => $end_time. ' 23:59:59',
			];
			if(!empty($service))
			{
				$criteria->addCondition(' (t.type=0 and consol.service = '.$service.') or (t.type=5 and consol.service is null)' );
			}

			$criteria->order = "warehouse ASC,scan_time ASC";
			$rs = ShipmentScan::model()->with('shipment','shipment.consol')->together('user')->findAll($criteria);
	        $scan_date_data = [];
	        
            $importBagTagArr = [];
		    $importBagTags = ImportBagTag::model()->with(['imParcel'])->findAll([
		    'condition' => 'import_bag_id IN (
		        SELECT pid FROM shipment_scan WHERE scan_time > :start AND scan_time < :end AND type = 5 )',
		    'params' => [
		        ':start' => $start_time . ' 00:00:00',
                ':end' => $end_time . ' 23:59:59'
		    ],
		]);

			foreach ($importBagTags as $importBagTag) {
			    $shipment = $importBagTag->imParcel;
			    //Shipment::model()->find('id = :id', [':id' => $importBagTag->shipment_id]);
			    if (!empty($shipment)) {
			        $importBagTagArr[$importBagTag->import_bag_id][] = $shipment;
			    }
			}

	        foreach ($rs as $r) {
	        	if ($r->type == 5) {
		            if(!empty($service)&&$importBagTagArr[$r->pid][0]->consol->service!=$service)
		            {
		            	continue;
		            }
	        	}

	            $uid = $r->user_id;
	            $scan_date = date('Y-m-d', strtotime($r->scan_time));
	            if (!isset($scan_date_data[$uid][$scan_date])&&$uid!==0) {
	                $scan_date_data[$uid][$scan_date] = [
	                    'time' => 0,
	                    'user' => empty($r->user) ? '' : ($onlyFirstName?$r->user->fname:$r->user->getFullName()),
	                    //'user' => $uid,
	                    'depot' => $r->warehouse,
	                    'dp_packs'=>0,
	                    'dp_weight'=>0,
	                    'pcs_packs' => 0,
	                    'pcs_weight' => 0,
	                    'carton_packs' => 0,
	                    'carton_weight' => 0
	                ];
	                $start = $r->scan_time;
	            }

                $end = $r->scan_time;
                $timeDiff = abs(strtotime($end) - strtotime($start));
                $scan_date_data[$uid][$scan_date]['time'] = $timeDiff;
                //$start = $r->scan_time;
	            // if (abs(strtotime($start) - strtotime($r->scan_time)) < $gap) {
	            //     $scan_date_data[$uid][$scan_date]['time'] += abs(strtotime($start) - strtotime($r->scan_time));
	            // } else {
	            //     $scan_date_data[$uid][$scan_date]['time'] += 1;
	            // }
	            // $start = $r->scan_time;
	            if ($r->type == 0) {
	              $scan_date_data[$uid][$scan_date]['pcs_packs'] += $r->pkg;
	              $scan_date_data[$uid][$scan_date]['pcs_weight'] += $r->weight;
                  if(!empty($r->shipment)){
                     if($r->shipment->agent_id==org::ORGID_CLIENT_DAIPOST)
	                  {
		               	 $scan_date_data[$uid][$scan_date]['dp_packs'] += $r->pkg;
		               	 $scan_date_data[$uid][$scan_date]['dp_weight'] += $r->weight;
	                  }
                  }
	            } else if ($r->type == 5) {

	                $scan_date_data[$uid][$scan_date]['carton_packs'] += 1;
	                if(!empty($importBagTagArr[$r->pid]))
	                {
		                foreach ($importBagTagArr[$r->pid] as $key => $shipment)
		                {
		                	$scan_date_data[$uid][$scan_date]['carton_weight'] += $shipment->weight;
		                }
	            	}
	            }
	        }
	        foreach ($scan_date_data as $uid => $user_data) {
	            foreach ($user_data as $scan_date => $data) {
	                $hrs = number_format($data['time']/ 3600,2);
	                $dp_packs=$data['dp_packs'];
	                $pcs_packs=$data['pcs_packs'];
	                $carton_packs=$data['carton_packs'];
	                $dp_weight=$data['dp_weight'];
	                $pcs_weight=$data['pcs_weight'];
	                $carton_weight=$data['carton_weight'];
	                $provide[] = [
	                	'id'=>$uid,
	                    'user' => $data['user'],
	                    'depot' => isset($depotMapping[$data['depot']]) ? $depotMapping[$data['depot']] : '',
	                    'dp_packs'=>$dp_packs,
	                    'dp_weight'=>number_format($dp_weight*10,2),
	                    'pcs_packs' => ($pcs_packs-$dp_packs),
	                    'pcs_weight' => number_format(($pcs_weight-$dp_weight),2),
	                    'carton_packs' => $carton_packs,
	                    'carton_weight' => number_format($carton_weight,2),
	                    'scan_date' => $scan_date,
	                    'time' => $hrs,
	                    'total_packs' => ($pcs_packs + $carton_packs),
	                    'total_weight' =>number_format(($dp_weight*10 +$pcs_weight-$dp_weight+$carton_weight),2),
	                ];
	            }
	        }
	    
	    $cache = $this->setCacheData("wdr".$dptId.$service.$start_time.$end_time,$provide,600);
	    return $provide;
	}

}
?>