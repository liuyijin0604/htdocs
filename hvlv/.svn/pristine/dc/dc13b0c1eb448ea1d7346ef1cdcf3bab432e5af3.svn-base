<?php

class CargoBookingController extends Controller
{
    protected $nonAjax = [];
    protected $skipAcl = [];

    public function actionIndex()
    {
        $userId = Yii::app()->user->id;
        $orgId = Yii::app()->user->org;
        $rejected = CargoBooking::model()->findAllByAttributes(['org_id' => $orgId, 'status' => CargoBooking::REJECTED]);
        $rejectedCount = count($rejected);
        $this->render('index', ['uid' => $userId, 'rejectedCount' => $rejectedCount]);
    }

    public function actionProcessPage()
    {
        $this->layout = false;
        $userId = Yii::app()->user->id;
        $user = User::model()->findByPk($userId);
        switch ($_GET['tab']) {
            case 'booking_list':
                $model = new CargoBooking('search');
                $model->unsetAttributes();  // clear any default values
                if (isset($_GET['CargoBooking']))
                    $model->attributes = $_GET['CargoBooking'];
                $this->render('booking_list', [
                    'model' => $model,
                ]);
                break;
            case 'rejected_list':
                $model = new CargoBooking('search');
                $model->unsetAttributes();
                $model->status = CargoBooking::REJECTED;
                if (isset($_GET['CargoBooking']))
                    $model->attributes = $_GET['CargoBooking'];
                $this->render('rejected_list', [
                    'model' => $model,
                ]);
                break;
            case 'create_booking':
                $this->render('create_booking', ['uid' => $userId]);
                break;
        }
    }

    public function actionSearch()
    {
        $containerNo = $_POST['container_no'];
        $hbn = $_POST['hbn'];
        $depot = $_POST['depot'];
        switch ($depot) {
            case 'Sydney':
                $sql = 'SELECT * FROM shipment WHERE hbn = "' . $hbn . '" AND consol_id IN (SELECT id FROM consol WHERE dpt_id = 106 AND (container_no = "' . $containerNo . '" OR awb = "' . $containerNo . '"))';
                break;
            case 'Melbourne':
                $sql = 'SELECT * FROM shipment WHERE hbn = "' . $hbn . '" AND consol_id IN (SELECT id FROM consol WHERE dpt_id = 218 AND (container_no = "' . $containerNo . '" OR awb = "' . $containerNo . '"))';
                break;
            case 'Brisbane':
                $sql = 'SELECT * FROM shipment WHERE hbn = "' . $hbn . '" AND consol_id IN (SELECT id FROM consol WHERE dpt_id = 530 AND (container_no = "' . $containerNo . '" OR awb = "' . $containerNo . '"))';
                break;
            case 'Perth':
                $sql = 'SELECT * FROM shipment WHERE hbn = "' . $hbn . '" AND consol_id IN (SELECT id FROM consol WHERE dpt_id = 811 AND (container_no = "' . $containerNo . '" OR awb = "' . $containerNo . '"))';
                break;
        }

        $shipment = ImParcel::model()->findBySql($sql);
        $model = new stdClass;

        if (!empty($shipment)) {
            $sql = 'SELECT * FROM cargo_booking WHERE shipment_id = ' . $shipment->id . ' AND `status` IN (1,2,3,6)';
            $booking = CargoBooking::model()->findBySql($sql);
            if (empty($booking)) {
                $model->success = true;
                $model->hbn = $hbn;
                $model->shipment_id = $shipment->id;
                $model->weight = $shipment->weight;
                $model->cbm = $shipment->cbm;
                $model->pallets = @$shipment->mdata['amzon_pallet'];
                $model->packages = $shipment->pkg;
                $cnee = Addr::model()->findByPk($shipment->cnee_id);
                if (!empty($cnee)) {
                    $model->cnee = new stdClass;
                    $model->cnee->name = $cnee->name;
                    $model->cnee->company = $cnee->company;
                    $model->cnee->address = $cnee->address;
                    $model->cnee->suburb = $cnee->suburb;
                    $model->cnee->city = $cnee->city;
                    $model->cnee->state = $cnee->state;
                    $model->cnee->postcode = $cnee->postcode;
                    $model->cnee->tel = $cnee->tel;
                    $model->cnee->email = $cnee->email;
                }
                echo json_encode($model);
                return;
            } else {
                $model->success = false;
                $model->msg = 'You have already booked a delivery for this shipment.';
                echo json_encode($model);
                return;
            }
        } else {
            $model->success = false;
            $model->msg = 'We cannot find this shipment information in our system, please check your input.';
            echo json_encode($model);
        }
    }

    public function actionShowPrice()
    {
        $model = new stdClass;
        if (!empty($_POST['shipment_id'])) {
            $shipment = ImParcel::model()->findByPk($_POST['shipment_id']);
            if (!empty($shipment)) {
                if (!empty($shipment->cnee)) {
                    $shipment->receiver->name = $shipment->cnee->name;
                    $shipment->receiver->company = $shipment->cnee->company;
                    $shipment->receiver->address = $shipment->cnee->address;
                    $shipment->receiver->suburb = $shipment->cnee->suburb;
                    $shipment->receiver->city = $shipment->cnee->city;
                    $shipment->receiver->state = $shipment->cnee->state;
                    $shipment->receiver->postcode = $shipment->cnee->postcode;
                    $shipment->receiver->tel = $shipment->cnee->tel;
                    $shipment->receiver->email = $shipment->cnee->email;
                    $shipment->receiver->save();
                    $shipment->cnee->name = $_POST['cnee_name'];
                    $shipment->cnee->company = $_POST['cnee_company'];
                    $shipment->cnee->address = $_POST['cnee_address'];
                    $shipment->cnee->suburb = $_POST['cnee_suburb'];
                    $shipment->cnee->city = $_POST['cnee_city'];
                    $shipment->cnee->state = $_POST['cnee_state'];
                    $shipment->cnee->postcode = $_POST['cnee_postcode'];
                    $shipment->cnee->tel = $_POST['cnee_tel'];
                    $shipment->cnee->email = $_POST['cnee_email'];
                    $shipment->cnee->save();
                } else {
                    $cnee = new Addr();
                    $cnee->name = $_POST['cnee_name'];
                    $cnee->company = $_POST['cnee_company'];
                    $cnee->address = $_POST['cnee_address'];
                    $cnee->suburb = $_POST['cnee_suburb'];
                    $cnee->city = $_POST['cnee_city'];
                    $cnee->state = $_POST['cnee_state'];
                    $cnee->postcode = $_POST['cnee_postcode'];
                    $cnee->tel = $_POST['cnee_tel'];
                    $cnee->email = $_POST['cnee_email'];
                    $cnee->save();
                    $shipment->cnee = $cnee;
                }

                $chargecode = '2280';
                //$chargecode = '8143';
                $basePrice = round($shipment->getChargeByChargecode($chargecode), 2);
                $oversizePrice = $shipment->getChargeByChargecode($chargecode, false, null, true, false, true);
                $oversize = $oversizePrice['amount'];
                $specificDeliveryTimeFee = 0.00;
                $unloadingFee = 0.00;
                if ($_POST['delivery_time'] != 'none') {
                    $specificDeliveryTimeFee = ($basePrice + $oversize) * 0.20;
                    /* if ($specificDeliveryTimeFee == 0) {
                        $specificDeliveryTimeFee = 30.00;
                    } */
                    if ($specificDeliveryTimeFee > 100) {
                        $specificDeliveryTimeFee = 100.00;
                    }
                }
                if ($_POST['folk'] == 'true') {
                    if (!empty($_POST['pallets'])) {
                        $unloadingFee = 20 * $_POST['pallets'];
                    } else {
                        $unloadingFee = 30.00;
                    }
                }
                $gst = ($basePrice + $oversize + $specificDeliveryTimeFee + $unloadingFee) * 0.1;
                $total = $basePrice + $oversize + $specificDeliveryTimeFee + $unloadingFee;


                // Save Cargo booking record
                $cargoBooking = new CargoBooking();
                $cargoBooking->create_date = date('Y-m-d H:i:s');
                $cargoBooking->booking_date_1 = date('Y-m-d', strtotime($_POST['booking_date_1']));
                if (!empty($_POST['booking_date_2'])) {
                    $cargoBooking->booking_date_2 = date('Y-m-d', strtotime($_POST['booking_date_2']));
                }
                $cargoBooking->status = CargoBooking::PRE_PENDING;
                $cargoBooking->delivery_period = $_POST['delivery_time'];
                $cargoBooking->org_id = Yii::app()->user->org;
                $cargoBooking->shipment_id = $shipment->id;
                $cargoBooking->generateBookingNumber("Sydney");


                if ($_POST['folk'] == 'true') {
                    $cargoBooking->mdata['need_unloading'] = 'Yes';
                } else {
                    $cargoBooking->mdata['need_unloading'] = 'No';
                }
                $cargoBooking->mdata['special_need_other'] = $_POST['other'];
                $cargoBooking->mdata['base_price'] = number_format((float)$basePrice, 2, '.', '');
                $cargoBooking->mdata['oversize_fee'] = number_format((float)$oversize, 2, '.', '');
                $cargoBooking->mdata['time_deliver_fee'] = number_format((float)$specificDeliveryTimeFee, 2, '.', '');
                $cargoBooking->mdata['unloading_fee'] = number_format((float)$unloadingFee, 2, '.', '');
                $cargoBooking->destination = $shipment->cnee_id;
                $cargoBooking->fee = number_format((float)$total, 2, '.', '');
                $cargoBooking->hbn = $_POST['shipment_hbn'];
                $cargoBooking->other_ref = @$_POST['other_reference'];
                // Save Cargo Booking DO files
                if (!empty($_FILES)) {
                    $i = 1;
                    $hbn = $_POST['shipment_hbn'];
                    foreach ($_FILES as $fk => $file) {
                        if ($file['error'] == 0 && !empty($file['name'])) {
                            $fileType = substr($file['type'], strpos($file['type'], "/") + 1);
                            $file['name'] = $hbn . "-DO-" . $i . '.' . $fileType;
                            $target_dir = Yii::app()->basePath . DIRECTORY_SEPARATOR . "runtime" . DIRECTORY_SEPARATOR . "cargo_booking_DO" . DIRECTORY_SEPARATOR;
                            if (!is_dir($target_dir)) {
                                mkdir($target_dir);
                            }
                            $target_file = $target_dir . basename($file["name"]);
                            move_uploaded_file($file['tmp_name'], $target_file);
                            // TODO: create a new file type in FileRepo class istead of 18
                            $filerepoId = FileRepo::storeFile($target_file, basename($file["name"]), 200, $cargoBooking->shipment_id);
                            unlink($target_file);
                            $i++;
                        }
                    }
                }

                if ($cargoBooking->save()) {
                    $model->success = true;
                    $model->booking_id = $cargoBooking->id;
                    $model->basePrice = number_format((float)$basePrice, 2, '.', '');
                    $model->oversize = number_format((float)$oversize, 2, '.', '');
                    $model->specificDeliveryTimeFee = number_format((float)$specificDeliveryTimeFee, 2, '.', '');
                    $model->unloadingFee = number_format((float)$unloadingFee, 2, '.', '');
                    $model->gst = number_format((float)$gst, 2, '.', '');
                    $model->total = number_format((float)$total, 2, '.', '');
                    echo json_encode($model);
                } else {
                    echo json_encode($cargoBooking);
                }
            }
        }
    }

    public function actionCreateBooking()
    {
        $cargoBooking = CargoBooking::model()->findByPk($_POST['booking_id']);
        if (!empty($cargoBooking)) {
            $cargoBooking->status = CargoBooking::PENDING;
            $cargoBooking->save();
            $res = new stdClass;
            $res->success = true;
            $res->message = "Cargo booking successfully created.";
            echo json_encode($res);
        } else {
            $res = new stdClass;
            $res->success = false;
            $res->message = "Ops, some error occured.";
            echo json_encode($res);
        }
    }
}
