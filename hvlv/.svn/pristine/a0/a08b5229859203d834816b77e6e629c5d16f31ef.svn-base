  <script type="text/javascript">
  	function quickWorkTimeInput(date)
    {
        var workTime= $("#workTime"+date).val();
        $.ajax({
                url: '<?=$this->createUrl("shipmentScan/workTimeChange")?>',
                type: "post",
                data: {"workTime":workTime,"date":date},
                success: function(r) {
                    if(r=='done')
                     {
                        myApp.notice('Done', 5000);
                     }else
                     {
                        myApp.alert(r, false);   
                     }
                 },
                error: function(e) {
                    console.log(e);
                }
            });     
    }

  </script>