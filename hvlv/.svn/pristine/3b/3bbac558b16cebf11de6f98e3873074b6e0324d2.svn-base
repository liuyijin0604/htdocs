			}
		} else if ($type == 4&&empty($cacheData)) {
			$sql = "SELECT t.id as inv_id, t.no as inv_no,t.consol_id, (SELECT o.name FROM `org` o WHERE o.id=t.to_id) as owner_name , t.date as inv_date, (t.total-IFNULL((SELECT SUM(p.amount) FROM `pay_inv` p INNER JOIN `payment` py ON p.pay_id=py.id WHERE p.inv_id=t.id AND py.type=5 AND py.status=6),0)) as inv_total, (SELECT c.no FROM `consol` c WHERE c.id=t.consol_id) as consol_no, (SELECT c.type FROM `consol` c WHERE c.id=t.consol_id) as consol_type FROM `invoice` t WHERE t.status NOT IN (10,8) AND t.date<= '" . $dateTo . "' AND t.date >='" . $dateFrom . "' HAVING consol_type IN (15,70,80)  ORDER BY t.consol_id,t.date";
