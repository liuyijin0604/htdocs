	public function actionKpiReport()
	{
		$model = new ReportCache('search');
		$model->unsetAttributes();
		$model->setAttribute('id', -1); // dummy data only

		$reports = ReportCache::model()->findAll(['condition'=>'type=:type','params'=>[":type"=>ReportCache::KpiReportMonthly],'order'=> 'create_time asc']);
		$monthList = [];
		foreach ($reports as $key => $report) {
			$month = date('Y-m',strtotime($report->create_time));
			$monthList[$month] = $month;
		}

		$this->render('kpi_rpt', ['model' => $model->search(),'monthList'=>$monthList]);
	}

	public function actionAjaxKpiReport()
	{
		$month = $_GET['month'];
		$report = ReportCache::model()->find('create_time = :month and type=:type',[':month'=>$month."-01 00:00:00",":type"=>ReportCache::KpiReportMonthly]);
		if(empty($report))
		{
			echo "";
			return;
		}
		$report = $report->mdata;
		$tableStr='<div class="grid-view"><table class="items">';
		$headerStr="<tr>";
		foreach ($report["header"] as $key => $value)
		{
			$headerStr.="<th>".$value."</th>";
		}
		$headerStr.="</tr>";
		$totalData = [];
		foreach ($report["totalData"] as $key => $value) {
			$totalData[$value[0].$value[1]] = [$key=>$value];
		}
		$user = User::getCurrentUser();
		if(empty($user->occupation)) return;

		$mySee = [];
		foreach (User::$occupations as $key => $value) {
			if(($user->occupation&$key)>0)
			{
				$mySee = array_merge($mySee,User::$occupation_tree[$key]);
			}
		}

		ksort($totalData);
		$lastRow = [];
		foreach ($totalData as $kk => $rows) {
			foreach ($rows as $k1 => $row) {
				$keyArr = explode('-', $k1);
				$userId = $keyArr[0];
				$thisOccupation = count($keyArr)>1?intval($keyArr[1]):0;
				$thisUser = User::model()->findByPk($k1);
				$canSee = false;
				if($thisUser->id == $user->id)
				{
					$canSee = true;
				}else
				{
					foreach ($mySee as $ss => $see) {
						if(($thisUser->occupation&$see)>0)
						{
							$canSee = true;
							break;
						}
					}
				}
				if(count($keyArr)>1)
				{
					if(($thisUser->occupation&$thisOccupation)==0) continue;
				}
				if(!$canSee) continue;
				$rowStr = "<tr>";
				foreach ($row as $k2 => $value) {
					if($k2>1)
					{
						$rowStr .= '<td>'.CHtml::link($value,$this->createUrl('/report/getKpiReportDetail')."?userId=".$userId."&&occupation=".$thisOccupation."&&type=".$k2."&&month=".$month,['class'=>'tab_link','title'=>'KPI'.$row[0].'|'.$k2.'|'.$month,'style'=>'text-decoration:underline']).'</td>';
					}else
					{
						if(!empty($lastRow)&&$lastRow[$k2]==$row[$k2]&&$k2==0)
						{
							$rowStr .= '<td>'.$value.'</td>';
						}else
						{
							$rowStr .= '<td>'.$value.'</td>';
						}
					}
				}
				$rowStr .="</tr>";
				$headerStr.=$rowStr;
				$lastRow = $row;
				}
		}
		$tableStr.=$headerStr;
		$tableStr.="</table></div>";
		echo $tableStr;
		return;
	}


	public function actionGetKpiReportDetail()
	{
		$type = $_GET['type'];
		$occupation = $_GET['occupation'];
		$userId = $_GET['userId'];
		$month = $_GET['month'];
		$kpiService = new KpiService();
		$report = $kpiService->getKpiDetail($userId,$occupation,$type,$month);
		$user = User::model()->findByPk($userId);
		if(empty($report))
		{
			echo "";
			return;
		}
		$tableStr='<div class="grid-view"><table class="items">';
		$headerStr="<tr>";
		foreach ($report["header"] as $key => $value)
		{
			$headerStr.="<th>".$value."</th>";
		}
		$headerStr.="</tr>";
		foreach ($report["totalData"] as $k1 => $row) {
			$rowStr = "<tr>";
			foreach ($row as $k2 => $value) {
				$rowStr .= '<td>'.$value.'</td>';
			}
			$rowStr .="</tr>";
			$headerStr.=$rowStr;
		}
		$tableStr.=$headerStr;
		$tableStr.="</table></div>";
		echo $tableStr;
		return;
	}



