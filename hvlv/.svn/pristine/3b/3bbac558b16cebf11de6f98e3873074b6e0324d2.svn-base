	public function actionExportGap()
	{
		$start_time = $_GET['start_date'];
		$end_time = $_GET['end_date'];
		$org_id = $_GET['org_id'];
		$sql = "SELECT shipment.id as sid,reconciliation_line.id as rid "
			. "FROM `shipment` INNER JOIN reconciliation_line on shipment.ref=reconciliation_line.shipment_no "
			. "WHERE shipment.ref like :ref and shipment.created>=:start and shipment.created<=:end and shipment.agent_id=:agid";
		$rs = Yii::app()->db->createCommand($sql)->bindValues([':ref' => 'AMQ%', ':start' => $start_time, ':end' => $end_time, ':agid' => $org_id])->queryAll();
		$xls = new oExcel();
		$i = 1;
		$xls->addRow($i++, ['ref', 'Courier Charge Weight', 'PCA Charge Weight']);
		$org = Org::model()->findByPk($org_id);
		$orgName = empty($org) ? $org_id : $org->shortName(3);
		foreach ($rs as $r) {
			$p = ImParcel::model()->findByPk($r['sid']);
			$rc = ReconciliationLine::model()->find('id=:id', [':id' => $r['rid']]);
			$custChargeWt = $p->agent_id == 1206 ? $p->weight : $p->chargeWeight();
			$courierChargeWeight = $rc->weight;
			if ($custChargeWt >= $courierChargeWeight) {
				continue;
			}
			$xls->addRow($i++, [$p->ref, $courierChargeWeight, $custChargeWt]);
		}
		$xls->output($orgName . '_weight_gap.xlsx');
	}

	public function actionImportClient()
	{
		if (!empty($_FILES['client_check_file'])) {
			if (!empty($_FILES['client_check_file']['tmp_name'])) {
				$file = $_FILES['client_check_file'];
				$xls = new oExcel();
				$xls->supported($file['name']);
				$xls->load($file['tmp_name']);
				$data = $xls->getAll();
				$consolIds = [];
				if (!empty($data[1])) {
					if (preg_match("/refCourier Charge WeightPCA Charge Weightcheck weight/i", implode('', $data[1]))) {
						unset($data[1]);
						$o = '';
						foreach ($data as $index => $d) {
							if (empty($d[1]) || empty($d[4])) {
								continue;
							}
							$recon = ReconciliationLine::model()->find('shipment_no=:ref', [':ref' => $d[1]]);
							$p = ImParcel::model()->find('ref=:ref', [':ref' => $d[1]]);
							if (!empty($recon) && !empty($p)) {
								$recon->cust_check_weight = round($d[4], 2);
								$recon->update('cust_check_weight');
							}
							//we produce this invoice based on consol and agent, so every time we will udpate the invoice on the console of that agent;
							if ($p->consol_id <= 0) {
								continue;
							}
							$consolIds[$p->consol_id][] = $p->agent_id;
						}
						foreach ($consolIds as $oid => $agentIds) {
							$imcoCosol = ImcoConsol::model()->findByPk($oid);
							if (!empty($imcoCosol)) {
								$imcoCosol->eParcelWeightDiffInvoice($agentIds);
							}
						}
						$o .= "<p style='color:green;'>Succesfully</p>";
						echo $o;
					} else {
						echo '<p style="color:red"> The template is wrong!</p>';
					}
				} else {
					echo '<p style="color:red"> The file not contain valid content</p>';
				}
			} else {
				echo '<p style="color:red"> The file is not valid</p>';
			}
			return;
		}
		$this->render('client_form');
	}

	public function actionImPlReport()
	{
		$filtersForm = new FiltersForm;
		$provide = [];
		$model = new ImcoConsol('search');
		$model->unsetAttributes();
		$criteria = new CDbCriteria;
		$dpt = isset($_GET['wid']) ? $_GET['wid'] : 0;
		$criteria->compare('t.dpt_id', $dpt);

		$dateFrom = isset($_GET['datefrom']) ? $_GET['datefrom'] : '';
		$dateTo = isset($_GET['dateto']) ? $_GET['dateto'] : '';
		if (!empty($dateFrom)) {
			$criteria->addCondition("t.eta >= '" . $dateFrom . "'");
		}

		if (!empty($dateTo)) {
			$criteria->addCondition("t.eta <= '" . $dateTo . "'");
		}

		$criteria->addCondition("t.owner_id != 114"); // remove pca express owner which is for WMS 3PL local delivery
		$criteria->addInCondition('type', [15, 70, 80]);

		//        $modeldp = new CActiveDataProvider($model, array(
		//            'criteria' => $criteria,
		//            'sort'=>array(
		//                'defaultOrder'=>'t.id DESC',
		//            ),
		//            'pagination'=>array(
		//                'pageSize' => 30,
		//            )
		//        ));

		$consols = Consol::model()->findAll($criteria);
		if (!empty($consols)) {
			foreach ($consols as $con) {
				$provide[] = ['id' => $con->id, 'no' => $con->no, 'owner' => $con->getOwnerName(), 'eta' => $con->eta, 'type' => $con->type, 'shipments' => $con->totShipments(), 'weight' => $con->totWeight(),
					'revenue' => $con->getTotalInvoice(), 'cost' => $con->totCost(), 'gp' => $con->getProfitGP(), 'profit_rate' => ($con->getProfitRate() * 100) . '%'];
			}
		}
		$filteredData = $filtersForm->filter($provide);
		$dataprovider = new CArrayDataProvider($filteredData);
		$dataprovider->pagination = ['pageSize' => 30];
		$sort = new CSort();
		$sort->attributes = [
			'no' => [
				'asc' => 'no ASC',
				'desc' => 'no DESC',
			],
			'eta' => [
				'asc' => 'eta ASC',
				'desc' => 'eta DESC',
			],
			'shipments' => [
				'asc' => 'shipments ASC',
				'desc' => 'shipments DESC',
			],
			'weight' => [
				'asc' => 'weight ASC',
				'desc' => 'weight DESC',
			],
			'revenue' => [
				'asc' => 'revenue ASC',
				'desc' => 'revenue DESC',
			],
			'cost' => [
				'asc' => 'cost ASC',
				'desc' => 'cost DESC',
			],
			'profit_rate' => [
				'asc' => 'profit_rate ASC',
				'desc' => 'profit_rate DESC',
			],
		];
		$sort->defaultOrder = "eta DESC";
		$dataprovider->sort = $sort;

		$totalData = [
			'revenue' => 0,
			'cost' => 0,
			'gp' => 0,
			'profit' => 0,
		];

		$this->render('im_pl_rpt', ['model' => $dataprovider, 'filter' => $filtersForm, 'total' => $totalData]);
	}

