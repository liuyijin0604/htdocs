		$typeArray["dateFrom"] = $dateFrom;
		$typeArray["dateTo"] = $dateTo;
		$typeArray["client_id"] = $client_id;
		$cacheKey = "PLReport:".json_encode($typeArray);
		$cacheData = $reportService->getCacheData($cacheKey);
		if(!empty($cacheData))
		{
			$cacheData = json_decode($cacheData,true);
			$totalData = $cacheData['totalData'];
			$sortAttributes = $cacheData['sortAttributes'];
			$totalData = $cacheData['totalData'];
			$provide = $cacheData['provide'];
			$sortNumberAttributes = $cacheData['sortNumberAttributes'];
