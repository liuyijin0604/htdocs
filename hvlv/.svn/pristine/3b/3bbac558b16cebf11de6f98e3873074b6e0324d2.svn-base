	public function actionAjaxTplGpReport($path){
		
		$pt = explode('/', $path);
		$dptStr = " ";
		if(!empty($pt[0]))
		{
			$dptStr = " AND dpt_id = " . $pt[0];
		}
		$ptc = count($pt);
		if($ptc < 4){

			[$app_name, Yii::app()->name] = [Yii::app()->name, 'TLA'];
			$objInvoices = Invoice::model()->findAll('status not in (1,8,10,99) and dpt_id '. (empty($pt[0]) ? '!' : '') . '= :dpt AND `date` >= :df AND `date` <= :dt and dpmt = 40 and type in (40,60,70)',[':dpt' => $pt[0], ':df' => $pt[1], ':dt' => $pt[2]]);
			Yii::app()->name = $app_name;

			$client = [];
			foreach ($objInvoices as $objInvoice) {

				if (!isset($client[$objInvoice->to_id])) {
					$client[$objInvoice->to_id] = [];
				}

				$objInvoiceLines = $objInvoice->lines;
				//Invoice type 40 OT 60 WMS STORAGE 70 WMS SERVICE
				$numInvoiceType = $objInvoice->type;
				if(!empty($objInvoiceLines)){
					foreach($objInvoiceLines as $objInvoiceLine){
						$numRevenue = ($objInvoiceLine->amount - $objInvoiceLine->gst) * $objInvoiceLine->qty;
						$numCost = 0 ;
						
						if ($objInvoiceLine->det == "Delivery") {
							$wmsTask = WmsTask::model()->findByPk($objInvoiceLine->fid);
							if (!empty($wmsTask)) {
								$shipment = ImParcel::model()->findByPk($wmsTask->mdata['shipment_id']);

								$floatWeight = empty($shipment->weight) ? 0 : $shipment->weight;
								$strPackage = $wmsTask->mainTask->packTask->mdata['pkg'];
								$wmsLength = $wmsWidth = $wmsHeight = $wmsPkgs = 0;
								if (!empty($strPackage)) {
									foreach (json_decode($strPackage, true) as $pkg) {
										if (!empty($pkg['w']) || !empty($pkg['h']) || !empty($pkg['d'])) {
											$wmsLength += $pkg['w'] / 100;
											$wmsWidth += $pkg['h'] / 100;
											$wmsHeight += $pkg['d'] / 100;
											$wmsPkgs++;
										}
									}
								}
								$wmsCourierId = $wmsTask->mdata['courier'];
								$wmsPostcode = $wmsTask->mdata['cnee']['postcode'];
								$wmsSuburb = $wmsTask->mdata['cnee']['suburb'];
								$orgRate = $wmsTask->chooseOrgRate($wmsCourierId, $wmsTask->dpt_id);
								if ($wmsTask->mdata['courier'] == '3702' || $wmsTask->mdata['courier'] == '3701') {
									$wmsCost = round(ImcoConsol::getCourierTestCostPrice($orgRate, $wmsPostcode, $floatWeight, $wmsPkgs, false, $wmsSuburb)['price']);
								}else if($wmsTask->mdata['courier'] == '114'){ //for KP cost
									$wmsCost = 0;
									$objCargoProcess = $shipment->cargo_process;
									if(!empty($objCargoProcess)){
										$wmsCost = $objCargoProcess->getCargoProcessFeeReCal();
									}
								}else {
									if($wmsPkgs == 0){
										$wmsPkgs =1;
									}
									$wmsCost = round(ImcoConsol::getCourierCostPrice($orgRate, $wmsPostcode, $floatWeight, $wmsPkgs, "", $wmsSuburb, false, '', $shipment), 2);
								}
								$wmsSurcharge = round($wmsTask->deliveryTaskSurCharge($wmsCourierId, $wmsLength, $wmsWidth, $wmsHeight, $floatWeight), 2);
								//cost for task
								if(is_numeric($wmsCost) && is_numeric($wmsSurcharge)){
									if(($wmsCost + $wmsSurcharge)>=99999){
										$numCost = 0;
									}else{
										$numCost = $wmsCost + $wmsSurcharge;
									}
								}else{
									$numCost = 0;
								}
								
							}
							
						//stroage cost
						}elseif($objInvoiceLine->det == "Warehouse Storage"){
							if(!empty($objInvoiceLine->mdata['regular'][0])){
								$numStorage = is_int($objInvoiceLine->mdata['regular'][0])? $objInvoiceLine->mdata['regular'][0] * 3.68 : 0;
								$numCost = $numStorage;
							}
							if(!empty($objInvoiceLine->mdata['oversize'][0])){
								$numStorage = is_int($objInvoiceLine->mdata['oversize'][0])? $objInvoiceLine->mdata['oversize'][0] * 7.36 : 0;
								$numCost = $numStorage;
							}
						}

						
						$client[$objInvoice->to_id]['revenue'] +=  $numRevenue;
						$client[$objInvoice->to_id]['cost'] += $numCost;
					}
				}
				//$client[$r['to_id']][$r['currency']][0] += $r['ttl'];
			}

			$ls = '';
			$sum_rev = [];
			$sum_cost = [];
			$audtt_rev = 0;
			$audtt_cost = 0;

			foreach ($client as $dp => $ct) {
				$strOrgName = Org::model()->findByPk($dp)->name;
				$ls .= '<li><p><span class="exp" data-path="' . $path . '/' . $dp . '" data-loaded="0"></span> ' . (($dp == 1) ? 'Other' :$strOrgName) . ' &nbsp; &nbsp; ';
				$tt_rev = [];
				$tt_cost = [];
				$tt_gp=[];
				$sta_rev = 0;
				$sta_cost = 0;
				if(!empty($ct['revenue'])){
					$sta_rev = $ct['revenue'];
					$audtt_rev +=  $ct['revenue'];
					$tt_rev[] = Invoice::$currencies[1] . ' ' . AppHelper::money_format('', $ct['revenue']);
				}else{
					$tt_rev[] = Invoice::$currencies[1] . ' ' . AppHelper::money_format('', 0);
				}

				if(!empty($ct['cost'])){
					$sta_cost = $ct['cost'];
					$audtt_cost += $ct['cost'];
					$tt_cost[] = Invoice::$currencies[1] . ' ' . AppHelper::money_format('', $ct['cost']);
					$tt_gp[] = Invoice::$currencies[1] . ' ' . AppHelper::money_format('', $ct['revenue']-$ct['cost']);
				}else{
					$tt_cost[] = Invoice::$currencies[1] . ' ' . AppHelper::money_format('', 0);
					$tt_gp[] = Invoice::$currencies[1] . ' ' . AppHelper::money_format('', $ct['revenue']-$ct['cost']);
				}


				$ls .= 'Rev: ';
				if (count($tt_rev) > 1) {
					$ls .= '<b>~AUD ' . AppHelper::money_format('', $sta_rev) . '</b> (' . implode(' &nbsp;', $tt_rev) . ')';
				} else {
					$ls .= implode(' &nbsp;', $tt_rev);
				}
				$ls .= ' &nbsp; Cost: ';
				if (count($tt_cost) > 1) {
					$ls .= '<b>~AUD ' . AppHelper::money_format('', $sta_cost) . '</b> (' . implode(' &nbsp;', $tt_cost) . ')';
				} else {
					$ls .= implode(' &nbsp;', $tt_cost);
				}
				$ls .= ' &nbsp; GP: ';
				if (count($tt_gp) > 1) {
					$ls .= '<b>~AUD ' . AppHelper::money_format('', $sta_rev-$sta_cost) . '</b> (' . implode(' &nbsp;', $tt_gp) . ')';
				} else {
					$ls .= implode(' &nbsp;', $tt_gp);
				}
				$ls .= ' &nbsp; Margin: <b>' . ($sta_rev > 0 ? (round(($sta_rev - $sta_cost) / $sta_rev, 4) * 100) : '-') . '%</b></p><ul></ul></li>';
			}
			$rcs = [];
			if ($audtt_rev != 0 ) {
				$rcs[] = Invoice::$currencies[1] . ' ' . AppHelper::money_format('', $audtt_rev);
			}
			$ccs = [];
			if ($audtt_cost != 0 ) {
				$ccs[] = Invoice::$currencies[1] . ' ' . AppHelper::money_format('', $audtt_cost);
			}
			$gps = [];
			if($audtt_rev != 0 && $audtt_cost != 0){
				$gps[] = Invoice::$currencies[1] . ' ' . AppHelper::money_format('', $audtt_rev - $audtt_cost);
			}
			echo '<li><p>Total - Rev: ';
			if (count($rcs) > 1) {
				echo '<b>~AUD ' . AppHelper::money_format('', $audtt_rev) . '</b> (' . implode(' &nbsp;', $rcs) . ')';
			} else {
				echo 'AUD ' . AppHelper::money_format('', $audtt_rev);
			}

			echo ' &nbsp; Cost: ';
			if (count($ccs) > 1) {
				echo '<b>~AUD ' . AppHelper::money_format('', $audtt_cost) . '</b> (' . implode(' &nbsp;', $ccs) . ')';
			} else {
				echo 'AUD ' . AppHelper::money_format('', $audtt_cost);
			}

			echo ' &nbsp; GP: ';
			if (count($gps) > 1) {
				echo '<b>~AUD ' . AppHelper::money_format('', ($audtt_rev - $audtt_cost)) . '</b> (' . implode(' &nbsp;', $gps) . ')';
			} else {
				echo 'AUD ' . AppHelper::money_format('',($audtt_rev - $audtt_cost));
			}

			echo ' &nbsp; Margin: <b>' . ($audtt_rev > 0 ? (round(($audtt_rev - $audtt_cost) / $audtt_rev, 4) * 100) : '-') . '%</b></p><ul>' . $ls . '</ul></li>';
		} elseif($ptc == 4){
			echo '<li><p><span class="exp" data-path="' . $path . '/service" data-loaded="0"></span>Wms Services</p><ul></ul></li>
				<li><p><span class="exp" data-path="' . $path . '/stroage" data-loaded="0"></span>Wms Stroage</p><ul></ul></li>
				<li><p><span class="exp" data-path="' . $path . '/ot" data-loaded="0"></span>OT Invoice</p><ul></ul></li>';//<li><p><a href="report/ajaxCogsSumReport.app?path=' . $path . '/export" target="_blank">Export</a></p></li>
		} elseif($ptc == 5 && $pt[4]=='service'){
			$param = [':dpt' => $pt[0], ':df' => $pt[1], ':dt' => $pt[2]];
			if ($pt[3] > 1) {
				$param[':to_id'] = $pt[3];
			}
			[$app_name, Yii::app()->name] = [Yii::app()->name, 'TLA'];
			$objServiceInvoicemodels = Invoice::model()->findAll('status not in (1,8,10,99) and dpt_id '. (empty($pt[0]) ? '!' : '') . '= :dpt AND `date` >= :df AND `date` <= :dt and `to_id` = :to_id and type = 70 and dpmt = 40',$param);
			Yii::app()->name = $app_name;

			$arrService = [];
			$numTotalRevenue = $numTotalCost = $numTotalGP = 0;
			foreach($objServiceInvoicemodels as $objServiceInvoicemodel){
				$objInvoiceLines = $objServiceInvoicemodel->lines;
				if(!empty($objInvoiceLines)){
					foreach($objInvoiceLines as $objInvoiceLine){
						$numServiceRevenue = ($objInvoiceLine->amount - $objInvoiceLine->gst) * $objInvoiceLine->qty;
						$numServiceCost = 0 ;
						if(!empty(json_decode($objInvoiceLine->meta)->items)){
							$strTaskId = json_decode($objInvoiceLine->meta)->items[0][0];
							$strCompDate = json_decode($objInvoiceLine->meta)->items[0][2];
							$strDescription = $objInvoiceLine->det;
						}
						
						$wmsTask = WmsTask::model()->findByPk($objInvoiceLine->fid);
						if(!empty($wmsTask)){
							if ($objInvoiceLine->det == "Delivery") {
								if (!empty($wmsTask)) {
									$shipment = ImParcel::model()->findByPk($wmsTask->mdata['shipment_id']);
								}
								$floatWeight = empty($shipment->weight) ? 0 : $shipment->weight;
								$strPackage = $wmsTask->mainTask->packTask->mdata['pkg'];
								$wmsLength = $wmsWidth = $wmsHeight = $wmsPkgs = 0;
								if (!empty($strPackage)) {
									foreach (json_decode($strPackage, true) as $pkg) {
										if (!empty($pkg['w']) || !empty($pkg['h']) || !empty($pkg['d'])) {
											$wmsLength += $pkg['w'] / 100;
											$wmsWidth += $pkg['h'] / 100;
											$wmsHeight += $pkg['d'] / 100;
											$wmsPkgs++;
										}
									}
								}
								$wmsCourierId = $wmsTask->mdata['courier'];
								$wmsPostcode = $wmsTask->mdata['cnee']['postcode'];
								$wmsSuburb = $wmsTask->mdata['cnee']['suburb'];
								$orgRate = $wmsTask->chooseOrgRate($wmsCourierId, $wmsTask->dpt_id);
								if ($wmsTask->mdata['courier'] == '3702' || $wmsTask->mdata['courier'] == '3701') {
									$wmsCost = round(ImcoConsol::getCourierTestCostPrice($orgRate, $wmsPostcode, $floatWeight, $wmsPkgs, false, $wmsSuburb)['price']);
								}else if($wmsTask->mdata['courier'] == '114'){ //for KP cost
									$wmsCost = 0;
									$objCargoProcess = $shipment->cargo_process;
									if(!empty($objCargoProcess)){
										$wmsCost = $objCargoProcess->getCargoProcessFeeReCal();
									}
								}else {
									if($wmsPkgs == 0){
										$wmsPkgs =1;
									}
									$wmsCost = round(ImcoConsol::getCourierCostPrice($orgRate, $wmsPostcode, $floatWeight, $wmsPkgs, "", $wmsSuburb, false, '', $shipment), 2);
								}
								$wmsSurcharge = round($wmsTask->deliveryTaskSurCharge($wmsCourierId, $wmsLength, $wmsWidth, $wmsHeight, $floatWeight), 2);
								//cost for task
								if(($wmsCost + $wmsSurcharge)>=99999){
									$numServiceCost = 0;
								}else{
									$numServiceCost = $wmsCost + $wmsSurcharge;
								}
							}
						}
						$arrService[$objInvoiceLine->id]['taskid'] = $strTaskId;
						$arrService[$objInvoiceLine->id]['compdate'] = $strCompDate;
						$arrService[$objInvoiceLine->id]['description'] = $strDescription;
						$arrService[$objInvoiceLine->id]['revenue'] =  $numServiceRevenue;
						$arrService[$objInvoiceLine->id]['cost'] = $numServiceCost;
						$arrService[$objInvoiceLine->id]['gp'] = $numServiceRevenue - $numServiceCost;

						$numTotalRevenue += $numServiceRevenue;
						$numTotalCost += $numServiceCost;
						
					}
					$numTotalGP = $numTotalRevenue - $numTotalCost;
				}
			}
			$rcs = [];
			if ($numTotalRevenue != 0 ) {
				$rcs[] = Invoice::$currencies[1] . ' ' . AppHelper::money_format('',  $numTotalRevenue);
			}
			$ccs = [];
			if ($numTotalCost != 0 ) {
				$ccs[] = Invoice::$currencies[1] . ' ' . AppHelper::money_format('', $numTotalCost);
			}
			if($numTotalGP != 0){
				$gps[] = Invoice::$currencies[1] . ' ' . AppHelper::money_format('', $numTotalGP);
			}

			echo '<p>Wms Services Total - Rev: ';
			if (count($rcs) > 1) {
				echo '<b>~AUD ' . AppHelper::money_format('', $numTotalRevenue) . '</b> (' . implode(' &nbsp;', $rcs) . ')';
			} else {
				echo 'AUD ' . AppHelper::money_format('', $numTotalRevenue);
			}

			echo ' &nbsp; Cost: ';
			if (count($ccs) > 1) {
				echo '<b>~AUD ' . AppHelper::money_format('', $numTotalCost) . '</b> (' . implode(' &nbsp;', $ccs) . ')';
			} else {
				echo 'AUD ' . AppHelper::money_format('', $numTotalCost);
			}

			echo ' &nbsp; GP: ';
			if (count($gps) > 1) {
				echo '<b>~AUD ' . AppHelper::money_format('', ($numTotalGP)) . '</b> (' . implode(' &nbsp;', $gps) . ')';
			} else {
				echo 'AUD ' . AppHelper::money_format('',($numTotalGP));
			}
			echo ' &nbsp; Margin: <b>' . ($numTotalRevenue > 0 ? (round(($numTotalGP) / $numTotalRevenue, 4) * 100) : '-') . '%</b></p>';
			
			$out = '<div class="grid-view"><table class="items"><thead><tr><th>Task Id</th><th>Comp</th><th>Description</th><th>Rev.</th><th>Cost</th><th>GP</th></tr></thead><tbody>';

			foreach ($arrService as $oid => $ct) {
				$tr = '<tr><td  text-align:center;>' . $ct['taskid'] . '</td><td text-align:center;>' . $ct['compdate'] . '</td><td text-align:center;>' . $ct['description'] . '</td><td text-align:center;>' . $ct['revenue'] . '</td><td text-align:center;>' . $ct['cost'] . '</td><td text-align:center;>' . $ct['gp'] . '</td></tr>';
				$out .= $tr;
			}
			echo $out . '</tbody></table></div>';
		} elseif($ptc == 5 && $pt[4]=='stroage'){
			$param = [':dpt' => $pt[0], ':df' => $pt[1], ':dt' => $pt[2]];
			if ($pt[3] > 1) {
				$param[':to_id'] = $pt[3];
			}
			[$app_name, Yii::app()->name] = [Yii::app()->name, 'TLA'];
			$objStroageInvoicemodels = Invoice::model()->findAll('status not in (1,8,10,99) and dpt_id '. (empty($pt[0]) ? '!' : '') . '= :dpt AND `date` >= :df AND `date` <= :dt and `to_id` = :to_id and type = 60 and dpmt = 40',$param);
			Yii::app()->name = $app_name;

			$arrStroage = [];
			$numTotalRevenue = $numTotalCost = $numTotalGP = 0;
			foreach($objStroageInvoicemodels as $objStroageInvoicemodel){
				$objInvoiceLines = $objStroageInvoicemodel->lines;
				if(!empty($objInvoiceLines)){
					foreach($objInvoiceLines as $objInvoiceLine){
						$numStroageRevenue = ($objInvoiceLine->amount - $objInvoiceLine->gst) * $objInvoiceLine->qty;
						$numStroageCost = 0 ;
						if(!empty(json_decode($objInvoiceLine->meta)->items)){
							$strInvoiceNo = $objStroageInvoicemodel->no;
							$strCompDate = $objStroageInvoicemodel->date;
							$strDescription = $objInvoiceLine->det;
						}
						

						if($objInvoiceLine->det == "Warehouse Storage"){
							if(!empty($objInvoiceLine->mdata['regular'][0])){
								$numStorage = is_int($objInvoiceLine->mdata['regular'][0])? $objInvoiceLine->mdata['regular'][0] * 3.68 : 0;
								$numStroageCost += $numStorage;
								$strDescription .= " Regular PLT: ".$objInvoiceLine->mdata['regular'][0];
							}
							if(!empty($objInvoiceLine->mdata['oversize'][0])){
								$numStorage = is_int($objInvoiceLine->mdata['oversize'][0])? $objInvoiceLine->mdata['oversize'][0] * 7.36 : 0;
								$numStroageCost += $numStorage;
								$strDescription .= " Oversize PLT: ".$objInvoiceLine->mdata['oversize'][0];
							}
						}
						

						$arrStroage[$objInvoiceLine->id]['invoiceno'] = $strInvoiceNo;
						$arrStroage[$objInvoiceLine->id]['compdate'] = $strCompDate;
						$arrStroage[$objInvoiceLine->id]['description'] = $strDescription;
						$arrStroage[$objInvoiceLine->id]['revenue'] =  $numStroageRevenue;
						$arrStroage[$objInvoiceLine->id]['cost'] = $numStroageCost;
						$arrStroage[$objInvoiceLine->id]['gp'] = $numStroageRevenue - $numStroageCost;

						$numTotalRevenue += $numStroageRevenue;
						$numTotalCost += $numStroageCost;
					}
					$numTotalGP = $numTotalRevenue - $numTotalCost;
				}
			}

			$rcs = [];
			if ($numTotalRevenue != 0 ) {
				$rcs[] = Invoice::$currencies[1] . ' ' . AppHelper::money_format('',  $numTotalRevenue);
			}
			$ccs = [];
			if ($numTotalCost != 0 ) {
				$ccs[] = Invoice::$currencies[1] . ' ' . AppHelper::money_format('', $numTotalCost);
			}
			if($numTotalGP != 0){
				$gps[] = Invoice::$currencies[1] . ' ' . AppHelper::money_format('', $numTotalGP);
			}

			echo '<p>Wms Stroage Total - Rev: ';
			if (count($rcs) > 1) {
				echo '<b>~AUD ' . AppHelper::money_format('', $numTotalRevenue) . '</b> (' . implode(' &nbsp;', $rcs) . ')';
			} else {
				echo 'AUD ' . AppHelper::money_format('', $numTotalRevenue);
			}

			echo ' &nbsp; Cost: ';
			if (count($ccs) > 1) {
				echo '<b>~AUD ' . AppHelper::money_format('', $numTotalCost) . '</b> (' . implode(' &nbsp;', $ccs) . ')';
			} else {
				echo 'AUD ' . AppHelper::money_format('', $numTotalCost);
			}

			echo ' &nbsp; GP: ';
			if (count($gps) > 1) {
				echo '<b>~AUD ' . AppHelper::money_format('', ($numTotalGP)) . '</b> (' . implode(' &nbsp;', $gps) . ')';
			} else {
				echo 'AUD ' . AppHelper::money_format('',($numTotalGP));
			}
			echo ' &nbsp; Margin: <b>' . ($numTotalRevenue > 0 ? (round(($numTotalGP) / $numTotalRevenue, 4) * 100) : '-') . '%</b></p>';


			$out = '<div class="grid-view"><table class="items"><thead><tr><th>Invoice Id</th><th>Comp</th><th>Description</th><th>Rev.</th><th>Cost</th><th>GP</th></tr></thead><tbody>';

			foreach ($arrStroage as $oid => $ct) {
				$tr = '<tr><td  text-align:center;>' . $ct['invoiceno'] . '</td><td text-align:center;>' . $ct['compdate'] . '</td><td text-align:center;>' . $ct['description'] . '</td><td text-align:center;>' . $ct['revenue'] . '</td><td text-align:center;>' . $ct['cost'] . '</td><td text-align:center;>' . $ct['gp'] . '</td></tr>';
				$out .= $tr;
			}
			echo $out . '</tbody></table></div>';
		} elseif($ptc == 5 && $pt[4]=='ot'){
			$param = [':dpt' => $pt[0], ':df' => $pt[1], ':dt' => $pt[2]];
			if ($pt[3] > 1) {
				$param[':to_id'] = $pt[3];
			}
			[$app_name, Yii::app()->name] = [Yii::app()->name, 'TLA'];
			$objOTInvoicemodels = Invoice::model()->findAll('status not in (1,8,10,99) and dpt_id '. (empty($pt[0]) ? '!' : '') . '= :dpt AND `date` >= :df AND `date` <= :dt and `to_id` = :to_id and type = 40 and dpmt = 40',$param);
			Yii::app()->name = $app_name;

			$arrOT = [];
			$numTotalRevenue = $numTotalCost = $numTotalGP = 0;
			foreach($objOTInvoicemodels as $objOTInvoicemodel){
				$objInvoiceLines = $objOTInvoicemodel->lines;
				if(!empty($objInvoiceLines)){
					foreach($objInvoiceLines as $objInvoiceLine){

						$numOTCost = 0;
						if(!empty($objInvoiceLine->linkto)){
							$numOTCost = $objInvoiceLine->getRelatedSupplyCost();
						}

						$numOTRevenue = ($objInvoiceLine->amount - $objInvoiceLine->gst) * $objInvoiceLine->qty;
						$strInvoiceNo = $objOTInvoicemodel->no;
						$strCompDate = $objOTInvoicemodel->date;
						$strDescription = $objInvoiceLine->det;

						$arrOT[$objInvoiceLine->id]['invoiceno'] = $strInvoiceNo;
						$arrOT[$objInvoiceLine->id]['compdate'] = $strCompDate;
						$arrOT[$objInvoiceLine->id]['description'] = $strDescription;
						$arrOT[$objInvoiceLine->id]['revenue'] =  $numOTRevenue;
						$arrOT[$objInvoiceLine->id]['cost'] = $numOTCost;
						$arrOT[$objInvoiceLine->id]['gp'] = $numOTRevenue - $numOTCost;

						$numTotalRevenue += $numOTRevenue;
						$numTotalCost += $numOTCost;
					}
					$numTotalGP = $numTotalRevenue - $numTotalCost;
				}
			}
			$rcs = [];
			if ($numTotalRevenue != 0 ) {
				$rcs[] = Invoice::$currencies[1] . ' ' . AppHelper::money_format('',  $numTotalRevenue);
			}
			$ccs = [];
			if ($numTotalCost != 0 ) {
				$ccs[] = Invoice::$currencies[1] . ' ' . AppHelper::money_format('', $numTotalCost);
			}
			if($numTotalGP != 0){
				$gps[] = Invoice::$currencies[1] . ' ' . AppHelper::money_format('', $numTotalGP);
			}

			echo '<p>OT Invoice Total - Rev: ';
			if (count($rcs) > 1) {
				echo '<b>~AUD ' . AppHelper::money_format('', $numTotalRevenue) . '</b> (' . implode(' &nbsp;', $rcs) . ')';
			} else {
				echo 'AUD ' . AppHelper::money_format('', $numTotalRevenue);
			}

			echo ' &nbsp; Cost: ';
			if (count($ccs) > 1) {
				echo '<b>~AUD ' . AppHelper::money_format('', $numTotalCost) . '</b> (' . implode(' &nbsp;', $ccs) . ')';
			} else {
				echo 'AUD ' . AppHelper::money_format('', $numTotalCost);
			}

			echo ' &nbsp; GP: ';
			if (count($gps) > 1) {
				echo '<b>~AUD ' . AppHelper::money_format('', ($numTotalGP)) . '</b> (' . implode(' &nbsp;', $gps) . ')';
			} else {
				echo 'AUD ' . AppHelper::money_format('',($numTotalGP));
			}
			echo ' &nbsp; Margin: <b>' . ($numTotalRevenue > 0 ? (round(($numTotalGP) / $numTotalRevenue, 4) * 100) : '-') . '%</b></p>';

			$out = '<div class="grid-view"><table class="items"><thead><tr><th>Invoice Id</th><th>Comp</th><th>Description</th><th>Rev.</th><th>Cost</th><th>GP</th></tr></thead><tbody>';

			foreach ($arrOT as $oid => $ct) {
				$tr = '<tr><td  text-align:center;>' . $ct['invoiceno'] . '</td><td text-align:center;>' . $ct['compdate'] . '</td><td text-align:center;>' . $ct['description'] . '</td><td text-align:center;>' . $ct['revenue'] . '</td><td text-align:center;>' . $ct['cost'] . '</td><td text-align:center;>' . $ct['gp'] . '</td></tr>';
				$out .= $tr;
			}
			echo $out . '</tbody></table></div>';
		}
	}
	
}
