	protected function acc_ddc()
	{
		$c = ExcoConsol::model()->findByPk($_POST['ExParcel']['consol_id']);
		$xls = new oExcel;
		$i = 1;
		$xls->setColWidth([20, 10, 20, 10, 15, 10, 10, 10, 15, 15, 15]);
		$xls->addRow($i++, ['WBN', 'REF', 'AWB', 'Agent', 'Weight', 'State', 'Rate', 'Delivery Charge']);
		if (empty($c->eta) || $c->eta == '0000-00-00') {
			$c->eta = (empty($c->etd) || $c->etd == '0000-00-00') ? $c->created : $c->etd;
		}
		foreach ($c->shipments as $p) {
			$typ = $p->goodsType();
			$ln = $p->getLastLog();
			$weight = $p->chargeWeight();
			$rate = $p->rating($c->poc, $c->exrate, true, $c->eta);
			$cost = round($p->getCost() / $c->exrate * 100) / 100;
			$xls->addRow($i++, [$p->hbn, $p->ref, $p->getAwb(), empty($p->agent) ? '' : $p->agent->name, $weight, $p->state, $rate[1]->zone, $rate[0]]);
		}
		$xls->output($c->no . '_ddc_report.xlsx');
	}

	protected function acc_iwr()
	{
		$xls = new oExcel;
		$i = 1;
		$xls->setColWidth([15, 20, 10, 20, 10, 15, 10, 15, 20, 10, 10, 10, 10, 15, 15]);
		$xls->addRow($i++, ['Invoice #', 'Bill To', 'Agent ID', 'Status', 'Branch', 'Date', 'Due', 'Currency', 'B Pcs', 'M Pcs', 'O Pcs', 'Total Pcs', 'B Weight', 'M Weight', 'O Weight', 'Total Weight', 'B Total', 'M Total', 'O Total', 'Total', 'Paid', 'Balance']);

		$rs = Invoice::model()->findAll('type = 20 AND date >= :df AND date <= :dt AND status > 1 AND status < 10', [':df' => $_POST['date']['from'], ':dt' => $_POST['date']['to']]);

		foreach ($rs as $r) {
			$wws = ['B' => 0, 'M' => 0, 'O' => 0];
			$tts = ['B' => 0, 'M' => 0, 'O' => 0];
			$pps = ['B' => 0, 'M' => 0, 'O' => 0];
			foreach ($r->lines as $il) {
				foreach ($il->mdata['items'] as $itm) {
					$wws[$itm[4]] += $itm[2];
					$tts[$itm[4]] += $itm[7];
					$pps[$itm[4]]++;
				}
			}
			$xls->addRow($i++, ['="' . $r->no . '"', empty($r->to_id) ? "" : $r->cust->name, $r->to_id, $r->getStatus(), $r->getBranch(), $r->date, $r->due, $r->getCurrency(), $pps['B'], $pps['M'], $pps['O'], array_sum($pps), $wws['B'], $wws['M'], $wws['O'], array_sum($wws), $tts['B'], $tts['M'], $tts['O'], $r->total, $r->paid(), $r->getBalance()]);
		}
		$xls->output('exp_invoice_weight_report_' . date('Ymd') . '.xlsx');
	}

	protected function acc_vol()
	{
		$xls = new oExcel;
		$i = 1;
		$xls->setColWidth([15, 20, 10, 10, 10, 10]);
		$xls->addRow($i++, ['Consol #', 'AWB', 'ETD', 'Packs', 'Excl. Pks', 'Weight', 'AWB Weight', 'Comm. Packs']);
		$rs = ExcoConsol::model()->findAll('etd >= :df AND etd <= :dt AND status > 10', [':df' => $_POST['date']['from'], ':dt' => $_POST['date']['to']]);

		foreach ($rs as $r) {
			$packs = $r->totShipments();
			$twt = $r->totWeight();
			if (empty($packs)) {
				continue;
			}
			$sql = 'SELECT COUNT(id) AS t FROM shipment WHERE agent_id IN (861, 800) AND consol_id = ' . $r->id;
			$exq = Yii::app()->db->createCommand($sql)->queryScalar();
			$xls->addRow($i++, ['="' . $r->no . '"', '="' . $r->awb . '"', $r->etd, $packs, $exq, $twt, empty($r->mdata['awb_check_wt']) ? 0 : $r->mdata['awb_check_wt'], '=D' . ($i - 1) . '-E' . ($i - 1)]);
		}
		$li = $i - 1;
		$xls->addRow($i++, ['', '', '', '=SUM(D2:D' . $li . ')', '=SUM(E2:E' . $li . ')', '=SUM(F2:F' . $li . ')', '=SUM(G2:G' . $li . ')', '=SUM(H2:H' . $li . ')']);
		$xls->output('exp_vol_report_' . $_POST['date']['from'] . '-' . $_POST['date']['to'] . '.xlsx');
	}

	public function actionChart()
	{
		if (!empty($_GET['t'])) {
			$x = '`date`';
			$dr = 'DATE_SUB(CURRENT_DATE, INTERVAL 15 DAY)';

			if ($_GET['f'] == 'm') {
				$x = 'SUBSTR(`date`, 1, 7)';
				$dr = 'DATE_SUB(CURRENT_DATE, INTERVAL 12 MONTH)';
			} elseif ($_GET['f'] == 'w') {
				$x = 'CONCAT(YEAR(`date`), \'w\', LPAD(WEEK(`date`, 7),2,0))';
				$dr = 'DATE_SUB(CURRENT_DATE, INTERVAL 2 MONTH)';
			}

			$sql = 'SELECT type AS t, SUM(qty) AS q, SUM(wt) AS w, ' . $x . ' AS x FROM ex_stat WHERE ' . ($_GET['org_id'] > 0 ? 'org_id = ' . $_GET['org_id'] . ' AND ' : '') . '`date` >= ' . $dr . ' GROUP BY x, type ORDER BY x ASC';

			$rs = Yii::app()->db->createCommand($sql)->queryAll();

			$w2sd = function ($w) {
				if (preg_match('/(\d{4})w0*(\d+)/', $w, $m)) {
					$time = strtotime("1 January " . $m[1]);
					$day = date('w', $time);
					$time += ((7 * ($m[2] - 1)) + 1 - $day) * 24 * 3600;
					return 'W' . date('Y-m-d', $time);
				}
			};

			$labels = [];
			$dss = [];
			foreach ($rs as $r) {
				if ($_GET['f'] == 'w') {
					$r['x'] = $w2sd($r['x']);
				}
				if (!in_array($r['x'], $labels)) {
					$labels[] = $r['x'];
				}
				if (!isset($dss[$r['t']])) {
					$dss[$r['t']] = ['label' => ExStat::$types[$r['t']], 'data' => [], 'backgroundColor' => ExStat::type2color($r['t'], 0.3), 'borderWidth' => 1];
				}
				if ($_GET['t'] == 'line') {
					$dss[$r['t']]['backgroundColor'] = 'rgba(0,0,0,0)';
					$dss[$r['t']]['borderColor'] = ExStat::type2color($r['t']);
					$dss[$r['t']]['borderWidth'] = 2;
					$dss[$r['t']]['pointRadius'] = 5;
					$dss[$r['t']]['lineTension'] = 0.25;
				}
				$dss[$r['t']]['data'][] = $_GET['y'] == 'q' ? $r['q'] : $r['w'];
			}

			$options = ['responsive' => true];

			if ($_GET['t'] == 'barstack') {
				$_GET['t'] = 'bar';
				$options['scales'] = [
					'xAxes' => [[
						'stacked' => true,
					]],
					'yAxes' => [[
						'stacked' => true,
					]],
				];
				$dst = [];
				foreach ($dss as $t => $d) {
					foreach ($d['data'] as $i => $q) {
						if (!isset($dst[$i])) {
							$dst[$i] = 0;
						}
						$dst[$i] += $q;
					}
				}

				foreach ($dss as $t => $d) {
					foreach ($d['data'] as $i => $q) {
						$dss[$t]['data'][$i] = round($q / $dst[$i] * 1000) / 10;
					}
				}
			}

			ksort($dss);
			$dss = array_values($dss);

			$r = [
				'type' => $_GET['t'],
				'data' => [
					'labels' => $labels,
					'datasets' => $dss,
				],
				'options' => $options,
			];
			echo json_encode($r);
			Yii::app()->end();
		}
		$this->render('chart');
	}

	public function actionInvoiceGST()
	{
		if (empty($_POST)) {
			$this->render('invoice_gst');
		} else {
			if (empty($_POST['fromdate'])) {
				$_POST['fromdate'] = date('Y-m-d', strtotime('- 1 month'));
			}
			if (empty($_POST['todate'])) {
				$_POST['todate'] = date('Y-m-d');
			}

			$sql = 'SELECT invoice.type, invoice.to_id, inv_line.ccode, SUM(inv_line.amount) AS amount, SUM(inv_line.gst) AS gst, IF(inv_line.gst > 0, 1, 0) AS sup FROM inv_line JOIN invoice ON inv_line.inv_id = invoice.id WHERE invoice.date >= :fromdate AND invoice.date <= :todate GROUP BY invoice.type, invoice.to_id, inv_line.ccode, sup ORDER BY invoice.type, invoice.to_id, inv_line.ccode, sup';
			$lines = Yii::app()->db->createCommand($sql)->bindValues([':fromdate' => $_POST['fromdate'], ':todate' => $_POST['todate']])->queryAll();

			$xls = new oExcel;
			$i = 1;
			$xls->setColWidth([15, 25, 10, 20, 10, 10, 10]);
			$xls->addRow($i++, ['Invoice Type', 'Client', 'Client ID', 'Description', 'Net Value', 'GST', 'Total']);

			$checkcodes = [];
			foreach ($lines as $line) {
				$ccodeModel = ChargeItemType::model()->find('code = :ccode', [':ccode' => $line['ccode']]);
				if (empty($ccodeModel)) {
					$ccodeModel = Chargecode::model()->find('code = :ccode', [':ccode' => $line['ccode']]);
				}
				if (!empty($ccodeModel)) {
					$ccode = $ccodeModel->name;
				} else {
					if (in_array($line['type'], [60, 65, 70, 75]) && is_numeric($line['ccode'])) {
						if (!empty(WmsOrgQuote::$chgcodes[$line['ccode']][0])) {
							$ccode = WmsOrgQuote::$chgcodes[$line['ccode']][0];
						}
					} else {
						$ccode = $line['ccode'];
					}
				}

				if ($line['gst'] == 0) {
					$checkcodes[$line['type'] . '@@' . $line['to_id'] . '@@' . $line['ccode']] = 0;

					$invlines = InvLine::model()->with('invoice')->findAll('invoice.type = :type AND invoice.to_id = :org AND ccode = :ccode AND t.gst = 0 AND invoice.date >= :from AND invoice.date <= :to', [
						':type' => $line['type'],
						':org' => $line['to_id'],
						':ccode' => $line['ccode'],
						':from' => $_POST['fromdate'],
						':to' => $_POST['todate'],
					]);

					$invoices = [];
					foreach ($invlines as $invline) {
						if (!in_array($invline->invoice->no, $invoices)) {
							$invoices[] = $invline->invoice->no;
						}
					}

					$xls->addRow($i++, [Invoice::$types[$line['type']], Org::getName($line['to_id']), $line['to_id'], $ccode, $line['amount'] - $line['gst'], $line['gst'], $line['amount'], implode(',', $invoices)]);
				} elseif ($line['gst'] > 0 && isset($checkcodes[$line['type'] . '@@' . $line['to_id'] . '@@' . $line['ccode']])) {
					$checkcodes[$line['type'] . '@@' . $line['to_id'] . '@@' . $line['ccode']] = 1;

					$xls->addRow($i++, [Invoice::$types[$line['type']], Org::getName($line['to_id']), $line['to_id'], $ccode, $line['amount'] - $line['gst'], $line['gst'], $line['amount']]);
				}
			}

			$xls->addRow($i++, []);
			$xls->addRow($i++, ['Invoice', 'Client', 'Description', 'Net Value', 'GST', 'Total']);
			foreach ($checkcodes as $checkcode => $v) {
				if ($v == 0) {
					continue;
				}
				$lines = InvLine::model()->with('invoice')->findAll('invoice.type = :type AND invoice.to_id = :org AND ccode = :ccode AND t.gst = 0 AND invoice.date >= :from AND invoice.date <= :to', [
					':type' => explode('@@', $checkcode)[0],
					':org' => explode('@@', $checkcode)[1],
					':ccode' => explode('@@', $checkcode)[2],
					':from' => $_POST['fromdate'],
					':to' => $_POST['todate'],
				]);

				foreach ($lines as $line) {
					$xls->addRow($i++, [$line->invoice->no, Org::getName($line->invoice->to_id), $line->invoice->to_id, explode('@@', $checkcode)[2], $line->amount - $line->gst, $line->gst, $line->amount]);
				}
			}

			$xls->output('invoice_gst_report_' . $_POST['fromdate'] . '-' . $_POST['todate'] . '.xlsx');
		}
	}
	public function actionGetDFEAndTntCost() //

	{
		$shipments = ImParcel::model()->with('trans')->findAll('trans.org_id = 976 and trans.cost>0 and (TO_DAYS(trans.time) >= TO_DAYS("2019-11-01") )and (TO_DAYS(trans.time) <= TO_DAYS("2019-12-31") )');
		$xls = new oExcel;
		$i = 1;
		$xls->addRow($i++, ['HBN', 'Ref', 'Postcode', 'Suburb', 'State', 'TNT cost', 'Total DFE cost(+ Forwarding Fee)', 'Forwarding Fee']);

		foreach ($shipments as $shipment) {
			$trans = $shipment->trans;
			$trans = end($trans);
			$price = 0;
			$zoneMap = DfeZone::model()->find('postcode = :postcode AND state = :state AND postcodename = :suburb', [':postcode' => $shipment->cnee->postcode, ':state' => strtoupper($shipment->cnee->state), ':suburb' => strtoupper($shipment->cnee->suburb)]);
			$chargeCode = 'N1';
			$postcodename = '';
			if (!empty($zoneMap)) {
				$chargeCode = $zoneMap->carrierzone;
				$postcodename = $zoneMap->postcodename;
			} else {
				echo ($shipment->cnee->postcode . "," . $shipment->cnee->suburb . "," . $shipment->cnee->state);
			}
			$weight = $shipment->weight;
			$zrs = ZoneRate::model()->findAll("zone = :s AND (weight_lo < :w AND weight_hi >= :w) AND rate_id = :rateid AND base+item+perkg > 0 ", [':s' => $chargeCode . "_" . $postcodename, ':w' => $shipment->weight, ':rateid' => 710]);
			if (empty($zrs)) {
				$zrs = ZoneRate::model()->findAll("zone = :s AND (weight_lo < :w AND weight_hi >= :w) AND rate_id = :rateid AND base+item+perkg > 0 ", [':s' => $chargeCode, ':w' => $shipment->weight, ':rateid' => 710]);
			}
			if (!empty($zrs)) {
				// get maximum one
				foreach ($zrs as $zr) {
					$temp = $zr['base'] + $zr['item'];
					if ($zr['nkg'] > 0) {
						$wl = $weight - ($zr['base'] > 0 ? $zr['nkg'] : 0);
						$temp += ceil($wl / $zr['nkg']) * $zr['perkg'];
					} else {
						$temp += $weight * $zr['perkg'];
					}
					if ($zr['minimum'] > 0 && $temp < $zr['minimum']) {
						$temp = $zr['minimum'];
					}
					$price = max($price, $temp);
				}
			} else {
				continue;
			}
			$DFECost = $price;
			$forwardingFee = DfeForwardingFee::model()->find('postcode = :postcode AND suburb = :suburb', [':postcode' => $shipment->cnee->postcode, ':suburb' => strtoupper($shipment->cnee->suburb)]);
			if (empty($forwardingFee)) {
				$forwardingFee = DfeForwardingFee::model()->find('postcode = :postcode AND suburb like "ALL %" ', [':postcode' => $shipment->cnee->postcode]);
			}
			$thisForwardingFee = 0;
			if (!empty($forwardingFee)) {
				$thisForwardingFee = $forwardingFee->cost;
			}

			$xls->addRow($i++, [$shipment->hbn, $shipment->ref, $shipment->cnee->postcode, $shipment->cnee->suburb, $shipment->cnee->state, $trans->cost, $DFECost + $thisForwardingFee, @$thisForwardingFee]);
		}
		//$xls->output('imp_search_export_'.time().'.xlsx');
	}

	public function actionGetDFEAndTntCostReport() //

	{
		$shipments = ImParcel::model()->with(['trans', 'consol'])->findAll('pod = "AUSYD" and trans.org_id = 976 and trans.cost>0 and (TO_DAYS(trans.time) >= TO_DAYS("2019-11-01") )and (TO_DAYS(trans.time) <= TO_DAYS("2019-12-31") )');
		$xls = new oExcel;
		$i = 1;
		$xls->addRow($i++, ['DFE ZONE', 'total kg', 'total cbm', 'TNT cost', 'DFE cost(+ Forwarding Fee)', 'Forwarding Fee']);
		$result = [];
		foreach ($shipments as $shipment) {
			$trans = $shipment->trans;
			$trans = end($trans);
			$price = 0;
			$zoneMap = DfeZone::model()->find('postcode = :postcode AND state = :state AND postcodename = :suburb', [':postcode' => $shipment->cnee->postcode, ':state' => strtoupper($shipment->cnee->state), ':suburb' => strtoupper($shipment->cnee->suburb)]);
			$chargeCode = 'N1';
			$postcodename = '';
			if (!empty($zoneMap)) {
				$chargeCode = $zoneMap->carrierzone;
				$postcodename = $zoneMap->postcodename;
			} else {
				continue;
			}
			$weight = $shipment->weight;
			$zrs = ZoneRate::model()->findAll("zone = :s AND (weight_lo < :w AND weight_hi >= :w) AND rate_id = :rateid AND base+item+perkg > 0 ", [':s' => $chargeCode . "_" . $postcodename, ':w' => $shipment->weight, ':rateid' => 710]);
			if (empty($zrs)) {
				$zrs = ZoneRate::model()->findAll("zone = :s AND (weight_lo < :w AND weight_hi >= :w) AND rate_id = :rateid AND base+item+perkg > 0 ", [':s' => $chargeCode, ':w' => $shipment->weight, ':rateid' => 710]);
			}
			if (!empty($zrs)) {
				// get maximum one
				foreach ($zrs as $zr) {
					$temp = $zr['base'] + $zr['item'];
					if ($zr['nkg'] > 0) {
						$wl = $weight - ($zr['base'] > 0 ? $zr['nkg'] : 0);
						$temp += ceil($wl / $zr['nkg']) * $zr['perkg'];
					} else {
						$temp += $weight * $zr['perkg'];
					}
					if ($zr['minimum'] > 0 && $temp < $zr['minimum']) {
						$temp = $zr['minimum'];
					}
					$price = max($price, $temp);
				}
			} else {
				continue;
			}
			$DFECost = $price;
			$forwardingFee = DfeForwardingFee::model()->find('postcode = :postcode AND suburb = :suburb', [':postcode' => $shipment->cnee->postcode, ':suburb' => strtoupper($shipment->cnee->suburb)]);
			if (empty($forwardingFee)) {
				$forwardingFee = DfeForwardingFee::model()->find('postcode = :postcode AND suburb like "ALL %" ', [':postcode' => $shipment->cnee->postcode]);
			}
			$thisForwardingFee = 0;
			if (!empty($forwardingFee)) {
				$thisForwardingFee = $forwardingFee->cost;
			}

			if (isset($result[$chargeCode])) {
				$result[$chargeCode] = [$chargeCode, $result[$chargeCode][1] + $shipment->weight, $result[$chargeCode][2] + round($shipment->cbm * $shipment->pkg, 2), $result[$chargeCode][3] + $trans->cost, $result[$chargeCode][4] + $DFECost + $thisForwardingFee, $result[$chargeCode][5]+@$thisForwardingFee];
			} else {
				$result[$chargeCode] = [$chargeCode, $shipment->weight, round($shipment->cbm * $shipment->pkg, 2), $trans->cost, $DFECost + $thisForwardingFee, @$thisForwardingFee];
			}
		}

		foreach ($result as $key => $value) {
			$xls->addRow($i++, $value);
		}

		$xls->output('imp_search_export_' . time() . '.xlsx');
	}

	public function actionGetOldFastwayAndNewFastwayCost() //

	{
		$shipments = ImParcel::model()->with(['trans', 'consol'])->findAll('pod = "AUSYD" and trans.org_id = 115  and trans.cost>0 and (TO_DAYS(trans.time) >= TO_DAYS("2019-10-01") )and (TO_DAYS(trans.time) <= TO_DAYS("2019-12-31") )');
		$xls = new oExcel;
		$i = 1;
		$type = empty($_GET['type']) ? '' : $_GET['type'];
		if ($type == 1) {
			$xls->addRow($i++, ['ref', 'weight', 'manifest_weight', 'postcode', 'cost', 'new fastway', 'new zone']);
		} else {
			$xls->addRow($i++, ['Fastway ZONE', 'type', 'number', 'total kg', 'total manifest kg', 'cost', 'new fastway']);
		}
		$result = [];
		foreach ($shipments as $shipment) {
			$trans = $shipment->trans;
			$trans = end($trans);
			$price = 0;
			$zoneMap = ZoneMap::model()->find('org_id = 115 AND zone_id = 4 and pc_lo <= :pc AND pc_hi >= :pc', [':pc' => $shipment->cnee->postcode]);
			$chargeCode = 'N1';
			if (!empty($zoneMap)) {
				$chargeCode = $zoneMap->z1;
			} else {
				continue;
			}
			$weight = $shipment->mdata['manifest_weight'];
			$zrs = ZoneRate::model()->findAll("zone = :s AND (weight_lo < :w AND weight_hi >= :w) AND rate_id = :rateid AND base+item+perkg > 0 ", [':s' => $chargeCode, ':w' => $shipment->mdata['manifest_weight'], ':rateid' => 718]);
			if (!empty($zrs)) {
				// get maximum one
				foreach ($zrs as $zr) {
					$temp = $zr['base'] + $zr['item'];
					if ($zr['nkg'] > 0) {
						$wl = $weight - ($zr['base'] > 0 ? $zr['nkg'] : 0);
						$temp += ceil($wl / $zr['nkg']) * $zr['perkg'];
					} else {
						$temp += $weight * $zr['perkg'];
					}
					if ($zr['minimum'] > 0 && $temp < $zr['minimum']) {
						$temp = $zr['minimum'];
					}
					$price = max($price, $temp);
				}
			} else {
				continue;
			}
			$newFastwayCost = $price;
			if ($shipment->trans[0]->org_id == '115') {
				$sType = 'old_fastway';
			} else {
				$sType = 'eparcel';
			}
			$this->fastwayExportType($result, $type, $chargeCode, $sType, $shipment, $weight, $trans, $newFastwayCost);
		}

		foreach ($result as $key => $value) {
			$xls->addRow($i++, $value);
		}

		$xls->output('imp_search_export_' . time() . '.xlsx');
	}

	private function fastwayExportType(&$result, $type, $chargeCode, $sType, $shipment, $weight, $trans, $newFastwayCost)
	{
		switch ($type) {
			case 1:
				$result[$shipment->ref] = [$shipment->ref, $shipment->weight, $weight, $shipment->postcode, $trans->cost, $newFastwayCost, $chargeCode];
				break;
			default:
				if (isset($result[$chargeCode . '_' . $sType])) {
					$result[$chargeCode . '_' . $sType] = [$chargeCode, $sType, $result[$chargeCode . '_' . $sType][2] + 1, $result[$chargeCode . '_' . $sType][3] + $shipment->weight, $result[$chargeCode . '_' . $sType][4] + $weight, $result[$chargeCode . '_' . $sType][5] + $trans->cost, $result[$chargeCode . '_' . $sType][6] + $newFastwayCost];
				} else {
					$result[$chargeCode . '_' . $sType] = [$chargeCode, $sType, 1, $shipment->weight, $weight, $trans->cost, $newFastwayCost];
				}
				break;
		}
	}

