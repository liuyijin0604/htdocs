	public function actionCbReport()
	{ //this report used to calculate the courier cubic vs the our cubic based on client.

		$filtersForm = new FiltersForm;
		$provide = [];
		if (isset($_GET['FiltersForm'])) {
			$filtersForm->filters = $_GET['FiltersForm'];
		}
		if (!empty($_GET['start_date']) && !empty($_GET['end_date'])) {
			$start_time = $_GET['start_date'];
			$end_time = $_GET['end_date'];

			$sql = 'SELECT count(shipment.id) as no ,sum(shipment.weight) as wt,sum(reconciliation_line.cdeadwt) as cdwt,agent_id ,sum(reconciliation_line.my_value) as my_value,sum(reconciliation_line.weight) as crwt ,sum(reconciliation_line.value) as crcharge, sum(reconciliation_line.my_charge) as mycharge,sum(if(shipment.cbm*250*shipment.pkg>shipment.weight, shipment.cbm*250*shipment.pkg,shipment.weight)) as cgwt FROM `shipment` INNER JOIN reconciliation_line on shipment.ref=reconciliation_line.shipment_no WHERE shipment.ref like :ref and shipment.created>=:start and shipment.created<=:end and reconciliation_line.cdeadwt>0 group by shipment.agent_id order by cgwt';
			$rs = Yii::app()->db->createCommand($sql)->bindValues([':ref' => 'AMQ%', ':start' => $start_time, ':end' => $end_time])->queryAll();

			foreach ($rs as $r) {
				if ($r['mycharge'] == 0) {
					continue;
				}
				$org = Org::model()->findByPk($r['agent_id']);
				$orgName = empty($org) ? $r['agent_id'] : $org->shortName(3);
				if ($r['agent_id'] == 1206) {
					$cubic_rate = round($r['crwt'] / $r['wt'] * 100, 2) . '%';
				} else {
					$cubic_rate = round($r['crwt'] / $r['cgwt'] * 100, 2) . '%';
				}
				$profit = round($r['mycharge'] - $r['crcharge'], 2);
				$provide[] = ['id' => $r['agent_id'], 'no' => $r['no'], 'my_value' => round($r['my_value'], 2), 'name' => $orgName, 'cwt' => round($r['cdwt'], 2), 'crwt' => round($r['crwt'], 2), 'cgwt' => round($r['agent_id'] == 1206 ? $r['wt'] : $r['cgwt'], 2), 'crcharge' => round($r['crcharge'], 2), 'wt' => $r['wt'], 'mycharge' => round($r['mycharge'], 2), 'cbc_rate' => $cubic_rate, 'profit' => $profit];
			}
		}

		$filteredData = $filtersForm->filter($provide);
		$dataprovider = new CArrayDataProvider($filteredData);
		$sort = new CSort();
		$sort->attributes = [
			'name' => [
				'asc' => 'name ASC',
				'desc' => 'name DESC',
			],
			'my_value' => [
				'asc' => 'my_value ASC',
				'desc' => 'my_value DESC',
			],
			'no' => [
				'asc' => 'no ASC',
				'desc' => 'no DESC',
			],
			'cwt' => [
				'asc' => 'cwt ASC',
				'desc' => 'cwt DESC',
			],
			'wt' => [
				'asc' => 'wt ASC',
				'desc' => 'wt DESC',
			],
			'crwt' => [
				'asc' => 'crwt ASC',
				'desc' => 'crwt DESC',
			],
			'cgwt' => [
				'asc' => 'cgwt ASC',
				'desc' => 'cgwt DESC',
			],
			'crcharge' => [
				'asc' => 'crcharge ASC',
				'desc' => 'crcharge DESC',
			],
			'mycharge' => [
				'asc' => 'mycharge ASC',
				'desc' => 'mycharge DESC',
			],
			'cbc_rate' => [
				'asc' => 'cbc_rate ASC',
				'desc' => 'cbc_rate DESC',
			],
			'profit' => [
				'asc' => 'profit ASC',
				'desc' => 'profit DESC',
			],
		];
		$sort->defaultOrder = "name DESC";
		$dataprovider->sort = $sort;
		$dataprovider->pagination = ['pageSize' => 30];

		if (!empty($_GET['partial'])) {
			$this->renderPartial('cbrpt_search', ['dataProvider' => [$dataprovider, $filtersForm]]);
			return;
		}
		$this->render('cb_rpt', ['dataProvider' => [$dataprovider, $filtersForm]]);
	}

	public function actionRebate()
	{
		if (empty($_POST)) {
			$this->render('rebate');
		} else {
			$xls = new oExcel;
			$xls->setColWidth([8, 12, 12, 18, 8, 18]);
			$xls->setFont('A1:F1', ['bold' => true]);
			$xls->addRow(1, ['Org', 'From', 'To', 'Invoice Amount', 'Rate', 'Rebate Amount']);

			$q = 'type = :type AND date >= :fd AND date < :td';
			$p = [];
			$p[':type'] = Invoice::INVOICE_TYPE_EXPORT;
			$p[':fd'] = $_POST['date']['from'];
			$p[':td'] = $_POST['date']['to'];

			// filter by agent
			if (!empty($_POST['fwd_id'])) {
				$org_ids[] = ['to_id' => $_POST['fwd_id']];
			} else {
				$sql = 'select distinct(to_id) from `invoice` where ' . $q;
				$org_ids = Yii::app()->db->createCommand($sql)->bindValues($p)->queryAll();
			}

			$i = 2;

			foreach ($org_ids as $org_id) {
				$p[':to_id'] = $org_id['to_id'];
				$invoices = Invoice::model()->findAll(['condition' => $q . ' AND to_id = :to_id', 'params' => $p]);
				// get rates
				$rates = SellRate::model()->findAll('org_id = :to_id AND type = 25 AND ((vfrom >= :fd AND vfrom <= :td) OR (vto >= :fd AND vto <= :td))', $p);

				$invoice_amounts = [];
				foreach ($invoices as $invoice) {
					foreach ($invoice->payments as $pay_inv) {
						if ($pay_inv->payment->type == Payment::PAYMENT_TYPE_EFT || $pay_inv->payment->type == Payment::PAYMENT_TYPE_CASH) {
							foreach ($rates as $rate) {
								if ($pay_inv->invoice->date >= $rate->vfrom && ((!empty($rate->vto) && $pay_inv->invoice->date <= $rate->vto) || empty($rate->vto))) {
									if (empty($invoice_amounts[$rate->item])) {
										$invoice_amounts[$rate->item]['amount'] = 0;
										$invoice_amounts[$rate->item]['rate'] = $rate;
									}
									$invoice_amounts[$rate->item]['amount'] += $pay_inv->amount;
								}
							}
						}
					}
				}

				$org = Org::model()->findByPk($org_id);

				if ((empty($_POST['forall'])) || !empty($_POST['forall'])) {
					foreach ($invoice_amounts as $rate => $invoice_amount) {
						$rebate_amount = floatval($invoice_amount['amount']) * floatval($rate) / 100;
						if ($rebate_amount) {
							$xls->addRow($i++, [$org->id, $invoice_amount['rate']->vfrom, $invoice_amount['rate']->vto, number_format($invoice_amount['amount'], 2), $rate . '%', number_format($rebate_amount, 2)]);
						}
					}
				}
			}

			$xls->output('rebate_' . time() . '.xlsx');
		}
	}

