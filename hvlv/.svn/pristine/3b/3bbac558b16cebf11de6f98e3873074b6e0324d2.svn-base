	public function actionAjaxExportImPlSumReport()
	{
		$reportService = new ReportService();
		$dpt = isset($_GET['wid']) ? $_GET['wid'] : 0;
		$dateFrom = isset($_GET['datefrom']) ? $_GET['datefrom'] : '';
		$dateTo = isset($_GET['dateto']) ? $_GET['dateto'] : '';
		$type = isset($_GET['type']) ? $_GET['type'] : 1;
		$wid = $dpt;

		$criteria = new CDbCriteria;
		$criteria->addCondition("t.eta >= '" . $dateFrom . "'");
		$criteria->addCondition("t.eta <= '" . $dateTo . "'");
		if (!empty($wid)) {
			$criteria->addCondition("t.dpt_id = '" . $wid . "'");
		}
		$criteria->addCondition("t.status < 100");
		$criteria->addCondition("t.owner_id != 114"); // remove TLA express owner which is for WMS 3PL local dilivery
		$criteria->addInCondition('type', [15, 70, 80]);
		$criteria->order = 'eta DESC';
		// $criteria->addCondition("t.owner_id != 114"); // remove TLA express owner which is for WMS 3PL local dilivery
		$imConsoles = Consol::model()->findAll($criteria);
		$xls = new oExcel;

		$i = 1;

		if ($type != 5 && $type != 6 && $type != 2 ) {
			$xls->addRow($i++, ['No.','Owner','Created', 'Shipments', 'Weight', 'Revenue', 'Cost', 'GP', 'Margin', 'Invoices out Date']);
			$totRevenue = 0;
			$totCost = 0;
			$totOutDateRevenue = 0;
			$invs = [];
			foreach ($imConsoles as $consol) {
				if (!empty($consol->mdata['ignore_revenue'])) {
					continue;
				}
				if ($consol->type == 15 && $consol->totShipments() == 0) {
					continue;
				}
				if ($consol->eta < '2018-03-01') {
					if ($consol->totCost() <= 0) {
						continue;
					}
				}
				$ownerName = $consol->getOwnerName();
				$singleRevenue = $consol->getTotalInvoice();
				$singleCost = $consol->totCost();

				// remove no revenue or cost
				// if ( $singleCost == 0.0 || $singleRevenue == 0.0 ) continue;

				$singleOutDateRevenue = $consol->getTotalInvoiceOutDates($dateFrom, $dateTo);
				$xls->addRow($i++, [$consol->no,$ownerName, $consol->created, $consol->totShipments(), $consol->totWeight(), $singleRevenue, $singleCost, $consol->getProfitGP(), $consol->getProfitRate(), $singleOutDateRevenue]);

				$totRevenue += $singleRevenue;
				$totCost += $singleCost;
				$totOutDateRevenue += $singleOutDateRevenue;
				$invs = array_merge($invs, $consol->getInvoices());
			}

			if ($totRevenue == 0) {
				$totalProfitRate = 0;
			} else {
				$totalProfitRate = round(($totRevenue - $totCost) / $totRevenue * 10000) / 10000;
			}
			$xls->addRow($i++, ['', '', '', 'Total', AppHelper::money_format('%i', $totRevenue), AppHelper::money_format('%i', $totCost), AppHelper::money_format('%i', $totRevenue - $totCost), $totalProfitRate, $totOutDateRevenue]);
			$xls->setPercentage('H2:H' . $i);

			$xls->addRow($i++, ['In Date Span Revenue:', AppHelper::money_format('%i', $totRevenue - $totOutDateRevenue)]);
			$xls->addRow($i++, ['In Date Span Profit:', AppHelper::money_format('%i', $totRevenue - $totOutDateRevenue - $totCost)]);

			$xls->createSheet('Invoices');
			$xls->goSheet(1);
			$i = 1;
			$xls->addRow($i++, ['Consol No.', 'Inv #', 'Inv Date', 'Inv Total', 'Inv GST', 'Credit']);
			foreach ($invs as $inv) {
				$xls->addRow($i++, $inv);
			}
		}else if ($type == 2) {
			$xls->addRow($i++, ['No.', 'Created','Client','Shipments', 'Weight', 'Revenue', 'Cost', 'GP','Profit Rate']);
			$totRevenue = 0;
			$totCost = 0;
			$invs = [];
			foreach ($imConsoles as $consol) {
				$ownerIds = $consol->getOwnerName(true);
				if ($consol->type == 15 && sizeof($ownerIds) != 1) {
					$orgReports = $consol->getReportDetailBaseOnAgent();
					foreach ($orgReports as $orgId => $re) {
						if($re['revenue']==0&&$re['cost']==0&&in_array($orgId,[1228,3494]))
						{
							continue;
						}
						$org = Org::model()->findByPk($orgId);
						$percent = empty($re['revenue'])?0:round(($re['revenue']-$re['cost'])*100/$re['revenue'],2);
						$xls->addRow($i++, [$consol->no,$consol->created,$org->name,$re['number'], $re['weight'], $re['revenue'], $re['cost'],round($re['revenue']-$re['cost'],2), $percent."%"]);
						$totRevenue += $re['revenue'];
						$totCost += $re['cost'];
					}
				} else {
					$ownerId = $ownerIds[0];
					$org = Org::model()->findByPk($ownerId);
					$myTotCost = $consol->totCost();
					$myTotRevenue = $consol->getTotalInvoice();
					$percent = empty($myTotRevenue)?0:round(($myTotRevenue-$myTotCost)*100/$myTotRevenue,2);
					$xls->addRow($i++, [$consol->no,$consol->created,$org->name,$consol->totShipments(), $consol->totWeight(),$myTotRevenue, $myTotCost,round($myTotRevenue-$myTotCost,2), $percent."%"]);
					$totRevenue+=$myTotRevenue;
					$totCost+=$myTotCost;
				}

			}

			if ($totRevenue == 0) {
				$totalProfitRate = 0;
			} else {
				$totalProfitRate = round(($totRevenue - $totCost) / $totRevenue * 10000*100) / 10000;
			}
			$xls->addRow($i++, ['', '', '', 'Total', AppHelper::money_format('%i', $totRevenue), AppHelper::money_format('%i', $totCost), AppHelper::money_format('%i', $totRevenue - $totCost), $totalProfitRate."%"]);

		} else {
			$client_id = isset($_GET['org_id']) ? $_GET['org_id'] : 0;
			$courier_id = isset($_GET['courier']) ? $_GET['courier'] : 0;
			$consol_no = isset($_GET['consol']) ? $_GET['consol'] : 0;
			$xls->addRow($i++, ['Client：', @Org::model()->findByPk($client_id)->name]);
			$xls->addRow($i++, ['Courier：', @Org::model()->findByPk($courier_id)->name]);
			$xls->addRow($i++, ['Consol No.', $consol_no]);

			$pt = [$wid, $dateFrom, $dateTo, 10, '', $client_id, $courier_id, $consol_no];
			if ($type == 5) {
				$xls->addRow($i++, ["Zone", "Shipments", "Total Weight(KG)", "Dispersion_Percentage"]);
				$pt[4] = 'zo';
				$provide = $reportService->_plWeightQuery($pt, '', 'zone', 'rev DESC');
				$sortAttributes = ["Zone" => "Zone", "Shipments" => "shipments", "Total Weight" => "weight", "Dispersion_Percentage" => "Dispersion_Percentage"];
				$categories = SystemSetting::getAupostZoneCategorySetting();
				$categoryProvide = [];
				$categoryProvideId = 0;
				foreach ($provide as $key => $data) { //fitting all the data into categories
					$xls->addRow($i++, [$data["Zone"], $data["shipments"], $data["weight"], $data["Dispersion_Percentage"]]);
					$cate = $categories[$data['Zone']];
					if (isset($categoryProvide[$cate])) {
						$categoryProvide[$cate]["Dispersion_Percentage"] += $data['Dispersion_Percentage'];
						$categoryProvide[$cate]["shipments"] += $data['shipments'];
						$categoryProvide[$cate]["weight"] += $data['weight'];
					} else {
						$categoryProvide[$cate] = ["id" => $categoryProvideId, "category" => $cate, "Dispersion_Percentage" => $data['Dispersion_Percentage'], "shipments" => $data['shipments'], "weight" => $data['weight']];
						$categoryProvideId++;
					}
				}
				$xls->addRow($i++, []);
				$xls->addRow($i++, []);
				$xls->addRow($i++, ["Category", "Shipments", "Total Weight(KG)", "Dispersion_Percentage"]);

				foreach ($categoryProvide as $key => $data) {
					$xls->addRow($i++, [$data["category"], $data["shipments"], $data["weight"], round($data["Dispersion_Percentage"], 2) . "%"]);
				}

			} elseif ($type == 6) {
				$pt[4] = 'we';
				$provide = $reportService->_plWeightQuery($pt, '', 'weight', 'rev DESC');
				$xls->addRow($i++, ["Weight_Step", "Shipments", "Total Weight(KG)", "Dispersion_Percentage"]);
				foreach ($provide as $key => $data) { //fitting all the data into categories
					$xls->addRow($i++, [$data["Weight_Step"], $data["shipments"], $data["weight"], $data["Dispersion_Percentage"]]);
				}
			}

		}

		$tempfile = Yii::app()->basePath . DIRECTORY_SEPARATOR . "runtime" . DIRECTORY_SEPARATOR . 'im_plsum_report_result.xlsx';

		$xls->output($tempfile, null, false);
		echo $this->createUrl('report/downloadImPlSumReportResult');
	}

