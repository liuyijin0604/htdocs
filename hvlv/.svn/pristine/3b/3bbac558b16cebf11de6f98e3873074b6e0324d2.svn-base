	public function ajaxPlSumReport_20($pt, $path)
	{
		$dp = sizeof($pt);
		if ($dp == 5) {
			echo '<li><p><span class="exp" data-path="' . $path . '/csl" data-loaded="0"></span> By Consol.</p><ul></ul></li>
				<li><p><span class="exp" data-path="' . $path . '/pod" data-loaded="0"></span> By POD</p><ul></ul></li>
				<li><p><span class="exp" data-path="' . $path . '/clt" data-loaded="0"></span> By Client</p><ul></ul></li>';
		} else {
			$ett = [];
			if ($pt[5] == 'csl') {
				$rs = $this->_plQuery($pt, '', 'grp1');
				foreach ($rs as $i => $r) {
					$c = Consol::model()->findByPk($r['grp1']);
					$rs[$i]['c1'] = '<a class="tab_link" title="' . $c->no . '" href="' . $this->createUrl('excoConsol/update', ['id' => $r['grp1']]) . '">' . $c->no . '</a>';
					$rs[$i]['c2'] = $c->totPacks();
					$rs[$i]['c3'] = $c->totWeight();
					$rs[$i]['c4'] = round($r['rev'] / $rs[$i]['c3'] * 1000) / 1000;
					$rs[$i]['c5'] = round(($r['ac'] + $r['at']) / $rs[$i]['c3'] * 1000) / 1000;
					$rs[$i]['c6'] = Yii::app()->db->createCommand("SELECT SUM(actual_amt) FROM pl_ledger_management WHERE grp1 = " . $r['grp1'] . " AND grp2 = 'dt'")->queryScalar();
				}
				$c1 = ['c1' => 'Consol.', 'c2' => 'Pcs', 'c3' => 'Weight', 'c4' => 'Rev/Kg', 'c5' => 'Cost/kg', 'c6' => 'Duty'];
				$ett = ['c2', 'c3', 'c4' => '=rev/c3', 'c5' => '=(ac+at)/c3', 'c6'];
			} elseif ($pt[5] == 'pod') {
				$rs = $this->_plQuery($pt, '', 'grp1');
				$ts = [];
				foreach ($rs as $r) {
					$c = Consol::model()->findByPk($r['grp1']);
					if (!isset($ts[$c->poc])) {
						$ts[$c->poc] = ['c1' => ExChannel::getName($c->poc), 'c2' => 0, 'c3' => 0, 'c4' => 0, 'c5' => 0, 'c6' => 0, 'rev' => 0, 'grs' => 0, 'ac' => 0, 'at' => 0];
					}
					$ts[$c->poc]['c2'] += $c->totPacks();
					$ts[$c->poc]['c3'] += $c->totWeight();
					$ts[$c->poc]['c6'] += Yii::app()->db->createCommand("SELECT SUM(actual_amt) FROM pl_ledger_management WHERE grp1 = " . $r['grp1'] . " AND grp2 = 'dt'")->queryScalar();
					foreach (['rev', 'grs', 'ac', 'at'] as $k) {
						$ts[$c->poc][$k] += $r[$k];
					}
				}

				foreach ($ts as $i => $t) {
					$ts[$i]['c4'] = round($t['rev'] / $t['c3'] * 1000) / 1000;

					$ts[$i]['c5'] = round(($t['ac'] + $t['at']) / $t['c3'] * 1000) / 1000;
				}

				$rs = $ts;
				$c1 = ['c1' => 'Consol.', 'c2' => 'Pcs', 'c3' => 'Weight', 'c4' => 'Rev/Kg', 'c5' => 'Cost/kg', 'c6' => 'Duty'];
				$ett = ['c2', 'c3', 'c4' => '=rev/c3', 'c5' => '=(ac+at)/c3', 'c6'];
			} elseif ($pt[5] == 'clt') {
				if (!empty($pt[6])) {
					$this->render('plsum_clt', ['pt' => $pt]);
					Yii::app()->end();
				}
				$rs = $this->_plQuery($pt, '', 'org_id', 'grs DESC');
				$c1 = ['o' => 'Client'];
			}

			$this->_ajaxPLchart($rs, $c1, $path, $ett);
		}
	}

	public function ajaxPlSumReport_30($pt, $path)
	{
		$dp = sizeof($pt);
		if ($dp == 5) {
			echo '<li><p><span class="exp" data-path="' . $path . '/jb" data-loaded="0"></span> By Job</p><ul></ul></li>
				<li><p><span class="exp" data-path="' . $path . '/pod" data-loaded="0"></span> By POD</p><ul></ul></li>
				<li><p><span class="exp" data-path="' . $path . '/clt" data-loaded="0"></span> By Client</p><ul></ul></li>';
			//<li><p><span class="exp" data-path="'.$path.'/inv" data-loaded="0"></span> By Invoice</p><ul></ul></li>
		} else {
			if ($pt[5] == 'jb') {
				$rs = $this->_plQuery($pt, '', 'grp1');
				$c1 = ['j' => 'Job'];
			} elseif ($pt[5] == 'pod') {
				$rs = $this->_plQuery($pt, '', 'grp1');
				$ts = [];
				foreach ($rs as $r) {
					$job = EdiJob::model()->findByPk($r['grp1']);
					$c = EdiAwbConsol::model()->find('awb = :awb', [':awb' => $job->awb]);
					$pod = (empty($job->awb) || empty($c)) ? 'Other' : $c->pod;
					if (!isset($ts[$pod])) {
						$ts[$pod] = ['c1' => $pod, 'rev' => 0, 'grs' => 0, 'ac' => 0, 'at' => 0];
					}
					foreach (['rev', 'grs', 'ac', 'at'] as $k) {
						$ts[$pod][$k] += $r[$k];
					}
				}
				$rs = $ts;
				$c1 = ['c1' => 'POD'];
			} elseif ($pt[5] == 'clt') {
				$rs = $this->_plQuery($pt, '', 'org_id', 'grs DESC');
				$c1 = ['o' => 'Client'];
			} elseif ($pt[5] == 'inv') {
				$sql = "SELECT p.dpmt, org_id, grp1, grp2, gl, SUM(IF(actual_amt > 0 OR acc = 1, actual_amt, amt) * IF(c.type='Direct Costs' OR c.type='Expense', -1, 1)) AS grs, SUM(IF(actual_amt > 0 OR acc = 1, actual_amt,amt) * IF(c.type='Direct Costs' OR c.type='Expense', 0, 1)) AS rev, SUM(amt * IF(c.type='Direct Costs' OR c.type='Expense', 1, 0) * IF(acc = 0, 1, 0)) AS ac, SUM(actual_amt * IF(c.type='Direct Costs' OR c.type='Expense', 1, 0)) AS at FROM pl_ledger_management p INNER JOIN chargecode c ON p.gl = c.id INNER JOIN invoice i ON i.job_id = p.grp1 WHERE gl != 98 AND p.dpt_id = " . $pt[0] . " AND i.date >= '" . $pt[1] . "' AND i.date <= '" . $pt[2] . "' AND grp1 != '' ";
				if (!empty($pt[3])) {
					$sql .= 'AND p.dpmt = ' . $pt[3] . ' ';
				}
				$sql .= ' GROUP BY grp1';
				$rs = Yii::app()->db->createCommand($sql)->queryAll();
				$c1 = ['i' => 'Invoice', 'j' => 'Main Job', 'js' => 'Sub Jobs'];
			}
			$this->_ajaxPLchart($rs, $c1, $path);
		}
	}

	public function actionAjaxCogsSumReport($path)
	{
		Yii::app()->name = "TLA";
		$pt = explode('/', $path);
		$dptStr = " ";
		if(!empty($pt[0]))
		{
			$dptStr = " AND dpt_id = " . $pt[0];
		}
		$ptc = count($pt);
		if ($ptc < 4) { //top
			//revenue
			$sql = 'SELECT dpmt, currency, SUM(total-gst) AS ttl FROM `hvlv_top`.invoice WHERE status NOT IN (1, 8, 10, 99) AND dpt_id ' . (empty($pt[0]) ? '!' : '') . '= :dpt AND `date` >= :df AND `date` <= :dt GROUP BY dpmt, currency';
			$rs = Yii::app()->db->createCommand($sql)->bindValues([':dpt' => $pt[0], ':df' => $pt[1], ':dt' => $pt[2]])->queryAll();
			$dpmts = [];
			foreach ($rs as $r) {
				if ($r['currency'] == 0) {
					$r['currency'] = 1;
				}

				if (!isset($dpmts[$r['dpmt']])) {
					$dpmts[$r['dpmt']] = [];
				}

				if (!isset($dpmts[$r['dpmt']][$r['currency']])) {
					$dpmts[$r['dpmt']][$r['currency']] = [0,0];
				}

				$dpmts[$r['dpmt']][$r['currency']][0] += $r['ttl'];
			}

			// manual credit invoice
			$invs = Invoice::model()->findAll('status = 8 AND dpt_id ' . (empty($pt[0]) ? '!' : '') . '= :dpt AND `date` >= :df AND `date` <= :dt', [':dpt' => $pt[0], ':df' => $pt[1], ':dt' => $pt[2]]);
			foreach ($invs as $inv) {
				if ($inv->payments[0]->payment->type == 5 && $inv->payments[0]->payment->bank == 90) {
					continue;
				}

				if (!isset($dpmts[$inv->dpmt])) {
					$dpmts[$inv->dpmt] = [];
				}

				if (!isset($dpmts[$inv->dpmt][$inv->currency])) {
					$dpmts[$inv->dpmt][$inv->currency] = [];
				}

				$dpmts[$inv->dpmt][$inv->currency][0] += $inv->total - $inv->gst;
			}

			// credit note
			$pays = Payment::model()->findAll('type = 5 AND bank = 91 AND status = 6 AND `date` >= :df AND `date` <= :dt', [':df' => $pt[1], ':dt' => $pt[2]]);
			foreach ($pays as $pay) {
				if (!isset($dpmts[$pay->dpmt])) {
					$dpmts[$pay->dpmt] = [];
				}

				if (!isset($dpmts[$pay->dpmt][$pay->currency])) {
					$dpmts[$pay->dpmt][$pay->currency] = [];
				}

				$dpmts[$pay->dpmt][$pay->currency][0] -= $pay->amount - $pay->line_gst;
			}

			//cogs
			// $sql = 'SELECT l.dpmt, l.currency, SUM(l.actual_amount) AS sum FROM `hvlv_top`.`billing_line` l INNER JOIN `hvlv_top`.`billing` b ON l.billing_id = b.id LEFT JOIN `hvlv_db`.`chargecode` c on c.code = l.charge_code WHERE c.type = "Direct Costs" AND b.status NOT IN (1,11) AND l.status NOT IN (1,11) AND b.dpt_id ' . (empty($pt[0]) ? '!' : '') . '= :dpt AND b.`date` >= :df AND b.`date` <= :dt GROUP BY l.dpmt, l.currency ORDER BY l.dpmt, l.currency';

			$sql = "SELECT p.dpmt,0 as currency, SUM(IF(actual_amt > 0 OR acc = 1, actual_amt, amt) * IF(c.type='Direct Costs' OR c.type='Expense', 1, 0)) AS sum FROM pl_ledger2 p INNER JOIN chargecode c ON p.gl = c.id WHERE gl != 98  AND model!='ImP_Manifest' " . $dptStr . " AND inv_cdate >= '" . $pt[1] . "' AND inv_cdate <= '" . $pt[2] . "'  and (actual_amt>=0 or amt >=0)";

			$rs = Yii::app()->db->createCommand($sql)->bindValues([':dpt' => $pt[0], ':df' => $pt[1], ':dt' => $pt[2]])->queryAll();
			$ls = '';
			foreach ($rs as $r) {
				if ($r['currency'] == 0) {
					$r['currency'] = 1;
				}

				if ($r['dpmt'] < 10) {
					$r['dpmt'] = 1;
				}

				if (!isset($dpmts[$r['dpmt']])) {
					$dpmts[$r['dpmt']] = [];
				}

				if (!isset($dpmts[$r['dpmt']][$r['currency']])) {
					$dpmts[$r['dpmt']][$r['currency']] = [0,0];
				}

				$dpmts[$r['dpmt']][$r['currency']][1] += $r['sum'];
			}

			$sum_rev = [];
			$sum_cost = [];
			$audtt_rev = 0;
			$audtt_cost = 0;
			foreach ($dpmts as $dp => $ct) {
				$ls .= '<li><p><span class="exp" data-path="' . $path . '/' . $dp . '" data-loaded="0"></span> ' . (($dp == 1) ? 'Other' : Invoice::$dpmts[$dp]) . ' &nbsp; &nbsp; ';
				$tt_rev = [];
				$tt_cost = [];
				$sta_rev = 0;
				$sta_cost = 0;
				foreach ($ct as $c => $t) {
					if (!empty($t[0])) {
						$tt_rev[] = Invoice::$currencies[$c] . ' ' . AppHelper::money_format('', $t[0]);
						if (!isset($sum_cost[$c])) {
							$sum_cost[$c] = 0;
						}

						$sum_rev[$c] += $t[0];
						if ($c > 1) {
							$exrate = Currency::getExrate($pt[2], $c)[0];
							$audtt_rev += $t[0] / $exrate;
							$sta_rev += $t[0] / $exrate;
						} else {
							$audtt_rev += $t[0];
							$sta_rev += $t[0];
						}
					}
					if (empty($t[1])) {
						continue;
					}

					$tt_cost[] = Invoice::$currencies[$c] . ' ' . AppHelper::money_format('', $t[1]);
					if (!isset($sum_cost[$c])) {
						$sum_cost[$c] = 0;
					}

					$sum_cost[$c] += $t[1];
					if ($c > 1) {
						$exrate = Currency::getExrate($pt[2], $c)[0];
						$audtt_cost += $t[1] / $exrate;
						$sta_cost += $t[1] / $exrate;
					} else {
						$audtt_cost += $t[1];
						$sta_cost += $t[1];
					}
				}
				$ls .= 'Rev: ';
				if (count($tt_rev) > 1) {
					$ls .= '<b>~AUD ' . AppHelper::money_format('', $sta_rev) . '</b> (' . implode(' &nbsp;', $tt_rev) . ')';
				} else {
					$ls .= implode(' &nbsp;', $tt_rev);
				}
				$ls .= ' &nbsp; Cost: ';
				if (count($tt_cost) > 1) {
					$ls .= '<b>~AUD ' . AppHelper::money_format('', $sta_cost) . '</b> (' . implode(' &nbsp;', $tt_cost) . ')';
				} else {
					$ls .= implode(' &nbsp;', $tt_cost);
				}
				$ls .= ' &nbsp; Margin: <b>' . ($sta_rev > 0 ? (round(($sta_rev - $sta_cost) / $sta_rev, 4) * 100) : '-') . '%</b></p><ul></ul></li>';
			}

			$rcs = [];
			foreach ($sum_rev as $c => $t) {
				$rcs[] = Invoice::$currencies[$c] . ' ' . AppHelper::money_format('', $t);
			}
			$ccs = [];
			foreach ($sum_cost as $c => $t) {
				$ccs[] = Invoice::$currencies[$c] . ' ' . AppHelper::money_format('', $t);
			}
			echo '<li><p>Total - Rev: ';
			if (count($rcs) > 1) {
				echo '<b>~AUD ' . AppHelper::money_format('', $audtt_rev) . '</b> (' . implode(' &nbsp;', $rcs) . ')';
			} else {
				echo 'AUD ' . AppHelper::money_format('', $audtt_rev);
			}

			echo ' &nbsp; Cost: ';
			if (count($ccs) > 1) {
				echo '<b>~AUD ' . AppHelper::money_format('', $audtt_cost) . '</b> (' . implode(' &nbsp;', $ccs) . ')';
			} else {
				echo 'AUD ' . AppHelper::money_format('', $audtt_cost);
			}

			echo ' &nbsp; Margin: <b>' . ($audtt_rev > 0 ? (round(($audtt_rev - $audtt_cost) / $audtt_rev, 4) * 100) : '-') . '%</b></p><ul>' . $ls . '</ul></li>';
		} elseif ($ptc == 4) {
			echo '<li><p><span class="exp" data-path="' . $path . '/clt" data-loaded="0"></span> Profit By Client</p><ul></ul></li>
				<li><p><span class="exp" data-path="' . $path . '/ccd" data-loaded="0"></span> Cost By GL Code</p><ul></ul></li>
				<li><p><span class="exp" data-path="' . $path . '/spl" data-loaded="0"></span> Cost By Supplier</p><ul></ul></li>
				<li><p><a href="report/ajaxCogsSumReport.app?path=' . $path . '/export" target="_blank">Export</a></p></li>';
		} elseif ($ptc == 5 && $pt[4] == 'clt') {
			$param = [':dpt' => $pt[0], ':df' => $pt[1], ':dt' => $pt[2]];
			$sql = 'SELECT i.to_id, o.name as org_name, i.currency, SUM(i.total - i.gst) AS ttl FROM `hvlv_top`.`invoice` i INNER JOIN `hvlv_db`.`org` o ON o.id = i.to_id WHERE i.status NOT IN (1, 8, 10, 99) AND i.dpt_id ' . (empty($pt[0]) ? '!' : '') . '= :dpt AND i.dpmt ' . ($pt[3] > 1 ? '= :dpmt' : '< 10') . ' AND i.`date` >= :df AND i.`date` <= :dt GROUP BY i.to_id, i.currency ORDER BY ttl DESC';

			if ($pt[3] > 1) {
				$param[':dpmt'] = $pt[3];
			}
			$rs = Yii::app()->db->createCommand($sql)->bindValues($param)->queryAll();

			$sps = [];
			$orgs = [];
			foreach ($rs as $r) {
				if ($r['currency'] == 0) {
					$r['currency'] = 1;
				}

				$orgs[$r['to_id']] = $r['org_name'];
				if (!isset($sps[$r['to_id']])) {
					$sps[$r['to_id']] = [];
				}

				if (!isset($sps[$r['to_id']][$r['currency']])) {
					$sps[$r['to_id']][$r['currency']] = 0;
				}

				$sps[$r['to_id']][$r['currency']] += $r['ttl'];
			}

			// manual credit invoice
			$invs = Invoice::model()->findAll('status = 8 AND dpt_id ' . (empty($pt[0]) ? '!' : '') . '= :dpt AND `date` >= :df AND `date` <= :dt', [':dpt' => $pt[0], ':df' => $pt[1], ':dt' => $pt[2]]);
			foreach ($invs as $inv) {
				if ($inv->payments[0]->payment->type == 5 && $inv->payments[0]->payment->bank == 90) {
					continue;
				}

				if (!isset($sps[$inv->to_id])) {
					$sps[$inv->to_id] = [];
				}

				if (!isset($sps[$inv->to_id][$inv->currency])) {
					$sps[$inv->to_id][$inv->currency] = 0;
				}

				$sps[$inv->to_id][$inv->currency] += $inv->total - $inv->gst;
			}

			// credit note
			$pays = Payment::model()->findAll('type = 5 AND bank = 91 AND status = 6 AND `date` >= :df AND `date` <= :dt', [':df' => $pt[1], ':dt' => $pt[2]]);
			foreach ($pays as $pay) {
				if (!isset($sps[$pay->org_id])) {
					$sps[$pay->org_id] = [];
				}

				if (!isset($sps[$pay->org_id][$pay->currency])) {
					$sps[$pay->org_id][$pay->currency] = 0;
				}

				$sps[$pay->org_id][$pay->currency] -= $pay->amount - $pay->line_gst;
			}

			$sql = "SELECT p.org_id,p.dpmt,0 as currency, SUM(IF(actual_amt > 0 OR acc = 1, actual_amt, amt) * IF(c.type='Direct Costs' OR c.type='Expense', 1, 0)) AS sum FROM pl_ledger2 p INNER JOIN chargecode c ON p.gl = c.id WHERE gl != 98  AND model!='ImP_Manifest' " . $dptStr . " AND inv_cdate >= '" . $pt[1] . "' AND inv_cdate <= '" . $pt[2] . "'  and (actual_amt>=0 or amt >=0) group by p.org_id";

			$rs = Yii::app()->db->createCommand($sql)->bindValues($param)->queryAll();
			$costArr = [];
			foreach ($rs as $key => $r) {
				$costArr[$r['org_id']] = $r['sum'];
			}

			$out = '<div class="grid-view"><table class="items"><thead><tr><th>Client</th><th>Revenue</th><th>Cost</th><th>GP</th><th>Margin</th></tr></thead><tbody>';

			foreach ($sps as $oid => $ct) {
				$tr = '<tr><td>' . $oid . ' - ' . $orgs[$oid] . '</td><td>';
				$gt0 = false;
				$dd = '';
				$sta = 0;
				foreach ($ct as $c => $t) {
					if (empty($t)) {
						continue;
					}

					$dd .= Invoice::$currencies[$c] . ' ' . AppHelper::money_format('', $t) . ' &nbsp;';
					$gt0 = true;
					if ($c > 1) {
						$exrate = Currency::getExrate($pt[2], $c)[0];
						$sta += $t / $exrate;
					} else {
						$sta += $t;
					}
				}
				if (count($ct) > 1) {
					$tr .= '<b>~AUD ' . AppHelper::money_format('', $sta) . '</b> &nbsp; &nbsp; ';
				}
				$tr .= $dd . '</td>';

				$cost = isset($costArr[$oid])?$costArr[$oid]:0;
				$tr .= '<td>'.AppHelper::money_format('',$cost).'</td><td>'.AppHelper::money_format('',$sta-$cost).'</td><td>'.number_format((($sta-$cost)*100)/$sta,2,'.','').'%</td></tr>';

				if ($gt0) {
					$out .= $tr;
				}

			}
			echo $out . '</tbody></table></div>';
		} elseif ($ptc == 5 && $pt[4] == 'ccd') {
			$param = [':dpt' => $pt[0], ':df' => $pt[1], ':dt' => $pt[2]];
			$sql = 'SELECT l.charge_code, c.name as gl_name, b.currency, SUM(l.actual_amount) AS sum, b.status FROM `hvlv_top`.`billing_line` l INNER JOIN `hvlv_top`.`billing` b ON l.billing_id = b.id LEFT JOIN `hvlv_db`.`chargecode` c on c.code = l.charge_code WHERE c.type = "Direct Costs" AND b.status NOT IN (1,11) AND l.status NOT IN (1,11) AND l.dpmt ' . ($pt[3] > 1 ? '= :dpmt' : '< 10') . ' AND b.dpt_id ' . (empty($pt[0]) ? '!' : '') . '= :dpt AND b.`date` >= :df AND b.`date` <= :dt GROUP BY l.charge_code, l.currency, b.status ORDER BY sum desc, l.charge_code, l.currency';

			if ($pt[3] > 1) {
				$param[':dpmt'] = $pt[3];
			}
			$rs = Yii::app()->db->createCommand($sql)->bindValues($param)->queryAll();
			$gls = [];
			$sps = [];
			foreach ($rs as $r) {
				if ($r['currency'] == 0) {
					$r['currency'] = 1;
				}

				$gls[$r['charge_code']] = $r['gl_name'];
				if (!isset($sps[$r['charge_code']])) {
					$sps[$r['charge_code']] = [];
				}

				if (!isset($sps[$r['charge_code']]['all'][$r['currency']])) {
					$sps[$r['charge_code']]['all'][$r['currency']] = 0;
					$sps[$r['charge_code']]['confirmed'][$r['currency']] = 0;
				}
				$sps[$r['charge_code']]['all'][$r['currency']] += $r['sum'];
				if ($r['status'] == 2) {
					$sps[$r['charge_code']]['confirmed'][$r['currency']] += $r['sum'];
				}
			}
			$out = '<div class="grid-view"><table class="items"><thead><tr><th>GL Code</th><th>Total</th></tr></thead><tbody>';

			foreach ($sps as $cid => $ct) {
				$tr = '<tr><td>' . $cid . ' - ' . $gls[$cid] . '</td><td>';
				$gt0 = false;
				$sta = 0;
				$dd = '';
				foreach ($ct['all'] as $c => $t) {
					if (empty($t)) {
						continue;
					}

					$dd .= Invoice::$currencies[$c] . ' ' . AppHelper::money_format('', $t) . ' &nbsp;';
					$gt0 = true;
					if ($c > 1) {
						$exrate = Currency::getExrate($pt[2], $c)[0];
						$sta += $t / $exrate;
					} else {
						$sta += $t;
					}
				}
				if (array_sum($ct['confirmed']) > 0) {
					$dd .= '<span style="color:red">(Waiting to post: ';
					foreach ($ct['confirmed'] as $c => $t) {
						if (empty($t)) {
							continue;
						}

						$dd .= Invoice::$currencies[$c] . ' ' . AppHelper::money_format('', $t) . ' &nbsp;';
						$gt0 = true;
						// if($c > 1){
						//     $exrate = Currency::getExrate($pt[2], $c)[0];
						//     $sta += $t / $exrate;
						// }else{
						//     $sta += $t;
						// }
					}
					$dd .= ')</span>';
				}
				if (count($ct['all']) > 1) {
					$tr .= '<b>~AUD ' . AppHelper::money_format('', $sta) . '</b> &nbsp; &nbsp; ';
				}
				$tr .= $dd . '</td></tr>';
				if ($gt0) {
					$out .= $tr;
				}

			}
			echo $out . '</tbody></table></div>';

		} elseif ($ptc == 5 && $pt[4] == 'spl') {
			$param = [':dpt' => $pt[0], ':df' => $pt[1], ':dt' => $pt[2]];
			$sql = 'SELECT b.org_id, o.name as org_name, l.currency, SUM(l.actual_amount) AS sum, b.status FROM `hvlv_top`.`billing_line` l INNER JOIN `hvlv_top`.`billing` b ON l.billing_id = b.id LEFT JOIN `hvlv_db`.`chargecode` c on c.code = l.charge_code LEFT JOIN `hvlv_db`.`org` o ON o.id = b.org_id WHERE c.type = "Direct Costs" AND b.status NOT IN (1,11) AND l.status NOT IN (1,11) AND l.dpmt ' . ($pt[3] > 1 ? '= :dpmt' : '< 10') . ' AND b.dpt_id ' . (empty($pt[0]) ? '!' : '') . '= :dpt AND b.`date` >= :df AND b.`date` <= :dt GROUP BY b.org_id, l.currency, b.status ORDER BY sum desc, b.org_id, l.currency';

			if ($pt[3] > 1) {
				$param[':dpmt'] = $pt[3];
			}
			$rs = Yii::app()->db->createCommand($sql)->bindValues($param)->queryAll();

			$sps = [];
			$orgs = [];
			foreach ($rs as $r) {
				if ($r['currency'] == 0) {
					$r['currency'] = 1;
				}

				$orgs[$r['org_id']] = $r['org_name'];
				if (!isset($sps[$r['org_id']])) {
					$sps[$r['org_id']] = [];
				}

				if (!isset($sps[$r['org_id']]['all'][$r['currency']])) {
					$sps[$r['org_id']]['all'][$r['currency']] = 0;
					$sps[$r['org_id']]['confirmed'][$r['currency']] = 0;
				}
				$sps[$r['org_id']]['all'][$r['currency']] += $r['sum'];
				if ($r['status'] == 2) {
					$sps[$r['org_id']]['confirmed'][$r['currency']] += $r['sum'];
				}
			}

			$out = '<div class="grid-view"><table class="items"><thead><tr><th>Supplier</th><th>Total</th></tr></thead><tbody>';

			foreach ($sps as $oid => $ct) {
				$tr = '<tr><td>' . $oid . ' - ' . $orgs[$oid] . '</td><td>';
				$gt0 = false;
				$dd = '';
				$sta = 0;
				foreach ($ct['all'] as $c => $t) {
					if (empty($t)) {
						continue;
					}

					$dd .= Invoice::$currencies[$c] . ' ' . AppHelper::money_format('', $t) . ' &nbsp;';
					$gt0 = true;
					if ($c > 1) {
						$exrate = Currency::getExrate($pt[2], $c)[0];
						$sta += $t / $exrate;
					} else {
						$sta += $t;
					}
				}
				if (array_sum($ct['confirmed']) > 0) {
					$dd .= '<span style="color:red">(Waiting to post: ';
					foreach ($ct['confirmed'] as $c => $t) {
						if (empty($t)) {
							continue;
						}

						$dd .= Invoice::$currencies[$c] . ' ' . AppHelper::money_format('', $t) . ' &nbsp;';
						$gt0 = true;
						if ($c > 1) {
							$exrate = Currency::getExrate($pt[2], $c)[0];
							$sta += $t / $exrate;
						} else {
							$sta += $t;
						}
					}
					$dd .= ')</span>';
				}
				if (count($ct['all']) > 1) {
					$tr .= '<b>~AUD ' . AppHelper::money_format('', $sta) . '</b> &nbsp; &nbsp; ';
				}
				$tr .= $dd . '</td></tr>';
				if ($gt0) {
					$out .= $tr;
				}

			}
			echo $out . '</tbody></table></div>';
		} elseif ($ptc == 5 && $pt[4] == 'export') {
			$xls = new oExcel;
			$i = 1;
			$sheet = $xls->getActiveSheet();
			$sheet->setTitle('Revenue');

			//revenue
			$param = [':dpt' => $pt[0], ':df' => $pt[1], ':dt' => $pt[2]];
			if ($pt[3] > 1) {
				$param[':dpmt'] = $pt[3];
			}
			$rs = Invoice::model()->findAll(['condition' => 'status NOT IN (1, 8, 10, 99) AND dpt_id ' . (empty($pt[0]) ? '!' : '') . '= :dpt AND dpmt ' . ($pt[3] > 1 ? '= :dpmt' : '< 10') . ' AND `date` >= :df AND `date` <= :dt', 'params' => $param]);

			$xls->setColWidth([15, 15, 15, 35, 15, 15, 15, 15]);
			$xls->setFont('A' . $i . ':H' . $i, ['bold' => true]);
			$xls->addRow($i++, ['Date', 'Inv #', 'Client ID', 'Client Name', 'Type', 'Currency', 'Amount', 'GST']);
			foreach ($rs as $r) {
				$xls->addRow($i++, [$r->date, $r->no, $r->to_id, $r->cust->name, $r->getType(), $r->getCurrency(), ($r->total - $r->gst), $r->gst]);
			}

			// manual credit invoice
			$invs = Invoice::model()->findAll('status = 8 AND dpt_id ' . (empty($pt[0]) ? '!' : '') . '= :dpt AND dpmt ' . ($pt[3] > 1 ? '= :dpmt' : '< 10') . ' AND `date` >= :df AND `date` <= :dt', $param);
			foreach ($invs as $r) {
				if ($r->payments[0]->payment->type == 5 && $r->payments[0]->payment->bank == 90) {
					continue;
				}

				$xls->addRow($i++, [$r->date, $r->no, $r->to_id, $r->cust->name, $r->getType(), $r->getCurrency(), ($r->total - $r->gst), $r->gst]);
			}

			// credit note
			$param = [':df' => $pt[1], ':dt' => $pt[2]];
			if ($pt[3] > 1) {
				$param[':dpmt'] = $pt[3];
			}
			$pays = Payment::model()->findAll('type = 5 AND bank = 91 AND status = 6 AND dpmt ' . ($pt[3] > 1 ? '= :dpmt' : '< 10') . ' AND `date` >= :df AND `date` <= :dt', $param);
			foreach ($pays as $r) {
				$xls->addRow($i++, [$r->date, $r->no, $r->org_id, $r->cust->name, $r->getType(), $r->getCurrency(), -$r->amount + $r->line_gst, -$r->line_gst]);
			}

			//cogs
			$param = [':dpt' => $pt[0], ':df' => $pt[1], ':dt' => $pt[2]];
			$sql = 'SELECT b.date, b.billing_cref, CONCAT(b.org_id, " - ", o.name) AS org_name, l.charge_code, l.currency, l.actual_amount, l.gst_amount FROM `hvlv_top`.`billing_line` l INNER JOIN `hvlv_top`.`billing` b ON l.billing_id = b.id LEFT JOIN `hvlv_db`.`chargecode` c on c.code = l.charge_code LEFT JOIN `hvlv_db`.`org` o ON o.id = b.org_id WHERE c.type = "Direct Costs" AND b.status NOT IN (1,11) AND l.status NOT IN (1,11) AND l.dpmt ' . ($pt[3] > 1 ? '= :dpmt' : '< 10') . ' AND b.dpt_id ' . (empty($pt[0]) ? '!' : '') . '= :dpt AND b.`date` >= :df AND b.`date` <= :dt ORDER BY b.org_id, l.currency';

			if ($pt[3] > 1) {
				$param[':dpmt'] = $pt[3];
			}

			$rs = Yii::app()->db->createCommand($sql)->bindValues($param)->queryAll();

			$xls->createSheet('COGS');
			$xls->goSheet(1);
			$i = 1;
			$xls->setColWidth([15, 15, 35, 15, 15, 15, 15]);
			$xls->setFont('A' . $i . ':G' . $i, ['bold' => true]);
			$xls->addRow($i++, ['Date', 'Inv #', 'Supplier', 'GL Code', 'Currency', 'Amount', 'GST']);
			foreach ($rs as $r) {
				$r['currency'] = Invoice::$currencies[$r['currency']];
				$xls->addRow($i++, $r);
			}
			$dpmt = $pt[3] > 1 ? Invoice::$dpmts[$pt[3]] : 'Other';
			$xls->output('financial_report_' . str_replace('/', '', $dpmt) . '_' . $pt[1] . '-' . $pt[2] . '.xlsx');
		}
	}

	public function actionAjaxRebateSumReport($path)
	{
		Yii::app()->name = "TLA";
		$pt = explode('/', $path);
		$dptStr = " ";
		if(!empty($pt[0]))
		{
			$dptStr = " AND dpt_id = " . $pt[0];
		}
		$ptc = count($pt);
		if ($ptc < 4) { //top
			//revenue
			$sql = 'SELECT "all" as dpmt,currency, SUM(total-gst) AS ttl FROM `hvlv_top`.invoice WHERE status IN (6,9,11) AND dpt_id ' . (empty($pt[0]) ? '!' : '') . '= :dpt AND `date` >= :df AND `date` <= :dt GROUP BY currency';
			$rs = Yii::app()->db->createCommand($sql)->bindValues([':dpt' => $pt[0], ':df' => $pt[1], ':dt' => $pt[2]])->queryAll();
			$dpmts = [];
			foreach ($rs as $r) {
				if ($r['currency'] == 0) {
					$r['currency'] = 1;
				}

				if (!isset($dpmts[$r['dpmt']])) {
					$dpmts[$r['dpmt']] = [];
				}

				if (!isset($dpmts[$r['dpmt']][$r['currency']])) {
					$dpmts[$r['dpmt']][$r['currency']] = [0,0,0];
				}

				$dpmts[$r['dpmt']][$r['currency']][0] += $r['ttl'];
			}

			// credit note
			$pays = Payment::model()->with('pays','pays.invoice')->findAll('t.type = 5 AND t.bank = 91 AND t.status = 6 AND t.`date` >= :df AND t.`date` <= :dt AND invoice.status=6', [':df' => $pt[1], ':dt' => $pt[2]]);
			foreach ($pays as $pay) {
				if (!isset($dpmts['all'])) {
					$dpmts['all'] = [];
				}

				if (!isset($dpmts['all'][$pay->currency])) {
					$dpmts['all'][$pay->currency] = [0,0,0];
				}

				$dpmts['all'][$pay->currency][0] -= $pay->amount - $pay->line_gst;
			}


			$sql = 'SELECT "all" as dpmt,inv.id, currency, SUM(inl.amount-inl.gst) AS ttl, SUM(inl.gst) AS gst,inv.status FROM `hvlv_top`.inv_line_rebate inl left join `hvlv_top`.invoice inv on inl.inv_id = inv.id WHERE status IN (6,9,11) AND dpt_id ' . (empty($pt[0]) ? '!' : '') . '= :dpt AND `date` >= :df AND `date` <= :dt and inl.rebate=1 GROUP BY inv.id, inv.currency';
			$rs = Yii::app()->db->createCommand($sql)->bindValues([':dpt' => $pt[0], ':df' => $pt[1], ':dt' => $pt[2]])->queryAll();
			foreach ($rs as $r) {

				if ($r['currency'] == 0) {
					$r['currency'] = 1;
				}

				if (!isset($dpmts[$r['dpmt']])) {
					$dpmts[$r['dpmt']] = [];
				}

				if (!isset($dpmts[$r['dpmt']][$r['currency']])) {
					$dpmts[$r['dpmt']][$r['currency']] = [0,0,0];
				}

				$thisTtl = $r['ttl'];
				if($r['status']==6)
				{
					$pays = Payment::model()->with('pays','pays.invoice')->findAll('t.type = 5 AND t.bank = 91 AND t.status = 6 AND t.`date` >= :df AND t.`date` <= :dt AND invoice.id=:invId', [':df' => $pt[1], ':dt' => $pt[2],':invId'=>$r['id']]);
					foreach ($pays as $key => $pay) {
						foreach ($pay->pays as $key2 => $pa)
						{
							if($r['gst']>0)
							{
								$thisTtl = $thisTtl-($pa->amount/1.1);
							}else
							{
								$thisTtl = $thisTtl-$pa->amount;
							}
						}
					}
				}
				if($thisTtl>0)
				{
					$dpmts[$r['dpmt']][$r['currency']][1] += $thisTtl;
				}
			}

			$sql = 'SELECT "all" as dpmt,inv.id, currency, SUM(inl.amount-inl.gst) AS ttl, SUM(inl.gst) AS gst FROM `hvlv_top`.inv_line_rebate inl left join `hvlv_top`.invoice inv on inl.inv_id = inv.id WHERE status IN (6,9,11) AND dpt_id ' . (empty($pt[0]) ? '!' : '') . '= :dpt AND `date` >= :df AND `date` <= :dt and inl.rebate=2 GROUP BY inv.id, inv.currency';
			$rs = Yii::app()->db->createCommand($sql)->bindValues([':dpt' => $pt[0], ':df' => $pt[1], ':dt' => $pt[2]])->queryAll();
			foreach ($rs as $r) {
				if ($r['currency'] == 0) {
					$r['currency'] = 1;
				}

				if (!isset($dpmts[$r['dpmt']])) {
					$dpmts[$r['dpmt']] = [];
				}

				if (!isset($dpmts[$r['dpmt']][$r['currency']])) {
					$dpmts[$r['dpmt']][$r['currency']] = [0,0,0];
				}

				$thisTtl = $r['ttl'];
				if($r['status']==6)
				{
					$pays = Payment::model()->with('pays','pays.invoice')->findAll('t.type = 5 AND t.bank = 91 AND t.status = 6 AND t.`date` >= :df AND t.`date` <= :dt AND invoice.id=:invId', [':df' => $pt[1], ':dt' => $pt[2],':invId'=>$r['id']]);
					foreach ($pays as $key => $pay) {
						foreach ($pay->pays as $key2 => $pa)
						{
							if($r['gst']>0)
							{
								$thisTtl = $thisTtl-($pa->amount/1.1);
							}else
							{
								$thisTtl = $thisTtl-$pa->amount;
							}
						}
					}
				}
				if($thisTtl>0)
				{
					$dpmts[$r['dpmt']][$r['currency']][2] += $thisTtl;
				}
			}


			$sum_rev = [];
			$sum_rebate = [];
			$sum_rebate_invalid = [];
			$audtt_rev = 0;
			$audtt_rebate = 0;
			$audtt_rebate_invalid = 0;
			$ls = "";
			foreach ($dpmts as $dp => $ct) {
				$ls .= '<li><p><span class="exp" data-path="' . $path . '/' . $dp . '" data-loaded="0"></span> ' . (($dp == 1) ? 'Other' : 'all') . ' &nbsp; &nbsp; ';
				$tt_rev = [];
				$tt_rebate = [];
				$tt_rebate_invalid = [];
				$sta_rev = 0;
				$sta_cost = 0;
				foreach ($ct as $c => $t) {
					if (!empty($t[0])) {
						$tt_rev[] = Invoice::$currencies[$c] . ' ' . AppHelper::money_format('', $t[0]);
						if (!isset($sum_rebate[$c])) {
							$sum_rebate[$c] = 0;
						}
						if (!isset($sum_rebate_invalid[$c])) {
							$sum_rebate_invalid[$c] = 0;
						}
						if(!isset($sum_rev[$c])) $sum_rev[$c] = 0;
						$sum_rev[$c] += $t[0];
						if ($c > 1) {
							$exrate = Currency::getExrate($pt[2], $c)[0];
							$audtt_rev += $t[0] / $exrate;
							$sta_rev += $t[0] / $exrate;
						} else {
							$audtt_rev += $t[0];
							$sta_rev += $t[0];
						}
					}
					if (empty($t[0])) {
						continue;
					}

					$tt_rebate[] = Invoice::$currencies[$c] . ' ' . AppHelper::money_format('', $t[1]);
					$tt_rebate_invalid[] = Invoice::$currencies[$c] . ' ' . AppHelper::money_format('', $t[2]);
					if (!isset($sum_rebate[$c])) {
						$sum_rebate[$c] = 0;
					}
					if (!isset($sum_rebate_invalid[$c])) {
						$sum_rebate_invalid[$c] = 0;
					}

					$sum_rebate[$c] += $t[1];
					$sum_rebate_invalid[$c] += $t[2];
					if ($c > 1) {
						$exrate = Currency::getExrate($pt[2], $c)[0];
						$audtt_cost += $t[1] / $exrate;
						$sta_cost += $t[1] / $exrate;
					} else {
						$audtt_rebate += $t[1];
						$sta_cost += $t[1];
						$audtt_rebate_invalid += $t[2];
					}
				}
				$ls .= 'Rev: ';
				if (count($tt_rev) > 1) {
					$ls .= '<b>~AUD ' . AppHelper::money_format('', $sta_rev) . '</b> (' . implode(' &nbsp;', $tt_rev) . ')';
				} else {
					$ls .= implode(' &nbsp;', $tt_rev);
				}
				$ls .= ' &nbsp; Rebate: ';
				if (count($tt_rebate) > 1) {
					$ls .= '<b>~AUD ' . AppHelper::money_format('', $sta_cost) . '</b> (' . implode(' &nbsp;', $tt_rebate) . ')';
				} else {
					$ls .= implode(' &nbsp;', $tt_rebate);
				}
				// $ls .= ' &nbsp; Invalid Rebate: ';
				// if (count($tt_rebate_invalid) > 1) {
				// 	$ls .= '<b>~AUD ' . AppHelper::money_format('', $sta_cost) . '</b> (' . implode(' &nbsp;', $tt_rebate_invalid) . ')';
				// } else {
				// 	$ls .= implode(' &nbsp;', $tt_rebate_invalid);
				// }
				$ls .= '</p><ul></ul></li>';
			}

			$rcs = [];
			foreach ($sum_rev as $c => $t) {
				$rcs[] = Invoice::$currencies[$c] . ' ' . AppHelper::money_format('', $t);
			}
			$ccs = [];
			foreach ($sum_rebate as $c => $t) {
				$ccs[] = Invoice::$currencies[$c] . ' ' . AppHelper::money_format('', $t);
			}

			$ccsi = [];
			foreach ($sum_rebate_invalid as $c => $t) {
				$ccsi[] = Invoice::$currencies[$c] . ' ' . AppHelper::money_format('', $t);
			}

			echo '<li><p>Total - Rev: ';
			if (count($rcs) > 1) {
				echo '<b>~AUD ' . AppHelper::money_format('', $audtt_rev) . '</b> (' . implode(' &nbsp;', $rcs) . ')';
			} else {
				echo 'AUD ' . AppHelper::money_format('', $audtt_rev);
			}

			echo ' &nbsp; Rebate: ';
			if (count($ccs) > 1) {
				echo '<b>~AUD ' . AppHelper::money_format('', $audtt_rebate) . '</b> (' . implode(' &nbsp;', $ccs) . ')';
			} else {
				echo 'AUD ' . AppHelper::money_format('', $audtt_rebate);
			}

			// echo ' &nbsp; Invalid Rebate: ';
			// if (count($ccsi) > 1) {
			// 	echo '<b>~AUD ' . AppHelper::money_format('', $audtt_rebate_invalid) . '</b> (' . implode(' &nbsp;', $ccsi) . ')';
			// } else {
			// 	echo 'AUD ' . AppHelper::money_format('', $audtt_rebate_invalid);
			// }

			echo '</p><ul>' . $ls . '</ul></li>';
		} elseif ($ptc == 4) {
			echo '<li><p><span class="exp" data-path="' . $path . '/clt" data-loaded="0"></span> By Client</p><ul></ul></li>
				<li><p><a href="report/ajaxRebateSumReport.app?path=' . $path . '/export" target="_blank">Export</a></p></li>';
		} elseif ($ptc == 5 && $pt[4] == 'clt') {
			$param = [':dpt' => $pt[0], ':df' => $pt[1], ':dt' => $pt[2]];
			$sql = 'SELECT i.to_id, o.name as org_name, i.currency, SUM(i.total - i.gst) AS ttl FROM `hvlv_top`.`invoice` i INNER JOIN `hvlv_top`.`org` o ON o.id = i.to_id WHERE i.status IN (6,9,11) AND i.dpt_id ' . (empty($pt[0]) ? '!' : '') . '= :dpt AND i.`date` >= :df AND i.`date` <= :dt GROUP BY i.to_id, i.currency ORDER BY ttl DESC';

			if ($pt[3] > 1) {
				$param[':dpmt'] = $pt[3];
			}
			$rs = Yii::app()->db->createCommand($sql)->bindValues($param)->queryAll();

			$sps = [];
			$orgs = [];
			foreach ($rs as $r) {
				if ($r['currency'] == 0) {
					$r['currency'] = 1;
				}

				$orgs[$r['to_id']] = $r['org_name'];
				if (!isset($sps[$r['to_id']])) {
					$sps[$r['to_id']] = [];
				}

				if (!isset($sps[$r['to_id']][$r['currency']])) {
					$sps[$r['to_id']][$r['currency']] = 0;
				}

				$sps[$r['to_id']][$r['currency']] += $r['ttl'];
			}

			// credit note
			$pays = Payment::model()->with('pays','pays.invoice')->findAll('t.type = 5 AND t.bank = 91 AND t.status = 6 AND t.`date` >= :df AND t.`date` <= :dt AND invoice.status=6', [':df' => $pt[1], ':dt' => $pt[2]]);
			foreach ($pays as $pay) {
				if (!isset($sps[$pay->org_id])) {
					$sps[$pay->org_id] = [];
				}

				if (!isset($sps[$pay->org_id][$pay->currency])) {
					$sps[$pay->org_id][$pay->currency] = 0;
				}

				$sps[$pay->org_id][$pay->currency] -= $pay->amount - $pay->line_gst;
			}

			$sql = 'SELECT inv.to_id as org_id,"all" as dpmt,inv.id, currency, SUM(inl.amount-inl.gst) AS sum , SUM(inl.gst) AS gst,inv.status FROM `hvlv_top`.inv_line_rebate inl left join `hvlv_top`.invoice inv on inl.inv_id = inv.id WHERE status IN (6,9,11) AND dpt_id ' . (empty($pt[0]) ? '!' : '') . '= :dpt AND `date` >= :df AND `date` <= :dt and rebate = 1 GROUP BY inv.id, inv.currency';
			$rs = Yii::app()->db->createCommand($sql)->bindValues([':dpt' => $pt[0], ':df' => $pt[1], ':dt' => $pt[2]])->queryAll();

			$costArr = [];
			foreach ($rs as $key => $r) {
				if(!isset($costArr[$r['org_id']]))
				{
					$costArr[$r['org_id']] = 0;
				}
				$sum = $r['sum'];

				if($r['status']==6)
				{
					$pays = Payment::model()->with('pays','pays.invoice')->findAll('t.type = 5 AND t.bank = 91 AND t.status = 6 AND t.`date` >= :df AND t.`date` <= :dt AND invoice.id=:invId', [':df' => $pt[1], ':dt' => $pt[2],':invId'=>$r['id']]);
					foreach ($pays as $key => $pay) {
						foreach ($pay->pays as $key2 => $pa)
						{
							if($r['gst']>0)
							{
								$sum = $sum-($pa->amount/1.1);
							}else
							{
								$sum = $sum-$pa->amount;
							}
						}
					}
				}
				if($sum>0)
				{
					$costArr[$r['org_id']] += $sum;
				}
			}


			$sql = 'SELECT inv.to_id as org_id,"all" as dpmt,inv.id, currency, SUM(inl.amount-inl.gst) AS sum, SUM(inl.gst) AS gst,inv.status FROM `hvlv_top`.inv_line_rebate inl left join `hvlv_top`.invoice inv on inl.inv_id = inv.id WHERE status IN (6,9,11) AND dpt_id ' . (empty($pt[0]) ? '!' : '') . '= :dpt AND `date` >= :df AND `date` <= :dt and rebate = 2 GROUP BY inv.id, inv.currency';
			$rs = Yii::app()->db->createCommand($sql)->bindValues([':dpt' => $pt[0], ':df' => $pt[1], ':dt' => $pt[2]])->queryAll();

			$invalidRebateArr = [];
			foreach ($rs as $key => $r) {
				if(!isset($invalidRebateArr[$r['org_id']]))
				{
					$invalidRebateArr[$r['org_id']] = 0;
				}
				$sum = $r['sum'];
				if($r['status']==6)
				{
					$pays = Payment::model()->with('pays','pays.invoice')->findAll('t.type = 5 AND t.bank = 91 AND t.status = 6 AND t.`date` >= :df AND t.`date` <= :dt AND invoice.id=:invId', [':df' => $pt[1], ':dt' => $pt[2],':invId'=>$r['id']]);
					foreach ($pays as $key => $pay) {
						foreach ($pay->pays as $key2 => $pa)
						{
							if($r['gst']>0)
							{
								$sum = $sum-($pa->amount/1.1);
							}else
							{
								$sum = $sum-$pa->amount;
							}
						}
					}
				}
				if($sum>0)
				{
					$invalidRebateArr[$r['org_id']] += $sum;
				}

			}



			// $out = '<div class="grid-view"><table class="items"><thead><tr><th>Client</th><th>Total Revenue</th><th>Rebate Revenue</th><th>Invalid Rebate Revenue</th><th>Rebate Percentage</th></tr></thead><tbody>';
			$out = '<div class="grid-view"><table class="items"><thead><tr><th>Client</th><th>Total Revenue</th><th>Rebate Revenue</th><th>Rebate Percentage</th></tr></thead><tbody>';
			foreach ($sps as $oid => $ct) {
				$tr = '<tr><td>' . $oid . ' - ' . $orgs[$oid] . '</td><td>';
				$gt0 = false;
				$dd = '';
				$sta = 0;
				foreach ($ct as $c => $t) {
					if (empty($t)) {
						continue;
					}

					$dd .= Invoice::$currencies[$c] . ' ' . AppHelper::money_format('', $t) . ' &nbsp;';
					$gt0 = true;
					if ($c > 1) {
						$exrate = Currency::getExrate($pt[2], $c)[0];
						$sta += $t / $exrate;
					} else {
						$sta += $t;
					}
				}
				if (count($ct) > 1) {
					$tr .= '<b>~AUD ' . AppHelper::money_format('', $sta) . '</b> &nbsp; &nbsp; ';
				}
				$tr .= $dd . '</td>';

				$rebate = isset($costArr[$oid])?$costArr[$oid]:0;
				$invalidRebate = isset($invalidRebateArr[$oid])?$invalidRebateArr[$oid]:0;
				$percent = 0;
				$percent = OrgRateService::getOrgRebatePercentWithRebateAmount($rebate,$oid)*100;
				//$tr .= '<td>'.AppHelper::money_format('',$rebate).'</td><td>'.AppHelper::money_format('',$invalidRebate).'</td><td>'.$percent.'%</td></tr>';
				$tr .= '<td>'.AppHelper::money_format('',$rebate).'</td><td>'.$percent.'%</td></tr>';
				if ($gt0) {
					$out .= $tr;
				}

			}
			echo $out . '</tbody></table></div>';
		} elseif ($ptc == 5 && $pt[4] == 'export') {

			$xls = new oExcel;
			$i = 1;
			$sheet = $xls->getActiveSheet();
			$sheet->setTitle('Rebate Details');

			//revenue
			$param = [':dpt' => $pt[0], ':df' => $pt[1], ':dt' => $pt[2]];
			if ($pt[3] > 1) {
				$param[':dpmt'] = $pt[3];
			}
			
			$sql = 'SELECT inv.to_id as org_id,"all" as dpmt,inv.id, currency, SUM(inl.amount-inl.gst) AS sum , SUM(inl.gst) AS gst,inv.status FROM `hvlv_top`.inv_line_rebate inl left join `hvlv_top`.invoice inv on inl.inv_id = inv.id WHERE status IN (6,9,11) AND dpt_id ' . (empty($pt[0]) ? '!' : '') . '= :dpt AND `date` >= :df AND `date` <= :dt and rebate = 1 GROUP BY inv.id, inv.currency';
			$rs = Yii::app()->db->createCommand($sql)->bindValues([':dpt' => $pt[0], ':df' => $pt[1], ':dt' => $pt[2]])->queryAll();

			$rebateArr = [];
			foreach ($rs as $key => $r) {
				$sum = $r['sum'];

				if($r['status']==6)
				{
					$pays = Payment::model()->with('pays','pays.invoice')->findAll('t.type = 5 AND t.bank = 91 AND t.status = 6 AND t.`date` >= :df AND t.`date` <= :dt AND invoice.id=:invId', [':df' => $pt[1], ':dt' => $pt[2],':invId'=>$r['id']]);
					foreach ($pays as $key => $pay) {
						foreach ($pay->pays as $key2 => $pa)
						{
							if($r['gst']>0)
							{
								$sum = $sum-($pa->amount/1.1);
							}else
							{
								$sum = $sum-$pa->amount;
							}
						}
					}
				}
				if($sum>0)
				{
					$rebateArr[$r['id']] = $sum;
				}
			}


			$rs = Invoice::model()->findAll(['condition' => 'status IN (6,9,11) AND dpt_id ' . (empty($pt[0]) ? '!' : '') . '= :dpt  AND `date` >= :df AND `date` <= :dt', 'params' => $param,'order'=>'to_id,id']);
			$xls->setColWidth([15, 15, 15, 35, 15, 15, 15, 15]);
			$xls->setFont('A' . $i . ':H' . $i, ['bold' => true]);
			$xls->addRow($i++, ['Date', 'Inv #', 'Client ID', 'Client Name', 'Type', 'Currency', 'Amount', 'GST','Credit Note','Rebate']);
			foreach ($rs as $r) {
				// credit note
				$credit = 0;
				$rebate = 0;
				if($r->status==6)
				{
					$pays = Payment::model()->with('pays','pays.invoice')->findAll('t.type = 5 AND t.bank = 91 AND t.status = 6 AND t.`date` >= :df AND t.`date` <= :dt AND invoice.id=:invId', [':df' => $pt[1], ':dt' => $pt[2],':invId'=>$r->id]);
					foreach ($pays as $key => $pay) {
						foreach ($pay->pays as $key2 => $pa)
						{
							$credit+=$pa->amount;
						}
					}
				}
				if(isset($rebateArr[$r->id]))
				{
					$rebate = $rebateArr[$r->id];
				}
				$xls->addRow($i++, [$r->date, $r->no, $r->to_id, $r->cust->name, $r->getType(), $r->getCurrency(), ($r->total - $r->gst), $r->gst,$credit,$rebate]);
			}

			
			$xls->output('rebate_report_all_' . $pt[1] . '-' . $pt[2] . '.xlsx');
		}
	}

	public function ajaxPlSumReport_40($pt, $path)
	{
		$dp = sizeof($pt);
		if ($dp == 6) {
			echo '<li><p><span class="exp" data-path="' . $path . '/clt" data-loaded="0"></span> By Client</p><ul></ul></li>';
		} elseif ($pt[6] == 'clt') {
			$rs = $this->_plQuery($pt, '', 'org_id', 'grs DESC');
			$c1 = ['o' => 'Client'];
			$this->_ajaxPLchart($rs, $c1, $path);
		}
	}

	public function actionPLReportExport()
	{
		$pt = $_GET;
		$rs = $this->_plQuery($pt, '', 'grp1');

		$xls = new oExcel;
		$i = 1;
		$xls->setColWidth([15, 25, 15, 15, 15, 15, 15, 15]);
		$xls->setFont('A' . $i . ':H' . $i, ['bold' => true]);
		$xls->addRow($i++, ['Job Date', 'Job #', 'Inv Date', 'Inv #', 'Client', 'OP', 'Sales Person', 'Rev', 'Accrual', 'Actual', 'GP', 'Margin']);

		foreach ($rs as $r) {
			$job = EdiJob::model()->findByPk($r['grp1']);
			$inv = empty($job->invoice) ? new Invoice : $job->invoice[count($job->invoice) - 1];
			$xls->addRow($i++, [$job->created, $job->no, $inv->date, $inv->no, $job->owner_id . ':' . $job->owner->shortName(), $job->getUser(), $job->getSP(), $r['rev'], $r['ac'], $r['at'], $r['grs'], ($r['rev'] > 0 ? round($r['grs'] / $r['rev'] * 100, 2) . '%' : 'n/a')]);
		}
		$xls->output('plreport_job_' . implode('_', $pt) . '.xlsx');
	}

	public function actionAjaxImPlSumReport()
	{
		$wid = 0;
		$reportService = new ReportService();
		$filtersForm = new FiltersForm;
		$provide = [];
		if (!empty($_GET['wid'])) {
			$wid = $_GET['wid'];
		}
		$type = isset($_GET['type']) ? $_GET['type'] : 1;
		if (isset($_GET['FiltersForm'])) {
			$filtersForm->filters = $_GET['FiltersForm'];
		}
		$dateFrom = isset($_GET['datefrom']) ? $_GET['datefrom'] : '';
		$dateTo = isset($_GET['dateto']) ? $_GET['dateto'] : '';
