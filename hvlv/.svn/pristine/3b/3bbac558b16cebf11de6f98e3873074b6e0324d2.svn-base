	private function downloadReportFile($filename)
	{
		$tempfile = Yii::app()->basePath . DIRECTORY_SEPARATOR . "runtime" . DIRECTORY_SEPARATOR . $filename;
		header("Cache-Control: maxage=1");
		header("Content-Type: application/force-download");
		header("Content-Type: application/octet-stream");
		header("Content-Type: application/download");
		header("Content-Disposition: attachment;filename=\"" . urldecode(basename($tempfile)) . '"');
		header("Content-Transfer-Encoding: binary");
		readfile($tempfile);
		unlink($tempfile);
		Yii::app()->end();
	}
	public function actionAjaxExportPlSumReport()
	{
		// export as excel
		$xls = new oExcel;
		$mfn = 'plsum_report_result';

		$wid = 0;
		if (!empty($_POST['wid'])) {
			$wid = $_POST['wid'];
		}
		if (empty($wid)) {
			$wid = Org::PCAE_DEPARTMENT_SYDNEY;
		}
		$dpmts = [];
		if (isset($_POST['dpmt'])) {
			$dpmts = $_POST['dpmt'];
		}
		if (empty($dpmts)) {
			$dpmts[] = 10;
		}

		$date = [];
		if (isset($_POST['date'])) {
			$date = $_POST['date'];
		}

		$sums = [];
		$dpmtsInArray = '(' . implode(',', $dpmts) . ')';

		$sql = "SELECT p.date ,p.amt * IF(c.type='Direct Costs', -1, 1) as amt,p.gst,p.dpmt,c.name,c.type,p.grp1,p.grp2 FROM pl_ledger_management p inner join chargecode c on p.gl = c.id where";
		$sql .= " p.dpt_id = " . $wid;
		$sql .= " AND p.dpmt in " . $dpmtsInArray;
		$sql .= " AND p.date >= '" . $date['from'] . "' AND p.date <= '" . $date['to'] . "'";
		$sumRows = Yii::app()->db->createCommand($sql)->queryAll();
		$i = 1;
		$xls->addRow($i++, ['Date', 'Amount', 'GST', 'Department', 'Name', 'Type', 'Grp1', 'Grp2']);
		$mxTotal = 0;
		$mxGst = 0;
		foreach ($sumRows as $r) {
			$xls->addRow($i++, [$r['date'], AppHelper::money_format('%i', $r['amt']), AppHelper::money_format('%i', $r['gst']), $r['dpmt'], $r['name'], $r['type'], $r['grp1'], $r['grp2']]);
			$mxTotal += $r['amt'];
			$mxGst += $r['gst'];
		}

		$xls->addRow($i++, ['Total', AppHelper::money_format('%i', $mxTotal), AppHelper::money_format('%i', $mxGst)]);

		$tempfile = Yii::app()->basePath . DIRECTORY_SEPARATOR . "runtime" . DIRECTORY_SEPARATOR . $mfn . '.xlsx';

		$xls->output($tempfile, null, false);
		$dlUrl = $this->createUrl('report/downloadPlSumReportResult');
		$resp = '<span>File is ready , Please <a href="' . $dlUrl . '" target="_blank">click me</a> to download now<span>';

		echo $resp;
	}

	public function actionAjaxExportPlGroupReport()
	{
		$mqProcess = null;
		$shipmentDetails = 0;
		if(!empty($_GET['mqProcessId']))
		{
			$mqProcess = MqProcess::model()->findByPk($_GET['mqProcessId']);
			$path =$mqProcess->mdata['path'];
			$shipmentDetails = $mqProcess->mdata['shipmentDetails'];
		}else
		{
			$path = $_GET['path'];
			$shipmentDetails = 0;
			if(!empty($_GET['shipments']))
			{
				$shipmentDetails = 1;
			}
		}
		$pt = explode('/', $path);

		if(empty($_GET['mqProcessId']))
		{
			$mqProcess = new MqProcess();
			$mqProcess->process_type = MqProcess::PLGROUP_REPORT;
			$mqProcess->process_status = MqProcess::NO_READY;
			$mqProcess->des = "deport:".$pt[0]." From:".$pt[1]." To:".$pt[2]." Org:".$pt[3]." Consol:".$pt[4]." Department:".$pt[5]." shipmentDetails:".($shipmentDetails==1?"Yes":"No");
			$mqProcess->mdata=["path"=>$path,"shipmentDetails"=>$shipmentDetails];
			$mqProcess->save();
			$tlaTaskService = new TlaTaskService();
			$tlaTaskService->transferMqProcessToBeReportTask($mqProcess);
			echo "Submit process success";
			return;
		}

		if(!empty($mqProcess))
		{
			$mqProcess->process_status = MqProcess::PROCESSING;
			$mqProcess->update(['process_status']);
		}
		// export as excel
		$xls = new oExcel;
		$mfn = 'plsum_report_result';

		$dptStr = " AND dpt_id = " . $pt[0];
		if (empty($pt[0])) {
			$dptStr = "";
		}
		$sql = "SELECT p.dpt_id,p.dpmt, org_id, grp1, grp2, gl, SUM(IF(actual_amt > 0 OR acc = 1, actual_amt, amt) * IF(c.type='Direct Costs' OR c.type='Expense', -1, 1)) AS grs, SUM(IF(actual_amt > 0 OR acc = 1, actual_amt,amt) * IF(c.type='Direct Costs' OR c.type='Expense', 0, 1)) AS rev, SUM(amt * IF(c.type='Direct Costs' OR c.type='Expense', 1, 0) * IF(acc = 0, 1, 0)) AS ac, SUM(actual_amt * IF(c.type='Direct Costs' OR c.type='Expense', 1, 0)) AS at,fid FROM pl_ledger_management p INNER JOIN chargecode c ON p.gl = c.id WHERE gl != 98  AND model!='ImP_Manifest' " . $dptStr . " AND date >= '" . $pt[1] . "' AND date <= '" . $pt[2] . "'  and (actual_amt>=0 or amt >=0)";

		if (!empty($pt[3])) {
			$sql .= ' AND p.org_id = ' . $pt[3] . ' ';
		}

		if (!empty($pt[4])) {
			$nos = explode(',',$pt[4]);
			$consol = Consol::model()->findAll('no in ("'.join('","',$nos).'")',[":no"=>$pt[4]]);
			if(empty($consol))
			{
				$sql .= ' AND p.grp1 = 999999999 ';
			}else
			{
				$sql .= ' AND p.grp1 in ( ' . join(',',array_column($consol,'id')) . ') ';
			}
		}

		if ($pt[5]!="") {
			$sql .= ' AND p.dpmt = ' . $pt[5] . ' ';
		}

		if(!empty($pt[4])||$shipmentDetails==1)
		{
			$sql .= ' GROUP BY fid';
		}else
		{
			if($pt[5]==Invoice::DPMT_3PL)
			{
				$sql .= ' GROUP BY org_id';
			}else
			{
				$sql .= ' GROUP BY org_id,grp1';
			}
		}



		$sumRows = Yii::app()->db->createCommand($sql)->queryAll();
		$i = 1;

		if(!empty($pt[4])||$shipmentDetails==1)
		{
			$xls->addRow($i++, ['HBN','Ref','Pkg','Weight','Total CBM','Consol','Org Id', 'Rev.', 'Acr Cost', 'Actl Cost', 'GP', 'Margin']);
		}else
		{
			if($pt[5]==Invoice::DPMT_3PL)
			{
				$xls->addRow($i++, ['Org Id', 'Rev.', 'Acr Cost', 'Actl Cost', 'GP', 'Margin']);
			}else
			{
				$xls->addRow($i++, ['Consol','Org Id', 'Rev.', 'Acr Cost', 'Actl Cost', 'GP', 'Margin']);
			}
		}


		
		$mxTotal = 0;
		$mxGst = 0;
		foreach ($sumRows as $rkey => $r) {
			$o = Org::model()->findByPk($r['org_id']);
			if(!empty($o->owner)&&$o->by!=1)
			{
				foreach ($sumRows as $key => $my) {
					if(!empty($pt[4])||$shipmentDetails==1)
					{
						if($r['fid']==$my['fid']&&$my['org_id'] == $o->owner->id&&$r['grp1']==$my['grp1'])
						{
							$sumRows[$key]['rev']+=$r['rev'];
							$sumRows[$key]['ac']+=$r['ac'];
							$sumRows[$key]['at']+=$r['at'];
							$sumRows[$key]['grs']+=$r['grs'];
							unset($sumRows[$rkey]);
							break;
						}
					}else
					{
						if($pt[5]==Invoice::DPMT_3PL)
						{
							if($my['org_id'] == $o->owner->id)
							{
								$sumRows[$key]['rev']+=$r['rev'];
								$sumRows[$key]['ac']+=$r['ac'];
								$sumRows[$key]['at']+=$r['at'];
								$sumRows[$key]['grs']+=$r['grs'];
								unset($sumRows[$rkey]);
								break;
							}
						}else
						{
							if($my['org_id'] == $o->owner->id&&$r['grp1']==$my['grp1'])
							{
								$sumRows[$key]['rev']+=$r['rev'];
								$sumRows[$key]['ac']+=$r['ac'];
								$sumRows[$key]['at']+=$r['at'];
								$sumRows[$key]['grs']+=$r['grs'];
								unset($sumRows[$rkey]);
								break;
							}
						}


					}

				}
				if(isset($sumRows[$rkey]))
				{
					$sumRows[$rkey]['org_id'] = $o->owner->id;
				}

			}
		}



		foreach ($sumRows as $r) {
			if(!empty($pt[4])||$shipmentDetails==1)
			{
				$consol = Consol::model()->findByPk($r['grp1']);
				$org = Org::model()->findByPk($r['org_id']);
				$p = ImParcel::model()->findByPk($r['fid']);
				$consolNo = $consol->no;
				if(empty($p))
				{
					$consolNo = "";
				}
				$pkg = 0;
				$weight = 0;
				$totalCBM = 0;
				if(!empty($p)) $pkg=$p->pkg;
				if(!empty($p)) $weight=$p->weight;
				if(!empty($p)) $totalCBM=number_format($p->cbm*$p->pkg,4,'.','');

				$xls->addRow($i++, [@$p->hbn,@$p->ref,$pkg,$weight,$totalCBM,$consolNo,@$org->name, AppHelper::money_format('', $r['rev']),  AppHelper::money_format('', $r['ac']), AppHelper::money_format('', $r['at']), AppHelper::money_format('', $r['grs']), ($r['rev'] > 0 ? round($r['grs'] / $r['rev'] * 100, 2) . '%' : 'n/a')]);

			}else
			{
				if($pt[5]==Invoice::DPMT_3PL)
				{
					$org = Org::model()->findByPk($r['org_id']);
					$xls->addRow($i++, [@$org->name, AppHelper::money_format('', $r['rev']),  AppHelper::money_format('', $r['ac']), AppHelper::money_format('', $r['at']), AppHelper::money_format('', $r['grs']), ($r['rev'] > 0 ? round($r['grs'] / $r['rev'] * 100, 2) . '%' : 'n/a')]);
				}else
				{
					$consol = Consol::model()->findByPk($r['grp1']);
					$org = Org::model()->findByPk($r['org_id']);
					$xls->addRow($i++, [@$consol->no,@$org->name, AppHelper::money_format('', $r['rev']),  AppHelper::money_format('', $r['ac']), AppHelper::money_format('', $r['at']), AppHelper::money_format('', $r['grs']), ($r['rev'] > 0 ? round($r['grs'] / $r['rev'] * 100, 2) . '%' : 'n/a')]);
				}
			}
		}

		if(!empty($mqProcess))
		{
			$filename = $mfn.$mqProcess->id . '.xlsx';
			$tempfile = Yii::app()->basePath . DIRECTORY_SEPARATOR . "runtime" . DIRECTORY_SEPARATOR . $filename;
			$xls->output($tempfile, null, false);
			FileRepo::storeFile($tempfile, $filename, FileRepo::TLATASKFILETYPE, $mqProcess->task->id);
			
			if(!empty($mqProcess))
			{
				$mqProcess->process_status = MqProcess::READY;
				$mqProcess->update(['process_status']);
			}
		}
		// $tempfile = Yii::app()->basePath . DIRECTORY_SEPARATOR . "runtime" . DIRECTORY_SEPARATOR . $mfn.$mqProcess->id . '.xlsx';
		// $xls->output($tempfile, null, false);
		// $dlUrl = $this->createUrl('report/downloadPlSumReportResult');
		// $resp = '<span>File is ready , Please <a href="' . $dlUrl . '" target="_blank">click me</a> to download now<span>';

		// echo $resp;
	}

	/**
	 * because currently it is a little bit tough to download file in ajax form
	 * so we save the destination file firstly , then provide this download link to download the file again
	 */
	public function actionDownloadPlSumReportResult()
	{
		$xls = new oExcel;
		$mfn = 'plsum_report_result';
		$tempfile = Yii::app()->basePath . DIRECTORY_SEPARATOR . "runtime" . DIRECTORY_SEPARATOR . $mfn . '.xlsx';
		$xls->load($tempfile);
		$xls->output($mfn . '.xlsx');
	}

	public function _plQuery($pt, $c = '', $g = '', $o = '',$freshCache = false)
	{
		$data = [$pt,$c,$g,$o];
		$key = 'PL:'.json_encode($data);
		$rsData = Yii::app()->cache->get($key); // caching the system setting
		if(!empty($rsData))
		{
			// if($freshCache===false)
			// {
			// 	return json_decode($rsData,true);
			// }
		}

		$dptStr = " AND dpt_id = " . $pt[0];
		if (empty($pt[0])) {
			$dptStr = "";
		}
		$sql = "SELECT p.dpt_id,p.dpmt, org_id, grp1, grp2, gl, SUM(IF(actual_amt > 0 OR acc = 1, actual_amt, amt) * IF(c.type='Direct Costs' OR c.type='Expense' OR c.type='Credit', -1, 1)) AS grs, SUM(IF(actual_amt > 0 OR acc = 1, actual_amt,amt) * IF(c.type='Direct Costs' OR c.type='Expense', 0, 1)* IF(c.type='Credit', -1, 1)) AS rev, SUM(amt * IF(c.type='Direct Costs' OR c.type='Expense', 1, 0) * IF(acc = 0, 1, 0)) AS ac, SUM(actual_amt * IF(c.type='Direct Costs' OR c.type='Expense', 1, 0)) AS at FROM pl_ledger_management p INNER JOIN chargecode c ON p.gl = c.id WHERE gl != 98  AND model!='ImP_Manifest' " . $dptStr . " AND date >= '" . $pt[1] . "' AND date <= '" . $pt[2] . "'  and (actual_amt>=0 or amt >=0)";

		if (!empty($pt[3])) {
			$sql .= ' AND p.org_id = ' . $pt[3] . ' ';
		}


		if (!empty($pt[4])) {
			$nos = explode(',',$pt[4]);
			$consol = Consol::model()->findAll('no in ("'.join('","',$nos).'")',[":no"=>$pt[4]]);
			if(empty($consol))
			{
				$sql .= ' AND p.grp1 = 999999999 ';
			}else
			{
				$sql .= ' AND p.grp1 in ( ' . join(',',array_column($consol,'id')) . ') ';
			}
		}




		if ($pt[5]!="") {
			$sql .= ' AND p.dpmt = ' . $pt[5] . ' ';
		}

		$sql .= $c;
		if (!empty($g)) {
		$sql .= ' GROUP BY ' . $g;
		}
		if (!empty($o)) {
			$sql .= ' ORDER BY ' . $o;
		}
		$rs = Yii::app()->db->createCommand($sql)->queryAll();
		Yii::app()->cache->set($key,json_encode($rs),518400);

		$key = 'PLCacheDate:'.json_encode($data);
		Yii::app()->cache->set($key,date('Y-m-d H:i:s'),518400);

		return $rs;
	}

	public function actionAjaxPlSumReport($path)
	{
		$pt = explode('/', $path);
		$nototal = @$_GET['nototal'];
		$data = [];
		if (sizeof($pt) < 6) { //top
			if($pt[0]=='all')
			{
				$pt[0] = '';
				$rs = $this->_plQuery($pt, '', 'dpt_id');
				$data = [$pt,'', 'dpt_id',''];
				$ls = '';
				$sum = ['rev' => 0, 'grs' => 0, 'at' => 0, 'ac' => 0];
				foreach ($rs as $r) {
					$pt[0] = $r['dpt_id'];
					$thisPath = join('/',$pt);
					$ls .= '<li><p><span class="exp" data-path="' . $thisPath. '" data-loaded="0" data-nototal="1"></span> ' .@Org::$warehouse_list[$r['dpt_id']] . ' &nbsp;&nbsp; Rev: ' . AppHelper::money_format('', $r['rev']) . ' &nbsp;&nbsp; GP: ' . AppHelper::money_format('', $r['grs']) . ' &nbsp;&nbsp; Cost: ' . AppHelper::money_format('', $r['at']) . ' + ' . AppHelper::money_format('', $r['ac']) . ' &nbsp;&nbsp; Margin: ' . ($r['rev'] > 0 ? round($r['grs'] / $r['rev'] * 100, 2) . '%' : 'n/a') . '&nbsp;</p><ul></ul></li>';
					foreach (array_keys($sum) as $k) {
						$sum[$k] += $r[$k];
					}
				}
			}else
			{
				$rs = $this->_plQuery($pt, '', 'dpmt');
				$data = [$pt,'', 'dpmt',''];
				$ls = '';
				$sum = ['rev' => 0, 'grs' => 0, 'at' => 0, 'ac' => 0];
				foreach ($rs as $r) {
					$ls .= '<li><p><span class="exp" data-path="' . $path . '/' . $r['dpmt'] . '" data-loaded="0"></span> ' . @Invoice::$dpmts[$r['dpmt']] . ' &nbsp;&nbsp; Rev: ' . AppHelper::money_format('', $r['rev']) . ' &nbsp;&nbsp; GP: ' . AppHelper::money_format('', $r['grs']) . ' &nbsp;&nbsp; Cost: ' . AppHelper::money_format('', $r['at']) . ' + ' . AppHelper::money_format('', $r['ac']) . ' &nbsp;&nbsp; Margin: ' . ($r['rev'] > 0 ? round($r['grs'] / $r['rev'] * 100, 2) . '%' : 'n/a') . '&nbsp;<input type="button" name="export_details" value="Export Details" data-path="' . $path . '/' . $r['dpmt'] . '"/><input type="button" name="export_shipment_details" value="Export Shipment Details" data-path="' . $path . '/' . $r['dpmt'] . '"/></p><ul></ul></li>';
					foreach (array_keys($sum) as $k) {
						$sum[$k] += $r[$k];
					}
				}
			}
			if($nototal=='1')
			{
				echo '<li><ul>' . $ls . '</ul></li>';
			}else
			{
				$head = "";
				$key = 'PLCacheDate:'.json_encode($data);
				$cacheDate = empty(Yii::app()->cache->get($key))?"":Yii::app()->cache->get($key);
				$head = '<p>Cache Date:'.$cacheDate.'</p>';
				echo $head.'<li><p>Total - Rev: ' . AppHelper::money_format('', $sum['rev']) . ' &nbsp;&nbsp; GP: ' . AppHelper::money_format('', $sum['grs']) . ' &nbsp;&nbsp; Cost: ' . AppHelper::money_format('', $sum['at']) . ' + ' . AppHelper::money_format('', $sum['ac']) . ' &nbsp;&nbsp; Margin: ' . ($sum['rev'] > 0 ? round($sum['grs'] / $sum['rev'] * 100, 2) . '%' : 'n/a') . '</p><ul>' . $ls . '</ul></li>';
			}
		} else {
			$this->{'ajaxPlSumReport_' . $pt[5]}($pt, $path);
		}
	}

	public function _ajaxPLchart($rs, $cs, $path, $extt = [])
	{
		$t = '<div class="grid-view"><table class="items"><thead><tr><th>' . implode('</th><th>', $cs) . '</th><th>Rev.</th><th>Acr Cost</th><th>Actl Cost</th><th>GP</th><th>Margin</th></tr></thead><tbody>';
		$i = 0;
		$tt = ['rev' => 0, 'grs' => 0, 'ac' => 0, 'at' => 0];
		foreach ($rs as $rkey => $r) {
			foreach ($cs as $c => $h) {
				switch ($c) {
					case 'o':
						$o = Org::model()->findByPk($r['org_id']);
						if(!empty($o->owner)&&$o->by!=1)
						{
							foreach ($rs as $key => $my) {
								if($my['org_id'] == $o->owner->id)
								{
									$rs[$key]['rev']+=$r['rev'];
									$rs[$key]['ac']+=$r['ac'];
									$rs[$key]['at']+=$r['at'];
									$rs[$key]['grs']+=$r['grs'];
									unset($rs[$rkey]);
									break;
								}

							}
							if(isset($rs[$rkey]))
							{
								$rs[$rkey]['org_id'] = $o->owner->id;
							}
						}
						break;
					
					default:
						break;
				}
			}
		}




		foreach ($rs as $r) {
			$ext = [];
			foreach ($cs as $c => $h) {
				switch ($c) {
					case 'o':
						$o = Org::model()->findByPk($r['org_id']);
						$ext[] = empty($o) ? '' : '<a class="jqm_link orpt" href="' . $this->createUrl('report/ajaxPlSumReport', ['path' => $path . '/' . $o->id]) . '">' . $o->name . '</a>';
						break;
					case 'j':
						$o = EdiJob::model()->findByPk($r['grp1']);
						$ext[] = empty($o) ? '' : '<a class="tab_link" href="' . $this->createUrl('ediJob/update', ['id' => $o->id]) . '" title="' . $o->no . '">' . $o->no . '</a>';
						break;
					case 'i':
						$job = EdiJob::model()->findByPk($r['grp1']);
						$inv = empty($job) ? '' : $job->invoice[count($job->invoice) - 1];
						$ext[] = empty($inv) ? '' : $inv->no;
						break;
					case 'js':
						$job = EdiJob::model()->findByPk($r['grp1']);
						$subs = '';
						if (!empty($job->mdata['sub'])) {
							foreach ($job->mdata['sub'] as $sub) {
								$subs .= '<a class="tab_link" href="' . $this->createUrl('ediJob/update', ['id' => $sub['id']]) . '" title="' . $sub['no'] . '">' . $sub['no'] . '</a> ';
							}
						}
						$ext[] = $subs;
						break;
					case 'co':
						$o = Org::model()->findByPk($r['grp2']);
						$ext[] = empty($o) ? '' : '<a class="jqm_link orpt" href="' . $this->createUrl('report/ajaxPlSumReport', ['path' => $path . '/' . $o->id]) . '">' . $o->name . '</a>';
						break;
					default:
						$ext[] = isset($r[$c]) ? $r[$c] : '';
						break;
				}
			}

			$t .= '<tr><td>' . implode('</td><td>', $ext) . '</td><td>' . AppHelper::money_format('', $r['rev']) . '</td><td>' . AppHelper::money_format('', $r['ac']) . '</td><td>' . AppHelper::money_format('', $r['at']) . '</td><td>' . AppHelper::money_format('', $r['grs']) . '</td><td>' . ($r['rev'] > 0 ? round($r['grs'] / $r['rev'] * 100, 2) . '%' : 'n/a') . '</td></tr>';

			foreach (['rev', 'grs', 'ac', 'at'] as $k) {
				$tt[$k] += $r[$k];
			}

			foreach ($extt as $k) {
				if (!isset($r[$k])) {
					continue;
				}
				$tt[$k] += $r[$k];
			}
		}

		$fes = [];
		array_shift($cs);
		foreach ($cs as $c => $h) {
			if (isset($tt[$c])) {
				$fes[] = $tt[$c];
			} elseif (isset($extt[$c]) && preg_match('/^=/', $extt[$c])) {
				eval('$fes[] = sprintf("%.3f", ' . preg_replace('/([^\(\)\*\/\+\-]+)/', '\$tt[\'\\1\']', substr($extt[$c], 1)) . ');');
			} else {
				$fes[] = '&nbsp;';
			}
		}

		echo $t . '</tbody><tfoot><tr><td align="right"><b>Total</b></td><td>' . implode('</td><td>', $fes) . '</td><td>' . AppHelper::money_format('', $tt['rev']) . '</td><td>' . AppHelper::money_format('', $tt['ac']) . '</td><td>' . AppHelper::money_format('', $tt['at']) . '</td><td>' . AppHelper::money_format('', $tt['grs']) . '</td><td>' . ($tt['rev'] > 0 ? round($tt['grs'] / $tt['rev'] * 100, 2) . '%' : 'n/a') . '</td></tfoot></table></div>';

		if ($c == 'j') {
			echo '<a class="ajax-link" href="' . Yii::app()->createUrl('report/pLReportExport', explode('/', $path)) . '" target="_blank">Export</a>';
		}
	}

	public function _ajaxPLWeightchart($rs, $cs, $path, $extt = [])
	{
		$t = '<div class="grid-view"><table class="items"><thead><tr><th>' . implode('</th><th>', $cs) . '</th><th>Dispersion_Percentage</th></tr></thead><tbody>';
		$i = 0;
		$tt = ['rev' => 0, 'grs' => 0, 'ac' => 0, 'at' => 0];
		foreach ($rs as $r) {
			$ext = [];
			foreach ($cs as $c => $h) {
				switch ($c) {
					default:
						$ext[] = isset($r[$h]) ? $r[$h] : '';
						break;
				}
			}

			$t .= '<tr><td>' . implode('</td><td>', $ext) . '</td><td>' . AppHelper::money_format('', $r['Dispersion_Percentage']) . '%</td></tr>';
		}

		$fes = [];
		array_shift($cs);
		foreach ($cs as $c => $h) {
			if (isset($tt[$c])) {
				$fes[] = $tt[$c];
			} elseif (isset($extt[$c]) && preg_match('/^=/', $extt[$c])) {
				eval('$fes[] = sprintf("%.3f", ' . preg_replace('/([^\(\)\*\/\+\-]+)/', '\$tt[\'\\1\']', substr($extt[$c], 1)) . ');');
			} else {
				$fes[] = '&nbsp;';
			}
		}

		echo $t . '</tbody></table></div>';
	}
	
	public function ajaxPlSumReport_0($pt, $path)
	{
		$reportService = new ReportService();
		$dp = sizeof($pt);
		if ($dp == 6) {
			echo 
				'<li><p><span class="exp" data-path="' . $path . '/clt" data-loaded="0"></span> By Client</p><ul></ul></li>
				<li><p><span class="exp" data-path="' . $path . '/cor" data-loaded="0"></span> By Courier</p><ul></ul></li>';
		} else {
			if ($pt[6] == 'clt') {
				$rs = $this->_plQuery($pt, '', 'org_id', 'rev DESC');
				$c1 = ['o' => 'Client'];
			} elseif ($pt[6] == 'cor') {
				$rs = $this->_plQuery($pt, '', 'grp2', 'rev DESC');
				$c1 = ['co' => 'Courier'];
			}

			$this->_ajaxPLchart($rs, $c1, $path);
		}
	}

	public function ajaxPlSumReport_10($pt, $path)
	{
		$reportService = new ReportService();
		$dp = sizeof($pt);
		if ($dp == 6) {
			echo '<li><p><span class="exp" data-path="' . $path . '/csl" data-loaded="0"></span> By Consol.</p><ul></ul></li>
				<li><p><span class="exp" data-path="' . $path . '/clt" data-loaded="0"></span> By Client</p><ul></ul></li>
				<li><p><span class="exp" data-path="' . $path . '/cor" data-loaded="0"></span> By Courier</p><ul></ul></li>
				<li><p><span class="exp" data-path="' . $path . '/zo" data-loaded="0"></span> By zone</p><ul></ul></li>
				<li><p><span class="exp" data-path="' . $path . '/we" data-loaded="0"></span> By weight</p><ul></ul></li>';
		} else {
			if ($pt[6] == 'csl') {
				$rs = $this->_plQuery($pt, '', 'grp1');
				foreach ($rs as $i => $r) {
					$c = Consol::model()->findByPk($r['grp1']);
					$rs[$i]['c1'] = @$c->no;
				}
				$c1 = ['c1' => 'Consol.'];
			} elseif ($pt[6] == 'clt') {
				$rs = $this->_plQuery($pt, '', 'org_id', 'rev DESC');
				$c1 = ['o' => 'Client'];
			} elseif ($pt[6] == 'cor') {
				$rs = $this->_plQuery($pt, '', 'grp2', 'rev DESC');
				$c1 = ['co' => 'Courier'];
			} elseif ($pt[6] == 'zo') {
				$rs = $reportService->_plWeightQuery($pt, '', 'zone', 'rev DESC');
				$c1 = ['co' => 'Zone'];
			} elseif ($pt[6] == 'we') {
				$rs = $reportService->_plWeightQuery($pt, '', 'weight', 'rev DESC');
				$c1 = ['co' => 'Weight_Step'];
			}

			if ($pt[5] == 'zo' || $pt[5] == 'we') {
				$this->_ajaxPLWeightchart($rs, $c1, $path);
			} else {
				$this->_ajaxPLchart($rs, $c1, $path);
			}
		}
	}


