	public function actionGetWareHouseReminder($dpt_id){
		$mhbns = "SORTHELD";

		$srtlDepot = Org::model()->findByPk($dpt_id)->name;
		$model = new ImParcel('search');//mhbns
		$model->unsetAttributes();
		$model->ot_id = null;
		$arrLeft = ReportService::getSortHeldReminder();
		$temp =[];
			if(!empty($arrLeft)){
				if($dpt_id==Org::TLA_DEPARTMENT_SYDNEY){
					$temp = $arrLeft['SYD'];
				}elseif($dpt_id==Org::TLA_DEPARTMENT_MELBOURNE){
					$temp = $arrLeft['MEL'];
				}elseif($dpt_id==Org::TLA_DEPARTMENT_BRISBANE){
					$temp = $arrLeft['BNE'];
				}
				foreach($temp as $ref => $data){
					$mhbns .= ",".$ref;
				}
			}
			$model->mhbns = rtrim($mhbns, ',');
			$this->render('list', [
				'model'=>$model,
				'depot'=>$srtlDepot,
				'modelType'=>'WHRR',
			]);
	}

	public function actionCargoProcessReport(){
		$model=new CargoProcess('search');
		$model->unsetAttributes();  // clear any default values
		if (isset($_GET["CargoProcess"])) {
			$model->attributes=$_GET["CargoProcess"];
			$model->skipPickUp = 1;
			$model->status = 100;
		}else{
			$model->ref = "searching";
			$model->skipPickUp = 1;
			$model->status = 100;
		}
		if(!empty($_GET["reCalculate"])){
			$boolRe = 1;
		}else{
			$boolRe = 0;
		}
		$this->render('cargoprocess_summary_report', [
			'model'=>$model,
			'modelType'=>'Cargo_Porcess',
			'isReCalculate' => $boolRe
		]);
	}

	public function actionCargoProcessReportExport(){
		$model=new CargoProcess('search');
		$model->unsetAttributes();
		if (isset($_POST["CargoProcess"])) {
			$model->attributes=$_POST["CargoProcess"];
			$model->skipPickUp = 1;
			$model->status = 100;
			$dataProviders = $model->search(true, 100, false, true, null, null);
			$resp = '<span>No records finded.<span>';
			$rs = CargoProcess::model()->findAll($dataProviders->getCriteria());
			if(!empty($rs)){
				$xls = new oExcel;
				$i = 1;
				$xls->setColWidth(array(30,30, 30, 15, 15, 15, 15, 15, 15, 10, 15, 15, 15, 15, 20, 30, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15,15));
				$xls->addRow($i++, array('Consol','Connote', 'Ref', 'Agent Id', 'Depot', 'Type', 'Postcode', 'Weight','Pkg', 'Volumn', 'Job Name', 'Release Date', 'Complate Date', 'Days', 'Effective Delivery', 'Driver', 'System Cost', 'Supplier Cost', 'ChargeCode', 'Revenue', 'Revenue Base', 'MHCharge', 'OSCharge','RECharge','LevyCharge','FuelCharge','OT','Paid Rev'));
				foreach($rs as $r){
					$consolNo = !empty($r->shipment->consol->no)?$r->shipment->consol->no:"";
					$hbn = $r->shipment->hbn;
					$ref = $r->getRef();
					$agent_id = $r->shipment->agent_id;
					$depot = $r->getDepot();
					$type = $r->getCargoTypeName();
					$postcode = !empty($r->shipment->cnee->postcode)? $r->shipment->cnee->postcode:"";
					$weight = !empty($r->getWeight())?$r->getWeight():0;
					$pkg = !empty($r->getPackages())?$r->getPackages():0;
					$cbm = !empty($r->shipment->cbm)?$r->shipment->cbm:0;
					$job = !empty($r->job_relation->job->job_name)? $r->job_relation->job->job_name:"";
					$staDate = $r->started;
					$endDate = !empty($r->comp_date)?$r->comp_date:"";
					$daydiff = $r->getDateDiff();
					$effectiveDate = $r->isGoodDelivery();
					$driver = $r->getDriver();
					if($_POST['reCalculate']){
						$sysCost = $r->getCargoProcessFeeReCal();
						$revenue = $r->getCargoProcessRevenueFeeReCal();
					}else{
						$sysCost = $r->getCargoProcessFee();
						$revenue = $r->getCargoProcessRevenueFee();
					}
					$suppCost = $r->getSupplierCost();
					$chargeCode = $r->getChargeCode();
					$base = $r->getSystemRevenueBase();
					$MHcharge = $r->getMHCharge();
					$OScharge = $r->getOSCharge();
					$REcharge = $r->getRECharge();
					$Levycharge = $r->getLevyCharge();
					$Fuelcharge = $r->getFuelCharge();
					$systemOt = $r->getSystemOt();
					$paidInvoice = $r->getPaidInvoice(); 
					
					$xls->addRow($i++, [$consolNo,$hbn,$ref,$agent_id,$depot,$type,$postcode,$weight,$pkg,$cbm,$job,$staDate,$endDate,$daydiff,$effectiveDate,$driver,$sysCost,$suppCost,$chargeCode,$revenue,$base,$MHcharge,$OScharge,$REcharge,$Levycharge,$Fuelcharge,$systemOt,$paidInvoice]);
					//$xls->addRow($i++, [$consolNo,$hbn,$ref,$agent_id,$depot,$type,$postcode,$weight,$pkg,$cbm,$job,$staDate,$endDate,$daydiff,$driver,$sysCost,$suppCost,$chargeCode,$revenue]);
				}
				//$xls->output('Cargo Process Report ' . date("Y-m-d H:i:s") . '.xlsx');
				$tempfile = Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR.'Cargo Process Report.xlsx';
				$xls->output($tempfile, null, false);
				$dlUrl =  $this->createUrl('report/downloadTmcResult');
				$resp = '<span>File is ready , Please <a href="'.$dlUrl.'" target="_blank">click me</a> to download now<span>';
			}
		}
		echo $resp;
	}

	public function actionDownloadTmcResult()
	{
		$xls = new oExcel;
		$mfn = 'Cargo Process Report';
		$tempfile = Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR.$mfn.'.xlsx';
		$xls->load($tempfile);
		$xls->output($mfn.'.xlsx');
	}

