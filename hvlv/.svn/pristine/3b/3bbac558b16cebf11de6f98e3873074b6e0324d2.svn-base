		foreach ($c->shipments as $p) {
			$p->altGoods();
			$typ = $p->goodsType();
			$ln = $p->getLastLog();
			$weight = $p->chargeWeight();
			$rate = $p->getAgentRate();
			$cost = round($p->getCost() / $c->exrate * 100) / 100;
			$xls->addRow($i++, [$p->hbn, $p->ref, empty($p->mdata['ref1']) ? '' : $p->mdata['ref1'], $p->getAwb(), empty($p->agent) ? '' : $p->agent->name, $weight, $typ, $p->calTariff($c->poc)]);
