	public function actionByCostDetail($org_id, $from, $to)
	{
		$criteria = new CDbCriteria;

		$criteria->addCondition("t.eta >= '" . $from . "'");
		$criteria->addCondition("t.eta <= '" . $to . "'");
		$criteria->addCondition("t.status < 100");
		$criteria->addCondition("t.owner_id != 114"); // remove pca express owner which is for WMS 3PL local dilivery
		$criteria->addInCondition('type', [15, 70, 80]);
		$consols = Consol::model()->findAll($criteria);
		$consols = $this->consolFilter($consols);
		$provide = [];
		foreach ($consols as $con) {
			$sql = 'SELECT * FROM hvlv_db.billing_line WHERE billing_ref = :no AND status != 11 AND accrual_amount > 0 AND org_id = :org_id UNION SELECT * FROM hvlv_top.billing_line WHERE billing_ref = :no AND status != 11 AND accrual_amount > 0 AND org_id = :org_id';
			$rs = Yii::app()->db->createCommand($sql)->bindValues([':no' => $con->no, ':org_id' => $org_id])->queryAll();
			foreach ($rs as $r) {
				if (empty($provide[$r['billing_ref']])) {
					$provide[$r['billing_ref']] = ['id' => $r['billing_ref'], 'consol' => $r['billing_ref'], 'accrual' => 0, 'consol_ids' => [], 'invoice_payable' => 0];
				}

				$provide[$r['billing_ref']]['accrual'] += $r['accrual_amount'];

				// old billing actual
				if ($r['actual_amount'] > 0) {
					$sql = 'SELECT * FROM hvlv_db.supplier_invoice WHERE inv_no = :no UNION SELECT * FROM hvlv_top.supplier_invoice WHERE inv_no = :no';
					$si = Yii::app()->db->createCommand($sql)->bindValues([':no' => $r['billing_cref']])->queryAll();
					if (empty($si)) {
						$provide[$r['billing_ref']]['invoice_payable'] += $r['actual_amount'];
					}
				}
			}
		}
		$temp = [];
		foreach ($consols as $consol) {
			$temp[] = $consol->id;
		}
		$invoice_payable = Billing::getPayableFromSiReconcile($org_id, $temp, true);
		foreach ($provide as $consol => $line) {
			foreach ($invoice_payable as $item) {
				if ($item['consol_no'] == $consol) {
					$provide[$consol]['invoice_payable'] += $item['payable'];
				}
			}
			$provide[$consol]['invoice_payable / accrual'] = number_format($provide[$consol]['invoice_payable'] / $provide[$consol]['accrual'] * 100, 2, '.', '') . '%';
			$con = Consol::model()->find('no = :no', [':no' => $consol]);
			if (preg_match('/DmawbConsol/', get_class($con))) {
				$provide[$consol]['consol'] = '<a href="' . Yii::app()->createUrl('dmawbConsol/updateByNo', ['no' => $consol]) . '" class="tab_link">' . $consol . '</a>';
			} else if (preg_match('/ElmsConsol/', get_class($con))) {
				$provide[$consol]['consol'] = '<a href="' . Yii::app()->createUrl('elmsConsol/updateByNo', ['no' => $consol]) . '" class="tab_link">' . $consol . '</a>';
			} else {
				$provide[$consol]['consol'] = '<a href="' . Yii::app()->createUrl('imcoConsol/updateByNo', ['no' => $consol]) . '" class="tab_link">' . $consol . '</a>';
			}
		}
		foreach ($provide as $org_id => $line) {
			foreach ($provide[$org_id] as $key => $value) {
				if (in_array($key, ['accrual', 'invoice_payable', 'dispute', 'confirm_payable'])) {
					$provide[$org_id][$key] = '<div style="width: 100%; text-align: right">' . AppHelper::money_format('%i', $value) . '</div>';
				} else if (in_array($key, ['invoice_payable / accrual'])) {
					$provide[$org_id][$key] = '<div style="width: 100%; text-align: right">' . $value . '</div>';
				}
			}
		}
		$provide = array_values($provide);
		$sortAttributes = ['consol' => 'consol', 'accrual' => 'accrual', 'invoice_payable' => 'invoice_payable', 'invoice_payable / accrual' => 'invoice_payable / accrual'];
		$sortNumberAttributes = ['consol' => 'consol', 'accrual' => 'accrual', 'invoice_payable' => 'invoice_payable', 'invoice_payable / accrual' => 'invoice_payable / accrual'];
		$reportService = new ReportService();
		$filtersForm = new FiltersForm;

		$filteredData = $filtersForm->filter($provide);
		$dataprovider = new CArrayDataProvider($filteredData);
		$dataprovider->pagination = false;
		$sort = new CSort();
		$sortAttr = [];
		foreach ($sortAttributes as $tempAttribute) {
			$sortAttr[$tempAttribute] = ['asc' => $tempAttribute . ' ASC', 'desc' => $tempAttribute . ' DESC'];
		}
		$sort->attributes = $sortAttr;
		$sort->defaultOrder = 'eta DESC';
		$dataprovider->sort = $sort;

		$this->renderPartial('im_pl_rpt_details', ['model' => $dataprovider, 'filter' => $filtersForm, 'attributes' => $sortAttributes]);
	}

	public function actionImCourierReport()
	{
		$this->render('im_courier_report');
	}

	public function actionAjaxImCourierReport()
	{
		$wid = 0;
		$filtersForm1 = new FiltersForm;
		$filtersForm2 = new FiltersForm1;
		$provide = [];
		$type = isset($_GET['type']) ? $_GET['type'] : 1;
		if (isset($_GET['FiltersForm'])) {
			$filtersForm1->filters = $_GET['FiltersForm'];
		}
		$dateFrom = isset($_GET['datefrom']) ? $_GET['datefrom'] : '';
		$dateTo = isset($_GET['dateto']) ? $_GET['dateto'] : '';
		$orgId = isset($_GET['courier']) ? $_GET['courier'] : '';
		$clientId = isset($_GET['org_id']) ? $_GET['org_id'] : '';
		$wid = isset($_GET['wid']) ? $_GET['wid'] : '';
		$type = isset($_GET['type']) ? $_GET['type'] : '';
		$openStateRowKeys_manifested = !empty($_GET['openStateRowKeys_manifested']) ? $_GET['openStateRowKeys_manifested'] : false;
		$openStateRowKeys_delivered = !empty($_GET['openStateRowKeys_delivered']) ? $_GET['openStateRowKeys_delivered'] : false;
		if (!empty($openStateRowKeys_manifested)) {
			$openStateRowKeys_manifested = explode(';', $openStateRowKeys_manifested);
		}
		if (!empty($openStateRowKeys_delivered)) {
			$openStateRowKeys_delivered = explode(';', $openStateRowKeys_delivered);
		}

		if ($type == 1) {
			$report1 = $this->getCourierReport($filtersForm1, $dateFrom, $dateTo, $orgId, $clientId, $wid, 'manifested', $openStateRowKeys_manifested); //for getting the manifested report
			$report2 = $this->getCourierReport($filtersForm2, $dateFrom, $dateTo, $orgId, $clientId, $wid, 'delivered', $openStateRowKeys_delivered); //for getting the delivered report

			$this->renderPartial('im_courier_report_partial', ['dataProvider' => ['manifested' => $report1[0], 'delivered' => $report2[0]], 'attributes' => ['manifested' => $report1[1], 'delivered' => $report2[1]], 'filter' => ['manifested' => $filtersForm1, 'delivered' => $filtersForm2], 'labels' => ['manifested' => "Manifest Report", 'delivered' => "Delivery Report"]], false, true);
		} else if ($type == 2) {
			$report1 = $this->getCourierReport($filtersForm1, $dateFrom, $dateTo, $orgId, $clientId, $wid, 'rts'); //for getting the rts report

			$this->renderPartial('im_courier_report_partial', ['dataProvider' => ['rts' => $report1[0]], 'attributes' => ['rts' => $report1[1]], 'filter' => ['rts' => $filtersForm1], 'labels' => ['rts' => "RTS Report"]], false, true);
		}
	}

	public function actionAjaxExportImCourierReport()
	{
		$wid = 0;
		$filtersForm1 = new FiltersForm;
		$filtersForm2 = new FiltersForm1;
		$provide = [];
		$type = isset($_GET['type']) ? $_GET['type'] : 1;
		if (isset($_GET['FiltersForm'])) {
			$filtersForm->filters = $_GET['FiltersForm'];
		}
		$dateFrom = isset($_GET['datefrom']) ? $_GET['datefrom'] : '';
		$dateTo = isset($_GET['dateto']) ? $_GET['dateto'] : '';
		$orgId = isset($_GET['courier']) ? $_GET['courier'] : '';
		$clientId = isset($_GET['org_id']) ? $_GET['org_id'] : '';
		$wid = isset($_GET['wid']) ? $_GET['wid'] : '';
		$type = isset($_GET['type']) ? $_GET['type'] : '';
		$exportState = isset($_GET['exportState']) ? true : false;

		if ($type == 3) {
			$report = $this->getCourierReport($filtersForm1, $dateFrom, $dateTo, $orgId, $clientId, $wid, 'manifest_report', false, $exportState);
			$xls = new oExcel;
			$i = 1;
			$xls->addRow($i++, array_keys($report[0]));
			foreach ($report as $key => $row) {
				$xls->addRow($i++, $row);
			}
			$tempfile = Yii::app()->basePath . DIRECTORY_SEPARATOR . "runtime" . DIRECTORY_SEPARATOR . 'im_courier_report_result.xlsx';
			$xls->output($tempfile, null, false);
			echo $this->createUrl('report/downloadImCourierReportResult');
			return;
		}

		$report1 = $this->getCourierReport($filtersForm1, $dateFrom, $dateTo, $orgId, $clientId, $wid, 'manifested', false, $exportState); //for getting the manifested report
		$report2 = $this->getCourierReport($filtersForm2, $dateFrom, $dateTo, $orgId, $clientId, $wid, 'delivered', false, $exportState); //for getting the delivered report
		$report3 = $this->getCourierReport($filtersForm1, $dateFrom, $dateTo, $orgId, $clientId, $wid, 'rts'); //for getting the rts report

		$xls = new oExcel;
		$reports = ["Shipments Manifested Report" => $report1, "Shipments Delivered Report" => $report2, "Shipments Rts Report" => $report3];
		$i = 1;
		$xls->addRow($i++, ["From Date", $dateFrom, "To Date", $dateTo]);
		if (!empty($orgId)) {
			$orgName = @Org::model()->findByPk($orgId)->name;
			$xls->addRow($i++, ["Courier:", $orgName]);
		} else {
			$xls->addRow($i++, ["All Courier"]);
		}

		foreach ($reports as $key => $report) {
			$xls->addRow($i++, []);
			$xls->addRow($i++, []);
			$xls->addRow($i++, [$key]);
			$insertData = [];
			foreach ($report[1] as $key1 => $value) {
				$insertData[] = $key1;
			}
			$xls->addRow($i++, $insertData);
			$reportData = $report[0]->rawData;
			foreach ($reportData as $key1 => $data) {
				$insertData = [];
				if (isset($data['state']) && $data['state'] != 'TOTAL') {
					$data['name'] = "";
				} else if (isset($data['state']) && $data['state'] == 'TOTAL') {
					$xls->addRow($i++, []);
				}
				foreach ($data as $key2 => $dataValue) {
					if ($key2 != "id") {
						$insertData[] = $dataValue;
					}
				}
				$xls->addRow($i++, $insertData);
			}
		}

		$tempfile = Yii::app()->basePath . DIRECTORY_SEPARATOR . "runtime" . DIRECTORY_SEPARATOR . 'im_courier_report_result.xlsx';

		$xls->output($tempfile, null, false);
		echo $this->createUrl('report/downloadImCourierReportResult');
	}

	private function getCourierReport(&$filtersForm, $dateFrom, $dateTo, $orgId, $clientId, $dptId, $type = '', $openStateRowKeys = false, $export = false)
	{
		$cacheKey = $dateFrom . $dateTo . "o" . $orgId . "c" . $clientId . "d" . $dptId . $type;
		if (empty($openStateRowKeys)) {
			$openStateRowKeys = [];
		}

		$typeStrC = "";
		$typeStrCg = "";
		$provide = [];
		$attributes = [];
		if ($dateFrom == '' || $dateTo == '') {
			return [$provide, $attributes];
		}
		$orgStr = '';
		if (!empty($orgId)) {
			$orgStr = " t.org_id ={$orgId} and ";
		}
		$depotStr = '';
		if (!empty($dptId)) {
			$depotStr = " c.dpt_id ={$dptId} and ";
		}
		$clientStr = '';
		if (!empty($clientId)) {
			$clientStr = " agent_id ={$clientId} and ";
		}
		$criteriaStr = "{$orgStr} {$depotStr} {$clientStr}";

		if ($type == 'manifested') // this is for selecting the manifested report for courier report, just edit the eta filtering time and org_id
		{
			// this sql is so complecated, it can be devided as 4 part
			$sql = "SELECT o.name,t.state,quantity,d1 as d1,d2 as d2, d3 as d3, d4 as d4, d5 as d5 from (
					select agent_id,state,count(1) as quantity, sum(IF(day1<=1,1,0)) as d1,sum(IF(day1<=2,1,0)) as d2,sum(IF(day1<=3,1,0)) as d3,sum(IF(day1>3,1,0)) as d4
					,sum(IF(day1 is null,1,0)) as d5
					FROM
					(select (to_days(tr.dt)-to_days(tra.dt)) as day1,s.agent_id,a.state from consol c
					join shipment s on c.id = s.consol_id
					join addr a on s.cnee_id = a.id
					join tranship t on s.id = t.pid
					join tracking tra on tra.pid = s.id and tra.type = 61
					left join (select * from (select tra.*,row_number() over (partition by pid order by dt) as rownum from tracking tra left join tranship tt on tra.pid =tt.pid where tra.type = 70 and (depot != '' or (activity = 'In transit' and tt.org_id = 858)) and activity not like '%information has been approved%') t where rownum = 1) tr on tr.pid = s.id
					where {$criteriaStr} s.type = 10 and c.eta<='{$dateTo}' and c.eta>='{$dateFrom}' and c.no not like '3PL%' and c.awb not like 'RTS%' and ((to_days(tr.dt)-to_days(tra.dt)) > -1 or (to_days(tr.dt)-to_days(tra.dt)) is null) group by s.id) as r group by r.agent_id,r.state) t join org o on agent_id = o.id";

			$attributes = ["client name" => "name", "state" => "state", "packages" => 'quantity', '<=1' => 'd1', '<=2' => 'd2', '<=3' => 'd3', '>3' => 'd4', 'not manifested' => 'd5'];

		} elseif ($type == 'delivered') {
			// this sql is so complecated, it can be devided as 4 part, but if you would like to edit it, just edit the eta filtering time and org_id
			$sql = "SELECT o.name,t.state,quantity,d1 as d1,d2 as d2, d3 as d3, d4 as d4,d5 as d5,
				d6 as d6 ,d7 as d7,d8 as d8
				,d9 as d9 ,d10 as d10 ,d11 as d11 ,d12 as d12 ,d13 as d13 ,d14 as d14
				from (
				select agent_id,state,count(1) as quantity,
				sum(IF(day1<=2,1,0)) as d1,sum(IF(day1<=3,1,0)) as d2,sum(IF(day1<=4,1,0)) as d3,sum(IF(day1<=5,1,0)) as d4 ,sum(IF(day1<=6,1,0)) as d5,sum(IF(day1<=7,1,0)) as d6,sum(IF(day1<=8,1,0)) as d7
				,sum(IF(day1<=9,1,0)) as d8 ,sum(IF(day1<=10,1,0)) as d9 ,sum(IF(day1<=11,1,0)) as d10,sum(IF(day1<=13,1,0)) as d11,sum(IF(day1<=15,1,0)) as d12,sum(IF(day1>15,1,0)) as d13
				,sum(IF(day1 is null,1,0)) as d14

				from (
				select (to_days(trd.dt)-to_days(tr.dt)) as day1,s.agent_id,a.state from consol c
				join shipment s on c.id = s.consol_id
				join addr a on s.cnee_id = a.id
				join tranship t on s.id = t.pid
				join (select * from (select tra.*,row_number() over (partition by pid order by dt) as rownum from tracking tra left join tranship tt on tra.pid =tt.pid where tra.type = 70 and (depot != '' or (activity = 'In transit' and tt.org_id = 858)) and activity not like '%information has been approved%') t where rownum = 1) tr on tr.pid = s.id
				left join tracking trd on trd.pid = s.id and trd.type = 70 and trd.activity like '%elivered%'
				where {$criteriaStr}  s.type = 10 and c.eta<='{$dateTo}' and c.eta>='{$dateFrom}' and c.no not like '3PL%' and c.awb not like 'RTS%' and ((to_days(trd.dt)-to_days(tr.dt)) > -1 or (to_days(trd.dt)-to_days(tr.dt)) is null ) group by s.id ) as r group by r.agent_id,r.state) t join org o on agent_id = o.id";

			$attributes = ["client name" => "name", "state" => "state", "packages" => 'quantity', '<=2' => 'd1', '<=3' => 'd2', '<=4' => 'd3', '<=5' => 'd4', '<=6' => 'd5', '<=7' => 'd6', '<=8' => 'd7', '<=9' => 'd8', '<=10' => 'd9', '<=11' => 'd10', '<=13' => 'd11', '<=15' => 'd12', '>15' => 'd13', 'not delivered' => 'd14'];
		} elseif ($type == 'rts') {
			// this sql is so complecated, it can be devided as 4 part, but if you would like to edit it, just edit the eta filtering time and org_id
			$sql = "SELECT  o.name, quantity, rated as rts_quantity, rated/quantity as rated from (
					select agent_id,count(1) as quantity, sum(IF(lid is null,0,1)) as rated
					FROM
					(
					select l.id as lid,s.agent_id from consol c
					join shipment s on c.id = s.consol_id
					join tranship t on s.id = t.pid
					left join (select * from (select *,row_number() over (partition by lid order by time desc) as rownum from log where JSON_VALUE(meta, '$.status') like '%RTS Received%' and model = 'ImParcel') t where rownum = 1) l on l.lid = s.id
					where {$criteriaStr} s.type = 10 and c.eta<='{$dateTo}' and c.eta>='{$dateFrom}' and c.no not like '3PL%' and c.awb not like 'RTS%' group by s.id ) as r group by r.agent_id ) t join org o on agent_id = o.id";

			$attributes = ["client name" => "name", "packages" => 'quantity', "RTS packages" => 'rts_quantity', 'rate' => 'rated'];
		} elseif ($type == 'manifest_report') {
			$manifests = Manifest::model()->findAll("fwd_id = :org_id and type = 90 and to_days(created) >= to_days('" . $dateFrom . "') and to_days(created) <= to_days('" . $dateTo . "')", [":org_id" => $orgId]);
			$provide = [];
			foreach ($manifests as $key => $manifest) {
				$accrual = 0;
				$actual = 0;
				$pids = array_column($manifest->lines, 'fid');
				$cogs = CogsLine::model()->findAll(["condition" => "fid in (" . join(",", $pids) . ") and model='ImParcel' and item_code = 'item' and accrual_amount>0 ", 'group' => 'fid']);
				foreach ($cogs as $key => $cog) {
					$actual += $cog->actual_amount;
					$accrual += $cog->accrual_amount;
				}
				$provide[] = ['AP Number' => $manifest->ref, 'created' => date("Y-m-d", strtotime($manifest->created)), 'Shipment Numbers' => count($cogs), 'accrual_amount' => $accrual, 'actual_amount' => $actual];
			}
			return $provide;
		}
		$provide = Yii::app()->cache->get($cacheKey);
		if (!empty($provide)) {
			$provide = json_decode($provide, true);
		} else {
			$provide = Yii::app()->db->createCommand($sql)->queryAll();
			Yii::app()->cache->set($cacheKey, json_encode($provide), 3000);
		}

		if ($type != 'rts') {
			$summaryProvide = [];
			foreach ($provide as $key => $value) {
				if (empty($summaryProvide[$value['name']])) {
					$summaryProvide[$value['name']] = $value;
					$summaryProvide[$value['name']]['state'] = 'TOTAL';
				} else {
					foreach ($attributes as $key2 => $attribute) {
						if (preg_match('/[d]|quantity/', $attribute)) {
							$summaryProvide[$value['name']][$attribute] += $value[$attribute];
						}
					}
				}
				if (in_array($value['name'], $openStateRowKeys) || $export) {
					$summaryProvide[$value['name'] . $value['state'] . "ssub"] = $value;
				}
			}
			ksort($summaryProvide);
			$id = 0;
			$sumData = [];
			foreach ($summaryProvide as $key => $value) {
				$value["id"] = $id++;
				$sumData[] = $value;
			}
			$provide = $sumData;
		}

		$total = ["id" => 0, "state" => "TOTAL", "name" => "TOTAL", "quantity" => 0];
		foreach ($attributes as $key => $value) {
			$total[$value] = 0;
		}

		$total["name"] = "TOTAL";
		$total["state"] = "TOTAL";
		$quantity = 0;
		$count = 0;
		foreach ($provide as $key => $value) { //because there are summary and sub are in the array together so, we need to process them by using if
			if ($value['state'] == 'TOTAL') //this means the summary data
			{
				$total['quantity'] += $value['quantity'];
				$count++;
			}

			if ($type == 'rts') {
				$total['rts_quantity'] += $value['rts_quantity'];
				foreach ($value as $key2 => $data) {
					if (preg_match('/[d]/', $key2)) {
						$provide[$key][$key2] = round($data * 100, 2) . "%";
						$total[$key2] += $data;
					}
				}
			} else //for time report
			{
				foreach ($value as $key2 => $data) {
					if (preg_match('/[d]/', $key2) && !in_array($key2, ["id"])) {
						if ($value['state'] == 'TOTAL') //for summary data
						{
							$provide[$key][$key2] = round(($data / $value['quantity']) * 100, 2) . "%";
							$total[$key2] += $data / $value['quantity'];
						} else // for sub data
						{
							$summaryData = $summaryProvide[$value['name']][$key2];

							$c = empty($summaryData) ? 0 : @round(($value[$key2] / $summaryData) * 100, 2);
							$provide[$key][$key2] = $c . "%";
						}
					}
				}
			}
		}

		foreach ($attributes as $key => $value) {
			if (preg_match('/[d]/', $value)) {
				$total[$value] = round(($total[$value] * 100) / ($count + 0.00000001), 2) . "%";
			}
		}

		$provide[] = $total;
		$filteredData = $filtersForm->filter($provide);
		$dataprovider = new CArrayDataProvider($filteredData);
		$dataprovider->pagination = ['pageSize' => 100];

		return [$dataprovider, $attributes];
	}

	public function actionAjaxImWDSumReport()
	{
		$wid = 0;
		$reportService = new ReportService();
		$filtersForm = new FiltersForm;
		$provide = [];
		if (!empty($_GET['wid'])) {
			$wid = $_GET['wid'];
		}
		$type = isset($_GET['type']) ? $_GET['type'] : 1;
		if (isset($_GET['FiltersForm'])) {
			$filtersForm->filters = $_GET['FiltersForm'];
		}
		$dateFrom = isset($_GET['datefrom']) ? $_GET['datefrom'] : '';
		$dateTo = isset($_GET['dateto']) ? $_GET['dateto'] : '';

		$selectedClientType = !empty($_GET['selectedClientType']) ? $_GET['selectedClientType'] : null;

		$criteria = new CDbCriteria;

		if (!empty($dateFrom)) {
			$criteria->addCondition("t.eta >= '" . $dateFrom . "'");
		}

		if (!empty($dateTo)) {
			$criteria->addCondition("t.eta <= '" . $dateTo . "'");
		}

		if (!empty($wid)) {
			$criteria->addCondition("t.dpt_id = '" . $wid . "'");
		}
		$criteria->addCondition("t.status < 100");
		$criteria->addCondition("t.owner_id != 114"); // remove pca express owner which is for WMS 3PL local dilivery
		$criteria->addInCondition('type', [15, 70, 80]);
		$consols = Consol::model()->findAll($criteria);
		$consols = $this->consolFilter($consols);
		if ($type == 1) {
			$provide = $reportService->sortWD($consols, $type, $selectedClientType);
			// $totalData= $this->getTotalDataByConsols($consols,"WD");
			$sortAttributes = ['No' => 'no', 'Eta' => 'eta', 'CourierWeight' => 'courierWeight', 'CustomerChargeWeight' => 'customerChargeWeight', 'WeightDiff' => 'weightDiff', 'Rate' => 'weightDiffRate'];
		} elseif ($type == 2) { //by client
			$provide = $reportService->sortWD($consols, $type, $selectedClientType);
			//$totalData= $this->getTotalDataByOthers($consols, $provide,"WD");
			$sortAttributes = ['Owner' => 'owner', 'CourierWeight' => 'courierWeight', 'CustomerChargeWeight' => 'customerChargeWeight', 'WeightDiff' => 'weightDiff', 'Rate' => 'weightDiffRate'];
		} elseif ($type == 3) { //by courier
			$provide = $reportService->sortWD($consols, $type, $selectedClientType);
			//$totalData= $this->getTotalDataByOthers($consols, $provide,"WD");
			$sortAttributes = ['Courier' => 'courier', 'CourierWeight' => 'courierWeight', 'CustomerChargeWeight' => 'customerChargeWeight', 'WeightDiff' => 'weightDiff', 'Rate' => 'weightDiffRate'];
		}

		if (!empty($_GET['export'])) {
			$xls = new oExcel;
			$i = 1;
			$xls->addRow($i++, ["From Date", "To Date"]);
			$xls->addRow($i++, ["{$dateFrom}", "{$dateTo}"]);
			$xls->addRow($i++, $sortAttributes);
			$invs = [];
			foreach ($provide as $pro) {
				if ($type == 1) {
					array_pop($pro);
				}
				array_shift($pro);
				$xls->addRow($i++, $pro);
			}

			$tempfile = Yii::app()->basePath . DIRECTORY_SEPARATOR . "runtime" . DIRECTORY_SEPARATOR . 'im_wdsum_report_result.xlsx';

			$xls->output($tempfile, null, false);
			echo $this->createUrl('report/downloadImWDSumReportResult');
			return "";
		}

		$dataprovider = $reportService->preDataProvider($filtersForm, $provide, $sortAttributes);

		$this->renderPartial('im_wd_rpt_partial', ['model' => $dataprovider, 'filter' => $filtersForm, 'attributes' => $sortAttributes], false, true);
	}

	/*
	 * @Params  array consol
	 * @return  arrray $totalData,
	 * Added by Jerry at 2018-09-16
	 */
	private function getTotalDataByConsols($consols)
	{
		$totRevenue = 0;
		$totCost = 0;
		foreach ($consols as $consol) {
			$totRevenue += $consol->getTotalInvoice();
			$totCost += $consol->totCost();
		}
		if ($totRevenue > 0) {
			$totalProfitRate = round(($totRevenue - $totCost) / $totRevenue * 10000) / 10000;
		} else {
			$totalProfitRate = 0;
		}
		$totalData = [
			'revenue' => number_format(round($totRevenue, 2), 2),
			'cost' => number_format(round($totCost, 2), 2),
			'gp' => number_format(round($totRevenue - $totCost, 2), 2),
			'profit' => ($totalProfitRate * 100) . '%',
		];
		return $totalData;
	}
	//End by Jerry at 2018-09-16
	private function getTotalDataByOthers($consols, $provide)
	{
		$totRevenue = 0;
		$totCost = 0;
		foreach ($provide as $pr) {
			if ($pr['id'] == 'total') {
				continue;
			}

			$totRevenue += $pr['revenue'];
			$totCost += floatval($pr['cost']);
		}
		if ($totRevenue > 0) {
			$totalProfitRate = round(($totRevenue - $totCost) / $totRevenue * 10000) / 10000;
		} else {
			$totalProfitRate = 0;
		}
		$totalData = [
			'revenue' => number_format(round($totRevenue, 2), 2),
			'cost' => number_format(round($totCost, 2), 2),
			'gp' => number_format(round($totRevenue - $totCost, 2), 2),
			'profit' => ($totalProfitRate * 100) . '%',
		];
		return $totalData;
	}

	/**
	 *  Filter the consol According to set rules
	 * 1. ignore revenue
	 * 2. Imconsol shipments number less than or equral 0
	 * 3  eta < 2018-03-01 and total cost equals 0
	 * @param array $consols
	 * @return array
	 * Added By Jerry at 2018-09-16
	 */
	private function consolFilter($consols, $client_id = 0)
	{
		foreach ($consols as $ci => $con) {
			if (!empty($client_id)) {
				$consols[$ci]->checkAgentId = $client_id;
			}
			if (!empty($con->mdata['ignore_revenue'])) {
				unset($consols[$ci]);
				continue;
			}
			if ($con->type == 15 && $con->totShipments() == 0) {
				unset($consols[$ci]);
				continue;
			}
			if ($con->eta < '2018-03-01' && $con->totCost() == 0) {
				unset($consols[$ci]);
				continue;
			}
		}
		return $consols;
	}

	//End By Jerry at 2018-09-16;

	/**
	 * Sort By Consols
	 * @param array $consols
	 * @return array of data provide
	 * Add by Jerry at 2018-09-16;
	 */
	private function sortByConsols($consols, $type = 0)
	{
		$provide = [];
		if (!empty($consols)) {
			foreach ($consols as $con) {
				$provide[] = ['id' => $con->id, 'consol_id' => $con->id, 'no' => $con->no, 'owner' => $con->getOwnerName(), 'eta' => $con->eta, 'type' => $con->type,
					'shipments' => $con->totShipments(), 'weight' => $con->totWeight(),
					'revenue' => $con->getTotalInvoice(), 'cost' => $con->totCost(),
					'gp' => $con->getProfitGP(), 'profit_rate' => $con->getProfitRate() * 100];
			}
		}
		return $provide;
	}

	/**
	 * Sort By Depot
	 * @param array $Depot
	 * @return array of data provide
	 * Add by Gero at 2021-08-02;
	 */
	private function sortByDepot($consols, $type = 0)
	{
		$provide = [];
		if (!empty($consols)) {
			foreach ($consols as $con) {
				if(!empty($provide[$con->dpt_id]))
				{
					$provide[$con->dpt_id]['shipments'] += $con->totShipments();
					$provide[$con->dpt_id]['shipments'] += $con->totWeight();
					$provide[$con->dpt_id]['shipments'] += $con->getTotalInvoice();
					$provide[$con->dpt_id]['shipments'] += $con->totCost();
					$provide[$con->dpt_id]['shipments'] += $con->getProfitGP();
				}else
				{
					$provide[$con->dpt_id] = ['id' => $con->dpt_id,'depot'=>Org::model()->findByPk($con->dpt_id)->name, 'consol_id' => $con->id, 'no' => $con->no, 'owner' => $con->getOwnerName(),'shipments' => $con->totShipments(), 'weight' => $con->totWeight(),'revenue' => $con->getTotalInvoice(), 'cost' => $con->totCost(),'gp' => $con->getProfitGP()];
				}
			}
		}

		foreach ($provide as $key => $value) {
			$allRevenue = $provide[$key]['revenue'] <= 0 ? 1 : $provide[$key]['revenue'];
			$profitRate = round($provide[$key]['gp'] / $allRevenue * 10000) / 10000;
			$provide[$key]['profit_rate'] = $profitRate*100;
		}
		return $provide;
	}
	//Ended By Jerry 2018-09-16;

	/**
	 * Sort by Client for import Report (type 2)
	 * @param Array $consols
	 * @return Array
	 * Modify By Gero at 2019-10-01
	 */
	private function sortByClient($consols)
	{
		$provide = [];
		$temp = [];
		$theCosnolIds = [];
		if (!empty($consols)) {
			foreach ($consols as $con) {
				$theCosnolIds[] = $con->id;
				$ownerIds = $con->getOwnerName(true);
				if ($con->type == 15 && sizeof($ownerIds) != 1) {
					$result = $con->getReportDetailBaseOnAgent();
					foreach ($result as $org_id => $detais) {
						if (key_exists($org_id, $temp)) {
							$temp[$org_id]['shipments'] += intval(@$detais['number']);
							$temp[$org_id]['weight'] += floatval(@$detais['weight']);
							$temp[$org_id]['cost'] += floatval(@$detais['cost']);
							$temp[$org_id]['revenue'] += floatval(@$detais['revenue']);
						} else {
							$temp[$org_id]['shipments'] = intval($detais['number']);
							$temp[$org_id]['weight'] = floatval(@$detais['weight']);
							$temp[$org_id]['cost'] = floatval(@$detais['cost']);
							$temp[$org_id]['revenue'] = floatval(@$detais['revenue']);
						}
					}
				} else {
					$ownerId = $ownerIds[0];
					if (key_exists($ownerId, $temp)) {
						$temp[$ownerId]['shipments'] += $con->totShipments();
						$temp[$ownerId]['weight'] += $con->totWeight();
						$temp[$ownerId]['revenue'] += $con->getTotalInvoice();
						$temp[$ownerId]['cost'] += $con->totCost();
					} else {
						$temp[$ownerId]['shipments'] = $con->totShipments();
						$temp[$ownerId]['weight'] = $con->totWeight();
						$temp[$ownerId]['revenue'] = $con->getTotalInvoice();
						$temp[$ownerId]['cost'] = $con->totCost();
					}
				}
			}

			$check1 = 0;
			$check2 = 0;
			$check3 = 0;
			foreach ($temp as $agent_id => $t) {
				$org = Org::model()->find('id=:id', [':id' => $agent_id]);
				$provide[] = ['id' => $agent_id, 'no' => '', 'owner' => empty($org->name) ? (($agent_id == 10000) ? '商壹' : '') : $org->name, 'eta' => '', 'type' => 15, 'shipments' => number_format($t['shipments'],2), 'weight' => $t['weight'],
					'revenue' => number_format($t['revenue'],2), 'cost' => number_format($t['cost'],2), 'gp' => number_format($t['revenue'] - $t['cost'],2), 'profit_rate' => number_format(($t['revenue'] - $t['cost']) / ($t['revenue'] <= 0 ? 1 : $t['revenue']) * 100,3)];
				$check1 += $t['revenue'];
				$check2 += $t['cost'];
				$check3 += $t['revenue'] - $t['cost'];
			}

		}
		return $provide;
	}

	//End Modify By Jerry 2018-09-16
	/**
	 *
	 * @param type $consols
	 * @return Array data provide.
	 *
	 * Modify By Jerry at 2018-09-16
	 */
	private function sortByCourier($consols)
	{
		$temp = [];
		$provide = [];
		if (!empty($consols)) {
			foreach ($consols as $con) {
				if (!empty($con->mdata['ignore_revenue'])) {
					continue;
				}
				// if ($con->type == 15 && $con->totShipments() == 0) {
				//     continue;
				// }
				foreach ($con->getReportDetailByCourier() as $courier_id => $detail) {
					if (key_exists($courier_id, $temp)) {
						$temp[$courier_id]['shipments'] += $detail['number'];
						$temp[$courier_id]['weight'] += $detail['weight'];
						$temp[$courier_id]['revenue'] += $detail['revenue'];
						$temp[$courier_id]['cost'] += $detail['cost'];
					} else {
						$temp[$courier_id]['shipments'] = $detail['number'];
						$temp[$courier_id]['weight'] = $detail['weight'];
						$temp[$courier_id]['revenue'] = $detail['revenue'];

						$temp[$courier_id]['cost'] = $detail['cost'];
					}
				}
			}

			$total = ['id' => 'otal', 'no' => '', 'owner' => 'Total', 'eta' => '', 'type' => 15, 'shipments' => 0, 'weight' => 0,
				'revenue' => 0, 'cost' => 0, 'gp' => 0, 'profit_rate' => 0];
			foreach ($temp as $agent_id => $t) {
				if (is_numeric($agent_id)) {
					$org = Org::model()->find('id=:id', [':id' => $agent_id]);
				} else {
					$org = new stdClass();
					$org->name = $agent_id;
				}
				$provide[] = ['id' => $agent_id, 'no' => '', 'owner' => @$org->name, 'eta' => '', 'type' => 15, 'shipments' => $t['shipments'], 'weight' => $t['weight'],
					'revenue' => $t['revenue'], 'cost' => $t['cost'], 'gp' => $t['revenue'] - $t['cost'], 'profit_rate' => ($t['revenue'] - $t['cost']) / ($t['revenue'] <= 0 ? 1 : $t['revenue']) * 100];
				$total['shipments'] += $t['shipments'];
				$total['weight'] += $t['weight'];
				$total['revenue'] += $t['revenue'];
				$total['cost'] += $t['cost'];
			}

			$total['gp'] = $total['revenue'] - $total['cost'];
			$total['profit_rate'] = ($total['revenue'] - $total['cost']) / ($total['revenue'] <= 0 ? 1 : $total['revenue']) * 100;
			$provide[] = $total;
		}
		return $provide;
	}
