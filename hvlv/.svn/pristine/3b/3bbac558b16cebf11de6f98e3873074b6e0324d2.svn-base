	/**
	 * hold agent shipments report
	 */
	public function actionHoldAgent()
	{

		// get all [client , agent , export agent , export sub-agent]
		$orgModel = new Org('search');
		$orgModel->unsetAttributes();
		$ec = new CDbCriteria;
		$ec->condition = "type IN (30,50,60,65)";
		$ec->condition .= ' AND dpt_id = ' . Org::PCAE_DEPARTMENT_SYDNEY;
		$dp = $orgModel->search(false);
		$orgs = [];
		foreach ($dp->data as $org) {
			// only save we have hold parcels org
			if ($org->creditBlock()) {
				$orgs[] = $org;
			}
		}

		$allData = [];

		// get all invoices for each org
		foreach ($orgs as $org) {
			$model = new Invoice('search');
			$model->unsetAttributes();
			$ec = new CDbCriteria;
			$ec->condition = "status IN (2,3,7)";
			$ec->condition .= ' AND dpt_id = ' . Org::PCAE_DEPARTMENT_SYDNEY . ' AND to_id = ' . $org->id;
			$dp = $model->search(false, 0, 't.due ASC', $ec);
			$invoices = [];
			$totalOverdue = 0;
			$totalShipments = 0;
			foreach ($dp->data as $r) {
				$balance = $r->getBalance();
				if ($balance <= 0) {
					continue;
				}
				$invoices[] = $r;
				$totalOverdue += $balance;
				foreach ($r->lines as $line) {

					// maybe shippments has been shipped , just invoice not paid
					// so here we need to get all shipments which are not shipped
					if (isset($line->mdata['items'])) {
						foreach ($line->mdata['items'] as $si => $sp) {
							$shipment = ExParcel::model()->find('hbn = :hbn', [':hbn' => $sp[0]]);
							if (!empty($shipment) && $shipment->status < 25) { // status before not confirmed
								$totalShipments++;
							}
						}
					}
					// $totalShipments += count($line->mdata['items']);
				}
			}

			if ($totalShipments > 0) {
				$allData[] = [
					'id' => $org->id,
					'name' => $org->name,
					'aramount' => number_format($totalOverdue, 2),
					'shipments' => $totalShipments,
				];
			}
		}

		$dp = new CArrayDataProvider($allData, [
			'id' => 'export_hold_agent_report',
			'pagination' => [
				'pageSize' => 30,
				'pageVar' => 'page',
			],
		]);

		$this->render('hold_agent', ['dp' => $dp]);
	}

	/**
	 * show hold agent inovice and shipments details
	 */
	public function actionHoldDetails()
	{
		$org = Org::model()->findByPk($_GET['id']);

		$model = new Invoice('search');
		$model->unsetAttributes();
		$ec = new CDbCriteria;
		$ec->condition = "status IN (2,3,7)";
		$ec->condition .= ' AND dpt_id = ' . Org::PCAE_DEPARTMENT_SYDNEY . ' AND to_id = ' . $org->id;
		$dp = $model->search(false, 0, 't.due ASC', $ec);

		foreach ($dp->data as $r) {
			$balance = $r->getBalance();
			if ($balance <= 0) {
				continue;
			}
			//$shipments =  '';
			$shipments = 0;
			foreach ($r->lines as $line) {
				//$parcel = ImParcel::model()->findByPk($line->fid);
				//$shipments .= '<a href="' . Yii::app()->createUrl("exParcel/update",["id" => $parcel->id]) .'">' . $parcel->hbn . '</a><br/>';
				//$shipments += count($line->mdata['items']);

				foreach ($line->mdata['items'] as $si => $sp) {
					$shipment = ExParcel::model()->find('hbn = :hbn', [':hbn' => $sp[0]]);
					if (!empty($shipment) && $shipment->status < 25) { // status before not confirmed
						$shipments++;
					}
				}
			}

			if ($shipments > 0) {
				$allData[] = [
					'id' => $r->id,
					'no' => $r->no,
					'balance' => number_format($r->getBalance(), 2),
					//  'shipments' => count($r->lines)
					'shipments' => $shipments,
				];
			}
		}

		$dp = new CArrayDataProvider($allData, [
			'id' => 'export_hold_agent_detail_report',
			'pagination' => [
				'pageSize' => 30,
				'pageVar' => 'page',
			],
		]);

		$this->render('hold_agent_detail', ['model' => $org, 'dp' => $dp]);
	}

	public function actionAccount()
	{
		if (empty($_GET['rpt'])) {
			$this->render('account');
		} elseif (in_array($_GET['rpt'], ['acc_cpl', 'acc_trf', 'acc_ddc'])) {
			$this->render('acc_consol_rpt', ['title' => $this->rpts[$_GET['rpt']][2], 'model' => new $this->rpts[$_GET['rpt']][0]('search')]);
		} else {
			$this->render('account_rpt', ['title' => $this->rpts[$_GET['rpt']][2], 'model' => new $this->rpts[$_GET['rpt']][0]('search')]);
		}
	}

	protected function exco_dthc($c, $w)
	{
		if (in_array($c->poc, ['CNPEK', 'CNCAN'])) {
			return 3 * $w;
		} elseif (in_array($c->poc, ['CNCSX'])) {
			return $w * 5.6;
		} elseif (in_array($c->poc, ['CNTA2'])) {
			return 2.6 * $w;
		} elseif (in_array($c->poc, ['CNCA3'])) {
			return (strtotime($c->created) > strtotime('2016-06-05') ? 4 : 5) * $w;
		} elseif (in_array($c->poc, ['CNXMN', 'CNXM2'])) {
			return 3 * $w;
		} else {
			return 0;
		}
	}

	protected function exco_ccc($c, $p, $w)
	{
		$tt = 0;
		if ($c->poc == 'CNPEK') {
			$tt = $p * 8;
		} elseif ($c->poc == 'CNCAN') {
			$tt = $p * 8;
		} elseif ($c->poc == 'CNKMG') {
			$tt = $w * 5.5;
			$tt += 1; //id check fee
		} elseif ($c->poc == 'CNTA2') {
			$tt = $p * 6;
		} elseif ($c->poc == 'CNCA2') {
			//$tt = $w * (8+1);
			$tt += 5.5;
		} elseif ($c->poc == 'CNTSN') {
			$tt = $w * 5.5;
		} elseif ($c->poc == 'CNJMN') {
			if (strtotime($c->created) < 1472652000) {
				$tt = $w * 2.1;
			}
		} elseif ($c->poc == 'CNCSX') {
			//$tt = $p * (1.6 + 8);
			$tt = $p * 7;
		} elseif ($c->poc == 'CNCTU') {
			//$tt = $p * (1.6 + 8);
			$tt = $w * 4;
		} elseif ($c->poc == 'CNCA3') {
			$tt = $p * 7;
		} elseif (in_array($c->poc, ['CNXMN', 'CNXM2'])) {
			$tt += $p * 4.5;
		} elseif (in_array($c->poc, ['CNCHQ'])) {
			$tt += $p * 5;
			$tt += $w * 3.5;
		}
		return $tt;
	}

	protected function exco_dcdc($c, $ctw, $ms = false, $wid = 0)
	{
		$tt = 0;
		if ($c->poc == 'HKHKG') {
			return $tt;
		}
		/*if($c->poc == 'CNXMN'){
		foreach($c->shipments as $p){
		if(!empty($wid) && $p->odpt_id != $wid) continue;
		$tq = array_sum($p->eitems['q']);
		switch($p->goodsType()){
		case 'B':
		$r = 3.5;
		if($tq == 1){
		$r = 4;
		}elseif($tq == 2){
		$r = 4.5;
		}
		break;
		case 'M':
		$r = 3.3;
		if($tq < 2){
		$r = 4.5;
		}elseif($tq < 3){
		$r = 4;
		}elseif($tq < 6){
		$r = 3.5;
		}
		break;
		case 'O':
		$r = 4.5;
		break;
		}
		$tt += $p->weight * $c->exrate * $r;
		}
		return $tt;
		}*/
		if ($c->poc == 'CNJMN') {
			if (strtotime($c->created) < 1476622800) {
				$jmrbrk = [1 => 3.5, 2 => 2.25, 3 => 1.85, 4 => 1.65, 5 => 1.5, 6 => 1.45, 7 => 1.4, 8 => 1.35, 9 => 1.3];
				foreach ($c->shipments as $p) {
					if (!empty($wid) && $p->odpt_id != $wid) {
						continue;
					}
					$spwt = $p->shipWeight();
					if ($spwt >= 10) {
						$jmr = 1.25;
					} else {
						$jmr = $jmrbrk[ceil($spwt)];
					}
					$tt += $spwt * $c->exrate * $jmr;
				}
			} else {
				foreach ($c->shipments as $p) {
					if (!empty($wid) && $p->odpt_id != $wid) {
						continue;
					}
					$spwt = $p->shipWeight();
					if ($spwt < 3 || $p->goodsType() == 'O') {
						$jmr = 2.6;
					} else {
						$jmr = 1.85;
					}
					if ($spwt < 1.5) {
						$spwt = 1.5;
					}
					$tt += $spwt * $c->exrate * $jmr;
					if (preg_match('/UGG|鞋/', implode('', $p->eitems['g']))) {
						$tt += 3 * $c->exrate;
					}
				}
			}
			return $tt;
		}
		if ($c->poc == 'CNJM2') {
			foreach ($c->shipments as $p) {
				if (!empty($wid) && $p->odpt_id != $wid) {
					continue;
				}
				$spwt = $p->shipWeight();
				if ($spwt < 3 || $p->goodsType() == 'O') {
					$jmr = 2.8;
				} else {
					$jmr = 2.05;
				}
				if ($spwt < 1) {
					$spwt = 1;
				}
				$tt += $spwt * $c->exrate * $jmr;
			}
		}
		$rnf = 0;
		if (empty($c->eta) || $c->eta == '0000-00-00') {
			$c->eta = (empty($c->etd) || $c->etd == '0000-00-00') ? $c->created : $c->etd;
		}
		if (!$ms) {
			foreach ($c->shipments as $p) {
				if (!empty($wid) && $p->odpt_id != $wid) {
					continue;
				}
				$rt = $p->rating($c->poc, $c->exrate, false, $c->eta);
				if (empty($rt)) {
					$rnf += $p->weight;
				} else {
					$tt += $rt;
				}
			}
		} else { //sub consol
			foreach ($ms as $m) {
				foreach ($m->lines as $l) {
					$p = $l->mm();
					if (!empty($wid) && $p->odpt_id != $wid) {
						continue;
					}
					$rt = $p->rating($c->poc, $c->exrate, false, $c->eta);
					if (empty($rt)) {
						$rnf += $p->weight;
					} else {
						$tt += $rt;
					}
				}
			}
		}

		if ($rnf > 0) { //apply everage rate to rate not found shipments
			if ($rnf < $ctw) {
				$tt += $tt / ($ctw - $rnf) * $rnf;
			}
		}

		return $tt;
	}

	protected function exco_tariff($c, $ms = false, $wid = 0)
	{
		if (in_array($c->poc, ['CNTAO', 'A2U', 'STO', 'CNJMN'])) {
			return 0;
		}
		$tt = 0;
		if (!$ms) {
			foreach ($c->shipments as $p) {
				if (!empty($wid) && $p->odpt_id != $wid) {
					continue;
				}
				$p->altGoods();
				$tt += $p->calTariff($c->poc);
			}
		} else { //sub consol
			foreach ($ms as $m) {
				foreach ($m->lines as $l) {
					$p = $l->mm();
					if (!empty($wid) && $p->odpt_id != $wid) {
						continue;
					}
					$p->altGoods();
					$tt += $p->calTariff($c->poc);
				}
			}
		}

		return $tt;
	}

	protected function noid($c, $ms = false, $wid = 0)
	{
		if (!in_array($c->poc, ['CNKMG', 'CNJMN'])) {
			return 0;
		}
		$tt = 0;
		if (!$ms) {
			foreach ($c->shipments as $p) {
				if (!empty($wid) && $p->odpt_id != $wid) {
					continue;
				}
				if (empty($p->cnee->cnid_id) && empty($p->cnee->cnid_no)) {
					$tt += 2;
				}
			}
		} else { //sub consol
			foreach ($ms as $m) {
				foreach ($m->lines as $l) {
					$p = $l->mm();
					if (!empty($wid) && $p->odpt_id != $wid) {
						continue;
					}
					if (empty($p->cnee->cnid_id)) {
						$tt += 2;
					}
				}
			}
		}
		return $tt;
	}

	protected function exco_frt($c, $w)
	{
		$c2p = ['CNTA2' => 'CNTAO', 'CNCA3' => 'CNCAN', 'CNJMN' => 'CNCAN', 'CNJM2' => 'CNCAN', 'CNXM2' => 'CNXMN'];
		$pod = isset($c2p[$c->pod]) ? $c2p[$c->pod] : $c->pod;
		return $w * (isset(Yii::app()->params['settings']['af_' . $c->pol . '_' . $pod]['value']) ? Yii::app()->params['settings']['af_' . $c->pol . '_' . $pod]['value'] : -1) * $c->exrate;
	}

	public function actionExport()
	{
		if ($_GET['m'] == 'shipments') {
			if ($_GET['rpt'] == 'weight') {
				return $this->weightReport();
			}
			if ($_GET['rpt'] == 'cou_par') {
				return $this->courierParcelReport();
			}
			
			$xls = new oExcel;
			$xls->setColWidth([15, 20, 10, 10, 10, 5, 20, 20, 10, 10, 5]);
			$i = 1;
			$xls->addRow($i++, [$this->rpts[$_GET['rpt']][2] . ' Shipments Report']);
			$xls->mergeCells('A1:M1');
			$xls->setFont('A1', ['bold' => true, 'size' => '20']);
			$xls->centerAlignment('A1');
			$xls->addRow($i++, ['HBN', 'Consol', 'AWB', 'Agent', 'Pkg', 'Weight', 'State', 'Post Code', 'Cnor', 'Cnee', 'Pickup', 'Departure', 'Delivery', 'Dispatch Days', 'Delivery Days']);

			$model = new $this->rpts[$_GET['rpt']][0]('search');
			$model->unsetAttributes();
			$model->attributes = $_POST[$this->rpts[$_GET['rpt']][0]];

			$criteria = new CDbCriteria;
			$criteria->compare('agent_id', $model->agent_id, false);

			if (!empty($_POST['date'])) {
				$criteria->addCondition('t.created >= :fd AND t.created < DATE_ADD(:td, INTERVAL 1 DAY)');
				$criteria->params += [':fd' => $_POST['date']['from'], ':td' => $_POST['date']['to']];
			}

			if (!empty($model->cnee_name)) {
				$with[] = 'cnee';
				$criteria->compare('cnee.name', $model->cnee_name, true);
			}

			if (!empty($model->cnor_name)) {
				$with[] = 'cnor';
				$criteria->compare('cnor.name', $model->cnor_name, true);
			}

			if (!empty($with)) {
				$criteria->with = $with;
				$criteria->together = true;
			}

			$tc = $model::model()->count($criteria);
			$criteria->limit = 500;
			$tpg = ceil($tc / $criteria->limit);

			for ($p = 0; $p < $tpg; $p++) {
				$criteria->offset = $p * $criteria->limit;
				$rs = $model::model()->findAll($criteria);

				foreach ($rs as $r) {
					$days = $r->getPerformanceDates();
					$xls->addRow($i++, ['="' . $r->hbn . '"', empty($r->consol) ? '' : $r->consol->no, empty($r->consol) ? '' : $r->getAwb(), empty($r->agent_id) ? '' : $r->agent->name, $r->pkg, $r->weight, $r->state, $r->postcode, $r->cnor->name, $r->cnee->name, $days[0], $days[1], $days[2], $days[3], $days[4]]);
				}
			}

			$xls->output(str_replace(' ', '_', $this->rpts[$_GET['rpt']][2]) . '_shipments_report' . date('Ymd') . '.xlsx');
		} elseif ($_GET['m'] == 'awbnobill') {
			// export no billing report based on awb
			$this->exportAwbNoBillReport();
		} elseif ($_GET['m'] == 'consol') {
			$dpt = 'ALL';
			if (!empty($_POST['wid'])) {
				$org = Org::model()->findByPk($_POST['wid']);
				$dpt = $org->shortName(1);
			}
			$xls = new oExcel;
			$xls->setColWidth([15, 15, 10, 10, 20, 10, 10, 10, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 10, 10, 10, 10, 10, 10, 10, 10, 10, 10, 10, 10]);
			$i = 1;
			$xls->addRow($i++, [$this->rpts[$_GET['rpt']][2] . ' Consol. Report - ' . $dpt]);
			$xls->mergeCells('A1:AE1');
			$xls->setFont('A1', ['bold' => true, 'size' => '20']);
			$xls->centerAlignment('A1');
			$rowTitle = ['Date', 'Consol#', 'POL', 'POC', 'AWB', 'ExRate', 'Weight', 'Packs', 'FRT', 'DTHC',
				'CCC', 'DCDC', 'TARIFF', 'No ID', 'Total Cost', 'Cost/KG', 'Total Rev.', 'Rev./KG', 'B Wt.', 'M Wt.', 'O Wt.', 'Mix Wt.',
				'Invoice Weight', 'Invoice Revenue', 'Channel Weight', 'Channel Qty', 'Clearance & Delivery', 'Duty', 'Others', 'Total Cost', 'Invoice Ref.'];
			$xls->addRow($i++, $rowTitle);

			$model = new $this->rpts[$_GET['rpt']][1]('search');
			$model->unsetAttributes();

			$criteria = new CDbCriteria;

			if (!empty($_POST['date'])) {
				$criteria->addCondition('t.created >= :fd AND t.created < DATE_ADD(:td, INTERVAL 1 DAY)');
				$criteria->params += [':fd' => $_POST['date']['from'], ':td' => $_POST['date']['to']];
			}

			$tc = $model::model()->count($criteria);
			$criteria->limit = 10;
			$tpg = ceil($tc / $criteria->limit);
			ob_start();
			for ($p = 0; $p < $tpg; $p++) {
				$criteria->offset = $p * $criteria->limit;
				$rs = $model::model()->findAll($criteria);
				foreach ($rs as $k => $r) {
					if (!empty($r->mdata['subc']) && sizeof($r->mdata['subc']) > 1) { //sub consols
						foreach ($r->mdata['subc'] as $sc) {
							if (empty($sc['pids'])) {
								continue;
							}
							$ms = Manifest::model()->findAll('id IN (' . $sc['pids'] . ')');
							$tw = 0;
							$tp = 0;
							foreach ($ms as $m) {
								$tw += $m->totWeight($_POST['wid']);
								$tp += $m->totPacks($_POST['wid']);
							}
							$wd = $r->weightDist($ms, $_POST['wid']);

							// based on awb number to get more statistic data
							// from consol_weight_check_line table
							$moreData = ConsolWeightCheckLine::model()->find('awb_no = :awb', [':awb' => $sc['awb']]);
							$data = [$r->created, $r->no, $r->pol, $r->getPoc(), $sc['awb'], $r->exrate, $tw, $tp, $this->exco_frt($r, $tw), $this->exco_dthc($r, $tw), $this->exco_ccc($r, $tp, $tw), $this->exco_dcdc($r, $tw, $ms, $_POST['wid']), $this->exco_tariff($r, $ms, $_POST['wid']), $this->noid($r, $ms, $_POST['wid']), '=SUM(I' . $i . ':N' . $i . ')', '=O' . $i . '/G' . $i, $r->totRevenue($ms, $_POST['wid'], true), '=Q' . $i . '/G' . $i, $wd['B'], $wd['M'], $wd['O'], $wd['X']];
							if (!empty($moreData)) {
								$data = array_merge($data, [$moreData->invoice_weight, $moreData->invoice_revenue, $moreData->channel_weight, $moreData->channel_qty, $moreData->clearance_cost, $moreData->duty, $moreData->others, $moreData->ttlCost, $moreData->invoice_ref]);
							} else {
								$data = array_merge($data, [0, 0, 0, 0, 0, 0, 0, 0, '']);
							}
							$xls->addRow($i, $data);
							$i++;
						}
					} else {
						$tw = $r->totWeight($_POST['wid']);
						$tp = $r->totShipments($_POST['wid']);
						$wd = $r->weightDist(false, $_POST['wid']);
						if (empty($tp)) {
							continue;
						}

						// based on awb number to get more statistic data
						// from consol_weight_check_line table
						$moreData = ConsolWeightCheckLine::model()->find('awb_no = :awb', [':awb' => $r->awb]);
						$data = [$r->created, $r->no, $r->pol, $r->getPoc(), $r->allAwb(), $r->exrate, $tw, $tp, $this->exco_frt($r, $tw), $this->exco_dthc($r, $tw), $this->exco_ccc($r, $tp, $tw), $this->exco_dcdc($r, $tw, false, $_POST['wid']), $this->exco_tariff($r, false, $_POST['wid']), $this->noid($r, $ms, $_POST['wid']), '=SUM(I' . $i . ':N' . $i . ')', '=O' . $i . '/G' . $i, $r->totRevenue(false, $_POST['wid'], true), '=Q' . $i . '/G' . $i, $wd['B'], $wd['M'], $wd['O'], $wd['X']];
						if (!empty($moreData)) {
							$data = array_merge($data, [$moreData->invoice_weight, $moreData->invoice_revenue, $moreData->channel_weight, $moreData->channel_qty, $moreData->clearance_cost, $moreData->duty, $moreData->others, $moreData->ttlCost, $moreData->invoice_ref]);
						} else {
							$data = array_merge($data, [0, 0, 0, 0, 0, 0, 0, 0, '']);
						}

						$xls->addRow($i, $data);

						$i++;
					}
				}
			}
			$err = ob_get_contents();
			ob_end_clean();
			$j = $i - 1;
			$xls->addRow($i, ['', 'Total', '', '', '', '', '=SUM(G3:G' . $j . ')', '=SUM(H3:H' . $j . ')', '=SUM(I3:I' . $j . ')', '=SUM(J3:J' . $j . ')', '=SUM(K3:K' . $j . ')', '=SUM(L3:L' . $j . ')', '=SUM(M3:M' . $j . ')', '=SUM(N3:N' . $j . ')', '=SUM(I' . $i . ':N' . $i . ')', '=O' . $i . '/G' . $i, '=SUM(Q3:Q' . $j . ')', '=Q' . $i . '/G' . $i, '=SUM(S3:S' . $j . ')', '=SUM(T3:T' . $j . ')', '=SUM(U3:U' . $j . ')',
				'=SUM(V3:V' . $j . ')', '=SUM(W3:W' . $j . ')', '=SUM(X3:X' . $j . ')', '=SUM(Y3:Y' . $j . ')', '=SUM(Z3:Z' . $j . ')', '=SUM(AA3:AA' . $j . ')', '=SUM(AB3:AB' . $j . ')', '=SUM(AC3:AC' . $j . ')', '=SUM(AD3:AD' . $j . ')', '=SUM(AE3:AE' . $j . ')']);

			$xls->addRow($i++, []);
			if (!empty($err)) {
				$ls = explode("\n", $err);
				foreach (array_unique($ls) as $l) {
					$xls->addRow($i++, [$l]);
				}
			}
			$xls->output(str_replace(' ', '_', $this->rpts[$_GET['rpt']][2]) . '_consol_report_' . $dpt . '_' . date('Ymd') . '.xlsx');
		} elseif ($_GET['m'] == 'account') {
			if (method_exists($this, $_GET['rpt'])) {
				$this->{$_GET['rpt']}();
			}
		} elseif ($_GET['m'] == 'bondstorage') {
			$this->bondStorageReport();
		} elseif ($_GET['m'] == 'dataentry') {
			$this->dataEntryReport();
		} elseif ($_GET['m'] == 'priority') {
			$this->exportPriority();
		} elseif ($_GET['m'] == 'priority2') {
			$this->exportPriority2();
		} elseif ($_GET['m'] == 'billingline0') {
			$this->exportBillingline0();
		} elseif( $_GET['m'] == 'KP'){
			$temp = "";
		}
	}

	private function exportBillingline0()
	{
		$xls = new oExcel;
		$xls->setColWidth([15, 20, 15, 15, 15, 15, 15, 15]);
		$i = 1;
		$xls->addRow($i++, ['Consol / EdiJob billlingline 0 Report']);
		$xls->mergeCells('A1:D1');
		$xls->setFont('A1', ['bold' => true, 'size' => '20']);
		$xls->centerAlignment('A1');
		$xls->setFont('A2:H2', ['bold' => true]);
		$xls->addRow($i++, ['AWB', 'Consol / EdiJob', 'Date', 'Type', 'Org', 'Item', 'Accrual', 'Actual']);

		$dptId = $_POST['wid'];
		$fromDate = $_POST['date']['from'];
		$toDate = $_POST['date']['to'];

		$sql = "SELECT c.awb,c.no,c.created,c.type,bl.org_id,bl.item_code,bl.accrual_amount,bl.actual_amount FROM consol as c JOIN billing_line bl on c.no = bl.billing_ref WHERE c.created >= '$fromDate' AND c.created < DATE_ADD('$toDate', INTERVAL 1 DAY) AND ((bl.accrual_amount > 0 AND bl.actual_amount = 0) OR (bl.accrual_amount = 0 AND bl.actual_amount > 0))";
		if ($dptId) {
			$sql .= ' AND c.dpt_id = $dptId';
		}
		$results = Yii::app()->db->createCommand($sql)->queryAll();
		foreach ($results as $r) {
			if (!empty($r['awb'])) {
				$xls->addRow($i++, [$r['awb'], $r['no'], $r['created'], Consol::$types[$r['type']], Org::model()->getName($r['org_id']), BillingLine::model()->getItemcodeDesc2($r['item_code']), $r['accrual_amount'], $r['actual_amount']]);
			}
		}

		$sql = "SELECT c.awb,c.no,c.created,c.type,bl.org_id,bl.item_code,bl.accrual_amount,bl.actual_amount FROM job as c JOIN billing_line bl on c.no = bl.billing_ref WHERE c.created >= '$fromDate' AND c.created < DATE_ADD('$toDate', INTERVAL 1 DAY) AND ((bl.accrual_amount > 0 AND bl.actual_amount = 0) OR (bl.accrual_amount = 0 AND bl.actual_amount > 0))";
		if ($dptId) {
			$sql .= ' AND c.dpt_id = $dptId';
		}
		$results = Yii::app()->db->createCommand($sql)->queryAll();
		foreach ($results as $r) {
			if (!empty($r['awb'])) {
				$xls->addRow($i++, [$r['awb'], $r['no'], $r['created'], Job::$types[$r['type']], Org::model()->getName($r['org_id']), BillingLine::model()->getItemcodeDesc2($r['item_code']), $r['accrual_amount'], $r['actual_amount']]);
			}
		}

		$xls->output('billingline0_report' . date('Ymd') . '.xlsx');
	}

	private function exportPriority2()
	{
		$i = 1;
		$xls = new oExcel;
		$xls->setColWidth([30, 30, 15, 15, 15, 15, 15, 15, 15]);
		$xls->setFont('A1:F1', ['bold' => true]);
		$xls->addRow($i++, ['Dest', 'Matched Result', 'Amount']);
		$xls->addRow($i++, ['']);

		$total = 0;
		$sql = 'select matched_result, sum(total) AS total from air_freight_invoice_reconciliation where (dest like "%xian%" OR dest like "%ximen%") AND eta >= "' . $_POST['date']['from'] . '" AND eta <= "' . $_POST['date']['to'] . '" group by matched_result';
		$af_invs = Yii::app()->db->createCommand($sql)->queryAll();
		foreach ($af_invs as $af_inv) {
			$xls->addRow($i++, ['西安 or 厦门', AFInvoiceReconciliation::$matched_error_msg[$af_inv['matched_result']], '$' . number_format($af_inv['total'], 2)]);
			$total += $af_inv['total'];
		}
		$xls->setFont('A' . $i . ':F' . $i, ['bold' => true]);
		$xls->addRow($i++, ['SP', '', '$' . number_format($total, 2)]);
		$xls->addRow($i++, ['']);

		$total = 0;
		$sql = 'select matched_result, sum(total) AS total from air_freight_invoice_reconciliation where dest not like "%xian%" AND dest not like "%ximen%" AND eta >= "' . $_POST['date']['from'] . '" AND eta <= "' . $_POST['date']['to'] . '" group by matched_result';
		$af_invs = Yii::app()->db->createCommand($sql)->queryAll();
		foreach ($af_invs as $af_inv) {
			$xls->addRow($i++, ['非西安 or 厦门', AFInvoiceReconciliation::$matched_error_msg[$af_inv['matched_result']], '$' . number_format($af_inv['total'], 2)]);
			$total += $af_inv['total'];
		}
		$xls->setFont('A' . $i . ':F' . $i, ['bold' => true]);
		$xls->addRow($i++, ['ED', '', '$' . number_format($total, 2)]);
		$xls->addRow($i++, ['']);

		$total = 0;
		$sql = 'select dest, matched_result, sum(total) AS total from air_freight_invoice_reconciliation where eta >= "' . $_POST['date']['from'] . '" AND eta <= "' . $_POST['date']['to'] . '" group by dest, matched_result';
		$af_invs = Yii::app()->db->createCommand($sql)->queryAll();
		foreach ($af_invs as $af_inv) {
			$xls->addRow($i++, [$af_inv['dest'], AFInvoiceReconciliation::$matched_error_msg[$af_inv['matched_result']], '$' . number_format($af_inv['total'], 2)]);
			$total += $af_inv['total'];
		}
		$xls->setFont('A' . $i . ':F' . $i, ['bold' => true]);
		$xls->addRow($i++, ['Total', '', '$' . number_format($total, 2)]);
		$xls->addRow($i++, ['']);

		$subtotal = 0;
		$gst = 0;
		$total = 0;
		$xls->setFont('A' . $i . ':I' . $i, ['bold' => true]);
		$xls->addRow($i++, ['Invoice', 'AWB', 'ETA', 'ETD', 'Destination', 'Subtotal', 'Gst', 'Total', 'Matched_result']);
		$sql = 'select invoice_no, awb, eta, etd, dest, subtotal, gst, total, matched_result from air_freight_invoice_reconciliation where eta >= "' . $_POST['date']['from'] . '" AND eta <= "' . $_POST['date']['to'] . '"';
		$af_invs = Yii::app()->db->createCommand($sql)->queryAll();
		foreach ($af_invs as $af_inv) {
			$xls->addRow($i++, [$af_inv['invoice_no'], $af_inv['awb'], $af_inv['eta'], $af_inv['etd'], $af_inv['dest'], $af_inv['subtotal'], $af_inv['gst'], $af_inv['total'], AFInvoiceReconciliation::$matched_error_msg[$af_inv['matched_result']]]);
			$subtotal += $af_inv['subtotal'];
			$gst += $af_inv['gst'];
			$total += $af_inv['total'];
		}
		$xls->setFont('A' . $i . ':I' . $i, ['bold' => true]);
		$xls->addRow($i++, ['', '', '', '', '', '$' . number_format($subtotal, 2), '$' . number_format($gst, 2), '$' . number_format($total, 2)]);

		$xls->output('priority_sp_ed_report_' . time() . '.xlsx');
	}

	private function exportPriority()
	{
		$xls = new oExcel;
		$xls->setColWidth([20, 20, 20, 20, 20, 20, 20]);
		$xls->setFont('A1:G1', ['bold' => true]);
		$xls->addRow(1, ['Invoice no.', 'AWB', 'Actual Amount', 'Accrual Amount', 'Diff', '%', 'Ref no.', '']);

		$af_invs = AFInvoiceReconciliation::model()->findAll('matched_result in (1,5,9) AND created >= :fd AND created <= :td', [':fd' => $_POST['date']['from'], ':td' => $_POST['date']['to']]);
		$i = 2;
		foreach ($af_invs as $af_inv) {
			// invoice lines imported - actual
			$inv_lines = $af_inv->lines;
			$inv_lines_combine = [];
			$actual_amount = [];
			foreach ($inv_lines as $inv_line) {
				if (empty($inv_lines_combine[$inv_line->glcode])) {
					$inv_lines_combine[$inv_line->glcode]['amount'] = [];
					$inv_lines_combine[$inv_line->glcode]['amount'][] = $inv_line->amount;
					$actual_amount[$inv_line->glcode] = $inv_line->amount;
				} else {
					$inv_lines_combine[$inv_line->glcode]['amount'][] = $inv_line->amount;
					$actual_amount[$inv_line->glcode] += $inv_line->amount;
				}
			}

			// related export consol billing lines - accrual
			if ($af_inv->model == 'ExcoConsol') {
				$excol = ExcoConsol::model()->findByPk($af_inv->fid);
				$bill_lines = BillingLine::model()->findAll('billing_ref = :billing_ref', ['billing_ref' => $excol->no]);
				$ref_no = $excol->no;
			} elseif ($af_inv->model == 'EdiJob') {
				$edijob = EdiJob::model()->findByPk($af_inv->fid);
				$bill_lines = BillingLine::model()->findAll('billing_ref = :billing_ref', ['billing_ref' => $edijob->no]);
				$ref_no = $edijob->no;
			}
			$bill_lines_combine = [];
			$accrual_amount = [];
			foreach ($bill_lines as $bill_line) {
				if (in_array($bill_line->item_code, array_keys($inv_lines_combine)) || $bill_line->org_id == 954) {
					if (empty($bill_lines_combine[$bill_line->item_code])) {
						$bill_lines_combine[$bill_line->item_code]['amount'] = [];
						$bill_lines_combine[$bill_line->item_code]['amount'][] = $bill_line->accrual_amount;
						$accrual_amount[$bill_line->item_code] = $bill_line->accrual_amount;
					} else {
						$bill_lines_combine[$bill_line->item_code]['amount'][] = $bill_line->accrual_amount;
						$accrual_amount[$bill_line->item_code] += $bill_line->accrual_amount;
					}
				}
			}

			// check
			$actual_sum = round(array_sum($actual_amount), 2);
			$accrual_sum = round(array_sum($accrual_amount), 2);
			if (($af_inv->matched_result == 1 && $accrual_sum < $actual_sum) || $af_inv->matched_result != 1) {
				if ($accrual_sum < $actual_sum) {
					$xls->addRow($i++, [$af_inv->invoice_no, $af_inv->awb, number_format($actual_sum, 2), number_format($accrual_sum, 2), number_format($actual_sum - $accrual_sum, 2), $accrual_sum ? number_format(($actual_sum - $accrual_sum) / $accrual_sum * 100, 2) . '%' : '100%', $ref_no, $af_inv->getMatchedErrMessage()]);
					foreach ($inv_lines_combine as $index => $line) {
						if (!empty($bill_lines_combine[$index]['amount'])) {
							$xls->addRow($i++, ['', $index, (count($inv_lines_combine[$index]['amount']) > 1) ? implode('+', $inv_lines_combine[$index]['amount']) . '=' . $actual_amount[$index] : implode('+', $inv_lines_combine[$index]['amount']), (count($bill_lines_combine[$index]['amount']) > 1) ? implode('+', $bill_lines_combine[$index]['amount']) . '=' . $accrual_amount[$index] : implode('+', $bill_lines_combine[$index]['amount']), $actual_amount[$index] - $accrual_amount[$index], number_format(($actual_amount[$index] - $accrual_amount[$index]) / ($accrual_amount[$index] ? $accrual_amount[$index] : 1) * 100, 2) . '%', '']);
						}
					}
					foreach ($inv_lines_combine as $index => $line) {
						if (empty($bill_lines_combine[$index]['amount'])) {
							$xls->addRow($i++, ['', $index, (count($inv_lines_combine[$index]['amount']) > 1) ? implode('+', $inv_lines_combine[$index]['amount']) . '=' . $actual_amount[$index] : implode('+', $inv_lines_combine[$index]['amount']), 0, $actual_amount[$index], '100%', '']);
						}
					}
					foreach ($bill_lines_combine as $index => $line) {
						if (!in_array($index, array_keys($inv_lines_combine))) {
							$xls->addRow($i++, ['', $index, 0, (count($bill_lines_combine[$index]['amount']) > 1) ? implode('+', $bill_lines_combine[$index]['amount']) . '=' . $accrual_amount[$index] : implode('+', $bill_lines_combine[$index]['amount']), -$accrual_amount[$index], '-100%', '']);
						}
					}
					$xls->addRow($i++, ['']);
				}
			}
		}

		$xls->output('priority_invoice_report_' . time() . '.xlsx');
	}

	/**
	 * export no billing report based on AWB
	 */
	private function exportAwbNoBillReport()
	{
		$xls = new oExcel;
		$xls->setColWidth([15, 20, 15, 15]);
		$i = 1;
		$xls->addRow($i++, ['AWB No Billing Report']);
		$xls->mergeCells('A1:D1');
		$xls->setFont('A1', ['bold' => true, 'size' => '20']);
		$xls->centerAlignment('A1');
		$xls->addRow($i++, ['AWB', 'Consol', 'Date', 'Type']);

		$dptId = $_POST['wid'];
		$fromDate = $_POST['date']['from'];
		$toDate = $_POST['date']['to'];

		$sql = "SELECT awb,no,created,type FROM consol as c WHERE c.created >= '$fromDate' AND c.created < DATE_ADD('$toDate', INTERVAL 1 DAY) AND c.awb NOT IN (SELECT billing_ref FROM billing WHERE billing.id > 0)";
		if ($dptId) {
			$sql .= ' AND c.dpt_id = $dptId';
		}
		$results = Yii::app()->db->createCommand($sql)->queryAll();
		foreach ($results as $r) {
			if (!empty($r['awb'])) {
				$xls->addRow($i++, [$r['awb'], $r['no'], $r['created'], Consol::$types[$r['type']]]);
			}
		}

		$sql = "SELECT awb,no,created,type FROM job as c WHERE c.created >= '$fromDate' AND c.created < DATE_ADD('$toDate', INTERVAL 1 DAY) AND c.awb NOT IN (SELECT billing_ref FROM billing WHERE billing.id > 0)";
		if ($dptId) {
			$sql .= ' AND c.dpt_id = $dptId';
		}
		$results = Yii::app()->db->createCommand($sql)->queryAll();
		foreach ($results as $r) {
			if (!empty($r['awb'])) {
				$xls->addRow($i++, [$r['awb'], $r['no'], $r['created'], Job::$types[$r['type']]]);
			}
		}

		// search for EDI job
		$xls->output('awb_nobilling_report' . date('Ymd') . '.xlsx');
	}

	private function weightReport()
	{
		$xls = new oExcel;
		$xls->setColWidth([15, 20, 10, 10, 10, 5, 20, 20, 10, 10, 5]);
		$i = 1;
		$xls->addRow($i++, ['Shipments Weight Report']);
		$xls->mergeCells('A1:M1');
		$xls->setFont('A1', ['bold' => true, 'size' => '20']);
		$xls->centerAlignment('A1');
		$xls->addRow($i++, ['HBN', 'Agent ID', 'Agent', 'Weight', 'Check Weight']);

		$model = new ExParcel('search');
		$model->unsetAttributes();
		$model->attributes = $_POST['ExParcel'];

		$criteria = new CDbCriteria;
		$criteria->compare('agent_id', $model->agent_id, false);
		$criteria->addCondition('t.wtck > t.weight * 1.05 AND t.wtck < t.weight * 1.5');

		if (!empty($_POST['date'])) {
			$criteria->addCondition('t.created >= :fd AND t.created < DATE_ADD(:td, INTERVAL 1 DAY)');
			$criteria->params += [':fd' => $_POST['date']['from'], ':td' => $_POST['date']['to']];
		}

		if (!empty($model->cnee_name)) {
			$with[] = 'cnee';
			$criteria->compare('cnee.name', $model->cnee_name, true);
		}

		if (!empty($model->cnor_name)) {
			$with[] = 'cnor';
			$criteria->compare('cnor.name', $model->cnor_name, true);
		}

		if (!empty($with)) {
			$criteria->with = $with;
			$criteria->together = true;
		}

		$tc = $model::model()->count($criteria);
		$criteria->limit = 500;
		$tpg = ceil($tc / $criteria->limit);

		for ($p = 0; $p < $tpg; $p++) {
			$criteria->offset = $p * $criteria->limit;
			$rs = $model::model()->findAll($criteria);

			foreach ($rs as $r) {
				$xls->addRow($i++, ['="' . $r->hbn . '"', $r->agent_id, empty($r->agent_id) ? '' : $r->agent->name, $r->weight, $r->wtck]);
			}
		}

		$xls->output('shipments_weight_report' . date('Ymd') . '.xlsx');
	}

	private function courierParcelReport()
	{
		$xls = new oExcel;
		$xls->setColWidth([20, 20, 20, 20, 20, 20, 20, 20, 20, 20, 20, 20]);
		$i = 1;
		$xls->addRow($i++, ['Courier Shipments Report']);
		$xls->mergeCells('A1:M1');
		$xls->setFont('A1', ['bold' => true, 'size' => '20']);
		$xls->centerAlignment('A1');
		$xls->addRow($i++, ['Reference No', 'Courier','Agent Name', 'Weight', 'CBM', 'Packages','From', 'To Postcode', 'Scan In', 'Manifest Time', 'Courier Receive Time', 'Delivery Time']);

		if (!empty($_POST['date'])) {
			$fromDate = $_POST['date']['from'];
			$toDate = $_POST['date']['to'];
			$shipments = Shipment::model()->findAllBySql("SELECT * FROM shipment WHERE created BETWEEN :fromDate AND :toDate", array(':fromDate' => $fromDate, ':toDate' => $toDate));
		} else {
			$shipments = Shipment::model()->findAllBySql("SELECT * FROM shipment WHERE id = 0");
		}

		foreach ($shipments as $shipment) {
			$tranship = Tranship::model()->find('pid = :pid', array(':pid' => $shipment->id));
			$courierName = Org::model()->findByPk($tranship->org_id)->name;
			$agentName = Org::model()->findByPk($shipment->agent_id)->name;
			$fromWarehouse = Org::model()->findByPk($shipment->ddpt_id)->name;
			$tracks = Tracking::model()->findAll('pid = :pid', array(':pid' => $shipment->id));
			$now = new DateTime("now");
			$courierReceiveTime = $now;
			$deliveryTime = '';
			$arrivalTime = '';
			$manifestTime = '';
			
			foreach ($tracks as $track) {				
				switch ($track->type) {
					case 30:
						$manifestTime = $track->dt;
						break;
					case 40:
						$arrivalTime = $track->dt;
						break;
					case 70:
						if ($courierReceiveTime > $track->dt) {
							$courierReceiveTime = $track->dt;
						}
						break;
					case 90:
						$deliveryTime = $track->dt;
						break;
				}
			}
			if ($courierReceiveTime != $now){
				$xls->addRow($i++, [$shipment->ref, $courierName, $agentName, $shipment->weight, $shipment->cbm, $shipment->pkg, $fromWarehouse, $shipment->postcode, $arrivalTime, $manifestTime, $courierReceiveTime, $deliveryTime]);
			} else {
				$courierReceiveTime = '';
				$xls->addRow($i++, [$shipment->ref, $courierName, $agentName, $shipment->weight, $shipment->cbm, $shipment->pkg, $fromWarehouse, $shipment->postcode, $arrivalTime, $manifestTime, '', $deliveryTime]);
			}			
		}
		$xls->output('Courier_Shipments_Report' . date('Ymd') . '.xlsx');
	}
	

	private function dataEntryReport()
	{
		if (empty($_POST['detail'])) {
			$xls = new oExcel;
			$xls->setColWidth([15, 20, 15, 10, 10]);
			$i = 1;
			$xls->addRow($i++, ['Data Entry Report']);
			$xls->mergeCells('A1:C1');
			$xls->setFont('A1', ['bold' => true, 'size' => '20']);
			$xls->centerAlignment('A1');
			$xls->addRow($i++, ['Date', 'New', 'Check']);
			$sql = 'SELECT d, COUNT(lid) AS c FROM (SELECT DATE(t.time) AS d, lid FROM `log` t WHERE model = "ExParcel" AND user_id IN (SELECT id FROM user WHERE (type = 120) AND t.time >= :fd AND t.time < DATE_ADD(:td, INTERVAL 1 DAY) GROUP BY lid) t GROUP BY d';
			$rs = Yii::app()->db->createCommand($sql)->bindValues([':fd' => $_POST['date']['from'] . ' 06:00', ':td' => $_POST['date']['to'] . ' 06:00'])->queryAll();
			$dd = [];
			foreach ($rs as $r) {
				$dd[$r['d']] = [$r['c'], 0];
			}
			$sql = 'SELECT d, COUNT(lid) AS c FROM (SELECT DATE(t.time) AS d, lid FROM `log` t INNER JOIN `shipment` s on s.id = t.lid WHERE model = "ExParcel" AND user_id IN (SELECT id FROM user WHERE (type = 120) AND t.time >= :fd AND t.time < DATE_ADD(:td, INTERVAL 1 DAY) AND s.meta LIKE "%client_entry%" GROUP BY lid) t GROUP BY d';
			$rs = Yii::app()->db->createCommand($sql)->bindValues([':fd' => $_POST['date']['from'] . ' 06:00', ':td' => $_POST['date']['to'] . ' 06:00'])->queryAll();

			foreach ($rs as $r) {
				$dd[$r['d']][1] = $r['c'];
				$dd[$r['d']][0] -= $r['c'];
			}
			foreach ($dd as $d => $v) {
				$xls->addRow($i++, [$d, $v[0], $v[1]]);
			}

			$xls->output('dataentry_report' . date('Ymd') . '.xlsx');
		} else {
			$xls = new oExcel;
			$xls->setColWidth([15, 20, 15, 10, 10]);
			$i = 1;
			$xls->addRow($i++, ['Data Entry Detailed Report']);
			$xls->mergeCells('A1:M1');
			$xls->setFont('A1', ['bold' => true, 'size' => '20']);
			$xls->centerAlignment('A1');
			$xls->addRow($i++, ['HBN', 'User', 'Date Time', 'New', 'Check']);

			$model = new Log('search');
			$model->unsetAttributes();

			$criteria = new CDbCriteria;
			$criteria->addCondition('model = "ExParcel" AND user_id IN (SELECT id FROM user WHERE type = 120 OR id = 379)');

			if (!empty($_POST['date'])) {
				$criteria->addCondition('t.time >= :fd AND t.time < DATE_ADD(:td, INTERVAL 1 DAY)');
				$criteria->params += [':fd' => $_POST['date']['from'] . ' 06:00', ':td' => $_POST['date']['to'] . ' 06:00'];
			}
			$criteria->group = 'lid';
			$criteria->order = 'user_id';

			$tc = $model::model()->count($criteria);
			$criteria->limit = 1000;
			$tpg = ceil($tc / $criteria->limit);

			for ($p = 0; $p < $tpg; $p++) {
				$criteria->offset = $p * $criteria->limit;
				$rs = $model::model()->findAll($criteria);

				foreach ($rs as $l) {
					$r = $l->mm();
					$ce = !empty($r->mdata['client_entry']);
					$xls->addRow($i++, ['="' . $r->hbn . '"', $l->user->name, $l->time, $ce ? 0 : 1, $ce ? 1 : 0]);
				}
			}

			$xls->output('dataentry_detailed_report' . date('Ymd') . '.xlsx');
		}
	}

	/**
	 * create bond storage report based on specified conditions
	 */
	private function bondStorageReport()
	{
		$xls = new oExcel;
		$xls->setColWidth([10, 15, 15, 10, 10, 10, 10, 10]);

		// search all shipments in the bonds warehouse
		$wid = $_POST['wid'];
		$date_from = $_POST['date']['from'];
		$date_to = $_POST['date']['to'];
		$agent_id = $_POST[$this->rpts[$_GET['rpt']][0]]['agent_id'];

		// actually for Import Parcel - ImParcel class
		$sql = 'SELECT A.agent_id, A.hbn,A.weight,A.pkg ,B.awb,C.mani_id ,B.eta as inDate , D.created as outDate FROM shipment as A ';
		$sql .= 'Left join consol as B on A.consol_id = B.id ';
		$sql .= 'Left join mani_map as C on C.fid = A.id ';
		$sql .= 'Left join manifest as D on D.id = C.mani_id ';
		$sql .= 'where A.type = 10 ';

		if (!empty($wid)) {
			$sql .= 'and B.dpt_id = ' . $wid; // search for spefified warehouse
		}
		if (!empty($agent_id)) {
			$sql .= ' and A.agent_id = ' . $agent_id; // search for specified agent
		}
		$sql .= ' and ( D.type = 50 or D.type is NULL) '; // search for out from storage or still in storage
		$destFromDate = '2016-07-01'; // too old date , we just ignore
		$destToDate = '';
		if (!empty($date_from) && $date_from > $destFromDate) {
			$destFromDate = $date_from;
		}
		if (!empty($date_to) && $date_to > $destFromDate) {
			$destToDate = $date_to;
		}
		$sql .= " and A.created >= '" . $destFromDate . "'"; // too old data we just ignore them
		if (!empty($destToDate)) {
			$sql .= " and A.created <= '" . $destToDate . "'";
		}

		$sql .= 'GROUP BY A.hbn';

		// search for all shipments
		$dataReader = Yii::app()->db->createCommand($sql)->query([]);
		$shipments = [];
		foreach ($dataReader as $row) {
			$shipments[] = $row;
		}

		// group all shipments by agent
		$agentShipments = [];
		if (empty($agent_id)) {
			foreach ($shipments as $shipment) {
				if (!isset($agentShipments[$shipment['agent_id']])) { // agent not exiting yet ,create a new one
					$agentShipments[$shipment['agent_id']] = [];
				}
				$agentShipments[$shipment['agent_id']][] = $shipment;
			}
		} else {
			$agentShipments[$agent_id] = $shipments;
		}

		// set export excel title
		$i = 1;
		$xls->addRow($i++, ['Bond Storage Report']);
		$xls->mergeCells('A1:H1');
		$xls->setFont('A1', ['bold' => true, 'size' => '20']);
		$xls->centerAlignment('A1');

		// export all shipments by agent id now
		foreach ($agentShipments as $agentId => $shipments) {
			// show agent name
			$agent = Org::model()->findByPk($agentId);
			$xls->addRow($i++, [$agent->name]);
			$xls->setFont('A' . ($i - 1), ['bold' => true]);

			// show conditions : date from and to , day rate and storage free day terms
			$ss = new OrgRate('search');
			$cus_services = $ss->getCustomerServicePlans($agentId);
			$storage_rate = $storage_terms = 0;
			if (isset($cus_services['services']->AU->str_rate)) {
				$storage_rate = $cus_services['services']->AU->str_rate;
			}
			if (isset($cus_services['services']->AU->str_terms)) {
				$storage_terms = $cus_services['services']->AU->str_terms;
			}
			$xls->addRow($i++, ['From:', $date_from, 'To:', $date_to, 'Free Storage Terms:', $storage_terms . ' day(s)', 'Day Rate:', $storage_rate . '/pk']);

			// export title
			$xls->addRow($i++, ['No.', 'MAWB', 'HBN', 'PCS', 'WEIGHT', 'DAYS', 'CHARGE DAYS', 'AMOUNT']);

			if ($storage_rate <= 0.0) {
				// add one blank row
				$xls->addRow($i++, ['']);

				// go to next agent
				continue;
			}

			// export each shipment row
			$rowIndex = 1;
			$totalAmount = 0;
			foreach ($shipments as $shipment) {
				// how many days stored in our bonds warehouse
				if (!empty($shipment['inDate'])) {
					$inTime = new DateTime($shipment['inDate'], new DateTimeZone('Australia/Sydney'));
					if (!empty($shipment['outDate'])) {
						$outTime = new DateTime($shipment['outDate'], new DateTimeZone('Australia/Sydney'));
					} else {
						// $outTime = new DateTime('now', new DateTimeZone('Australia/Sydney')); // default current time
						continue; // only for prepared GatePass parcels
					}
					$storedDays = $outTime->diff($inTime)->format("%a");

					$chargeDays = $storedDays - $storage_terms;
					if ($chargeDays > 0) {
						// how much we should charge
						$amount = $chargeDays * $shipment['weight'] * $storage_rate;
						$totalAmount += $amount;
						$amount = number_format($amount, 2, '.', '');
						$xls->addRow($i++, [$rowIndex++, '="' . $shipment['awb'] . '"', '="' . $shipment['hbn'] . '"', $shipment['pkg'], $shipment['weight'], $storedDays, $chargeDays, $amount]);
					}
				}
			}

			$totalAmount = number_format($totalAmount, 2, '.', '');
			$xls->addRow($i++, ['Total:']);
			$xls->mergeCells('A' . ($i - 1) . ':G' . ($i - 1));
			$xls->setCell('H' . ($i - 1), $totalAmount);
			$xls->setFont('A' . ($i - 1), ['bold' => true, 'size' => '20']);
			$xls->setFont('H' . ($i - 1), ['bold' => true, 'size' => '20']);

			// add one blank row
			$xls->addRow($i++, ['']);
		}

		$xls->output('bondstorage_report' . date('Ymd') . '.xlsx');
	}

	protected function acc_nrr()
	{
		$db = Yii::app()->getDb();
		$sql = "SELECT s.id FROM shipment s LEFT JOIN (SELECT mm.fid FROM mani_map mm INNER JOIN manifest m ON m.id = mm.mani_id WHERE m.type = 40 AND m.created >= :f) r ON s.id = r.fid WHERE s.created >= :f AND s.created < DATE_ADD(:t, INTERVAL 1 DAY) AND s.status NOT IN (8,9,10,100,102) AND s.type = 20 AND r.fid IS NULL";
		$prms = [':f' => $_POST['date']['from'], ':t' => $_POST['date']['to']];
		if (!empty($_POST['wh'])) {
			$sql .= ' AND s.odpt_id = :p';
			$prms[':p'] = $_POST['wh'];
		}
		$rs = $db->createCommand($sql)->bindValues($prms)->queryAll();
		$xls = new oExcel;
		$xls->setColWidth([15, 20, 10, 15, 15, 20, 15, 15, 10]);
		$i = 1;
		$xls->addRow($i++, [$this->rpts[$_GET['rpt']][2] . ' Shipments Report']);
		$xls->mergeCells('A1:M1');
		$xls->setFont('A1', ['bold' => true, 'size' => '20']);
		$xls->centerAlignment('A1');
		$xls->addRow($i++, ['HBN', 'Status', 'Depot', 'Agent', 'Weight', 'State', 'Post Code', 'Cnor', 'Phone', 'Cnee', 'Phone', 'Date']);
		foreach ($rs as $r) {
			$r = ExParcel::model()->findByPk($r['id']);
			$xls->addRow($i++, ['="' . $r->hbn . '"', $r->getStatus(), empty($r->odpt_id) ? '' : $r->odepot->shortName(1), empty($r->agent_id) ? '' : $r->agent->name, $r->weight, $r->state, $r->postcode, $r->cnor->name, $r->cnor->tel, $r->cnee->name, $r->cnee->tel, $r->pickupDate()]);
		}
		$xls->output('no_receipt_report_' . date('Ymd') . '.xlsx');
	}

	protected function acc_rec()
	{
		$xls = new oExcel;
		$i = 1;
		$xls->setColWidth([15, 20, 10, 20, 10, 15, 10, 15, 20, 10, 10, 10, 10, 15, 15]);
		$xls->addRow($i++, ['Location', 'WBN', 'Status', 'Agent', 'Agent ID', 'Sender', 'Sender Tel', 'Cnee Name', 'Cnee Tel', 'Address', 'State', 'Weight', 'Type', 'Rating Code', 'Rate', 'Charge']);
		$sql = 'SELECT s.id, s.hbn, a.name, a.address, a.state FROM shipment s LEFT JOIN addr a ON (s.cnee_id = a.id) WHERE s.odpt_id = :wid AND s.id IN (SELECT pid FROM tracking WHERE `type` IN (14,15,18) AND dt >= :df AND dt < DATE_ADD(:dt, INTERVAL 1 DAY) GROUP BY pid ORDER BY dt ASC)';
		$rs = Yii::app()->db->createCommand($sql)->bindValues([':wid' => $_POST['wh'], ':df' => $_POST['date']['from'], ':dt' => $_POST['date']['to']])->queryAll();
		$dfs = strtotime($_POST['date']['from']);
		$dts = strtotime($_POST['date']['to']);
		foreach ($rs as $r) {
			$dt = Yii::app()->db->createCommand('SELECT dt FROM tracking WHERE `type` IN (14,15,18) AND pid = :id ORDER BY dt ASC LIMIT 1')->bindValues([':id' => $r['id']])->queryScalar();
			$dts = strtotime($dt);
			if ($dts < $dfs || $dts >= $dts + 86400) {
				continue;
			}
			$p = ExParcel::model()->findByPk($r['id']);
			if (empty($p->cnee)) {
				continue;
			}
			$typ = $p->goodsType();
			$ln = $p->getLastLog();
			$weight = $p->chargeWeight();
			$rate = $p->getAgentRate();
			$xls->addRow($i++, [$p->getLocation(), $p->hbn, $p->getStatus(), empty($p->agent) ? '' : $p->agent->name, $p->agent_id, $p->cnor->name, '="' . $p->cnor->tel . '"', $p->cnee->name, '="' . $p->cnee->tel . '"', $p->cnee->address, $p->cnee->state, $weight, $typ, $rate[0], $rate[1]->perkg, $rate[2]]);
		}
		$xls->output('receival_report_' . date('Ymd') . '.xlsx');
	}

	protected function acc_cpl()
	{
		$xls = new oExcel;
		$i = 1;
		$xls->setColWidth([20, 10, 20, 10, 15, 10, 10, 10, 15, 15, 15]);
		$xls->addRow($i++, ['WBN', 'Status', 'Agent', 'Ship Weight', 'Charge Weight', 'State', 'Type', 'Rating Code', 'Rate', 'Charge', 'Cost', 'P/L']);
		$c = ExcoConsol::model()->findByPk($_POST['ExParcel']['consol_id']);
		foreach ($c->shipments as $p) {
			$typ = $p->goodsType();
			$ln = $p->getLastLog();
			$rate = $p->getAgentRate();
			$cost = round($p->getCost() / $c->exrate * 100) / 100;
			$xls->addRow($i, [$p->hbn, $p->getStatus(), empty($p->agent) ? '' : $p->agent->name, $p->shipWeight(), $p->chargeWeight(), $p->state, $typ, $rate[0], $rate[1]->perkg, $rate[2], $cost, '=J' . $i . '-K' . $i]);
			$i++;
		}
		$xls->output($c->no . '_pnl_report.xlsx');
	}

	protected function acc_trf()
	{
		$c = ExcoConsol::model()->findByPk($_POST['ExParcel']['consol_id']);
		$xls = new oExcel;
		$i = 1;
		$xls->setColWidth([20, 10, 20, 10, 15, 10, 10, 10, 15, 15, 15]);
