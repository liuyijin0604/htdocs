					// new billing actual
					} else {
						$invoice_payable = !empty($new_data[$r['org_id'] . '_' . $con->no]) ? $new_data[$r['org_id'] . '_' . $con->no] : 0;
						$dispute = Billing::getDisputeFromSiReconcile($r['org_id'], $con->id);
					}

					if (empty($provide[$r['org_id']][$invoice_payable > 0])) {
						$provide[$r['org_id']][$invoice_payable > 0] = ['id' => $r['org_id'], 'supplier' => Org::model()->findByPk($r['org_id'])->name, 'accrual' => 0, 'invoice_payable' => 0, 'dispute' => 0, 'confirm_payable' => 0];
					}
					$provide[$r['org_id']][$invoice_payable > 0]['accrual'] += $r['accrual_amount'];
					$provide[$r['org_id']][$invoice_payable > 0]['invoice_payable'] += $invoice_payable;
					$provide[$r['org_id']][$invoice_payable > 0]['dispute'] += $dispute;
					$provide[$r['org_id']][$invoice_payable > 0]['confirm_payable'] += $invoice_payable - $dispute;
				}
			}
			if (!empty($provide[Org::ORGID_COURIER_AUSLETTER])) {
				foreach ($provide[Org::ORGID_COURIER_AUSLETTER] as $has_actual => $line) {
					$provide[Org::ORGID_COURIER_AUPOST][$has_actual]['accrual'] += $provide[Org::ORGID_COURIER_AUSLETTER][$has_actual]['accrual'];
				}
				unset($provide[Org::ORGID_COURIER_AUSLETTER]);
			}
			foreach ($provide as $org_id => $lines) {
				foreach ($lines as $has_actual => $line) {
				// if (!in_array($org_id, array_merge(Org::$couriers, Org::$airports))) {
				// 	unset($provide[$org_id]);
				// 	continue;
				// }
				$provide[$org_id][$has_actual]['confirm_payable'] = $provide[$org_id][$has_actual]['invoice_payable'] - $provide[$org_id][$has_actual]['dispute'];
				$provide[$org_id][$has_actual]['confirm_payable / accrual'] = number_format($provide[$org_id][$has_actual]['confirm_payable'] / $provide[$org_id][$has_actual]['accrual'] * 100, 2, '.', '') . '%';
				$provide[$org_id][$has_actual]['supplier'] = '<a href="' . Yii::app()->createUrl('report/byCostDetail', ['org_id' => $org_id, 'from' => $dateFrom, 'to' => $dateTo]) . '" class="tab_link" title="' . $provide[$org_id][$has_actual]['supplier'] . '">' . $provide[$org_id][$has_actual]['supplier'] . '</a>';
				}
			}
			$totalData = ['revenue' => 0, 'cost' => 0, 'gp' => 0, 'profit' => 0, 'accrual' => 0, 'invoice_payable' => 0, 'dispute' => 0, 'confirm_payable' => 0];
			foreach ($provide as $org_id => $lines) {
				foreach ($lines as $has_actual => $line) {
				foreach ($line as $key => $value) {
					if (in_array($key, ['accrual', 'invoice_payable', 'dispute', 'confirm_payable'])) {
						$provide[$org_id][$has_actual][$key] = '<div style="width: 100%; text-align: right">' . AppHelper::money_format('%i', $value) . '</div>';
						$totalData[$key] += floatval($value);
					} else if (in_array($key, ['dispute'])) {
						if ($provide[$org_id][$has_actual][$key] <= 0) $provide[$org_id][$has_actual][$key] = '';
						else $provide[$org_id][$has_actual][$key] = '<div style="width: 100%; text-align: right"><span style="color: red">(' . AppHelper::money_format('%i', $value) . ')</span></div>';
						$totalData[$key] += floatval($value);
					} else if (in_array($key, ['confirm_payable / accrual'])) {
						$provide[$org_id][$has_actual][$key] = '<div style="width: 100%; text-align: right">' . $value . '</div>';
					}
				}
				}
			}
			$temp = [];
			foreach ($provide as $org_id => $lines) {
				foreach ($lines as $has_actual => $line) {
					$temp[$org_id . ' ' . $has_actual] = $line;
				}
			}
			ksort($temp);
			$provide = array_values($temp);
			$sortAttributes = ['supplier' => 'supplier', 'accrual' => 'accrual', 'invoice_payable' => 'invoice_payable', 'dispute' => 'dispute', 'confirm_payable' => 'confirm_payable', 'confirm_payable / accrual' => 'confirm_payable / accrual'];
			$sortNumberAttributes = $sortAttributes;
		} else if ($type == 8&&empty($cacheData)) {
			[$app_name, Yii::app()->name] = [Yii::app()->name, 'TLA'];
			$invoices = SiReconcile::model()->with('parent')->findAll('t.status < 100 AND parent.inv_date >= "' . $dateFrom . '" AND parent.inv_date <= "' . $dateTo . '" AND parent.status < 100');
			$nos = [];
			foreach ($invoices as $invoice) {
				$nos[] = $invoice->parent->inv_no;
				if (empty($provide[$invoice->org_id])) $provide[$invoice->org_id] = ['id' => $invoice->org_id, 'supplier' => Org::model()->findByPk($invoice->org_id)->name, 'invoice_payable' => 0, 'dispute' => 0, 'confirm_payable' => 0, 'to_xero' => 0, 'inv_no' => 0, 'to_xero_no' => 0];
				$provide[$invoice->org_id]['invoice_payable'] += $invoice->total;
				$dl = DisputeLine::model()->with('parent')->find('parent.rec_id = :rid AND t.status < 99', [':rid' => $invoice->id]);
				if (!empty($dl)) {
					if ($dl->status == 0) $provide[$invoice->org_id]['dispute'] += $dl->dispute_amount_ex_gst * ($gst ? 1.1 : 1);
					else if ($dl->status == 10) $provide[$invoice->org_id]['dispute'] += $dl->credit_amount_ex_gst * ($gst ? 1.1 : 1);
				}
				$provide[$invoice->org_id]['inv_no'] += 1;
				if (($invoice->confirm_status & 16) > 0) {
					$provide[$invoice->org_id]['to_xero'] += $invoice->total;
					$provide[$invoice->org_id]['to_xero_no'] += 1;
				}
			}

			$totalData = ['revenue' => 0, 'cost' => 0, 'gp' => 0, 'profit' => 0, 'invoice_payable' => 0, 'dispute' => 0, 'confirm_payable' => 0, 'to_xero' => 0];
			foreach ($provide as $org_id => $line) {
				$provide[$org_id]['confirm_payable'] = $provide[$org_id]['invoice_payable'] - $provide[$org_id]['dispute'];
				$provide[$org_id]['finish_percent'] = '<div style="width: 100%; text-align: right">' . number_format($provide[$org_id]['to_xero_no'] / $provide[$org_id]['inv_no'] * 100, 2, '.', '') . '%</div>';
			}
			foreach ($provide as $org_id => $line) {
				foreach ($line as $key => $value) {
					if (in_array($key, ['invoice_payable', 'confirm_payable', 'to_xero'])) {
						$provide[$org_id][$key] = '<div style="width: 100%; text-align: right">' . AppHelper::money_format('%i', $value) . '</div>';
						$totalData[$key] += floatval($value);
					} else if (in_array($key, ['dispute'])) {
						if ($provide[$org_id][$key] <= 0) $provide[$org_id][$key] = '';
						else $provide[$org_id][$key] = '<div style="width: 100%; text-align: right"><span style="color: red">(' . AppHelper::money_format('%i', $value) . ')</span></div>';
						$totalData[$key] += floatval($value);
					}
				}
			}
			ksort($provide);
			$provide = array_values($provide);
			$sortAttributes = ['id' => 'id', 'supplier' => 'supplier', 'invoice_payable' => 'invoice_payable', 'dispute' => 'dispute', 'confirm_payable' => 'confirm_payable', 'to_xero' => 'to_xero', 'finish_percent' => 'finish_percent'];
			$sortNumberAttributes = $sortAttributes;

			$sql = 'SELECT charge_code AS id, SUM(actual_amount) AS total, (SELECT name FROM chargecode WHERE code = charge_code) AS code, charge_code FROM hvlv_top.billing_line WHERE billing_cref IN ("' . implode('","', $nos) . '") AND status = 3 GROUP BY charge_code';
			$rs = Yii::app()->db->createCommand($sql)->queryAll();
			foreach ($rs as $k => $v) {
				$rs[$k]['total'] = '<div style="width: 100%; text-align: right">' . AppHelper::money_format('%i', $rs[$k]['total']) . '</div>';
			}
			usort($rs, function ($a, $b) {
				return $a['code'] > $b['code'];
			});
			$sortAttributes2 = ['total', 'code', 'charge_code'];
			$sortNumberAttributes2 = $sortAttributes2;
			$dataprovider2 = $reportService->preDataProvider($filtersForm, $rs, $sortAttributes2, $sortNumberAttributes);
			Yii::app()->name = $app_name;
		} else if ($type == 9&&empty($cacheData)) {
			$criteria = new CDbCriteria;

			$criteria->addCondition("t.eta >= '" . $dateFrom . "'");
			$criteria->addCondition("t.eta <= '" . $dateTo . "'");
			if (!empty($wid)) {
				$criteria->addCondition("t.dpt_id = '" . $wid . "'");
			}
			$criteria->addCondition("t.status < 100");
			$criteria->addCondition("t.owner_id != 114"); // remove pca express owner which is for WMS 3PL local dilivery
			$criteria->addInCondition('type', [15, 70, 80]);
			$consols = Consol::model()->findAll($criteria);
			$consols = $this->consolFilter($consols, $client_id);

			$provide = $this->sortByDepot($consols);
			$totalData = $this->getTotalDataByOthers($consols, $provide);
			$sortAttributes = ['Depot' => 'depot', 'shipments' => 'shipments', 'weight' => 'weight', 'revenue' => 'revenue', 'cost' => 'cost', 'gp' => 'gp', 'profit Rate' => 'profit_rate'];
			$sortNumberAttributes = ['weight' => 'weight', 'revenue' => 'revenue', 'cost' => 'cost', 'gp' => 'gp'];
		} else if (empty($cacheData)){
			$courier_id = isset($_GET['courier']) ? $_GET['courier'] : 0;
			$consol_no = isset($_GET['consol']) ? $_GET['consol'] : 0;
			$totalData = ['revenue' => 0, 'cost' => 0, 'gp' => 0, 'profit' => 0];
			$pt = [$wid, $dateFrom, $dateTo, 10, '', $client_id, $courier_id, $consol_no];
			if ($type == 5) {
				$filtersForm1 = new FiltersForm1;
				if (isset($_GET['FiltersForm1'])) {
					$filtersForm1->filters = $_GET['FiltersForm1'];
				}

				$provides = $reportService->getZoneData($pt, $filtersForm, $filtersForm1);
				$dataprovider = $provides[0];
				$dataprovider1 = $provides[1];
				$sortAttributes = $provides[2];
				$sortAttributes1 = $provides[3];

				$this->renderPartial('im_pl_rpt_partial', ['model' => $dataprovider, 'model1' => $dataprovider1, 'filter1' => $filtersForm1, 'filter' => $filtersForm, 'total' => $totalData, 'attributes' => $sortAttributes, 'attributes1' => $sortAttributes1], false, true);
				return;
			} elseif ($type == 6) {
				$pt[4] = 'we';
				$provide = $reportService->_plWeightQuery($pt, '', 'weight', 'rev DESC');
				$sortAttributes = ["Weight_Step" => "Weight_Step", "Shipments" => "shipments", "Total Weight(KG)" => "weight", "Dispersion_Percentage" => "Dispersion_Percentage"];
				$sortNumberAttributes = ["Total Weight(KG)" => "weight"];
			}
		}

		if(empty($cacheData))
		{
			$cacheData = [];
			$cacheData['totalData'] = $totalData;
			$cacheData['sortAttributes'] = $sortAttributes;
			$cacheData['totalData'] = $totalData;
			$cacheData['provide'] = $provide;
			if(isset($sortNumberAttributes))
			{
				$cacheData['sortNumberAttributes'] = $sortNumberAttributes;
			}
			$reportService->setCacheData($cacheKey,json_encode($cacheData),86400);
		}

		$dataprovider = $reportService->preDataProvider($filtersForm, $provide, $sortAttributes, $sortNumberAttributes);
		if(empty($withoutRender))
		{
			$this->renderPartial('im_pl_rpt_partial', ['model' => $dataprovider, 'filter' => $filtersForm, 'total' => $totalData, 'attributes' => $sortAttributes, 'model2' => @$dataprovider2], false, true);
		}
	}

