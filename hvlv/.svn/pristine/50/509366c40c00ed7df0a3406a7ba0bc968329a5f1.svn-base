		$model=new ImcoConsol('search');
		$unpackteam = User::currentUserOrgId();	
		if(!empty($unpackteam)){
			$model2 = Consol::model()->with('process')->findAll(['condition'=>'eta <= :nextthreedays AND service = :service AND eta >= :pastthreedays AND JSON_VALUE(process.meta,"$.unpacking_team") = :unpackteam', 'params'=>[':nextthreedays' => $nextthreedays, ':pastthreedays' => $pastthreedays, ':unpackteam' => $unpackteam,":service"=>Consol::SEACONSOL], 'order'=>'eta ASC, JSON_VALUE(process.meta,"$.unpack_status") ASC']);
