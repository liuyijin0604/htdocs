	public function actionUploadContainerPhotos()
	{
		$consolId = $_GET['id'];
		$consol = Consol::model()->findByPk($consolId);
		// print_r($_FILES);
		// Yii::app()->end();
		if(isset($_FILES['seal_file'])){
			$this->uploadContainerPhotos($_FILES['seal_file'],FileRepo::UNPACK_CONTAINER_SEAL_PHOTO,$consol,"seal");
		}
		else{
			echo 'Fail';
			return ;
		}		
		if(isset($_FILES['container_front_file'])){
			$this->uploadContainerPhotos($_FILES['container_front_file'],FileRepo::UNPACK_CONTAINER_FRONT_PHOTO,$consol,"container_front");
		}
		else{
			echo 'Fail';
			return ;
		}
		if(isset($_FILES['container_back_file'])){
			$this->uploadContainerPhotos($_FILES['container_back_file'],FileRepo::UNPACK_CONTAINER_BACK_PHOTO,$consol,"container_back");
		}
		else{
			echo 'Fail';
			return ;
		}
		if(isset($_FILES['process_100_file'])){
			$this->uploadContainerPhotos($_FILES['process_100_file'],FileRepo::UNPACK_CONTAINER_100PROCESS_PHOTO,$consol,"process_100");
		}
		else{
			echo 'Fail';
			return ;
		}
		if(isset($_FILES['process_0_file'])){
			$this->uploadContainerPhotos($_FILES['process_0_file'],FileRepo::UNPACK_CONTAINER_0PROCESS_PHOTO,$consol,"process_0");
		}
		else{
			echo 'Fail';
			return ;
		}
		if(isset($_FILES['container_left_file'])){
			$this->uploadContainerPhotos($_FILES['container_left_file'],FileRepo::UNPACK_CONTAINER_LEFT_PHOTO,$consol,"container_left");
		}
		if(isset($_FILES['container_right_file'])){
			$this->uploadContainerPhotos($_FILES['container_right_file'],FileRepo::UNPACK_CONTAINER_RIGHT_PHOTO,$consol,"container_right");
		}
		if(isset($_FILES['process_50_file'])){
			$this->uploadContainerPhotos($_FILES['process_50_file'],FileRepo::UNPACK_CONTAINER_50PROCESS_PHOTO,$consol,"process_50");
		}
		if(isset($_FILES['extra_file'])){
			// $total = count($_FILES['extra_file']['name']);
			$this->uploadExtraInfoPhotos($_FILES['extra_file'],FileRepo::UNPACK_CONTAINER_EXTRA_PHOTO,$consol,"extra_info");			
		}
		if(!isset($consol->process->mdata['unpack_status'])||$consol->process->mdata['unpack_status']=='0'){
			$consol->process->mdata['unpack_status'] = '1';
			$consol->process->updateMeta();
		}

		echo 'done';
	}

	public function uploadExtraInfoPhotos($f,$type,$consol,$pname=null){
		$total = count($f['name']);
		$i = 0;

		foreach ($f['name'] as $key => $value) {
			$filename = $f['tmp_name'][$key];
			$name = $f['name'][$key];
			if(empty($name)) return "empty files";
			$namearr = explode('.', $name);
			$name = $consol->no."_".$pname."_".$i.".".end($namearr);

			$hash = FileRepo::uploadHash($consol, $type);
			if(!is_uploaded_file($filename)) return false;
			$thisHash = $hash;
			$filesize = filesize($filename);
			$date = date('Y-m-d H:i:s');
			$fileHash = hash_file('crc32b', $filename).hash('crc32b', $filesize);
			$finfo = finfo_open(FILEINFO_MIME_TYPE);
			$mime = finfo_file($finfo, $f['tmp_name'][$key]);
			$fr = Service::updateUploadSingleFile($filesize,$date,$fileHash,$finfo,$mime,$filename,$name, $thisHash,false,false,false,true,FileRepo::ACTIVE);
			$i++;
		}
	}

	public function uploadContainerPhotos($file,$type,$consol,$pname=null)
	{
		$f = $file;
		$filename = $f['tmp_name'];
		$name = $f['name'];
		if(empty($name)) return "empty files";
		$namearr = explode('.', $name);
		$name = $consol->no."_".$pname.".".end($namearr);

		$hash = FileRepo::uploadHash($consol, $type);
		if(!is_uploaded_file($filename)) return false;
		$thisHash = $hash;
		$filesize = filesize($filename);
		$date = date('Y-m-d H:i:s');
		$fileHash = hash_file('crc32b', $filename).hash('crc32b', $filesize);
		$finfo = finfo_open(FILEINFO_MIME_TYPE);
		$mime = finfo_file($finfo, $f['tmp_name']);
		$fr = Service::updateUploadSingleFile($filesize,$date,$fileHash,$finfo,$mime,$filename,$name, $thisHash,false,false,false,true,FileRepo::ACTIVE);
		return true;
	}
}
