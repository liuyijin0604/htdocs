		else{
			$model2 = [];
		}	

		// $model2 = Consol::model()->with('process')->findAll(['condition'=>'eta <= :nextthreedays AND service = :service AND eta >= :pastthreedays', 'params'=>[':nextthreedays' => $nextthreedays, ':pastthreedays' => $pastthreedays, ":service"=>Consol::SEACONSOL], 'order'=>'eta ASC, JSON_VALUE(process.meta,"$.unpack_status") ASC']);

		// if(!empty($model2)){
		// 	$model->id = array_column($model2,'id');
		// }
		// else{
		// 	$model = null;
		// }		

		// if (isset($_GET['ImcoConsol'])) {
		// 	$model->attributes=$_GET['ImcoConsol'];
		// }
		// $delivery_type='All Type';
		// if (!empty($_GET['delivery_type'])) {
		// 	$model->service=$_GET['delivery_type'];
		// 	switch ($_GET['delivery_type']) {
		// 				case 10: $delivery_type='Air';break;
		// 				case 20: $delivery_type="Sea";break;
		// 			}
		// }

		$filtersForm=new FiltersForm;
		if (isset($_GET['FiltersForm'])) {
			$filtersForm->filters=$_GET['FiltersForm'];
