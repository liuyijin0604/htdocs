<?php

class APILog
{
	public $fromInfo;
	private $appName;
	public function __construct($appName,$type)
	{
		$this->appName = $appName;
		if(empty($type)||$type=='SYD'||$type==Org::TLA_DEPARTMENT_SYDNEY)
		{
			$this->fromInfo=[
				'suburb'=>"BANKSTOWN AERODROME",
				'postcode'=>"2200",
				'address'=>"1/233 Milperra Rd",
				'state'=>"NSW"
			];
		}elseif($type=='MEL'||$type==Org::TLA_DEPARTMENT_MELBOURNE)
		{
			$this->fromInfo=[
				'suburb'=>"Sunshine",
				'postcode'=>"3020",
				'address'=>"3B/8 Judge St",
				'state'=>"VIC"
			];
		}elseif($type=='BNE'||$type==Org::TLA_DEPARTMENT_BRISBANE)
		{
			$this->fromInfo=[
				'suburb'=>"Coopers Plains",
				'postcode'=>"4108",
				'address'=>"6/55 Musgrave Rd",
				'state'=>"QLD"
			];
		}elseif($type=='PER'||$type==Org::TLA_DEPARTMENT_PERTH)
		{
			$this->fromInfo=[
				'suburb'=>"Welshpool",
				'postcode'=>"6106",
				'address'=>"Warehouse, 8 Glenferrie Road",
				'state'=>"WA"
			];
		}
	}
	public function log2file($m, $file='ELabel',$folder = '')
	{
		if(!empty($folder))
		{
			$lf = Yii::app()->basePath.DIRECTORY_SEPARATOR.'runtime'.DIRECTORY_SEPARATOR . $this->appName . DIRECTORY_SEPARATOR. $folder . DIRECTORY_SEPARATOR;
		}else
		{
			$lf = Yii::app()->basePath.DIRECTORY_SEPARATOR.'runtime'.DIRECTORY_SEPARATOR . $this->appName . DIRECTORY_SEPARATOR;
		}

		$lf .= $this->appName.'_api_'.$file. date('Y-m-d') . '.log';
		return file_put_contents($lf, $m."\n"."\n"."\n", FILE_APPEND);
	}

	public function getFromInfo()
	{
		return $this->fromInfo;
	}

	public static function getRequestUrl2($endpoint, $params = [],$domain="")
	{

		if ($params) {
			$endpoint .= '?';
			foreach ($params as $k => $v) {
				$endpoint .= $k . '=' . $v . '&';
			}
		}

		return $endpoint;
	}


	public static function get($endpoint, $params = [])
	{
		// Set the curl parameters.
		$ch = curl_init();
		curl_setopt($ch, CURLOPT_URL, self::getRequestUrl2($endpoint, $params));
		curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, false);
		curl_setopt($ch, CURLOPT_SSL_VERIFYHOST, false);
		curl_setopt($ch, CURLOPT_POST, false);
		curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);

		$httpResponse = curl_exec($ch);
		curl_close($ch);

		if (!$httpResponse) {
			return false;
		}

		return $httpResponse;
	}
}

?>