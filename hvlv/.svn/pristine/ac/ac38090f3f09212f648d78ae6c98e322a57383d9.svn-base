		<?php echo CHtml::submitButton('Save'); ?>
	</div>


<?php $this->endWidget(); ?>
</div><!-- form -->


<script type="text/javascript">
$(function(){
	var tab = $('#<?=$_GET["tabid"];?>');
	var panel = tab.data('panel');
      var changeToSea=function(){
       $("label[for='DmawbConsol_awb']",panel).html('Ocean Bill<span class="required">*</span>');
       $("label[for='DmawbConsol_flight']",panel).html('Voyage<span class="required">*</span>');
       $("label[for='DmawbConsol_airline']",panel).html('Vessel id(IMO)<span class="required">*</span>');
       //House Billing Of Landing
     }
         $(".air_type",panel).hide();
        var awb="<?=$model->awb?>";
        if(awb.match(/\d{3}\-\d{8}/i)&&$("#ImcoConsol_service",panel).val()!=20){
          $(".air_type",panel).show();
         }
         $("#DmawbConsol_service",panel).off('change').on('change',function(){
             let awb=$(this).val();
             if(awb.match(/\d{3}\-\d{8}/i)&&$("#ImcoConsol_service",panel).val()!=20){
                  $(".air_type",panel).show();
             }else{
                 $(".air_type",panel).hide(); 
             }
         });
     
     var changeToAir=function(){
             $("label[for='DmawbConsol_awb']",panel).html('AWB No.');
             $("label[for='DmawbConsol_flight']",panel).html('Flight No.');
             $("label[for='DmawbConsol_airline']",panel).html('Airline');
    }
	$('form#dmawb_ov_consol-form', panel).on('success', function(e, r){
		tab.load();
	});
          $('.sea-input-fileds',panel).hide();
        <?php if(@$model->service==20):?>
            $('.sea-input-fileds',panel).show();
             $('.air-input-fileds',panel).hide();
             changeToSea();
        <?php endif;?>
       $('#DmawbConsol_service',panel).on('change',function(e,r){
          if($(this).val()==10){
              $('.sea-input-fileds',panel).hide();
              $('.air-input-fileds',panel).show();
              changeToAir();
          }else{
              $('.sea-input-fileds',panel).show();
              $('.air-input-fileds',panel).hide();
              changeToSea();
           }
        });
          $(".lcl_type",panel).hide();
        <?php if(@$model->mdata['cargo_type']=="LCL"):?>
             $(".lcl_type",panel).show(); 
        <?php endif;?>
          $('.sea_type',panel).on('change',function(){
              if($(this).val()=='LCL'){
                $(".lcl_type",panel).show();
             }else{
                $(".lcl_type",panel).hide();
             }
          }
      );
      
      	$('#DmawbConsol_status', panel).next().on('dblclick', function(){
		if(window.confirm('Are you sure to override status?')){
			$(this).prev().attr('disabled', false);
		}
	});
        var addr=<?=json_encode(DmawbConsol::$cargo_receip_address)?>;
        $('#mdata_delivery_address',panel).on('change',function(){
           var address=addr[$(this).val()];
           if(address){
               $('#mdata_cargo_receipt_addr',panel).val(address);
           }

        });
    
       $(".sea_type").on('change',function(){
          if($(this).val()=="LCL")
          {
            $(".lcl_type").show();
          }else if($(this).val()=="FCL")
          {
             $(".lcl_type").hide();
          }
       });
      
       var addr=<?=json_encode(DmawbConsol::$available_address)?>;
        $('#mdata_goods_available_address',panel).on('change',function(){
           var address=addr[$(this).val()];
           if(address){
             var theAddress = address.split('| ')[1];
             $('#mdata_arrival_cfs',panel).val(theAddress);
           }else
           {
              $('#mdata_arrival_cfs',panel).val("");
           }
        }); 
         
});
</script>