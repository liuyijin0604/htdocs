          <?php echo CHtml::label('Customs Duties & Fees (AUD)','for_item'); ?>
          <?php echo CHtml::textField('mdata[inv_item_cdty_sea]', @$model->mdata['inv_item_cdty_sea'], array('size'=>20)); ?>
        </div>
