   </div> -->
    <div class="row">
      <div class="rowcol rowleft">
            <?php

                  echo '<a class="jqm_link" data-win-class="XL" href="org/orgFlexibleRateForConsol/' . $model->id . '.app"><div style="background-position:-16px 0" class="icon"></div>' . $this->t('Org Flexible Rate') . '</a>';
                    
            ?>
          <div class="rowcol rowright">
            <label class="radio_label">  <?php echo CHtml::checkBox('mdata[not_apply_org_flexible_rate]',@$model->mdata['not_apply_org_flexible_rate']); ?> Don't Apply Org Flexible Rate  </label>
          </div>
      </div>
  </div>

