	// 	return false;
	// });

	$('.sf_btn', panel).click(function() {
		if (confirm('Are you sure to send SF lodgement?')) {
			$(this).hide();
			$.get('<?=$this->createUrl("imcoConsol/sFManifest", ["id" => $model->id]);?>', maniResult);
