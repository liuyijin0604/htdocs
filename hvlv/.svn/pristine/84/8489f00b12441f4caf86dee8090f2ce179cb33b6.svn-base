<!DOCTYPE html>
<html>

<head>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>
    <title>Cargo Booking System</title>
</head>

<body>
    <center>
        <h1>Cargo Booking System</h1>
    </center> 
    <div id="cargo-tabs">
        <ul class="nav nav-tabs">
            <?php
            $tabs = [];
            $tabs[] = ['booking_list', $this->t('Booking List'), true];
            $tabs[] = ['rejected_list', $this->t('Rejected List'), true];
            $tabs[] = ['create_booking', $this->t('New Booking'), true];
            $tabs[] = ['create_booking_without_hbn', $this->t('New Booking(Without HBN)'), true];

            foreach ($tabs as $key => $tab) {
                $href = strpos($tab[0], '/') === false ? $this->createUrl('cargoBooking/processPage', array('tab' => $tab[0], "tabid" => "tab" . $key)) : $tab[0];
                if ($key == 1) {
                    echo '<li><a href="' . $href . '" class="active">' . $tab[1] . '&nbsp;<span class="badge" style="background-color: red;">'. $rejectedCount .'</span></a></li>';
                } else {
                    echo '<li><a href="' . $href . '" class="active">' . $tab[1] . '</a></li>';
                }
                
            }
            ?>
        </ul>
    </div>
    <script type="text/javascript">
        $(function() {
            $('#cargo-tabs').tabs({
                active: <?php echo empty($_GET['actab']) ? 0 : $_GET['actab']; ?>,
                load: function(event, ui) {
                    // posApp.ajaxifyForm(this);
                }
            });
        });
    </script>
</body>

</html>