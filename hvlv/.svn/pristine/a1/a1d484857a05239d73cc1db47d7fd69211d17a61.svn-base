<div class="unique-load" id='div_loading' style="display: none;">
        <span></span>
        <span></span>
        <span></span>
</div>


<script>
    function funcSearch() {
        $('#table_records').html('');
        $('#btn_search').attr('disabled', true);
        $('#div_loading').attr('style', '');
        listData = $('#report_consol_form').serializeArray();
        $.ajax({
            url: "<?=$this->createUrl("/ConsolReport/consolReportSearch");?>",
            data: listData,
            async: true,
            success: (data) => {
                $('#table_records').html(data);
            },
            complete: function() {
                $('#btn_search').attr('disabled', false);
                $('#div_loading').attr('style', 'display:none');
            }
        });
    }

</script>

