<?php
class ModelReport{
	private $strTimeFrom = null;
	private $strTimeTo = null;
	private $listStatus =[];
	private $listAirSea =[];
	private $strConsolId = null;
	private $strOwnerId = null;
	private $strState = null;
	private $strByUrgent = null;
	private $isSetCompleteTime = null; //mdata[ctn_comp_time]
	
	function __construct($strTimeFrom,$strTimeTo, $listStatus,$listAirSea,$strConsolId,$strOwnerId ,$strState,$strByUrgent,$isSetCompleteTime,$strAwb)
	{
		$this->strTimeFrom = $strTimeFrom;
		$this->strTimeTo = $strTimeTo;
		$this->listStatus = $listStatus;
		$this->listAirSea = $listAirSea;
		$this->strConsolId = $strConsolId;
		$this->strOwnerId = $strOwnerId;
		$this->strState = $strState;
		$this->strByUrgent = $strByUrgent;
		$this->isSetCompleteTime = $isSetCompleteTime;
		$this->strAwb =$strAwb;
	}
	
	
	public function funcRecords(){
		$listRecords = [];
		$timeStr = "";
		$strAwb = "";
		if(empty($this->strAwb))
		{
			$timeStr = ' and eta >="'.$this->strTimeFrom.'" and eta <= "'.$this->strTimeTo.'"';
		}
		if(!empty($this->strAwb)){
			$strAwb = ' and (awb = "'.$this->strAwb.'" or  container_no = "'.$this->strAwb.'")';
		}

		$consolIdSql = "select Distinct(consol_id) as consol_id from shipment where agent_id=".User::currentUserOrgId()." and consol_id>0";
		$consolIds =Yii::app()->db->createCommand($consolIdSql)->queryAll();
		$consolIds = join(',',array_column($consolIds,'consol_id'));
		$consolStr = "";
		if(!empty($consolIds))
		{
			$consolStr = " and id in ({$consolIds})";
		}else
		{
			$consolStr = " and id =-1";
		}
		$thisAgent = Org::model()->findByPk(User::currentUserOrgId());
		$strSqlJoinTable ='select id as id_consol,service,no,owner_id as consol_owner_id,service,awb,airline,pod,pol,etd,eta,JSON_UNQUOTE(JSON_EXTRACT(consol.meta, "$.container_no")) container_no,JSON_UNQUOTE(JSON_EXTRACT(consol.meta, "$.pickup")) consol_pickup,JSON_UNQUOTE(JSON_EXTRACT(consol.meta, "$.arrival_cfs")) arrival_cfs from consol  where  service is not null and service!=0 and status !='.ImcoConsol::Status_Cancelled.$timeStr.$strAwb.$consolStr;
	
		$listWhere =[];
		if(!empty($this->listAirSea)){
			$strSqlAirSea = 'service in ( ';
			foreach($this->listAirSea as $i=>$strAirSea){
				$strSqlAirSea.=$strAirSea;
				if($i != sizeof($this->listAirSea)-1){
					$strSqlAirSea.=',';
				}
			}
			$strSqlAirSea .= ' ) ';
			$listWhere[] = $strSqlAirSea;
		}
		
		// if(!empty($this->strOwnerId)){
		// 	$listWhere[] = 'org_code = "'. $this->strOwnerId.'"';
		// }
		// if(!empty($this->strOwnerId)){
		// 	$listWhere[] = 'shipment_org_code = "'. $this->strOwnerId.'"';
		// }
		
		if(!empty($this->strState)){
			$listWhere[] = 'pod = "'. $this->strState.'"';
		}
		
		if(!empty($this->strConsolId)){
			$listWhere[] = 'no like "%'.$this->strConsolId.'%"';
		}
		
		
		if(sizeof($listWhere) !=0){
			$strSqlWhere = ' where ';
			foreach($listWhere as $i=>$strWhere){
				$strSqlWhere.=$strWhere;
				if($i != sizeof($listWhere)-1){
					$strSqlWhere.=' and ';
				}
			}
			$strSqlJoinTable.=$strSqlWhere;
		}
		
		$listRows =Yii::app()->db->createCommand($strSqlJoinTable)->queryAll();
		
        foreach($listRows as $objRow){
			$objRecord = new stdClass;
			$objRecord->id = $objRow['id_consol'];
			$objRecord->customer = $thisAgent->name;
			$objRecord->service =  $objRow['service'];
			$objRecord->owner_id = $objRow['consol_owner_id'];
			$objRecord->agent_id = User::currentUserOrgId();

			$objRecord->no = $objRow['no'];
			// $objRecord->status = $objConsol->status;
			$objRecord->pod = $objRow['pod'];
			$objRecord->pol = $objRow['pol'];
			$objRecord->service = $objRow['service'];
			$objRecord->awb = $objRow['awb'];
			if($objRecord->service == Consol::SEACONSOL){
				$objRecord->awb = $objRow['container_no'];
			}
			$objRecord->arrival_cfs = $objRow['arrival_cfs'];
			$objRecord->airline = $objRow['airline'];
			$objRecord->etd = $objRow['etd'];
			$objRecord->eta = $objRow['eta'];
			$mawbNumber = $objRow['awb'];
            $bwtrunkRecords = Bwtrunk::model()->findAllByAttributes(array('MAWB_number' => $mawbNumber));
            $objRecord->cto_start = array();
			$objRecord->cto_finish = array();
			$objRecord->client_start = array();
			$objRecord->client_finish = array();
			if (!empty($bwtrunkRecords)) {
			    foreach ($bwtrunkRecords as $bwtrunkRecord) {
			        $objRecord->cto_start[] = $bwtrunkRecord->CTO_start;
			        $objRecord->cto_finish[] = $bwtrunkRecord->CTO_finish;
			        $objRecord->client_start[] = $bwtrunkRecord->Client_start;
			        $objRecord->client_finish[] = $bwtrunkRecord->Client_finish;
			    }
				usort($objRecord->cto_start, function ($a, $b) {
			    if ($a === null) {
			        return 1;
			    } elseif ($b === null) {
			        return -1;
			    }
			    return ($a <=> $b);
			});

				usort($objRecord->cto_finish, function ($a, $b) {
				    if ($a === null) {
				        return 1;
				    } elseif ($b === null) {
				        return -1;
				    }
				    return ($a <=> $b);
				});

				usort($objRecord->client_start, function ($a, $b) {
				    if ($a === null) {
				        return 1;
				    } elseif ($b === null) {
				        return -1;
				    }
				    return ($a <=> $b);
				});

				usort($objRecord->client_finish, function ($a, $b) {
				    if ($a === null) {
				        return 1;
				    } elseif ($b === null) {
				        return -1;
				    }
				    return ($a <=> $b);
				});				
			    
			} else {
              $objRecord->cto_start = null;
              $objRecord->cto_finish = null;
              $objRecord->client_start = null;
              $objRecord->client_finish = null;
            }


            $consol_no = $objRow['no'];
            $consol = Consol::model()->findByAttributes(array('no'=>$consol_no));
            $consol_id = $consol['id'];
            $consol_process = ConsolProcess::model()->findByAttributes(array('fid'=>$consol_id));

            $to_warehouse=@$consol_process->to_warehouse;
            
            if (empty($objRecord->client_finish)) {
			    // 将 $to_warehouse 赋值给 $objRecord->client_start[0]
			    $objRecord->client_finish[0] = $to_warehouse;
			}

            if (is_array($objRecord->client_finish) || $objRecord->client_finish instanceof Traversable) {

	            	foreach ($objRecord->client_finish as $key => $value) {
	            	if (empty($objRecord->client_finish[$key])&&!empty($to_warehouse)){
	            
		              $objRecord->client_finish[$key] =$to_warehouse;
		            }else if(empty($objRecord->client_finish[$key])&&empty($to_warehouse)){

		              $objRecord->client_finish[$key] = null;
		            }
	            }
            }
 
            if (empty($objRecord->client_start)) {
			    $objRecord->client_start[0] = $objRecord->client_finish[0];
			}
            if (is_array($objRecord->client_start) || $objRecord->client_start instanceof Traversable) { 
            	foreach ($objRecord->client_start as $index => $clientStart) {
            	if(empty($objRecord->client_start[$index])&&!empty($objRecord->client_finish[$index])){
            		
            		$objRecord->client_start[$index] =$objRecord->client_finish[$index];
            	}else if(empty($objRecord->client_start[$index])&&empty($objRecord->client_finish[$index])){

	              $objRecord->client_start[$index] = null;
	            }
            }
        }
        

        if (is_array($objRecord->cto_start) || $objRecord->cto_start instanceof Traversable) {
            	 foreach ($objRecord->cto_start as $index => $ctoStart) {
			        // 检查对应索引处的值是否存在于其他数组中
			    if (isset($objRecord->client_finish[$index])) {
			        // 获取对应索引处的日期时间值
			        $clientFinish = $objRecord->client_finish[$index];
			        $ctoFinish = $objRecord->cto_finish[$index];
			        $clientStart = $objRecord->client_start[$index];
			        // 将日期时间值转换为DateTime对象
			        $clientFinishDateTime = new DateTime($clientFinish);
			        $ctoStartDateTime = new DateTime($ctoStart);
			        

			        // 计算两个日期时间值之间的差异（以分钟为单位）
			        //$diff = $ctoStartDateTime->diff($clientFinishDateTime)->i;
			        $diff = $ctoStartDateTime->diff($clientFinishDateTime); 
                    $diffMinutes = ($diff->h * 60) + $diff->i;
			        // 如果差异小于等于5分钟，则将对应索引处的值设置为null
			        if ($diffMinutes <= 5) {
			            $objRecord->cto_start[$index] = null;
			            $objRecord->cto_finish[$index] = null;
			            $objRecord->client_start[$index] = null;
			        }
			    }
			  }
            } 

            

            $consol_no = $objRow['no'];
            $consol = Consol::model()->findByAttributes(array('no'=>$consol_no));
            $consol_id = $consol['id'];
            $consol_process = ConsolProcess::model()->findByAttributes(array('fid'=>$consol_id));
            $consol_process_id = @$consol_process['id'];


           
			$earliestLog = Log::model()->find([
			    "condition" => "lid=:lid AND model=:model and (meta LIKE '%PICK UP%'
			        or meta LIKE '%Notified Driver%'
			        or meta LIKE '%WH scan%'
			        or meta LIKE '%AirOut/Manifest%'
			        or meta LIKE '%created Invoice%'
			        or meta LIKE '%Consol Process done%'
			        or meta LIKE '%NOA_Email%')",
			    "params" => [':lid' => $consol_process_id, ':model' => 'ConsolProcess'],
			    "order" => "time ASC"
			]);

			if ($earliestLog) {
			    $objRecord->checkin = $earliestLog->time;
			} else {
			    $objRecord->checkin = null;
			}

			// $objRecord->discharge = date("Y-m-d", strtotime('+2 day', strtotime($objConsol->eta)));
			// add 1 day for air ， 2 day for sea
			if($objRecord->service == Consol::AIRCONSOL){
				$objRecord->discharge = date("Y-m-d", strtotime('+1 day', strtotime($objRow['eta'])));
			}
			else{
				$objRecord->discharge = date("Y-m-d", strtotime('+2 day', strtotime($objRow['eta'])));
			}
			
			$objRecord->pickup = null;
			$objRecord->unpack = null;
			$objRecord->days_pickup = null;
			$objRecord->days_unpack = null;
 
			if($objRecord->service == Consol::SEACONSOL){
				if($objRecord->pod != Consol::POD_AUSYD){
					$objRecord->pickup = date("Y-m-d", strtotime('+2 day', strtotime($objRecord->discharge)));
					$objRecord->days_pickup = 2;
				}
			}

			if(!empty($objRow['consol_pickup'])){
				$objRecord->pickup = $objRow['consol_pickup'];
				$objRecord->days_pickup = floor((strtotime($objRecord->pickup )-strtotime($objRecord->discharge))/86400);
			}

			if($objRecord->days_pickup <0){
				$objRecord->pickup = $objRecord->discharge;
				$objRecord->days_pickup = 0;
			}

            $consol_no = $objRow['no'];
            $consol = Consol::model()->findByAttributes(array('no'=>$consol_no));
            $consol_id = $consol['id'];

            $shipments = [];

            if(!empty($objRecord->client_finish)&& is_array($objRecord->client_finish)){
            	foreach ($objRecord->client_finish as $cKey => $client_finish) {

                $shipment = Shipment::model()->find([
                    "condition" => 'consol_id = :consolId and json_value(meta,"$.scan_time") is not null and json_value(meta,"$.scan_time") > :Client_Finish',
                    "params" => [":consolId" => $consol_id, ":Client_Finish" => $client_finish],
                    "order" => 'json_value(meta,"$.scan_time") ASC']);
                if ($shipment != null) {
                 	$shipments[] = $shipment;
                }else
                {   
                	if (!empty($objRecord->cto_start[$cKey])) {
                	$shipment = Shipment::model()->find([
                    "condition" => 'consol_id = :consolId and json_value(meta,"$.scan_time") is not null and json_value(meta,"$.scan_time") > :Client_Finish',
                    "params" => [":consolId" => $consol_id, ":Client_Finish" => $objRecord->cto_start[$cKey]],
                    "order" => 'json_value(meta,"$.scan_time") ASC']);
                	}
                	
					if($shipment!=null)
					{
						$shipments[] = $shipment;
					}else{$shipments=null;}
                }
             }
          }else{
          	$shipments=null;
         }
           

           

            if(!empty($shipments)){
            	$objRecord->unpack = [];
            	foreach ($shipments as $shipment) {
                        $objRecord->unpack[] = $shipment->getScanTime();
                }
               sort($objRecord->unpack); 
            }else{
            	$objRecord->unpack = null;
            }
         
            $consol_no = $objRow['no'];
            $consol = Consol::model()->findByAttributes(array('no'=>$consol_no));
            $consol_id = $consol['id'];
            $unpacktime = !empty($objRecord->unpack) ? $objRecord->unpack[0] : '0000-00-00 00:00:00';           

			$gatepassShipmentTime = GatepassShipment::model()->find(array(
			    'select' => 'MIN(gate_pass_time) as gate_pass_time',
			    'join' => 'JOIN shipment ON shipment.id = t.fid',
			    'condition' => 'shipment.consol_id = :consolId AND gate_pass_time != "0000-00-00 00:00:00"AND gate_pass_time > :unpackTime',
			    'params' => array(
			    	':consolId' => $consol_id,
                    ':unpackTime' => $unpacktime,
			),
			));

			if (!empty($gatepassShipmentTime)&&!empty($objRecord->unpack)) {
			    $objRecord->gatepasstime = $gatepassShipmentTime->gate_pass_time;

			    // Check if there are multiple records
			    $count = GatepassShipment::model()->count(array(
			        'join' => 'JOIN shipment ON shipment.id = t.fid',
			        'condition' => 'shipment.consol_id = :consolId AND gate_pass_time != "0000-00-00 00:00:00"',
			        'params' => array(':consolId' => $consol_id),
			    ));

			    if ($count > 1) {
			        if (strtotime($objRecord->gatepasstime) < strtotime("2001-01-01 00:00:00")) {
			            $objRecord->gatepasstime = null;
			        }
			    } else {
			        // Only one record, display the earliest time
			        $objRecord->gatepasstime = $gatepassShipmentTime->gate_pass_time;
			    }
			   

			} else {
			    $objRecord->gatepasstime = null;
			}
		
			if($objRecord->days_pickup === null){
				$objRecord->days_pickup = floor((strtotime(date("Y-m-d") )-strtotime($objRecord->discharge))/86400);
			}
			if($objRecord->days_unpack === null){
				$objRecord->days_unpack = floor((strtotime(date("Y-m-d") )-strtotime($objRecord->discharge))/86400);
			}
			
			
			$listRecords[] = $objRecord;
			
			
		}
		
		// Filter
		// $listRecords = $this->funcFilterServiceSeaAir($listRecords);
		// $listRecords = $this->funcFilterPolAUSYD($listRecords);
		// $listRecords = $this->funcFilterDischarge($listRecords);
		// $listRecords = $this->funcFilterSYD($listRecords);
		// $listRecords = $this->funcFilterSeaNoArrival_cfs($listRecords);
		// $listRecords = $this->funcFilterOrg3494($listRecords);
		// $listRecords = $this->funcLocalArrivalFilter($listRecords);
		
		 

		// sort
		$dicDays2ListRecords=[];
		foreach($listRecords as $i=>$objRecord){
			$numDays = $objRecord->days_pickup + $objRecord->days_unpack ;
			if(!isset($dicDays2ListRecords[$numDays])){
				$dicDays2ListRecords[$numDays] = [];
			}
			$dicDays2ListRecords[$numDays][] = $objRecord;
		}
		
		if($this->strByUrgent=='asc'){
			ksort($dicDays2ListRecords);
		}
		else{
			krsort($dicDays2ListRecords);
		}
		
		$listResult=[];
		foreach($dicDays2ListRecords as $i=>$ListRecords){
			foreach($ListRecords as $j=>$objRecord){
				$listResult[] = $objRecord;
			}
		}
		
		return $listResult;		
	}
	
	private function funcLocalArrivalFilter($listConsol){
		if(sizeof($listConsol)==0){
			return $listConsol;
		}
		$listResult =[];
		$listConsolId = [];
		$dicConsolId2IsLocalArrival=[];
		foreach ($listConsol as $i=> $objConsol){
			$listConsolId[]=$objConsol->id;
			$dicConsolId2IsLocalArrival[$objConsol->id]= false;
		}
		
		$strSql = 'consol_id in ( ';
		foreach ($listConsolId as $i=>$strConsolId){
			$strSql.=$strConsolId;
			if($i != sizeof($listConsolId) -1){
				$strSql .= ',';
			}
		}
		$strSql .= ' )';
		
		$listShipmentId = [];
		$dicShipment2IsLocalArrival=[];
		$listImparcel = ImParcel::model()->findAll($strSql);
		foreach($listImparcel as $i=>$objImparcel){

			$listShipmentId[] = $objImparcel->id;
			$dicShipment2IsLocalArrival[$objImparcel->id] = false;
		}
		
		if(sizeof($listShipmentId)==0){
			return $listConsol;
		}
		$strSql = 'lid in ( ';
		foreach ($listShipmentId as $i=>$strShipmentId){
			$strSql.=$strShipmentId;
			if($i != sizeof($listShipmentId) -1){
				$strSql .= ',';
			}
		}

			$strSql .= ' ) and meta like "%Local%"';	
		$listLog = Log::model()->findAll($strSql);
		foreach($listLog as $i=>$objLog){
			$dicShipment2IsLocalArrival[$objLog->lid] = true;
		}
		
		foreach($listImparcel as $i=>$objImparcel){
			if($dicShipment2IsLocalArrival[$objImparcel->id]){
				$dicConsolId2IsLocalArrival[$objImparcel->consol_id]= true;
			}
		}
		
		foreach ($listConsol as $i=> $objConsol){
			if(!$dicConsolId2IsLocalArrival[$objConsol->id]){
				$listResult[]=$objConsol;
			}
		}
		
		return $listResult;
	}
	
	
	private function funcFilterSYD($listConsol){
		$listResult =[];
		foreach ($listConsol as $i=> $objConsol){
			$strStart = substr($objConsol->no,0,3);
			$strEnd = substr($objConsol->no,-3);
			
			if($strEnd=="SYD" && $strStart != 'TDW' ){
				
			}
			else{
				$listResult[]=$objConsol;
			}
		}
		
		return $listResult;
	}
	
	
	// exclude 3494 Top Logistics IMPORTS-CASUAL CUSTOMER-Clearance Only
	private function funcFilterOrg3494($listConsol){
		$listResult =[];
		foreach ($listConsol as $i=> $objConsol){
			if($objConsol->agent_id != 3494 && $objConsol->owner_id != 3494){
				$listResult[]=$objConsol;
			}
		}
		return $listResult;
	}
	
	private function funcFilterDischarge($listConsol){
		$listResult =[];
		foreach ($listConsol as $i=> $objConsol){
			$numDays = null;
			if($objConsol->service == Consol::AIRCONSOL){
				if(empty($objConsol->discharge)){
					$numDays = -1;
				}
				else{
					$numDays = floor((strtotime(date("Y-m-d") )-strtotime(date("Y-m-d",  strtotime($objConsol->discharge))))/86400);
				}
			}
			else{
				$numDays = floor((strtotime(date("Y-m-d") )-strtotime(date("Y-m-d", strtotime($objConsol->discharge))))/86400);
			}
			if($numDays >=0){
				$listResult[]=$objConsol;
			}
		}
		
		
		return $listResult;
	}
	
	private function funcFilterSeaNoArrival_cfs($listConsol){
		$listResult =[];
		foreach ($listConsol as $i=> $objConsol){
			if($objConsol->service == Consol::SEACONSOL && empty($objConsol->arrival_cfs)){

			}
			else{
				$listResult[] = $objConsol;
			}
		}
		
		
		return $listResult;
	}

	private function funcFilterServiceSeaAir($listConsol){
		$listResult =[];
		foreach ($listConsol as $i=> $objConsol){
			if($objConsol->service == Consol::SEACONSOL || $objConsol->service == Consol::AIRCONSOL){
				$listResult[] = $objConsol;
			}
		}
		return $listResult;
	}

	private function funcFilterPolAUSYD($listConsol){
		$listResult =[];
		foreach ($listConsol as $i=> $objConsol){
			if($objConsol->pol != 'AUSYD'){
				$listResult[] = $objConsol;
			}
		}
		return $listResult;
	}

	public function funcListRecords2HTML($listRecords){
		
		$strHtml ='<table class="items"><thead><tr><th>Customer</th><th>No.</th><th>State</th><th>Air/Sea</th><th>awb/container_no</th><th>Airline/Vessel</th><th>ETD</th><th>ETA</th><th>Discharge</th><th>Pickup</th><th>Unpack</th></tr></thead><tbody id="table_records">';
		$strHtml .=$this->funcListRecords2Tbody($listRecords);
		$strHtml .='</tbody></table>';
		return $strHtml;
	}
	
	public function funcListRecords2Tbody($listRecords,$isShowLink = false ){
		$dicPort2State = [
			'AUSYD' => 'NSW',
			'AUMEL' => 'VIC',
			'AUBNE' => 'QLD',
			'AUPER' => 'WA',
			'AUADL' => 'SA',
			'AUFRE' => 'WA',

		];
		$strHtml = '';
		foreach ($listRecords as $i => $objRecord) {
			$strHtml .= '<tr class="' . ($i % 2 == 0 ? 'odd' : 'even') . '">';
			
			$strHtml .= '<td>' . $dicPort2State[$objRecord->pod] . '</td>';
			
			$strService = Imcoconsol::$services[$objRecord->service];
			$strHtml .= '<td>' . $strService. '</td>';
			$strHtml .= '<td>' . $objRecord->awb . '</td>';
			
			$strHtml .= '<td>' . ($objRecord->etd ? date("d/m/Y H:i", strtotime($objRecord->etd)) : '') . '</td>';
            $strHtml .= '<td>' . ($objRecord->eta ? date("d/m/Y H:i", strtotime($objRecord->eta)) : '') . '</td>';
			$strHtml .= '<td>' .($objRecord->checkin ? date("d/m/Y H:i", strtotime($objRecord->checkin)) : '').'</td>';
			
			if (is_array($objRecord->cto_start)) {
				$count = count($objRecord->cto_start);
				$strHtml .= '<td>';
			    foreach ($objRecord->cto_start as $key=> $time) {

			        if($time!=null){
			    		$strHtml .='<span>'.date("d/m/Y H:i", strtotime($time)).'</span>';
			    	}else{
			    		$strHtml .= '<span style="display: inline-block; width: 100%; height: 20px; margin-bottom: 10px;">&nbsp;</span>';
			    	}
			        if($key < $count-1){
			        	$strHtml.='<hr style="border-top: 1px dashed #333; margin: 5px 0;">';
			        }
			    }
                $strHtml .= '</td>';
			} else {
			    $strHtml .= '<td>'.$objRecord->cto_start.'</td>';
			}
			
			if (is_array($objRecord->cto_finish)) {
				$count = count($objRecord->cto_finish);
				$strHtml .= '<td>';
			    foreach ($objRecord->cto_finish as $key=> $time) {
			        if($time!=null){
			    		$strHtml .='<span>'.date("d/m/Y H:i", strtotime($time)).'</span>';
			    	}else{
			    		$strHtml .= '<span style="display: inline-block; width: 100%; height: 20px; margin-bottom: 10px;">&nbsp;</span>';
			    	}
			          if($key < $count-1){
			        	$strHtml.='<hr style="border-top: 1px dashed #333; margin: 5px 0;">';
			        }
			    }
			    $strHtml .= '</td>';
			} else {
			    $strHtml .= '<td>'.$objRecord->cto_finish.'</td>';
			}
			if (is_array($objRecord->client_start)) {
				$count = count($objRecord->client_start);
				$strHtml .= '<td>';
			    foreach ($objRecord->client_start as $key=> $time) {
			    	if($time!=null){
			    		$strHtml .='<span>'.date("d/m/Y H:i", strtotime($time)).'</span>';
			    	}else{
			    		$strHtml .= '<span style="display: inline-block; width: 100%; height: 20px; margin-bottom: 10px;">&nbsp;</span>';
			    	}
			        if($key < $count-1){
			        	$strHtml.='<hr style="border-top: 1px dashed #333; margin: 5px 0;">';
			        }
			    }
			    $strHtml .= '</td>';
			} else {
			    $strHtml .= '<td>'.$objRecord->client_start.'</td>';
			}
			if (is_array($objRecord->client_finish)) {
				$count = count($objRecord->client_finish);
				$strHtml .= '<td>';
			    foreach ($objRecord->client_finish as $key=> $time) {
			        if($time!=null){
			    		$strHtml .='<span>'.date("d/m/Y H:i", strtotime($time)).'</span>';
			    	}else{
			    		$strHtml .= '<span style="display: inline-block; width: 100%; height: 20px; margin-bottom: 10px;">&nbsp;</span>';
			    	}
			         if($key < $count-1){
			        	$strHtml.='<hr style="border-top: 1px dashed #333; margin: 5px 0;">';
			        }
			    }
			    $strHtml .= '</td>';
			} else {
			    $strHtml .='<td>'.$objRecord->client_finish.'</td>';
			}
			
			// if (!empty($objRecord->unpack)) {
			// 	$strHtml .= '<td>'.date("d/m/Y h:m", strtotime($objRecord->unpack)).'</td>';
			// }
			if (is_array($objRecord->unpack)) {
				$count = count($objRecord->unpack);
				$strHtml .= '<td>';
			    foreach ($objRecord->unpack as $key=> $time) {
			        $strHtml .='<span>'.date("d/m/Y H:i", strtotime($time)).'</span>';
			        if($key < $count-1){
			        	$strHtml.='<hr style="border-top: 1px dashed #333; margin: 5px 0;">';
			        }
			    }
			    $strHtml .= '</td>';
			} else {
			    $strHtml .= '<td>'.$objRecord->unpack.'</td>';
			}
            $strHtml .= '<td>' .(!empty($objRecord->gatepasstime)?date("d/m/Y H:i", strtotime($objRecord->gatepasstime)) : '').'</td>';
		    
			$strHtml .= '</tr>';
		}
		
		$strHtml .='</tbody></table>';
		return $strHtml;
	}
	
	
	
	
}

