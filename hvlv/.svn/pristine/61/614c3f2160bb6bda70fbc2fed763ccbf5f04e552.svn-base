<!doctype html>
<html>
<head>
<meta charset="utf-8">
<title>SinoEx Logo</title>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/1/jquery.min.js" type="text/javascript"></script>
<style type="text/css">
* { box-sizing:border-box; }
body { margin: 0; padding: 0; font-family: Arial, sans-serif; }
.qbox {	width: 33.3%; padding: 2mm; float: left; text-align: center; height: 24mm; }
#tpl{ display: none; }
.l1{ font-size: 22px; line-height: 6mm; height: 6mm; text-align:center; overflow: hidden; }
.barcode{ font-family: IDAutomationC39M; font-size: 18px; height: 12mm; overflow: hidden; }
.clear{	clear:both;	page-break-after: always; }
@media print {
	@page {
		size: 210mm 297mm;
		margin: 0;
		padding: 0;
		margin-top: 10mm;
	}
}
</style>
</head>
<body>
<div id="tpl" class="qbox">
<img src="images/sinoex_logo.png" width="90%" />
</div>
</body>
<script type="text/javascript">

$(function(){
	var tpl = $('#tpl');
	var pp = 33;
	var i = 0;
	for(var l = 1; l <= pp; l++){
		box = tpl.clone().attr('id','');
		$('body').append(box.show());
		if(i > 1 && i % 33 == 0) $('body').append('<div class="clear"></div>');
		i++;
	}
});
</script>
</html>
