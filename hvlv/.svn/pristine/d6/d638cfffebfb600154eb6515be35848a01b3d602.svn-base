	public static function getPodSetting($pod = "",$key = false)
	{
		$regionName = self::getSetting("RegionName",$pod);//{"AU":"Australia","CN":"China","HK":"Hong Kong","TW":"Taiwan","NZ":"New Zealand","VN":"Vietnam"}
		$result = self::getSetting($pod.'POD',$key);////{"TWACH":["Hsin-chuang","KHH"],"TWANG":["Nangang","KHH"]}
		$result[0] = $result[0].", ".$regionName;
		return $result;
	}

