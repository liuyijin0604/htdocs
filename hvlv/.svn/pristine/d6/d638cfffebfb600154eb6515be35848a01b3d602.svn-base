	public static function getSetting($key1,$key2 = false)
	{
		// $rulesData = Yii::app()->cache->get($key1); // caching the system setting
		// if(!empty($rulesData))
		// {
		// 	$rulesData = json_decode($rulesData,true);
		// 	if(!empty($key2))
		// 	{
		// 		return @$rulesData[$key2];
		// 	}

		// 	return $rulesData;
		// }

		$rules = self::model()->find(' `key` = :key ',[":key"=>$key1]);
		if(!empty($rules))
		{
			Yii::app()->cache->set($key1,json_encode($rules->mdata),3000);
			if(!empty($key2))
			{
				return @$rules->mdata[$key2];
			}

			return $rules->mdata;
		}else
		{
			return [];
		}
	}

