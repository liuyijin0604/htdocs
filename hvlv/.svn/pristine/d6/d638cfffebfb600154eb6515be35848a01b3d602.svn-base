	/**
	 * @return array validation rules for model attributes.
	 */
	public function rules()
	{
		// NOTE: you should only define rules for those attributes that
		// will receive user inputs.
		return array(
			array('key, meta, uid, date', 'required'),
			array('uid', 'numerical', 'integerOnly'=>true),
			array('key', 'length', 'max'=>45),
			// The following rule is used by search().
			// @todo Please remove those attributes that should not be searched.
			array('id, key, meta, uid, date', 'safe', 'on'=>'search'),
		);
	}

	/**
	 * @return array relational rules.
	 */
	public function relations()
	{
		// NOTE: you may need to adjust the relation name and the related
		// class name for the relations automatically generated below.
		return array(
		);
	}

	/**
	 * @return array customized attribute labels (name=>label)
	 */
	public function attributeLabels()
	{
		return array(
			'id' => 'ID',
			'key' => 'Key',
			'meta' => 'Meta',
			'uid' => 'Uid',
			'date' => 'Date',
		);
	}

	/**
	 * Retrieves a list of models based on the current search/filter conditions.
	 *
	 * Typical usecase:
	 * - Initialize the model fields with values from filter form.
	 * - Execute this method to get CActiveDataProvider instance which will filter
	 * models according to data in model fields.
	 * - Pass data provider to CGridView, CListView or any similar widget.
	 *
	 * @return CActiveDataProvider the data provider that can return the models
	 * based on the search/filter conditions.
	 */
	public function search()
	{
		// @todo Please modify the following code to remove attributes that should not be searched.

		$criteria=new CDbCriteria;
		$criteria->compare('id',$this->id);
		$criteria->compare('t.`key`',$this->key,true);
		$criteria->compare('meta',$this->meta,true);
		$criteria->compare('uid',$this->uid);
		$criteria->compare('date',$this->date,true);

		$sort = new CSort(get_called_class());
		$sort->defaultOrder='t.id DESC';

		return new CActiveDataProvider($this, array(
			'criteria'=>$criteria,
			'sort'=>$sort,
		));
	}


	public static function getCargoProcessCRules()//{"c1":{"minimum":"70","costCBM":"20","minimumIncludeCBM":"3.5","freeKM":"30","extraFeeKM":"1","fuelCharge":"4"}}
	{
		$cRule = self::model()->find(' `key` = :key ',[":key"=>'cargoProcess']);
		$results = [];
		foreach ($cRule->mdata as $key => $value) {
			$results[$key] = $key;
		}
		return $results;
	}

	public static function getCargoProcessRuleSetting($ruleKey)
	{
		$rules = self::model()->find(' `key` = :key ',[":key"=>'cargoProcess']);
		return $rules->mdata[$ruleKey];
	}

	public static function getAupostFuelChargeSetting()//
	{
		// $rules = self::model()->find(' `key` = :key ',[":key"=>'AupostFuelCharge']);//{"2019-10":2.2,"2019-09":2.1,"2019-08":2.5,"2019-07":2.3,"2019-06":2.2,"2019-05":1.8,"2019-04":1.5,"2019-03":1.6,"2019-02":2.5,"2019-01":3}
		$rules = self::getSetting('AupostFuelCharge');
		if (is_array($rules)) {
			$rules = new SystemSetting;
			$rules->mdata = self::getSetting('AupostFuelCharge');
		}
		krsort($rules->mdata);
		return $rules->mdata;
	}

	public static function setAupostFuelChargeSetting($data)
	{
		$rules = self::model()->find(' `key` = :key ', [':key' => 'AupostFuelCharge']);
		$rules->mdata[$data['month']] = $data['rate'];
		$rules->updateMeta();
	}

	public static function deleteAupostFuelChargeSetting($month)
	{
		$rules = self::model()->find(' `key` = :key ', [':key' => 'AupostFuelCharge']);
		unset($rules->mdata[$month]);
		$rules->updateMeta();
	}

