	public static function getDateWorkTime($key = false)
	{
		$rulesData = Yii::app()->cache->get('dateWorkingTime');
		if(empty($key))
		{
			return $rulesData;
		}else
		{
			return $rulesData[$key];
		}
	}

	public static function setDateWorkTime($date,$workingTime)
	{
		$rulesData = Yii::app()->cache->get('dateWorkingTime');
		$rulesData[$date] = $workingTime;
		Yii::app()->cache->set('dateWorkingTime',$rulesData);
	}


	public static function getDFERequestTimes($prefix = "")
	{
		$timesArr = Yii::app()->cache->get('DFERequestTimes'.$prefix);
		return $timesArr['times'];
	}

	public static function setDFERequestTimes($times,$prefix)
	{
		$timesArr = Yii::app()->cache->get('DFERequestTimes'.$prefix);
		if(empty($timesArr['date'])||$timesArr['date']!=date('Y-m-d'))
		{
			$timesArr['times'] = 1;
			$timesArr['date'] = date('Y-m-d');
		}else
		{
			$timesArr['times'] = $times;
		}
		Yii::app()->cache->set('DFERequestTimes'.$prefix,$timesArr);
	}

	public static function setTNTResponse($data,$key)
	{
		$allData = [];
		$data = json_encode($data);
		$allData['data'] = $data;
		$allData['time'] = date('Y-m-d');
		$saver = json_encode($allData);
		Yii::app()->cache->set('tnt_resp:'.$key,$saver);
		return true;
	}

	public static function getTNTResponse($key)
	{
		$allData = json_decode(Yii::app()->cache->get('tnt_resp:'.$key),true);
		if(!empty($allData))
		{
			if(strtotime($allData['time'])<strtotime('-3 day',strtotime(date('Y-m-d'))))
			{
				return [];
			}else
			{
				return json_decode($allData['data'],true);
			}
		}
		return [];
	}


	public static function setConsolTotCost($data)
