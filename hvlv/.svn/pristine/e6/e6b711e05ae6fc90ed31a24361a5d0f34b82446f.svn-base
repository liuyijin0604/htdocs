	public function genCode()
	{
		if (empty($this->name)) {
			return '';
		}
		$w = preg_split('/ +/', $this->name);
		if (sizeof($w) > 1) {
			$c = $w[0][0] . $w[1][0];
		} else {
			$c = $w[0][0] . $w[0][1];
		}
		$s = self::model()->count('code LIKE :c', [':c' => $c . '%']);
		return strtoupper($c) . ($s + 1);
	}

	public function genHash()
	{
		return hash('crc32b', $this->name . rand(100000, 999999));
	}

	public function storeName()
	{
		return $this->pid > 0 ? $this->ret->code . ' ' . $this->name : $this->name;
	}

	public function getType()
	{
		return Yii::t(strtolower(__CLASS__), empty(self::$types[$this->type]) ? 'System' : self::$types[$this->type]);
	}

	public function getStatus()
	{
		return Yii::t(strtolower(__CLASS__), empty(self::$states[$this->status]) ? '' : self::$states[$this->status]);
	}

	public function getCargoDriverType()
	{
		$cdtStr = "";
		foreach (self::$cdts as $key => $value) {
			if (($key & $this->cargo_driver_type) > 0) {
				$cdtStr .= Yii::t(strtolower(__CLASS__), $value) . "      ";
			}
		}
		return $cdtStr;
	}

	public function getAddress($country = true, $ml = true, $br = true)
	{
		$a = $this->address;
		$a .= $ml ? ",\n" : ', ';
		$a .= $this->suburb . ' ' . $this->state . ' ' . $this->postcode;
		if ($country) {
			$a .= $ml ? ",\n" : ', ';
			$a .= $this->country;
		}
		return $br ? nl2br($a) : $a;
	}

	public function fullAddress($cs = [])
	{
		$cs = empty($cs) ? ['suburb', 'state', 'postcode', 'country'] : $cs;
		$fa = [];
		$addr = str_replace(',', ', ', $this->address);
		foreach ($cs as $c) {
			if ($c == 'address') {
				continue;
			}
			$fa[] = $this->{$c};
			//$addr = str_ireplace($this->{$c},'', $addr);
		}
		if (!in_array('country', $cs)) {
			$addr = str_ireplace($this->country, '', $addr);
		}
		return preg_replace('/[ ]*,[, ]+/', ', ', $addr . ', ' . implode(', ', $fa));
	}

	public function getOwner()
	{
		if ($this->owner) {
			return $this->owner->name;
		} else {
			return Yii::t(strtolower(__CLASS__), 'System');
		}
	}

	public static function listSupplier($t = [13, 14], $short = false)
	{
		if (is_array($t)) {
