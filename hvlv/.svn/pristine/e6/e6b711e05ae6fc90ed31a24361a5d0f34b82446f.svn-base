	public static function tList($t)
	{
		if (is_array($t)) {
			$rs = self::model()->findAll('status =1 AND type IN (' . implode(',', $t) . ')');
		} else {
			$rs = self::model()->findAll('status =1 AND type = ' . $t);
		}
		$a = [];
		foreach ($rs as $r) {
			$a[$r->id] = $r->name;
		}
		return $a;
	}

	public function contactList($func)
	{
		$rt = [];
		foreach ($this->contacts as $c) {
			if ($c->func & 1 > 0) {
				$rt[] = $c;
			}
		}
		return $rt;
	}

	public function termList($t = false)
	{
		$ts = [];
		if ($t) {
			$ts[$t] = $t;
		}
		if (!empty($this->extra['payterm'])) {
			$pts = explode("\n", $this->extra['payterm']);
			foreach ($pts as $pt) {
				if (empty($pt) || in_array($pt, $ts)) {
					continue;
				}
				$ts[$pt] = $pt;
			}
		}
		return $ts;
	}

	public function shortName($l = 1)
	{
		$n = explode(' ', $this->name);
		return implode(' ', array_slice($n, 0, $l));
	}

