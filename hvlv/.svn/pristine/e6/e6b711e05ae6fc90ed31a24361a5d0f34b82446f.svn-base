		} else {
			$rs = self::model()->findAll('status = 1 AND type = :t ORDER BY name', [':t' => $t]);
		}
		$rt = [];
		foreach ($rs as $r) {
			$rt[$r->id] = $short === false ? $r->name : $r->shortName($short);
