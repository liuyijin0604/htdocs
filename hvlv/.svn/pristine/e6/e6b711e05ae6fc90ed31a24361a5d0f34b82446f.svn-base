	 */
	public static function model($className = __CLASS__)
	{
		return parent::model($className);
	}

	/**
	 * get related WMS quote by quote index
	 * @param $quoteIndex
	 */
	public function getWmsQuote($quoteIndex)
	{
		if (empty($this->wmsQuotes)) {
			$this->wmsQuotes = WmsOrgQuote::getOrgQuotes($this->id);
		}
		if (empty($this->wmsQuotes)) {
			return -1; // org wms quote not set or no valid one
		}

		if (!isset($this->wmsQuotes[$quoteIndex])) {
			return -2; // specified quote index not existing
		}

		$quote = $this->wmsQuotes[$quoteIndex];

		return $quote;
	}

	/**
	 * @return string the associated database table name
	 */
	public function tableName()
	{
		return 'org';
	}

	public $extra = [];

	/**
	 * @return array validation rules for model attributes.
	 */
	public function rules()
	{
		// NOTE: you should only define rules for those attributes that
		// will receive user inputs.
		return [
			['type, name, country,phone,email', 'required'],
			['pid, status, address, suburb, postcode, code, accode, email, phone, fax, abn, desc, state, meta, manager, nln, hash', 'safe'],
			['type, status, by', 'numerical', 'integerOnly' => true],
			['name, address', 'length', 'max' => 255],
			['suburb, country', 'length', 'max' => 100],
			['abn, code, accode', 'length', 'max' => 30],
			['lat, lng', 'numerical'],
			['postcode', 'length', 'max' => 10],
			['phone, fax', 'length', 'max' => 50],
			// The following rule is used by search().
			// Please remove those attributes that should not be searched.
			['id, pid, type, name, code, accode, abn, address, suburb, state,oids, postcode, country, email, phone, fax, desc, status, meta, by, manager,nln, hash,lat, lng, cargo_driver_type', 'safe', 'on' => 'search'],
		];
	}

	/**
	 * @return array relational rules.
	 */
	public function relations()
	{
		// NOTE: you may need to adjust the relation name and the related
		// class name for the relations automatically generated below.
		return [
			'contacts' => [self::HAS_MANY, 'OrgContact', 'org_id', 'on' => 'contacts.status > 0'],
			'users' => [self::HAS_MANY, 'User', 'org_id'],
			'sales' => [self::BELONGS_TO, 'User', 'manager'],
			'owner' => [self::BELONGS_TO, 'Org', 'by'],
			'parent' => [self::BELONGS_TO, 'Org', 'pid'],
			'childs' => [self::HAS_MANY, 'Org', 'by'],
			'zoneMap' => [self::HAS_MANY, 'ZoneMap', 'org_id'],
			'banks' => [self::HAS_MANY, 'OrgBankAccount', 'org_id'],
		];
	}

	/**
	 * save to Xero as well
	 */
	public function afterSave()
	{
		// in case save to Xero system as well
		if ($this->sync_xero) {
			if (in_array($this->type, [30, 50, 60, 65, 70])) {
				$this->save2Xero();
			}
		}
		if (!$this->nolog) {
			Log::add($this, $this->isNewRecord ? 3 : 4);
		}

		// check DDP process
		if ((!empty($this->extra['creditlimit']) && $this->getCurrentCreditOfLimit() < 1) || (!empty($this->extra['credit_ext_date']) && strtotime($this->extra['credit_ext_date']) > time())) {
			$shipments = Shipment::model()->findAll('agent_id = :aid AND bwf & ' . ImParcel::CUSTOM_DDP . ' > 0', [':aid' => $this->id]);
			foreach ($shipments as $shipment) {
				if (!empty($shipment->process) && $shipment->process->status == ShipmentProcess::INFROM_CUSTOMER_PAY) {
					$shipment->process->changeStatus(ShipmentProcess::CONFIRM_PAYMENT);
				}
			}
		}

		return parent::afterSave();
	}

	/**
	 * sync all Org data with Xero system
	 */
	private function save2Xero()
	{
		$contact = new XeContact();
		$contact->name = $this->name;
		$contact->contactNumber = 'PORG-' . $this->id;
		$contact->accountNumber = 'PORG-' . $this->id;
		$contact->taxNumber = $this->abn;
		if (filter_var($this->email, FILTER_VALIDATE_EMAIL)) {
			$contact->emailAddress = $this->email;
		}
		$address = new XeAddress();
		$address->addressType = XeAddress::AT_POBOX; //billing address
		$address->addressLine1 = $this->address;
		$address->city = $this->suburb;
		$address->region = $this->state;
		$address->postalCode = $this->postcode;
		$contact->addresses->add($address);
		if (!empty($this->phone)) {
			$phone = new XePhone();
			$phone->phoneCountryCode = '+61';
			$phone->phoneNumber = $this->phone;
			$contact->phones->add($phone);
		}
		if (!empty($this->fax)) {
			$fax = new XePhone();
			$fax->phoneType = 'FAX';
			$fax->phoneNumber = $this->fax;
			$contact->phones->add($fax);
		}
		try {
			$rt = $contact->save();
			if (!$rt) {
				Yii::app()->xero->log('Failed to save Org - ' . $this->id, Xero::LOG_LEVEL_ERR);
			}
		} catch (Exception $ecp) {
			$msg = 'Failed to save org - ' . $ecp->getMessage();
			$msg .= PHP_EOL;
			$msg .= 'Org Data : ' . json_encode($contact, JSON_PRETTY_PRINT);
			Yii::app()->xero->log($msg, Xero::LOG_LEVEL_ERR);
		}
	}

	/**
	 * get Xero xml data from single contact object
	 * @param $org
	 * @return mixed
	 */
	public static function getXeroXmlData(&$org)
	{
		$contact = new XeContact();
		$contact->name = $org->name;
		//$contact->firstName = 'Michael';
		//$contact->lastName = 'Yue';
		$contact->contactNumber = 'PORG-' . $org->id;
		$contact->accountNumber = 'PORG-' . $org->id;
		$contact->taxNumber = $org->abn;
		$contact->emailAddress = $org->email;
		$address = new XeAddress();
		$address->addressType = XeAddress::AT_POBOX; //billing address
		$address->addressLine1 = $org->address;
		$address->city = $org->suburb;
		$address->region = $org->state;
		$address->postalCode = $org->postcode;
		$contact->addresses->add($address);
		if (!empty($org->phone)) {
			$phone = new XePhone();
			$phone->phoneCountryCode = '+61';
			$phone->phoneNumber = $org->phone;
			$contact->phones->add($phone);
		}
		if (!empty($org->fax)) {
			$fax = new XePhone();
			$fax->phoneType = 'FAX';
			$fax->phoneNumber = $org->fax;
			$contact->phones->add($fax);
		}
		return $contact->getXmlData();
	}

	public function getPackageNums()
	{
	}
	/**
	 * sync all Orgs to Xero
	 */
	public static function sync2Xero()
	{
		$MAX_LOOP_ITEMS = 40;
		$orgs = self::model()->findAll('status = 1 AND type in (30,50,60,65,70)');

		$bulkXmlData = '';
		$index = 0;
		foreach ($orgs as $org) {
			$bulkXmlData .= self::getXeroXmlData($org);
			if ($index++ >= $MAX_LOOP_ITEMS) {
				self::bulkSaveOrg2Xero($bulkXmlData);
				$index = 0;
				$bulkXmlData = '';
			}
		}

		if (!empty($bulkXmlData)) {
			self::bulkSaveOrg2Xero($bulkXmlData);
		}
	}

	private static function bulkSaveOrg2Xero(&$data)
	{
		$bulkXmlData = '<?xml version="1.0"?><Contacts>';
		$bulkXmlData .= $data;
		$bulkXmlData .= '</Contacts>';
		$xecontacts = new XeContacts();
		try {
			$xecontacts->setEndPoint('Contacts');
			$rt = $xecontacts->bulkSave($bulkXmlData);
			if (!$rt) {
				Yii::app()->xero->log('Failed to sync Orgs unkown reason', Xero::LOG_LEVEL_ERR);
			}
		} catch (Exception $ecp) {
			$msg = 'Failed to sync all Orgs - ' . $ecp->getMessage();
			Yii::app()->xero->log($msg, Xero::LOG_LEVEL_ERR);
		}
	}

	public function hasUser($id, $sub = true)
	{
		$u = User::model()->findByPk($id);
		if (!$u) {
			return false;
		}
		if ($this->id == $u->org_id) {
			return true;
		}
		if ($sub && $u->org->by == $this->id) {
			return true;
		}
		return false;
	}

	public static function fwdList()
	{
		return self::tList([30, 50]);
	}

	public static function dptList($t = [20, 25])
	{
		$a = self::tList($t);
		foreach ($a as $k => $v) {
			$a[$k] = trim(str_replace('Warehouse', '', $v));
		}
		return $a;
	}

	public static function dptList3PL($t = [20, 25])
	{
		$a = self::tList($t);
		foreach ($a as $k => $v) {
			if (!preg_match('/syd/i', $v) && !preg_match('/mel/i', $v) && !preg_match('/bri/i', $v)) {
				unset($a[$k]);
				continue;
			}
			$a[$k] = trim(str_replace('Warehouse', '', $v));
		}
		return $a;
	}

	public static function ownerList()
	{
		return self::tList([15, 30, 50, 60]);
