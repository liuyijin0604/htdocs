	public function getLabelNumber()
	{
		$v = '@nln_'.$this->id."_".hash('crc32b', microtime().rand(0, 999999));
		Yii::app()->db->createCommand('UPDATE org SET nln=(' . $v . ':=nln)+1 WHERE id=:id')->bindValue(":id", $this->id)->execute();

		return Yii::app()->db->createCommand('SELECT ' . $v . ';SET ' . $v . '=NULL;')->queryScalar();
	}

	public function meTo($by)
	{
		$waste = false;
		if ($this->id == 3) { //meport
			$rs = self::model()->findAll('status = 1 AND t.by = :b AND t.type = :t', [':b' => $by, ':t' => 30]);
		} else {
			switch ($this->type) {
				case 30: //station
					$rs = self::model()->findAll('status = 1 AND t.by = :b AND t.type = :t', [':b' => $by, ':t' => 31]);
					break;
				case 31: //slauther
					$rs = self::model()->findAll('status = 1 AND t.by = :b AND t.type = :t', [':b' => $by, ':t' => 32]);
					break;
				case 32: //warehouse
					$rs = self::model()->findAll('t.id = 6');
					break;
			}
			$waste = self::model()->findByPk(4);
		}
		$o = [];
		foreach ($rs as $r) {
			$o[$r->id] = $r->name;
		}
		if ($waste) {
			$o[$waste->id] = Yii::t(strtolower(__CLASS__), $waste->name);
		}
		return $o;
	}

	public function beforeSave()
	{
		if(!empty(User::getCurrentUser()))
		{
			if (!User::checkIsNotTruckUser()) {
				$this->by = User::getCurrentUser()->org_id;
			}
		}
		if (empty($this->by)) {
			$this->by = 1;
		}
		if (empty($this->code)) {
			$this->code = $this->genCode();
		}
		if (empty($this->hash)) {
			$this->hash = $this->genHash();
		}
		if (!empty($this->email)) {
			$emls = preg_split('/[;,\s]+/', $this->email);
			if (count($emls) > 1) {
				foreach ($emls as $k => $eml) {
					$emls[$k] = (string) filter_var($eml, FILTER_VALIDATE_EMAIL);
				}
				$this->email = implode(';', $emls);
			} else {
				$this->email = (string) filter_var($this->email, FILTER_VALIDATE_EMAIL);
			}
		}
		foreach (['outturn_email', 'client_billing_email'] as $extra_key) {
			if (!empty($this->extra[$extra_key])) {
				$emls = preg_split('/[;,\s]+/', $this->extra[$extra_key]);
				if (count($emls) > 1) {
					foreach ($emls as $k => $eml) {
						$emls[$k] = (string) filter_var($eml, FILTER_VALIDATE_EMAIL);
					}
					$this->extra[$extra_key] = implode(';', $emls);
				} else {
					$this->extra[$extra_key] = (string) filter_var($this->extra[$extra_key], FILTER_VALIDATE_EMAIL);
				}
			}
		}
		$this->meta = json_encode($this->extra);
		return true;
	}

	/**
	 * get consumables sell mode
	 * 0 - free
	 * 1 - not free
	 * @return int
	 */
	public function getCgSellModel()
	{
		// currently we save consumables price setting in the sell type table
		// if ( isset($this->extra['cg_sell_model']) ) {
		//     return $this->extra['cg_sell_model'];
		// }
		$ratesInfo = SellRate::getCgoodsRates($this->id);
		return $ratesInfo['found'] ? 1 : 0;
	}

	public function afterFind()
	{
		$this->extra = json_decode($this->meta, true);

		// for Import Client we give some initial credit settings if not set yet before
		if (in_array($this->type, [30, 50, 60, 65])) {
			if (!isset($this->extra['wthreshold'])) {
				$this->extra['wthreshold'] = 5;
			}
		}

		if (!isset($this->extra['credit_init_date'])) {
			$this->extra['credit_init_date'] = date('Y-m-d');
		}
		if (!isset($this->extra['creditlimit'])) {
			$this->extra['creditlimit'] = 1;
		}
		if (!isset($this->extra['creditterms'])) {
			$this->extra['creditterms'] = 1; // credit
		}

		return true;
	}

	public function rUpdate($d)
	{
		if ($d->attr == 'meta') {
			$this->extra = json_decode($d->val, true);
		}
		$this->{$d->attr} = $d->val;
		$this->update([$d->attr]);
	}

	public function searchAll()
	{
		$criteria = new CDbCriteria;
		$criteria->compare('t.type', $this->type);
		$criteria->compare('t.id', '>5');
		return self::model()->findAll($criteria, ['sort' => ['t.name ASC']]);
	}

	public function getWarehouseList()
	{
		$r = Yii::app()->cache->get('OrgWarehouseList_' . $this->id);
		if (!empty($r)) {
			return $r;
		}
		$r = [];
		if (empty($this->extra['warehouse'])) {
			return $r;
		}
		foreach ($this->extra['warehouse'] as $k) {
			$w = self::model()->findByPk($k);
			$r[$k] = $w->name;
		}

		Yii::app()->cache->set('OrgWarehouseList_' . $this->id, $r, 1800);

		return $r;
	}

	public function creditBlock()
	{
		return empty($this->extra['creditlimit']) ? false : floatval($this->extra['creditlimit']) < 0;
	}

	public function overCreditLimit()
	{
		if (!empty($this->extra['credit_lock'])) {
			return true;
		}

		if (empty($this->extra['credit_action'])) {
			return false;
		}

		// return false; //temporarily turn credit check off;
		if (!empty($this->extra['credit_ext_date']) && strtotime($this->extra['credit_ext_date']) > time()) {
			return false;
		}
		if (date('N') > 5 || (date('N') == 5 && date("H") > 18)) {
			return false;
		} // from Friday 18:00 to Monday, can print labels
		$ool = Yii::app()->cache->get('ORG_OVERLIMIT_' . $this->id);
		if (!empty($ool)) {
			return $ool;
		}
		Yii::app()->name = "TLA";
		$limit = empty($this->extra['creditlimit']) ? 1 : floor($this->extra['creditlimit']);
		$term = empty($this->extra['creditterms']) ? 1 : intval($this->extra['creditterms']);
		$start = empty($this->extra['credit_init_date']) ? '1900-01-01' : date('Y-m-d', strtotime($this->extra['credit_init_date']));
		if (isset($this->extra['credit_payment_method']) && $this->extra['credit_payment_method'] == 1) {
			/*Option 2 payment method
			 * 22th<=day<7th, consider the  <16th invoice of the last month.
			 * 7th<=day<22th, consider the <1th invoice of the this month.*/
			$considerDue = date('d') < 7 ? date('Y-m-16', strtotime("-1 month")) : date('Y-m-01');
			$sql = "SELECT SUM(total) FROM `invoice` WHERE to_id= " . $this->id . " AND status IN(2,3,7) AND date >='" . $start . "' AND date <'" . $considerDue . "'";
			$hasInvoiceNotPaid = Yii::app()->db_tla->createCommand($sql)->queryScalar();
			$ool = $hasInvoiceNotPaid > 0;
			Yii::app()->cache->set('ORG_OVERLIMIT_' . $this->id, $ool, 600);
			Yii::app()->name = "HVLV";
			return $ool;
		} else {
			/* The Default payment method, when the term due or invoice amount over credit, return true*/
			$sql = "SELECT id FROM `invoice` WHERE to_id=" . $this->id . " AND status IN(2,3,7) AND date< DATE_SUB(CURDATE(), INTERVAL " . $term . " DAY) AND date >= '" . $start . "' ORDER BY date ASC";
			$hasOverTermInvoice = Yii::app()->db_tla->createCommand($sql)->queryScalar();
			if (!empty($hasOverTermInvoice)) {
				$ool = true;
				Yii::app()->cache->set('ORG_OVERLIMIT_' . $this->id, $ool, 600);
				Yii::app()->name = "HVLV";
				return $ool;
			}
			$sql = "SELECT SUM(total) FROM invoice WHERE to_id = " . $this->id . " AND status IN(2,3) AND date >= '" . $start . "'";
			$totalOverdue = Yii::app()->db_tla->createCommand($sql)->queryScalar();
			if ($totalOverdue <= $limit) {
				$invoices = Invoice::model()->findAll("to_id = " . $this->id . " AND status = 7 AND date >= '" . $start . "'");
				foreach ($invoices as $r) {
					$totalOverdue += $r->getBalance();
				}
			}
			// $payments = Payment::model()->findAll('org_id = ' . $this->id . ' AND status = 6 AND ata > 0');
			// foreach ($payments as $r) {
			// 	$totalOverdue -= $r->ata;
			// }
			$ool = $totalOverdue >= $limit;
			Yii::app()->cache->set('ORG_OVERLIMIT_' . $this->id, $ool, 600);
			Yii::app()->name = "HVLV";
			return $ool;
		}
	}

	public function getCurrentCreditBalance()
	{
		Yii::app()->name= "TLA";
		$limit = empty($this->extra['creditlimit']) ? 1 : floor($this->extra['creditlimit']);
		if ($limit <= 0) {
			return false;
		}
		$totalOverdue = $this->getCurrentCreditTotalOverDue();
		return $limit-$totalOverdue;
	}

	public function getCurrentCreditTotalOverDue()
	{
		Yii::app()->name= "TLA";
		$limit = empty($this->extra['creditlimit']) ? 1 : floor($this->extra['creditlimit']);
		if ($limit <= 0) {
			return false;
		}
		$term = empty($this->extra['creditterms']) ? 1 : intval($this->extra['creditterms']);
		$start = empty($this->extra['credit_init_date']) ? '1900-01-01' : date('Y-m-d', strtotime($this->extra['credit_init_date']));
		$sql = "SELECT SUM(total) FROM invoice WHERE to_id = " . $this->id . " AND status IN(2,3)  AND date >= '" . $start . "'";
		$totalOverdue = Yii::app()->db_tla->createCommand($sql)->queryScalar();
		$invoices = Invoice::model()->findAll("to_id = " . $this->id . " AND status = 7 AND date >= '" . $start . "'");
		foreach ($invoices as $r) {
			$totalOverdue += $r->getBalance();
		}
		// $payments = Payment::model()->findAll('org_id = ' . $this->id . ' AND status = 6 AND ata > 0');
		// foreach ($payments as $r) {
		// 	$totalOverdue -= $r->ata;
		// }
		return $totalOverdue;
	}

	public function getCurrentCreditOfLimit()
	{
		Yii::app()->name= "TLA";
		$limit = empty($this->extra['creditlimit']) ? 1 : floor($this->extra['creditlimit']);
		if ($limit <= 0) {
			return false;
		}
		$totalOverdue = $this->getCurrentCreditTotalOverDue();
		if($totalOverdue==false)
		{
			return false;
		}
		// $totalOverdue = max(0, $totalOverdue);
		// echo $totalOverdue."\n";
		return $totalOverdue/ $limit;
	}

	public function getCurrentCreditLeft()
	{
		$limit = empty($this->extra['creditlimit']) ? 1 : floor($this->extra['creditlimit']);
		if ($limit <= 1) {
			return 0;
		}
		$start = empty($this->extra['credit_init_date']) ? '1900-01-01' : date('Y-m-d', strtotime($this->extra['credit_init_date']));
		$sql = "SELECT SUM(total) FROM invoice WHERE to_id = " . $this->id . " AND status IN(2,3)  AND date >= '" . $start . "'";
		$totalOverdue = Yii::app()->db->createCommand($sql)->queryScalar();
		$invoices = Invoice::model()->findAll("to_id = " . $this->id . " AND status = 7 AND date >= '" . $start . "'");
		foreach ($invoices as $r) {
			$totalOverdue += $r->getBalance();
		}
		// $payments = Payment::model()->findAll('org_id = ' . $this->id . ' AND status = 6 AND ata > 0');
		// foreach ($payments as $r) {
		// 	$totalOverdue -= $r->ata;
		// }
		$totalOverdue = max(0, $totalOverdue);
		return round($limit - $totalOverdue, 2);
	}

	public function getCurrentCreditTerm()
	{
		$term = empty($this->extra['creditterms']) ? 1 : intval($this->extra['creditterms']);
		$start = empty($this->extra['credit_init_date']) ? '1900-01-01' : date('Y-m-d', strtotime($this->extra['credit_init_date']));
		$sql = "SELECT date, no FROM `invoice` WHERE to_id=" . $this->id . " AND status IN(2,3,7) AND date >= '" . $start . "' ORDER BY date ASC";
		$invoice_oldest = Yii::app()->db->createCommand($sql)->queryRow(); //the oldedst unpaid invoice date;
		if (isset($invoice_oldest['date'])) {
			$inv_date = new DateTime($invoice_oldest['date'], new DateTimeZone('Australia/Sydney'));
			$inv_now = new DateTime('now', new DateTimeZone('Australia/Sydney'));
			$date = time(); // Change to whatever date you need
			$dotw = date('w', $date);
			$end = ($dotw == 7/* Friday */) ? $date : strtotime('next Sunday', $date);
			$inv_end = new DateTime(date('Y-m-d', $end), new DateTimeZone('Australia/Sydney')); //end of this week, sunday
			$daydiff = $inv_now->diff($inv_date)->format("%a");
			$daydiffend = $inv_end->diff($inv_date)->format("%a");
			if (isset($this->extra['credit_payment_method']) && $this->extra['credit_payment_method'] == 1) {
				$considerDue = new DateTime(date('d') < 7 ? date('Y-m-16', strtotime("-1 month")) : date('Y-m-01'), new DateTimeZone('Australia/Sydney'));
				$daydiffDue = $considerDue->diff($inv_date)->format('%a');
				return [intval(-$daydiffDue), $invoice_oldest['no'], $invoice_oldest['date'], intval($term - $daydiffend)];
			} else {
				return [intval($term - $daydiff), $invoice_oldest['no'], $invoice_oldest['date'], intval($term - $daydiffend)];
			}
		}
		return [$term, '', ''];
	}

	public function getCreditDetails()
	{
		$credit = [
			'limit' => 0,
			'balance' => 0,
			'terms' => 14,
			'left' => 14,
			'currency' => 'AUD',
			'balance_warning' => false,
			'left_warning' => false,
		]; // with default value
		if (isset($this->extra['creditlimit'])) {
			$credit['limit'] = floor($this->extra['creditlimit']);
		}
		if (isset($this->extra['creditterms'])) {
			$credit['terms'] = intval($this->extra['creditterms']);
		}
		if (isset($this->extra['credit_init_date'])) {
			$term_credit = $this->getCurrentCreditTerm();
			$credit['left'] = $term_credit[0];
		}
		if (isset($this->extra['currency']) && !empty($this->extra['currency'])) {
			$credit['currency'] = Invoice::$currencies[$this->extra['currency']];
		}

		// get credit balance
		// balance = limit - all unpaid invoice

		$credit['balance'] = isset($this->extra['creditlimit']) ? $this->getCurrentCreditBalance() :0;
		$percent = $this->getCurrentCreditOfLimit();
		if ($percent > 0.8) {
			$credit['balance_warning'] = true;
		}
		if ($credit['left'] <= 3) {
			$credit['left_warning'] = true;
		}

		$credit['percent'] = $percent;
		$credit['action'] = @$this->extra['credit_action'];

		return $credit;
	}

	/**
	 * get total of need pay invoice for the specified owner and warehouse
	 * @param $org
	 * @param $dptId
	 * @return mixed
	 */
	public function getOrgTotalNotPaidAmount($dptId = 0)
	{

		// get total of unpaid amount
		$sql = 'SELECT SUM(total) FROM invoice WHERE type = 10 AND status < 7 AND to_id = ' . $this->id;
		if ($dptId > 0) {
			$sql .= ' AND dpt_id = ' . $dptId;
		}
		$rt = Yii::app()->db->createCommand($sql);
		$total = $rt->queryScalar();

		// get total of partially paid amount
		$invs = Invoice::model()->findAll('type = 10 AND to_id = :id AND status = 7', [':id' => $this->id]);
		foreach ($invs as $inv) {
			// get patially paid amount
			$sql = 'SELECT SUM(amount) FROM pay_inv WHERE inv_id = ' . $inv->id;
			$rt = Yii::app()->db->createCommand($sql);
			$totalPaid = $rt->queryScalar();
			$total = $inv->total - $totalPaid;
		}

		return $total > 0 ? $total : 0;
	}

	/**
	 * Retrieves a list of models based on the current search/filter conditions.
	 * @return CActiveDataProvider the data provider that can return the models based on the search/filter conditions.
	 */
	public function search($pgn = true, $ps = 30, $ec = false)
	{
		// Warning: Please modify the following code to remove attributes that
		// should not be searched.

		$criteria = new CDbCriteria;

		if (!User::checkIsNotTruckUser()) {
			$this->by = User::getCurrentUser()->org_id;
		}
		$criteria->compare('t.id', $this->id);
		$criteria->compare('pid', $this->pid);
		$criteria->compare('t.type', '>1');
		$criteria->compare('t.type', $this->type);
		$criteria->compare('name', $this->name, true);
		$criteria->compare('code', $this->code, true);
		$criteria->compare('accode', $this->accode, true);
		$criteria->compare('abn', $this->abn, true);
		$criteria->compare('address', $this->address, true);
		$criteria->compare('suburb', $this->suburb, true);
		$criteria->compare('state', $this->state, true);
		$criteria->compare('postcode', $this->postcode, true);
		$criteria->compare('country', $this->country, true);
		$criteria->compare('email', $this->email, true);
		$criteria->compare('phone', $this->phone, true);
		$criteria->compare('fax', $this->fax, true);
		$criteria->compare('desc', $this->desc, true);
		$criteria->compare('status', $this->status);
		$criteria->compare('hash', $this->hash);
		if (!empty($this->cargo_driver_type)) {
			$criteria->addCondition(" (cargo_driver_type & {$this->cargo_driver_type}) > 0");
		}
		if (!empty($this->by) && empty($this->oids)) {
			$criteria->compare('t.by', $this->by);
		}
		if (!empty($this->oids)) {
			$criteria->addInCondition('t.id', $this->oids);
		}

		if (Yii::app()->name == 'PEP') {
			$criteria->addInCondition('t.type', [60, 65]);
		}

		if ($ec) {
			$criteria->mergeWith($ec);
		}

		return new CActiveDataProvider($this, [
			'criteria' => $criteria,
			'sort' => [
				'defaultOrder' => 't.name ASC',
			],
			'pagination' => $pgn ? [
				'pageSize' => $ps,
			] : false,
		]);
	}

	public function updateMeta()
	{
		$this->meta = json_encode($this->extra);
		$this->update(['meta']);
	}

	public function getOPName()
	{
		if (empty($this->extra['op_id'])) {
			return '';
		}
		$u = User::model()->findByPk($this->extra['op_id']);
		return empty($u) ? '' : $u->name;
	}

	public function getSPName()
	{
		if (empty($this->extra['sp_id'])) {
			return '';
		}
		$u = User::model()->findByPk($this->extra['sp_id']);
		return empty($u) ? '' : $u->name;
	}

	public static function getName($id, $code = true)
	{
		$org = self::model()->findByPk($id);
		if (!empty($org)) {
			if ($code) {
				return $org->code . ':' . $org->name;
			} else {
				return $org->name;
			}
		} else {
			return '';
		}
	}

	public function resetPassword()
	{
		$password = md5(date('YmdHis'));
		$this->extra['password'] = md5($password);
		$this->sync_xero = false;
		$this->save();

		Yii::log($password, 'warning', 'trace');

		return $password;
	}

	public function cgLimit()
	{
		// orders
		$orders = WmsTask::model()->findAll([
			'condition' => 'type = :type AND is_request = 1 AND meta like :org_id AND status in (20,30,99)',
			'params' => [
				':type' => array_search('CG Delivery', WmsTask::$types),
				':org_id' => '%"org":"' . $this->id . '"%',
			],
			'order' => 'id DESC',
		]);

		// total thermal and wrapper orded
		$thermal_total = 0;
		$wrapper_total = 0;
		$tape_total = 0;
		foreach ($orders as $order) {
			foreach ($order->items as $item) {
				if (preg_match('/热敏/', $item->mdata['sn'])) {
					$thermal_total += $item->mdata['uq'];
				} elseif (preg_match('/缠绕膜/', $item->mdata['sn'])) {
					$wrapper_total += $item->mdata['uq'];
				} elseif (preg_match('/透明胶带/', $item->mdata['sn'])) {
					$tape_total += $item->mdata['uq'];
				}
			}
		}

		// shipments
		if (!empty($order)) {
			$shipments1 = Shipment::model()->count('agent_id = :org_id AND created >= :order_time AND (hbn like \'%EAU%\' or hbn like \'%DAU%\') AND status > 10 AND status < 100', [':org_id' => $this->id, ':order_time' => $order->schd_time]);
			$shipments2 = Shipment::model()->count('agent_id = :org_id AND created >= :order_time AND status > 10 AND status < 100', [':org_id' => $this->id, ':order_time' => $order->schd_time]);
		} else {
			$shipments1 = 0;
			$shipments2 = 0;
		}

		if (empty($this->extra['thermal_credit'])) {
			$this->extra['thermal_credit'] = 0;
			$this->sync_xero = false;
			$this->save();
		}
		if (empty($this->extra['wrapper_credit'])) {
			$this->extra['wrapper_credit'] = 0;
			$this->sync_xero = false;
			$this->save();
		}
		if (empty($this->extra['tape_credit'])) {
			$this->extra['tape_credit'] = 0;
			$this->sync_xero = false;
			$this->save();
		}

		$thermal_prod = WmsProd::model()->find('status = 1 AND name like "%热敏面单%"');
		$wrapper_prod = WmsProd::model()->find('status = 1 AND name like "%缠绕膜%"');
		$tape_prod = WmsProd::model()->find('status = 1 AND name like "%透明胶带%"');
		$thermal_limit = empty($thermal_prod) ? 0 : floor(($thermal_total * floatval($thermal_prod->mdata['bqtf']) - $shipments1) / (floatval($thermal_prod->mdata['bqtf']) + 50));
		$thermal_limit = max($thermal_limit, 0);
		$wrapper_limit = empty($wrapper_prod) ? 0 : floor(($wrapper_total * floatval($wrapper_prod->mdata['bqtf']) - $shipments2) / floatval($wrapper_prod->mdata['bqtf']));
		$wrapper_limit = max($wrapper_limit, 0);
		$tape_limit = empty($tape_prod) ? 0 : floor(($tape_total * floatval($tape_prod->mdata['bqtf']) - $shipments2) / floatval($tape_prod->mdata['bqtf']));
		$tape_limit = max($tape_limit, 0);
		return ['thermal_limit' => $thermal_limit, 'wrapper_limit' => $wrapper_limit, 'tape_limit' => $tape_limit, 'thermal_credit' => $this->extra['thermal_credit'], 'wrapper_credit' => $this->extra['wrapper_credit'], 'tape_credit' => $this->extra['tape_credit'], 'shipments1' => $shipments1, 'thermal_total' => $thermal_total, 'shipments2' => $shipments2, 'wrapper_total' => $wrapper_total, 'tape_total' => $tape_total];
	}

	public function cgDiscount()
	{
		$discount = SellRate::model()->find('org_id = :org_id AND type = 25 AND (vfrom <= :date AND (vto >= :date OR vto is null))', [':org_id' => $this->id, ':date' => date('Y-m-d')]);
		return empty($discount) ? 0 : $discount->item;
	}

	public static function getDriverList($driverType = 0)
	{
		if ($driverType != 0) {
			$drivers = [];
			$byStr = "";
			$byStr .= " and `by` = " . User::getCurrentUser()->org_id;

			$orgs = self::model()->findAll("(cargo_driver_type & " . $driverType . ") > 0 and status = 1 " . $byStr);
		} else {
			$orgs = self::model()->findAll("(cargo_driver_type & " . self::ALL_DRIVER . ") > 0 and status = 1 ");
		}
		foreach ($orgs as $key => $org) {
			$drivers[$org->id] = $org->name;
		}
		return $drivers;
	}

	public static function getAllCouriers()
	{
		$allOrgs = self::model()->findAll(" id in (" . join(',', self::COURIERS) . ")");
		$result = [];
		foreach ($allOrgs as $key => $value) {
			$result[$value->id] = $value->name;
		}
		return $result;
	}

	public static function inVip()
	{
		if (!empty(self::model()->findByPk(Yii::app()->user->org)->extra['vipService'])) {
			return true;
		} else {
			return false;
		}
	}

	public static function isOurWarehouse($pod)
	{
		if (in_array($pod, self::$ourWarehouseList)) {
			return true;
		} else {
			return false;
		}
	}

	public function getBankAccount($url = true, $currency)
	{
		foreach ($this->banks as $bank) {
			if ($bank->currency != $currency) continue;
			if ($url) {
				return '<a href="' . Yii::app()->createUrl('billing/orgBankAccount', ['org_id' => $this->id, 'currency' => $currency]) . '" class="jqm_link">' . $bank->bank_bsb . ' ' . $bank->bank_number . '</a>';
			} else {
				return $bank->bank_bsb . ' ' . $bank->bank_number;
			}
		}

		if ($url) {
			return '<a href="' . Yii::app()->createUrl('billing/orgBankAccount', ['org_id' => $this->id, 'currency' => $currency]) . '" class="jqm_link">Add</a>';
		} else {
			return 'Empty';
		}
	}

	public static function getSpecialOrgByType($type) //this function is for managing those special clients so that the format will be looked better

	{
		switch ($type) {
			case 0:return [1733,3113];
			case 1:return [1316];
			case 2:return [1474];
			case 3:return [1474,3113];
			default:return [1733];
		}
	}

	public function getAccBalanceDetails()
	{
		if(empty($this->extra['credit_action'])) return 99999999;

		$balance = isset($this->extra['creditlimit']) ? $this->getCurrentCreditBalance() :0;// the balance will be a minus number
		if($balance<0||$balance>0)
		{
			$ps = ImParcel::model()->findAll("status = :status and agent_id = :agent_id",[":agent_id"=>$this->id,":status"=>ImParcel::STATE_ACCOUNT_HELD]);
			foreach ($ps as $key => $p)
			{
				$balance+=$p->getValue();
			}
			return $balance;
		}else
		{
			return 0;
		}
	}
}
