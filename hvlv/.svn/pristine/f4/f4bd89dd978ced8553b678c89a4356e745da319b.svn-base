	/* this function is used to send AQIS inovice to the custom
	 * SACNCC@agriculture.gov.au
	 */
	public static function sendAqisToCustom($model)
	{
		$files=[];
		$o=['status'=>false,'msg'=>''];
		$fs= FileRepo::model()->findAll('fid=:fid and type in (19,20) and status=30', [':fid'=>$model->id]);
		foreach ($fs as $f) {
			// if (!preg_match('/invoice/i', $f->name)) {
			// 	continue;
			// }
			$files[]=[$f->getFile(),$f->name];
		}
		if (empty($files)) {
			foreach ($fs as $f) {
				$files[]=[$f->getFile(),$f->name];
			}
		}
		if (empty($files)) {
			$o['status']=false;
			$o['msg']='no file find to custom';
			return $o;
		}
		$emailLog=new Emailog();
		$emailLog->type= Emailog::AQIS_TO_CUSTOM;
		$emailLog->fid = $model->id;
		$emailLog->dt = date('Y-m-d H:i:s');
		$emailLog->to_id = $model->agent_id;
		$org = Org::model()->findByPk($model->agent_id);
		$emailLog->status = 10;
		$emailLog->prepTemplate();
		$emailLog->subject = $emailLog->tpl->subject;
		$emailLog->body = $emailLog->tpl->getContent();
		$emailLog->mdata['to']="SACNCC@agriculture.gov.au";
		$emailLog->mdata['from']='imports@toplogistics.com.au';
		$emailLog->mdata['fromName']='Imports';
		$emailLog->mdata['cc']='imports@toplogistics.com.au';
		$d=$emailLog->sendEmail($files);
		if ($d['status']) {
			$o['status']=true;
			$o['msg']='send successfully';
			$model->process->changeStatus(ShipmentProcess::STATE_AQIS_CUSTOM);
		} else {
			$o['status']=false;
			$o['msg']=$d['msg'];
		}
		return $o;
	}
	
	public function getUpdateToNow()
	{
		if ($this->status!=24) {
			$etaDay=new DateTime(date('Y-m-d', strtotime($this->date)), new DateTimeZone('Australia/Sydney'));
			$now=new DateTime('now', new DateTimeZone('Australia/Sydney'));
			$daydiff = $now->diff($etaDay)->format("%a");
			return $daydiff;
		} else {
			return 0;
		}
	}
	public function getProcessType()
	{
		$value='';
		if (($this->type&4)>0) {
			$value.="<span class='warn'>HV</span>";
		}
		if (($this->type&1)>0) {
			$value.="<span class='warn'>EMPP</span>";
		}
		if (($this->type&2)>0) {
			$value.="<span class='warn'>AQIS</span>";
		}
		if (($this->type&8)>0) {
			$value.="<span class='warn'>OT</span>";
		}
		if (($this->type&16)>0) {
			$value.="<span class='warn'>SAC</span>";
		}
		return $value;
	}
	public function paymentReceived($custom_log='')
	{
		$this->status= self::PAYMENT_RECEIVED;
		$this->custom_log_note=$custom_log;
		$shipment= $this->shipment;
		// if shipment already cleared we change it to clear-wait
			if ($shipment->status==57) {//duty held
				$shipment->status= ImParcel::STATE_CLEAR_WAIT;
				$shipment->update('status');
			}
		$this->update('status');
	}
			
			
	/**
	 * check if the related invoice are  already paid!
	 */
	public function checkPaidByTransactionAlready()
	{
		$invoices=Invoice::model()->findAll('type in (41,45) AND total>0 AND status NOT IN (8,10) AND pid=:pid', [':pid'=> $this->pid]);
		if (!empty($invoices)) {
			$total=0;
			foreach ($invoices as $inv) {
				if($inv->status==Invoice::INVOICE_STATUS_PENDING_PAID)
				{

				}else
				{
					$total+=($inv->total-$inv->paid()>0?$inv->total-$inv->paid():0);
				}
			}
			if ($total<=0.01) {//means fully paid
				$this->status= self::PAYMENT_RECEIVED;
				$this->custom_log_note=" Payment Received By Bank Transaction,Confirm with Finance";
				$this->update('status');
			}
		}
	}
			
	public function findRelatedConsignee()
	{
		$provide=[];
		$cnee= $this->shipment->cnee;
		$sql='SELECT t.id FROM `shipment` t INNER JOIN `shipment_process` s ON t.id=s.pid INNER JOIN `addr` a ON t.cnee_id=a.id WHERE LOWER(a.name)=:name AND a.postcode=:postcode';
		$rs=Yii::app()->db->createCommand($sql)->bindValues([':name'=> strtolower($cnee->name),':postcode'=>$cnee->postcode])->queryAll();
		$provide=[];
		if (!empty($rs)) {
			foreach ($rs as $r) {
				if ($r['id']==$this->pid) {
					continue;
				}
				$p = ImParcel::model()->findByPk($r['id']);
				$fs= FileRepo::model()->findAll('fid=:fid and type in (19,18,20) and status!=0', [':fid'=>$r['id']]);
				$loa=null;
				foreach ($fs as $f) {
					if (preg_match('/loa/i', $f->name)) {
						$loa=$f;
						break;
					}
				}
				if (empty($loa)) {
					continue;
				}
				$provide[]=['ref'=>empty($p->ref)?$p->hbn:$p->ref,'id'=>$p->id,'name'=>$p->cnee->name,'tel'=>$p->cnee->tel,'email'=>$p->cnee->email,
					'loa_id'=>(!empty($loa)?$loa->id:0),'loa_name'=>(!empty($loa)?$loa->name:''),'loa_hash'=>(!empty($loa)?$loa->hash:'')];
			}
		}
		return $provide;
	}

	public function getStorageStartDate()
	{
		if(!empty($this->shipment->mdata['scan_time']))
		{
			if($this->shipment->consol->isOurWarehouse()&&$this->shipment->consol->service==Consol::AIRCONSOL)
				{
					$startDate = date("Y-m-d",strtotime($this->shipment->mdata['scan_time']));

					$check = 3;
					while ($check>0) {
						$startDate = date('Y-m-d', strtotime($startDate . '+ 1 day'));
						if (!HolidayHelper::checkDateIsHoliday($startDate, $this->shipment->consol->pod)) {
							$check--;
						}
					}
					
					$this->mdata['ssdate'] = $startDate;
					return @$this->mdata['ssdate'];

				}
		}


		if(empty($this->mdata['ssdate']))
		{
			if(!empty($this->shipment->consol))
			{
				if($this->shipment->consol->isOurWarehouse()&&$this->shipment->consol->service==Consol::AIRCONSOL)
				{
					$startDate = $this->shipment->consol->eta;
					if(!empty($this->shipment->mdata['scan_time']))
					{
						$startDate = date("Y-m-d",strtotime($this->shipment->mdata['scan_time']));
					}

					if(!empty($startDate))
					{
						$check = 3;
						while ($check>0) {
							$startDate = date('Y-m-d', strtotime($startDate . '+ 1 day'));
							if (!HolidayHelper::checkDateIsHoliday($startDate, $this->shipment->consol->pod)) {
								$check--;
							}
						}
						$this->mdata['ssdate'] = $startDate;
					}

				}
				
				if(!$this->shipment->consol->isOurWarehouse()||$this->shipment->consol->service==Consol::SEACONSOL)
				{
					$availableDate = empty($this->shipment->consol->mdata['available_date'])?"":$this->shipment->consol->mdata['available_date'];
					if(!empty($availableDate))
					{
						$startDate = $availableDate;
						$check = 3;
						while ($check>0) {
							$startDate = date('Y-m-d', strtotime($startDate . '+ 1 day'));
							if (!HolidayHelper::checkDateIsHoliday($startDate, $this->shipment->consol->pod)) {
								$check--;
							}
						}
						$this->mdata['ssdate'] = $startDate;
					}
				}
			}
		}

		return @$this->mdata['ssdate'];
	}
	
	public static function getStaticOnDayRange()
	{
		$provide = [];
		$hv_total = $aqis_total = $empp_total = $other_total = 0;
		$sql = 'SELECT p.*, s.consol_id, c.eta FROM `shipment_process` p INNER JOIN shipment s ON p.pid = s.id LEFT JOIN consol c ON c.id = s.consol_id WHERE p.status<24';
		$rs = Yii::app()->db->createCommand($sql)->queryAll();
		$orgShipmentProcess = [];
		foreach ($rs as $r) {
			if (($r['s_bwf'] & 2) > 0 && ($r['s_agent_id'] == 1002)) {
				$orgShipmentProcess[1401][] = $r;
			} else {
				$orgShipmentProcess[$r['s_agent_id']][] = $r;
			}
		}
		foreach ($orgShipmentProcess as $org_id => $processGroup) {
			$temp = [1 => [-1, 3], 2 => [3, 5], 3 => [5, 7], 4 => [7, 1000]];
			foreach ($temp as $key => $range) {
				${'n' . $key . 'H'} = ${'n' . $key . 'A'} = ${'n' . $key . 'E'}= ${'n' . $key . 'S'} = ${'n' . $key . 'O'} = 0;
			}
			$number = 0;
			foreach ($processGroup as $r) {
				// $consol = ImParcel::model()->findByPk($r['pid'])->consol;
				if(empty($r['consol_id']))
				{
					$daysdiff = -1;
				}else
				{
					$daysdiff = ceil((time() - strtotime($r['eta'])) / 86400);
				}
				$k = 0;
				$number++;
				foreach ($temp as $key => $range) {
					if ($range[0] < $daysdiff && $range[1] >= $daysdiff) {
						$k = $key;
					}
				}
				if($daysdiff<0)
				{
					$k = 1;
				}
				if ($k == 0) {
					continue;
				}

				if ($daysdiff > 1000) {
					$k = 4;
				}
				if (($r['type'] & ShipmentProcess::TYPE_HV) > 0) {
					${'n' . $k . "H"}++;
					$hv_total++;
				}
				if (($r['type'] & ShipmentProcess::TYPE_EMPP) > 0) {
					${'n' . $k . "E"}++;
					$empp_total++;
				}
				if (($r['type'] & ShipmentProcess::TYPE_AQIS) > 0) {
					${'n' . $k . "A"}++;
					$aqis_total++;
				}
				if (($r['type'] & ShipmentProcess::TYPE_OTHER) > 0) {
					${'n' . $k . "O"}++;
					$other_total++;
				}
				if (($r['type'] & ShipmentProcess::TYPE_SAC) > 0) {
					${'n' . $k . "S"}++;
					$other_total++;
				}
			}
			foreach ($temp as $k => $range) {
				${'n' . $k} = (${'n' . $k . 'E'} > 0 ? 'Empp:' . ${'n' . $k . 'E'} . '<br/>' : '') . (${'n' . $k . 'A'} > 0 ? 'AQIS:' . ${'n' . $k . 'A'} . '<br/>' : '') . (${'n' . $k . 'H'} > 0 ? 'HV:' . ${'n' . $k . 'H'} . '<br/>' : '') . (${'n' . $k . 'S'} > 0 ? 'SAC:' . ${'n' . $k . 'S'} . '<br/>' : '') . (${'n' . $k . 'O'} > 0 ? 'OT:' . ${'n' . $k . 'O'} . '<br/>' : '');
			}
			$org = Org::model()->find('id=:id', [':id' => $org_id]);
			if ($org_id == 1401) {
				$orgName = "商壹";
			} else {
				$orgName = @$org->name;
			}
			$provide[] = ['id' => $org_id, 'number' => $number, 'agent_id' => $org_id, 'owner' => $orgName, 'day1' => $n1, 'day2' => $n2, 'day3' => $n3, 'day4' => $n4];
		}
		return ['provide' => $provide, 'hv_total' => $hv_total, 'aqis_total' => $aqis_total, 'empp_total' => $empp_total, 'other_total' => $other_total];
	}

	/**
	 * Returns the static model of the specified AR class.
	 * Please note that you should have this exact method in all your CActiveRecord descendants!
	 * @param string $className active record class name.
	 * @return ShipmentProcess the static model class
	 */
	public static function model($className=__CLASS__)
	{
		return parent::model($className);
	}
}
