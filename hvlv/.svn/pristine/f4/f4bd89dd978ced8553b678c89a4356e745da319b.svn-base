	public function tableName()
	{
		return 'shipment_process';
	}

	/**
	 * @return array validation rules for model attributes.
	 */
	public function rules()
	{
		// NOTE: you should only define rules for those attributes that
		// will receive user inputs.
		return [
			['pid, status, date,started', 'required'],
			['pid, status,type,broker_id,consol_id,s_bwf,s_agent_id', 'numerical', 'integerOnly'=>true],
			// The following rule is used by search().
			// @todo Please remove those attributes that should not be searched.
			['consol_eta','length','max'=>20],
			['id, pid, status,started,type date,consol_eta,consol_id,s_bwf,s_agent_id,broker_id,meta,direction_due_date', 'safe', 'on'=>'search'],
		];
	}


	/**
	 * @return array relational rules.
	 */
	public function relations()
	{
		// NOTE: you may need to adjust the relation name and the related
		// class name for the relations automatically generated below.
		return [
			'shipment' => [self::BELONGS_TO, 'ImParcel', 'pid'],
			'processLog'=>[self::HAS_MANY,'ProcessLog','fid'],
		];
	}

	/**
	 * @return array customized attribute labels (name=>label)
	 */
	public function attributeLabels()
	{
		return [
			'id' => 'ID',
			'pid' => 'Pid',
			'status' => 'Status',
			'started' => 'Started',
			'date' => 'Date',
			'type' => 'Type',
			'broker_id' => 'Broker Id',
			'meta' => 'Meta',
		];
	}

	/**
	 * Retrieves a list of models based on the current search/filter conditions.
	 *
	 * Typical usecase:
	 * - Initialize the model fields with values from filter form.
	 * - Execute this method to get CActiveDataProvider instance which will filter
	 * models according to data in model fields.
	 * - Pass data provider to CGridView, CListView or any similar widget.
	 *
	 * @return CActiveDataProvider the data provider that can return the models
	 * based on the search/filter conditions.
	 */
	public function search()
	{
		// @todo Please modify the following code to remove attributes that should not be searched.

		$criteria=new CDbCriteria;
		$criteria->compare('id', $this->id);
		$criteria->compare('pid', $this->pid);
		$criteria->compare('status', $this->status);
		$criteria->compare('type', $this->type);
		$criteria->compare('date', $this->date, true);
		$criteria->compare('started', $this->started, true);
		$criteria->compare('broker_id', $this->started);
		$criteria->compare('s_agent_id', $this->s_agent_id);
		$criteria->compare('consol_id', $this->consol_id);
		$criteria->compare('s_bwf', $this->s_bwf);
		$criteria->compare('consol_eta', $this->consol_eta);
		$criteria->compare('meta', $this->meta, true);
		return new CActiveDataProvider($this, [
			'criteria'=>$criteria,
		]);
	}
		
	public function afterFind()
	{
		if (!empty($this->meta)) {
			$this->mdata= json_decode($this->meta, true);
		}
	}
	public function beforeSave()
	{
		// 2023-01-11 Gero Auto assign broker
		// if($this->status == self::DOC_RECEIVED)
		// {
			if(empty($this->broker_id)&&($this->shipment->bwf&ImParcel::BWF_SELF_CUSTOM)==0)
			{
				if($this->s_agent_id==Org::ORGID_CLIENT_SHUNCHIDA)
				{
					$this->broker_id = Org::ORGID_BROKER_MASTER;
				}

				if(($this->type&self::TYPE_HV)>0&&($this->type&self::TYPE_EMPP)==0)
				{
					if(in_array($this->s_agent_id,[Org::ORGID_CLIENT_4PX,Org::ORGID_CLIENT_SF]))
					{
						$this->broker_id = Org::ORGID_BROKER_AUTUMN;
					}elseif(in_array($this->s_agent_id,[Org::ORGID_CLIENT_AUSTWAY,Org::ORGID_CLIENT_GLODEN,Org::ORGID_CLIENT_DINGDA]))
					{
						if(($this->shipment->bwf&ImParcel::CUSTOM_DDU)>0)
						{
							$this->broker_id = Org::ORGID_BROKER_AUTUMN;
						}elseif(($this->shipment->bwf&ImParcel::CUSTOM_DDP)>0)
						{
							$this->broker_id = Org::ORGID_BROKER_MASTER;
						}
						
					}elseif(in_array($this->s_agent_id,[Org::ORGID_CLIENT_HENGAO,Org::ORGID_CLIENT_ZHONGWAI,ORG::ORGID_CLIENT_YIYUNDA,Org::ORGID_CLIENT_AOCHEN,Org::ORGID_CLIENT_AOLIAN,Org::ORGID_CLIENT_YONGZHE,Org::ORGID_CLIENT_YANER,Org::ORGID_CLIENT_AOYING,1222,4612,4156,4669,4696,4534,4780,4207,4141]))
					{
						$this->broker_id = Org::ORGID_BROKER_MASTER;
					}elseif(in_array($this->s_agent_id,[Org::ORGID_CLIENT_ZTO]))
					{
						$this->broker_id = Org::ORGID_BROKER_MASTER;
					}
				}

			}
		// }

		if (!empty($this->mdata)) {
			$this->meta= json_encode($this->mdata);
		}
		
		$this->getStorageStartDate();
		return true;
	}
 
	public function updateMeta()
	{
		if (!empty($this->mdata)) {
			$this->meta= json_encode($this->mdata);
		}
		$this->update(['meta']);
	}
	public function getStatus()
	{
		return isset(static::$states[$this->status])? Yii::t(strtolower(__CLASS__), static::$states[$this->status]) : $this->status;
	}

	public function afterSave()
	{
		if (!$this->nolog && !empty($this)) {
			$extra = empty($this->custom_log_note)? [] : ['note' => $this->custom_log_note];
			if(!empty($this->mdata['ssdate']))
			{
				$extra['ssdate'] = $this->mdata['ssdate'];
			}
			Log::add($this, $this->isNewRecord? 3 : 4, array_merge(['status' => $this->getStatus()], $extra));
		}
		if ($this->status!=self::CUSTOM_DONE) {
			foreach (array_keys(self::$the_types) as $type) {
				if (($this->type&$type)>0) {
					ProcessLog::addLog($this->id, $type);
				}
			}
		}
	}

	public static function brokerList($withEmpty=true){
		$rs = Org::model()->findAll('type = 72 AND status = 1');
		$nvp = [];
		foreach($rs as $r){
			$nvp[$r->id] = $r->name;
		}
		if($withEmpty)
		{
			$nvp[-1] = "Empty Broker";
		}
		return $nvp;
	}
	/**
		* update consol_id consol_eta s_agent_id  s_cbwf;
		*/
	public function updateBatchInfo()
	{
		$shipment= $this->shipment;
		if (!empty($shipment)) {
			$this->s_agent_id=$shipment->agent_id;
			$this->s_bwf=$shipment->bwf;
			$this->consol_id=$shipment->consol_id;
			$this->consol_eta=@$shipment->consol->eta;
			$this->save();
		}
	}

	public static function brokerStats($list = true){
		$rs = [];
		foreach(self::$states as $k => $v){
			if ($list && in_array($k, [3,4,10,12,14,18,20,22])) {
				$rs[$k] = $k == 15? 'Finalised' : $v;
			} else if (in_array($k, [3,4,10,12,14])) {
				$rs[$k] = $k == 15? 'Finalised' : $v;
			}
		}
		return $rs;
	}
		 
	public static function getProcessAmount($status=[])
	{
		$amount=0;
		foreach ($status as $st) {
			$sql="SELECT COUNT(*) as number FROM `shipment_process` sp join shipment s on sp.pid=s.id WHERE s.type = 10 and s.ot_id = 0 and s.status!=100 and `sp`.`status`=:status";
			$r=Yii::app()->db->createCommand($sql)->bindValues([':status'=>$st])->queryScalar();
			if ($r>0) {
				$amount+=$r;
			}
		}
		return $amount;
	}
	
	public function changeStatus($status)
	{
		$this->status=$status;
		$this->date=date('Y-m-d H:i:s');
		$this->update(['status','date']);
	}

	public function getBrokerName()
	{
		if ($this->broker_id>0) {
			$org= Org::model()->findByPk($this->broker_id);
			if (!empty($org)) {
				return $org->name;
			}
		}
		return "";
	}
	public static function sendDocumentNotice($model)
	{ //$model is the shipment this is to sender.
		//send to sender
		$emailLog = new Emailog();
		$emailLog->type = Emailog::CUST_DOCUMENT_SENDER;
		$emailLog->fid = $model->id;
		$emailLog->dt = date('Y-m-d H:i:s');
		$emailLog->to_id = $model->agent_id;
		$emailLog->status = 10;
		$emailLog->prepTemplate();
		$emailLog->subject = $emailLog->tpl->subject;
		$emailLog->body = $emailLog->tpl->getContent();
		if ($emailLog->requireHighValueDocumentsSend()) {
			// echo 'send!';
			if (empty($model->process)) {
				$model->newShipmentProcess(ShipmentProcess::MSG_SENDER);// send to customer;
			} else {
				$processes = ShipmentProcess::model()->findAll('pid = :pid',[':pid'=>$model->id]);
				foreach ($processes as $key => $process) {
					$process->changeStatus(ShipmentProcess::MSG_SENDER);
				}
			}
		}
	}
		 
		 
	public static function sendDocumentNoticeToCustomer($model)
	{ //$model is the shipment
		//check if there are email or sms//
		if (isset($model->cnee->email)&&filter_var(preg_split('/[;,]+/i', $model->cnee->email)[0], FILTER_VALIDATE_EMAIL)) {
			$emailLog = new Emailog();
			$emailLog->type = Emailog::CUST_DOCUMENT_CUSTOMER;
			$emailLog->fid = $model->id;
			$emailLog->dt = date('Y-m-d H:i:s');
			$emailLog->status = 10;
			$emailLog->prepTemplate();
			$emailLog->subject = $emailLog->tpl->subject;
			$emailLog->body = $emailLog->tpl->getContent();
			if($model->isTLA())
			{
				$file=Yii::app()->basePath.DIRECTORY_SEPARATOR.'consignee_authorization_letter_template_top.docx';
			}else
			{
				$file=Yii::app()->basePath.DIRECTORY_SEPARATOR.'consignee_authorization_letter_template.docx';
			}
			if ($emailLog->requireHighValueDocumentsSendCustomer($model->cnee->email, [$file])) {
				$model->process->changeStatus(ShipmentProcess::MSG_CONSIGNEE);
				// after sending email we send sms to notice that
				if ((isset($model->cnee->tel)&&preg_match('/^04\d{8}$/', ($model->cnee->auTel())))) {
					$no=$model->cnee->auTel();
					$link=$model->getTheHashUrl(true); //true means this link is for customer not for sender.
					$msg='This '.Org::COMPANY_NAME_SL.', a notice is sent to email:'.$model->cnee->email.' for your Parcel '. $model->ref.' Please reply the email as ASAP! tel: 02-99257111';
					if (Sms::sendCustomsMessageLocal($no, $msg)) {
						// Log::log2file($model->ref.' no=>'.$no.' msg:=>'.$msg, 'msg_notice_doucument_send', 'smslog');
					}
				}
			}
		}
	}
					 
	public static function requireLoa($model)
	{ //$model is the shipment
		//check if there are email or sms//
		if (isset($model->cnee->email)&&filter_var(preg_split('/[;,]+/i', $model->cnee->email)[0], FILTER_VALIDATE_EMAIL)) {
			$emailLog = new Emailog();
			$emailLog->type = Emailog::CUST_DOCUMENT_CUSTOMER2; //require loa
			$emailLog->fid = $model->id;
			$emailLog->dt = date('Y-m-d H:i:s');
			$emailLog->status = 10;
			$emailLog->prepTemplate();
			$emailLog->subject = $emailLog->tpl->subject;
			$emailLog->body = $emailLog->tpl->getContent();
									
			$fs= FileRepo::model()->findAll('fid=:fid and type in (19,20) and status in (20,30)', [':fid'=>$model->id]);
			foreach ($fs as $f) {
				$files[]=[$f->getFile(),$f->name];
			}
			if($model->isTLA())
			{
				$files[]=[$file=Yii::app()->basePath.DIRECTORY_SEPARATOR.'consignee_authorization_letter_template_top.docx','consignee_authorization_letter_template_top.docx'];
			}else
			{
				$files[]=[$file=Yii::app()->basePath.DIRECTORY_SEPARATOR.'consignee_authorization_letter_template.docx','consignee_authorization_letter_template.docx'];
			}
			if ($emailLog->requireHVDCustomerLoa($model->cnee->email, $files)) {
				$model->process->changeStatus(ShipmentProcess::MSG_CONSIGNEE);
				// after sending email we send sms to notice that
				if ((isset($model->cnee->tel)&&preg_match('/^04\d{8}$/', ($model->cnee->auTel())))) {
					$no=$model->cnee->auTel();
					$link=$model->getTheHashUrl(true); //true means this link is for customer not for sender.
					$msg='This '.Org::COMPANY_NAME_SL.', a notice is sent to email:'.$model->cnee->email.' for your Parcel '. $model->ref.' Please reply via the email as ASAP! tel: 02-99257111';
					if (Sms::sendCustomsMessageLocal($no, $msg)) {
						// Log::log2file($model->ref.' no=>'.$no.' msg:=>'.$msg, 'msg_notice_doucument_send', 'smslog');
					}
				}
			}
		} else {
			echo 'not valid email';
		}
	}
 
	public static function sendToBroker($model)
	{
		$tempDirectory = Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR.'zip'.time();
		if (!file_exists($tempDirectory)) {
			mkdir($tempDirectory);
		}
		$files=[];
		$fs= FileRepo::model()->findAll('fid=:fid and type in (19,18,20) and status=30', [':fid'=>$model->id]);
		foreach ($fs as $f) {
			$files[]=[$f->getFile(),$f->name];
		}
		$fileName=$tempDirectory.DIRECTORY_SEPARATOR.'house_bill_'.$model->hbn.'.pdf';
		oPDF::renderPDF('custom_airwaybill', ['model' => $model], 2, $fileName);
		$files[]=[$fileName,'house_bill_'.$model->hbn.'.pdf'];
		
		//send to sender
		$emailLog = new Emailog();
		$emailLog->type = Emailog::CUST_DOCUMENT_BROKER;
		$emailLog->fid = $model->id;
		$emailLog->dt = date('Y-m-d H:i:s');
		$emailLog->to_id =$model->process->broker_id;
		$emailLog->status = 10;
		$emailLog->prepTemplate();
		$emailLog->subject = $emailLog->tpl->subject;
		$emailLog->body = $emailLog->tpl->getContent();
		if ($emailLog->sendToBroker($files)) {
			// echo 'send!';
			$model->process->changeStatus(ShipmentProcess::MSG_BROKER);
			//update the file flag to active
			unset($f);
			foreach ($fs as $f) {
				$f->status=20;
				$f->update('status');
			}
		}
		AppHelper::unlinkRecursive($tempDirectory);
	}
	public static function sendEntryToConfirm($model)
	{

		//DDP   to sender
		//DDU  to consignee
		$email='';
		if (($model->bwf&ImParcel::CUSTOM_DDP)>0) {
			$org = Org::model()->findByPk($model->agent_id);
			if (!empty($org->extra['outturn_email'])) {
				$email=$org->extra['outturn_email'];
			}
			if (($org->id==1002)&&($model->bwf&ImParcel::BWF_SY)>0) {
				$email='ryan.cs@com1express.net';
			}
		} elseif (($model->bwf&ImParcel::CUSTOM_DDU)>0) {
			if (!empty($model->receiver->name)) {
				$email = isset($model->receiver->email) ? $model->receiver->email : '';
				if (empty($email)) return 'Receiver has no email address';
			} else {
				$email = isset($model->cnee->email) ? $model->cnee->email : '';
				if (empty($email)) return 'Consignee has no email address';
			}
		}

		if (($model->bwf&ImParcel::CUSTOM_DDU)>0) {
			$model->process->changeStatus(ShipmentProcess::ENTRY_CONFIRM);
			return 'done';
		}

		$files=[];
		$fs= FileRepo::model()->findAll('fid=:fid and type in (19) and status!=0', [':fid'=>$model->id]);
		foreach ($fs as $f) {
			if (!preg_match('/entry/i', $f->name)) {
				continue;
			}
			$files[]=[$f->getFile(), $f->name];
		}
						

		if (filter_var(preg_split('/[;,]+/i', $email)[0], FILTER_VALIDATE_EMAIL)) {
			$emailLog = new Emailog();
			$emailLog->type = Emailog::CUST_ENTRY_CONFIRM;
			$emailLog->fid = $model->id;
			$emailLog->dt = date('Y-m-d H:i:s');
			$emailLog->status = 10;
			$emailLog->prepTemplate();
			$emailLog->subject = $emailLog->tpl->subject;
			$emailLog->body = $emailLog->tpl->getContent();
			if ($emailLog->sendEntryToConfirm($email, $files)) {
				// echo 'send!';
				$model->process->changeStatus(ShipmentProcess::ENTRY_SEND);
				if ((($model->bwf&ImParcel::CUSTOM_DDU)>0)&&(isset($model->cnee->tel)&&preg_match('/^04\d{8}$/', ($model->cnee->auTel())))) {
					$no=$model->cnee->auTel();
					$msg='This '.Org::COMPANY_NAME_SL.', a entry is sent to email:'.$model->cnee->email.' for your Parcel '. $model->ref.' Please confirm the email ASAP! tel: 02-99257111';
					if (Sms::sendCustomsMessageLocal($no, $msg)) {
						// Log::log2file($model->ref.' msg send to customer notice', 'smslog');
					}
				}
			}
		}

		return 'done';
	}
				
					
	public static function sendToBrokerToPay($model,$stayHere = false)
	{
		if(!empty($model->process->mdata['stay_here'])&&$stayHere==false)
		{
			$model->process->changeStatus(ShipmentProcess::BROKER_PAID);
			return;
		}

		$model->process->mdata['stay_here'] = $stayHere;
		$model->process->save();

		$emailLog = new Emailog();
		$emailLog->type = Emailog::BROKER_TO_PAY;
		$emailLog->fid = $model->id;
		$emailLog->dt = date('Y-m-d H:i:s');
		$emailLog->to_id =$model->process->broker_id;
		$emailLog->status = 10;
		$emailLog->prepTemplate();
		$emailLog->subject = $emailLog->tpl->subject;
		$emailLog->body = $emailLog->tpl->getContent();
		if ($emailLog->sendToBrokerToPay()) {
			// echo 'send!';
			if(!$stayHere)
			{
				$model->process->changeStatus(ShipmentProcess::BROKER_PAID);
			}
			//update the file flag to active
		}

		// DDP to sender
		// DDU to consignee
		$email = '';
		if (($model->bwf & ImParcel::CUSTOM_DDP) > 0) {
			$org = Org::model()->findByPk($model->agent_id);
			if (!empty($org->extra['outturn_email'])) {
				$email = $org->extra['outturn_email'];
			}
		} elseif (($model->bwf & ImParcel::CUSTOM_DDU) > 0) {
			$email = isset($model->cnee->email) ? $model->cnee->email : '';
		}

		$emailLog = new Emailog();
		$emailLog->type = Emailog::PAYMENT_RECEIVED;
		$emailLog->fid = $model->id;
		$emailLog->dt = date('Y-m-d H:i:s');
		$emailLog->to_id = $model->agent_id;
		$emailLog->status = 10;
		$emailLog->prepTemplate();
		$emailLog->subject = $emailLog->tpl->subject;
		$emailLog->body = $emailLog->tpl->getContent();
		$emailLog->mdata['to'] = $email;
		$emailLog->mdata['fromName'] = 'TLA Imports';
		$emailLog->mdata['from'] = 'imports@toplogistics.com.au';
		$emailLog->mdata['cc'] = 'imports@toplogistics.com.au';
		$emailLog->sendEmail();
	}
					
	public static function sendToBrokerRequestFinalEntry($model)
	{
		$emailLog = new Emailog();
		$emailLog->type = Emailog::REQUEST_FINAL_ENTRY_BROKER; //
		$emailLog->fid = $model->id;
		$emailLog->dt = date('Y-m-d H:i:s');
		$emailLog->to_id =$model->process->broker_id;
