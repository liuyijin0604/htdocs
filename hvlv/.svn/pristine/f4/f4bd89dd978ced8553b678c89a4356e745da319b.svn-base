	public static function sendInvoiceToInform($model)
	{
		$files=[];
		$tempDirectory = Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR.'emlatt'.time();
		if (!file_exists($tempDirectory)) {
			mkdir($tempDirectory);
		}
		$invs = Invoice::model()->findAll(
				'dpmt=10 AND type IN(41,45) AND pid = :pid AND status not in (10,9,8,6) ORDER BY id DESC',
			[':pid'=>$model->id]
			);
		if (empty($invs)) {
			echo 'invoice not created';
			return;
		}
		$isDdp=false;

		$confirmFiles = [];

		if (($model->bwf&ImParcel::CUSTOM_DDU)>0)//for DDU preparing the entry confirm files with invoice
		{
			$fs= FileRepo::model()->findAll('fid=:fid and type in (19) and status!=0', [':fid'=>$model->id]);
			foreach ($fs as $f) {
				if (!preg_match('/entry/i', $f->name)) {
					continue;
				}
				$confirmFiles[]=[$f->getFile(), $f->name];
			}
		}

		foreach ($invs as $tempInv) {
			$fileName=$tempDirectory.DIRECTORY_SEPARATOR.'Invoice_'.$tempInv->no.'.pdf';
			oPDF::renderPDF('invoice', ['inv'=>$tempInv], 2, $fileName);
			$files[]=[$fileName, 'Invoice_'.$tempInv->no.'.pdf'];
		}
		$files = array_merge($files,$confirmFiles);
		//DDP   to sender
		//DDU  to consignee
		$email='';
		if (($model->bwf&ImParcel::CUSTOM_DDP)>0) {
			$org = Org::model()->findByPk($model->agent_id);
			if (!empty($org->extra['outturn_email'])) {
				$email=$org->extra['outturn_email'];
			}

			if($model->agent_id==Org::ORGID_COURIER_4PX)
			{
				$org = Org::model()->findByPk($model->agent_id);
				$email=$org->extra['outturn_email'];
			}

			
			$isDdp=true;
		} elseif (($model->bwf&ImParcel::CUSTOM_DDU)>0) {
			$email=isset($model->cnee->email)?$model->cnee->email:'';

			if($model->agent_id==Org::ORGID_COURIER_4PX)
			{
				$org = Org::model()->findByPk($model->agent_id);
				$email=$org->extra['outturn_email'];
			}
			$isDdp=false;
		}

		if (filter_var(preg_split('/[;,]+/i', $email)[0], FILTER_VALIDATE_EMAIL)) {
			$emailLog = new Emailog();
			if ($isDdp) {
				$emailLog->type= Emailog::CUSTOM_INVOICE_AGENT;
			} else {
				$emailLog->type = Emailog::CUST_INVOICE_INFORM;
			}
			$emailLog->fid = $model->id;
			$emailLog->dt = date('Y-m-d H:i:s');
			$emailLog->status = 10;
			$emailLog->prepTemplate();
			$emailLog->subject = $emailLog->tpl->subject;
			$emailLog->body = $emailLog->tpl->getContent();
			$emailLog->mdata['to']=$email;
			$emailLog->mdata['fromName']='TLA Imports';
			$emailLog->mdata['from']='donotreply@toplogistics.com.au';
			$emailLog->mdata['cc']='imports@toplogistics.com.au';
			if(empty($email))
			{
				echo "Empty Email Address";
			}
			$o=$emailLog->sendEmail($files);
									
			if ($o['status']) {
				foreach($invs as $invoice){
					if($invoice->status == Invoice::INVOICE_STATUS_PENDING){
						$invoice->status = Invoice::INVOICE_STATUS_POSTED;
						$invoice->update('status');
					}
				}
				if ($model->bwf & ImParcel::CUSTOM_DDU > 0) {
					$model->process->changeStatus(ShipmentProcess::INFROM_CUSTOMER_PAY);
				}
				if ((($model->bwf&ImParcel::CUSTOM_DDU)>0)&&(isset($model->cnee->tel)&&preg_match('/^04\d{8}$/', ($model->cnee->auTel())))) {
					$no=$model->cnee->auTel();
					$msg='This '.Org::COMPANY_NAME_SL.', a entry is sent to email:'.$model->cnee->email.' for your Parcel '. $model->ref.' Please confirm the email ASAP! tel:  02-99257111';
					if (Sms::sendCustomsMessageLocal($no, $msg)) {
						// Log::log2file($model->ref.' msg send to customer notice', 'smslog');
					}
				}
			}
		}
		AppHelper::unlinkRecursive($tempDirectory);
	}
					
									 
	public static function noticeDelivery($model)
	{
		//DDP   to sender
		//DDU  to consignee
		$o=['status'=>false,'msg'=>'email not valid'];
		if(!in_array($model->status,[ImParcel::STATE_CLEAR,ImParcel::STATE_CLEAR_WAIT]))
		{
			$o=['status'=>false,'msg'=>'status not valid'];
			return $o;
		}
		$email='';
		if (($model->bwf&ImParcel::CUSTOM_DDP)>0) {
			$org = Org::model()->findByPk($model->agent_id);
			if (!empty($org->extra['outturn_email'])) {
				$email=$org->extra['outturn_email'];
			}
		} elseif (($model->bwf&ImParcel::CUSTOM_DDU)>0) {
			$email=isset($model->cnee->email)?$model->cnee->email:'';
		}
		if (filter_var(filter_var(preg_split('/[;,]+/i', $email)[0], FILTER_VALIDATE_EMAIL), FILTER_VALIDATE_EMAIL)) {
			$emailLog = new Emailog();
			$emailLog->type = Emailog::NOTICE_DELIVERY;
			$emailLog->fid = $model->id;
			$emailLog->dt = date('Y-m-d H:i:s');
			$emailLog->status = 10;
			$emailLog->prepTemplate();
			$emailLog->subject = $emailLog->tpl->subject;
			if(!empty($model->process->notice_content))
			{
				$emailLog->body = $model->process->notice_content;
			}else
			{
				$emailLog->body = $emailLog->tpl->getContent();
			}
			$d=$emailLog->sendNoticeDelivery($email);
			if ($d['status']) {
				$o['status']=true;
				$o['msg']='send successfully';
				if ((($model->bwf&ImParcel::CUSTOM_DDU)>0)&&(isset($model->cnee->tel)&&preg_match('/^04\d{8}$/', ($model->cnee->auTel())))) {
					$no=$model->cnee->auTel();
					$msg='This '.Org::COMPANY_NAME_SL.', your Parcel '. $model->ref.' is already cleared and will be delivery to you.';
					if (Sms::sendCustomsMessageLocal($no, $msg)) {
						// Log::log2file($model->ref.' msg send to customer notice delivery', 'msg_customer', 'smslog');
					}
				}
			} else {
				$o['status']=false;
				$o['msg']=$d['msg'];
			}
		}
		return $o;
	}

