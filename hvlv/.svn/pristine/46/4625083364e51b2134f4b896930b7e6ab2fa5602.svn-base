	public function actionUploadCustomsFiles()
	{
		if(empty($_FILES['file']))
		{
			$model=new ImParcel('search');
			$model->unsetAttributes();  // clear any default values
			if (isset($_GET['ImParcel'])) {
				$model->attributes=$_GET['ImParcel'];
			}
			if (Yii::app()->user->grp>10) {
				$model->agent_id=Yii::app()->user->org;
			}
			$model->searchHeld=true;
			if (isset($_GET['ImParcel']['heldDate'])) {
				$model->heldDate=$_GET['ImParcel']['heldDate'];
			}
			$this->render('upload_customs_files', [
				'model'=>$model,'org'=>$this->org,
			]);
			return;
		}

		$f = $_FILES['file'];
		$filename = $f['tmp_name'];
		$name = $f['name'];
		$hbn = "";
		$nameArr = explode('-', explode('.', $name)[0]);
		if(count($nameArr)<=2)
		{
			$hbn =$nameArr[0];
		}else
		{
			for ($i=0; $i < count($nameArr)-1 ; $i++) {
				if(empty($hbn))
				{
					$hbn = $nameArr[$i];
				}else
				{
					$hbn .= '-'.$nameArr[$i];
				}
			}
		}
		if(empty($hbn)) echo 'DONE';

		$model = ImParcel::model()->find('(hbn=:hbn or ref=:hbn or cref=:hbn) and status!=100',[":hbn"=>$hbn]);
		if(empty($model))
		{
			echo 'DONE';
			return;
		}else
		{
			if(empty($model->process))
			{
				$model->bwf = $model->bwf|ImParcel::BWF_HELD_OTHER;
				$model->save();
			}
			
		}
		if(!is_uploaded_file($filename)) return false;
		$thisHash =FileRepo::uploadHash($model, FileRepo::CUSTOMSSENDERFILE);
		$filesize = filesize($filename);
		$date = date('Y-m-d H:i:s');
		$fileHash = hash_file('crc32b', $filename).hash('crc32b', $filesize);
		$finfo = finfo_open(FILEINFO_MIME_TYPE);
		$mime = finfo_file($finfo, $f['tmp_name']);
		$fr = CargoProcess::updateUploadSingleFile($filesize,$date,$fileHash,$finfo,$mime,$filename,$name, $thisHash,false,false,false,false,FileRepo::STATUS_ACTIVE);
		echo 'DONE';


	}
	
