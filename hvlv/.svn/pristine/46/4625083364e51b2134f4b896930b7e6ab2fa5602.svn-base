	public function actionPrint($id)
	{
		$model = $this->loadModel($id);
		if ($model->status == 8) {
			$model->status = 9;
			$model->save();
		}
		// for AMQ label we use AMQ label template
		$fn=$model->hbn;
		foreach ([$model] as $key => $d) {
			if(!empty($d->consol)&&preg_match('/WDT/i', $d->consol->no))
			{
				if($d->getParentShipment()->status!=ImParcel::DELIVERED)
				{
					if(empty($_GET['ppwd']))
					{
						continue;
					}else if($this->authPassword($_GET['ppwd'])&&(in_array(User::currentUserOrgId(), [1474,3321,3103,4534])||in_array(User::currentUserID(), [3517])))
					{

					}else
					{
						continue;
					}
				}
			}

			$apiLabel = ImParcelService::getEizLabel($d);
			if(!empty($apiLabel))
			{
				$ps[] = $apiLabel;
			}else
			{
				$normal[] = $d;
			}
		}

		if(!empty($normal))
		{
			$normalLabel = oPDF::renderPDF('label_A6', ['tpl' => '_label_1', 'rs' => $normal], 2);
			$ps[] = $normalLabel;
		}

		oPDF::mergePDF($ps, 1, true, $fn.'.pdf');
	}

	/**
	 * Authenticate
	 */
	public function actionAuthPassword(){
		$resp = ['success' => 0 , 'msg' => 'Unknown Error'];
		if($this->authPassword($_POST['ppwd']))
		{
			$resp['success'] = 1;
		}
		echo json_encode($resp);
	}

	/**
	 * Authenticate
	 */
	private function authPassword($password){
		if(User::getCurrentUser()->password == md5($password))
		{
			return true;
		}
		return false;
	}
	
	public function actionUpdate($id)
	{
		$model = $this->loadModel($id);
		if (!Acl::hasAccess('B:Import/SeeAllShipments') && !empty($model->agent_id) && $model->agent_id != Yii::app()->user->org) {
			Acl::denied403();
		}
		
		if (!empty($_POST)) {
			$_POST = utf8zts::t2sArray($_POST);
			$model->cnor->attributes = $_POST['Cnor'];
			$model->cnor->save();
			$model->cnee->attributes = $_POST['Cnee'];
			$model->cnee->save();
			if(!empty($_POST['Receiver']['name']))
			{
				if(empty($model->receiver))
				{
					$model->receiver = new Addr();
				}

				$model->receiver->attributes = $_POST['Receiver'];
				$model->receiver->save();
				$model->receiver_id = $model->receiver->id;
			}
			if(!empty($_POST[get_class($model)]['pkg'])&&$_POST[get_class($model)]['pkg']!=$model->pkg&&!empty($model->pkg))
			{
				if(!$model->checkCanEditPkg())
				{
					$model->addError("id","this shipment can not be updated number of packages");
					$this->ajaxResult($model);
				}
			}

			$model->attributes=$_POST[get_class($model)];

			if (empty($model->cnor_id)) {
				$model->cnor_id = $model->cnor->id;
			}
			if (empty($model->cnee_id)) {
				$model->cnee_id = $model->cnee->id;
			}

			if(!empty($_POST['clear']))
			{
				$model->bwf=$model->bwf&ImParcel::CUSTOM_DDU^$model->bwf;// clear DDP
				$model->bwf=$model->bwf&ImParcel::CUSTOM_DDP^$model->bwf; //clear DDU
				$model->bwf = $model->bwf|$_POST['clear'];
			}

			// remove inalid items
			$items = $_POST['items'];
			foreach ($items['q'] as $i=>$qty) {
				if (empty($qty)) {
					unset($items['q'][$i]);
					unset($items['g'][$i]);
					unset($items['g_zh'][$i]);
					unset($items['pid'][$i]);
					unset($items['hs'][$i]);
					unset($items['v'][$i]);
					continue;
				}
			}
			$model->eitems = $items;
			$model->state = $model->cnee->state;
			$model->postcode = $model->cnee->postcode;
			$model->mdata['amazon_po'] = $_POST['mdata']['amazon_po'];
			$model->mdata['amazon_shipment_ids'] = $_POST['mdata']['amazon_shipment_ids'];
			$chargecodeService = new ChargecodeService();
			$errorMsg = $chargecodeService->checkChargecode($model);
			if(!empty($errorMsg))
			{
				$model->addError('Chargecode Error',$errorMsg);
				$this->ajaxResult($model);
			}



			$model->save();
			$this->ajaxResult($model, ['id', 'hbn', 'status'], 'Shipment updated successfully.');
		}

		$this->render($model->canBeUpdate()? 'update' : 'view', ['model' => $model, 'type' => $this->type, 'org' => $this->org]);
	}

