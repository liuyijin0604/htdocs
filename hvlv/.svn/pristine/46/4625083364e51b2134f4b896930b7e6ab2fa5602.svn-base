<?php

class ShipmentController extends Controller
{
	/**
	 * Declares class-based actions.
	 */
	protected $nonAjax=['bulkPrint','print','export','report'];
	protected $skipAcl=['auPcSuggest','cnCitySuggest','cnSuburbSuggest','prodSuggest', 'tracking'];

	protected $org;
	protected $type;


	public function beforeAction($action)
	{
		if (!Yii::app()->user->isGuest) {
			$this->org = Org::model()->findByPk(Yii::app()->user->org);
			$this->type = 'im';
		}
		return parent::beforeAction($action);
	}

	public function actionCreate()
	{
		$model = new ImParcel;
		if (!empty($_POST)) {
			$_POST = utf8zts::t2sArray($_POST);
			$predata=new stdClass();
			$predata->chargecode=$_POST['chargecode'];
			$predata->shipper=$_POST['Cnor'];
			$predata->consignee=$_POST['Cnee'];
			$predata->weight=$_POST['ImParcel']['weight'];
			$predata->cbm=$_POST['ImParcel']['cbm'];
			$predata->insurance=$_POST['ImParcel']['insurance'];
			$predata->cust_ref=$_POST['ImParcel']['cref'];
			$predata->packs=(isset($_POST['ImParcel']['pkg'])&&$_POST['ImParcel']['pkg']>0)?$_POST['ImParcel']['pkg']:1;
			$predata->items=[];
			if (empty($_POST['items'])) {
				$model->addError('id', 'Items need to be supplied!');
				$this->ajaxResult($model);
			}
			foreach ($_POST['items']['g'] as $k=> $item_name) {
				$predata->items[$k]=['type' => 'O', 'name' => trim($item_name), 'qty' => trim($_POST['items']['q'][$k]),
					'price' => trim($_POST['items']['v'][$k]),'name_zh'=>isset($_POST['items']['g_zh'][$k])?trim($_POST['items']['g_zh'][$k]):''
					,'hs'=>isset($_POST['items']['hs'][$k])?$_POST['items']['hs'][$k]:''];
			}
			$predata->agent_id= $this->org->id;
			$manifest=null;
			if (!empty($_GET['man_id'])) {
				$manifest= Manifest::model()->find('fwd_id=:oid AND id=:id', [':oid'=>$this->org->id,':id'=>$_GET['man_id']]);
			}
			if (empty($predata->weight)) {
				$model->addError('id', 'Weight need to be supplied!');
				$this->ajaxResult($model);
			}
			$d=ChooseShipment::newShipmentWithChargeCode($predata, false, empty($manifest->id)? null : ['man_id' => $manifest->id]);
			if ($d->success) {//sucess
				$this->ajaxResult($model, ['id', 'hbn'], json_encode($d));
			} else {
				$model->addError('id', json_encode($d));
				$this->ajaxResult($model);
			}
		}

		$this->render('create', ['model' => $model, 'type' => $this->type, 'org' => $this->org]);
	}

	public function actionManage()
	{
		$model = new ImParcel('search');
		$model->unsetAttributes();
		$model->ot_id = null;
//		$model->dbCriteria->order = 't.id ASC';
		if (isset($_GET['ImParcel'])&&$model->ref=="Search") {
			$model->ref = "";
		}
		if (isset($_GET['ImParcel'])) {
			$model->attributes = $_GET['ImParcel'];
		}
		if (isset(Yii::app()->user->org) && Yii::app()->user->org > 1) {
			$model->agent_id = Yii::app()->user->org;
		}

		if(isset($_GET['awb']))
		{
			$model->awb_name = trim($_GET['awb']);
		}
		if (!isset($_GET['ImParcel'])) {
			$model->ref = "Search";
		}
		$this->render('manage', ['model' => $model, 'type' => $this->type]);
	}

	public function actionExport()
	{
		$model = new ImParcel('search');
		$model->unsetAttributes();
		$model->dbCriteria->order = 't.id DESC';
		if (!empty($_GET['ImParcel'])) {
			$model->attributes = $_GET['ImParcel'];
		}
		if (Yii::app()->user->org > 1) {
			$model->agent_id = Yii::app()->user->org;
		}

		if(isset($_GET['awb']))
		{
			$model->awb_name = trim($_GET['awb']);
		}
		
		$criteria = new CDbCriteria;
		$criteria->condition = "t.created >= '".$_POST['start']."' AND t.created < DATE_ADD('".$_POST['end']."', INTERVAL 1 DAY)";
		$dp = $model->search(false, 0, $criteria);

		$xls = new oExcel;
		$i = 1;
		$xls->addRow($i++, ['运单号', '参考号','客户运单号','重量', '状态', '发件人', '电话', '收件人', '电话', '地址', '区','洲','国家', '日期','件数','品名与数量','总价值','币种']);

		foreach ($dp->data as $r) {
			if (empty($r->cnee)) {
				continue;
			}

			$rowData = ['="'.$r->hbn.'"',
				'="'.$r->ref.'"',
				empty($r->cref)? '' : '="'.$r->cref.'"',
				'="'.$r->weight.'"',
				$r->getStatus(),
				$r->cnor->name,
				'="'.$r->cnor->tel.'"',
				$r->cnee->name,
				'="'.$r->cnee->tel.'"',
				$r->cnee->address,
				$r->cnee->suburb,
				$r->cnee->state,
				$r->cnee->country,
				$r->created,$r->pkg,$r->getGoodsDescription(),$r->dvalue,ImParcel::$currencyTypes[$r->currency]];

			$xls->addRow($i++, $rowData);
		}
		$xls->output('shipment_export_'.time().'.xlsx');
	}

	public function actionReport()
	{
		$model = new ImParcel('search');
		$xls = new oExcel;
		$i = 1;
		$hdr = ['运单号', '派送单号', '参考号','重量', '状态', '发件人', '电话', '收件人', '电话', '地址', '区','洲','邮编', '日期'];
		$fn = 'shipment_report_'.time().'.xlsx';
		$addInfo = function ($r, &$d) {
			return;
		};
		switch ($_GET['type']) {
			case 'noid':
				$rs = $model->with('cnee')->findAll('agent_id = :aid AND status < 18 AND cnee.cnid_id = 0', [':aid' => Yii::app()->user->org]);
			break;
			case 'nop':
				$rs = $model->findAll('agent_id = :aid AND status NOT IN (100,102) AND cbwf = 1', [':aid' => Yii::app()->user->org]);
			break;
			case 'dlv':
				$rs = $model->findAll('agent_id = :aid AND status IN (70, 80, 81, 83, 94) AND created > DATE_SUB(NOW(), INTERVAL 3 MONTH)', [':aid' => Yii::app()->user->org]);
				$hdr[] = '派送信息';
				$fn = 'shipment_delivery_report_'.time().'.xlsx';
				$addInfo = function ($r, &$d) {
					$ts = $r->tracks;
					$c = [];
					for ($i = 0; $i< 3; $i++) {
						$t = array_pop($ts);
						if (empty($t)) {
							break;
						}
						$c[] = $t->dt.': '.$t->activity;
					}
					if (!empty($c)) {
						$d[] = implode("\n", $c);
					}
				};
			break;
		}

		$xls->addRow($i++, $hdr);

		foreach ($rs as $r) {
			$rowData = ['="'.$r->hbn.'"',
				empty($r->ref)? '' : '="'.$r->ref.'"',
				empty($r->cref)? '' : '="'.$r->cref.'"',
				'="'.$r->weight.'"',
				$r->getStatus(),
				$r->cnor->name,
				'="'.$r->cnor->tel.'"',
				$r->cnee->name,
				'="'.$r->cnee->tel.'"',
				$r->cnee->address,
				$r->cnee->suburb,
				$r->cnee->state,
				$r->cnee->postcode,
				$r->created];
			$addInfo($r, $rowData);
			$xls->addRow($i++, $rowData);
		}
		$xls->output($fn);
	}

	public function actionExportOrgTLDWithoutPackages()
	{
		$reportService = new ReportService();
		$data = $reportService->getOrgTLDWithoutPackages(User::currentUserOrgId());
		$i = 1;
		$header = ['港口','运单号', '派送单号', '客户运单号','重量', '总体积', '件数'];
		$filename = 'shipment_report_'.time().'.xlsx';
		$reportService->exportData($data,$header,$filename);
	}
	
	public function actionBulkPrint($s, $fn)
	{
		$model = new ImParcel('search');
		switch ($s) {
			case 'nop':
				$rs = $model->findAll('agent_id = :aid AND status NOT IN (100,102) AND cbwf = 1', [':aid' => Yii::app()->user->org]);
			break;
			case 'irnop':
				$rs = $model->findAll('agent_id = :aid AND status >= 18 AND status NOT IN (100,102) AND cbwf = 1', [':aid' => Yii::app()->user->org]);
			break;
			default:
				$model->mids = explode(',', $s);
				$dp = $model->search(false);
				$rs = $dp->data;
			break;
		}

		foreach($rs as $key => $d)
		{
			if ($d->status == 8) {
				$d->status = 9;
				$d->save();
			} elseif (($r->cbwf & 1) > 0) {
				$d->cbwf -= 1;
				$d->custom_log_note = 'Printed';
				$d->save();
			}
			if(!empty($d->consol)&&preg_match('/WDT/i', $d->consol->no))
			{
				continue;
			}

			$apiLabel = ImParcelService::getEizLabel($d);
			if(!empty($apiLabel))
			{
				$ps[] = $apiLabel;
			}else
			{
				$normal[] = $d;
			}
		}

		if(!empty($normal))
		{
			$normalLabel = oPDF::renderPDF('label_A6', ['tpl' => '_label_1', 'rs' => $normal], 2);
			$ps[] = $normalLabel;
		}

		oPDF::mergePDF($ps, 1, true, $fn.'.pdf');
	}
	
