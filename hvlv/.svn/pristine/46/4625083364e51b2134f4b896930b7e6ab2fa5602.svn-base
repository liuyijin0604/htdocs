		}

		$model->willBeCargoProcess = true;
		$model->ot_id = null;
		$this->render('bookschedules',["model"=>$model]);
	}

	public function actionScheduleBooking(){
		//$temp = $_POST;
		$bookDate = $_POST['date'];
		$arrayShipmentID = explode(',',$_POST['id']);
		$successfulShipmentsCount = 0;
		$errorShipmentCount = 0;
		$successfulInfo=[];
		$errorInfo=[];

		$transaction=Yii::app()->db->beginTransaction();
		try{
			foreach ($arrayShipmentID as $shipmentId){
				$model = ImParcel::model()->findByPk($shipmentId);
				$unloadDate = @$model->consol->mdata['ContainerUnloadDate'];
				$oldBookDate = $model->mdata['delivery_booking_time'];
				if($unloadDate<$bookDate&&!empty($unloadDate)){
					$cargoProcessModel = CargoProcess::model()->findBySql('select * from cargo_process where status = 10 and status !=101 and shipment_id ='.$shipmentId);
					if(!empty($cargoProcessModel)){
						if(!empty($cargoProcessModel->mdata['delivery_booking_time'])){
							$model->mdata['delivery_booking_time'] = $bookDate;
							$model->update(['meta']);
							$cargoProcessModel->mdata['delivery_booking_time']=$bookDate;
							$cargoProcessModel->save();
							$cargoProcessModel->saveNormalDeliveryInfo($bookDate);
							$successfulShipmentsCount++;
							$successfulInfo[] = "<br /> Ref: ".$model->ref." update successful! Schedule Date: ".$bookDate;
						}else{
							$model->mdata['delivery_booking_time'] = $bookDate;
							$model->update(['meta']);
							$oldBookDate = $cargoProcessModel->mdata['delivery_booking_time'];
							$cargoProcessModel->mdata['delivery_booking_time']=$bookDate;
							$cargoProcessModel->save();
							$cargoProcessModel->saveNormalDeliveryInfo($bookDate);
							$successfulShipmentsCount++;
							$successfulInfo[] = "<br /> Ref: ".$model->ref." update successful! Old Date ".$oldBookDate." New Date: ".$bookDate;
						}
					}else{
						if(empty($oldBookDate)){
							//$model->mdata['CustomerBookingDate'] = $bookDate;
							$model->mdata['delivery_booking_time'] = $bookDate;
							$model->update(['meta']);
							$model->saveNormalDeliveryInfo($bookDate);
							$successfulShipmentsCount++;
							$successfulInfo[] = "<br /> Ref: ".$model->ref." update successful! Schedule Date: ".$bookDate;
						}else{
							$model->mdata['delivery_booking_time'] = $bookDate;
							$model->update(['meta']);
							$model->saveNormalDeliveryInfo($bookDate);
							$successfulShipmentsCount++;
							$successfulInfo[] = "<br /> Ref: ".$model->ref." update successful! Old Date ".$oldBookDate." New Date: ".$bookDate;
						}
					}
				}else{
					if(!empty($unloadDate)){
						$errorShipmentCount++;
						$errorInfo[] = "<br /> Ref: ".$model->ref." schedule date needs to be greate than ".$unloadDate;
					}else{
						/**
						 * if not have unloadDate and cargoprocess be created then update booking time;
						 */
						$cargoProcessModel = CargoProcess::model()->findBySql('select * from cargo_process where status = 10 and status !=101 and shipment_id ='.$shipmentId);
						if(!empty($cargoProcessModel)){
							if(!empty($cargoProcessModel->mdata['delivery_booking_time'])){
								$model->mdata['delivery_booking_time'] = $bookDate;
								$model->update(['meta']);
								$cargoProcessModel->mdata['delivery_booking_time']=$bookDate;
								$cargoProcessModel->save();
								$cargoProcessModel->saveNormalDeliveryInfo($bookDate);
								$successfulShipmentsCount++;
								$successfulInfo[] = "<br /> Ref: ".$model->ref." update successful! Schedule Date: ".$bookDate;
							}else{
								$model->mdata['delivery_booking_time'] = $bookDate;
								$model->update(['meta']);
								$oldBookDate = $cargoProcessModel->mdata['delivery_booking_time'];
								$cargoProcessModel->mdata['delivery_booking_time']=$bookDate;
								$cargoProcessModel->save();
								$cargoProcessModel->saveNormalDeliveryInfo($bookDate);
								$successfulShipmentsCount++;
								$successfulInfo[] = "<br /> Ref: ".$model->ref." update successful! Old Date ".$oldBookDate." New Date: ".$bookDate;
							}
						}else{
							$errorShipmentCount++;
							$errorInfo[] = "<br /> Ref: ".$model->ref." could not be update!";
						}
					}
					
				}
			}
			if(empty($errorInfo)){
				$transaction->commit();
				echo json_encode([
					'isSuccess' => true,
					'shipmentscount' => $successfulShipmentsCount,
					'info'=>$successfulInfo,
				]);
				return;
			}else{
				$transaction->rollback();
				echo json_encode([
					'isSuccess' => false,
					'shipmentscount' => $errorShipmentCount,
					'info'=>$errorInfo,
				]);
				return;
			}
		}
		catch(Exception $ex){
			$transaction->rollback();
			throw $ex;
		}
	}

	public function actionProcessPage()
	{
		switch ($_GET['tab']) {
			case 'need_schedule':
				$model = new ImParcel('search');
				$model->unsetAttributes();
				if(!empty($_GET["ImParcel"]))
				{
					$model->setAttributes($_GET["ImParcel"]);
				}
				if (isset(Yii::app()->user->org) && Yii::app()->user->org > 1) {
					$model->agent_id = Yii::app()->user->org;
				}

				$model->willBeCargoProcess = true;
				$model->ot_id = null;
				$this->render('bookschedules',["model"=>$model]);
				break;
			case 'waiting_for_delivery':
				$model = new ImParcel('search');
				$model->unsetAttributes();
				if(!empty($_GET["ImParcel"]))
				{
					$model->setAttributes($_GET["ImParcel"]);
				}
				if (isset(Yii::app()->user->org) && Yii::app()->user->org > 1) {
					$model->agent_id = Yii::app()->user->org;
				}

				$model->overseasWarehouseBooked = true;
				$model->ot_id = null;
				$this->render('waiting_for_delivery', array('model' => $model));
				break;
		}
	}

