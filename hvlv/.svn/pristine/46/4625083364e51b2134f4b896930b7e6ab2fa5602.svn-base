	public function actionGetStorageFee()
	{
		if (isset($_POST['barcode'])) {
            GatePass::checkStorage($_POST['barcode'],Yii::app()->user->org,true);
            return;
        }

        $model = new ImParcel('search');
        $model->unsetAttributes();
//		$model->dbCriteria->order = 't.id ASC';
		if (isset($_GET['ImParcel'])) {
			$model->attributes = $_GET['ImParcel'];
		}
		if (isset(Yii::app()->user->org) && Yii::app()->user->org > 1) {
			$model->agent_id = Yii::app()->user->org;
		}
		$model->status = ImParcel::STATE_DUTY_HELD;

        $this->render('check_storage',['model'=>$model]);
	}

	public function actionUpdateStorageStatus($id)
	{
		$model = ImParcel::model()->findByPk($id);
//		$model->dbCriteria->order = 't.id ASC';
		if (isset($_POST['ImParcel'])) 
		{
			$model = ImParcel::model()->findByPk($_POST['ImParcel']['id']);
			if($model->status == ImParcel::STATE_DUTY_HELD)
			{
				$model->status = ImParcel::STATE_CLEAR_WAIT;
				$model->mdata['agent_release_parcel'] = 1; 
				$model->save();
				$this->ajaxResult($model);
			}
		}

        $this->render('update_storage_list_status',['model'=>$model]);
	}

	public function actionTimeReport()
	{
		$model=new ImParcel('search');
		$model->unsetAttributes();  // clear any default values
