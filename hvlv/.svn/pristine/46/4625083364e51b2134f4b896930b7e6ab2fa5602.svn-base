		$model->status = '>50';
		if (Yii::app()->user->grp>10) {
			$model->agent_id=Yii::app()->user->org;
		}

		$xls = new oExcel;
		$i = 1;
		// $xls->addRow($i++, ['WBN', 'Ref','Awb','Packages', 'Weight', 'Status', 'Agent', 'Sender', 'Sender Tel', 'Cnee Name', 'Cnee Tel', 'Address', 'State', 'Date', 'Delay','Extra Info']);
		$xls->addRow($i++, ['包裹追踪号', '柜号 / 提单号','Memo','状态','拆柜时间', '从PCA仓库出库时间', '派送商揽收时间	', '妥投时间', '最后一条追踪轨迹字段', '最后一条追踪轨迹对应的时间']);
		$dp = $model->search(false);
		foreach ($dp->data as $r) {
			$xls->addRow($i++, [$r->ref, @$r->consol->awb."  /  ".@$r->consol->mdata["container_no"],$r->can, ImParcel::$states[$r->status],ImParcelService::getTimePoint($r,1),ImParcelService::getTimePoint($r,2),ImParcelService::getTimePoint($r,3),ImParcelService::getTimePoint($r,4),is_array(ImParcelService::getTimePoint($r,5))?ImParcelService::getTimePoint($r,5)[0]:"",is_array(ImParcelService::getTimePoint($r,5))?ImParcelService::getTimePoint($r,5)[1]:""]);
		}
		$xls->output('time_report_'.time().'.xlsx');
	}

