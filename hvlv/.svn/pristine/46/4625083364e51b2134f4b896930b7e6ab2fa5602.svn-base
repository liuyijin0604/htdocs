	public function actionCheckStorage()
	{
		if (!empty($_POST)) {
			$res = new stdClass;
			$shipmentId = $_POST['shipment_id'];
			$scheduledDate = $_POST['scheduled_date'];
			$scheduledDate = date('Y-m-d', strtotime($scheduledDate));
			$shipment = ImParcel::model()->findByPk($shipmentId);
			$cargoProcessService = new CargoProcessService();
			//$storage = $shipment->getStorageFee(false, $scheduledDate);
			$storage = $cargoProcessService->calculateCargoProcessStorageFee($scheduledDate, $shipment);
			$res->storageFee = $storage[0];
			$res->storageDays = $storage[1];
			$res->storageStart = $storage[2];
			$res->storageTo = $storage[3];
			echo json_encode($res);
		}
	}

	public function actionUpdateScheduledDate()
	{
		if (!empty($_GET['id'])) {
			$shipment = ImParcel::model()->findByPk($_GET['id']);
			$this->render('update_scheduled_date', array('model'=>$shipment));
		} else if (!empty($_POST)) {
			$res = new stdClass;
			$res->success = true;
			$shipmentId = $_POST['shipment_id'];
			$scheduledDate = date('Y-m-d', strtotime($_POST['scheduled_date']));
			$bookingRef = !empty($_POST['amazon_po']) ? $_POST['amazon_po'] : '';
			$amazonShipmentIds = !empty($_POST['amazon_shipment_id']) ? $_POST['amazon_shipment_id'] : '';
			$res->deliveryDate = $scheduledDate;
			$storageStart = date('Y-m-d', strtotime($_POST['storage_start']));
			$storageTo = date('Y-m-d', strtotime($_POST['storage_to']));
			$storageDays = intval($_POST['storage_days']);
			$storageFee = floatval($_POST['storage_fee']);
			$res->errMsg = '';

			$transaction = Yii::app()->db->beginTransaction();
			try {
				$shipment = ImParcel::model()->findByPk($shipmentId);
				$availableDate = $shipment->getUnPackingDate();
				if (!empty($availableDate)) {
					if (preg_match("/PICKUP/i", $shipment->ref) && preg_match("/WDT/i", $shipment->consol->no)) {
						if (date('w', strtotime($availableDate)) == 6 || date('w', strtotime($availableDate)) == 5) {
							$availableDate = date('Y-m-d', strtotime($availableDate . '+5 day'));
						} else if (date('w', strtotime($availableDate)) == 0) {
							$availableDate = date('Y-m-d', strtotime($availableDate . '+4 day'));
						} else {
							$availableDate = date('Y-m-d', strtotime($availableDate . '+3 day'));
						}
					} else {
						if (date('w', strtotime($availableDate)) == 6 || date('w', strtotime($availableDate)) == 5) {
							$availableDate = date('Y-m-d', strtotime($availableDate . '+4 day'));
						} else if (date('w', strtotime($availableDate)) == 0) {
							$availableDate = date('Y-m-d', strtotime($availableDate . '+3 day'));
						} else {
							$availableDate = date('Y-m-d', strtotime($availableDate . '+2 day'));
						}
					}	
				}
				$oldBookDate = @$shipment->mdata['delivery_booking_time'];
				if (!empty($availableDate) && $availableDate < $scheduledDate) {
					$cargoProcessModel = CargoProcess::model()->findBySql('select * from cargo_process where status !=101 and shipment_id ='.$shipmentId);
					if (!empty($cargoProcessModel)) {
						if (!empty($cargoProcessModel->mdata['delivery_booking_time'])) {
							$shipment->mdata['delivery_booking_time'] = $scheduledDate;
							$shipment->mdata['amazon_po'] = $bookingRef;
							$shipment->mdata['amazon_shipment_ids'] = $amazonShipmentIds;
							$shipment->update(['meta']);
							$cargoProcessModel->mdata['delivery_booking_time'] = $scheduledDate;
							$cargoProcessModel->save();
							$cargoProcessModel->saveNormalDeliveryInfo($scheduledDate);
						} else {
							$shipment->mdata['delivery_booking_time'] = $scheduledDate;
							$shipment->mdata['amazon_po'] = $bookingRef;
							$shipment->mdata['amazon_shipment_ids'] = $amazonShipmentIds;
							$shipment->update(['meta']);
							$oldBookDate = $cargoProcessModel->mdata['delivery_booking_time'];
							$cargoProcessModel->mdata['delivery_booking_time'] = $scheduledDate;
							$cargoProcessModel->save();
							$cargoProcessModel->saveNormalDeliveryInfo($scheduledDate);
						}
					} else {
						if(empty($oldBookDate)) {
							$shipment->mdata['delivery_booking_time'] = $scheduledDate;
							$shipment->mdata['amazon_po'] = $bookingRef;
							$shipment->mdata['amazon_shipment_ids'] = $amazonShipmentIds;
							if (empty($shipment->scan)) {
								$shipment->mdata['cargo_ignore_scan'] = 1;
							}
							$shipment->save();
							$shipment->saveNormalDeliveryInfo($scheduledDate);
						} else {
							$shipment->mdata['delivery_booking_time'] = $scheduledDate;
							$shipment->mdata['amazon_po'] = $bookingRef;
							$shipment->mdata['amazon_shipment_ids'] = $amazonShipmentIds;
							if (empty($shipment->scan)) {
								$shipment->mdata['cargo_ignore_scan'] = 1;
							}
							$shipment->save();
							$shipment->saveNormalDeliveryInfo($scheduledDate);
						}
					}
				} else {
					if (!empty($availableDate)) {
						$res->success = false;
						$res->errMsg = 'Items are not available on your selected date, please choose another date.';
					} else {
						$cargoProcessModel = CargoProcess::model()->findBySql('select * from cargo_process where status !=101 and shipment_id ='.$shipmentId);
						if (!empty($cargoProcessModel)) {
							if (!empty($cargoProcessModel->mdata['delivery_booking_time'])) {
								$shipment->mdata['delivery_booking_time'] = $scheduledDate;
								$shipment->mdata['amazon_po'] = $bookingRef;
								$shipment->mdata['amazon_shipment_ids'] = $amazonShipmentIds;
								$shipment->update(['meta']);
								$cargoProcessModel->mdata['delivery_booking_time'] = $scheduledDate;
								$cargoProcessModel->save();
								$cargoProcessModel->saveNormalDeliveryInfo($scheduledDate);
							} else {
								$shipment->mdata['delivery_booking_time'] = $scheduledDate;
								$shipment->mdata['amazon_po'] = $bookingRef;
								$shipment->mdata['amazon_shipment_ids'] = $amazonShipmentIds;
								$shipment->update(['meta']);
								$oldBookDate = $cargoProcessModel->mdata['delivery_booking_time'];
								$cargoProcessModel->mdata['delivery_booking_time'] = $scheduledDate;
								$cargoProcessModel->save();
								$cargoProcessModel->saveNormalDeliveryInfo($scheduledDate);
							}
						} else {
							$res->success = false;
							$res->errMsg = 'Ref: ' . $shipment->ref . ' could not be update.';
						}
					}
				}

				if ($storageFee > 0 && $storageDays > 0) {
					$invoiceService = new InvoiceService();
					$invoiceService->createCGStorageInvoice($shipment, $storageStart, $storageTo, $storageDays, $storageFee);
					$shipment->mdata['cg_storage_invoiced_to'] = $storageTo;
					$shipment->update(['meta']);
				}
				$transaction->commit();
			} catch (Exception $e) {
				$transaction->rollback();
				throw $e;
			}
			
			echo json_encode($res);
		}
	}

	public function actionCancelSchedule($id)
	{
		$shipment = ImParcel::model()->findByPk($id);
		if (!empty($shipment)) {
			$shipment->mdata['delivery_booking_time'] = '';
			if (Yii::app()->user->org == 1) {
				$shipment->mdata['delivery_booking_cancelled_by'] = 'internal';
			} else {
				$shipment->mdata['delivery_booking_cancelled_by'] = 'external';
			}
			$shipment->update(['meta']);
			$cargoProcess = CargoProcess::model()->findByAttributes(array('shipment_id' => $shipment->id));
			if (!empty($cargoProcess)) {
				$cargoProcess->mdata['delivery_booking_time'] = '';
				$cargoProcess->save();
			}
		}	
	}

	public function actionShowInfo()
	{
		if (!empty($_GET['id'])) {
