	}
		
	public function actionPrintCreditNote($id)
	{
		$model = $this->loadModel($id);
		if ($model->status!=6 && Yii::app()->user->grp != 0) {
			if ($model->status==1) {
				echo "<h1>The Credit Note Need to be Approved!</h1>";
			} elseif ($model->status==9) {
				echo  "<h1>The Credit Note already been deleted!";
			}
			return;
		}
		if (empty($_GET['type']) || $_GET['type'] == 'pdf') {
			oPDF::renderPDF('credit_note', ['credit' => $model], 1, $model->id . '.pdf');
		} else {
			$model->exportExcel();
		}
	}

	/**
	 * Lists and search.
	 */
	public function actionList()
	{
		$model=new Payment('search');
		$model->unsetAttributes();  // clear any default values
		if (isset($_GET['Payment'])) {
			$model->attributes=$_GET['Payment'];
		}


		$this->render('list', [
			'model'=>$model,
		]);
	}

	public function actionExport()
	{
		$xls = new oExcel;
		$i = 1;
		$setHdr = function () use ($xls, &$i) {
			$xls->addRow($i++, ['Date', 'No', 'Transaction Date', 'Client', 'Agent ID', 'Status', 'Type', 'Account', 'Currency', 'Amount', 'Gst',  'Avl. Amt', 'Inv#', 'Ref']);
			$xls->setColWidth([10,10,25,10,15,10,15,15,15,10,15,15,15,15]);
		};

		switch ($_GET['type']) {
			case 'search':
				$setHdr();
				$model=new Payment('search');
				$model->unsetAttributes();
				if (!empty($_GET['Payment'])) {
					$model->attributes=$_GET['Payment'];
				}
				$dp = $model->search(false, 0);
				foreach ($dp->data as $r) {
					if ($r->status == 9) {
						continue;
					}
					$xls->addRow($i++, [$r->date, $r->no, $r->transaction_date, $r->cust->name, $r->org_id, $r->getStatus(), $r->getType(), $r->getBank(), $r->getCurrency(), $r->amount, $r->getInvoiceGsts(), $r->ata, $r->getInvNos(), '="'.$r->ref.'"']);
				}
				$xls->output('receipt_search_export_'.time().'.xlsx');
			break;
			case 'report':
				$setHdr();
				$q = 'date >= :fd AND date <= :td AND status = 6';
				$ps = [':fd' => $_POST['fromdate'], ':td' => $_POST['todate']];
				if(!empty($_POST['agent_id'])){
					$q .= ' AND org_id = :agt';
					$ps[':agt'] = $_POST['agnet_id'];
				}
				$rs = Payment::model()->findAll($q, $ps);

				foreach ($rs as $r) {
					$xls->addRow($i++, [$r->date, $r->transaction_date, $r->cust->name, $r->org_id, $r->getStatus(), $r->getType(), $r->getBank(), $r->getCurrency(), $r->amount, $r->getInvoiceGsts(), $r->ata, $r->getInvNos(), '="'.$r->ref.'"']);
				}
				$xls->output('receipt_report_'.$_POST['fromdate'].'_'.$_POST['todate'].'.xlsx');
			break;
		}
		Yii::app()->end();
	}

	public function actionReport()
	{
		$this->render('report');
	}

	/**
	 * Returns the data model based on the primary key given in the GET variable.
	 * If the data model is not found, an HTTP exception will be raised.
	 * @param integer the ID of the model to be loaded
	 */
	public function loadModel($id)
	{
		$model=Payment::model()->findByPk($id);
		if ($model===null) {
			throw new CHttpException(404, 'The requested page does not exist.');
		}
		return $model;
	}

	/**
	 * Performs the AJAX validation.
	 * @param CModel the model to be validated
	 */
	protected function performAjaxValidation($model)
	{
		if (isset($_POST['ajax']) && $_POST['ajax']==='payment-form') {
			echo CActiveForm::validate($model);
			Yii::app()->end();
		}
	}
}
