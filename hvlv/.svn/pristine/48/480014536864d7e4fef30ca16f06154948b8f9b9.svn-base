	public function getWarehouseData()
	{
		$cacheKey = "getWarehouseData";
		$provide = Yii::app()->cache->get($cacheKey);
		if(!empty($provide))
		{
			return json_decode($provide,true);
		}

		$provide = [];
		$lastWorkingDay = HolidayHelper::getLastWeekday(date("Y-m-d"),'AUSYD');
		$lastMonthWorkingDay = HolidayHelper::getLastWeekday(date("Y-m-d",strtotime('+1 day',strtotime("-1 month",strtotime(date("Y-m-d"))))),'AUSYD');
		$today = date("Y-m-d");
		$inStr = "Wating for WH scan";
		$outStr= "Waiting for AirOut/Manifest";
		$temp = array($lastWorkingDay=>['id'=>0,'date'=>'Last Working Day','in_pkg'=>0,'in_weight'=>0,'out_pkg'=>0,'out_weight'=>0],$today=>['id'=>1,'date'=>'Today till Now','in_pkg'=>0,'in_weight'=>0,'out_pkg'=>0,'out_weight'=>0],$lastMonthWorkingDay=>['id'=>2,'date'=>'Last Month Same Day','in_pkg'=>0,'in_weight'=>0,'out_pkg'=>0,'out_weight'=>0],);

		$data = $this->getData($inStr,$lastWorkingDay,$lastMonthWorkingDay);
		$outData = $this->getDataOut($lastWorkingDay,$lastMonthWorkingDay);

		foreach ($data as $key => $value) {
			$dateName = date('Y-m-d',strtotime($value['date']));
			$temp[$dateName]['in_pkg'] = $value['pkg'];
			$temp[$dateName]['in_weight'] = $value['weight'];
		}

		foreach ($outData as $key => $value) {
			$dateName = date('Y-m-d',strtotime($value['date']));
			$temp[$dateName]['out_pkg'] = $value['pkg'];
			$temp[$dateName]['out_weight'] = $value['weight'];
		}

		$temp["Today vs Last Working Day"] = ['id'=>4,'date'=>'Today vs Last Working Day',
			'in_pkg'=>round($temp[$today]['in_pkg']*100000/($temp[$lastWorkingDay]['in_pkg']*1000+1),0)."%",
			'in_weight'=>round($temp[$today]['in_weight']*100000/($temp[$lastWorkingDay]['in_weight']*1000+1),0)."%",
			'out_pkg'=>round($temp[$today]['out_pkg']*100000/($temp[$lastWorkingDay]['out_pkg']*1000+1),0)."%",
			'out_weight'=>round($temp[$today]['out_weight']*100000/($temp[$lastWorkingDay]['out_weight']*1000+1),0)."%"];

		$temp["Today vs Last Month Same Day"] = ['id'=>4,'date'=>'Today vs Last Month Same Day',
			'in_pkg'=>round($temp[$today]['in_pkg']*100000/($temp[$lastMonthWorkingDay]['in_pkg']*1000+1),0)."%",
			'in_weight'=>round($temp[$today]['in_weight']*100000/($temp[$lastMonthWorkingDay]['in_weight']*1000+1),0)."%",
			'out_pkg'=>round($temp[$today]['out_pkg']*100000/($temp[$lastMonthWorkingDay]['out_pkg']*1000+1),0)."%",
			'out_weight'=>round($temp[$today]['out_weight']*100000/($temp[$lastMonthWorkingDay]['out_weight']*1000+1),0)."%"];


		foreach ($temp as $key => $value) {
			if(!in_array($key,["Today vs Last Working Day","Today vs Last Month Same Day"]))
			{
				$temp[$key]['in_pkg'] = number_format($value['in_pkg'],0,'.',',')."pcs";
				$temp[$key]['out_pkg'] = number_format($value['out_pkg'],0,'.',',')."pcs";
				$temp[$key]['in_weight'] = number_format($value['in_weight'],0,'.',',')."kg";
				$temp[$key]['out_weight'] = number_format($value['out_weight'],0,'.',',')."kg";
			}
		}


		$provide = [];
		foreach ($temp as $key => $value) {
			$provide[] = $value;
		}
		Yii::app()->cache->set($cacheKey,json_encode($provide),300);
		return $provide;
	}

	public function getWarehouseDataMonth()
	{
		$cacheKey = "getWarehouseDataMonth";
		$provide = Yii::app()->cache->get($cacheKey);
		if(!empty($provide))
		{
			return json_decode($provide,true);
		}

		$provide = [];
		$lastMonth = date("Y-m", strtotime("-1 month",strtotime(date("Y-m-d"))));
		$lastMonthWorkingDay = date("Y-m-d",strtotime("-1 month",strtotime(date("Y-m-d"))));
		$thisMonth = date("Y-m");
		
		$temp = array(
			$lastMonth=>['id'=>0,'date'=>'Last Month till Today','in_pkg'=>0,'in_weight'=>0,'out_pkg'=>0,'out_weight'=>0],
			$thisMonth=>['id'=>1,'date'=>'This Month till Today','in_pkg'=>0,'in_weight'=>0,'out_pkg'=>0,'out_weight'=>0],);
		$inStr = "Wating for WH scan";
		$outStr= "Waiting for AirOut/Manifest";

		$data = $this->getMonthData($inStr,$lastMonth,$thisMonth,$lastMonthWorkingDay);
		$outData = $this->getMonthData($outStr,$lastMonth,$thisMonth,$lastMonthWorkingDay);

		foreach ($data as $key => $value) {
			$dateName = date('Y-m',strtotime($value['date']));
			$temp[$dateName]['in_pkg'] = $value['pkg'];
			$temp[$dateName]['in_weight'] = $value['weight'];
		}

		foreach ($outData as $key => $value) {
			$dateName = date('Y-m',strtotime($value['date']));
			$temp[$dateName]['out_pkg'] = $value['pkg'];
			$temp[$dateName]['out_weight'] = $value['weight'];
		}

		$temp["This Month vs Last Month"] = ['id'=>3,'date'=>'This Month vs Last Month',
			'in_pkg'=>round($temp[$thisMonth]['in_pkg']*100000/($temp[$lastMonth]['in_pkg']*1000+1),0)."%",
			'in_weight'=>round($temp[$thisMonth]['in_weight']*100000/($temp[$lastMonth]['in_weight']*1000+1),0)."%",
			'out_pkg'=>round($temp[$thisMonth]['out_pkg']*100000/($temp[$lastMonth]['out_pkg']*1000+1),0)."%",
			'out_weight'=>round($temp[$thisMonth]['out_weight']*100000/($temp[$lastMonth]['out_weight']*1000+1),0)."%"];
		
		foreach ($temp as $key => $value) {
			if($key!="This Month vs Last Month")
			{
				$temp[$key]['in_pkg'] = number_format($value['in_pkg'],0,'.',',')."pcs";
				$temp[$key]['out_pkg'] = number_format($value['out_pkg'],0,'.',',')."pcs";
				$temp[$key]['in_weight'] = number_format($value['in_weight'],0,'.',',')."kg";
				$temp[$key]['out_weight'] = number_format($value['out_weight'],0,'.',',')."kg";
			}
		}

		$provide = [];
		foreach ($temp as $key => $value) {
			$provide[] = $value;
		}

		Yii::app()->cache->set($cacheKey,json_encode($provide),300);
		return $provide;
	}

	public function getAllGpDataMonth()
	{
		$cacheKey = "getAllGpDataMonth";
		$provide = Yii::app()->cache->get($cacheKey);
		if(!empty($provide))
		{
			return json_decode($provide,true);
		}

		$provide = [];
		$lastMonth = date("Y-m", strtotime("-1 month",strtotime(date("Y-m-d"))));
		$lastMonthWorkingDay = date("Y-m-d",strtotime("-1 month",strtotime(date("Y-m-d"))));
		$thisMonth = date("Y-m");

		$thisMonthData = $this->getGpMonthData($thisMonth."-01",date("Y-m-d"));
		$lastMonthData = $this->getGpMonthData($lastMonth."-01",$lastMonthWorkingDay);
		$provide[] = ["id"=>0,"date"=>"Last Month till Today","gp"=>$lastMonthData["gp"],"revenue"=>$lastMonthData["revenue"],"totalShipment"=>$lastMonthData["totalShipment"],"totalWeight"=>$lastMonthData["totalWeight"]];
		$provide[] = ["id"=>1,"date"=>"This Month till Today","gp"=>$thisMonthData["gp"],"revenue"=>$thisMonthData["revenue"],"totalShipment"=>$thisMonthData["totalShipment"],"totalWeight"=>$thisMonthData["totalWeight"]];

		$provide[] = ["id"=>2,"date"=>"This Month vs Last Month","gp"=>round($thisMonthData["gp"]*100000/($lastMonthData["gp"]*1000+1),0)."%","revenue"=>round($thisMonthData["revenue"]*100000/($lastMonthData["revenue"]*1000+1),0)."%","totalShipment"=>round($thisMonthData["totalShipment"]*100000/($lastMonthData["totalShipment"]*1000+1),0)."%","totalWeight"=>round($thisMonthData["totalWeight"]*100000/($lastMonthData["totalWeight"]*1000+1),0)."%"];
		
		foreach ($provide as $key => $value) {
			if($value['date']!="This Month vs Last Month")
			{
				$provide[$key]['gp'] = "$".number_format($value['gp'],0,'.',',');
				$provide[$key]['revenue'] = "$".number_format($value['revenue'],0,'.',',');
				$provide[$key]['totalShipment'] = number_format($value['totalShipment'],0,'.',',')."pcs";
				$provide[$key]['totalWeight'] = number_format($value['totalWeight'],0,'.',',')."kg";
			}
		}

		Yii::app()->cache->set($cacheKey,json_encode($provide),3000);

		return $provide;
		
	}

	public static function getValue($value){
		if(!empty($value)){
			return number_format($value,0, '.', ',');
		}else{
			return 0;
		}
	}

	public static function getDivValue($Divisor,$Dividend){
		if($Dividend!=0){
			return number_format($Divisor/$Dividend,0)+1;
		}else{
			return "n/a";
		}

	}

	public function getAvgCargoProcessCloseByMonth($reportType){
		$totalCloseMonth = 0;
		$totalB2CCloseMonth = 0;
		$countDays=0;
		$result =[];
		$beginDate = date('Y-m-01',strtotime(date("Y-m-d")));
		$endDate = date('Y-m-d',strtotime("$beginDate +1 month -1 day"));
		$models = ReportCache::model()->findAllBySql('select * from report_cache where status=1 and type='.$reportType.' and create_time >="'.$beginDate.'" and create_time <="'.$endDate.'"');
		if(!empty($models)){
			foreach($models as $model){
				$totalCloseMonth+=$model->mdata['todayClose']['weighttotals'];
				$totalB2CCloseMonth +=$model->mdata['todayClose']['norweighttotals'];
				$countDays++;
			}
			$result['totalCloseMonth'] = number_format($totalCloseMonth/$countDays,0,'.','');
			$result['totalB2CCloseMonth'] = number_format($totalB2CCloseMonth/$countDays,0,'.','');
		}

		$modelLeft = ReportCache::model()->findBySql('select * from report_cache where status = 1 and type = '.$reportType.' order by id desc limit 1');
		if(!empty($modelLeft)){
			$result['totalLeft'] = number_format($modelLeft->mdata['todayLeft']['weighttotals'],0,'.','');
			$result['totalNorLeft'] = number_format($modelLeft->mdata['todayLeft']['norweighttotals'],0,'.','');
			$result['totalClose'] = number_format($modelLeft->mdata['todayClose']['weighttotals'],0,'.','');
			$result['totalNorClose'] = number_format($modelLeft->mdata['todayClose']['norweighttotals'],0,'.','');
			$result['esttotal'] = self::getDivValue(number_format($modelLeft->mdata['todayLeft']['weighttotals'],0,'.',''),number_format($modelLeft->mdata['todayClose']['weighttotals'],0,'.',''));
			$result['estnor'] = self::getDivValue(number_format($modelLeft->mdata['todayLeft']['norweighttotals'],0,'.',''),number_format($modelLeft->mdata['todayClose']['norweighttotals'],0,'.',''));
			$result['esttotalavg'] =  self::getDivValue(number_format($modelLeft->mdata['todayLeft']['weighttotals'],0,'.',''),$result['totalCloseMonth']);
			$result['estnoravg'] =  self::getDivValue(number_format($modelLeft->mdata['todayLeft']['norweighttotals'],0,'.',''),$result['totalB2CCloseMonth']);
		}
		return $result;
	}

	public function getEffectiveDiff($reportType){
		$result = [0,0];
		$model = ReportCache::model()->findBySql('select * from report_cache where status = 1 and type = '.$reportType.' order by id desc limit 1');
		if(!empty($model)){
			$effective = $model->mdata['effective'];
			if(!empty($effective)){
				$diffb2ctotal = $effective['diffb2ctotal'];
				$diffb2ceffecttotal = $effective['diffb2ceffecttotal'];
				$diffb2cgooddelivery = $effective['diffb2cgooddelivery'];
				$result[0]=$diffb2ceffecttotal;
				$result[1]=$diffb2ctotal;
				$result[2]=$diffb2cgooddelivery;
				// if($diffb2ceffecttotal!=0){
				// 	$result = $diffb2ceffecttotal."/".$diffb2ctotal." ".(round(($diffb2ceffecttotal) / $diffb2ctotal, 4) * 100)."%"; 
				// }
			}
		}
		return $result;
	}

