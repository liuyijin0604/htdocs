	public function getWareHouseReminder($type=0){
		$provide = [];
		$recordPutAway['today'] = ReportService::getSortHeldTodayReminder($type);
		$recordPutAway['left'] = ReportService::getSortHeldReminder($type);
		$recordPutAway['all'] = ReportService::getSortHeldAll($type);
		$numTotalLeft = $recordPutAway['left']['SYDcount']+$recordPutAway['left']['MELcount']+$recordPutAway['left']['BNEcount'];

		$provide[] = ['id'=>0,'numTotalLeft'=>$numTotalLeft,'sydToday'=>$recordPutAway['today']['SYDcount'],'sydLeft'=>$recordPutAway['left']['SYDcount'],'sydAll'=>$recordPutAway['all']['SYDcount'],'melToday'=>$recordPutAway['today']['MELcount'],'melLeft'=>$recordPutAway['left']['MELcount'],'melAll'=>$recordPutAway['all']['MELcount'],'bneToday'=>$recordPutAway['today']['BNEcount'],'bneLeft'=>$recordPutAway['left']['BNEcount'],'bneAll'=>$recordPutAway['all']['BNEcount']];
		foreach ($provide as $key => $value) {
			$provide[$key]['numTotalLeft'] = $value['numTotalLeft'];
			$provide[$key]['sydToday'] = $value['sydToday'];
			$provide[$key]['sydLeft'] = $value['sydLeft'];
			$provide[$key]['sydAll'] = $value['sydAll'];
			$provide[$key]['melToday'] = $value['melToday'];
			$provide[$key]['melLeft'] = $value['melLeft'];
			$provide[$key]['melAll'] = $value['melAll'];
			$provide[$key]['bneToday'] = $value['bneToday'];
			$provide[$key]['bneLeft'] = $value['bneLeft'];
			$provide[$key]['bneAll'] = $value['bneAll'];
		}
		return $provide;
	}
}
