		return $provide;
		
	}

	private function getGpMonthData($startDate,$endDate)
	{
		$criteria=new CDbCriteria;

		$criteria->addCondition("t.eta >= '" .$startDate."'");
		$criteria->addCondition("t.eta <= '".$endDate ."'");
		$criteria->addCondition("t.status < 100");
		$criteria->addCondition("t.owner_id != 114"); // remove pca express owner which is for WMS 3PL local dilivery
		$criteria->addInCondition('type', [15,70,80]);
		$consols = Consol::model()->findAll($criteria);
		$totRevenue = 0;
		$totCost = 0;
		$totalShipment = 0;
		$totalWeight = 0;
		foreach ($consols as $consol) {
			$totalShipment += $consol->totShipments();
			$totalWeight += $consol->totWeight();
			$totRevenue += $consol->getTotalInvoice();
			$totCost += $consol->totCost();
		}
		if ($totRevenue > 0) {
			$totalProfitRate = round(($totRevenue - $totCost) / $totRevenue * 10000) / 10000;
		} else {
			$totalProfitRate = 0;
		}
		$totalData = [
			'revenue' => $totRevenue,
			'cost' => $totCost,
			'gp' => $totRevenue - $totCost,
			'profit' => $totalProfitRate,
			'totalShipment'=> $totalShipment,
			'totalWeight'=> $totalWeight,
		];
		return $totalData;
	}

	private function getData($checkStr,$lastWorkingDay,$lastMonthWorkingDay)
	{
		$sql = "SELECT `time` as date,sum(pkg) as pkg,sum(weight) as weight from (select s.*,t.time from shipment s join (SELECT l.time,c.id FROM `consol` c join consol_process cp on c.id = cp.fid join log l on cp.id = l.lid where  c.service=10 and json_value(l.meta,'$.status')='${checkStr}' and l.model ='ConsolProcess' and (to_days(l.time) = to_days(now()) or to_days(l.time) = to_days('{$lastWorkingDay}') or to_days(l.time) = to_days('{$lastMonthWorkingDay}')) group by c.id) t on s.consol_id = t.id) st group by to_days(`date`) order by `date`";
		$data = Yii::app()->db->createCommand($sql)->queryAll();
		return $data;
	}

	private function getDataOut($lastWorkingDay,$lastMonthWorkingDay)
	{
		$sql = "SELECT `time` as date,sum(pkg) as pkg,sum(weight) as weight from 
		(select s.*,t.time from shipment s join 
		 (SELECT l.time,c.id FROM `consol` c join consol_process cp on c.id = cp.fid join log l on cp.id = l.lid  
		  where  c.service=10 and json_value(l.meta,'$.status')='Waiting for AirOut/Manifest' and l.model ='ConsolProcess' and (to_days(l.time) = to_days(now()) or to_days(l.time) = to_days('{$lastWorkingDay}') or to_days(l.time) = to_days('{$lastMonthWorkingDay}')) group by c.id) t on s.consol_id = t.id
		JOIN
		 (select s.id,t.time from shipment s join 
		 (SELECT l.time,c.id FROM `consol` c join consol_process cp on c.id = cp.fid join log l on cp.id = l.lid
		where  c.service=10  and json_value(l.meta,'$.status')='Wating for WH scan' and l.model ='ConsolProcess' and (to_days(l.time) = to_days(now()) or to_days(l.time) = to_days('{$lastWorkingDay}') or to_days(l.time) = to_days('{$lastMonthWorkingDay}')) group by c.id) t on s.consol_id =t.id) t2 on t2.id = s.id and to_days(t2.time) = to_days(t.time)

		) st group by to_days(`date`) order by `date`";
		$data = Yii::app()->db->createCommand($sql)->queryAll();
		return $data;
	}

	private function getMonthData($checkStr,$lastMonth,$thisMonth,$lastMonthWorkingDay)
	{
		$sql = "SELECT `time` as date,sum(pkg) as pkg,sum(weight) as weight from (select s.*,t.time from shipment s join (SELECT l.time,c.id FROM `consol` c join consol_process cp on c.id = cp.fid join log l on cp.id = l.lid and json_value(l.meta,'$.status')='${checkStr}' and l.model ='ConsolProcess' where  c.service=10 and ((l.time >= '$lastMonth-01 01:00:00' and l.time <= '$lastMonthWorkingDay 23:00:00') or (l.time >= '$thisMonth-01 01:00:00' and l.time <= '$thisMonth-31 23:00:00')) group by c.id) t on s.consol_id = t.id) st group by DATE_FORMAT(`date`, '%Y-%m') order by DATE_FORMAT(`date`, '%Y-%m')";

		$data = Yii::app()->db->createCommand($sql)->queryAll();
		return $data;
	}

	public function getConsolProcessReport($reportType)
	{
		$cacheKey = "getConsolProcessReport".$reportType;
		$provide = [];
		$model = ReportCache::model()->findBySql('select * from report_cache where status = 1 and type = '.$reportType.' order by id desc limit 1');
		$today = date("Y-m-d");
		if(!empty($model)){
			$todayNew = $model->mdata['todayNew'];
			$todayDone = $model->mdata['todayDone'];
        	$todayLeft = $model->mdata['todayLeft'];
		}
		if(empty($model)) return [];

		$provide[] = ["id"=>0,$today=>"Total",'col'=>'Consol',
						"totaln"=>self::getValue($todayNew["totalCount"]),"airn"=>self::getValue($todayNew["airCount"]),"sean"=>self::getValue($todayNew["seaCount"]),
						"totalc"=>self::getValue($todayDone["totalCount"]),"airc"=>self::getValue($todayDone["airCount"]),"seac"=>self::getValue($todayDone["seaCount"]),
						"totall"=>self::getValue($todayLeft["totalCount"]),"airl"=>self::getValue($todayLeft["airCount"]),"seal"=>self::getValue($todayLeft["seaCount"])
					];
		$provide[] = ["id"=>1,$today=>"CBM",'col'=>'CBM',
						"totaln"=>self::getValue($todayNew["totalCBM"]),"airn"=>self::getValue($todayNew["airCBM"]),"sean"=>self::getValue($todayNew["seaCBM"]),
						"totalc"=>self::getValue($todayDone["totalCBM"]),"airc"=>self::getValue($todayDone["airCBM"]),"seac"=>self::getValue($todayDone["seaCBM"]),
						"totall"=>self::getValue($todayLeft["totalCBM"]),"airl"=>self::getValue($todayLeft["airCBM"]),"seal"=>self::getValue($todayLeft["seaCBM"])
					];
		$provide[] = ["id"=>2,$today=>"WEIGHT",'col'=>'Weight',
						"totaln"=>self::getValue($todayNew["totalWeight"]),"airn"=>self::getValue($todayNew["airWeight"]),"sean"=>self::getValue($todayNew["seaWeight"]),
						"totalc"=>self::getValue($todayDone["totalWeight"]),"airc"=>self::getValue($todayDone["airWeight"]),"seac"=>self::getValue($todayDone["seaWeight"]),
						"totall"=>self::getValue($todayLeft["totalWeight"]),"airl"=>self::getValue($todayLeft["airWeight"]),"seal"=>self::getValue($todayLeft["seaWeight"])
					];
		
		
		foreach ($provide as $key => $value) {
			if($key==0){
				$provide[$key]['col'] = $value['col'];
				$provide[$key]['totaln'] = intval($value['totaln']);
				$provide[$key]['airn'] = intval($value['airn']);
				$provide[$key]['sean'] = intval($value['sean']);
				$provide[$key]['totalc'] = intval($value['totalc']);
				$provide[$key]['airc'] = intval($value['airc']);
				$provide[$key]['seac'] = intval($value['seac']);
				$provide[$key]['totall'] = intval($value['totall']);
				$provide[$key]['airl'] = intval($value['airl']);
				$provide[$key]['seal'] = intval($value['seal']);
			}elseif($key==1){
				$provide[$key]['col'] = $value['col'];
				$provide[$key]['totaln'] = $value['totaln']."M³";
				$provide[$key]['airn'] = $value['airn']."M³";
				$provide[$key]['sean'] = $value['sean']."M³";
				$provide[$key]['totalc'] = $value['totalc']."M³";
				$provide[$key]['airc'] = $value['airc']."M³";
				$provide[$key]['seac'] = $value['seac']."M³";
				$provide[$key]['totall'] = $value['totall']."M³";
				$provide[$key]['airl'] = $value['airl']."M³";
				$provide[$key]['seal'] = $value['seal']."M³";
			}elseif($key==2){
				$provide[$key]['col'] = $value['col'];
				$provide[$key]['totaln'] = $value['totaln']."Kg";
				$provide[$key]['airn'] = $value['airn']."Kg";
				$provide[$key]['sean'] = $value['sean']."Kg";
				$provide[$key]['totalc'] = $value['totalc']."Kg";
				$provide[$key]['airc'] = $value['airc']."Kg";
				$provide[$key]['seac'] = $value['seac']."Kg";
				$provide[$key]['totall'] = $value['totall']."Kg";
				$provide[$key]['airl'] = $value['airl']."Kg";
				$provide[$key]['seal'] = $value['seal']."Kg";
			}
			
		}
		return $provide;
	}

	public function getPutAwayReporySyd(){
		$cacheKey = "getPutAwayReporySyd";
		$provide = [];
		$models = ReportCache::model()->findBySql('select * from report_cache where status = 1 and type = 7 order by id desc limit 30');
		$arrSyd=$arrMel=$arrBne=[];
		if(!empty($models)){
			foreach($models as $model){
				$arrSyd[$model->create_time] = json_decode($model->mdata['SYD']);
				$arrMel[$model->create_time] = json_decode($model->mdata['MEL']);
				$arrBne[$model->create_time] = json_decode($model->mdata['BNE']);
			}
		}

	}

	public function getTPLDailySydReport(){
		$cacheKey = "getTPLDailySydReport";
		$provide = [];
		$model = ReportCache::model()->findBySql('select * from report_cache where status = 1 and type = 9 order by id desc limit 1');
		if(!empty($model)){
			$todayNew = $model->mdata['todayNew']['totalcount'];
			$todayInvoice = $model->mdata['todayNew']['totalinvcount'];
			$todayCost = $model->mdata['todayNew']['totalcostcount'];
			$todayLeft = $model->mdata['todayLeft']['totalcount'];
			$todayDone = $model->mdata['todayDone']['totalcount'];
		}else
		{
			return [];
		}

		$numTotalInv = $numTotalCost = $i = 0;
		$modelMonth = ReportCache::model()->findAllBySql('select * from report_cache where status = 1 and type = 9 and create_time >="'.date('Y-m-01', strtotime(date("Y-m-d"))).'"');
		if(!empty($modelMonth)){
			foreach($modelMonth as $modelDay){
				$numTotalInv += $modelDay->mdata['todayNew']['totalinvcount'];
				$numTotalCost += $modelDay->mdata['todayNew']['totalcostcount'];
				$i++;
			}
		}
		$numAvgInv = number_format($numTotalInv,2);
		$numAvgCost = number_format($numTotalCost,2);
		$numGPM = number_format($numTotalInv-$numTotalCost,2);

		if($todayNew+$todayLeft==0){
			$preFinished = $todayDone."/".($todayNew+$todayLeft)." 0.00%";
		}else{
			$preFinished = $todayDone."/".($todayNew+$todayLeft)." ".round($todayDone/($todayNew+$todayLeft)*100,2)."%";
		}

		//return $provide = [$todayNew,$todayInvoice,$todayInvoice-$todayCost,$todayLeft,$numAvgInv,$numAvgCost,$todayDone,$preFinished];
		$provide[] = ['id'=>0,'todaytask'=>$todayNew,'todayinvoice'=>$todayInvoice,'todaygp'=>$todayInvoice-$todayCost,'todayleft'=>$todayLeft,'monavginv'=>$numAvgInv,'monavgcost'=>$numGPM,'todaydone'=>$todayDone,'todayfinish'=>$preFinished];
		foreach ($provide as $key => $value) {
			$provide[$key]['todaytask'] = $value['todaytask'];
			$provide[$key]['todayinvoice'] = "$".$value['todayinvoice'];
			$provide[$key]['todaygp'] =  "$".$value['todaygp'];
			$provide[$key]['todayleft'] = $value['todayleft'];
			$provide[$key]['monavginv'] =  "$".$value['monavginv'];
			$provide[$key]['monavgcost'] =  "$".$value['monavgcost'];
			$provide[$key]['todaydone'] = $value['todaydone'];
			$provide[$key]['todayfinish'] = $value['todayfinish'];
		}
		return $provide;
	}

