<?php

/**
 * This is the model class for table "addr".
 *
 * The followings are the available columns in table 'addr':
 * @property string $id
 * @property string $owner_id
 * @property string $name
 * @property string $address
 * @property string $suburb
 * @property string $city
 * @property string $state
 * @property string $postcode
 * @property string $country
 * @property string $tel
 * @property string $email
 * @property string $acc
 */
class Addr extends CActiveRecord
{
	public $old_full_addr;
	public $auto_match = true;
	public $name_change = false;
	const LOCAL_CORRECT_SUBURB = 1;
	const LOCAL_CORRECT_POSTCODE = 2;
	const LOCAL_CORRECT_STATE = 4;
	const GEOCODE_CORRECT_SUBURB = 8;
	const GEOCODE_CORRECT_POSTCODE = 16;
	const GEOCODE_CORRECT_STATE = 32;
	const INCORRECTABLE_STATE = 512;

	public static $editStreetCode = [ 
		1=>"local correct suburb",
		2=>"local correct postcode",
		4=>"local correct state",
		8=>"geocode correct suburb",
		16=>"geocode correct postcode",
		32=>"geocode correct state",
		512=>"incorrectable"
	];


	/**
	 * @return string the associated database table name
	 */
	public function tableName()
	{
		return 'addr';
	}

	/**
	 * @return array validation rules for model attributes.
	 */
	public function rules()
	{
		// NOTE: you should only define rules for those attributes that
		// will receive user inputs.
		return [
			['owner_id, name, address,company, suburb, city, state, postcode, country, tel, email, cnid_id, cnid_no, acc', 'safe'],
			['name, email', 'length', 'max'=>200],
			['suburb, state', 'length', 'max'=>100],
			['postcode', 'length', 'max'=>20],
			['company', 'length', 'max'=>250],
			['country, tel', 'length', 'max'=>50],
			// The following rule is used by search().
			// @todo Please remove those attributes that should not be searched.
			['id, name, address, suburb, company,city, state, postcode, country, tel, email, cnid_id, cnid_no, acc', 'safe', 'on'=>'search'],
		];
	}

	/**
	 * @return array relational rules.
	 */
	public function relations()
	{
		// NOTE: you may need to adjust the relation name and the related
		// class name for the relations automatically generated below.
		return [
			'cnid' => [self::BELONGS_TO, 'CnID', 'cnid_id'],
			'latest' => [self::HAS_MANY, 'Addr', '', 'on'=>'latest.cnid_id = t.cnid_id AND t.id < latest.id'],
		];
	}

	public function ExportValidate($t=1, $adderr=false)
	{
		$err = [];
		if (empty($this->name)) {
			$err['name'] = in_array($t, [1,3])? 'Consignor Name required' : 'Consignee Name required';
		}
		if (in_array($t, [2, 4])) {
			if (empty($this->address)) {
				$err['address'] = 'Consignee Address required';
			}
			if (empty($this->tel)) {
				$err['tel'] = 'Consignee Phone required';
			}
		}
		if ($t == 2 && empty($this->cnid_id)) {
			$err['cnid_id'] = 'Consignee Chinese ID required';
		}

		if ($adderr) {
			foreach ($err as $k => $v) {
				$this->addError($k, $v);
			}
		}

		return $err;
	}

	public function fullAddress($cs=[])
	{
		$cs = empty($cs)? ['suburb', 'city', 'state', 'postcode', 'country'] : $cs;
		$fa = [];
		$addr = str_replace(',', ', ', $this->address);
		foreach ($cs as $c) {
			if ($c == 'address') {
				continue;
			}
			$fa[] = $this->{$c};
			//$addr = str_ireplace($this->{$c},'', $addr);
		}
		if (!in_array('country', $cs)) {
			$addr = str_ireplace(', '.$this->country, '', $addr);
		}
		return preg_replace('/[ ]*,[, ]+/', ', ', $addr.', '.implode(', ', $fa));
	}

	public function apAddress($cs=[])
	{
		$cs = empty($cs)? ['suburb', 'state', 'postcode'] : $cs;
		$fa = [];
		$addr = str_replace(',', ', ', ucwords(strtolower($this->address)));
		foreach ($cs as $c) {
			if ($c == 'address') {
				continue;
			}
			$fa[] = $this->{$c};
		}
		return preg_replace('/[ ]*,[, ]+/', ', ', $addr."\n ".strtoupper(implode(' ', $fa)));
	}
	
	public function getDest()
	{
		return $this->postcode;
	}

	public function getCnFullAddress($stf = false)
	{
		if (!empty($this->state) && strpos($this->address, mb_substr($this->state, 0, 2)) === 0 && !empty($this->city) && strpos($this->address, mb_substr($this->city, 0, 2)) > 0) { //check if address field already contains the full address
			$ad = $this->address;
		} else {
			if ($stf) {
				if ($this->state == $this->city) {
					$this->city = mb_substr($this->city, 0, 2);
				}
				$this->state = mb_substr($this->state, 0, 2);
				if (!empty($this->suburb)) {
					$this->address = str_replace($this->suburb, '', $this->address);
				}
				if (!empty($this->city)) {
					$this->address = str_replace($this->city, '', $this->address);
				}
			}
			$ad = ($this->state == $this->city? $this->state : $this->state.($this->city == '直辖县'? '' : $this->city)).($this->suburb == '市辖区'? '' : $this->suburb).$this->address;
		}
		return $stf? preg_replace('/\s+/', '', $ad) : $ad;
	}
	
	public function labelAddress($css="")
	{
		if ($this->country != 'PR China') {
			$cn = preg_replace('/(\w)\/(\w)/', '$1 / $2', $this->name);
			$a = ucwords(strtolower($cn)).'<br />';
		} else {
			$cn = $this->name;
			$a = $cn.'<br />';
		}
		$l = strlen($cn) > 32? 2 : 1;
		$a2 = $this->fullAddress(['suburb', 'state', 'postcode']);
		$l += ceil(strlen($a2) / 32);
		$a .= $a2;
		$a .= ($l < 4)? '<br />' : ' ';
		$a .= 'Phone: '.trim($this->tel);
		if ($l < 5) {
			return '<p style="'.$css.'">'.$a.'</p>';
		} else {
			$fs = 30 - $l*2;
			return '<p style="font-size:'.$fs.'px;'.$css.'">'.$a.'</p>';
		}
	}

	public function setCnAddr($addr, $pc='')
	{
		$this->address = preg_replace('/[, ]+/', '', AppHelper::semiAngle(trim($addr)));
		$this->address = preg_replace('/^中国/', '', $this->address);
		$this->postcode = $pc;
		$this->country = 'PR China';
		$cnp = CnProvince::model()->find('name LIKE :p', [':p' => mb_substr($addr, 0, 2)."%"]);
		if ($cnp) {
			$this->state = $cnp->name;
			foreach ($cnp->cities as $cnc) {
				if (strpos($addr, mb_substr($cnc->name, 0, -1)) !== false) {
					$this->city = $cnc->name;
					if (sizeof($cnc->areas) == 1) {
						$cna = $cnc->areas[0];
						$this->suburb = $cna->name;
						$this->postcode = empty($pc)? $cna->zip : $pc;
					} else {
						$sxq = null;
						foreach ($cnc->areas as $cna) {
							if ($cna->name == '市辖区') {
								$sxq = $cna;
							}
							if (strpos($addr, mb_substr($cna->name, 0, -1)) > 0) {
								$this->suburb = $cna->name;
								$this->postcode = empty($pc)? $cna->zip : $pc;
								break;
							}
						}
						//set postcode to the city
						if (empty($this->postcode) && !empty($sxq)) {
							$this->postcode = $sxq->zip;
						}
					}
					break;
				}
			}
			if (empty($this->city)) {//trying match area directly
				foreach ($cnp->cities as $cnc) {
					foreach ($cnc->areas as $cna) {
						if (strpos($addr, $cna->name) > 0) {
							$this->city = $cna->city->name;
							$this->suburb = $cna->name;
							$this->postcode = empty($pc)? $cna->zip : $pc;
							break 2;
						}
					}
				}
			}
		} else {
			$cnc = CnCity::model()->find('name LIKE :p', [':p' => mb_substr($addr, 0, 2)."%"]);
			if ($cnc) {
				$this->city = $cnc->name;
				$this->state = $cnc->province->name;
				foreach ($cnc->areas as $cna) {
					if (empty($this->postcode)) {
						$this->postcode = empty($pc)? $cna->zip : $pc;
					}
					if (strpos($addr, mb_substr($cna->name, 0, -1)) !== false) {
						$this->suburb = $cna->name;
						$this->postcode = empty($pc)? $cna->zip : $pc;
						break;
					}
				}
			}
		}
	}

	public function getZip($debug = false)
	{
		if ($debug) {
			echo '[O] P:', $this->state, ' C:', $this->city, ' S:', $this->suburb, ' Z:', $this->postcode, "\n";
		}
		//check zxs
		$rs = CnCity::model()->with('province')->findAll('province.name LIKE :p', [':p' => $this->state.'%']);
		$zxs = false;
		if (sizeof($rs) == 1) {
			$this->state = $rs[0]->province->name;
			$o_city = $this->city;
			$this->city = $rs[0]->name;
			$a = CnArea::model()->find('city_id = :cid AND name LIKE :a', [':cid' => $rs[0]->id, ':a' => $this->suburb.'%']);
			if (!$a) {
				$a = CnArea::model()->find('city_id = :cid AND name LIKE :a', [':cid' => $rs[0]->id, ':a' => $o_city.'%']);
				if ($a) {
					$o_suburb = $this->suburb;
					$this->suburb = $a->name;
					if (strpos($this->address, $o_suburb) === false) {
						$this->address = $o_suburb.$this->address;
					}
				}
			}
		}
		$a = CnArea::model()->with(['city', 'city.province'])->find([
			'condition' => 'province.name LIKE :p AND city.name LIKE :c AND t.name LIKE :s',
			'order' => 't.id',
			'params' => [':p' => $this->state.'%', ':c' => substr($this->city, 0, 9).'%', ':s' => substr($this->suburb, 0, 9).'%'],
		]);
		if (empty($a)) {
			$a = CnArea::model()->with(['city', 'city.province'])->find([
				'condition' => 'province.name LIKE :p AND city.name LIKE :c',
				'order' => 't.id',
				'params' => [':p' => $this->state.'%', ':c' => substr($this->city, 0, 9).'%'],
			]);
		}
		if (empty($a)) {
			$a = CnArea::model()->with(['city', 'city.province'])->find([
				'condition' => 'province.name LIKE :p AND t.name LIKE :s',
				'order' => 't.id',
				'params' => [':p' => $this->state.'%', ':s' => substr($this->city, 0, 9).'%'],
			]);
			if ($a) {
				$this->city = $a->city->name;
				$o_suburb = $this->suburb;
				$this->suburb = $a->name;
				if (!empty($o_suburb) && strpos($this->address, $o_suburb) === false) {
					$this->address = $o_suburb.$this->address;
				}
			}
		}
		if ($a) {
			$this->postcode = $a->zip;
		}
		if ($debug) {
			echo '[N] P:', $this->state, ' C:', $this->city, ' S:', $this->suburb, ' Z:', $this->postcode, "\n";
		}
	}

	public function auTel()
	{
		return self::auTelValid($this->tel);
	}
	
	public static function auTelValid($no)
	{
		$tel = preg_replace('/[^\d]+/', '', $no);
		$tel = trim($tel);
		$realTel = $tel;
		if (preg_match('/^1300(\d{6})$/', $tel, $m)) {
			// in order to avoid error
			// "message":"Phone number longer than 10 characters: 01300255533.","field":"shipments[0].to.phone"}
			$realTel = $tel;
		} elseif (preg_match('/61(\d{10})$/', $tel, $m)) {
			// in case +61 04 3274 3955
			$realTel = $m[1];
		} elseif (preg_match('/61(\d{9})$/', $tel, $m)) {
			$realTel = '0'.$m[1];
		} elseif (preg_match('/^0\d{9}$/', $tel)) {
			$realTel = $tel;
		} elseif (preg_match('/^\d{9}$/', $tel, $m)) {
			$realTel = '0'.$tel;
		} else {
			return '';
		}
		if (strlen($realTel) > 10) {
			$realTel = substr($realTel, 0, 10);
		}
		return $realTel;
	}

	public function auPhone()
	{
		return self::auPhoneValid($this->tel);
	}
	public static function auPhoneValid($no)
	{
		$tel = preg_replace('/[^\d]+/', '', $no);
		$tel = trim($tel);
		$realTel = $tel;
		if (preg_match('/61(\d{10})$/', $tel, $m)) {
			// in case +61 04 3274 3955
			$realTel = $m[1];
		} elseif (preg_match('/61(\d{9})$/', $tel, $m)) {
			$realTel = '0'.$m[1];
		} elseif (preg_match('/^0\d{9}$/', $tel)) {
			$realTel = $tel;
		} elseif (preg_match('/^\d{9}$/', $tel, $m)) {
			$realTel = '0'.$tel;
		} else {
			return '';
		}
		if (strlen($realTel) > 10) {
			$realTel = substr($realTel, 0, 10);
		}
		return $realTel;
	}

	public static function checkIsPoBox($address)
	{
		return (preg_match('/P\.O\.|PO \d+ABN#|P[\s\.OST]*O[\s\.FICE]*B\s*O\s*X[\s\,\.]*\d*|POST OFFICE|Australia Post|Postal\s*Locker|Parcel\s*Locker|post\s*Locker|Locker\s*Number|Parcel\s*collect|PMB\s*\d+|\d+\s*P[\s\.OST]*O[\s\.FICE]*BOX|CnC\s?Woolworths|Cnc\s?BIG\s?W|(^| )Box\s*\d+/i', $address)&&!preg_match('/(post office street|post office st|Post Office Lane)/i',$address));
	}
	public static function getEditStreetCode($editStreetCode)
	{
		$result = [];
		if(empty($editStreetCode))
		{
			return "";
		}else
		{
			foreach (self::$editStreetCode as $key => $value) {
				if(($editStreetCode&$key)>0)
				{
					$result[] =$value;
				}
			}
		}
		return join(',',$result);
	}
	public static function checkAuState($state)
	{
		$states_reg = ['NSW' => '/New South Wales|^NSW$/i',
			'ACT' => '/(AUSTRALIAN CAPITAL TERRITORY|^ACT$)/i',
			'NT' => '/(NORTHERN TERRITORY|^NT$)/i',
			'QLD' => '/(QUEENSLAND|^QLD$)/i',
			'SA' => '/(SOUTH AUSTRALIA|^SA$)/i',
			'TAS' => '/(TASMANIA|^TAS$)/i',
			'VIC' => '/(VICTORIA|^VIC$)/i',
			'WA' => '/(WESTERN AUSTRALIA|^WA$)/i',
		];
		foreach ($states_reg as $key=>$reg) {
			if (preg_match($reg, $state)) {
				return $key;
			}
		}
		return $state;
	}

