	/**
	 * Retrieves a list of models based on the current search/filter conditions.
	 *
	 * Typical usecase:
	 * - Initialize the model fields with values from filter form.
	 * - Execute this method to get CActiveDataProvider instance which will filter
	 * models according to data in model fields.
	 * - Pass data provider to CGridView, CListView or any similar widget.
	 *
	 * @return CActiveDataProvider the data provider that can return the models
	 * based on the search/filter conditions.
	 */
	public function search()
	{
		// @todo Please modify the following code to remove attributes that should not be searched.

		$criteria=new CDbCriteria;

		$criteria->compare('t.id', $this->id);
		$criteria->compare('t.owner_id', $this->name);
		$criteria->compare('name', $this->name, true);
		$criteria->compare('address', $this->address, true);
		$criteria->compare('suburb', $this->suburb, true);
		$criteria->compare('city', $this->city, true);
		$criteria->compare('state', $this->state, true);
		$criteria->compare('postcode', $this->postcode, true);
		$criteria->compare('country', $this->country, true);
		$criteria->compare('tel', $this->tel, true);
		$criteria->compare('email', $this->email, true);
		$criteria->compare('cnid_id', $this->cnid_id, true);
		$criteria->compare('cnid_no', $this->cnid_no, true);
		$criteria->compare('acc', $this->acc, true);

		return new CActiveDataProvider($this, [
			'criteria'=>$criteria,
		]);
	}

	public function checkCnAddr()
	{
		$addr = $this->getCnFullAddress();
		if (empty($addr)) {
			return false;
		}
		$acr = BaiduAPI::Geocoding($addr);
		if ($acr->status == 0) {
			$this->acc = empty($acr->result->confidence)? 1 : $acr->result->confidence;
		}
		return $this->acc;
	}

	public function beforeSave()
	{
		$this->name = trim($this->name);
		$this->tel = trim($this->tel);
		$this->state = trim($this->state);
		$this->suburb = trim($this->suburb);
		$this->city = trim($this->city);
		$this->postcode = trim($this->postcode);
		$this->address = trim($this->address);
		if(!empty($this->email)){
			$emls = preg_split('/[;,\s]+/', $this->email);
			if(count($emls) > 1){
				foreach($emls as $k => $eml){
					$emls[$k] = (string) filter_var($eml, FILTER_VALIDATE_EMAIL);
				}
				$this->email = implode(';', $emls);
			}else{
				$this->email = (string) filter_var($this->email, FILTER_VALIDATE_EMAIL);
			}
		}
		if ($this->cnid_id > 0 && !empty($this->cnid) && $this->name != $this->cnid->name) {
			$this->cnid_id = 0;
		}
		if ($this->country == 'PR China') {
			$this->name = preg_replace('/\s+/', '', $this->name);
			if ((empty($this->state) || empty($this->city)) && !empty($this->address)) {
				$this->setCnAddr($this->address);
			}
			if (empty($this->postcode)) {
				$this->getZip();
			}
			if (empty($this->cnid_id) && !empty($this->name) && !empty($this->tel)) {
				$cnid = CnID::model()->find(['condition' => 'status IN (15,18,20) AND bwf = 0 AND name = :n AND mobile = :t', 'params' => [':n' => $this->name, ':t' => $this->tel], 'order' => 'id DESC']);

				if (!$cnid) {
					$cnid = CnID::model()->find(['condition' => 'name = :n AND status IN (15,18,20) AND bwf = 0', 'params' => [':n' => $this->name], 'order' => 'id DESC']);
				}
				// if(!$cnid) $cnid = CnID::model()->find(['condition' => '(name = :n OR mobile = :t) AND status IN (15,18,20) AND bwf = 0', 'params' => array(':n' => $this->name, ':t' => $this->tel), 'order' => 'id DESC']);
				
				if ($cnid) {
					if ($this->name == $cnid->name) {
						$this->cnid_id = $cnid->id;
					} elseif (AppHelper::similar_text_cn($this->name, $cnid->name) > 0 && CnID::model()->count('mobile = :t AND status IN (15,18,20) AND bwf = 0', [':t' => $this->tel]) == 1) {
						$this->cnid_id = $cnid->id;
						$this->name = $cnid->name;
						$this->name_change = true;
					}
				}
			}
		}
		/* no address check
		if(!$this->isNewRecord && $this->fullAddress() != $this->old_full_addr){//address changed
			if($this->country == 'PR China') $this->checkCnAddr();
		}
		*/

		$cln = [];
		if ($this->id > 0)
		{
			$o = Addr::model()->findByPk($this->id);
			foreach (['name','tel','state','suburb','city','postcode','address','country','email'] as $key => $value) {
				if ($o->$value != $this->$value) {
					$cln[] = $value.' changed from: ' . $o->$value;
				}
			}

			if(!empty($cln))
			{
				$p = ImParcel::model()->find('cnee_id=:cid',[':cid'=>$this->id]);
				if(!empty($p))
				{
					$extra = ['|Consignee note' => implode(', ', $cln)];
					Log::add($p, 4, array_merge(['status' => $p->getStatus()], $extra));
				}else
				{
					$p = ImParcel::model()->find('receiver_id=:cid',[':cid'=>$this->id]);
					if(!empty($p))
					{
						$extra = ['|Receiver note' => implode(', ', $cln)];
						Log::add($p, 4, array_merge(['status' => $p->getStatus()], $extra));
					}
				}
			}
		}



		return true;
	}

	public function afterSave()
	{
		if ($this->cnid_id > 0 && !empty($this->cnid)) {
			$up = false;
			if (empty($this->cnid->mobile) && !empty($this->tel)) {
				$this->cnid->mobile = $this->tel;
				$up = true;
			}
			if (empty($this->cnid->city) && !empty($this->city)) {
				$this->cnid->city = $this->city;
				$up = true;
			}
			if ($this->cnid->status < 20) {
				$this->cnid->status = 20;
				$up = true;
			}
			if ($up) {
				$this->cnid->save();
			}
			if ($this->auto_match) {
				$this->cnid->matchCnee();
			}
		}
		if ($this->name_change && $this->id > 0) {
			$p = ExParcel::model()->find('cnee_id = :cid', [':cid' => $this->id]);
			if ($p) {
				$p->bwf = $p->bwf | 128;
				$p->custom_log_note = 'Consignee Name changed: '.$this->name.' > '.$cnid->name;
				$p->save();
			}
		}
		return true;
	}

	public function afterFind()
	{
		$this->old_full_addr = $this->fullAddress();
	}
	
	public function nameInit()
	{
		$ns = explode(' ', $this->name);
		$in = '';
		if (sizeof($ns) > 1) {
			return substr($ns[0], 0, 1).'. '.$ns[sizeof($ns) -1];
		} else {
			return $this->name;
		}
	}
	
	public function getTel($no=true)
	{
		return preg_replace('/[^\d]+/', '', $this->tel);
	}

	public function checkPostcode($fix = false,$fromAPi = false)
	{
		$type = 0;
		if (empty($this->state)) {
			if (empty($this->postcode)) {
				return 0;
			}
			$r = Postcode::model()->find('postcode = :p AND country = "AU"', [':p' => $this->postcode]);
			if (!empty($r->state)) {
				$this->state = $r->state;
				$type = $type|self::LOCAL_CORRECT_STATE;
			}
		}
		$this->state = strtoupper($this->state);
		$suburb = $this->suburb;
		$this->suburb = preg_replace(['/\bMT\b\.*/i', '/\bNTH\b\.*/i', '/\bSTH\b\.*/i', '/^PT\b\.*/i', '/^(SAINT\b|ST\.)/i'], ['MOUNT', 'NORTH', 'SOUTH', 'PORT', 'ST'], $suburb);
		if($this->suburb != $suburb){
			$type = $type|self::LOCAL_CORRECT_SUBURB;
		}

		if(Postcode::model()->count('suburb = :sub AND postcode = :p AND state = :s AND country = "AU"', [':sub' => $this->suburb, ':p' => $this->postcode, ':s' => $this->state]) > 0) return empty($type)? 99 : $type;

		//check postcode
		$rs = Postcode::model()->findAll('postcode = :p AND state = :s AND country = "AU"', [':p' => $this->postcode, ':s' => $this->state]);
		if (empty($rs)) { //wrong postcode
			$r = Postcode::model()->find('suburb = :sub AND state = :s AND country = "AU"', [':sub' => $this->suburb, ':s' => $this->state]);
			if (empty($r->postcode)) { //wrong state
				$r = Postcode::model()->find('suburb = :sub AND postcode = :p AND country = "AU"', [':sub' => $this->suburb, ':p' => $this->postcode]);
				if (!empty($r->state)) {
					$this->state = $r->state;
					$type = $type|self::LOCAL_CORRECT_STATE;
				}
			} else {
				$this->postcode = $r->postcode;
				$type = $type|self::LOCAL_CORRECT_POSTCODE;
			}
			if ($fix) {
				$this->save();
			}
			return $type;
		}

		$addressContainsSuburb = function($add, $sub){
			if(stripos($add, $sub) > 0) return true; //full contain
			if(strrpos($sub, ' ') > 0 && stripos(str_replace(' ', '', $add), str_replace(' ', '', $sub)) > 0) return true; //compare without space
			if(stripos(str_replace(' ', '', preg_replace('/\b(SAINT\b|ST\.)/i', 'ST', $add)), str_replace(' ', '', preg_replace(['/\bMOUNT\b/', '/\bNORTH\b/', '/\bSOUTH\b/', '/^PORT\b/'], ['MT', 'NTH', 'STH', 'PT'], $sub))) > 0) return true; //abbrevation

			return false;
		};

		//not matched
		foreach ($rs as $r) { //try to see if suburb is in the address line
			if ($addressContainsSuburb($this->address, $r->suburb)) {
				$this->suburb = $r->suburb;
				if ($fix) {
					$this->save();
				}
				$type = $type|self::LOCAL_CORRECT_SUBURB;
				return $type;
			}
		}

		//check suburb
		// 6837-6848 Perth
		// 2600,2601 Canberra
		// 2300 Newcastle
		// 2500 Wollongong
		// 3220 Geelong
		// 4810 Townsville
		$r = Postcode::model()->find('suburb = :sub AND state = :s AND country = "AU" AND ((postcode > 1000 AND postcode % 1000 > 5) OR (postcode < 1000 AND postcode % 100 > 5)) AND (postcode < 6837 OR postcode > 6848) AND postcode NOT IN (2600, 2601, 2300, 2500, 3220, 4810)', [':sub' => $this->suburb, ':s' => $this->state]);
		if(!empty($r)){
			$this->postcode = $r->postcode;
			$type = $type|self::LOCAL_CORRECT_POSTCODE;
			if ($fix) {
				$this->save();
			}
			return $type;
		}

		//only one suburb per postcode
		if(count($rs) == 1){
			$this->suburb = $rs[0]->suburb;
			$type = $type|self::LOCAL_CORRECT_SUBURB;
			if ($fix) {
				$this->save();
			}
			return $type;
		}

		if(!$fromAPi)
		{
			$this->suburb = $rs[0]->suburb;
			if ($fix) {
				$this->save();
			}
		}
		return 0;
	}
		
		
	/*to check the add is
	 *    391 Park Road,Regents Park, 2143
	 *  2. David Road, Padstow, 2211
	 *
	 */
	public function checkSelfDelivery()
	{
		if ($this->postcode=="2143"&&preg_match("/Regents Park/i", $this->suburb)) {
			if (preg_match("/391\s*Park\s*(Road|RD|Roads)/i", $this->address)) {
				return true;
			}
		}
		if ($this->postcode=="2211"&& preg_match("/Padstow/i", $this->suburb)) {
			if (preg_match("/(45\s*-\s*53|53|45\/53|45)\s*DAVIES\s*(ROAD|RD|ROADS)/i", $this->address)) {
				return true;
			}
		}
		return false;
	}

	public function getCname()
	{
		return (strlen($this->name)>8)?substr($this->name, 0,8):$this->name;
	}

	/**
	 * Returns the static model of the specified AR class.
	 * Please note that you should have this exact method in all your CActiveRecord descendants!
	 * @param string $className active record class name.
	 * @return Addr the static model class
	 */
	public static function model($className=__CLASS__)
	{
		return parent::model($className);
	}

	/** 
	 * This function supports phone numbers like:
	 * +61-0400-000-000
	 * +61 0400 000 000
	 * 400 000 000
	 * 0400 000 000
	 * 0400-000-000
	 * 400-000-000
	 * 
	 * returns phone number has prefix '0' in front of '4', e.g. 0400-000-000
	 * returns false when no match in string 
	 */
	public static function extract_australian_phone_numbers($string)
	{
		//$pattern = '/(\+61|61|0)\s?\-?\d{1,4}(\s?\-?\d{2,3}){2}/';
		$pattern = '/(\+61|61|0)?[\s-]*\d{1,4}[\s-]*\d{3}[\s-]*\d{3}/';
		preg_match_all($pattern, $string, $matches);
		$phone_numbers = $matches[0];
		$phone_numbers = preg_replace('/\+?61\s?/', '', $phone_numbers); // remove +61 and optional space
		$phone_numbers = preg_replace('/\s+/', '', $phone_numbers); // remove all spaces
		$phone_numbers = preg_replace('/\D/', '', $phone_numbers); // keep only digits
		$phone_numbers = preg_grep('/^0?4/', $phone_numbers); // keep only phone numbers starting with 04
		if (!empty($phone_numbers[0])) {
			if (strlen($phone_numbers[0]) == 9) {
				return '0' . $phone_numbers[0];
			} else {
				return $phone_numbers[0];
			}
		} else {
			return false;
		}
	}
}
