</table>
<hr />

<table width="100%" border="0" cellspacing="0" cellpadding="0">
	<tr><td>
		<p align="center" style="font-size:1.25em;">AP Article Id: <?=$aid;?></p>
		<div style="width:620px; margin:0 auto;"><?php
