		echo '<p style="padding:5px 0"><img src="data:image/png;base64,' . base64_encode($bc->getBarcodePngData(2, 125)) . '" height="125"  /></p>';
		?></div>
		<p align="center" style="font-size:1.25em;">AP Article Id: <?=$aid;?></p>
