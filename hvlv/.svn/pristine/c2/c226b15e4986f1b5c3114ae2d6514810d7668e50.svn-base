			if (isset($this->mdata['inv_item_custom_lines'])&& intval($this->mdata['inv_item_custom_lines'])>0) {
				$lineNumber=intval($this->mdata['inv_item_custom_lines']);
				$orgRate = OrgRate::model()->find('type=40 and org_id=:oid', [':oid' =>$owner->id]);
				$rateInfo = json_decode($orgRate['meta']);
				if (empty($rateInfo->AU->csdcRate)||empty($rateInfo->AU->csdclRate)||empty($rateInfo->AU->csdcapRate)) {
					$errors[]='Custom declaration line rate is not set in the org rate!';
				} else {
					if ($lineNumber<=10) {
						$amount=floatval($rateInfo->AU->csdcRate);
						$tot += $amount;
						$items[] = [$this->awb, 'Customs Declaration', 1, 0, $rateInfo->AU->csdcRate, $amount];
					} else {
						$amount= number_format(($lineNumber-10)*floatval($rateInfo->AU->csdclRate), 2, '.', '')+floatval($rateInfo->AU->csdcRate);
						if ($amount>$rateInfo->AU->csdcapRate) {
							$amount= floatval($rateInfo->AU->csdcapRate);
						}
						$tot+=$amount;
						$items[] = [$this->awb, 'Customs Declaration', 1, 0, $amount, $amount];
					}
				}
			} else {
				if (isset($this->mdata['inv_item_cd']) && $this->mdata['inv_item_cd'] > 0) {
					$amount = floatval($this->mdata['inv_item_cd']);
					$tot += $amount;
					$items[] = [$this->awb, 'Customs Declaration', 1, 0, $amount, $amount];
				}
			}
			if (isset($this->mdata['inv_item_ad']) && $this->mdata['inv_item_ad'] > 0) {
				$amount = floatval($this->mdata['inv_item_ad']);
				$tot += $amount;
				$items[] = [$this->awb, 'Airline Document Fee', 1, 0, $amount ,$amount];
			}
			if (isset($this->mdata['inv_item_cmr']) && $this->mdata['inv_item_cmr'] > 0) {
				$amount = floatval($this->mdata['inv_item_cmr']);
				$tot += $amount;
				$items[] = [$this->awb, 'CMR Fee', 1, 0, $amount,$amount];
			}
			if (isset($this->mdata['inv_item_cdty']) && $this->mdata['inv_item_cdty'] > 0) {
				$amount = floatval($this->mdata['inv_item_cdty']);
				$tot += $amount;
				$items[] = [$this->awb, 'Customs Duties & Fees', 1, 0, $amount,$amount];
			}

			$cgb_wt = 0.0;
			if (isset($this->mdata['cgb_wt'])) {
				$cgb_wt = $this->mdata['cgb_wt'];
			}
			if ($cgb_wt > 0.0) {
				if (isset($this->mdata['inv_item_at']) && $this->mdata['inv_item_at'] > 0) {
					$rate = floatval($this->mdata['inv_item_at']);
					$amount = $rate * $cgb_wt;
					$tot += $amount;
					$items[] = [$this->awb, 'Airline Terminal Fee', 1, $cgb_wt, $rate, $amount];
				}
				if (isset($this->mdata['inv_item_ab']) && $this->mdata['inv_item_ab'] > 0) {
					$rate = floatval($this->mdata['inv_item_ab']);
					$amount = $rate * $cgb_wt;
					$tot += $amount;
					$items[] = [$this->awb, 'Airline Breakbulk Fee', 1, $cgb_wt, $rate, $amount];
				}
				if (isset($this->mdata['inv_item_dlv']) && $this->mdata['inv_item_dlv'] > 0) {
					$rate = floatval($this->mdata['inv_item_dlv']);
					$amount = $rate * $cgb_wt;
					$tot += $amount;
					$items[] = [$this->awb, 'Delivery Fee', 1, $cgb_wt,$rate,$amount];
				}
			}
		}

		// return ['inv'=>$inv,'items'=>$items,'owner'=>$owner,'tot'=>$tot,'errors'=>$errors];
	}

	public function getReportDetailByCourier()
	{
		$data=[];
		$data['Truck Delivery']['number'] = 0;
		$data['Truck Delivery']['weight'] = 0;
		$data['Truck Delivery']['revenue'] = 0;
		$data['Truck Delivery']['cost'] = 0;
		$data['Self Pickup']['number'] = 0;
		$data['Self Pickup']['weight'] = 0;
		$data['Self Pickup']['revenue'] = 0;
		$data['Self Pickup']['cost'] = 0;
		$pids = [];
		foreach ($this->shipments as $p) {
			$pids[] = $p->id;
		}
		$sis = [];
		$siIds = [];
		$mysis = SiReconcileLine::model()->with('parent')->findAll('fid in ('.join(',',$pids).') and parent.status !=100 and item_code = "item"');
		foreach ($sis as $key => $si) {
			if(!empty($sis[$si->fid]))
			{
				$sis[$si->fid][] = $si;
			}else
			{
				$sis[$si->fid] = [$si];
			}
			$siIds[] = $si->id;
		}
		$disputes = [];
		if(!empty($siIds))
		{
			$myDisputes = DisputeLine::model()->find('si_reconcile_line_id in ('.join(',',$siIds).') and status<99');
			foreach ($myDisputes as $key => $md)
			{
				$dispute[$si->fid] = $md;
			}
		}

		foreach ($this->shipments as $p) {
			if (empty($p->mdata['charge_client_amount'])) {
				$revenue=0;
				if (!empty($mdata['chargecode'])) {
					$revenue=$p->getChargeByChargecode();
					if ($revenue>0) {
						$p->mdata['charge_client_amount']=$revenue;
						$p->updateMeta();
					}
				}
				if ($revenue==0) {
					continue;
				}
			}
			if (in_array($p->agent_id, [1426,1427])) {
				continue;
			}
			if(!empty($this->checkAgentId))
			{
				if($p->agent_id!=$this->checkAgentId)
				{
					continue;
				}
			}
			if(!empty($p->trans[0])){
				$mySis = @$sis[$p->id];
				if($p->trans[0]->org_id==Org::ORGID_COURIER_EIZ)
				{
					$thisCost = 0;
					if(!empty($mySis))
					{
						foreach ($mySis as $key => $si) {
							$dl = $disputes[$si->id];
							$thisCost+=$si->value;

							if(!empty($dl))
							{
								$thisCost -=$dl->dispute_amount_ex_gst;
							}
						}

						$lis = $mySis[0]->getOtherChargeInvoiceLine();
						if(!empty($lis))
						{
							foreach ($lis as $key => $li) {
								$thisCost = $thisCost-$li->amount-$li->gst;
							}
						}
						
					}else
					{
						$thisCost=Shipment::getCourierCostByShipment($p->trans[0]->connote, $p->mdata['org_rate_id'], $p->getCubeWeight())['price'];
					}

					if (preg_match("/AOE\d{7}/i", $p->ref))
					{

						if (key_exists('EIZ Express Allied', $data)) {
							$data['EIZ Express Allied']['number']+=1;
							$data['EIZ Express Allied']['weight']+=$p->weight;
							$data['EIZ Express Allied']['revenue']+=$p->mdata['charge_client_amount'];
							$data['EIZ Express Allied']['cost']+=$thisCost;
						} else {
							$data['EIZ Express Allied']['number']=1;
							$data['EIZ Express Allied']['weight']=$p->weight;
							$data['EIZ Express Allied']['revenue']=$p->mdata['charge_client_amount'];
							$data['EIZ Express Allied']['cost']=$thisCost;
						}

					}else
					{
						if (key_exists('EIZ Express Toll', $data)) {
							$data['EIZ Express Toll']['number']+=1;
							$data['EIZ Express Toll']['weight']+=$p->weight;
							$data['EIZ Express Toll']['revenue']+=$p->mdata['charge_client_amount'];
							$data['EIZ Express Toll']['cost']+=$thisCost;
						} else {
							$data['EIZ Express Toll']['number']=1;
							$data['EIZ Express Toll']['weight']=$p->weight;
							$data['EIZ Express Toll']['revenue']=$p->mdata['charge_client_amount'];
							$data['EIZ Express Toll']['cost']=$thisCost;
						}
					}
					continue;
				}
				
				$otherCharge = 0;
				if(!empty($mySis))
				{
					foreach ($mySis as $key => $si) {
						$dl =  @$disputes[$si->id];
						if(!empty($dl))
						{
							$otherCharge -= $dl->dispute_amount_ex_gst;
						}
					}

					$lis = $mySis[0]->getOtherChargeInvoiceLine();
					if(!empty($lis))
					{
						foreach ($lis as $key => $li) {
							$otherCharge += ($li->amount-$li->gst);
						}
					}
				}

				if (key_exists($p->trans[0]->org_id, $data)) {
					$data[$p->trans[0]->org_id]['number']+=1;
					$data[$p->trans[0]->org_id]['weight']+=$p->weight;
					$data[$p->trans[0]->org_id]['revenue']+=$p->mdata['charge_client_amount']+$otherCharge;
				} else {
					$data[$p->trans[0]->org_id] = ['number' => 1, 'weight' => $p->weight, 'revenue' => $p->mdata['charge_client_amount'], 'cost' => 0];
				}
			}else
			{
				//check truck delivery
				if(!empty($p->cargo_process))
				{
					if($p->cargo_process->type== CargoProcess::PICKUP_CARGO)
					{
						$data['Truck Delivery']['number']+=1;
						$data['Truck Delivery']['weight']+=$p->weight;
						$data['Truck Delivery']['revenue']+=$p->mdata['charge_client_amount'];
					}
					else
					{
						$data['Self Pickup']['number']+=1;
						$data['Self Pickup']['weight']+=$p->weight;
						$data['Self Pickup']['revenue']+=$p->mdata['charge_client_amount'];
					}
				}
			}
			if (preg_match("/LET\d{7}/i", $p->ref)) {
				if (key_exists(Org::ORGID_COURIER_AUSLETTER, $data)) {
					$data[Org::ORGID_COURIER_AUSLETTER]['number']+=1;
					$data[Org::ORGID_COURIER_AUSLETTER]['weight']+=$p->weight;
					$data[Org::ORGID_COURIER_AUSLETTER]['revenue']+=$p->mdata['charge_client_amount'];
				} else {
					$data[Org::ORGID_COURIER_AUSLETTER]['number']=1;
					$data[Org::ORGID_COURIER_AUSLETTER]['weight']=$p->weight;
					$data[Org::ORGID_COURIER_AUSLETTER]['revenue']=$p->mdata['charge_client_amount'];
				}
			}

		}

		if(empty($data)&&preg_match("/^EL\d{5}/i", $this->no))//special for BFE EL letter consol
		{
			$data[Org::ORGID_COURIER_AUSLETTER]['number']=number_format($this->totShipments(), 0);
			$data[Org::ORGID_COURIER_AUSLETTER]['weight']=$this->totWeight();
			$data[Org::ORGID_COURIER_AUSLETTER]['revenue']=$this->getTotalInvoice();
			$data[Org::ORGID_COURIER_AUSLETTER]['cost']=$this->totCost();
			return $data;
		}

		$costData = $this->getTabBilling(true);
		$costData = $costData['data'];
		// $sql="SELECT org_id, SUM(IF(actual_amount> 0 , actual_amount,accrual_amount) ) as sumData FROM `billing_line` WHERE billing_ref = '".$this->no . "' GROUP by org_id ";
		// $all = Yii::app()->db->createCommand($sql)->queryAll();
		foreach ($costData as $key => $row) 
		{
			if($row['supplier_id']==Org::ORGID_COURIER_EIZ) continue;
			if (key_exists($row['supplier_id'], $data)) 
			{
				if(preg_match("/^EL\d{5}/i", $this->no)&&$row['supplier_id']==Org::ORGID_COURIER_AUPOST)
				{
					$data[Org::ORGID_COURIER_AUSLETTER]['cost']= $row['sumData'];
				}else
				{
					if(empty($data[$row['supplier_id']]['cost']))
					{
						$data[$row['supplier_id']]['cost']= 0;
					}
					$data[$row['supplier_id']]['cost']+=empty($row['confirm_payable'])?$row['accrual']:$row['confirm_payable'];
				}
			}
		}
		
		unset($this->shipments);
		return $data;
	}

	public function updateFlight($backend=false)
	{
		if($this->service!=self::AIRCONSOL) return;
		$flag = $this->getflightTracking();
		if ($flag == 0) {
			return;
		} elseif ($flag == 1) {
			if (!empty($this->etd) && !empty($this->flight)) {
				$data = Tracking::flight($this->flight, $this->etd);
				if ($data[7] > 0) {
					//update all the dispatch info
					foreach ($this->shipments as $p) {
						$tracking = Tracking::model()->find('pid=:pid and activity=:ac', [':pid' => $p->id, ':ac' => 'Flight dispatched']);
						if (!empty($tracking)) {
							$tracking->dt = $data[4];
							$tracking->save();
						}
					}
					$this->mdata['updatedEtd'] = 0;
					$this->save();
				}
			}
		} elseif ($flag == 2) {
			if (!empty($this->etd) && !empty($this->flight)) {
				$data = Tracking::flight($this->flight, $this->etd);
				if ($data[7] > 0) {
					//update all the dispatch info
					foreach ($this->shipments as $p) {
						$tracking = Tracking::model()->find('pid=:pid and activity=:ac', [':pid' => $p->id, ':ac' => 'Flight dispatched']);
						if (!empty($tracking)) {
							$tracking->dt = $data[4];
							$tracking->save();
						}
						$tracking = Tracking::model()->find('pid=:pid and activity=:ac', [':pid' => $p->id, ':ac' => 'Flight arrived']);
						if (!empty($tracking)) {
							$tracking->dt = $data[5];
							$tracking->save();
						}
					}
					$this->mdata['updatedEtd'] = 0;
					$this->save();
				}
			}
		}

		if($backend)
		{
			if ($flag == 0) {
				return;
			} elseif ($flag == 1) {
				if (!empty($this->etd) && !empty($this->flight)) {
					foreach ($this->shipments as $p) {
					$tracking = Tracking::model()->find('pid=:pid and activity=:ac', [':pid' => $p->id, ':ac' => 'Flight dispatched']);
						if (!empty($tracking)) {
							$replaced = preg_replace('/\d{4}-\d{2}-\d{2}/', $this->etd, $tracking->dt);
							$tracking->dt = $replaced;
							$tracking->save();
						}
					}
				}
			} elseif ($flag == 2) {
				if (!empty($this->etd) && !empty($this->flight)) {
					foreach ($this->shipments as $p) {
						$tracking = Tracking::model()->find('pid=:pid and activity=:ac', [':pid' => $p->id, ':ac' => 'Flight dispatched']);
						if (!empty($tracking)) {
							$replaced = preg_replace('/\d{4}-\d{2}-\d{2}/', $this->etd, $tracking->dt);
							$tracking->dt = $replaced;
							$tracking->save();
						}
						$tracking = Tracking::model()->find('pid=:pid and activity=:ac', [':pid' => $p->id, ':ac' => 'Flight arrived']);
						if (!empty($tracking)) {
							$tracking->dt = $this->eta.' '.date('H:i:s');
							$tracking->save();
						}
					}
				}
			}
		}
	}

	public function updateSea()
	{
		if($this->service!=self::SEACONSOL) return;
		$flag = $this->getSeaTracking();
		$vesselInfo = " ".@$this->mdata['sea_vessel']."/".@$this->flight;
		if ($flag == 0) {
			return;
		} elseif ($flag == 1) {
			if (!empty($this->etd) && !empty($this->flight)) {
				$polInfor = SystemSetting::getPodSetting(substr($this->pol,0,2),$this->pol);
				foreach ($this->shipments as $p) {
					$tracking = Tracking::model()->find('pid=:pid and activity like :ac', [':pid' => $p->id, ':ac' => '%Sea vessel dispatched%']);
					if (!empty($tracking)) {
						$tracking->dt = $this->etd;
						$tracking->activity = 'Sea vessel dispatched'.$vesselInfo;
						$tracking->save();
					}else
					{
						$p->addTracking(38, 'Sea vessel dispatched'.$vesselInfo, $polInfor[0], $r->etd);
					}
				}
				$this->mdata['updatedEtd'] = 0;
				$this->save();
			}
		} elseif ($flag == 2) {
			if (!empty($this->etd) && !empty($this->flight)) {
				foreach ($this->shipments as $p) {
						$tracking = Tracking::model()->find('pid=:pid and activity like :ac', [':pid' => $p->id, ':ac' => '%Sea vessel dispatched%']);
						if (!empty($tracking)) {
							$tracking->dt =  $this->etd;
							$tracking->activity = 'Sea vessel dispatched'.$vesselInfo;
							$tracking->save();
						}
						$tracking = Tracking::model()->find('pid=:pid and activity like :ac', [':pid' => $p->id, ':ac' => '%Sea arrived%']);
						if (!empty($tracking)) {
							$tracking->dt =  $this->eta;
							$tracking->activity = 'Sea arrived'.$vesselInfo;
							$tracking->save();
						}
					}
					$this->mdata['updatedEtd'] = 0;
					$this->save();
			}
		}
	}

		/*to check if the consol shipment have flight dispatched
	 * 0: no dispatch and arrive
	 * 1. dispatch but not arrive
	 * 2. dispatch and arrive
	 *
	 */
	public function getflightTracking()
	{
		if (empty($this->shipments)) {
			return 0;
		}
		$p=$this->shipments[0];
		if (empty($p->tracks)) {
			return 0;
		}
		$flag=0;
		foreach ($p->tracks as $t) {
			if (preg_match('/Flight dispatched/i', $t->activity)) {
				$flag=$flag|1;
			}
			if (preg_match('/Flight arrived/i', $t->activity)) {
				$flag=$flag|2;
			}
		}
		if ($flag==0) {
			return 0;
		} elseif ($flag==1) {
			return 1;
		} else {
			return 2;
		}
	}
	public function getSeaTracking()
	{
		if (empty($this->shipments)) {
			return 0;
		}
		$p=$this->shipments[0];
		if (empty($p->tracks)) {
			return 0;
		}
		$flag=0;
		foreach ($p->tracks as $t) {
			if (preg_match('/Sea vessel dispatched/i', $t->activity)) {
				$flag=$flag|1;
			}
			if (preg_match('/Sea arrived/i', $t->activity)) {
				$flag=$flag|2;
			}
		}
		if ($flag==0) {
			return 0;
		} elseif ($flag==1) {
			return 1;
		} else {
			return 2;
		}
	}

