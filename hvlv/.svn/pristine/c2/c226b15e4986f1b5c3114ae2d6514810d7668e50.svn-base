	public function getRTSInvoices()
	{
		$invoices = [];
		$sql = 'SELECT invoice.* FROM invoice JOIN inv_line ON invoice.id = inv_line.inv_id JOIN shipment ON shipment.id = inv_line.fid JOIN consol ON shipment.consol_id = consol.id WHERE inv_line.model = "ImParcel" AND invoice.type IN (36) AND consol.id = :cid';
		$param = [':cid' => $this->id];
		$rs = Yii::app()->db->createCommand($sql)->bindValues($param)->queryAll();
		if (!empty($rs)) {
			$inv_ids = [];
			foreach ($rs as $r) {
				$inv_ids[] = $r['id'];
			}
			if (!empty($inv_ids)) {
				$invoices = Invoice::model()->findAll('id IN (' . implode(',', $inv_ids) . ')');
			}
		}

		return $invoices;
	}

	public function is3PL()
	{
		if($this->is3PLOnly()||$this->isWDT())
		{
			return true;
		}
		return false;
	}

	public function is3PLOnly()
	{
		if (($this->owner_id == Org::ORGID_CLIENT_TLA)&&empty($this->mdata['for3PL']))
		{
			return true;
		}
		if(preg_match('/^3PL/', $this->no))
		{
			return true;
		}
		return false;
	}
	public function isWDT()
	{
		if(preg_match('/^WDT/', $this->no))
		{
			return true;
		}
		return false;
	}

	

	public function getConsolDGWarnings($isAll = false,$isHtml=true)
	{
		if($isAll)
		{
			$shipments = AllShipment::model()->findAll('consol_id = :cid AND (JSON_VALUE(meta,"$.is_dg") = 1 or (bwf&:bwf)>0)', [':cid' => $this->id,':bwf'=>ImParcel::DAMAGEBWFCODE]);
		}else
		{
			$shipments = Shipment::model()->findAll('consol_id = :cid AND (JSON_VALUE(meta,"$.is_dg") = 1 or (bwf&:bwf)>0)', [':cid' => $this->id,':bwf'=>ImParcel::DAMAGEBWFCODE]);
		}

		$pro = [];
		if(!empty($this->mdata['isAutoGen']))
		{
			if($isHtml)
			{
				$pro['auto_inv']='<span>&nbsp;</span> <span class="green">AUTO INV</span>';
			}else
			{
				$pro['auto_inv']='AUTO INV';
			}
		}

		if(!empty($this->mdata['NOA_SENT_UB']))
		{
			if($isHtml)
			{
				if(empty($this->mdata['ubmerror'])||$this->mdata['ubmsent']==9)
				{
					$pro['noa_sent_ub']='<span>&nbsp;</span> <span class="green">NOA_SENT_UB</span>';
				}else
				{
					$pro['noa_sent_ub']='<span>&nbsp;</span> <span class="red">NOA_SENT_UB</span>';
				}
			}else
			{
				$pro['noa_sent_ub']='NOA_SENT_UB';
			}
		}

		if(!empty($this->mdata['prealert']))
		{
			if($isHtml)
			{
				$pro['prealert']='<span>&nbsp;</span> <span class="orange">PREALERT</span>';
			}else
			{
				$pro['prealert']='PREALERT';
			}
		}

		if(!empty($this->mdata['NOA_DMAWBCONSOL']))
		{
			if($isHtml)
			{
				$pro['noa_dmawbconsol']='<span>&nbsp;</span> <span class="green">NOA_DMAWBCONSOL</span>';
			}else
			{
				$pro['noa_dmawbconsol']='NOA_DMAWBCONSOL';
			}
		}

		foreach ($shipments as $key => $p) {
			if(!empty($p->mdata['is_dg']))
			{
				if($isHtml)
				{
					$pro['dg']='<span>&nbsp;</span> <span class="warn_red">DG</span>';
				}else
				{
					$pro['dg']='DG';
				}
			}
			if(($p->bwf&ImParcel::DAMAGEBWFCODE)>0)
			{
				if($isHtml)
				{
					$pro['dm']='<span>&nbsp;</span> <span class="warn_red">DAMAGE</span>';
				}else
				{
					$pro['dm']='DAMAGE';
				}
			}
		}
		return join('',$pro);

	}

	public function isTLA()
	{
		if (in_array($this->type, [Consol::DMAWBCONSOLTYPE, Consol::IMCOCONSOLTYPE, Consol::ELMSCONSOLTYPE]) && (strtotime($this->eta) >= strtotime('2020-08-01') || strtotime($this->created) >= strtotime('2020-08-01'))) return true;
		return false;
	}
	
	public function cleanDuplicatedBillingLine(&$provide)
	{
		$has = false;
		if(array_key_exists(Org::ORGID_COURIER_TNT_TOP,$provide)&&array_key_exists(Org::ORGID_COURIER_TNT,$provide))
		{
			unset($provide[Org::ORGID_COURIER_TNT]);
		}

		if(!empty($provide[Org::ORGID_AIRPORT_QANTAS]))
		{
			$checkKey = "";
			$has = false;
			foreach ($provide[Org::ORGID_AIRPORT_QANTAS] as $key => $value) {
				if(!empty($key))
				{
					$checkKey = $key;
				}else
				{
					$has = true;
				}
			}
			if(!empty($checkKey)&&$has)
			{
				unset($provide[Org::ORGID_AIRPORT_QANTAS]['']);
			}
		}
	}


	public function getTabBilling($backend = false)
	{
		$provide = [];
		if($this->isTLA())
		{
			$sql = 'SELECT * FROM hvlv_top.billing_line WHERE billing_ref = :no AND status != 11 AND accrual_amount != 0 AND org_id!=3937';
		}else
		{
			$sql = 'SELECT * FROM hvlv_db.billing_line WHERE billing_ref = :no AND status != 11 AND accrual_amount != 0  AND org_id!=3937';
		}

		$rs = Yii::app()->db->createCommand($sql)->bindValues([':no' => $this->no])->queryAll();
		foreach ($rs as $r) {
			if (empty($provide[$r['org_id']][$r['billing_cref']])) {
				$provide[$r['org_id']][$r['billing_cref']] = ['id' => $r['org_id'] . $r['billing_cref'], 'inv_no' => $r['billing_cref'] == $this->no ? '' : $r['billing_cref'], 'supplier_id' => $r['org_id'], 'supplier' => Org::model()->findByPk($r['org_id'])->name, 'accrual' => 0, 'invoice_payable' => 0, 'dispute' => 0, 'confirm_payable' => 0, 'currency' => Invoice::$currencies[$r['currency']],'glcode'=>$r['charge_code'],'billing_id'=>$r['id'],'dpt_id'=>$r['dpt_id'],'dpmt'=>$r['dpmt']];
			}

			$provide[$r['org_id']][$r['billing_cref']]['accrual'] += $r['accrual_amount'];

			// old billing actual
			if ($r['actual_amount'] > 0) {
				$sql = 'SELECT * FROM hvlv_db.supplier_invoice WHERE inv_no = :no UNION SELECT * FROM hvlv_top.supplier_invoice WHERE inv_no = :no';
				$si = Yii::app()->db->createCommand($sql)->bindValues([':no' => $r['billing_cref']])->queryAll();
				if (empty($si)) {
					$provide[$r['org_id']][$r['billing_cref']]['invoice_payable'] += $r['actual_amount'];
					$provide[$r['org_id']][$r['billing_cref']]['confirm_payable'] += $r['actual_amount'];
				}
			}
		}
		$this->cleanDuplicatedBillingLine($provide);
		// if (!empty($provide[Org::ORGID_COURIER_AUSLETTER])) {
		// 	foreach ($provide[Org::ORGID_COURIER_AUSLETTER] as $inv_no => $v) {
		// 		$provide[Org::ORGID_COURIER_AUPOST][$inv_no]['accrual'] += $provide[Org::ORGID_COURIER_AUSLETTER][$inv_no]['accrual'];
		// 	}
		// 	unset($provide[Org::ORGID_COURIER_AUSLETTER]);
		// }
		foreach ($provide as $org_id => $lines) {
			// if (!in_array($org_id, array_merge(Org::$couriers, Org::$airports))) {
			// 	unset($provide[$org_id]);
			// 	continue;
			// }
			foreach ($lines as $inv_no => $line) {
				// valid inv_no = except couriers
				if (!empty($inv_no) && $inv_no != $this->no) {
					if ($org_id == Org::ORGID_COURIER_TNT) {
						$payable = Billing::getPayableFromSiReconcile([Org::ORGID_COURIER_TNT,Org::ORGID_COURIER_TNT_TOP], $this->id, false, $inv_no, 'exclude');
						$dispute = Billing::getDisputeFromSiReconcile([Org::ORGID_COURIER_TNT,Org::ORGID_COURIER_TNT_TOP], $this->id, $inv_no, 'exclude');
					}
					else if ($org_id != Org::ORGID_COURIER_AUSLETTER) {
						$payable = Billing::getPayableFromSiReconcile($org_id, $this->id, false, $inv_no, 'exclude');
						$dispute = Billing::getDisputeFromSiReconcile($org_id, $this->id, $inv_no, 'exclude');
					} else {
						$payable = Billing::getPayableFromSiReconcile(Org::ORGID_COURIER_AUPOST, $this->id, false, $inv_no, 'only');
						$dispute = Billing::getDisputeFromSiReconcile(Org::ORGID_COURIER_AUPOST, $this->id, $inv_no, 'only');
					}
					$provide[$org_id][$inv_no]['invoice_payable'] += $payable;
					$provide[$org_id][$inv_no]['dispute'] = $dispute;
					$provide[$org_id][$inv_no]['confirm_payable'] += $payable - $dispute;
					if(empty($provide[$org_id][$inv_no]['accrual']))
					{
						$provide[$org_id][$inv_no]['confirm_payable / accrual'] =  '0%';
					}else
					{
						$provide[$org_id][$inv_no]['confirm_payable / accrual'] = number_format($provide[$org_id][$inv_no]['confirm_payable'] / $provide[$org_id][$inv_no]['accrual'] * 100, 2, '.', '') . '%';
					}

					if ($provide[$org_id][$inv_no]['dispute'] <= 0) $provide[$org_id][$inv_no]['dispute'] = '';
				} else {
					if ($org_id == Org::ORGID_COURIER_TNT) {
						$payables = Billing::getPayableFromSiReconcile([Org::ORGID_COURIER_TNT,Org::ORGID_COURIER_TNT_TOP], $this->id, true, null, 'exclude');
					}elseif ($org_id != Org::ORGID_COURIER_AUSLETTER) {
						$payables = Billing::getPayableFromSiReconcile($org_id, $this->id, true, null, 'exclude');
					} else {
						$payables = Billing::getPayableFromSiReconcile(Org::ORGID_COURIER_AUPOST, $this->id, true, null, 'only');
					}
					foreach ($payables as $payable) {
						if($payable['invoice_no']!=$inv_no&&!empty($provide[$org_id][$payable['invoice_no']]))continue;
						if (empty($provide[$org_id][$payable['invoice_no']])) $provide[$org_id][$payable['invoice_no']] = ['id' => $org_id . $payable['invoice_no'], 'inv_no' => $payable['invoice_no'],'supplier_id'=>$org_id, 'supplier' => Org::model()->findByPk($org_id)->name, 'accrual' => 0, 'invoice_payable' => 0, 'dispute' => 0, 'confirm_payable' => 0, 'currency' => $line['currency']];
						if ($org_id == Org::ORGID_COURIER_TNT) {
							$dispute = Billing::getDisputeFromSiReconcile([Org::ORGID_COURIER_TNT,Org::ORGID_COURIER_TNT_TOP], $this->id, $payable['invoice_no'], 'exclude');
						}elseif ($org_id != Org::ORGID_COURIER_AUSLETTER) {
							$dispute = Billing::getDisputeFromSiReconcile($org_id, $this->id, $payable['invoice_no'], 'exclude');
						} else {
							$dispute = Billing::getDisputeFromSiReconcile(Org::ORGID_COURIER_AUPOST, $this->id, $payable['invoice_no'], 'only');
						}

						$provide[$org_id][$payable['invoice_no']]['accrual'] += $payable['accrual'] > 0 ? $payable['accrual'] : $payable['payable'];
						$provide[$org_id][$payable['invoice_no']]['invoice_payable'] += $payable['payable'];
						$provide[$org_id][$payable['invoice_no']]['dispute'] = $dispute;
						$provide[$org_id][$payable['invoice_no']]['confirm_payable'] += $payable['payable'] - $dispute;
						if(empty($provide[$org_id][$payable['invoice_no']]['accrual']))
						{
							$provide[$org_id][$payable['invoice_no']]['confirm_payable / accrual'] = '0%';
						}else
						{
							$provide[$org_id][$payable['invoice_no']]['confirm_payable / accrual'] = number_format($provide[$org_id][$payable['invoice_no']]['confirm_payable'] / $provide[$org_id][$payable['invoice_no']]['accrual'] * 100, 2, '.', '') . '%';
						}

						$provide[$org_id][$inv_no]['accrual'] -= $payable['accrual'];
					}
				}
			}
		}
		$total = [];
		$notAUD = false;
		$found = false;
		foreach ($provide as $org_id => $line) {
			foreach ($provide[$org_id] as $inv_no => $line) {
				if(preg_match('/-RE/i',$inv_no))
				{
					unset($provide[$org_id][$inv_no]);
					continue;
				}

				if (!empty($line['inv_no'])) {
					$sql = 'SELECT currency FROM hvlv_db.supplier_invoice WHERE inv_no = :no AND status < 100 AND org_id = :org_id UNION SELECT currency FROM hvlv_top.supplier_invoice WHERE inv_no = :no AND status < 100 AND org_id = :org_id';
					$rs = Yii::app()->db->createCommand($sql)->bindValues([':no' => $inv_no, ':org_id' => $org_id])->queryAll();
					if (!empty($rs)) {
						$provide[$org_id][$inv_no]['currency'] = Invoice::$currencies[$rs[0]['currency']];
					}
				}
				if (number_format($line['accrual'], 2, '.', '') <= 0&&$inv_no==$this->no&&$line['confirm_payable']==0) {
					unset($provide[$org_id][$inv_no]);
					continue;
				}
				foreach ($provide[$org_id][$inv_no] as $key => $value) {
					if (in_array($key, ['accrual', 'invoice_payable', 'dispute', 'confirm_payable'])) {
						if(in_array($provide[$org_id][$inv_no]['supplier_id'],Org::$airportsCal)&&$key=='accrual')
						{
							if(!empty($provide[Org::ORGID_AIRPORT_PCAETEMP][$this->no]))
							{
								$thisValue = str_replace('<div style="width: 100%; text-align: right">', '', $provide[Org::ORGID_AIRPORT_PCAETEMP][$this->no]['accrual']);
								$thisValue = str_replace('</div>', '', $thisValue);
								$thisValue = str_replace(',', '', $thisValue);
								$total[$key] = $total[$key]-$thisValue;
								unset($provide[Org::ORGID_AIRPORT_PCAETEMP]);
							}
						}

						if($backend)
						{
							$provide[$org_id][$inv_no][$key] = $value;
						}else
						{
							$provide[$org_id][$inv_no][$key] = '<div style="width: 100%; text-align: right">' . AppHelper::money_format('%i', $value) . '</div>';
						}
						if (empty($total[$key])) $total[$key] = 0;
						if ($provide[$org_id][$inv_no]['currency'] != 'AUD') {
							$notAUD = true;
							$total[$key] += BillingLine::getByCurrency(floatval($value), array_search($provide[$org_id][$inv_no]['currency'], Invoice::$currencies));
						} else {
							$total[$key] += floatval($value);
						}
					} else if (in_array($key, ['dispute'])) {
						if ($provide[$org_id][$inv_no][$key] <= 0)
						{
							$provide[$org_id][$inv_no][$key] = '';
						}
						else
						{
							if($backend)
							{
								$provide[$org_id][$inv_no][$key] = $value;
							}else
							{
								$provide[$org_id][$inv_no][$key] = '<div style="width: 100%; text-align: right"><span style="color: red">(' . AppHelper::money_format('%i', $value) . ')</span></div>';
							}
						}
						if (empty($total[$key])) $total[$key] = 0;
						if ($provide[$org_id][$inv_no]['currency'] != 'AUD') {
							$notAUD = true;
							$total[$key] += BillingLine::getByCurrency(floatval($value), array_search($provide[$org_id][$inv_no]['currency'], Invoice::$currencies));
						} else {
							$total[$key] += floatval($value);
						}
					} else if (in_array($key, ['confirm_payable / accrual'])) {
						if($backend)
						{
							$provide[$org_id][$inv_no][$key] = $value;
						}else
						{
							$provide[$org_id][$inv_no][$key] = '<div style="width: 100%; text-align: right">' . $value . '</div>';
						}
					}
				}

				if (empty($provide[$org_id][$inv_no]['desc'])) {
					$provide[$org_id][$inv_no]['desc'] = Billing::getDescFromSiReconcile($org_id, $this->id, $inv_no);
				}
			}
		}



		if ($notAUD) {
			foreach ($total as $key => $value) {
				$total[$key] = '~' . $value;
			}
		}

		$rs = [];
		foreach (array_values($provide) as $v) {
			$rs = array_merge($rs, array_values($v));
		}
		return ['data' => array_values($rs), 'total' => $total];
	}

	public function getDest()
	{
		$destArr = [106=>'SYD',218=>'MEL',529=>'ADL',530=>'BNE',811=>'PER',2936=>'FRE'];
		return $destArr[$this->dpt_id];
	}

	public function getMinScanTime()
	{
		$sql = 'SELECT min(json_value(meta,"$.scan_time")) FROM shipment WHERE status != 100 and consol_id = ' . $this->id;
		$c = Yii::app()->db->createCommand($sql);
		return $c->queryScalar();
	}

	public function linkShipment($update=true)
	{
		if (!empty($this->linkShipment)&&!$update) {
			return $this->linkShipment[0];
		}
		if (empty($this->linkShipment)) {
			$model=new ImParcel();
			$model->agent_id= $this->owner_id;
			$cnor = new Addr;
			$cnee=new Addr();
		} else {
			$model= $this->linkShipment[0];
			$cnor=$model->cnor;
			$cnee=$model->cnee;
		}
		$model->hbn= $this->no;
		$model->currency=2;
		$model->consol_id= $this->id;
		if(empty($cnor->name))
		{
			$cnor->name= isset($this->mdata['cnor'])?$this->mdata['cnor']:'';
		}

		if(empty($cnor->address))
		{
			$cnor->address=isset($this->mdata['cnor_addr'])?$this->mdata['cnor_addr']:'';
		}
		$cnor->save();
		
		$model->cnor_id=$cnor->id;
		if(empty($cnee->name))
		{
			$cnee->name=isset($this->mdata['cnee'])?$this->mdata['cnee']:'';
		}
		if(empty($cnee->address))
		{
			$cnee->address=isset($this->mdata['cnee_addr'])?$this->mdata['cnee_addr']:'';
		}
		if(empty($cnee->postcode))
		{
			$cnee->postcode=isset($this->mdata['cnee_postcode'])?$this->mdata['cnee_postcode']:'';
		}
		if(empty($cnee->suburb))
		{
			$cnee->suburb=isset($this->mdata['cnee_suburb'])?$this->mdata['cnee_suburb']:'';
		}
		if(empty($cnee->state))
		{
			$cnee->state=isset($this->mdata['cnee_state'])?$this->mdata['cnee_state']:'';
		}
		if(empty($cnee->country))
		{
			$cnee->country=isset($this->mdata['cnee_country'])?$this->mdata['cnee_country']:'';
		}

		if (empty($cnee->state)) {
			$cnee->state='NSW';
		}
		$cnee->save();
		$model->cnee_id=$cnee->id;
		if (!empty($this->mdata['rece'])) {
			if (empty($model->receiver)) {
				$receiver=new Addr();
			} else {
				$receiver=$model->receiver;
			}
			$receiver->name=$this->mdata['rece'];
			$receiver->address=isset($this->mdata['rece_addr'])?$this->mdata['rece_addr']:'';
			$receiver->save();
			$model->rec_id=$receiver->id;
		}
		$model->pkg= isset($this->mdata['shipments'])?intval($this->mdata['shipments']):1;
		$model->dvalue= isset($this->mdata['dvalue'])?floatval($this->mdata['dvalue']):0;
		$model->weight= isset($this->mdata['awb_wt'])?floatval($this->mdata['awb_wt']):0;
		if(empty($model->ref))
		{
			if ($this->service == 20) {
				$model->ref=isset($this->mdata['house_bill'])?$this->mdata['house_bill']:$this->awb;
			} else {
				$model->ref= $this->awb;
			}
		}
		$model->cref=isset($this->mdata['house_bill'])?$this->mdata['house_bill']:'';
		$model->eitems['type'][0]='O';
		$model->eitems['g'][0]=@$this->mdata['item'];
		$model->eitems['q'][0]=isset($this->mdata['shipments'])?intval($this->mdata['shipments']):1;
		$model->eitems['v'][0]= sprintf("%.2f", (isset($this->mdata['dvalue'])?floatval($this->mdata['dvalue']):0)/(!empty($this->mdata['shipments'])?intval($this->mdata['shipments']):1));
		$model->cbwf=$model->cbwf|ImParcel::CBWF_DIRECT_CONSOL_BASE;
		$model->save();
		if (empty($this->linkShipment)) {
			$link=new ConsolShipmentMap();
			$link->cid=$this->id;
			$link->sid=$model->id;
			$link->save();
		}
		return $model;
	}

	public function getDDUStorageBase()
	{
		$base = 80;
		$minimum = 0;
		$rate = 30; 
		if(!empty($this->mdata['goods_available_address']))
		{
			switch ($this->mdata['goods_available_address']) {
				case 3:
					if(!empty($this->mdata['arrival_cfs']))
					{
						if(preg_match('/CITO/i', $this->mdata['arrival_cfs']))
						{
							$base = 25;
							$rate = 65;
							$minimum = 220;
						}elseif(preg_match('/PORTGATE/i', $this->mdata['arrival_cfs']))
						{
							$base = 55;
							$rate = 45;
							$minimum = 125;
						}elseif(preg_match('/XLI/i', $this->mdata['arrival_cfs']))
						{
							$base = 40;
							$rate = 50;
							$minimum = 200;
						}
					}
					break;
				case 1://CITO
					$base = 25;
					$rate = 65;
					$minimum = 220;
					# code...
					break;
				case 13://portgate
					$base = 55;
					$rate = 45;
					$minimum = 125;
					break;
				case 14://PER XLI
					$base = 40;
					$rate = 50;
					$minimum = 200;
					break;
				
				default:
					# code...
					break;
			}
		}
		return ['base'=>$base,'rate'=>$rate,'minimum'=>$minimum];
	}

	public function getAOutStatus(){
		$result="";
		if(!empty($this->mdata['aoutsent'])&&$this->mdata['aoutsent']==1){
			$result = "Y[D]";
		}elseif (!empty($this->mdata['isclickunpack'])&&$this->mdata['isclickunpack']==1){
			$result = "Y";
		}
		if($this->service==10){
			if(!empty($this->mdata['seaoutreceipt'])&&$this->mdata['seaoutreceipt']==1){
				$result.="[R]";
			}
		}
		return $result;
	}


	public function log($action)
	{
		$extra =["action"=>$action];
		Log::add($this, $this->isNewRecord? 3 : 4, array_merge(['status' => $this->getStatus()], $extra));
	}

	public function getNoticeEmail()
	{
		if($this->is3PL())
		{
			$email = '3pl@toplogistics.com.au';
		}else
		{
			$email = 'imports@toplogistics.com.au';
		}
		return $email;
	}

	public function getReal()
	{
		if(empty($this->real))
		{
			if(!empty($this->shadowParentMap))
			{
				$this->real = $this->shadowParentMap->consol;
			}else
			{
				$this->real = $this;
			}
		}
		return $this->real;
	}	

}
