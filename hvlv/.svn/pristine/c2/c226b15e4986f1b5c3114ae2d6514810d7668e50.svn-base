	public function beforeSave()
	{
		$this->awb = trim($this->awb);
		$this->airline = trim($this->airline);
		$this->flight = trim($this->flight);
		if(!empty($this->mdata)&&!empty($this->mdata['container_no']))
		{
			$this->mdata['container_no'] = trim($this->mdata['container_no']);
		}

		if(!empty($this->mdata)&&!empty($this->mdata['house_bill']))
		{
			$this->mdata['house_bill'] = trim($this->mdata['house_bill']);
		}


		if (empty($this->created)) {
			$this->created = date('Y-m-d H:i:s');
		}

		if (empty($this->status)) {
			$this->status = 10;
		}

		if (empty($this->no)) {
			$this->no = $this->genNo();
		}

		if($this->service == 20) $this->awb = preg_replace('/\s+/', '', $this->awb);
		
		if (!empty($this->mdata)) {
			$this->meta = json_encode($this->mdata);
		}

		return true;
	}

	public function genNo()
	{
		$pfx = 'C';
		if(strtotime($this->eta) >= strtotime('2020-08-01')) $pfx = 'TC';
		if(strtotime($this->eta) >= strtotime('2020-12-30'))
		{
			$pfx = 'TC';
			if(!empty(self::$consolPrefix[$this->dpt_id]))
			{
				$pfx = self::$consolPrefix[$this->dpt_id];
			}
		}

		if(!empty(self::$servicePrefix[$this->service]))
		{
			$pfx .= self::$servicePrefix[$this->service];
		}

		$n = $pfx . date('ymd', strtotime($this->created));
		if ($this->owner_id == Org::ORGID_CLIENT_TLA&&empty($this->mdata['for3PL'])) {
			$n = '3PL' . date('ymd', strtotime($this->created));
		}
		$s = self::model()->count('no LIKE :n', [':n' => $n . '%']) + 1;
		return $n . sprintf('%02d', $s) . substr($this->pol, 2);
	}

	public function getServiceTag()
	{
		if(!empty(self::$servicePrefix[$this->service]))
		{
			return self::$servicePrefix[$this->service];
		}
		return "";
	}

	public function afterSave()
	{
		if (!$this->nolog && !empty($this)) {
			$extra = empty($this->custom_log_note) ? array() : array('note' => $this->custom_log_note);
			if(!empty($this->mdata['available_date']))
			{
				$extra['available_date'] = $this->mdata['available_date'];
			}

			if(!empty($this->eta))
			{
				$extra['eta'] = $this->eta;
			}


			Log::add($this, $this->isNewRecord ? 3 : 4, array_merge(array('status' => $this->getStatus()), $extra));
		}
	}

	public function afterFind()
	{

		if (Yii::app() instanceof CWebApplication) {
			if ($this->isTLA()) [$app_name, Yii::app()->name] = [Yii::app()->name, 'TLA'];
			else [$app_name, Yii::app()->name] = [Yii::app()->name, 'HVLV APP'];
		}

		return parent::afterFind();
	}

	/**
	 * Retrieves a list of models based on the current search/filter conditions.
	 *
	 * Typical usecase:
	 * - Initialize the model fields with values from filter form.
	 * - Execute this method to get CActiveDataProvider instance which will filter
	 * models according to data in model fields.
	 * - Pass data provider to CGridView, CListView or any similar widget.
	 *
	 * @forgp search for gate pass
	 * @bydate search for all after of specified date
	 * @return CActiveDataProvider the data provider that can return the models
	 * based on the search/filter conditions.
	 */
	public function search($pgn = true, $ps = 30, $ec = false, $forgp = false, $bydate = false,$bySea = false)
	{
		// @todo Please modify the following code to remove attributes that should not be searched.

		$criteria = new CDbCriteria;

		$criteria->compare('t.id', $this->id);
		$criteria->compare('t.no', $this->no, true);
		$criteria->compare('t.owner_id', $this->owner_id);
		$criteria->compare('t.dpt_id', $this->dpt_id);
		$criteria->compare('carrier_id', $this->carrier_id);

		if (!empty($this->container_no)) {
			$cawb = new CDbCriteria;
			$cawb->compare('t.container_no', $this->container_no, true);
			$cawb->compare('t.meta', $this->container_no, true, 'OR');
			$criteria->mergeWith($cawb);
		}

		if(!empty($this->service)&&$this->service==ImcoConsol::AIRCONSOL&&$this->dpt_id==Org::TLA_DEPARTMENT_SYDNEY)
		{
			$criteria->addCondition('t.service=10 or (t.service=0 and awb like "Direct%")');
		}else
		{
			$criteria->compare('service', $this->service);
		}
		
		if(!empty($this->dpt_id)&&$this->canUserCheckAll())
		{
			$criteria->compare('t.dpt_id', $this->dpt_id);
		}else
		{
			if($this->isBackend)
			{
				if(!empty($this->dpt_id))
				{
					$criteria->compare('t.dpt_id', $this->dpt_id);
				}
			}else
			{
				$criteria->compare('t.dpt_id', $this->getUserDptId());
			}
		}

		if (empty($this->status)) {
			if(!$this->isBackend)// occupation control
			{
				$permissionArr = ConsolProcessService::getUserPermission();
				$serviceStr = "";
				$statusStr = "";
				if(!empty($permissionArr[0]))
				{
					$criteria->addCondition(" service in (".join(',',$permissionArr[0]).")" );
				}

				if(!empty($permissionArr[1]))
				{
					$criteria->addCondition(" t.status".$permissionArr[1]);
				}
			}
			$criteria->addCondition('t.status != 100');
		}

		$with = [];
		if (!empty($this->process_not_status)) {
			$with[] = 'process';
			$criteria->addNotInCondition('process.status', $this->process_not_status);
		}
		if (!empty($this->process_status)) {
			$with[] = 'process';
			$criteria->compare('process.status', $this->process_status);
		}
		if (!empty($this->process_statuses)) {
			$with[] = 'process';
			$criteria->addInCondition('process.status', $this->process_statuses);
		}
		if (!empty($this->sea_process_status)) {
			$with[] = 'process';
			$criteria->addCondition('process.status&' . $this->sea_process_status . "=0");
		}
		if (!empty($this->process_types)) {
			$with[] = 'process';
			$criteria->addInCondition('process.type', $this->process_types);
		}
		if (!empty($this->bwf)) {
			$criteria->addCondition('t.bwf&' . $this->bwf . ">0");
		}
		if (!empty($this->process_airport)) {
			$with[] = 'process';
			$criteria->compare('process.airport', $this->process_airport, true);
		}
		if (!empty($this->process_airport_dead)) {
			$with[] = 'process';
			$criteria->compare('process.airport', $this->process_airport_dead, true);

		}
		if (!empty($this->owner_name)) {
			//$criteria->compare('owner.name',$this->owner_name,true);
			$sql = 'SELECT s.consol_id FROM shipment s INNER JOIN org o on s.agent_id = o.id WHERE o.name LIKE :n GROUP BY s.agent_id, s.consol_id';
			$rs = Yii::app()->db->createCommand($sql)->bindValues([':n' => '%' . $this->owner_name . '%'])->queryAll();
			$cids = [];
			$anotherSql = 'SELECT s.id FROM consol s INNER JOIN org o ON s.owner_id=o.id WHERE s.owner_id>0 AND o.name LIKE :n';
			$rs1 = Yii::app()->db->createCommand($anotherSql)->bindValues([':n' => '%' . $this->owner_name . '%'])->queryAll();
			foreach ($rs as $r) {
				if (empty($r['consol_id'])) {
					continue;
				}

				$cids[] = $r['consol_id'];
			}
			foreach ($rs1 as $r) {
				if (empty($r['id'])) {
					continue;
				}

				$cids[] = $r['id'];
			}
			$criteria->addInCondition("t.id", $cids);
		}

		if (!empty($this->awb)) {
			$cawb = new CDbCriteria;
			$cawb->compare('t.awb', $this->awb, true);
			$cawb->compare('t.meta', $this->awb, true, 'OR');
			$criteria->mergeWith($cawb);
		} else {
			if ($forgp) {
				$criteria->addCondition('awb is not NULL');
			}
		}
		if (!empty($this->mabws)) {
			$ns = preg_split('/[\s,;]+/', trim($this->mabws));
			if (sizeof($ns) > 1000) {
				$ns = array_slice($ns, 0, 1000);
			}
			$sc1 = new CDbCriteria;
			$sc1->addCondition('t.awb REGEXP "' . implode('|', $ns) . '"');
			$sc1->addCondition('t.meta REGEXP "' . implode('|', $ns) . '"', 'OR');
			$sc1->addCondition('t.no REGEXP "' . implode('|', $ns) . '"', 'OR');
			$criteria->mergeWith($sc1);
		}
		$criteria->compare('exrate', $this->exrate, true);
		$criteria->compare('airline', $this->airline, true);
		$criteria->compare('flight', $this->flight, true);
		$criteria->compare('pol', $this->pol);
		$criteria->compare('pod', $this->pod);
		$criteria->compare('poc', $this->poc, true);
		$criteria->compare('etd', $this->etd, true);
		$criteria->compare('eta', $this->eta, true);

		if (!empty($this->cargoType)) {
			$criteria->addCondition('JSON_VALUE(t.meta,"$.cargo_type") = "'.$this->cargoType.'"');

		}

		if ($forgp) {
			// in case searching for GatePass
			// we only show not cleared console
			$criteria->addCondition('t.status < 90');
		} else {
			$criteria->compare('t.status', $this->status);
		}
		if ($bydate) {
			$criteria->addCondition("t.created >= '2017-01-01'");
		} else {
			$criteria->compare('t.created', $this->created, true);
		}
		if (!empty($this->bwf)) {
			$criteria->addCondition('bwf & ' . $this->bwf . ' > 0');
		}

		if($this->exInfo==ImParcel::DGBWFCODE)
		{
			$with[] = 'shipments';
			$criteria->addCondition('json_value(shipments.meta,"$.is_dg") = 1');
		}
		if($this->exInfo==ImParcel::DAMAGEBWFCODE)
		{
			$with[] = 'shipments';
			$criteria->addCondition('shipments.bwf & ' . $this->exInfo . ' > 0');
		}
		if($this->exInfo==self::NOA_SENT_UB)
		{
			$criteria->addCondition('json_value(t.meta,"$.NOA_SENT_UB")=1');
		}



		if ($ec) {
			$criteria->mergeWith($ec);
		}

		$sort = new CSort(get_called_class());
		$sort->attributes = array(
			'owner_name' => array(
				'asc' => 'owner.name',
				'desc' => 'owner.name DESC',
			),
			'process_airport' => array(
				'asc' => 'process.airport',
				'desc' => 'process.airport DESC',
			),
			'process_airport_dead' => array(
				'asc' => 'process.pick_dead_date',
				'desc' => 'process.pick_dead_date DESC',
			),
			'*',
		);

		if($bySea)
		{
			$sort->defaultOrder = 't.eta ASC, t.airline,t.flight';
		}else
		{

			$sort->defaultOrder = 't.id DESC';
		}
		$sob = $sort->getOrderBy();
		$sobs = preg_split('/, */', $sob);
		foreach ($sobs as $ob) {
			if (!strpos($ob, '.')) {
				continue;
			}

			list($m, $f) = explode('.', $ob);
			if (str_replace('`', '', $m) == 't') {
				continue;
			}

			$with[] = $m;
		}
		if (!empty($with)) {
			$criteria->with = array_unique($with);
			$criteria->together = true;
		}

		return new CActiveDataProvider($this, array(
			'criteria' => $criteria,
			'sort' => $sort,
			'pagination' => $pgn ? array(
				'pageSize' => $ps,
			) : false,
		));
	}

	public static function getTheConsolType($id)
	{
		$sql = "SELECT type FROM `consol` WHERE id=" . $id;
		$type = Yii::app()->db->createCommand($sql)->queryScalar();
		return $type;
	}

	public function getBLpcs()
	{
		if ($this->type == 15) {
			return @$this->mdata['b&l_pcs'];
		} else if ($this->type == 70) {
			return @$this->mdata['shipments'];
		} else {
			return '';
		}
	}

	public function updateMeta()
	{
		$this->meta = json_encode($this->mdata);
		$this->update(['meta']);
	}

	/**
	 * Returns the static model of the specified AR class.
	 * Please note that you should have this exact method in all your CActiveRecord descendants!
	 * @param string $className active record class name.
	 * @return Consol the static model class
	 */
	public static function model($className = __CLASS__)
	{
		return parent::model(get_called_class());
	}



