	/**
	 * get total invoice amount
	 * just get from related invoice directly
	 * we don't calculate it again
	 */
	public function getTotalInvoice()
	{
		$this->totRevenue = 0;

		// [$app_name, Yii::app()->name] = [Yii::app()->name, 'HVLV APP'];
		// $r1 = $this->_getTotalInvoice();
		// Yii::app()->name = $app_name;
		[$app_name, Yii::app()->name] = [Yii::app()->name, 'TLA'];
		$r2 = $this->_getTotalInvoice();
		Yii::app()->name = $app_name;
		$this->totRevenue = $r2;
		// $this->totRevenue = $r1+$r2;
		return $this->totRevenue;
	}

	public function _getTotalInvoice()
	{
		$totRevenue = 0;
		// ignore cancelled invoice
		//        $sql = 'SELECT SUM(total-gst) FROM invoice WHERE status < 10 AND consol_id = '.$this->id;
		//        $c = Yii::app()->db->createCommand($sql);
		//        $this->totRevenue = round(floatval($c->queryScalar()),2);
		//        return  $this->totRevenue;
		$invs = Invoice::model()->findAll('consol_id=:consol_id and status NOT IN (10)', array('consol_id' => $this->id));
		$temp = [];
		$other = [];
		if (!empty($invs)) {
			foreach ($invs as $i => $inv) {
				// if (preg_match("/$inv->id/i", $inv->no)) {
				// 	$temp[$inv->no][$inv->no] = $inv;
				// } else {
					$other[$inv->no] = $inv;
				// }
			}
			/*if (!empty($temp) && !empty($other)) {
				foreach ($temp as $no => $t) {
					foreach ($other as $k => $ot) {
						if (preg_match("/$no/", $k)) {
							$temp[$no][$ot->no] = $ot;
							unset($other[$k]);
						}
					}
				}
			}*/
			$total = 0;
			/*foreach ($temp as $no => $t) {
				if (sizeof($t) > 1) {
					ksort($t);
					$t = array_reverse($t);
					foreach ($t as $k) {
						$total += ($k->total - $k->gst - $k->getCreditByConsol());
						break;
					}
				} else {
					foreach ($t as $m) {
						$total += ($m->total - $m->gst - $m->getCreditByConsol());
					}
				}
			}*/
			if (!empty($other)) {
				foreach ($other as $o) {
					$total += ($o->total - $o->gst); // - $o->getCreditByConsol()
				}
			}
			$totRevenue = round(floatval($total), 2);

		}

		// add rts invoice
		foreach ($this->getRTSInvoices() as $invoice) {
			$totRevenue += $invoice->getTotalByConsol($this->id, false);
		}

		if (preg_match('/RTS/', $this->no)) {
			$invoices = Invoice::model()->findAll('type = 36');
			foreach ($invoices as $invoice) {
				$totRevenue -= $invoice->total - $invoice->gst;
			}
		}

		// minus credit note
		$creditnotes = Payment::model()->findAll('type = 5 AND (ref LIKE :ref or JSON_VALUE(meta, "$.consol") LIKE :ref) AND status = 6', [':ref' => '%' . $this->no . '%']);
		foreach ($creditnotes as $creditnote) {
			$totRevenue -= $creditnote->amount;
		}

		// minus auto credit note
		foreach ($invs as $invoice) {
			if ($invoice->status == 8) {
				foreach ($invoice->payments as $payInv) {
					if ($payInv->payment->type == 5 && $payInv->payment->bank == 90 && $payInv->payment->status == 6) {
						$totRevenue -= $payInv->amount;
					}
				}
			}
		}

		$totRevenue = round(floatval($totRevenue), 2);

		if (empty($totRevenue)) {
			$totRevenue = 0;
		}

		return $totRevenue;
	}

	public function getTotalInvoiceByOrg($oid)
	{
		$invoices = Invoice::model()->findAll('consol_id=:consol_id and status not in (1,8,10) AND to_id=:oid', array('consol_id' => $this->id, ':oid' => $oid));
		$total = 0;
		foreach ($invoices as $i => $inv) {
			$total += ($inv->total - $inv->gst - $inv->getCredit());
		}
		return $total;
	}

	public function getTotalInvoiceOutDates($dateFrom, $dateTo)
	{
		$total = 0;
		// ignore cancelled invoice
		// 2020-04-17 and ignore fully credit and pending invoice
		$invoices = Invoice::model()->findAll('consol_id = :cid and status NOT IN (1,8,10)', [':cid' => $this->id]);
		foreach ($invoices as $invoice) {
			if ($invoice->date < $dateFrom || $invoice->date > $dateTo) {
				$total += ($invoice->total - $invoice->gst);
			}
			// $dates .= $invoice->no . '[' . $invoice->total. ']' . '('. $invoice->date . '),';
		}
		return round($total, 2);
	}

	public function getInvoices()
	{
		// ignore cancelled invoice
		$invoices = Invoice::model()->findAll('consol_id = :cid and status NOT IN (1,8,10)', [':cid' => $this->id]);
		$rs = [];
		foreach ($invoices as $invoice) {
			$rs[] = [$this->no, $invoice->no, $invoice->date, $invoice->total - $invoice->gst, $invoice->gst, $invoice->getCredit()];
		}
		return $rs;
	}

	public function totCharge()
	{
		$tot = 0;
		foreach ($this->shipments as $p) {
			$tot += $p->getCharge($this->owner);
		}
		return $tot;
	}

	public function updateWmsDeliveryCost($cid, $rec)
	{
		$ss = [];
		$shipment_left = [];
		$transaction = Yii::app()->db->beginTransaction();
		try {
			foreach ($this->shipments as $p) {
				if (!empty($p->trans) && $p->trans[0]->org_id == $cid) {
					if (isset($p->mdata['import_billing_id'])) {
						$billingline = BillingLine::model()->findByPk($p->mdata['import_billing_id']);
						if (!empty($billingline) && $billingline->status != 11 && $billingline->actual_amount != 0) continue;
					}
					$cond = 'shipment_id = :ship AND parent_id = :pid';
					$params = array(':ship' => $p->id, ':pid' => $rec);
					if ($cid == Org::ORGID_COURIER_STARTRACK) {
						$cond .= ' AND JSON_VALUE(meta, "$.st_type") = :type';
						$params[':type'] = 'Shipment';
					}
					$rs = ReconciliationLine::model()->findAll($cond, $params);
					if (!empty($rs)) {
						$p->mdata['actual_delivery_cost'] = 0;
						foreach ($rs as $r) {
							$p->mdata['actual_delivery_cost'] += round(floatval(min($r->value, $r->my_value)) * 100, 2) / 100;
						}
						$p->updateMeta();
						$ss[] = $p;
					}
				}
			}

			$r = Reconciliation::model()->findByPk($rec);
			foreach ($ss as $s) {
				if (preg_match('/^T(\d{6,7})$/', $s->cref, $m)) {
					$wmstask = WmsTask::model()->findByPk($m[1]);
				} else {
					$wmstask = WmsTask::model()->with('deliveryTask')->find('JSON_QUERY(deliveryTask.meta, "$.shipment_id") LIKE "%' . $s->id . '%"');
				}

				if (!empty($wmstask)) {
					$billing = BillingLine::model()->find('link_id = :id AND billing_ref = :ref AND org_id = :oid AND billing_cref = :cref AND `desc` = :desc', array(':id' => $this->id, ':ref' => $wmstask->getNo(), ':oid' => $cid, ':cref' => $this->no, ':desc' => $r->invoice_no . ' - ' . $this->no));
					if (empty($billing)) {
						$billing = new BillingLine;
						$billing->status = 1;
						$billing->link_id = $this->id;
						$billing->org_id = $cid;
						$billing->op_id = empty(Yii::app()->user->id) ? 0 : Yii::app()->user->id;
						$billing->charge_code = Consol::DELIVERY_3PL_COST_GL_CODE;
						$billing->billing_cref = $r->invoice_no;
						$billing->billing_ref = $wmstask->getNo();
						$billing->awb = '';
						$billing->dpt_id = 106;
						$billing->date = $r->invoice_date;
						$billing->created = $r->invoice_date;
						$billing->transaction_date = $r->invoice_date;
						$billing->due = $r->invoice_date;
						$billing->type = BillingLine::BILLING_TYPE_3PL;
						$billing->dpmt = Invoice::DPMT_3PL;
						$billing->actual_amount = 0;
						$billing->gst = 'INPUT';
						$billing->desc = $r->invoice_no . ' - ' . $this->no;
						$billing->accrual_amount = 0;
						$billing->actual_amount = 0;
						$billing->save();
					}
					if (empty($billing->getErrors())) {
						$theCost = 0;
						$s->mdata['import_billing_id'] = $billing->id;
						$s->updateMeta();
						foreach ($s->trans as $ts) {
							if ($ts->type == 80) {
								$theCost += $ts->cost;
							}
						}
						$billing->accrual_amount += number_format($s->mdata['actual_delivery_cost'], 2, '.', '');
						$billing->actual_amount += number_format($s->mdata['actual_delivery_cost'], 2, '.', '');
						$billing->actual_amount = number_format(round($billing->actual_amount * 100) / 100, 2, '.', '');
						$billing->gst = 'INPUT';
						$billing->gst_amount = $billing->getGSTValue();
						$billing->save();
					}

					// link billing and check
					Billing::linkLine($billing);
				}
			}
			$transaction->commit();
		} catch (Exception $ex) {
			$transaction->rollback();
			throw $ex;
		}
	}

	public function updateWmsRTSCost($rec)
	{
		$cid = Org::ORGID_COURIER_AUPOST;
		$transaction = Yii::app()->db->beginTransaction();
		try {
			$sql = 'SELECT rl.shipment_no AS shipment_no, r.manifest_no AS manifest_no, r.invoice_date AS invoice_date, SUM(rl.value) AS sum FROM reconciliation_line rl JOIN reconciliation r ON r.id = rl.parent_id WHERE r.client_type = 10 AND rl.consol_id = :consol_id GROUP BY rl.shipment_no';
			$rs = Yii::app()->db->createCommand($sql)->bindValues([':consol_id' => $this->id])->queryAll();
			foreach ($rs as $r) {
				$shipment = ImParcel::model()->find('ref = :ref', [':ref' => $r['shipment_no']]);
				if (preg_match('/^T(\d{6,7})$/', $shipment->cref, $m)) {
					$task = WmsTask::model()->findByPk($m[1]);
				} else {
					$task = WmsTask::model()->with('deliveryTask')->find('JSON_QUERY(deliveryTask.meta, "$.shipment_id") LIKE "%' . $shipment->id . '%"');
				}
				if (!empty($task)) {
					$billing = BillingLine::model()->find('billing_ref = :ref AND org_id = :oid AND charge_code = :ccode AND JSON_VALUE(meta, "$.rts_manifest_no") = :manifest_no', [':ref' => $task->getNo(), ':oid' => $cid, ':ccode' => self::DELIVERY_3PL_COST_GL_CODE, ':manifest_no' => $r['manifest_no']]);
					if (empty($billing)) {
						$billing = new BillingLine;
						$billing->status = 1;
						$billing->link_id = 0;
						$billing->org_id = $cid;
						$billing->charge_code = Consol::DELIVERY_3PL_COST_GL_CODE;
						$billing->billing_cref = $r['manifest_no'];
						$billing->currency = 1; // AUD default
						$billing->weight = 0;
						$billing->charge_weight = 0;
						$billing->billing_ref = $task->getNo();
						$billing->awb = $this->awb;
						$billing->dpt_id = empty($this->dpt_id) ? Org::PCAE_DEPARTMENT_SYDNEY : $this->dpt_id;
						$billing->date = $r['invoice_date'];
						$billing->created = date('Y-m-d');
						$billing->transaction_date = $r['invoice_date'];
						$billing->due = $r['invoice_date'];
						$billing->type = BillingLine::BILLING_TYPE_3PL; // for 3pl type
						$billing->dpmt = Invoice::DPMT_3PL;
						$billing->mdata['rts_manifest_no'] = $r['manifest_no'];
					}
					$billing->actual_amount = 0;
					$billing->gst = 'INPUT';
					$billing->gst_amount = $billing->getGSTValue();
					$billing->accrual_amount = number_format(round($r['sum'], 2), 2, '.', '');
					$billing->save();
				}
			}
			$transaction->commit();
		} catch (Exception $ex) {
			$transaction->rollback();
			throw $ex;
		}
	}

	/**
	 * update aupost real cost
	 * @throws CDbException
	 */
	public function updateAupostRealCost()
	{
		$totalCost = [];
		$totalAccrual = [];
		$shipment_left = [];
		$ss = [];
		$cid = Org::ORGID_COURIER_AUPOST;
		$billings = BillingLine::model()->findAll([
			'condition' => 'billing_ref = :cref AND org_id = :oid AND charge_code = :ccode AND JSON_VALUE(meta, "$.rts_manifest_no%") IS NULL',
			'params' => [':cref' => $this->no, ':oid' => $cid, ':ccode' => self::AU_LOCAL_DELIVERY_COST_GL_CODE],
			'order' => 'id ASC'
		]);
		$transaction = Yii::app()->db->beginTransaction();
		try {
			$invoice_no = '';
			$invoice_date = '';
			foreach ($this->shipments as $p) {
				if (preg_match('/^AMQ\d{7}|^333UF\d{7}|^33EVJ\d{7}|^33EVH\d{7}/', $p->ref) || (!empty($p->trans) && $p->trans[0]->org_id == 101)) {
					// only for eParcel shipment
					// if (isset($p->mdata['import_billing_id']) && sizeof($billings) >= 1) {
					// 	continue;
					// }
					if (isset($p->mdata['import_billing_id'])) {
						$billingline = BillingLine::model()->findByPk($p->mdata['import_billing_id']);
						if (!empty($billingline) && $billingline->status != 11 && $billingline->actual_amount != 0) {
							// $consol = Consol::model()->find('no = :no', [':no' => $billingline->billing_ref]);
							// if ($consol->id == $p->consol_id) {
							// 	continue;
							// } else {
							// 	$p->mdata['old_import_billing_id'] = $p->mdata['import_billing_id'];
							// 	unset($p->mdata['import_billing_id']);
							// }
							// cause duplicate actual_amount in origin and new consol
							continue;
						}
					}
					// set import_billing_id means we have account this cost to the billing before.
					// $r = ReconciliationLine::model()->find(array('condition' => 'shipment_no=:ship', 'params' => array(':ship' => $p->ref), 'order' => 'id desc'));
					// if (!empty($r)) {
					// 	$invoice_no = $r->parent->invoice_no;
					// 	$invoice_date = $r->parent->invoice_date;
					// }
					// if (isset($p->mdata['actual_delivery_cost'])) {
					// 	$totalCost += floatval($p->mdata['actual_delivery_cost']);
					// 	$ss[] = $p;
					// } else {
					// 	if (!empty($r)) {
					// 		$totalCost += floatval($r->value);
					// 		$p->mdata['actual_delivery_cost'] = floatval($r->value);
					// 		$p->updateMeta();
					// 		$ss[] = $p;
					// 	} else {
					// 		$shipment_left[] = $p;
					// 	}
					// }

					$rs = ReconciliationLine::model()->with('parent')->findAll('t.shipment_no = :ship AND parent.client_type = :type', array(':ship' => $p->ref, ':type' => Reconciliation::AUPOST_TYPE));
					if (!empty($rs)) {
						$p->mdata['actual_delivery_cost'] = 0;
						foreach ($rs as $r) {
							$invoice_no = $r->parent->manifest_no;
							$invoice_date = $r->parent->invoice_date;
							if (empty($totalCost[$invoice_no])) $totalCost[$invoice_no] = 0;
							$totalCost[$invoice_no] += floatval($r->value);
							if (empty($totalAccrual[$invoice_no])) $totalAccrual[$invoice_no] = 0;
							$totalAccrual[$invoice_no] += floatval($r->my_value);
							$p->mdata['actual_delivery_cost'] += floatval($r->value);
						}
						$p->updateMeta();
						$ss[$invoice_no][] = $p;
					} else {
						$shipment_left[] = $p;
					}
				}
			}

			foreach ($ss as $$invoice_no => $sub_ss) {
				if ($totalCost[$$invoice_no] > 0) {
					if (!empty($billings)) {
						$billing = end($billings);
						if ($billing->actual_amount > 0) {
							$billing = null;
						}
					}
					if (empty($billing)) {
						$billing = new BillingLine();
						$billing->status = 1; // initial pending status
						$billing->link_id = 0;
						$billing->org_id = $cid;
						$billing->charge_code = Consol::AU_LOCAL_DELIVERY_COST_GL_CODE;
						if ($this->owner_id == 114) {
							$billing->charge_code = Consol::DELIVERY_3PL_COST_GL_CODE;
						}
						$billing->currency = 1; // AUD default
						$billing->weight = 0;
						$billing->charge_weight = 0;
						$billing->billing_ref = $this->no;
						$billing->awb = $this->awb;
						$billing->dpt_id = empty($this->dpt_id) ? Org::PCAE_DEPARTMENT_SYDNEY : $this->dpt_id;
						$billing->type = BillingLine::BILLING_TYPE_IMPORT; // for import type
						$billing->dpmt = Invoice::DPMT_IMPORT;
						if ($this->owner_id == 114) {
							$billing->type = BillingLine::BILLING_TYPE_3PL;
							$billing->dpmt = Invoice::DPMT_3PL;
						}
					}
					$billing->actual_amount = number_format(round($totalCost[$$invoice_no], 2), 2, '.', '');
					$billing->accrual_amount = number_format(round($totalAccrual[$$invoice_no], 2), 2, '.', '');
					$billing->gst = 'INPUT';
					$billing->gst_amount = $billing->getGSTValue();
					$billing->desc = 'total shipment: ' . sizeof($sub_ss);
					$billing->billing_cref = $invoice_no;
					$billing->date = $invoice_date;
					$billing->created = $invoice_date;
					$billing->transaction_date = $invoice_date;
					$billing->due = $invoice_date;
					if ($billing->save()) {
						foreach ($sub_ss as $p) {
							$p->mdata['import_billing_id'] = $billing->id;
							$p->updateMeta();
						}
					}

					// link billing and check
					Billing::linkLine($billing);
				}
			}

			if (sizeof($shipment_left) > 0) {
				$theCost = 0;
				foreach ($shipment_left as $shipment) {
					// get all tranships
					$tss = $shipment->trans;
					foreach ($tss as $ts) {
						if ($ts->type == 80) {
							$theCost += $ts->cost;
						}
					}
				}

				$newBilling = new BillingLine();
				$newBilling->status = 1; // initial pending status
				$newBilling->link_id = 0;
				$newBilling->org_id = $cid;
				$newBilling->charge_code = Consol::AU_LOCAL_DELIVERY_COST_GL_CODE;
				if ($this->owner_id == 114) {
					$newBilling->charge_code = Consol::DELIVERY_3PL_COST_GL_CODE;
				}
				$newBilling->billing_cref = $this->no;
				$newBilling->currency = 1; // AUD default
				$newBilling->weight = 0;
				$newBilling->charge_weight = 0;

				// normally billing reference will be awb no , if not set we set job ID as reference
				$newBilling->billing_ref = $this->no;
				$newBilling->awb = $this->awb;
				$newBilling->dpt_id = empty($this->dpt_id) ? Org::PCAE_DEPARTMENT_SYDNEY : $this->dpt_id;
				$newBilling->date = date('Y-m-d');
				$newBilling->created = date('Y-m-d');
				$newBilling->transaction_date = date('Y-m-d');
				$newBilling->due = date('Y-m-d');
				$newBilling->type = BillingLine::BILLING_TYPE_IMPORT; // for import type
				$newBilling->dpmt = Invoice::DPMT_IMPORT;
				if ($this->owner_id == 114) {
					$newBilling->type = BillingLine::BILLING_TYPE_3PL;
					$newBilling->dpmt = Invoice::DPMT_3PL;
				}
				$newBilling->actual_amount = 0;
				$newBilling->gst = 'INPUT';
				$newBilling->desc = "left shipment " . sizeof($shipment_left);
				$newBilling->accrual_amount = number_format($theCost, 2, '.', '');
				$newBilling->save();
			}
			$transaction->commit();
		} catch (Exception $ex) {
			$transaction->rollback();
			throw $ex;
		}
	}

	public function updateAupostRealCostRTS()
	{
		$cid = Org::ORGID_COURIER_AUPOST;
		$transaction = Yii::app()->db->beginTransaction();
		try {
			$sql = 'SELECT r.manifest_no AS manifest_no, r.invoice_date AS invoice_date, SUM(rl.value) AS sum FROM reconciliation_line rl JOIN reconciliation r ON r.id = rl.parent_id WHERE r.client_type = 10 AND rl.consol_id = :consol_id GROUP BY r.id';
			$rs = Yii::app()->db->createCommand($sql)->bindValues([':consol_id' => $this->id])->queryAll();
			foreach ($rs as $r) {
				$billing = BillingLine::model()->find('billing_ref = :ref AND org_id = :oid AND charge_code = :ccode AND JSON_VALUE(meta, "$.rts_manifest_no") = :manifest_no', [':ref' => $this->no, ':oid' => $cid, ':ccode' => self::AU_LOCAL_DELIVERY_COST_GL_CODE, ':manifest_no' => $r['manifest_no']]);
				if (empty($billing)) {
					$billing = new BillingLine;
					$billing->status = 1;
					$billing->link_id = 0;
					$billing->org_id = $cid;
					$billing->charge_code = Consol::AU_LOCAL_DELIVERY_COST_GL_CODE;
					$billing->billing_cref = $r['manifest_no'];
					$billing->currency = 1; // AUD default
					$billing->weight = 0;
					$billing->charge_weight = 0;
					$billing->billing_ref = $this->no;
					$billing->awb = $this->awb;
					$billing->dpt_id = empty($this->dpt_id) ? Org::PCAE_DEPARTMENT_SYDNEY : $this->dpt_id;
					$billing->date = $r['invoice_date'];
					$billing->created = date('Y-m-d');
					$billing->transaction_date = $r['invoice_date'];
					$billing->due = $r['invoice_date'];
					$billing->type = BillingLine::BILLING_TYPE_IMPORT; // for import type
					$billing->dpmt = Invoice::DPMT_IMPORT;
					$billing->mdata['rts_manifest_no'] = $r['manifest_no'];
				}
				$billing->actual_amount = 0;
				$billing->gst = 'INPUT';
				$billing->gst_amount = $billing->getGSTValue();
				$billing->accrual_amount = number_format(round($r['sum'], 2), 2, '.', '');
				$billing->save();
			}
			$transaction->commit();
		} catch (Exception $ex) {
			$transaction->rollback();
			throw $ex;
		}
	}

	public function getEstID(){
		$ub_other_depot = (!empty($this->mdata['ubmsent']) && $this->mdata['ubmsent'] == 9) && (!empty($this->mdata['ubm_dest']) && !empty(IcsService::getIcsConfig($this->mdata['ubm_dest'])));
	
		$thisIcsSetting = Yii::app()->params['ics'];
		if($ub_other_depot) $thisIcsSetting = IcsService::getIcsConfig($this->mdata['ubm_dest']);

		$dpt = 'AUSYD';
		if($this->dpt_id == 218){
			$dpt = 'AUMEL';
		}

		if($this->dpt_id == 530){
			$dpt = 'AUBNE';
		}

		if(empty($this->mdata['ubm_dest']))
		{
			if($dpt=='AUSYD')
			{
				return 'GP29H';
			}elseif($dpt == 'AUMEL')
			{
				return 'GP47K';
			}elseif($dpt == 'AUBNE')
			{
				return 'GQ48B';
			}
		}
		return $thisIcsSetting['est_id_'.$dpt];
	}

	public function updateStarTrackRealCost($rec_id = null)
	{
		$totalCost = [0, 0];
		$shipment_left = [[], []];
		$ss = [[], []];

		$cid[0] = Org::ORGID_COURIER_STARTRACK;
		$billings[0] = BillingLine::model()->findAll('billing_ref = :cref AND org_id = :oid AND charge_code = :ccode AND status = 1 order by id', [':cref' => $this->no, ':oid' => $cid[0], ':ccode' => self::AU_LOCAL_DELIVERY_COST_GL_CODE]);
		$cid[1] = Org::ORGID_COURIER_STARTRACK;
		$billings[1] = BillingLine::model()->findAll('billing_ref = :cref AND org_id = :oid AND charge_code = :ccode AND status = 1 order by id', [':cref' => $this->no, ':oid' => $cid[1], ':ccode' => self::AU_LOCAL_DELIVERY_COST_GL_CODE]);

		$transaction = Yii::app()->db->beginTransaction();
		try {
			$invoice_no = '';
			$invoice_date = '';
			foreach ($this->shipments as $p) {
				if (preg_match('/(7RFZ)\d{8}/', $p->ref)) {
					if (isset($p->mdata['import_billing_id'])) {
						// foreach ($billings[0] as $billingline) {
						// 	if ($p->mdata['import_billing_id'] == $billingline->id && $billingline->actual_amount != 0) {
						// 		continue 2;
						// 	}
						// }
						$billingline = BillingLine::model()->findByPk($p->mdata['import_billing_id']);
						if (!empty($billingline) && $billingline->status != 11 && $billingline->actual_amount != 0) continue;
					}
					// set import_billing_id means we have account this cost to the billing before.
					if (empty($rec_id)) {
						$r = ReconciliationLine::model()->find(array('condition' => 'shipment_no = :ship AND JSON_VALUE(meta, "$.st_type") = "Shipment"', 'params' => array(':ship' => $p->ref), 'order' => 'id desc'));
						if (!empty($r)) {
							$invoice_no = $r->parent->invoice_no;
							$invoice_date = $r->parent->invoice_date;
						}
						/**
						 * 2020-06-16
						 * only record min(value, my_value)
						 */
						if (!empty($r)) {
							$amount = floatval($r->my_value * 1.05 < $r->value || $r->my_value + 10 < $r->value ? $r->my_value : $r->value);
							$totalCost[0] += $amount;
							$p->mdata['actual_delivery_cost'] = $amount;
							$p->updateMeta();
							$ss[0][$p->hbn] = $p;
						} else {
							$shipment_left[0][] = $p;
						}
					} else {
						// one shipment charge multiple times in one invoice
						$rs = ReconciliationLine::model()->findAll('shipment_no = :ship AND parent_id = :invid AND JSON_VALUE(meta, "$.st_type") = "Shipment"', [':ship' => $p->ref, ':invid' => $rec_id]);
						if (!empty($rs)) {
							$invoice_no = $rs[0]->parent->invoice_no;
							$invoice_date = $rs[0]->parent->invoice_date;
							foreach ($rs as $r) {
								$amount = floatval($r->my_value * 1.05 < $r->value || $r->my_value + 10 < $r->value ? $r->my_value : $r->value);
								$totalCost[0] += $amount;
								$p->mdata['actual_delivery_cost'] = $amount;
								$p->updateMeta();
								$ss[0][$p->hbn] = $p;
							}
						} else {
							$shipment_left[0][] = $p;
						}
					}
				} else if (preg_match('/(4XHZ)\d{8}/', $p->ref)) {
					if (isset($p->mdata['import_billing_id'])) {
						// foreach ($billings[1] as $billingline) {
						// 	if ($p->mdata['import_billing_id'] == $billingline->id && $billingline->actual_amount != 0) {
						// 		continue 2;
						// 	}
						// }
						$billingline = BillingLine::model()->findByPk($p->mdata['import_billing_id']);
						if (!empty($billingline) && $billingline->status != 11 && $billingline->actual_amount != 0) continue;
					}
					// set import_billing_id means we have account this cost to the billing before.
					if (empty($rec_id)) {
						$r = ReconciliationLine::model()->find(array('condition' => 'shipment_no = :ship AND JSON_VALUE(meta, "$.st_type") = "Shipment"', 'params' => array(':ship' => $p->ref), 'order' => 'id desc'));
						if (!empty($r)) {
							$invoice_no = $r->parent->invoice_no;
							$invoice_date = $r->parent->invoice_date;
						}
						if (!empty($r)) {
							$amount = floatval($r->my_value * 1.05 < $r->value || $r->my_value + 10 < $r->value ? $r->my_value : $r->value);
							$totalCost[1] += $amount;
							$p->mdata['actual_delivery_cost'] = $amount;
							$p->updateMeta();
							$ss[1][$p->hbn] = $p;
						} else {
							$shipment_left[1][] = $p;
						}
					} else {
						// one shipment charge multiple times in one invoice
						$rs = ReconciliationLine::model()->findAll('shipment_no = :ship AND parent_id = :invid AND JSON_VALUE(meta, "$.st_type") = "Shipment"', [':ship' => $p->ref, ':invid' => $rec_id]);
						if (!empty($rs)) {
							$invoice_no = $rs[0]->parent->invoice_no;
							$invoice_date = $rs[0]->parent->invoice_date;
							foreach ($rs as $r) {
								$amount = floatval($r->my_value * 1.05 < $r->value || $r->my_value + 10 < $r->value ? $r->my_value : $r->value);
								$totalCost[1] += $amount;
								$p->mdata['actual_delivery_cost'] = $amount;
								$p->updateMeta();
								$ss[1][$p->hbn] = $p;
							}
						} else {
							$shipment_left[1][] = $p;
						}
					}
				}
			}
			foreach ($totalCost as $k => $v) {
				if ($totalCost[$k] > 0) {
					$billing = null;
					if (!empty($billings[$k])) {
						foreach ($billings[$k] as $bill) {
							if (empty($bill->mdata['from_rec'])) {
								continue;
							}

							if ($bill->actual_amount > 0) {
								continue;
							}

							$billing = $bill;
						}
					}
					if (!empty($billing)) {
						$billing->actual_amount = number_format(round($totalCost[$k], 2), 2, '.', '');
						$billing->gst = 'INPUT';
						$billing->gst_amount = $billing->getGSTValue();
						$billing->desc = 'total shipment: ' . sizeof($ss[$k]);
						$billing->mdata['from_rec'] = 0;
						$billing->updateMeta();
						$billing->billing_cref = $invoice_no;
						$billing->date = $invoice_date;
						$billing->created = $invoice_date;
						$billing->transaction_date = $invoice_date;
						$billing->due = $invoice_date;
						if ($billing->update(['actual_amount', 'gst', 'gst_amount', 'desc', 'billing_cref', 'date', 'created', 'transaction_date', 'due'])) {
							foreach ($ss[$k] as $p) {
								if (isset($p->mdata['import_billing_id']) && $p->mdata['import_billing_id'] != $billing->id) {
									$p->mdata['import_billing_id_prev'][] = $p->mdata['import_billing_id'];
								}
								$p->mdata['import_billing_id'] = $billing->id;
								$p->updateMeta();
							}
						}
					} else {
						$billing = new BillingLine();
						$billing->mdata['from_rec'] = 0; //1 new  'from_rec' 0=>already used!
						$billing->status = 1; // initial pending status
						$billing->link_id = 0;
						$billing->org_id = $cid[$k];
						$billing->charge_code = Consol::AU_LOCAL_DELIVERY_COST_GL_CODE;
						$billing->billing_cref = $invoice_no;
						$billing->currency = 1; // AUD default
						$billing->weight = 0;
						$billing->charge_weight = 0;
						$billing->billing_ref = $this->no;
						$billing->awb = $this->awb;
						$billing->dpt_id = empty($this->dpt_id) ? Org::PCAE_DEPARTMENT_SYDNEY : $this->dpt_id;
						$billing->date = $invoice_date;
						$billing->created = $invoice_date;
						$billing->transaction_date = $invoice_date;
						$billing->due = $invoice_date;
						$billing->type = BillingLine::BILLING_TYPE_IMPORT; // for import type
						$billing->dpmt = Invoice::DPMT_IMPORT;
						$billing->actual_amount = number_format(round($totalCost[$k], 2), 2, '.', '');
						$billing->gst = 'INPUT';
						$billing->gst_amount = $billing->getGSTValue();
						$billing->desc = 'total shipment: ' . sizeof($ss[$k]);
						$billing->accrual_amount = 0;
						if ($billing->save()) {
							$theCost = 0;
							foreach ($ss[$k] as $p) {
								if (isset($p->mdata['import_billing_id']) && $p->mdata['import_billing_id'] != $billing->id) {
									$p->mdata['import_billing_id_prev'][] = $p->mdata['import_billing_id'];
								}
								$p->mdata['import_billing_id'] = $billing->id;
								$p->updateMeta();
								foreach ($p->trans as $ts) {
									if ($ts->type == 80) {
										$theCost += $ts->cost;
									}
								}
							}
							$billing->accrual_amount = number_format($theCost, 2, '.', '');
							$billing->save();
						}
					}

					// link billing and check
					Billing::linkLine($billing);

					if (sizeof($shipment_left[$k]) > 0) {
						$theCost = 0;
						foreach ($shipment_left[$k] as $shipment) {
							// get all tranships
							$tss = $shipment->trans;
							foreach ($tss as $ts) {
								if ($ts->type == 80) {
									$theCost += $ts->cost;
								}
							}
						}

						$newBilling = new BillingLine();
						$newBilling->mdata['from_rec'] = 1; //1 new  'from_rec' 0=>already used!
						$newBilling->status = 1; // initial pending status
						$newBilling->link_id = 0;
						$newBilling->org_id = $cid[$k];
						$newBilling->charge_code = Consol::AU_LOCAL_DELIVERY_COST_GL_CODE;
						$newBilling->billing_cref = $this->no;
						$newBilling->currency = 1; // AUD default
						$newBilling->weight = 0;
						$newBilling->charge_weight = 0;

						// normally billing reference will be awb no , if not set we set job ID as reference
						$newBilling->billing_ref = $this->no;
						$newBilling->awb = $this->awb;
						$newBilling->dpt_id = empty($this->dpt_id) ? Org::PCAE_DEPARTMENT_SYDNEY : $this->dpt_id;
						$newBilling->date = date('Y-m-d');
						$newBilling->created = date('Y-m-d');
						$newBilling->transaction_date = date('Y-m-d');
						$newBilling->due = date('Y-m-d');
						$newBilling->type = BillingLine::BILLING_TYPE_IMPORT; // for import type
						$newBilling->dpmt = Invoice::DPMT_IMPORT;
						$newBilling->actual_amount = 0;
						$newBilling->gst = 'INPUT';
						$newBilling->desc .= 'left shipment ' . sizeof($shipment_left[$k]);
						$newBilling->accrual_amount = number_format($theCost, 2, '.', '');
						$newBilling->save();
					}
				}
			}
			$transaction->commit();
		} catch (Exception $ex) {
			$transaction->rollback();
			throw $ex;
		}
	}
   /**
    * current just support D2Z and TNT and Hunter and ECOF and Globavend
    * @throws Exception
    */
	public function updateCourierRealCost($cid,$refReg,$declare = false, $rts = false)
	{
		$totalCost = 0;
		$shipment_left = [];
		$ss = [];
		$billings = BillingLine::model()->findAll('billing_ref = :cref AND org_id = :oid AND charge_code = :ccode order by id', [':cref' => $this->no, ':oid' => $cid, ':ccode' => self::AU_LOCAL_DELIVERY_COST_GL_CODE]);
		$transaction = Yii::app()->db->beginTransaction();
		try {
			$invoice_no = '';
			$invoice_date = '';
			foreach ($this->shipments as $p) {
				$trans = $p->trans;
				$oid = 0;
				if(!empty($trans))
				{
					$tran = end($trans);
					$oid = $tran->org_id;
				}

				if (preg_match('/'.$refReg.'/', $p->ref) || preg_match('/'.$refReg.'/', $p->hbn)||$oid==$cid) {
					if(!$declare && !$rts)
					{
						// check if this consol has billing for this parcel
						if (isset($p->mdata['import_billing_id'])) {
							// foreach ($billings as $billingline) {
							// 	if ($p->mdata['import_billing_id'] == $billingline->id) {
							// 		continue 2;
							// 	}
							// }
							$billingline = BillingLine::model()->findByPk($p->mdata['import_billing_id']);
							if (!empty($billingline) && $billingline->status != 11 && $billingline->actual_amount != 0) continue;
						}
						// if (!empty($p->mdata['import_billing_id']) && sizeof($billings) >= 1) {
						// 	continue;
						// }
						// else
						// {
							// set import_billing_id means we have account this cost to the billing before.
							$r = ReconciliationLine::model()->find(array('condition' => 'shipment_no=:ship OR shipment_no=:hbn', 'params' => array(':ship' => $p->ref, ':hbn' => $p->hbn), 'order' => 'id desc'));
							if (!empty($r)) {
								$invoice_no = $r->parent->invoice_no;
								$invoice_date = $r->parent->invoice_date;
							}
							if (isset($p->mdata['actual_delivery_cost'])) {
								$totalCost += floatval($p->mdata['actual_delivery_cost']);
								$ss[] = $p;
							} else {
								if (!empty($r)) {
									$rvalue = empty($r->mdata['total_invoice'])?$r->value:$r->mdata['total_invoice'];
									$totalCost += floatval($rvalue);
									$p->mdata['actual_delivery_cost'] = floatval($rvalue);
									$p->updateMeta();
									$ss[] = $p;
								} else {
									$shipment_left[] = $p;
								}
							}
						// }
					}

					if($declare)
					{

						if (!empty($p->mdata['declare_billing_id']) && sizeof($billings) >= 1) {
							continue;
						}else
						{
							// set import_billing_id means we have account this cost to the billing before.
							$r = ReconciliationLineDeclare::model()->find(array('condition' => 'shipment_no=:ship and client_type >=:type and client_type <=:typeMax', 'params' => array(':ship' => $p->ref,':type'=>Reconciliation::DECLARE_TYPE,':typeMax'=>Reconciliation::DECLARE_TYPE_MAX), 'order' => 'id desc'));
							if (!empty($r)) {
								$invoice_no = $r->parent->invoice_no;
								$invoice_date = $r->parent->invoice_date;
							}
							if (isset($p->mdata['under_declare_cost'])) {
								$totalCost += floatval($p->mdata['under_declare_cost']);
								$ss[] = $p;
							}
						}
					}


					if($rts)
					{

						if (!empty($p->mdata['rts_billing_id']) && sizeof($billings) >= 1) {
							continue;
						}else
						{
							// set import_billing_id means we have account this cost to the billing before.
							$r = ReconciliationLineDeclare::model()->find(array('condition' => 'shipment_no=:ship and client_type >=:type and client_type <=:typeMax', 'params' => array(':ship' => $p->ref,':type'=>Reconciliation::RTS_TYPE,':typeMax'=>Reconciliation::RTS_TYPE_MAX), 'order' => 'id desc'));
							if (!empty($r)) {
								$invoice_no = $r->parent->invoice_no;
								$invoice_date = $r->parent->invoice_date;
							}
							if (isset($p->mdata['RTS_cost'])) {
								$totalCost += floatval($p->mdata['RTS_cost']);
								$ss[] = $p;
							}
						}
					}



				}
			}
			if ($totalCost > 0) {
				$billing = null;
				if (!empty($billings)) {
					foreach ($billings as $bill) {
						if (empty($bill->mdata['from_rec'])) {
							continue;
						}

						if ($bill->actual_amount > 0) {
							continue;
						}

						$billing = $bill;
					}
				}
				if (!empty($billing)) {
					$billing->actual_amount = number_format(round($totalCost, 2), 2, '.', '');
					if ($cid == Org::ORGID_COURIER_D2Z) {
						$billing->gst = 'INPUT';
					} else if ($cid === Org::ORGID_COURIER_TNT||$cid === Org::ORGID_COURIER_HUNTER||$cid === Org::ORGID_COURIER_ECOF||$cid === ORG::ORGID_COURIER_UBI) {
						$billing->gst = 'INPUT';
					}
					$billing->gst_amount = $billing->getGSTValue();
					$billing->desc = 'total shipment: ' . sizeof($ss);
					
					if($declare)
					{
						$billing->desc .= " under declare ";
					}

					if($rts)
					{
						$billing->desc .= " RTS ";
					}

					$billing->mdata['from_rec'] = 0;
					$billing->updateMeta();
					$billing->billing_cref = $invoice_no;
					$billing->date = $invoice_date;
					$billing->created = $invoice_date;
					$billing->transaction_date = $invoice_date;
					$billing->due = $invoice_date;
					if ($billing->update(['actual_amount', 'gst', 'gst_amount', 'desc', 'billing_cref', 'date', 'created', 'transaction_date', 'due'])) {
						foreach ($ss as $p) {
							if(!$declare && !$rts)
							{
								$p->mdata['import_billing_id'] = end($billings)->id;
							}

							if($declare)
							{
								$p->mdata['declare_billing_id'] = end($billings)->id;
							}

							if($rts)
							{
								$p->mdata['rts_billing_id'] = end($billings)->id;
							}
							$p->updateMeta();
						}
					}
				} else {
					$billing = new BillingLine();
					$billing->mdata['from_rec'] = 0; //1 new  'from_rec' 0=>already used!
					$billing->status = 1; // initial pending status
					$billing->link_id = 0;
					$billing->org_id = $cid;
					$billing->charge_code = Consol::AU_LOCAL_DELIVERY_COST_GL_CODE;
					$billing->billing_cref = $invoice_no;
					$billing->currency = 1; // AUD default
					$billing->weight = 0;
					$billing->charge_weight = 0;
					$billing->billing_ref = $this->no;
					$billing->awb = $this->awb;
					$billing->dpt_id = empty($this->dpt_id) ? Org::PCAE_DEPARTMENT_SYDNEY : $this->dpt_id;
					$billing->date = $invoice_date;
					$billing->created = $invoice_date;
					$billing->transaction_date = $invoice_date;
					$billing->due = $invoice_date;
					$billing->type = BillingLine::BILLING_TYPE_IMPORT; // for import type
					$billing->dpmt = Invoice::DPMT_IMPORT;
					if ($cid == Org::ORGID_SUPPLIER_GLOBAVEND) {
						$billing->actual_amount = number_format(round($totalCost / 1.1, 2), 2, '.', '');
					} else {
						$billing->actual_amount = number_format(round($totalCost, 2), 2, '.', '');
					}
					if ($cid == Org::ORGID_COURIER_D2Z) {
						$billing->gst = 'INPUT';
					} else if ($cid === Org::ORGID_COURIER_TNT||$cid === Org::ORGID_COURIER_HUNTER||$cid === Org::ORGID_COURIER_ECOF||$cid === Org::ORGID_SUPPLIER_GLOBAVEND||$cid === Org::ORGID_COURIER_UBI) {
						$billing->gst = 'INPUT';
					}
					$billing->gst_amount = $billing->getGSTValue();
					$billing->desc = 'total shipment: ' . sizeof($ss);
					if($declare)
					{
						$billing->desc .= " under declare ";
					}

					if($rts)
					{
						$billing->desc .= " RTS ";
					}
					$billing->accrual_amount = 0;

					if ($billing->save()) {
						$theCost = 0;
						foreach ($ss as $p) {
							$p->mdata['import_billing_id'] = $billing->id;
							if(!$declare && !$rts)
							{
								$p->mdata['import_billing_id'] = $billing->id;
							}

							if($declare)
							{
								$p->mdata['declare_billing_id'] = $billing->id;
							}

							if($rts)
							{
								$p->mdata['rts_billing_id'] = $billing->id;
							}

							$p->updateMeta();
							foreach ($p->trans as $ts) {
								if ($ts->type == 80) {
									$theCost += $ts->cost;
								}
							}
						}
						$billing->accrual_amount = number_format($theCost, 2, '.', '');
						$billing->save();
					}
				}

				// link billing and check
				Billing::linkLine($billing);

				if (sizeof($shipment_left) > 0) {
					$theCost = 0;
					foreach ($shipment_left as $shipment) {
						// get all tranships
						$tss = $shipment->trans;
						foreach ($tss as $ts) {
							if ($ts->type == 80) {
								$theCost += $ts->cost;
							}
						}
					}

					$newBilling = new BillingLine();
					$newBilling->mdata['from_rec'] = 1; //1 new  'from_rec' 0=>already used!
					$newBilling->status = 1; // initial pending status
					$newBilling->link_id = 0;
					$newBilling->org_id = $cid;
					$newBilling->charge_code = Consol::AU_LOCAL_DELIVERY_COST_GL_CODE;
					$newBilling->billing_cref = $this->no;
					$newBilling->currency = 1; // AUD default
					$newBilling->weight = 0;
					$newBilling->charge_weight = 0;

					// normally billing reference will be awb no , if not set we set job ID as reference
					$newBilling->billing_ref = $this->no;
					$newBilling->awb = $this->awb;
					$newBilling->dpt_id = empty($this->dpt_id) ? Org::PCAE_DEPARTMENT_SYDNEY : $this->dpt_id;
					$newBilling->date = date('Y-m-d');
					$newBilling->created = date('Y-m-d');
					$newBilling->transaction_date = date('Y-m-d');
					$newBilling->due = date('Y-m-d');
					$newBilling->type = BillingLine::BILLING_TYPE_IMPORT; // for import type
					$newBilling->dpmt = Invoice::DPMT_IMPORT;
					$newBilling->actual_amount = 0;
					if ($cid == Org::ORGID_COURIER_D2Z) {
						$newBilling->gst = 'EXEMPTEXPENSES';
					} else if ($cid === Org::ORGID_COURIER_TNT||$cid === Org::ORGID_COURIER_HUNTER||$cid === Org::ORGID_COURIER_ECOF||$cid === Org::ORGID_COURIER_UBI) {
						$newBilling->gst = 'INPUT';
					}
					$newBilling->desc .= "left shipment " . sizeof($shipment_left);
					$newBilling->accrual_amount = number_format($theCost, 2, '.', '');
					$newBilling->save();//Gero found
				}
			}
			$transaction->commit();
		} catch (Exception $ex) {
			$transaction->rollback();
			throw $ex;
		}
	}

	public function updateTntRealCost($cid, $refReg, $rec = null)
	{
		$totalCost = 0;
		$shipment_left = [];
		$ss = [];
		$billings = BillingLine::model()->findAll('billing_ref = :cref AND org_id = :oid AND charge_code = :ccode AND status = 1 order by id', [':cref' => $this->no, ':oid' => $cid, ':ccode' => self::AU_LOCAL_DELIVERY_COST_GL_CODE]);
		$transaction = Yii::app()->db->beginTransaction();
		try {
			$invoice_no = '';
			$invoice_date = '';
			foreach ($this->shipments as $p) {
				$trans = $p->trans;
				$oid = 0;
				if(!empty($trans))
				{
					$tran = end($trans);
					$oid = $tran->org_id;
				}

				if (preg_match('/'.$refReg.'/', $p->ref) || preg_match('/'.$refReg.'/', $p->hbn)||$oid==$cid) {
					// set import_billing_id means we have account this cost to the billing before.
					if ($rec) {
						$r = ReconciliationLine::model()->find(array('condition' => '(shipment_no=:ship OR shipment_no=:hbn) AND JSON_VALUE(meta, "$.tnt_type") = "Shipment" AND parent_id = :pid', 'params' => array(':ship' => $p->ref, ':hbn' => $p->hbn, ':pid' => $rec), 'order' => 'id desc'));
					} else {
						$r = ReconciliationLine::model()->find(array('condition' => '(shipment_no=:ship OR shipment_no=:hbn) AND JSON_VALUE(meta, "$.tnt_type") = "Shipment"', 'params' => array(':ship' => $p->ref, ':hbn' => $p->hbn), 'order' => 'id desc'));
					}
					// check if this consol has billing for this parcel
					if (isset($p->mdata['import_billing_id'])) {
						$billingline = BillingLine::model()->findByPk($p->mdata['import_billing_id']);
						if (!empty($billingline) && $billingline->status != 11 && $billingline->actual_amount != 0 && $billing->billing_cref == $r->invoice_no) continue;
					}
					if (!empty($r)) {
						$invoice_no = $r->parent->invoice_no;
						$invoice_date = $r->parent->invoice_date;
					}
					/**
					 * 2020-06-16
					 * only record min(value, my_value)
					 */
					if (!empty($r)) {
						$amount = floatval($r->my_value * 1.05 < $r->value || $r->my_value + 10 < $r->value ? $r->my_value : $r->value);
						$totalCost += $amount;
						$p->mdata['actual_delivery_cost'] = $amount;
						$p->updateMeta();
						$ss[] = $p;
					} else {
						$shipment_left[] = $p;
					}
				}
			}
			if ($totalCost > 0) {
				$billing = null;
				if (!empty($billings)) {
					foreach ($billings as $bill) {
						if (empty($bill->mdata['from_rec'])) {
							continue;
						}

						if ($bill->actual_amount > 0) {
							continue;
						}

						$billing = $bill;
					}
				}
				if (!empty($billing)) {
					$billing->actual_amount = number_format(round($totalCost, 2), 2, '.', '');
					$billing->gst = 'INPUT';
					$billing->gst_amount = $billing->getGSTValue();
					$billing->desc = 'total shipment: ' . sizeof($ss);
					$billing->mdata['from_rec'] = 0;
					$billing->updateMeta();
					$billing->billing_cref = $invoice_no;
					$billing->date = $invoice_date;
					$billing->created = $invoice_date;
					$billing->transaction_date = $invoice_date;
					$billing->due = $invoice_date;
					if ($billing->update(['actual_amount', 'gst', 'gst_amount', 'desc', 'billing_cref', 'date', 'created', 'transaction_date', 'due'])) {
						foreach ($ss as $p) {
							$p->mdata['import_billing_id'] = end($billings)->id;
							$p->updateMeta();
						}
					}
				} else {
					$billing = new BillingLine();
					$billing->mdata['from_rec'] = 0; //1 new  'from_rec' 0=>already used!
					$billing->status = 1; // initial pending status
					$billing->link_id = 0;
					$billing->org_id = $cid;
					$billing->charge_code = Consol::AU_LOCAL_DELIVERY_COST_GL_CODE;
					$billing->billing_cref = $invoice_no;
					$billing->currency = 1; // AUD default
					$billing->weight = 0;
					$billing->charge_weight = 0;
					$billing->billing_ref = $this->no;
					$billing->awb = $this->awb;
					$billing->dpt_id = empty($this->dpt_id) ? Org::PCAE_DEPARTMENT_SYDNEY : $this->dpt_id;
					$billing->date = $invoice_date;
					$billing->created = $invoice_date;
					$billing->transaction_date = $invoice_date;
					$billing->due = $invoice_date;
					$billing->type = BillingLine::BILLING_TYPE_IMPORT; // for import type
					$billing->dpmt = Invoice::DPMT_IMPORT;
					$billing->actual_amount = number_format(round($totalCost, 2), 2, '.', '');
					$billing->gst = 'INPUT';
					$billing->gst_amount = $billing->getGSTValue();
					$billing->desc = 'total shipment: ' . sizeof($ss);
					$billing->accrual_amount = 0;

					if ($billing->save()) {
						$theCost = 0;
						foreach ($ss as $p) {
							$p->mdata['import_billing_id'] = $billing->id;
							$p->updateMeta();
							foreach ($p->trans as $ts) {
								if ($ts->type == 80) {
									$theCost += $ts->cost;
								}
							}
						}
						$billing->accrual_amount = number_format($theCost, 2, '.', '');
						$billing->save();
					}
				}

				// link billing and check
				Billing::linkLine($billing);

				if (sizeof($shipment_left) > 0) {
					$theCost = 0;
					foreach ($shipment_left as $shipment) {
						// get all tranships
						$tss = $shipment->trans;
						foreach ($tss as $ts) {
							if ($ts->type == 80) {
								$theCost += $ts->cost;
							}
						}
					}

					$newBilling = new BillingLine();
					$newBilling->mdata['from_rec'] = 1; //1 new  'from_rec' 0=>already used!
					$newBilling->status = 1; // initial pending status
					$newBilling->link_id = 0;
					$newBilling->org_id = $cid;
					$newBilling->charge_code = Consol::AU_LOCAL_DELIVERY_COST_GL_CODE;
					$newBilling->billing_cref = $this->no;
					$newBilling->currency = 1; // AUD default
					$newBilling->weight = 0;
					$newBilling->charge_weight = 0;

					// normally billing reference will be awb no , if not set we set job ID as reference
					$newBilling->billing_ref = $this->no;
					$newBilling->awb = $this->awb;
					$newBilling->dpt_id = empty($this->dpt_id) ? Org::PCAE_DEPARTMENT_SYDNEY : $this->dpt_id;
					$newBilling->date = date('Y-m-d');
					$newBilling->created = date('Y-m-d');
					$newBilling->transaction_date = date('Y-m-d');
					$newBilling->due = date('Y-m-d');
					$newBilling->type = BillingLine::BILLING_TYPE_IMPORT; // for import type
					$newBilling->dpmt = Invoice::DPMT_IMPORT;
					$newBilling->actual_amount = 0;
					$newBilling->gst = 'INPUT';
					$newBilling->desc = "left shipment " . sizeof($shipment_left);
					$newBilling->accrual_amount = number_format($theCost, 2, '.', '');
					$newBilling->save();//Gero found
				}
			}
			$transaction->commit();
		} catch (Exception $ex) {
			$transaction->rollback();
			throw $ex;
		}
	}

	/**
	 * update fastway real cost
	 * @throws CDbException
	 */
	public function updateFastWayRealCost($rec = null)
	{
		$totalCost = 0;
		$shipment_left = [];
		$ss = [];
		$cid = Org::ORGID_COURIER_FASTWAY;
		$billings = BillingLine::model()->findAll('billing_ref = :cref AND org_id = :oid AND charge_code = :ccode AND status = 1 order by id', [':cref' => $this->no, ':oid' => $cid, ':ccode' => self::AU_LOCAL_DELIVERY_COST_GL_CODE]);
		$transaction = Yii::app()->db->beginTransaction();
		try {
			$invoice_no = '';
			$invoice_date = '';
			foreach ($this->shipments as $p) {
				if ((isset($p->trans) && !empty($p->trans) && $p->trans[0]->org_id == Org::ORGID_COURIER_FASTWAY)) {
					// check if this consol has billing for this parcel
					if (isset($p->mdata['import_billing_id'])) {
						// foreach ($billings as $billingline) {
						// 	if ($p->mdata['import_billing_id'] == $billingline->id) {
						// 		continue 2;
						// 	}
						// }
						$billingline = BillingLine::model()->findByPk($p->mdata['import_billing_id']);
						if (!empty($billingline) && $billingline->status != 11 && $billingline->actual_amount != 0) continue;
					}

					// if parcel in this reconciliation
					if ($rec) {
						$r = ReconciliationLine::model()->find('shipment_id = :ship AND parent_id = :pid', array(':ship' => $p->id, ':pid' => $rec));
					} else {
						$r = ReconciliationLine::model()->find('shipment_id = :ship', array(':ship' => $p->id));
					}
					if (!empty($r)) {
						$invoice_no = $r->parent->invoice_no;
						$invoice_date = $r->parent->invoice_date;
					}
					// if (!empty($r)) {
					/**
					 * 2020-06-16
					 * only record min(value, my_value)
					 */
					if (!empty($r)) {
						$totalCost += floatval(min($r->value, $r->my_value));
						$p->mdata['actual_delivery_cost'] = floatval(min($r->value, $r->my_value));
						$p->updateMeta();
						$ss[] = $p;
					} else {
						$shipment_left[] = $p;
					}
				}
			}

			if ($totalCost > 0) {
				//logic we only update the last one of the billig line
				$billing = null;
				if (!empty($billings)) {
					$billing = end($billings);
					if ($billing->actual_amount > 0) {
						$billing = null;
					}
				}
				if (!empty($billing)) {
					$billing->actual_amount = number_format(round($totalCost, 2), 2, '.', '');
					$billing->gst = 'INPUT';
					$billing->gst_amount = $billing->getGSTValue();
					$billing->desc = 'total shipment: ' . sizeof($ss);
					$billing->billing_cref = $invoice_no;
					$billing->date = $invoice_date;
					$billing->created = $invoice_date;
					$billing->transaction_date = $invoice_date;
					$billing->due = $invoice_date;
					$billing->update(['actual_amount', 'gst', 'gst_amount', 'desc', 'billing_cref', 'date', 'created', 'transaction_date', 'due']);
				} else {
					$billing = new BillingLine();
					$billing->status = 1; // initial pending status
					$billing->link_id = 0;
					$billing->org_id = $cid;
					$billing->charge_code = Consol::AU_LOCAL_DELIVERY_COST_GL_CODE;
					if ($this->owner_id == 114) {
						$billing->charge_code = Consol::DELIVERY_3PL_COST_GL_CODE;
					}
					$billing->billing_cref = $invoice_no;
					$billing->currency = 1; // AUD default
					$billing->weight = 0;
					$billing->charge_weight = 0;
					$billing->billing_ref = $this->no;
					$billing->awb = $this->awb;
					$billing->dpt_id = empty($this->dpt_id) ? Org::PCAE_DEPARTMENT_SYDNEY : $this->dpt_id;
					$billing->date = $invoice_date;
					$billing->created = $invoice_date;
					$billing->transaction_date = $invoice_date;
					$billing->due = $invoice_date;
					$billing->type = BillingLine::BILLING_TYPE_IMPORT; // for import type
					$billing->dpmt = Invoice::DPMT_IMPORT;
					if ($this->owner_id == 114) {
						$billing->type = BillingLine::BILLING_TYPE_3PL;
						$billing->dpmt = Invoice::DPMT_3PL;
					}
					$billing->actual_amount = number_format(round($totalCost, 2), 2, '.', '');
					$billing->gst = 'INPUT';
					$billing->gst_amount = $billing->getGSTValue();
					$billing->desc = 'total shipment: ' . sizeof($ss);
					$billing->accrual_amount = 0;
					$billing->save();
				}

				if (empty($billing->getErrors())) {
					$theCost = 0;
					foreach ($ss as $p) {
						if (isset($p->mdata['import_billing_id']) && $p->mdata['import_billing_id'] != $billing->id) {
							$p->mdata['import_billing_id_prev'][] = $p->mdata['import_billing_id'];
						}
						$p->mdata['import_billing_id'] = $billing->id;
						$p->updateMeta();
						foreach ($p->trans as $ts) {
							if ($ts->type == 80) {
								$theCost += $ts->cost;
							}
						}
					}
					$billing->accrual_amount = number_format($theCost, 2, '.', '');
					$billing->save();
				}

				// link billing and check
				Billing::linkLine($billing);

				if (sizeof($shipment_left) > 0) {
					$theCost = 0;
					foreach ($shipment_left as $shipment) {
						// get all tranships
						$tss = $shipment->trans;
						foreach ($tss as $ts) {
							if ($ts->type == 80) {
								$theCost += $ts->cost;
							}
						}
					}
					$newBilling = new BillingLine();
					$newBilling->status = 1; // initial pending status
					$newBilling->link_id = 0;
					$newBilling->org_id = 115;
					$newBilling->charge_code = Consol::AU_LOCAL_DELIVERY_COST_GL_CODE;
					if ($this->owner_id == 114) {
						$newBilling->charge_code = Consol::DELIVERY_3PL_COST_GL_CODE;
					}
					$newBilling->billing_cref = $this->no;
					$newBilling->currency = 1; // AUD default
					$newBilling->weight = 0;
					$newBilling->charge_weight = 0;

					// normally billing reference will be awb no , if not set we set job ID as reference
					$newBilling->billing_ref = $this->no;
					$newBilling->awb = $this->awb;
					$newBilling->dpt_id = empty($this->dpt_id) ? Org::PCAE_DEPARTMENT_SYDNEY : $this->dpt_id;
					$newBilling->date = date('Y-m-d');
					$newBilling->created = date('Y-m-d');
					$newBilling->transaction_date = date('Y-m-d');
					$newBilling->due = date('Y-m-d');
					$newBilling->type = BillingLine::BILLING_TYPE_IMPORT; // for import type
					$newBilling->dpmt = Invoice::DPMT_IMPORT;
					if ($this->owner_id == 114) {
						$newBilling->type = BillingLine::BILLING_TYPE_3PL;
						$newBilling->dpmt = Invoice::DPMT_3PL;
					}
					$newBilling->actual_amount = 0;
					$newBilling->gst = 'INPUT';
					$newBilling->desc .= "left shipment " . sizeof($shipment_left);
					$newBilling->accrual_amount = number_format($theCost, 2, '.', '');
					$newBilling->save();
				}
			}
			$transaction->commit();
		} catch (Exception $ex) {
			$transaction->rollback();
			throw $ex;
		}
	}
	public function totCost($isFlash = false)
	{
		$totalCost = SystemSetting::getConsolTotCost();
		$thisTotalCost = 0;
		if(empty($totalCost[$this->no]))
		{
			$thisTotalCost = $this->_totCost();
			$totalCost[$this->no] = $thisTotalCost;
			SystemSetting::setConsolTotCost($totalCost);
		}else
		{
			$thisTotalCost = $totalCost[$this->no];
		}

		$this->totCost =$thisTotalCost;
		return $this->totCost;
	}
	/**
	 * calculate total of cost amount for client reporting
	 * @return int
	 */
	public function _totCost()
	{
		$totCost = 0;
		$tabBillings = $this->getTabBilling(true);
		foreach ($tabBillings['data'] as $key1 => $billing) {
				if($billing['currency']=='AUD')
				{
					if($billing['confirm_payable']>0)
					{
						$totCost+=floatval($billing['confirm_payable']);
					}else
					{
						$totCost+=floatval($billing['accrual']);
					}
				}else
				{
					if($billing['confirm_payable']>0)
					{
						$totCost+=BillingLine::getByCurrency(floatval($billing['confirm_payable']), array_search($billing['currency'], Invoice::$currencies));
					}else
					{
						$totCost+=BillingLine::getByCurrency(floatval($billing['accrual']), array_search($billing['currency'], Invoice::$currencies));
					}
				}
		}
		return  $totCost;
	}

	public function totAccrualCost()
	{
		$billingLines = BillingLine::model()->findAll("billing_ref = '" . $this->no . "' AND status != 11");
		$totCost = 0;
		foreach ($billingLines as $key => $r) {
			$totCost+=BillingLine::getByCurrency($r->accrual_amount,$r);
		}
		$this->totCost = $totCost;
		return $this->totCost;
	}

	public function getProfitGP()
	{
		return $this->totRevenue - $this->totCost;
	}

	public function getSeaProcessStatus()
	{
		return isset(ConsolProcess::$newSeaStates[isset($this->process->status)?$this->process->status:-1])? Yii::t(strtolower(__CLASS__), ConsolProcess::$newSeaStates[$this->process->status]) : $this->process->status;
	}

