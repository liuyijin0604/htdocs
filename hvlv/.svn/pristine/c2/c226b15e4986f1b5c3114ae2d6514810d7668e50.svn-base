	public function customsClearTime($wid = 0)
	{
		$sql = "SELECT dt from tracking tr join (SELECT id from shipment where consol_id = {$this->id} and status !=100) s on tr.pid = s.id where tr.type = 55 order by tr.dt limit 1";
		$c = Yii::app()->db->createCommand($sql);
		$dt = $c->queryScalar();
		if(empty($dt))
		{
			$sql = "SELECT dt from tracking tr join (SELECT id from shipment where consol_id = {$this->id} and status !=100) s on tr.pid = s.id where tr.type = 60 order by tr.dt limit 1";
			$c = Yii::app()->db->createCommand($sql);
			$dt = $c->queryScalar();
		}
		return $dt;
	}

	public function recoveryTime($wid = 0)
	{
		$sql = "SELECT time from log where lid in (SELECT id FROM `consol_process` where fid = {$this->id}) and meta like '%Wating for WH scan%' limit 1";
		$c = Yii::app()->db->createCommand($sql);
		return $c->queryScalar();
	}


	public function totPacksTCK($wid = 0)
	{
		$totPacksTCK = 0;
		$shipments = $this->shipments;
		foreach ($shipments as $key => $shipment) {
			$totPacksTCK+=@$shipment["mdata"]["pkgtck"]>0?$shipment["mdata"]["pkgtck"]:$shipment["pkg"];
		}
		return $totPacksTCK;
	}

