	/**
	 * @return array validation rules for model attributes.
	 */
	public function rules()
	{
		return array(
			array('dpt_id, pc_id, no, owner_id, carrier_id, type, service, awb, airline, flight, pol, pod, poc, exrate, eta, etd, created, status, bwf, meta, mdata', 'safe'),
			array('status, type, service, bwf', 'numerical', 'integerOnly' => true),
			array('dpt_id, carrier_id', 'length', 'max' => 10),
			array('no', 'length', 'max' => 30),
			array('pol, pod, poc', 'length', 'max' => 5),
			array('awb, flight', 'length', 'max' => 50),
			array('airline', 'length', 'max' => 100),
			array('eta, etd', 'default', 'setOnEmpty' => true, 'value' => null),
			// The following rule is used by search().
			// @todo Please remove those attributes that should not be searched.
			array('id, pc_id, no, owner_id, dpt_id, carrier_id,bwf,process_airport,process_airport_dead,sea_process_status,process_status,process_types,process_not_status,process_statuses,type, service, awb, airline, flight, pol, pod, poc, exrate, etd, eta, created, status, bwf, meta, owner_name, mdata, mabws,exInfo, container_no', 'safe', 'on' => 'search'),
		);
	}

	/**
	 * @return array relational rules.
	 */
	public function relations()
	{
		// NOTE: you may need to adjust the relation name and the related
		// class name for the relations automatically generated below.
		return array(
			'depot' => array(self::BELONGS_TO, 'Org', 'dpt_id'),
			'shipments' => array(self::HAS_MANY, 'Shipment', 'consol_id'),
			'owner' => array(self::BELONGS_TO, 'Org', 'owner_id'),
			'parent' => array(self::BELONGS_TO, 'Consol', 'pc_id'),
			'process' => array(self::HAS_ONE, 'ConsolProcess', 'fid'),
			'linkShipment'=>array(self::MANY_MANY,'Shipment','consol_shipment_map(cid,sid)'),
			'allShipments' => array(self::HAS_MANY, 'AllShipment', 'consol_id'),
			'shadowMap'=>array(self::HAS_MANY,'ConsolShadowMap','consol_id'),
			'shadowParentMap'=>array(self::HAS_ONE,'ConsolShadowMap','shadow_id'),
		);
	}

	public function getOwnerName($type = false,$isAll = false)
	{
		// get owner name directly
		if (!empty($this->owner_id) && isset($this->owner)) {
			if($type)
			{
				return [$this->owner_id];
			}
			return $this->owner->name;
		}

		// get owner name from shipments
		if($isAll)
		{
			$rs = AllShipment::model()->findAll(['condition' => 'consol_id = :c', 'params' => [':c' => $this->id], 'group' => 'agent_id']);
		}else
		{
			$rs = Shipment::model()->findAll(['condition' => 'consol_id = :c', 'params' => [':c' => $this->id], 'group' => 'agent_id']);
		}

		$ownerNames = array();
		$ownerIds = [];
		foreach ($rs as $shipment) {
			if (!empty($shipment->agent)) {
				$ownerNames[] = $shipment->agent->shortName(2);
				$ownerIds[] = $shipment->agent_id;
			}
		}

		if($type)
		{
			return $ownerIds;
		}

		return implode(', ', $ownerNames);
	}
	public function getAllAgentId()
	{
		// get owner name from shipments
		$rs = Shipment::model()->findAll(['condition' => 'consol_id = :c', 'params' => [':c' => $this->id], 'group' => 'agent_id']);
		$ownerIds = [];
		foreach ($rs as $shipment) {
			if (!empty($shipment->agent)) {
				$ownerIds[] = $shipment->agent_id;
			}
		}
		return $ownerIds;
	}

	public function AwbTracking($targetBlank=false)
	{
		if (empty($this->awb)) {
			return '';
		}
		
		if (AwbTracking::canTrack($this->awb)) {
			return '<a'.($targetBlank? '' : ' class="jqm_link"').' href="'.yii::app()->createURL('tracking/awb',['id'=>$this->awb]).'"'.($targetBlank? ' target="_blank"' : '').'>' . $this->awb . '</a> &#8599';
		} elseif(preg_match('/^(DHL|UPS|FEDEX)([A-Z\+, \d]+)/i', $this->awb, $m)) { // express
			$awbs = preg_replace('/[\+, ]+/', ' ', $m[2]);
			switch($m[1]){
				case 'DHL':
					$url = 'http://www.dhl.com.au/en/express/tracking.html?AWB=' . $awbs . '&brand=DHL';
				break;
				case 'UPS':
					$url = 'https://www.ups.com/track?loc=en_AU&tracknum=' . $awbs . '&requester=WT/trackdetails';
				break;
				case 'FEDEX':
					$url = 'https://www.fedex.com/apps/fedextrack/?tracknumbers=' . $awbs . '&language=en&cntry_code=au';
				break;
			}
			return '<a href="'.$url.'" target="_blank">' . $this->awb . '</a> &#8599';
		} elseif(preg_match('/^(OOLU|HDMU|EGLV|SUDU|COSU|ALAU)([A-Z\d]+)/', $this->awb, $m)) { // sea freight
			$sfc = function($c){
				$m = ['OOLU' => 'oocl','HDMU' => 'hmm21', 'EGLV' => 'evergreen', 'SUDU' => 'hamburgsudline', 'COSU' => 'cosco', 'ALAU' => 'zim'];
				return isset($m[$c])? $m[$c] : '';
			};
			return '<a href="https://wheremy.com/bill-of-lading-tracking/show-tracking-info/'.$sfc($m[1]).'/'.$this->awb.'" target="_blank">' . $this->awb . '</a> &#8599';
		}else{
			return $this->awb;
		}
	}

	public function totWeight($wid = 0,$isAll = false)
	{
		if($isAll)
		{
			$sql = 'SELECT SUM(weight) FROM all_shipment WHERE status!=100 and consol_id = ' . $this->id;
		}else
		{
			$sql = 'SELECT SUM(weight) FROM shipment WHERE status!=100 and consol_id = ' . $this->id;
		}

		if (!empty($wid)) {
			$sql .= ' AND odpt_id = ' . $wid;
		}

		$c = Yii::app()->db->createCommand($sql);
		return $c->queryScalar();
	}

	public function totWtck($wid = 0)
	{
		if($isAll)
		{
			$sql = 'SELECT SUM(if(wtck>0,wtck,weight)) from all_shipment WHERE status!=100 and consol_id = ' . $this->id;
		}else
		{
			$sql = 'SELECT SUM(if(wtck>0,wtck,weight)) from shipment WHERE status!=100 and consol_id = ' . $this->id;
		}

		if (!empty($wid)) {
			$sql .= ' AND odpt_id = ' . $wid;
		}

		$c = Yii::app()->db->createCommand($sql);
		return $c->queryScalar();
	}

	public function totPacks($wid = 0,$isAll = false)
	{
		if($isAll)
