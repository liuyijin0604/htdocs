	/**
	 * @return array validation rules for model attributes.
	 */
	public function rules(){
		// NOTE: you should only define rules for those attributes that
		// will receive user inputs.
		return array(
			array('pid, srid, dt, type, tid, activity, depot, meta', 'safe'),
			array('pid, tid, srid', 'length', 'max'=>11),
			array('depot', 'length', 'max'=>100),
			// The following rule is used by search().
			// @todo Please remove those attributes that should not be searched.
			array('id, pid, srid, dt, type, tid, activity, depot', 'safe', 'on'=>'search'),
		);
	}

	/**
	 * @return array relational rules.
	 */
	public function relations(){
		// NOTE: you may need to adjust the relation name and the related
		// class name for the relations automatically generated below.
		return array(
			'tranship' => array(self::BELONGS_TO, 'Tranship', 'tid'),
			'shipment' => array(self::BELONGS_TO, 'Shipment', 'pid'),
			'archiveShipment' => array(self::BELONGS_TO, 'ImParcelArchive', 'pid'),
		);
	}
	
	public function getInfo(){
		if(!empty($this->mdata['signature'])){
			return '<img src="data:image/png;base64,'.$this->mdata['signature'].'" width="100" />';
		}
		// get ICS returned held reasons if existing
		if(!empty($this->mdata['held_reason'])){
			return '<textarea rows="4" cols="50">' . $this->mdata['held_reason'] . '</textarea>';
		}
		return '';
	}

