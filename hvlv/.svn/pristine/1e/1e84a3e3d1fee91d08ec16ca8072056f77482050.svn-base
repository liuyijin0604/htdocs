	public function preNormalDataProvider(&$filtersForm, &$provide)
	{
		$filteredData=$filtersForm->filter($provide);
		$dataprovider=new CArrayDataProvider($filteredData);
		$dataprovider->pagination=['pageSize' => 200];
			
		return $dataprovider;
	}

	public function exportReport($report,$extraTitle=[])
	{
		$xls = new oExcel;
		$attributes = $report[2];
		$i = 1;
		foreach ($extraTitle as $key => $value) {
			$xls->addRow($i++,$value);
		}
		$keys = array_keys($attributes);
		unset($keys[0]);
		$xls->addRow($i++,$keys );
		$datas = $report[0]->data;

			foreach ($datas as $data) 
			{
				$row = [];
				foreach ($data as $key => $value) 
				{
					$row[] = $value;
				}
				unset($row[0]);
				$xls->addRow($i++, $row);
			}

		$tempfile = Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR.'fba_report.xlsx';

		$xls->output($tempfile, null, false);
		return $tempfile;
	}

	public function preDataProvider(&$filtersForm, &$provide, &$sortAttributes,&$sortNumberAttributes = false)
	{
		$filteredData=$filtersForm->filter($provide);
		$dataprovider=new CArrayDataProvider($filteredData);
		$dataprovider->pagination=['pageSize' => 200];
		$sort=new CSort();
		$sortAttr=[];
		foreach ($sortAttributes as $tempAttribute) {
			if(is_array($tempAttribute))
			{
				$sortAttr[$tempAttribute[0]]=['asc'=>$tempAttribute[0]." ASC", 'desc'=>$tempAttribute[0].' DESC'];
			}else
			{
				$sortAttr[$tempAttribute]=['asc'=>$tempAttribute." ASC", 'desc'=>$tempAttribute.' DESC'];
			}
			
		}
		$sort->attributes=$sortAttr;
		$sort->defaultOrder = "eta DESC";
		$dataprovider->sort=$sort;
			
		return $dataprovider;
	}

	private function calculateWithRate($pkg,$left_packages,$total)
	{
		if(empty($left_packages))
		{
			return $total;
		}
		return $total*($left_packages/$pkg);	
	}

	public function getImparcelsNeedAddressModefiedReport($isExport = false)
	{
		$o = new stdClass();
		$model=new ImParcel('search');
		$model->unsetAttributes();
		$model->created = ">2020-04-27";
		$model->cbwf = 16;
		if(isset($_GET['FiltersForm']['created']))
		{
			$model->created = $_GET['FiltersForm']['created'];
		}
		if(isset($_GET['ImParcel'])) {
			$model->attributes=$_GET['ImParcel'];
		}

		if(isset($_GET['ImParcel']['is_diff'])) {
			$model->is_diff=$_GET['ImParcel']['is_diff'];
		}

		if(isset($_GET['ImParcel']['editStreetCode'])) {
			$model->editStreetCode=$_GET['ImParcel']['editStreetCode'];
		}

		$ec=new CDbcriteria;
		// $ec->addCondition('(t.cbwf & 16) > 0');
		if(!$isExport)
		{
			$ec->addCondition('json_value(t.meta,"$.is_diff") is null');
		}
		$ec->addCondition('json_value(t.meta,"$.cm_address_confirm") is null');
		$result=$model->search(false, '', $ec);
		$shipments = $result->data;
		$fastwayJson= Yii::app()->cache->get('fastwayArea');
		$transaction=Yii::app()->db->beginTransaction();
		$resultData = [];
		try {
			foreach ($shipments as $key => $p) {
				$nowConsignee = $p->cnee;
				if(!empty($p->mdata['newAddress']['suggest_suburb']))
				{
					$resultObj = [];
					$resultObj['id'] = $key;
					$resultObj['p'] = $p;
					if($p->mdata['newAddress']['suggest_suburb']=="1")
					{
						$resultObj['isDiff'] = 'without suburb for suggest';
					}elseif ($p->mdata['newAddress']['suggest_suburb']=="2") 
					{
						$resultObj['isDiff'] = 'without postcode for suggest';
					}elseif ($p->mdata['newAddress']['suggest_suburb']!=$nowConsignee->suburb)
					{
						$resultObj['isDiff'] = 'yes';
					}else
					{
						$resultObj['isDiff'] = 'no';
					}
					$p->mdata['is_diff'] = $resultObj['isDiff'];
					$p->save();
					$resultData[] = $resultObj;
					continue;
				}
				$consignee = $p->cnee;
				if(empty($consignee))
				{
					$resultObj = [];
					$resultObj['id'] = $key;
					$resultObj['p'] = $p;		
					$resultObj['isDiff'] = 'without consignee';
					$p->mdata['is_diff'] = $resultObj['isDiff'];
					$p->save();
					$resultData[] = $resultObj;
					continue; 
				}
				
				$situation = 0;
				if(Postcode::validateAddress($consignee->suburb, $consignee->state, $consignee->postcode, $consignee->country))
				{
					$status = $this->checkAddressInCourier($p);
					$situation = 1;
					if($status)
					{
						$p->mdata['newAddress']['suggest_suburb'] = $consignee->suburb;
						$resultObj = [];
						$resultObj['id'] = $key;
						$resultObj['p'] = $p;	
						$resultObj['isDiff'] = 'no';
						$p->mdata['is_diff'] = $resultObj['isDiff'];
						$p->save();
						$resultData[] = $resultObj;
						continue;
					}else
					{
						$this->getNewPostcode($p,$consignee,$fastwayJson);
					}
				}else
				{
					if(!empty($p->mdata['editStreetCode'])&&($p->mdata['editStreetCode']&512)>0)
					{
						ChooseShipment::modifyAddress($consignee,$o,'Australia',"8917");
					}else
					{
						$checkType=$consignee->checkPostcode(false,true);
					}

					if($nowConsignee->suburb!=$consignee->suburb)
					{
						$status = $this->checkAddressInCourier($p);
						if($status)
						{
							$p->mdata['newAddress']['suggest_suburb']=$consignee->suburb;
						}else
						{
							$this->getNewPostcode($p,$consignee,$fastwayJson);
						}
					}else
					{
						$this->getNewPostcode($p,$consignee,$fastwayJson);
					}
				}
				$resultObj = [];
				if(!empty($p->mdata['newAddress']['suggest_suburb']))
				{		
					$resultObj['id'] = $key;
					$resultObj['p'] = $p;		
					if($p->mdata['newAddress']['suggest_suburb']=="1")
					{
						$resultObj['isDiff'] = 'without suburb for suggest';
					}elseif ($p->mdata['newAddress']['suggest_suburb']=="2") 
					{
						$resultObj['isDiff'] = 'without postcode for suggest';
					}elseif ($p->mdata['newAddress']['suggest_suburb']!=$nowConsignee->suburb)
					{
						$resultObj['isDiff'] = 'yes';
					}else
					{
						$resultObj['isDiff'] = 'no';
					}
					$resultData[] = $resultObj;
				}else
				{
					$resultObj['id'] = $key;
					$resultObj['p'] = $p;		
					$resultObj['isDiff'] = 'without suggest';
					$resultData[] = $resultObj;
				}

				$p->mdata['is_diff'] = $resultObj['isDiff'];
				$p->save();
			}
			$transaction->commit();
		} catch (Exception $ex) {
			$transaction->rollback();
			throw $ex;
		}
		if($isExport)
		{
			return $model->search(false)->data;
		}else
		{
			return $model;
		}
		
	}
	private function getNewPostcode(&$p,$consignee,$fastwayJson)
	{
		if(isset($fastwayJson[$consignee->postcode]))
		{
			$suburb = $fastwayJson[$consignee->postcode][0];
			$p->mdata['newAddress']['suggest_suburb']=$suburb;
			return true;
		}else
		{
			$auZoneMap = ZoneMap::model()->find('org_id = 101 AND zone_id = 0 AND pc_lo <= :p AND pc_hi >= :p', [':p' => $consignee->postcode]);
			if(!empty($auZoneMap))
			{
				$postcodeData = Postcode::model()->find('postcode = :postcode',[":postcode"=>$consignee->postcode]);
				if(empty($postcodeData))
				{
					$p->mdata['newAddress']['suggest_suburb']="1";
					return false;
				}else
				{
					$p->mdata['newAddress']['suggest_suburb']=$postcodeData->suburb;
					return true;
				}
			}else
			{
				$p->mdata['newAddress']['suggest_suburb']="2";//"courier don't delivery";
				return false;
			}
		}
		$p->save();
	}
	private function checkAddressInCourier($p)
	{
		$courierid = 0;
		if(preg_match('/^(AMQ|333UF|33EVH|33EVJ|33A8Y)\d{7}/', $p->ref)||preg_match('/^(33MBQ)\d{7}/', $p->ref)) {
			$courierid = Org::ORGID_COURIER_AUPOST;
		} elseif (!empty($p->mdata['etower_shipment_orderid'])) {
			$courierid = Org::ORGID_COURIER_UBI;
		}else
		{
			$courierid = Org::ORGID_COURIER_FASTWAY;
		}
		return ChooseShipment::courierCanDelivery($courierid, $p);
	}

	private function processingWeeklyReport($provide)
	{
		$result = [];
		foreach ($provide as $key => $provide) {
			$abt = $provide['amazon_booking_time'];
			$bf = $provide['booking_ref'];
			if(!empty($abt))
			{
				if(empty($result[$abt][$bf]))
				{
					$result[$abt][$bf] = [$provide];
				}else
				{
					$result[$abt][$bf][] = $provide;
				}
			}else
			{
				$result[''][''][] = $provide;
			}
		}
		$finalResult = [];
		$i = 1;
		foreach ($result as $k1 => $r1)
		{
			foreach ($r1 as $k2 => $r2)
			{
				$header =  ["id" => $i++,"ref"=>'Date:'.$k1,"pkg"=>"","totalCBM"=>"Time slot:".$k2,"amazonPos"=>"","amazonShipmentIds"=>"","pallet"=>""];
				$finalResult[] = $header;
				$finalResult[] = ["id"=>$i++,"ref"=>"Ref","pkg"=>"Package",'totalCBM'=>'Total_CBM','pallet'=>'Pallet_Count',"amazonPos"=>"Amazon_PO","amazonShipmentIds"=>"Amazon_Shipment_Id"];
				$totalPallet = 0;
				foreach ($r2 as $k3 => $r3)
				{
					$finalResult[]  =  ["id" => $i++,"ref"=>$r3['ref'],"pkg"=>$r3['pkg'],"totalCBM"=>$r3['totalCBM'],"pallet"=>$r3['pallet'],"amazonPos"=>$r3['amazonPos'],"amazonShipmentIds"=>$r3['amazonShipmentIds']];
					if(!empty($r3['pallet']))
					{
						$totalPallet += $r3['pallet'];
					}
				}
				$total = ["id" => $i++,"ref"=>'',"pkg"=>"","totalCBM"=>"Total plt","pallet"=>$totalPallet,"amazonPos"=>"","amazonShipmentIds"=>""];
				$finalResult[] = $total;

			}
		}

		return $finalResult;
	}

	public function getClientConsolReport($wid,$type,$dateFrom,$dateTo,$clientId,$consol_no)
	{
		$wid = 0;
		$filtersForm = new FiltersForm;
		$criteria = new CDbCriteria;

		$criteria->addCondition("t.eta >= '" . $dateFrom . "'");
		$criteria->addCondition("t.eta <= '" . $dateTo . "'");
		if (!empty($wid)) {
			$criteria->addCondition("t.dpt_id = '" . $wid . "'");
		}
		$criteria->with = ['shipments'];
		$criteria->addCondition("t.status < 100");
		$criteria->addCondition("t.owner_id != 114");
		$criteria->addCondition("shipments.agent_id = ".$clientId);
		if(!empty($consol_no))
		{
			$criteria->addCondition("t.no = '{$consol_no}' or t.awb = '{$consol_no}' or json_value(t.meta,'container_no') = '{$consol_no}'");
		}
		$criteria->addInCondition('t.type', [15, 70, 80]);
		$consols = Consol::model()->findAll($criteria);
		return $this->_funGetClientConsolReport($consols,$clientId);
	}

	public function _funImClientConsolReport()
	{
		$wid = 0;
		if (!empty($_GET['wid'])) {
			$wid = $_GET['wid'];
		}
		$type = isset($_GET['type']) ? $_GET['type'] : 1;
		$dateFrom = isset($_GET['datefrom']) ? $_GET['datefrom'] : '';
		$dateTo = isset($_GET['dateto']) ? $_GET['dateto'] : '';
		$clientId = isset($_GET['org_id']) ? $_GET['org_id'] : 0;
		$consol_no = isset($_GET['consol']) ? $_GET['consol'] : 0;
		return $this->getClientConsolReport($wid,$type,$dateFrom,$dateTo,$clientId,$consol_no);
	}

	public function _funGetClientConsolReport($consols,$clientId)
	{
		$provide = [];
		foreach ($consols as $key => $consol)
		{
			$ata = '';
			if($consol->mdata['ubmsent']==9)
			{
				$ata = $consol->eta;
			}
			$cc = $consol->customsClearTime();
			$customsCleared = empty($cc)?"":$cc;
			$rd = $consol->recoveryTime();
			$recoveryDate = empty($rd)?"":$rd;
			if(!empty($recoveryDate))
			{
				$hour = date("H",strtotime($recoveryDate));
				if($hour>=22||$hour<6)
				{
					$recoveryDate = date("Y-m-d",strtotime('+ 12 hours',strtotime($recoveryDate)));
				}else
				{
					$recoveryDate = date("Y-m-d",strtotime($recoveryDate));
				}
			}

			$provide[$key] = ['id'=>$consol->id,'dest'=>$consol->getDest(),'mawb'=>!empty($consol->mdata['container_no'])?$consol->mdata['container_no']:$consol->awb,'pkg'=>$consol->totPacks(),'eta'=>$consol->eta,'ata'=>$ata,'customs_cleared'=>$customsCleared,"recovery_date"=>$recoveryDate];
			if($clientId==3025||$clientId==ORG::ORGID_CLIENT_ZTO)
			{
				$hoa = $this->_funcConsolAUP($consol);
				$handOverAup = empty($hoa)?"":$hoa;
				//$hop = $this->_funcConsolPp($consol);
				//$handOverPp = empty($hop)?"":$hop;
				$provide[$key]["hand_over_aup"]=$handOverAup;
				//$provide[$key]["hand_over_pp"]=$handOverPp;
			}
		}
		$sortAttributes = ["MAWB/Container No."=>"mawb","Dest"=>"dest","Parcel Count"=>"pkg","ETA"=>"eta","ATA"=>"ata","Customs Cleared"=>"customs_cleared","Recovery Date"=>"recovery_date"];

		if($clientId==3025||$clientId==ORG::ORGID_CLIENT_ZTO)
		{
			$hoa = $this->_funcConsolAUP($consol);
			$handOverAup = empty($hoa)?"":$hoa;
			//$hop = $this->_funcConsolPp($consol);
			//$handOverPp = empty($hop)?"":$hop;
			$sortAttributes["Hand Over AUP"]="hand_over_aup";
			//$sortAttributes["Hand Over PP"]="hand_over_pp";
		}

		return [$provide,$sortAttributes,[]];
	}

	private function _funcConsolAUP($consol)
	{
		$sql = "SELECT t.gate_pass_time FROM `gatepass_shipment` t join (select id,agent_id,ref,hbn,meta from shipment where consol_id = {$consol->id}) imparcel on t.fid = imparcel.id where json_value(imparcel.meta,'$.UBI_edit_to_clear') = 1 or t.connote_no like 'F3X%' or t.connote_no like '33XHE%' or t.connote_no like '33XJM%' or t.connote_no like '33G7K%' or json_value(imparcel.meta,'$.org_id') = 101  and parent_id != 0 order by gate_pass_time limit 1";
		$c = Yii::app()->db->createCommand($sql);
		return $c->queryScalar();
	}

	private function _funcConsolPp($consol)
	{
		$sql = "SELECT t.gate_pass_time FROM `gatepass_shipment` t join (select id,agent_id,ref,hbn from shipment where consol_id = {$consol->id}) imparcel on t.fid = imparcel.id where t.courier_id = 114 and imparcel.agent_id = 3025 and hbn like '001934%'  and parent_id != 0 order by gate_pass_time limit 1";
		$c = Yii::app()->db->createCommand($sql);
		return $c->queryScalar();
	}



	public function getOrgTLDWithoutPackages($agentId)
	{
		$ps = ImParcel::model()->findAll('(ref like "SKP%" or ref like "MKP%" or ref like "BKP%" or ref like "PKP%") and agent_id = :agentId and consol_id = 0 and status <42 and (packages = "" or packages="[]" or packages="{}")',[":agentId"=>$agentId]);
		$finalData = [];
		foreach ($ps as $key => $p) {
			$finalData[] = [(empty($p->ddpt_id)?"":Org::$warehouse_list[$p->ddpt_id]),$p->hbn,$p->ref,$p->cref,$p->weight,$p->cbm*$p->pkg,$p->pkg];
		}

		return $finalData;
	}

	public function getCargoProcessDetailByCJobID($id)
	{
		$cargoprocessRelations = CargoProcessJob::model()->findByPk($id)->job_relations;
		$finalData = [];
		foreach ($cargoprocessRelations as $cargoprocessRelation){
			$cargoprocessModel = $cargoprocessRelation->cargo_process;
			$strConnote = $cargoprocessModel->shipment->hbn;
			$strDeliveryAddress = $cargoprocessModel->shipment->getCneeAddress(true);
			$strCbm = $cargoprocessModel->shipment->cbm;
			$strWeight = $cargoprocessModel->getWeight(true)."kg";
			$strDistance = $cargoprocessModel->shipment->getDeliveryDistance()."km";
			$strPkg = $cargoprocessModel->shipment->pkg;
			$strNote = $cargoprocessModel->getNote(true);
			$strDriver = $cargoprocessModel->mdata["tony_assign_driver"];
			$strName = $cargoprocessModel->shipment->cnee->name;
			$strTel = $cargoprocessModel->shipment->cnee->tel;

			$finalData[] = [$strConnote,$strDeliveryAddress,$strName,$strTel,$strCbm,$strWeight,$strDistance,$strPkg,$strNote,$strDriver];
		}
		return $finalData;
	}

	public function getCargoProcessJobRelationInvoiceDetail($week){
		$modelCargoProcessJobRelations = new CargoProcessJobRelations('search');
		$modelCargoProcessJobRelations->driverId = User::getCurrentUser()->org_id;
		$modelCargoProcessJobRelations->week = $week;
		$dataProviders = $modelCargoProcessJobRelations->search(true, 100);
		$rs = CargoProcessJobRelations::model()->findAll($dataProviders->getCriteria());
		$xls = new oExcel;
		$i = 1;
		$xls->setColWidth(array(60,50, 50, 50, 50, 50));
		$xls->addRow($i++, array('Supplier Id:',User::getCurrentUser()->org_id,'','','',''));
		$xls->addRow($i++, array(' ',' ',' ',' ',' ',' '));
		$xls->addRow($i++, array('Consignment No','Description','Freight fee','Surcharge','Surcharge fee','Gst'));
		$total=0;
		if(!empty($rs)){
			foreach($rs as $r){
				$hbn = $r->cargo_process->shipment->hbn;
				$fee = $r->getCargoCost();
				$total += $fee;
				$xls->addRow($i++, [$hbn,'',$fee,'','','']);
			}	
		}
		$xls->addRow($i++, array('SUBTOTAL','',$total,'','',''));
		$xls->addRow($i++, array('TOTAL','','','','',''));
		return $xls;
	}

	public static function getPutAwayReminder($depot_id){
		$recordPutAway['today'] = self::getSortHeldTodayReminder();
		$recordPutAway['left'] = self::getSortHeldReminder();
		//$recordPutAway = ReportCache::model()->findAll('type = 7 and status = 1',['order'=>'create_time desc'])->one();
		if(!empty($recordPutAway)){
			if($depot_id==Org::TLA_DEPARTMENT_SYDNEY){
				return [$recordPutAway['today']['SYDcount'],$recordPutAway['left']['SYDcount']];
			}elseif($depot_id==Org::TLA_DEPARTMENT_MELBOURNE){
				return [$recordPutAway['today']['MELcount'],$recordPutAway['left']['MELcount']];
			}elseif($depot_id==Org::TLA_DEPARTMENT_BRISBANE){
				return [$recordPutAway['today']['BNEcount'],$recordPutAway['left']['BNEcount']];
			}
		}
		return "";
	}

	public static function recordSortHeldReminder(){
		$recordSummary = self::getSortHeldReminder();
		$temp = json_encode($recordSummary);
		$modelReportCachePutAway = new ReportCache();
		$modelReportCachePutAway->type = ReportCache::PutAwayReminder;
		$modelReportCachePutAway->status = ReportCache::Active;
		$modelReportCachePutAway->meta = $temp;
		$modelReportCachePutAway->create_time = date('Y-m-d H:i:s');
		$modelReportCachePutAway->creater = 1;
		$modelReportCachePutAway->modify_time = date('Y-m-d H:i:s');
		$modelReportCachePutAway->modifyer = 1;
		$modelReportCachePutAway->save();
	}

	public static function getSortHeldReminder($type=0,$refreshCache = false){
		$cacheKey = "getSortHeldReminder".$type;
		$arrSummary = Yii::app()->cache->get($cacheKey);
		if(!empty($arrSummary)&&$refreshCache===false)
		{
			return json_decode($arrSummary,true);
		}

		$arrSummary = $arrSyd = $arrMel = $arrBne = [];
		$modelImparcels = ImParcel::model()->findAllBySql('select * from shipment where status <90 and status !=62 and agent_id != 3013 and scan!="" and scan!="{\"50\":[]}" and JSON_UNQUOTE(JSON_EXTRACT(meta, "$.scan_time")) >= "'.date("Y-m-d",strtotime("-30 day")).'" and (ref like "SKP%" or ref like "MKP%" or ref like "BKP%" or ref like "PICKUP%" or status=55 or ( (JSON_UNQUOTE(JSON_EXTRACT(meta,"$.cargo_delivery"))=1 or JSON_UNQUOTE(JSON_EXTRACT(meta,"$.cargo_pickup"))=1) and JSON_UNQUOTE(JSON_EXTRACT(meta, "$.scan_time"))>="2022-08-24"))');
		if(!empty($modelImparcels)){
			foreach ($modelImparcels as $modelImparcel){
				if($modelImparcel->consol->dpt_id == Org::TLA_DEPARTMENT_SYDNEY){
					if(date("Y-m-d", strtotime($modelImparcel->getScanTime())) >= date("Y-m-d",strtotime("-30 day"))){
						$tempSyd = $modelImparcel->getRackParentNumber($type);
						if(!empty($tempSyd)){
							//$arrSyd[$modelImparcel->ref] = $tempSyd;
						}else{
							$arrSyd[$modelImparcel->ref] = [];
						}
					}
				}elseif($modelImparcel->consol->dpt_id == Org::PCAE_DEPARTMENT_MELBOURNE){
					if(date("Y-m-d", strtotime($modelImparcel->getScanTime())) >= date("Y-m-d",strtotime("-30 day"))){
						$tempMel = $modelImparcel->getRackParentNumber($type);
						if(!empty($tempMel)){
							//$arrMel[$modelImparcel->ref] = $tempMel;
						}else{
							$arrMel[$modelImparcel->ref] = [];
						}
					}
				}elseif($modelImparcel->consol->dpt_id == Org::PCAE_DEPARTMENT_BRISBANE){
					if(date("Y-m-d", strtotime($modelImparcel->getScanTime())) >= date("Y-m-d",strtotime("-30 day"))){
						$tempBne = $modelImparcel->getRackParentNumber($type);
						if(!empty($tempBne)){
							//$arrBne[$modelImparcel->ref] = $tempBne;
						}else{
							$arrBne[$modelImparcel->ref] = [];
						}
					}
				}
			}
		}
		$arrSummary['SYD']=$arrSyd;
		$arrSummary['SYDcount']=count($arrSyd);
		$arrSummary['MEL']=$arrMel;
		$arrSummary['MELcount']=count($arrMel);
		$arrSummary['BNE']=$arrBne;
		$arrSummary['BNEcount']=count($arrBne);

		Yii::app()->cache->set($cacheKey,json_encode($arrSummary),3600);
		return $arrSummary;
	}

	public static function getSortHeldTodayReminder($type=0,$refreshCache = false){
		$cacheKey = "getSortHeldTodayReminder".$type;
		$arrSummary = Yii::app()->cache->get($cacheKey);
		if(!empty($arrSummary)&&$refreshCache===false)
		{
			return json_decode($arrSummary,true);
		}

		$arrSummary = $arrSyd = $arrMel = $arrBne = [];
		// $modelRack = WmsRackShipment::model()->findAllBySql('select ');
		// $modelImparcels = ImParcel::model()->findAllBySql('select * from shipment where status <90 and scan!="" and JSON_UNQUOTE(JSON_EXTRACT(meta, "$.scan_time")) like "'.date("Y-m-d").'%" and (ref like "SKP%" or ref like "MKP%" or ref like "BKP%" or ref like "PICKUP%")');
		$modelImparcels = ImParcel::model()->findAllBySql('select * from shipment where status <90 and status !=62 and agent_id != 3013  and scan!="" and scan!="{\"50\":[]}" and JSON_UNQUOTE(JSON_EXTRACT(meta, "$.scan_time")) like "'.date("Y-m-d").'%" and (ref like "SKP%" or ref like "MKP%" or ref like "BKP%" or ref like "PICKUP%" or status=55 or ( (JSON_UNQUOTE(JSON_EXTRACT(meta,"$.cargo_delivery"))=1 or JSON_UNQUOTE(JSON_EXTRACT(meta,"$.cargo_pickup"))=1) and JSON_UNQUOTE(JSON_EXTRACT(meta, "$.scan_time"))>="2022-08-24"))');
		if(!empty($modelImparcels)){
			foreach ($modelImparcels as $modelImparcel){
				if($modelImparcel->consol->dpt_id == Org::TLA_DEPARTMENT_SYDNEY){
					if(date("Y-m-d", strtotime($modelImparcel->getScanTime())) == date("Y-m-d")){
						$tempSyd = $modelImparcel->getRackParentNumber($type);
						if(!empty($tempSyd)){
							//$arrSyd[$modelImparcel->ref] = $tempSyd;
						}else{
							$arrSyd[$modelImparcel->ref] = [];
						}
					}
				}elseif($modelImparcel->consol->dpt_id == Org::PCAE_DEPARTMENT_MELBOURNE){
					if(date("Y-m-d", strtotime($modelImparcel->getScanTime())) == date("Y-m-d")){
						$tempMel = $modelImparcel->getRackParentNumber($type);
						if(!empty($tempMel)){
							//$arrMel[$modelImparcel->ref] = $tempMel;
						}else{
							$arrMel[$modelImparcel->ref] = [];
						}
					}
				}elseif($modelImparcel->consol->dpt_id == Org::PCAE_DEPARTMENT_BRISBANE){
					if(date("Y-m-d", strtotime($modelImparcel->getScanTime())) == date("Y-m-d")){
						$tempBne = $modelImparcel->getRackParentNumber($type);
						if(!empty($tempBne)){
							//$arrBne[$modelImparcel->ref] = $tempBne;
						}else{
							$arrBne[$modelImparcel->ref] = [];
						}
					}
				}
			}
		}
		$arrSummary['SYD']=$arrSyd;
		$arrSummary['SYDcount']=count($arrSyd);
		$arrSummary['MEL']=$arrMel;
		$arrSummary['MELcount']=count($arrMel);
		$arrSummary['BNE']=$arrBne;
		$arrSummary['BNEcount']=count($arrBne);

		Yii::app()->cache->set($cacheKey,json_encode($arrSummary),1800);

		return $arrSummary;
	}

	public static function getSortHeldAll($type=0,$refreshCache = false){
		$cacheKey = "getSortHeldAll".$type;
		$arrSummary = Yii::app()->cache->get($cacheKey);
		if(!empty($arrSummary)&&$refreshCache===false)
		{
			return json_decode($arrSummary,true);
		}

		$arrSummary = $arrSyd = $arrMel = $arrBne = [];
		$modelImparcels = ImParcel::model()->with('rack_record')->findAll('t.status <90 and t.status !=62 and t.agent_id != 3013 and t.scan!="" and t.scan!="{\"50\":[]}" and JSON_UNQUOTE(JSON_EXTRACT(t.meta, "$.scan_time")) >= "'.date("Y-m-d",strtotime("-30 day")).'" and (t.ref like "SKP%" or t.ref like "MKP%" or t.ref like "BKP%" or t.ref like "PICKUP%" or t.status=55 or ( (JSON_UNQUOTE(JSON_EXTRACT(meta,"$.cargo_delivery"))=1 or JSON_UNQUOTE(JSON_EXTRACT(meta,"$.cargo_pickup"))=1) and JSON_UNQUOTE(JSON_EXTRACT(meta, "$.scan_time"))>="2022-08-24") )  and rack_record.created>"'.date('Y-m-d 00:00:00').'"');
		if(!empty($modelImparcels)){
			foreach ($modelImparcels as $modelImparcel){
				if($modelImparcel->consol->dpt_id == Org::TLA_DEPARTMENT_SYDNEY){
					if(date("Y-m-d", strtotime($modelImparcel->getScanTime())) >= date("Y-m-d",strtotime("-30 day"))){
						$tempSyd = $modelImparcel->getRackParentNumber($type);
						if(!empty($tempSyd)){
							$arrSyd[$modelImparcel->ref] = [];
						}
					}
				}elseif($modelImparcel->consol->dpt_id == Org::PCAE_DEPARTMENT_MELBOURNE){
					if(date("Y-m-d", strtotime($modelImparcel->getScanTime())) >= date("Y-m-d",strtotime("-30 day"))){
						if(!empty($tempMel)){
							$arrMel[$modelImparcel->ref] = [];
						}
					}
				}elseif($modelImparcel->consol->dpt_id == Org::PCAE_DEPARTMENT_BRISBANE){
					if(date("Y-m-d", strtotime($modelImparcel->getScanTime())) >= date("Y-m-d",strtotime("-30 day"))){
						$tempBne = $modelImparcel->getRackParentNumber($type);
						if(!empty($tempBne)){
							$arrBne[$modelImparcel->ref] = [];
						}
					}
				}
			}
		}
		$arrSummary['SYD']=$arrSyd;
		$arrSummary['SYDcount']=count($arrSyd);
		$arrSummary['MEL']=$arrMel;
		$arrSummary['MELcount']=count($arrMel);
		$arrSummary['BNE']=$arrBne;
		$arrSummary['BNEcount']=count($arrBne);

		Yii::app()->cache->set($cacheKey,json_encode($arrSummary),1800);
		return $arrSummary;
	}

	public static function getSeasonProfit($refresh = false)
	{
		Yii::app()->name="TLA";
		$cache = Service::getCacheData('SeasonProfit230205');
		if(!isset($cache)||$refresh){
			$sql = 'SELECT * FROM invoice WHERE `date` >= "2023-02-01" AND `date` <= "2023-05-31" AND `status` != 10';
			$invoices = Invoice::model()->findAllBySql($sql);
			$income = 0.00;
			foreach($invoices as $invoice){
				$income += $invoice->total - $invoice->gst;
			}
			$sql = 'SELECT * FROM payment WHERE `date` >= "2023-02-01" AND `date` <= "2023-05-31" AND `type` = 5 AND "status" != 9';
			$payments = Payment::model()->findAllBySql($sql);
			$creditNote = 0.00;
			foreach($payments as $payment){
				$creditNote += $payment->amount;
			}
			$profit = $income - $creditNote;
			Service::setCacheData('SeasonProfit230205', '{"profit":"' . $profit . '"}', 86400);
			$cache = Service::getCacheData('SeasonProfit230205');
			return $cache;
		} else {
			return $cache;
		}
	}
}
?>