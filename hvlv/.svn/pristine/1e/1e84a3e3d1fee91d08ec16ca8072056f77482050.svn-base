<?php 
class ReportService extends Service
{

		//for zone report
	public function getWeightDataForDash($courierId,$filtersForm)
	{
		$pt = ['',date("Y-m-01"),date("Y-m-d"),10,'','',$courierId,''];
		$lastMonth = date("Y-m", strtotime("-1 month",strtotime(date("Y-m-d"))));
		$lastMonthWorkingDay = date("Y-m-d",strtotime("-1 month",strtotime(date("Y-m-d"))));
		$pt[4] = 'we';
		$pt[8] = 2;
		$provide = $this->_plWeightQuery($pt, '', 'weight', 'rev DESC');
		$sortAttributes = ["Weight_Step"=>"Weight_Step","Shipments"=>"shipments","Total Weight(KG)"=>"weight","Dispersion_Percentage"=>"Dispersion_Percentage"];

		$dataprovider= $this->preDataProvider($filtersForm, $provide, $sortAttributes);
		return [$dataprovider,$sortAttributes];
	}



	//for zone report
	public function getZoneDataForDash($courierId,$filtersForm1)
	{
		$pt = ['',date("Y-m-01"),date("Y-m-d"),10,'','',$courierId,''];
		$lastMonth = date("Y-m", strtotime("-1 month",strtotime(date("Y-m-d"))));
		$lastMonthWorkingDay = date("Y-m-d",strtotime("-1 month",strtotime(date("Y-m-d"))));
		$pt[4] = 'zo';
		$provideThisMonth = $this->_plWeightQuery($pt, '', 'zone', 'zone DESC');
		$pt[1] = $lastMonth."-01";
		$pt[2] = $lastMonthWorkingDay;
		$provideLastMonth = $this->_plWeightQuery($pt, '', 'zone', 'zone DESC');

		$categoryProvideThisMonth = [];
		$categoryProvideThisMonth = $this->sumZoneData($provideThisMonth,1);
		$categoryProvideLastMonth = [];
		$categoryProvideLastMonth = $this->sumZoneData($provideLastMonth,1);
		$categoryProvide = [];
		$sum = [];
		foreach ($categoryProvideThisMonth as $key => $value) {
			$categoryProvideThisMonth[$key]['category'] = 'This month-'.$categoryProvideThisMonth[$key]['category'];
			$categoryProvideLastMonth[$key]['category'] = 'Last month-'.$categoryProvideLastMonth[$key]['category'];
			$categoryProvide[] = $categoryProvideLastMonth[$key];
			$categoryProvide[] = $categoryProvideThisMonth[$key];
			$categoryProvide[] = ['category'=>'This month vs Last Month','shipments'=>round($categoryProvideThisMonth[$key]['shipments']*100/($categoryProvideLastMonth[$key]['shipments']+0.00001),0)."%",
			'weight'=>round($categoryProvideThisMonth[$key]['weight']*100/($categoryProvideLastMonth[$key]['weight']+0.00001),0)."%",
			'Dispersion_Percentage'=>round($categoryProvideThisMonth[$key]['Dispersion_Percentage']*100/($categoryProvideLastMonth[$key]['Dispersion_Percentage']+0.00001),0)."%"];
			$categoryProvide[] = ['category'=>'','shipments'=>"",'weight'=>"",'Dispersion_Percentage'=>100];
		}


		$sortAttributes1 = ["Category"=>"category","Shipments"=>"shipments","Total Weight(KG)"=>"weight","Dispersion_Percentage"=>"Dispersion_Percentage"];

		$dataprovider1= $this->preDataProvider($filtersForm1, $categoryProvide, $sortAttributes1);
		return [null,$dataprovider1,null,$sortAttributes1];
	}

	private function sumZoneData($provide,$type = 0)
	{
		$categories = SystemSetting::getAupostZoneCategorySetting();
		$categoryProvide = [];
		$categoryResult = [];
		$categoryProvideId = 0;
		$cate="123";
		$totalShipment = 0;
		$totalWeight = 0;
		foreach ($provide as $key => $data) {//fitting all the data into categories
			if(!isset($categories[$data['Zone']])) continue;
			$cate = $categories[$data['Zone']];
			if(!empty($categoryResult[$cate]))
			{
				$categoryResult[$cate]["Dispersion_Percentage"] += $data['Dispersion_Percentage'];
				$categoryResult[$cate]["shipments"] += $data['shipments'];
				$categoryResult[$cate]["weight"] += $data['weight'];
			}else
			{
				$categoryResult[$cate] =  ["id"=>$categoryProvideId,"category"=>$cate,"Dispersion_Percentage"=>$data['Dispersion_Percentage'],"shipments"=>$data['shipments'],"weight"=>$data['weight']];
				$categoryProvideId++;
			}
			$totalShipment+=$data['shipments'];
			$totalWeight+=$data['weight'];
		}

		foreach ($categoryResult as $key => $value) {
			$value["Dispersion_Percentage"] = $value["Dispersion_Percentage"]."%";
			$categoryProvide[$value['id']] = $value;
		}
		if($type!=1)
		{
			$categoryProvide[] = ["id"=>999,"category"=>"Total","Dispersion_Percentage"=>"","shipments"=>$totalShipment,"weight"=>$totalWeight];
		}
		return $categoryProvide;
	}


	//for zone report
	public function getZoneData($pt,&$filtersForm,&$filtersForm1)
	{
		$pt[4] = 'zo';
		$provide = $this->_plWeightQuery($pt, '', 'zone');
		$sortAttributes = ["Zone"=>"Zone","Shipments"=>"shipments","Total Weight"=>"weight","Dispersion_Percentage"=>"Dispersion_Percentage"];
		$sortNumberAttributes = ["Total Weight"=>"weight"];
		$categoryProvide = $this->sumZoneData($provide);

		$sortAttributes1 = ["Category"=>"category","Shipments"=>"shipments","Total Weight(KG)"=>"weight","Dispersion_Percentage"=>"Dispersion_Percentage"];
		$sortNumberAttributes1 = ["Total Weight(KG)"=>"weight"];

		$dataprovider= $this->preDataProvider($filtersForm, $provide, $sortAttributes,$sortNumberAttributes);
		$dataprovider1= $this->preDataProvider($filtersForm1, $categoryProvide, $sortAttributes1,$sortNumberAttributes1);
		return [$dataprovider,$dataprovider1,$sortAttributes,$sortAttributes1];
	}
	//for zone and weight report
	public function _plWeightQuery($pt, $c = '', $g = '', $o = false)
	{
		$cacheKey = "_plWeightQuery".json_encode($pt);
		$provide = Yii::app()->cache->get($cacheKey);
		if(!empty($provide))
		{
			return json_decode($provide,true);
		}

		$dptStr = " AND p.dpt_id = ".$pt[0];
		$dpmtStr = "";
		if(empty($pt[0]))
		{
			$dptStr = "";
		}
		if (!empty($pt[3])) {
			$dpmtStr = ' AND p.dpmt = '.$pt[3].' ';
		}

		$clientStr ="";
		$courierStr = "";
		$consolStr = ' AND c.no not like "3PL%" ';

		if (!empty($pt[5])) {
			$clientStr = ' AND p.org_id = '.$pt[5].' ';
		}

		if (!empty($pt[6])) {
			$courierStr = ' AND p.grp2 = '.$pt[6].' ';
		}

		$end = 23;
		if (!empty($pt[8])) {
			$end = $pt[8];
		}

		if (!empty($pt[7])) {
			$consol = ImcoConsol::model()->find(" no = :no ",[":no"=>$pt[7]]);
			$consol_id = empty($consol)?9999999999:$consol->id;
			$consolStr .= ' AND p.grp1 = '.$consol_id.' ';
		}

		$sql = "SELECT p.* from pl_ledger p join consol c on p.grp1=c.id join mani_map ma on ma.fid = p.fid and ma.model='ImParcel' join manifest m on m.id = ma.mani_id and m.type=90  where p.gl = 101 and p.model='ImP_Manifest' ".$dptStr.$dpmtStr.$clientStr.$courierStr.$consolStr." AND m.created >= '".$pt[1]." 00:00:00' AND m.created <= '".$pt[2]." 23:00:00' AND weight >0 group by p.fid ";

		$sqlAll = "SELECT sum(weight) as sumAll from (select p.* from pl_ledger p join consol c on p.grp1=c.id join mani_map ma on ma.fid = p.fid and ma.model='ImParcel' join manifest m on m.id = ma.mani_id and m.type=90 where p.gl = 101 and p.model='ImP_Manifest' ".$dptStr.$dpmtStr.$clientStr.$courierStr.$consolStr." AND m.created >= '".$pt[1]." 00:00:00' AND m.created <= '".$pt[2]." 23:00:00' group by p.fid ) as t";
		
		$all = Yii::app()->db->createCommand($sqlAll)->queryAll();
		$all = $all[0]['sumAll'];
		$all = empty($all)?100:$all;
		$provice = [];
		$data = [];

		if($g=="zone")
		{
			if(empty($o))
			{
				$o = 'Dispersion_Percentage desc';
			}
			$sql = " SELECT zone as Zone,concat(round(sum(weight)*100/{$all},2),'%') as Dispersion_Percentage,count(1) as shipments,sum(weight) as weight from ( {$sql} ) as t GROUP by zone order by {$o} ";
		}

		if($g=="weight")
		{
			$concatStr = "";
			$i = 0;
			$round = 0;
			while($i<=$end) { 
				if($i ==0)
				{
					$provide[]=["Weight_Step"=>"Up to 250g","Dispersion_Percentage"=>0,"shipments"=>0,"weight"=>0];
				}
				if($i ==0.25)
				{
					$provide[]=["Weight_Step"=>"250g to 500g","Dispersion_Percentage"=>0,"shipments"=>0,"weight"=>0];
				}
				if($i ==0.5)
				{
					$provide[]=["Weight_Step"=>"0.51kg to 1kg","Dispersion_Percentage"=>0,"shipments"=>0,"weight"=>0];
				}
				if($i ==23)
				{
					$provide[]=["Weight_Step"=>">22kg","Dispersion_Percentage"=>0,"shipments"=>0,"weight"=>0];
				}
				
				if($i !=23)
				{
					$checkWeight = $i;
					if($i ==0||$i==0.25)
					{
						$checkWeight = $i+0.25;
					}
					else if($i==0.5)
					{
						$checkWeight = $i+0.5;
					}else
					{
						$checkWeight = $i+1;
					}

					$concatStr .=' concat(round(SUM(IF(weight > '.$i.' and weight<='.$checkWeight.', weight, 0) )/SUM(weight)*100,2),"%") AS weight'.$round.", ";

					$concatStr .=' SUM(IF(weight > '.$i.' and weight<='.$checkWeight.', weight, 0) ) AS total_weight'.$round.", ";
					$concatStr .=' SUM(IF(weight > '.$i.' and weight<='.$checkWeight.', 1, 0) ) AS shipments'.$round;
					if($i<$end)
					{
						$concatStr .=" , ";
					}
				}

				if($i != 0&&$i!=23&&$i !=0.5&&$i !=0.25)
				{
					$provide[]=["Weight_Step"=>($i+0.01)."kg to ".(($i+1)."kg"),"Dispersion_Percentage"=>0];
				}

				if($i==23)
				{
					$concatStr .=' concat(round(SUM(IF(weight > '.$i.' , weight, 0) )/SUM(weight)*100,2),"%") AS weight'.$round.", ";
					$concatStr .=' SUM(IF(weight > '.$i.' , weight, 0) ) AS total_weight'.$round.", ";
					$concatStr .=' SUM(IF(weight > '.$i.' , 1, 0) ) AS shipments'.$round;
				}
				if($i ==0||$i==0.25)
				{
					$i+=0.25;
				}else if($i==0.5)
				{
					$i+=0.5;
				}else
				{
					$i+=1;
				}
				$round++;
				
			}
			$sql = "SELECT {$concatStr} from ( {$sql} ) as t ";
			$data = Yii::app()->db->createCommand($sql)->queryAll();
		}

		if($g=="zone")
		{
			$provide = Yii::app()->db->createCommand($sql)->queryAll();
			Yii::app()->cache->set($cacheKey,json_encode($provide),3000);
			return $provide;
		}

		if($g=="weight")
		{
			foreach ($provide as $key => $value) {
				$provide[$key]['id'] = $key;
				$provide[$key]['Dispersion_Percentage'] = $data[0]['weight'.$key];
				$provide[$key]['weight'] = $data[0]['total_weight'.$key];
				$provide[$key]['shipments'] = $data[0]['shipments'.$key];
			}
			Yii::app()->cache->set($cacheKey,json_encode($provide),3000);
			return $provide;
		}
	}

	//Gero at 2019-08-12; move at 2019-12-11
	
	/**
	 * Sort WD By Consols,Client,Courier
	 * @param array $consols,$type
	 * @return array of data provide
	 */
	public function sortWD($consols,$type = 0,$selectedClientType=null)
	{
		$provide=[];
		$consolIdArr = array_column($consols, 'id');
		$consolIdStr = join($consolIdArr,",");
		$courierWeight = 0;
		$clientChargeWeight = 0;
		$weightDiff = 0;
		if($type == 1)//sort by consol
		{
			$criteria = new CDbCriteria();
			$criteria->addInCondition('t.consol_id',$consolIdArr);
			if(!empty($selectedClientType))
			{
				$criteria->addCondition(" parent.client_type = {$selectedClientType}");
			}
			$reconciliationLines = ReconciliationLine::model()->with('parent')->findAll($criteria);
			if (!empty($reconciliationLines)) 
			{
				$trans = Yii::app()->db->beginTransaction();
				try
				{
					foreach ($consols as $key => $con) 
					{
						$exist = false;
						$courierWeight = 0;
						$clientChargeWeight = 0;
						$weightDiff = 0;
						foreach ($reconciliationLines as $reconciliationLine) 
						{
							if($reconciliationLine->consol_id == $con->id)
							{
								$exist = true;
								$thisCourierWeight=$reconciliationLine->getCdeadwtOrWeight();
								$thisClientChargeWeight=$reconciliationLine->getCustomerWeight();
								if($thisCourierWeight>0&&$thisClientChargeWeight>0)
								{
									$courierWeight+=$thisCourierWeight;
									$clientChargeWeight+=$thisClientChargeWeight;
								}
							}
						}
						$weightDiff=$courierWeight-$clientChargeWeight;
						if($exist&&$courierWeight!=0&&$clientChargeWeight!=0)
						{
							$provide[] = ['id' => $con->id,'no' => $con->no, 'eta' => $con->eta,
								'courierWeight' => number_format($courierWeight, 2),'customerChargeWeight' => number_format($clientChargeWeight, 2),
								'weightDiff' => number_format($weightDiff, 2),'weightDiffRate'=>number_format(($weightDiff/$courierWeight)*100)."%",'type'=>$con->type];
						}
					}
					$trans->commit();
				} catch (Exception $ex) 
				{
					$trans->rollback();
					throw $ex;
				}
			}
		}else if ($type == 2)// sort by client
		{
			$sql="select s.agent_id,t.id,t.parent_id,c.no from reconciliation re join reconciliation_line t on re.id = t.parent_id join shipment s on s.ref = t.shipment_no join consol c on s.consol_id = c.id where t.consol_id in ({$consolIdStr}) ";
			if(!empty($selectedClientType))
			{
				$sql.=" and re.client_type = {$selectedClientType}";
			}


			$agentReconArr=Yii::app()->db->createCommand($sql)->queryAll();
			$agentIds = array_column($agentReconArr, 'agent_id');
			$agentIds = array_unique($agentIds);
			if (!empty($agentIds)) 
			{
				$trans = Yii::app()->db->beginTransaction();
				try
				{
					foreach ($agentIds as $agentId) 
					{
						$agent = Org::model()->findByPk($agentId);
						$courierWeight = 0;
						$clientChargeWeight = 0;
						$weightDiff = 0;
						foreach ($agentReconArr as $key => $agentRecon) 
						{
							if($agentRecon["agent_id"] == $agentId)
							{
								//echo $agentRecon['id'].",";
								$reconciliationLine = ReconciliationLine::model()->find("id = :id and parent_id = :parent_id",["id"=>$agentRecon['id'],"parent_id"=>$agentRecon['parent_id']]);
								// $courierWeight+=$reconciliationLine->getWeight();
								// $clientChargeWeight+=$reconciliationLine->getCSChargeWeight();
								// $weightDiff+=$reconciliationLine->getChargeWeightDiff();
								$thisCourierWeight=$reconciliationLine->getCdeadwtOrWeight();
								$thisClientChargeWeight=$reconciliationLine->getCustomerWeight();
								if($thisCourierWeight>0&&$thisClientChargeWeight>0)
								{
									$courierWeight+=$thisCourierWeight;
									$clientChargeWeight+=$thisClientChargeWeight;
								}
							}
						}
						$weightDiff=$courierWeight-$clientChargeWeight;
						if($courierWeight!=0&&$courierWeight!=0&&$clientChargeWeight!=0)
						{
							$provide[] = ['id'=>$agent->id,'owner' => $agent->name,'courierWeight' => number_format($courierWeight, 2), 
							'customerChargeWeight' => number_format($clientChargeWeight, 2),'weightDiff' => number_format($weightDiff, 2),'weightDiffRate'=>number_format(($weightDiff/$courierWeight)*100)."%"];
						}
						//echo "</br>";
					}
					$trans->commit();
				} catch (Exception $ex) 
				{
					$trans->rollback();
					throw $ex;
				}
			}
		}else if ($type == 3)
		{
			$sql="select re.client_type,t.id,t.parent_id from reconciliation_line t join reconciliation re on re.id = t.parent_id where t.consol_id in ({$consolIdStr}) ";

			if(!empty($selectedClientType))
			{
				$sql.=" and re.client_type = {$selectedClientType}";
			}
			$clientReconArr=Yii::app()->db->createCommand($sql)->queryAll();
			$clientTypes = array_column($clientReconArr, 'client_type');
			$clientTypes = array_unique($clientTypes);
			if (!empty($clientTypes)) 
			{
				$trans = Yii::app()->db->beginTransaction();
				try
				{
					foreach ($clientTypes as $clientType) 
					{
						$clientTypeName = Reconciliation::$types[$clientType];
						$courierWeight = 0;
						$clientChargeWeight = 0;
						$weightDiff = 0;
						foreach ($clientReconArr as $key => $clientRecon) 
						{
							if($clientRecon["client_type"] == $clientType)
							{
								$reconciliationLine = ReconciliationLine::model()->find("id = :id and parent_id = :parent_id",["id"=>$clientRecon['id'],"parent_id"=>$clientRecon['parent_id']]);
								// $courierWeight+=$reconciliationLine->getWeight();
								// $clientChargeWeight+=$reconciliationLine->getCSChargeWeight();
								// $weightDiff+=$reconciliationLine->getChargeWeightDiff();
								$thisCourierWeight=$reconciliationLine->getCdeadwtOrWeight();
								$thisClientChargeWeight=$reconciliationLine->getCustomerWeight();
								if($thisCourierWeight>0&&$thisClientChargeWeight>0)
								{
									$courierWeight+=$thisCourierWeight;
									$clientChargeWeight+=$thisClientChargeWeight;
								}
							}
						}
						$weightDiff=$courierWeight-$clientChargeWeight;
						
						if($courierWeight!=0&&$courierWeight!=0&&$clientChargeWeight!=0)
						{
							$provide[] = ['id'=>$clientType,'courier' => $clientTypeName,'courierWeight' => number_format($courierWeight, 2), 
							'customerChargeWeight' => number_format($clientChargeWeight, 2),'weightDiff' => number_format($weightDiff, 2),'weightDiffRate'=>number_format(($weightDiff/$courierWeight)*100)."%"];
						}
					}
					$trans->commit();
				} catch (Exception $ex) 
				{
					$trans->rollback();
					throw $ex;
				}
			}
		}

		return $provide;
	}
	public function getFbaReport($ddptId,$type,$datefrom,$dateto,$filtersForm,$export=false,$swid)
	{
		if($ddptId==Org::TLA_DEPARTMENT_PERTH)
		{
			$provide1 = $this->getFbaReportProvide(Org::TLA_DEPARTMENT_PERTH,$type,$datefrom,$dateto,$filtersForm,$export,$swid);
			$provide2 = $this->getFbaReportProvide(Org::TLA_DEPARTMENT_FREMANTLE,$type,$datefrom,$dateto,$filtersForm,$export,$swid);
			$provide = $provide1+$provide2;
		}else
		{
			$provide = $this->getFbaReportProvide($ddptId,$type,$datefrom,$dateto,$filtersForm,$export,$swid);
		}
		$dataProvider =  $this->preNormalDataProvider($filtersForm, $provide);
		if($type ==1)
		{
			$attributes = ["Id"=>"id","Est. Delivery Date"=>"eta","Amazon Booking Time"=>"abt","TLA HBN No"=>"hbnsOnly","TLA HBN No. + Customs Status"=>"hbns","TLA Ref No. + Customs Status"=>"refs","Amazon PO"=>"amazonPos","Amazon Shipment Id"=>"amazonShipmentIds",'Total CBM'=>'totalCBM','Pallet'=>'pallet','Ctn'=>'pkg','Unit'=>'pls'];
		}else if($type == 2)
		{
			$attributes = ["Id"=>"id","Amazon Booking Time"=>"eta","TLA HBN No"=>"hbnsOnly","TLA HBN No. + Customs Status"=>"hbns","TLA Ref No. + Customs Status"=>"refs","Amazon PO"=>"amazonPos","Amazon Shipment Id"=>"amazonShipmentIds",'Total CBM'=>'totalCBM','Pallet'=>'pallet','Ctn'=>'pkg','Unit'=>'pls'];
		}else if($type == 3)
		{
			$attributes = ["Id"=>"id","Eta"=>"eta","TLA HBN No"=>"hbnsOnly","TLA HBN No. + Customs Status"=>"hbns","TLA Ref No. + Customs Status"=>"refs","Amazon PO"=>"amazonPos","Amazon Shipment Id"=>"amazonShipmentIds",'Total CBM'=>'totalCBM','Pallet'=>'pallet','Ctn'=>'pkg','Unit'=>'pls'];
		}else if($type == 4)
		{
			$attributes = ["Id"=>"id","Ref"=>"ref","Package"=>"pkg",'Total CBM'=>'totalCBM','Pallet count'=>'pallet',"Amazon PO"=>"amazonPos","Amazon Shipment Id"=>"amazonShipmentIds"];
		}
		return [$dataProvider,$filtersForm,$attributes];
	}
	public function getFbaReportProvide($ddptId,$type,$datefrom,$dateto,$filtersForm,$export=false,$swid)
	{
		// $airDate = HolidayHelper::getDateByBusinessDays($ddptId,$dateto,2,false);
		// echo $airDate;
		// $seaDate = HolidayHelper::getDateByBusinessDays($ddptId,$dateto,7,1);
		$palletRate = 1;
		if(strtotime($dateto)<strtotime($datefrom)&&$type == 1)
		{
			$dataTemp = $dateto;
			$dateto = $datefrom;
			$datefrom = $dataTemp;
		}
		if($export)
		{
			$symbol = ',';
		}else
		{
			$symbol = "</br>";
		}
		// if(strtotime($airDate)<strtotime($datefrom))
		// {
		// 	$dateto1 = $datefrom;
		// 	$datefrom1 = $airDate;
		// }else
		// {
		// 	$dateto1 =$dateto;
		// 	$datefrom1 =$datefrom;
		// }

		// if(strtotime($seaDate)<strtotime($datefrom))
		// {
		// 	$dateto2 = $datefrom;
		// 	$datefrom2 = $seaDate;
		// }else
		// {
		// 	$dateto2 =$dateto;
		// 	$datefrom2 =$datefrom;
		// }
		if($ddptId !=null)
		{
			$pod = SystemSetting::getCargoProcessPodSetting($ddptId);
			$state = @$pod["postcode"];
			$selectStateStr = "postcode like ";
			$subWidStr = "";
			$subWidStr2 = "";
			$sql ="";
			if(empty($state))
			{
				$state = @$pod["state"];
				$selectStateStr = "state = ";
			}

			$state = "'".$state."'";
			$checkSuburb = "";
			$checkPostcode ="";
			$equals = true;
			if(!empty($swid))
			{
				switch ($ddptId) {
					case Org::TLA_DEPARTMENT_MELBOURNE:
						$checkSuburb = "RAVENHALL";
						$checkPostcode = "3023";
						$equals = true;
						if($swid=='218-1')
						{
							$subWidStr .= ' and ( cnee.suburb!="'.$checkSuburb.'" and cnee.postcode!="'.$checkPostcode.'" ) ';
