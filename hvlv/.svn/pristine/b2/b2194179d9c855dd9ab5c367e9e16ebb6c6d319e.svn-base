	/**
	 *
	 */
	public function actionAjaxAddConsoleShipments(){

		$resp = array('success' => 1,'msg' => '');

		$shipments = $_POST['shipments'];
		$consolNo = $_POST['consolno'];
		$shipments = explode(';',$shipments);

		// in case all data validation
		if ( !empty($shipments) && !empty($consolNo) ) {
			$console = Consol::model()->find('no = :no',[':no' => $consolNo]);
			if ( !empty($console) ) {
				$transaction = Yii::app()->db->beginTransaction();
				try {
					foreach ( $shipments as $shipment ) {
						if(empty(trim($shipment))) continue;
						$cmodel = Shipment::model()->find('hbn = :hbn and consol_id = :consolId',[':hbn' => $shipment,'consolId'=>$console->id]);
						if(!empty($cmodel))
						{
							$resp['msg'] .= $shipment . ' is existing in this consol';
							continue;
						}

						$smodel = Shipment::model()->find('hbn = :hbn and consol_id = 0',[':hbn' => $shipment] );
						if(empty($smodel))    $smodel = Shipment::model()->find('ref = :ref AND agent_id != 1656 and consol_id = 0',[':ref' => $shipment]);

						if(empty($smodel))
						{
							$smodel = Shipment::model()->find('hbn = :hbn order by id desc',[':hbn' => $shipment] );
							if(empty($smodel))    $smodel = Shipment::model()->find('ref = :ref AND agent_id != 1656 order by id desc',[':ref' => $shipment]);
						}

						if ( !empty($smodel) ) {
							// if($smodel->agent->overCreditLimit()){
							// 	$resp['msg'] .= $shipment.' - Client over credit limit, please contact accounts';
							// 	continue;
							// }
							$smodel->consol_id = $console->id;
							$smodel->scan_no=$smodel->pkg-(empty($smodel->scan_data[50])?0:sizeof($smodel->scan_data[50]));
							$smodel->update(['consol_id','scan_no']);
						} else {
							$resp['msg'] .= $shipment . ' is not existing';
						}
					}
					$transaction->commit();
				} catch (Exception $ex) {
					$transaction->rollback();
					throw $ex;
				}
			} else {
				$resp['msg'] = 'consol No. is not existing!';
			}
		} else {
			$resp['msg'] = 'consol No. or shipments are empty!';
		}

		if ( empty($resp['msg']) ) {
			$resp['msg'] = 'shipments added succussfully!';
		}
		echo json_encode($resp);

	}
	
	public function actionCheckShipments(){
	   $resp=array('success'=>1,'msg'=>'');
	   if(!empty($_POST['shipment'])){
		 $shipments = explode(';',trim($_POST['shipment']));
		 if(!empty($shipments)){
			 foreach($shipments as $s){
				 $p=ImParcel::model()->find('ref=:hbn or hbn=:hbn AND cbwf&'.ImParcel::CBWF_DIRECT_CONSOL_BASE.'=0',array(':hbn'=>$s));
				 if(!empty($p->consol_id)){
					 $resp['success']=0;
					 $resp['msg'].=$s.';';
				 }
				 
			 }
		  }
	   }
	   echo json_encode($resp);
		
	}

	/**
	 * select courier by postcode & weight batch
	 */
	public function actionAjaxCourierBatchCheck(){
		$resp = array('success' => 1,'msg' => 'Done');
		$postw_file = empty($_FILES['postw_batch']) ? array() : $_FILES['postw_batch'];
		if ( empty($postw_file['tmp_name']) || !is_uploaded_file( $postw_file['tmp_name'] ) ) {
			$resp['msg'] = 'Invalid template file';
			echo json_encode($resp);
			return;
		} else {
			$xls = new oExcel;
			$xls->load($postw_file['tmp_name']);
			$data = $xls->getAll();

			// remove title
			unset($data[1]);

			$allOrgRates = OrgRate::model()->findAll('type = 5 and zone_id > 0');
			$allData = array();
			foreach ( $data as $row ) {
				$postCode = $row[1];
				$weight = $row[2];
				$allData[] = array(
					'postcode' => $postCode,
					'weight' => $weight,
					'data' => $this->getCouriersByPostcodeWeight($allOrgRates,$postCode,$weight)
				);
			}

			// get a org rate list order by ID asc
			$headers = array('Postcode','Weight(kg)');
			foreach ( $allData[0]['data']['others'] as $orgRate ) {
				$headers[] = $orgRate['name'];
			}

			// out put all data as format
			if ( $_POST['op'] == 'show' ) {
				$resp['msg'] = $this->renderPartial('_form_postw_check', array('header' => $headers, 'data' => $allData), true);
			}
		}

		if ( $_POST['op'] == 'show' ) {
			$resp['op'] = 'show';
			echo json_encode($resp);
		} else {
			// export as excel
			$xls = new oExcel;
			$mfn = 'batch_check_result';

			$i = 1;
			$headers[] = 'MX';
			$headers[] = '';

			$xls->addRow($i++, $headers);

			$totals = array();
			$rowInfo = array();
			$mxTotal = 0;
			foreach ( $allData as $k => $row ) {
				$rowInfo[] = $row['postcode'];
				$rowInfo[] = number_format(floatval($row['weight']),2,'.','');

				foreach ( $row['data']['others']  as $rate ) {
					$rowInfo[] =  $rate['price'];
					if ( !isset($totals[$rate['id']]) ) $totals[$rate['id']] = 0;
					$totals[$rate['id']] += $rate['oprice'];
				}
				$rowInfo[] =  $row['data']['cheap']['name'];
				$rowInfo[] =  $row['data']['cheap']['price'];
				$mxTotal += $row['data']['cheap']['oprice'];

				$xls->addRow($i++, $rowInfo);
				$rowInfo = array();
			}

			$rowInfo = array('');
			$rowInfo[] = 'Total';
			foreach ($totals as $k => $total ) {
				$rowInfo[] =  AppHelper::money_format('%i', $total);
			}
			$rowInfo[] = '';
			$rowInfo[] = AppHelper::money_format('%i', $mxTotal);
			$xls->addRow($i++, $rowInfo);

			$tempfile = Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR.$mfn.'.xlsx';

			$xls->output($tempfile,null,false);
			$resp['op'] = 'export';
			$dlUrl =  $this->createUrl('import/downloadBatchCheckResult');
			$resp['msg'] = '<span>File is ready , Please <a href="'.$dlUrl.'" target="_blank">click me</a> to download now<span>';

			echo json_encode($resp);
		}
	}

	/**
	 * because currently it is a little bit tough to download file in ajax form
	 * so we save the destination file firstly , then provide this download link to download the file again
	 */
	public function actionDownloadBatchCheckResult(){
		$xls = new oExcel;
		$mfn = 'batch_check_result';
		$tempfile = Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR.$mfn.'.xlsx';
		$xls->load($tempfile);
		$xls->output($mfn.'.xlsx');
	}

