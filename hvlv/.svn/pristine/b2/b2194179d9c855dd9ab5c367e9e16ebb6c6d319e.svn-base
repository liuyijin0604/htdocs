			'model'=>$model,'chgcodeid' => $chargecode_id,'calculate_cbm'=>@$chargecode->mdata['calculate_cbm'],'minimum_cbm'=>@$chargecode->mdata['minimum_cbm']
		));
	}

	public function actionOutturnShortReport(){
		$model = new ImParcel('search');
		$model->unsetAttributes();  // clear any default values
		$cond = new CDbCriteria;

		// last two months import shipments only currently
		$prevTwoMonths = date('Y-m-d',strtotime('-60 days',time()));
		$cond->condition = "t.status IN (50,55,60) AND t.created >= '" . $prevTwoMonths . "'" ; // reported , held , cleared

		// only support filter by console no
		if ( isset($_REQUEST['ImParcel']) ) {
			if ( !empty($_REQUEST['ImParcel']['consol_no']) ) {
				$cond->with = array('consol');
				$cond->compare('consol.id',$model->consol_id,false);
				$cond->compare('consol.no',$_REQUEST['ImParcel']['consol_no'],true);
			}
		}
		$modelSearch = $model->search(false,0,$cond);
		$allShipments = [];
		foreach ( $modelSearch->data as $shipment ) {
			if ( $shipment->getOutPkg() != $shipment->pkg ) {
				$allShipments[] = $shipment;
			}
		}
		$aships=[];
		  foreach($allShipments as $p){
			  $aships[]=['id'=>$p->id,'ref'=>$p->ref,'hbn'=>$p->hbn,'awb'=>empty($p->consol)?'':$p->consol->awb,'pkg'=>$p->pkg,'scanned'=>$p->getOutPkg(),'consol_id'=>empty($p->consol_id)?'':$p->consol->id,'consol_no'=>empty($p->consol_id)?'':$p->consol->no,
				  'status'=>$p->getStatus(),'cnee_name'=>empty($p->cnee)?'':$p->cnee->name,'postcode'=>$p->postcode,'weight'=>$p->weight,'location'=>$p->getLocation(),'tranship'=>$p->getTranships(),
				  'created'=>empty($p->consol)?'':$p->consol->eta,'bwf'=>$p->getWarnings()];
		  }
		 $filtersForm=new FiltersForm;
		 if (isset($_GET['FiltersForm'])) $filtersForm->filters=$_GET['FiltersForm'];
		 
		 $filteredData=$filtersForm->filter($aships);
		 $dp=new CArrayDataProvider($filteredData);  
		  $sort=new CSort();
		  $sort->attributes=array(
		  'hbn'=>array(
				'asc'=>'hbn ASC',
				'desc'=>'hbn DESC',
			),
		  'ref'=>array(
				'asc'=>'ref ASC',
				'desc'=>'ref DESC',
			),
		   'awb'=>array(
				'asc'=>'awb ASC',
				'desc'=>'awb DESC',
			),
			'consol_no'=>array(
				'asc'=>'consol_no ASC',
				'desc'=>'consol_no DESC',
			),

		  'cnee_name'=>array(
				'asc'=>'cnee_name ASC',
				'desc'=>'cnee_name DESC',
			),
			  'weight'=>array(
				'asc'=>'weight ASC',
				'desc'=>'weight DESC',
			),
			  'postcode'=>array(
				'asc'=>'postcode ASC',
				'desc'=>'postcode DESC',
			),
				'created'=>array(
				'asc'=>'created ASC',
				'desc'=>'created DESC',
			),
			  'status'=>array(
					'asc'=>'status ASC',
					'desc'=>'status DESC',
			  )
	  );
		   $sort->defaultOrder = "id DESC";
		   $dp->sort=$sort;
		   $dp->pagination=array('pageSize' => 50,'pageVar' => 'page');
		   $dp->id='imparcel_shortage_report';
	   
//        $dp = new CArrayDataProvider($allShipments,array(
//            'id' => 'imparcel_shortage_report',
//            'pagination' => array(
//                'pageSize' => 50,
//                'pageVar' => 'page'
//            )
//        ));

		$this->render('outturn_shortage_report',['model' => $model,'dp' => $dp,'filtersForm'=>$filtersForm]);
	}

	/**
	 * update import charge code
	 * @param $id
	 */
	public function actionUpdate($id){
		$model = ImportChargeCode::model()->findByPk($id);
		if( isset($_POST['ImportChargeCode']) ){
			$model->attributes=$_POST['ImportChargeCode'];
			$model->description = $_POST['ImportChargeCode']['description'];
			if ( !isset($_POST['selected_rates']) ) {
				$model->couriersObj = [];
				$model->couriers = '';
				// $model->addError('couriers','Please select at least one courier');
			} else {
				$model->couriersObj = $_POST['selected_rates'];
			}
			if(isset($_POST['mdata'])){
				foreach($_POST['mdata'] as $v=>$k){
					$model->mdata[$v]=$k;
				}
			}
			// if(!isset($_POST['mdata']['print_dg'])){
			// 	if(isset($model->mdata['print_dg']))
			// 	{
			// 		$model->mdata['print_dg'] = 0;
			// 	}
			// }
			if(!isset($_POST['mdata']['cm_address'])){
				if(isset($model->mdata['cm_address']))
				{
					$model->mdata['cm_address'] = 0;
				}
			}
			
			if(!isset($_POST['mdata']['selected_service'])){
				$model->mdata['selected_service']=[];
			}
			$model->save();
			$this->ajaxResult($model, array('id'));
		}
		$this->render('update_charge_code',array('model'=>$model));
	}


	/**
	 * test shipment courier selection based on charge code
	 * test step :
	 * 1. import shipments and create cheap label based on specified charge code setting
	 */
	public function actionAjaxtestmix()
	{
		$chargecode = $_POST['chargecode'];
		$chargeCodeInfo = ImportChargeCode::model()->find('chargecode = :ccode',[':ccode' => $chargecode]);
		if ( empty($chargeCodeInfo) ) {
			echo 'Invalid Charge Code';
			return;
		}
		$file = false;
		if (!empty($_FILES)) {
			$errors = [];
			// read all parcels data from excel template file
			if(empty($file)) $file = empty($_FILES['testmix_file'])? array() : $_FILES['testmix_file'];

			$xls = new oExcel;
			$xls->supported($file['name']);
			$xls->load($file['tmp_name']);
			$data = $xls->getAll();
			ini_set('precision', 12);
			unset($xls); // release memory right now

			// remove common header
			unset($data[1]);
			unset($data[2]);

			// create the console for them  only test by PCA Express
			$con = ImcoConsol::model()->find("owner_id = 114 AND dpt_id = 106 AND pol = 'AUSYD' AND created = :d", [':d' => date('Y-m-d')]);
			if(empty($con)){
				$con = new ImcoConsol;
				$con->owner_id = 114;
				$con->pol = 'AUSYD';
				$con->pod = 'AUSYD';
				$con->dpt_id = 106;
				$con->eta = date('Y-m-d');
				$con->created = date('Y-m-d');
				$con->save();
			}

			foreach ($data as $l => $r) {
				if (empty($r[1])) {
					$errors[] = 'row : ' . $l . ' No. index is missing';
					continue; //  parcel No. column at 1 :  save real parcel ( one parcel number maybe include multiple goods lines)
				}
				if (empty($r[20])) break; // goods weight column at 10 :  goods must have weight value

				// if parcel existing just update it
				// otherwise will create a new one
				$p = ImParcel::model()->find('status = 10 AND hbn = :hbn AND owner_id = :oid', array(':hbn' => $r[2], ':oid' => Yii::app()->user->id));
				if (empty($p)) {
					$p = new ImParcel;
					$ar = new Addr;
					$ae = new Addr;
				} else {
					$ar = &$p->cnor;
					$ae = &$p->cnee;
				}

				// get currency ID
				$cur = Invoice::getCurID($r[23]);

				// save or update shipper address information
				$ar->name = $r[4];
				$shipperName = trim($ar->name);
				if ( !empty($shipperName)) {
					$ar->tel = preg_replace('/[^\d]+/', '', $r[5]);
					$ar->address = $r[6];
					$ar->suburb = $r[7];
					$ar->city = $r[8];
					$ar->state = $r[9];
					$ar->postcode = $r[10];
					$ar->country = empty($r[11]) ? 'PR China' : $r[11];
				}
				$ar->save();

				// update or save consignee address information
				$ae->name = $r[12];
				$ae->tel = preg_replace('/[^\d]+/', '', $r[13]);
				$ae->address = $r[14];
				$ae->suburb = $r[15];
				$ae->state = strtoupper($r[16]);
				$ae->postcode = $r[17];
				$ae->country = empty($r[18]) ? 'Australia' : $r[18];
				$ae->save();

				$p->setAttributes(array(
					'consol_id' => 0,
					'zr_id' => 0,
					'agent_id' => 114, // test by PCA Express
					'cnor_id' => $ar->id,
					'cnee_id' => $ae->id,
					'status' => 10,
					'type' => 10,
					'hbn' => $r[2],
					'cref' => $r[3],
					'pkg' => $r[19],
					'state' => strtoupper($r[16]),
					'postcode' => $r[17],

					// 'value' => number_format((float)$r[27] * $r[28], 2, '.', '') ,
					// 'dvalue' => number_format((float)$r[27] * $r[28], 2, '.', '') ,
					'cbm' => number_format(empty($r[21]) ? round($r[21] / 600 * 1000000) / 1000000 : round($r[21] * 1000000) / 1000000, 2, '.', ''),
					'currency' => empty($cur) ? 1 : $cur,
					'weight' => sprintf('%0.2f', ($r[20] * 100) / 100),

				));

				// get all goods , currently only support maximum 100 items for one parcel
				$items = array('g' => [], 'g_zh' => [], 'b' => [], 'm' => [], 'v' => [], 'q' => [], 'hs' => []);
				$names = explode(';', $r[22]);
				$values = explode(';', $r[24]);
				$qtys = explode(';', $r[25]);
				$allValues = 0.0;
				$itemCounts = sizeof($names);
				for ($index = 0; $index < $itemCounts; $index++) {
					$items['g'][$index] = $names[$index];
					$items['g_zh'][$index] = '';
					$items['b'][$index] = '';
					$items['m'][$index] = '';
					$items['v'][$index] = $values[$index];
					$items['q'][$index] = $qtys[$index];
					$items['hs'][$index] = '';
					$allValues += $values[$index] * $qtys[$index];
				}
				$p->setAttribute('value', number_format((float)$allValues, 2, '.', ''));
				$p->setAttribute('dvalue', number_format((float)$allValues, 2, '.', ''));

				$p->eitems = $items;
				$p->man_id = 0;
				$p->consol_id = $con->id;
				$p->save();

				// select related courier based on charge code
				$rt = ChooseShipment::selectServiceByChargeCode($chargecode,$p);
				if ( !empty($rt->msg) ) {
					$errors[] =  $rt->msg;
				}
			}
			if ( !empty($errors) ) {
				$allErrors = '';
				foreach ( $errors as $error ){
					$allErrors .= $error . '<br/>';
				}
				echo $allErrors;
			} else {
				echo 'All Done Successfully';
			}
		} else {
			echo 'invalid file';
		}
	}


	/**
	 * test send shipment by fastway
	 * test step :
	 * 1. import shipments and create fastway label
	 * 2. create console for the shipments
	 * 3. generate related invoice
	 */
	public function actionAjaxtestfw()
	{
		$model = new Manifest('upload');

		$file = false;
		if (!empty($_FILES)) {
			// read all parcels data from excel template file
			if(empty($file)) $file = empty($_FILES['testfw_file'])? array() : $_FILES['testfw_file'];

			$xls = new oExcel;
			$xls->supported($file['name']);
			$xls->load($file['tmp_name']);
			$data = $xls->getAll();
			ini_set('precision', 12);
			unset($xls); // release memory right now

			// remove common header
			unset($data[1]);
			unset($data[2]);

			// create the console for them  only test by PCA Express
			$con = ImcoConsol::model()->find("owner_id = 114 AND dpt_id = 106 AND pol = 'AUSYD' AND created = :d", [':d' => date('Y-m-d')]);
			if(empty($con)){
				$con = new ImcoConsol;
				$con->owner_id = 114;
				$con->pol = 'AUSYD';
				$con->pod = 'AUSYD';
				$con->dpt_id = 106;
				$con->eta = date('Y-m-d');
				$con->created = date('Y-m-d');
				$con->save();
			}

			$fastwayApi = new FastwayAPI(true);
			foreach ($data as $l => $r) {
				if (empty($r[1])) {
					$model->addError('id', 'row : ' . $l . ' No. index is missing');
					continue; //  parcel No. column at 1 :  save real parcel ( one parcel number maybe include multiple goods lines)
				}
				if (empty($r[20])) break; // goods weight column at 10 :  goods must have weight value

				// if parcel existing just update it
				// otherwise will create a new one
				$p = ImParcel::model()->find('status = 10 AND hbn = :hbn AND owner_id = :oid', array(':hbn' => $r[2], ':oid' => Yii::app()->user->id));
				if (empty($p)) {
					$p = new ImParcel;
					$ar = new Addr;
					$ae = new Addr;
				} else {
					$ar = &$p->cnor;
					$ae = &$p->cnee;
				}

				// get currency ID
				$cur = Invoice::getCurID($r[23]);

				// save or update shipper address information
				$ar->name = $r[4];
				$shipperName = trim($ar->name);
				if ( !empty($shipperName)) {
					$ar->tel = preg_replace('/[^\d]+/', '', $r[5]);
					$ar->address = $r[6];
					$ar->suburb = $r[7];
					$ar->city = $r[8];
					$ar->state = $r[9];
					$ar->postcode = $r[10];
					$ar->country = empty($r[11]) ? 'PR China' : $r[11];
				}
				$ar->save();

				// update or save consignee address information
				$ae->name = $r[12];
				$ae->tel = preg_replace('/[^\d]+/', '', $r[13]);
				$ae->address = $r[14];
				$ae->suburb = $r[15];
				$ae->city = $r[15];
				$ae->state = strtoupper($r[16]);
				$ae->postcode = $r[17];
				$ae->country = empty($r[18]) ? 'Australia' : $r[18];
				$ae->save();

				$p->setAttributes(array(
					'consol_id' => 0,
					'zr_id' => 0,
					'agent_id' => 114, // test by PCA Express
					'cnor_id' => $ar->id,
					'cnee_id' => $ae->id,
					'status' => 10,
					'type' => 10,
					'hbn' => $r[2],
					'cref' => $r[3],
					'pkg' => $r[19],
					'state' => strtoupper($r[16]),
					'postcode' => $r[17],

					// 'value' => number_format((float)$r[27] * $r[28], 2, '.', '') ,
					// 'dvalue' => number_format((float)$r[27] * $r[28], 2, '.', '') ,
					'cbm' => number_format(empty($r[21]) ? round($r[21] / 600 * 1000000) / 1000000 : round($r[21] * 1000000) / 1000000, 2, '.', ''),
					'currency' => empty($cur) ? 1 : $cur,
					'weight' => sprintf('%0.2f', ($r[20] * 100) / 100),

				));

				// get all goods , currently only support maximum 100 items for one parcel
				$items = array('g' => [], 'g_zh' => [], 'b' => [], 'm' => [], 'v' => [], 'q' => [], 'hs' => []);
				$names = explode(';', $r[22]);
				$values = explode(';', $r[24]);
				$qtys = explode(';', $r[25]);
				$allValues = 0.0;
				$itemCounts = sizeof($names);
				for ($index = 0; $index < $itemCounts; $index++) {
					$items['g'][$index] = $names[$index];
					$items['g_zh'][$index] = '';
					$items['b'][$index] = '';
					$items['m'][$index] = '';
					$items['v'][$index] = $values[$index];
					$items['q'][$index] = $qtys[$index];
					$items['hs'][$index] = '';
					$allValues += $values[$index] * $qtys[$index];
				}
				$p->setAttribute('value', number_format((float)$allValues, 2, '.', ''));
				$p->setAttribute('dvalue', number_format((float)$allValues, 2, '.', ''));

				$p->eitems = $items;
				$p->man_id = 0;
				$p->consol_id = $con->id;
				$p->save();

				// add shipment to Fastway by API
				$result = $fastwayApi->addConsignment($p);
				if ( $result ) {
					$cost = $result->TotalCostExGST;

					// for fastway , because fastway server side issue
					// we need shrink the cost to 90.75 %
					$cost = $cost * 0.9075;

					$consignmentID = $result->ConsignmentID;
					$manifestID = $result->ManifestID;
					$refNumber = $result->LabelNumbers[0];
					$p->nolog = true;
					$p->ref = $refNumber;
					$p->update(['ref']);

					// save tranship information for Fastway courier
					$ts = new Tranship;
					$ts->pid = $p->id;
					$ts->org_id = 115;  // for Fastway post office
					$ts->man_id = $p->man_id;
					$ts->type = 80;  // shipment transfer to a different delivery courier
					$ts->status = 19; // in finally moving status
					$ts->connote = $p->ref;
					$ts->time = date('Y-m-d H:i:s');
					$ts->mdata['fw_consigment_id'] = $consignmentID;
					$ts->mdata['fw_manifest_id'] = $manifestID;
					$ts->mdata['fw_label_color'] = $result->Items[0]->labels[0]->colour;
					// $ts->mdata['fw_exlabel_count'] = $result->ExcessLabelCount;
					$ts->mdata['fw_dest_code'] = $result->DestinationRFCode; // delivering deport code
					$ts->cost = round($cost,2);
					$ts->save();
				}
			}

			// generate invoice for them

			$this->ajaxResult($model, array('id', 'warns'));
		}
	}

	public function actionAjaxFastwayCheck(){

		$suburb = $_POST['suburb'];
		$postcode = $_POST['postcode'];
		$weight = $_POST['weight'];
		$state = $_POST['state'];

		$resp = new stdClass();
		$resp->msg = 'Congratulations! Fastway can delivery your parcel';
		$fwApi = new FastwayAPI();
		if ( !FastwayAPI::isInDeliveryArea($postcode, $suburb) ) {
			$resp->msg = 'Sorry! Fastway can not delivery to : ' . $suburb . ' ' . $postcode . ' ' . $state;
		} else {
			if ( $fwApi->getProductCode($postcode,$weight)  == -1 ) {
				$resp->msg = 'Sorry! Fastway can not delivery to : ' . $suburb . ' ' . $postcode . ' ' . $state;
			}
		}

		echo json_encode($resp);
		Yii::app()->end();
	}

	/**
	 * import AuPost Cost from au post report file
	 */
	public function actionAjaxAupostCostImport(){

		$resp = array('success' => 1,'msg' => 'import successfully');
		$aupost_file = empty($_FILES['aupost']) ? array() : $_FILES['aupost'];
		if ( empty($aupost_file['tmp_name']) || !is_uploaded_file( $aupost_file['tmp_name'] ) ) {
			$resp['msg'] = 'Invalid template file';
			echo json_encode($resp);
			return;
		} else {
			$xls = new oExcel('CSV');
			$xls->load($aupost_file['tmp_name']);
			$data = $xls->getAll();
			// remove top two lines for title
			unset($data[1]);
			unset($data[2]);

			// save all console ids in order to update their cost billing line
			$consoleIds = array();
			$shipment = Shipment::model();
			foreach ( $data as $k => $cost ) {
				// for cost from aupost export file like : $12.23
				// we should remove currency sign
				$costValue = floatval(substr($cost[6],1));
				$consoleId = $shipment->addCost2Shipment($cost[1],$costValue);
				if ( $consoleId > 0 ) {
					array_push($consoleIds,$consoleId);
				}
			}

			// update all console's aupost cost billing
			ImcoConsol::updateImportConsoleBilling($consoleIds);

		}
		echo json_encode($resp);

	}

