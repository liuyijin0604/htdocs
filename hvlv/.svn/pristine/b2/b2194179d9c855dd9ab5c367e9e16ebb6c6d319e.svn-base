	/**
	 * list all import charge code
	 */
	public function actionChargecodemng(){
		$model = new ImportChargeCode('search');
		if ( isset($_GET['ImportChargeCode']) ) {
			$model->attributes = $_GET['ImportChargeCode'];
		}
		$model->dpmt = 10;

		$this->render('chargecode_list',['model' => $model]);
	}

	public function actionImportChargCodeLog($id)
	{
		$model = ImportChargeCode::model()->findByPk($id);
		if ($model==null) {
			throw new CHttpException(404, 'The requested page does not exist.');
		}
		$this->render('importChargecodeLog', [
			'model'=>$model,
		]);
	}

	public function actionCreatechargecode(){
		$model = new ImportChargeCode();
		if (!empty($_GET['dpmt'])) $model->dpmt = $_GET['dpmt'];
		if(isset($_POST['ImportChargeCode'])){
			//$model->setScenario('create');
			$model->attributes=$_POST['ImportChargeCode'];
			$model->description=$_POST['ImportChargeCode']['description'];
			if ( !isset($_POST['selected_rates']) ) {
			  $model->addError('couriers','Please select at least one courier');
			} else {
				$model->created = date('Y-m-d H:i:s');
				$model->couriersObj = $_POST['selected_rates'];
				$model->save();
			}
			$this->ajaxResult($model, array('id'));
		}

		$this->render('create_charge_code',array(
			'model'=>$model,
		));

	}

	public function actionCopychargecode($id){
		$transaction=Yii::app()->db->beginTransaction();
		try {	
			$model = ImportChargeCode::model()->findByPk($id);
			$model->status = 0;
			$model->chargecode = null;
			$model->id = null;
			$model->isNewRecord = true;
			$model->created = date('Y-m-d H:i:s');
			$model->save();
			//copy zone files
			$rs = FileRepo::model()->findAll('fid = :oid and type = 55 order by id desc', [':oid' => $id]);
			foreach($rs as $r){
				$r->id = null;
				$r->isNewRecord = true;
				$r->fid = $model->id;
				$r->save();
			}

			//copy zone data
			$rs = ZoneMap::model()->findAll('chargecode_id = :cid', [':cid' => $id]);
			foreach($rs as $r){
				$r->id = null;
				$r->isNewRecord = true;
				$r->chargecode_id = $model->id;
				$r->save();
			}

			//copy rate
			$rs = ZoneRate::model()->findAll('chargecode_id = :cid',array(':cid' => $id));
			foreach($rs as $r){
				$r->id = null;
				$r->isNewRecord = true;
				$r->chargecode_id = $model->id;
				$r->save();
			}
			$transaction->commit();
			echo json_encode(['id' => $model->id, 'code' => $model->chargecode]);
		} catch (Exception $ex) {
			$transaction->rollback();
			throw $ex;
		}
	}

	public function actionPcarate($id){
		$chargecode_id = $id;
		$model=Org::model()->findByPk(114); // for our own org PCAE
		$chargecode = ImportChargeCode::model()->findByPk($chargecode_id);
