<?php

class ImParcelController extends Controller
{
	protected $nonAjax = ['export', 'label','pcaLabel', 'epLabel','ResendACR','importInstruction','changeChargecode','seaOrder','seaOutturn','cargoReceipt','seaManifest','genGatepassDoc','requestManifest','preAlert','arrivalNotice','storageLabel', 'batchWeight', 'downloadBatchWeight','dgDocument','batchIsB2B','exportAllDFE','genLabel','exportAllChangedLabelShipment','exportMixSelection','shipmentReportExcel','exportAllSKP', 'genYlwLabel','manualCoverSheet'];
	/**
	 * Displays a particular model.
	 * @param integer $id the ID of the model to be displayed
	 */
	public function actionView($id)
	{
		$this->render('view', [
			'model'=>$this->loadModel($id),
		]);
	}

	/**
	 * Creates a new model.
	 * If creation is successful, the browser will be redirected to the 'view' page.
	 */
	public function actionCreate()
	{
		$model=new ImParcel;

		// Uncomment the following line if AJAX validation is needed
		// $this->performAjaxValidation($model);

		if (isset($_POST['ImParcel'])) {
			$model->setScenario('create');
			$model->attributes=$_POST['ImParcel'];
			//get owner_id;
			//$u = User::model()->find('org_id = :id', [':id' => $_POST['ImParcel']['owner_id']]);
			//$model->owner_id = empty($u)? $_POST['ImParcel']['agent_id'] : $u->id;
			$model->eitems = $_POST['items'];
			$model->mdata = $_POST['mdata'];
			$cnor = new Addr;
			$cnor->attributes = $_POST['Cnor'];
			$cnor->save();
			$model->cnor_id = $cnor->id;
			$cnee = new Addr;
			$cnee->attributes = $_POST['Cnee'];
			$cnee->save();
			$model->cnee_id = $cnee->id;
			$model->save();
			$this->ajaxResult($model, ['id']);
		}

		$model->pkg = 1;

		$this->render('create', [
			'model'=>$model,
		]);
	}

	/**
	 * re-send ACR for specified shipment
	 * @param $id
	 * @throws CHttpException
	 */
	public function actionResendACR($id)
	{
		$resp = ['success' => 0];
		$senderSite = Yii::app()->params['ics']['testing']? Yii::app()->params['ics']['test_site'] : Yii::app()->params['ics']['prod_site'];
		$p = $this->loadModel($id);
		if (in_array($p->status, [50, 55, 58, 60])) {
			$cn = $p->consol;
			//$goods = WordReplace::replace($p->getGoods(), $p->agent_id)[0];
			if (in_array($p->agent_id, SystemSetting::getNameValidationCustomers())) {
				$goods = WordReplace::replace($p->getGoods(), $p->agent_id)[0];
			} else {
				$goods = $p->getGoods();
			}
			$err = [];
			if (empty($p->weight)) {
				$err[] = 'Shipment ' . $p->hbn . ' has no weight.';
			}
			if (empty($p->dvalue)) {
				$err[] = 'Shipment ' . $p->hbn . ' has no value.';
			}
			if (empty($p->pkg)) {
				$err[] = 'Shipment ' . $p->hbn . ' has number of packs.';
			}
			if (empty($goods)) {
				$err[] = 'Shipment has no goods description.';
			}

			$cnor_name = $p->cnor->name;
			if (!preg_match('/\w/', $cnor_name)) $cnor_name = $p->agent->name;
			$cnor_name = Edimsg::strEscape($cnor_name);
							
			if(empty($cnor_name)){
				$err[] = 'Shipment '.$p->hbn.' cnor name problem';
			}

			$cnor_addr = $p->cnor->fullAddress(['suburb', 'city', 'state', 'postcode']);
			if (!preg_match('/\w/', $cnor_addr)) {
				$cnor_addr = $p->agent->getAddress(true, false, false);
			}
			$cnor_addr = trim($cnor_addr, " .,");
			$cnor_addr = Edimsg::strEscape($cnor_addr);
							
			if(empty($cnor_addr)){
				$err[] = 'Shipment '.$p->hbn.' cnor address problem';
			}

			if (!empty($p->receiver)&&!empty($p->receiver->address)&&!empty($p->receiver->name)&&!empty($p->receiver->postcode)) {
				$cnee_name=$p->receiver->name;
				$cnee_addr=$p->receiver->fullAddress(['suburb', 'state', 'postcode']);
			} else {
				$cnee_name=$p->cnee->name;
				if(!empty($p->cnee->company)&&$p->cnee->company!=$p->cnee->name)
				{
					$cnee_name = $p->cnee->company." ".$p->cnee->name;
				}
				$cnee_addr=$p->cnee->fullAddress(['suburb', 'state', 'postcode']);
			}

			$cnee_name = Edimsg::strEscape($cnee_name);
			$cnee_addr = Edimsg::strEscape($cnee_addr);

			if(empty($cnee_name) || !preg_match('/[A-z]+/', $cnee_name)){
				$err[] = 'Shipment '.$p->hbn.' cnee name problem';
			}
			if(empty($cnee_addr) || !preg_match('/[A-z]+/', $cnee_addr)){
				$err[] = 'Shipment '.$p->hbn.' cnee address problem';
			}

			if(!empty($err)){
				$resp['msg'] = implode('<br />', $err);
				echo json_encode($resp);
				return;
			}

			if ($cn->service == 20) {//sea cargo

				$os = Edimsg::model()->findAll(['condition' => "status = 50 AND type = 'SEACR-S' AND fid = :id AND sender = :sender", 'params' => [':id' => $p->id,':sender'=>$senderSite], 'order' => 't.id DESC']);
				$omid = null;
				if (!empty($os)) {
					foreach ($os as $o) {
						if (preg_match('/BGM\+933:::SEACR\+([^\+:]+):\d+\+9\'/', $o->msg, $m)) {
							$omid = $m[1];
							break;
						}
					}
				}
				
				if(Edimsg::model()->count('fid = :id AND type ="SEACR-S" AND status IN (20, 30, 40) AND sender = :sender', [':id' => $p->id,':sender'=>$senderSite]) > 0){
					$resp['msg']='There is an SCR message waiting for response from ICS, please try again later.';
					echo json_encode($resp);
					return;
				}

				$canSac = $p->canSAC();
				$obl=$cn->awb;// /required ocean bill landing
				$hbl=$cn->mdata['house_bill'];//house bill landing;// parent house bill landing
			//A document signed and delivered by the Master of a Ship to the consignor. A document of title and a receipt for goods.
				$voyage_number=$cn->flight ;// like 023s
				$vessel=$cn->airline; //IMO  like 9235103
				$container_number=trim($cn->mdata['container_no']);//container no  like OOLU9551594
				$container_size= DmawbConsol::getContainerCode($cn->mdata['sea_type']);
				$cargo_type=$cn->mdata['cargo_type'];
				if (empty($cargo_type)) $cargo_type="LCL";
				$volume=$p->cbm>0?$p->cbm*$p->pkg:$p->weight/250;
				if ($volume<0.01) $volume=0.01;

				$em = new Edimsg;
				$em->dt = date('Y-m-d H:i:s');
				$em->type = 'SEACR-S';
				$em->sender = Yii::app()->params['ics']['testing']? Yii::app()->params['ics']['test_site'] : Yii::app()->params['ics']['prod_site'];
				$em->receiver = Yii::app()->params['ics']['customs_id'];
				$em->status = 19;
				$em->fid = $p->id;
				$em->save();
				$em->mid = sprintf('%06s', substr($em->id, -6));
				$vn = Edimsg::model()->count('type = :t AND fid = :fid AND sender = :sender', [':t' => 'SEACR-S', ':fid' => $p->id,':sender'=>$senderSite]) + 1;
				$msg = "UNH+".$em->mid."+CUSCAR:D:99B:UN'
BGM+933:::SEACR+" . (empty($omid)?  $p->hbn.'-'.$vn : $omid). ":" . $vn . "+".(empty($omid)? 9 : 4)."'
RFF+PQ:PO'\n";
				if(!empty($hbl)) $msg .= "RFF+BM:".$hbl."'\n";
				//use word replace service;
				$msg .= "RFF+BH:".$p->hbn."'
RFF+MB:".$obl."'
NAD+AH+".Yii::app()->params['ics']['abn']."::95'
NAD+VW+".Yii::app()->params['ics']['abn']."::95'
NAD+CN++".Edimsg::strSegment($cnee_name, 35, 2).":".Edimsg::strSegment($cnee_addr, 35, 3)."'
NAD+CZ++".Edimsg::strSegment($cnor_name, 35, 2).":".Edimsg::strSegment($cnor_addr, 35, 3)."'
TDT+20+".$voyage_number."++11++++".$vessel."::11'
LOC+8+".(empty($cn->mdata['scr_destination'])?$cn->pod:$cn->mdata['scr_destination'])."::6'
LOC+12+".(empty($cn->mdata['scr_discharge'])?$cn->pod:$cn->mdata['scr_discharge'])."::6'
LOC+27+".substr($cn->pol, 0, 2)."::5'
LOC+76+".$cn->pol."::6'
LOC+73+".$cn->pol."::6'
CNI++:::".(empty($omid)? 'I' : 'A')."'
RFF+AAQ:".$container_number."'
GID+1'
RFF+ACC:".$container_size."'
GID+1'
RFF+ZZZ:1'
".($canSac ? "GIS+SAC:109:95'\n" : "")."GID+1'
PAC+".$p->pkg."'
PAC+++".$cargo_type.":67:95'
PAC+++GENN:121:95'
PAC+++PK:185:95'
FTX+AAA+++".Edimsg::strSegment(str_replace('/', ',', trim($goods, '/')), 512, 5)."'
MEA+AAE+AAL+KG:".sprintf("%.2f", $p->weight)."'
MEA+AAE+ABJ+CU:".sprintf("%.2f", $volume)."'
MEA+AAE+G+KG:".sprintf("%.2f", $p->weight)."'
";
				$mc = substr_count($msg, "\n")+1;
				$msg .= "UNT+".$mc."+".$em->mid."'";
				$em->msg = $msg;
				if (Yii::app()->params['ics']['testing']) {
					$em->mdata['test'] = 1;
				}
			}else{

			// get related console information
			$cn = $p->consol;
			$hwb = empty($cn->mdata['house_bill'])? $cn->no : $cn->mdata['house_bill'];
			$airline = substr(trim($cn->airline), 0, 2);
			$flight = substr(trim($cn->flight), 2);
			//$flight = preg_replace('/[^\d]+/', '', $cn->flight);
			$awb = preg_replace('/[^\d]+/', '', $cn->awb);


			// only value < 750USD can SAC
			// or 1000 AUD can be SAC (Self Assessed Clearance) only
			if (!empty($_GET['config_check'])) {
				if (!empty($_GET['can_sac'])) {
					$canSac=true;
				} else {
					$canSac=false;
				}
			} else {
				$canSac = $p->canSAC();
			}
			$os = Edimsg::model()->findAll(['condition' => "status = 50 AND type = 'AIRCR-S' AND fid = :id AND sender = :sender", 'params' => [':id' => $p->id,':sender'=>$senderSite], 'order' => 't.id DESC']);
			$omid = null;
			if (!empty($os)) {
				foreach ($os as $o) {
					if (preg_match('/MWB:'.$awb.'/', $o->msg) && preg_match('/BGM\+933:::AIRCR\+([^\+:]+):\d+\+9\'/', $o->msg, $m)) {
						$omid = $m[1];
						break;
					}
				}
			}
			
			if(Edimsg::model()->count('fid = :id AND type ="AIRCR-S" AND status IN (20, 30, 40) AND sender = :sender', [':id' => $p->id,':sender'=>$senderSite]) > 0){
				$resp['msg']='There is an ACR message waiting for response from ICS, please try again later.';
				echo json_encode($resp);
				return;
			}

			/*if (empty($omid)) {
				$resp['msg']='Original MSG not found for '.$p->hbn;
				echo json_encode($resp);
				return;
			}*/

			$em = new Edimsg;
			$em->dt = date('Y-m-d H:i:s');
			$em->type = 'AIRCR-S';
			$em->sender = Yii::app()->params['ics']['testing'] ? Yii::app()->params['ics']['test_site'] : Yii::app()->params['ics']['prod_site'];
			$em->receiver = Yii::app()->params['ics']['customs_id'];
			$em->status = 19;
			$em->fid = $p->id;
			$em->save();
			$em->mid = sprintf('%06s', substr($em->id, -6));
			$vn = Edimsg::model()->count('type = :t AND fid = :fid AND sender = :sender', [':t' => 'AIRCR-S', ':fid' => $p->id,':sender'=>$senderSite]) + 1;
			$msg = "UNH+" . $em->mid . "+CUSCAR:D:99B:UN'
BGM+933:::AIRCR+" . (empty($omid)?  $p->hbn.'-'.$vn : $omid). ":" . $vn . "+".(empty($omid)? 9 : 4)."'
RFF+PQ:PO'
RFF+AWB:" . $hwb . "'\n";
			$msg .= "RFF+HWB:" . $p->hbn . "'
RFF+MWB:" . $awb . "'
NAD+CN++" . Edimsg::strSegment($cnee_name, 35, 2) . ":" . Edimsg::strSegment($cnee_addr, 35, 3) . "'
NAD+CZ++" . Edimsg::strSegment($cnor_name, 35, 2) . ":" . Edimsg::strSegment($cnor_addr, 35, 3) . "'
NAD+VW+" . Yii::app()->params['ics']['abn'] . "::95'
TDT+20+" . $flight . "++6+" . $airline . "::3'
LOC+8+".(empty($cn->mdata['scr_destination'])?$cn->pod:$cn->mdata['scr_destination'])."::6'
LOC+76+" . $cn->pol . "::6'
LOC+12+".(empty($cn->mdata['scr_discharge'])?$cn->pod:$cn->mdata['scr_discharge'])."::6'
LOC+91+" . $cn->pol . "::6'
DTM+178:" . date("Ymd", strtotime($cn->eta)) . ":102'
CNI+1'
RFF+UCN:" . $p->hbn . "'
MOA+44:" . sprintf("%.2f", $p->getDvalue()) . ":USD'
" . ($canSac ? "GIS+SAC:109:95'\n" : "") . "GID+1'
PAC+" . $p->pkg . "'
FTX+AAA+++" . Edimsg::strSegment(str_replace('/', ',', trim($goods, '/')), 512, 5) . "'
MEA+AAE+G+KG:" . sprintf("%.2f", $p->weight) . "'
";
			$mc = substr_count($msg, "\n") + 1;
			$msg .= "UNT+" . $mc . "+" . $em->mid . "'";
			$em->msg = $msg;
			if (Yii::app()->params['ics']['testing']) {
				$em->mdata['test'] = 1;
			}
		}
			//echo $msg;
			$em->status = 20;
			$em->save();
			$p->save();

			$resp['success'] = 1;
		} else {
			$resp['success']   = 0;
			$resp['msg'] = 'The shipment status is wrong : only for HELD and REPORTED status';
		}
		echo json_encode($resp);
	}

	public function actionUpdateByNo($no)
	{
		$p = ImParcel::model()->find('(ref = :ref OR hbn = :ref)', [':ref' => $no]);
		if (!empty($p)) {
			$this->actionUpdate($p->id);
		} else {
			throw new CHttpException(404, 'The requested page does not exist.');
		}
	}

	/**
	 * Updates a particular model.
	 * If update is successful, the browser will be redirected to the 'view' page.
	 * @param integer $id the ID of the model to be updated
	 */
	public function actionUpdate($id)
	{
		$model=$this->loadModel($id);

		$model->genCnor();
		$model->genReceiver();
		$model->genNotifier();
		$oCneePostcode = $model->cnee->postcode;
		$oCneeSuburb = $model->cnee->suburb;
		// Uncomment the following line if AJAX validation is needed
		// $this->performAjaxValidation($model);
		if(!empty($_POST['Cnee']) && Yii::app()->user->grp == 72){
			$up_cnee = false;
			$up_rcvr = false;
			foreach($_POST['Cnee'] as $k => $v){
				if(in_array($k, ['tel', 'email', 'company']) && $model->cnee->{$k} != $v){
					$model->cnee->{$k} = $v;
					$up_cnee = true;
				}
			}
			if($up_cnee) $model->cnee->save();

			if (!empty($_POST['Receiver'])) {
				foreach($_POST['Receiver'] as $k => $v){
					if(in_array($k, ['tel', 'email', 'company']) && $model->receiver->{$k} != $v){
						$model->receiver->{$k} = $v;
						$up_rcvr = true;
					}
				}
				if($up_rcvr) $model->receiver->save();
			}
			$this->ajaxResult($model);
		}

		if (isset($_POST['mdata']['billing_note'])) {
			foreach($_POST['mdata'] as $k => $v){
				$model->mdata[$k] = $v;
			}
			$model->updateMeta();
			$this->ajaxResult($model);
		}
 
		if (isset($_POST['clear_log'])) {
			$model->mdata['clear_log']=$_POST['clear_log'];
		}

		if (isset($_POST['ImParcel']) && ($model->status < 50 || true)) {
			if(isset($_POST['ImParcel']['status'])&&$_POST['ImParcel']['status']!=$model->status)
			{
				if(!Acl::hasAccess('B:Import/cancelShipment'))
				{
					$model->addError("Shipment can not be updated", "Shipment can not be updated");
					$this->ajaxResult($model);
				}
			}

			if(!empty($_POST['ImParcel']['pbn']))
			{
				$p = ImParcel::model()->find("(hbn = :hbn or ref =:hbn) and consol_id = :consolId and status !=:status",[":hbn"=>$_POST['ImParcel']['pbn'],":consolId"=>$model->consol_id,":status"=>ImParcel::STATE_CANCELLED]);
				if(empty($p))
				{
					$model->addError("Can't find the pbn shipment", "Can't find the pbn shipment");
					$this->ajaxResult($model);
				}

				if(empty($model->fakParent))
				{
					$re = new ImportsShipmentFakRelations('create');
				}else
				{
					$re = $model->fakParent;
				}

				$re->cid = $model->id;
				$re->pid = $p->id;
				$re->save();
			}

			if(empty($_POST['bwf_ffi'])){
				$model->bwf = $model->bwf & (~ 4096);
			}else{
				$model->bwf = $model->bwf | 4096;
			}
			
			// $oref = $model->ref;
			// $ref = @$_POST['ImParcel']['ref'];
			if(isset($_POST['ImParcel']['status'])&& $_POST['ImParcel']['status']==ImParcel::STATE_CLEAR)
			{
				if($model->status>=ImParcel::STATE_DUTY_HELD&&$model->status<=ImParcel::STATE_CLEAR_WAIT)
				{
					$model->editedToCleared = true;
				}
			}

			if(isset($_POST['ImParcel']['status'])&&$_POST['ImParcel']['status']==ImParcel::STATE_CLEAR&&$model->agent_id==Org::ORGID_COURIER_UBI_CLIENT)
			{
				if($model->status==ImParcel::STATE_CLEAR_WAIT)
				{
					$model->mdata['UBI_edit_to_clear'] = 1;
				}
			} 

			$model->attributes = $_POST['ImParcel'];
			// if(!empty($_POST['ref_confirm']))
			// {
			// 	$model->ref = $ref;
			// }else
			// {
			// 	$model->ref = $oref;
			// }
			if(User::checkIsNotTruckUser())
			{
				foreach($_POST['items'] as $k1 => $colv)
				{
					$v2 = [];
					foreach($colv as $v)
					{
						$v2[] = $v;
					}
					$_POST['items'][$k1] = $v2;
				}
				$model->eitems = $_POST['items'];
				$model->cnor->attributes = $_POST['Cnor'];
			}
			foreach ($_POST['mdata'] as $k=>$v) {
				$model->mdata[$k] = $v;
			}
			// if(!empty($_POST['mdata']['amzon_pallet'])){
			// 	$cargoProcess = CargoProcess::model()->find('shipment_id = :shipment_id and status != 101 and (sub_type & 4096)>1',[':shipment_id'=>$model->id]);
			// 	if(!empty($cargoProcess)){
			// 		$cargoProcess->mdata['pallet']=$_POST['mdata']['amzon_pallet'];
			// 		$cargoProcess->save();
			// 	}
			// }

			if (!empty($_POST['re_print_label'])) {
				$model->cbwf=$model->cbwf|2048;
			} else {
				$model->cbwf=$model->cbwf&(~2048);
			}
			if (!empty($_POST['dim'])) {
				$model->mdata['dim'] = $_POST['dim'];
			}
			$model->cnor->save();
			$model->cnee->attributes = $_POST['Cnee'];
			$model->cnee->save();

			/*************************************************Update For Fastway Sort*****************************************************************/
			if($oCneePostcode!=$model->cnee->postcode||$oCneeSuburb!=$model->cnee->suburb)
			{
				if(!empty($model->trans))
				{
					foreach ($model->trans as $key => $ts) {
						if($ts->org_id==Org::ORGID_COURIER_FASTWAY)
						{
							$sortcode = FastwayAPI::sortingCode($model->cnee->postcode, $model->cnee->suburb);
							if(!empty($sortcode))
							{
								$ts->mdata['fw_toRf'] = $sortcode[0];
								$ts->mdata['fw_subDepotCode'] = $sortcode[1];
								$ts->mdata['fw_toCf'] = $sortcode[2];
								$ts->save();
								break;
							}
						}
					}
					
				}
			}
			/*******************************************************************************************************************/


			if (!empty($_POST['Receiver'])) {
				$model->receiver->attributes = $_POST['Receiver'];
				$model->receiver->save();
			}
			if (!empty($_POST['Notifier'])) {
				$model->notifier->attributes = $_POST['Notifier'];
				$model->notifier->save();
			}

			if (!empty($_POST['AmazonInfo']['booking_ref'])) 
			{
				$amazonInfo=$model->getAmazonInfo();
				$amazonInfo->booking_ref=$_POST['AmazonInfo']['booking_ref'];
				$date = !empty($_POST['AmazonInfo']['amazon_booking_time'])?$_POST['AmazonInfo']['amazon_booking_time']:null;
				if (!empty($_POST['AmazonInfo']['amazon_booking_time'])||!empty($amazonInfo->amazon_booking_time)) {
					$amazonInfo->amazon_booking_time=$date;
					$model->mdata['amazon_booking_time']=$date;
					$model->mdata['booking_ref']=$_POST['AmazonInfo']['booking_ref'];
					if ($model->status<90) {
						$model->updateAmazonBookingTime();
					}
				}
				$amazonInfo->save();
				$model->copyAmazonAndCargoDeliveryInfo();
			}

			$amazonDeleteType = 0;
			if (empty($_POST['AmazonInfo']['booking_ref'])&&(!empty($model->amazon_info->booking_ref))) {
				$amazonDeleteType += 1;
			}
			
			if (empty($_POST['AmazonInfo']['amazon_booking_time'])&&(!empty($model->amazon_info->amazon_booking_time))) {
				$amazonDeleteType += 2;
			}

			if($amazonDeleteType>0)
			{
				if($amazonDeleteType>=1&&$amazonDeleteType!=2)
				{
					$model->amazon_info->booking_ref='';
					$model->mdata['booking_ref']='';
				}

				if($amazonDeleteType>=2)
				{
					$model->amazon_info->booking_ref='';
					$model->mdata['amazon_booking_time']='';
					$model->amazon_info->amazon_booking_time = null;
				}

				$model->amazon_info->save();
				$model->copyAmazonAndCargoDeliveryInfo();
			}

			//Added by Gero 2019-04-29
			if(!isset($_POST['mdata']['cargo_delivery'])&&isset($model->mdata['cargo_delivery'])&&$model->mdata['cargo_delivery']==1&&User::checkIsNotTruckUser())
			{
				$model->mdata['cargo_delivery'] = 0;
				if(!empty($model->cargo_process))
				{
					$model->cargo_process->status = CargoProcess::DELETED;
					$model->cargo_process->update(["status"]);
				}
			}

			if(!isset($_POST['mdata']['cargo_ignore_scan'])&&!empty($model->mdata['cargo_ignore_scan']))
			{
				$model->mdata['cargo_ignore_scan'] = 0;
			}

			if(!isset($_POST['mdata']['Tailgate_Pallet'])&&!empty($model->mdata['Tailgate_Pallet']))
			{
				$model->mdata['Tailgate_Pallet'] = 0;
			}

			//Added by Gero 2019-07-18
			if(!isset($_POST['mdata']['cargo_pickup'])&&isset($model->mdata['cargo_pickup'])&&$model->mdata['cargo_pickup']==1&&User::checkIsNotTruckUser())
			{
				$model->mdata['cargo_pickup'] = 0;
				if(!empty($model->cargo_process))
				{
					$model->cargo_process->status = CargoProcess::DELETED;
					$model->cargo_process->update(["status"]);
				}
			}

			$cargoDeliveryInfo = null;
			//Added by Gero 2019-04-11 for saving delivery_booking_time
			if (!empty($_POST['CargoDeliveryInfo']['delivery_booking_time'])) {
				$model->saveNormalDeliveryInfo($_POST['CargoDeliveryInfo']['delivery_booking_time']);
				$model->copyAmazonAndCargoDeliveryInfo();
			}

			//Added by Gero 2019-05-02
			if(isset($_POST['delivery_select']))
			{
				$ds = $_POST['delivery_select'];
				if($ds==CargoProcess::NORMAL_CARGO)
				{
					$model->mdata['amazon_booking_time']="";
					$model->mdata['booking_ref']="";
					if(isset($model->amazon_info))AmazonInfo::model()->deleteAll(" fid = ".$model->id);
					
				}else if($ds == CargoProcess::FBA_CARGO)
				{
					if($cargoDeliveryInfo!=null)CargoDeliveryInfo::model()->deleteAll(" shipment_id = ".$model->id);
				}
			}
			//Added by Gero 2029-03-27
			if(!isset($_POST['mdata']['is_dg']))
			{
				if(!empty($model->mdata['is_dg']))
				{
					$model->mdata['is_dg'] = 0;
				}
			}

			if(isset($_POST['mdata']['is_b2c']))
			{
				$model->mdata['is_b2b'] = 0;
			}

			if(empty($_POST['mdata']['is_b2c'])&&empty($_POST['mdata']['is_b2b']))
			{
				unset($model->mdata['is_b2b']);
			}

			
			if(isset($_POST['ImParcel']['weight']))
			{
				$model->mdata['charge_client_weight']= $model->chargeWeight();
			}			
			
			$model->postcode = $model->cnee->postcode;
			$model->state = $model->cnee->state;
			$model->save();

			//Added by jerry 2018-09-23 for generate sea storage invoice
			if(!empty($_POST['gen_sea_inv'])){
				$errors = $model->genSeaStorageInvoice();
				if(!empty($errors)){
					$model->addError("GenInvoice Failed", implode("; ", $errors));
				}
			}
			//end by Jerry

			$this->ajaxResult($model);
		}
		if (!empty($model->mdata['dim']) && is_object($model->mdata['dim'])) {
			$model->mdata['dim'] = json_decode(strtolower(json_encode($model->mdata['dim'])), true);
		}
			  
		
		if (isset($_GET['tab'])) {
			Acl::hasAccess($this->CaName.'/'.$_GET['tab'], true);

			if ($_GET['tab'] == 'crm') {
				$this->render('/crm/tab_' . $_GET['tab'], ['model' => $model]);
			} else {
				$this->render('tab_' . $_GET['tab'], ['model' => $model]);
			}
		} else {
			$this->render('update', ['model'=>$model]);
		}
	}
	
	public function actionNotes($id)
	{
		$model=$this->loadModel($id);
		if (!empty($_POST['notes'])) {
			$log = Log::add($model, 6, ['notes' => $_POST['notes']]);
			$this->ajaxResult($log);
		}
	}

	public function actionOtScanned($id)
	{
		$model=$this->loadModel($id);
		if (!empty($_GET['undo'])) {
			Yii::app()->cache_java->delete("scan:".$model->id);
			$log = Log::add($model, 6, ['notes' => "unscan:".$_GET['undo'].":".$model->scan_data[50][$_GET['undo']]]);
			unset($model->scan_data[50][$_GET['undo']]);
			
			if(empty($model->scan_data[50]))
			{
				unset($model->mdata['scan_time']);
			}
			$model->save();
			// $model->updateUnScan(true);
			echo 'Done';
			Yii::app()->end();
		}
		$pbs = ParcelBarcode::model()->findAll('main_ref =:main_ref',[":main_ref"=>$model->ref]);
		$this->render('otscan', ['model'=>$model,'pbs'=>$pbs]);
	}
		
	public function actionClearLog($id)
	{
		$model=$this->loadModel($id);
		if (!empty($_POST['clear_log'])) {
			$model->mdata['clear_log']=$_POST['clear_log'];
			$model->save();
			$this->ajaxResult($model);
		}
		$this->render('clear_log', ['model'=>$model]);
	}
		
	public function actionCustMsg($id)
	{
		$model=$this->loadModel($id);
		if (!empty($_POST['msg_cust'])) {
			$model->mdata['msg_cust']=$_POST['msg_cust'];
			$model->save();
			$this->ajaxResult($model);
		}
		$this->render('msg_cust', ['model'=>$model]);
	}
	
	
	public function actionTrackingGrid($id)
	{
		if (empty($_POST['Tracking']['id'])) {//add
			$pt = new Tracking;
			$pt->pid = $id;
		} else {
			$pt = Tracking::model()->findByPk($_POST['Tracking']['id']);
		}
		$pt->attributes = $_POST['Tracking'];
		$pt->save();
		$this->ajaxResult($pt);
	}

	/**
