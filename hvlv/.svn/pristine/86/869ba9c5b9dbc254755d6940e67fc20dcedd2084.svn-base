	public function actionManualGatepass($id)
	{
		$model = $this->loadModel($id);
		$tranship = Tranship::model()->find(['condition' => 'pid = :pid', 'params' => [':pid' => $id], 'order' => 'id DESC']);
		if (!empty($tranship)) {
			$courier_id = $tranship->org_id;
		}
		if ($model->agent_id == 1918) {
			$courier_id = 134;
		} else if (in_array($model->agent_id, [2619, 2797, 2995])) {
			$courier_id = $model->agent_id;
		} else if ($model->agent_id == 3025) {
			if ((!empty($model->bag_tag->bag_tag) && preg_match('/UBA1050032SKU0/', $model->bag_tag->bag_tag)) || $model->can == 'SYD' || (!empty($model->bag_tag->importBag->mdata['destination']) && $model->bag_tag->importBag->mdata['destination'] == 'SYD')) {
				$courier_id = '3025-SYD';
			} else if ((!empty($model->bag_tag->bag_tag) && preg_match('/UBA1050034SKU0/', $model->bag_tag->bag_tag)) || $model->can == 'MEL' || (!empty($model->bag_tag->importBag->mdata['destination']) && $model->bag_tag->importBag->mdata['destination'] == 'MEL')) {
				$courier_id = '3025-MEL';
			} else if ((!empty($model->bag_tag->bag_tag) && preg_match('/UBA1050033SKU0/', $model->bag_tag->bag_tag)) || $model->can == 'BNE' || (!empty($model->bag_tag->importBag->mdata['destination']) && $model->bag_tag->importBag->mdata['destination'] == 'BNE')) {
				$courier_id = '3025-BNE';
			} else if ((!empty($model->bag_tag->bag_tag) && preg_match('/UBA1050035SKU0/', $model->bag_tag->bag_tag)) || $model->can == 'ADL' || (!empty($model->bag_tag->importBag->mdata['destination']) && $model->bag_tag->importBag->mdata['destination'] == 'ADL')) {
				$courier_id = '3025-ADL';
			}
		}

		if (empty($courier_id)) {
			echo json_encode(['done' => false, 'msg' => 'No courier info']);
			return;
		}

		$gatepass_courier = GatepassCourier::model()->find(['condition' => 'courier_id = :courier_id', 'params' => [':courier_id' => $courier_id], 'order' => 'id DESC']);
		if (empty($gatepass_courier)) {
			echo json_encode(['done' => false, 'msg' => 'No latest gatepass']);
			return;
		}

		$gatepass_shipment = GatepassShipment::model()->find('fid = :fid AND parent_id > 0', [':fid' => $id]);
		if (!empty($gatepass_shipment)) {
			echo json_encode(['done' => false, 'msg' => 'Already have gatepass']);
			return;
		} else if (empty($model->getScanTime())) {
			echo json_encode(['done' => false, 'msg' => 'No scan time']);
			return;
		}

		$gs = GatepassShipment::model()->find(['condition' => 'fid = :fid AND parent_id = 0', 'params' => [':fid' => $id], 'order' => 'id DESC']);
		if (empty($gs)) $gs = new GatepassShipment;
		$gs->fid = $model->id;
		$gs->sno = $model->pkg;
		$gs->courier_id = $courier_id;
		$gs->shipment_status = $model->status;
		$gs->connote_no = $model->ref;
		$gs->warehouse = 106;
		$gs->scan_time = $model->getScanTime();
		$gs->gate_pass_time = $gatepass_courier->create_time;
		$gs->parent_id = $gatepass_courier->id;
		$gs->status = 10;
		$gs->save();
		echo json_encode(['done' => true, 'msg' => 'Successfully']);
		return;
	}

