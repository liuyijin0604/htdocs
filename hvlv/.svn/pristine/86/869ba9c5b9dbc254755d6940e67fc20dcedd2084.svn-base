	/**
	 * to change the chargecode to the specify shipments;
	 *  $_POST   shipment_no and chargcode
	 * @return String;
	 */
	public function actionChangeChargecode()
	{
		if (!empty($_POST)) {
			if (empty($_POST['shipment_no'])) {
				echo "<div style='color:red;'>The shipment No is required!</div>";
				return;
			} elseif (empty($_POST['chargecode'])) {
				echo "<div style='color:red;'>chargcode is required!</div>";
				return;
			}
			if (!ImportChargeCode::model()->find('chargecode=:chargecode AND status=1', [':chargecode'=>trim($_POST['chargecode'])])) {
				echo "<div style='color:red;'>The chargeCode is not valid</div>";
				return;
			}

			$trans = Yii::app()->db->beginTransaction();
			try {
				foreach (preg_split("/[;,\n]/", $_POST['shipment_no']) as $hbn) {
					if (empty($hbn)) {
						continue;
					}
					if(!empty($_POST['consol_no']))
					{
						$consol = Consol::model()->find('no = :no',[':no'=>$_POST['consol_no']]);
						if(empty($consol))
						{
							echo "<div style='color:red;'>Consol is not valid</div>";
							return;
						}
						$rs= ImParcel::model()->findAll('(hbn=:hbn OR ref=:hbn) AND status != 100 AND consol_id = :consolId', [':hbn'=>trim($hbn),':consolId'=>$consol->id]);
					}else
					{
						$rs= ImParcel::model()->findAll('(hbn=:hbn OR ref=:hbn) AND status != 100', [':hbn'=>trim($hbn)]);
					}
					if (sizeof($rs)>1) {
						echo "<div style='color:red;'>".$hbn." has duplicate shipments</div>";
						continue;
					} elseif (sizeof($rs)==1) {
						$p=$rs[0];
					}
					if (!empty($p)) {
						$p->mdata['chargecode']= trim($_POST['chargecode']);
						$p->updateMeta();
						echo "<div style='color:green;'>".$hbn." Update Successfully</div>";
					} else {
						echo "<div style='color:red;'> shipment ".$hbn." not found!</div>";
					}
				}
				$trans->commit();
			} catch (Exception $ex) {
				$trans->rollback();
				throw $ex;
			}
		}
	}
		
