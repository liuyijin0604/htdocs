	public function actionImportD2zOutturn()
	{
		if (empty($_FILES)) {
			$this->render('import_d2z_outturn');
		} else {
			$resp = array('success' => 1, 'msg' => 'Imported Successfully');
			$file = $_FILES['outturn'];
			if (empty($file['tmp_name']) || !is_uploaded_file($file['tmp_name'])) {
				$resp['success'] = 0;
				$resp['msg'] = 'Invalid template file';
			} else {
				if(preg_match('/csv/', $file['name']))
				{
					$xls = new oExcel('CSV');
				}else
				{
					$xls = new oExcel();
				}
				$xls->load($file['tmp_name']);
				$data = $xls->getAll();
				if ($data[1][1] == 'Tracking' && $data[1][2] == 'Dg') {
					unset($data[1]);
					$trans = Yii::app()->db->beginTransaction();
					try{
						foreach ($data as $line) {
							$shipment = ImParcel::model()->find('ref = :ref', [':ref' => $line[1]]);
							if(empty($shipment)){
								$resp['msg'] .= ' '.$line[1].' not found';
								continue;
							}
							$line[2] = trim($line[2]);
							if($line[2]==1)
							{
								$shipment->mdata['is_dg'] = 1;
								$shipment->save();
							}
							
						}
						$trans->commit();
						echo json_encode($resp);
						Yii::app()->end();
					} catch (Exception $ex) 
					{
						$trans->rollback();
						throw $ex;
						echo json_encode($resp);
						Yii::app()->end();
					}
				}

				if ($data[1][1] == 'Parcel Outturn Report'&&$data[5][1] == "MAWB") {
					$mawb = $data[6][1];
					unset($data[1]);
					unset($data[2]);
					unset($data[3]);
					unset($data[4]);
					unset($data[5]);
					$surplus = [];
					$trans = Yii::app()->db->beginTransaction();
					try{
						foreach ($data as $line) {
							$shipment = ImParcel::model()->find('ref = :ref', [':ref' => $line[3]]);
							if($line[6]=="SU")
							{
								$surplus[] = $line[3];
							}

							if(empty($shipment)){
								$resp['msg'] .= ' '.$line[3].' not found';
								continue;
							}
							$status = $line[7];
							if($shipment->status!=ImParcel::STATE_HELD&&$shipment->status!=ImParcel::STATE_CLEAR)
							{
								if(preg_match('/held/i', $status))
								{
									$status = ImParcel::STATE_HELD;
									$shipment->status = $status;
								}
								if(preg_match('/clear/i', $status))
								{
									$status = ImParcel::STATE_CLEAR;
									$shipment->status = $status;
								}
							}

							if(!empty($line[8]))
							{
								$checkInPkg = $line[8];
								if(is_float($line[10]))
								{
									$checkInDate = date('Y-m-d H:i:s', strtotime(oExcel::toDate($line[10])));
								}else
								{
									$checkInDate = str_replace('/', '-', $line[10]);
									$checkInDate = date('Y-m-d H:i:s', strtotime($checkInDate));
								}
								$shipment->scan_data = [50=>[]];

								for ($i=1; $i<=$checkInPkg; $i++) { 
									$shipment->scan_data[50][$shipment->hbn.'-'.$i] = $checkInDate;
								}
								if (empty($shipment->mdata['scan_time'])) $shipment->mdata['scan_time'] = $checkInDate;
							}

							$shipment->save();
							
						}



						if(!empty($surplus))
						{
							$emailService = new EmailService();
							$emailService->sendNormalEmail('imports@toplogistics.com.au','AMI outturn surplus-----'.$mawb,join(',',$surplus));
						}
						$trans->commit();
						echo json_encode($resp);
						Yii::app()->end();
					} catch (Exception $ex) 
					{
						$trans->rollback();
						throw $ex;
						echo json_encode($resp);
						Yii::app()->end();
					}
				}

				if (($data[1][1] == '箱号' && $data[1][2] == '包裹单号')||($data[1][1] == 'BagTag' && $data[1][2] == 'Ref')) {
					unset($data[1]);
					$previousTag = '';
					$trans = Yii::app()->db->beginTransaction();
					try{
						foreach ($data as $key => $line) {
							if(!empty($line[1]))
							{
								$previousTag = $line[1];
							}
							$shipment = ImParcel::model()->find('ref = :ref', [':ref' => $line[2]]);
							if(empty($shipment)){
								$resp['msg'] .= ' '.$line[2].' not found';
								continue;
							}
							$isLetter = empty($line[4])?"":$line[4];
							if(!empty($isLetter))
							{
								$shipment->mdata['is_manual_letter'] = 1;
								$shipment->save();
							}

							$importBag = ImportBag::model()->find('bag_tag = :bag_tag',[':bag_tag'=>$previousTag]);

							if(strtoupper($previousTag)!='NULL')
							{
								if(empty($importBag))
								{
									$destination = empty($line[3])?"":$line[3];
									$importBag = new ImportBag();
									$importBag->user_id= User::currentUserID();
									$importBag->bag_tag = $previousTag;
									$importBag->created = date("Y-m-d H:i:s");
									if(!empty($destination))
									{
										$importBag->mdata['destination'] = $destination;
									}
									if(!empty($isLetter))
									{
										$importBag->mdata['is_manual_letter'] = 1;
									}
									$importBag->save();
								}else
								{
									$destination = empty($line[3])?"":$line[3];
									if(!empty($destination))
									{
										$importBag->mdata['destination'] = $destination;
									}
									if(!empty($isLetter))
									{
										$importBag->mdata['is_manual_letter'] = 1;
									}
									$importBag->save();
								}
							}

							$bagTag = ImportBagTag::model()->find('shipment_id = :shipment_id',[':shipment_id'=>$shipment->id]);
							if(strtoupper($previousTag)!='NULL')
							{
								if(empty($bagTag))
								{
									$bagTag = new ImportBagTag();
								}
								$bagTag->bag_tag = $previousTag;
								$bagTag->import_bag_id = $importBag->id;
								$bagTag->shipment_id = $shipment->id;
								$bagTag->save();
							}else
							{
								if(!empty($bagTag))
								{
									$importBag = ImportBag::model()->find('bag_tag = :bag_tag',[':bag_tag'=>$bagTag->bag_tag]);
									$bagTag->delete();
									if(ImportBagTag::model()->count('bag_tag = :bag_tag',[':bag_tag'=>$bagTag->bag_tag])==0)
									{
										if(!empty($importBag))
										{
											$importBag->delete();
										}
									}
								}
							}			
						}
						$trans->commit();
						echo json_encode($resp);
						Yii::app()->end();
					} catch (Exception $ex) 
					{
						$trans->rollback();
						throw $ex;
						echo json_encode($resp);
						Yii::app()->end();
					}
				}


				if ($data[1][1] == 'Tracking' && $data[1][2] == 'Status') {
					unset($data[1]);
					$trans = Yii::app()->db->beginTransaction();
					try{
					foreach ($data as $line) {
						if(!empty($line[4]))
						{
							$shipment = ImParcel::model()->find('hbn = :hbn', [':hbn' => $line[4]]);
						}else
						{
							$shipment = ImParcel::model()->find('ref = :ref', [':ref' => $line[1]]);
						}
						if(empty($shipment)){
							$resp['msg'] .= ' '.$line[1].' not found';
							continue;
						}
						$line[2] = trim($line[2]);
						if (preg_match('/held/i', $line[2]) && $shipment->status <= 55 && ((!empty($shipment->trans[0]) && in_array($shipment->trans[0]->org_id, [1426, 3079])) || $shipment->isLetter()||in_array($shipment->agent_id, [2716,3333,1804]))) {

							foreach (ImParcel::$held_reasons_check as $key => $value) {
								if(preg_match('/'.$value.'/i', $line[3]))
								{		
									if(($shipment->bwf & $key)==0)
									{
										$shipment->bwf = $shipment->bwf+$key;
									}

								}
							}

							$shipment->status = 55;
							$shipment->update(['status','bwf']);
							if(preg_match('/heldshort/i', $line[2]))
							{
								continue;
							}
							if ($shipment->pkg - $shipment->getOutPkg()) {
								$st = time() - rand(2000, 6000);
								for ($j = 1; $j <= $shipment->pkg; $j++) {
									if (!empty($shipment->scan_data[50][$shipment->hbn . '-' . $j])) continue;
									$pt = $st + rand(10, 100 * $j);
									$shipment->scan_data[50][$shipment->hbn . '-' . $j] = date('Y-m-d H:i:s', $pt);
								}
								if (empty($shipment->mdata['scan_time'])) $shipment->mdata['scan_time'] = date('Y-m-d H:i:s', $st);
								$shipment->save();
							}
						} else if ((preg_match('/clear/i', $line[2])&&!preg_match('/Formal/i', $line[2])) && ((!empty($shipment->trans[0]) && in_array($shipment->trans[0]->org_id, [1426, 3079])) || $shipment->isLetter()||in_array($shipment->agent_id, [2716,3333,1804]))) {
							if ($shipment->status < 60) {
								$shipment->status = 60;
								$shipment->update('status');
							}else{
								$dts = [];
								foreach($shipment->tracks as $t){
									if($t->type == 40){
										$dts[0] = strtotime($t->dt);
									}elseif($t->type == 70){
										$dts[1] = strtotime($t->dt);
										break;
									}
								}
								if(!empty($dts[1])){
									$dt = $dts[1] - (empty($dts[0])? rand(3600 * 2, 3600 * 8) : ceil(($dts[1] - $dts[0]) * rand(400, 800) / 1000));
								}else{
									$dt = $dts[0] + rand(3600 * 2, 3600 * 6);
								}
								$shipment->addTracking(60, 'Clearance processing complete', 'Kingsgrove', date('Y-m-d H:i:s', $dt));
							}
							if(preg_match('/clearshort/i', $line[2]))
							{
								continue;
							}
							if ($shipment->pkg - $shipment->getOutPkg()) {
								$st = time() - rand(2000, 6000);
								for ($j = 1; $j <= $shipment->pkg; $j++) {
									if (!empty($shipment->scan_data[50][$shipment->hbn . '-' . $j])) continue;
									$pt = $st + rand(10, 100 * $j);
									$shipment->scan_data[50][$shipment->hbn . '-' . $j] = date('Y-m-d H:i:s', $pt);
								}
								if (empty($shipment->mdata['scan_time'])) $shipment->mdata['scan_time'] = date('Y-m-d H:i:s', $st);
								$shipment->save();
							}
						}else{
							$resp['msg'] .= ' '.$line[1].' can not be updated';
						}
					}
						$trans->commit();
					} catch (Exception $ex) {
						$trans->rollback();
						throw $ex;
					}
				} else {
					$resp['success'] = 0;
					$resp['msg'] = 'Invalid template file';
				}
			}
			echo json_encode($resp);
			Yii::app()->end();
		}
	}

	public function actionBatchStatus($status)
	{
		$model = new ImParcel('search');
		if (empty($_POST)) {
			$this->render('batch_status', ['model' => $model]);
		} else {
			$model->attributes = $_POST['ImParcel'];
			$data = $model->search(false);
			foreach ($data->getData() as $shipment) {
				if ($shipment->status <= $status) {
					$shipment->status = $status;
					$shipment->custom_log_note = 'Manual Change';
					$shipment->update('status');
				}
			}

			$this->ajaxResult($model);
		}
	}

	public function actionBatchWeight()
	{
		if (empty($_FILES)) {
			$this->render('batch_weight');
		} else {
			$file = $_FILES['batch_change_file'];
			$xls = new oExcel;
			$xls->supported($file['name']);
			$xls->load($file['tmp_name']);
			$data = $xls->getAll();

			$xls = new oExcel;
			if (preg_match('/ref/i', $data[1][1])) {
				$xls->addRow(1, array_merge($data[1], ['Result']));
				unset($data[1]);
			}
			foreach ($data as $k => $line) {
				$p = ImParcel::model()->find('ref = :ref', [':ref' => $line[1]]);
				if (empty($p)) {
					$xls->addRow($k, array_merge($line, ['Not exist']));
					continue;
				}
				if (preg_match('/\[M\]/', $p->getStatus()) || !empty($_POST['manifested'])) {
					if ($p->weight < $line[2]) {
						$p->weight = $line[2];
						$p->update('weight');
						$xls->addRow($k, array_merge($line, ['Already manifested. Increase weight. Accept!']));
					} else {
						$xls->addRow($k, array_merge($line, ['Already manifested. Decrease weight. Decline!']));
					}
				} else {
					$p->weight = $line[2];
					$p->update('weight');
					$xls->addRow($k, array_merge($line, ['Updated']));
				}
			}
			$mfn = 'change_weight_result';
			$tempfile = Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR.$mfn.'.xlsx';
			$xls->output($tempfile, null, false);
			echo "<a href=\"" . $this->createUrl('imParcel/downloadBatchWeight') . "\" target=\"_blank\">Click to download result</a>";
			yii::app()->end();
		}
	}

