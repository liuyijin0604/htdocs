	public function actionBatchProcess()
	{
		if(!Acl::hasAccess('B:BatchProcess'))
		{
			return;
		}

		$model = new ImParcel('search');
		if(!empty($_POST))
		{
			$mhbns = $_POST['ImParcel']['mhbns'];
			$ns = [];
			if (!empty($mhbns)) {
				$ns = preg_split('/[\s,;]+/', trim($mhbns));
				$ns = array_slice($ns, 0, 200);
			}
			$ids = [];
			$transaction=Yii::app()->db->beginTransaction();
			try {
				foreach ($ns as $s) {
					if(empty($s)) continue;
					$p = ImParcel::model()->find(["condition"=>"(hbn=:hbn or ref=:ref or cref=:cref) and status != :status","params"=>[":hbn"=>$s,":ref"=>$s,":cref"=>$s,":status"=>ImParcel::STATE_CANCELLED],"order"=>"id desc"]);
					if(empty($p))
					{
						$model->addError($p->ref."empty",$p->ref."empty");
					}else
					{
						if(in_array($p->id,$ids))
						{
							continue;
						}
						if($p->status!=ImParcel::STATE_SUB_UBM)
						{
							$p->mdata['old_status'] = $p->status;
							$p->status = ImParcel::STATE_SUB_UBM;
							$p->bwf = $p->bwf|ImParcel::BWF_FFI;
							$p->update(['meta','bwf','status']);
							$ids[] = $p->id;
						}
					}
				}
				$transaction->commit();
			} catch (Exception $ex) {
				$transaction->rollback();
				throw $ex;
			}
			$this->ajaxResult($model);

		}

		$this->render('batch_process',['model'=>$model]);
	}


	public function actionBatchMarkGatepass()
	{
		if(!Acl::hasAccess('B:MarkGatepass'))
		{
			return;
		}

		$model = new ImParcel('search');
		if(!empty($_POST)&&!empty($_FILES))
		{
			$mhbns = $_POST['ImParcel']['mhbns'];
			$ns = [];
			if (!empty($mhbns)) {
				$ns = preg_split('/[\s,;]+/', trim($mhbns));
			}
			$ids = [];
			$file = null;
			$service = new Service();
			$transaction=Yii::app()->db->beginTransaction();
			try {
				foreach ($ns as $s) {
					if(empty($s)) continue;
					$p = ImParcel::model()->find(["condition"=>"(hbn=:hbn or ref=:ref or cref=:cref) and status != :status","params"=>[":hbn"=>$s,":ref"=>$s,":cref"=>$s,":status"=>ImParcel::STATE_CANCELLED],"order"=>"id desc"]);
					if(empty($p))
					{
						$model->addError($p->ref."empty",$p->ref."empty");
					}else
					{
						if(in_array($p->id,$ids))
						{
							continue;
						}
						$p->cbwf = $p->cbwf|ImParcel::CBWF_FORCE_GATEPASS;
						$p->update(['cbwf']);
						 $courier_id = null;
			            if (empty($courier_id)) 
			            {
			                $courier_id=$p->getCourierId();
			            }
			            $action = "MarkGatepass";
						GatepassShipment::gatepassScan($p, $courier_id, 1, $p->consol->dpt_id,$action);
						$service->saveFiles($_FILES,'ImParcel',$p->id,FileRepo::FORCE_GATEPASS);
						$ids[] = $p->id;
					}
				}
				$transaction->commit();
			} catch (Exception $ex) {
				$transaction->rollback();
				throw $ex;
			}
			$this->ajaxResult($model);

		}

		$this->render('batch_process',['model'=>$model]);
	}
											
	/**
	 * Returns the data model based on the primary key given in the GET variable.
	 * If the data model is not found, an HTTP exception will be raised.
	 * @param integer the ID of the model to be loaded
	 */
	public function loadModel($id)
	{
		$model = null;
		$model=ImParcel::model()->findByPk($id);
		if(empty($model))
		{
			$model=ImParcelArchive::model()->findByPk($id);
		}

		if ($model===null) {
			throw new CHttpException(404, 'The requested page does not exist.');
		}
		return $model;
	}

	public function actionManualCoverSheet($id)
	{
		$model=$this->loadModel($id);
		$type = "";
		if ($model->consol->service == 10)
		{
			$type = "Air";
		}else
		{
			$type = "Sea";
		}
		$ps = [];
		$cptype = empty($_GET['type'])?"":$_GET['type'];
		$firstpage = oPDF::renderPDF('manual_cover_sheet_1', ['shipment' => $model,'type'=>$type], 2);
		$ps[] = $firstpage;
		$secondpage = oPDF::renderPDF('manual_cover_sheet_2', ['model' => $model,'type'=>$type], 2);
		$ps[] = $secondpage;
		oPDF::mergePDF($ps, 1, true, 'manual_cover_sheet'.$model->hbn.'.pdf');
	}

	public function actionCopyShipment($id)
	{	
		$model = $this->loadModel($id);
		if (empty($_POST)) {
			$this->render('confirm', ['title' => 'Copy Shipment - ' . $model->hbn, 'id' => $id]);
		} else {			
			$ref = $model->ref;
			$reTransNum =  $model->pkg;//shipment->pkg
			$orgShipment = ImParcel::model()->findByPk($id);
			$newShipment = new ImParcel('create');
			$newShipment->attributes = $orgShipment->attributes;
			// $newShipment->hbn = $newShipment->hbn;
			// $newShipment->cref = $newShipment->cref;			
			// $newShipment->ot_id = 10;
			$newShipment->can = $orgShipment->ref;
			$cnor = new Addr;
			$cnor->attributes = $orgShipment->cnor->attributes;
			$cnor->save();
			$newShipment->cnor_id = $cnor->id;
			$cnee = new Addr;
			$cnee->attributes = $orgShipment->cnee->attributes;

			$cnee->save();
			$newShipment->cnee_id = $cnee->id;
			$newShipment->eitems = $orgShipment->eitems;
			$newShipment->mdata = $orgShipment->mdata;
			// unset($newShipment->mdata['direct_courier']);
			// unset($newShipment->mdata['rts_scan_date']);
			// unset($newShipment->mdata['ss_lbl_request_id']);

			// unset($newShipment->mdata['import_billing_id']);
			// unset($newShipment->mdata['old_import_billing_id']);
			// unset($newShipment->mdata['location']);
			// unset($newShipment->mdata['used_location']);
			// unset($newShipment->mdata['eiz']);
			// unset($newShipment->mdata['eiz_id']);
			// unset($newShipment->mdata['chargecode']);
			$newShipment->mdata['oref'] = $orgShipment->ref;
			$newShipment->ref = " ";
			$newShipment->status = ImParcel::NEW_STATUS;
			// $newShipment->consol_id = 0;
			$newShipment->consol_id = $orgShipment->consol_id;
			$newShipment->created = date('Y-m-d');
			$newShipment->weight = round(($orgShipment->weight/$orgShipment->pkg)*$reTransNum,2);
			$newShipment->pkg = $reTransNum;
			$newShipment->mdata['total_cbm'] = round($newShipment->cbm*$reTransNum,2);
			// save original RTS shipment No.
			// $newShipment->note .= $orgShipment->ref;
			$newShipment->note = $orgShipment->note;
			$newShipment->bwf = $orgShipment->bwf;
			// $newShipment->bwf = 0;

			if ($newShipment->save()) {
				$createOk = true;
				$this->ajaxResult($newShipment);
			}

			// $sql = 'UPDATE shipment SET ref = hbn WHERE ref = "" AND consol_id = :cid';
			// Yii::app()->db->createCommand($sql)->bindValues([':cid' => $id])->execute();
			// $this->ajaxResult($model);
		}
	}

	public function actionWordReplace($id=null)
	{
		if (empty($_POST)) {
			$this->render('word_replace',array('id'=>$id));
		} else {
			$imParcel = $this->loadModel($_POST['shipment_id']);
			$originWord = strtolower($_POST['original_word']);
			$replaceWord = $_POST['replace_word'];
			$wordType = $_POST['word_type'];

			/**
			 * save or update word replace record
			 */
			$wordModel = WordReplace::model()->findByAttributes(array('pre_word'=>$originWord));
			if (empty($wordModel)) {
				$wordReplace = new WordReplace();
				$wordReplace->pre_word = strtolower($originWord);
				$wordReplace->replace_word = $replaceWord;
				$wordReplace->type = intval($wordType);
				$wordReplace->status = 1;
				$wordReplace->save();
			} else {
				$wordModel->replace_word = $replaceWord;
				$wordModel->type = intval($wordType);
				$wordModel->status = 1;
				$wordModel->save();
			}

			/**
			 * Update item names of current shipment
			 */
			
			for ($i = 0; $i < count($imParcel->eitems['g']); $i++) {
				$words = explode(" ", $imParcel->eitems['g'][$i]);
				for ($j = 0; $j < count($words); $j++) {
					if (strtolower($words[$j]) == $originWord) {
						$words[$j] = $replaceWord;
					}
				}
				$strItemName = '';
				foreach ($words as $word) {
					$strItemName .= $word . ' ';
				}
				$strItemName = substr($strItemName, 0, -1);
				$imParcel->eitems['g'][$i] = $strItemName;
			}
			
			$imParcel->save();

			$response = new stdClass;
			$response->success = true;
			$response->msg = "Done";
			echo json_encode($response);
		}
	}
}


