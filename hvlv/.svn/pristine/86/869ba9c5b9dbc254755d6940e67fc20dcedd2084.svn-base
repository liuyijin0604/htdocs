	public function actionUpdateClearReason($id)
	{
		$model= $this->loadModel($id);
		if (!empty($_POST)) {
			if (isset($_POST['clear_reasons'])) {
				$model->cleanClear();
				$model->bwf=$model->bwf&64^$model->bwf;// clear DDP
				$model->bwf=$model->bwf&128^$model->bwf; //clear DDU
				$model->bwf=$model->bwf&2^$model->bwf; //clear shang yi
				$model->bwf=$model->bwf&~2048; //clear 海运散货
				
				foreach ($_POST['clear_reasons'] as $r) {
					$model->bwf=$model->bwf|$r;
				}

				if(($model->bwf&ImParcel::BWF_SELF_CUSTOM)>0)
				{
				 	$model->bwf = $model->bwf|ImParcel::BWF_NON_SAC;
				}

				if(($model->bwf&ImParcel::BWF_NON_SAC)>0)
				{
				    $model->bwf = $model->bwf & 16384 ^ $model->bwf;
				}

				if(($model->bwf&ImParcel::BWF_SAC)>0&&!$model->canSac())
				{
					$model->addError('Can\'t be SAC','Can\'t be SAC');
					$this->ajaxResult($model);
				}
			 
				if ((in_array(8, $_POST['clear_reasons']) || in_array(16, $_POST['clear_reasons']))
					&&(!in_array(4, $_POST['clear_reasons'])&&!in_array(32, $_POST['clear_reasons'])&&!in_array(512, $_POST['clear_reasons']))) {
					$heldTime=$model->getHeldTrackingTime();
					if (!empty($heldTime)&& (time()-strtotime($heldTime))>86400) {
						$model->bwf=$model->bwf|ImParcel::BWF_HELD_OTHER;
					}
				}
				if (!empty($model->process)) {
					$process=$model->process;
					if (in_array(4, $_POST['clear_reasons'])) {//hv
						if (($process->type&4)==0) {
							$process->type= $process->type|4;
							$process->update('type');
						}
					} else {
						if (($process->type&4)>0) {
							$process->type= $process->type&~4;
							$process->update('type');
							ProcessLog::deleteLog($process->id, 4);
						}
					}
					if (in_array(ImParcel::BWF_HELD_OTHER, $_POST['clear_reasons'])) {
						//sac and border, need to category to a other held,
						if (($process->type&ShipmentProcess::TYPE_OTHER)==0) {
							$process->type=$process->type|ShipmentProcess::TYPE_OTHER;
							$process->update('type');
						}
						//if held for more than one day,then will add other held
					} else {
						if (($process->type&ShipmentProcess::TYPE_OTHER)>0) {
							$process->type=$process->type&~ShipmentProcess::TYPE_OTHER;
							$process->update('type');
							ProcessLog::deleteLog($process->id, ShipmentProcess::TYPE_OTHER);
						}
					}
					if (in_array(512, $_POST['clear_reasons'])) {
						if (($process->type&ShipmentProcess::TYPE_EMPP)==0) {
							$process->type=$process->type|ShipmentProcess::TYPE_EMPP;
							$process->update('type');
						}
					} else {
						if (($process->type&ShipmentProcess::TYPE_EMPP)>0) {
							$process->type=$process->type&~ShipmentProcess::TYPE_EMPP;
							$process->update('type');
							ProcessLog::deleteLog($process->id, ShipmentProcess::TYPE_EMPP);
						}
					}
					if (in_array(32, $_POST['clear_reasons'])) {
						if (($process->type&ShipmentProcess::TYPE_AQIS)==0) {
							$process->type=$process->type|ShipmentProcess::TYPE_AQIS;
							$process->update('type');
						}
					} else {
						if (($process->type&ShipmentProcess::TYPE_AQIS)>0) {
							$process->type=$process->type&~ShipmentProcess::TYPE_AQIS;
							$process->update('type');
							ProcessLog::deleteLog($process->id, ShipmentProcess::TYPE_AQIS);
						}
					}
				}
				if (!empty($model->sea_process)) {
					$seaPrcoess=$model->sea_process;
					if (!in_array(2048, $_POST['clear_reasons'])) {
						$seaPrcoess->deleteProcess();
					}
				}
				$model->updateHeldTrackingReason();
			} else {
				$model->afterClear();
				$model->bwf=$model->bwf&64^$model->bwf;// clear DDP
				$model->bwf=$model->bwf&128^$model->bwf; //clear DDU
				$model->bwf=$model->bwf&2^$model->bwf; //clear shang yi
				$model->bwf=$model->bwf&~2048; //clear 海运散货
							  if (!empty($model->sea_process)) {
								$seaPrcoess=$model->sea_process;
							 
								$seaPrcoess->deleteProcess();
							  }
			}
			$model->save();
			$this->ajaxResult($model);
		}
		$this->render('clear_reason', ['model'=>$model]);
	}


