	public function actionExportAllSKP()
	{
		$cargoProcess = CargoProcess::model()->with("shipment")->findAll("t.dpt_id=:podId and shipment.ref like 'SKP%' and t.status <= :status",[":podId"=>Org::TLA_DEPARTMENT_SYDNEY,":status"=>CargoProcess::WAITINGASSIGNDRIVER]);
		$xls = new oExcel;
		$i = 1;
		// $xls->addRow($i++, ['WBN', 'Ref','Awb','Packages', 'Weight', 'Status', 'Agent', 'Sender', 'Sender Tel', 'Cnee Name', 'Cnee Tel', 'Address', 'State', 'Date', 'Delay','Extra Info']);
		$xls->addRow($i++, ['WBN', 'Ref','Consol No','Packages', 'Weight','Total CBM','Status', 'Cnee Name', 'Cnee Company',  'Cnee Tel', 'Address','suburb', 'State', 'Postcode','Rack','Memo','Cargo Type']);

		foreach ($cargoProcess as $r) {
			$ca = $r;
			$r = $r->shipment;
			if (empty($r->cnee)) {
				continue;
			}
			$isB2B = '';
			if(isset($r->mdata['is_b2b']))
			{
				$isB2B = empty($r->mdata['is_b2b'])?0:1;
			}

			$xls->addRow($i++, [$r->hbn, $r->ref,empty($r->consol)? '' : $r->consol->no,$r->pkg, $r->weight,$r->cbm*$r->pkg, $r->getStatus(), $r->cnee->name,$r->cnee->company ,$r->cnee->tel,$r->cnee->address,$r->cnee->suburb, $r->cnee->state,$r->cnee->postcode,$r->getRackName(),$r->can,CargoProcess::$cargoTypeList[$ca->type]]);
		}
		$xls->output('imp_search_export_'.time().'.xlsx');
	}

	public function actionExportMixSelection()
	{
		$shipments = ImParcel::model()->with(['consol'])->findAll('agent_id =1804 and consol_id>0 and hbn like "2020%" and consol.dpt_id = 106 and t.created>"2020-12-01" and t.created<"2021-01-01"');
		$xls = new oExcel;
		$i = 1;
		// $xls->addRow($i++, ['WBN', 'Ref','Awb','Packages', 'Weight', 'Status', 'Agent', 'Sender', 'Sender Tel', 'Cnee Name', 'Cnee Tel', 'Address', 'State', 'Date', 'Delay','Extra Info']);
		$xls->addRow($i++, ['WBN', 'Ref','Packages', 'Weight','Total CBM','Status', 'Cnee Name', 'Cnee Company',  'Cnee Tel', 'Address','suburb', 'State', 'Postcode','Selected Courier','Cheapest Cost','Au cost','PK cost','TNT cost','Toll cost','SF cost']);

		foreach ($shipments as $k =>$r) {
			if (empty($r->cnee)) {
				continue;
			}
			$courierArr = [];
			$checkDistance = 150;
			$truckId = ImportChargeCode::TRUCK_SYD_ID;
			$tntId = ImportChargeCode::TNT_SYDNEY_ID_TOP;
			$eizTollId =ImportChargeCode::EIZ_TOLL_ID;
			$eizAPI = new EizAPI('syd');
			$tntAPI = TntAPI::getTntInterface('syd_top');
			$AuspostCost =Shipment::getCourierCostByShipment($r->ref, 730, $r->weight);
			$SFCost =Shipment::getCourierCostByShipment($r->ref, 854, $r->weight);
			$distance = GoogleMapAPI::getDistance($r,Org::PCAE_DEPARTMENT_SYDNEY);
			$tntCost = $tntAPI->getTntCost($r,$tntId);
			$tollCost = $eizAPI->getQuoteTollPrice($r);
			$truckResult = Shipment::getCourierCostByShipment($r->ref,ImportChargeCode::AUSTWAY_TRUCK_DELIVERY,$r->myChargeCBM());

			if($distance<$checkDistance)
			{
				if(!empty($truckResult)&&!empty($truckResult['price']))
				{
					$courierArr[$truckId] = $truckResult['price'];
				}
			}

			if(!empty($AuspostCost['price']))
			{
				$courierArr[730] = $AuspostCost['price'];
			}

			if(!empty($SFCost['price']))
			{
				$courierArr[854] = $SFCost['price'];
			}


			if(!empty($tntCost))
			{
				$courierArr[$tntId] = $tntCost;
			}

			if(!empty($tollCost))
			{
				$courierArr[$eizTollId] = $tollCost;
			}

			$courier = 999;
			$cheapCost = 9999;
			$result = false;
			foreach ($courierArr as $key => $c) {
				if($c<$cheapCost)
				{
					$courier = $key;
					$cheapCost = $c;
				}
			}
			$selectedCourier = OrgRate::model()->findByPk($courier)->org;
			$selectedCourier = str_replace('Eiz', 'Toll', $selectedCourier->name);
			$xls->addRow($i++, [$r->hbn, $r->ref,$r->pkg, $r->weight,$r->cbm*$r->pkg, $r->getStatus(), $r->cnee->name,$r->cnee->company ,$r->cnee->tel,$r->cnee->address,$r->cnee->suburb, $r->cnee->state,$r->cnee->postcode,$selectedCourier,$cheapCost,@$courierArr[730],@$courierArr[$truckId],@$tntCost,@$tollCost,@$courierArr[854]]);
		}
		$xls->output('imp_search_export_'.time().'.xlsx');
	}

	public function actionExportAllChangedLabelShipment()
	{
		$labels = DfeChangeLabel::model()->findAll(['condition'=>'allied_ref not like "AOE%"','group'=>' pid ']);
		$xls = new oExcel;
		$i = 1;
		// $xls->addRow($i++, ['WBN', 'Ref','Awb','Packages', 'Weight', 'Status', 'Agent', 'Sender', 'Sender Tel', 'Cnee Name', 'Cnee Tel', 'Address', 'State', 'Date', 'Delay','Extra Info']);
		$xls->addRow($i++, ['Courier','Agent','WBN', 'Ref','Pre Ref','Packages', 'Weight','Total CBM','Status','Changed Date']);

		foreach ($labels as $key => $label)
		{
			$r = ImParcel::model()->findByPk($label->pid);
			$rate = OrgRate::model()->findByPk($r->mdata['org_rate_id']);
			if (empty($r->cnee)||empty($rate)) {
				continue;
			}
			$org = $rate->org;

			$isB2B = '';
			if(isset($r->mdata['is_b2b']))
			{
				$isB2B = empty($r->mdata['is_b2b'])?0:1;
			}

			$xls->addRow($i++, [$org->name,$r->agent->name,$r->hbn, $r->ref,$label->dfe_ref,$r->pkg, $r->weight,$r->cbm*$r->pkg, $r->getStatus(),date('Y-m-d',strtotime($label->create))]);
		}
		$xls->output('imp_search_export_'.time().'.xlsx');
	}

