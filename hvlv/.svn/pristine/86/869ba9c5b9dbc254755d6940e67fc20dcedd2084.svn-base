	/*import special instructions from customer
	 *
	 */
	public function actionImportInstruction()
	{
		if (!empty($_FILES['instruction_file'])) {
			if (!empty($_FILES['instruction_file']['tmp_name'])) {
				$file=$_FILES['instruction_file'];
				$xls=new oExcel();
				$xls->supported($file['name']);
				$xls->load($file['tmp_name']);
				$data=$xls->getAll();
				if (!empty($data[1])) {
					if (preg_match("/^转运单号渠道名称/i", implode('', $data[1]))) {
						unset($data[1]);
						$o='';
						foreach ($data as $index=>$d) {
							if (empty($d[1])) {
								continue;
							}
							if (trim($d[2])!="商壹") {
								continue;
							}
							$shipment= ImParcel::model()->find('ref=:ref', [':ref'=>trim($d[1])]);
							if (!empty($shipment)) {
								$shipment->bwf=$shipment->bwf|2;
								$shipment->update(['bwf']);
							} else {
								$o.="<p style='color:red;'>Shipment ".$d[1]."not found in the system</p>";
							}
						}
						$o.="<p style='color:green;'>Succesfully</p>";
						echo $o;
					} else {
						echo '<p style="color:red"> The template is wrong!</p>';
					}
				} else {
					echo '<p style="color:red"> The file not contain valid content</p>';
				}
			} else {
				echo '<p style="color:red"> The file is not valid</p>';
			}
			return;
		}
		 
		$this->render('import');
	}
	 
	public function actionUpdateStartrack($id)
	{
		$resp=['success'=>0,'msg'=>'not update succesfully!'];
		$model=$this->loadModel($id);
		if (!preg_match('/(7RFZ|4XHZ)\d{8}/i', $model->ref)) {
			echo json_encode($resp);
		} else {
			if (empty($model->mdata['ss_shipment_items'])) {
				echo json_encode($resp);
				return;
			} else {
				if (preg_match('/4XHZ\d{8}/i', $model->ref)) {
					$ss= new StarTrackAPI('mel', true);
				} else {
					$ss = new StarTrackAPI('syd', true);
				}
				$result = $ss->updateShipment($model->mdata['ss_shipment_id'], $model);
				$respLabel = $ss->createLabels([$model->mdata['ss_shipment_id']]);
				$result= (array) $result;
				if (empty($result)||isset($result['warnings'])) {
					$theResult=$ss->getShipments($model->mdata['ss_shipment_id']);
					$theResult = $theResult->shipments[0];
					if ($theResult->items[0]->tracking_details->consignment_id!=$model->ref) {
						$resp=['success'=>0,'msg'=>'the label number already be changed, please contact the technician!'];
						echo json_encode($resp);
						return;
					}
					$resp=['success'=>1,'msg'=>'update succesfully!'];
					echo json_encode($resp);
				} else {
					echo json_encode($resp);
					return;
				}
			}
		}
	}

