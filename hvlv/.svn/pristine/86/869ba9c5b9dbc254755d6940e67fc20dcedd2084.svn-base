	/*this is used to check the imparcel cost based on  postcode,weigt,service options
	 *
	 *
	 */
	public function actionCostCheck()
	{
		if (isset($_POST['flag'])) {
			$resp=['done'=>true,'msg'=>''];
			
			if (!empty($_POST['suburb'])) {
				$suburb=$_POST['suburb'];
			} else {
				$resp['msg']='<div style="color:red;">Please supply the suburb<div>';
				echo json_encode($resp);
				return;
			}
			if (!empty($_POST['postcode'])) {
				$postcode=$_POST['postcode'];
			} else {
				$resp['msg']='<div style="color:red;">Please supply the postcode<div>';
				echo json_encode($resp);
				return;
			}
			if (!empty($_POST['weight'])) {
				$weight=$_POST['weight'];
			} else {
				$resp['msg']='<div style="color:red;">Please supply the weight<div>';
				echo json_encode($resp);
				return;
			}
			if (!empty($_POST['courier'])) {
				$courier=$_POST['courier'];
			}
			$apost=Postcode::model()->find('postcode=:postcode AND suburb=:suburb AND country="AU"', [':postcode'=>$postcode,':suburb'=>$suburb]);
			if (!empty($apost)) {
				$state=$apost->state;
				if (empty($courier)) {
					$rp=$this->selectAuCourier($suburb, $postcode, $state, $weight, array_keys(ImParcel::$couriers));
				} else {
					$rp=$this->selectAuCourier($suburb, $postcode, $state, $weight, [$courier]);
				}
				if (!empty($rp['done'])) {//success we need to output the courier and cost
					$selectCourier= ImParcel::$couriers[$rp['courier'][0]];
					$resp['msg']='<div>Courier: '.$selectCourier.' Cost: '.$rp['cost'].'</div>';
					echo json_encode($resp);
					return;
				} else {//failed we need to output the msg
					$selectCourier='';
					foreach ($rp['courier'] as $c) {
						$selectCourier.='  '.ImParcel::$couriers[$c];
					}
					$resp['msg']='<div style="color:red">Couriers: '.$selectCourier.' msg: '.$rp['msg'].'</div>';
					echo json_encode($resp);
					return;
				}
			} else {
				$resp['msg']='<div style="color:red;">Please check the spell of suburb and postcode<div>';
				echo json_encode($resp);
				return;
			}
		}
		$this->render('cost_check');
	}
 
	  
	public function selectAuCourier($suburb, $postcode, $state, $weight, $couriers=[38,44,52])
	{
		$resp=['done'=>1, 'courier'=>'','cost'=>0, 'msg'=>''];
		$minCost = 99999; // in order to get minimum one
		$cheapOrgRate = null;
		$getCheapOrgRateError = '';
		$tp = new ImParcel;
		$tp->weight = $weight;
		$tp->pkg = 1;
		$tp->cnee = new Addr;
		$tp->cnee->state = $state;
		$tp->cnee->postcode = $postcode;
		$tp->cnee->suburb = $suburb;
		foreach ($couriers as $courier) {
			$orgRate = OrgRate::model()->findByPk($courier);
			if (ChooseShipment::courierCanDelivery($orgRate->org_id, $ts, false)) {
				$selectedOrgRates[]=$orgRate;
			}
		}
		if (empty($selectedOrgRates)) { //empty means not in the delivery area.
			$resp['done']=0;
			$resp['courier']=$couriers;
			$resp['msg']='Not In delivery Area';
			return $resp;
		}
		foreach ($selectedOrgRates as $orgrate) {
			// get cost based on org rate
			$cost = ImcoConsol::getCourierCostPrice($orgrate, $postcode, $weight);
			if ($cost > 0 &&  $cost < $minCost) {
				$minCost = $cost;
				$cheapOrgRate = $orgrate;
			}
		}
		if (!empty($cheapOrgRate)) {
			$resp['courier']=[$cheapOrgRate->id];
			$resp['cost']=$minCost;
			return $resp;
		} else {
			$resp['done']=0;
			$resp['courier']=$couriers;
			$resp['msg']='Not set cost for this area';
			return $resp;
		}
	}

	public function actionCreateLabel()
	{
		$resp=['done'=>true,'msg'=>''];
		if (isset($_POST['shipment_hbn'])) {
			if (empty($_POST['label_type'])) {
				$resp['done']='false';
				$resp['msg']='Please Choose The Label Type';
				echo json_encode($resp);
				return;
			}
			foreach (preg_split("/[;,]/i", $_POST['shipment_hbn']) as $hbn) {
				if (empty(trim($hbn))) {
					continue;
				}
				$p= ImParcel::model()->find('hbn=:hbn and status !=100', [':hbn'=>$hbn]);
				if (!empty($p)) {
					// clear all old tranship
					Tranship::model()->deleteAll('pid = :pid', [':pid' => $p->id]);
					$p->unsetMetaFlag();
					$cl = false;
					switch ($_POST['label_type']) {
						case 'eParcel-syd':
							$courier = OrgRate::model()->findByPk(ImportChargeCode::SYDNEY_AUPOST_ID);
							$cl =  $p->createCourierLabel($courier);
							break;
						case 'eParcel-syd-express':
							$courier = OrgRate::model()->findByPk(ImportChargeCode::AUPOST_EXPRESS_ID);
							$cl =  $p->createCourierLabel($courier);
							break;
						case 'eParcel-mel':
							$cl = $p->createAuPostLabel('33EVH');
							break;
						case 'eParcel-bne':
							$courier = OrgRate::model()->findByPk(ImportChargeCode::BRISBANE_AUPOST_ID);
							$cl = $p->createCourierLabel($courier);
							break;
						case 'eParcel-per':
							$cl = $p->createAuPostLabel('34AWE');
							break;
						case 'startrack-syd':
							$cl = $p->createStartrackLabel('syd');
							break;
						case 'startrack-mel':
							$cl = $p->createStartrackLabel('mel');
							break;
						case 'fastway-syd':
							$cl = $p->createFastwayLabel();
							break;
						case 'fastway-mel':
						 	$p->mdata['org_rate_id'] = ImportChargeCode::FASTWAY_MEL_3PL_ID;
							$cl = $p->createFastwayLabel('mel');
							break;
						case 'tnt-syd':
							$cl = $p->createTntLabel('syd');
							break;
						case 'tnt-mel':
							$cl = $p->createTntLabel('mel');
						break;
						case 'tnt-bne':
							$cl = $p->createTntLabel('bne');
						break;
						case 'tnt-syd-top':
							$courier = OrgRate::model()->findByPk(ImportChargeCode::TNT_SYDNEY_ID_TOP);
							$rt = ChooseShipment::courierCanDelivery(Org::ORGID_COURIER_TNT_TOP, $p,true,ImportChargeCode::TNT_SYDNEY_ID_TOP);
							if(!$rt->success){
								$cl = false;
								break;
							}

							$cl =  $p->createCourierLabel($courier);
							break;
						case 'tnt-mel-top':
							$courier = OrgRate::model()->findByPk(ImportChargeCode::TNT_MELBOURNE_ID_TOP);
							$rt = ChooseShipment::courierCanDelivery(Org::ORGID_COURIER_TNT_TOP, $p,true,ImportChargeCode::TNT_MELBOURNE_ID_TOP);
							if(!$rt->success){
								$cl = false;
								break;
							}

							$cl =  $p->createCourierLabel($courier);
							break;
						break;
						case 'tnt-bne-top':
							$courier = OrgRate::model()->findByPk(ImportChargeCode::TNT_BRISBANE_ID);
							$rt = ChooseShipment::courierCanDelivery(Org::ORGID_COURIER_TNT_TOP, $p,true,ImportChargeCode::TNT_BRISBANE_ID);
							if(!$rt->success){
								$cl = false;
								break;
							}

							$cl =  $p->createCourierLabel($courier);
							break;
						break;
						case 'tnt-per-top':
							$courier = OrgRate::model()->findByPk(ImportChargeCode::TNT_PERTH_ID_TOP);
							$rt = ChooseShipment::courierCanDelivery(Org::ORGID_COURIER_TNT_TOP, $p,true,ImportChargeCode::TNT_PERTH_ID_TOP);
							if(!$rt->success){
								$cl = false;
								break;
							}

							$cl =  $p->createCourierLabel($courier);
							break;
						break;
						case 'winit-eparcel-syd':
							$cl = $p->createWinitLmaLabel();
						break;
						case 'winit-express-syd':
							$cl = $p->createWinitLmaLabel(true, '');
						break;
						case 'hunter':
							$cl = $p->createHunterLabel();
							break;
						case 'd2z-syd':
							$cl = $p->createD2zLabel('syd');
							break;
						case 'd2z-mel':
							$cl = $p->createD2zLabel('mel');
							break;
						case 'd2z-bri':
							$cl = $p->createD2zLabel('bri');
							break;
						case 'd2z-per':
							$cl = $p->createD2zLabel('per');
							break;
						case 'd2z-local':
							$cl = $p->createD2zLabel('local');
							break;
						case 'd2z-local-mel':
							$cl = $p->createD2zLabel('local-mel');
							break;
						case 'ubi-local-MELWW':
						case 'ubi-local-SYDWW':
						case 'ubi-local-BNE':
						case 'ubi-local-PER':
							$facility = explode('ubi-local-', $_POST['label_type'])[1];
							$orgRate = OrgRate::model()->find("org_id = :org_id AND json_value(meta,'$.facility') = :facility and json_value(meta,'$.service_code')='UBI.AU2AU.AUPOST'", [":org_id"=>Org::ORGID_COURIER_UBI,":facility"=>$facility]);
							$cl = $p->createUbiLabel($orgRate,$facility);
							break;
						case 'ubi-toll-syd':
							$facility = explode('ubi-toll-', $_POST['label_type'])[1];
							$orgRate = OrgRate::model()->findByPk(952);
							$cl = $p->createUbiLabel($orgRate,$facility);
							break;
						case 'ubi-toll-mel':
							$facility = explode('ubi-toll-', $_POST['label_type'])[1];
							$orgRate = OrgRate::model()->findByPk(955);
							$cl = $p->createUbiLabel($orgRate,$facility);
							break;
						case 'eParcel-ecof':
							$cl = $p->createAuPostLabel('33MBQ');
							break;
						case 'gv-4port':
							$cl = $p->createAuPostLabel('UWQ');
							break;
						// case 'dfe-syd':
						// 	$cl = $p->createDfeLabel(ImportChargeCode::DFE_ID,'syd');
						// 	break;
						case 'dfe-syd-top':
							$cl = $p->createDfeLabel(ImportChargeCode::DFE_ID_TOP,'syd_top');
							break;
						// case 'dfe-mel-top':
						// 	$cl = $p->createDfeLabel(ImportChargeCode::DFE_MEL_ID_TOP,'mel_top');
						// 	break;
						// case 'dfe-bne-top':
						// 	$cl = $p->createDfeLabel(ImportChargeCode::DFE_BNE_ID_TOP,'bne_top');
						// 	break;
						case 'eiz-allied-syd':
							$cl = $p->createEizLabel(ImportChargeCode::EIZ_ALLIED_ID,'syd_allied');
							break;
						case 'eiz-allied-mel':
							$cl = $p->createEizLabel(ImportChargeCode::EIZ_ALLIED_MEL_ID,'mel_allied');
							break;
						case 'eiz-allied-bne':
							$cl = $p->createEizLabel(ImportChargeCode::EIZ_ALLIED_BNE_ID,'bne_allied');
							break;
						case 'eiz-allied-per':
							$cl = $p->createEizLabel(ImportChargeCode::EIZ_ALLIED_PER_ID,'per_allied');
							break;

						case 'eiz-border-syd':
							$cl = $p->createEizLabel(ImportChargeCode::EIZ_BORDER_ID,'syd_border');
							break;
						case 'eiz-border-mel':
							$cl = $p->createEizLabel(ImportChargeCode::EIZ_BORDER_MEL_ID,'mel_border');
							break;
						case 'eiz-border-bne':
							$cl = $p->createEizLabel(ImportChargeCode::EIZ_BORDER_BNE_ID,'bne_border');
							break;
						case 'eiz-border-per':
							$cl = $p->createEizLabel(ImportChargeCode::EIZ_BORDER_PER_ID,'per_border');
							break;


						case 'eiz-toll-syd':
							$cl = $p->createEizLabel(ImportChargeCode::EIZ_TOLL_ID,'syd');
							break;
						case 'eiz-toll-mel':
							$cl = $p->createEizLabel(ImportChargeCode::EIZ_TOLL_MEL_ID,'mel');
							break;
						case 'eiz-toll-bne':
							$cl = $p->createEizLabel(ImportChargeCode::EIZ_TOLL_BNE_ID,'bne');
							break;
						case 'pickup':
							$courier = new stdClass;
							$courier->org_id = Org::ORGID_COURIER_PICKUP;
							$cl = $p->createCourierLabel($courier);
							break;
						case 'pickup_non_ref':
							$courier = OrgRate::model()->find(["condition"=>"code = :code","params"=>[":code"=>ImportChargeCode::PICKUP_NON_REF_CODE],"order"=>"id desc"]);
							$cl = $p->createCourierLabel($courier);
							break;
						case 'eparcel-chukou1':
							$cl = $p->createChukou1Label(ImportChargeCode::CHUKOU1_ID,'syd');
							break;	
						case 'sf-syd':
							$cl = $p->createSFLabel(ImportChargeCode::SF_ID,'syd');
							break;
						case 'sf-mel':
							$cl = $p->createSFLabel(ImportChargeCode::SF_MEL_ID,'syd_truck');
							break;	

						case 'mytoll-syd':
							$rt = ChooseShipment::courierCanDelivery(Org::ORGID_COURIER_TOLL_IPEC, $p,true,ImportChargeCode::MYTOLL_SYD_ID);
							if(!$rt->success){
								$cl = false;
								break;
							}

							$cl = $p->createMyTollLabel(ImportChargeCode::MYTOLL_SYD_ID,'syd');
							break;
						
						case 'mytoll-syd-plt':
							$cl = $p->createMyTollLabel(ImportChargeCode::MYTOLL_SYD_PLT_ID,'syd_plt');
							break;

						case 'mytoll-mel':
							$rt = ChooseShipment::courierCanDelivery(Org::ORGID_COURIER_TOLL_IPEC, $p,true,ImportChargeCode::MYTOLL_MEL_ID);
							if(!$rt->success){
								$cl = false;
								break;
							}

							$cl = $p->createMyTollLabel(ImportChargeCode::MYTOLL_MEL_ID,'mel');
							break;
						case 'mytoll-bne':
							$rt = ChooseShipment::courierCanDelivery(Org::ORGID_COURIER_TOLL_IPEC, $p,true,ImportChargeCode::MYTOLL_BNE_ID);
							if(!$rt->success){
								$cl = false;
								break;
							}
							$cl = $p->createMyTollLabel(ImportChargeCode::MYTOLL_BNE_ID,'bne');
							break;
						case 'mytoll-per':
							$rt = ChooseShipment::courierCanDelivery(Org::ORGID_COURIER_TOLL_IPEC, $p,true,ImportChargeCode::MYTOLL_PER_ID);
							if(!$rt->success){
								$cl = false;
								break;
							}
							$cl = $p->createMyTollLabel(ImportChargeCode::MYTOLL_PER_ID,'per');
							break;
						case 'gv-eParcel-syd':
							$cl = $p->createGVAuPostLabel('34KHX',ImportChargeCode::SYDNEY_GV_AUPOST_ID);
							break;
						case 'gv-eParcel-mel':
							$cl = $p->createGVAuPostLabel('34KG6',ImportChargeCode::MELBOUNE_GV_AUPOST_ID);
							break;
						case 'gv-eParcel-bne':
							$cl = $p->createGVAuPostLabel('34KHY',ImportChargeCode::BRISBANE_GV_AUPOST_ID);
							break;
						case 'gv-eParcel-per':
							$cl = $p->createGVAuPostLabel('34KHW',ImportChargeCode::PERTH_GV_AUPOST_ID);
							break;
						case 'TLD-mel':
							$courier = OrgRate::model()->findByPk(ImportChargeCode::TRUCK_MEL_ID);
							$cl =  $p->createCourierLabel($courier);
							break;
					}

					if($cl){
						$resp['msg'] .= $p->hbn.' created Successfully! | ';
					} else {
						$resp['msg'] .= $p->hbn. ' failed!'.(empty($p->tempErrors)? '' : ' '.$p->tempErrors);
						$resp['done'] = false;
					}
				} else {
					$resp['msg'].=$hbn. 'not found!';
					$resp['done']=false;
				}
			}
			echo json_encode($resp);
			return;
		}
		$this->render('create_label');
	}
  
	/**
	 * Save the invoice amount for generate custom invoice for consignee.
	 * The invoice will be generated when customer confirm the entry and we have.
	 * Required the broker to pay for the declaration.
	 * @param Integer the ID of the model.
	 */
	public function actionCustomInv($id)
	{
		$model= $this->loadModel($id);
		/*if (isset($_POST['custom_inv_amount'])) {
			$model->mdata['custom_inv_amount']= floatval($_POST['custom_inv_amount']);
			$model->cbwf = empty($_POST['custom_inv_created'])? $model->cbwf & ~512 : $model->cbwf | 512;
			if (isset($_POST['cust_duty_lines'])) {
				$model->mdata['cust_duty_lines']=intval($_POST['cust_duty_lines']);
			}
			$model->save();
			$this->ajaxResult($model);
		}*/
		if(!empty($_POST['InvLine'])){
			if(!empty($_POST['ImParcel']['owner_id'])) $model->owner_id = $_POST['ImParcel']['owner_id'];
			foreach ($_POST['InvLine'] as $key => &$value) {
				if(!is_array($value))
				{
					$value = [$value];
				}
			}
			$model->mdata['custom_inv'] = $_POST['InvLine'];
			$model->cbwf = empty($_POST['custom_inv_created'])? $model->cbwf & ~512 : $model->cbwf | 512;
			$model->save();
			$this->ajaxResult($model);
		}
		$this->render('custom_amount', ['model'=>$model]);
	}
