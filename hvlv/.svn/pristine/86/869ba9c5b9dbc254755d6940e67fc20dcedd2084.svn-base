	public function actionExport()
	{
		if (isset($_GET['ImParcel'])) {
			$model=new ImParcel('search');
			$model->unsetAttributes();  // clear any default values
			$model->attributes=$_GET['ImParcel'];
		}

		if(!empty($_GET['TplParcel']))
		{
			$model=new TplParcel('search');
			$model->unsetAttributes();  // clear any default values
			$model->attributes=$_GET['TplParcel'];
		}

		if (!Acl::hasAccess('B:Import/SeeAllShipments')) {
			$model->agent_id = Yii::app()->user->org;
		}
		$dp = $model->search(false);
		if (!empty($_GET['typ'])&&$_GET['typ']!='dfe') {
			if ($_GET['typ'] == 'clabel') {
				$imparcelService = new ImParcelService();
				$imparcelService->getAutoImparcelLabelMulti($dp->data);

			}elseif ($_GET['typ'] == 'plabel') {
				$imparcelService = new ImParcelService();
				$imparcelService->getAutoImparcelLabelMulti($dp->data);

			}elseif ($_GET['typ'] == 'dgdoc') {
				$td = Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR;
				$ps=[];
				foreach ($dp->data as $shipment) 
				{
					$trans = $shipment->trans;
					if(!empty($trans)&&(end($trans)->org_id == Org::ORGID_COURIER_PCA))continue;
					if (empty($shipment->mdata['is_dg'])) continue;
					$tf = tempnam($td, "stmt");
					oPDF::renderPDF('dg_document', ['model' => $shipment], 2, $tf);
					$ps[] = $tf;
				}
				oPDF::mergePDF($ps, 1, true, 'dg_documents.pdf');
			}elseif ($_GET['typ'] == 'sodoc') {
				$td = Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR;
				$ps=[];
				foreach ($dp->data as $shipment) 
				{
					if ($shipment->consol->service == 10) {
						throw new CHttpException(404, $shipment->ref.' Only Sea Type Has Sea Order.');
					}
					if($shipment->isTLA())
					{
						Yii::app()->name = 'TLA';
					}
					$tf = tempnam($td, "stmt");
					oPDF::renderPDF('sea_order', ['model' => $shipment], 2, $tf);
					$ps[] = $tf;
				}
				oPDF::mergePDF($ps, 1, true, 'sea_order_documents.pdf');
			}elseif($_GET['typ'] == 'amiauto')
			{
				$txt ="";
				foreach ($dp->data as $p) 
				{
					$consol = $p->consol;
					$addr = Edimsg::strEscape($p->cnee->address);
					$ls = AppHelper::mbstr_split($addr, 35);
			$txt .='webpage_id=pca
uac_code=TOPLOGSYD
rpid=67119225133
h_mawb='.$consol->awb.'
no_hawb=1
h_origin='.$consol->pol.'
h_dest='.$consol->pod.'
h_port_load=
h_port_discharge=
h_flight_no='.$consol->flight.'
eta_date='.date('d/m/y', strtotime($consol->eta)).'
prim_hawb='.(empty($consol->mdata['house_bill'])? '' : $consol->mdata['house_bill']).'
h_hawb='.$p->hbn.'
consig_name='.Edimsg::strEscape($p->cnee->name).'
consig_addr1='.$ls[0].'
consig_addr2='.(empty($ls[1])? '' : $ls[1]).'
consig_city='.$p->cnee->suburb.'
consig_state='.$p->cnee->state.'
consig_zip='.$p->cnee->postcode.'
consig_country=AU
consig_phone='.$p->cnee->tel.'
consig_contact=
ship_name='.Edimsg::strEscape($p->cnor->name).'
ship_addr1='.Edimsg::strEscape($p->cnor->address).'
ship_addr2='.$p->cnor->suburb.'
ship_city='.$p->cnor->city.'
ship_state='.$p->cnor->state.'
ship_zip='.$p->cnor->postcode.'
ship_country=CN
pieces='.$p->pkg.'
act_weight='.$p->weight.'
narr='.substr($p->getGoods(), 0, 30).'
ppc_ccx=P
email_addr=
notes=
customs='.$p->getDvalue().'
customs_curr=AUD
landed=
sac_ind=Y
order_no=
vendor_id=
importer_id=
gst_paid=
ip_addr=127.0.0.1
';
				}

				header("Cache-Control: maxage=1");
				header("Content-Type: application/force-download");
				header("Content-Disposition: attachment;filename=\"webmation.txt\"");
				header("Content-Length: ".strlen($txt));
				echo $txt;
				Yii::app()->end();

			}elseif($_GET['typ']=='dfeCost')
			{
				$dfeAPI = new DFEAPI('syd');
				$alliedAPI = new EizAPI('syd_allied');
				$tntAPI = TntAPI::getTntInterface('syd');
				$xls = new oExcel;
				$i = 1;
				// $xls->addRow($i++, ['WBN', 'Ref','Awb','Packages', 'Weight', 'Status', 'Agent', 'Sender', 'Sender Tel', 'Cnee Name', 'Cnee Tel', 'Address', 'State', 'Date', 'Delay','Extra Info']);
				$xls->addRow($i++, ['WBN', 'Ref','Consol No','Packages', 'Weight','Total CBM','Status', 'Cnee Name', 'Cnee Company',  'Cnee Tel', 'Address','suburb', 'State', 'Postcode','Rack','Memo','isB2B','DFE','Allied','Toll','TNT']);

				foreach ($dp->data as $r) {
					if (empty($r->cnee)) {
						continue;
					}
					$isB2B = 0;
					if(!empty($r->cnee->company))
					{
						$isB2B = 1;
					}

					if(isset($r->mdata['is_b2b']))
					{
						$isB2B = empty($r->mdata['is_b2b'])?0:1;
					}

					$dfeCost = $dfeAPI->getCost(ImportChargeCode::DFE_ID_TOP, $r->cnee->suburb, $r->cnee->postcode, $r->getCubeWeight())->data;
					$tntCost = $tntAPI->getTntCost($r);
					$elzCost = $alliedAPI->getQuotePrice($r);
					$alliedCost = empty($elzCost['allied'])?0:$elzCost['allied']['amount'];
					$tollCost = empty($elzCost['toll'])?0:$elzCost['toll']['amount'];

					$xls->addRow($i++, [$r->hbn, $r->ref,empty($r->consol)? '' : $r->consol->no,$r->pkg, $r->weight,$r->cbm*$r->pkg, $r->getStatus(), $r->cnee->name,$r->cnee->company ,$r->cnee->tel,$r->cnee->address,$r->cnee->suburb, $r->cnee->state,$r->cnee->postcode,$r->getRackName(),$r->can,$isB2B,$dfeCost,$alliedCost,$tollCost,$tntCost]);
				}
				$xls->output('imp_search_export_'.time().'.xlsx');

			}
		} else {
			$xls = new oExcel;
			$i = 1;
			// $xls->addRow($i++, ['WBN', 'Ref','Awb','Packages', 'Weight', 'Status', 'Agent', 'Sender', 'Sender Tel', 'Cnee Name', 'Cnee Tel', 'Address', 'State', 'Date', 'Delay','Extra Info']);
			if($_GET['typ']=='dfe')
			{
				$xls->addRow($i++, ['WBN', 'Ref','Consol No','Packages', 'Weight','Total CBM','Status', 'Cnee Name', 'Cnee Company',  'Cnee Tel', 'Address','suburb', 'State', 'Postcode','Rack','Memo','is_B2B(1yes 0No)']);
			}else
			{
				$xls->addRow($i++, ['WBN', 'Ref','Consol No','Consol Eta','Awb','Packages', 'Weight', 'Status', 'Agent','Shipper Name','Shipper Address', 'Cnee Name', 'Cnee Tel', 'Address', 'State', 'Postcode', 'Date', 'Delay','Extra Info','Memo','Rack','Cref','Cust_invoice_ref','Marks and numbers']);
			}

			foreach ($dp->data as $r) {
				if (empty($r->cnee)) {
					continue;
				}
				$ln = $r->getLastLog();
				$extraInfo=$r->getExtraInfo();
				$dd = empty($ln)? 0 : ceil((time() - strtotime($ln->time)) / 86400);
				// $xls->addRow($i++, [$r->hbn, $r->ref, empty($r->consol)? '' : $r->consol->awb,$r->pkg,$r->weight, $r->getStatus(), empty($r->agent)? '' : $r->agent->name, $r->cnor->name, '="'.$r->cnor->tel.'"', $r->cnee->name, '="'.$r->cnee->tel.'"', $r->cnee->address, $r->cnee->state, $r->created, $dd,$extraInfo]);
				if($_GET['typ']=='dfe')
				{
					$trans = $r->trans;
					if(!empty($trans)&&end($trans)->org_id==Org::ORGID_COURIER_DFE_TOP)
					{
						$isB2B = '';
						if(isset($r->mdata['is_b2b']))
						{
							$isB2B = empty($r->mdata['is_b2b'])?0:1;
						}

						$xls->addRow($i++, [$r->hbn, $r->ref,empty($r->consol)? '' : $r->consol->no,$r->pkg, $r->weight,$r->cbm*$r->pkg, $r->getStatus(), $r->cnee->name,$r->cnee->company ,$r->cnee->tel,$r->cnee->address,$r->cnee->suburb, $r->cnee->state,$r->cnee->postcode,$r->getRackName(),$r->can,$isB2B]);
					}
				}else
				{
					$xls->addRow($i++, [$r->hbn, $r->ref,empty($r->consol)? '' : $r->consol->no,@$r->consol->eta,empty($r->consol)? '' : $r->consol->awb,$r->pkg,$r->weight, $r->getStatus(), empty($r->agent)? '' : $r->agent->name,$r->cnor->name,
						$r->cnor->address, $r->cnee->name, '="'.$r->cnee->tel.'"', $r->cnee->address, $r->cnee->state, $r->cnee->postcode, $r->created, $dd,$extraInfo,$r->can,$r->getRackName(),$r->cref,@$r->mdata['cust_invoice_ref'],@$r->mdata['sea_mark_number']]);
				}
			}
			$xls->output('imp_search_export_'.time().'.xlsx');
		}
	}

