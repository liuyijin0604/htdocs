	public function actionFileUpdate($id)
	{
		$model=FileRepo::model()->findByPk($id);
		if ($model===null) {
			throw new CHttpException(404, 'The requested page does not exist.');
		}

		// Uncomment the following line if AJAX validation is needed
		// $this->performAjaxValidation($model);

		if (isset($_POST['FileRepo'])) {
			$model->attributes=$_POST['FileRepo'];
			if ($model->save()) {
				if ($_POST['FileRepo']['status']==0&&$model->type==25) {
					//POD FILE, IF DELETE, WE NEED TO REMOVE THE TRACKING;
					if ($model->fid>0) {
						$shipment= ImParcel::model()->findByPk($model->fid);
						if (!empty($shipment)) {
							$tracking =Tracking::model()->find('pid=:pid and type=71 ORDER BY id DESC', [':pid'=> $shipment->id]);
							if (!empty($tracking)) {
								$tracking->delete();
							}
							$shipment->updatePodTrackingUrl();
						}
					}
				}
				$this->ajaxResult($model);
			}
		}

		$this->render('update_file', [
			'model'=>$model,
		]);
	}
	
	
	/**
	* produce the report compare using NSW  with using NSW,MEL mixed MILD;
	*/
	public function actionDailyEparcelSend()
	{
		$filtersForm=new FiltersForm;
		if (isset($_GET['FiltersForm'])) {
			$filtersForm->filters=$_GET['FiltersForm'];
		}
		$provide=[];
		$i=1;
		if (!empty($_GET['start_date']) && !empty($_GET['end_date'])) {
			$start_time = $_GET['start_date'];
			$end_time = $_GET['end_date'];
			$end_time=date('Y-m-d', strtotime('+1 day', strtotime($end_time)));
			$sql="SELECT date_format(s.scan_time,'%Y-%m-%d') as date_in,SUM(t.pkg) as number, SUM(s.weight) as total_weight FROM `shipment` t INNER JOIN `shipment_scan` s ON t.id=s.pid WHERE t.hbn like 'SJU%' OR t.ref LIKE 'SJU%' GROUP by date_in HAVING date_in>=:start_date AND date_in<=:end_date ORDER BY date_in";
			$d2z=Yii::app()->db->createCommand($sql)->bindValues([':start_date'=>$start_time,':end_date'=>$end_time])->queryAll();
			$sql="SELECT date_format(s.scan_time,'%Y-%m-%d') as date_in,SUM(t.pkg) as number, SUM(s.weight) as total_weight FROM `shipment` t INNER JOIN `shipment_scan` s ON t.id=s.pid WHERE t.hbn like '33EVH%' OR t.ref LIKE '33EVH%' GROUP by date_in HAVING date_in>=:start_date AND date_in<=:end_date ORDER BY date_in";
			$pca=Yii::app()->db->createCommand($sql)->bindValues([':start_date'=>$start_time,':end_date'=>$end_time])->queryAll();
			$sql="SELECT t.id as id, date_format(s.scan_time,'%Y-%m-%d') as scan_date,ts.org_id as courier_id from `shipment` t INNER JOIN `shipment_scan` s ON t.id=s.pid LEFT JOIN `tranship` ts ON t.id=ts.pid WHERE s.scan_time>=:start_time AND s.scan_time<=:end_time  AND (t.ref LIKE 'AMQ%' OR ts.org_id=115)";
			$totalSydeneyScan=Yii::app()->db->createCommand($sql)->bindValues([':start_time'=>$start_time,':end_time'=>$end_time])->queryAll();
			$fastWay=OrgRate::model()->findByPk(52);
			$eparcel=OrgRate::model()->findByPk(ImportChargeCode::SYDNEY_AUPOST_ID);
			$melEparcel=OrgRate::model()->findByPk(ImportChargeCode::MELBOUNE_AUPOST_ID);
			$temp=[];
			$transaction=  Yii::app()->db->beginTransaction();
			try {
				foreach ($totalSydeneyScan as $oneShipment) {
					$p= ImParcel::model()->findByPk($oneShipment['id']);
					$tempCost=9999999;
					if (empty($p->mdata['cheap_org_rate_id'])) {
						$selectRate=null;
						foreach ([$fastWay,$eparcel,$melEparcel] as $orgRate) {
							$cost = ImcoConsol::getCourierCostPrice($orgRate, $p->cnee->postcode, $p->chargeWeight(), $p->pkg, true);
							if ($cost<$tempCost) {
								$tempCost=$cost;
								$selectRate=$orgRate;
							}
						}
						$p->mdata['cheap_org_rate_id']=$selectRate->id;
						$p->updateMeta();
					}
					if ($p->mdata['cheap_org_rate_id']== ImportChargeCode::MELBOUNE_AUPOST_ID) {
						if (key_exists($oneShipment['scan_date'], $temp)) {
							$temp[$oneShipment['scan_date']]['weight']+=$p->weight;
							$temp[$oneShipment['scan_date']]['number']+=$p->pkg;
						} else {
							$temp[$oneShipment['scan_date']]['weight']=$p->weight;
							$temp[$oneShipment['scan_date']]['number']=$p->pkg;
						}
					}
				}
				$transaction->commit();
			} catch (Exception $ex) {
				$transaction->rollback();
				throw $ex;
			}
			while ($start_time<$end_time) {
				$tempD2zPacks=0;
				$tempD2zWeight=0;
				$tempPcaPacks=0;
				$tempPcaWeight=0;
				$tempPoPcaPacks=0;
				$tempPoPcaWeight=0;
				$tempTotPacks=0;
				$tempTotWeight=0;
				foreach ($d2z as $r) {
					if ($r['date_in']!=$start_time) {
						continue;
					}
					$tempD2zPacks=$r['number'];
					$tempD2zWeight=$r['total_weight'];
				}
				foreach ($pca as $r) {
					if ($r['date_in']!=$start_time) {
						continue;
					}
					$tempPcaPacks=$r['number'];
					$tempPcaWeight=$r['total_weight'];
				}
				if (key_exists($start_time, $temp)) {
					$tempPoPcaPacks=$temp[$start_time]['number']+$tempPcaPacks;
					$tempPoPcaWeight=$temp[$start_time]['weight']+$tempPcaWeight;
				}
				$tempTotPacks=$tempD2zPacks+$tempPcaPacks;
				$tempTotWeight=$tempD2zWeight+$tempPcaWeight;
				if ($tempTotPacks<=0&&$tempPoPcaPacks<=0) {
					$start_time=date('Y-m-d', strtotime('+1 day', strtotime($start_time)));
					continue;
				}
				$provide[]=['id'=>$i++,'date'=>$start_time,'daily_d2z_packs'=>$tempD2zPacks,'daily_d2z_weight'=>$tempD2zPacks,
					'daily_pca_packs'=>$tempPcaPacks,'daily_pca_weight'=>$tempPcaWeight,'daily_tot_packs'=>$tempTotPacks,
					'daily_tot_weight'=>$tempTotWeight,'daily_po_pca_packs'=>$tempPoPcaPacks,'daily_po_pca_weight'=>$tempPoPcaWeight];
				$start_time=date('Y-m-d', strtotime('+1 day', strtotime($start_time)));
			}
		}
		$filteredData=$filtersForm->filter($provide);
		$dataprovider=new CArrayDataProvider($filteredData);
		$dataprovider->pagination=['pageSize' =>60,];
		$sort=new CSort();
		$sort->attributes=[
			'date'=>[
				'asc'=>'date ASC',
				'desc'=>'datea DESC',
			],
		];
		$sort->defaultOrder = "date ASC";
		$dataprovider->sort=$sort;
		if (!empty($_GET['partial'])) {
			$this->renderPartial('_search_daily_delivery', [
				'dataProvider' => [$dataprovider, $filtersForm]
			]);
			return;
		}
		
		
		$this->render('report_daily_delivery', ['dataProvider'=>[$dataprovider,$filtersForm]]);
	}
	
	/**
	 * produce the report compare using NSW  with using NSW,MEL mixed MILD;
	 */
	public function actionMixedMildsReport()
	{
		$filtersForm=new FiltersForm;
		if (isset($_GET['FiltersForm'])) {
			$filtersForm->filters=$_GET['FiltersForm'];
		}
		$provide=[];
		$i=1;
		if (!empty($_GET['start_date']) && !empty($_GET['end_date'])) {
			$start_time = $_GET['start_date'];
			$end_time = $_GET['end_date'];
			$end_time=date('Y-m-d', strtotime('+1 day', strtotime($end_time)));
			$sql="SELECT IF(r.cdeadwt>0 ,r.cdeadwt,r.weight) as weight,r.shipment_no,s.postcode,r.value as value, s.postcode as postcode,c.eta as date FROM `reconciliation_line` r INNER JOIN `consol` c ON r.consol_id=c.id INNER JOIN `shipment` s ON s.ref=r.shipment_no WHERE c.eta>=:startdate AND c.eta<=:enddate AND (r.shipment_no like  'AMQ%' OR r.shipment_no like '33EVH%' OR r.shipment_no Like '33EVJ%') and s.agent_id!=1206 ORDER BY c.eta";
			$rs=Yii::app()->db->createCommand($sql)->bindValues([':startdate'=>$start_time,'enddate'=>$end_time])->queryAll();
			while ($start_time<$end_time) {
				$sydneyCost=0;
				$totalWeight=0;
				$deliveryWeight=0;
				$totalPacks=0;
				$deliveryPacks=0;
				$mixedCost=0;
				foreach ($rs as $r) {
					if ($r['date']!=$start_time) {
						continue;
					}
					$totalWeight+=$r['weight'];
					$totalPacks++;
					if (preg_match("/AMQ\d{7}/i", $r['shipment_no'])) {
						$sydneyCost+=$r['value'];
						$chooseCost=$this->getEparcelCostByShipment1($r['weight'], $r['postcode']);
						$mixedCost+=$chooseCost[0];
						if ($chooseCost[1]!="sydney") {
							$deliveryWeight+=$r['weight'];
							$deliveryPacks++;
						}
					} else {
						$sydneyCost+= $this->getEparcelCostByShipment1($r['weight'], $r['postcode'], ['sydney'=>[3,101]])[0];
						$deliveryWeight+=$r['weight'];
						$deliveryPacks++;
						$mixedCost+=$r['value'];
					}
				}
				if ($totalPacks<=0) {
					$start_time=date('Y-m-d', strtotime('+1 day', strtotime($start_time)));
					continue;
				}
				$provide[]=['id'=>$i++,'date'=>$start_time,'syd_cost'=>$sydneyCost,'total_weight'=>$totalWeight,'total_packs'=>$totalPacks,'mixed_cost'=>$mixedCost,'del_weight'=>$deliveryWeight,'delivery_packs'=>$deliveryPacks];
				$start_time=date('Y-m-d', strtotime('+1 day', strtotime($start_time)));
			}
		}
		if (sizeof($provide)>=1) {
			$sydneyCost=$totalWeight=$totalPacks=$mixedCost=$deliveryWeight=$deliveryPacks=0;
			foreach ($provide as $p) {
				$sydneyCost+=$p['syd_cost'];
				$totalWeight+=$p['total_weight'];
				$totalPacks+=$p['total_packs'];
				$mixedCost+=$p['mixed_cost'];
				$deliveryWeight+=$p['del_weight'];
				$deliveryPacks+=$p['delivery_packs'];
			}
			$provide[]=['id'=>$i++,'date'=>'Total','syd_cost'=>$sydneyCost,'total_weight'=>$totalWeight,'total_packs'=>$totalPacks,'mixed_cost'=>$mixedCost,'del_weight'=>$deliveryWeight,'delivery_packs'=>$deliveryPacks];
		}
		$filteredData=$filtersForm->filter($provide);
		$dataprovider=new CArrayDataProvider($filteredData);
		$dataprovider->pagination=['pageSize' =>60,];
		$sort=new CSort();
		$sort->attributes=[
			'number'=>[
				'asc'=>'number ASC',
				'desc'=>'number DESC',
			],
			'status'=>[
				'asc'=>'status ASC',
				'desc'=>'status DESC',
			],
		];
		$sort->defaultOrder = "status ASC";
		$dataprovider->sort=$sort;
		if (!empty($_GET['partial'])) {
			$this->renderPartial('_search_mix', [
				'dataProvider' => [$dataprovider, $filtersForm]
			]);
			return;
		}
		
		
		$this->render('report_mix', ['dataProvider'=>[$dataprovider,$filtersForm]]);
	}
	private function getEparcelCostByShipment1($weight, $postcode, $options=['sydney'=>[3,101],'melbourne'=>[4,110]])
	{
		$resp=[100000,''];
		foreach ($options as $area=>$op) {
			$price = 0;
			$zoneMap = ZoneMap::model()->find('org_id = 101 AND zone_id = :zoneid AND pc_lo <= :code AND pc_hi >= :code', [':zoneid' => $op[0], ':code' =>$postcode]);
			// if not found we set as NSW country
			$chargeCode = 'N1';
			if (!empty($zoneMap) && !empty($zoneMap['z1'])) {
				$chargeCode = $zoneMap['z1'];
			}
			$zrs = ZoneRate::model()->findAll(
			"zone = :s AND (weight_lo < :w AND weight_hi >= :w) AND rate_id = :rateid AND base+item+perkg > 0 ",
				[':s' => $chargeCode, ':w' => $weight, ':rateid' => $op[1]]
		  );
			if (!empty($zrs)) {
				foreach ($zrs as $zr) {
					$temp = $zr['base'] + $zr['item'];
					if ($zr['nkg'] > 0) {
						$wl = $weight - ($zr['base'] > 0 ? $zr['nkg'] : 0);
						$temp += ceil($wl / $zr['nkg']) * $zr['perkg'];
					} else {
						$temp += $weight * $zr['perkg'];
					}
					if ($zr['minimum'] > 0 && $temp < $zr['minimum']) {
						$temp = $zr['minimum'];
					}
					$price = max($price, $temp);
				}
			}
			if ($price<$resp[0]) {
				$resp[0]=$price;
				$resp[1]=$area;
			}
		}
		return $resp;
	}
		
