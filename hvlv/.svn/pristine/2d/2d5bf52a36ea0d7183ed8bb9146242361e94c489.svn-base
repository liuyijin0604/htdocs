<?php

/**
 * This is the model class for table "pickup_booking".
 *
 * The followings are the available columns in table 'pickup_booking':
 * @property string $id
 * @property string $create_date
 * @property string $booking_time
 * @property integer $status
 * @property string $driver_name
 * @property string $rego
 * @property string $company_name
 * @property string $company_email
 * @property string $note
 * @property string $fee
 * @property string $meta
 * @property string $booking_number
 * @property string $shipment_id
 * @property string $ref
 * @property string $depot_id
 */
class PickupBooking extends MetaModel
{
	const NEW = 1;
	const PAID = 2;
	const SCHEDULED = 2;
	const CANCELLED = 3;
	const DONE = 4;
	const INBOUND_ERROR = 10;
	public $accountCode;

	public static $state = array(
		1 => 'New',
		2 => 'Scheduled',
		3 => 'Cancelled',
		4 => 'Done',
		10 => 'Inbound Error',
	);

	/**
	 * @return string the associated database table name
	 */
	public function tableName()
	{
		return 'pickup_booking';
	}

	/**
	 * @return array validation rules for model attributes.
	 */
	public function rules()
	{
		// NOTE: you should only define rules for those attributes that
		// will receive user inputs.
		return array(
			array('create_date, booking_time, status, driver_name, rego, company_name, company_email, fee, booking_number, shipment_id', 'required'),
			array('status', 'numerical', 'integerOnly'=>true),
			array('driver_name', 'length', 'max'=>100),
			array('rego', 'length', 'max'=>20),
			array('company_name, company_email', 'length', 'max'=>150),
			array('fee', 'length', 'max'=>5),
			array('meta', 'length', 'max'=>300),
			array('note', 'safe'),
			// The following rule is used by search().
			// @todo Please remove those attributes that should not be searched.
			array('id, create_date, booking_time, status, driver_name, rego, company_name, company_email, note, fee, meta, booking_number, shipment_id, ref, accountCode, depot_id', 'safe', 'on'=>'search'),
		);
	}

	/**
	 * @return array relational rules.
	 */
	public function relations()
	{
		// NOTE: you may need to adjust the relation name and the related
		// class name for the relations automatically generated below.
		return array(
			'shipment'=>array(self::BELONGS_TO, 'ImParcel', 'shipment_id'),
		);
	}

	/**
	 * @return array customized attribute labels (name=>label)
	 */
	public function attributeLabels()
	{
		return array(
			'id' => 'ID',
			'create_date' => 'Create Date',
			'booking_time' => 'Booking Time',
			'status' => 'Status',
			'driver_name' => 'Driver Name',
			'rego' => 'Rego',
			'company_name' => 'Company Name',
			'company_email' => 'Company Email',
			'note' => 'Note',
			'fee' => 'Fee',
			'meta' => 'Meta',
			'accountCode' => 'Account Code',
			'booking_number' => 'Booking Number',
			'shipment_id' => 'Shipment Id',
			'ref' => 'Ref',
			'depot_id' => 'Depot',
		);
	}

	public function getStatus($ishtml = false)
	{
		if($this->status==self::PAID||$this->status==self::DONE)
		{
			if($ishtml)
			{
				return "<span style='color:green'>".self::$state[$this->status]."</span>";
			}
		}else
		{
			if($ishtml)
			{
				return "<span style='color:red'>".self::$state[$this->status]."</span>";
			}
		}
		return self::$state[$this->status];
	}
	public function getEditUrl($token)
	{
		return "https://www.toplogistics.com.au/edit-booking-info/"."?"."booking_number=".$this->booking_number."&&token=".$token;
	}

	public function getEditToken()
	{
		return MD5(date("YmdHis").$this->booking_number);
	}

	public function generateBookingNumber($depot)
	{
		$today = date('Y-m-d');
		$today = $today . ' 00:00:00';
		$todayBookings = PickupBooking::model()->findAllBySql('SELECT * FROM pickup_booking WHERE create_date >= "'. $today . '"');
		$bookingCount = count($todayBookings)+1;
		$s = date('ymd');
		switch ($depot) {
			case "Sydney":
				$this->booking_number = "SBK" . $s . $bookingCount;
				break;
			case "Melbourne":
				$this->booking_number = "MBK" . $s . $bookingCount;
				break;
			case "Brisbane":
				$this->booking_number = "BBK" . $s . $bookingCount;
				break;
		}
	}

	public function getNoteContent()
	{
		$note = $this->note;
		$note.="<p>Weight:".$this->shipment->weight."</p>";
		$note.="<p>Total CBM:".number_format($this->shipment->cbm*$this->shipment->pkg,2,'.','')."</p>";
		$note.="<p>PKG:".$this->shipment->pkg."</p>";
		return $note;
	}

	public function getAccountCodeDiscount()
	{
		$account_Code = @$this->mdata["account_code"];
		if(empty($account_Code)) return "";


		$sellRate = new SellRate();
		$sobj = $sellRate->findImCode($account_Code);
		
		switch ($sobj) {
			case $sobj=0:
				return "No discount.";
				break;
			case $sobj>0:
				return "Discount:". $sellRate*100 . "%";
				break;
		}
	}

	/**
	 * Retrieves a list of models based on the current search/filter conditions.
	 *
	 * Typical usecase:
	 * - Initialize the model fields with values from filter form.
	 * - Execute this method to get CActiveDataProvider instance which will filter
	 * models according to data in model fields.
	 * - Pass data provider to CGridView, CListView or any similar widget.
	 *
	 * @return CActiveDataProvider the data provider that can return the models
	 * based on the search/filter conditions.
	 */
	public function search()
	{
		// @todo Please modify the following code to remove attributes that should not be searched.

		$criteria=new MyCDbCriteria;

		$criteria->compare('id',$this->id,true);
		$criteria->compare('create_date',$this->create_date,true);
		$criteria->compare('booking_time',$this->booking_time,true);
		$criteria->compare('status',$this->status);
		$criteria->compare('driver_name',$this->driver_name,true);
		$criteria->compare('rego',$this->rego,true);
		$criteria->compare('company_name',$this->company_name,true);
		$criteria->compare('company_email',$this->company_email,true);
		$criteria->compare('note',$this->note,true);
		$criteria->compare('fee',$this->fee,true);
		$criteria->compare('meta',$this->meta,true);
		$criteria->compare('booking_number',$this->booking_number,true);
		$criteria->compare('shipment_id',$this->shipment_id,true);
		$criteria->compare('depot_id', $this->depot_id, true);
		$criteria->compareWithObj($this,"ref",'id',"ImParcel","","shipment_id","ref =:content or hbn=:content");

		if(!empty($this->accountCode))
		{
			$criteria->addCondition("json_value(t.meta,'$.account_code') = ".$this->accountCode);
		}

		if (!empty($with)) {
			$criteria->with = array_unique($with);
			$criteria->together = true;
		}

		$sort=new CSort();
		$sort->attributes=[
			'booking_time' =>[
				'asc'=>'booking_time ASC',
				'desc'=>'booking_time DESC'
			]
		];
		$sort->defaultOrder = 'booking_time ASC';

		return new CActiveDataProvider($this, array(
			'criteria'=>$criteria,
			'sort'=>$sort,
			'pagination'=>['pageSize' => 30],
		));
	}

	/**
	 * Returns the static model of the specified AR class.
	 * Please note that you should have this exact method in all your CActiveRecord descendants!
	 * @param string $className active record class name.
	 * @return PickupBooking the static model class
	 */
	public static function model($className=__CLASS__)
	{
		return parent::model($className);
	}
}
