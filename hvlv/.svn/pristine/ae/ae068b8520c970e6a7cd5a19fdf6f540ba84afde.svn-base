<?php 
class SalesfunnelRequirementsService extends Service
{
	
    public function createSalesfunnelRequirements($questionNum,$question,$questionType,$Answers)
    {
        $questionModel = new SalesfunnelRequirementsQuestions();
        $answerModel = new SalesfunnelRequirementsAnswer();
        $errors = [];
        $newCBM = 0;
        $qa = SalesfunnelRequirementsQuestions::model()->findAll(["condition"=>'question_num =  "'.$questionNum. 'and question ="'.$question.'"']);
        if(!empty($qa))
        	print('alert("This requirement is exited.")');
        else{
        	$qu = new SalesfunnelRequirementsQuestions;
        	$qu->question_num = $questionNum;
        	$qu->question = $question;
        	$qu->question_type = $questionType;
        	$qu->save();
        }
        $an = new SalesfunnelRequirementsAnswer;
        foreach ($Answers as $key => $d) {
            $an->answer = $d[0];
            $an->question_id = $qu->id;
            $an->next_question_id = $d[1];
            $an->save();
        }

        return $qu->id;
	}

   public function modifySalesfunnelRequirements($questionId,$questionNum,$question,$questionType,$Answers)
   {
        $this->modifySalesfunnelRequirementsQuestions($questionId,$questionNum,$question,$questionType);
        $this->modifySalesfunnelRequirementsAnswer($questionId,$Answers);

    }

    public function modifySalesfunnelRequirementsQuestions($questionId,$questionNum,$question,$questionType){
    	$questionModel = SalesfunnelRequirementsQuestions::model()->findByPk($questionId);
        $errors = [];        
        if(!empty($questionModel)){
        	if(!empty($questionNum)){
        		$questionModel->question_num = $questionNum;
        	}
            if(!empty($question)){
        		$questionModel->question = $question;
        	}
            if(!empty($questionType)){
        		$questionModel->question_type = $questionType;
        	}            
            $questionModel->save();
            $questionModel->refresh();
        }
        else
        	print('console.log("empty.")');

    }

    public function modifySalesfunnelRequirementsAnswer($questionId,$Answers){
    	$answerModels = SalesfunnelRequirementsAnswer::model()->findAll(['condition'=>'question_id =  "'.$questionId]);
        foreach ($Answers as $key => $d){
        	if(!empty($d[0])){
            	$answerModels->answer = $d[0];
       		}
       		if(!empty($questionId)){
            	$answerModels->question_id = $questionId;
       		}
       		if(!empty($d[1])){
            	$answerModels->next_question_id = $d[1];
        	}   
    	}            
        $answerModels->save();
        $answerModels->refresh();
    }

