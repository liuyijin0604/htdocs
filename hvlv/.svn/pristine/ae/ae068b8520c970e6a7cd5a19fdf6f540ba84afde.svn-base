	public function editProcessEmail($postData,$getData,$ids)
	{
		$submission = SalesfunnelRequirementsSubmission::model()->findByPk($ids[0]);
		$ccEmail = "imports@toplogistics.com.au";
		$customerInfo = @$submission->company_name." ".$submission->first_name." ".$submission->last_name;
		$emailContent = $customerInfo."</br></br> Info:</br><table border=2 cellspacing=0 ><tr><th>TYPE</th><th>CTN number</th><th>Vessel</th><th>Vessel ID</th><th>Voyage</th><th>ETA</th><th>Free Detention Days</th></tr>";
		$submissions = [];
		foreach ($ids as $key => $id) {
			$thisSubmission = SalesfunnelRequirementsSubmission::model()->findByPk($id);
			$emailContent.= "<tr><td>".@SalesfunnelRequirementsSubmission::$customerType[$thisSubmission->customer_type]."</td>"."<td>Forwarder or Shipping Agent".@SalesfunnelRequirementsSubmission::$forwarderAgent[$thisSubmission->forwarder_shippingagent]."</td>"."</tr>";
			$submissions[] = $thisSubmission;
		}
		$emailContent .= "</table>";
		$salesRequirementService = new SalesfunnelRequirementsService();

		$emailService = new EmailService();
		// print_r(json_encode($getData));
		// Yii::app()->end();
		[$model,$data] = $emailService->createEmailContent($postData,$getData,null,null,null,null);	

		return [$model,$data];
	}

	public function updateRequirementProcessStatus($submission,$processType,$isIgnore=false,$postData = null)
 	{
		if(!empty($isIgnore))
		{

	 		$submission->sub_status = intval($submission->sub_status)|$processType;
			$submission->sub_status_ignore = intval($submission->sub_status_ignore)|$processType;

	 		$submission->save();
	 		return  $this->getSuccessResultWithWarns();
		}else
		{
			$submission->sub_status = intval($submission->sub_status)|$processType;
			$submission->sub_status_ignore = (intval($submission->sub_status_ignore)|$processType) - $processType;
			$submission->save();
			return  $this->getSuccessResultWithWarns();
		}

 	}
}
