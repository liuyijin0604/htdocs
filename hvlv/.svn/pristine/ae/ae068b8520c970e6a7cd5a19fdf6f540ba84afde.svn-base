	public function showAnswers($questionId=1){
		$requirementAns = SalesfunnelRequirementsAnswer::model()->findAll("question_id = :question_id", [":question_id" =>$questionId]);
        if (!empty($requirementAns))
        	return $requirementAns;
        else 
