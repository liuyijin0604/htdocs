	}

	public function sendRequirementEmail($submissionModel,$requirementRecordModels,$toEmail,$subject,$cc=""){
		$emailService = new EmailService();
		$htmlStr='';
		// $subjectStr = 'New Sales Funnel Requirement from'.$submissionModel->company_name;
		$htmlStr.='<a class = "tab_link" href="https://os.toplogistics.com.au/?salesfunnelRequirementsSubmission_id=';
		if (!empty($submissionModel->id)){
			$htmlStr.=$submissionModel->id;
		}
		$htmlStr.='&&menu=showCustomersDetail">Link to our system</a> </br></br>';

		$htmlStr.= '<div class="row">
                        <div class="col-md-6">
                            <label for="email" class="form-label pe-label text-input-row">Email</label>
                            <input disabled type="text" class="form-control" id="email" name="email"';

        if (!empty($submissionModel->email)){
            $htmlStr.= 'value="'.$submissionModel->email.'"';
        }

        $htmlStr.='>
                        </div>
                        <div class="col-md-6">
                            <label for="company_name" class="form-label pe-label text-input-row">Company name</label>
                            <input disabled type="text" class="form-control" id="company_name" name="company_name"';

        if (!empty($submissionModel->company_name)){
             $htmlStr.='value="'.$submissionModel->company_name.'"';
        }
        $htmlStr.='>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <label for="Name" class="form-label pe-label text-input-row">Name</label>
                            <input disabled type="text" class="form-control" id="Name" name="Name"';
        
        if (!empty($submissionModel->first_name) || !empty($submissionModel->last_name)){
            $htmlStr.='value="'.$submissionModel->first_name."  ".$submissionModel->last_name.'"';
        }
         $htmlStr.='>
                        </div>
                        <div class="col-md-6">
                            <label for="contact_number" class="form-label pe-label text-input-row">Contact number</label>
                            <input disabled type="text" class="form-control" id="contact_number" name="contact_number"';

        if (!empty($submissionModel->contact_number)){
            $htmlStr.='value="'.$submissionModel->contact_number.'"';
        }
        $htmlStr.='>
                        </div>
                    </div>';

		foreach ($requirementRecordModels as $key => $recordModel)
		{
			if (!empty($recordModel->question) && !empty($submissionModel))
		    {
                $htmlStr .= '<div class="item" id="item">';
		    	$htmlStr .=$this->printFinalQuestion($recordModel->question, $submissionModel->id,false);
                $htmlStr .= '</div> </br>';
		    }
		}
		$emailService->sendNormalEmail($toEmail,$subject,$htmlStr,$cc);
	}

	public function checkNextQuestionExited($question_id){
		$q = SalesfunnelRequirementsQuestions::model()->findByPk($question_id);
        $answerModel = SalesfunnelRequirementsAnswer::model()->find('question_id = :question_id', [':question_id' => $question_id]);
        if(!empty($answerModel)){
            if (!empty($answerModel->next_question_id)){
                return $answerModel->next_question_id;
            }
            else{
                return NULL;
            }
        }
        else{
             $nextQuestionModel = SalesfunnelRequirementsQuestions::model()->find(["condition"=>'question_num >  '.($q->question_num),"order"=>"question_num ASC"]);
            if (!empty($nextQuestionModel)){
                return $nextQuestionModel->id;
            }
            else{
                return NULL;
            }
        }
    }

    public function checkServiceType($serviceTypes){
    	$questionCategories = array();

    	foreach ($serviceTypes as $key => $serviceType) {
    		$service = SalesfunnelRequirementsAnswer::model()->findByPk($serviceType);
    		switch ($service->answer) {
    		case 'Import Service':
    			array_push($questionCategories, SalesfunnelRequirementsQuestions::IMPORTSERVICE);
    			break;

    		case 'Same Day Delivery':
    			array_push($questionCategories, SalesfunnelRequirementsQuestions::SAMECITYDELIVERY);
    			break;

    		case 'Service Type For 3PL':
    			array_push($questionCategories, SalesfunnelRequirementsQuestions::_3PLFULFILMENT);
    			break;
    		
    		default:
    			// code...
    			break;
    		}
    	}
    	return $questionCategories;

    }

    public function randomPassword() {
	    $alphabet = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ1234567890';
	    $pass = array(); //remember to declare $pass as an array
	    $alphaLength = strlen($alphabet) - 1; //put the length -1 in cache
	    for ($i = 0; $i < 8; $i++) {
	        $n = rand(0, $alphaLength);
	        $pass[] = $alphabet[$n];
	    }
	    return implode($pass); //turn the array into a string
	}

	public function printQuestion($data, $submitID = null){
		
		if (!isset($data['question_type']))
			return print("echo'error");
		else{
			$questionAnswerModel = SalesfunnelRequirementsRecords::model()->find('submit_id = :submit_id AND question_id = :question_id',[':submit_id' => $submitID, ':question_id' => $data->id]);
			// echo $questionAnswerModel->question_id;
			// Yii::app()->end();

			switch ($data['question_type']) {
				case SalesfunnelRequirementsQuestions::QUESTIONTYPENUMBER:
					$this->printType0($data, $questionAnswerModel);
					break;
				case SalesfunnelRequirementsQuestions::QUESTIONTYPETEXTFIELD:
					$this->printType1($data, $questionAnswerModel);
					break;
				case SalesfunnelRequirementsQuestions::QUESTIONTYPERADIOBUTTON:
					$this->printType2($data,$questionAnswerModel);
					break;
				case SalesfunnelRequirementsQuestions::QUESTIONTYPECHECKBOX:
					$this->printType3($data, $questionAnswerModel);
					break;
				case SalesfunnelRequirementsQuestions::LASTQUESTIONQUESTIONTYPE:
					$this->printType99($data);
					break;

				default:
					// code...
					break;
			}

		}

	}

