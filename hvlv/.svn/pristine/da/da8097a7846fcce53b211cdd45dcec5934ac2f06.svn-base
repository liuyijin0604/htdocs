<script>
    $(function(){
        var tab=$('#<?=$_GET['tabid']?>');
        var panel=tab.data('panel');
          tab.unbind('reload_sea_consol_process_grid').bind('reload_sea_consol_process_grid', function(){
		$('#sea_consol_process_grid<?=$_GET['tabid']?>',panel).yiiGridView('update');
		return false;
	});
    })
</script>
