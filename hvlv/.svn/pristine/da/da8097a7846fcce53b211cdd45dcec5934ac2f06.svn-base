		['name' => 'awb', 'type' => 'raw', 'value' => '$data->AwbTracking()'],
        array('header'=>'Customer','name' => 'owner_name','value' => '$data->getOwnerName()'),
		array('name' => 'status', 'value' => '$data->getStatus()', 
			'filter'=>CHtml::dropDownList('ImcoConsol[status]', $consol->status, $this->t($consol::$states), array('prompt'=>$this->t('All'))),),
	        array('name'=>'process_status','value'=>'$data->getProcessStatus()','cssClassExpression' => '$data->process->status== 21? "cloumn_notify" : ""','filter'=>CHtml::dropDownList('ImcoConsol[process_status]', $consol->process_status, $this->t(ConsolProcess::$states), array('prompt'=>$this->t('All'))),),
	        array('name' => 'dpt_id', 'value' => '$data->depot->name', 
			'filter'=>CHtml::dropDownList('ImcoConsol[dpt_id]', $consol->dpt_id, $this->t(Org::dptList()), array('prompt'=>$this->t('All'))),),
                array('name'=>'process_airport','header'=>'Pick Up Airport','value'=>'@$data->process->airport'),
                array('name'=>'process_airport_dead','header'=>'Pick Up Dead time','value'=>'@$data->process->pick_dead_date'),
		'flight',
		'pol',
		'pod',
		'eta',
                array('header' => 'Notes', 'value' => '@$data->process->mdata["process_note"]'),
		array('header' => 'Shipments', 'value' => '$data->totShipments()'),
		array('header' => 'Weight', 'value' => '$data->totWeight()'),
		['header' => 'B/L pcs', 'value' => '$data->getBLpcs()'],
                array('header' => 'UnScanPacks', 'value' => '$data->totLeftPacks()'),
                ['header'=>'extra Info','type'=>'raw','value'=>'$data->getReal()->getConsolDGWarnings()','filter'=>CHtml::dropDownList('Consol[exInfo]', $consol->exInfo, $this->t(Consol::$exInfos), ['prompt'=>'All'])],
                array(
