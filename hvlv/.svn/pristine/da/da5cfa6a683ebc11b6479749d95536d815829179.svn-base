<?php

require_once 'protected/modules/REST/src/SmsNotice/ModalSmsNotice.php';

class ModalSmsNoticeCollection{
    private $listModalSmsNotice = [];
    
    public function funcGetNotProcessed(){
        $result = (OrmSmsNotice::model()->findAll("(is_processed=:is_processed or is_processed=:is_processed1) and phone!='0000000000' and phone !='echo' ",[":is_processed"=>0,":is_processed1"=>1]));
        foreach($result as $i=>$orm){
            $objModal = new ModalSmsNotice;
            $objModal->CreateFromORM($orm);
            $this->listModalSmsNotice[]=$objModal;
            
        }
        
    }
    
    public function getCollection(){
        return $this->listModalSmsNotice;
    }
    
    public function funcCollection2StdClass(){
        $array = [];
        foreach ( $this->listModalSmsNotice as $i=> $objModalSmsNotice){
            $array[] = $objModalSmsNotice->funcOrm2StdClass();
        }
        return $array;
    }
    
    public function funcBatchSetIsPricessedTrue(){
        foreach ( $this->listModalSmsNotice as $i=> $objModalSmsNotice){
            $objModalSmsNotice->funcSetIsProceddedTrue();
        }
    }
    
    
}