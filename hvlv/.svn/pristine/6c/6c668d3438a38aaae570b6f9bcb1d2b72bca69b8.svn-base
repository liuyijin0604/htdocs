<script type="text/javascript">
	function checkboxOnclick(checkbox) {
		var panelSi = $('#<?= $_GET["tabid"]; ?>').data('panel');
		if (checkbox.checked == true) {
			var temp = $('#direction' + checkbox.value).text();
			var description = $('#description', panelSi).val();
			$('#description', panelSi).val(description + temp);
			//alert(checkbox.value);
		}
	};

	function removeCargo($id) {
		if (confirm('Are you sure to remove cargo?')) {
			var formData = new FormData();
			formData.append('id', $id);
			$.ajax({
				url: '<?= Yii::app()->createUrl("topCourierService/removeCargoJob") ?>',
				type: 'POST',
				data: formData,
				processData: false,
				contentType: false,
				success: function(r) {
					r = JSON.parse(r);
					if (r.done) {
						$('#<?= $_GET["tabid"] ?>_cargo_process_for_job_grid').yiiGridView('update');
						myApp.notice(r.msg, 5000);
					} else {
						myApp.alert(r.msg, false);
					}
				},
				error: function(r) {
					myApp.alert('System error', false);
				}
			});
		}
	};

	$(function() {
		var tab = $('#<?= $_GET["tabid"]; ?>');
		var panelSi = $('#<?= $_GET["tabid"]; ?>').data('panel');

		function uploading_on(obj) {
			obj.addClass('uploading');
			obj.val('    Uploading');
			obj.prop('disabled', 'disabled');
		}

		function uploading_off(obj) {
			obj.removeClass('uploading');
			obj.val('create cargo job');
			obj.removeProp('disabled');
		}

		$('#save_cargo_job', panelSi).on('click', function() {
			uploading_on($('#save_cargo_job', panelSi));
			var ids = new Array();
			var cargoSequence = new Array();
			var jobPalletNo = new Array();
			var job_name = $('#job_name', panelSi).val();
			var vehicle_id = $('#vehicle_id', panelSi).val();
			var driver_id = $('#driver_id', panelSi).val();
			var description = $('#description', panelSi).val();
			var created = $('#<?= $_GET["tabid"]; ?>_dt_crtd').val();
			//var created = $("*[name='created']").val();
			var directionforcustomer = "";
			$('input:checkbox[name=directioncheckbox]:checked').each(function(k) {
				if (k == 0) {
					directionforcustomer = $(this).val();
				} else {
					directionforcustomer += ',' + $(this).val();
				}
			});
			var distance = $('#meta_distance', panelSi).val();
			var destination = $('#meta_destination', panelSi).val();
			var time = $('#meta_time', panelSi).val();
			

			var jobId = '<?= $model->id ?>';

			$("input[name='job_relation_id']").each(function() {
				ids.push($(this).val());
				cargoSequence.push($('#' + $(this).val() + "cargo_sequence").val());
				jobPalletNo.push($('#' + $(this).val() + "job_pallet_no").val());
			});

			var formData = new FormData();
			formData.append('ids', ids);
			formData.append('cargoSequence', cargoSequence);
			formData.append('jobPalletNo', jobPalletNo);
			formData.append('vehicleId', vehicle_id);
			formData.append('jobName', job_name);
			formData.append('driverId', driver_id);
			formData.append('directionforcustomer', directionforcustomer);
			formData.append('distance', distance);
			formData.append('destination', destination);
			formData.append('description', description);
			formData.append('time', time);
			formData.append('jobId', jobId);
			formData.append('created', created);
			$.ajax({
				url: '<?= Yii::app()->createUrl("topCourierService/saveCargoJob") ?>',
				type: 'POST',
				data: formData,
				processData: false,
				contentType: false,
				success: function(r) {
					uploading_off($('#save_cargo_job', panelSi));
					r = JSON.parse(r);
					if (r.done) {
						$('#<?= $_GET["tabid"] ?>_cargo_process_for_job_grid').yiiGridView('update');
						myApp.notice(r.msg, 5000);
					} else {
						myApp.alert(r.msg, false);
					}
				},
				error: function(r) {
					uploading_off($('#save_cargo_job', panelSi));
					myApp.alert('System error', false);
				}
			});
		});

	});

	function funcExportCitoExcel<?= $model->id ?>() {
		window.open("topCourierService/exportCitoExcel?id=<?= $model->id ?>", '_blank', '');
	}
</script>