			echo "<p>Supplier ID:".CHtml::dropDownList('port_charge[supplier_id]',@$model->process->mdata['port_charge']['supplier_id'],Org::$shippingLine, array('empty' => 'Select Supplier'))."</p>";
			echo "<p id='manual_supplier' style='display:none'>Input Manual Supplier Id".CHtml::numberField('port_charge[manual_supplier_id]')."</p>";
