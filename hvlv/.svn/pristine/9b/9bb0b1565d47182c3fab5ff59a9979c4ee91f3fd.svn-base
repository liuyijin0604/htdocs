		case ConsolProcess::DU_EXCEPTION:
			$shipmentId = join(',',array_column($model->shipments,'id'));
			$files = FileRepo::model()->findAll(" ((type in (".FileRepo::CONTAINER_PHOTO.") and fid=:fid) or (type = :type and fid in ({$shipmentId}))) and status != :status",[":type"=>FileRepo::SHIPMENT_DAMAGE,":fid"=>$model->id,":status"=>FileRepo::DELETED]);
