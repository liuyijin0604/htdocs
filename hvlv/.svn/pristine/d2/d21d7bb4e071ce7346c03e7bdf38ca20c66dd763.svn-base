	public function completeTask(){
		$rs = WmsTask::model()->with('job')->findAll('job.org_id = :oid AND t.link_id = 0 AND t.status = 30', [':oid' => $this->prompt('Org ID: ')]);
		foreach($rs as $r){
			$wiplog = Log::model()->find(['condition' => 'model = "WmsTask" AND lid = :lid AND json_value(meta, "$.status") = "WIP"', 'params' => [':lid' => $r->id], 'order' => 'time DESC']);
			if(empty($wiplog)) continue;
			if(strtotime($wiplog->time) > time() - 86400) continue;
			$r->status = 99;
			$r->compl_time = date('Y-m-d H:i:s', strtotime($wiplog->time) + 3600);
			$r->save();
		}
		echo 'Done', PHP_EOL;
	}

	public function fastwayBD(){
		$rs = ZoneRate::model()->findAll('zone = "NON-SYD" AND rate_id = 52 AND item > 0');
		$rates = [];
		foreach($rs as $r){
			$rates[] = [$r->weight_lo, $r->weight_hi, $r->item];
		}
		$getCost = function($w) use ($rates){
			foreach($rates as $r){
				if($r[0] <= $w && $r[1] > $w){
					return $r[2];
				}
			}
			return 0;
		};
		$sql = "SELECT p.id, p.agent_id, p.hbn, p.ref, p.agent_id, p.postcode, p.weight FROM `shipment` p INNER JOIN tranship t ON t.pid = p.id left join zone_map z on (z.zone_id = 1 AND z.org_id = 115 AND z.z1 = 'SYD' AND z.pc_lo <= p.postcode AND z.pc_hi >= p.postcode)where p.type = 10 and p.status < 60 and p.created > '2019-07-01' and t.org_id = 115 and t.connote NOT LIKE 'BD%' AND z.zone_id IS NOT NULL and p.scan_no > 0";
		$rs = $this->db->createCommand($sql)->queryAll();
		foreach($rs as $p){
			echo implode(',', $p),',',$getCost($p['weight']);
		}
	}

	public function addRTSscan(){
		return;
		$sql = 'SELECT id,hbn,weight,pkg,ref,cref,agent_id,meta FROM shipment WHERE type = 10 AND status >= 80  AND status <= 86 UNION SELECT id,hbn,weight,pkg,ref,cref,agent_id,meta FROM shipment_archive WHERE type = 10 AND status >= 80  AND status <= 86';
		$rs = $this->db->createCommand($sql)->queryAll();
		$tt = [];

		$trans = Yii::app()->db->beginTransaction();
		try{
			foreach($rs as $r){
				$mdata = json_decode($r['meta'], true);
				if(!empty($mdata['rts_scan_date'])){
					// echo $r['hbn'], ' at ', $mdata['rts_scan_date'], PHP_EOL;
					$shipment_scan = ShipmentScan::model()->find('pid = :id AND user_id = 0 AND type = 4', [':id' => $r['id']]);
					if(empty($shipment_scan)){
						$shipment_scan=new ShipmentScan;
						$shipment_scan->pid=$r['id'];
						$shipment_scan->user_id=0;
						$shipment_scan->type=4;
						$shipment_scan->weight=round($r['weight']/$r['pkg'], 2);
						$shipment_scan->pno=1;
						$shipment_scan->warehouse=106;
						$shipment_scan->pkg=1;
						$shipment_scan->scan_time=$mdata['rts_scan_date'].' 12:34:56';
						$shipment_scan->save();
						echo 'RTS '.$r['hbn'].' added scan record', PHP_EOL;
					}
				}
			}
			$trans->commit();
		} catch (Exception $ex) {
			$trans->rollback();
			throw $ex;
		}
		echo 'Done', PHP_EOL;
	}

	public function stLabelID(){
		$date = empty($this->args[1])? date('Y-m-d') : $this->args[1];
		$ls = file('runtime/startrack/startrack_api_'.$date.'.log');
		foreach($ls as $l){
			if(!preg_match('/^Response: {"message":"Your label printing/', $l)) continue;
			$d = json_decode(substr(trim($l), 9));
			if(empty($d->labels)) continue;
			$p = ImParcel::model()->find('created > ref LIKE :ref AND created > DATE_SUB(:d, INTERVAL 2 DAY) AND json_value(meta, "$.ss_shipment_id") = :ssid', [':ref' => '7RFZ%', ':d' => $date, ':ssid' => $d->labels[0]->shipment_ids[0]]);
			if(empty($p) || !empty($p->mdata['ss_lbl_request_id'])) continue;
			$p->mdata['ss_lbl_request_id'] = $d->labels[0]->request_id;
			$p->updateMeta();
			echo $p->ref.' update: '.$d->labels[0]->request_id.' '.$d->labels[0]->shipment_ids[0], PHP_EOL;
		}
	}

