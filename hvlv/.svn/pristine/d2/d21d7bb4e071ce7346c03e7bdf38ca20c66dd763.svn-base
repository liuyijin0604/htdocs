	public function loadChina(){
		spl_autoload_unregister(array('YiiBase','autoload'));
		include_once(Yii::app()->basePath.DIRECTORY_SEPARATOR.'vendor/autoload.php');
		spl_autoload_register(array('YiiBase','autoload'));

		$pinyin = new Overtrue\Pinyin\Pinyin();
		$rs = file('China.csv');
		$n = 0;
		$c = 0;
		$sxq = [];
		unset($rs[0]);

		$addSxq = function($sxq){
			//if(empty($sxq[2])) return;
			$city = CnCity::model()->findByPk($sxq[0]);
			$area = new CnArea;
			$area->id = $city->id;
			$area->name = '市辖区';
			$area->city_id = $city->id;
			$area->init = 'SX';
			$area->zip = $sxq[2];
			$area->code = $sxq[1];
			$area->save();
			echo $city->name, PHP_EOL;
		};

		foreach($rs as $r){
			$r = explode(",", trim($r));
			if(empty($r[2])){ //province
				if(!empty($sxq)){
					$addSxq($sxq);
					$sxq = false;
				}
				$prov = CnProvince::model()->find('name = :n', [':n' => $r[1]]);
				if(empty($prov)) die('Province '.$r[1].' not found');
			}elseif(empty($r[3])){ //city
				if(!empty($sxq)){
					$addSxq($sxq);
					$sxq = false;
				}
				$city = new CnCity;
				$city->id = $r[0];
				$city->name = $r[2];
				$city->pid = $prov->id;
				$city->init = strtoupper($pinyin->abbr(mb_substr(preg_replace('/自治(区|州|县|市)/', '\\1', $r[2]), 0, -1)));
				$city->weight = 0;
				$city->save();
				$sxq = [$city->id, $r[4], $r[5]];
				$c++;
			}else{ //area
				if($r[2] != $city->name && $city->name != '直辖县' && preg_match('/直辖县级/', $r[2])){
					$city = new CnCity;
					$city->id = floor($r[0] / 100) * 100;
					$city->name = '直辖县';
					$city->pid = $prov->id;
					$city->init = 'ZXX';
					$city->weight = 0;
					$city->save();
					$sxq = false;
				}
				$area = new CnArea;
				$area->id = $r[0];
				$area->name = $r[3];
				$area->city_id = $city->id;
				$area->init = strtoupper($pinyin->abbr(mb_substr(preg_replace('/自治(区|州|县|市)/', '\\1', $r[3]), 0, -1)));
				$area->zip = $r[5];
				$area->code = $r[4];
				$area->save();
				$sxq = false;
				$n++;
			}
		}

		echo $n,' area, ',$c,' city', PHP_EOL;
	}

	public function loadTw(){
		$rs = file('tw_area.tsv');
		$n = 1;
		$c = 1;
		foreach($rs as $r){
			$r = explode("\t", trim($r));
			$city = CnCity::model()->find('pid = 710000 AND name = :n', [':n' => $r[0]]);
			if(empty($city)){
				$city = new CnCity;
				$city->id = 710000 + ($c * 100);
				$city->name = $r[0];
				$city->pid = 710000;
				$city->init = '';
				$city->weight = 0;
				$city->save();
				$c++;
				$n=1;
			}
			$area = new CnArea;
			$area->id = $city->id + $n;
			$area->name = $r[1];
			$area->city_id = $city->id;
			$area->init = '';
			$area->zip = '';
			$area->code = '';
			$area->save();
			$n++;
		}
		echo 'Done',PHP_EOL;
	}

	public function cleanupStarTrack(){
		$ppg = 100;
		$ss = new StarTrackAPI('syd', true);
		$r = $ss->getShipments(null, 0, 1);
		if(empty($r)) return;
		$tt = $r->pagination->total_number_of_records;
		$pgs = ceil($tt / $ppg) - 1;
		$c = 0;
		$ids = [];
		echo 'Total ', $tt, ' shipments', PHP_EOL;
		while($pgs > 0){
			$rs = $ss->getShipments(null, $pgs*$ppg, $ppg);
			if(empty($rs->shipments)) break;

			foreach($rs->shipments as $r){
				//var_dump($r->shipment_id);
				//var_dump($r->shipment_creation_date);
				if(!empty($r->order_id)){
					// echo $r->order_id, PHP_EOL;
					// echo $r->shipment_id, PHP_EOL;
					// echo $r->shipment_creation_date, PHP_EOL;
					// echo $r->shipment_reference, PHP_EOL;
					// var_dump($r);
					// break 2;
					continue;
				}
				$p = ImParcel::model()->find('hbn = :n', [':n' => $r->shipment_reference]);
				if(!empty($p) && $p->status != 100){
					if($p->status < 40 && strtotime($r->shipment_creation_date) > strtotime('-30 days')){
						continue;
					}elseif(strtotime($r->shipment_creation_date) > strtotime('-60 days')){
						continue;
					}
				}
				$ids[] = $r->shipment_id;
				$c++;
			}
			$pgs--;
			echo 'Page:', $pgs, '  Mark Deletion:', $c, PHP_EOL;
			if($c > 1000) break;
		}

		return;

		$pp = 10;
		$tt = ceil(count($ids) / $pp);
		$i = 0;
		while($i < $tt){
			$ss->deleteShipment(implode(',',array_splice($ids, 0, $pp)));
			$i++;
		}
		echo 'Done', PHP_EOL;
	}

	public function msgLdgRjt(){
		$rs = Edimsg::model()->findAll('type IN ("AIRCRR")  AND dt > "2018-09-01"');

		$trans = Yii::app()->db->beginTransaction();
		try{
		foreach($rs as $r){
			preg_match('/RFF\+ABO:([^:\+]+)::(\d+)/', $r->msg, $m);
			if (isset($m[1])) {
				$oref = $m[1].':'.ltrim($m[2],0);
				if (preg_match('/^(.+)\-(\d{1,2})$/', $m[1], $nm)) {
					$hbn = $nm[1];
				} else {
					$hbn = $m[1];
				}

				$omt = substr($r->type, 0, -1);

				$c = Consol::model()->find('no = :n', [':n' => $hbn]);
				if (empty($c)) {
					// $r->fid = $p->id;
					$omt .= '-S';
				} else {
					// $r->fid = $c->id;
					$omt .= '-C';
				}
				//update ACR/SCR status
				$om = Edimsg::model()->find('fid = :fid AND status IN (30, 40) AND type = :t AND msg LIKE :ref', [':fid' => $r->fid, ':t' => $omt, ':ref' => '%+'.$oref.'+%']);
				if($om){
					$om->status = preg_match('/THIS TRANSACTION WAS REJECTED/', $r->msg)? 60 : 50;
					//echo $om->id.':'.$om->status, PHP_EOL;
					$om->save();
				}
			}
		}
			$trans->commit();
		} catch (Exception $ex) {
			$trans->rollback();
			throw $ex;
		}
		echo 'Done', PHP_EOL;
	}

	public function fixEmptyPlainBody(){
		include_once(Yii::app()->basePath.DIRECTORY_SEPARATOR.'vendor/autoload.php');

		$rs = ImportsMail::model()->findAll('plain_body = ""');
		foreach($rs as $r){
			$eml = $this->tmp.'importsmail'.DIRECTORY_SEPARATOR.$r->no.'.eml';
			if(is_file($eml)){
				$parser = new PhpMimeMailParser\Parser();
				$parser->setText(file_get_contents($eml));
				$html= preg_replace('/charset=[^"^\']*/', 'charset=utf8', $parser->getMessageBody('html'));
				$r->plain_body = Html2Text\Html2Text::convert($html, true);
				$r->save();
			}
		}
		echo 'Done', PHP_EOL;
	}

	public function exconsolStatus(){
		$rs = ExcoConsol::model()->findAll('created >= "2018-07-01" AND status IN (10, 75, 80)');
		foreach($rs as $r){
			if($r->status == 80 && !preg_match('/顺丰/', $r->awb)){
				$sql = 'SELECT COUNT(id) AS t FROM shipment WHERE consol_id = '.$r->id.' AND status > 80';
				$c = Yii::app()->db->createCommand($sql)->queryScalar();
				if($c == 0){
					$r->status = 75;
					$r->save();
					echo $r->no,' still in clearance', PHP_EOL;
				}
			}elseif($r->status == 10){
				if($r->totShipments() == 0){ //cancel
					$r->status = 90;
					$r->save();
					echo $r->no,' cancelled', PHP_EOL;
				}
			}elseif($r->status < 80 && preg_match('/顺丰/', $r->awb)){
				$r->status = 80;
				$r->save();
				echo $r->no,' completed', PHP_EOL;
			}
		}
		echo 'Done', PHP_EOL;
	}

	public function outturnStatus(){
		$rs = Edimsg::model()->findAll('status = 19 AND type IN ("AIROUTR", "SEAOUTR") AND dt > "2018-01-01"');
		$trans = Yii::app()->db->beginTransaction();
		$c = 0;
		try{
			foreach($rs as $r){
				preg_match('/RFF\+ABO:([^:\+]+)::(\d+)/', $r->msg, $m);
				$oref = $m[1].':'.ltrim($m[2],0);
				$omt = substr($r->type, 0, -1);
				//update AIROUT/SEAOUT status
				$om = Edimsg::model()->find('fid = :fid AND status IN (30,40,60) AND type = :t AND msg LIKE :ref', [':fid' => $r->fid, ':t' => $omt, ':ref' => '%+'.$oref.'+%']);
				if($om){
					$om->status = preg_match('/THIS TRANSACTION WAS REJECTED/', $r->msg)? 60 : 50;
					$om->save();
					$c++;
				}
			}
			$trans->commit();
		} catch (Exception $ex) {
			$trans->rollback();
			throw $ex;
		}

		echo $c.' msg updated', PHP_EOL;
	}

	public function errorAck(){
		$rs = Edimsg::model()->findAll('status = 19 AND type = "CONTRL" AND dt > "2018-09-01"');
		$trans = Yii::app()->db->beginTransaction();
		$c = 0;
		try{
			foreach($rs as $r){
				if(preg_match_all('/UCM\+(\d+)\+CUSCAR:D:99B\:UN\+(4|7)[+\']+/', $r->msg, $m) > 0 || preg_match_all('/UCI\+0*(\d+)\+.+\+(4|7)[+\']+/', $r->msg, $m) > 0){
					foreach($m[1] as $i=>$mid){
						if($m[2][$i] == 7) continue;

						$rm = Edimsg::model()->find('mid = :mid AND dt > DATE_SUB(:dt, INTERVAL 10 DAY) AND dt < :dt', [':mid' => substr($mid, -6), ':dt' => $r->dt]);
						if ($rm) {
							if($rm->status <= 40){
								$rm->status = 44;
								$rm->save();
								$c++;
							}
						}
					}
				}
			}
			$trans->commit();
		} catch (Exception $ex) {
			$trans->rollback();
			throw $ex;
		}

		echo $c.' msg updated', PHP_EOL;
	}

	public function yystatement(){
		$xls = new oExcel;
		$xls->load('yy_statement.xlsx', true);
		$sheetsArray = $xls->xls->getAllSheets();
		foreach($sheetsArray as $n=>$sheet){
			$xls->goSheet($n);
			$title = $sheet->getTitle();
			$bill_to = "Top Logistics\nU12/1801 Botany Road,\nBanksmeadow NSW 2019";
			if(preg_match('/^\d+ \- Invoice$/', $title)){//invoice
				$xls->setCell('F5', '');
				$xls->setCell('G5', $bill_to);
				$xls->setCell('AP5', "PCAEXPSYD");
			}elseif(preg_match('/^\d+ \- Statement of Account$/', $title)){//statement
				$xls->setCell('E5', '');
				$xls->setCell('F5', $bill_to);
				$xls->setCell('U5', "PCAEXPSYD");
			}
			
			//$dd = array_merge($dd, $xls->getAll());
		}
		$xls->output('yy_'.time().'.xlsx', null, false);
	}

	public function checkHeld(){
		$tt = ImParcel::model()->count('status >= 58 AND created > "2018-07-01"');
		$ppg = 10000;
		$pgs = ceil($tt / $ppg);

		for($i = 0; $i < $pgs; $i++){
			$rs = ImParcel::model()->count(['condition' => 'status >= 58 AND created > "2018-07-01"', 'limit' => $ppg, 'offset' => $i * $ppg]);
			foreach($rs as $r){
				$em = Edimsg::model()->find(['condition' => 'fid = :id AND type = "CARST"', 'order' => 'dt DESC']);
				if(!$em || preg_match('/CONSOLIDATED STATUS:HELD/', $em->msg)){
					echo $r->hbn, PHP_EOL;
				}
			}
		}
		echo 'Done', PHP_EOL;
	}

	public function scanReport(){
		$sql = 'select user_id, u.fname, count(pid) as c, sum(weight) as w, date(scan_time) as d FROM `shipment_scan` s inner join user u on s.user_id = u.id group by user_id, d having c > 10';
		$us = $this->db->createCommand($sql)->queryAll();
		echo 'Name	Pks	Wt	Date	Time', PHP_EOL;
		foreach($us as $r){
			$rs = ShipmentScan::model()->findAll('user_id = :uid AND scan_time >= :st AND scan_time < DATE_ADD(:st, INTERVAL 1 DAY) ORDER BY scan_time ASC', [':uid' => $r['user_id'], ':st' => $r['d']]);
			$gap=300;
			$time=0;
			$start=$rs[0]->scan_time;
			foreach ($rs as $l) {
				if (abs(strtotime($start)-strtotime($l->scan_time))<$gap) {
					$time+=abs(strtotime($start)-strtotime($l->scan_time));
				} else {
					$time+=1;//if gap>10 min, we just add 1 second.
				}
				$start=$l->scan_time;
			}
			echo $r['fname'].'	'.$r['c'].'	'.$r['w'].'	'.$r['d'].'	'.round($time / 3600, 2), PHP_EOL;
		}
	}

	public function tinyEmailSubject(){
		$rs = ImportsMail::model()->findAll('subject LIKE :s', [':s' => '%{EM00%}%']);
		$trans = Yii::app()->db->beginTransaction();
		try{
			foreach($rs as $r){
				$a = $r->subject;
				if(preg_match_all('/\{EM\d+\}/', $a, $ms)){
					$a = str_replace($ms[0], '', $a).' '.implode(' ',$ms[0]);
				}
				$a = preg_replace('/Re:\s*Re:(\s*Re:)?(\s*Re:)?(\s*Re:)?/i', 'Re:', $a);
				if($a != $r->subject){
					$r->subject = $a;
					$r->save();
				}
			}
			$trans->commit();
		} catch (Exception $ex) {
			$trans->rollback();
			throw $ex;
		}
		echo 'Done', PHP_EOL;
	}

	public function popularProds(){
		$c = ExParcel::model()->count('status >= 60 AND status < 100 AND created > DATE_SUB(NOW(), INTERVAL 6 MONTH)');
		$pgs = ceil($c / 1000);
		$sts = [];
		for($i; $i < $pgs; $i++){
			$rs = ExParcel::model()->findAll(['condition' => 'status >= 60 AND status < 100 AND created > DATE_SUB(NOW(), INTERVAL 6 MONTH)', 'limit' => 1000, 'offset' => $i * 1000]);
			foreach($rs as $r){
				if(empty($r->eitems['pid'])) continue;
				foreach($r->eitems['pid'] as $g){
					if(!isset($sts[$g])) $sts[$g] = 0;
					$sts[$g]++;
				}
			}
		}
		rsort($sts);
		foreach($sts as $gid => $t){
			$prod = ExProdb::model()->findByPk($gid);
			echo $prod->name, "\t", $prod->brand, "\t", $prod->model, "\t", $t, PHP_EOL;
		}
	}

	public function cnCtn(){
		$ctn = include('ctn.php');

		$rs = CnlOrder::model()->findAll('transportMode = 10 AND status IN (20, 90)');

		foreach($rs as $odr){
			$bl = $odr->mdata['bk']['bln'];

			if(!isset($ctn[$bl])){
				echo $bl.' container info needed', PHP_EOL;
				continue;
			}

			$cgo = $odr->bCargos[0];
			$cc = [];
			foreach($ctn[$bl] as $n => $t){
				$cc[] = ['size' => substr($t, 0, 2), 'type' => substr($t,2), 'no' => $n];
			}
			
			if(json_encode($cgo->containers) != json_encode($cc)){
				$cgo->containers = $cc;
				$cgo->save();
				echo $bl.' updated', PHP_EOL;
				CnlMsg::createMsg($odr, 'GFP_INTL_LINEHAUL_CARGO_UPDATE_CALLBACK');
			}
			unset($ctn[$bl]);
		}

		foreach($ctn as $bl => $cs) {
			echo $bl.' not found', PHP_EOL;
		}

		echo 'Done', PHP_EOL;
	}

