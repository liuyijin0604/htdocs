	}

	public function checkRtsRate(){
		function getStartrackInvAmount($p){
			$il = InvLine::model()->with('invoice')->find('invoice.type = :it AND t.meta LIKE :t', [':it' => 10, ':t' => '%'.$p->ref.'%']);
			if(empty($il)){
				return 999;
			}else{
				foreach($il->mdata['items'] as $itm){
					if($itm[0] == $p->ref){
						return $itm[5];
					}
				}
			}
			return 999;
		}

		function getRtsRate($orgId, $p = null)
		{

			$courier = getCourier($p);

			// get organizaton price rate
			$orgRate = OrgRate::model()->find('org_id = :oid AND type = 40', [':oid' => $orgId]);
			if (empty($orgRate)) {
				return 0;
			}

			// get org rate details
			$rateInfo = json_decode($orgRate['meta']);
			$code = 'AU'; // RTS fee belongs to Australia local
			$rtsFee = 0;
			if ($courier == 'fastway') {
				if (isset($rateInfo->$code->rts_rate_fast)) {
					$rtsFee = floatval($rateInfo->$code->rts_rate_fast);
				}
			} elseif (in_array($courier, ['startrack', 'tnt'])) {
				if (isset($rateInfo->$code->rts_rate_star)) {
					$rtsFee = floatval($rateInfo->$code->rts_rate_star) * getStartrackInvAmount($p) / 100;
				}
			} elseif ($courier == 'letter') {
				$rtsFee = 0;
			} elseif (isset($rateInfo->$code->rts_rate)) {
				$rtsFee = floatval($rateInfo->$code->rts_rate);
			}
			return $rtsFee;
		};

		function getCourier($p){
			$courier = 'aus';

			if (preg_match('/LET\d{7}/i', $p->ref)) {
				$courier = 'letter';
			}else{
				$sql = 'SELECT org_id FROM `tranship` WHERE pid = '.$p->id.' AND connote = "'.$p->ref.'" ORDER BY id DESC LIMIT 1';
				$t = Yii::app()->getDb()->createCommand($sql)->queryScalar();
				if(!empty($t)){
					switch($t){
						case Org::ORGID_COURIER_FASTWAY:
							$courier = 'fastway';
						break;
						case Org::ORGID_COURIER_STARTRACK:
							$courier = 'startrack';
						break;
						case Org::ORGID_COURIER_TNT:
							$courier = 'tnt';
						break;
					}
				}
			}
			return $courier;
		}
		$p = ImParcel::model()->findByPk($this->prompt('Shipment ID:'));

		var_dump(getRtsRate($p->agent_id, $p));
	}

	public function fixUbiAID(){
		$ts = Tranship::model()->findAll('org_id = 3079');

		$trans = Yii::app()->db->beginTransaction();
		try{
			foreach($ts as $t){
				if(empty($t->shipment->mdata['article_id'])){
					$aid = $t->shipment->ref.sprintf('%02s', 1).'00093'.'51'.'0';
					$aid .= AusPostAPI::aidChkDgt($aid);
					$t->shipment->mdata['article_id'] = $aid;
					if(!empty($t->shipment->mdata['etower_shipment_orderid'])){
					unset($t->shipment->mdata['etower_shipment_orderid']);
						$t->shipment->hbn = $t->shipment->hbn . 'A';
					}
					$t->shipment->nolog = true;
					$t->shipment->update('hbn', 'meta');
					$t->shipment->nolog = false;
					$t->status = 10;
					$t->update('status');
				}
			}
			$trans->commit();
		} catch (Exception $ex) {
			$trans->rollback();
			throw $ex;
		}

		echo 'Done', PHP_EOL;
	}

