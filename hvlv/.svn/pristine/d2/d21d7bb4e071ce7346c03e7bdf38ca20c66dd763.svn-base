	public function withdrawACRMutiple(){
		$cns = Consol::model()->findAll("id in (".$this->prompt('Consol ID: ').")");
		foreach ($cns as $cnk => $cn)
		{
			sleep(5);
			$senderSite = Yii::app()->params['ics']['testing']? Yii::app()->params['ics']['test_site'] : Yii::app()->params['ics']['prod_site'];
			if(empty($cn)){
				die("Consol not found\n");
			}else{
				echo "AWB: ", $cn->awb, "\n";
			}
			$oawb = explode("-",$cn->awb)[0].explode("-",$cn->awb)[1];
			$hwb = empty($cn->mdata['house_bill'])? $cn->no : $cn->mdata['house_bill'];
			$airline = substr(trim($cn->airline), 0, 2);
			$flight = substr(trim($cn->flight), 2);
			$transaction=Yii::app()->db->beginTransaction();
			try {
				$os = Edimsg::model()->findAll("status = 50 AND type = 'AIRCR-C' AND fid = :id AND sender =:sender", [':id' => $cn->id,':sender'=>$senderSite]);
				$omid = null;
				if(!empty($os)){
					foreach($os as $o){
						if(preg_match('/MWB:'.$oawb.'/', $o->msg) && preg_match('/BGM\+933:::AIRCR\+([^\+:]+):\d+\+9\'/', $o->msg, $m)){
							$omid = $m[1];
							break;
						}
					}
				}
			if(empty($omid)){
				echo 'Original MSG not found for ', $cn->no, "\n";
			}else{
				$em = new Edimsg;
				$em->dt = date('Y-m-d H:i:s');
				$em->type = 'AIRCR-C';
				$em->sender =$senderSite;
				$em->receiver = Yii::app()->params['ics']['customs_id'];
				$em->status = 19;
				$em->fid = $cn->id;
				$em->save();
				$em->mid = sprintf('%06s', substr($em->id, -6));
				$vn = Edimsg::model()->count('type = :t AND fid = :fid AND sender = :sender', [':t' => 'AIRCR-C', ':fid' => $cn->id,':sender'=>$senderSite]) + 1;
				$msg = "UNH+".$em->mid."+CUSCAR:D:99B:UN'
BGM+933:::AIRCR+".$omid.":".$vn."+50'
RFF+HWB:".$cn->no."'
RFF+MWB:".$oawb."'
TDT+20+".$flight."++6+".$airline."::3'
DTM+178:".date("Ymd", strtotime($cn->eta)).":102'
";
				$mc = substr_count($msg, "\n")+1;
				$msg .= "UNT+".$mc."+".$em->mid."'";
				$em->msg = $msg;
				$em->status = 20;
				$em->save();
			}
			foreach($cn->shipments as $i=>$p){
	//                    if(($p->bwf&4)<=0)                        continue;
				echo $p->ref."\n";
				$p->mdata['heldEta'] = [];
				$p->updateMeta();
				$os = Edimsg::model()->findAll("status = 50 AND type = 'AIRCR-S' AND fid = :id AND sender =:sender", [':id' => $p->id,':sender'=>$senderSite]);
				$omid = null;
				if(!empty($os)){
					foreach($os as $o){
						if(preg_match('/MWB:'.$oawb.'/', $o->msg) && preg_match('/BGM\+933:::AIRCR\+([^\+:]+):\d+\+9\'/', $o->msg, $m)){
							$omid = $m[1];
							break;
						}
					}
				}
				if(empty($omid)){
					echo 'Original MSG not found for ', $p->hbn, "\n";
					continue;
				}
				$em = new Edimsg;
				$em->dt = date('Y-m-d H:i:s');
				$em->type = 'AIRCR-S';
				$em->sender = $senderSite;
				$em->receiver = Yii::app()->params['ics']['customs_id'];
				$em->status = 19;
				$em->fid = $p->id;
				$em->save();
				$em->mid = sprintf('%06s', substr($em->id, -6));
				$vn = Edimsg::model()->count('type = :t AND fid = :fid AND sender =:sender', [':t' => 'AIRCR-S', ':fid' => $p->id,':sender'=>$senderSite]) + 1;
				$msg = "UNH+".$em->mid."+CUSCAR:D:99B:UN'
BGM+933:::AIRCR+".$omid.":".$vn."+50'
RFF+HWB:".$p->hbn."'
RFF+MWB:".$oawb."'
TDT+20+".$flight."++6+".$airline."::3'
DTM+178:".date("Ymd", strtotime($cn->eta)).":102'
";
				$mc = substr_count($msg, "\n")+1;
				$msg .= "UNT+".$mc."+".$em->mid."'";
				$em->msg = $msg;
				$em->status = 20;
				$em->save();
			}
				$transaction->commit();
			} catch (Exception $ex) {
				$transaction->rollback();
				throw $ex;
			}
			echo "Done\n";

		}
		
	}



