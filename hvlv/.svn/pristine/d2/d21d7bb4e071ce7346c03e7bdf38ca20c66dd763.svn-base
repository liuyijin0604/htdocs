	}

	public function fixScanMeta(){
		$rs = ImParcel::model()->findAll('consol_id = :c and scan_no > 0', [':c' => $this->prompt("Consol ID:")]);
		foreach($rs as $r){
			$s = ShipmentScan::model()->find('pid = :pid AND type IN (0,2)', [':pid' => $r->id]);
			if(!empty($s)){
				$r->scan_data[50][$r->hbn] = $s->scan_time;
				$r->save();
