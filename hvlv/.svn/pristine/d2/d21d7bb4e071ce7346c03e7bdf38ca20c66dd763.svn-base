			}
		}
		echo 'Done', PHP_EOL;
	}

	public function restoreMeta(){
		$rs = $this->db->createCommand('SELECT id, meta FROM shipment_restore')->queryAll();
		foreach($rs as $r){
			$p = Shipment::model()->findByPk($r['id']);
			$om = json_decode($r['meta'], true);
			foreach($p->mdata as $k => $v){
				$om[$k] = $v;
			}
			if(!empty($om)){
				$p->mdata = $om;
				$p->updateMeta();
			}
		}
		echo 'Done', PHP_EOL;
	}

	public function resetACR(){
		$cid = $this->prompt('Consol ID: ');
		$cn = Consol::model()->findByPk($cid);
		if(empty($cn)) die('Consol not found');
		$cn->mdata['acr_stat'] = 0;
		$cn->save();
		$trans = Yii::app()->db->beginTransaction();
		try{
			$this->db->createCommand('UPDATE shipment SET status = 50 WHERE consol_id = '.$cid)->execute();
			foreach($cn->shipments as $s){
				$sql = 'UPDATE edimsg SET status = 90 WHERE fid = '.$s->id.' AND type = "AIRCR-S"';
				$this->db->createCommand($sql)->execute();
			}
			$trans->commit();
		} catch (Exception $ex) {
			$trans->rollback();
			throw $ex;
		}
		echo 'Done', PHP_EOL;
	}

	public function combpick(){
		$oid = $this->prompt('Org ID: ');
		$ts = WmsTask::model()->with('job')->findAll('job.org_id = :oid AND t.status < 99 AND t.link_id = 0', [':oid' => $oid]);

		$xls = new oExcel;
		$xls->setColWidth([10,10,10,10,10]);
		$i = 1;
		$xls->addRow($i++, ['Task ID', 'Order Ref', 'Item', 'Item SKU', 'Qty', 'Customer', 'Address', 'Suburb', 'State', 'Postcode', 'Tel']);
		$labels = [];
		foreach($ts as $t){
			$dt = $t->deliveryTask();

			foreach($t->items as $itm){
				$stk = WmsStock::model()->findByPk($itm->mdata['si']);
				$xls->addRow($i++, [$t->id, $t->ref, $itm->mdata['sn'], $stk->prod->ean, $itm->mdata['uq'], $dt->mdata['cnee']['name'], $dt->mdata['cnee']['address'], $dt->mdata['cnee']['suburb'], $dt->mdata['cnee']['state'], $dt->mdata['cnee']['postcode'], $dt->mdata['cnee']['tel']]);
				//label
				if($itm->mdata['uq'] < 5 && !empty($itm->mdata['si'])){
					$o = ['agent_id' => $oid, 'pkg' => $itm->mdata['uq'], 'ref' => $t->getNo(), 'cref' => $t->ref, 'hbn' => $t->getNo(), 'cnee' => $dt->mdata['cnee']];
					$o = json_decode(json_encode($o));
					$o->mdata = ['show_sku' => true, ''];
					$o->eitems = ['sku' => ['<span style="font-size:1.2em">'.$itm->mdata['sn'].' '.$stk->prod->ean.' x 1</span>']];
					$labels[$stk->prod->ean][] = $o;
				}
			}
		}
		$xls->output('combined_pick.xlsx', null, false);
		ksort($labels);
		$lbls = [];
		foreach($labels as $ls){
			$lbls = array_merge($lbls, $ls);
		}
		oPDF::renderPDF('label_A6', ['rs' => $lbls, 'tpl' => '_label_letter'], 2, 'letter_labels.pdf');
		
		echo 'Done', PHP_EOL;
	}

