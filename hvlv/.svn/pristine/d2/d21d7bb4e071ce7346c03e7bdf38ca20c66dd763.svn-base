	public function compareZoneRateTable(){
		$compTbl = function($sql, $ts=['zone_rate', 'zone_rate_20190520']){
			$rs = [];
			foreach($ts as $t){
				$rs[] = Yii::app()->db->createCommand(str_replace(':tbl', $t, $sql))->queryAll();
			}
			return $rs;
		};
		
		$rs = $compTbl('select distinct(rate_id) as r from :tbl order by rate_id');
		foreach($rs[0] as $k => $v){
			if($rs[0][$k]['r'] != $rs[1][$k]['r']){
				echo 'different rate ID: ', $rs[0][$k]['r'], PHP_EOL;
			}else{
				//check rate counts
				$ds = $compTbl('select count(*) as c from :tbl where rate_id  = '. $v['r']);
				if(json_encode($ds[0]) != json_encode($ds[1])){
					echo 'different rates count: ', $v['r'], PHP_EOL;
				}

				//check weight breaks
				$ds = $compTbl('select weight_lo, weight_hi, count(id) as c from :tbl where rate_id  = '. $v['r'].' group by weight_lo, weight_hi order by weight_lo');
				if(json_encode($ds[0]) != json_encode($ds[1])){
					echo 'different rates setup: ', $v['r'], PHP_EOL;
				}
			}
		}

		echo 'Done', PHP_EOL;
	}

