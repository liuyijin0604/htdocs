	public function relodgeSSdeletedShipmentsByConsol(){
		$c = Consol::model()->findByPk($this->args[1]);
		$rs = [];
		foreach($c->shipments as $shipment){
			if(!in_array($shipment->status, [42, 58, 60]) || !preg_match('/^(7RFZ|4XHZ)\d{8}/i', $shipment->ref) || $shipment->scan_no == $shipment->pkg) continue;
			if (!empty($shipment->trans) && count($shipment->trans) == 1 && !empty($shipment->trans[0]->mdata['oid'])) {
				continue;
			}
			unset($shipment->mdata['ss_shipment_items']);
			$rs[] = $shipment;
		}

		if(empty($rs)) die('No shipment to manifest'.PHP_EOL);

		$ss =new StarTrackAPI('syd', true);

		$r = $ss->createOrderIncludingShipments($rs, $c->no.'-DEL');

		if(!empty($r->order)){
			$oid = $r->order->order_id;

			$ssShipments = array();
			foreach  ( $r->order->shipments as $aushipment ) {
				$ssShipments[$aushipment->shipment_reference] = $aushipment;
			}

			foreach($rs as $i => $s){
				$ts = Tranship::model()->find('pid = :pid AND connote = :c', [':pid' => $s->id, ':c' => $s->ref]);
				if(empty($ts)){
					$ts = new Tranship;
					$ts->pid = $s->id;
					$ts->org_id = 858;
					$ts->type = 80;
					$ts->connote = $s->ref;
					$ts->time = date('Y-m-d H:i:s');
					$ts->status = 19;
				}
				$ts->mdata['oid'] = $oid;
				$ts->mdata['sid'] = $ssShipments[$s->hbn]->shipment_id;
				$ts->save();
				$s->mdata['ss_shipment_id'] = $result->shipment_id;
				$s->updateMeta();
			}
		}else{
			foreach($ss->err as $e){
				if(!empty($e->field) && preg_match('/shipments\[(\d+)\]/', $e->field, $m)){
					echo $rs[$m[1]]->hbn.': '.$e->message."\n";
				}
			}
		}

		echo 'Done', PHP_EOL;
	}

	public function recreateSSShipment(){
		$shipment = ImParcel::model()->find('hbn = :h OR ref = :h', [':h' => $this->args[1]]);
		if(empty($shipment)) die('Shipment not found'.PHP_EOL);
		unset($shipment->mdata['ss_shipment_items']);

		$ss =new StarTrackAPI('syd', true);
		$result = $ss->createShipments($shipment);
		if ($result && isset($result->shipments) && is_array($result->shipments)) {
			$result = $result->shipments[0];
			$result_item=[];
			foreach ($result->items as $item) {
				if (!empty($item->tracking_details->article_id)) {
					if (preg_match('/(?<=^7RFZ|^4XHZ)\d{8}EXP(\d{5})/i', $item->tracking_details->article_id, $match)) {
						$result_item[intval($match[1] - 1)] = $item->item_id;
					}
				}
			}
			ksort($result_item);
			$shipment->mdata['ss_shipment_id'] = $result->shipment_id;
			$shipment->mdata['ss_shipment_items'] = $result_item;
			$shipment->updateMeta();
			
			$ts = Tranship::model()->find('pid = :pid AND connote = :c', [':pid' => $shipment->id, ':c' => $shipment->ref]);
			// save tranship information for startrack courier
			if(empty($ts)){
				$ts = new Tranship;
				$ts->pid = $shipment->id;
				$ts->org_id = 858;
				$ts->type = 80;
				$ts->connote = $shipment->ref;
				$ts->time = date('Y-m-d H:i:s');
				$ts->status = 19;
			}
			$ts->time = date('Y-m-d H:i:s');
			$ts->mdata['ss_shipment_id'] = $result->shipment_id;
			$ts->cost = number_format(round($result->shipment_summary->total_cost, 2), 2, '.', '');
			$ts->save();
			echo 'Done', PHP_EOL;
		}else{
			echo 'Create Shipment Failed', PHP_EOL;
		}
	}

