	public function rerunAddressValidation(){// for incorrectables
		$o = new stdClass;
		$country = 'AU';

		$rs = ImParcel::model()->findAll('cbwf & 16 > 0 AND json_value(meta, "$.editStreetCode") = 512');

		foreach($rs as $p){
			$result = ChooseShipment::modifyAddress($p->cnee,$o,$country,$p->mdata['chargecode']);
			if($result->isModified==1)
			{
				if(!empty($result->newAddress))
				{
					$p->mdata['newAddress'] = $result->newAddress;
					$p->mdata['oldAddress'] = $result->oldAddress;
					$p->mdata['editStreetCode'] = $result->editCode;
				}
				unset($p->mdata['is_diff']);
				$p->cbwf = $p->cbwf | 16;
				$p->cnee->save();
				$p->save();
				echo $p->hbn, ' local corrected', PHP_EOL;
			}else if($result->isModified==2)
			{
				$p->cbwf = $p->cbwf | 16;
				if(!empty($result->tempAddress))
				{
					$p->mdata['tempAddress'] = $result->tempAddress;
					var_dump($result->tempAddress);
				}
				$p->mdata['oldAddress'] = $result->oldAddress;
				$p->mdata['editStreetCode'] = $result->editCode;
				if(($result->editCode & 512) > 0){
					echo $p->hbn, ' INCORRECTABLE', PHP_EOL;
				}else{
					unset($p->mdata['is_diff']);
					$p->save();
					$p->cnee->save();
					echo $p->hbn, ' geocode corrected', PHP_EOL;
				}
			}
		}
		echo 'Done';
	}

	public function apordersfromlog(){
		$log_dir = Yii::app()->basePath.DIRECTORY_SEPARATOR.'runtime'.DIRECTORY_SEPARATOR.'auspost'.DIRECTORY_SEPARATOR;
		$detail = !empty($this->args[1]) && $this->args[1] == 'detail';
		
		if($detail){
			echo "HBN\tRef\tConsol\tAgent\tCreated\tWeight\tCost\tAP#\tDate", PHP_EOL;
		}else{
			echo "AP#\tDate\tCost\tShipments\tItems", PHP_EOL;
		}
		$t = [0,0,0];
		foreach(glob($log_dir.'auspost_api_2020-04*.log') as $f){
			$ls = file($f);
			foreach($ls as $l){
				if(preg_match('/^Response: \{"order":\{"order_id":"AP/', $l)){ //order response
					$r = json_decode(trim(substr($l, 10)), true);
					if($detail){
						foreach($r['order']['shipments'] as $s){
							$p = ImParcel::model()->find('hbn = :n', [':n' => $s['shipment_reference']]);
							if(empty($p)) echo $s['shipment_reference'], ' not found!', PHP_EOL;
							$tc = 0;
							foreach($s['items'] as $itm){
								$tc += $itm['item_summary']['total_cost'];
							}
							echo $p->hbn, "\t", $p->ref, "\t", $p->agent_id, "\t", $p->consol_id, "\t", $p->created, "\t", $p->weight, "\t", $tc, "\t", $r['order']['order_id'], "\t", $r['order']['order_creation_date'], PHP_EOL;
						}
						continue;
					}
					echo $r['order']['order_id'], "\t", $r['order']['order_creation_date'], "\t", $r['order']['order_summary']['total_cost'], "\t", $r['order']['order_summary']['number_of_shipments'], "\t", $r['order']['order_summary']['number_of_items'], PHP_EOL;
					$t[0] += $r['order']['order_summary']['total_cost'];
					$t[1] += $r['order']['order_summary']['number_of_shipments'];
					$t[2] += $r['order']['order_summary']['number_of_items'];
				}
			}
		}
		if(!$detail) echo "\t\t",implode("\t", $t), PHP_EOL;
	}

	public function scanlog(){
		$ls = file('runtime/batch_scan.log');
		$ns = [];
		$tns = [];
		$transaction=Yii::app()->db->beginTransaction();
		$tempWareHouse=106;
		if (!empty(Yii::app()->session['scan_warehouse']) && Yii::app()->session['scan_warehouse']=='melbourne') {
			$tempWareHouse=218;
		}
		$type = 0;
		try {
			foreach($ls as $l){
				$time = substr($l, 0, 19);
				$ds = json_decode(trim(substr($l, 21)));
				foreach($ds as $d){
					if(in_array($d, $ns)) continue;
					$ns[] = $d;
					$tns[$time][] = $d;
					$isHbn = $sn == 0;
					$courier_id = 0;
					if(preg_match('/^(33EVH|333UF|AMQ)\d{10,}/', $d)) $d = '019931265099999891'.$d;
					$p = ShipmentScan::getShipmentByBarcode($d, $sn, $courier_id);
					if(empty($p)) {
						if (preg_match('/-\d+$/', $d)) {
							list($hbn, $sn) = explode('-', $d);
						} else {
							$hbn = $d;
							$sn = 0;
						}
						$p = ImParcel::fromBarcode($hbn, $isHbn);
					}
					if(empty($p)){
						echo $d.' not found', PHP_EOL;
						continue;
					}
					if($p->scanCount() > 0) continue;
					echo $p->ref.' no scan record', PHP_EOL;
					ShipmentScan::genShipmentScan($p, $type, $sn, $tempWareHouse, 3600);
					GatepassShipment::gatepassScan($p, $courier_id, $sn, $tempWareHouse);
					if (!$isHbn || $p->pkg == 1) {
						$p->scan_data[50][strtoupper($d)] = date('Y-m-d H:i:s');
					}
					$p->scan_no = $p->pkg - $p->scanCount();
					$p->mdata['scan_time'] = date('Y-m-d H:i:s');
					$p->pushToHeldProcess(true);
					$p->update(['scan_no', 'scan', 'meta', 'bwf']);
					$p->updateDeconsolidationTime();
					echo 'Updated '.$p->ref, PHP_EOL;
				}
			}
			$transaction->commit();
		} catch (Exception $ex) {
			$transaction->rollback();
			var_dump($ex->getMessage());
			print_r($ex->getTrace());
			throw new CHttpException(500, 'Failed save to DB!');
		}

		// file_put_contents('s.json', json_encode($tns));
		echo 'Done',PHP_EOL;
	}

	public function upAP838(){
		include(Yii::app()->basePath.DIRECTORY_SEPARATOR.'commands/trackingCommand.php');
		$tracking = new trackingCommand('ubm', null);
		$rs = Tranship::model()->with('shipment')->findAll(  			't.org_id = 101 and t.status = 19 and t.time > "2020-04-01" and shipment.status = 70 and shipment.agent_id = 838');
		$transaction=Yii::app()->db->beginTransaction();
		try {
			foreach($rs as $t){
				$tracking->_upImTrack($t);
				echo date('Y-m-d H:i:s'), "\t", $t->connote, PHP_EOL;
			}
			$transaction->commit();
		} catch (Exception $ex) {
			$transaction->rollback();
			throw $ex;
		}
		echo 'Done';
	}

	public function gvdblmanifinv(){
		$to_id = 2716;
		$owner = Org::model()->findByPk($to_id);
		$orgRate = OrgRate::model()->find('org_id = :oid AND type = 40', [':oid' => $owner->id]);
		// chargecode 3184 syd, 1082 mel
		$ls = file('gv_shipments.csv');
		$shipments = [];
		foreach($ls as $l){
			$r = explode(',', trim($l));
			$p = ImParcel::model()->find('ref = :r AND agent_id = :o', [':r' => $r[1], ':o' => $to_id]);
			if(empty($p)){
				echo $r[1], ' not found', PHP_EOL;
				continue;
			}
			$p->mdata['chargecode'] = preg_match('/^33EVH/', $p->ref)? 1082 : 3184;
			$shipments[] = $p;
		}
		$con = new ImcoConsol;
		$result = $con->genShipmentsInvoicePro($owner, $orgRate, $shipments);
		$inv = new Invoice;
		$isUpdate = false;
		$inv->date = date('Y-m-d');
		$inv->status = Invoice::INVOICE_STATUS_PENDING;
		$inv->type = Invoice::INVOICE_TYPE_DIRECT_MAWB;
		$inv->dpmt = Invoice::DPMT_IMPORT;
		$inv->to_id = $to_id;
		$inv->consol_id = 0;
		$inv->man_id = 0;
		$inv->dpt_id = 106;
		$inv->currency = 1;
		if ($result[0] > 0) {
			$inv->total = $result[0];
			$items = $result[1];
			$inv->save();
			$il = new InvLine;
			$il->inv_id = $inv->id;
			$il->amount = round($inv->total, 2);
			$il->gst = 0;
			$il->qty = 1;
			$il->mdata['items'] = $items;
			$il->save();
		}
		echo $inv->id, PHP_EOL;
	}

	public function storageUnitTest(){
		//test cases
		$free_days = [0, 2, 5, 7, 10, 14, 21];
		$span = 140;
		$stock = 0;
		$moves = [];

		//forward logic
		$fcl = function($wk, $free)use(&$moves){
			$in = 0;
			$out = 0;
			
			foreach($moves as $m){
				if($m[0] + $free + 1 > $wk * 7) break;
				//all in before the free date
				$in++;

				//out before last period and in this period but less than free days;
				if($m[1] === null || $m[1] + $free + 1 > $wk * 7) continue;
				if($m[1] + $free < ($wk-1) * 7 || $m[1] - $m[0] < $free){
					$out++;
				}
			}
			return $in - $out;
		};

		//quick logic
		$qcl = function($wk, $free)use(&$moves){
			$in = 0; 
			$out = 0;

			// stock balance ending last period
			$sbd = $wk * 7 - $free;
			if($sbd < 0) $sbd = 0;

			foreach($moves as $m){
				if($m[0] >= $sbd) break;

				//all in before the free date and not out before the billing date
				if($m[1] === null || $m[1] >= $sbd) $in++;
				
				if($m[1] === null || $m[1] >= $sbd) continue;
				//add back out not free
				if($m[1] >= $sbd - 7 && $m[1] - $m[0] >= $free){
					$out--;
				}
			}

			return $in - $out;
		};

		//register moves
		$regMove = function($q, $d) use(&$moves){
			if($q == 0) return;
			if($q > 0){
				for($i = 0; $i < $q; $i++){
					$moves[] = [$d,null];
				}
			}else{
				$pk = [];
				foreach($moves as $k => $m){
					if($m[1] !== null) continue;
					$pk[] = $k;
				}
				shuffle($pk);
				for($i = 0; $i < -$q; $i++){
					$moves[$pk[$i]][1] = $d;
				}
			}
		};

		//generate test data table
		echo '|', str_pad('Week', 6, ' ', STR_PAD_BOTH);
		foreach(['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'] as $d){
			echo '|', str_pad($d, 10, ' ', STR_PAD_BOTH);
		}
		echo '|', PHP_EOL, str_pad('|', 7, '-'), implode('', array_fill(0, 7, str_pad('|', 11, '-')));
		for($i = 0; $i < $span; $i++){
			if($i % 7 == 0) echo '|', PHP_EOL, '|', str_pad(ceil($i / 7) + 1, 6, ' ', STR_PAD_BOTH);
			$m = rand(0, 20 + min($stock, 20)) - min($stock, 20);
			$stock += $m;
			$regMove($m,$i);
			echo '| ', str_pad($stock.'('.($m > 0? '+' : '').$m.')', 9, ' ');
		}
		echo '|', PHP_EOL, PHP_EOL;

		//testing result;
		echo '|', str_pad('Free', 8, ' ', STR_PAD_BOTH);
		$wks = floor($span/7);
		for($i = 1; $i <= $wks; $i++){
			echo '|', str_pad('Wk '.$i, 8, ' ', STR_PAD_BOTH);
		}
		echo '|', str_pad('Total', 8, ' ', STR_PAD_BOTH), '|', PHP_EOL, implode('', array_fill(0, $wks+2, str_pad('|', 9, '-')));

		foreach($free_days as $free){
			echo '|', PHP_EOL, '|', str_pad($free.'D', 8, ' ', STR_PAD_BOTH);
			$ttf = 0;
			$ttq = 0;
			for($i = 1; $i <= $wks; $i++){
				$f = $fcl($i, $free);
				$q = $qcl($i, $free);
				$ttf += $f;
				$ttq += $q;
				echo '|', str_pad($f == $q? ' ='.$f : $f.'/'.$q, 8, ' ', $f == $q? STR_PAD_RIGHT : STR_PAD_BOTH);
			}
			echo '|', str_pad($ttf == $ttq? ' ='.$ttf : $ttf.'/'.$ttq, 8, ' ', $ttf == $ttq? STR_PAD_RIGHT : STR_PAD_BOTH);
		}

		echo '|', PHP_EOL, PHP_EOL;
	}

	public function apfwratio(){
		$date_from = date('Y-m-d', strtotime('-15 day'));
		$date_to = date('Y-m-d', strtotime('-1 day'));
		
		$fw_ir = 1;

		$fwRoundWeight = function($w){
			if ($w <= 0.3) {
				return $w;
			} elseif ($w <= 0.5) {
				return round($w * 12) / 20;
			} elseif ($w <= 1) {
				return 0.35+round(rand(0,100)/100*0.15,2);
			} elseif ($w <= 2) {
				return 0.45+round(rand(0, 100)/100*0.05, 2);//round($w * 5) / 10;//0.35+round(rand(0,100)/100*0.14,2);
			} elseif ($w<=3) {
				return 0.85+round(rand(0, 100)/100*0.14, 2);
			} elseif ($w<=4) {
				return 1.85+ round(rand(0, 100)/100*0.14, 2);//0.85+ round(rand(0,100)/100*0.14,2);
			} elseif ($w <= 5) {
				return 2.85+round(rand(0, 100)/100*0.14, 2);
			} elseif ($w > 5 && $w <= 9) {
				return 5;
			} elseif ($w <= 12.5) {
				return 9;
			} elseif ($w > 12.5) {
				return $w - 3.5;
			} else {
				return $w;
			}
		};
		//get ap zones, weight range
		$sql = 'SELECT z1,pc_lo,pc_hi FROM `zone_map` where org_id = 101 and chargecode_id = 0 and zone_id = 3';
		$ap_zones = $this->db->createCommand($sql)->queryAll();

		$sql = 'SELECT zone,weight_lo,weight_hi,item FROM zone_rate where rate_id = 101 and item > 0';
		$ap_wrs = $this->db->createCommand($sql)->queryAll();

		//get fw zones, weight range
		$sql = 'SELECT z1,pc_lo,pc_hi FROM `zone_map` where org_id = 115 and chargecode_id = 0 and zone_id = 1';
		$fw_zones = $this->db->createCommand($sql)->queryAll();
		
		$sql =  'SELECT zone,weight_lo,weight_hi,item FROM zone_rate where rate_id = 52 and item > 0';
		$fw_wrs = $this->db->createCommand($sql)->queryAll();
		
		//fw new rates
		$fw_wrs = [
['zone' => 'SYD', 'weight_lo' => 0, 'weight_hi' => 0.3, 'item' => 3.65],
['zone' => 'SYD', 'weight_lo' => 0.3, 'weight_hi' => 25, 'item' => 3.95],
['zone' => 'NON-SYD', 'weight_lo' => 0, 'weight_hi' => 0.3, 'item' => 3.65],
['zone' => 'NON-SYD', 'weight_lo' => 0.3, 'weight_hi' => 0.5, 'item' => 4.35],
['zone' => 'NON-SYD', 'weight_lo' => 0.5, 'weight_hi' => 1, 'item' => 4.7],
['zone' => 'NON-SYD', 'weight_lo' => 1, 'weight_hi' => 3, 'item' => 5.55],
['zone' => 'NON-SYD', 'weight_lo' => 3, 'weight_hi' => 5, 'item' => 7.05],
['zone' => 'NON-SYD', 'weight_lo' => 5, 'weight_hi' => 10, 'item' => 8.36],
['zone' => 'NON-SYD', 'weight_lo' => 10, 'weight_hi' => 15, 'item' => 10.25],
['zone' => 'NON-SYD', 'weight_lo' => 15, 'weight_hi' => 20, 'item' => 11.93],
['zone' => 'NON-SYD', 'weight_lo' => 20, 'weight_hi' => 25, 'item' => 14.34],
		];

		//get shipments
		$sql = 'SELECT weight, a.postcode, a.suburb FROM shipment s LEFT JOIN addr a on s.cnee_id = a.id WHERE s.agent_id = 3113 AND s.type = 10 AND s.created >= :df AND s.created <= :dt AND s.pkg = 1 AND s.weight < 20 AND s.status < 100';

		$rs = $this->db->createCommand($sql)->bindValues([':df' => $date_from, ':dt' => $date_to])->queryAll();

		$getZone = function($pc, &$zones){
			foreach($zones as $z){
				if($z['pc_lo'] <= $pc && $z['pc_hi'] >= $pc){
					return $z['z1'];
				}
			}
			return false;
		};

		$getCost = function($weight, $zone, &$wrs){
			foreach($wrs as $r){
				if($r['zone'] != $zone) continue;
				if($r['weight_lo'] < $weight && $r['weight_hi'] >= $weight){
					return $r['item'];
				}
			}
			return false;
		};

		$ap_stat = [];
		$fw_stat = [];
		$metro_diff = [];
		$diff_stat = [];

		foreach($rs as $r){
			$ac = false;
			$fc = false;
			$az = false;
			$fz = false;
			//ap zone
			$az = $getZone($r['postcode'], $ap_zones);
			if($az != false){
//				$ap_stat['zone'][$az]++;
				$ac = $getCost($r['weight'], $az, $ap_wrs);
//				if($ac !== false) $ap_stat['cost'] += $ac;
			}

			//fw zone
			if(FastwayAPI::isInDeliveryArea($r['postcode'], $r['suburb'])){
				$fz = $getZone($r['postcode'], $fw_zones);
				if($fz != false){
					$fw_stat['zone'][$fz]++;
					$fc = $getCost($fwRoundWeight($r['weight']), $fz, $fw_wrs);
					if($fc !== false) $fw_stat['cost'] += $fc;
				}
			}
			
			if($ac !== false && $fc !== false && ($fc * ($fz == 'SYD'? $fw_ir : 1)) < $ac){
				$fw_stat['save'] += $ac-$fc;
				if(in_array(substr($az,1), [0,1])){ //metro
					$metro_diff[] = $ac-$fc;
					$diff_stat[] = $az.','.$fz.','.$r['weight'].','.($ac-$fc);
				}
			}else{
				// if($fc !== false) echo 'F>A '.$fc.' > '.$ac, PHP_EOL;
				$ap_stat['zone'][$az]++;
								if($ac !== false) $ap_stat['cost'] += $ac;
			}
		}
		
		$mr = [0, 0];
		foreach($ap_stat['zone'] as $z=>$q){
			if(in_array(substr($z,1), [0,1])) $mr[0] += $q;
			else $mr[1] += $q;
		}

		//diff
		sort($metro_diff);
		$md = ceil((($mr[0]+$mr[1]) * 0.65 - $mr[0]) / 0.35);
		$at = 0;
		for($ati = 0; $ati < $md; $ati++){
			if($metro_diff[$ati] > 2) break;
			$at += $metro_diff[$ati];
		}
		// $fw_stat['cost'] = $fw_stat['cost'] / $fw_ir;
		
		echo $mr[0].'/'.($mr[0]+$mr[1]).' = '.round($mr[0] / ($mr[0]+$mr[1]) * 10000)/100, '%', PHP_EOL;
		if($md > 0){
			echo 'move '.$ati.' fw metro to ap,'.($mr[0]+$ati).'/'.($mr[0]+$mr[1]+$ati).' = '.(round(($mr[0]+$ati) / ($mr[0]+$mr[1]+$ati) * 10000)/100).'% extra cost: $'.$at, PHP_EOL;
		}
		echo 'Total mixed cost: $', ($ap_stat['cost'] + $fw_stat['cost'] + $at), PHP_EOL;
		echo json_encode($ap_stat),PHP_EOL,json_encode($fw_stat),PHP_EOL;
		
		//diff stat
		//file_put_contents('af_diff.csv', implode(PHP_EOL, $diff_stat));
	}

	public function scapratio(){
		$date_from = '2020-07-01';
		$date_to = '2020-07-31';

		//get ap zones, weight range
		$sql = 'SELECT z1,pc_lo,pc_hi FROM `zone_map` where org_id = 101 and chargecode_id = 0 and zone_id = 3';
		$ap_zones = $this->db->createCommand($sql)->queryAll();
		
		//get shipments
		$sql = 'SELECT s.ref,s.weight, a.postcode, a.suburb FROM shipment s LEFT JOIN addr a on s.cnee_id = a.id WHERE s.agent_id = 3113 AND s.type = 10 AND s.created >= :df AND s.created <= :dt AND s.pkg = 1 AND s.weight < 20 AND s.status < 100';

		$rs = $this->db->createCommand($sql)->bindValues([':df' => $date_from, ':dt' => $date_to])->queryAll();

		$getZone = function($pc, &$zones){
			foreach($zones as $z){
				if($z['pc_lo'] <= $pc && $z['pc_hi'] >= $pc){
					return $z['z1'];
				}
			}
			return false;
		};

		$ap_stat = [0,0];
		$fw = 0;

		foreach($rs as $r){
			if(preg_match('/^(2|Q)X/', $r['ref'])){
				$fw++;
				continue;
			}
			if(!preg_match('/^AMQ/', $r['ref'])){
				continue;
			}
			//ap zone
			$az = $getZone($r['postcode'], $ap_zones);
			if($az != false){
				if(in_array(substr($az,1), [0,1])){
					$ap_stat[0]++;
				}else{
					$ap_stat[1]++;
				}
			}
		}

		var_dump($ap_stat);
		echo (round($ap_stat[0]/array_sum($ap_stat)*10000)/100).'% metro', PHP_EOL;
		echo 'Fastway: '.$fw, PHP_EOL;
	}

	public function fw_change(){
		$fw = new FastwayAPI(true, false, $type);

		$getZone = function($pc, &$zones){
			foreach($zones as $z){
				if($z['pc_lo'] <= $pc && $z['pc_hi'] >= $pc){
					return $z['z1'];
				}
			}
			return false;
		};

		$sql = 'SELECT z1,pc_lo,pc_hi FROM `zone_map` where org_id = 115 and chargecode_id = 0 and zone_id = 1';
		$fw_zones = $this->db->createCommand($sql)->queryAll();

		$rs = ImParcel::model()->findAll('consol_id IN (62627, 63006, 63009)');
		$pc = 0;
		$c = 0;
		foreach($rs as $p){
			$ts = $p->trans[0];
			if($ts->org_id != 115) continue;
			$z = $getZone($p->postcode, $fw_zones);
			$wt = $fw->roundWeight($p->weight);
			if($wt > 0.3 && $z == 'SYD'){
				if(empty($ts->mdata['fw_toRf'])){
					$ts->mdata['fw_toRf'] = 'SYD';
					$ts->mdata['fw_origin'] = 'syd';
					$ts->save();
					echo 'add sort for '.$ts->connote, PHP_EOL;
				};
				continue;
			}
			$csl = ChangeShipmentLabel::model()->find("newref = :ref", [":ref" => $p->ref]);
			if(!empty($csl) || $p->status > 60) continue; // $p->scan_no == 0
			$pref = $p->ref;
			$trans = Yii::app()->db->beginTransaction();
			try{
				$ts->pid = null;
				$ts->save();
				$p->refresh();
				if($p->createFwLabelWithNR()){
					$p->can = $pref;
					unset($p->mdata['fw_cl_err']);
					$p->update(['can', 'meta']);
					$csl = new ChangeShipmentLabel;
					$csl->pid = $p->id;
					$csl->pref = $pref;
					$csl->phbn = $p->hbn;
					$csl->newref = $p->ref;
					$csl->save();
					$c++;
				}else{
					$ts->pid = $p->id;
					$ts->save();
					$p->mdata['fw_cl_err'] = 1;
					$p->nolog = true;
					$p->updateMeta();
					$p->nolog = false;
					$pc++;
					echo $p->hbn,' problem get new label', PHP_EOL;
				}
				$trans->commit();
			} catch (Exception $ex) {
				$trans->rollback();
				throw $ex;
			}
			//echo $p->hbn,' changed ',$pref,' to ',$p->ref, PHP_EOL;
			//break;
		}
		
		echo $c.' success, ',$pc,' failed', PHP_EOL;

		/*$ls = file('fw_change_label.csv');
		foreach($ls as $i => $l){
			$r = explode(',', trim($l));
			if(preg_match('/"([\d\.]+)"/', $r[4], $m)){
				$z = $getZone(substr($r[3],1,-1), $fw_zones);
				$r[5] = $fwRoundWeight($m[1], true);
				$r[6] = $fwRoundWeight($m[1]);
				$r[7] = $z;
				$r[8] = $r[6] > 0.3 && $z == 'SYD' ? 'n' : 'Y';
			}
			$ls[$i] = implode(',', $r).PHP_EOL;
		}
		file_put_contents('fw_change_label_3.csv', implode('', $ls));
		*/
	}

	public function delete_fastway_cache()
	{
		Yii::app()->cache->delete('fastwayArea');
		Yii::app()->cache->delete('fastwaySorting');
		echo 'Done', PHP_EOL;
	}


	public function weightUP3113(){
		$ls = file('3113_weight.tsv');
		$c = 0;
		$trans = Yii::app()->db->beginTransaction();
		try{
			foreach($ls as $l){
				$r = explode("\t", trim($l));
				$r[1] = floatval($r[1]);
				$p = ImParcel::model()->find('t.ref = :r', [':r' => $r[0]]);
				if(empty($p)){
					$csl = ChangeShipmentLabel::model()->find('pref = :r', [':r' => $r[0]]);
					if(!empty($csl)) $p = $csl->shipment;
				}
				if(empty($p)){
					echo $r[0], ' not found', PHP_EOL;
					continue;
				}
				if(abs($r[1] - $p->weight) / $p->weight > 0.2){
					echo 'Weight change >20% '.$p->hbn.' '.$p->weight.' -> '.$r[1], PHP_EOL;
				}
				if($p->weight != round($r[1]*100)/100 && $r[1] > 0){
					$p->weight = $r[1];
					$p->update(['weight']);
					$c++;
				}
			}
			$trans->commit();
		} catch (Exception $ex) {
			$trans->rollback();
			throw $ex;
		}
		echo $c.' shipments updated', PHP_EOL;
	}

	public function weightVari3113(){
		$ls = file('3113_weight.tsv');
		//get fw zones, weight range
		$sql = 'SELECT z1,pc_lo,pc_hi FROM `zone_map` where org_id = 115 and chargecode_id = 0 and zone_id = 1';
		$zones = $this->db->createCommand($sql)->queryAll();

		$sql =  'SELECT zone,weight_lo,weight_hi,item FROM zone_rate where rate_id = 52 and item > 0';
		$wrs = $this->db->createCommand($sql)->queryAll();

		$getZone = function($pc, &$zones){
			foreach($zones as $z){
				if($z['pc_lo'] <= $pc && $z['pc_hi'] >= $pc){
					return $z['z1'];
				}
			}
			return false;
		};

		$getCost = function($weight, $zone, &$wrs){
			foreach($wrs as $r){
				if($r['zone'] != $zone) continue;
				if($r['weight_lo'] < $weight && $r['weight_hi'] >= $weight){
					return $r['item'];
				}
			}
			return false;
		};
		$crs = Consol::model()->findAll('id IN (62627, 63006, 63009)');
		$cs = [];
		foreach($crs as $c){
			$cs[$c->id] = $c->no;
		}

		$csv = ['Consol,HBN,Old Weight,New Weight,Old Cost,New Cost'];
		foreach($ls as $l){
			$r = explode("\t", trim($l));
			$r[1] = floatval($r[1]);
			$p = ImParcel::model()->find('t.ref = :r', [':r' => $r[0]]);
			if(empty($p)){
				$csl = ChangeShipmentLabel::model()->find('pref = :r', [':r' => $r[0]]);
				if(!empty($csl)) $p = $csl->shipment;
			}
			if(empty($p)){
				echo $r[0], ' not found', PHP_EOL;
				continue;
			}
			$ow = 0;
			foreach($p->logs() as $log){
				if(preg_match('/Weight changed from: ([\d\.]+)/', $log->meta, $m)){
					$ow = $m[1];
				}
			}
			if(!isset($cs[$p->consol_id])) echo $p->hbn, ' not in 3 consols?', PHP_EOL;
			$z = $getZone($p->postcode);
			$oc = $getCost($ow, $z);
			$nc = $getCost($p->weight, $z);
			$csv[] = $cs[$p->consol_id].','.$p->hbn.','.$ow.','.$p->weight.','.$oc.','.$nc;
		}
		file_put_contents('../3113_wt_change.csv', implode("\n", $csv));
		echo 'Done', PHP_EOL;
	}
	
	public function csladdpid(){
		$rs = ChangeShipmentLabel::model()->findAll();
		$trans = Yii::app()->db->beginTransaction();
		try{
			foreach($rs as $r){
				$p = ImParcel::model()->find('hbn = :n', [':n' => $r->phbn]);
				if(!empty($p)){
					$r->pid = $p->id;
					$r->update(['pid']);
				}
			}
			$trans->commit();
		} catch (Exception $ex) {
			$trans->rollback();
			throw $ex;
		}
		echo 'Done', PHP_EOL;
	}

	public function shipmentfromarchive(){
		$hbn = $this->prompt("HBN: ");
		$db = $this->db;
		$sql = 'SELECT * FROM shipment_archive WHERE hbn = :hbn';
		$r = $db->createCommand($sql)->bindValues([':hbn' => $hbn])->queryRow();
		if(empty($r)){
			echo $hbn.' not found in archive', PHP_EOL;
			return;
		}
		//var_dump($r);
		$transArch = function ($ss, $m=[]) use (&$db) {
			$trans = $db->beginTransaction();
			try {
				foreach ($ss as $sql) {
					echo $sql, PHP_EOL;
					$cmd = $db->createCommand($sql);
					if(!empty($m)) $cmd->bindValues($m);
					$cmd->execute();
				}
				$trans->commit();
			} catch (Exception $ex) {
				$trans->rollback();
				throw $ex;
			}
		};

		//restore edimsg
		$transArch([
				'INSERT INTO `edimsg` SELECT * FROM `edimsg_archive` where fid = :fid',
				'DELETE FROM `edimsg_archive` WHERE fid = :fid',
			], [':fid' => $r['id']]);

		//restore logs
		$transArch([
				'INSERT INTO `log` SELECT * FROM `log_archive` WHERE lid = :fid',
				'DELETE FROM `log_archive` WHERE lid = :fid',
			], [':fid' => $r['id']]);

		//tracking
		$transArch([
			'INSERT INTO `tracking` SELECT * FROM `tracking_archive` WHERE pid = :fid',
			'DELETE FROM `tracking_archive` WHERE pid = :fid',
		], [':fid' => $r['id']]);

		//address
		foreach (['cnor_id', 'cnee_id', 'receiver_id', 'notify_id'] as $f) {
			if(empty($r[$f])) continue;
			$transArch([
				'INSERT INTO `addr` SELECT * FROM `addr_archive` WHERE `id` = :fid',
				'DELETE FROM `addr_archive` WHERE id = :fid',
			], [':fid' => $r[$f]]);
		}

		//shipment
		$transArch([
			'INSERT INTO `shipment` SELECT * FROM `shipment_archive` s WHERE id = :id',
			'DELETE FROM `shipment_archive` WHERE id = :id',
		], [':id' => $r['id']]);

		echo 'Done', PHP_EOL;
	}

	public function gvShipper(){
		$data = $this->_loadXlsData($this->args[1]);
		$trans = Yii::app()->db->beginTransaction();
		try{
			foreach($data as $r){
				$p = ImParcel::model()->find('ref = :r', [':r' => $r[1]]);
				if(empty($p)){
					echo $r[1], ' not found', PHP_EOL;
					continue;
				}
				$p->cnor->name = $r[2];
				$p->cnor->address = $r[3];
				$p->cnor->suburb = $r[4];
				$p->cnor->state = $r[5];
				$p->cnor->country = $r[7];
				$p->cnor->save();
			}
			$trans->commit();
		} catch (Exception $ex) {
			$trans->rollback();
			throw $ex;
		}
		echo 'Done', PHP_EOL;
	}

	public function fwmanifest(){
		//by shipment scan time
		$sql = 'select s.id, date(json_value(s.meta, "$.scan_time")) as day from tranship t left join shipment s on s.id = t.pid WHERE t.org_id = 115 and t.status > 10 and s.created >= "2020-01-01"';

		$rs = $this->db->createCommand($sql)->queryAll();
		$mans = [];
		foreach($rs as $r){
			if(empty($r['day'])) continue;
			$mans[$r['day']][] = $r['id'];
		}

		foreach($mans as $day => $ss){
			$ref = 'Checkin_'.$day;
			$trans = Yii::app()->db->beginTransaction();
			try{
				$mani = Manifest::model()->find('type = 90 AND fwd_id = 115 AND ref = :r', [':r' => $ref]);
				if(empty($mani)){
					$mani = new Manifest;
					$mani->type = 90;
					$mani->fwd_id = 115;
					$mani->ref = $ref;
					$mani->created = $day.' 23:59:59';
					$mani->save();
				}
				foreach($ss as $s){
					$sql = 'SELECT p.id FROM mani_map p INNER JOIN manifest m ON m.id = p.mani_id WHERE m.type = 90 AND p.fid = :pid';
					$t = $this->db->createCommand($sql)->bindValues([':pid' => $s])->queryScalar();
					if(!empty($t)) continue;
					$mm = new ManiMap;
					$mm->mani_id = $mani->id;
					$mm->fid = $s;
					$mm->model = 'ImParcel';
					$mm->save();
				}
				$trans->commit();
			} catch (Exception $ex) {
				$trans->rollback();
				throw $ex;
			}
			echo $day.' manifest done', PHP_EOL;
		}
		echo 'Done', PHP_EOL;

		return;
		//by shipment_scan table
		$sql = 'select pid, date(scan_time) as day from (select ss.pid, ss.scan_time from tranship t left join shipment_scan ss on ss.pid = t.pid WHERE t.org_id = 115 and t.status > 10 and ss.scan_time >= "2020-01-01") t GROUP by pid order by scan_time';

		$rs = $this->db->createCommand($sql)->queryAll();
		$mans = [];
		foreach($rs as $r){
			$mans[$r['day']][] = $r['pid'];
		}

		foreach($mans as $day => $ss){
			$ref = 'Checkin_'.$day;
			$trans = Yii::app()->db->beginTransaction();
			try{
				$mani = new Manifest;
				$mani->type = 90;
				$mani->fwd_id = 115;
				$mani->ref = $ref;
				$mani->created = $day.' 23:59:59';
				$mani->save();
				foreach($ss as $s){
					$sql = 'SELECT p.id FROM mani_map p INNER JOIN manifest m ON m.id = p.mani_id WHERE m.type = 90 AND p.fid = :pid';
					$t = $this->db->createCommand($sql)->bindValues([':pid' => $s])->queryScalar();
					if(!empty($t)) continue;
					$mm = new ManiMap;
					$mm->mani_id = $mani->id;
					$mm->fid = $s;
					$mm->model = 'ImParcel';
					$mm->save();
				}
				$trans->commit();
			} catch (Exception $ex) {
				$trans->rollback();
				throw $ex;
			}
			echo $day.' manifest done', PHP_EOL;
		}
		echo 'Done', PHP_EOL;
	}

	public function APIntShipment(){
		$hbns = $this->prompt('HBN: ');
		$up = strtoupper($this->prompt('Update: ', 'N'));
		
		$apa = new AusPostAPI('syd', true, false); //TMA

		$pcode = strtoupper($this->prompt('Product (ECM8/AIR8/PTI8):', 'AIR8'));

		foreach(preg_split('/[\s,;]/', trim($hbns)) as $hbn){
			$p = ExParcel::model()->find('hbn = :h', [':h' => $hbn]);
			if($up == 'Y'){
				//echo 'Updating '.$hbn.PHP_EOL;
				$r = $apa->updateIntShipment($p->mdata['apsid'], $p, $pcode);
			}else{
				//echo 'Creating '.$hbn.PHP_EOL;
				$p->ref = '';
				$r = $apa->createIntShipments($p, $pcode);
				$p->mdata['apsid'] = $r->shipments[0]->shipment_id;
				$p->ref = $r->shipments[0]->items[0]->tracking_details->article_id;
				$p->status = 25;
			}

			$r2 = $apa->createLabels($p->mdata['apsid']);

			foreach($r2->labels as $lbl){
				$t = 0;
				while($t < 5){
					sleep(2);
					$r3 = $apa->getLabel($lbl->request_id);
					foreach($r3->labels as $l){
						if(empty($l->url)) continue;
						$p->note = $l->url;
						echo 'wget "'.$l->url.'" -O '.$p->ref.'.pdf'.PHP_EOL;
						break 2;
					}
					$t++;
				}
			}
			$p->save();
		}
		echo 'Done', PHP_EOL;
	}

