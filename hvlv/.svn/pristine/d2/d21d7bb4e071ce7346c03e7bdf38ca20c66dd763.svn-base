	public function entry2file(){
		$rs = FileRepo::model()->findAll("type = 28 AND name LIKE '%entryprint%'");
		$c = 0;
		foreach($rs as $r){
			$pdf = new modiPDF($r->getFile());
			if(preg_match('/REF : PCA ([^\s]+)/i', $pdf->rawText(), $m)){
				$p = ImParcel::model()->find('hbn = :n', [':n' => $m[1]]);
				if($p){
					if(FileRepo::model()->count('fid = :fid AND type = :t AND hash = :h', [':fid' => $p->id, ':t' => 19, ':h' => $r->hash]) == 0){
						$r->isNewRecord = true;
						$r->id = null;
						$r->type = 19;
						$r->fid = $p->id;
						$r->save();
						echo $p->hbn.PHP_EOL;
						$c++;
					}
				}
			}
		}
		echo $c.' Done', PHP_EOL;
	}

	public function wwArabic(){
		$ls = file('ww_arabic.txt');
		$id = 0;
		$ds = [];
		foreach($ls as $l){
			if(preg_match('/^(\d{6})$/', trim($l), $m)){
				$id = $m[1];
				continue;
			}
			$ds[$id][] = trim($l);
		}

		foreach($ds as $id => &$d){
			$u = true;
			foreach($d as $k => $v){
				if($k == 0){
					$t = $d[0];
					continue;
				}elseif($u){
					unset($d[$k]);
					if($k > 0 && $v == $t) $u = false;
					continue;
				}

				if(preg_match('/^[\w\- ]+$/', $v) && !preg_match('/^propose/i', $v)){
					// echo $id, ':'.$k.' ', $v, PHP_EOL;
					unset($d[$k]);
				}
			}
			$d = array_values($d);
			$d = array_merge(array_slice($d, 0, 3), [implode(' ', array_slice($d, 3, -1))], array_slice($d, -1));
			echo '<div style="width: 30%"><p><b>'.$id.'</b><br />'.implode("<br />\n", $d).'</p></div>',PHP_EOL;
		}
	}

	public function starTrackPriceDAT(){
		$ls = file($this->args[1]);
		$cps = [[0,8], [8,3], [11,3], [14,3], [17,1], [21, 3], [24,6], [30,1], [31,6], [37,5], [42,1], [45,7]];
		$c = 0;
		foreach($ls as $l){
			$l = trim($l);
			$r = [];
			foreach($cps as $i => $p){
				$r[] = substr($l, $p[0], $p[1]);
				if(in_array($i, [5,9])){
					$r[$i] = intval($r[$i]);
				}elseif(in_array($i, [6,8,11])){
					$r[$i] = floatval($r[$i]);
				}
			}
			if($r[1] != 'EXP' || !in_array($r[2], ['SYD'])) continue;
			var_dump($r);
			$c++;
		}
		echo $c.' Done', PHP_EOL;
	}

	public function regetAupostCost(){
		$orderId = 'AP04957632';
		$aupostApi = new AusPostAPI('syd', true);
		$orderInfo = $aupostApi->getOrder($orderId);
		if ( !empty($orderInfo->order) ) {
			foreach ($orderInfo->order->shipments as $aushipment) {
				$ims = ImParcel::model()->find('hbn = :hbn', [':hbn' => $aushipment->shipment_reference]);
				if (!empty($ims)) {
					$ts = Tranship::model()->find('org_id = 101 AND pid = :pid', [':pid' => $ims->id]);
					if (empty($ts)) {
						$ts = new Tranship;
						$ts->pid = $ims->id;
						$ts->org_id = 101;  // for Australia post office
						$ts->man_id = $ims->man_id;
						$ts->type = 80;  // shipment transfer to a different delivery courier
						$ts->status = 19; // in finally moving status
						$ts->connote = $ims->ref;
						$ts->time = date('Y-m-d H:i:s');
						$ims->mdata['direct_courier']=1;
						$ims->cbwf=($ims->cbwf^32)&$ims->cbwf;
						$ims->cbwf=$ims->cbwf|64;
						$ims->updateMeta();
						$ims->update(['cbwf']);
					}

					$ts->mdata['oid'] = $orderId;
					$ts->mdata['sid'] = $aushipment->shipment_id;
					$costValue = floatval($aushipment->shipment_summary->total_cost - $aushipment->shipment_summary->total_gst);
					$ts->cost = round($costValue, 2);
					$ts->save();
				}
				echo 'done for shipment : ' . $ims->ref . PHP_EOL;
			}
		}
		echo 'Done', PHP_EOL;
	}

	public function AupostcodesFromPDF(){
		//lat lon from geonames.org
		$tf = '_au_postcode.zip';
		$df = file_put_contents($tf, file_get_contents('https://download.geonames.org/export/zip/AU.zip'));
		$zip = new ZipArchive;
		$cords = [];
		if ($zip->open($tf) === TRUE) {
			$rs = explode("\n", $zip->getFromName('AU.txt'));
			foreach($rs as $r){
				$d = explode("\t", trim($r));
				if(empty($d[1])) continue;
				$cords[strtoupper($d[2]).strtoupper($d[4]).$d[1]] = [$d[9], $d[10]];
			}
			ksort($cords);
			$zip->close();
		} else {
			echo 'failed reading zip file';
		}
		unlink($tf);

		$tf = '_au_postcodes.pdf';

		//remove pdf security;
		exec('C:\Progra~2\PDFtk\bin\qpdf.exe --decrypt '.$this->args[1].' '.$tf);
		include_once(Yii::app()->basePath.DIRECTORY_SEPARATOR.'vendor/autoload.php');
		$parser = new \Smalot\PdfParser\Parser;
		$pdf = $parser->parseFile($tf);
		$d = $pdf->getText();
		$d = preg_replace('/^[A-Z]{1}[\n\r]+/m', '\n', $d);
		$d = preg_replace('/[\’]+/', "'", $d);
		$d = preg_replace('/\s*'.chr(194).chr(173).'\s*/', '-', $d);
		$d = preg_replace('/(\d+)\s+(\d+)\s*/', '$1$2', $d);
		//Care PO
		$d = preg_replace('/Care PO/', "", $d);
		// file_put_contents('_postcode_au.txt', $d);
		// $d = file_get_contents('_postcode_au.txt');
		preg_match_all('/((?:NO[\.\s]+\d+)?[A-Z\'\s\(\)\-]+)(N\s*S\s*W|V\s*I\s*C|S\s*A|W\s*A|N\s*T|T\s*A\s*S|Q\s*L\s*D|A\s*C\s*T)[\s]+(\d{4})/sm', $d, $m);
		//var_dump($m);

		$xls = new oExcel;
		$xls->setColWidth([15,10,10,10,10]);
		$i = 1;
		$xls->addRow($i++, ['Suburb', 'State', 'Postcode', 'Lat', 'Lon']);
		$pcs = [];
		foreach($m[1] as $k => $v){
			$suburb = preg_replace(['/\t/', '/[\s]+/'], ['', ' '], trim($v));
			$state = preg_replace('/\s+/', '', $m[2][$k]);
			$postcode = trim($m[3][$k]);
			$pcs[$suburb.$state.$postcode] = [strtoupper($suburb), $state, '="'.$postcode.'"'];
			if(!empty($cords[$suburb.$state.$postcode])){
				$pcs[$suburb.$state.$postcode][3] = $cords[$suburb.$state.$postcode][0];
				$pcs[$suburb.$state.$postcode][4] = $cords[$suburb.$state.$postcode][1];
			}
		}
		ksort($pcs);
		foreach($pcs as $r){
			$xls->addRow($i++, $r);
		}
		$xls->output('postcode_au.xlsx', null, false);
		unlink($tf);
		//report difference
		$rs = Postcode::model()->findAll('country = "AU"');
		foreach($rs as $r){
			if(!isset($pcs[$r->suburb.$r->state.$r->postcode])){
				echo '- ',$r->suburb, "\t", $r->state, "\t", $r->postcode, PHP_EOL;
			}else{
				$pcs[$r->suburb.$r->state.$r->postcode][5] = 1;
			}
		}
		foreach($pcs as $k => $r){
			if(empty($r[5])) echo '+ ',$r[0], "\t", $r[1], "\t", preg_replace('/[^\d]+/', '', $r[2]), PHP_EOL;
		}
		echo 'Done', PHP_EOL;
		return $pcs;
	}

	public function NZpostcodes(){
		$tf = '_nz_postcode.zip';
		$df = file_put_contents($tf, file_get_contents('https://download.geonames.org/export/zip/NZ.zip'));
		$zip = new ZipArchive;
		$xls = new oExcel;
		$xls->setColWidth([15,10,10,10,10]);
		$i = 1;
		$xls->addRow($i++, ['Suburb', 'State', 'Postcode', 'Lat', 'Lon']);
		$pcs = [];
		if ($zip->open($tf) === TRUE) {
			$rs = explode("\n", $zip->getFromName('NZ.txt'));
			foreach($rs as $r){
				$d = explode("\t", trim($r));
				if(empty($d[1])) continue;
				$pcs[$d[2].$d[3].$d[1]] = [$d[2], $d[3], '="'.$d[1].'"', $d[9], $d[10]];
			}
			ksort($pcs);
			$zip->close();
		} else {
			echo 'failed reading zip file';
		}
		foreach($pcs as $r){
			$xls->addRow($i++, $r);
		}
		$xls->output('postcode_nz.xlsx', null, false);
		unlink($tf);
		echo 'Done', PHP_EOL;
		return $pcs;
	}

	public function upPostCode(){
		$this->db->createCommand('TRUNCATE TABLE postcode')->execute();
		
		$trans = Yii::app()->db->beginTransaction();
		try{
			foreach(['AU' => 'postcode_au.xlsx', 'NZ' => 'postcode_nz.xlsx'] as $c => $f){
				$data = $this->_loadXlsData($f);
				unset($data[0]);
				foreach($data as $i=>$d){
					$a = new Postcode;
					$a->country = $c;
					$a->suburb = $d[1];
					$a->state = $d[2];
					$a->postcode = $d[3];
					$a->lat = $d[4];
					$a->lon = $d[5];
					$a->save();
				}
			}
			$trans->commit();
		} catch (Exception $ex) {
			$trans->rollback();
			throw $ex;
		}
		echo 'Done', PHP_EOL;
	}

	public function winitZoneCost(){
		$xls = new oExcel;
		$xls->supported($this->args[1]);
		$xls->load($this->args[1]);
		ini_set('precision', 12);
		foreach($xls->xls->getAllSheets() as $n => $sheet){
			$rid = $sheet->getTitle();
			$rs = $xls->getAll($sheet);
			//echo $t, PHP_EOL;
			$wbs = [];
			foreach($rs as $i => $r){
				if(empty($r[1])) continue;
				if($i == 1){ //header
					foreach($r as $c => $d){
						if(preg_match('/^([\d\.]+)(?:kg)?\-([\d\.]+)kg$/i', trim($d), $m)){
							$wbs[$c] = [$m[1], $m[2]];
						}
					}
					// var_dump($wbs);
				}else{
					foreach($wbs as $c => $wb){
						$zr = ZoneRate::model()->find('rate_id = :rid AND zone = :z AND weight_lo = :wl AND weight_hi = :wh', [':rid' => $rid, ':z' => $r[2], ':wl' => $wb[0], ':wh' => $wb[1]]);
						if(empty($zr)){
							$zr = new ZoneRate;
							$zr->rate_id = $rid;
							$zr->zone = $r[2];
							$zr->zone_name = $r[1];
							$zr->weight_lo = $wb[0];
							$zr->weight_hi = $wb[1];
						}
						$zr->item = round($r[$c]*1000)/1000;
						$zr->save();
						$errs = $zr->getErrors();
						if(!empty($errs)){ var_dump($zr->item); var_dump($errs); }
					}
				}
			}
		}
		echo "Done", PHP_EOL;
	}

	public function fixDupMailuser(){
		$sql = 'SELECT count(id) as c, mail_id, user_id FROM `mail_user` group by mail_id, user_id having c > 1';
		$rs = $this->db->createCommand($sql)->queryAll();
		foreach($rs as $r){
			$mu = MailUser::model()->findAll(['condition' => 'mail_id = :mid AND user_id = :uid', 'params' => [':mid' => $r['mail_id'], ':uid' => $r['user_id']], 'order' => 't.id']);
			foreach($mu as $i => $m){
				if($i > 0) $m->delete();
			}
		}
		echo "Done", PHP_EOL;
	}

	public function upSCdetails(){
		$data = $this->_loadXlsData($this->args[1]);
		$c = 0;
		ini_set('precision', 12);
		
		$trans = Yii::app()->db->beginTransaction();
		try{
			foreach($data as $i => $r){
				if($i < 2 || empty($r[1])) continue;
				$p = ImParcel::model()->find('hbn = :h', [':h' => $r[1]]);
				if(empty($p)){
					echo $r[1]." not found \n";
					continue;
				}
				$p->weight = round($r[3]*100)/100;
				$p->cbm = round($r[17]*1000)/1000;
				$p->pkg = $r[12];
				$p->eitems['g'][0] = $r[13];
				$p->eitems['q'][0] = $r[14];
				$p->eitems['v'][0] = round($r[16] / $r[14], 2);
				$p->save();

				$p->cnee->name = $r[4];
				$p->cnee->tel = $r[6];
				$p->cnee->address = $r[7];
				$p->cnee->suburb = $r[8];
				$p->cnee->state = $r[9];
				$p->cnee->postcode = $r[10];
				$p->cnee->save();
				$p->cnor->name = $r[18];
				$p->cnor->address = $r[19];
				$p->cnor->city = $r[20];
				$p->cnor->state = $r[21];
				$p->cnor->save();
				$c++;
			}
			$trans->commit();
		} catch (Exception $ex) {
			$trans->rollback();
			throw $ex;
		}
		echo $c." updated\n";
	}

	public function scupdateacr(){
		$resendACR = function($id){
		$resp = ['success' => 0];

		$p = ImParcel::model()->findByPk($id);
		if ($p->status == 50 || $p->status == 55) {
			$cn = $p->consol;
			if (in_array($p->agent_id, SystemSetting::getNameValidationCustomers())) {
				$goods = WordReplace::replace($p->getGoods(), $p->agent_id, $p)[0];
			} else {
				$goods = $p->getGoods();
			}
			
			$err = [];
			if (empty($p->weight)) {
				$err[] = 'Shipment ' . $p->hbn . ' has no weight.';
			}
			if (empty($p->dvalue)) {
				$err[] = 'Shipment ' . $p->hbn . ' has no value.';
			}
			if (empty($p->pkg)) {
				$err[] = 'Shipment ' . $p->hbn . ' has number of packs.';
			}
			if (empty($goods)) {
				$err[] = 'Shipment has no goods description.';
			}

			$cnor_name = $p->cnor->name;
			if (!preg_match('/\w/', $cnor_name)) $cnor_name = $p->agent->name;
			$cnor_name = Edimsg::strEscape($cnor_name);
							
			if(empty($cnor_name)){
				$err[] = 'Shipment '.$p->hbn.' cnor name problem';
			}

			$cnor_addr = $p->cnor->fullAddress(['suburb', 'city', 'state', 'postcode']);
			if (!preg_match('/\w/', $cnor_addr)) {
				$cnor_addr = $p->agent->getAddress(true, false, false);
			}
			$cnor_addr = trim($cnor_addr, " .,");
			$cnor_addr = Edimsg::strEscape($cnor_addr);
							
			if(empty($cnor_addr)){
				$err[] = 'Shipment '.$p->hbn.' cnor address problem';
			}

			if (!empty($p->receiver)&&!empty($p->receiver->address)&&!empty($p->receiver->name)&&!empty($p->receiver->postcode)) {
				$cnee_name=$p->receiver->name;
				$cnee_addr=$p->receiver->fullAddress(['suburb', 'state', 'postcode']);
			} else {
				$cnee_name=$p->cnee->name;
				$cnee_addr=$p->cnee->fullAddress(['suburb', 'state', 'postcode']);
			}

			$cnee_name = Edimsg::strEscape($cnee_name);
			$cnee_addr = Edimsg::strEscape($cnee_addr);

			if(empty($cnee_name) || !preg_match('/[A-z]+/', $cnee_name)){
				$err[] = 'Shipment '.$p->hbn.' cnee name problem';
			}
			if(empty($cnee_addr) || !preg_match('/[A-z]+/', $cnee_addr)){
				$err[] = 'Shipment '.$p->hbn.' cnee address problem';
			}

			if(!empty($err)){
				$resp['msg'] = implode('<br />', $err);
				echo json_encode($resp);
				return;
			}

			if ($cn->service == 20) {//sea cargo

				$os = Edimsg::model()->findAll(['condition' => "status = 50 AND type = 'SEACR-S' AND fid = :id", 'params' => [':id' => $p->id], 'order' => 't.id DESC']);
				$omid = null;
				if (!empty($os)) {
					foreach ($os as $o) {
						if (preg_match('/BGM\+933:::SEACR\+([^\+:]+):\d+\+9\'/', $o->msg, $m)) {
							$omid = $m[1];
							break;
						}
					}
				}
				
				if(Edimsg::model()->count('fid = :id AND type ="SEACR-S" AND status IN (20, 30, 40)', [':id' => $p->id]) > 0){
					$resp['msg']='There is an SCR message waiting for response from ICS, please try again later.';
					echo json_encode($resp);
					return;
				}

				$canSac = $p->canSAC();
				$obl=$cn->awb;// /required ocean bill landing
				$hbl=$cn->mdata['house_bill'];//house bill landing;// parent house bill landing
			//A document signed and delivered by the Master of a Ship to the consignor. A document of title and a receipt for goods.
				$voyage_number=$cn->flight ;// like 023s
				$vessel=$cn->airline; //IMO  like 9235103
				$container_number=$cn->mdata['container_no'];//container no  like OOLU9551594
				$container_size= DmawbConsol::getContainerCode($cn->mdata['sea_type']);
				$cargo_type=$cn->mdata['cargo_type'];
				if (empty($cargo_type)) $cargo_type="LCL";
				$volume=$p->cbm>0?$p->cbm*$p->pkg:$p->weight/250;
				if ($volume<0.01) $volume=0.01;

				$em = new Edimsg;
				$em->dt = date('Y-m-d H:i:s');
				$em->type = 'SEACR-S';
				$em->sender = Yii::app()->params['ics']['testing']? Yii::app()->params['ics']['test_site'] : Yii::app()->params['ics']['prod_site'];
				$em->receiver = Yii::app()->params['ics']['customs_id'];
				$em->status = 19;
				$em->fid = $p->id;
				$em->save();
				$em->mid = sprintf('%06s', substr($em->id, -6));
				$vn = Edimsg::model()->count('type = :t AND fid = :fid', [':t' => 'SEACR-S', ':fid' => $p->id]) + 1;
				$msg = "UNH+".$em->mid."+CUSCAR:D:99B:UN'
BGM+933:::SEACR+" . (empty($omid)?  $p->hbn.'-'.$vn : $omid). ":" . $vn . "+".(empty($omid)? 9 : 4)."'
RFF+PQ:PO'\n";
				if(!empty($hbl)) $msg .= "RFF+BM:".$hbl."'\n";
				//use word replace service;
				$msg .= "RFF+BH:".$p->hbn."'
RFF+MB:".$obl."'
NAD+AH+".Yii::app()->params['ics']['abn']."::95'
NAD+VW+".Yii::app()->params['ics']['abn']."::95'
NAD+CN++".Edimsg::strSegment($cnee_name, 35, 2).":".Edimsg::strSegment($cnee_addr, 35, 3)."'
NAD+CZ++".Edimsg::strSegment($cnor_name, 35, 2).":".Edimsg::strSegment($cnor_addr, 35, 3)."'
TDT+20+".$voyage_number."++11++++".$vessel."::11'
LOC+8+".$cn->pod."::6'
LOC+12+".$cn->pod."::6'
LOC+27+".substr($cn->pol, 0, 2)."::5'
LOC+76+".$cn->pol."::6'
LOC+73+".$cn->pol."::6'
CNI++:::".(empty($omid)? 'I' : 'A')."'
RFF+AAQ:".$container_number."'
GID+1'
RFF+ACC:".$container_size."'
GID+1'
RFF+ZZZ:1'
".($canSac ? "GIS+SAC:109:95'\n" : "")."GID+1'
PAC+".$p->pkg."'
PAC+++".$cargo_type.":67:95'
PAC+++GENN:121:95'
PAC+++PK:185:95'
FTX+AAA+++".Edimsg::strSegment(str_replace('/', ',', trim($goods, '/')), 512, 5)."'
MEA+AAE+AAL+KG:".sprintf("%.2f", $p->weight)."'
MEA+AAE+ABJ+CU:".sprintf("%.2f", $volume)."'
MEA+AAE+G+KG:".sprintf("%.2f", $p->weight)."'
";
				$mc = substr_count($msg, "\n")+1;
				$msg .= "UNT+".$mc."+".$em->mid."'";
				$em->msg = $msg;
				if (Yii::app()->params['ics']['testing']) {
					$em->mdata['test'] = 1;
				}
			}else{

			// get related console information
			$cn = $p->consol;
			$hwb = empty($cn->mdata['house_bill'])? $cn->no : $cn->mdata['house_bill'];
			$airline = substr(trim($cn->airline), 0, 2);
			$flight = substr(trim($cn->flight), 2);
			//$flight = preg_replace('/[^\d]+/', '', $cn->flight);
			$awb = preg_replace('/[^\d]+/', '', $cn->awb);


			// only value < 750USD can SAC
			// or 1000 AUD can be SAC (Self Assessed Clearance) only
			if (!empty($_GET['config_check'])) {
				if (!empty($_GET['can_sac'])) {
					$canSac=true;
				} else {
					$canSac=false;
				}
			} else {
				$canSac = $p->canSAC();
			}
			$os = Edimsg::model()->findAll(['condition' => "status = 50 AND type = 'AIRCR-S' AND fid = :id", 'params' => [':id' => $p->id], 'order' => 't.id DESC']);
			$omid = null;
			if (!empty($os)) {
				foreach ($os as $o) {
					if (preg_match('/MWB:'.$awb.'/', $o->msg) && preg_match('/BGM\+933:::AIRCR\+([^\+:]+):\d+\+9\'/', $o->msg, $m)) {
						$omid = $m[1];
						break;
					}
				}
			}
			
			if(Edimsg::model()->count('fid = :id AND type ="AIRCR-S" AND status IN (20, 30, 40)', [':id' => $p->id]) > 0){
				$resp['msg']='There is an ACR message waiting for response from ICS, please try again later.';
				echo json_encode($resp);
				return;
			}

			/*if (empty($omid)) {
				$resp['msg']='Original MSG not found for '.$p->hbn;
				echo json_encode($resp);
				return;
			}*/

			$em = new Edimsg;
			$em->dt = date('Y-m-d H:i:s');
			$em->type = 'AIRCR-S';
			$em->sender = Yii::app()->params['ics']['testing'] ? Yii::app()->params['ics']['test_site'] : Yii::app()->params['ics']['prod_site'];
			$em->receiver = Yii::app()->params['ics']['customs_id'];
			$em->status = 19;
			$em->fid = $p->id;
			$em->save();
			$em->mid = sprintf('%06s', substr($em->id, -6));
			$vn = Edimsg::model()->count('type = :t AND fid = :fid', [':t' => 'AIRCR-S', ':fid' => $p->id]) + 1;
			$msg = "UNH+" . $em->mid . "+CUSCAR:D:99B:UN'
BGM+933:::AIRCR+" . (empty($omid)?  $p->hbn.'-'.$vn : $omid). ":" . $vn . "+".(empty($omid)? 9 : 4)."'
RFF+PQ:PO'
RFF+AWB:" . $hwb . "'\n";
			$msg .= "RFF+HWB:" . $p->hbn . "'
RFF+MWB:" . $awb . "'
NAD+CN++" . Edimsg::strSegment($cnee_name, 35, 2) . ":" . Edimsg::strSegment($cnee_addr, 35, 3) . "'
NAD+CZ++" . Edimsg::strSegment($cnor_name, 35, 2) . ":" . Edimsg::strSegment($cnor_addr, 35, 3) . "'
NAD+VW+" . Yii::app()->params['ics']['abn'] . "::95'
TDT+20+" . $flight . "++6+" . $airline . "::3'
LOC+8+" . $cn->pod . "::6'
LOC+76+" . $cn->pol . "::6'
LOC+12+" . $cn->pod . "::6'
LOC+91+" . $cn->pol . "::6'
DTM+178:" . date("Ymd", strtotime($cn->eta)) . ":102'
CNI+1'
RFF+UCN:" . $p->hbn . "'
MOA+44:" . sprintf("%.2f", $p->getDvalue()) . ":USD'
" . ($canSac ? "GIS+SAC:109:95'\n" : "") . "GID+1'
PAC+" . $p->pkg . "'
FTX+AAA+++" . Edimsg::strSegment(str_replace('/', ',', trim($goods, '/')), 512, 5) . "'
MEA+AAE+G+KG:" . sprintf("%.2f", $p->weight) . "'
";
			$mc = substr_count($msg, "\n") + 1;
			$msg .= "UNT+" . $mc . "+" . $em->mid . "'";
			$em->msg = $msg;
			if (Yii::app()->params['ics']['testing']) {
				$em->mdata['test'] = 1;
			}
		}
			//echo $msg;
			$em->status = 20;
			$em->save();
			$p->save();

			$resp['success'] = 1;
		} else {
			$resp['success']   = 0;
			$resp['msg'] = 'The shipment status is wrong : only for HELD and REPORTED status';
		}
		return $resp;
	};
		$c = DmawbConsol::model()->findByPk(25026);
		foreach($c->shipments as $s){
			$r = $resendACR($s->id);
			if($r['success'] != 1){
				echo $s->hbn,'/',$s->ref,PHP_EOL;
				var_dump($r);
			}
		}

		echo 'Done',PHP_EOL;
	}

	public function tntmel(){
		$tnt = TntAPI::getTntInterface('mel');
		$p = ImParcel::model()->find('hbn = :hbn', [':hbn' => $this->prompt("HBN: ")]);
		$ss_mel = [$p];
		if(!$tnt->preEt12File($ss_mel)){
			echo "Melbourne TNT manifest Failed";
		}
		echo 'Done',PHP_EOL;
	}

	public function fixddpcainv(){
		$rs = Invoice::model()->findAll('date > "2017-06-30" AND type = 41 AND to_id != 1228 AND status IN (2,3)');
		foreach($rs as $r){
			if($r->mdata['name'] != $r->cust->name){
				$r->mdata['name'] = $r->cust->name;
				$r->mdata['address'] = $r->cust->getAddress();
				$r->save();
				echo $r->no, ' updated', PHP_EOL;
			}
		}
		echo 'Done', PHP_EOL;
	}

	public function badDebt(){
		$rs = Payment::model()->findAll('ref LIKE :r AND date = :d AND ata > 0', [':r' => '%bad debt%', ':d' => '2018-12-31']);
		foreach($rs as $r){
			$invs = Invoice::model()->findAll('to_id = :id AND status IN (2,3,6,7)', [':id' => $r->org_id]);
			$tt = 0;
			foreach($invs as $inv){
				$tt += $inv->getBalance();
			}
			if($tt != $r->ata){
				echo $r->org_id,' Balance incorrect!', PHP_EOL;
			}else{
				foreach ($invs as $inv) {
					$pi = new PayInv();
					$pi->inv_id = $inv->id;
					$pi->pay_id = $r->id;
					$pi->amount = $inv->getBalance();
					$pi->exrate = 1;
					$pi->save();
					$inv->checkPaid();
					$inv->save();
				}
				$r->updateAta();
			}
		}
		echo 'Done', PHP_EOL;
	}

