	public function repushubiaid(){
		$ps = file('wrong_ubi_aid.csv');
		if(empty($ps)) return;

		$max_ppg = 300;
		$pgs = ceil(count($ps) / $max_ppg);
		$ubi=new UbiAPI(false,false,0);
		for($pg = 0; $pg < $pgs; $pg++){
			$ds = array_slice($ps, $pg * $max_ppg, $max_ppg);
			$ss = [];
			$transaction=Yii::app()->db->beginTransaction();
			try {
				foreach($ds as $d){
					$d = trim($d);
					if(empty($d)) continue;
					$p = ImParcel::model()->find('ref = :r', [':r' => substr($d, 0, 12)]);
					if(empty($p)) continue;
					$p->hbn = $p->hbn.'A';
					$p->mdata['article_id'] = $d;
					$p->mdata['etower_shipment_orderid'] = '';
					$p->nolog = true;
					$p->update('hbn', 'meta');
					$p->nolog = false;
					$ss[] = $p;
				}
				$transaction->commit();
			} catch (Exception $ex) {
				$transaction->rollback();
				throw $ex;
			}
			if(empty($ss)) continue;
			$rs=$ubi->createShipment($ss);
			if(is_object($rs)){
				if($rs->status=="Failure"){
					continue;
				}else{
					$transaction=Yii::app()->db->beginTransaction();
					try {
						foreach($rs->data as $result){
							if($result->status=="Success"){
								if(!empty($result->referenceNo)){
									$s = ImParcel::model()->find('hbn = :n', [':n' => $result->referenceNo]);
									if(!empty($s)){
										$s->nolog = true;
										$s->mdata['etower_shipment_orderid'] = $result->orderId;
										$s->update('meta');
										$s->nolog = false;
										$s->trans[0]->mdata['oid'] = '';
										$s->trans[0]->save();
									}
								}
							}
						}
						$transaction->commit();
					} catch (Exception $ex) {
						$transaction->rollback();
						throw $ex;
					}
				}
			}
		}
		echo 'Done', PHP_EOL;
	}

	public function gvNoTrans(){
