	public function fixDoubleClear(){
		$rs = $this->db->createCommand("SELECT pid, id, count(id) as c FROM `tracking` WHERE type = 60 and dt > '2018-07-01' GROUP BY pid HAVING c > 1")->queryAll();
		$c = 0;

		$trans = Yii::app()->db->beginTransaction();
		try{
			foreach($rs as $r){
				$lt = Tracking::model()->find(['condition' => 'pid = :pid AND type = 60', 'params' => [':pid' => $r['pid']], 'order' => 't.id DESC']);

				$pt = Tracking::model()->find(['condition' => 'pid = :pid AND id < :id AND type IN (55,60)', 'params' => [':id' => $lt->id, ':pid' => $r['pid']], 'order' => 't.id DESC']);
				if(empty($pt)) continue;
				if($pt->type == 60){
					echo 'Delete '.$lt->pid.':'.$lt->id, PHP_EOL;
					$lt->delete();
					$c++;
				}else{
					echo 'Held again '.$lt->pid.':'.$lt->id, PHP_EOL;
				}
			}
			$trans->commit();
		} catch (Exception $ex) {
			$trans->rollback();
			throw $ex;
		}

		echo $c.' removed';
	}

	public function fixRtsManifest(){
		$rts = RtsList::model()->findAll('created > :d', [':d' => '2019-01-15']);
		$rts_eParcel = [];
		foreach($rts as $rt){
			foreach ($rt->lines as $line) {
				$p = $line->mm();
				if(empty($p)) continue;
				if(empty($p->trans) && preg_match('/^AMQ\d{7}$/i', $p->ref)) {
					$rts_eParcel[]=$p;
				}
			}
		}
		var_dump(count($rts_eParcel));
		if (!empty($rts_eParcel)) {
			$apa = new AusPostAPI('syd'); //TMA
			$r = $apa->createOrderIncludingShipments($rts_eParcel, 'rtsmani'.date('Ymd'), AusPostAPI::CHARGE_CODE_POD);
			if (!empty($r->order)) {
				$oid = $r->order->order_id;
				$transaction=Yii::app()->db->beginTransaction();
				try {
					foreach ($rts_eParcel as $i => $s) {
						$ts = new Tranship;
						$ts->pid = $s->id;
						$ts->org_id = 101;  // for Australia post office
						$ts->man_id = $rtsListId;
						$ts->type = 80;  // shipment transfer to a different delivery courier
						$ts->status = 19; // in finally moving status
						$ts->connote = $s->ref;
						$ts->time = date('Y-m-d H:i:s');
						$ts->mdata['oid'] = $oid;
						$ts->mdata['sid'] = $r->order->shipments[$i]->shipment_id;
						$ts->save();
					}
					$transaction->commit();
				} catch (Exception $ex) {
					$transaction->rollback();
					throw $ex;
				}
			} else {
				$resp['msg'] = '';
				foreach ($apa->err as $e) {
					$msg = $e->message;
					if (!empty($e->field) && preg_match('/shipments\[(\d+)\]/', $e->field, $m)) {
						$msg .= ': '.$rtsShipments[$m[1]]->hbn;
					}
					$resp['msg'] .= $msg . '<br/>';
				}
				var_dump($resp);
			}
		}
		echo 'Done', PHP_EOL;
	}

	public function wallaby2desv(){
		$rs = Invoice::model()->findAll('to_id = 2169');
		$c = 0;
		foreach($rs as $inv){
			$inv->to_id = 1478;
			$inv->mdata['name'] = 'SHENZHEN DESV EXPRESS WORLDWIDE CO.LTD';
			$inv->mdata['address'] = 'CHINA';
			foreach($inv->lines as $l){
				if($l->gst > 0){
					$l->tax = 'EXEMPTOUTPUT';
					if($l->qty == 0) $l->qty = 1;
					$l->amount = $l->amount - $l->gst;
					$l->gst = 0;
					$l->save();
				}
			}
			$inv->getTotal();
			$inv->save();
			echo $inv->no, ' updated', PHP_EOL;
			$c++;
		}
		echo $c, ' invoices updated', PHP_EOL;
	}

