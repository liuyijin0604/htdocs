	public function withdrawOutturn(){
		$cn = Consol::model()->find('no = :n', [':n' => $this->args[1]]);
		if(empty($cn)){
			die("Consol not found\n");
		}
		
		$isair = $cn->service == 10;

		$em = new Edimsg;
		$em->dt = date('Y-m-d H:i:s');
		$em->type = $isair? 'AIROUT' : 'SEAOUT';
		$em->sender = Yii::app()->params['ics']['testing']? Yii::app()->params['ics']['test_site'] : Yii::app()->params['ics']['prod_site'];
		$em->receiver = Yii::app()->params['ics']['customs_id'];
		$em->status = 19;
		$em->fid = $cn->id;
		$em->save();

		$em->mid = sprintf('%06s', substr($em->id, -6));
		$os = Edimsg::model()->findAll("status = 50 AND type = :t AND fid = :id ORDER BY t.id DESC", [':id' => $cn->id, ':t' => $em->type]);
		$omid = null;
		$ymd = null;
		$hi = null;
		if(!empty($os)){
			foreach($os as $o){
				if(preg_match('/BGM\+263:::'.$em->type.'\+([^\+:]+):\d+\+(9|4)/', $o->msg, $m)){
					$omid = $m[1];
					if(preg_match('/DTM\+570:(\d+):102/', $o->msg, $m)){
						$ymd = $m[1];
					}
					if(preg_match('/DTM\+570:(\d+):401/', $o->msg, $m)){
						$hi = $m[1];
					}
					break;
				}
			}
		}
		if(empty($omid)){
			echo 'Original MSG not found for ', $cn->no, PHP_EOL;
			return;
		}

		$vn = Edimsg::model()->count('type = :t AND fid = :fid', [':t' => $em->type, ':fid' => $cn->id]) + 1;
		if($isair){//air
			$airline = substr(trim($cn->airline), 0, 2);
			$flight = substr(trim($cn->flight), 2);
			$msg = "UNH+".$em->mid."+CUSCAR:D:99B:UN'
BGM+263:::AIROUT+".$omid.":".$vn."+50'
DTM+570:".$ymd.":102'
DTM+570:".$hi.":401'
NAD+VW+".Yii::app()->params['ics']['abn']."::95'
TDT+20+".$flight."++6+".$airline."::3'
LOC+59+".$cn->getEstID()."::95'
DTM+132:".date("Ymd", strtotime($cn->eta)).":102'
";
		}else{
			$voyage_number = trim($cn->flight);// like 023s
			$vessel = trim($cn->airline); //IMO  like 9235103
			$cargo_type = $cn->mdata['cargo_type'];
			$msg = "UNH+".$em->mid."+CUSCAR:D:99B:UN'
BGM+263:::SEAOUT+".$omid.":".$vn."+50'
TDT+20+".$voyage_number."++11++++".$vessel."::11'
LOC+4+".$cn->getEstID()."::95'
";
		}

		$mc = substr_count($msg, "\n")+1;
		$msg .= "UNT+".$mc."+".$em->mid."'";
		$em->msg = $msg;
		$em->status = 20;
		$em->dt = date('Y-m-d H:i:s', time() + (200 * $i));
		$em->save();
		echo 'Withdrawn ', $cn->no, PHP_EOL;
	}

	public function manfiestChargecode(){
		$sql = 'SELECT man_id, id FROM shipment WHERE type = 10 AND created > "2019-07-01" AND man_id > 0 GROUP BY man_id';
		$rs = $this->db->createCommand($sql)->queryAll();
		$transaction=Yii::app()->db->beginTransaction();
		try {
			foreach($rs as $r){
				$p = ImParcel::model()->findByPk($r['id']);
				if(!empty($p->mdata['chargecode'])){
					$m = Manifest::model()->findByPk($r['man_id']);
					$m->mdata['chargecode'] = $p->mdata['chargecode'];
					$m->save();
				}
			}
			$transaction->commit();
		} catch (Exception $ex) {
			$transaction->rollback();
			throw $ex;
		}
		
		echo "done", PHP_EOL;
	}

