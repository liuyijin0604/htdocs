	public function imInvoiceAddZone(){
		$inv = Invoice::model()->findByPk($this->args[1]);
		$cidmap = [];
		foreach($inv->lines as $l){
			$up = false;
			foreach($l->mdata['items'] as $i => $itm){
				$p = ImParcel::model()->find('ref = :r', [':r' => $itm[0]]);
				if(empty($p)) continue;
				if(empty($p->mdata['chargecode'])){
					echo $p->ref, ' has no charge code', PHP_EOL;
				}
				if(empty($cidmap[$p->mdata['chargecode']])){
					$cc = ImportChargeCode::model()->find('chargecode = :c', [':c' => $p->mdata['chargecode']]);
					$cidmap[$p->mdata['chargecode']] = $cc->id;
				}
				
				$z = ZoneMap::model()->find('chargecode_id = :cid AND pc_lo <= :p AND pc_hi >= :p', [':cid' => $cidmap[$p->mdata['chargecode']], ':p' => ltrim($itm[6], '0')]);
				if(empty($z)){
					echo $p->ref, ' has no zone', PHP_EOL;
				}elseif(!preg_match('/'.$z['zone_name'].'$/', $l->mdata['items'][$i][1])){
					$l->mdata['items'][$i][1] .= ' '.$z['zone_name'];
					$up = true;
				}
			}
			if($up) $l->save();
		}
		echo 'Done', PHP_EOL;
	}

