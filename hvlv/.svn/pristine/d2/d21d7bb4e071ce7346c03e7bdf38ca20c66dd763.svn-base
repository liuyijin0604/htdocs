	public function clearDeliveryNoticeEmail(){
		foreach(glob('runtime/importsmail/*.emz') as $f){
			if(preg_match('/EM(\d+)\.emz$/', $f, $m)){
				$id = $this->db->createCommand('SELECT id FROM imports_mail WHERE id = '.$m[1].' LIMIT 1;')->queryScalar();
				if(empty($id)){
					unlink($f);
					echo $f, PHP_EOL;
				}
			}
		}
		
		$sql = "SELECT no FROM imports_mail WHERE subject LIKE 'Mail delivery %'";
		$rs = $this->db->createCommand($sql)->queryAll();
		foreach($rs as $r){
			$f = 'runtime/importsmail/'.$r['no'].'.emz';
			if(is_file($f)){
				echo 'remove '.$f, PHP_EOL;
				unlink($f);
			}
		}
		$this->db->createCommand("DELETE FROM imports_mail WHERE subject LIKE 'Mail delivery %'")->execute();
		echo 'Done', PHP_EOL;
	}

	public function cleanDuplicateEmails(){
		$sql = "SELECT * FROM imports_mail WHERE id > 902576";
		$rs = $this->db->createCommand($sql)->queryAll();
		$body_hashs = [];
		foreach($rs as $r){
			$bh = md5($r['plain_body'].$r['from'].$r['to']);
			if(in_array($bh, $body_hashs)){
				//remove file
				$f = 'runtime/importsmail/'.$r['no'].'.emz';
				if(is_file($f)){
					echo 'remove '.$f, PHP_EOL;
					unlink($f);
				}
				//remove mail user
				$this->db->createCommand("DELETE FROM mail_user WHERE mail_id = ".$r['id'])->execute();
				//remove mail
				$this->db->createCommand("DELETE FROM imports_mail WHERE id = ".$r['id'])->execute();
			}else{
				$body_hashs[] = $bh;
			}
		}
		echo 'Done', PHP_EOL;
	}
	
