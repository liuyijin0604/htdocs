				sleep(2);
				$r3 = $apa->getLabel($lbl->request_id);
				foreach($r3->labels as $l){
					if(empty($l->url)) continue;
					$cmd = 'wget --no-check-certificate "'.$l->url.'" -O '.$p->ref.'.pdf';
					echo $cmd.PHP_EOL;
					exec($cmd);
					break 2;
				}
				$t++;
			}
		}
		return;

		//$result = $apa->createShipments($p);
		if ($result && isset($result->shipments) && is_array($result->shipments)) {
			$sid = $result->shipments[0]->shipment_id;
			$r2 = $apa->createLabels($sid);
			$p->ref = $result->shipments[0]->items[0]->tracking_details->consignment_id;
			$p->mdata['apsid'] = $sid;
			// $p->save();
			echo $sid, PHP_EOL;
			echo $p->ref, PHP_EOL;
			echo $result->shipments[0]->items[0]->tracking_details->article_id, PHP_EOL;

			foreach($r2->labels as $lbl){
				$t = 0;
				while($t < 5){
					sleep(2);
					$r3 = $apa->getLabel($lbl->request_id);
					foreach($r3->labels as $l){
						if(empty($l->url)) continue;
						$cmd = 'wget --no-check-certificate "'.$l->url.'" -O '.$p->ref.'.pdf';
						echo $cmd.PHP_EOL;
						exec($cmd);
						break 2;
					}
					$t++;
				}
			}
			//lodge manifest
			// $apa->createOrderFromShipments([$sid]);
			echo 'Done', PHP_EOL;
		}else{
			echo 'Create Shipment Failed', PHP_EOL;
		}
	}

	public function shipment2json(){
		ini_set('serialize_precision', 14);
		$sql = 'SELECT COUNT(*) FROM `shipment` WHERE `meta` LIKE "a:%" OR `items` LIKE "a:%" OR `scan` LIKE "a:%"';
		$tc = $this->db->createCommand($sql)->queryScalar();
		$c = 0;
		if(strtoupper($this->prompt('Update '.$tc.' shipments?', 'n')) == 'Y'){
			$ppg = 2000;
			$pgs = ceil($tc / $ppg);
			for($i = 0; $i<$pgs; $i++){
				if($c > 0) echo $c, ' rows updated', PHP_EOL;
				$sql = 'SELECT id,`meta`,`items`,`scan` FROM `shipment` WHERE `meta` LIKE "a:%" OR `items` LIKE "a:%" OR `scan` LIKE "a:%" LIMIT '.$ppg;
				$rs = $this->db->createCommand($sql)->queryAll();
				$trans = Yii::app()->db->beginTransaction();
				try{
					foreach($rs as $r){
						$up = [];
						$valid = true;
						// file_put_contents('before.log', json_encode($r).PHP_EOL, FILE_APPEND);
						foreach(['items', 'scan', 'meta'] as $fld){
							if(preg_match('/^a:\d+/', $r[$fld])){
								$meta = unserialize($r[$fld]);
								if(!is_array($meta)){
									echo $r['id'],':',$fld,PHP_EOL;
									var_dump($r[$fld]);
									$valid = false;
									continue;
								}
								if(is_string($meta['client_entry']) && preg_match('/^a:\d+/', $meta['client_entry'])){
									$meta['client_entry'] = unserialize($meta['client_entry']);
									if(!is_array($meta['client_entry']) || empty($meta['client_entry'])){
										echo $fld.':'.$r['id'].' client_entry problem', PHP_EOL;
										$valid = false;
										continue;
									}
								}
								$cc = count($meta);
								$meta = json_encode($meta);
								if(empty($meta)){
									echo $fld.':'.$r['id'].' encode problem', PHP_EOL;
									$valid = false;
									continue;
								}
								if($cc != count(json_decode($meta, true))){
									echo $fld.':'.$r['id'].' decode problem', PHP_EOL;
									$valid = false;
									continue;
								}
								$up[$fld] = $meta;
							}
						}
						if($valid && !empty($up)){
							$bv = [':id' => $r['id']];
							$ups = [];
							foreach($up as $k => $m){
								$ups[] = '`'.$k.'` = :'.$k;
								$bv[':'.$k] = $m;
							}
							$this->db->createCommand('UPDATE `shipment` SET '.implode(', ', $ups).' WHERE id = :id')->bindValues($bv)->execute();
							$c++;
						}
					}
					$trans->commit();				} catch (Exception $ex) {
					$trans->rollback();
					throw $ex;
				}
			}
			// foreach(file('before.log') as $l){
			// 	$r = json_decode(trim($l), true);
			// 	$s = Shipment::model()->findByPk($r['id']);
			// 	if($s->items != json_encode(unserialize($r['items']))){
			// 		echo $r['id'],' item not equal', PHP_EOL;
			// 	}
			// 	if(!empty($r['scan']) && $s->scan != json_encode(unserialize($r['scan']))){
			// 		echo $r['id'],' scan not equal', PHP_EOL;
			// 	}
			// 	$meta = unserialize($r['meta']);
			// 	if(!empty($meta['client_entry'])){
			// 		$meta['client_entry'] = unserialize($meta['client_entry']);
			// 	}
			// 	if($s->meta != json_encode($meta)){
			// 		echo $r['id'],' meta not equal', PHP_EOL;
			// 	}
			// }

			echo 'Total '.$c.' shipment updated', PHP_EOL;
		}
	}

	public function meta2json(){
		ini_set('serialize_precision', 14);
		$tbl = $this->prompt('Table Name: ');
		$fld = $this->prompt('Filed Name: ', 'meta');
		$sql = 'SELECT COUNT(*) FROM `'.$tbl.'` WHERE `'.$fld.'` LIKE "a:%"';
		$tc = $this->db->createCommand($sql)->queryScalar();
		$c = 0;
		if(strtoupper($this->prompt('Update '.$tc.' rows in '.$tbl.'?', 'n')) == 'Y'){
			$ppg = 1000;
			$pgs = ceil($tc / $ppg);
			for($i = 0; $i<$pgs; $i++){
				if($c > 0) echo $c, ' rows updated', PHP_EOL;
				$sql = 'SELECT id,`'.$fld.'` FROM `'.$tbl.'` WHERE `'.$fld.'` LIKE "a:%" LIMIT '.$ppg;
				$rs = $this->db->createCommand($sql)->queryAll();
				$trans = Yii::app()->db->beginTransaction();
				try{
					foreach($rs as $r){
						if(!empty($r[$fld])){
							$meta = @unserialize($r[$fld]);
							if(!is_array($meta)){
								var_dump($r[$fld]);
								continue;
							}
							$cc = count($meta);
							$meta = json_encode($meta);
							if(empty($meta)){
								echo $tbl.':'.$r['id'].' encode problem', PHP_EOL;
								continue;
							}
							if($cc != count(json_decode($meta, true))){
								echo $tbl.':'.$r['id'].' decode problem', PHP_EOL;
								continue;
							}
							$this->db->createCommand('UPDATE `'.$tbl.'` SET `'.$fld.'` = :m WHERE id = :id')->bindValues([':m' => $meta, ':id' => $r['id']])->execute();
							$c++;
						}
					}
					$trans->commit();
				} catch (Exception $ex) {
					$trans->rollback();
					throw $ex;
				}
			}
			echo 'Total '.$c.' rows updated', PHP_EOL;
		}
	}

	public function compressEml(){
		$tmp = Yii::app()->basePath . DIRECTORY_SEPARATOR . 'runtime' . DIRECTORY_SEPARATOR . 'importsmail' . DIRECTORY_SEPARATOR;
		$c = 0;
		foreach(glob($tmp.'*.eml') as $f){
			$d = gzencode(file_get_contents($f));
			if(!empty($d)){
				file_put_contents(substr($f, 0,-1).'z', $d);
				unlink($f);
				$c++;
			}
		}
		echo 'Total '.$c.' email compressed', PHP_EOL;
	}

	public function wwsTranslation(){
		if(empty($this->args[1]) || !file_exists($this->args[1])) die('Please specify translation word file'.PHP_EOL);
		
		$contents = [];
		$zip = zip_open($this->args[1]);
		if (!$zip || is_numeric($zip)) return false;

		while ($zip_entry = zip_read($zip)) {
			if (zip_entry_open($zip, $zip_entry) == false || zip_entry_name($zip_entry) != "word/document.xml") continue;
			$contents[] = strip_tags(str_replace(['</w:r></w:p></w:tc><w:tc>', '</w:r></w:p>'], [" ", "\r\n"], zip_entry_read($zip_entry, zip_entry_filesize($zip_entry))));
			zip_entry_close($zip_entry);
		}
		zip_close($zip);

		$ts = [];
		foreach($contents as $r){
			$ls = preg_split('/[\r\n]+/', $r);
			$ns = [];
			foreach($ls as $j => $l){
				$l = trim($l, "  \n\r\t");
				if(empty($l)) continue;
				if(preg_match('/^(.+)\s+(\d{6})$/', $l, $m)){
					$ns[] = $m[1];
					$ns[] = $m[2];
					continue;
				}
				$ns[] = $l;
			}
			$t = null;
			foreach($ns as $l){
				if(empty($l)) continue;
				if(preg_match('/^\d{6}$/', $l)){
					$t = trim($t);
					if(!isset($ts[$l])){
						$ts[$l] = ['en' => '', 'ab' => ''];
					}
					if(!empty($ts[$l]['en'])){
						$t = &$ts[$l]['ab'];
					}else{
						$t = &$ts[$l]['en'];
					}
				}else{
					$t .= $l."\n";
				}
			}
		}
		$t = trim($t);
		unset($t);
		ksort($ts);
		foreach($ts as $k => $p){
			$en = preg_split('/[\r\n]+/', $p['en']);
			$ab = preg_split('/[\r\n]+/', $p['ab']);
			if($en[0] != $ab[0] && $en[0] != $ab[1]){
				echo $k, ': ', $en[0], PHP_EOL;
			}
			if(abs(count($en) - count($ab)) > 3){
				echo $k, ': lines diff too big', PHP_EOL;
			}
		}
		// var_dump(array_keys($ts));
		file_put_contents('wws_translation_'.date('Ymd').'.json', json_encode($ts, JSON_UNESCAPED_UNICODE));
		echo 'Done', PHP_EOL;
	}

	public function cl838_33mbq(){
		$rs = ImParcel::model()->findAll('agent_id = 838 AND ref LIKE "33MBQ%"');
		$c = 0;
		foreach($rs as $r){
			$l = new ChangeShipmentLabel;
			$l->pid = $r->id;
			$l->pref = $r->ref;
			$l->phbn = $r->hbn;
			$d2z = new D2zShipAPI('local');
			$result = $d2z->createConsignments($r);
			if (is_array($result) && !empty($result[0]['barcodeLabelNumber'])) {
				$r->ref = preg_match('/(\]d2019931265099999891)?([A-Z0-9]{3,5}\d{7})\d{2}000\d{4}0\d{1}(\d{23})?$/', $result[0]['barcodeLabelNumber'], $m)? $m[2] : $result[0]['barcodeLabelNumber'];
				$r->mdata['d2ztype'] = 'local';
				$r->nolog = true;
				$r->update('ref', 'meta');
				$r->nolog = false;

				$ts = new Tranship;
				$ts->pid = $r->id;
				$ts->org_id = Org::ORGID_COURIER_D2Z;
				$ts->type = 80;
				$ts->status = 19;
				$ts->connote = $r->ref;
				$ts->time = date('Y-m-d H:i:s');
				$ts->mdata['d2z_barcodeLabelNumber'] = $result[0]['barcodeLabelNumber'];
				$ts->cost = 0;
				$ts->save();
				$l->newref = $r->ref;
				$l->save();
				echo $l->pref.' => '.$r->ref, PHP_EOL;
				$c++;
			} else {
				var_dump($result['errorDetails']);
			}
		}
		echo $c,' changed', PHP_EOL;
	}
	
	public function fcinvreport(){
		$lastUser = function($inv){
			$l = Log::model()->find(['condition' => 'lid = :id AND model = :inv', 'order' => 't.time DESC', 'params' => [':id' => $inv->id, ':inv' => 'Invoice']]);
			return empty($l)? 'unknown' : $l->user->name;
		};
		$rs = Invoice::model()->findAll('status = 8 and date > DATE_SUB(NOW(), INTERVAL 6 MONTH)');
		echo implode("\t", ['Inv #', 'Date', 'Total', 'Dpmt', 'Type', 'User', 'New Inv#', 'New Date', 'New Total', 'Total Diff', 'Date Diff', 'User', 'Change Times']), PHP_EOL;
		foreach($rs as $r){
			if(preg_match('/-/', $r->no)) continue;
			$t = [$r->no, $r->date, $r->total, $r->getDpmt(), $r->getType(), $lastUser($r)];
			$lt = Invoice::model()->find(['condition' => 't.no LIKE :n', 'order' => 't.date DESC', 'params' => [':n' => $r->no.'-%']]);
			if(!empty($lt)){
				$t[] = $lt->no;
				$t[] = $lt->date;
				$t[] = $lt->total;
				$t[] = $r->total - $lt->total;
				$t[] = (strtotime($lt->date) - strtotime($r->date)) / 86400;
				$t[] = $lastUser($lt);
				$t[] = Invoice::model()->count(['condition' => 't.no LIKE :n', 'params' => [':n' => $r->no.'-%']]);
			}
			echo implode("\t", $t), PHP_EOL;
		}
	}

	public function fix33mbqScan(){
		$rs = ImParcel::model()->findAll('consol_id IN (35269,35425,35239,35218,35230) AND scan_no != 0');
		$c = 0;
		foreach($rs as $r){
			if(empty($r->scan_data[50])) continue;
			foreach($r->scan_data[50] as $k=>$t){
				if($k != $r->ref){
					$r->scan_data[50][$r->ref] = $t;
					unset($r->scan_data[50][$k]);
				}
				$r->nolog = true;
				$r->save();
				$c++;
			}
		}
		echo $c, ' fixed', PHP_EOL;
	}

	public function testUFLapi(){
		$method = 'PUT';
		$url = 'https://wos.ufreight.com/wosedi/ws/outboundUpdate/status';
		$data = [
			"customer" => "HKG042069",
			"orderNo" => "ESAU15536241",
			"warehouseCode" => "PCASY",
			"status" => "C",
		];

		$hdr = ['Content-Type: application/json', 'Accept: application/json', 'Authorization: Basic cGNhZXhwcmVzczpwd2Q0cGNhZXhwcmVzcw=='];
		$ds = '';
		$c = new curl($url);

		if (!empty($data)) {
			$ds = AppHelper::safeJsonEncode($data);
			if(in_array($method, ['POST', 'PUT'])){
				$c->setopt(CURLOPT_POSTFIELDS, $ds);
				$hdr[] = 'Content-Length: ' . strlen($ds);
			}else{
				ksort($data);
				$c->setopt(CURLOPT_URL, $url.'?'.$c->asPostString($data));
			}
		}

		$c->setopt(CURLOPT_CUSTOMREQUEST, strtoupper($method));
		$c->setopt(CURLOPT_RETURNTRANSFER, true);
		$c->setopt(CURLOPT_SSL_VERIFYPEER, false);
		$c->setopt(CURLOPT_TIMEOUT, 600);
		$c->setopt(CURLOPT_HTTPHEADER, $hdr);
		if (!$c->exec()) {
			throw new Exception('cUrl Error: '.$c->err);
		}
		var_dump($c->result);
	}

	public function d2zShipments(){
		foreach(glob('runtime/d2z/d2z_2019-08*.log') as $f){
			$ls = file($f);
			for($i = 0; $i < count($ls); $i++){
				if(preg_match('/^Response: \{"status":"BAD_REQUEST/', trim($ls[$i]))){
					$d = json_decode(substr(trim($ls[$i]), 10), true);
					if(empty($d['errorDetails'])) continue;
					$transaction=Yii::app()->db->beginTransaction();
					try {
						foreach($d['errorDetails'] as $s){
							if(preg_match('/(ECN\d+) : Shippment is already allocated/', $s, $m)){ //allocated
								$p = ImParcel::model()->find('hbn = :h', [':h' => $m[1]]);
								if(!empty($p)){
									if(($p->cbwf & 32) > 0){
										$p->cbwf = $p->cbwf - 32;
										$p->mdata['direct_courier'] = 1;
										$p->nolog = true;
										$p->save();
									}
									if(empty($p->trans[0]->mdata['oid'])){
										$p->trans[0]->mdata['oid'] = '1426';
										$p->trans[0]->save();
										echo $p->ref, ' allocated', PHP_EOL;
									}
								}
							}
						}
						$transaction->commit();
					} catch (Exception $ex) {
						$transaction->rollback();
						throw $ex;
					}
				}
			}
		}
		echo 'Done', PHP_EOL;
	}

	public function d2zAllocationReport(){
		$csv = ['HBN,Ref,Allocation Ref.,Allocation Time,1st Tracking Time'];
		foreach(glob('runtime/d2z/d2z_2019-*.log') as $f){
			if(filectime($f) < strtotime(date('Y-m-d', strtotime('-7 days'))) || filectime($f) > strtotime(date('Y-m-d'))) continue;
			$ls = file($f);
			for($i = 0; $i < count($ls); $i++){
				if(preg_match('/^(\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}) PUT: https:\/\/www.d2z.com.au\/v1\/d2z\/api\/consignments\/shipment\/(.+)$/', $ls[$i], $m) && preg_match('/allocated success/i', $ls[$i+3])){
					$ns = explode(',', substr($ls[$i+2], 5));
					foreach($ns as $n){
						$n = trim($n);
						$p = ImParcel::model()->find('hbn = :n', [':n' => $n]);
						if(empty($p)){
							echo 'Problem find '.$n,PHP_EOL;
							continue;
						}
						$t1 = '';
						foreach($p->tracks as $t){
							if(stripos($t->activity, 'dispatch information received') > 0){
								$t1 = $t->dt;
								break;
							}
						}
						$csv[] = $n.','.$p->ref.','.$m[2].','.$m[1].','.$t1;
					}
					$i+=3;
				}
			}
		}

		include_once('PHPMailer/class.phpmailer.php');
		$mail = new PHPMailer();
		$mail->CharSet = 'UTF-8';
		$mail->IsHTML(false);
		$mail->From	 = 'gero@toplogistics.com.au';
		$mail->FromName = 'Frank Liu';
		$mail->Subject  = 'Shipment allocation report '.date('Ymd H:i');
		$mail->Body = 'Please check attached allocation report';
		$mail->AddAddress('gero@toplogistics.com.au');
		$mail->AddStringAttachment(implode("\n", $csv), 'allocation_report_'.date('Ymd H:i').'.csv', 'base64', 'text/csv');
		$mail->Send();
		echo 'Done', PHP_EOL;
	}

	public function loadPostcodeDistance(){
		$sydney = Org::PCAE_DEPARTMENT_SYDNEY;
		$melbourne = Org::PCAE_DEPARTMENT_MELBOURNE;
		$sydneyArr = Postcode::model()->findAll(" postcode like '2%'  and country = 'AU' ");
		$melbourneArr = Postcode::model()->findAll(" postcode like '3%'  and country = 'AU' ");
		foreach ($sydneyArr as $key => $value) {
			$distance = GoogleMapAPI::getDistanceBetweenPostcode($sydney,$value["suburb"]." ".$value["state"]." ".$value["country"]." ".$value['postcode']);
			if($distance==null)
			{
				$distance = 0;
			}
			$sql = "INSERT into postcode_distance (origin,destination,distance,suburb,state,country) values ({$sydney},\"{$value['postcode']}\",{$distance},\"{$value['suburb']}\",\"{$value['state']}\",'{$value['country']}')";
			echo $sql."\n";
			$this->db->createCommand($sql)->execute();
		}

		foreach ($melbourneArr as $key => $value) {
			$distance = GoogleMapAPI::getDistanceBetweenPostcode($melbourne,$value["suburb"]." ".$value["state"]." ".$value["country"]." ".$value['postcode']);
			if($distance==null)
			{
				$distance = 0;
			}
			$sql = "INSERT into postcode_distance (origin,destination,distance,suburb,state,country) values ({$melbourne},\"{$value['postcode']}\",{$distance},\"{$value['suburb']}\",\"{$value['state']}\",'{$value['country']}')";
			echo $sql."\n";
			 $this->db->createCommand($sql)->execute();
		}

		echo "done";
	}

	public function d2z33g7k(){
		$service = '1PS5';
		$rs = Tranship::model()->findAll('status = 10 AND connote LIKE "33G7K%"');
		$xls = new oExcel;
		$i = 1;
		$xls->addRow($i++, ['referenceNumber', 'consigneeCompany', 'consigneeName', 'consigneeAddr1', 'consigneeAddr2', 'consigneeSuburb', 'consigneeState', 'consigneePostcode', 'consigneePhone', 'productDescription', 'value', 'currency', 'weight', 'shippedQuantity', 'dimensionsLength', 'dimensionsHeight', 'dimensionsWidth', 'serviceType', 'barcodeLabelNumber', 'datamatrix', 'created', 'allocate']);
		$prepAddrLines = function ($addr){
				$addr = str_ireplace(['&#xd', '&#xa', '&#39', ' ', '–'], ["\n", "\n", "'", ' ', '-'], $addr);
				$ls = preg_split('/[\n\r;]+/', trim($addr));
				if (sizeof($ls) == 1 && mb_strlen($addr) > 50) {
					$ls = AppHelper::mbstr_split($addr, 50);
				}
				$ls = array_slice($ls, 0, 2);
				$ls[0] = mb_substr($ls[0], 0, 50);
				if (!empty($ls[1])) {
					$ls[1] = mb_substr($ls[1], 0, 50);
				}

				return $ls;
		};
		
		foreach($rs as $t){
			$r = $t->shipment;
			$addrs = $prepAddrLines($r->cnee->address);
			$aid = $r->ref.sprintf('%02s', 1).'00093'.'51'.'0';
			$aid .= AusPostAPI::aidChkDgt($aid);

			$xls->addRow($i++, [$r->hbn, $r->cnee->company, $r->cnee->name, $addrs[0], empty($addrs[1])? '' : $addrs[1], $r->cnee->suburb, $r->cnee->state, '="'.$r->cnee->postcode.'"', '="'.$r->cnee->tel.'"', @$r->eitems['g'][0], max(@$r->eitems['v'][0], 1), 'AUD', round($r->weight * 100) / 100, $r->pkg, max(floatval(@$r->mdata['dim']['d']), 1), max(floatval(@$r->mdata['dim']['h']), 1), max(floatval(@$r->mdata['dim']['w']), 1), $service, '019931265009991891'.$aid, '[01]99312650099918[91]'.$aid.'[420]'.$r->postcode.'[8008]'.date('Ymd', strtotime($r->created)).'120000', $r->created, ($r->cbwf & 32) > 0? 'Y' : 'N']);
		}
		$xls->output('d2z_1PS5_'.date('Ymd').'.xlsx', null, false);
		
		$trans = Yii::app()->db->beginTransaction();
		try{
			foreach($rs as $t){
				$t->status = 11;
				if(($t->shipment->cbwf & 32) > 0){
					$t->shipment->mdata['direct_courier'] = 1;
					$t->shipment->cbwf = ($s->cbwf ^ 32) & $s->cbwf;
					$t->shipment->update(['meta', 'cbwf']);
					$t->mdata['oid'] = 1426;
				}
				$t->save();
			}
			$trans->commit();
		} catch (Exception $ex) {
			$trans->rollback();
			throw $ex;
		}
		echo 'Done', PHP_EOL;
	}

	public function d2zManifest(){
		$rs = [];
		foreach(glob('runtime/d2z/d2z_2019-0*.log') as $f){
			if(filectime($f) < strtotime(empty($this->args[1])? '-1 day' : $this->args[1])) continue;
			$ls = file($f);
			for($i = 0; $i < count($ls); $i++){
				if(preg_match('/Data: (ECN.+)$/', trim($ls[$i]), $m)){
					$rs = array_merge($rs, explode(',', $m[1]));
				}
			}
		}
		$rs = array_unique($rs);
		$csv = [];
		foreach($rs as $n){
			$p = ImParcel::model()->find('hbn = :h', [':h' => $n]);
			$aid = $p->ref.sprintf('%02s', 1).'00093'.'51'.'0';
			$aid .= AusPostAPI::aidChkDgt($aid);
			$csv[] = $n.','.$p->ref.','.$aid;
		}

		include_once('PHPMailer/class.phpmailer.php');
		$mail = new PHPMailer();
		$mail->CharSet = 'UTF-8';
		$mail->IsHTML(false);
		$mail->From	 = 'gero@toplogistics.com.au';
		$mail->FromName = 'Frank Liu';
		$mail->Subject  = 'Shipment allocation check '.date('Ymd H:i');
		$mail->Body = 'Please check attached shipment for allocation';
		$mail->AddAddress('gero@toplogistics.com.au');
		$mail->AddStringAttachment(implode("\n", $csv), 'allocation_check_'.date('Ymd H:i').'.csv', 'base64', 'text/csv');
		$mail->Send();
		echo 'Done', PHP_EOL;
	}
	
	public function fastwayArea(){
		$ls = file('D:\handleData\AU TSS - delivery RF Sub depot CF code.csv');
		$ls = file('D:\handleData\AU TSS - delivery RF Sub depot CF code.csv');


		$area = [];
		$c = $err = 0;
		$csv = ['Suburb,Postcode,DeliveryRF,SubDepotCode,DeliveryCF'];
		foreach($ls as $l){
			$r = explode(',', trim($l));
			foreach($r as $k => $v){
				$r[$k] = trim($v);
			}
			if(empty($r[2])) continue;
			$r[1] = str_pad($r[1], 4, 0, STR_PAD_LEFT);
			if(preg_match('/^(\d+)$/', $r[1], $m)){
				$pc = Postcode::model()->find('postcode = :pc AND suburb = :s', [':pc' => $r[1], ':s' => $r[0]]);
				$zoneMap = ZoneMap::model()->find('(pc_hi = :pc or pc_lo = :pc) AND upper(suburb) = :s AND org_id=115 AND zone_id=1', [':pc' => $r[1], ':s' => strtoupper($r[0])]);
				if(empty($zoneMap)){
					echo $r[0].' '.$r[1].' rate not found', PHP_EOL;
					$err++;
					continue;
				}
				if(empty($pc)){
					$pc = Postcode::model()->find('postcode = :pc', [':pc' => $r[1]]);
				}
				if(empty($pc)){
					echo $r[0].' '.$r[1].' not found', PHP_EOL;
					$err++;
					continue;
				}
				// if(!Postcode::validateAddress($r[0], $pc->state, $r[1])){
				// 	echo $r[0].' '.$r[1].' not valid', PHP_EOL;
				// 	$err++;
				// 	continue;
				// }
				if(preg_match('/([^-]+)/', $r[4], $m)){
					$r[4] = $m[1];
				}else{
					$r[4] = '';
				}
				$area[$r[1]][$r[0]] = [$r[2], $r[3], $r[4]];
				$csv[] = implode(',', $r);
				$c++;
			}
		}
		file_put_contents('D:/handleData/fastway_area.json', json_encode($area));
		file_put_contents('D:/handleData/fastway_delivery_area.csv', implode("\n", $csv));
		echo $err,' Error, ', $c, ' Done', PHP_EOL;
	}

	public function fastwayArea2Zone(){
		$ds = json_decode(file_get_contents('data/fastway_area.json'), true);
		$zone = ['SYD'=>[],'NON-SYD'=>[],'MEL'=>[],'NON-MEL'=>[]];
		foreach($ds as $p => $d){
			switch(end($d)[0]){
				case 'SYD':
					$zone['SYD'][] = $p;
					$zone['NON-MEL'][] = $p;
				break;
				case 'MEL':
					$zone['MEL'][] = $p;
					$zone['NON-SYD'][] = $p;
				break;
				default:
					$zone['NON-SYD'][] = $p;
					$zone['NON-MEL'][] = $p;
				break;
			}
		}
		foreach($zone as $zid => $zs){
			sort($zs);
			$pz = 0;
			$oz = 0;
			$la = '';
			foreach($zs as $i=>$z){
				if($z != $pz+1){
					if($pz != $oz && $pz > 0){
						$la .= '-'.$pz;
					}
					$la .= ','.$z;
					$oz = $z;
				}
				$pz = $z;
			}
			if($pz != $oz && $pz > 0){
				$la .= '-'.$pz;
			}

			$zone[$zid] = ltrim($la,',');
		}
		print_r($zone);
	}

	public function mixcostcomp(){
		$rs = ImportChargeCode::model()->findAll('org_id IN (2198, 2719, 1222, 1478, 1303, 1474, 1900, 838)');

		$ttl = ['fastway' => 0, 'fw_new' => 0, 'd2z' => 0, 'amq_new' => 0, 'pkg_total' => 0, 'pkg_fw' => 0, 'pkg_fw_new' => 0, 'pkg_ap' => 0, 'amq_old' => 0];
		$or52 = OrgRate::model()->findByPk(52);
		$or522 = OrgRate::model()->findByPk(522);
		$or101 = OrgRate::model()->findByPk(101);
		$fwa = new FastwayAPI();
		foreach($rs as $r){
			if(in_array(52, $r->couriersObj) && (in_array(522, $r->couriersObj) || in_array(101, $r->couriersObj))){
				$ps = ImParcel::model()->findAll('agent_id = :aid AND created >= :d AND created < :d2 AND json_value(meta, "$.chargecode") = :c', [':aid' => $r->org_id, ':c' => $r->chargecode, ':d' => '2019-05-01', ':d2' => '2019-07-01']);
				echo $r->org_id.' '.$r->chargecode.' '.count($ps), PHP_EOL;
				$ttl['pkg_total'] += count($ps);
				foreach($ps as $p){
					if(empty($p->trans)) continue;
					$chargeWeight = empty($r->charge_wt)? $p->chargeWeight() : $p->weight;
					$units = $p->pkg <= 0 ? 1 : $p->pkg;
					$fcw = $fwa->roundWeight($chargeWeight);
					if($p->trans[0]->org_id == 115){ //fastway
						$fc = ImcoConsol::getCourierCostPrice($or52, $p->cnee->postcode, $fcw, $units, true, $p->cnee->suburb);
						if($fc == 3.95){
							$fc = 4.09;
						}
						$ttl['fastway'] += $fc;
						if($fc > 4.5 && $fcw <=2){
							$fc = 4.5;
						}
						$ttl['fw_new'] += $fc;
						$ttl['pkg_fw']++;
					}elseif(in_array($p->trans[0]->org_id, [101,1426])){
						if($units == 1 && !empty($p->trans[0]->cost)){
							$ttl['amq_old'] += $p->trans[0]->cost;
						}
						// $ac1 = ImcoConsol::getCourierCostPrice($or522, $p->cnee->postcode, $chargeWeight, $units, true, $p->cnee->suburb);
						if($units == 1 && FastwayAPI::isInDeliveryArea($p->cnee->postcode, $p->cnee->suburb)){
							$fc = ImcoConsol::getCourierCostPrice($or52, $p->cnee->postcode, $fcw, $units, true, $p->cnee->suburb);
							if($fc > 4.5 && $fcw <= 2){
								$fc = 4.5;
							}
							if($fc > 13.5){
								echo 'Too high: '.$p->ref.' '.$fc,PHP_EOL;
							}
							$ttl['fw_new'] += $fc;
							$ttl['pkg_fw_new']++;
						}elseif($units == 1){
						// if($fc > 0 && $fc > $ac1){
						// 	echo $p->hbn,' ',$p->postcode,' ',($fc - $ac1), PHP_EOL;
						// }
						$ttl['amq_new'] += ImcoConsol::getCourierCostPrice($or101, $p->cnee->postcode, $chargeWeight, $units, true, $p->cnee->suburb);
						//$ttl['d2z'] += $ac1;
						$ttl['pkg_ap']++;
						}
					}
				}
				//var_dump($ttl);
			}
		}
		var_dump($ttl);
	}

	public function ssreport(){
		$criteria->addCondition("t.eta >= '2019-07-01'");
		$criteria->addCondition("t.eta <= '2019-07-31'");
		$criteria->addCondition("t.status < 100");
		$criteria->addInCondition('type', [15]);
		$consols = Consol::model()->findAll($criteria);
		echo 'connote,weight,postcode,courier',PHP_EOL;
		foreach ($consols as $con) {
			if ($con->totShipments() == 0) {
				continue;
			}

			foreach ($this->shipments as $p) {
				if(empty($p->trans[0])) continue;
				$cc = 'other';
				if($p->trans[0]->org_id == 115){
					$cc = 'fw';
				}elseif(in_array($p->trans[0]->org_id, [101, 1426])){
					$cc = 'ap';
				}
				echo $p->ref,',', $p->weight,',', $p->postcode,',', $cc,PHP_EOL;
			}
		}
	}

	public function aupost(){
		$c = new cUrl('https://auspostbusiness.force.com/bsp/BSPConsignmentSearch');
		$c->setopt(CURLOPT_FOLLOWLOCATION, true);
		$c->setopt(CURLOPT_TIMEOUT, 5);
		$c->setopt(CURLOPT_REFERER, 'https://auspostbusiness.force.com/bsp/BSPConsignmentSearch');
		$c->setopt(CURLOPT_SSL_VERIFYPEER, false);
		$c->setopt(CURLOPT_HTTPHEADER, array('User-Agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/76.0.3809.100 Safari/537.36', 'Cache-Control: no-cache', 'Origin: auspostbusiness.force.com'));
		$c->setopt(CURLOPT_POST, true);
		$postr = array(
			'page:conSearch_form' => 'page:conSearch_form',
			'page:conSearch_form:consignmentNumber_id' => 'AMQ5296745',
		);

		$c->setopt(CURLOPT_POSTFIELDS, $c->asPostString($postr));
		$c->exec();


		var_dump($c->result);
	}

	public function reclineaddshipmentid(){
		$c = 0;
		while(ReconciliationLine::model()->count(['condition' => 'shipment_id = 0 AND shipment_no !=""']) > 0){
			$rs = ReconciliationLine::model()->findAll(['condition' => 'shipment_id = 0 AND shipment_no !=""', 'limit' => '5000']);
			$trans = Yii::app()->db->beginTransaction();
			try{
				foreach($rs as $r){
					$r->save();
					if(empty($r->shipment_id)){
						$sql = 'select id from shipment_archive WHERE hbn = :n OR ref = :n';
						$sid = $this->db->createCommand($sql)->bindValues([':n' => $r->shipment_no])->queryScalar();
						$r->shipment_id = empty($sid)? 1 : $sid;
						$r->save();
					}
					$c++;
				}
				$trans->commit();
			} catch (Exception $ex) {
				$trans->rollback();
				throw $ex;
			}
			echo $c.' records done', PHP_EOL;
		}
	}

	public function checkImInvoice(){
		$cid = $this->prompt('Client ID: ');
		$rs = Invoice::model()->findAll('status < 4 AND type = 10 AND to_id = :id', [':id' => $cid]);
		$orgRate = OrgRate::model()->find('type=40 and org_id=:oid', [':oid' => $cid]);
		$owner = Org::model()->findByPk($cid);

		foreach($rs as $r){
			$ok = true;
			foreach($r->lines as $l){
				$tt = 0;
				foreach($l->mdata['items'] as $i => $itm){
					$p = ImParcel::model()->find('(hbn = :n OR ref = :n) AND agent_id = :cid', [':n' => $itm[0], ':cid' => $cid]);
					if(empty($p)){
						echo $itm[0].' not found', PHP_EOL;
					}else{
						$amt = $p->getChargePro($owner, $orgRate);
						if($amt[0] != $itm[5]){
							//echo $itm[0].': '.$itm[5].' != '.$amt[0], PHP_EOL;
							$l->mdata['items'][$i][5] = $amt[0];
							$ok = false;
						}
						$tt += $amt[0];
					}
				}
				if($tt != $l->amount){
					//echo $r->no.' line total '.$l->amount.' => '.$tt,PHP_EOL;
					$l->amount = $tt;
					$l->qty = 1;
					$l->save();
				}
			}
			if($ok){
				echo $r->no.' OK', PHP_EOL;
			}else{
				$oamt = $r->total;
				$r->getTotal();
				$r->save();
				echo $r->id.' '.$r->no.' '.$oamt.' => '.$r->total.' updated', PHP_EOL;
			}
		}
	}

	public function addClearTrack(){
		$rs = ImParcel::model()->findAll('consol_id = 38899');
		foreach($rs as $shipment){
			$dts = [];
			foreach($shipment->tracks as $t){
				if($t->type == 40){
					$dts[0] = strtotime($t->dt);
					echo '40: '.$t->dt;
				}elseif($t->type == 70){
					$dts[1] = strtotime($t->dt);
					echo '70: '.$t->dt;
					break;
				}elseif($t->type == 60){
					continue 2;
				}
			}

			if(!empty($dts[1])){
				$dt = $dts[1] - (empty($dts[0])? rand(3600 * 2, 3600 * 8) : ceil(($dts[1] - $dts[0]) * rand(200, 600) / 1000));
			}else{
				$dt = $dts[0] + rand(3600 * 2, 3600 * 6);
			}
			echo 'add 60: '.date('Y-m-d H:i:s', $dt);
			// $shipment->addTracking(60, 'Clearance processing complete', 'Kingsgrove', date('Y-m-d H:i:s', $dt));
		}
	}

	public function bfeInvoice(){
		//invoice
		$consol = ImcoConsol::model()->findByPk($this->prompt('Consol ID:'));
		$owner = Org::model()->findByPk(1206);
		// in case invoice existing , we just update
		$inv = Invoice::model()->find('consol_id = :cid', [':cid' => $consol->id]);

		// in case invoice has been frozen, we can't change it again
		$invoiceNo = '';
		$oldPaymentLines = '';
		if (!empty($inv)) {
			if ($inv->isInvoiceClosed()) {
				$inv->createCreditForMe();
				$oldPaymentLines = $inv->payments;
				$invoiceNo = $inv->no;
				$inv = null;
			}
		}
		if (empty($inv)) {
			$inv = new Invoice;
			$inv->type = 10;
			$inv->dpmt = Invoice::DPMT_IMPORT;
			$inv->to_id = 2791;
			$inv->mdata['suborg'] = 1206;
			$inv->dpt_id = Org::PCAE_DEPARTMENT_SYDNEY; // default set Sydney as warehouse
			$inv->ref = 'ck1-ep' . date('Ymd', strtotime($consol->created));
			$inv->currency = 1;
			if (!empty($invoiceNo)) {
				$inv->no = Invoice::genNewInvoiceNo($invoiceNo);
			}               // $invoiceNo . '-1';
			$inv->consol_id = $consol->id;
			$inv->status = Invoice::INVOICE_STATUS_PENDING;
		}
		$inv->date = date('Y-m-d', strtotime($consol->created));
		$inv->due = $inv->date;
		$inv->save();
		$items = [];
		$tot = 0;
		$transaction = Yii::app()->db->beginTransaction();
		try {
			foreach($consol->shipments as $k=>$p){
				$pc = trim($p->cnee->postcode);
			
				// currently we hardcode here , we always use charge code 5813
				// so we create invoice by charge code now
				$amt = $p->getChargeByChargecode(5813, true);
				$p->mdata['charge_client_amount']= number_format($amt, 4, '.', '');
				$p->mdata['charge_client_weight']= number_format($p->weight, 2, '.', '');
				$p->updateMeta();
				$zoneMap = ZoneMap::model()->find('chargecode_id = 15 AND zone_id = 1 AND pc_lo <= :p AND pc_hi >= :p', [':p' => $pc]);
				$zoneCode = 'N1';
				if (!empty($zoneMap) && !empty($zoneMap['z1'])) {
					$zoneCode = $zoneMap['z1'];
				}
				if (!empty($p->tempChargeweight)) {
					$p->weight=$p->tempChargeweight;
				}  //to record the break weight
				$items[] = [$p->ref, $p->getDesc().'    ' . $zoneCode, $p->pkg, $p->weight, $p->cbm, $amt,$p->cnee->postcode];
				$tot += $amt;

				// in case parcel with insurance
				// we add insurance value to total value
				if ($p->insurance > 0) {
					$insuranceRatio = 1;
					if (isset($owner->extra['insurance_invoice_ratio'])) {
						$insuranceRatio = floatval($owner->extra['insurance_invoice_ratio']);
					}
					$invInsurance = round($p->insurance * ($insuranceRatio / 100), 2);
					$p->mdata['insurance_charge_client']=$invInsurance;
					$p->updateMeta();
					$items[] = [$p->ref, 'Insurance Fee',0, 0, 0, $invInsurance];
					$tot += $invInsurance;
				}
			}
			$transaction->commit();
		} catch (Exception $ex) {
			$transaction->rollback();
			Log::log2file("Manifest(1206) create Invoice".$consol->no."=>".$ex->getMessage(), "transaction_err_log", "transaction");
			throw $ex;
		}

		$inv->refresh();
		$il = new InvLine;
		$il->inv_id = $inv->id;
		$il->ccode = 'EPA';
		$il->mdata['items'] = $items;
		$il->det = $consol->no;
		$il->fid = $consol->id;
		$il->model = 'ImcoConsol'; // invoice connected with console directly
		$il->amount = round($tot * 1000) / 1000;
		$il->qty = 1;
		$il->save();
		$inv->getTotal();
		$inv->consol_id = $consol->id;

		$inv->mdata['name'] = $owner->name;
		$inv->mdata['address'] = $owner->getAddress();
		$inv->mdata['payterm'] = empty($owner->extra['payterm'])? 'COD' : $owner->extra['payterm'].' days';

		if (!empty($oldPaymentList)) {
			$inv->applyPayments($oldPaymentList);
			$inv->getTotal();
			$inv->checkPaid();
		}

		$inv->save();

		// update console related aupost courier cost
		ImcoConsol::updateImportConsoleBilling([$consol->id]);

		// check to see if something wrong when create invoice or invoice line
		$errorsInv = $inv->getErrors();
		$errorsInvLine = $il->getErrors();
		$error = implode('<br/>', array_merge($errorsInv, $errorsInvLine));
		if (!empty($error)) {
			echo 'Failed to create invoice : ' . $error . ' <br/>';
		} else {
			echo 'Invoice ' . $inv->no . " issued<br />";
		}
	}

	public function xeroLogBillingDate(){
		$c = 0;
		foreach(glob('runtime/xero/xero_api_2019*.log') as $f){
			$cont = file_get_contents($f);
			preg_match_all('/Xero Server Response data : (\{.+?[\n\r]+\})[\n\r$]+/ms', $cont, $m);
			$transaction=Yii::app()->db->beginTransaction();
			try {
				foreach($m[1] as $j){
					$data = json_decode($j);
					if(empty($data->Invoices)) continue;
					foreach($data->Invoices as $inv){
						if(empty($inv) || $inv->Type != 'ACCPAY') continue;
						$oid = preg_replace('/^PORG-/', '', $inv->Contact->AccountNumber);
						$inv_date = substr($inv->DateString, 0, 10);
						if(strtotime($inv_date) < strtotime('2018-07-01')) continue;

						$bill = Billing::model()->find('org_id = :oid AND billing_cref = :ref AND total > 0', [':oid' => $oid, ':ref' => $inv->InvoiceNumber]);
						if(empty($bill) && preg_match('/^(.+)-\d+$/', $inv->InvoiceNumber, $mn)){ // try removing -1
							$bill = Billing::model()->find('org_id = :oid AND billing_cref = :ref AND total > 0', [':oid' => $oid, ':ref' => $mn[1]]);
						}
						if(empty($bill)){
							$ls = BillingLine::model()->findAll('org_id = :oid AND billing_cref = :ref', [':oid' => $oid, ':ref' => $inv->InvoiceNumber]);
							if(empty($ls)){
								echo $oid.' '.$inv->InvoiceNumber.' not found', PHP_EOL; 
							}else{
								$bill = new Billing;
								$bill->org_id = $ls[0]->org_id;
								$bill->billing_cref = $inv->InvoiceNumber;
								$bill->created = $ls[0]->created;
								$bill->date = $inv_date;
								$bill->currency = $ls[0]->currency;
								$bill->status = 3;
								$bill->type = $ls[0]->type;
								$bill->dpmt = $ls[0]->dpmt;
								$bill->dpt_id = 106;
								$bill->sync_xero = 1;
								$bill->save();
								$tt = 0;
								$gst = 0;
								foreach($ls as $l){
									$l->billing_id = $bill->id;
									$l->update('billing_id');
									$tt+=$l->actual_amount;
									$gst+=$l->gst_amount;
								}
								$bill->total = $tt;
								$bill->gst = $gst;
								$bill->save();
								echo $oid.' '.$inv->InvoiceNumber.' line only '.$bill->id, PHP_EOL;
							}
						}elseif($bill->date != $inv_date){
							echo $oid.' '.$inv->InvoiceNumber.' '.$bill->date.' => '.$inv_date, PHP_EOL;
							$bill->date = $inv_date;
							$bill->save();
							$c++;
						}
						
					}
				}
				$transaction->commit();
			} catch (Exception $ex) {
				$transaction->rollback();
				throw $ex;
			}
		}
		echo $c.' updated', PHP_EOL;
	}

	public function testAmp(){
		include_once(Yii::app()->basePath.DIRECTORY_SEPARATOR.'vendor/autoload.php');
		Amp\Loop::run(function () {
			$tns = [
				'33G7K9265371',
				'33G7K9265369',
				'33G7K9265368',
				// '33G7K9265367',
				// '33G7K9265366',
				// '33G7K9265365',
				// '33G7K9265364',
				// '33G7K9265363',
				// '33G7K9265362',
				// '33G7K9265361',
				// '33G7K9265360',
				// '33G7K9265359',
				// '33G7K9265358',
				// '33G7K9265357',
				// '33G7K9265356',
				// '33G7K9265355',
				// '33G7K9265354',
				// '33G7K9265353',
				// '33G7K9265352',
			];

			$client = new Amp\Artax\DefaultClient;
			// $client->setOption(Amp\Artax\Client::OP_DISCARD_BODY, true);

			try {
				foreach ($tns as $tn) {
					$uri = 'http://localhost:8081/aupost?tn='.$tn;
					$promises[$uri] = $client->request($uri);
				}

				$responses = yield $promises;

				foreach ($responses as $uri => $response) {
					$json = yield $response->getBody();
					print $uri . " - " . $response->getStatus() . ' ' .$json. PHP_EOL;
				}
			} catch (Amp\Artax\HttpException $error) {
				// If something goes wrong Amp will throw the exception where the promise was yielded.
				// The Client::request() method itself will never throw directly, but returns a promise.
				print $error->getMessage() . PHP_EOL;
			}
		});
	}

