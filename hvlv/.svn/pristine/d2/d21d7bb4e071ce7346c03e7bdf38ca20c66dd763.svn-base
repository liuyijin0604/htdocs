		$rs = $this->db->createCommand($sql)->queryAll();
		$transaction=Yii::app()->db->beginTransaction();
		try {
			foreach($rs as $r){
				$ts = new Tranship;
				$ts->pid = $r['id'];
				$ts->org_id = Org::ORGID_COURIER_UBI;
				$ts->type = 80;
				$ts->status = 10;
				$ts->connote = $r['ref'];
				$ts->time = date('Y-m-d H:i:s');
				$ts->cost = 0;
				$ts->save();
			}
			$transaction->commit();
		} catch (Exception $ex) {
			$transaction->rollback();
			throw $ex;
		}
		echo 'Done', PHP_EOL;
	}

