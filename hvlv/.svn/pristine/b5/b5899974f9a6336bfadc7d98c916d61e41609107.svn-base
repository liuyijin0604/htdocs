	public function actionAp_manifest($id)
	{
		$model=$this->loadModel($id);
		$csv = [];
		foreach ($model->shipments as $p) {
			if ($p->zrate->orgrate->org_id != 101) {
				continue;
			}
			$addr = str_split(str_replace("\n", ' ', $p->cnee->address), 40);
			while (sizeof($addr)<4) {
				$addr[] = '';
			}
			$csv[] = 'C,"'.$p->hbn.'",,S1,,"'.$p->cnee->name.'",,"'.implode('","', $addr).'","'.$p->cnee->suburb.'",'.$p->cnee->state.','.$p->cnee->postcode.',AU,"'.$p->cnee->getTel().'",N,,,N,N,,N,0,"'.$p->hbn.'",Y,,N,,N,Sender,Unit 7 1-3 Burrow Road,,,,St Peters,NSW,2044,AU,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,';
			$csv[] = 'A,'.$p->weight.',,,,,"'.$p->getGoods().'",,N,0,,,,,,,,,,';
			$csv[] = 'G,,,"'.$p->getGoods().'",,,'.$p->itemsTotQty().','.$p->weight.','.$p->value.','.$p->dvalue;
		}
		header("Cache-Control: maxage=1");
		header("Content-type: text/csv");
		header("Content-Disposition: attachment; filename=ap_manifest_".date('YmdHis').".csv");
		echo implode("\n", $csv);
	}
	
	public function actionCp_manifest($id)
	{
		$model=$this->loadModel($id);
		$csv = [];
		foreach ($model->shipments as $p) {
			if ($p->zrate->orgrate->org_id != 102) {
				continue;
			}
			$pweight = $p->weight<1? 1 : $p->weight;
			$csv[] = 'C,,"'.$p->cnee->name.'","'.str_replace("\n", ' ', $p->cnee->address).'",,,"'.$p->cnee->suburb.'",'.$p->cnee->postcode.',,"'.$p->cnee->getTel().'",,"'.$p->hbn.'",,,'.$p->zrate->getCode().','.$p->pkg.','.$pweight.','.(round($pweight/660*1000)/1000);
		}
		header("Cache-Control: maxage=1");
		header("Content-type: text/csv");
		header("Content-Disposition: attachment; filename=cp_manifest_".date('YmdHis').".csv");
		echo implode("\n", $csv);
	}

