						if(preg_match('/LOCAL/i', $orgRate->code)) continue;
					  	$ss[] = $s;
					}
			  	}
			  }
		  	}
		}
		$max_ppg = 300;
		$pgs = ceil(count($ss) / $max_ppg);

		for($pg = 0; $pg < $pgs; $pg++){
			$shipments = array_slice($ss, $pg * $max_ppg, $max_ppg);
			$err = array_merge($err, $imConsolService->doMyBorderManifest($shipments));
