			  if ($tran->connote==$s->ref&&empty($tran->mdata['non_manifest'])&&!isset($tran->mdata['oid'])) { // if upload manifest before, we don't send again
			  	if($tran->org_id==Org::ORGID_COURIER_BORDER)
			  	{
			  		if((in_array($s->status, ImParcel::$allow_manifest_states)&&$s->getOutPkg() > 0)|| $cn->owner_id == Org::ORGID_CLIENT_TLA)
