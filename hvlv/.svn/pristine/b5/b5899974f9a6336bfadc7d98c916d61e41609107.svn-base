	public function actionAddressReport()
	{
		$model=new ImParcel('search');
		$model->unsetAttributes();
		$model->created = ">2020-04-27";
		if (isset($_GET['ImParcel'])) {
			$model->attributes=$_GET['ImParcel'];
		}
			   
		$ec=new CDbcriteria;
		//                 if(!empty($GET['start_date'])){
		//                          $ec->addCondition('created>:start_date');
		//                          $ec->params[':start_date']=$_GET['start_date'];
		//                  }
		$ec->addCondition('(t.cbwf & ' . 16 . ') > 0');
		//               $ec->addCondition('t.consol_id>0');
		$this->render('address_report', ['model'=>$model,'ec'=>$ec]);
	}
	public function actionExportAddressReport()
	{
		$model=new ImParcel('search');
		$model->unsetAttributes();
		$model->created = ">2020-04-27";
		if (isset($_GET['ImParcel'])) {
			$model->attributes=$_GET['ImParcel'];
		}
		$ec=new CDbcriteria;
		$ec->addCondition('t.cbwf & ' . 16 . ' > 0');
		if (!empty($_GET['type'])) {
			if ($_GET['type']=='xls') {
				$result=$model->search(false, '', $ec);
				$rs=$result->data;
				$xls = new oExcel;
				$i = 1;
				$xls->addRow($i++, ['ref','customer Ref','address','state','postcode','submit address','modified address','submit suburb','modified suburb','created date','editStreetCode']);
				foreach ($rs as $s) {
					$data = [$s->ref, $s->cref, preg_replace("/\,/", ";", $s->cnee->address), $s->cnee->state, $s->cnee->postcode, @$s->mdata["oldAddress"]["address"]." ".@$s->mdata["oldAddress"]["suburb"]." ".@$s->mdata["oldAddress"]["state"]." ".@$s->mdata["oldAddress"]["postcode"], @$s->mdata["newAddress"]["address"]." ".@$s->mdata["newAddress"]["suburb"]." ".@$s->mdata["newAddress"]["state"]." ".@$s->mdata["newAddress"]["postcode"],@$s->mdata["oldAddress"]["suburb"], @$s->mdata["newAddress"]["suburb"] ,$s->created, Addr::getEditStreetCode(@$s->mdata["editStreetCode"])];
					$xls->addRow($i++, $data);

				}
				$xls->output('address_manifest.xlsx');
			}
		}
	}

	public function actionExportAddressManifestReport()
	{
		$filtersForm=new FiltersForm;
		$model = new ImParcel();
		$provide=[];
		if (isset($_GET['FiltersForm'])) {
			$filtersForm->filters=$_GET['FiltersForm'];
		}
		$reportService = new ReportService();
		$provide = $reportService->getImparcelsNeedAddressModefiedReport(true);
		$finalProvide = [];
		$provideArr = [];
		foreach ($provide as $key => $data) 
		{
			// $provideArr["id"] = $data["p"]->id;
			$provideArr["hbn"] = $data->hbn;
			$provideArr["ref"] = $data->ref;
			$provideArr["agent_name"] = @$data->agent->name;
			$provideArr["status"] = @$data->getStatus();
			$provideArr["cnee_name"] = empty($data->cnee)? "" : $data->cnee->name;
			$provideArr["submit_address"] = @$dat->mdata["oldAddress"]["address"]." ".@$data->mdata["oldAddress"]["suburb"]." ".@$data->mdata["oldAddress"]["state"]." ".@$data->mdata["oldAddress"]["postcode"];
			$provideArr["modified_address"] = @$data->mdata["newAddress"]["address"]." ".@$data->mdata["newAddress"]["suburb"]." ".@$data->mdata["newAddress"]["state"]." ".@$data->mdata["newAddress"]["postcode"];
			
			$provideArr["submit_suburb"] = @$data->mdata["oldAddress"]["suburb"];
			$provideArr["modified_suburb"] = @$data->mdata["newAddress"]["suburb"];
			$provideArr["suggest_suburb"] = @$data->mdata["newAddress"]["suggest_suburb"];
			$provideArr["created"] = substr($data->created,0,10);
			$provideArr["isDiff"] = $data->mdata["is_diff"];
			$provideArr["editStreetCode"] = Addr::getEditStreetCode(@$data->mdata["editStreetCode"]);
			$finalProvide[] = $provideArr;
		}
		$sortAttribute = ['hbn','ref','agent_name','status','cnee_name','submit_address','modified_address','submit_suburb','modified_suburb','suggest_suburb','created','isDiff','editStreetCode'];
		$xls = new oExcel;
		$i = 1;
		$xls->addRow($i++, $sortAttribute);
		foreach ($finalProvide as $data) {
			
			$xls->addRow($i++, $data);
		}

		$xls->output('address_manifest_report.xlsx');
	}

