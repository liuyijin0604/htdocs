	public function actionD2zCountryManifest($id)
	{
		$cn = $this->loadModel($id);
		$err=[];
		$ss=[];
		foreach ($cn->shipments as $s) {
			if (in_array($s->agent_id, [1427,1426])) {
				continue;
			}
			if (preg_match('/^33A8Y\d{7}/', $s->ref) &&empty($s->trans)&&($s->cbwf&ImParcel::CBWF_DIRECT_CONSOL_BASE)==0) { // only for startrack shipment and Not sent yet
				if ($s->getOutPkg() > 0 && in_array($s->status, ImParcel::$allow_manifest_states)) {
					$ss[] = $s;
				}
			}
		}
		if (!empty($ss)) {
			if (D2zCountryRate::manifest($ss, $cn->no)) {
				ImcoConsol::updateImportConsoleBilling([$id]);
				$cn->mdata['d2zcountrysent']=1;
				$cn->updateMeta();
				echo 'done!';
			} else {
				echo 'failed!';
			}
		}
	}
		
