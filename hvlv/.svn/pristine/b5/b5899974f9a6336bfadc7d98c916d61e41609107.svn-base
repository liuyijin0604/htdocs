	/**
	 * export the held shipments on three types,
	 * 1: today scanned held shipments
	 * 2: the held shipments on specified consol
	 * 3: All the held shipments.
	 */
	public function actionExportHeldShipments()
	{
		$senderSite =  Yii::app()->params['ics']['testing']? Yii::app()->params['ics']['test_site'] : Yii::app()->params['ics']['prod_site'];
		if (!empty($_POST['export_type'])) {
			$rs=[];
			switch (intval($_POST['export_type'])) {
				case 1:    // today scanned held
					$rs = ImParcel::model()->findAll("consol_id IN (select consol_id FROM shipment WHERE status IN (55,57,59) AND json_value(meta, '$.scan_time') > CURRENT_DATE() GROUP BY consol_id) AND (t.status=55 OR (t.status = 57 AND t.scan_no < t.pkg))");
				break;
				case 2:   // consol held
					if(intval($_POST['export_format_type'])==4)
					{
						echo "Scan Check only supports Today Held";
						return;
					}
					foreach (preg_split("/[;,\n]/", $_POST['held_shipments_consol_no']) as $consol_no) {
						$tempConsol= Consol::model()->find('no=:no or awb=:no or json_value(meta,"$.container_no") = :no', [':no'=>trim($consol_no)]);
						if (!empty($tempConsol)) {
							$tempShipments= ImParcel::model()->findAll('consol_id=:cid AND ( status in (55,57,59))', [':cid'=>$tempConsol->id]);
							$sumS = array_sum(array_column($tempShipments, 'scan_no'));
							$sumP = array_sum(array_column($tempShipments, 'pkg'));
							if($sumS<$sumP)
							{
								$rs= array_merge($rs, $tempShipments);
							}
						}
					}
				break;
				case 3:    //All held
					if(intval($_POST['export_format_type'])==4)
					{
						echo "Scan Check only supports Today Held";
						return;
					}
					$rs= ImParcel::model()->with('consol')->findAll(['condition'=>' t.status in (55,57,59) and scan_no < pkg or t.id >100000000', 'order'=>'consol_id DESC, consol.eta DESC']);
				break;
				case 4:    // yesterday scanned held
					$rs = ImParcel::model()->findAll("consol_id IN (select consol_id FROM shipment WHERE status IN (55,57,59) AND  (TO_DAYS(NOW( )) - TO_DAYS(json_value(meta, '$.scan_time'))) = 1

						GROUP BY consol_id) AND (t.status=55 OR (t.status = 57 AND t.scan_no < t.pkg))");
				break;
			}

			foreach ($rs as $key=>$r) {
				$export_pod = [];
				if(!empty($_POST['export_pod']))
				{
					$export_pod = [$_POST['export_pod']];
					if($_POST['export_pod']=="AUBNE")
					{
						$export_pod[] = "AUCPS";
					}
				}
				if (!empty($_POST['export_pod']) && !empty($r->consol) && !in_array($r->consol->pod, $export_pod)) {
					unset($rs[$key]);
				}
				if((!empty($r->consol)&&((!empty($r->consol->mdata['ubm_dest'])&&$r->consol->mdata['ubm_dest']!=Yii::app()->params['ics']['est_id_AUSYD'])||empty($r->consol->mdata['ubm_dest']))&&in_array('AUSYD',$export_pod))&&empty($r->mdata['ubm_tla']))
				{
					unset($rs[$key]);
				}
			}
			switch (intval($_POST['export_format_type'])) {
				case 1: //excel
					$xls=new oExcel();
					$i=1;
					$xls->addRow($i++, ['Hbn','Shipment No','AWB','Packages','Weight','POD','Status','Agent', 'ETA', 'memo', 'Location']);
					foreach ($rs as $r) {
						$xls->addRow($i++, [$r->hbn,!empty($r->ref)?$r->ref:$r->hbn,isset($r->consol->awb)?$r->consol->awb:'',$r->pkg,$r->weight,empty($r->consol)? '' : $r->consol->pod,$r->getStatus(),$r->agent->name, isset($r->consol)?$r->consol->eta:'', $r->can, $r->getRackName(true)]);
					}
				   $xls->getActiveSheet()->getStyle('A1:G1')->getFont()->setBold(true);
				   $xls->getActiveSheet()->getColumnDimension('A')->setWidth(20);
				   $xls->getActiveSheet()->getColumnDimension('B')->setWidth(20);
				   $xls->getActiveSheet()->getColumnDimension('G')->setWidth(30);
				   $xls->getActiveSheet()->getColumnDimension('H')->setWidth(15);
				   $xls->output(time().'_heldshipments.xlsx');
				break;
				case 2: //pdf
					$isToday = 0;
					if(intval($_POST['export_type'])==1) $isToday = 1;
					 oPDF::renderPDF('label_held_shipments', ['rs'=>$rs,'isToday'=>$isToday], 1, time() . '.pdf');
				break;
				case 3:
					 oPDF::renderPDF('label_held_shipments_full', ['rs'=>$rs], 1, time() . '.pdf');
				break;
				case 4:
					$filtersForm=new FiltersForm;
					$filteredData=$filtersForm->filter($rs);
					$dataProvider=new CArrayDataProvider($filteredData);
					$dataProvider->pagination=['pageSize' => 10000];
					$this->renderPartial('export_held_shipments_scan_check',['dataProvider'=>$dataProvider,'filter'=>$filtersForm]);
				break;
			}
				
			return;
		}
		$filtersForm=new FiltersForm;
		$filteredData=$filtersForm->filter([]);
		$dataProvider=new CArrayDataProvider($filteredData);
		$dataProvider->pagination=['pageSize' => 10000];
		$this->render('export_held_shipments',['dataProvider'=>$dataProvider,'filter'=>$filtersForm]);
	}

	public function actionHeldCheckScanBarcode()
	{
		$barcode = $_GET['barcode'];
		$sn = 0;
		$courier_id = 0;
		$p = ShipmentScan::getShipmentByBarcode($barcode, $sn, $courier_id);
		if(!empty($p))
		{
			$podMap = [];
			$pod_state_map = Yii::app()->params['settings']['pod_state_map'];
			$dptId= 0;
			if($p->ddpt_id==0)
			{
				$dptId = $p->consol->dpt_id;
			}else
			{
				$dptId = $p->ddpt_id;
			}

			$org = Org::model()->findByPk($dptId);
			$shipmentState = strtoupper($org->state);
			$podMap = $pod_state_map[$shipmentState];
			$result = ["code"=>$podMap["city"],"id"=>$p->id,"status"=>$p->getStatus(),"barcode"=>$barcode];
		}else
		{
			$result = ["code"=>"not_found"];
		}
		echo json_encode($result);
	}

	public function actionSaveHeldScanCheck()
	{
		$data = $_POST['data'];
		$saveData = [];
		foreach ($data as $key => $value) {
			if(!empty($value))
			{
				$saveData[]=["id"=> $value['id'],"scanCheck"=>$value['scanCheckData'],"scanLog"=>$value['scanLog'],'diff'=>$value['diff']];
			}
		}
		$iSC = new ImparcelScanCheck();
		$iSC->mdata = $saveData;
		$iSC->created = date("Y-m-d H:i:s");
		$iSC->user_id = Yii::app()->user->id;
		$iSC->save();
		echo "done";
	}

	public function actionHistoryScanCheckList()
	{
