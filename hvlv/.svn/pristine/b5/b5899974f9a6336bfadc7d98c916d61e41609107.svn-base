	public function actionFastway($id){
		$cn = $this->loadModel($id);

		$ss = ImParcel::model()->with('trans')->findAll('consol_id = :cid AND trans.status = 10 AND trans.org_id = 115 AND (json_value(t.meta,"$.oid") is null or json_value(t.meta,"$.oid") ="") ', [':cid' => $id]);
		$fssSyd = [];
		$fssMel = [];
		if (empty($ss)) return;
		foreach ($ss as $key => $s) {
			$orgRate = null;
			if(!empty($s->mdata['org_rate_id']))
			{
				$orgRate = OrgRate::model()->findByPk($s->mdata['org_rate_id']);
			}
			if(($s->getOutPkg() > 0 && in_array($s->status, ImParcel::$allow_manifest_states))||$cn->owner_id == Org::ORGID_CLIENT_TLA)
			{
				if(empty($orgRate)||!preg_match('/mel/i', $orgRate->code))
				{
					$fssSyd[] = $s;
				}else
				{
					$fssMel[] = $s;
				}
			}
		}

		$fssArr = [[$fssSyd,'syd'],[$fssMel,'mel']];
		$err = ['Fastway Manifest Error'];
		$fw = new FastwayAPI(true);

		foreach ($fssArr as $key => $fss)
		{
			if(empty($fss[0])) continue;
			if($fw->ftpManifest($fss[0],$fss[1])){
				if(empty($cn->mdata['fastwaysent'])){
					$cn->mdata['fastwaysent'] = 1;
					$cn->custom_log_note = 'Fastway Manifested';
					$cn->updateMeta();
				}
				foreach($fss[0] as $s){
					$result = $fw->addTracking($s->ref, 'PP2', time() - rand(1800, 3600));
					$result = $fw->addTracking($s->ref, 'PP5', time());
				}
				ImcoConsol::updateImportConsoleBilling([$id]);
				echo 'done';
			}else{
				echo implode('<br />', $err);
			}
		}
	}

	public function actionStartrack($id, $airout=false)
	{
		$cn = $this->loadModel($id);

		// startrack lodgement
		$ss_syd = [];
		$ss_mel = [];
		foreach ($cn->shipments as $s) {
			// when create startrack label, we have set one tranship record
			if (preg_match('/^(7RFZ|4XHZ)\d{8}/', $s->ref) && !empty($s->trans) && count($s->trans) == 1&&($s->cbwf&ImParcel::CBWF_DIRECT_CONSOL_BASE)==0) { // only for startrack shipment and Not sent yet
				// only for we received the shipment which means has been scanned in our warehouse
				// and status is cleared $s->getOutPkg() == $s->pkg
				if (($s->getOutPkg() > 0 && in_array($s->status, ImParcel::$allow_manifest_states)) || $cn->owner_id == Org::ORGID_CLIENT_TLA) {
					$s->cnee->checkPostcode();
					if (!isset($s->trans[0]->mdata['oid'])) { // if upload manifest before, we don't send again
						if (preg_match('/7RFZ\d{8}/i', $s->ref)) {
							$ss_syd[]=$s;
						} elseif (preg_match('/4XHZ\d{8}/i', $s->ref)) {
							$ss_mel[]= $s;
						}
					}
				}
			}
		}
		if ($airout&&empty($ss_syd)&&empty($ss_mel)) {
			return;
		}
		$err = [];
		$consolIds=[];
		if (!empty($ss_syd)) {
			$sydAPI =new StarTrackAPI('syd', true);
			$err= array_merge($err, $this->doStartrackManifest($sydAPI, $ss_syd, $consolIds, $cn));
		}
		if (!empty($ss_mel)) {
			$melAPI= new StarTrackAPI('mel', true);
			$err= array_merge($err, $this->doStartrackManifest($melAPI, $ss_mel, $consolIds, $cn));
		}
		if (!empty($consolIds)) {
			ImcoConsol::updateImportConsoleBilling($consolIds);
		}
		if (empty($err)) {
			echo 'done';
		} else {
			echo implode('<br />', $err);
		}
	}
	/**
	 * Manifest the Statrack Parcels
	 * @param $api the instance of StatrackAPI, can be Sysdney Instance and Melbourne Instance
	 *         $ss  An Array of Shipments
	 *         $consolIds an array to store consol id
	 *         $cn  the consol
	 */
	public function doStartrackManifest($api, $ss, &$consolIds, $cn)
	{
		$err=[];
		$r = $api->createOrderFromShipments($ss, $cn->no);
		if (!empty($r->order)) {
			$cn->mdata['startracksent'] = 1;
			$cn->save();
			$oid = $r->order->order_id;

			$mani = new Manifest;
			$mani->type = 90;
			$mani->fwd_id = Org::ORGID_COURIER_STARTRACK;
			$mani->ref = $oid;
			$mani->save();
			// because aupost returned shipment is not the same order with our sending order
			// so here we need to order by HBN again
			$auPostShipments = [];
			foreach ($r->order->shipments as $aushipment) {
				$auPostShipments[$aushipment->shipment_reference] = $aushipment;
			}
			$transaction=Yii::app()->db->beginTransaction();
			try {
				foreach ($ss as $i => $s) {

					$aushipment = $auPostShipments[$s->hbn];
					// check to see if tranship existing
					// in case existing , just update it
					$ts = Tranship::model()->find('pid = :pid AND org_id = :oid AND status = 19', [':pid' => $s->id,':oid' => Org::ORGID_COURIER_STARTRACK]);
					if (empty($ts)) {
						$mm = new ManiMap;
						$mm->mani_id = $mani->id;
						$mm->fid = $s->id;
						$mm->model = 'ImParcel';
						$mm->status = 10;
						$mm->mdata['mani_time'] = date('Y-m-d H:i:s');
						$mm->save();

						$ts = new Tranship;
						$ts->pid = $s->id;
						$ts->org_id = Org::ORGID_COURIER_STARTRACK;  // for startrack post office
						$ts->man_id = $s->man_id;
						$ts->type = 80;  // shipment transfer to a different delivery courier
						$ts->status = 19; // in finally moving status
						$ts->connote = $s->ref;
						// currently we save cost with a single field

						$ts->mdata['cost'] = $aushipment->shipment_summary->total_cost;
						$costValue = floatval($aushipment->shipment_summary->total_cost - $aushipment->shipment_summary->total_gst);
						$ts->cost = round($costValue, 2);
					}
					$ts->time = date('Y-m-d H:i:s');
					$ts->mdata['oid'] = $oid;
					$ts->mdata['sid'] = $aushipment->shipment_id;
					$ts->save();
					if ($s->consol_id  > 0) {
						array_push($consolIds, $s->consol_id);
					}

					$s->addTracking(70, 'In transit');
				}
				$consolIds=array_unique($consolIds);
				$transaction->commit();
			} catch (Exception $ex) {
				$transaction->rollback();
				Log::log2file("Startrack Manifest=>".$cn->no."=>".$ex->getMessage(), "transaction_err_log", "transaction");
				throw $ex;
			}
		} else {
			foreach ($api->err as $e) {
				$msg = $e->message;
				if (!empty($e->field) && preg_match('/shipments\[(\d+)\]/', $e->field, $m)) {
					$msg .= ': '.$ss[$m[1]]->hbn;
				}
				$err[] = $msg;
			}
		}
		return $err;
	}

	/**
	 * send lodgement to Toll
	 * @param $id
	 * @throws CHttpException
	 */
	public function actionTollpost($id, $airout=false)
	{
		$cn = $this->loadModel($id);

		// toll lodgement
		$ss = [];
		$tollMatches = '/^'. TollAPI::TOLL_SLID .'\d{7}|^'. TollAPI::TOLL_SLID .'\d{6}/';
		$tollMatches2 = '/^'. TollAPI::TOLL_SLID_OFFPEAK .'\d{7}|^'. TollAPI::TOLL_SLID_OFFPEAK .'\d{6}/';
		$bResend = false;
		if (isset($cn->mdata['tollsent']) && $cn->mdata['tollsent'] == 1) {
			$bResend = true;
		}
		foreach ($cn->shipments as $s) {
			if (($s->cbwf&ImParcel::CBWF_DIRECT_CONSOL_BASE)>0) {
				continue;
			}
			if ((preg_match($tollMatches, $s->ref) || preg_match($tollMatches2, $s->ref))
				&&  ($bResend ||  (!$bResend && empty($s->trans)))) { // only for toll shipment and Not sent yet
				// only for we received the shipment which means has been scanned in our warehouse
				// and status is cleared $s->getOutPkg() == $s->pkg
				if (($s->getOutPkg() > 0 && in_array($s->status, ImParcel::$allow_manifest_states)) || $cn->owner_id == Org::ORGID_CLIENT_TLA) {
					$s->cnee->checkPostcode();
					$ss[] = $s;
				}
			}
		}

		$err = [];
		if ($airout&&empty($ss)) {
			return;
		}
		if (!empty($ss)) {
			$tollApi = new TollAPI(true);
			$xml = $tollApi->getXmlConsignments($ss);
			$rt = $tollApi->postShipments($xml);
			if (!$rt) {
				$err[] = 'Failed to send to Toll : ' . $tollApi->getError() ;
			} else {
				if(empty($cn->mdata['tollsent'])){
					$cn->mdata['tollsent'] = 1;
					$cn->custom_log_note = 'Toll Manifested';
					$cn->updateMeta();
				}

				// save all tranship information
				foreach ($ss as $i => $s) {

					// check to see if tranship existing or not
					// in case existing just updated
					$ts = Tranship::model()->find('pid = :pid AND org_id = :oid AND type = 80', [':pid' => $s->id,':oid' => Org::ORGID_COURIER_TOLL]);
					if (empty($ts)) {
						$ts = new Tranship;
						$ts->pid = $s->id;
						$ts->org_id = Org::ORGID_COURIER_TOLL;  // for toll
						$ts->type = 80;  // shipment transfer to a different delivery courier
						$ts->status = 19; // in finally moving status
					}
					$ts->man_id = $s->man_id;
					$ts->connote = $s->ref;
					$ts->time = date('Y-m-d H:i:s');

					// get cost by Toll API
					$cost = $tollApi->getCost($s);
					if ($cost > 0) {
						$ts->cost = round($cost, 2);
					}

					$ts->save();

					// for toll we need create billing based on parcel
					// not by consol
					$billing = BillingLine::model()->find('billing_ref = :cref AND link_id = :lid AND org_id = :oid AND charge_code = :ccode', [':cref' => $cn->no,':lid' => $s->id ,':oid' => Org::ORGID_COURIER_TOLL,':ccode' =>Consol::AU_LOCAL_DELIVERY_COST_GL_CODE ]);
					if (empty($billing)) {
						$billing = new BillingLine();
						$billing->type = BillingLine::BILLING_TYPE_IMPORT;
						$billing->status = 1; // initial pending status

						// for toll bill should be based on Parcel
						// so we should link with parcel id
						$billing->link_id = $s->id;
						$billing->desc = $s->ref; // show related shipment reference number
						$billing->org_id = Org::ORGID_COURIER_TOLL;
						$billing->charge_code = Consol::AU_LOCAL_DELIVERY_COST_GL_CODE;
						$billing->billing_cref =  $cn->no;
						$billing->currency = 1; // AUD default
						$billing->weight = isset($cn->mdata['awb_wt']) ? $cn->mdata['awb_wt'] : 0;
						$billing->charge_weight = isset($cn->mdata['cgb_wt']) ? $cn->mdata['cgb_wt'] : 0;

						// normally billing reference will be awb no , if not set we set job ID as reference
						$billing->billing_ref = $cn->no;
						$billing->awb = $cn->awb;
						$billing->dpt_id = empty($cn->dpt_id) ? Org::PCAE_DEPARTMENT_SYDNEY : $cn->dpt_id;
						$billing->date = date('Y-m-d');
						$billing->created = date('Y-m-d');
						$billing->transaction_date = $billing->date;
						$billing->due = $billing->date;
						$billing->type = BillingLine::BILLING_TYPE_IMPORT; // for import type
						$billing->dpmt = Invoice::DPMT_IMPORT;
						$billing->actual_amount = 0;
						$billing->gst = 'EXEMPTEXPENSES';
					}
					$billing->accrual_amount = $cost;
					$billing->save();


					// push to pl ledger table as well
					// push cost data to pl ledger table as well
					// group 2 saved as tranship org id which is courier id
					$d = [
						'gl' => 29,
						'fid' => $s->id,
						'model' => 'ImParcel',
						'dpt_id' => Org::PCAE_DEPARTMENT_SYDNEY,
						'lid' => 0,
						'org_id' => $s->agent_id,
						'dpmt' => Invoice::DPMT_IMPORT,
						'grp1' => $cn->id,
						'grp2' => Org::ORGID_COURIER_TOLL,
						'date' => $cn->eta,
						'amt' => $cost,
						'gst' => 0,
					];
					
					PlLedger::add($d, true, ['org_id', 'date', 'grp1']);
				}

				// update console billing data
			   // ImcoConsol::updateImportConsoleBilling([$cn->id]);
			}
		} else {
			$err[] = 'Sorry , no any Toll shipments';
		}

		if (empty($err)) {
			echo 'done';
		} else {
			echo implode('<br />', $err);
		}
	}
		
		
	public function actionD2zPost($id)
	{
		$cn = $this->loadModel($id);
		$err=[];
		$ss=[];
		$tempShipments=[];
		foreach ($cn->shipments as $s) {
			// when create startrack label, we have set one tranship record
			 if (isset($s->mdata['d2z_shipment_orderid'])&& (strlen($s->ref)>7) && !empty($s->trans) && count($s->trans) == 1&&($s->cbwf&ImParcel::CBWF_DIRECT_CONSOL_BASE)==0) { // only for startrack shipment and Not sent yet
			 // only for we received the shipment which means has been scanned in our warehouse
			 // and status is cleared $s->getOutPkg() == $s->pkg
		  if ($s->getOutPkg() > 0 && in_array($s->status, ImParcel::$allow_manifest_states)) {
			  if (!isset($s->trans[0]->mdata['oid'])) { // if upload manifest before, we don't send again
				  $ss[] = $s;
				  $tempShipments[$s->ref]=$s;
			  }
		  }
			 }
		}
		if (!empty($ss)) {
			$d2z=new D2zAPI(false, false);  //need to fix on live
			$result=$d2z->manifest($ss);
			if (is_array($result)) {
				$transaction = Yii::app()->db->beginTransaction();
				try {
					foreach ($result as $shipmentRef) {
						$ref= substr($shipmentRef, 0, -11);
						$shipment=$tempShipments[$ref];
						$tranship=$shipment->trans[0];
						$tranship->mdata['oid'] = $ref;
						$tranship->cost= number_format($d2z->getD2zCost($shipment), 2, '.', '');
						$tranship->save();
					}
					$transaction->commit();
				} catch (Exception $ex) {
					$transaction->rollback();
					Log::log2file("D2Z".$cn->no."=>".$ex->getMessage(), "transaction_err_log", "transaction");
					throw $ex;
				}
			} elseif (is_object($result)) {
				if ($result->status=="Failed") {
					$err[]=$result->message;
				}
			}
			if (empty($err)) {
				ImcoConsol::updateImportConsoleBilling([$id]);

				if(empty($cn->mdata['d2zsent'])){
					$cn->mdata['d2zsent'] = 1;
					$cn->custom_log_note = 'D2Z Manifested';
					$cn->updateMeta();
				}
				echo 'done!';
			} else {
				echo implode('<br />', $err);
			}
		}
	}

	public function actionUbiManifest($id)
	{
		$cn = $this->loadModel($id);
		$imConsolService = new ImConsolService();
		$err=[];
		$ss=[];
		foreach ($cn->shipments as $s) {
			if (((in_array($s->status, ImParcel::$allow_manifest_states)&&$s->getOutPkg() > 0)|| $cn->owner_id == Org::ORGID_CLIENT_TLA)&&!empty($s->trans)) 
			{
				$trans = $s->trans;
				$tran = end($trans);

			  if ($tran->connote==$s->ref&&!isset($tran->mdata['oid'])&&($tran->org_id==Org::ORGID_COURIER_UBI)) { // if upload manifest before, we don't send again
					$orgRate = OrgRate::model()->findByPk($s->mdata['org_rate_id']);
					if(preg_match('/TOLL/i', $orgRate->code)) continue;
				  	$ss[] = $s;
			  }
		  	}
		}
		$max_ppg = 300;
		$pgs = ceil(count($ss) / $max_ppg);
		for($pg = 0; $pg < $pgs; $pg++){
			$shipments = array_slice($ss, $pg * $max_ppg, $max_ppg);
			$err = array_merge($err, $imConsolService->doUbiManifest($shipments));
		}
		//$err = $imConsolService->doUbiManifest($ss);
		if(!empty($ss)){
			if (empty($err)) {
				ImcoConsol::updateImportConsoleBilling([$id]);
				if(empty($cn->mdata['ubisent'])){
					$cn->mdata['ubisent'] = 1;
					$cn->custom_log_note = 'UBI Manifested';
					$cn->updateMeta();
				}
				echo 'done!';
			} else {
				Emailog::sendEmailTo($cn->getNoticeEmail(), "UBI ".$cn->no." ".join(",",$err), $cn->no." UBI Aupost Manifest ERROR");
				echo implode('<br />', $err);
			}
		}
	}

	public function actionDfeManifest($id)
	{
		return false;
		$cn = $this->loadModel($id);
		$imConsolService = new ImConsolService();
		$err=[];
		$ss=[];
		$ssT = [];
		foreach ($cn->shipments as $s) {
			if (!empty($s->trans)) 
			{
				$trans = $s->trans;
				$tran = end($trans);
			  if ((!isset($tran->mdata['oid'])||(isset($tran->mdata['oid'])&&$tran->mdata['oid']!=Org::ORGID_COURIER_DFE))&&($tran->org_id==Org::ORGID_COURIER_DFE)&& in_array($s->status, ImParcel::$allow_manifest_states)&&$s->getOutPkg() > 0&&$tran->connote==$s->ref) { // if upload manifest before, we don't send again
				  $ss[] = $s;
			  }

			  if ((!isset($tran->mdata['oid'])||(isset($tran->mdata['oid'])&&$tran->mdata['oid']!=Org::ORGID_COURIER_DFE_TOP))&&($tran->org_id==Org::ORGID_COURIER_DFE_TOP)&& in_array($s->status, ImParcel::$allow_manifest_states)&&$s->getOutPkg() > 0&&$tran->connote==$s->ref) { // if upload manifest before, we don't send again
				  $ssT[] = $s;
			  }
		  	}
		}
		$err1 = [];
		$err2 = [];
		$err = [];
		$err1 = array_merge($err1, $imConsolService->doDfeManifest($ss));
		$err2 = array_merge($err2, $imConsolService->doDfeManifest($ssT));
		$err= array_merge($err1,$err2);
		//$err = $imConsolService->doUbiManifest($ss);

		if (empty($err)) {
			ImcoConsol::updateImportConsoleBilling([$id]);
			if(empty($cn->mdata['dfesent'])){
				$cn->mdata['dfesent'] = 1;
				$cn->mdata['manifest_date'] = date('Y-m-d');
				$cn->custom_log_note = 'DFE Manifested';
				$cn->updateMeta();
			}
			echo 'done!';
		} else {
			echo implode('<br />', $err);
		}
	}

