	public function actionExportDFEShipment($id)
	{
		$model = $this->loadModel($id);
		$xls = new oExcel;
		$i = 1;
		// $xls->addRow($i++, ['WBN', 'Ref','Awb','Packages', 'Weight', 'Status', 'Agent', 'Sender', 'Sender Tel', 'Cnee Name', 'Cnee Tel', 'Address', 'State', 'Date', 'Delay','Extra Info']);
		$xls->addRow($i++, ['WBN', 'Ref','Consol No','Packages', 'Weight','Total CBM','Status', 'Cnee Name', 'Cnee Company',  'Cnee Tel', 'Address','suburb', 'State', 'Postcode','Rack','Memo','is_B2B(1yes 0No)']);

		foreach ($model->shipments as $r) {
			if (empty($r->cnee)) {
				continue;
			}
			$ln = $r->getLastLog();
			$extraInfo=$r->getExtraInfo();
			$dd = empty($ln)? 0 : ceil((time() - strtotime($ln->time)) / 86400);
			// $xls->addRow($i++, [$r->hbn, $r->ref, empty($r->consol)? '' : $r->consol->awb,$r->pkg,$r->weight, $r->getStatus(), empty($r->agent)? '' : $r->agent->name, $r->cnor->name, '="'.$r->cnor->tel.'"', $r->cnee->name, '="'.$r->cnee->tel.'"', $r->cnee->address, $r->cnee->state, $r->created, $dd,$extraInfo]);
			$trans = $r->trans;
			if(!empty($trans)&&end($trans)->org_id==Org::ORGID_COURIER_DFE_TOP)
			{
				$isB2B = 0;
				if(!empty($r->cnee->company))
				{
					$isB2B = 1;
				}

				if(isset($r->mdata['is_b2b']))
				{
					$isB2B = empty($r->mdata['is_b2b'])?0:1;
				}

				$xls->addRow($i++, [$r->hbn, $r->ref,empty($r->consol)? '' : $r->consol->no,$r->pkg, $r->weight,$r->cbm*$r->pkg, $r->getStatus(), $r->cnee->name,$r->cnee->company ,$r->cnee->tel,$r->cnee->address,$r->cnee->suburb, $r->cnee->state,$r->cnee->postcode,$r->getRackName(),$r->can,$isB2B]);
			}
		}
		$xls->output('imp_search_export_'.time().'.xlsx');
	}

	public function actionChukou1Manifest($id)
	{
		$cn = $this->loadModel($id);
		$imConsolService = new ImConsolService();
		$err=[];
		$ss=[];
		$ssT = [];
		foreach ($cn->shipments as $s) {
			if (!empty($s->trans)) 
			{
				$trans = $s->trans;
				$tran = end($trans);
			  if ((!isset($tran->mdata['oid'])||(isset($tran->mdata['oid'])&&$tran->mdata['oid']!=Org::ORGID_COURIER_CHUKOU1))&&($tran->org_id==Org::ORGID_COURIER_CHUKOU1)&& in_array($s->status, ImParcel::$allow_manifest_states)&&$s->getOutPkg() > 0) { // if upload manifest before, we don't send again
				  $ss[] = $s;
			  }
		  	}
		}
		if(empty($ss))
		{
			echo 'done!';
			return;
		}
		$err = [];
		$err = array_merge($err, $imConsolService->doChukou1Manifest($ss));
		//$err = $imConsolService->doUbiManifest($ss);

		if (empty($err)) {
			ImcoConsol::updateImportConsoleBilling([$id]);
			if(empty($cn->mdata['chukou1sent'])){
				$cn->mdata['chukou1sent'] = 1;
				$cn->mdata['manifest_date'] = date('Y-m-d');
				$cn->custom_log_note = 'Chukou1 Manifested';
				$cn->updateMeta();
			}
			echo 'done!';
		} else {
			echo implode('<br />', $err);
		}
	}

