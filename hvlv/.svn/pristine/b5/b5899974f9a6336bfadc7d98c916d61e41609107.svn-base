		}
	}

	/**
	 * Lists and search.
	 */
	public function actionList()
	{
		$model=new ImcoConsol('search');
		$model->unsetAttributes();  // clear any default values
		if (isset($_GET['ImcoConsol'])) {
			$model->attributes=$_GET['ImcoConsol'];
		}
		$delivery_type='All Type';
		if (!empty($_GET['delivery_type'])) {
			$model->service=$_GET['delivery_type'];
			switch ($_GET['delivery_type']) {
						case 10: $delivery_type='Air';break;
						case 20: $delivery_type="Sea";break;
					}
		}
		$this->render('list', [
			'model'=>$model,
			'delivery_type'=>$delivery_type,
		]);
	}

	public function actionExportCurrentSearch()
	{
		$csv = [];
		$csv[] = 'No,AWB No.,Customer,Status,Service,Depot,Flight No.,POL,POD,ETA,Shipments,Weight,extra Info,Unload Date';
		$model=new ImcoConsol('search');
		$model->unsetAttributes();  // clear any default values
		if (isset($_GET['ImcoConsol'])) {
			$model->attributes=$_GET['ImcoConsol'];
		}
		$delivery_type='All Type';
		if (!empty($_GET['delivery_type'])) {
			$model->service=$_GET['delivery_type'];
			switch ($_GET['delivery_type']) {
						case 10: $delivery_type='Air';break;
						case 20: $delivery_type="Sea";break;
					}
		}
		$consols = $model->search(false)->data;

		foreach ($consols as $r)
		{
			$customer = join(";",explode(',',$r->getOwnerName(false,true)));
			$csv[] = $r->no.",".$r->awb.",".$customer.",".$r->getStatus().",".$r->getService().",".@$r->depot->name.",".$r->flight.",".$r->pol.",".$r->pod.",".$r->eta.",".$r->totShipments(0,true).",".$r->totWeight(0,true).",".$r->getConsolDGWarnings(true,false).",".@$r->mdata["ContainerUnloadDate"];
		}
		header("Content-type: text/csv");
		header("Content-Disposition: attachment; filename=consol_export.csv");
		header("Pragma: no-cache");
		header("Expires: 0");
		echo implode("\n", $csv);
	}


	
	public function actionExport($id)
	{
		$model=$this->loadModel($id);
		$csv = [];
		$csv[] = 'TYPE,CONNOTE NO.,REFERENCE,WEIGHT,VOLUME,CNEE,TEL,ADDRESS,SUBURB,STATE,P/C,DESTINATION,,PCS,COMMODITY,INNER ITEMS,UNIT VALUE,TTL VALUE,CMETER,SHIPPER,SHIPPER ADD,SHIPPER STATE,SHIPPER PC,SHIPPER COUNTRY CODE,SHIPPER CONTACT';
		foreach ($model->shipments as $r) {
			if (($r->cbwf&ImParcel::CBWF_DIRECT_CONSOL_BASE)>0) {
				continue;
			}
			$volume=$r->cbm>0?$r->cbm*$r->pkg:$r->weight/250;
			if ($volume<0.001) {
				$volume=0.001;
			}

			$type = 'Parcel';
			if(!empty($r->mdata['letter_aupost'])){
				switch($r->mdata['letter_aupost']){
					case 1:
						$type = 'Small Letter';
					break;
					case 2:
					case 4:
					case 8:
						$type = 'Large Letter';
					break;
					case 16:
						$type = 'Priority Small Letter';
					break;
					case 32:
					case 64:
					case 128:
						$type = 'Priority Large Letter';
					break;
				}
			}
			$csv[] = $type.',"'.$r->hbn.'","'.$r->ref.'",'.$r->weight.','.sprintf("%.3f", $volume).',"'.$r->cnee->name.'","'.$r->cnee->tel.'","'.str_replace('"', '', $r->cnee->address).'","'.$r->cnee->suburb.'","'.$r->cnee->state.'",'.$r->cnee->postcode.','.$r->cnee->country.','.$r->cnee->country.','.$r->pkg.',"'.implode(',', $r->eitems['g']).'","'.implode(',', $r->eitems['q']).'","'.implode(',', $r->eitems['v']).'",'.$r->dvalue.','.$r->cbm.',"'.$r->cnor->name.'","'.str_replace('"', '', $r->cnor->address).'","'.$r->cnor->state.'",'.$r->cnor->postcode.',"'.$r->cnor->country.'",'.$r->cnor->tel;
		}
		header("Content-type: text/csv");
		header("Content-Disposition: attachment; filename=consol_manifest_".$model->awb.".csv");
		header("Pragma: no-cache");
		header("Expires: 0");
		echo implode("\n", $csv);
	}
		
	public function actionExportShipmentDetail($id)
	{
		$model=$this->loadModel($id);
		$csv=[];
		$csv[]='CONNOTE NO.,REF,CLIENT,WEIGHT,VOLUME,PACKS';
		foreach ($model->shipments as $r) {
			if (($r->cbwf&ImParcel::CBWF_DIRECT_CONSOL_BASE)>0) {
				continue;
			}
			$volume= sprintf("%.4f", $r->cbm*$r->pkg);
			$agent=$r->agent->name;
			$csv[] = '"'.$r->hbn.'","'.$r->ref.'","'.$agent.'",'.$r->weight.','.sprintf("%.4f", $volume).','.$r->pkg;
		}
		header("Content-type: text/csv");
		header("Content-Disposition: attachment; filename=consol_detail_".$model->no.".csv");
		header("Pragma: no-cache");
		header("Expires: 0");
		echo implode("\n", $csv);
	}
	
	public function actionEparcel($id)
	{
		$model=$this->loadModel($id);
		$pods = [
			'NSW' => 'AUSYD',
			'ACT' => 'AUSYD',
			'VIC' => 'AUMEL',
			'SA' => 'AUMEL',
			'TAS' => 'AUMEL',
			'WA' => 'AUPER',
			'QLD' => 'AUBNE',
			'NT' => 'AUBNE',
		];
		$pdata = [];
		foreach ($model->shipments as $r) {
			$addr = str_split(str_replace("\n", ' ', $r->cnee->address), 40);
			while (sizeof($addr)<4) {
				$addr[] = '';
			}
			
			$goods = $r->getGoods();
			$cbm = round($r->cbm*1000000)/1000000;
			$weight = round($r->weight*1000)/1000;
			$pod = empty($pods[$r->state])? 'AUSYD' : $pods[$r->state];
			$pdata[$pod][] = [
				'C,'.$r->hbn.',,PL5,,"'.$r->cnee->name.'",,"'.implode('","', $addr).'","'.$r->cnee->suburb.'",'.$r->cnee->state.','.$r->cnee->postcode.',AU,'.preg_replace('/[^\d]+/', '', $r->cnee->tel).',N,,,N,N,,N,0,,N,,N,,N,Sender,Unit 7 1-3 Burrow Road,,,,St Peters,NSW,2044,AU,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,',
				'A,'.$weight.',,,,,'.$goods.',,N,0,,,,,,,,,,',
				'G,,,"'.$goods.'",,,'.$r->itemsTotQty().','.$weight.','.$r->value.','.$r->dvalue
			];
		}
		
		$bd = Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR;
		$zip = new ZipArchive;
		$zf = $bd.'PCAE_eParcel'.date('Ymd').'.zip';
		$zip->open($zf, ZipArchive::CREATE);
		
		foreach ($pdata as $pod => $rs) {
			$csv = [];
			$i = 1;
			foreach ($rs as $r) {
				$csv = array_merge($csv, $r);
			}
			$zip->addFromString('eParcel_'.$model->awb.'_'.$pod.'.csv', implode("\n", $csv));
		}
		
		$zip->close();
		header("Cache-Control: maxage=1");
		header("Content-Description: File Transfer");
		header("Content-type: application/octet-stream");
		header("Content-Disposition: attachment; filename=\"".basename($zf)."\"");
		header("Content-Transfer-Encoding: binary");
		header("Content-Length: ".filesize($zf));
		readfile($zf);
		unlink($zf);
		Yii::app()->end();
	}

	public function actionDownload($id)
	{
		$ships = Shipment::model()->findAll("consol_id = :id",[":id"=>$id]);
		$imParcelService = new ImParcelService();
		$imParcelService->getAutoImparcelLabelMultiZip($ships);
	}
		
		
	public function actionSendScan($id)
	{
		$model=$this->loadModel($id);

		$existing = ConsolScan::model()->find('consol_id = :cid', [':cid' => $model->id]);
		if (empty($existing)) {
			$consoleScan = new ConsolScan();
			$consoleScan->added_date = date('Y-m-d');
			$consoleScan->status = 0; // ready for scan
			$consoleScan->consol_id = $model->id;

			$consoleScan->save();
			$err = $consoleScan->getErrors();

			if (empty($err)) {
				$model->mdata['sentforscan'] = true;
				$model->save();
			}
		} else {
			$err = ['Already for scan'];
		}

		if (empty($err)) {
			echo 'done';
		} else {
			echo  implode('<br />', $err);
		}
	}

	public function actionSac($id)
	{
		$model=$this->loadModel($id);
		$xls = new oExcel;
		$mfn = 'PCAE'.date('Ymd').$model->pod;
		$i = 1;
		$xls->addRow($i++, ['fld_TM_manifest_id', 'fld_TM_cartons', 'fld_TM_cbm', 'fld_TM_weight', 'fld_TM_container_type', 'fld_TM_container_no', 'fld_TM_seal_no', 'fld_TM_vessel_name', 'fld_TM_edt', 'fld_TMD_connote_no', 'fld_TMD_order_no', 'fld_TMD_cartons', 'fld_TMD_cbm', 'fld_TMD_weight', 'fld_TO_filename', 'fld_TO_import_date', 'fld_TO_order_no', 'fld_TO_carrier', 'fld_TO_surname', 'fld_TO_address_1', 'fld_TO_address_2', 'fld_TO_country_code', 'fld_TO_suburb', 'fld_TO_state', 'fld_TO_postcode', 'fld_TO_telephone', 'fld_TO_delivery_instr', 'fld_TO_address_3', 'fld_TO_weight', 'fld_TOL_line_no', 'fld_TOL_product_no', 'fld_TOL_item_no', 'fld_TOL_quantity', 'fld_TOL_promised_date', 'fld_TOL_price', 'fld_TOL_total_amount', 'fld_edi_description', 'name', 'addr1', 'addr2', 'city', 'state', 'postcode', 'country']);
		$xls->setFont('A1:H1', ['bold' => true]);
		foreach ($model->shipments as $r) {
			$addr = $r->cnee->address;
			$addr2 = '';
			if (preg_match('/P\.*O\.*\s+BOX/', $r->cnee->address)) {
				$addr = '';
				$addr2 = $r->cnee->address;
			}
			
			$goods = $r->getGoods();
			$cbm = round($r->cbm*1000000)/1000000;
			$weight = round($r->weight*1000)/1000;
			$service = $weight > 2? 'AeParcelPar' : 'AeParcelPac';
			$etd = date('d/m/Y', strtotime($model->eta.' +5 days'));
			$xls->addRow($i++, [$r->hbn, 1, $cbm, $weight, 'AIR', 'PCAE', 'AUD', $model->airline, date('d/m/Y', strtotime($model->eta)), 'CONNOTE', 'ORDER_NO', 1, $cbm, $weight, $mfn, date('d/m/Y', strtotime($model->eta)), $r->hbn, 1, $r->cnee->name, $addr, $addr2, 'AUS', $r->cnee->suburb, $r->state, $r->postcode, preg_replace('/[^\d]+/', '', $r->cnee->tel), $service, '', $weight, 1, '', '', $r->pkg, $etd, $r->value, $r->dvalue, $goods, $r->cnor->name, $r->cnor->address, '', $r->cnor->suburb, $r->cnor->state, $r->cnor->postcode, substr($model->pol, 2)]);
		}
		$xls->output($mfn.'.xls', 'Excel5');
	}
	
	public function actionMsac($id)
	{
		$model=$this->loadModel($id);
		$pods = [
			'NSW' => 'AUSYD',
			'ACT' => 'AUSYD',
			'VIC' => 'AUMEL',
			'SA' => 'AUMEL',
			'TAS' => 'AUMEL',
			'WA' => 'AUPER',
			'QLD' => 'AUBNE',
			'NT' => 'AUBNE',
		];
		$pdata = [];
		foreach ($model->shipments as $r) {
			$addr = $r->cnee->address;
			$addr2 = '';
			if (preg_match('/P\.*O\.*\s+BOX/', $r->cnee->address)) {
				$addr = '';
				$addr2 = $r->cnee->address;
			}
			
			$goods = $r->getGoods();
			$cbm = round($r->cbm*1000000)/1000000;
			$weight = round($r->weight*1000)/1000;
			$service = $weight > 2? 'AeParcelPar' : 'AeParcelPac';
			$etd = date('d/m/Y', strtotime($model->eta.' +5 days'));
			$pod = empty($pods[$r->state])? 'AUSYD' : $pods[$r->state];
			$pdata[$pod][] = [$r->hbn, 1, $cbm, $weight, 'AIR', 'PCAE', 'AUD', $model->airline, date('d/m/Y', strtotime($model->eta)), 'CONNOTE', 'ORDER_NO', 1, $cbm, $weight, $pod, date('d/m/Y', strtotime($model->eta)), $r->hbn, 1, $r->cnee->name, $addr, $addr2, 'AUS', $r->cnee->suburb, $r->state, $r->postcode, preg_replace('/[^\d]+/', '', $r->cnee->tel), $service, '', $weight, 1, '', '', $r->pkg, $etd, $r->value, $r->dvalue, $goods, $r->cnor->name, $r->cnor->address, '', $r->cnor->suburb, $r->cnor->state, $r->cnor->postcode, substr($model->pol, 2)];
		}
		
		$bd = Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR.'SACM'.time().DIRECTORY_SEPARATOR;
		if (is_dir($bd)) {
			AppHelper::unlinkRecursive($bd);
		}
		mkdir($bd);
		$zip = new ZipArchive;
		$zf = $bd.'PCAE_SACM'.date('Ymd').'.zip';
		$zip->open($zf, ZipArchive::CREATE);
		
		foreach ($pdata as $pod => $rs) {
			$xls = new oExcel;
			$mfn = 'PCAE'.date('Ymd').$pod;
			$i = 1;
			$xls->addRow($i++, ['fld_TM_manifest_id', 'fld_TM_cartons', 'fld_TM_cbm', 'fld_TM_weight', 'fld_TM_container_type', 'fld_TM_container_no', 'fld_TM_seal_no', 'fld_TM_vessel_name', 'fld_TM_edt', 'fld_TMD_connote_no', 'fld_TMD_order_no', 'fld_TMD_cartons', 'fld_TMD_cbm', 'fld_TMD_weight', 'fld_TO_filename', 'fld_TO_import_date', 'fld_TO_order_no', 'fld_TO_carrier', 'fld_TO_surname', 'fld_TO_address_1', 'fld_TO_address_2', 'fld_TO_country_code', 'fld_TO_suburb', 'fld_TO_state', 'fld_TO_postcode', 'fld_TO_telephone', 'fld_TO_delivery_instr', 'fld_TO_address_3', 'fld_TO_weight', 'fld_TOL_line_no', 'fld_TOL_product_no', 'fld_TOL_item_no', 'fld_TOL_quantity', 'fld_TOL_promised_date', 'fld_TOL_price', 'fld_TOL_total_amount', 'fld_edi_description', 'name', 'addr1', 'addr2', 'city', 'state', 'postcode', 'country']);
			$xls->setFont('A1:H1', ['bold' => true]);
			foreach ($rs as $r) {
				$r[14] = $mfn;
				$xls->addRow($i++, $r);
			}
			$xls->output($bd.$mfn.'.xls', 'Excel5', false);
			$zip->addFile($bd.$mfn.'.xls', $mfn.'.xls');
		}
		
		$zip->close();
		header("Cache-Control: maxage=1");
		header("Content-Description: File Transfer");
		header("Content-type: application/octet-stream");
		header("Content-Disposition: attachment; filename=\"".basename($zf)."\"");
		header("Content-Transfer-Encoding: binary");
		header("Content-Length: ".filesize($zf));
		readfile($zf);
		unlinkRecursive($bd);
		unlink($zf);
		Yii::app()->end();
	}

