	public function actionSeaOutturnShipments()
	{
		$id = $_GET['id'];
		$model= $this->loadModel($id);
		$cptype = empty($_GET['type'])?"":$_GET['type'];
		$courier = empty($_GET['courier'])?"":$_GET['courier'];
		$format = empty($_GET['format'])?"":$_GET['format'];
		if (!empty($model->shipments)) {
			$td = Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR;
			$ps=[];
			$type = Consol::$services[$model->service];
			if($cptype==1)
			{
				$coverpage = oPDF::renderPDF('sea_outturn_coverpage', ['model' => $model], 2);
				$ps[] = $coverpage;
			}
			if($format == "" || $format == 0) {
				foreach ($model->shipments as $shipment) {
					$size = count($shipment->trans);
					if(!in_array(0, $courier))
					{
						if(!empty($courier)&&$size>0)
						{
							if(!in_array($shipment->trans[$size-1]->org_id, $courier))
							{
								continue;
							}
						}else
						{
							if(!in_array(999, $courier))
							{
								continue;
							}
						}
					}
					if(($shipment->bwf & 4096) > 0) continue;
					$tf = tempnam($td, "stmt");
					oPDF::renderPDF('sea_outturn', ['model' => $shipment,"type"=>$type], 2, $tf);
					$ps[] = $tf;
				}
			} else {	// Print simple sea outturn report
				$sql = 'SELECT * FROM shipment WHERE consol_id = ' . $model->id . ' AND (bwf & 4096)=0';
				$shipments = ImParcel::model()->findAllBySql($sql);
				/**
				 * This is used for pagination.
				 * Display 5 shipments on each page.
				 */
				$shipmentGroup = [];
				$temp = [];
				for ($i = 0; $i < count($shipments); $i++) {
					if (count($temp) == 5) {
						array_push($shipmentGroup, $temp);
						$temp = [];
						if(($shipments[$i]->bwf & 4096) > 0) {
							continue;
						}
						array_push($temp, $shipments[$i]);
					} else {
						if(($shipments[$i]->bwf & 4096) > 0) {
							continue;
						}
						array_push($temp, $shipments[$i]);
					}
					if ($i == count($shipments) - 1 && count($temp) > 0) {
						array_push($shipmentGroup, $temp);
					}
				}
				foreach ($shipmentGroup as $group) {
					$tf = tempnam($td, "stmt");
					oPDF::renderPDF('sea_outturn_simple', ['model' => $model, "shipments" => $group, "type"=>$type], 2, $tf);
					$ps[] = $tf;
				}
				// Damage report page
				$tf = tempnam($td, "stmt");
				oPDF::renderPDF('sea_outturn_simple_damage', ['model' => $model, "shipments" => $shipments, "type"=>$type], 2, $tf);
				$ps[] = $tf;
			}
			oPDF::mergePDF($ps, 1, true, 'outturn'.$model->no.'.pdf');
		}
	}
		
