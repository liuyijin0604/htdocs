			  if ($tran->connote==$s->ref&&empty($tran->mdata['non_manifest'])&&!isset($tran->mdata['oid'])&&($tran->org_id==Org::ORGID_COURIER_UBI)) { // if upload manifest before, we don't send again
			  	if((in_array($s->status, ImParcel::$allow_manifest_states)&&$s->getOutPkg() > 0)|| $cn->owner_id == Org::ORGID_CLIENT_TLA)
				{
					$orgRate = OrgRate::model()->findByPk($s->mdata['org_rate_id']);
					if(preg_match('/LOCAL/i', $orgRate->code)) continue;
				  	$ss[] = $s;
