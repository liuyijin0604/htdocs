				if(empty($cn->mdata['bordersent'])){
					$cn->mdata['bordersent'] = 1;
				}

				$cn->custom_log_note = 'My Border Manifested';
				$cn->updateMeta();
				echo 'done!';
			} else {
				Emailog::sendEmailTo($cn->getNoticeEmail(), "MY border ".$cn->no." ".join(",",$err), $cn->no." My border Manifest ERROR");
				echo implode('<br />', $err);
			}
		}
	}

