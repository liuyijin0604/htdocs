	public function actionGetScanCheck()
	{
		$id = $_GET['id'];
		$filtersForm=new FiltersForm;
		$iSC = ImparcelScanCheck::model()->findByPk($id);
		$provide = [];
		foreach ($iSC->mdata as $key => $value) {
			$pid = $value['id'];
			$p = ImParcel::model()->findByPk($pid);
			$scanCheck = $value['scanCheck'];
			$diff = $value['diff'];
			$p->scanCheck = $scanCheck;
			$provide[] = $p;
		}
		$filteredData=$filtersForm->filter($provide);
		$dataProvider=new CArrayDataProvider($filteredData);
		$dataProvider->pagination=['pageSize' => 10000];
		$this->render('get_scan_check',['dataProvider'=>$dataProvider,'filter'=>$filtersForm,'model'=>$iSC]);
	}

	public function actionGetScanLog()
	{
		$id = $_GET['id'];
		$sid = $_GET['sid'];
		$filtersForm=new FiltersForm;
		$iSC = ImparcelScanCheck::model()->findByPk($id);
		$provide = [];
		foreach ($iSC->mdata as $key => $value) {
			if($sid==$value['id'])
			{
				$this->render('get_scan_check_log',['scanLog'=>json_decode($value['scanLog'],true)]);
			}
		}
	}
	
