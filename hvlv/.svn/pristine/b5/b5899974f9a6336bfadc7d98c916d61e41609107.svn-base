	public function actionCopyRef($id)
	{
		$model = $this->loadModel($id);
		if (empty($_POST)) {
			$this->render('confirm', ['title' => 'Copy Ref - ' . $model->no]);
		} else {
			$sql = 'UPDATE shipment SET ref = hbn WHERE ref = "" AND consol_id = :cid';
			Yii::app()->db->createCommand($sql)->bindValues([':cid' => $id])->execute();
			$this->ajaxResult($model);
		}
	}

	public function actionLocalArrival($id)
	{
		$model = $this->loadModel($id);
		if (empty($_POST)) {
			$this->render('confirm', ['title' => 'Set Local Arrival - ' . $model->no]);
		} else {
			$transaction=Yii::app()->db->beginTransaction();
			try {
				foreach ($model->shipments as $shipment) {
					if (in_array($shipment->status, [10, 25, 30])) {
						$shipment->mdata['old_status'] = $shipment->status;
						$shipment->status = 42;
						$shipment->update(['meta', 'status']);
					}
				}
				$transaction->commit();
			} catch (Exception $ex) {
				$transaction->rollback();
				throw new CHttpException(500, 'Failed save to DB!');
			}
			$this->ajaxResult($model);
		}
	}


