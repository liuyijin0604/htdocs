	public function actionD2zManifest($id)
	{
		$cn = $this->loadModel($id);

		$ss = [];
		foreach ($cn->shipments as $s) {
			if (!empty($s->trans) && $s->trans[0]->org_id == 1426 && empty($s->trans[0]->mdata['oid']) && ($s->cbwf&ImParcel::CBWF_DIRECT_CONSOL_BASE) == 0) {
				if ($s->getOutPkg() > 0 && in_array($s->status, ImParcel::$allow_manifest_states)) {
					// $s->manifestD2zLabel();
					$ss[] = $s;
				}
			}
		}

		if (!empty($ss)) {
			$r = $this->doD2zManifest($ss, $cn);
			if($r === true){
				if(empty($cn->mdata['d2zsent'])){
					$cn->mdata['d2zsent'] = 1;
					$cn->custom_log_note = 'D2Z Manifested';
					$cn->updateMeta();
				}
				echo 'done';
			}else{
				echo 'D2Z manifest error: '.json_encode($r);
			}
		}
	}

	public function doD2zManifest($sst, $consol)
	{
		$d2z = new D2zShipAPI('auto');
		$max_ppg = 500;
		$pgs = ceil(count($sst) / $max_ppg);

		for($pg = 0; $pg < $pgs; $pg++){
			$shipments = array_slice($sst, $pg * $max_ppg, $max_ppg);
			// fix d2z use reserved connote number range
			foreach ($shipments as $shipment) {
				if ($shipment->trans[0]->status == 10) $needCreate[] = $shipment;
			}
			if (!empty($needCreate)) $result = $d2z->createConsignments($needCreate, true);
			$result = $d2z->allocate_shipments($shipments, $consol->no);
			if (!empty($result['responseMessage']) && in_array($result['responseMessage'], ['Shipment allocation Successful', 'Shipment Allocated Successfully'])) {
				$transaction=Yii::app()->db->beginTransaction();
				try {
					foreach ($shipments as $s) {
						$ts = Tranship::model()->find('pid = :id', [':id' => $s->id]);
						$ts->mdata['oid'] = Org::ORGID_COURIER_D2Z;
						$ts->save();
					}
					$transaction->commit();
				} catch (Exception $ex) {
					$transaction->rollback();
					throw $ex;
				}
			} else {
				return $result;
			}
		}
		return true;
	}
