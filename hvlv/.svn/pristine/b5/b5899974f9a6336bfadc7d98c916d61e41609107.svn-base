	public function actionExportAout($id)
	{
		$model=$this->loadModel($id);
		$csv = [];
		$csv[]='MAWB:,'.(empty($model->awb)?$model->no:$model->awb);
		$csv[]='ETD:,'.$model->etd.',ETA:,'.$model->eta;
		$csv[]='WEIGHT:,'.(empty($model->mdata['awb_wt'])?'':$model->mdata['awb_wt']).',CHARGEABLE WEIGHT:,'.(empty($model->mdata['cgb_wt'])?'':$model->mdata['cgb_wt']);
		$csv[]='Airline:,'.$model->airline.',Flight No:,'.$model->flight;
		$csv[]='POL:,'.$model->pol.',POD:,'.$model->pod;
		$csv[]='';
		$csv[] = 'ConsignmentRef,Tracking,Status,ScannedDateTime,Count,Manifested';
		foreach ($model->shipments as $s) {
			//Check multiple packs
			if ($s->status==100) {
				continue;
			}
			$csv[] = '="'.$s->hbn.'",="'.$s->ref.'",'.($s->status<=55? 'Held' : 'Clear').','.(empty($s->getScanTime())?'':date('Y-m-d', strtotime($s->getScanTime()))).','.$s->getOutPkg().','.$s->pkg;
		}
		header("Cache-Control: maxage=1");
		header("Content-type: text/csv");
		header("Content-Disposition: attachment; filename=outturn_".date('YmdHis').".csv");

		echo implode("\n", $csv);
	}
		
	public function actionCusout($id)
	{
		$model=$this->loadModel($id);
		$agent_ships=[];
		$select_agent='';
		foreach ($model->shipments as $s) {
			$agent_ships[$s->agent_id][]=$s;
		}

		if (!empty($model->mdata['owner_id'])) {
			$select_agent=$model->mdata['owner_id'];
		}

		if(empty($model->mdata['cusout_sent'])){
			$model->mdata['cusout_sent'] = 1;
			$model->update(['meta']);
		}
		$imConsolService = new ImConsolService();
		$tempDirectory = Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR.'zip'.time();
		if (!file_exists($tempDirectory)) {
			mkdir($tempDirectory);
		}
		foreach ($agent_ships as $org_id=>$ships){
			$filenames = [];
			$csv = [];
			$xsl=new oExcel();
			$i=1;
			if ($org_id==$select_agent){
				$csv[]='MAWB:,'.(empty($model->awb)?$model->no:$model->awb);
				$csv[]='ETD:,'.$model->etd.',ETA:,'.$model->eta;
				$csv[]='WEIGHT(KG):,'.(empty($model->mdata['awb_wt'])?'':$model->mdata['awb_wt']).',CHARGEABLE WEIGHT(KG):,'.(empty($model->mdata['cgb_wt'])?'':$model->mdata['cgb_wt']);
				$csv[]='Airline:,'.$model->airline.',Flight No:,'.$model->flight;
				$csv[]='POL:,'.$model->pol.',POD:,'.$model->pod;
				$csv[]='';
				if(is_array($csv[0]))
				{
					$xsl->addRow($i++,$csv[0]);
				}else
				{
					$xsl->addRow($i++,[$csv[0]]);
				}
			}
			$xsl->addRow($i++, ['ConsignmentRef','Tracking','Status','ScannedDateTime','Count','Manifested','Damage','Damage img']);
			foreach ($ships as $s) {
				if($s->status==100)
				{
					continue;
				}

				$row = [$s->hbn,$s->ref,($s->status<=55? 'Held' : 'Clear'),(empty($s->getScanTime())?'':date('Y-m-d', strtotime($s->getScanTime()))),$s->getOutPkg(),$s->pkg,@$s->mdata["damaged_packs"]];
				$thisFiles=ImParcelService::getImParcelDamageFile($s);
				foreach ($thisFiles as $key => $thisFile) {
					$row[] = $thisFile;
				}
				$xsl->addRow($i++, $row);
			}

			$noStr = $model->no;
			if($model->isWDT())
			{
				$parentShipment = $model->shipments[0]->getParentShipment();
				if(!empty($parentShipment))
				{
					$noStr = $parentShipment->ref;
				}
			}
			$fileName=$tempDirectory.DIRECTORY_SEPARATOR.'TLA_'.$org_id.'_'.$noStr.'.xls';
			$BagTagFile = $imConsolService->getConsolBagTagsPrint($id,$tempDirectory,true);
			if(!empty($BagTagFile))
			{
				$filenames[] = $BagTagFile;
			}
			$xsl->output($fileName, null, false);
			$filenames[] = $fileName;
			$emailLog = new Emailog();
			$emailLog->type = Emailog::OUTTURN_REPORT;
			$emailLog->fid = $id;
			$emailLog->dt = date('Y-m-d H:i:s');
			$emailLog->to_id = $org_id;
			$emailLog->status = 10;
			$emailLog->prepTemplate();

			$emailLog->subject = $emailLog->tpl->subject;
			$emailLog->body = $emailLog->tpl->getContent();
			if (empty($emailLog->scheduled)) {
				$emailLog->imConsolSend($filenames);
			}
		}
		AppHelper::unlinkRecursive($tempDirectory);
		$this->ajaxResult($model, ['id'], 'Email Sent Successfully');
	}

	public function actionExportApLodge($id)
	{
		$model=$this->loadModel($id);
		$xls = new oExcel;
		$i = 1;
		$xls->setColWidth([15,15,15,15,10,10,10,20,15,10]);
		$xls->addRow($i++, ['Lodgement Summary Report']);
		$xls->setFont('A1:H1', ['bold' => true]);
		$xls->centerAlignment('A1');
		$xls->mergeCells('A1:H1');
		$xls->addRow($i++, ['Customer Name:', '', 'Target Media Australia P/L',]);
		$xls->addRow($i++, ['Customer\'s Address:', '', 'GPO Box 268 ST PETERS NSW 2044',]);
		$xls->addRow($i++, ['Merchant ID:', '', '="20289181"',]);
		$xls->addRow($i++, ['Merchant Location ID:', '', 'AMQ',]);
		$xls->addRow($i++, ['Australia Post Account Number: ', '', '="6081844"',]);
		$xls->addRow($i++, ['Lodgement Facility:', '', '271812 ALEXANDRIA BUSINESS HUB DWS',]);
		for ($j = 2; $j < 8; $j++) {
			$xls->mergeCells('A'.$j.':B'.$j);
			$xls->mergeCells('C'.$j.':E'.$j);
		}
		$i++;
		$xls->addRow($i++, ['Manifest No.', 'Connote', 'Ref 1', 'Ref 2', 'Articles', 'Weight (kg)', 'Post Code', 'Created', 'Status', 'Scanned']);
		$ta = 0;
		$tw = 0;
		foreach ($model->shipments as $s) {
			$ts = $s->trans[0];
			$xls->addRow($i++, [$ts->mdata['oid'], $s->ref, $s->hbn, '="'.$s->cref.'"', $s->pkg, $s->weight, '="'.$s->postcode.'"', $ts->time, $s->getStatus(), $s->getOutPkg()]);
			$ta += $s->pkg;
			$tw += $s->weight;
		}
		$xls->addRow($i++, ['Total', '', '', '', $ta, $tw, '', '']);
		$xls->output($model->no.'_lodgement_manifest.xlsx');
	}

	/**
	 * export toll lodgement manifest
	 * @param $id
	 * @throws CHttpException
	 */
	public function actionExportTollApLodge($id)
	{
		$model=$this->loadModel($id);
		$ps = [];


		$tollMatches = '/^'. TollAPI::TOLL_SLID .'\d{7}|^'. TollAPI::TOLL_SLID .'\d{6}/';
		$tollMatches2 = '/^'. TollAPI::TOLL_SLID_OFFPEAK .'\d{7}|^'. TollAPI::TOLL_SLID_OFFPEAK .'\d{6}/';
		foreach ($model->shipments as $s) {
			if (preg_match($tollMatches, $s->ref) || preg_match($tollMatches2, $s->ref)) {
				if (isset($s->trans[0]) && !empty($s->trans[0])) { // only for shipments which has been post to Toll side successfully
					$ps[] = $s;
				}
			}
		}
		oPDF::renderPDF('label_manifest-A4', ['tpl' => '_label-manifest-toll', 'rs' => $ps,'model' => $model], 1, $model->no.'_toll_lodgement_manifest.pdf');
	}

	public function actionCitoDeliveryMethod($id)
	{
		$model=$this->loadModel($id);
		$xls = new oExcel;
		$i = 1;
		$xls->addRow($i++, ['CONNOTE NO.','REFERENCE','WEIGHT','VOLUME','PCS','ADDRESS','Delivery Method','Barcodes']);
		foreach ($model->shipments as $s) {
			$trans = $s->trans;
			$courier = '';
			$barcode = '';
			if(!empty($trans))
			{
				$ts = end($trans);
				$t = $ts->infoLink();
				$courier = explode(':', $t)[0];
				$barcode = $s->getParcelBarcode($ts->org_id);
				if(!empty($barcode))
				{
					if($barcode[0]!=$p->ref)
					{
						$barcode = join(',',$barcode);
					}
				}
			}
			$xls->addRow($i++, [$s->hbn,$s->ref,$s->weight,$s->getTotalCBM(),$s->pkg,$s->cnee->address,$courier,$barcode]);
		}
		$xls->output($model->awb.'_delivery_method.xlsx');
	}


	/**
	 * @param $id
	 * @throws CHttpException
	 */
	public function actionExportStartrackApLodge($id)
	{
		$model = $this->loadModel($id);

		// get order ID firstly
		$orderIds = [];
		foreach ($model->shipments as $s) {
			if (preg_match('/^7RFZ\d{8}/', $s->ref) && !empty($s->trans)) {
				foreach ($s->trans as $tranship) {
					if (!empty($tranship->mdata['oid'])) {
						$orderId = $tranship->mdata['oid'];
						if (!isset($orderIds[$orderId])) {
							$orderIds[$orderId] = $orderId;
						}
					}
				}
			}
		}

		if (!empty($orderIds)) {
			$api = new StarTrackAPI('syd', true);
			$api->getOrderSummary($orderIds);
		} else {
			$model->addError('id', 'No any StarTrack order found!');
			$this->ajaxResult($model);
		}
	}
