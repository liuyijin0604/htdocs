					$item->tracking_details['article_id'] = $aid.AusPostAPI::aidChkDgt($aid);
					$item->tracking_details['barcode_id'] = '019931265099999891'.$item->tracking_details['article_id'].'|420'.$d->to->postcode.'|8008'.date('ymdHis');
				}
				$shipments[substr($s->ref, 0, 5)][] = $d;
			}
		}

		include_once('PHPMailer/class.phpmailer.php');
		$mail = new PHPmailer();
		$mail->CharSet = "UTF-8";
		$mail->IsHTML(true);
								
		/***************SMTP*********/
		$mail->isSMTP(); // Set mailer to use SMTP
		$mail->Host = 'mail.toplogistics.com.au'; // Specify main and backup SMTP servers
		$mail->SMTPSecure = 'tls'; // Enable TLS encryption, `ssl` also accepted
		$mail->Port = 587; // TCP port to connect to
		$mail->SMTPAuth = true; // Enable SMTP authentication
		$mail->Username = 'imports@toplogistics.com.au'; // SMTP username
		$mail->Password = 'mxK+fU$n&LDK';
		/***************SMTP*********/
		$mail->From     = 'imports@toplogistics.com.au';
		$mail->FromName = 'Imports';
		$mail->Subject  = 'LMA Manifest';
		$mail->Body = 'Please find attached manifest.';
		$addrs = [
			'michelle@toplogistics.com.au'
		];
		foreach ($addrs as $add) {
			$mail->AddAddress($add);
		}
		foreach($shipments as $k=>$d){
			$mail->AddStringAttachment(json_encode($d), $k.'_'.date('YmdHis') . '.json', 'base64', 'application/json');
		}
		$mail->Send();
	}

	public function actionTntManifest($id)
	{
		$cn=$this->loadModel($id);
		$err=[];
		$ss=['syd' => [], 'mel' => [], 'bne' => [],'syd_top'=>[],'mel_top'=>[],'per_top'=>[]];//manifest shipments;
		foreach ($cn->shipments as $s) {
			if (preg_match("/^(DKC|PCD|BPC|LMA|TLS|TBC|LPC)\d{9}$/i", $s->ref)&&empty($s->trans)&&($s->cbwf&ImParcel::CBWF_DIRECT_CONSOL_BASE)==0) {
				if (($s->getOutPkg() > 0 && in_array($s->status, ImParcel::$allow_manifest_states)) || $cn->owner_id == Org::ORGID_CLIENT_TLA) {
					if(preg_match("/^DKC\d{9}$/i", $s->ref)){
						$ss['syd'][] = $s;
					}else if(preg_match("/PCD\d{9}/i", $s->ref)){
						$ss['mel'][] = $s;
					}else if(preg_match("/BPC\d{9}/i", $s->ref)){
						$ss['bne'][] = $s;
					}else if(preg_match("/TLS\d{9}/i", $s->ref)){
						$ss['syd_top'][] = $s;
					}else if(preg_match("/LMA\d{9}/i", $s->ref)){
						$ss['mel_top'][] = $s;
					}else if(preg_match("/TBC\d{9}/i", $s->ref)){
						$ss['bne_top'][] = $s;
					}else if(preg_match("/LPC\d{9}/i", $s->ref)){
						$ss['per_top'][] = $s;
					}
				}
			}
		}

		foreach($ss as $o => $oss){
			if(empty($oss)) continue;
			$tnt= TntAPI::getTntInterface($o);
			if ($tnt->preEt12File($oss)) {
				if(empty($cn->mdata['tntsent'])){
					$cn->mdata['tntsent'] = 1;
					$cn->custom_log_note = 'TNT Manifested';
					$cn->updateMeta();
				}
			} else {
				$err[] = "TNT manifest Failed";
			}
		}

		if(empty($err)){
			if(!empty($ss['mel'])||!empty($ss['syd'])){
				ImcoConsol::updateImportConsoleBilling([$id]);
			}
			echo 'done';
		}else{
			echo implode(";", $err);
		} 
	}

	public function actionHunterManifest($id)
