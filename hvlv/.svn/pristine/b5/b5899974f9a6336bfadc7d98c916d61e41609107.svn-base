	public function actionAirout($id)
	{
		$model=$this->loadModel($id);
		if(!empty($model)){
			$model->mdata['isclickunpack']=1;
			$model->save();
		}
		$icsService = new IcsService();
		$hasLetter=false;
		$errors = $icsService->airout($id,null,$hasLetter);
		if(empty($errors)) echo "Airout Done!";
		ob_start();
		$this->actionAupost($id);
		$this->actionFastway($id);
		$this->actionStartrack($id, true);
		$this->actionTollpost($id, true);
		//$this->actionD2zCountryManifest($id); 2019-05-14 Gero add
		$this->actionTntManifest($id);
		$this->actionHunterManifest($id);
		//$this->actionD2zManifest($id);
		//$this->actionDfeManifest($id);
		$this->actionSFManifest($id);
		$this->actionUbiTollManifest($id);
		$this->actionEizTollManifest($id);
		$this->actionBorderManifest($id);
		$this->actionFLHunterManifest($id);
		// $this->actionHvlvJavaManifest($id);

		$kk =  ob_get_contents();
		ob_end_clean();
		$rt = str_replace('done', '', $kk);
		echo implode('</br>',$errors);
		if(!empty($rt))
		{
			echo $rt;
		}
		if ($hasLetter) $this->actionEmps($id);
	

		if (!empty($_GET['to_cus']) && $_GET['to_cus'] == 'true') {
			$this->actionCusout($id);
		}
	}


	public function actionHvlvJavaManifest($id)
	{
		$cn = $this->loadModel($id);
		$imConsolService = new ImConsolService();
		$err=[];
		$ss=[];
		foreach ($cn->shipments as $s) {
			if (!empty($s->trans)) 
			{
				$trans = $s->trans;
				$tran = end($trans);
			  if ($tran->connote==$s->ref&&empty($tran->mdata['non_manifest'])&&!isset($tran->mdata['oid'])&&!empty($tran->mdata['java_gen'])) { // if upload manifest before, we don't send again
			  	if((in_array($s->status, ImParcel::$allow_manifest_states)&&$s->getOutPkg() > 0)|| $cn->owner_id == Org::ORGID_CLIENT_TLA)
				{
				  	$ss[] = $s;
				}
			  }
		  	}
		}
		$max_ppg = 300;
		$pgs = ceil(count($ss) / $max_ppg);

		for($pg = 0; $pg < $pgs; $pg++){
			$shipments = array_slice($ss, $pg * $max_ppg, $max_ppg);
			$err = array_merge($err, $imConsolService->doHvlvJavaManifest($shipments));
		}

		//$err = $imConsolService->doUbiManifest($ss);
		if(!empty($ss)){
			if (empty($err)) {
				ImcoConsol::updateImportConsoleBilling([$id]);
				if(empty($cn->mdata['javasent'])){
					$cn->mdata['javasent'] = 1;
				}

				$cn->custom_log_note = 'MY Allied Manifested';
				$cn->updateMeta();
				echo 'done!';
			} else {
				Emailog::sendEmailTo($cn->getNoticeEmail(), "My Allied ".$cn->no." ".join(",",$err), $cn->no." MY Allied Manifest ERROR");
				echo implode('<br />', $err);
			}
		}
	}


