<?php

class ImcoConsolController extends Controller
{
	protected $nonAjax=['export','emps', 'eparcel', 'sac', 'msac','email', 'ap_manifest', 'cp_manifest','exportAddressReport','exportAddressManifestReport', 'exportAout','exportStartrackApLodge' ,'exportApLodge','exportTollApLodge','download','printAllLabels','exportHeldShipments','seaManifest','exportShipmentDetail','exportStartrackMelApLodge','seaOutturnShipments', 'storageLabel', 'd2zAutomation', 'blueAutomation', 'gvAutomation', 'webMation','seaDeliveryOrderTogether','exportCargoReceipt','dgDocument','printBagTags','seaDOShipments','groupedDeliveryOrders','exportDFEShipment','citoDeliveryMethod','importImcoConsol','exportCurrentSearch'];

	/**
	 * Displays a particular model.
	 * @param integer $id the ID of the model to be displayed
	 */
	public function actionView($id)
	{
		$this->render('view', [
			'model'=>$this->loadModel($id),
		]);
	}

	public function actionMissingAccrual()
	{
		$model = new ImcoConsol('search');
		$criteria = new CDbCriteria;
		//  $criteria->condition =  "created <= '" . date('Y-m-d',strtotime('-30 days')) ."' and `no` not in ( select billing_ref from billing_line where type = " . BillingLine::BILLING_TYPE_IMPORT . ")";
		$criteria->condition =  "created >= '2017-07-01' AND `no` not in ( select billing_ref from billing_line where type = " . BillingLine::BILLING_TYPE_IMPORT . ")";


		$modeldp =  new CActiveDataProvider($model, [
			'criteria'=>$criteria,
			'sort'=>[
				'defaultOrder'=>'t.id DESC',
			],
			'pagination'=>[
				'pageSize' => 30,
			]
		]);

		$this->render('missing_accrual_list', ['modeldp' => $modeldp,'model' => $model]);
	}

	/**
	 * show cost validation by console
	 */
	public function actionCostv()
	{
		$model = new ImcoConsol('search');
		$model->unsetAttributes();  // clear any default values

		$this->render('cost_validation', [ 'model' => $model]);
	}
		
	/**
	 * consol Management
	 */
	public function actionConsolManagement()
	{
		if (!empty($_GET['delivery_type'])) {
			switch ($_GET['delivery_type']) {
				case 10: $typeName="Air Consol";
						$type="Air";
						break;
				case 20: $typeName="Sea Consol";
						$type='Sea';
						break;
			}
			$provide[]=['id'=>10,'consol_type'=>'15','type'=>'Consol ('.$type.')'];
			$provide[]=['id'=>20,'consol_type'=>'70','type'=>'Direct Consol ('.$type.')'];
			$dataprovider=new CArrayDataProvider($provide);
			$dataprovider->pagination=false;
			$this->render('consol_manage_search', ['typeName'=>$typeName,'dataprovider'=>$dataprovider]);
			return;
		}
		$this->render('consol_manage');
	}

	/**
	 * Creates a new model.
	 * If creation is successful, the browser will be redirected to the 'view' page.
	 */
	public function actionCreateManif()
	{
		$model = new ImcoConsol;

		// Uncomment the following line if AJAX validation is needed
		// $this->performAjaxValidation($model);

		if (isset($_POST['ImcoConsol'])) {
			if (empty($_POST['recs'])) {
				$model->addError('awb', 'Please select shipments');
			} else {
				$model->attributes=$_POST['ImcoConsol'];
				$model->status = 10;
				$model->save();
				$agentIds = [];
				foreach ($_POST['recs'] as $m) {
					$man = Manifest::model()->findByPk($m);
					$man->status = 20;
					$man->save();
					$man->genInvoice();
					foreach ($man->rec_shipments as $p) {
						$p->consol_id = $model->id;
						$p->status = 30;
						$p->save();
						$agentId[$p->agent_id] = $p->agent_id;
					}
				}

				foreach ($agentIds as $key => $agentId) {
					$agt = Org::model()->findByPk($agentId);
					if(!empty($agt->extra['cod_account']))
					{
						$agt->extra['lock_account'] = 1;
						$agt->save();
						$model->addError('COD Warning', "Consol Created, COD Account Requiring Generate Invoice Please Contact Accounting");
					}

				}

			}
			$this->ajaxResult($model, ['id']);
		}

		$this->render('create_manif', [
			'model'=>$model,
		]);
	}
		
	/**
	 *
	 */
	public function actionGetConsolClientName()
	{
		$model= ImcoConsol::model()->find('no=:no', [':no'=>trim($_GET['consol_no'])]);
		$orgIds=array_keys($model->getOrgsInfo());
		$orgIds=$orgIds+[0];
		$ids= implode(",", $orgIds);
		//                    echo $ids;
		$rs = Org::model()->findAll([
			'condition' => '(id LIKE :n OR name LIKE :n) AND id in('.$ids.')',
			'params'=>  [':n' => '%'.$_GET['term'].'%',],
			'order' => 'code',
			'limit' => 20,
		]);
		$a = [];
		foreach ($rs as $r) {
			$a[] = [
				'value' => $r->id,
				'label' => $r->name
			];
		}
		echo json_encode($a);
	}
	public function actionCreateShips()
	{
		$model = new ImcoConsol;
		$errors=[];

		// Uncomment the following line if AJAX validation is needed
		// $this->performAjaxValidation($model);

		if (isset($_POST['ImcoConsol'])) {
			if (empty($_POST['hbns'])&&empty($_POST['putcodes'])) {
				$model->addError('awb', 'Please select shipments or putcodes');
			} else {
				//before create consol, we need to check if all the if all the shipments exits;
				$selected_services=[];
				$ignore_depot = empty($_POST['ignore_depot'])?0:1;
				foreach (preg_split('/[\n\r]+/', trim($_POST['hbns'])) as $h) {
					if (preg_match('/[\t ]+/', $h)) {
						$ts = preg_split('/[\t ]+/', $h);
						$h = trim($ts[0]);
					}
					$p = ImParcel::model()->find(['condition'=>'(hbn = :h OR ref = :h) AND (cbwf&:cbwf)=0 AND status != 100', 'params'=>[':h' => $h,':cbwf'=> ImParcel::CBWF_D2Z_CONSOL_NOT_FOR_SCAN],'order'=>'id desc']);
					$model->checkImparcel($p,$errors, $selected_services,$h,$_POST['ImcoConsol']['dpt_id'],$ignore_depot);
				}

				if(!empty(trim($_POST['putcodes'])))
				{
					foreach (preg_split('/[\n\r]+/', trim($_POST['putcodes'])) as $putcode) {
						if (preg_match('/[\t ]+/', $putcode)) {
							$ts = preg_split('/[\t ]+/', $putcode);
							$putcode = trim($ts[0]);
							$wt = trim($ts[1]);
						}
						$izsObj = ImportZwStorage::model()->find("putcode = :putcode or pcano = :putcode",[":putcode"=>$putcode]);
						if(empty($izsObj))
						{
							$errors[] = 'putcode'.$putcode.'not exist';
							continue;
						}
						$relations = $izsObj->relations;
						if(empty($izsObj))
						{
							$errors[] = 'putcode'.$putcode.'shipments not exist';
						}
						foreach ($relations as $key => $r) {
							$model->checkImparcel($r->imParcel,$errors, $selected_services,$r->imParcel->hbn,$_POST['ImcoConsol']['dpt_id'],$ignore_depot);
						}
					}
				}
				//two step
				// 1. clear, air, delivery check
				// 2. di
				//var_dump($selected_services);
				if (sizeof($selected_services)>=1) {
					asort($selected_services);
					$selected_services= array_reverse($selected_services, true);
					$the_service=key($selected_services)-(key($selected_services)&32);
					if (isset($_POST['selected_service'])) {
						foreach ($_POST['selected_service'] as $select) {
							$the_service=$the_service|$select;
						}
					}
					foreach (preg_split('/[\n\r]+/', trim($_POST['hbns'])) as $h) {
						if (preg_match('/[\t ]+/', $h)) {
							$ts = preg_split('/[\t ]+/', $h);
							$h = trim($ts[0]);
						}
						$p = ImParcel::model()->find(['condition'=>'(hbn = :h OR ref = :h) AND status != 100', 'params'=>[':h' => $h],'order'=>'id desc']);
						$model->checkServiceErrors($p,$the_service,$errors,$h);
					}
					
					if(!empty(trim($_POST['putcodes'])))
					{
						foreach (preg_split('/[\n\r]+/', trim($_POST['putcodes'])) as $putcode) {
							if (preg_match('/[\t ]+/', $putcode)) {
								$ts = preg_split('/[\t ]+/', $putcode);
								$putcode = trim($ts[0]);
								$wt = trim($ts[1]);
							}
							$izsObj = ImportZwStorage::model()->find("putcode = :putcode or pcano = :putcode",[":putcode"=>$putcode]);
							if(empty($izsObj))
							{
								$errors[] = 'putcode'.$putcode.'not exist';
								continue;
							}
							$relations = $izsObj->relations;
							if(empty($izsObj))
							{
								$errors[] = 'putcode'.$putcode.'shipments not exist';
							}
							foreach ($relations as $key => $r) {
								$model->checkServiceErrors($r->imParcel,$the_service,$errors,$r->imParcel->hbn);
							}
						}
					}

				}
				if (!empty($errors)) {
					$model->addError('shipment', implode(';', $errors));
					$this->ajaxResult($model);
				}

				$model->attributes=$_POST['ImcoConsol'];
				$model->status = 10;

				if (!empty($_POST['ImcoConsol']['mdata'])) {
					foreach ($_POST['ImcoConsol']['mdata'] as $k=>$v) {
						$model->mdata[$k] = is_string($v)? trim($v) : $v;
					}
				}


				$model->save();
				$agentIds = [];
				$transaction=Yii::app()->db->beginTransaction();
				try {
					foreach (preg_split('/[\n\r]+/', trim($_POST['hbns'])) as $h) {
						if (preg_match('/[\t ]+/', $h)) {
							$ts = preg_split('/[\t ]+/', $h);
							$h = trim($ts[0]);
							$wt = trim($ts[1]);
						}
						$p = ImParcel::model()->find(['condition'=>'(hbn = :h OR ref = :h) AND cbwf&:cbwf=0  AND status != 100', 'params'=>[':h' => $h,':cbwf'=> ImParcel::CBWF_D2Z_CONSOL_NOT_FOR_SCAN],'order'=>'id desc']);
						$model->putImparcelIntoConsol($p,@$wt);
						$agentIds[$p->agent_id] =$p->agent_id;
					}

					if(!empty(trim($_POST['putcodes'])))
					{
						foreach (preg_split('/[\n\r]+/', trim($_POST['putcodes'])) as $putcode) {
							if (preg_match('/[\t ]+/', $putcode)) {
								$ts = preg_split('/[\t ]+/', $putcode);
								$putcode = trim($ts[0]);
								$wt = trim($ts[1]);
							}
							$izsObj = ImportZwStorage::model()->find("putcode = :putcode or pcano = :putcode",[":putcode"=>$putcode]);
							if(empty($izsObj))
							{
								$errors[] = 'putcode'.$putcode.'not exist';
								continue;
							}
							$relations = $izsObj->relations;
							if(empty($izsObj))
							{
								$errors[] = 'putcode'.$putcode.'shipments not exist';
							}
							foreach ($relations as $key => $r) {
								$model->putImparcelIntoConsol($r->imParcel,@$wt);
							}
						}
					}
					$transaction->commit();
				} catch (Exception $ex) {
					$transaction->rollback();
					throw $ex;
				}
			}

			foreach ($agentIds as $key => $agentId) {
				$agt = Org::model()->findByPk($agentId);
				if(!empty($agt->extra['cod_account']))
				{
					$agt->extra['lock_account'] = 1;
					$agt->save();
					$model->addError('COD Warning', "Consol Created, COD Account Requiring Generate Invoice Please Contact Accounting");
				}
			}


			$this->ajaxResult($model, ['id']);
		}
		$this->render('create_ships', [
			'model'=>$model,
		]);
	}

	public function actionHeldAllShipments($id)
	{
		$model = $this->loadModel($id);
		if (empty($_POST)) {
			$this->render('confirm', ['title' => 'Held All Shipments - ' . $model->no]);
		} else {
			$shipments = $model->shipments;
			if(empty($shipments))
			{
				$model->addError("Empty Shipments","Empty Shipments");
				$this->ajaxResult($model);
				return;
			}
			$checkCanHandle = false;

			$transaction=Yii::app()->db->beginTransaction();
			try
			{
				foreach ($shipments as $key => $shipment)
				{
					if(in_array($shipment->status, [ImParcel::NEW_STATUS,ImParcel::STATE_DISPATCHED,ImParcel::STATE_RECEIVED,ImParcel::STATE_MANIFESTED,ImParcel::STATE_SEA_ARRIVAL,ImParcel::STATE_AIR_ARRIVAL]))
					{
//					$edimsg = Edimsg::model()->count("fid = :fid and type = 'CARST'",[":fid"=>$shipment->id]);
//						if(!empty($edimsg))
//						{
//							continue;
//						}

						$shipment->mdata['old_status'] = $shipment->status;
						$shipment->status = ImParcel::STATE_HELD;
						$shipment->update(['meta', 'status']);
					}
				}
				$transaction->commit();
			} catch (Exception $ex) {
				$transaction->rollback();
				throw $ex;
			}

			$this->ajaxResult($model);
		}
		
	}


	public function actionWhHeldAllShipments($id)
	{
		$model = $this->loadModel($id);
		if (empty($_POST)) {
			$this->render('confirm', ['title' => 'WH Held All Shipments - ' . $model->no]);
		} else {
			$shipments = $model->shipments;
			if(empty($shipments))
			{
				$model->addError("Empty Shipments","Empty Shipments");
				$this->ajaxResult($model);
				return;
			}
			$checkCanHandle = false;

			$transaction=Yii::app()->db->beginTransaction();
			try
			{
				foreach ($shipments as $key => $shipment)
				{
					if(in_array($shipment->status, [ImParcel::STATE_CLEAR_WAIT,ImParcel::STATE_CLEAR]))
					{
						$shipment->mdata['old_status'] = $shipment->status;
						$shipment->status = ImParcel::STATE_WH_HELD;
						$shipment->update(['meta', 'status']);
					}
				}
				$transaction->commit();
			} catch (Exception $ex) {
				$transaction->rollback();
				throw $ex;
			}

			$this->ajaxResult($model);
		}
		
	}

	public function actionWhReleaseAllShipments($id)
	{
		$model = $this->loadModel($id);
		if (empty($_POST)) {
			$this->render('confirm', ['title' => 'WH Release All Shipments - ' . $model->no]);
		} else {
			$shipments = $model->shipments;
			if(empty($shipments))
			{
				$model->addError("Empty Shipments","Empty Shipments");
				$this->ajaxResult($model);
				return;
			}
			$checkCanHandle = false;

			$transaction=Yii::app()->db->beginTransaction();
			try
			{
				foreach ($shipments as $key => $shipment)
				{
					if(in_array($shipment->status, [ImParcel::STATE_WH_HELD]))
					{
						$shipment->status = $shipment->mdata['old_status'];
						$shipment->update(['status']);
					}
				}
				$transaction->commit();
			} catch (Exception $ex) {
				$transaction->rollback();
				throw $ex;
			}

			$this->ajaxResult($model);
		}
		
	}

	public function actionUpdateByNo($no)
	{

		// check to see if it is direct consol number
		$tabid = isset($_GET['tabid']) ? $_GET['tabid'] : 0;
		if (substr($no, 0, 2) == 'DW') {
			$this->redirect($this->createUrl('dmawbConsol/updateByNo', ['no' => $no,'tabid' => $tabid]));
			return;
		}

		if (substr($no, 0, 2) == 'EL') {
			$this->redirect($this->createUrl('elmsConsol/updateByNo', ['no' => $no,'tabid' => $tabid]));
			return;
		}

		$consol = ImcoConsol::model()->find('no = :no', [':no' => $no]);
		if (!empty($consol)) {
			$this->actionUpdate($consol->id);
		} else {
			throw new CHttpException(404, 'The requested page does not exist.');
		}
	}

	/**
	 * Updates a particular model.
	 * If update is successful, the browser will be redirected to the 'view' page.
	 * @param integer $id the ID of the model to be updated
	 */
	public function actionUpdate($id)
	{
		$model=$this->loadModel($id);
		$shadow=$this->loadModel($id);
		if(!empty($_GET['shadow_id']))// this consol may be a shadow consol
		{
			$shadow = $this->loadModel($_GET['shadow_id']);
		}

		$model = $model->getReal();
		$imconsolService = new ImConsolService();
		// Uncomment the following line if AJAX validation is needed
		// $this->performAjaxValidation($model);
		//                Currency::updateExrate();

		if (!empty($_POST)) {
			$model = $shadow;
			//if update unpackingDate then send email to customer
			if(empty($_POST['mdata']['ContainerUnloadDate'])){
				unset($model->mdata['ContainerUnloadDate']);
			}elseif($model->mdata['ContainerUnloadDate']!=$_POST['mdata']['ContainerUnloadDate']){
				if(strtotime($_POST['mdata']['ContainerUnloadDate'])<=strtotime(date('Y-m-d',strtotime("3 day")))){
					$imconsolService->sendB2BBookingNotice($id);
					$model->mdata['isSendPreBookingEmail']=1;
				}
				// if update ContainerUnloadDate than set ignore_scan now only b2b
				if($model->mdata['ContainerUnloadDate']!=$_POST['mdata']['ContainerUnloadDate'] && !empty($_POST['mdata']['ContainerUnloadDate'])){
					if(!empty($model->shipments)){
						foreach($model->shipments as $shipment){ 
							if($shipment->checkIsCargoProcessWithRef()){
								if($shipment->isB2bShipment()){
									$modelCargoProcess = CargoProcess::model()->find('shipment_id=:shipment_id',[':shipment_id'=>$this->id]);
									if(empty($modelCargoProcess)){
										$shipment->mdata['ContainerUnloadDate'] = $_POST['mdata']['ContainerUnloadDate'];
										$shipment->mdata['cargo_ignore_scan'] = 1;
										$shipment->save();
									}else{
										if($shipment->scanCount()>0){
											$modelCargoProcess->status = CargoProcess::WAITINGASSIGNDRIVER;
											$modelCargoProcess->save();
										}
										$shipment->mdata['ContainerUnloadDate'] = $_POST['mdata']['ContainerUnloadDate'];
										$shipment->save();
									}
								}
								elseif($shipment->getPreCargoProcessType()==CargoProcess::NORMAL_CARGO && !$shipment->isParcelPickup()){
									$shipment->mdata['ContainerUnloadDate'] = $_POST['mdata']['ContainerUnloadDate'];
									$shipment->mdata['cargo_ignore_scan'] = 1;
									$shipment->save();
								}
							}
						}
					}
				}
			}

			if (!empty($_POST['mdata'])) {
				foreach ($_POST['mdata'] as $k=>$v) {
					$model->mdata[$k] = is_string($v)? trim($v) : $v;
				}
			}
			if(empty($_POST['mdata']['not_apply_org_flexible_rate'])){
				unset($model->mdata['not_apply_org_flexible_rate']);
			}
			if(empty($_POST['mdata']['blockacr'])){
				unset($model->mdata['blockacr']);
			}

			if(empty($_POST['mdata']['skip_cacr'])){
				unset($model->mdata['skip_cacr']);
			}elseif(empty($model->mdata['acr_stat']) || $model->mdata['acr_stat'] < 5){
				$model->mdata['acr_stat'] = 5;
			}
			
			if (!empty($_POST['ImcoConsol'])) {
				if (!empty($_POST['ImcoConsol']['status']) && !Acl::hasAccess('B:Export/StatusOverride')) {
					Acl::denied403();
				}
				if ($model->status < 20 && !empty($model->flight) && !empty($model->eta)) {
					$model->status = 20;
				}
								   
				// if change etd, and if the shipment already have flight dispatch tracking infor,then we need to update them
				if (!empty($_POST['ImcoConsol']['etd'])) {
					if ($model->etd!=$_POST['ImcoConsol']['etd']||$model->eta!=$_POST['ImcoConsol']['eta']) {
						$model->etd=$_POST['ImcoConsol']['etd'];
						$model->eta=$_POST['ImcoConsol']['eta'];
						$model->mdata['updatedEtd']=1;
						if(strtotime($model->etd)>=strtotime(date('Y-m-d')))
						{
							$model->mdata['updateArrival']=1;
							$model->update(['meta']);
						}else
						{
							$transaction=Yii::app()->db->beginTransaction();
							try {
								$model->updateFlight(true);
								$model->updateSea();
								$transaction->commit();
							} catch (Exception $ex) {
								$transaction->rollback();
								throw $ex;
							}
						}
					}
				}
				
				$model->attributes=$_POST['ImcoConsol'];
				if (isset($_POST['ignore_revenue'])) {
					$model->mdata['ignore_revenue']=$_POST['ignore_revenue'];
				}
				if (preg_match('/\d{3}\-\d{8}/i', trim($_POST['ImcoConsol']['awb']))&&!preg_match('/C\d{8}NZ/i', $model->no)) {
					$model->handlingfee();
				}
			}
			$model->save();

			// only real consol can generate invoice
			$model = $model->getReal();

			// create invoice for special import agent client
			if (!empty($_POST['gen_inv'])) {
				if ($_POST['gen_inv'] == 1) {
					$selectedOrg=!empty($_POST['inv_client_select'])?[$_POST['inv_client_select']]:[];
					$errors = $model->genSpecialInvoice(false, false, $selectedOrg);
					if (!empty($errors)) {
						$model->addError('GenInvoice Failed', implode('; ', $errors));
					}
				}
			}

			if (!empty($_POST['gen_adv_inv'])) {
				if ($_POST['gen_adv_inv'] == 1) {
					$selectedOrg=!empty($_POST['inv_client_select'])?[$_POST['inv_client_select']]:[];
					$errors = $model->genSpecialInvoice(false, false, $selectedOrg,true);
					if (!empty($errors)) {
						$model->addError('GenDevInvoice Failed', implode('; ', $errors));
					}
				}
			}


			if (!empty($_POST['gen_air_type_inv'])) {
				if ($_POST['gen_air_type_inv'] == 1) {
					$errors = $model->genLooseInvoice(false);
					if (!empty($errors)) {
						$model->addError('GenInvoice Failed', implode('; ', $errors));
					}
				}
			}
			
			// create invoice for awb difference
			if (!empty($_POST['gen_awb_inv'])) {
				if ($_POST['gen_awb_inv'] == 1) {
					$errors = $model->genAwbDiffInvoice();
					if (!empty($errors)) {
						$model->addError('GenInvoice Failed', implode('; ', $errors));
					}
				}
			}

			// create invoice for clearance invoice
			if (!empty($_POST['gen_clearance_inv'])) {
				if ($_POST['gen_clearance_inv'] == 1) {
					$errors = $imconsolService->genClearanceInvoice($model);
					if (!empty($errors)) {
						$model->addError('Gen AQ Invoice Failed', implode('; ', $errors));
					}
				}
			}


			$this->ajaxResult($model);
		}
		
		if (isset($_GET['tab'])) {
			Acl::hasAccess($this->CaName.'/'.$_GET['tab'], true);
			if (!empty($_GET['fix'])) {
				$this->render('tab_' . $_GET['tab'], ['model' => $model, 'fix' => true]);
				return;
			}

			if($_GET['tab']=="overview")
			{
				if($shadow->type==ShadowConsol::$my_type)
				{
					$shadowIM = new ImcoConsol('search');
					$shadowIM->setAttributes($shadow->getAttributes());
					$shadowIM->isNewRecord = false;
					$shadowIM->mdata = $shadow->mdata;
					$this->render('tab_overview', ['model'=>$shadowIM,'real'=>$model]);
					return;
				}
				$this->render('tab_overview', ['model'=>$shadow,'real'=>$model]);
			}else
			{
				$pbn = @$_GET["ImParcel"]["pbn"];
				$this->render('tab_'.$_GET['tab'], ['model'=>$model,'shadow'=>$shadow,'pbn'=>$pbn]);
			}
		} else {
			$this->render('update', ['model'=>$model,'shadow'=>$shadow]);
		}
	}
	
	public function actionNotes($id)
	{
		$model=$this->loadModel($id);
		if (!empty($_POST['notes'])) {
			$log = Log::add($model, 6, ['notes' => $_POST['notes']]);
			$this->ajaxResult($log);
		}
	}
		
		
	/*
	 * update the scan
	 */
	public function actionUpdateScan($id)
	{
		$model=$this->loadModel($id);
		foreach ($model->shipments as $shipment) {
			$shipment->scan_no= $shipment->pkg-(empty($shipment->scan_data[50])?0:sizeof($shipment->scan_data[50]));
			$shipment->update('scan_no');
		}
		echo 'done';
	}

	/**
	 * delete specified manifest from DB
	 * @param $id
	 */
	public function actionDelmani($id)
	{
		$model = Manifest::model()->findByPk($id);
		//$model->delete();
		$model->status = 100;
		$model->save();
		$this->ajaxResult($model, ['id'], 'Manifest deleted successfully!');
	}

	public function actionUbm($id)
	{
		$model=$this->loadModel($id);
		if (!empty($_POST)) {

			// in case delete schedule UBM
			if (isset($_POST['delete'])) {
				if ($_POST['delete'] == 'Delete') {
					$this->deleteUbm($model);
					$this->ajaxResult($model);
				}
			}
			if (isset($_POST['force_ubm'])) {
				if ($_POST['force_ubm'] == 'Force Send UBM') {
					$this->forceSendUbm($model);
				}
			}
			if(!empty($_POST['ImcoConsol']))
			{
				$model->attributes=$_POST['ImcoConsol'];
			}
			if(!empty($_POST['ShadowConsol']))
			{
				$model->attributes=$_POST['ShadowConsol'];
			}
			if (!empty($_POST['mdata'])) {
				foreach ($_POST['mdata'] as $k=>$v) {
					$model->mdata[$k] = $v;
				}
			}
			$model->save();
			//send ubm
			if((!empty($_POST['yt1'])&&$_POST['yt1']=='Save')||(!empty($_POST['yt0'])&&$_POST['yt0']=='Save'))
			{
				$this->ajaxResult($model);
				return;
			}
			$this->preUbm($model);
			$this->ajaxResult($model);
		}
		if (empty($model->mdata['ubm_dest'])) {
			$model->mdata['ubm_dest'] = $model->getEstID();
			$model->save();
		}
		$this->render('ubm', [
			'model'=>$model,
		]);
	}

	public function actionApproveUbm($id)
	{
		if(!Acl::hasAccess('B:imcoconsol/approveUbm'))
		{
			echo('Access Denied');
		}
		$model= $this->loadModel($id);
		$model->mdata['ubmsent'] = 9;
		$model->log('ubmapproved by');
		$model->save();

		$model=$model->getReal();
		$model->mdata['ubmsent'] = 9;
		$model->log('ubmapproved by');
		$model->save();
		$this->ajaxResult($model);
	}
		
	private function preUbm($model, $force=false)
	{
		$senderSite =  Yii::app()->params['ics']['testing']? Yii::app()->params['ics']['test_site'] : Yii::app()->params['ics']['prod_site'];
		//send ubm
		$em = new Edimsg;
		$em->dt = date('Y-m-d H:i:s');
		$em->type = 'UBMREQ';
		$em->sender = Yii::app()->params['ics']['testing']? Yii::app()->params['ics']['test_site'] : Yii::app()->params['ics']['prod_site'];
		$em->receiver = Yii::app()->params['ics']['customs_id'];
		$em->status = 19;
		$em->fid = $model->getReal()->id;
		if ($model->service == 20) {
			$em->mdata['voyage_number']=trim($model->flight);
			$em->mdata['vessel']=trim($model->airline);
			$voyage_number=trim($model->flight);// like 023s
			$vessel=trim($model->airline); //IMO  like 9235103
			$obl=$model->awb;// /required ocean bill landing
			$container_number=trim($model->mdata['container_no']);//container no  like OOLU9551594
			$hbl=$model->mdata['house_bill'];
			$cargo_type=$model->mdata['cargo_type'];
			$em->save();
			$em->mid = sprintf('%06s', substr($em->id, -6));
			$vn = Edimsg::model()->count('type = :t AND fid = :fid AND sender=:sender', [':t' => 'UBMREQ', ':fid' => $model->id,':sender'=>$senderSite]);
			$ubm_discharge = (!empty($model->mdata['ubm_discharge'])?$model->mdata['ubm_discharge']:$model->mdata['ubm_origin']);
			$ubm_discharge = ($ubm_discharge=='NULL'?'':("LOC+11+".$ubm_discharge."::95'
"));
			$msg = "UNH+".$em->mid."+CUSCAR:D:99B:UN'
BGM+31:::UBMREQ+".$model->getReal()->no.($vn == 1? '' : '-'.$vn).":".$vn."+9'
RFF+ACD:".($model->totShipments() ==1? 'MOV' : 'DCL')."'
NAD+VW+".Yii::app()->params['ics']['abn']."::95'
TDT+1++ROA'
TDT+20+".$voyage_number."++11++++".$vessel."::11'
LOC+4+".$model->mdata['ubm_dest']."::95'
LOC+5+".$model->mdata['ubm_origin']."::95'
".$ubm_discharge.
"CNI++:::I'
RFF+AAQ:".$container_number."'
GID+1'
PAC+".$model->totPacks()."'
PAC+++PK:185:95'
PAC+++FCL:67:95'
";
			$mc = substr_count($msg, "\n")+1;
			$msg .= "UNT+".$mc."+".$em->mid."'";
			$em->msg = $msg;
			// if (!$force) {
			// 	if (isset($model->mdata['dclallowed'])&&$model->mdata['dclallowed']==1) {
			// 		$model->mdata['ubmsent'] = 1;
			// 		$em->status = 20; // sent
			// 	} else {
			// 		$model->mdata['ubmsent'] = 2;
			// 		$em->status = 18; // on schedule status
			// 	}
			// } else {
			// 	$model->mdata['ubmsent'] = 1;
			// 	$em->status = 20; // sent
			// }

			$model->mdata['ubmsent'] = 1;
			$em->status = 20; // sent

			if (!empty($model->process)) {
				$model->process->updateStatus(ConsolProcess::STATE_UB_ON_SCHEDULE);
			}
			$model->update(['meta']);
			$em->save();
		} else {
			//airline-underbond movement
			$em->mdata['airline'] = $model->airline;
			$em->mdata['flight'] = $model->flight;
			$em->mdata['eta'] = $model->eta;
			$em->mdata['etd'] = $model->etd;

			$em->save();
			$em->mid = sprintf('%06s', substr($em->id, -6));
			$vn = Edimsg::model()->count('type = :t AND fid = :fid AND sender = :sender', [':t' => 'UBMREQ', ':fid' => $model->id,':sender'=>$senderSite]);
			//$airline = preg_replace('/\d+/', '', trim($model->airline));
			//if(empty($airline)) $airline = preg_replace('/\d+/', '',trim($model->airline));
			//$flight = preg_replace('/[^\d]+/', '', $model->flight);

			$airline = substr(trim($model->airline), 0, 2);
			$flight = substr(trim($model->flight), 2);
			$ubm_discharge = (!empty($model->mdata['ubm_discharge'])?$model->mdata['ubm_discharge']:$model->mdata['ubm_origin']);
			$ubm_discharge = ($ubm_discharge=='NULL'?'':("LOC+11+".$ubm_discharge."::95'
"));
			$msg = "UNH+".$em->mid."+CUSCAR:D:99B:UN'
BGM+31:::UBMREQ+".$model->getReal()->no.($vn == 1? '' : '-'.$vn).":".$vn."+9'
RFF+ACD:DCL'
NAD+VW+".Yii::app()->params['ics']['abn']."::95'
TDT+1++ROA'
TDT+20+".$flight."++6+".$airline."::3'
LOC+4+".$model->mdata['ubm_dest']."::95'
LOC+5+".$model->mdata['ubm_origin']."::95'
";
if(empty($model->mdata['house_bill'])){
	$msg .= $ubm_discharge;
}
$msg .= "DTM+132:".date("Ymd", strtotime($model->eta)).":102'
CNI++:::I'
RFF+MWB:".str_replace('-', '', $model->awb)."'".(empty($model->mdata['house_bill'])? '' : "\nGID+1'\nRFF+HWB:".$model->mdata['house_bill']."'")."
GID+1'
PAC+".$model->totPacks()."'
";
			$mc = substr_count($msg, "\n")+1;
			$msg .= "UNT+".$mc."+".$em->mid."'";
			$em->msg = $msg;
			if (Yii::app()->params['ics']['testing']) {
				$em->mdata['test'] = 1;
			}
			if (!$force) {
				if ($this->isAirlineArrived($model->flight, $model->eta)) {
					//echo $msg;
					$em->status = 20; // in queue status
					$model->mdata['ubmsent'] = 1;
				} else {
					$model->mdata['ubmsent'] = 2;
					$em->status = 18; // on schedule status
				}
			} else {
				$em->status = 20; // in queue status
				$model->mdata['ubmsent'] = 1;
			}
			if (!empty($model->process)) {
				$model->process->updateStatus(ConsolProcess::STATE_UB_ON_SCHEDULE);
			}
			$model->update(['meta']);
			$em->save();
		}
	}

	/**
	 * try to delete on the schedule UBM request
	 * @param $console
	 */
	private function deleteUbm($console)
	{
		$senderSite =  Yii::app()->params['ics']['testing']? Yii::app()->params['ics']['test_site'] : Yii::app()->params['ics']['prod_site'];
		// try to find them
		$ubmModels = Edimsg::model()->findAll('fid = :fid AND type = :type AND status = 18 AND sender = :sender', [':fid' => $console->getReal()->id,':type' => 'UBMREQ',':sender'=>$senderSite]);
		foreach ($ubmModels as $ubm) {
			if($console->service==Consol::AIRCONSOL)
			{
				$airline = substr(trim($console->airline), 0, 2);
				$flight = substr(trim($console->flight), 2);
			}elseif($console->service==Consol::SEACONSOL)
			{
				$airline = trim($console->airline);
				$flight = trim($console->flight);
			}
			if(preg_match('/'.$flight.'/',$ubm->msg)&&preg_match('/'.$airline.'/',$ubm->msg))
			{
				$ubm->status = 90;
				$ubm->save();
			}
		}
		// reset UBN sent status
		unset($console->mdata['ubmsent']);
		if (!empty($model->process)) {
			$model->process->updateStatus(ConsolProcess::STATE_WAITING_SEND_UBM);
		}
		$console->save();
	}

	private function forceSendUbm($model)
	{
		// delete on schedule one if existing
		$this->deleteUbm($model);
		$this->preUbm($model, true);
		$this->ajaxResult($model);
	}
	/**
	 * check to see if the flight arrived or not
	 * @param $flight
	 * @param $etd
	 * @return bool
	 */
	private function isAirlineArrived($flight, $etd)
	{
		$arrived = false;
		// call flight tracking logic
		include(Yii::app()->basePath.DIRECTORY_SEPARATOR.'commands/trackingCommand.php');
		$tracking = new trackingCommand('ubm', null);
		$d = $tracking->flight($flight, $etd);
		if (!empty($d)) {
			if ($d[7] == 2) { //arrival

				// if  30 minutes  after arrived
				// we set arrived , so that we can send UBM message
				// get real arrived time
				$laterTime = strtotime($d[5]) + 30 * 60;
				if (time() > $laterTime) {
					$arrived = true;
				}
			}
		}
		return $arrived;
	}
