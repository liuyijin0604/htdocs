	public function actionExportCargoReceipt($id){
		//$consol = $this->loadModel($id);
		$consol = $this->loadModelImconsol($id);
		$shipments = [];
		$org = [];
		foreach ($consol->getOrgsInfo() as $key => $value) {
			$org = $value;
			break;
		}
		
		if (!empty($org['id']) &&  $org['id'] == Org::ORGID_COURIER_4PX) {
			oPDF::renderPDF('cargo_receipt_4px', ['model' => $consol], 1, $consol->no.'.pdf');
			return;
		} 

		foreach ($consol->shipments as $key => $p) {
			if($p->status!=ImParcel::STATE_CLEAR)
			{
				continue;
			}
			if(in_array($p->agent_id,[1206,2794,2942,2797,2791]))
			{
				if(preg_match('/^CPWP/i',$p->ref))
				{
					$shipments[] = $p;
				}
			}else
			{
				$shipments[] = $p;
			}
		}
		if(!empty($shipments))
		{
			oPDF::renderPDF('cargo_receipts_2', ['models' => $shipments]);
		}
	}

