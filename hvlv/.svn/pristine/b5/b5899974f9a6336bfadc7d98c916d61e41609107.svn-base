	public function actionSeaDOShipments()
	{
		$appName = Yii::app()->name;
		$id = $_GET['id'];
		$type = $_GET['type'];
		$model= $this->loadModel($id);
		$courier = empty($_GET['courier'])?"":$_GET['courier'];
		if ($model->service == 10) {
			throw new CHttpException(404, 'Only Sea Type Has Sea Order.');
		}
		if (!empty($model->shipments)) {
			$td = Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR;
			$ps=[];
			$type = Consol::$services[$model->service];
			foreach ($model->shipments as $shipment) {
				$size = count($shipment->trans);
				if(!in_array(0, $courier))
				{
					if(!empty($courier)&&$size>0)
					{
						if(!in_array($shipment->trans[$size-1]->org_id, $courier))
						{
							continue;
						}
					}else
					{
						if(!in_array(999, $courier))
						{
							continue;
						}
					}
				}
				if($shipment->hbn==$shipment->consol->no) continue;
				$tf = tempnam($td, "stmt");
				Yii::app()->name = $appName;
				oPDF::renderPDF('sea_order', ['model' => $shipment,'type'=>$type], 2, $tf);
				$ps[] = $tf;
			}
			if(!empty($ps))
			{
				Yii::app()->name = $appName;
				oPDF::mergePDF($ps, 1, true, 'sea_delivery_order'.$model->no.'.pdf');
			}else
			{
				echo "empty";
			}
		}
	}

	/**
	 * Returns a pdf of sea order if the shipment is belong to sea types.
	 * @param integer the ID of the model to be loaded
	 */
	public function actionDgDocument($id)
	{
		$model= $this->loadModel($id);
		$td = Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR;
		$ps=[];
		foreach ($model->shipments as $shipment) 
		{
			$trans = $shipment->trans;
			if(!empty($trans)&&(end($trans)->org_id == Org::ORGID_COURIER_PCA))continue;
			if (empty($shipment->mdata['is_dg'])) continue;
			$tf = tempnam($td, "stmt");
			oPDF::renderPDF('dg_document', ['model' => $shipment], 2, $tf);
			$ps[] = $tf;
		}
		oPDF::mergePDF($ps, 1, true, 'dg_document'.$model->no.'.pdf');
	}
	/**
	 * Returns the data model based on the primary key given in the GET variable.
	 * If the data model is not found, an HTTP exception will be raised.
	 * @param integer the ID of the model to be loaded
	 */
	public function loadModel($id)
	{
		$model= Consol::model()->findByPk($id);
		if ($model===null) {
			throw new CHttpException(404, 'The requested page does not exist.');
		}
		return $model;
	}

	public function loadModelImconsol($id)
	{
		$model= ImcoConsol::model()->findByPk($id);
		if ($model===null) {
			throw new CHttpException(404, 'The requested page does not exist.');
		}
		return $model;
	}
	
	
