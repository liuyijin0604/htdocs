	{
		$icsService = new IcsService();
		$cn = $icsService->acr($id);
		$this->ajaxResult($cn);
	}

	/**
	 * send lodgement to AuPost Office only
	 * @param $id
	 */
	public function actionAupost($id)
	{
		$cn = $this->loadModel($id);

		//auspost lodgement
		$ss = [];
		$transaction=Yii::app()->db->beginTransaction();
		$err = [];
		$ars = [];
		
		try {
			foreach ($cn->shipments as $s) {
				if (preg_match('/^(AMQ|333UF|33EVH|33EVJ|34AWE)\d{7}/', $s->ref, $m) && ($s->cbwf&ImParcel::CBWF_DIRECT_CONSOL_BASE)==0) { // only for eParcel shipment and Not sent yet
					// check if manifested
					if (!empty($s->trans)) {
						foreach ($s->trans as $tran) {
							if ($tran->connote == $s->ref) continue 2;
						}
					}

					if(!empty($s->mdata['aupost_return'])){
						if(empty($s->mdata['ap_sid'])) $ars[$s->hbn] = $s;
						continue;
					} else if (!empty($s->mdata['aupost_exp'])) {
						if (empty($s->mdata['ap_sid'])) $aes[$s->hbn] = $s;
						continue;
					}
					// add a feature for logment eparcel before report custom port
					$direct_eparcel=false; //set a flag
					if (!empty($s->mdata['chargecode'])) {
						$chargecodeInfo= ImportChargeCode::model()->find('chargecode=:chargecode AND status=1', [":chargecode"=>$s->mdata['chargecode']]);
						if (!empty($chargecodeInfo)) {
							if (!empty($chargecodeInfo->mdata['direct_courier'])) {
								$direct_eparcel=true;
								$s->mdata['direct_courier']=2;// direct log eparcel 2 means a flag when success we will change it to 1
								$s->updateMeta();
							}
						}
					}
					// only for we received the shipment which means has been scanned in our warehouse
					// and status is cleared $s->getOutPkg() == $s->pkg
					if (($s->getOutPkg() > 0 && in_array($s->status, ImParcel::$allow_manifest_states)) || $direct_eparcel || $cn->owner_id == Org::ORGID_CLIENT_TLA || $cn->owner_id == 3441) {
						$s->cnee->checkPostcode();
						if(strlen($s->cnee->suburb) > 40){
							$err[] = $s->hbn.' suburb too long!';
						}else{
							$ss[$m[1]][] = $s;
						}
					}
				}
			}
			$transaction->commit();
		} catch (Exception $ex) {
			$transaction->rollback();
			throw $ex;
		}

		if (!empty($err)) {
			echo implode('<br />', $err);
			return false;
		}

		$consoleIds=[];

		foreach($ss as $k => $ps){
			$err=array_merge($err, $this->doAupostManifest($ps, $k, $consoleIds, $cn));
			// if($k == '33MBQ' && empty($err)){ //send manifest to ecof;
			// 	$xls = new oExcel;
			// 	$i = 1;
			// 	$xls->addRow($i++, ['connote', 'weight', 'recipient_postcode', 'manifest_no']);
