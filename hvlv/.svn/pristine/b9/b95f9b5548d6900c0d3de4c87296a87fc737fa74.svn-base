<?php 
class SeaConsolService extends Service
{
	private function __clone() 
    { 
    }

     /** 
     * CreateDTime: 2023/01/03 14:35 
     * Function: "" 
     * @return sigle|null 
     */ 
    public static function getInstance() 
    { 
        if (self::$ins==null){ 
            self::$ins=new self(); 
        } 
        return self::$ins; 
    }

 	public function updateSeaDocumentationStatus($consol,$processType,$isIgnore=false,$postData = null)
 	{
 		if($processType==ConsolProcess::DU_UNPACKS&&!$isIgnore)
 		{
 			if(!empty($postData['unpackingTeam']))
 			{
 				$consol->process->mdata['unpacking_team'] =$postData['unpackingTeam'];
 				$this->updateUnpackingStatus($consol);

 				$consol->process->addOperationLog("Update Unpacking Team:".$postData['unpackingTeam']);

 				return  $this->getSuccessResult();
 			}
 		}

		if(!empty($isIgnore))
		{

	 		$consol->process->sub_status = intval($consol->process->sub_status)|$processType;
			$consol->process->sub_status_ignore = intval($consol->process->sub_status_ignore)|$processType;

	 		$consol->process->save();
	 		return  $this->getSuccessResultWithWarns();
		}else
		{
			return  $this->getFailResult("Failure");
		}

 	}

 	public static function updateSCRProcessStatus($consol,$om)
	{
		if($consol->service==Consol::SEACONSOL)
		{
			$newScrStat = -1;
			if($om->status==Edimsg::STATUSLGD)
			{
				$newScrStat = 5;
			}elseif($om->status==Edimsg::STATUSRJT)
			{
				$newScrStat = 0;
			}

			if((isset($consol->mdata['scr_stat'])&&$consol->mdata['scr_stat']!=$newScrStat)||!isset($consol->mdata['scr_stat']))
			{
				$consol->mdata['scr_stat'] = $newScrStat;
				$consol->updateMeta();
				if($newScrStat==5)
				{
					$consol->process->sub_status = intval($consol->process->sub_status)|ConsolProcess::DU_SCR;//update SCR pass
					$consol->process->sub_status_ignore = (intval($consol->process->sub_status_ignore)|ConsolProcess::DU_SCR)-ConsolProcess::DU_SCR;

				}else
				{
					$consol->process->sub_status = (intval($consol->process->sub_status)|ConsolProcess::DU_SCR) - ConsolProcess::DU_SCR;//update SCR failure
				}

				$consol->process->update(["sub_status","sub_status_ignore"]);
			}
		}
	}


	public static function updateUBMProcessStatus($process)
	{
		if($process->consol->service==Consol::SEACONSOL)
		{
			if(!empty($process->consol->mdata['ubmsent'])&&$process->consol->mdata['ubmsent']==9)
			{
				$process->sub_status = intval($process->sub_status)|ConsolProcess::DU_UB;
				$process->update('sub_status');
			}elseif(($process->sub_status&ConsolProcess::DU_UB)>0&&(empty($process->consol->mdata['ubmsent'])||!empty($process->consol->mdata['ubmsent'])&&$process->consol->mdata['ubmsent']!=9))
			{
				$process->sub_status = (intval($process->sub_status)|ConsolProcess::DU_UB)-ConsolProcess::DU_UB;
				$process->update('sub_status');
			}
		}
	}

	public static function updateDOProcessStatus($consol)
	{
		$check = FileRepo::model()->count("type = :type and fid = :fid and name like '%EDO%' and status != :status ",[":fid"=>$consol->id,":type"=>FileRepo::CONSOL_ATTACHMENT,":status"=>FileRepo::DELETED]);
		if($check>0)
		{
			$consol->process->sub_status = intval($consol->process->sub_status)|ConsolProcess::DU_DO;
			$consol->process->update('sub_status');
		}else
		{
			$consol->process->sub_status = (intval($consol->process->sub_status)|ConsolProcess::DU_DO)- ConsolProcess::DU_DO;
			$consol->process->update('sub_status');
		}
		return self::getSuccessResult();
	}

	public static function updateCartageProcessStatus($consol)
	{
		if(!empty($consol->process->mdata['send_cartage_email']))
		{
			$consol->process->sub_status = intval($consol->process->sub_status)|ConsolProcess::DU_CARTAGE;
			$consol->process->sub_status_ignore = (intval($consol->process->sub_status_ignore)|ConsolProcess::DU_CARTAGE)-ConsolProcess::DU_CARTAGE;
			$consol->process->update(['meta','sub_status','sub_status_ignore']);
		}else
		{
			$consol->process->sub_status = (intval($consol->process->sub_status)|ConsolProcess::DU_CARTAGE) - ConsolProcess::DU_CARTAGE;
			$consol->process->update(['meta','sub_status']);
		}
	}

