	public static function updateCLRStatus($shipment,$consol)
	{
		if(!empty($shipment->status==ImParcel::STATE_CLEAR))
		{
			$consol->process->sub_status = intval($consol->process->sub_status)|ConsolProcess::DU_CLR;
			$consol->process->sub_status_ignore = (intval($consol->process->sub_status_ignore)|ConsolProcess::DU_CLR)-ConsolProcess::DU_CLR;
			$consol->process->update('meta','sub_status','sub_status_ignore');
		}else
		{
			$consol->process->sub_status = (intval($consol->process->sub_status)|ConsolProcess::DU_CLR) - ConsolProcess::DU_CLR;
			$consol->process->update('sub_status');
		}
	}

	public function updateSeaConsolPortChargeFlexibleRate($consol,$data)
	{
		$orgIds = $consol->getAllAgentId();
		$allData = OrgFlexibleRate::getOrgFlexibleRateByOrgIds($consol->id,$orgIds,true);
		$check = false;
		foreach ($allData as $key => $value) {
			if(strtoupper($value['item'])=="PORT CHARGES"||strtoupper($value['item'])=="PORT CHARGE")
			{
				$o = OrgFlexibleRate::model()->findByPk($value['id']);
				$o->amount = $data['price'];
				$o->save();
				$check = true;
			}
		}

		if($check)
		{
			return $this->getSuccessResult();
		}else
		{
			return $this->getFailResult("can not find PORT CHARGS In Org Flexible Rate");
		}
	}

	public function editCartageEmail($postData,$getData,$ids)
	{
		$consol = Consol::model()->findByPk($ids[0]);
		$ccEmail = "imports@toplogistics.com.au";
		$vesselInfo = @$consol->mdata['sea_vessel']." ".$consol->airline." ".$consol->flight;
		$emailContent = $vesselInfo."</br></br> Info:</br><table border=2 cellspacing=0 ><tr><th>TYPE</th><th>CTN number</th><th>Vessel</th><th>Vessel ID</th><th>Voyage</th><th>ETA</th><th>Free Detention Days</th></tr>";
		$consols = [];
		foreach ($ids as $key => $id) {
			$thisConsol = Consol::model()->findByPk($id);
			$emailContent.= "<tr><td>".@Consol::SEA_TYPE[$thisConsol->mdata['sea_type']]."</td>"."<td>".@$thisConsol->container_no."</td>"."<td>".@$thisConsol->mdata['sea_vessel']."</td>"."<td>".@$thisConsol->airline."</td>"."<td>".@$thisConsol->flight."</td>"."<td>".@$thisConsol->eta."</td>"."<td>".(empty($thisConsol->mdata['free_detention_days'])?"8":$thisConsol->mdata['free_detention_days'])."</td>"."</tr>";
			$consols[] = $thisConsol;
		}
		$emailContent .= "</table>";
		$seaConsolService = new SeaConsolService();

		$emailService = new EmailService();
		[$model,$data] = $emailService->createEmailContent($postData,$getData,Emailog::CARTAGE_EMAIL,["VESSEL_INFO",$vesselInfo],["EMAIL_CONTENT"=>$emailContent],$ccEmail);
		if($data===1)
		{
			foreach ($consols as $key => $value) {
				$consol->process->addOperationLog("Send Cartage Email");

				$consol->process->mdata['send_cartage_email'] = 1;
				$this->updateCartageProcessStatus($consol);
			}
		}

		return [$model,$data];
	}

	public function getUnpackingTeam($consol)
	{
		$results = [];
		$orgs = Org::model()->findAll("status=:status and (cargo_driver_type & :type)>0",[":status"=>Org::STATEACTIVE,":type"=>Org::$upackingTypesRe[$consol->dpt_id]]);

		foreach ($orgs as $key => $value) {
			$results[$value->id] = $value->name;
		}
		return $results;
	}
	
}
