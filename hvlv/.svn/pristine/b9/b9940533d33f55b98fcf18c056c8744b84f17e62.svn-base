		['name'=>'process_status','value'=>'$data->getProcessStatus()','filter'=>CHtml::dropDownList('ImcoConsol[process_status]', $consol->process_status, $this->t(ConsolProcess::$states), ['prompt'=>$this->t('All')]),],
		['name'=>'sea_process_status','type'=>'raw','value'=>'$data->getSeaProcessStatus()','filter'=>CHtml::dropDownList('Consol[sea_process_status]', $consol->sea_process_status, $this->t(ConsolProcess::$seaStates), ['prompt'=>$this->t('All')]),],
