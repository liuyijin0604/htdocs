<script>
	$(function() {
		var tab = $('#<?= $_GET["tabid"]; ?>');
		var panel = tab.data('panel');
		$('a.export_search', panel).on('mousedown', function() {
			var q = $('.filters input, .filters select', panel).serialize();
			$(this).attr('href', $(this).data('baseurl') + '&' + q);
		});
	})
</script>