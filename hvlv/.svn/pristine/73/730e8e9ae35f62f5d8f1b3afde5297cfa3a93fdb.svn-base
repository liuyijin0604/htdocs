			['name' => 'sub_type', 'type' => 'raw', 'filter' => CHtml::dropDownList('CargoProcess[sub_type]', $cargo->sub_type, $this->t(CargoProcess::$sTypeList), ['prompt' => 'All']), 'value'=>function ($data) {
