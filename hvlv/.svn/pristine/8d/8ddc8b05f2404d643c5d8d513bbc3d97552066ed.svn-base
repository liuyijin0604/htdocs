	public function beforeSave()
	{
		return parent::beforeSave();
	}

	public function afterSave()
	{
		if(!empty($this->job_relations)){
			foreach($this->job_relations as $relation){
				if(!empty($relation->cargo_process->mdata['customer_confirmed']['surcharge_invoice'])){
					$modelCargoProcess = $relation->cargo_process;
					$strAppName = Yii::app()->name;
					Yii::app()->name = 'TLA';
					$objInvoice = Invoice::model()->findByPk($modelCargoProcess->mdata['customer_confirmed']['surcharge_invoice']);
					Yii::app()->name = $strAppName;
					if(!empty($objInvoice)){
						if($objInvoice->status == 2){
							$objInvoice->createCreditForMe();
						}
					}
				}
			}
		}
	}

	public function afterFind()
	{
		if (empty($this->job_no)) {
			$this->job_no = $this->genNo();
			$this->update(['job_no']);
		}
		return parent::afterFind();
	}

	public function genNo()
	{
		$pfx = 'CJOB';
		$n = $pfx . date('y', strtotime($this->created));
		// $s = self::model()->count('job_no LIKE :n', [':n' => $n . '%']) + 1;
		// return $n . sprintf('%02d', $s) . substr($this->dpt_id, 2);
		return $n . $this->id;
	}



	/**
	 * @return string the associated database table name
	 */
	public function tableName()
	{
		return 'cargo_process_job';
	}

	/**
	 * @return array validation rules for model attributes.
	 */
	public function rules()
	{
		// NOTE: you should only define rules for those attributes that
		// will receive user inputs.
		return array(
			array('status,vehicle_id,created', 'required'),
			array('status,vehicle_id', 'numerical', 'integerOnly' => true),
			array('description', 'length', 'max' => 255),
			// The following rule is used by search().
			// @todo Please remove those attributes that should not be searched.
			array('id, job_name, description, status,vehicle_id,job_no, created,comp_date,strdate,enddate', 'safe', 'on' => 'search'),
		);
	}

	/**
	 * @return array relational rules.
	 */
	public function relations()
	{
		// NOTE: you may need to adjust the relation name and the related
		// class name for the relations automatically generated below.
		return array(
			'driver' => [self::BELONGS_TO, 'Org', 'driver_id'],
			'user' => [self::BELONGS_TO, 'User', 'user_id'],
			'job_relations' => [self::HAS_MANY, 'CargoProcessJobRelations', 'job_id', 'on' => 'job_relations.active = 1'],
			'job_all_relations' => [self::HAS_MANY, 'CargoProcessJobRelations', 'job_id'],
			'vehicle' => [self::BELONGS_TO, 'CargoProcessVehicle', 'vehicle_id'],
			'amazon_info' => [self::HAS_ONE, 'AmazonInfo', 'fid', 'on' => "amazon_info.model='" . get_called_class() . "'"],
		);
	}

	/**
	 * @return array customized attribute labels (name=>label)
	 */
	public function attributeLabels()
	{
		return array(
			'id' => 'ID',
			'job_name' => 'Job Name',
			'job_no' => 'Job No',
			'description' => 'Description',
			'status' => 'Status',
			'meta' => 'Meta',
			'created' => 'Delivery Date',
			'driver_id' => 'Driver',
			'vehicle_id' => 'Vehicle',
			'user_id' => 'Created By',
			'time' => 'Time',
			'comp_date' => 'Complate Date',
		);
	}

	public function log($action)
	{
		$extra = ["action" => $action];
		Log::add($this, $this->isNewRecord ? 3 : 4, array_merge(['status' => $this->getStatus()], $extra));
	}

	public function getStatus()
	{
		return isset(static::$processTypes[$this->status]) ? Yii::t(strtolower(__CLASS__), static::$processTypes[$this->status]) : $this->status;
	}

	public function getPickupAddress($type = false)
	{
		if (!empty($this->mdata['pickup_address'])) {
			return $this->mdata['pickup_address'];
		} else {
			$warehouse = Org::model()->findByPk($this->dpt_id);

			$address = "";
			if ($type) {
				$address = "&nbsp;";
			}

			if ($warehouse != null) {
				if ($type) {
					$address = $warehouse->address . ", <br>" . $warehouse->suburb . ", " . $warehouse->state . ", <br>" . $warehouse->country . ", " . $warehouse->postcode;
				} else {
					$address = $warehouse->address . ", " . $warehouse->suburb . ", " . $warehouse->state . ", " . $warehouse->country . ", " . $warehouse->postcode;
				}
			}
			return $address;
		}
	}

	/**
	 * Retrieves a list of models based on the current search/filter conditions.
	 *
	 * Typical usecase:
	 * - Initialize the model fields with values from filter form.
	 * - Execute this method to get CActiveDataProvider instance which will filter
	 * models according to data in model fields.
	 * - Pass data provider to CGridView, CListView or any similar widget.
	 *
	 * @return CActiveDataProvider the data provider that can return the models
	 * based on the search/filter conditions.
	 */
	public function search($pgn = true, $ps = 50, $ec = false, $defaultOrder = true, $podId = 106, $jobType = null)
	{
		// @todo Please modify the following code to remove attributes that should not be searched.
		$criteria = new CDbCriteria;
		$criteria->compare('id', $this->id);
		$criteria->compare('job_no', $this->job_no, true);
		$criteria->compare('job_name', $this->job_name, true);
		$criteria->compare('description', $this->description, true);
		$criteria->compare('status', $this->status);
		$criteria->compare('driver_id', $this->driver_id);
		$criteria->compare('meta', $this->meta, true);

		if(!empty($this->strdate)&&!empty($this->enddate)){
			$criteria->addCondition('t.created >= "'.$this->strdate.'" and t.created <="'.$this->enddate.'"');
		}elseif(!empty($this->strdate)&&empty($this->enddate)){
			$criteria->addCondition('t.created >= "'.$this->strdate.'"');
		}elseif(empty($this->strdate)&&!empty($this->enddate)){
			$criteria->addCondition('t.created <= "'.$this->enddate.'"');
		}else{
			$criteria->compare('created', $this->created, true);
		}
		
		$criteria->compare('vehicle_id', $this->vehicle_id, true);
		$criteria->compare('comp_date', $this->comp_date, true);
		if (!empty($jobType)) {
			$criteria->compare('type', $jobType);
		}

		if(!empty($this->interstate_type == 2)){
			$criteria->addCondition('json_value(meta,"$.destination") = ' .$podId);
		}else{
			if (!empty($podId)) {
				$criteria->compare('dpt_id', $podId);
			}
		}
		
		if (!empty($this->mdata['time'])) {
			$criteria->addCondition('json_value(meta,"$.time") = ' . $this->mdata['time']);
		}

		if (empty($this->status)) {
			$criteria->addCondition('status <' . self::DELETED);
			$criteria->addCondition('status <' . self::PROCESSDONE);
		}

		// if (is_int(intval($this->week))) {
		// 	$dateStart = date('Y-m-d', (time() - ((date('w') == 0 ? 7 : date('w')) - 1) * 24 * 3600));
		// 	$dataEnd = date('Y-m-d', (time() + (7 - (date('w') == 0 ? 7 : date('w'))) * 24 * 3600));
		// 	$dateStart = date("Y-m-d",strtotime((intval($this->week) * 7)." day",strtotime($dateStart)));
		// 	$dataEnd =  date("Y-m-d",strtotime((intval($this->week) * 7)." day",strtotime($dataEnd)));
		// 	$criteria->addCondition('created >= "'.$dateStart.' 00:00:00" and created <= "'.$dataEnd.' 23:59:59"');
		// }

		$sort = new CSort();
		$sort->defaultOrder = array('created' => CSort::SORT_ASC);

		return new CActiveDataProvider($this, array(
			'sort' => $sort,
			'criteria' => $criteria,
		));
	}

	public function updateStatus($status, $type = false)
	{
		$update = false;
		if (key_exists($status, self::$processTypes)) {
			$this->status = $status;
			$update = true;
		}

		if ($update) {
			$this->save();
			$this->refresh();
		}
	}

	public function getFullDescription()
	{
		$description = [$this->description];
		$jres = CargoProcessJobRelations::model()->findAll(['condition' => 'job_id = :jobId and active = 1', 'params' => [":jobId" => $this->id], 'order' => 'sequence']);
		foreach ($jres as $key => $jre) {
			if (!empty($jre->cargo_process->shipment->note)) {
				$description[] = $jre->cargo_process->shipment->ref . "::" . $jre->cargo_process->shipment->note;
			}
		}
		return join('</br>', $description);
	}

	public function getCargoProcess()
	{

		$jres = CargoProcessJobRelations::model()->findAll(['condition' => 'job_id = :jobId and active = 1', 'params' => [":jobId" => $this->id], 'order' => 'sequence']);
		foreach ($jres as $key => $jre) {
			if (!empty($jre->cargo_process)) {
				$this->cargo_process[] = $jre->cargo_process;
			}
		}
		return $this->cargo_process;
	}

	public function getUser()
	{
		if (empty($this->user_id)) {
			return 'System';
		} else {
			if (empty($this->user)) return 'System';
			return $this->user->getFullName();
		}
	}

	public function getTime()
	{
		return $this::$cargoTimes[$this->mdata['time']];
	}

	public function getTotalCBMOfJob()
	{
		$totalCBM = 0;
		if($this->type ==6){
			$objcargoProcessRelations = $this->job_all_relations;
		}else{
			$objcargoProcessRelations = $this->job_relations;
		}
		if (!empty($objcargoProcessRelations)) {
			foreach ($objcargoProcessRelations as $objcargoProcessRelation) {
				$objcargoProcess = CargoProcess::model()->findByPk($objcargoProcessRelation->cargo_process_id);
				if (!empty($objcargoProcess)) {
					$totalCBM += $objcargoProcess->getTotalCBM();
				}
			}
		}
		return $totalCBM;
	}

	public function getMaxCBMofVehicle()
	{
		$vehicleCBM = 0;
		$vehicle = CargoProcessVehicle::model()->findByPk($this->vehicle_id);
		if (!empty($vehicle)) {
			$vehicleCBM = $vehicle->max_cbm;
		}
		return $vehicleCBM;
	}

	public function getAvailableCBMString()
	{
		$strResult = $this->getTotalCBMOfJob() . "/" . $this->getMaxCBMofVehicle();
		if ($this->getTotalCBMOfJob() == 0 || $this->getMaxCBMofVehicle() == 0) {
			$strResult .= " 0%";
		} else {
			$strResult .= " " . round($this->getTotalCBMOfJob() / $this->getMaxCBMofVehicle() * 100, 2) . "%";
		}
		return $strResult;
	}

	public function getAvailableCountString()
	{
		if($this->type ==6){
			$objcargoProcessRelations = $this->job_all_relations;
		}else{
			$objcargoProcessRelations = $this->job_relations;
		}
		$countMaxCargoProcess = self::$vehicleLimit[$this->vehicle_id];
		$countCargoProcess = empty(count($objcargoProcessRelations)) ? 0 : count($objcargoProcessRelations);
		$result = "";
		if ($countCargoProcess != 0 && $countMaxCargoProcess != 0) {
			$result = $countCargoProcess . "/" . $countMaxCargoProcess;
			$result .= " " . round($countCargoProcess / $countMaxCargoProcess * 100, 2) . "%";
		} else {
			$result = $countCargoProcess . "/" . $countMaxCargoProcess . " 0%";
		}

		return $result;
	}

	public function getTotalPltNo()
	{
		if(!empty($this->mdata['total_job_pallet_no'])){
			return $this->mdata['total_job_pallet_no'];
		}
		$arr = [];
		$num = 0;
		if (!empty($this->job_relations)) {
			foreach ($this->job_relations as $relation) {
				if (!empty($relation->cargo_process->shipment->rack_record)) {
					foreach ($relation->cargo_process->shipment->rack_record as $value) {
						$arr[$value->location->name] = 1;
					}
				}else{
					$numtemp = !empty($relation->cargo_process->mdata['job_pallet_no']) ? $relation->cargo_process->mdata['job_pallet_no']:0;
					if(empty($numtemp)){
						$numtemp = !empty($relation->cargo_process->shipment->mdata['amzon_pallet'])? $relation->cargo_process->shipment->mdata['amzon_pallet']:0;
					}
					$num += $numtemp;
					
				}
			}
		}
		return (count($arr)+$num > 0) ? count($arr)+$num : 0;
	}

	public function getTotalPltsNotSkip(){
		$numResult = 0;
		if (!empty($this->job_relations)) {
			foreach ($this->job_relations as $relation) {
				if(!empty($relation->cargo_process)){
					$numPlt = 0;
					if(!empty($relation->cargo_process->shipment->mdata['amzon_pallet'])){
						$numPlt = $relation->cargo_process->shipment->mdata['amzon_pallet'];
					}else{
						$numPlt = !empty($relation->cargo_process->shipment->getRackNumber()[1])?$relation->cargo_process->shipment->getRackNumber()[1]:0;
					}
					$numResult += !empty($relation->cargo_process->mdata['job_pallet_no'])? $relation->cargo_process->mdata['job_pallet_no']:$numPlt ;
				}
			}
		}
		return $numResult;
	}

	public function getThreeCjobDateFromNow()
	{
		$result = [];
		$dataNow = date("Y-m-d");
		//for($i=28;$i>=-2;$i--){
		for ($i = 100; $i >= -3; $i--) {
			$result[date("Y-m-d", strtotime("-" . $i . " day", strtotime($dataNow)))] = date("Y-m-d", strtotime("-" . $i . " day", strtotime($dataNow)));
		}
		return $result;
	}

	public function getCjobDateFromNowForTony()
	{
		$result = [];
		$dataNow = date("Y-m-d");
		//for($i=28;$i>=-2;$i--){
		for ($i = 100; $i >= -5; $i--) {
			$result[date("Y-m-d", strtotime("-" . $i . " day", strtotime($dataNow)))] = date("Y-m-d", strtotime("-" . $i . " day", strtotime($dataNow)));
		}
		return $result;
	}

	public function getAvailableJob($cargoID)
	{

		$ca = CargoProcess::model()->findByPk($cargoID);
		$distance = $ca->shipment->getDeliveryDistance();
		$weight = $ca->shipment->weight;
		$numPkg = $ca->shipment->pkg;
		$numCBM = $ca->getTotalCBM();
		if ($numCBM == 0 || $numCBM == null) {
			$numCBM = $weight / 250;
		}
		$dpt_id = $ca->dpt_id;
		$packs = $ca->shipment->packs;
		$type = $ca->type;

		$cargoProcessDate = $ca->started;

		if (date("w", strtotime($cargoProcessDate)) == 6) {
			$actionDate = date("Y-m-d", strtotime("+2 day", strtotime($cargoProcessDate)));
		} else if (date("w", strtotime($cargoProcessDate)) == 5) {
			$actionDate = date("Y-m-d", strtotime("+3 day", strtotime($cargoProcessDate)));
		} else {
			$actionDate = date("Y-m-d", strtotime("+1 day", strtotime($cargoProcessDate)));
		}

		if($ca->status == CargoProcess::PREPROCESS){
			$dateUnloadDate = $ca->shipment->mdata['ContainerUnloadDate'];
			if(date("w", strtotime($dateUnloadDate)) == 6){
				$dateDelivery = date("Y-m-d", strtotime("+2 day", strtotime($dateUnloadDate)));
			}else if(date("w", strtotime($cargoProcessDate)) == 5){
				$dateDelivery = date("Y-m-d", strtotime("+3 day", strtotime($dateUnloadDate)));
			} else{
				$dateDelivery = date("Y-m-d", strtotime("+1 day", strtotime($dateUnloadDate)));
			}
			if(strtotime($dateDelivery)>=strtotime($actionDate)){
				$actionDate = $dateDelivery;
			}
		}

		$region = $ca->getRegion();
		$region = $region = strtolower(strtr($region, array(' ' => '')));

		// $models = CargoProcessJob::model()->findAll('status = 30 and JSON_UNQUOTE(JSON_EXTRACT(meta, "$.'.$region.'"))=1 and JSON_UNQUOTE(JSON_EXTRACT(meta, "$.distance"))>:distance',array('distance'=>$distance));
		$models = CargoProcessJob::model()->findAllBySql('select * from cargo_process_job where status = 30 and type = '.$type.' and dpt_id = ' . $dpt_id . ' and created > "' . $actionDate . '" and JSON_UNQUOTE(JSON_EXTRACT(meta, "$.' . $region . '"))=1 and JSON_UNQUOTE(JSON_EXTRACT(meta, "$.distance"))>' . $distance);

		$result = [];
		foreach ($models as $model) {
			$totalCBM = 0;
			$objcargoProcessRelations = $model->job_relations;
			$limitPack = 0;
			if (!empty($objcargoProcessRelations)) {
				foreach ($objcargoProcessRelations as $objcargoProcessRelation) {
					$objcargoProcess = CargoProcess::model()->findByPk($objcargoProcessRelation->cargo_process_id);
					$totalCBM += $objcargoProcess->getTotalCBM();
					$limitPack++;
				}
			}

			if (empty(self::$vehicleLimit[$model->vehicle_id])) {
				if ($limitPack >= 10) {
					continue;
				}
			} else {
				if ($limitPack >= self::$vehicleLimit[$model->vehicle_id]) {
					continue;
				}
			}


			$vehicle = CargoProcessVehicle::model()->findByPk($model->vehicle_id);
			// 1CBM 200KG 40KB/per to truck Only
			if ($vehicle->type == CargoProcessVehicle::enum_type_small_vehicle) {
				if ($numCBM >= 2.5 || $weight >= 300 || ($weight / $numPkg) > 40) {
					continue;
				}

				if (!empty($packs)) {
					foreach ($packs as $pack) {
						if ($pack['length'] > 120 || $pack['height'] > 120 || $pack['width'] > 120) {
							continue 2;
						}
					}
				}
			}

			$dicId2T = [
				3 => '',
				28 => '',
			];

			if (($totalCBM + $numCBM) <= $vehicle->max_cbm) {
				if (sizeof($result) >= 2) { //Top 2
					break;
				}
				$result[$model->id] = $this->funcParseDeliveryTime($model->created, $model->mdata['time'], $dicId2T[$model->vehicle_id]);
			}
		}
		return $result;
	}

	public function funcParseDeliveryTime($strDate, $numTime, $strT)
	{
		return date("d-m-Y (l)", strtotime($strDate)) . " " . CargoProcessJob::$cargoTimes[$numTime] . ' ' . $strT;
	}

	public function getJobType()
	{
		return self::$cargoTypeList[$this->type];
	}

	public function isFBAJob()
	{
		if (empty($this->mdata['sig'])) {
			if($this->type ==2 || $this->type ==4){
				return true;
			}else{
				return false;
			}
			//return $this->type == 2 ? true : false;
		}
		return false;
	}

	public function getCJobByWeek()
	{
		$result = [];
		for ($i = 5; $i >= -26; $i--) {
			$result[$i] =  date("Y-m-d", strtotime(($i * 7) . " day", strtotime(date('Y-m-d', (time() - ((date('w') == 0 ? 7 : date('w')) - 1) * 24 * 3600))))) . " - " . date("Y-m-d", strtotime(($i * 7) . " day", strtotime(date('Y-m-d', (time() + (7 - (date('w') == 0 ? 7 : date('w'))) * 24 * 3600)))));
		}
		return $result;
	}

	public function getDriverList(){
		$result = [];
		foreach(self::$arrDriverOrgId as $driver){
			$result[$driver] = Org::model()->findByPk($driver)->name;
		}
		return $result;
	}

	public function getCourierThirdLabel(){
		$arr = [];
		foreach ($this->job_relations as $job_relation) {
			$n = !empty($job_relation->cargo_process->mdata["third_part_label_no"])? $job_relation->cargo_process->mdata["third_part_label_no"]:"";
			$n="<font>{$n}</font>";
			$arr[] = $n;
		}
		return implode(', ', array_unique($arr));
	}

	/**
	 * Returns the static model of the specified AR class.
	 * Please note that you should have this exact method in all your CActiveRecord descendants!
	 * @param string $className active record class name.
	 * @return CargoProcessJob the static model class
	 */
	public static function model($className = __CLASS__)
	{
		return parent::model($className);
	}
}
