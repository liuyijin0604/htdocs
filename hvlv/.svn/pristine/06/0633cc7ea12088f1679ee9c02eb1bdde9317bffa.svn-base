	public function createHvlvJavaLabel($orgRate)
	{
		if ($this->id <= 0) {
			return false;
		}
		$orgRate = OrgRate::model()->find("id = :id",[":id"=>$orgRate]);
		$type = HvlvJavaAPI::RATE_TYPE[$orgRate->mdata['ddpt_id']];
		$courier = $orgRate->mdata['courier'];
		$prefix = $orgRate->mdata['mlids'];
		$javaApi = new HvlvJavaAPI($type,$courier,$prefix);
		$this->ref = "";
		if(empty($this->ref)){
			$result=$javaApi->createShipment($this);
			if($result['code']!="60000")
			{
				$this->tempErrors = $result['msg'];
				return false;
			}

			$this->ref = $result['data']['ref'];
			$this->mdata['barcode'] = $result['data']['barcode'];
			$barcodes = explode(',',$this->mdata['barcode']);
			foreach ($barcodes as $key => $barcode) {
				$pb = new ParcelBarcode();
				$pb->main_ref = $this->ref;
				$pb->fid = $this->id;
				$pb->sub_ref = $barcode;
				$pb->sn = $key+1;
				$pb->save();
			}
		}
		$this->mdata['org_rate_id'] = $orgRate->id;
		$this->mdata['org_id'] = $orgRate->org_id;
		$this->nolog = true;
		$this->update('ref', 'meta');
		$this->nolog = false;
		
		$ts = new Tranship;
		$ts->pid = $this->id;
		$ts->org_id = $orgRate->org_id;
		$ts->type = 80;
		$ts->status = 10;
		$ts->connote = $this->ref;
		$ts->time = date('Y-m-d H:i:s');
		$ts->cost = 0;
		$ts->mdata = ['java_gen'=>1];
		return $ts->save();
	}

	public function printEizLabel($orgRate,$trackingno)
	{
		if ($this->id <= 0) {
			return false;
		}

		$orgRate = OrgRate::model()->find("id = :id",[":id"=>$orgRate]);

		$pb = new ParcelBarcode();
		$pb->main_ref = $trackingno;
		$pb->fid = $this->id;
		$pb->sub_ref = $trackingno;
		$pb->sn = 1;
		$pb->save();

		$this->mdata['labelNumber'] = $trackingno;
		$this->ref=$trackingno;
		$this->mdata['org_rate_id'] = $orgRate->id;
		$this->mdata['org_id'] = $orgRate->org_id;
		$this->status = 100;
		$this->nolog = true;
		$this->update('ref', 'meta');
		$this->nolog = false;


		$ts = new Tranship;
		$ts->pid = $this->id;
		$ts->org_id = $orgRate->org_id;
		$ts->type = 80;
		$ts->status = 10;
		$ts->connote = $this->ref;
		$ts->time = date('Y-m-d H:i:s');
		$ts->cost = 0;
		return $ts->save();
	}

	public function manifestD2zLabel()
	{
		if ($this->id <= 0) {
			return false;
		}
		$d2z = new D2zShipAPI('auto');
		$result = $d2z->allocate_shipment($this);
		if (!empty($result['responseMessage']) && $result['responseMessage'] == 'Shipment allocation Successful') {
			$ts = Tranship::model()->find('pid = :id', [':id' => $this->id]);
			$ts->mdata['oid'] = Org::ORGID_COURIER_D2Z;
			if ($ts->save()) {
				return true;
			}
		} else {
			return false;
		}
	}

	public function createTntLabel($o = 'syd')
	{
		if ($this->id <= 0) {
			return false;
		}
		Tranship::model()->deleteAll('pid = :pid', [':pid' => $this->id]);
		$this->unsetMetaFlag();
		$tnt = TntAPI::getTntInterface($o);
		$result = $tnt->createOneShipment($this);
		return $result['status'];
	}

	public function createFwLabelWithNR($type = 'syd'){
		if ($this->id <= 0) {
			return false;
		}
		// clear all old tranship
		Tranship::model()->deleteAll('pid = :pid', [':pid' => $this->id]);
		$this->unsetMetaFlag();
		$fw = new FastwayAPI(true, false, $type);
		$weight = $fw->roundWeight($this->weight,$this->cnee->state);
		$courier = OrgRate::model()->findByPk($this->mdata['org_rate_id']);
		$zr = ImcoConsol::getCourierCostPrice($courier, $this->cnee->postcode, $weight, $this->pkg, false, $this->cnee->suburb,true);
		$prod = $zr->weight_hi > 0.3? '2X' : 'QX';

		if(!empty($courier)&&preg_match('/mel/i', $courier->code))
		{
			$prod = $zr->weight_hi > 0.3? '2X0' : 'QX0';
		}
		
		$this->ref = FastWayAPI::genNumber($prod);
		if(empty($this->ref)) return false;
		$this->nolog = true;
		$this->update(['ref']);
		$this->nolog = false;

		$ts = new Tranship;
		$ts->pid = $this->id;
		$ts->org_id = 115; // for Fastway post office
		$ts->man_id = $this->man_id;
		$ts->type = 80; // shipment transfer to a different delivery courier
		$ts->status = 10; // in finally moving status
		$ts->connote = $this->ref;
		$ts->time = date('Y-m-d H:i:s');
		$sortcode = FastwayAPI::sortingCode($this->cnee->postcode, $this->cnee->suburb);
		$ts->mdata['fw_toRf'] = $sortcode[0];
		$ts->mdata['fw_subDepotCode'] = $sortcode[1];
		$ts->mdata['fw_toCf'] = $sortcode[2];
		$ts->mdata['fw_origin'] = $type;
		if($zr->weight_hi <= 0.3) $ts->mdata['fw_satchelSize'] = '300GM';
		if ($ts->save()) {
			return true;
		}
		return false;
	}

	public function createFastwayLableAPI($type = 'syd'){
		if ($this->id <= 0) {
			return false;
		}

		// clear all old tranship
		Tranship::model()->deleteAll('pid = :pid', [':pid' => $this->id]);
		$this->unsetMetaFlag();
		$fw = new FastwayAPI(true, false, $type);
		$result = $fw->addConsignment($this);
		if ($result) {
			$cost = $result->TotalCostExGST;
			// for fastway , because fastway server side issue
			// we need shrink the cost to 90.75 %
			$cost = $cost * 0.9075;	

			$consignmentID = $result->ConsignmentID;
			$manifestID = $result->ManifestID;
			// $refNumber = $result->LabelNumbers[0];
			$refNumber = $result->Items[0]->labels[0]->labelNumber;
			$this->ref = $refNumber;
			$this->nolog = true;
			$this->update(['ref']);
			$this->nolog = false;

			// save tranship information for Fastway courier
			$ts = new Tranship;
			$ts->pid = $this->id;
			$ts->org_id = 115; // for Fastway post office
			$ts->man_id = $this->man_id;
			$ts->type = 80; // shipment transfer to a different delivery courier
			$ts->status = 19; // in finally moving status
			$ts->connote = $this->ref;
			$ts->time = date('Y-m-d H:i:s');
			$ts->mdata['fw_consigment_id'] = $consignmentID;
			$ts->mdata['fw_manifest_id'] = $manifestID;
			$ts->mdata['fw_label_color'] = $result->Items[0]->labels[0]->colour;
			// $ts->mdata['fw_exlabel_count'] = $result->ExcessLabelCount;
			$ts->mdata['fw_dest_code'] = $result->DestinationRFCode; // delivering deport code
			$ts->cost = number_format(round($cost, 2), 2, '.', '');
			if ($ts->save()) {
				return true;
			}
		}
		return false;
	}

