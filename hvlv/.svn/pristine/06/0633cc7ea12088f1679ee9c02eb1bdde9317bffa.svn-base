	public function getDeconsoliation($pgn = true, $ps = 30, $ec = false, $defaultOrder = true, $podId = 106)
	{
		$criteria=new CDbCriteria;
	}


	public function getPickupParcel($pgn = true, $ps = 30, $ec = false, $defaultOrder = true, $podId = 106)
	{
		$criteria=new CDbCriteria;

		$criteria->join =' left join shipment_wh_prepare swp on t.id = swp.shipment_id ';

		$search_hbns = $this->hbn;
		$hbns = [];
		foreach (preg_split("/[;,\s\n]/", $search_hbns) as $hbn) {
			if (empty(trim($hbn))) {
				continue;
			}
			$hbns[] = trim($hbn);
		}

		$search_refs = $this->ref;
		$refs = [];
		foreach (preg_split("/[;,\s\n]/", $search_refs) as $ref) {
			if (empty(trim($ref))) {
				continue;
			}
			$refs[] = trim($ref);
		}
		
		if (sizeof($hbns)>1) {
			$criteria->addInCondition("hbn", $hbns);
		} else {
			if (!empty($this->hbn)) {
				$this->hbn = trim($this->hbn);
				$criteria->addCondition("t.hbn like '%{$this->hbn}%'");
			}
		}

		if (sizeof($refs)>1) {
			$criteria->addInCondition("ref", $refs);
		} else {
			if (!empty($this->ref)) {
				$this->ref = trim($this->ref);
				$criteria->addCondition("t.ref like '%{$this->ref}%'");
			}
		}


		$criteria->compare('t.id', $this->id, true);
		$criteria->compare('t.owner_id', $this->owner_id);
		$criteria->compare('t.consol_id', $this->consol_id);
		$criteria->compare('cnor_id', $this->cnor_id);
		$criteria->compare('cnee_id', $this->cnee_id);
		$criteria->compare('receiver_id', $this->receiver_id);
		$criteria->compare('man_id', $this->man_id);
		$criteria->compare('rec_id', $this->rec_id);
		$criteria->compare('odpt_id', $this->odpt_id);
		$criteria->compare('ddpt_id', $this->ddpt_id);
		$criteria->compare('zr_id', $this->zr_id);
		$criteria->compare('ot_id', $this->ot_id);
		//$criteria->compare('t.type',$this->type);
		$criteria->compare('cref', $this->cref, true);
		$criteria->compare('t.styp', $this->styp);
		$criteria->compare('pkg', $this->pkg, true);
		$criteria->compare('t.state', $this->state, true);
		$criteria->compare('t.postcode', $this->postcode, true);
		$criteria->compare('value', $this->value, true);
		$criteria->compare('dvalue', $this->dvalue, true);
		$criteria->compare('tariff', $this->tariff, true);
		$criteria->compare('currency', $this->currency);
		$criteria->compare('weight', $this->weight, true);
		$criteria->compare('wtck', $this->wtck, true);
		$criteria->compare('cbm', $this->cbm, true);
		$criteria->compare('sac', $this->sac);
		$criteria->compare('exm', $this->exm, true);
		$criteria->compare('can', $this->can, true);
		$criteria->compare('scan_no', $this->scan_no);
		$criteria->compare('t.note', $this->note, true);
		$criteria->compare('t.created', $this->created, true);

		$criteria->addCondition(' swp.id is null ');

		$sort = new CSort();
		$sort->attributes = [
			'id'=>[
				'asc'=>'t.id ASC',
				'desc'=>'t.id DESC',
			],
		];

		$criteria->addCondition('t.ref like "%PICKUP%" or t.hbn like "%PICKUP%"');
		$criteria->addCondition('t.status = '.self::STATE_CLEAR.' or t.status ='.self::STATE_LOCAL_ARRIVAL);
		$criteria->addCondition('t.scan_no = 0 ');
		$sort->defaultOrder ='t.id DESC';



		// in case sub-gridview, we need consol_id set by parent grid view
		$pagerparams = $_GET;
		return new CActiveDataProvider($this, [
			'criteria'=>$criteria,
			'sort' => $sort,
			'pagination' => $pgn ? [
				'pageSize' => $ps,
				'params' => $pagerparams,
			] : false,
		]);
	}

	public function getStorageStartDate($type=false)
	{
		if (!empty($this->consol->mdata['input_storage_date'])) {
			return $this->consol->mdata['input_storage_date'];
		}

		if (!empty($this->consol->mdata['available_date'])) {
			$available = $this->consol->mdata['available_date'];
			$date = date("Y-m-d H:i", strtotime($available.' +3 day +1 min'));
			if ($this->consol->isSYDMELWarehouse()) {// if is SYD MEL warehouse, the Storage is not included in weekends
				// if(!empty($this->cargo_process))
				// {
				// 	if($this->cargo_process->type!=CargoProcess::PICKUP_CARGO)
				// 	{
				// 		$clTime = $this->getParcelClearedDate(true);
				// 		if(strtotime($available)<strtotime($clTime))
				// 		{
				// 			$available = $clTime;
				// 		}
				// 		$date = date("Y-m-d H:i", strtotime($available.' +7 day +1 min'));
				// 	}
				// }

				$holidays = HolidayHelper::getWeekendDaysBetweenTwoDays($available, $date, $this->consol->pod);
				$date = date("Y-m-d H:i", strtotime($date.' +'.$holidays.' day'));
			} else {
				$check = 3;
				$startDate = $available;
				while ($check>0) {
					$startDate = date('Y-m-d', strtotime($startDate . '+ 1 day +1 min'));
					if (!HolidayHelper::checkDateIsHoliday($startDate, $this->consol->pod)) {
						$check--;
					}
				}
				$date = date("Y-m-d H:i", strtotime($startDate));
			}

			if(HolidayHelper::checkDateIsHoliday($date,$this->consol->pod))
			{
				$date = HolidayHelper::getNextWeekday($date,$this->consol->pod);
			}
		} else {
			$date = '';
		}

		if ($type&&!empty($date)) {
			$date = date('Y-m-d', strtotime($date));
		}
		return $date;
	}


	public function getParcelClearedDate($type=false)
	{
		$tr = Tracking::model()->find(" pid = :pid and type = :type ", [":pid"=>$this->id,":type"=>Tracking::CLEARED_TYPE]);
		if (!empty($tr)) {
			if ($type&&!empty($date)) {
				$date = date('Y-m-d', strtotime($tr->dt));
				return $date;
			} else {
				return $tr->dt;
			}
		}
	}

	public function getTotalCBM()
	{
		$myCBM = isset($this->mdata['total_cbm'])?$this->mdata['total_cbm']:$this->cbm*$this->pkg;
		$myCBM = max($myCBM, $this->cbm*$this->pkg);
		$myCBM = max($myCBM, 0.000001);
		return $myCBM;
	}

	public function getStorageFee($front = false,$checkToDate = "")
	{
		$ss = new OrgRate('search');
		$consol = $this->consol;
		if(empty($consol))
		{
			return [0,0,''];
		}
		$cbm = $this->getTotalCBM();
		$kg = $this->weight;
		$storage_rate=0;
		$amount = 0;
		$chargeDays = 0;
		$seaStFeePS = 0;
		$cctype = "CBM";
		$finalToDate = (empty($checkToDate)?'now':$checkToDate);
		$finalToDateTime = (empty($checkToDate)?date('Y-m-d H:i:s'):$checkToDate);
		$finalToDateOnly = (empty($checkToDate)?date('Y-m-d'):$checkToDate);

		// if (!empty($this->cargo_process)&&$this->cargo_process->type!=CargoProcess::PICKUP_CARGO) {
		// 	$cus_services = $ss->getCustomerServicePlans($this->agent_id);
		// 	$seaStFeePS = $seaStFeeCR = 0;
		// 	if (isset($cus_services['services']->AU->seaStFeePS)) {
		// 		$seaStFeePS = $cus_services['services']->AU->seaStFeePS;
		// 	}
		// 	if (isset($cus_services['services']->AU->seaStFeeCR)) {
		// 		$seaStFeeCR = $cus_services['services']->AU->seaStFeeCR;
		// 	}

		// 	$strTime = $this->getStorageStartDate();
		// 	if(empty($strTime))
		// 	{
		// 		return [$amount, $chargeDays,$strTime];;
		// 	}

		// 	$outTime = new DateTime('now', new DateTimeZone('Australia/Sydney'));
		// 	$strTime = new DateTime($strTime, new DateTimeZone('Australia/Sydney'));

		// 	if(strtotime($outTime->format('Y-m-d'))<strtotime($strTime->format('Y-m-d')))
		// 	{
		// 		return [$amount, $chargeDays,$strTime->format('Y-m-d'),$outTime->format('Y-m-d'),$this->agent->name,$this->weight,$this->getTotalCBM(),$seaStFeeCR,@Consol::$services[$consol->service],$seaStFeePS];
		// 	}

		// 	$storedDays = $outTime->diff($strTime)->format("%a");
		// 	$chargeDays = $storedDays+1;// will be set as 1

		// 	if ($chargeDays > 0) {
		// 		$amount = $seaStFeePS + $chargeDays * $cbm * $seaStFeeCR;
		// 	} else {
		// 		$chargeDays = 0;
		// 	}
		// 	$inTime = $strTime;
		// 	$storage_rate = $seaStFeeCR;

		// }else
		if ($consol->service == ImcoConsol::SEACONSOL) {
			$cus_services = $ss->getCustomerServicePlans($this->agent_id);
			$seaStFeePS = $seaStFeeCR= $seaStFeeKR = $seaStBefTerm= $seaStAftTerm = 0;
			if (isset($cus_services['services']->AU->seaStFeePS)) {
				$seaStFeePS = $cus_services['services']->AU->seaStFeePS;
			}
			if (isset($cus_services['services']->AU->seaStFeeCR)) {
				$seaStFeeCR = $cus_services['services']->AU->seaStFeeCR;
			}
			if (isset($cus_services['services']->AU->seaStFeeKR)) {
				$seaStFeeKR = $cus_services['services']->AU->seaStFeeKR;
			}
			if (isset($cus_services['services']->AU->seaStBefTerm)) {
				$seaStBefTerm = $cus_services['services']->AU->seaStBefTerm;
			}
			if (isset($cus_services['services']->AU->seaStAftTerm)) {
				$seaStAftTerm = $cus_services['services']->AU->seaStAftTerm;
			}
			if(empty($seaStAftTerm)) $seaStAftTerm=1;

			// calculate how many days we have stored
			$clTime = $this->getParcelClearedDate();
			$strTime = $this->getStorageStartDate();
			$outTime = new DateTime($finalToDate, new DateTimeZone('Australia/Sydney'));
			$storedDays = 0;
			$startDay = "";
			$isBefore = false;

			if (strtotime($strTime)===false||strtotime($clTime)===false) {
				return [$amount, $chargeDays,$strTime];
			}

			$clDate = new DateTime($clTime, new DateTimeZone('Australia/Sydney'));
			$clStrDayDiff = $clDate->diff(new DateTime($strTime, new DateTimeZone('Australia/Sydney')))->format("%a");
			if (strtotime($clTime)<strtotime($strTime)) {
				$isBefore = true;
			}

			if ($isBefore) {
				if (strtotime($finalToDateTime)>=strtotime($strTime)) {
					$strTime = new DateTime($strTime, new DateTimeZone('Australia/Sydney'));
					$storedDays = $outTime->diff($strTime)->format("%a")+1;
				} else {
					$strTime = new DateTime($strTime, new DateTimeZone('Australia/Sydney'));
					$storedDays = 0;
				}

				$chargeDays = $storedDays-$seaStBefTerm;// will be set as 0

				if ($clStrDayDiff<2) {
					$chargeDays = $chargeDays - $seaStAftTerm;
				}
			} else {
				if (($this->bwf&16)>0) {// if this parcel is border
					$clTime = date("Y-m-d", strtotime($clTime));
					$strTime = new DateTime($clTime, new DateTimeZone('Australia/Sydney'));
					$storedDays = $outTime->diff($strTime)->format("%a");
					$chargeDays = $storedDays-$seaStAftTerm;// will be set as 1
				} else {
					if($this->isParcelPickup())//for the parcel is pickup, we don't need to worried about whether cleared before or after
					{
						$strTime = new DateTime($strTime, new DateTimeZone('Australia/Sydney'));
						$storedDays = $outTime->diff($strTime)->format("%a")+1;
						$chargeDays = $storedDays;// will be set as 1
					}else
					{
						$clTime = date("Y-m-d", strtotime($clTime));
						$strTime = new DateTime($clTime, new DateTimeZone('Australia/Sydney'));
						$storedDays = $outTime->diff($strTime)->format("%a")+1;
						$chargeDays = $storedDays;// will be set as 1
					}
				}
			}
			// if ($this->consol->isSYDMELWarehouse()) {
			// 	$weekendDays = HolidayHelper::getWeekendDaysBetweenTwoDays($strTime->format('Y-m-d'), $outTime->format('Y-m-d'), $this->consol->pod);
			// } else {
			// 	$weekendDays = HolidayHelper::getWeekendDaysBetweenTwoDays($strTime->format('Y-m-d'), $outTime->format('Y-m-d'), $this->consol->pod);
			// }
			$weekendDays = HolidayHelper::getWeekendDaysBetweenTwoDays($strTime->format('Y-m-d'), $outTime->format('Y-m-d'), $this->consol->pod);

			$chargeDays = $chargeDays-$weekendDays;// will be set as 1

			if ($chargeDays > 0) {
				// how much we should charge
				// $cbm = $cbm>1?$cbm:1;
				if($cbm>0.00001)
				{
					$amount = $seaStFeePS + $chargeDays * $cbm * $seaStFeeCR;
				}else
				{
					$amount = $seaStFeePS + $chargeDays * $kg * $seaStFeeKR;
				}
			} else {
				$chargeDays = 0;
			}

			$inTime = $strTime;
			if($cbm>0.00001)
			{
				$storage_rate = $seaStFeeCR;
				$cctype ='CBM';
			}else
			{
				$storage_rate = $seaStFeeKR;
				$cctype = 'KG';
			}
		} else {
			$cus_services = $ss->getCustomerServicePlans($this->agent_id);
			$storage_rate = $storage_terms = 0;
			if (isset($cus_services['services']->AU->str_rate)) {
				$storage_rate = $cus_services['services']->AU->str_rate;
			}
			if (isset($cus_services['services']->AU->str_terms)) {
				$storage_terms = $cus_services['services']->AU->str_terms;
			}
			if (isset($cus_services['services']->AU->str_oth_terms)) {
				$storage_oth_terms = $cus_services['services']->AU->str_oth_terms;
			}
			if ($this->consol->isOurWarehouse()) {
				// calculate how many days we have stored
				$inTime = new DateTime($this->consol->eta, new DateTimeZone('Australia/Sydney'));
				$outTime = new DateTime($finalToDate, new DateTimeZone('Australia/Sydney'));
				$storedDays = $outTime->diff($inTime)->format("%a");
				$weekendDays = 0;
				$holidays = HolidayHelper::getHolidaysBetweenTwoDays($inTime->format('Y-m-d'), $outTime->format('Y-m-d'), $this->consol->pod);
				$chargeDays = $storedDays - $storage_terms+1-$holidays;
			} else {
				$inTime = new DateTime(@$this->consol->mdata['available_date'], new DateTimeZone('Australia/Sydney'));
				$outTime = new DateTime($finalToDate, new DateTimeZone('Australia/Sydney'));
				if (!empty($this->consol->mdata['available_date'])) {
					$storedDays = $outTime->diff($inTime)->format("%a");
					$weekendDays = !(empty($this->consol->mdata['available_date']))?HolidayHelper::getWeekendDaysBetweenTwoDays($this->consol->mdata['available_date'], $finalToDateOnly, $this->consol->pod):0;
					$chargeDays = $storedDays -$weekendDays -$storage_oth_terms+1;
				}
			}

			if ($chargeDays > 0) {
				// how much we should charge
				$amount = $chargeDays * $this->weight * $storage_rate;
			} else {
				$chargeDays = 0;
			}
			
			// for chinyun when high value, we don't charge storage fee;
			if ($this->agent_id==1222&&($this->getValue()>=1000)) {
				$amount=0;
			}
			$cctype = 'KG';
		}

		if($front)//for front of client
		{
			if($this->status>=self::STATE_CLEAR)
			{
				if (!(!empty($this->cargo_process)&&$this->cargo_process->type==CargoProcess::PICKUP_CARGO)) {
					return [0, 0,'','',$this->agent->name,$this->weight,$this->getTotalCBM(),$storage_rate,@Consol::$services[$consol->service],$seaStFeePS];
				}
			}
		}

		return [$amount, $chargeDays,$inTime->format('Y-m-d'),$outTime->format('Y-m-d'),$this->agent->name,$this->weight,$this->getTotalCBM(),$storage_rate,@Consol::$services[$consol->service],$seaStFeePS,$cctype];
	}

	public function getStoragePaidStatus()
	{
		return 0;
	}

	public function checkStorageInvoiceStatus($type=false)
	{
		if($this->hasSubShipments()||(!empty($this->consol)&&$this->consol->isWDT()))
		{
			if ($type) {
				return -1;
			}
			return Invoice::$storageInvoiceStates[-1];
		}
		
		$invoice = Invoice::model()->find('type = :type AND pid = :pid AND status != :status1 AND status != :status2', [':type' => Invoice::INVOICE_TYPE_SEA_STORAGE, ':pid' => $this->id,':status1'=>Invoice::INVOICE_STATUS_CACELLED,':status2'=>Invoice::INVOICE_STATUS_FULLY_CREDITED]);
		$state=0;
		if ($invoice==null) {
			$cargo = CargoProcess::model()->find("shipment_id = :fid", [":fid"=>$this->id]);
			if (!empty($cargo)) {
				if ($cargo->type==CargoProcess::PICKUP_CARGO&&$this->consol->service != ImcoConsol::AIRCONSOL) {
					if ($this->getStorageFee()[0]>0) {
						$state=0;
					} else {
						$state=-1;
					}
					if ($type) {
						return $state;
					}
					return Invoice::$storageInvoiceStates[$state];
				} else {
					if ($type) {
						return -1;
					}
					return Invoice::$storageInvoiceStates[-1];
				}
			} else {
				if ($type) {
					return -1;
				}
				return Invoice::$storageInvoiceStates[-1];
			}
		}

		if ($type) {
			return $invoice->status;
		}
		return Invoice::$storageInvoiceStates[$invoice->status];
	}

	public function getStorageInvoiceId()
	{
		$invoice = Invoice::model()->find('type = :type AND pid = :pid AND status != :status1 AND status != :status2', [':type' => Invoice::INVOICE_TYPE_SEA_STORAGE, ':pid' => $this->id,':status1'=>Invoice::INVOICE_STATUS_CACELLED,':status2'=>Invoice::INVOICE_STATUS_FULLY_CREDITED]);
		if ($invoice!=null) {
			return $invoice->id;
		} else {
			return 0;
		}
	}

	public function createSeaStorageInvoice()
	{
		if(!empty($this->cargo_process)&&$this->cargo_process->type!=CargoProcess::PICKUP_CARGO)
		{

		}else
		{
			if ($this->consol->service != ImcoConsol::SEACONSOL) {
				$this->addError("consol is not seaconsol", "consol is not seaconsol");
				return $this;
			}
		}
		// check to see if related pending invoice existing
		$invoice =null; //Invoice::model()->find('type = :type AND status = :status AND to_id = :aid', array(':type' => Invoice::INVOICE_TYPE_STORAGE_FEE, ':status' => Invoice::INVOICE_STATUS_PENDING, ':aid' => $shipment->agent_id));

		if (empty($invoice)) {
			/*2019-05-23 gero add*/
			$invoice=Invoice::model()->find(' type = :type and pid = :pid', [":type"=>Invoice::INVOICE_TYPE_SEA_STORAGE,":pid"=>$this->id]);
			if (!empty($invoice)) {
				$this->addError("storage invoice exist", "storage invoice exist");
				return $this;
			}
			$to_org = Org::ORGID_IMPORT_CASUAL_CUSTOMER;

			// not existing yet , just create a new one
			$invoice = new Invoice();
			$invoice->type = Invoice::INVOICE_TYPE_SEA_STORAGE; // for storage fee invoice
			$invoice->to_id = $to_org;
			$invoice->consol_id = $this->consol_id;
			$invoice->man_id = 0; // in case manifest id means nothing
			$invoice->dpmt = Invoice::DPMT_IMPORT;
			$invoice->pid = $this->id;
			$invoice->currency = 1;
			$invoice->dpt_id = 106;

			// if department not set , we set as sydney warehouse
			if (empty($invoice->dpt_id)) {
				$invoice->dpt_id = Org::PCAE_DEPARTMENT_SYDNEY;
			}

			$invoice->status = Invoice::INVOICE_STATUS_PENDING;

			// get invoice currency
			$invoiceCurrency = 1; // default as AUD
			$orgRate = OrgRate::model()->find('org_id = :oid AND type = 40', [':oid' => $this->agent_id]);
			if (!empty($orgRate)) {
				$invoiceCurrency = $orgRate['currency'];
			}
			$invoice->currency = $invoiceCurrency;

			// set invoice name , address and pay terms information
			$owner = $this->cnee;
			$invoice->mdata['name'] = $owner->name;
			$invoice->mdata['address'] = $owner->getCnFullAddress();
			// $invoice->mdata['payterm'] = empty($owner->extra['payterm']) ? '2 days' : $owner->extra['payterm'] . ' days';

			// here just dummy date , once accounting change to posted , should create new date for the invoice
			// $invoice->due = Invoice::calcDue($invoice->date, $invoice->mdata['payterm']);
		}

		$invoice->date = date('Y-m-d'); // here just dummy date , once accounting change to posted , should create new date for the invoice

		// calculate all price based on weight for the shipment
		$items = [];
		$rt = $this->getStorageFee();
		if ($rt[0] > 0) { // only save in case charge fee more than zero
			// we save charge days ,in and out date at the last two positions
			$items[] = [$this->consol->awb, $this->hbn, $this->getDesc(), $this->pkg, $this->weight, $this->getTotalCBM(), $rt[0],$this->ref, 0, 0, $rt[1], $rt[2],  $rt[3]];

			// save or update invoice

			// check org setting to see if storage has GST
			$gst = 0;
			$org = Org::model()->findByPk($to_org);
			if (isset($org) && isset($org->extra['incl_gst'])) {
				if ($org->extra['incl_gst'] == 1) {
					$gst = round($rt[0] * 10 / 100, 2);
				}
			}
			$invoice->total += $rt[0];
			$invoice->gst += $gst;
			$invoice->total += $gst;
			$invoice->save();

			// create related invoice line and attached it to the invoice
			$il = new InvLine;
			$il->inv_id = $invoice->id;
			$il->amount = $rt[0];
			$il->amount += $gst;
			$il->gst = $gst;
			$il->qty = 1;
			$il->mdata['items'] = $items;
			$il->model = 'Sea Storage Fee';
			$il->fid = 0;
			$il->save();
		}
		return $this;
	}

	public function checkRTSReceived()
	{
		$logs = Log::model()->find(' JSON_VALUE(meta, "$.status") like :status and lid = :lid and model = :model ', [":status"=>"%".self::$states[self::RTS_RECEIVED]."%",":lid"=>$this->id,":model"=>"ImParcel"]);
		if (!empty($logs)) {
			return true;
		} else {
			return false;
		}
	}

	public function getTranshipImparcel()
	{
		$transhipRecord = Tracking::model()->find(["condition"=>"pid = :pid and activity like '%Shipment tranship from%'",'params'=> [":pid"=>$this->id],'order'=>'id desc']);
		if (!empty($transhipRecord)) {
			$hbn = explode("Shipment tranship from : ", $transhipRecord->activity)[1];
			$shipment = ImParcel::model()->find("( hbn = :hbn or ref =:hbn ) and status !=100", [":hbn"=>$hbn]);
			return [$shipment->hbn,$shipment->ref,$shipment->id];
		} else {
			return null;
		}
	}

	public function exceedScreenPeriod()
	{
		$msg = Edimsg::model()->find(['condition' => 'fid = :fid AND type = "CARST"', 'params' => [':fid' => $this->id], 'order' => 'id DESC']);
		if (!empty($this->consol))
		{
			if ($this->consol->service == 10) {
				// air
				if (date('Y-m-d H:i:s', strtotime($msg->dt . ' + 2 hours')) < date('Y-m-d H:i:s')) {
					return true;
				} else {
					return false;
				}
			} elseif ($this->consol->service == 20) {
				// sea
				if (date('Y-m-d H:i:s', strtotime($msg->dt . ' + 24 hours')) < date('Y-m-d H:i:s')) {
					return true;
				} else {
					return false;
				}
			}
		}
	}

	public function checkStorageHeld()
	{
		if (!empty($this->mdata["storageHeld"])&&$this->mdata["storageHeld"]==1) {
			if ($this->status==self::STATE_DUTY_HELD) {
				return '[AD]';
			}
		}

		return '';
	}

	public function getRackName($show_parent=false,$isHtml = false)
	{
		$arr = $this->funcGetRackNameList($show_parent,$isHtml);
		
		return implode(', ', $arr);
	}
	
	public function funcGetRackNameList($show_parent=false,$isHtml = false)
	{
		$arr = [];
		foreach ($this->rack_record as $value) {
			$n = $value->location->name;
			if($show_parent && $value->location->pid > 0){
				$n .= '.'.$value->location->parent->name;
			}
			$strGroundLabel = @$value->location->extra['ground_label'];
			if($strGroundLabel != null) {
				$n = $n.'['.$strGroundLabel .']';
			}
			if(!empty($value->isScanned))
			{
				$n = $n."{S}";
				if($isHtml) $n="<font style='color:green'>{$n}</font>";
			}
			$arr[] = $n;
		}
		return array_unique($arr);
	}

	public function getRackNumber($show_parent=false)
	{
		$arr = [];
		$check = [];
		foreach ($this->rack_record as $value) {
			$arr[$value->location->name] = 1;
			if(!empty($value->isScanned))
			{
				$check[$value->location->name] = 1;
			}
		}
		if(count($arr)>0)return [count($check),count($arr)];
		return '';
	}

	public function getRackParentNumber($type=0){
		$arr = [];
		if($type==2)
		{
			if(!empty($this->rack_record))
			{
				$arr[$this->id] = 1;
				return $arr;
			}
		}
		if($type==1)
		{
			if(empty($this->rack_record))
			{
				$arr[$this->id] = 1;
				return $arr;
			}
		}

		foreach ($this->rack_record as $value){
			if($type==1&&in_array($value->location->type,[WmsLocation::TYPE_AREA,WmsLocation::TYPE_RACK_BAY]))//for area and rack bay, we will pass the putaway
			{
				$arr[$this->id] = 1;
				continue;
			}

			if($value->location->pid==0 && (preg_match('/PS|PM|PLT/i',$value->location->name))){
				if($value->location->extra['ground_label'] != null && $value->location->extra['ground_label'] !=""){
					$arr[$value->location->id] = $value->location->name;
				}
			}elseif($value->location->pid==0 && (preg_match('/SYDAQIS|SDH|SBorder/i',$value->location->name))){
				$arr[$value->location->id] = $value->location->name;
			}elseif($value->location->extra['ground_label'] != null && $value->location->extra['ground_label'] !=""){
				$arr[$value->location->id] = $value->location->name;
			}
		}

		return $arr;
		//return (count($arr)>0)? count($arr):0;
	}

	public function setRack($rack)
	{
		$this->rack = $rack;
	}
	public function getRack()
	{
		return $this->rack;
	}

	/**
	 * Retrieves a list of models based on the current search/filter conditions.
	 *
	 * Typical usecase:
	 * - Initialize the model fields with values from filter form.
	 * - Execute this method to get CActiveDataProvider instance which will filter
	 * models according to data in model fields.
	 * - Pass data provider to CGridView, CListView or any similar widget.
	 *
	 * @return CActiveDataProvider the data provider that can return the models
	 * based on the search/filter conditions.
	 */
	public function searchClientShipment($pgn = true, $ps = 30, $ec = false, $defaultOrder = true, $ignoreD2z = false)
	{
		// @todo Please modify the following code to remove attributes that should not be searched.

		$criteria = new CDbCriteria;
		$with = [];
		if (!empty($this->agent_id)) {
			$criteria->compare('agent_id', $this->agent_id, false);
			if (!empty($this->hbn)) {
				$criteria->compare('agent_id', 0, false, 'OR');
				$criteria->compare('hbn', $this->hbn, true);
			}
		} else {
			$criteria->compare('hbn', $this->hbn, true);
		}
		if ($ignoreD2z) {
			$criteria->addCondition('t.cbwf & ' . self::CBWF_D2Z_CONSOL_NOT_FOR_SCAN . '= 0');
		}
		$criteria->compare('t.id', $this->id, true);
		$criteria->compare('t.owner_id', $this->owner_id);
		$criteria->compare('consol_id', $this->consol_id);
		$criteria->compare('cnor_id', $this->cnor_id);
		$criteria->compare('cnee_id', $this->cnee_id);
		$criteria->compare('receiver_id', $this->receiver_id);
		$criteria->compare('man_id', $this->man_id);
		$criteria->compare('rec_id', $this->rec_id);
		$criteria->compare('odpt_id', $this->odpt_id);
		$criteria->compare('ddpt_id', $this->ddpt_id);
		$criteria->compare('zr_id', $this->zr_id);
		$criteria->compare('ot_id', $this->ot_id);
		if (empty($this->status) && empty($this->hbn) && empty($this->ref) && empty($this->mhbns)) {
			$criteria->addCondition('t.status != 100');
		} else {
			$criteria->compare('t.status', $this->status);
		}
		//$criteria->compare('t.type',$this->type);
		$criteria->compare('ref', $this->ref, true);
		$criteria->compare('cref', $this->cref, true);
		$criteria->compare('t.styp', $this->styp);
		$criteria->compare('pkg', $this->pkg, true);
		$criteria->compare('t.state', $this->state, true);
		$criteria->compare('t.postcode', $this->postcode, true);
		$criteria->compare('value', $this->value, true);
		$criteria->compare('dvalue', $this->dvalue, true);
		$criteria->compare('tariff', $this->tariff, true);
		$criteria->compare('currency', $this->currency);
		$criteria->compare('weight', $this->weight, true);
		$criteria->compare('wtck', $this->wtck, true);
		$criteria->compare('cbm', $this->cbm, true);
		$criteria->compare('sac', $this->sac);
		$criteria->compare('exm', $this->exm, true);
		$criteria->compare('can', $this->can, true);
		$criteria->compare('scan_no', $this->scan_no);
		$criteria->compare('t.note', $this->note, true);
		$criteria->compare('t.created', $this->created, true);

		$with[] = 'process';
		$with[] = 'cargo_process';
		$criteria->addCondition(" json_value(t.meta,'$.storageHeld') = 1 ");
		$criteria->addCondition(" (cargo_process.status is null or cargo_process.status < ".CargoProcess::WAITINGDELIVERY.") ");

		if (!empty($this->mhbns)) {
			$ns = preg_split('/[\s,;]+/', trim($this->mhbns));
			if (sizeof($ns) > 200) {
				$ns = array_slice($ns, 0, 200);
			}
			$sc1 = new CDbCriteria;
			$sc1->addInCondition("hbn", $ns);
			$sc1->addInCondition("ref", $ns, 'OR');
			$sc1->addInCondition("cref", $ns, 'OR');
			$criteria->mergeWith($sc1);
		}

		if (!empty($this->mids)) {
			$criteria->addInCondition("t.id", $this->mids);
		}

		if (!empty($this->bwf)) {
			$criteria->addCondition('t.bwf & ' . $this->bwf . ' > 0');
		}
		if (!empty($this->not_bwf)) {
			$criteria->addCondition('t.bwf & ' . $this->not_bwf . ' = 0');
		}

		if (!empty($this->cbwf)) {
			$criteria->addCondition('t.cbwf & ' . $this->cbwf . ' > 0');
		}

		if (!empty($this->agent_name)) {
			$with[] = 'agent';
			$criteria->addCondition('agent.name LIKE :agt_name OR agent_id = :agt_id');
			$criteria->params[':agt_name'] = '%' . $this->agent_name . '%';
			$criteria->params[':agt_id'] = $this->agent_name;
		}

		if (!empty($this->cnee_name)) {
			$with[] = 'cnee';
			$with[] = 'receiver';
			$criteria->addCondition('cnee.name LIKE :cnee_name OR receiver.name LIKE :cnee_name');
			$criteria->params[':cnee_name'] = '%' . $this->cnee_name . '%';
			// $criteria->compare('cnee.name', $this->cnee_name, true);
		}
		if (!empty($this->cnee_company)) {
			$with[] = 'cnee';
			$criteria->compare('cnee.company', $this->cnee_company, true);
		}
		if (!empty($this->cnee_email)) {
			$with[] = 'cnee';
			$criteria->compare('cnee.email', $this->cnee_email, true);
		}

		if (!empty($this->cnee_tel)) {
			$with[] = 'cnee';
			$criteria->compare('cnee.tel', $this->cnee_tel, true);
		}

		if (!empty($this->cnee_addr)) {
			$with[] = 'cnee';
			$criteria->compare('cnee.address', $this->cnee_addr, true);
		}

		if (!empty($this->cnee_cnid)) {
			$with[] = 'cnee';
			$with[] = 'cnee.cnid';
			$criteria->compare('cnid.no', $this->cnee_cnid, true);
		}

		if (!empty($this->cnor_name)) {
			$with[] = 'cnor';
			$criteria->compare('cnor.name', $this->cnor_name, true);
		}

		if (!empty($this->cnor_tel)) {
			$with[] = 'cnor';
			$criteria->compare('cnor.tel', $this->cnor_tel, true);
		}

		if (!empty($this->consol_no)) {
			$with[] = 'consol';
			$criteria->compare('consol.no', $this->consol_no);
		}
		if (!empty($this->consol_eta)) {
			$with[] = 'consol';
			$criteria->compare('consol.eta', $this->consol_eta, true);
		}

		if (!empty($this->awb_name)) {
			$with[] = 'consol';
			$criteria->compare('consol.awb', $this->awb_name, true);
		}
		if (!empty($this->process_status)) {
			$with[] = 'process';
			$criteria->compare('process.status', $this->process_status);
			if($this->process_status<ShipmentProcess::DOCUMENT_CONFIRM)
			{
				$criteria->addInCondition('t.status < '.ImParcel::STATE_CLEAR);
			}
		}

		if (!empty($this->sea_process_status)) {
			$with[] = 'sea_process';
			$criteria->compare('sea_process.status', $this->sea_process_status);
		}
		if (!empty($this->process_statuses)) {
			$with[] = 'process';
			$criteria->addInCondition('process.status', $this->process_statuses);
		}
		if (!empty($this->process_not_status)) {
			$with[] = 'process';
			$criteria->addNotInCondition('process.status', $this->process_not_status);
		}
		if (!empty($this->process_doc_date)) {
			$with[] = 'process';
			$criteria->compare('process.date', $this->process_doc_date, true);
		}
		if (!empty($this->process_broker)) {
			$with[] = 'process';
			$criteria->compare('process.broker_id', $this->process_broker);
		}
		if (!empty($this->sea_process_not_in)) {
			$with[] = 'sea_process';
			$criteria->addNotInCondition('sea_process.status', $this->sea_process_not_in);
		}
		if (!empty($this->item_name)) {
			$criteria->compare('t.items', $this->item_name, true);
		}

		if ($ec) {
			$criteria->mergeWith($ec);
		}

		$sort = new CSort(get_called_class());
		$sort->attributes = [
			'cnor_name' => [
				'asc' => 'cnor.name',
				'desc' => 'cnor.name DESC',
			],
			'cnee_name' => [
				'asc' => 'cnee.name',
				'desc' => 'cnee.name DESC',
			],
			'cnee_addr' => [
				'asc' => 'cnee.address',
				'desc' => 'cnee.address DESC',
			],
			'process_doc_date' => [
				'asc' => 'process.date',
				'desc' => 'process.date DESC',
			],
			'awb_name' => [
				'asc' => 'consol.awb',
				'desc' => 'consol.awb DESC',
			],
			'agent_name' => [
				'asc' => 'agent.name',
				'desc' => 'agent.name DESC',
			],
			'consol_no' => [
				'asc' => 'consol.no',
				'desc' => 'consol.no DESC',
			],
			'consol_eta' => [
				'asc' => 'consol.eta',
				'desc' => 'consol.eta  DESC',
			],
			'meta' => [
				'asc' => 'meta',
				'desc' => 'meta DESC',
			],

			'*',
		];
		if ($defaultOrder) {
			$sort->defaultOrder = 't.id DESC';
		}
		$sob = $sort->getOrderBy();
		$sobs = preg_split('/, */', $sob);
		foreach ($sobs as $ob) {
			if (!strpos($ob, '.')) {
				continue;
			}
			list($m, $f) = explode('.', $ob);
			if (str_replace('`', '', $m) == 't') {
				continue;
			}
			$with[] = $m;
		}

		if (!empty($with)) {
			$criteria->with = array_unique($with);
			$criteria->together = true;
		}

		// in case sub-gridview, we need consol_id set by parent grid view
		$pagerparams = $_GET;
		if ($this->consol_id > 0) {
			$pagerparams['consoleId'] = $this->consol_id;
		}

		return new CActiveDataProvider($this, [
			'criteria' => $criteria,
			'sort' => $sort,
			'pagination' => $pgn ? [
				'pageSize' => $ps,
				'params' => $pagerparams,
			] : false,
		]);
	}

	public function checkCanEditWeight($d)//fastway havn't api to update weight
	{
		if(!empty($this->trans))
		{
			$etrans = $this->trans;
			$etrans = end($etrans);
			if (!empty($etrans) && in_array($etrans->org_id,[Org::ORGID_COURIER_EIZ_TOLL,Org::ORGID_COURIER_UBI_TOLL])) {
				if ($d->weight!=$this->weight) {
					return false;
				}
			}

			if ($d->weight<$this->weight) {
				$etrans = $this->trans;
				$etrans = end($etrans);
				if (!empty($etrans) && in_array($etrans->org_id,[Org::ORGID_COURIER_FASTWAY])&& $etrans->status > 10) {
					return false;
				}
			}
		}
		return true;
	}

	public function checkCanEditPkg($d=false)//fastway havn't api to update weight
	{
		if(!empty($this->trans))
		{
			$etrans = $this->trans;
			$etrans = end($etrans);
			if (!empty($etrans) && ($etrans->org_id == Org::ORGID_COURIER_EIZ_TOLL||$etrans->org_id == Org::ORGID_COURIER_UBI||$etrans->org_id == Org::ORGID_COURIER_TOLL_IPEC)) {
				if (empty($d))
				{
					return false;
				}
				if ($d->packs!=$this->pkg) {
					return false;
				}
			}
		}
		return true;
	}

	private function addCargoProcessPreAlertCriteria(&$criteria, &$with)
	{
		$podId = $this->cargoProcessPreAlert["podId"];
		$cargoType = $this->cargoProcessPreAlert["cargoType"];
		$pod = SystemSetting::getCargoProcessPodSetting($podId);
		$state = @$pod["postcode"];
		$with[] = 'consol';
		$criteria->addCondition("consol.id >0 and ((cargo_process.id is null or cargo_process.status = 101) and t.status < 90 and t.status != 62) ");
		$selectStateStr = "postcode like ";
		$sql ="";
		if (empty($state)) {
			$state = @$pod["state"];
			$selectStateStr = "state = ";
		}

		$state = "'".$state."'";

		$with[] = 'cargo_process';
		if ($cargoType == CargoProcess::PICKUP_CARGO) {
			$criteria->addCondition("consol.dpt_id = ".$podId);
		} elseif ($cargoType != 'all') {
			$with[] = 'cnee';
			$criteria->addCondition("cnee.{$selectStateStr} ".$state);
		}

		if ($cargoType==CargoProcess::NORMAL_CARGO) {
			$postcode = CargoProcess::FBAPOSTCODE;
			$criteria->addCondition("((json_value(t.meta,'$.cargo_pickup') is null or json_value(t.meta,'$.cargo_pickup') = 0) and (t.ref like 'ECN%' or t.ref like 'SKP%' or t.ref like 'MKP%' or t.ref like 'BKP%' or t.ref like 'PKP%')) or (json_value(t.meta,'$.cargo_delivery') = 1) ");
			$regionData = SystemSetting::getFBARegionSetting();
			$strCriterias = [];
			foreach ($regionData as $key => $pData) {
				foreach ($pData as $key => $rData) {
					foreach ($rData as $key => $value) {
						$address = strtoupper($value[0]);
						$suburb = strtoupper($value[1]);
						$words = explode(' ', $address);
						$words2 = [];
						foreach ($words as $key => $value) {
							$words[$key] = " upper(cnee.address) not like '%{$value}%' ";
							$words2[] =  " upper(cnee.address) like '%{$value}%' ";
						}
						$addressStr = join(' and ', $words);
						$addressStr2 = join(' and ', $words2);

						$strCriterias[] = " ((({$addressStr}) and upper(suburb) != '{$suburb}') or (({$addressStr}) and upper(suburb) = '{$suburb}') or (({$addressStr2}) and upper(suburb) != '{$suburb}')) ";
					}
				}
			}
			$fStrCriteria = join(" and ", $strCriterias);
			$criteria->addCondition(" cnee.postcode not in ({$postcode})  or ( cnee.postcode in ({$postcode}) and {$fStrCriteria} )");
		} elseif ($cargoType==CargoProcess::FBA_CARGO) {
			$postcode=CargoProcess::PUREFBAPOSTCODE;
			$this->addFBAB2BPreAlertCriteria($criteria, $postcode, "FBA");
		} elseif ($cargoType==CargoProcess::B2B_CARGO) {
			$postcode=CargoProcess::OVERSEAPOSTCODE;
			$this->addFBAB2BPreAlertCriteria($criteria, $postcode, "B2B");
		} elseif ($cargoType==CargoProcess::PICKUP_CARGO) {
			$criteria->addCondition(" json_value(t.meta,'$.cargo_pickup') = 1 or (t.ref like 'PICKUP%' and json_value(t.meta,'$.cargo_delivery') is null) ");
		} elseif ($cargoType == 'all') {
			$criteria->addCondition(" (json_value(t.meta,'$.cargo_pickup') = 1 or (t.ref like 'PICKUP%' and json_value(t.meta,'$.cargo_delivery') is null) ) or ((json_value(t.meta,'$.cargo_pickup') is null or json_value(t.meta,'$.cargo_pickup') = 0) and (t.ref like 'ECN%' or t.ref like 'TCN%' or t.ref like 'SKP%' or t.ref like 'MKP%' or t.ref like 'BKP%' or t.ref like 'PKP%')) or (json_value(t.meta,'$.cargo_delivery') = 1) ");
		}
	}

	private function addFBAB2BPreAlertCriteria(&$criteria, $postcode, $type)
	{
		$criteria->addCondition("((json_value(t.meta,'$.cargo_pickup') is null or json_value(t.meta,'$.cargo_pickup') = 0) and (t.ref like 'ECN%' or t.ref like 'TCN%' or t.ref like 'SKP%' or t.ref like 'MKP%' or t.ref like 'BKP%' or t.ref like 'PKP%')) or (json_value(t.meta,'$.cargo_delivery') = 1) ");

		$criteria->addCondition(" cnee.postcode in ({$postcode}) ");
		$regionData = SystemSetting::getFBARegionSetting($type);
		$strCriterias = [];
		foreach ($regionData as $key => $rData) {
			foreach ($rData as $key => $value) {
				$address = strtoupper($value[0]);
				$suburb = strtoupper($value[1]);
				$words = explode(' ', $address);
				foreach ($words as $key => $value) {
					$words[$key] = " upper(cnee.address) like '%{$value}%' ";
				}
				$addressStr = join(' and ', $words);
				$strCriterias[] = " ( ($addressStr) and upper(suburb) = '{$suburb}' ) ";
			}
		}
		$fStrCriteria = join(" or ", $strCriterias);
		$criteria->addCondition($fStrCriteria);
	}

	public function saveTracking($type, $act, $dpt='', $dt = '', $tid = 0, $srid = 0, $meta='')
	{
		$t = $this->getTracking($type);
		if ($t==false) {
			$this->addTracking($type, $act, $dpt, $dt, $tid, $srid, $meta);
		} else {
			$t->activity =  $act;
			$t->depot = $dpt;
			$t->dt = $dt;
			$t->update(["activity","depot","dt"]);
		}
	}

