	public function getShipmentInfoForBroker()
	{
		$msg = '';

		$isair = empty($this->consol) || $this->consol->service == 10;

		if ($isair) {
			$awb = preg_replace('/[^\d]+/', '', $this->consol->awb);
			$msg .= '<p>Air way Bill(Master): <b>' . $awb . '</b><p>';
			$msg .= '<p>House: <b>' . $this->hbn . '</b></p>';
			$msg .= '<p>Flight Number: <b>' . $this->consol->flight . '</b>   Airline: <b>' . $this->consol->airline . '</b></p>';
		} else {
			$msg .= '<p>Bill of Lading(Master): <b>' . $this->consol->awb . '</b><p>';
			$msg .= '<p>Sub-Master Bill: <b>' . @$this->consol->mdata['house_bill'] . '</b></p>';
			$msg .= '<p>House: <b>' . $this->hbn . '</b></p>';
			$msg .= '<p>Vessel ID: <b>' . $this->consol->airline . '</b>   Voyage: <b>' . $this->consol->flight . '</b></p>';
			$msg .= '<p>Cargo Type: <b>' . @$this->consol->mdata['cargo_type'] . '</b> Container Size: <b>' . DmawbConsol::getContainerCode($this->consol->mdata['sea_type']) . '</b></p>';
			$msg .= '<p>Container No: <b>' . @$this->consol->mdata['container_no'] . '</b> Seal No: <b>' . @$this->consol->mdata['sea_seal'] . '</b></p>';
		}
		$msg .= '<p>Origin Port: <b>' . $this->consol->pol . ' </b>  Destination Port:<b> ' . $this->consol->pod . '</b></p>';
		$msg .= '<p>ETA:<b>' . $this->consol->eta . '</b></p>';
		$msg .= '<p>Valuation date:<b>' . $this->consol->etd . '</b></p>';
		$msg .= '<p> consignor detail:<b> name:</b>' . $this->cnor->name . '  <b>Address:</b>' . $this->cnor->fullAddress() . '</p>';
		$msg .= '<p> consignee detail:<b> name:</b>' . ((empty($this->receiver->name) && empty($this->receiver->address)) ? $this->cnee->name : $this->receiver->name) . '  <b>Address:</b>' . ((empty($this->receiver->name) && empty($this->receiver->address)) ? $this->cnee->fullAddress() : $this->receiver->fullAddress()) . '</p>';
		return $msg;
	}

	public function getShipmentInfoForAqis()
	{
		$msg = '';
		$awb = preg_replace('/[^\d]+/', '', $this->consol->awb);
		$flightNo = $this->consol->flight;
		$eta = $this->consol->eta;

		$msg .= '<p>MAWB: ' . $awb . '</p>';
		$msg .= '<p>HAWB: ' . $this->hbn . '</p>';
		$msg .= '<p>Flight: ' . $flightNo . '</p>';
		$msg .= '<p>ETA: ' . $eta . '</p>';
		return $msg;
	}

	public function getDDPInfoforBroker()
	{
		if (!empty($this->process->mdata['inv_terms'])) {
			$str = '<p><b>Please apply ';
			foreach ($this->process->mdata['inv_terms'] as $term) {
				$str .= @ShipmentProcess::$inv_terms[$term] . ",";
			}
			$str .= " term for this one</b></p>";
			return $str;
		} elseif (($this->bwf & 64) > 0) {
			return "<p><b>Please apply DDP term for this one.</b></p>";
		}
		return '';
	}

	public function getDDUInfoforBroker()
	{
		if (($this->bwf & 128) > 0) {
			return "LOA from the consignee,";
		}
		return '';
	}

	public function getCourierInfo()
	{
		$data = [];
		$trans = $this->trans;
		
		if (preg_match('/AMQ\d{7}/i', $this->ref)) {
			$data = ['AuPost', 'https://auspost.com.au/track/', '137678',0,'AU'];
		} elseif (!empty($this->trans) && end($trans)->org_id == Org::ORGID_COURIER_STARTRACK) {
			$data = ['Startrack', 'https://startrack.com.au/', '132345',Org::ORGID_COURIER_STARTRACK,'ST'];
		} elseif (!empty($this->trans) && end($trans)->org_id == Org::ORGID_COURIER_D2Z) {
			$data = ['D2Z', '', '137678',Org::ORGID_COURIER_D2Z,'D2'];
		} elseif (!empty($this->trans) && end($trans)->org_id == Org::ORGID_COURIER_UBI) {
			$o = OrgRate::model()->findByPk($this->mdata['org_rate_id']);
			if(preg_match('/TOLL/i', $o->code))
			{
				$data = ['UBI', 'https://online.toll.com.au/trackandtrace/', '',Org::ORGID_COURIER_UBI,'TO'];
			}else
			{
				$data = ['UBI', 'https://auspost.com.au/track/', '',Org::ORGID_COURIER_UBI,'AU'];
			}
		} elseif (!empty($this->trans) && end($trans)->org_id == Org::ORGID_COURIER_FASTWAY) {
			$data = ['Fastway', 'https://www.fastway.com.au/', '',Org::ORGID_COURIER_FASTWAY,'FA'];
		} elseif (!empty($this->trans) && (in_array(end($trans)->org_id, [Org::ORGID_COURIER_TNT_TOP,Org::ORGID_COURIER_TNT]))) {
			$data = ['TNT', 'https://www.tnt.com', '',0,'TN'];
		} elseif (!empty($this->trans) && end($trans)->org_id == Org::ORGID_COURIER_HUNTER) {
			$data = ['Hunter', 'https://www.hunterexpress.com.au', '',0,'HU'];
		}elseif (!empty($this->trans) && end($trans)->org_id == Org::ORGID_COURIER_SF) {
			$data = ['SF', 'https://www.sf-express.com', '',0,'SF'];
		} elseif (!empty($this->trans) && (in_array(end($trans)->org_id, [Org::ORGID_COURIER_DFE_TOP,Org::ORGID_COURIER_DFE]))) {
			$data = ['TLA', 'https://www.toplogistics.com.au', '',0,'KP'];
		} elseif (preg_match('/^AWNL\d{7}|^AWNL\d{6}/', $this->ref) || preg_match('/^AWUJ\d{7}|^AWUJ\d{6}/', $this->ref)) {
			$data = ['Toll', 'https://online.toll.com.au/trackandtrace/', '',0,'TO'];
		}elseif (!empty($this->trans) && end($trans)->org_id == Org::ORGID_COURIER_EIZ) {
			$o = OrgRate::model()->findByPk($this->mdata['org_rate_id']);
			if(in_array($o->code, ImportChargeCode::EIZ_TOLL_CODES))
			{
				$data = ['Toll', 'https://online.toll.com.au/trackandtrace/', '',Org::ORGID_COURIER_EIZ,'TO'];
			}else
			{
				$data = ['Allied', 'https://www.toplogistics.com.au/', '',Org::ORGID_COURIER_EIZ,'AL'];
			}
		}elseif (!empty($this->trans) && end($trans)->org_id == Org::ORGID_COURIER_TOLL_IPEC) {
			$data = ['Toll', 'https://online.toll.com.au/trackandtrace/', '',Org::ORGID_COURIER_TOLL_IPEC,'TO'];
		} else {
			$data = ['TLA', 'https://www.toplogistics.com.au/', '02-99257111',Org::ORGID_COURIER_TOLL_IPEC,'KP'];
		}
		return $data;
	}

	/***
	 * get the Parcel dimesions
	 * @return  [['height'=>10,'width':'10',length:'10']];
	 */
	public function getPackDimensions()
	{
		if (is_array($this->packs) && sizeof($this->packs) == $this->pkg) {
			foreach ($this->packs as $onePack) {
				$dim[] = [
					'height' => isset($onePack['height']) ? $onePack['height'] : 1,
					'length' => isset($onePack['length']) ? $onePack['length'] : 1,
					'width' => isset($onePack['width']) ? $onePack['width'] : 1,
				];
			}
		} else {
			$volume = $this->cbm > 0 ? $this->cbm * 1000000 : ($this->weight / ($this->pkg * 250)) * 1000000;
			$length = number_format(pow($volume, 1 / 3), 0, '', '');
			for ($index = 0; $index < $this->pkg; $index++) {
				$dim[] = [
					'height' => $length,
					'length' => $length,
					'width' => $length,
				];
			}
		}
		return $dim;
	}

	public function updateUnScan($up = false)
	{
		$this->scan_no = $this->pkg - $this->scanCount();
		if ($up) {
			$this->update('scan_no');
		}
	}

	public function createAuPostLabel($mild, $rate_id = 0)
	{
		$orgRate = OrgRate::model()->findByPk($rate_id);
		$code = $orgRate->code;
		$serviceCode = AusPostAPI::EPARCEL_CODE;
		//find international service
		if($code == ImportChargeCode::AUPOST_INTERNATIONAL_CODE)
		{
			$apa = new AusPostAPI('syd', true, false);
			$r = $apa->createIntShipments($this);
			if(empty($r->shipments[0]->shipment_id))
			{	
				return false;
			}
			$this->mdata['ap_sid'] = $r->shipments[0]->shipment_id;
			$this->ref = $r->shipments[0]->items[0]->tracking_details->article_id;
			$r2 = $apa->createLabels($this->mdata['ap_sid']);
			$this->mdata['ap_lbls'] = [];
			$this->mdata['aupost_int'] = 1;
			foreach($r2->labels as $lbl){
				$this->mdata['ap_lbls'][] = $lbl->request_id;
			}
			$this->nolog = true;
			$this->cbwf = $this->cbwf|self::CBWF_FOR_3PL;
			$this->mdata['org_rate_id'] = $rate_id;
			$this->update(['ref','note','cbwf']);
			$this->updateMeta();
			$this->nolog = false;
			return true;

		}else if($code == ImportChargeCode::AUPOST_EXPRESS_CODE)//find express service
		{
			$serviceCode = AusPostAPI::EXPRESS_CODE;
			$this->mdata['aupost_exp'] = 1;
			$this->cbwf = $this->cbwf|self::CBWF_FOR_3PL;
			$this->ref = self::genEparcelNo();
			$this->mdata['org_rate_id'] = $rate_id;

		}else if($code == ImportChargeCode::AUPOST_RETURN_CODE)//find return service
		{
			// $p->nolog = true;
			$this->mdata['aupost_return'] = 1;
			$this->cbwf = $this->cbwf|self::CBWF_FOR_3PL;
			$this->ref = self::genEparcelNo();
			$this->mdata['org_rate_id'] = $rate_id;
		}else
		{
			if ($mild == 'UWQ') {
				$gva = new GlobavendAPI;
				$res = $gva->createOrder($this);
				if (!empty($res['orderResult']) && $res['orderResult'][0]['status'] == 'succeed') {
					preg_match('/^019931265099999891(\w{3,5}\d{7})(\d{11})$/', $res['orderResult'][0]['trackingNumber'], $m);
					$this->ref = $m[1];
					$this->mdata['article_id'] = $m[1].$m[2];
					$this->mdata['gv_oid'] = $res['orderResult'][0]['orderNumber'];
					$this->nolog = true;
					$this->update(['ref','note']);
					$this->updateMeta();
					$this->nolog = false;
					$gva->getLabel($this);
					return true;
				}
				return false;
			}

			if ($mild == '33MBQ') {
				$apa = new AusPostAPI('ecof');
				$result = $apa->createShipments($this);
				if ($result && isset($result->shipments) && is_array($result->shipments)) {
					$apa->createLabels($result->shipments[0]->shipment_id);
					$this->mdata['ap_sid'] = $result->shipments[0]->shipment_id;
					$this->mdata['test_aupost_2017']=1;
					$this->ref = $result->shipments[0]->items[0]->tracking_details->consignment_id;
					$this->note = $result->shipments[0]->items[0]->tracking_details->article_id;
					$this->nolog = true;
					$this->update(['ref','note']);
					$this->updateMeta();
					$this->nolog = false;
					return true;
				}
				return false;
			}	

			$corg = 101;
			if($mild == 'AMQ' && $this->agent_id == 1206 && !in_array($this->mdata['chargecode'], [1791])) { //stonebridge
				$mild = "333UF";
				$corg = 1206;
			}
			if(empty($this->ref)){
				$this->ref = self::genEparcelNo($corg, $mild);
			}elseif(!empty($rate_id)){
				$rate = OrgRate::model()->findByPk($rate_id);
				if(!empty($rate->mdata['mlids'])){
					$mlids = preg_split('/[,; ]+/', trim($rate->mdata['mlids']));
					$valid = false;
					foreach($mlids as $mlid){
						if(preg_match('/^'.$mlid.'/', $this->ref)){
							$valid = true;
							break;
						}
					}
					if(!$valid) return false;
				}
			}

		}
		$this->nolog = true;
		$this->mdata['test_aupost_2017']=1;
		$aid = $this->ref.sprintf('%02s', 1).$serviceCode.'50'.'0';
		$aid .= AusPostAPI::aidChkDgt($aid);
		$this->note = $aid;
		$this->update(['ref','note','cbwf']);
		$this->mdata['org_rate_id'] = $rate_id;
		$this->mdata['article_id'] = $aid;
		$this->updateMeta();
		$this->nolog = false;
		return true;
	}

