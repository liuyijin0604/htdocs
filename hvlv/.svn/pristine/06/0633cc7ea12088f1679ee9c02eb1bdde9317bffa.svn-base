	public function createSFLabel($orgRateId,$type = 'syd')
	{
		$this->mdata['org_id'] = Org::ORGID_COURIER_SF;
		$this->mdata['org_rate_id'] = $orgRateId;
		$orgRate = OrgRate::model()->findByPk($orgRateId);
		$sfAPi = new SFAPI(false,false,'',$orgRate,$orgRate->mdata['api_type']);
		$ref = $sfAPi->getShipmentRefs($this->pkg);
		if(!empty($ref['count']==$this->pkg))
		{
			$cost =  $sfAPi->getCost($orgRateId,$this);
			$subRefs = $ref['subRef'];
			$barcode = join(',',$subRefs);
			if($barcode=="")
			{
				$barcode=$ref['mainRef'];
			}else
			{
				$barcode=$ref['mainRef'].','.$barcode;
			}
			$this->ref = $ref['mainRef'];
			$this->mdata['barcode'] = $barcode;
			$barcodes = explode(',', $barcode);
			foreach ($barcodes as $key => $barcode) {
				$pb = new ParcelBarcode();
				$pb->main_ref = $this->ref;
				$pb->fid = $this->id;
				$pb->sub_ref = $barcode;
				$pb->sn = $key+1;
				$pb->save();
			}
			$ts = new Tranship;
			$ts->pid = $this->id;
			$ts->org_id = Org::ORGID_COURIER_SF; // for StarTrack
			$ts->man_id = $this->man_id;
			$ts->type = 80; // shipment transfer to a different delivery courier
			$ts->status = 19; // in finally moving status
			$ts->connote = $this->ref;
			$ts->time = date('Y-m-d H:i:s');
			$ts->cost = round($cost, 2);
			$ts->save();
		}else
		{
			return false;
		}
		$this->save();
		return true;
	}
	public function createUbiLabel($orgRate, $facility = false)
	{
		if(preg_match('/TOLL/i', $orgRate->code))
		{
			return LabelService::createUbiTollLabel($this,$orgRate, $facility);
		}elseif(preg_match('/BORDER/i', $orgRate->code))
		{
			return LabelService::createUbiBorderLabel($this,$orgRate, $facility);
		}elseif(preg_match('/ALLIED/i', $orgRate->code))
		{
			return LabelService::createUbiAlliedLabel($this,$orgRate, $facility);
		}else
		{
			return LabelService::createUbiAuspostLabel($this,$orgRate, $facility);
		}
	}

	public function createAUKTollLabel($orgRate)
	{
		if ($this->id <= 0) {
			return false;
		}
		$aukAPI = AukAPI::getAPIInstance($orgRate->id);
		$result = $aukAPI->createShipment($this);

		if(is_array($result)){
			if(!$result['success'])
			{
				$this->tempErrors = $result['error'];
				return false;
			}else
			{
				$ref=$result["consignment_no"];
				$barcodes = $result["articles"];
				$this->ref = $ref;
				$this->nolog = true;
				$this->mdata['org_rate_id'] = $orgRate->id;
				$this->mdata['org_id'] = $orgRate->org_id;
				$this->mdata['barcode'] = join(',',$barcodes);
				$this->update('ref', 'note', 'meta');
				foreach ($barcodes as $key => $barcode) {
						$pb = new ParcelBarcode();
						$pb->main_ref = $this->ref;
						$pb->fid = $this->id;
						$pb->sub_ref = $barcode;
						$pb->sn = $key+1;
						$pb->save();
				}
				// give two chance for saving the tranship
				if (Tranship::saveOneTranship(Org::ORGID_COURIER_AUK,$this->id,$this->ref)) {
					return true;
				}else
				{
					if (Tranship::saveOneTranship(Org::ORGID_COURIER_AUK,$this->id,$this->ref)) {
					return true;
					}else
					{
						return false;
					}
				}
				return false;
			}
		}else {
			$this->tempErrors = $result['error'];
			return false;
		}
		return false;
	}

