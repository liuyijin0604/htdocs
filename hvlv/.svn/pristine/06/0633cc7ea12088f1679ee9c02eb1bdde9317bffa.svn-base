	public function addCargoTracking($type, $act, $dpt='', $dt = '', $tid = 0, $srid = 0, $meta='',$cargoProcessId = false)//overwriting the parents
	{
		$dt = empty($dt)? date('Y-m-d H:i:s') : $dt;
		if(!empty($cargoProcessId))
		{
			$t = Tracking::model()->find('pid = :pid AND dt = :dt AND type = :type AND json_value(t.meta,"$.cargo_process_id") = :cid', [':pid' => $this->id, ':dt' => $dt, ':type' => $type,':cid'=>$cargoProcessId]);
		}else
		{
			$t = Tracking::model()->find('pid = :pid AND dt = :dt AND type = :type', [':pid' => $this->id, ':dt' => $dt, ':type' => $type]);
		}
		if ($t) {
			return $t;
		}
		$t = new Tracking('create');
		$t->pid = $this->id;
		$t->tid = $tid;
		$t->srid = $srid;
		$t->dt = $dt;
		$t->activity = $act;
		$t->depot = $dpt;
		$t->type = $type;
		$t->meta = $meta;
		$t->save();
		return $t;
	}

