	public function connectingDeliveryAddress()
	{
		$thisAddress = $this->cnee->address.", ".$this->cnee->suburb.", ".$this->cnee->state." ".$this->cnee->postcode;
		foreach (DmawbConsol::$cargo_receip_address as $key => $address) {
			$fullAddress= explode(': ', $address)[1];
			$addressArr = explode(', ', $fullAddress);
			$check =true;
			foreach ($addressArr as $key2 => $info) {
				$valueArr  = explode(' ', $info);
				$value = join('[\s]*',$valueArr);
				$value = str_replace("/", "\/", $value);
				if(!preg_match('/'.$value.'/i', $thisAddress))
				{
					$check = false;
					break;
				}
			}
			if($check)
			{
				$this->mdata['delivery_address'] = $key;
				$this->mdata['cargo_receipt_addr'] = $address;
			}
		}
	}

