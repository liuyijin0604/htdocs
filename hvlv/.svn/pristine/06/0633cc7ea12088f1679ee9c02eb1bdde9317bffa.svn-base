	public function createDfeLabel($orgRate,$type)
	{
		if ($this->id <= 0) {
			return false;
		}

		$orgRate = OrgRate::model()->find("id = :id",[":id"=>$orgRate]);
		//$dfeapi = new DFEAPI($type);
		if (empty($this->ref)) 
		{
			if(!preg_match('/^(ECN|TCN|TSN|TMN|TBN|TAN|TPN|TFN)/', $this->hbn))
			{
				$hbn = $this->genHbn();
			}else
			{
				$hbn = $this->hbn;
			}

			switch ($orgRate->mdata['ddpt_id']) 
			{
				case Org::PCAE_DEPARTMENT_MELBOURNE:
					$pfx = 'MHD';
				break;
				case Org::PCAE_DEPARTMENT_BRISBANE: //bne
					$pfx = 'BHD';
				break;
				default: 
					$pfx = 'SHD';
				break;
			}
			$this->ref = preg_replace('/^(ECN|TCN|TSN|TMN|TBN|TAN|TPN|TFN)/', $pfx, $hbn);
			//$this->mdata['connote_date'] = date('Y-m-d')."T00:00:00".date('O');
		}

		// $this->mdata['org_rate_id'] = $orgRate->id;
		// $this->mdata['org_id'] = $orgRate->org_id;
		$this->nolog = true;
		$this->update('ref', 'meta');
		$this->nolog = false;

		$ts = new Tranship;
		$ts->pid = $this->id;
		$ts->org_id = $orgRate->org_id;
		$ts->type = 80;

		$ts->status = 10;
		$ts->connote = $this->ref;
		$ts->time = date('Y-m-d H:i:s');
		$ts->cost = 0;
		return $ts->save();
	}

	public function createEizLabel($orgRate,$type)
	{
		if ($this->id <= 0) {
			return false;
		}

		$orgRate = OrgRate::model()->find("id = :id",[":id"=>$orgRate]);
		$eizapi = new EizAPI($type);
		if (empty($this->ref)) {
			$result = $eizapi->createShipment($this);
			if(empty($result)||empty($result->data))
			{
				return false;
			}
			$resultData = $result->data[0];
			$barcodes = [];
			$myRef= "";
			$cdd = json_encode($resultData->label);
			$cddArr = json_decode($cdd,true);
			foreach ($cddArr as $key => $l) {
				foreach ($l as $lvk => $lv) {
					if(!in_array($lvk,["id","consignment_id","labelNumber","url","data"])) unset($cddArr[$key][$lvk]);
				}
				$barcodes[] = $l['labelNumber'];
				$myRef = $l['labelNumber'];
				$cddArr[$key]['url'] = str_replace('https://s3.ap-southeast-2.amazonaws.com/eiz.labels/labels/', '', $l['url']);
			}
			if(preg_match('/border/i', $orgRate->code))
			{
				[$barcodes,$header] = $eizapi->getLabelBarcodes($this);
				$resultData->border_header = $header;
			}
			$lArr = json_encode($cddArr);
			$resultData->label = json_decode($lArr);
			if(in_array($orgRate->code,ImportChargeCode::EIZ_TOLL_CODES))
			{
				$this->ref = $resultData->remoteConsignment_id;
			}else
			{
				$this->ref = $myRef;
			}
			$this->mdata['eiz'] = $resultData;
			$this->mdata['eiz_id'] = $resultData->id;
			$this->mdata['barcode'] = join(',',$barcodes);
			foreach ($barcodes as $key => $barcode) {
				$pb = new ParcelBarcode();
				$pb->main_ref = $this->ref;
				$pb->fid = $this->id;
				$pb->sub_ref = $barcode;
				$pb->sn = $key+1;
				$pb->save();
			}
		}
		
		$this->mdata['org_rate_id'] = $orgRate->id;
		$this->mdata['org_id'] = $orgRate->org_id;
		$this->nolog = true;
		$this->update('ref', 'meta');
		$this->nolog = false;

		$ts = new Tranship;
		$ts->pid = $this->id;
		$ts->org_id = $orgRate->org_id;
		$ts->type = 80;
		$ts->status = 10;
		$ts->connote = $this->ref;
		$ts->time = date('Y-m-d H:i:s');
		$ts->cost = 0;
		return $ts->save();
	}

