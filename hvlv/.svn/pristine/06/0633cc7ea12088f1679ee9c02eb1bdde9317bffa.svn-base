	public function isRealAQIS()
	{
		if(($this->bwf&ImParcel::AQISCODE)>0)
		{
			$heldTime = null;
			$clearTime = date("Y-m-d H:i:s");
			$logs = $this->logs;
			foreach ($logs as $key => $log) {
				if($log->extra['status']=='Held')
				{
					$heldTime = $log->time;
					break;
				}
			}
			rsort($logs);

			foreach ($logs as $key => $log) {
				if($log->extra['status']=='Held')
				{
					break;
				}
				if(preg_match("/Clear/i", $log->extra['status'])||preg_match("/Duty Held/i", $log->extra['status']))
				{
					$heldTime = $log->time;
				}
			}
			if(empty($heldTime))
			{
				return false;
			}
			$diff = floor((strtotime($clearTime)-strtotime($heldTime))/3600);
			return $diff>12;
		}
		return false;
	}

	public function getStorageWarning()
	{
		if(($this->bwf&self::CUSTOM_DDP)>0)
		{
			$storageStartDate = $this->getStorageStartDate();
		}

		if(($this->bwf&self::CUSTOM_DDU)>0)
		{
			$storageStartDate = $this->process->getStorageStartDate();
		}
		if(empty($storageStartDate)) return false;

		$outTime = new DateTime('now', new DateTimeZone('Australia/Sydney'));
		$strTime = new DateTime($storageStartDate, new DateTimeZone('Australia/Sydney'));

		if(strtotime($outTime->format('Y-m-d'))>strtotime($strTime->format('Y-m-d')))
		{
			return true;
		}

		$storedDays = $strTime->diff($outTime)->format("%a");

		if($storedDays<=3)
		{
			return true;
		}

	}

