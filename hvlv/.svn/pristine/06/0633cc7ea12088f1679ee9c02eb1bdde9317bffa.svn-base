	public function canBeUpdated()
	{
		if(empty($this->mdata['org_rate_id']))
		{
			return false;
		}
		$orgRateId = $this->mdata['org_rate_id'];
		$orgRate = OrgRate::model()->findByPk($orgRateId);
		if($orgRate->org_id==Org::ORGID_COURIER_TLA||$orgRate->org_id==Org::ORGID_COURIER_EIZ||$orgRate->org_id==Org::ORGID_COURIER_UBI_TOLL||$orgRate->org_id==Org::ORGID_COURIER_TOLL_IPEC)
		{
			if($this->status!=ImParcel::NEW_STATUS&&$this->status!=ImParcel::STATE_LOCAL_ARRIVAL)
	        {
	        	return false;
	        }
			if(!empty($this->mdata['eiz_id'])||!empty($this->mdata['etower_shipment_orderid']))
	        {
	            return false;
	        }

	        if (!empty($this->trans)) {
				foreach ($this->trans as $ts) {
					if ($ts->connote != $this->ref) {
						continue;
					}
					if (!empty($ts->mdata['oid'])) {
						return false;
					}
				}
			}

	        return true;
    	}else
    	{
    		return false;
    	}
		
	}

	public function getArrayMondayAndThursday(){
		$result = [];
		$cargoprocessDate = CargoProcess::model()->findBySql('select * from cargo_process where status !=101 and shipment_id ='.$this->id)->started;
		$unloadingDate = empty($this->consol->mdata["ContainerUnloadDate"])? date('Y-m-d',strtotime($cargoprocessDate)):$this->consol->mdata["ContainerUnloadDate"];
		if(!empty($unloadingDate)){
			if(!empty($this->mdata["delivery_booking_time"])){
				$result[date('Y-m-d',strtotime($this->mdata["delivery_booking_time"]))] = date('Y-m-d',strtotime($this->mdata["delivery_booking_time"]));
			}else{
				$today = date("w",strtotime($unloadingDate));
				switch($today){
					case 1:
						if (date('Y-m-d',strtotime("this week Wednesday",strtotime($unloadingDate)))>date('Y-m-d')){
							$result[date('Y-m-d',strtotime("this week Wednesday",strtotime($unloadingDate)))]=date('Y-m-d',strtotime("this week Wednesday",strtotime($unloadingDate)));
						} 	
						if (date('Y-m-d',strtotime("this week Friday",strtotime($unloadingDate)))>date('Y-m-d')){
							$result[date('Y-m-d',strtotime("this week Friday",strtotime($unloadingDate)))]=date('Y-m-d',strtotime("this week Friday",strtotime($unloadingDate)));
						}
						if (date('Y-m-d',strtotime("next week Monday",strtotime($unloadingDate)))>date('Y-m-d')){
							$result[date('Y-m-d',strtotime("next week Monday",strtotime($unloadingDate)))]=date('Y-m-d',strtotime("next week Monday",strtotime($unloadingDate)));
						}
						break;
					case 2:	
					case 3:
						if (date('Y-m-d',strtotime("this week Friday",strtotime($unloadingDate)))>date('Y-m-d')){
							$result[date('Y-m-d',strtotime("this week Friday",strtotime($unloadingDate)))]=date('Y-m-d',strtotime("this week Friday",strtotime($unloadingDate)));
						} 	
						if (date('Y-m-d',strtotime("next week Monday",strtotime($unloadingDate)))>date('Y-m-d')){
							$result[date('Y-m-d',strtotime("next week Monday",strtotime($unloadingDate)))]=date('Y-m-d',strtotime("next week Monday",strtotime($unloadingDate)));
						}
						if (date('Y-m-d',strtotime("next week Wednesday",strtotime($unloadingDate)))>date('Y-m-d')){
							$result[date('Y-m-d',strtotime("next week Wednesday",strtotime($unloadingDate)))]=date('Y-m-d',strtotime("next week Wednesday",strtotime($unloadingDate)));
						}
						break;
					case 4:
						//$result[$today]=$today;
						if (date('Y-m-d',strtotime("next week Monday",strtotime($unloadingDate)))>date('Y-m-d')){
							$result[date('Y-m-d',strtotime("next week Monday",strtotime($unloadingDate)))]=date('Y-m-d',strtotime("next week Monday",strtotime($unloadingDate)));
						}
						if (date('Y-m-d',strtotime("next week Wednesday",strtotime($unloadingDate)))>date('Y-m-d')){
							$result[date('Y-m-d',strtotime("next week Wednesday",strtotime($unloadingDate)))]=date('Y-m-d',strtotime("next week Wednesday",strtotime($unloadingDate)));
						}
						if (date('Y-m-d',strtotime("next week Friday",strtotime($unloadingDate)))>date('Y-m-d')){
							$result[date('Y-m-d',strtotime("next week Friday",strtotime($unloadingDate)))]=date('Y-m-d',strtotime("next week Friday",strtotime($unloadingDate)));
						}
						break;
					case 5:
					case 6:
					case 0:
						//$result[$today]=$today;	
						if(date('Y-m-d',strtotime("next week Wednesday",strtotime($unloadingDate)))>date('Y-m-d')){
							$result[date('Y-m-d',strtotime("next week Wednesday",strtotime($unloadingDate)))]=date('Y-m-d',strtotime("next week Wednesday",strtotime($unloadingDate)));
						}
						if(date('Y-m-d',strtotime("next week Friday",strtotime($unloadingDate)))>date('Y-m-d')){
							$result[date('Y-m-d',strtotime("next week Friday",strtotime($unloadingDate)))]=date('Y-m-d',strtotime("next week Friday",strtotime($unloadingDate)));
						}
						if(date('Y-m-d',strtotime("+2 week last monday",strtotime($unloadingDate)))>date('Y-m-d')){
							$result[date('Y-m-d',strtotime("+2 week last monday",strtotime($unloadingDate)))]=date('Y-m-d',strtotime("+2 week last monday",strtotime($unloadingDate)));
						}
						break;	
				}
			}
			return $result;
		}else{
			return $result;
		}
	}

	public function getUnPackingDate(){
		$result ="";
		$model = CargoProcess::model()->find('shipment_id=:shipment_id',[':shipment_id'=>$this->id]);
		if(!empty($model)){
			$result= date('Y-m-d',strtotime($model->started));
		}elseif(!empty($this->consol->mdata["ContainerUnloadDate"])){
			$result = $this->consol->mdata["ContainerUnloadDate"];
		}
		return $result;
	}

	public function isB2bShipment(){
		$match = false;
		if (strpos(CargoProcess::OVERSEAPOSTCODE,$this->cnee->postcode)!==false) {
			$regionData = SystemSetting::getFBARegionSetting("B2B");
			$regionData = $regionData[$this->cnee->postcode];
			if(!empty($regionData))
			{
				foreach ($regionData as $key => $value) {
					$words = explode(' ', $value[0]);
					$thisMatch = true;
					foreach ($words as $key => $word) {
						$word = str_replace('/', '\/', $word);
						if(!(preg_match("/".strtoupper($word)."/",  strtoupper($this->cnee->address))&&(strtoupper(trim($value[1])) == strtoupper(trim($this->cnee->suburb)))))
						{
							$thisMatch =false;
							break;
						}
					}
					if($thisMatch)
					{
						$match = true;
						break;
					}
				}
			}
		}
		return $match;
	}

	public function isFbaShipment(){
		$match = false;
		if (strpos(CargoProcess::PUREFBAPOSTCODE, $this->cnee->postcode) !== false) {
			$regionData = SystemSetting::getFBARegionSetting("FBA");
			$regionData = $regionData[$this->cnee->postcode];
			if (!empty($regionData)) {
				foreach ($regionData as $key => $value) {
					$words = explode(' ', $value[0]);
					$thisMatch = true;
					foreach ($words as $key => $word) {
						$word = str_replace('/', '\/', $word);
						if (!empty($word)) {
							if (!(preg_match("/" . strtoupper($word) . "/",  strtoupper($this->cnee->address)) && (strtoupper(trim($value[1])) == strtoupper(trim($this->cnee->suburb))))) {
								$thisMatch = false;
								break;
							}
						}
					}
					if ($thisMatch) {
						$match = true;
						break;
					}
				}
			}
		}
		return $match;
	}

	public function getPreCargoProcessType(){
		if (!empty($this->cnee->postcode)) {
			if (strpos(CargoProcess::FBAPOSTCODE, $this->cnee->postcode) !== false) {
				$match = false;
				if (strpos(CargoProcess::PUREFBAPOSTCODE, $this->cnee->postcode) !== false) {
					$type = CargoProcess::FBA_CARGO;
					$regionData = SystemSetting::getFBARegionSetting("FBA");
					$regionData = $regionData[$this->cnee->postcode];
					if (!empty($regionData)) {
						foreach ($regionData as $key => $value) {
							$words = explode(' ', $value[0]);
							$thisMatch = true;
							foreach ($words as $key => $word) {
								$word = str_replace('/', '\/', $word);
								if (!empty($word)) {
									if (!(preg_match("/" . strtoupper($word) . "/",  strtoupper($this->cnee->address)) && (strtoupper(trim($value[1])) == strtoupper(trim($this->cnee->suburb))))) {
										$thisMatch = false;
										break;
									}
								}
							}
							if ($thisMatch) {
								$match = true;
								break;
							}
						}
						if (!$match) {
							$type = CargoProcess::NORMAL_CARGO;
						}
					}
				}

				if (strpos(CargoProcess::OVERSEAPOSTCODE, $this->cnee->postcode) !== false && !$match) {
					$type = CargoProcess::B2B_CARGO;
					$regionData = SystemSetting::getFBARegionSetting("B2B");
					$regionData = $regionData[$this->cnee->postcode];
					if (!empty($regionData)) {
						$match = false;
						foreach ($regionData as $key => $value) {
							$words = explode(' ', $value[0]);
							$thisMatch = true;
							foreach ($words as $key => $word) {
								$word = str_replace('/', '\/', $word);
								if (!(preg_match("/" . strtoupper($word) . "/",  strtoupper($this->cnee->address)) && (strtoupper(trim($value[1])) == strtoupper(trim($this->cnee->suburb))))) {
									$thisMatch = false;
									break;
								}
							}
							if ($thisMatch) {
								$match = true;
								break;
							}
						}
						if (!$match) {
							if($this->scanCount()>0){
								$type = CargoProcess::NORMAL_CARGO;
							}
						}
					}
				}
			} else {
				$type = CargoProcess::NORMAL_CARGO;
			}
		}
		//Interstate
		if(!empty($this->cnee->state)){
			$state = "";
			if(!empty($this->consol->dpt_id)){
				$state = Org::model()->findByPk($this->consol->dpt_id)->state;
			}else{
				$state = $this->cnor->state;
			}
			if(!empty($state)){
				if(strtoupper($state)!=strtoupper($this->cnee->state)){
					$type = CargoProcess::INTERSTATE_CARGO;
				}
			}
		}

		return $type;
	}

	public function getInterStatePartRevenue(){
		$numRevenue = 0;
		if(!empty($this->cargo_process)&&isset($this->mdata['interstatechargecode'])){
			$numRevenue = $this->cargo_process->getInterstateRevenue();
		}
		return $numRevenue;
	}

	public function getCargoProcessType()
	{
		if ($this->checkIsCargoProcessWithRef())
		{	
			$cargoProcess = new CargoProcess();
			$cargoProcess->shipment_id = $this->id;
			if ($this->isParcelPickup()) {
				$cargoProcess->type = CargoProcess::PICKUP_CARGO;
			} else {
				$cargoProcess->setCargoType();
			}
		}
		return $cargoProcess->type;
	}

}
