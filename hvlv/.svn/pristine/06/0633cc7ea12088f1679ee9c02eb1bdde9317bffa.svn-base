	/**
	 * create AusLetter label
	 * @param $shipment
	 */
	public function createAusLetterLabel()
	{
		$type = ImParcel::$letter_types;  //['small letter','Large Letters up to 125g','Large Letters 125g-250g','Large Letters 250g-500g'];
		$dim = [];
		$dim[] = floatval($this->mdata['dim']['h']);
		$dim[] = floatval($this->mdata['dim']['w']);
		$dim[] = floatval($this->mdata['dim']['d']);
		asort($dim);
		$tmp=[];
		$typeTemp=0;
		foreach ($dim as $value) {
			$tmp[]=$value;
		}
		$weight=$this->weight;
		// later we may need to consider more on the width, length, as h<=0.5 don't mean it's a small letter.
		$suff = 'L';
		if ($tmp[0]<=0.5&&$tmp[1]<=13&&$tmp[2]<=24&&($this->getLetterService()!=1)) {
			if ($weight<=0.250) {
				$this->note=$type[1];
				$typeTemp=1;
				$suff = 'S';
			} else {
				$this->note=$type[8];
				$typeTemp=8;
			}
		} else {
			if ($weight<=0.125) {
				$this->note=$type[2];
				$typeTemp=2;
			} elseif ($weight<=0.250) {
				$this->note=$type[4];
				$typeTemp=4;
			} else {
				$this->note=$type[8];
				$typeTemp=8;
			}
		}
		if (!empty($this->mdata['chargecode']) && ImportChargeCode::isPriorityLetter($this->mdata['chargecode'])) {
			$typeTmpe *= 16;
			$suff = 'P'.$suff;
		}
		$this->ref = 'LET'.sprintf('%07s', substr($this->id, -7)).$suff;
		$this->mdata['letter_aupost'] =$typeTemp;
		// $this->cbwf=$this->cbwf|$typeTemp;
		$this->nolog = true;
		$this->update(['ref','note','cbwf']);
		$this->updateMeta();
		$this->nolog = false;
		return true;
	}

	public static function getCourierCostByShipments($weight, $postcode, $courierId = Org::ORGID_COURIER_FASTWAY, $m = false)
	{

		// make it fast we hardcode here currently
		$orgRates = [
			Org::ORGID_COURIER_FASTWAY => 52, // you can get this id from Org -> Rates Tab -> Flex Rate by Zone hypelink will including this id
			Org::ORGID_COURIER_AUPOST => 101,
		];
		$orate = OrgRate::model()->findByPk($orgRates[$courierId]);
		$price = 0;
		if ($m && $courierId == 101) {
			$ap = new AusPostAPI('syd', false);
			$weight = sprintf('%.02f', $ap->getBreakWeight($weight));
		}
		if ($m && $courierId == 115) {
			$fw = new FastwayAPI();
			$weight = sprintf('%.02f', $fw->roundWeight($weight));
		}

		// base on postcode to get related charge code
		$zoneMap = ZoneMap::model()->find(
			'org_id = :oid AND zone_id = :zoneid AND pc_lo <= :code AND pc_hi >= :code',
			[':oid' => $courierId, ':zoneid' => $orate->zone_id, ':code' => $postcode]
		);

		// if not found we set as NSW country
		$chargeCode = 'N1';
		if (!empty($zoneMap) && !empty($zoneMap['z1'])) {
			$chargeCode = $zoneMap['z1'];
		}

		// base charge code to get zone rate
		$zrs = ZoneRate::model()->findAll(
			"zone = :s AND (weight_lo < :w AND weight_hi >= :w) AND rate_id = :rateid AND base+item+perkg > 0 ",
			[':s' => $chargeCode, ':w' => $weight, ':rateid' => $orgRates[$courierId]]
		);

		if (!empty($zrs)) {

			// get maximum one
			foreach ($zrs as $zr) {
				$temp = $zr['base'] + $zr['item'];
				if ($zr['nkg'] > 0) {
					$wl = $weight - ($zr['base'] > 0 ? $zr['nkg'] : 0);
					$temp += ceil($wl / $zr['nkg']) * $zr['perkg'];
				} else {
					$temp += $weight * $zr['perkg'];
				}
				if ($zr['minimum'] > 0 && $temp < $zr['minimum']) {
					$temp = $zr['minimum'];
				}
				$price = max($price, $temp);
			}
		}

		return ['price' => $price, 'weight' => $weight];
	}

	public function newShipmentProcess($status = 2, $type = 4)
	{
		if (empty($this->process)) {
			$process = new ShipmentProcess;
			$process->started = date('Y-m-d H:i:s');
			$process->pid = $this->id;
			$process->type = $type;
			$process->s_agent_id = $this->agent_id;
			$process->consol_id = $this->consol_id;
			$process->consol_eta = @$this->consol->eta;
			$process->s_bwf = $this->bwf;
		} else {
			$process = $this->process;
			$process->type = $process->type | $type;
			$process->s_agent_id = $this->agent_id;
			$process->consol_id = $this->consol_id;
			$process->consol_eta = @$this->consol->eta;
			$process->s_bwf = $this->bwf;
		}
		$process->status = $status;
		$process->date = date('Y-m-d H:i:s');
		if ($process->save()) {
			return true;
		}
		return false;
	}

	public function newShipmentProcessAllStatus($status, $type)
	{
		if (empty($this->process)) {
			$process = new ShipmentProcess;
			$process->started = date('Y-m-d H:i:s');
			$process->pid = $this->id;
			$process->type = $type;
			$process->s_agent_id = $this->agent_id;
			$process->consol_id = $this->consol_id;
			$process->consol_eta = @$this->consol->eta;
			$process->s_bwf = $this->bwf;
			$process->status = $status;
		} else {
			if($this->process->type==$type&&$this->process->s_agent_id==$this->agent_id&&$this->process->consol_id==$this->consol_id&&$this->process->consol_eta==@$this->consol->eta&&$this->process->s_bwf==$this->bwf)
			{
				return true;
			}else
			{
				$process = $this->process;
				$process->type = $type;
				$process->s_agent_id = $this->agent_id;
				$process->consol_id = $this->consol_id;
				$process->consol_eta = @$this->consol->eta;
				$process->s_bwf = $this->bwf;
			}
		}
		$process->date = date('Y-m-d H:i:s');
		if ($process->save()) {
			return true;
		}
		return false;
	}

	public function newSeaProcess($type = 1, $status = 10)
	{
		if (empty($this->sea_process)) {
			$seaProcess = new SeaProcess();
			$seaProcess->start_time = date('Y-m-d H:i:s');
			$seaProcess->pid = $this->id;
			$seaProcess->type = $type;
		} else {
			$seaProcess = $this->sea_process;
			$seaProcess->type = $type;
		}
		$seaProcess->status = $status;
		$seaProcess->date = date('Y-m-d H:i:s');
		if ($seaProcess->save()) {
			return true;
		}
		return false;
	}

	public function getGoodsItemsForCustomer()
	{
		$items = '<ol>';
		$currency = $this->currency == 2 ? "USD $" : "AUS $";
		if (!empty($this->eitems)) {
			foreach ($this->eitems['g'] as $k => $v) {
				$items .= '<li>' . $v . '&nbsp;&nbsp;' . $this->eitems['q'][$k] . 'PCS&nbsp;&nbsp;' . $currency . floatval($this->eitems['q'][$k]) * floatval($this->eitems['v'][$k]) . '</li>';
			}
		}
		$items .= '</ol>';
		return $items;
	}
	public function getGoodsItemsForLabel()
	{
		$items = '';
		$currency = $this->currency == 2 ? "USD $" : "AUS $";
		if (!empty($this->eitems)) {
			foreach ($this->eitems['g'] as $k => $v) {
				$items .= '<p>' . $v . ':' . $this->eitems['q'][$k] . 'PCS'. '</p>';
			}
		}
		return $items;
	}

	/*this name is for custom send invoice to client
	 * DDP,we use the sener's name,
	 * DDU,we use the consignee's name,
	 */
	public function getClientName()
	{
		if (($this->bwf & self::CUSTOM_DDP) > 0) {
			return $this->agent->name;
		} elseif (($this->bwf & self::CUSTOM_DDU) > 0) {
			return $this->cnee->name;
		}
		return '';
	}

