	public function getStatus()
	{
		$status = isset(static::$states[$this->status]) ? Yii::t(strtolower(__CLASS__), static::$states[$this->status]) : $this->status;

		// in case shipment is cleared status we need tag manifest or un-manifest status
		if ($this->status == 60) {
			// in case cleared status
			if (!empty($this->trans) && count($this->trans) == 1) {
				$ts = $this->trans[0];
				if ($ts->org_id == Org::ORGID_COURIER_TOLL) {
					$status .= '[M]'; // for toll once tranship existing which means has been lodged
				} else {
					//                    if ( !empty($ts->mdata['oid']) ) {
					//                        // in case Aupost or Startrack
					//                        // only when trhanship order id existing which means has been lodged
					//                         $status .= '[M]';
					//                    }
				}
			}
		}
		// if (!empty($this->trans) && count($this->trans) == 1) {
		// 	$ts = $this->trans[0];
		// 	if (!empty($ts->mdata['oid'])) {
		// 		// in case Aupost or Startrack
		// 		// only when trhanship order id existing which means has been lodged
		// 		$status .= '[M]';
		// 	}
		// }
		if (!empty($this->trans)) {
			foreach ($this->trans as $ts) {
				if ($ts->connote != $this->ref) {
					continue;
				}
				if (!empty($ts->mdata['oid'])) {
					// in case Aupost or Startrack
					// only when trhanship order id existing which means has been lodged
					$status .= '[M]';
				}
			}
		}
		// if (!empty($this->mdata['aupost_return']) && !empty($this->mdata['manifest_weight'])) {
		// 	$status .= '[M]';
		// }
		if (!empty($this->mdata['direct_courier']) && $this->status != 31) {
			$status .= '[D]';
		}
		$status.=$this->checkStorageHeld();
		return $status;
	}
	
	public function getManifestStatus()
	{
		$status = "";

		// in case shipment is cleared status we need tag manifest or un-manifest status
		if ($this->status == 60) {
			// in case cleared status
			if (!empty($this->trans) && count($this->trans) == 1) {
				$ts = $this->trans[0];
				if ($ts->org_id == Org::ORGID_COURIER_TOLL) {
					$status = '[M]'; // for toll once tranship existing which means has been lodged
				} else {
					//                    if ( !empty($ts->mdata['oid']) ) {
					//                        // in case Aupost or Startrack
					//                        // only when trhanship order id existing which means has been lodged
					//                         $status .= '[M]';
					//                    }
				}
			}
		}
		// if (!empty($this->trans) && count($this->trans) == 1) {
		// 	$ts = $this->trans[0];
		// 	if (!empty($ts->mdata['oid'])) {
		// 		// in case Aupost or Startrack
		// 		// only when trhanship order id existing which means has been lodged
		// 		$status .= '[M]';
		// 	}
		// }
		if (!empty($this->trans)) {
			foreach ($this->trans as $ts) {
				if ($ts->connote != $this->ref) {
					continue;
				}
				if (!empty($ts->mdata['oid'])) {
					// in case Aupost or Startrack
					// only when trhanship order id existing which means has been lodged
					$status = '[M]';
				}
			}
		}
		// if (!empty($this->mdata['aupost_return']) && !empty($this->mdata['manifest_weight'])) {
		// 	$status .= '[M]';
		// }
		if (!empty($this->mdata['direct_courier']) && $this->status != 31) {
			$status = '[D]';
		}

		return $status;
	}

	public function rules()
	{
		$rules = [
			['agent_id', 'required'],
			['agent_id', 'checkCredit', 'on' => 'create'],
			['state', 'auStates'],
			['items', 'validItems', 'on' => 'create'],
			['heldDate', 'safe'],
			['sea_process_not_in,sea_process_status,bagTag,chargecode,heldDate,sctime,scheDate,unloadDate', 'safe', 'on' => 'search'],
		];
		$pRules = parent::rules();
		unset($pRules[4]);
		return array_merge($pRules, $rules);
	}

	public function relations()
	{
		return parent::relations() + [
			'amazon_info' => [self::HAS_ONE, 'AmazonInfo', 'fid', 'on' => "amazon_info.model='" . get_called_class() . "'"],
			'cargo_delivery_info' => [self::HAS_ONE, 'CargoDeliveryInfo', 'shipment_id','on' => "cargo_delivery_info.model='" . get_called_class() . "'"],
			'sea_process' => [self::HAS_ONE, 'SeaProcess', 'pid'],
			'gatepass_shipment' => [self::HAS_MANY, 'GatepassShipment', 'fid'],
			'deconciliation' => [self::HAS_ONE, 'Tracking', 'pid', 'on' => "deconciliation.type = 61"],
			'bag_tag' => [self::HAS_ONE, 'ImportBagTag', 'shipment_id'],
			'blue_label' => [self::HAS_MANY, 'ImportsShipmentRelations', 'pid']
		];
	}
	//add new zealand states at 09/20/2017 by jerry
	public function auStates()
	{
		return true;
		if (!in_array(strtoupper($this->state), ['ACT', 'NSW', 'NT', 'QLD', 'SA', 'TAS', 'VIC', 'WA', 'NI', 'SI']) && !in_array($this->agent_id, array_merge([Org::ORGID_3PL_IGEA, Org::ORGID_3PL_SMART_HUB], Org::$easyships))) {
			$this->addError('state', 'Please only use abbreviations for Australian states, e.g. ACT, NSW, NT, QLD, SA, TAS, VIC, WA,NI,SI');
			return false;
		}
	}

	public function getSendSms()
	{
		$info = $this->getCourierInfo();
		$cname = $this->cnee->getCname();
		$msg = "Hi ".$cname.", an overseas shipment is coming to you, pls prepare to receive. Tracking#{$this->ref} by ".$info[0].". Track on https://rebrand.ly/5kr?s={$this->ref}";
		return $msg;
	}

	public function msgNotice()
	{
		if (($this->cbwf & 8192) > 0 || !in_array($this->status, [42,60])) {
			return;
		}
		if (!empty($this->trans)) {
			switch ($this->trans[0]->org_id) {
				case Org::ORGID_COURIER_STARTRACK:
				case Org::ORGID_COURIER_TNT_TOP:
				case Org::ORGID_COURIER_DFE_TOP:
					$this->sendMsgToCourier();
					break;
			}
		}
	}
	private function sendMsgToCourier()
	{
		$resp = false;
		if (preg_match("/^04\d{8}/i", ($no = Addr::auTelValid($this->cnee->tel)))) {
			$msg = $this->getSendSms();
			if (Sms::sendMessageLocal($no, $msg)) {
				$this->custom_log_note = "Send SMS to " . $no;
				// Log::log2file($this->ref . "    " . $msg . " To " . $no, "delivery_message_notice", 'smslog');
				$this->save();
				$resp = true;
			}
			if (filter_var(($email = preg_split('/[;,]+/i', $this->cnee->email)[0]), FILTER_VALIDATE_EMAIL)) {
				$d = $this->deliveryEmailNotice();
				if ($d['status']) {
					$this->custom_log_note = "Send email " . $email;
					$this->save();
					$resp = true;
				}
			}
		}
		$this->nolog = true;
		if ($resp) {
			$this->cbwf = $this->cbwf | 8192;
			$this->update('cbwf');
		}
	}

	private function deliveryEmailNotice()
	{
		$email = preg_split('/[;,]+/i', $this->cnee->email)[0];
		$emailLog = new Emailog;
		$emailLog->fid = $this->id;
		$emailLog->type = Emailog::DELIVERY_EMAIL_NOTICE;
		$emailLog->status = 10;
		$emailLog->dt = date('Y-m-d H:i:s');
		$emailLog->prepTemplate();
		$emailLog->subject = $emailLog->tpl->subject;
		$emailLog->body = $emailLog->tpl->getContent();
		$emailLog->mdata['to'] = $email;
		$emailLog->mdata['from'] = 'donotreply@toplogistics.com.au';
		$emailLog->mdata['fromName'] = 'Notice';
		//            $emailLog->mdata['cc']='imports@toplogistics.com.au;jerry@toplogistics.com.au';
		$d = $emailLog->sendEmail();
		if ($d['status']) {
			$o['status'] = true;
			$o['msg'] = 'send successfully';
		} else {
			$o['status'] = false;
			$o['msg'] = $d['msg'];
		}
		return $o;
	}

	public function checkCredit()
	{
		$org = Org::model()->findByPk($this->agent_id);
		if (empty($org)) {
			$this->addError('agent_id', 'Client invalid');
			return false;
		}
		// if ($org->overCreditLimit()) {
		// 	$this->addError('agent_id', 'Client ' . $org->name . ' credit limit exceeded, please contact accounts!');
		// 	return false;
		// }
		return true;
	}

	public function scanCount()
	{
		if (empty($this->scan_data[50])) {
			return 0;
		}

		if (isset($this->scan_data[50]['SCAN_ALL'])) {
			return $this->pkg;
		}

		$sns = [];
		foreach ($this->scan_data[50] as $bc => $t) {
			$sn = '';
			$bc = strtoupper($bc);
			if (preg_match('/^T\d{6}(' . TollAPI::TOLL_SLID . '|' . TollAPI::TOLL_SLID_OFFPEAK . ')\d{10}/', $bc, $m)) { //Toll
				$sn = substr($m[0], 17, 3);
			}elseif (preg_match('/^64(\d{4})(\d{13})(\d{3})$/', $bc, $m)){
				$sn = ltrim($m[3], '0');
			} elseif (preg_match('/^(7RFZ|4XHZ)\d{8}' . StarTrackAPI::API_PRODUCT_ID . '\d{5}/', $bc, $m)) { //StarTrack
				$sn = substr($m[0], 15, 5);
			} elseif (preg_match('/^99700160([A-Z]{3})\d{18}/', $bc, $m)) { //eparcel legacy
				$sn = substr($m[0], 18, 2);
			} elseif (preg_match('/^(019931265099999891)?(\w{3,5}\d{7})(\d{11})(\d{23})?$/', $bc, $m)) { //eparcel 2d
				$sn = substr($m[3], 0, 2);
			} elseif (preg_match('/^(DKC|PCD|BPC|TLS|LMA|TBC)\d{9}(\d{3})$/', $bc, $m)) { // TNT translated
				$sn = $m[2];
			} elseif (preg_match('/^CP[A-Z]{5}\d{7}(\d{3})$/', $bc, $m)) { //couriers please
				$sn = $m[1];
			} elseif (preg_match('/^CP[A-Z]{3}\d{10}(\d{2})$/', $bc, $m)) { //couriers please 2
				$sn = $m[1];
			} elseif (preg_match('/^SCAU\d{8}(\d{3})\d{3}$/', $bc, $m)) { //saicheng
				$sn = $m[1];
			} elseif (preg_match('/^((?:ZV|PB|DQ)\d{6}|UDW\d{7})(\d{3})\d{7}$/', $bc, $m)) {	//hunter express
				$sn = $m[2];
			} elseif (preg_match('/^QS\d{3}-\w*-(\d{1,3})$/', $bc, $m)) { // master logistic
				$sn = $m[1];
			} elseif (preg_match('/^(246831|247511|345861|435721|240518)(\d{7})(\d{3})(\d{4})$/', $bc, $m)){ //dfe
				$sn = $m[3];
			}elseif (preg_match('/^((CN)[a-zA-Z0-9]{9})(\d{4})$/', $bc, $m)){
				$sn = $m[3]*1;
			}elseif (preg_match('/^((CN)[a-zA-Z0-9]{11})(\d{4})$/', $bc, $m)){
				$sn = $m[3]*1;
			}elseif (preg_match('/^TLDBBX\d{11}(\d{3})$/', $bc,$m))//my border
			{
				$sn = ltrim($m[1], '0');
			}elseif (preg_match('/^64(\d{4})(\d{13})(\d{3})$/', $bc, $m)){ //AUK TOLL
				$sn = ltrim($m[3], '0');
			
			}
			elseif (preg_match('/^(\d{12})(\d{3})$/', $bc,$m))//dfe
			{
				$sn = ltrim($m[2], '0');
			}
			elseif (preg_match('/^(.+)#(.*)@(\d+)$/', $bc, $m))
			{
				$sn = $m[3];
			}elseif ($bc == strtoupper($this->ref) || $bc == strtoupper($this->hbn) || ($bc == strtoupper($this->cref)&&$this->agent_id!=3321)|| $bc == strtoupper($this->can)) {
				$sn = 1;
			} elseif (preg_match('/-(\d+)$/', $bc, $m)) {
				$sn = $m[1];
			} 
			else {
				if(!empty($this->mdata['barcode']))
				{
					$bcs = explode(',', $this->mdata['barcode']);
					foreach ($bcs as $key => $bbc) {
						if($bbc==$bc)
						{
							$sn = $key+1;
							break;
						}
					}
				}else
				{
					$pb = ParcelBarcode::model()->find("sub_ref=:sub_ref",[":sub_ref"=>$bc]);
					if(!empty($pb))
					{
						$sn = $pb->sn;
					}else
					{
						continue;
					}
				}
			}
			$sns[] = ltrim($sn, 0);
		}

		return count(array_unique($sns));
	}

	/**
	 * get toll service type based on special requirement
	 */
	public function getTollServiceType()
	{
		// test with agent id 125 currently
		// only for JCEX -- 838
		// only for Jcex chargecode 3720
		// <= 10kg we use overnight
		// > 10kg we use off peak
		// waiting for xiaomi confirm
		if ($this->agent_id == 838 &&
			isset($this->mdata['chargecode']) &&
			$this->mdata['chargecode'] == 3720
		) {
			if ($this->chargeWeight() > 10) {
				return TollAPI::TOLL_SERVICE_OFFPEAK;
			}
		}
		if ($this->agent_id == 1303 && isset($this->mdata['chargecode']) && $this->mdata['chargecode'] == 9513) {
			if ($this->chargeWeight() > 10) {
				return TollAPI::TOLL_SERVICE_OFFPEAK;
			}
		}
		return TollAPI::TOLL_SERVICE_OVERNIGHT;
	}

	public static function fromBarcode($hbn, &$isHbn = null, $consolState = false,$containerNo = false)
	{
		if(empty($hbn)) return null;
		$symbol = "t.status < 100 and ";
		if ($consolState == false) {
			$symbol .= " consol_id > 0 AND ";
		}

		if (!empty($containerNo)) {
			$symbol .= "  (json_value(consol.meta,'$.container_no')  = '{$containerNo}' or consol.awb = '{$containerNo}') AND ";
		}

		$p = ImParcel::model()->with(['consol'])->find($symbol.' (hbn = :n or (cref=:n and agent_id =2716))', [':n' => $hbn]);
		if (empty($p)) {
			$p = ImParcel::model()->with(['consol'])->find($symbol.' ref = :n', [':n' => $hbn]);
		} else {
			$isHbn = true;
		}
		if (empty($p)) {
			$s3 = substr($hbn, 0, -3);
			$p = ImParcel::model()->with(['consol'])->find($symbol.' hbn = :n', [':n' => $s3]);
			if (empty($p)) {
				$p = ImParcel::model()->with(['consol'])->find($symbol.' ref = :n', [':n' => $s3]);
			} else {
				$isHbn = true;
			}
			if (empty($p)) {
				$s2 = substr($hbn, 0, -2);
				$p = ImParcel::model()->with(['consol'])->find($symbol.' hbn = :n ', [':n' => $s2]);
				if (empty($p)) {
					$p = ImParcel::model()->with(['consol'])->find($symbol.' ref = :n', [':n' => $s2]);
				} else {
					$isHbn = true;
				}
				if (!empty($p)) {
					$hbn = $s2;
					$p->sn = intval(substr($hbn, -2));
				}
			} else {
				$hbn = $s3;
				$p->sn = intval(substr($hbn, -3));
			}
		} else {
			$p->sn = 0;
		}

		return $p;
	}

	public function rateSelection()
	{
		if (empty($this->zr_id)) {
			$this->bestRate();
		}
		$ors = OrgRate::model()->findAll('type != 30 AND vfrom <= :today AND (vto >= :today OR vto IS NULL)', [':today' => (empty($this->consol->eta) || $this->consol->eta == '0000-00-00') ? date('Y-m-d') : $this->consol->eta]);
		$ops = [];
		$sa = [];
		foreach ($ors as $or) {
			$rs = $this->rating($or);
			if (empty($rs)) {
				continue;
			}
			foreach ($rs as $r) {
				$ops[$r[0]] = '$' . $r[1] . ' ' . $or->name . ($or->type == 20 ? ' ' . rtrim($r[2]->weight_hi, '.0') . 'kg' : '');
				$sa[$r[0]] = $r[1];
			}
		}
		//sort by pricing
		asort($sa);
		$sops = [];
		foreach ($sa as $k => $v) {
			$sops[$k] = $ops[$k];
		}
		$sops[328] = 'PCA Express';
		return CHtml::dropDownList('zr_id[' . $this->id . ']', $this->zr_id, $sops, ['class' => 'rate_sel']);
	}

	public function calcDvalue()
	{
		if (empty($this->eitems['v'])) {
			return;
		}
		$tv = 0;
		foreach ($this->eitems['v'] as $i => $v) {
			$tv += floatval($v) * floatval($this->eitems['q'][$i]);
		}
		$this->dvalue = number_format($tv, 2, '.', '');
	}

	public function beforeValidate()
	{
		$this->dvalue = number_format($this->dvalue, 2, '.', '');
		return parent::beforeValidate();
	}

	public function beforeSave()
	{
		$this->calcDvalue();
		if ($this->id > 0) {
			$o = ImParcel::model()->findByPk($this->id);
			if($o->bwf!=$this->bwf&&(!empty($o->bwf)||!empty($this->bwf)))
			{
				ShipmentUpdateService::generateBwfUpdateRecord($this,$o->bwf,$this->bwf);
			}
			if($o->bwf!=$this->bwf&&$this->status==self::STATE_HELD)
			{
				$this->editedToHeld = true;
			}

			$cln = $this->cln;
			if ($o->weight > 0 && $o->weight != $this->weight) {
				$cln[] = 'Weight changed from: ' . $o->weight;
				if (!empty($this->trans[0]) && $this->trans[0]->org_id == 1426 && $this->trans[0]->status > 10) {
					$this->cbwf = $this->cbwf | 65536;
				}
			}
			if ($o->pkg > 0 && $o->pkg != $this->pkg) {
				$cln[] = 'pkg changed from: ' . $o->pkg;
				ImParcelService::updateParcelTollLabels($this);
			}

			if ($o->cbm > 0 && $o->cbm != $this->cbm) {
				$cln[] = 'cbm changed from: ' . $o->cbm;
			}
			
			if ($o->ref != $this->ref && !empty($o->ref)) {
				$cln[] = 'Ref changed from: ' . $o->ref;
			}

			if ($o->insurance != $this->insurance) {
				$cln[] = 'Insurance changed from: ' . $o->ref;
			}

			if ($o->can != $this->can) {
				$cln[] = 'Memo changed from: ' . $o->can;
			}

			if (json_encode($this->eitems)!=$o->items)
			{
				foreach (['g','q','v'] as $k5 => $v5)
				{
					if(json_encode($this->eitems[$v5])!=json_encode($o->eitems[$v5]))
					{
						$cln[] = 'Items '.$v5.' changed from: '.json_encode($o->eitems[$v5]);
					}
				}
			}

			if ($o->consol_id != $this->consol_id) {
				$oNo = "";
				$nNo = "";
				if($o->consol_id>0)
				{
					$oConsol = Consol::model()->findByPk($o->consol_id);
					$oNo = $oConsol->no;
				}

				if($this->consol_id>0)
				{
					$nConsol = Consol::model()->findByPk($this->consol_id);
					$nNo = $nConsol->no;
				}

				$cln[] = 'Console changed from: ' . $oNo." to ".$nNo;
			}
			
			if (!empty($cln)) {
				$this->custom_log_note = implode(', ', $cln);
			}
		}

		// export held shipments report (scan_no < pkg), need to initialize scan_no = pkg
		if ($this->isNewRecord) {
			$this->scan_no = $this->pkg;
		} else {
			$this->scan_no = $this->pkg - $this->scanCount();
		}

		// felix manual set 80
		if ($this->status == self::RTS_RECEIVED && isset(Yii::app()->user->id) && Yii::app()->user->id > 0 && !empty($o) && $o->status != self::RTS_RECEIVED) {
			$this->cbwf = $this->cbwf | 256;
			$this->mdata['rts_scan_date'] = date('Y-m-d');
			// ShipmentScan::genShipmentScan($this, 4, 1, 106);
		}

		return parent::beforeSave();
	}

	//to add direct coureir cbwf to the shipment, according the chargecode infor.
	public function directCourier($directType = false)
	{
		if (empty($this->mdata['direct_courier']) && (empty($this->trans) || empty($this->trans[0]->mdata['oid'])) && ($this->cbwf & 32) == 0 && ($this->cbwf & 64) == 0) { //a flag when we make the manifest
			if (!empty($this->mdata['chargecode'])) {
				$chargecodeInfo = ImportChargeCode::model()->find('chargecode=:chargecode AND status=1', [":chargecode" => $this->mdata['chargecode']]);
				if (!empty($chargecodeInfo)) {
					if ((!empty($chargecodeInfo->mdata['direct_courier']))) {
						$this->cbwf = $this->cbwf | 32;
					}
				}
			}
		}
		$this->mdata['direct_type']=$directType;
	}

	/**
	 * get nearest dept
	 * from startrack nearest dept table : courier_nearest_dept
	 * based on postcode, suburb and state
	 */
	public function getStartrackDept()
	{
		$dest = 'SYD'; // should have default one ?
		$dept = CourierNearestDepot::model()->find(
			'type = 0 AND postcode = :postcode AND state = :state AND suburb = :suburb',
			[':postcode' => $this->cnee->postcode,
				':state' => strtoupper($this->cnee->state),
				':suburb' => strtoupper($this->cnee->suburb),
			]
		);
		if (!empty($dept)) {
			$dest = $dept->depot;
		}

		return $dest;
	}
	/*
	 * get letter service
	 * 0 means both, 1 big letter 2  only small letter
	 */

	public function getLetterService()
	{
		$chargecode = $this->mdata['chargecode'];
		if (empty($chargecode)) {
			return 0;
		}
		$chargecodeInfo = ImportChargeCode::model()->find('chargecode=:no', [':no' => $chargecode]);
		if (empty($chargecodeInfo)) {
			return 0;
		}

		if (in_array(85, $chargecodeInfo->couriersObj) && in_array(86, $chargecodeInfo->couriersObj)) {
			return 0;
		}
		if (in_array(85, $chargecodeInfo->couriersObj) && !in_array(86, $chargecodeInfo->couriersObj)) {
			return 1;
		}
		if (!in_array(85, $chargecodeInfo->couriersObj) && in_array(86, $chargecodeInfo->couriersObj)) {
			return 2;
		}
		return 0;
	}

	/**
	 * based on startrack QR code specification , create QR string
	 */
	public function getStartrackQRData($index = 1)
	{
		// Field # Field Name Type / Format Position Length Required? Remarks
		// All fields are fixed width. Spaces must be used to pad fields when optional fields are blank.
		// 01 Receiver Suburb Alphanumeric 1 30 Mandatory
		$suburb = $this->cnee->suburb;
		if (strlen($suburb) > 30) {
			$qrData = substr($suburb, 0, 30);
		} else {
			$qrData = str_pad($suburb, 30);
		}

		// 02 Receiver Postcode Numeric 31 4 Mandatory
		$qrData .= $this->cnee->postcode;

		// 03 Consignment Number Alphanumeric 35 12 Mandatory
		$qrData .= $this->ref;

		// 04 Freight Item (article/label) number Alphanumeric 47 20 Mandatory
		$pIndex = sprintf('%05d', $index);
		$articleId = $this->ref . StarTrackAPI::API_PRODUCT_ID . $pIndex;
		$qrData .= $articleId;

		// 05 Product Code Alphanumeric 67 3 Mandatory
		$qrData .= StarTrackAPI::API_PRODUCT_ID;

		// 06 Payer Account Numeric 70 8 Conditional
		$qrData .= str_pad(' ', 8);

		// 07 Sender Account Numeric 78 8 Conditional
		if (preg_match("/4XHZ\d{8}/", $this->ref)) {
			$qrData .= StarTrackAPI::getAccountNo('mel');
		} else {
			$qrData .= StarTrackAPI::getAccountNo('syd');
		}

		// 08 Consignment Quantity Numeric 86 4 Mandatory   Left-justified.
		$qrData .= str_pad($this->pkg, 4);

		// 09 Consignment Weight Numeric 90 5 Mandatory
		// The total weight of the consignment rounded up to the nearest whole kilogram. Left-Justified.
		$qrData .= str_pad(round($this->weight), 5);

		// 10 Consignment Cube Numeric 95 5 Conditional
		// Required when the consignment is not a satchel.
		// Remarks Total volumetric measure for this consignment expressed by multiplying by 1000 before inserting here.
		// If the total value overflows the 99999 format, then***** must be written. If there is more than one unit type
		// (i.e. type 12 records are used in the manifest file), then this field is the total volume summed over all unit types. Left-justified.
		$cube = round($this->cbm * $this->pkg * 1000);
		if ($cube > 99999) {
			$cube = '*****';
		} else {
			$cube = str_pad($cube, 5, ' ');
		}
		$qrData .= $cube;

		// 11 Despatch Date YYYYMMDD 100 8 Mandatory
		if (isset($this->trans) && !empty($this->trans)) {
			$qrData .= date('Ymd', strtotime($this->trans[0]->time));
		} else {
			$qrData .= date('Ymd');
		}

		// 12 Receiver Name 1 Alphanumeric 108 40 Mandatory
		$recvName = $this->cnee->name;
		if (strlen($recvName) > 40) {
			$qrData .= substr($recvName, 0, 40);
		} else {
			$qrData .= str_pad($recvName, 40);
		}

		// 13 Receiver Name 2 Alphanumeric 148 40 Optional
		$qrData .= str_pad(' ', 40);

		// 14 Unit Type Alphanumeric 188 3 Mandatory
		$qrData .= 'ITM';

		// 15 Destination Depot Alphanumeric 191 4 Mandatory Left justified field.
		$qrData .= str_pad($this->getStartrackDept(), 4);

		// 16 Receiver Address Line 1 Alphanumeric 195 40 Mandatory
		$recvAddr = $this->cnee->address;
		if (strlen($recvAddr) > 40) {
			$qrData .= substr($recvAddr, 0, 40);
		} else {
			$qrData .= str_pad($recvAddr, 40);
		}

		// 17 Receiver Address Line 2 Alphanumeric 235 40 Optional
		$qrData .= str_pad(' ', 40);

		// 18 Receiver Phone Number Numeric 275 14 Optional
		$recvTel = $this->cnee->tel;
		if (strlen($recvTel) > 14) {
			$qrData .= substr($recvTel, 0, 14);
		} else {
			$qrData .= str_pad($recvTel, 14);
		}

		// 19 Dangerous Goods Indicator Alphanumeric 289 1 Mandatory
		// Permitted values: Yes (Y) or No (N)
		$qrData .= 'N';

		// 20 Movement Type Indicator Alphanumeric 290 1 Mandatory
		// Permitted values:  Despatch Movement (N) Controlled Returns (C) Transfer Movements (T)
		$qrData .= 'N';

		// 21 Not Before Date YYYYMMDDHHMM 291 12 Optional
		$qrData .= str_pad(' ', 12);

		// 22 Not After Date YYYYMMDDHHMM 303 12 Optional
		$qrData .= str_pad(' ', 12);

		// 23 ATL Number Alphanumeric 315 10 Conditional
		$qrData .= str_pad(' ', 10);

		// 24 RA Number Alphanumeric 325 10 Conditional
		$qrData .= str_pad(' ', 10);

		return $qrData;
	}

	public function getOutPkg()
	{
		return $this->scanCount();
	}


	public function getCargoTracking($type,$cargoProcessId = false)
	{
		if($cargoProcessId==false)
		{
			$t= Tracking::model()->find('pid=:pid AND type=:type AND json_value(t.meta,"$.cargo_process_id") is null order by dt desc', [':pid'=>$this->id,':type'=>$type]);
		}else
		{
			$t= Tracking::model()->find('pid=:pid AND type=:type AND json_value(t.meta,"$.cargo_process_id") = :cid order by dt desc', [':pid'=>$this->id,':type'=>$type,':cid'=>$cargoProcessId]);
		}
		if ($t) {
			return $t;
		}
		return false;
	}

	public function updateAmazonBookingTime($cargoProcessId = false)
	{
		if (!empty($this->mdata['amazon_booking_time'])) {
			$t = $this->getCargoTracking(70);
			if ($t!=false) {
				$packageStr = "";
				if(!empty($this->cargo_process))
				{
					if(!empty($this->cargo_process->mdata["caref"]))
					{
						$packageStr =" with ".$this->cargo_process->mdata['left_packages']." packages, ";
					}
					$packageStr = $this->cargo_process->getRef().$packageStr;
				}

				$t->activity = $packageStr."Amazon Booking Time: " . $this->mdata['amazon_booking_time'] . ",Booking ref:" . @$this->mdata['booking_ref'];
				$t->depot = "amazon";
				$t->update(["activity","dpt"]);
			}
		}
	}

	public function addAmazonBookingTime()
	{
		if (!empty($this->mdata['amazon_booking_time'])) {
			$t = $this->getCargoTracking(70);
			if ($t==false) {
				$packageStr = "";
				if(!empty($this->cargo_process))
				{
					if(!empty($this->cargo_process->mdata["caref"]))
					{
						$packageStr =" with ".$this->cargo_process->mdata['left_packages']." packages, ";
					}
					$packageStr = $this->cargo_process->getRef().$packageStr;
				}

				$this->addTracking(70, "Amazon Booking Time: " . $this->mdata['amazon_booking_time'] . ",Booking ref:" . @$this->mdata['booking_ref'], "amazon", date('Y-m-d h:i:s', time()));
			}
		}
	}

	public function updateDeliveryBookingTime($change = false)
	{
		if (!empty($this->mdata['delivery_booking_time'])) {
			$changeMessage = "Delivery Booking Time: ";
		
			$t = $this->getTracking(70);
			if ($t==false) {
				$this->addTracking(70, $changeMessage . $this->mdata['delivery_booking_time'], "cargo delivery", date('Y-m-d h:i:s', time()));
			} else {
				$t->activity =  $changeMessage . $this->mdata['delivery_booking_time'];
				$t->depot = "truck delivery";
				$t->update(["activity","dpt"]);
			}
		}
	}

	public function updatePodTrackingUrl($cargoProcessId = false)
	{
		if (empty($this->getPodUrl())) {
			return;
		}
		if(!empty($cargoProcessId))
		{
			$tracking = Tracking::model()->find('pid=:pid and type=71 and json_value(t.meta,"$.cargo_process_id") = :cid ORDER BY id DESC', [':pid' => $this->id,":cid"=>$cargoProcessId]);
		}else
		{
			$tracking = Tracking::model()->find('pid=:pid and type=71 ORDER BY id DESC', [':pid' => $this->id]);
		}

		if (!empty($tracking)) {
			$tracking->activity = $this->getPodUrl($cargoProcessId);
			$tracking->update('activity');
		} else {
			if(!empty($cargoProcessId))
			{
				$this->addCargoTracking(71, $this->getPodUrl($cargoProcessId),'','',0,0,'{"cargo_process_id":"'.$cargoProcessId.'"}',$cargoProcessId);
			}else
			{
				$this->addTracking(71, $this->getPodUrl());
			}
		}
	}

	public function updateDeconsolidationTime($isGatePass = false,$noCheck = false,$isUpdate = false)
	{
		if (!empty($this->mdata['scan_time'])) {
			$activity = "";
			if($noCheck===false)
			{
				$t = Tracking::model()->find('pid=:pid and type=61 ORDER BY id DESC', [':pid' => $this->id]);
			}
			if (empty($t)||$noCheck == true) {
				if (($this->status==self::STATE_LOCAL_ARRIVAL||$this->status==self::STATE_CLEAR||$this->status==self::STATE_COURIER||$this->status==self::STATE_HELD)&&!$isGatePass) {
					$t = new Tracking('create');
					$t->pid = $this->id;
					$t->tid = 0;
					$t->srid = 0;
					$t->dt = $this->mdata['scan_time'];
					if($this->status==self::STATE_HELD)
					{
						$t->activity = 'Deconsolidation has been done';
					}else
					{
						$t->activity = 'Deconsolidation has been done, waiting for despatch';
					}
					$t->depot = '';
					$t->type = 61;
					$t->meta = '';
					$t->save();
					$this->updateTranshipTime();
				} else {
					if ($isGatePass) {
						if ($this->status==self::STATE_LOCAL_ARRIVAL||$this->status==self::STATE_CLEAR||$this->status==self::STATE_COURIER) {
							$t = new Tracking('create');
							$t->pid = $this->id;
							$t->tid = 0;
							$t->srid = 0;
							$t->dt = $this->mdata['scan_time'];
							$t->activity = 'Waiting for despatch';
							$t->depot = '';
							$t->type = 61;
							$t->meta = '';
							$t->save();
							$this->updateTranshipTime();
						}
					}
				}
			}elseif(!empty($t)&&$isUpdate ===true)
			{
				$t->dt = $this->mdata['scan_time'];
				$t->save();
			}
		}
	}

	public function getPodUrl($cargoProcessId = false)
	{
		$url = '';
		$refStr = "";
		if(!empty($cargoProcessId))
		{
			$r = FileRepo::model()->find('type=25 AND fid=:fid and status = 20 and json_value(t.meta,"$.cargo_process_id") = :cid order by id desc', [':fid' => $this->id,':cid'=>$cargoProcessId]);
			$ca = CargoProcess::model()->findByPk($cargoProcessId);
			$refStr = $ca->mdata['caref']." with ".$ca->mdata['left_packages']." packages :";
		}else
		{

			$r = FileRepo::model()->find('type=25 AND fid=:fid and status = 20 order by id desc', [':fid' => $this->id]);
		}
		if (!empty($r)) {
			$url = '<a target = "_blank" href="' . "https://os.toplogistics.com.au" . "/filerepo/" . $r->hash . "/" . $r->name . '">'.$refStr.'Click Here To Download POD</a>';
		}
		return $url;
	}
	public function checkConsolReceived()
	{
		if ($this->consol_id > 0) {
			$received = Yii::app()->cache->get('CONSOL_TO_CHECK_' . $this->consol_id);
			if ($received) {
				return $received;
			}
			if (isset($this->consol->process) && $this->consol->process->status <= ConsolProcess::STATE_NOTIFIED_DRIVER) {
				$this->consol->process->updateStatus(ConsolProcess::STATE_WAITING_WH_SCAN);
				Yii::app()->cache->set('CONSOL_TO_CHECK_' . $this->consol_id, true, 3600);
			} else {
				return true;
			}
		}
		return true;
	}

	public function checkWaitingForScan()
	{
		if ($this->consol_id > 0) {
			// $waitingForScan=Yii::app()->cache->get('CONSOL_TO_SCAN_'.$this->consol_id);
			// if ($waitingForScan) {
			//     return true;
			// }
			$sql = 'SELECT id FROM consol_process WHERE fid = :cid AND status >= :s1 AND status <= :s2 LIMIT 1';
			return !empty(Yii::app()->db->createCommand($sql)->bindValues([':cid' => $this->consol_id, ':s1' => ConsolProcess::STATE_WAITING_WH_SCAN, ':s2' => ConsolProcess::STATE_WAITING_AIR_MANI])->queryScalar());
		}
		return false;
	}

	public function canSendACR()
	{
		if ($this->status >= 60 || $this->status == 42) {
			return false;
		}

		return Edimsg::model()->count('fid = :id AND type ="AIRCR-S" AND status IN (20, 30, 40)', [':id' => $this->id]) == 0;
	}

	public static function getImStatus($s)
	{
		return Yii::t(strtolower(__CLASS__), empty(self::$states[$s]) ? '' : self::$states[$s]);
	}

	public function afterSave()
	{
		if (!$this->no_tracking) {
			if ($this->isNewRecord) {
				//                     $direct_eparcel = FALSE;
				//                     if (!empty($this->mdata['chargecode'])) {
				//                         $chargecodeInfo = ImportChargeCode::model()->find('chargecode=:chargecode AND status=1', array(":chargecode" => $this->mdata['chargecode']));
				//                         if (!empty($chargecodeInfo)) {
				//                              if (!empty($chargecodeInfo->mdata['direct_courier'])) {
				//                               $direct_eparcel = TRUE;
				//                                }
				//                            }
				//                        }
				$this->addTracking(10, 'Shipment info received'); //direct_eparcel do not need this tracking record.
			} elseif ($this->status < 70) {
				if($this->agent_id==Org::ORGID_CLIENT_SF&&$this->status==self::STATE_CLEAR_WAIT)
				{
					$ht = Tracking::model()->count('pid = :pid AND type = :t', [':pid' => $this->id, ':t' => self::STATE_CLEAR]);
				}else
				{
					$ht = Tracking::model()->count('pid = :pid AND type = :t', [':pid' => $this->id, ':t' => $this->status]);
				}


				if ($ht > 0 && empty(Yii::app()->user) && in_array($this->status, [55, 60])) {
					$lt = Tracking::model()->find(['condition' => 'pid = :id AND type IN (55,60)', 'params' => [':id' => $this->id], 'order' => 't.id DESC']);
					if (!empty($lt)) {
						$ht = $lt->type == $this->status ? 1 : 0;
						if($this->agent_id==Org::ORGID_CLIENT_SF)
						{
							if($this->status==self::STATE_CLEAR_WAIT&&$lt->type==self::STATE_CLEAR)
							{
								$ht = 1;
							}
						}
					}
				}

				if (empty($ht)||$this->editedToCleared||$this->editedToHeld) {
					switch ($this->status) {
						case 25:
							$this->addTracking(15, 'Received at depot', empty($this->odepot) ? '' : $this->odepot->suburb);
							break;
						case 30:
							$this->addTracking(30, 'Shipment info confirmed', empty($this->odepot) ? '' : $this->odepot->suburb);
							break;
						case 35:
							$this->addTracking(35, 'Customs cleared for export', empty($this->odepot) ? '' : $this->odepot->suburb);
							break;
						case 55:
							$this->editedToHeld = false;
							$this->updateTracking(55, 'Customs held' . $this->getHeldReasons(), strtoupper(Org::IM_COMPANY_SUBURB), '', 0, 0, $this->meta); // save the reason of held as well
							break;
						case 58:
							if($this->agent_id==Org::ORGID_CLIENT_SF)
							{
								$this->editedToCleared = false;
								$this->addTracking(60, 'Clearance processing complete', strtoupper(Org::IM_COMPANY_SUBURB));
								$this->afterClear();
							}
							break;
						case 60:
							$this->editedToCleared = false;
							$this->addTracking(60, 'Clearance processing complete', strtoupper(Org::IM_COMPANY_SUBURB));
							$this->afterClear();
							break;
						case 65:
							$this->addTracking(65, 'Sorted for dispatch', empty($this->odepot) ? '' : $this->odepot->suburb);
							break;
						case 94:
							$this->addTracking(94, 'Item is lost in transit', empty($this->odepot) ? '' : $this->odepot->suburb);
							break;
						default:
							break;
					}
				}
			}
		}

		if (!empty($this->agent->extra['label']) && $this->agent->extra['label'] == 1 && empty($this->ref)) {
			$this->ref = self::genEparcelNo();
			$this->nolog = true;
			$this->isNewRecord = false;
			$this->update(['ref']);
			$this->nolog = false;
			//Yii::log('ref:'.$this->ref, 'error');
		}


		//Added by Gero 2019-06-24 saved to cargo process
		try
		{
			$this->saveToCargoProcess();
		}catch(Exception $ex)
		{
			//throw $ex;
		}

		//Added by Gero 2019-11-20 send custom notice to customer
		$this->sendNoticeToCustomer();

		// $this->checkThirdPartyConsignmentStatus();
		return parent::afterSave();
	}

	public function saveToCargoProcess()
	{
		//Added by Gero 2019-06-24 saved to cargo process
		if ($this->checkCanBeCargoProcess()) {
			if ($this->checkIsCargoProcessWithRef())
			{
				$oldCargoProcess = CargoProcess::model()->find('shipment_id = :shipment_id ', [":shipment_id"=>$this->id]);
				if (empty($oldCargoProcess)||$oldCargoProcess->status==CargoProcess::DELETED) {
					$cargoProcess = new CargoProcess();
					if (!empty($oldCargoProcess)) {
						$cargoProcess = $oldCargoProcess;
					}
					$cargoProcess->shipment_id = $this->id;
					$cargoProcess->date = date("Y-m-d H:i:s");
					$cargoProcess->note = "";
					if ($this->isParcelPickup()) {
						$cargoProcess->status = CargoProcess::COLLECTINFO;//CargoProcess::WAITINGDELIVERY;
						if($this->agent_id==3013)
						{
							$cargoProcess->status = CargoProcess::WAITINGDELIVERY;
						}
						$cargoProcess->type = CargoProcess::PICKUP_CARGO;
					} else {
						$cargoProcess->status = CargoProcess::COLLECTINFO;
						$cargoProcess->setCargoType();
					}
					//add by gero for assign user to austway automatically, actually just assign to one user
					//$result = $cargoProcess->assignUserAuto(); //removed 2021-02-13 for courier service
					$doubleCheckCargoProcess = CargoProcess::model()->find('shipment_id = :shipment_id ', [":shipment_id"=>$this->id]);
					if (!empty($doubleCheckCargoProcess)&&$doubleCheckCargoProcess->status!=CargoProcess::DELETED)
					{
						return;
					}
					$cargoProcess->calculateDptId();
					$cargoProcess->save();
					$cargoProcess->copyAmazonAndCargoDeliveryInfo();
					if($cargoProcess->type==CargoProcess::NORMAL_CARGO||$cargoProcess->type==CargoProcess::PALLET_CARGO)
					{
						if(!empty($this->mdata['amzon_pallet'])){
							//$cargoProcess->mdata['pallet']=$this->mdata['amzon_pallet'];
							$cargoProcess->mdata['job_pallet_no'] = $this->mdata['amzon_pallet'];
							//$cargoProcess->sub_type=CargoProcess::PALLET_OUT;
							$cargoProcess->save();
						}
						if(!empty($cargoProcess->mdata['isPalletRequest'])&&$cargoProcess->mdata['isPalletRequest']==1&&$this->ot_id == 10){
							$this->mdata['isOnceGenerated'] = 1;
						}else{
							$cargoProcess->generateGatePass();
							$this->mdata['isOnceGenerated'] = 1;
						}
					}

					$sydneyPostcodeHead = CargoProcess::SYDHEAD;
					$melPostcodeHead = CargoProcess::MELHEAD;
					//FBA auto address select
					if ($cargoProcess->type == CargoProcess::FBA_CARGO||$cargoProcess->type == CargoProcess::B2B_CARGO) {
						$this->connectingDeliveryAddress();
						//for B2B pre booking if delivery_booking_time != "" then also update cargoprocess
						if($cargoProcess->type ==CargoProcess::B2B_CARGO){
							if(isset($this->mdata['delivery_booking_time'])&& $this->mdata['delivery_booking_time'] !=""){
								$cargoProcess->mdata['delivery_booking_time'] = $this->mdata['delivery_booking_time'];
								$cargoProcess->save();
							}
							//$sendEmail = new ImConsolService();
							//$sendEmail->noticeClientBooking($this->agent_id);
						}
						// if (preg_match("/$sydneyPostcodeHead\d{3}/", $this->cnee->postcode)) {
						// 	$this->mdata['delivery_address']=4;
						// 	$this->mdata['cargo_receipt_addr']=DmawbConsol::$cargo_receip_address[4];
						// }

						// if (preg_match("/$melPostcodeHead\d{3}/", $this->cnee->postcode)) {
						// 	$this->mdata['delivery_address']=5;
						// 	$this->mdata['cargo_receipt_addr']=DmawbConsol::$cargo_receip_address[5];
						// }
						
						$imparcelService = new ImParcelService();
						$imparcelService->generateCargoProcessGatePass($cargoProcess->id);
						$this->mdata['isOnceGenerated'] = 1;
					}
					//save Parcel cargo process type
					if ((isset($this->mdata['cargo_pickup'])&&$this->mdata['cargo_pickup']==1)||preg_match("/PICKUP/i", $this->ref)) {
						$cargoProcess->noticeWarehouseToPrepare();
						$this->mdata['cargo_pickup'] = 1;
					} else {
						$this->mdata['cargo_delivery'] = 1;
					}
					$this->save();
				}elseif($oldCargoProcess->status==CargoProcess::HELDSENTOUTTURN&&$this->status>=self::STATE_CLEAR)
				{
					$oldCargoProcess->status=CargoProcess::WAITINGDELIVERY;
					$oldCargoProcess->save();
				}elseif(@$oldCargoProcess->mdata['PreB2c']==1 && @$oldCargoProcess->mdata['PreB2cSendSMS'] ==0){
					if($this->scanCount()>0){
						if(!empty($oldCargoProcess->job_relation->job)){
							EmailService::sendScanAndCjobSms($oldCargoProcess);
							$time = date('d-m-Y',strtotime($oldCargoProcess->job_relation->job->created));
							$oldCargoProcess->shipment->addTrackingLimited(105,'Scand. Your delivery is '.$time);
							$oldCargoProcess->mdata['PreB2cSendSMS'] = 1;
							$oldCargoProcess->save();
						}
					}
				}elseif($oldCargoProcess->status == CargoProcess::PREPROCESS){
					if($this->scanCount()>0){
						if($oldCargoProcess->setCargoProcessInToAvailableCJob()){
							if(!empty($oldCargoProcess->job_relation->job)){
								EmailService::sendPreProcessIntoCjob($oldCargoProcess);
								$time = date('d-m-Y',strtotime($oldCargoProcess->job_relation->job->created));
								$oldCargoProcess->shipment->addTrackingLimited(105,'Scand. Your delivery is '.$time);
							}
						}else{
							$oldCargoProcess->mdata['PreB2c']==0;
							$oldCargoProcess->status = CargoProcess::WAITINGASSIGNDRIVER;
							$oldCargoProcess->save();
						}
					}
				}
			}
		} else {
			if(!empty($this->cargo_process)&&($this->cargo_process->status==CargoProcess::HELDSENTOUTTURN))
			{
				return;
			}

			if(!empty($this->cargo_process)&&(($this->status<self::STATE_CLEAR&&$this->status!=self::STATE_LOCAL_ARRIVAL)||($this->scanCount() == 0&& empty($this->mdata['cargo_ignore_scan'])&&$this->pkg>0))&&$this->status!=self::DELIVERED)
			{
				if ($this->cargo_process->status<=CargoProcess::AGENTCOLLECTINFO||($this->cargo_process->type==CargoProcess::PICKUP_CARGO&&$this->cargo_process->status<=CargoProcess::WAITINGDELIVERY)||($this->scanCount() == 0 && empty($this->mdata['cargo_ignore_scan']))) {//||($this->scanCount() == 0&& empty($this->mdata['cargo_ignore_scan']))
					$this->cargo_process->status = CargoProcess::DELETED;
					$this->cargo_process->update(["status"]);
				}
			}
		}
	}

