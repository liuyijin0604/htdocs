	/**
	 * check whscan to change label
	 * 1. cnee-> SUM GLOBAL
	 *  cbwf &2048>1;
	 * @return boolean
	 */
	public function hasChangeLabel()
	{
		if (preg_match("/SUM GLOBAL/i", $this->cnee->name)) {
			return true;
		} elseif (($this->cbwf & 2048) > 0) {
			return true;
		}
		return false;
	}

	public function afterClear()
	{
		// $this->bwf = $this->bwf & 4 ^ $this->bwf;
		// $this->bwf = $this->bwf & 8 ^ $this->bwf;
		// $this->bwf = $this->bwf & 16 ^ $this->bwf;
		// $this->bwf = $this->bwf & 32 ^ $this->bwf;
		// $this->bwf = $this->bwf & 512 ^ $this->bwf;
		$this->bwf = $this->bwf & ~1024;
		$this->update(['bwf']);
	}

	public function cleanClear()
	{
		$this->bwf = $this->bwf & 4 ^ $this->bwf;
		$this->bwf = $this->bwf & 8 ^ $this->bwf;
		$this->bwf = $this->bwf & 16 ^ $this->bwf;
		$this->bwf = $this->bwf & 32 ^ $this->bwf;
		$this->bwf = $this->bwf & 512 ^ $this->bwf;
		$this->bwf = $this->bwf & 8192 ^ $this->bwf;
		$this->bwf = $this->bwf & 16384 ^ $this->bwf;
		$this->bwf = $this->bwf & ~1024;
	}
	
	public function checkStorageShipmentForVipAccount()
	{
		if (!empty($this->agent->extra['vipService']) && ($this->status == ImParcel::STATE_DUTY_HELD||$this->status == ImParcel::STATE_CLEAR||$this->status == ImParcel::STATE_CLEAR_WAIT)&&(($this->bwf & self::CUSTOM_DDP) > 0)&&!$this->consol->isSYDWarehouse()) {
			$checkStorage = $this->getStorageFee();
			if ($checkStorage[0]>0&&$checkStorage[1]>0) {
				$this->status = ImParcel::STATE_DUTY_HELD;
				$this->mdata['storageHeld'] = 1;
				$this->save();
			}
		}
	}
	/*get the first 10 words of the clear log
	 */
	public function getClearLog()
	{
		if (isset($this->mdata['clear_log'])) {
			if (strlen($this->mdata['clear_log']) <= 20) {
				return $this->mdata['clear_log'];
			} else {
				return substr($this->mdata['clear_log'], 0, 20);
			}
		}
		return "";
	}

	public function getTheHashUrl($type = 1)
	{
		$rs = [1 => 'rec', 2 => 'sed', 3 => 'eny', 4 => 'inv', 5 => 'empp', 6 => 'aqis'];
		return isset($rs[$type]) ? 'https://os.toplogistics.com.au/parcelStatus?hbn=' . urlencode($this->hbn) . '&ref=' . urlencode($this->ref) . '&h=' . HashVerify::genHash($this) . '&r=' . $rs[$type] : '';
	}

	public function getSeaHashUrl($type = 1)
	{
		$url = "";
		$hostName = "https://os.toplogistics.com.au";
		if ($type == 1) {
			$url = $hostName . "/importPayment/seaStorage?hbn=" . urlencode($this->hbn) . "&h=" . HashVerify::genHash($this);
		}
		return $url;
	}

	public function getSeaParcelInfo()
	{
		$info = ['available_date' => '', 'storage_start_date' => '', 'pay_type' => 1, 'rate_base' => '', 'rate' => '', 'unit' => '', 'storage_end_date' => ''];
		if (!empty($this->consol->mdata['available_date'])) {
			$info['available_date'] = date("Y-m-d", strtotime($this->consol->mdata['available_date']));
			$info['storage_start_date'] = date("Y-m-d", strtotime('+3 day', strtotime($this->consol->mdata['available_date'])));
		}
		if (!empty($this->mdata['storage_end_date'])) {
			$info['storage_end_date'] = $this->mdata['storage_end_date'];
		}
		//default sea storage paid by CBM,
		//future this rool may changed.
		// (AUD80 + 30/CBM/DAY) /shipment
		//  2018-09-22  rate given by Michelle
		$info['pay_type'] = 1;
		$info['unit'] = sprintf("%.3f", floatval($this->cbm * $this->pkg));
		$info['rate_base'] = 80;
		$info['rate'] = 30;
		return $info;
	}

	public function genSeaStorageInvoice()
	{
		$appName = Yii::app()->name;
		if($this->isTLA())
		{
			Yii::app()->name = 'TLA';
		}else
		{
			Yii::app()->name = 'HVLV';
		}
		$errors = [];
		$seaInfo = $this->getSeaParcelInfo();
		if (empty($seaInfo['storage_start_date'])) {
			$errors[] = "The Available date should be supplied at the consol";
		}
		if (empty($seaInfo['storage_end_date'])) {
			$errors[] = "The storage end date should be supplied at the shipment";
		}
		if (empty($seaInfo['unit'])) {
			$errors[] = "The shipment volume shoulde be supplied.";
		}
		//find if have invoice paid
		$paidInvoice = Invoice::model()->find('pid=:pid AND type=:type AND status =9', [':pid' => $this->id, ':type' => Invoice::INVOICE_TYPE_SEA_STORAGE]);
		if (!empty($paidInvoice)) {
			$errors[] = "The Invoice has been already Paid!";
		}
		$inv = null;
		$oldInv = null;
		$invoices = Invoice::model()->findAll('pid=:pid AND type=:type AND status in (1,2,3,6,7)', [':pid' => $this->id, ':type' => Invoice::INVOICE_TYPE_SEA_STORAGE]);
		if (sizeof($invoices) > 1) {
			$errors[] = 'there are more than one Storage invoice for this shipment';
		}
		if (!empty($errors)) {
			return $errors;
		}
		if (!empty($invoices) && sizeof($invoices) == 1) {
			$inv = $invoices[0];
		}
		if (!empty($inv) && $inv->isInvoiceClosed()) {
			// in case invoice frozen and create credit for it
			$oldInv = $inv; //store inv  and created credit to it when we successfully create a new invoice;
			// create a new invoice the for this month
			$invRef = 'Original Invoice : ' . $inv->no;
			$oldInvoiceNo = $inv->no;
			$inv = new Invoice;
			$inv->no = Invoice::genNewInvoiceNo($oldInvoiceNo); //$oldInvoiceNo . '-1';
			$inv->ref = $invRef;
			$inv->date = date('Y-m-d');
			$inv->posted = $inv->date;
			$inv->status = Invoice::INVOICE_STATUS_PENDING; // set as posted which means will send to client for paying
		}
		if (empty($inv)) {
			$inv = new Invoice;
			$inv->date = date('Y-m-d');
			$inv->posted = $inv->date;
			$inv->status = Invoice::INVOICE_STATUS_PENDING;
		}

		$inv->type = Invoice::INVOICE_TYPE_SEA_STORAGE; // for import parcels
		$inv->dpmt = Invoice::DPMT_IMPORT;
		$inv->to_id = Org::ORGID_IMPORT_CASUAL_CUSTOMER;
		$inv->pid = $this->id;
		$inv->consol_id = $this->consol_id;
		$inv->man_id = 0; // in case there is no manifest now
		$inv->dpt_id = isset($this->consol->dpt_id) ? $this->consol->dpt_id : 0;
		$inv->currency = 1;
		$inv->mdata['name'] = !empty($this->cnee->company) ? $this->cnee->company : $this->cnee->name;
		$inv->mdata['address'] = $this->cnee->fullAddress();
		$inv->mdata['payterm'] = 'COD';
		$inv->mdata['awb'] = isset($this->consol->awb) ? $this->consol->awb : '';
		$inv->due = date('Y-m-d', strtotime($seaInfo['storage_end_date'])); //we need a due day...
		$inv->gst = 0;
		$inv->total = 0;
		//cal the amount of invoice
		$startDate = new DateTime(date('Y-m-d', strtotime($seaInfo['storage_start_date'])), new DateTimeZone('Australia/Sydney'));
		$endDate = new DateTime($seaInfo['storage_end_date'], new DateTimeZone('Australia/Sydney'));
		$storedDuration = $startDate->diff($endDate)->format("%r%a") + 1;
		if ($storedDuration <= 0) {
			$errors[] = "the storage duration is less than zero";
			return $errors;
		}
		$amount = $seaInfo['rate_base'] + $seaInfo['rate'] * $seaInfo['unit'] * $storedDuration;
		if ($amount <= 0) {
			$errors[] = "the invoice amount is less than zero";
			return $errors;
		}
		//end calculation the amount of invoice

		$items[] = [@$this->consol->awb, $this->hbn, $this->getDesc(), $this->pkg, $this->weight, $this->cbm, $amount, $this->ref, $seaInfo['rate_base'], $seaInfo['rate'], $storedDuration, $seaInfo['storage_start_date'], $seaInfo['storage_end_date']];
		$gst = 0;
		$org = Org::model()->findByPk(Org::ORGID_IMPORT_CASUAL_CUSTOMER); //1228 casual Org
		if (isset($org) && isset($org->extra['incl_gst'])) {
			if ($org->extra['incl_gst'] == 1) {
				$gst = round($amount * 10 / 100, 2);
			}
		}
		if ($amount > 0) {
			$inv->total += $amount;
			$inv->gst += $gst;
			$inv->total += $gst;
			if ($inv->save()) {
				foreach ($inv->lines as $line) {
					$line->delete();
				}
				$il = new InvLine;
				$il->inv_id = $inv->id;
				$il->amount = $amount;
				$il->amount += $gst;
				$il->gst = $gst;
				$il->qty = 1;
				$il->mdata['items'] = $items;
				$il->fid = 0;
				$il->save();
				if (!empty($oldInv)) {
					$oldPaymentsList = $oldInv->createCreditForMe();
				}
				// apply old payments for the new created invoice
				if (!empty($oldPaymentsList)) {
					$inv->applyPayments($oldPaymentsList);
				}
			} else {
				$errors = $inv->getErrors();
			}
		}
		return $errors;
	}

	/**
	 *  get the CA, storage DDU(WHEN DDU and having storage fees
	 * @return type
	 */
	public function getCasulInvTotal()
	{
		$invoices = Invoice::model()->findAll('dpmt=10 AND type in (41,45) AND pid=:pid AND status in(1,2,3) ORDER BY id DESC', [':pid' => $this->id]);
		$total = 0;
		$ref = [];
		$balance = 0;
		$paypalUrls = "";
		foreach ($invoices as $inv) {
			$total += $inv->total;
			$ref[] = $inv->no;
			$balance += $inv->total - $inv->paid();
			$paypalUrls.="<p><a href='".$inv->getPaypalUrl()."'>click and pay ".$inv->no." via paypal</a></p>";
		}
		return [$total, implode(', ', $ref), $total - $balance,$paypalUrls];
	}

	public function getProcessStatus()
	{
		return isset(ShipmentProcess::$states[isset($this->process->status) ? $this->process->status : -1]) ? Yii::t(strtolower(__CLASS__), ShipmentProcess::$states[$this->process->status]) : "new";
	}

	public function getSeaProcessStatus()
	{
		return isset(SeaProcess::$states[isset($this->sea_process->status) ? $this->sea_process->status : -1]) ? Yii::t(strtolower(__CLASS__), SeaProcess::$states[$this->sea_process->status]) : "";
	}

	public function createCourierLabel($courier, $country = 'AU')
	{
		if(!empty($courier->mdata['business_type']))//B2B or B2C
		{
			if($courier->mdata['business_type']==OrgRate::B2C_TYPE&&!empty($this->mdata['is_b2b']))
			{
				return false;
			}else if($courier->mdata['business_type']==OrgRate::B2B_TYPE&&empty($this->mdata['is_b2b']))
			{
				return false;
			}
		}

		$this->ddpt_id = empty($courier->mdata['ddpt_id'])? 0 : $courier->mdata['ddpt_id'];

		$this->nolog = true;
		$this->mdata['org_id'] = $courier->org_id;
		$this->mdata['org_rate_id'] = $courier->id;
		//for pallet rate cargos
		if(!empty($courier->mdata['plt_pricing']))
		{
			$this->cbwf = $this->cbwf|ImParcel::CBWF_PALLET_CARO;
		}



		if ($country == 'NZ'&&$courier->code!=ImportChargeCode::AUPOST_INTERNATIONAL_CODE) {
			$this->ref = 'NZ' . sprintf('%07s', substr($this->id, -7));
		} else {
			switch ($courier->org_id) {
				case Org::ORGID_COURIER_TLA:  // for Top Logistics
					switch ($courier->id) {
						case 525: //mel
						case 10318:
							$pfx = 'MKP';
						break;
						case 10321:
						case 675: //bne
							$pfx = 'BKP';
						break;
						case 10324:
						case 949: //per
							$pfx = 'PKP';
						break;
						case 10459: //SYD
							$pfx = 'SKPX';
						break;
						case 10462: //MEL
							$pfx = 'MKPX';
						break;
						case 10465:
							$pfx = 'BKPX';
						break;
						case 10468:
							$pfx = 'PKPX';
						break;
						default: // 70 syd
							$pfx = 'SKP';
						break;
					}
					
					if(!preg_match('/^(ECN|TCN|TSN|TMN|TBN|TAN|TPN|TFN)/', $this->hbn))
					{
						$hbn = $this->genHbn();
					}else
					{
						$hbn = $this->hbn;
					}

					$this->ref = preg_replace('/^(ECN|TCN|TSN|TMN|TBN|TAN|TPN|TFN)/', $pfx, $hbn);
				break;
				case Org::ORGID_COURIER_PICKUP:
					if($courier->code == ImportChargeCode::PICKUP_NON_REF_CODE)
					{
						$this->ref = $this->hbn;
					}elseif($courier->code == ImportChargeCode::PICKUP_3PL_CODE){
						//PICKUP8 + ID7 FOR 3PL
						$this->ref = 'PICKUP8' . sprintf('%07s', substr($this->id, -7));
					}
					else
					{
						//PICKUP6 + ID7 FOR NORMAL
						$this->ref = 'PICKUP6' . sprintf('%07s', substr($this->id, -7));
						//OLD CODE 2022/3/3
						//$this->ref = 'PICKUP' . sprintf('%07s', substr($this->id, -7));
					}
				break;
				case Org::ORGID_COURIER_FASTWAY: // for Fastway
					return $this->createFastwayLabel();
				break;
				case Org::ORGID_COURIER_AUPOST: // for Australia Post Office
					$mildsMatch = [
						ImportChargeCode::SYDNEY_AUPOST_ID_CODE => 'AMQ',
						ImportChargeCode::MELBOUNE_AUPOST_ID_CODE => '33EVH',
						ImportChargeCode::BRISBANE_AUPOST_ID_CODE => '33EVJ',
						ImportChargeCode::PERTH_AUPOST_ID_CODE => '34AWE',
						ImportChargeCode::ECOF_AUPOST_ID => '33MBQ',
						ImportChargeCode::GV_4PORTS => 'UWQ',
					];
					$mild = 'AMQ';
					if(isset($mildsMatch[$courier->code]))
					{
						$mild = $mildsMatch[$courier->code];
					}

					if(isset($mildsMatch[$courier->id]))
					{
						$mild = $mildsMatch[$courier->id];
					}
					
					return $this->createAuPostLabel($mild, $courier->id);
				break;
				case Org::ORGID_COURIER_TOLL: // for toll label
					return $this->createTollLabel();
				break;
				case Org::ORGID_COURIER_STARTRACK: // for StarTrack label
					$ss = $courier->id == ImportChargeCode::STARTRACK_MEL? 'mel' : 'syd';
					return $this->createStartrackLabel($ss);
				break;
				case  Org::ORGID_COURIER_AUSLETTER:
					return $this->createAusLetterLabel();
				break;
				case Org::ORGID_COURIER_UBI:
					return $this->createUbiLabel($courier);
				break;
				case Org::ORGID_COURIER_D2Z:
					if (in_array($courier->id, [ImportChargeCode::D2Z_COUNTRY_ID, ImportChargeCode::D2Z_COUNTRY_3PORT, ImportChargeCode::D2Z_COUNTRY_SYD])) {
						$type = 'old_country';
					} elseif (in_array($courier->id, [ImportChargeCode::D2Z_ETOWER_ID, ImportChargeCode::D2Z_ETOWER_3PORT, ImportChargeCode::D2Z_ETOWER_SYD])) {
						$type = 'old_etower';
					} else {
						$mildsMatch = [
							ImportChargeCode::D2Z_SYDNEY => 'syd',
							ImportChargeCode::D2Z_PERTH => 'per',
							ImportChargeCode::D2Z_MEL => 'mel',
							ImportChargeCode::D2Z_BNE => 'bne',
							ImportChargeCode::D2Z_LOCAL => 'local',
							ImportChargeCode::D2Z_LOCAL_MEL => 'local-mel',
						];
						$type = $mildsMatch[$courier->id];
					}
					return $this->createD2ZLabel($type);
				break;
				case Org::ORGID_COURIER_TNT:
					if ($courier->id == ImportChargeCode::TNT_MELBOURNE_ID) {
						return $this->createTntLabel('mel');
					} elseif ($courier->id == ImportChargeCode::TNT_BRISBANE_ID) {
						return $this->createTntLabel('bne');
					}
					
					return $this->createTntLabel('syd');
					break;
				case Org::ORGID_COURIER_HUNTER:
					return $this->createHunterLabel();
				case Org::ORGID_COURIER_DFE:
					return $this->createDfeLabel($courier->id,'syd');
					break;
				case Org::ORGID_COURIER_DFE_TOP:
					$code = OrgRate::model()->findByPk($courier->id)->code;
					if($code==ImportChargeCode::DFE_TOP_SYD_CODE)
					{
						return $this->createDfeLabel($courier->id,'syd_top');
					}else if($code==ImportChargeCode::DFE_TOP_MEL_CODE)
					{
						return $this->createDfeLabel($courier->id,'mel_top');
					}else if($code==ImportChargeCode::DFE_TOP_BNE_CODE)
					{
						return $this->createDfeLabel($courier->id,'bne_top');
					}	
					break;
				case Org::ORGID_COURIER_TNT_TOP:
					$code = OrgRate::model()->findByPk($courier->id)->code;
					if (in_array($code, [ImportChargeCode::TNT_MELBOURNE_TOP_CODE,ImportChargeCode::TNT_MELBOURNE_AMAZON_CODE])) {
						return $this->createTntLabel('mel_top');
					}else if (in_array($code, [ImportChargeCode::TNT_BRISBANE_TOP_CODE,ImportChargeCode::TNT_BRISBANE_AMAZON_CODE])) {
						return $this->createTntLabel('bne_top');
					}else if (in_array($code, [ImportChargeCode::TNT_PERTH_TOP_CODE,ImportChargeCode::TNT_PERTH_AMAZON_CODE])) {
						return $this->createTntLabel('per_top');
					}
					
					return $this->createTntLabel('syd_top');
					break;
				break;
				case Org::ORGID_COURIER_CHUKOU1:
					return $this->createChuKou1Label($courier->id,'syd');
					
					break;
				case Org::ORGID_COURIER_SF:
					return $this->createSFLabel($courier->id,$courier->mdata['api_type']);
					break;
				case Org::ORGID_COURIER_ALLIED:
					$code = OrgRate::model()->findByPk($courier->id)->code;
					$type = EizAPI::RATE_TYPE[$code];
					if(!empty($type))
					{
						return $this->createEizLabel($courier->id,$type);
					}
					break;

				case Org::ORGID_COURIER_TOLL_IPEC:
					$code = OrgRate::model()->findByPk($courier->id)->code;
					$type = MyTollAPI::RATE_TYPE[$code];
					if(!empty($type))
					{
						return $this->createMyTollLabel($courier->id,$type);
					}
					break;

				case Org::ORGID_COURIER_GV_AUPOST: // for Australia Post Office
					$mildsMatch = [
						ImportChargeCode::SYDNEY_GV_AUPOST_ID_CODE => '34KHX',
						ImportChargeCode::MELBOURNE_GV_AUPOST_ID_CODE => '34KG6',
						ImportChargeCode::BRISBANE_GV_AUPOST_ID_CODE => '34KHY',
						ImportChargeCode::PERTH_GV_AUPOST_ID_CODE => '34KHW',
						ImportChargeCode::MELBOURNE_GV_AUPOST_ID_CODE_2 => '34WMP'
					];
					$mild = '34KHX';
					if(isset($mildsMatch[$courier->code]))
					{
						$mild = $mildsMatch[$courier->code];
					}

					if(isset($mildsMatch[$courier->id]))
					{
						$mild = $mildsMatch[$courier->id];
					}
					
					return $this->createGVAuPostLabel($mild, $courier->id);
				break;

				case Org::ORGID_COURIER_AUK: // for AUK TOLL
					return $this->createAUKTollLabel($courier);
				break;

				case Org::ORGID_COURIER_BORDER: // for MY BORDER
					return $this->createMyBorderLabel($courier);
				break;
				
				case Org::ORGID_COURIER_FL: // for FL hunter
					$code = OrgRate::model()->findByPk($courier->id)->code;
					$type = FLHunterFTP::RATE_TYPE[$code];
					return $this->createFLHunter($courier->id,$type);
				break;

				case Org::ORGID_COURIER_ALLIED_TOP: // for Allied Top
					return $this->createHvlvJavaLabel($courier->id);
				break;

			}
		}

		$this->update('ref');
		$this->nolog = false;
		return true;
	}

	public function createTollLabel()
	{
		// clear all old tranship
		Tranship::model()->deleteAll('pid = :pid', [':pid' => $this->id]);
		$this->unsetMetaFlag();
		$this->ref = TollAPI::getTollConnoteNumber($this);
		$this->nolog = true;
		$this->update(['ref']);
		$this->nolog = false;
		return true;
	}

	public function createStartrackLabel($type = 'syd')
	{
		if ($this->id <= 0) {
			return false;
		}
		// clear all old tranship
		Tranship::model()->deleteAll('pid = :pid', [':pid' => $this->id]);
		$this->unsetMetaFlag();
		$ss = new StarTrackAPI($type, true);
		$result = $ss->createShipments($this);
		if ($result && isset($result->shipments) && is_array($result->shipments)) {
			$result = $result->shipments[0];
			$cost = $result->shipment_summary->total_cost;

			$this->mdata['ss_shipment_id'] = $result->shipment_id;
			$result_item = [];
			foreach ($result->items as $item) {
				if (!empty($item->tracking_details->article_id)) {
					if (preg_match('/(?<=7RFZ|4XHZ)\d{8}EXP(\d{5})/i', $item->tracking_details->article_id, $match)) {
						$result_item[intval($match[1] - 1)] = $item->item_id;
					}
				}
			}
			ksort($result_item);
			$this->mdata['ss_shipment_items'] = $result_item;
			$this->nolog = true;
			$this->updateMeta();
			// startrack label format: 7RFZ50000002EXP00001, we only need 7RFZ50000002
			// EXP00001 is index
			if (!empty($this->ref)) {
				$this->note .= '(' . $this->ref . ')';
			}
			$this->ref = substr($result->items[0]->tracking_details->article_id, 0, 12);
			$this->update(['ref', 'note']);
			// create label
			$respLabel = $ss->createLabels([$result->shipment_id]);
			$lblRequestId = '';
			if ($respLabel) {
				// get label  request ID
				// then we can print label based on request ID
				$lblRequestId = $respLabel->labels[0]->request_id;
				$this->mdata['ss_lbl_request_id'] = $lblRequestId;
				$this->updateMeta();

				// save tranship information for startrack courier
				$ts = new Tranship;
				$ts->pid = $this->id;
				$ts->org_id = Org::ORGID_COURIER_STARTRACK; // for StarTrack
				$ts->man_id = $this->man_id;
				$ts->type = 80; // shipment transfer to a different delivery courier
				$ts->status = 19; // in finally moving status
				$ts->connote = $this->ref;
				$ts->time = date('Y-m-d H:i:s');
				$ts->mdata['ss_shipment_id'] = $result->shipment_id;
				$ts->mdata['ss_lbl_request_id'] = $lblRequestId;
				$ts->cost = round($cost, 2);
				$ts->save();
			}
			$this->nolog = false;
			return true;
		}
		return false;
	}

	public function createWinitLmaLabel($exp = false, $pp = 'SYD')
	{
		if ($this->id <= 0) {
			return false;
		}
		Tranship::model()->deleteAll('pid = :pid', [':pid' => $this->id]);
		$this->unsetMetaFlag();
		$this->mdata['lma'] = $this->getWinitLmaNo($exp, $pp);
		$this->ref = self::genEparcelNo(101, $pp == 'SYD' ? '33FJV' : '33FKB');
		if (empty($this->ref)) {
			return false;
		}

		$this->mdata['test_aupost_2017'] = 1;
		$this->update(['ref']);
		$this->updateMeta();
		return true;
	}

	public static function genHunterNo()
	{
		return ConnoteRange::newNumber('Org', 140, 'PB');
	}

	public function createHunterLabel($mani = false)
	{
		if ($this->id <= 0) {
			return false;
		}
		Tranship::model()->deleteAll('pid = :pid', [':pid' => $this->id]);
		$this->unsetMetaFlag();

		if ($mani == false) {
			$this->ref = ImParcel::genHunterNo();
			$this->nolog = true;
			$this->update(['ref']);
			$this->nolog = false;
		} else {
			$hunter = new HunterAPI(false);
			$result = $hunter->bookingJob($this);
			if (!empty($result['trackingNumber'])) {
				$this->ref = $result['trackingNumber'];
				$this->update('ref');

				$ts = new Tranship;
				$ts->pid = $this->id;
				$ts->org_id = Org::ORGID_COURIER_HUNTER;
				$ts->man_id = $this->man_id;
				$ts->type = 80;
				$ts->status = 19;
				$ts->connote = $this->ref;
				$ts->time = date('Y-m-d H:i:s');
				$ts->mdata['hunter_job_number'] = $result['jobNumber'];
				$ts->mdata['oid'] = Org::ORGID_COURIER_HUNTER;
				$ts->cost = number_format(round($result['fee'], 2), 2, '.', '');
				if ($ts->save()) {
					return true;
				}
			}
		}

		return true;
	}

	public function manifestHunterLabel()
	{
		if ($this->id <= 0) {
			return false;
		}
		Tranship::model()->deleteAll('pid = :pid', [':pid' => $this->id]);
		$this->unsetMetaFlag();

		$hunter = new HunterAPI(false);
		$result = $hunter->bookingJob($this);
		if (!empty($result['trackingNumber'])) {
			$this->ref = $result['trackingNumber'];
			$this->update('ref');

			$ts = new Tranship;
			$ts->pid = $this->id;
			$ts->org_id = Org::ORGID_COURIER_HUNTER;
			$ts->man_id = $this->man_id;
			$ts->type = 80;
			$ts->status = 19;
			$ts->connote = $this->ref;
			$ts->time = date('Y-m-d H:i:s');
			$ts->mdata['hunter_job_number'] = $result['jobNumber'];
			$ts->mdata['oid'] = Org::ORGID_COURIER_HUNTER;
			$ts->cost = number_format(round($result['fee'], 2), 2, '.', '');
			if ($ts->save()) {
				return true;
			}
		}
	}

	public function createD2zLabel($type = 'auto')
	{
		if ($this->id <= 0) {
			return false;
		}
		if ($this->pkg>1) {
			return false;
		}
		if ($type == 'old_country') {
			$this->ref= D2zCountryRate::genNo();
			$this->nolog = true;
			$this->mdata['test_aupost_2017']=1;
			$aid = $this->ref.sprintf('%02s', 1).'00093'.'50'.'0';
			$aid .= AusPostAPI::aidChkDgt($aid);
			$this->note = $aid;
			$this->nolog = true;
			$this->update(['ref','note']);
			$this->updateMeta();
			$this->nolog = false;
			return true;
		} elseif ($type == 'old_etower') {
			$d2z=new D2zAPI(false, false, $courier->id);
			$result=$d2z->createShipment([$this]);
			if (is_object($result)) {
				if ($result->status=="Failed") {
					return false;
				}
			} elseif (is_array($result)) {
				$result=$result[0];
				if ($result->status=="Succeeded") {
					$d2zOrderId=$result->orderId;
					$refLong=$result->trackingNo;
					$ref= substr($refLong, 0, -11);
					$this->nolog = true;
					$this->ref = $ref;
					if (!empty($result->orderId)) {
						$this->mdata['d2z_shipment_orderid']=$result->orderId;
					}
					$this->mdata['test_aupost_2017']=1;
					$aid = $this->ref.sprintf('%02s', 1).'00093'.'51'.'0';
					$aid .= AusPostAPI::aidChkDgt($aid);
					if ($aid!=$result->trackingNo) {
						return false;
					}
					$this->note = $aid;
					$this->nolog = true;
					$this->update(['ref','note']);
					$this->updateMeta();
					$this->nolog = false;
					$ts = new Tranship;
					$ts->pid = $this->id;
					$ts->org_id = 101;  // for Fastway post office
					$ts->man_id = $this->man_id;
					$ts->type = 80;  // shipment transfer to a different delivery courier
					$ts->status = 19; // in finally moving status
					$ts->connote = $this->ref;
					$ts->time = date('Y-m-d H:i:s');
					$ts->cost = 0;
					if ($ts->save()) {
						return true;
					}
				}
			}
		} elseif (in_array($type, ['local','local-mel', 'mel', 'bne', 'per'])) {
			if (empty($this->ref)) {
				switch ($type) {
					case 'local':
						$this->ref = self::genEparcelNo('1426', '33G7K');
					break;
					case 'local-mel':
					case 'mel':
						$this->ref = self::genEparcelNo('1426', '33G7L');
					break;
					case 'bne':
						$this->ref = self::genEparcelNo('1426', '33PET');
					break;
					case 'per':
						$this->ref = self::genEparcelNo('1426', '33PEH');
					break;
				}
			}
			$this->nolog = true;
			$this->mdata['d2ztype'] = $type;
			$aid = $this->ref.sprintf('%02s', 1).'00093'.'51'.'0';
			$aid .= AusPostAPI::aidChkDgt($aid);
			$this->note = $aid;
			$this->update('ref', 'note', 'meta');
			$this->nolog = false;

			$ts = new Tranship;
			$ts->pid = $this->id;
			$ts->org_id = Org::ORGID_COURIER_D2Z;
			$ts->type = 80;
			$ts->status = 10;
			$ts->connote = $this->ref;
			$ts->time = date('Y-m-d H:i:s');
			$ts->mdata['d2z_barcodeLabelNumber'] = $aid;
			$ts->cost = 0;
			if ($ts->save()) {
				return true;
			}
		} else {
			$d2z = new D2zShipAPI($type);
			$result = $d2z->createConsignments($this);
			if (is_array($result) && !empty($result[0]['barcodeLabelNumber'])) {
				if (preg_match('/(\]d2019931265099999891)?([A-Z0-9]{3,5}\d{7})(\d{2}000\d{4}0\d{1})(\d{23})?$/', $result[0]['barcodeLabelNumber'], $m)) {
					$this->ref = $m[2];
					$this->note = $m[2].$m[3];
				} else {
					$this->ref = $result[0]['barcodeLabelNumber'];
				}
				$this->mdata['d2ztype'] = $type;
				$this->nolog = true;
				$this->update('ref', 'note', 'meta');
				$this->nolog = false;

				$ts = new Tranship;
				$ts->pid = $this->id;
				$ts->org_id = Org::ORGID_COURIER_D2Z;
				$ts->type = 80;
				$ts->status = 19;
				$ts->connote = $this->ref;
				$ts->time = date('Y-m-d H:i:s');
				$ts->mdata['d2z_barcodeLabelNumber'] = $result[0]['barcodeLabelNumber'];
				$ts->cost = 0;
				if ($ts->save()) {
					return true;
				}
			} else {
				$this->tempErrors = @json_encode($result['errorDetails']);
				return false;
			}
		}
	}

	public function createChuKou1Label($orgRateId,$type = 'syd')
	{
		$this->mdata['org_rate_id'] = $orgRateId;
		$ck1Api = new CK1API();
		$result = $ck1Api->createShipment($this);
		if(!empty($result['ref']))
		{
			$cost =  $ck1Api->getCost($orgRateId,$this);
			$this->ref = $result['ref'];
			$ts = new Tranship;
			$ts->pid = $this->id;
			$ts->org_id = Org::ORGID_COURIER_CHUKOU1; // for StarTrack
			$ts->man_id = $this->man_id;
			$ts->type = 80; // shipment transfer to a different delivery courier
			$ts->status = 19; // in finally moving status
			$ts->connote = $this->ref;
			$ts->time = date('Y-m-d H:i:s');
			$ts->mdata['Ck1PackageId'] = $result['Ck1PackageId'];
			$ts->cost = round($cost, 2);
			$ts->save();
		}else
		{
			return false;
		}
		$this->save();
		return true;
	}

