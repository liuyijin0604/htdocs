	public function getParcelLongRef($org_id,$isBarcode = false)
	{
		$longRef = [];
		$aupostPrefix = '019931265099999891';
		if (preg_match('/^(AMQ|333UF|33EVH|33EVJ|33A8Y|34KHX|34KHW|34KG6|34KHY|34WMP)\d{7}/', $this->ref)) {
			for ($i = 1; $i <= $this->pkg; $i++) {
				$aid = $this->ref . sprintf('%02s', $i) . '00093' . '50' . '0';
				$aid .= AusPostAPI::aidChkDgt($aid);
				if($isBarcode) $aid = $aupostPrefix.$aid;
				$longRef[] = $aid;
			}
		} elseif (preg_match('/^(33MBQ)\d{7}/', $this->ref)) {
			for ($i = 1; $i <= $this->pkg; $i++) {
				$aid = $this->ref . sprintf('%02s', $i) . '00093' . '15' . '0';
				$aid .= AusPostAPI::aidChkDgt($aid);
				if($isBarcode) $aid = $aupostPrefix.$aid;
				$longRef[] = $aid;
			}
		} elseif (!empty($this->mdata['d2z_shipment_orderid'])) {
			$aid = $this->ref . sprintf('%02s', 1) . '00093' . '51' . '0';
			$aid .= AusPostAPI::aidChkDgt($aid);
			if($isBarcode) $aid = $aupostPrefix.$aid;
			$longRef[] = $aid;
		} elseif (preg_match('/^(33G7K|33G7L|349PU|349PV)\d{7}/', $this->ref)) {
			for ($i = 1; $i <= $this->pkg; $i++) {
				$aid = $this->ref . sprintf('%02s', $i) . '00093' . '51' . '0';
				$aid .= AusPostAPI::aidChkDgt($aid);
				if($isBarcode) $aid = $aupostPrefix.$aid;
				$longRef[] = $aid;
			}
		} elseif(preg_match("/^(TLS|LPC|LMA|TBC|DKC|PCD|BPC)\d{9}/i", $this->ref))
		{
			for ($pkg_sn = 1; $pkg_sn <= $this->pkg; $pkg_sn++) {
				$item_number= TntAPI::genItemUniqueNumber($this->ref, $pkg_sn);
				$articleId="6104".$item_number."0".$this->cnee->postcode."0";
				$longRef[] = $articleId;
			}
		} elseif(isset($this->mdata['ss_lbl_request_id']))
		{
			$dept = $this->getStartrackDept();
			$route = StarTrackAPI::API_PRODUCT_ID . $this->cnee->postcode.$dept;
			for ($pkg_sn = 1; $pkg_sn <= $this->pkg; $pkg_sn++) 
			{
				$pIndex = sprintf('%04d',$pkg_sn);
				$articleId = $this->ref . StarTrackAPI::API_PRODUCT_ID . '0' . $pIndex;
				$longRef[] = $articleId;
			}
		}elseif(isset($this->mdata['org_id'])&&in_array($this->mdata['org_id'],[Org::ORGID_COURIER_DFE,Org::ORGID_COURIER_DFE_TOP]))
		{
			for ($pkg_sn = 1; $pkg_sn <= $this->pkg; $pkg_sn++) 
			{
				$pIndex = sprintf('%03d',$pkg_sn);
				if($isBarcode)
				{
					$articleId = $this->ref.$pIndex.$this->cnee->postcode;
				}else
				{
					$articleId = $this->ref.$pIndex;
				}
				$longRef[] = $articleId;
			}
		}elseif(isset($this->mdata['org_id'])&&in_array($this->mdata['org_id'],[Org::ORGID_COURIER_CHUKOU1]))
		{
			for ($pkg_sn = 1; $pkg_sn <= $this->pkg; $pkg_sn++) 
			{
				$aid =$this->ref.sprintf('%02s', $pkg_sn).'00093'.'51'.'0' ;
				$aid .= AusPostAPI::aidChkDgt($aid);
				if($isBarcode) $aid = $aupostPrefix.$aid;
				$longRef[] = $aid;
			}
		}elseif ($org_id == Org::ORGID_COURIER_FASTWAY )
		{
			$longRef[] = $this->ref;
		}elseif (isset($this->mdata['org_id'])&&in_array($this->mdata['org_id'],[Org::ORGID_COURIER_SF,Org::ORGID_COURIER_EIZ,Org::ORGID_COURIER_ALLIED,Org::ORGID_COURIER_FL_HUNTER]))
		{
			$longRef = explode(',', $this->mdata['barcode']);
		}elseif (isset($this->mdata['org_id'])&&in_array($this->mdata['org_id'],[Org::ORGID_COURIER_PCA]))
		{
			if($isBarcode)
			{
				for ($pkg_sn = 1; $pkg_sn <= $this->pkg; $pkg_sn++) 
				{
					$longRef[] = $this->ref.'-'.$pkg_sn;
				}
			}else
			{
				$longRef[] = $this->ref;
			}
		}elseif (isset($this->mdata['org_id'])&&in_array($this->mdata['org_id'],[Org::ORGID_COURIER_BORDER]))
		{
			$length = strlen($this->ref);
			$prefix = substr($this->ref, 0,$length-6);
			$number = substr($this->ref, $length-6,$length);
			if($isBarcode)
			{
				for ($pkg_sn = 1; $pkg_sn <= $this->pkg; $pkg_sn++) 
				{
					$longRef[] = $prefix.'BX00000'.$number.sprintf('%03s', $pkg_sn);
				}
			}else
			{
				$longRef[] = $this->ref;
			}
		}else
		{
			if(!empty($this->mdata['barcode']))
			{
				$longRef = explode(',',$this->mdata['barcode']);
			}else
			{
				$longRef[] = $this->ref;
			}
		}
		return $longRef;
	}

	public function getParcelBarcode($org_id)
	{
		return $this->getParcelLongRef($org_id,true);

	}

	public static function getCouriersByPostcodeWeight(&$orgRates, $postCode, $weight, $packs,$suburb = "",$type = false,$shipment="")
	{
		$rtCouriers = [];
		foreach ($orgRates as $orgRate) {
			$price = ImcoConsol::getCourierCostPrice($orgRate, $postCode, $weight, $packs,false,$suburb,false,'',$shipment);
			//$zone = ImcoConsol::getCourierCostPrice($orgRate, $postCode, $weight, $packs,false,$suburb,true);
			if ($price <= 0) {
				continue;
			} //means not in the delivery zoo
			if($type)
			{
				$rtCouriers[] = ['id' => $orgRate->id, 'price' => $price, 'name' => $orgRate->name];
			}else
			{
				$rtCouriers[] = ['id' => $orgRate->id, 'price' => AppHelper::money_format('%i', $price), 'name' => $orgRate->name];
			}
		}
		if (empty($rtCouriers)) {
			return false;
		} else {
			//find the cheap one from the $rtCouriers;
			$cheap = $rtCouriers[0];
			$cheapPrice = $rtCouriers[0]['price'];
			foreach ($rtCouriers as $index => $oneCourier) {
				if ($index == 0) {
					continue;
				}
				if ($oneCourier['price'] < $cheapPrice) {
					$cheap = $oneCourier;
					$cheapPrice = $oneCourier['price'];
				}
			}
			return $cheap;
		}
	}

	public static function getSingleCourierByPostcodeWeight(&$orgRate, $postcode, $weight, $packs)
	{
		$price = ImcoConsol::getCourierTestCostPrice($orgRate, $postcode, $weight, $packs);
		// $price=$price*$packs;
		$price['id'] = $orgRate->id;
		$price['name'] = $orgRate->name;
		return $price;
	}

	public function hasCustomProcess()
	{
		if (!empty($this->process)) {
			return true;
		} else {
			return false;
		}
	}

	public function getCourierId()
	{
		if ($this->isFastway()) {
			return Org::ORGID_COURIER_FASTWAY;
		} elseif ($this->isAusPost()) {
			return Org::ORGID_COURIER_AUPOST;
		} elseif ($this->isStartrack()) {
			return Org::ORGID_COURIER_STARTRACK;
		} elseif ($this->isToll()) {
			return Org::ORGID_COURIER_TOLL;
		} elseif ($this->isLetter()) {
			return Org::ORGID_COURIER_AUSLETTER;
		} else {
			if (!empty($this->trans)) {
				$trans = $this->trans;
				return end($trans)->org_id;
			}
		}
		return Org::ORGID_COURIER_PCA;
	}

	public function isFastway()
	{
		if (preg_match("/(BD|CD|GD|HD|LD|ML|OD|PD|QH|QI|QJ|RC|RD|VD|XD|ZD)\d{10}/i", $this->ref)) {
			return true;
		}
		return false;
	}

	public function isAusPost()
	{
		if (preg_match("/(UC7|33EVJ|UBZ|SJU|33EVH|AMQ|333UF|ZK6|33A8Y)\d{7}/i", $this->ref)) {
			return true;
		}
		return false;
	}

	public function isStartrack()
	{
		if (preg_match("/(7RFZ|4XHZ)\d{8}/i", $this->ref)) {
			return true;
		}
		return false;
	}

	public function isToll()
	{
		if (preg_match("/(AWNL|AWUJ)\d{6}/i", $this->ref)) {
			return true;
		}
		return false;
	}

	public function isLetter()
	{
		return !empty($this->mdata['letter_aupost']);
	}

	/**
	 *  this is the delivery cost.
	 * @return float
	 */
	public function getDeliveryCost()
	{
		$cost = 0;
		if (!empty($this->mdata['actual_delivery_cost'])) {
			$cost = floatval($this->mdata['actual_delivery_cost']);
		} elseif (!empty($this->trans[0])) {
			$lastTrans = sizeof($this->trans);
			$cost = $this->trans[$lastTrans-1]->cost;
		}

		if (!empty($this->mdata['RTS_cost'])) {
			$cost += $this->mdata['RTS_cost'];
		}
		return $cost;
	}

	/**
	 * get the value of shipment in USD
	 * @return type
	 */
	public function getDvalue()
	{
		if ($this->currency == 1) {
			return $this->dvalue * Currency::getExrate()[0];
		} else {
			return $this->dvalue;
		}
	}

	public function getAUDValue()
	{
		if ($this->currency == 1) {
			return $this->dvalue;
		} else {
			return $this->dvalue / Currency::getExrate()[0];
		}
	}

	public function unsetMetaFlag()
	{
		unset($this->mdata['d2z_shipment_orderid']);
		unset($this->mdata['ss_shipment_id']);
		unset($this->mdata['ss_shipment_items']);
		unset($this->mdata['ss_lbl_request_id']);
		unset($this->mdata['test_aupost_2017']);
		unset($this->mdata['ddu_storage_invoice_date']);
		unset($this->mdata['import_billing_id']);
		unset($this->mdata['actual_delivery_cost']);
		unset($this->mdata['tnt']);
		$this->nolog = true;
		$this->updateMeta(true);
		$this->nolog = false;
	}

	/**
	 * if shipment not HIGH VALUE/AQIS/EMPP
	 * and the status is HELD WHEN SCAN,push to OTHER custom PROCESS,here we jsut add a flag at first
	 * then the CRON will push the parcels to the process
	 */
	public function pushToHeldProcess($includeReport = false, $update = false)
	{
		if (($this->status == 55) || ($includeReport && $this->status == 50)) {
			if (($this->bwf & 4) == 0 && ($this->bwf & 32) == 0 && ($this->bwf & 512) == 0) {
				$this->bwf = $this->bwf | ImParcel::BWF_HELD_OTHER;
				if($update){
					$this->nolog = true;
					$this->update('bwf');
					$this->nolog = false;
				}
			}
		}
	}

	public function getDepot()
	{
		if (!empty($this->consol)) {
			return $this->consol->dpt_id;
		} else {
			return 106;
		}
	}

	public function getUnpaidInvoiceAmount()
	{
		$invoices = Invoice::model()->findAll('pid=:pid AND status not in(10,8,9)', [':pid' => $this->id]);
		if (!empty($invoices)) {
			$amount = 0;
			foreach ($invoices as $inv) {
				$amount += ($inv->total - $inv->paid());
			}
			return $amount;
		}
		return 0;
	}

	public static function genEparcelNo($org = 101, $site = 'AMQ')
	{
		return ConnoteRange::newNumber('Org', $org, $site);
	}

	public function getWinitLmaNo($exp = false, $pp = 'SYD')
	{
		$w = new WinitAPI();
		$d = $w->createShipment($this, $exp ? '' : 'OSF711002525', $pp == 'SYD' ? 'AULMA001' : '');
		if (empty($d->data->orderNo)) {
			$this->tempErrors = $d->code . ': ' . $d->msg;
			return false;
		}
		return $d->data->orderNo;
	}

	/**
	 *
	 * @param type $amount the amount of money received for the invoices related to this shipment
	 */
	public function receivedPaymentByPoli($amount, $trnInfo)
	{
		$invoices = Invoice::model()->findAll('pid=:pid AND status not in(8,9,10)', [':pid' => $this->id]);
		if ($amount >= $this->getUnpaidInvoiceAmount()) {
			$this->process->paymentReceived('Poli Paid');
		}
		$payment = new Payment();
		$payment->org_id = isset($invoices[0]->to_id) ? $invoices[0]->to_id : Org::ORGID_IMPORT_CASUAL_CUSTOMER;
		$payment->amount = floatval($trnInfo['AmountPaid']);
		$payment->ref = 'POLI TRN: ' . $trnInfo['TransactionRefNo'];
		$payment->date = date('Y-m-d');
		$payment->type = 6; // default by ETF
		$payment->bank = 10; // westbank
		$payment->currency = 1; // AUD
		$payment->status = 6; // posted status ? paid finish?
		$payment->save();
		foreach ($invoices as $inv) {
			if (in_array($inv->status, [8, 9, 10])) {
				continue;
			}
			$toPay = ($inv->total - $inv->paid() > 0 ? $inv->total - $inv->paid() : 0);
			if ($toPay > 0) {
				if ($toPay <= $amount) {
					$pi = new PayInv();
					$pi->inv_id = $inv->id;
					$pi->pay_id = $payment->id;
					$pi->amount = $toPay;
					$pi->save();
					$amount -= $toPay;
				} else {
					$pi = new PayInv();
					$pi->inv_id = $inv->id;
					$pi->pay_id = $payment->id;
					$pi->amount = $amount;
					$pi->save();
					$amount = 0;
				}
				$left = $toPay - $pi->amount;
				if ($left <= 0.001) {
					$inv->status = 9;
				} else {
					$inv->status = 7;
				}
				$inv->save();
			}
		}
		$payment->ata = $amount;
		$payment->update('ata');
	}

	public function receivedPaymentBySubPay($amount, $trnInfo)
	{
		$invoices = Invoice::model()->findAll('pid=:pid AND status not in(8,9,10)', [':pid' => $this->id]);
		if ($amount >= $this->getUnpaidInvoiceAmount()) {
			$this->process->paymentReceived('wechat,AliPay Paid');
		}
		$payment = new Payment();
		$payment->org_id = isset($invoices[0]->to_id) ? $invoices[0]->to_id : Org::ORGID_IMPORT_CASUAL_CUSTOMER;
		$payment->amount = $amount;
		$payment->ref = 'SUPAY TRN: ' . $trnInfo;
		$payment->date = date('Y-m-d');
		$payment->type = 8; // default by ETF
		$payment->bank = 10; // westbank
		$payment->currency = 1; // AUD
		$payment->status = 6; // posted status ? paid finish?
		$payment->save();
		foreach ($invoices as $inv) {
			if (in_array($inv->status, [8, 9, 10])) {
				continue;
			}
			$toPay = ($inv->total - $inv->paid() > 0 ? $inv->total - $inv->paid() : 0);
			if ($toPay > 0) {
				if ($toPay <= $amount) {
					$pi = new PayInv();
					$pi->inv_id = $inv->id;
					$pi->pay_id = $payment->id;
					$pi->amount = $toPay;
					$pi->save();
					$amount -= $toPay;
				} else {
					$pi = new PayInv();
					$pi->inv_id = $inv->id;
					$pi->pay_id = $payment->id;
					$pi->amount = $amount;
					$pi->save();
					$amount = 0;
				}
				$left = $toPay - $pi->amount;
				if ($left <= 0.001) {
					$inv->status = 9;
				} else {
					$inv->status = 7;
				}
				$inv->save();
			}
		}
		$payment->ata = $amount;
		$payment->update('ata');
	}

	public function findTheStorageDate()
	{
		if (!empty($this->process) && !empty($this->process->mdata['ssdate'])) {
			return $this->process->mdata['ssdate'];
		}

		$scanRecord = ShipmentScan::model()->find('pid=:pid', [':pid' => $this->id]);
		if (!empty($scanRecord)) {
			return date('Y-m-d', strtotime($scanRecord->scan_time));
		}
		if (!empty($this->consol->eta)) {
			return $this->consol->eta;
		} else {
			return $this->created;
		}
	}

	public function getDispatchDate()
	{
		if (!empty($this->mdata['scan_time'])) {
			return date('Y-m-d', strtotime($this->mdata['scan_time']));
		} elseif (!empty($this->consol->eta)) {
			return $this->consol->eta;
		} else {
			return $this->created;
		}
	}

	/**
	 * create invoice for ddu when the day
	 *
	 */
	public function createStorageInvoiceWhenDdu($checkOnly = false,$checkToDate="",$invoiceShows="",$ignoreStatus = false)
	{
		$finalToDate = (empty($checkToDate)?date('Y-m-d'):$checkToDate);
		$appName = Yii::app()->name;
		if($this->isTLA())
		{
			Yii::app()->name = 'TLA';
		}else
		{
			Yii::app()->name = 'HVLV';
		}
		//1. if it is DDU
		//2. if its status > 50 and <58
		$reply = ['status' => 1, 'msg' => ''];//2019-08-27 gero add only air type need to do such thing
		if (($this->status >= self::STATE_REPORTED && $this->status < self::STATE_CLEAR_WAIT)||$checkOnly||$ignoreStatus) {
			// $paidInvoice = Invoice::model()->find('type = :type AND status in (6,7,9) AND pid = :pid', [':type' => Invoice::INVOICE_TYPE_DDU_STORAGE, ':pid' => $this->id]);
			// if (!empty($paidInvoice)) {
			// 	$reply['status'] = 0;
			// 	$reply['msg'] = 'the Storage Invoice are already Paid!';
			// 	return $reply;
			// }
			if (($this->bwf & self::CUSTOM_DDU) > 0 && !empty($this->process) && !empty($this->process->getStorageStartDate())) {
				$this->process->updateMeta();
				if(strtotime($this->process->mdata['ssdate'])>strtotime(date($finalToDate)))
				{
					$reply['status'] = 0;
					$reply['msg'] = 'free week';
					return $reply;
				}

				$inTime = new DateTime($this->process->mdata['ssdate'], new DateTimeZone('Australia/Sydney'));
				$outTime = new DateTime((empty($checkToDate)?'now':$checkToDate), new DateTimeZone('Australia/Sydney'));
				$storedDays = $outTime->diff($inTime)->format("%a");
				$weekendDays = HolidayHelper::getWeekendDaysBetweenTwoDays($this->process->mdata['ssdate'], $finalToDate, $this->consol->pod);
				// calculate week no
				$this->process->mdata['fw'] = floor($storedDays / 7) + 1;
				$fdDays = 0;

				$this->process->mdata['fd'] = (($storedDays-$weekendDays-$fdDays)+1)>0?($storedDays-$weekendDays-$fdDays)+1:0;
				$this->process->update('meta');

				if ($this->consol->isOurWarehouse()&&$this->consol->service == ImcoConsol::AIRCONSOL) {//below is for air
					if ($storedDays<=0||$this->process->mdata['fw'] == 0) {
						$reply['status'] = 0;
						$reply['msg'] = 'free week';
						return $reply;
					}
				} else {
					if (strtotime($this->process->mdata['ssdate']) > strtotime($finalToDate)) {//this is for sea and not belong to our warehouse
						$reply['status'] = 0;
						$reply['msg'] = 'free day';
						return $reply;
					}
				}
				if($checkOnly)
				{
					$old_invoices = [];
				}else
				{
					$old_invoices = Invoice::model()->findAll('type = :type AND pid = :pid AND status != 10', [':type' => Invoice::INVOICE_TYPE_DDU_STORAGE, ':pid' => $this->id]);
				}

				if ($this->consol->service == ImcoConsol::AIRCONSOL) {
					if ($this->consol->isOurWarehouse()) {
						$weeks = $this->process->mdata['fw'];
						foreach ($old_invoices as $invoice) {
							if (!empty($invoice->lines[0]->mdata['items'][0][10])) {
								$weeks -= $invoice->lines[0]->mdata['items'][0][10];
							}
						}
						// check ST invoice for this week
						$invoice = Invoice::model()->find('type = :type AND pid = :pid AND date > :s AND date <= :e AND status != 10', [':type' => Invoice::INVOICE_TYPE_DDU_STORAGE, ':pid' => $this->id, ':s' => date('Y-m-d', strtotime($finalToDate. ' - 1 week')), ':e' => $finalToDate]);
					} else {
						$days = $this->process->mdata['fd'];
						$oldAmount = 0;
						$minimum = 50;// $for the warehouse which is not belong to us, minimum storage fee is $50
						foreach ($old_invoices as $invoice) {
							if (!empty($invoice->lines[0]->mdata['items'][0][10])) {
								$days -= $invoice->lines[0]->mdata['items'][0][10];
								$oldAmount += $invoice->lines[0]->mdata['items'][0][6];
							}
						}

						if ($minimum-$oldAmount>=0&&!empty($old_invoices)) {
							$reply['status'] = 0;
							$reply['msg'] = 'the storage fee is included in minimum fee, do not need to regenerate';
							return $reply;
						}
					}
				} else {
					$days = $this->process->mdata['fd'];
					$oldAmount = 0;
					$minimum = $this->consol->getDDUStorageBase()['minimum'];
					$base = $this->consol->getDDUStorageBase()['base'];

					foreach ($old_invoices as $invoice) {
						if (!empty($invoice->lines[0]->mdata['items'][0][10])) {
							if ($invoice->lines[0]->mdata['items'][0][10]>0) {
								$days -= $invoice->lines[0]->mdata['items'][0][10];
							}
							$oldAmount += $invoice->lines[0]->mdata['items'][0][6];
						}
					}
				}

				if($checkOnly)
				{
					$invoice = null;
				}else
				{
					// check ST invoice for today
					$invoice = Invoice::model()->find('type = :type AND pid = :pid AND date = :s AND status != 10', [':type' => Invoice::INVOICE_TYPE_DDU_STORAGE, ':pid' => $this->id, ':s' => $finalToDate]);
				}


				if (!empty($invoice)) {
					$reply['status'] = 0;
					$reply['msg'] = 'the Storage Invoice already exists';
					return $reply;
				}

				$invoice = new Invoice();
				$invoice->status = Invoice::INVOICE_STATUS_PENDING; // set as pending which means will send to client for paying via email at night
				$invoice->type = Invoice::INVOICE_TYPE_DDU_STORAGE; // for custom casual client /DDU
				$invoice->dpmt = Invoice::DPMT_IMPORT;
				$invoice->currency = 1;
				$invoice->dpt_id = 106;
				$invoice->pid = $this->id;
				$invoice->to_id = Org::ORGID_IMPORT_CASUAL_CUSTOMER; //casual client org

				if($this->agent_id==Org::ORGID_COURIER_4PX)
				{
					$invoice->to_id = Org::ORGID_COURIER_4PX;
				}

				$invoice->consol_id = $this->consol_id;
				$invoice->mdata['name'] = !empty($invoiceShows)?$invoiceShows:(!empty($this->cnee->company) ? $this->cnee->company : $this->cnee->name);
				$invoice->mdata['address'] = $this->cnee->fullAddress();
				$invoice->mdata['payterm'] = 'COD';
				$invoice->mdata['awb'] = isset($this->consol->awb) ? $this->consol->awb : '';

				if ($this->consol->service == ImcoConsol::AIRCONSOL) {
					if ($this->consol->isOurWarehouse()) {
						$invoice->date = date('Y-m-d', strtotime($this->process->mdata['ssdate'] . ' + ' . ($this->process->mdata["fw"] - 1) . ' week'));
						$isair = empty($this->consol) || $this->consol->service == 10;
						$rate = $isair ? 1.4 : 0.8;
						$amount = $rate * $weeks * $this->weight; //currently $1.4/week
						$invoice->due = date('Y-m-d', strtotime($this->process->mdata['ssdate'] . ' + ' . $this->process->mdata["fw"] . ' week'));
						$items = [];
						$startDate = date('Y-m-d', strtotime($this->process->mdata['ssdate'] . ' + ' . ($this->process->mdata["fw"] - $weeks) . ' week'));
						$endDate = date('Y-m-d', strtotime($this->process->mdata['ssdate'] . ' + ' . $this->process->mdata["fw"] . ' week'));

						$items[] = [@$this->consol->awb, $this->hbn, $this->getDesc(), $this->pkg, $this->weight, $this->cbm, $amount, $this->ref, $rate, 0, $weeks, $startDate, $endDate];
						if($checkOnly)
						{
							$calData = ['week',$rate, $weeks,$this->weight,'kg'];
						}
					} else {
						$invoice->date = date('Y-m-d');
						$rate = 0.2;
						if (empty($old_invoices)) {
							$amount = $rate * $days * $this->weight; //currently $1.4/week
							$invoice->mdata['amount_without_minimum'] = $amount;
							$amount = $amount<$minimum?$minimum:$amount;
						} else {
							$amount = ($rate * $this->process->mdata['fd'] * $this->weight) - $oldAmount;//because there are minimum fee, so need to calculate like this way
						}

						$startDate = date('Y-m-d', strtotime($this->process->mdata['ssdate'] . ' + ' . ($fdDays+$weekendDays+$this->process->mdata["fd"]) . ' day'));
						$endDate = date('Y-m-d', strtotime($this->process->mdata['ssdate'] . ' + ' . ($fdDays+$weekendDays+$this->process->mdata["fd"]-1) . ' day'));
						$check = $days;
						while ($check>0) {
							$startDate = date('Y-m-d', strtotime($startDate . '- 1 day'));
							if (!HolidayHelper::checkDateIsHoliday($startDate, $this->consol->pod)) {
								$check--;
							}
						}

						$invoice->due = date("Y-m-d");
						$items = [];
						$items[] = [@$this->consol->awb, $this->hbn, $this->getDesc(), $this->pkg, $this->weight, $this->cbm, $amount, $this->ref, $rate, 0, $days, $startDate, $endDate];
						if($checkOnly)
						{
							$calData = ['day',$rate, $days,$this->weight,'kg',$base];
						}
					}
				} elseif ($this->consol->service == ImcoConsol::SEACONSOL) {
					$invoice->date = date('Y-m-d');
					$rate = $this->consol->getDDUStorageBase()['rate'];
					$base = $this->consol->getDDUStorageBase()['base'];
					$calculate = number_format($this->getTotalCBM(),4,'.','');
					$calType = "CBM";
					if($calculate<0.0001)
					{
						$rate = 0.15;
						$calType = "KG";
						$calculate = $this->weight;
					}
					$amount = $rate * $days * $calculate;
					$isMinimum = false;
					$isHistory = false;
					if($minimum>0)
					{
						if (empty($old_invoices)) {
							$invoice->mdata['amount_without_minimum'] = $amount;
							if($amount<($minimum-$base))
							{
								$amount = $minimum-$base;
								$isMinimum = true;
							}
						}else
						{
							$normalAmount = $rate * $this->process->mdata['fd'] * $calculate;
							$minimumWithoutBase = $minimum-$base;
							if(!empty($old_invoices)&&((round($oldAmount)==round($minimumWithoutBase)&&($minimumWithoutBase-($normalAmount)>=0)))) {
									$reply['status'] = 0;
									$reply['msg'] = 'the storage fee is included in minimum fee, do not need to regenerate';
									return $reply;
							}
							if($oldAmount==$minimumWithoutBase&&($minimumWithoutBase-($normalAmount)<0))
							{
								$amount = $normalAmount-$minimumWithoutBase;
								$isHistory = true;
							}
							if($oldAmount>$minimumWithoutBase)
							{
								$amount = $normalAmount-$oldAmount;
								$isHistory = true;
							}
						}
					}

					$invoice->due = date('Y-m-d');
					$items = [];
					$gst = 0;
					$gstB = 0;
					$org = Org::model()->findByPk(Org::ORGID_IMPORT_CASUAL_CUSTOMER);
					if (isset($org) && isset($org->extra['incl_gst'])) {
						if ($org->extra['incl_gst'] == 1) {
							$gst = round($amount * 10 / 100, 2);
							$gstB = round($base * 10 / 100, 2);
						}
					}
					$startDate = date('Y-m-d', strtotime($this->process->mdata['ssdate'] . ' + ' . ($fdDays+$weekendDays+$this->process->mdata["fd"]) . ' day'));
					$endDate = date('Y-m-d', strtotime($this->process->mdata['ssdate'] . ' + ' . ($fdDays+$weekendDays+$this->process->mdata["fd"]-1) . ' day'));
					$check = $days;
					$perAmount = $days==0?0:($amount/$days);
					while ($check>0) {
						$startDate = date('Y-m-d', strtotime($startDate . '- 1 day'));
						if (!HolidayHelper::checkDateIsHoliday($startDate, $this->consol->pod)) {
							$check--;
						}
					}
					if($calType=="CBM")
					{
						$desc = "storage, AUD ".$rate."/CBM/DAY, ".$calculate." CBM".", start date:".$startDate.", end date:".$endDate;
					}else
					{
						$desc = "storage, AUD ".$rate."/KG/DAY, ".$calculate." KG".", start date:".$startDate.", end date:".$endDate;
					}

					if($isMinimum)
					{
						$desc.=", minimum fee is AUD ".$minimum." (including handling charge)";
					}
					if($isHistory)
					{
						$desc.=", ".$normalAmount."-".$oldAmount."(history invoices) = ".$amount;
					}

					$code = "STORAGE CHARGE";
					$items[] = [@$this->consol->awb, $this->hbn, $desc, $this->pkg, $this->weight, $this->cbm, $amount, $this->ref, $rate, 0, $days, $startDate, $endDate,$gst,$gst+$amount,$code,$perAmount];

					if (empty($old_invoices)) {
						$items[] = [@$this->consol->awb, $this->hbn, "Storage handling charge/shipment", $this->pkg, $this->weight, $this->cbm, $base, $this->ref, $base, 1, 1, "", "",$gstB,$gstB+$base,$code,$base];
						$amount+=$base;
						if($checkOnly)
						{
							$calData = ['day',$rate, $days,$this->getTotalCBM(),'cbm',$base];
						}
					}
				}

				$invoice->posted = date("Y-m-d");
				$invoice->gst = 0;
				$invoice->total = 0;
				$gst = 0;
				$org = Org::model()->findByPk(Org::ORGID_IMPORT_CASUAL_CUSTOMER);
				if (isset($org) && isset($org->extra['incl_gst'])) {
					if ($org->extra['incl_gst'] == 1) {
						$gst = round($amount * 10 / 100, 2);
					}
				}
				if ($amount > 0) {
					$invoice->total += $amount;
					$invoice->gst += $gst;
					$invoice->total += $gst;
					if($checkOnly)
					{
						$reply = ['status' => 1, 'invoice' => $invoice,'items'=>$items,'cal' =>$calData];
						return $reply;
					}


					$invoice->save();
					$this->mdata['ddu_storage_invoice_date'] = $endDate;
					$this->updateMeta(true);
					foreach ($invoice->lines as $line) {
						$line->delete();
					}
					$il = new InvLine;
					$il->inv_id = $invoice->id;
					$il->amount = $amount;
					$il->amount += $gst;
					$il->gst = $gst;
					if ($gst > 0) {
						$il->tax = 'OUTPUT';
					}
					$il->qty = 1;
					$il->mdata['items'] = $items;
					//$il->model =;
					$il->fid = 0;
					$il->save();
					$reply["invoiceId"] = $invoice->id;
				}
				return $reply;
			} else {
				$reply = ['status' => 0, 'msg' => 'CUSTOM_DDU or empty process or without storage start date'];
			}
		} else {
			$reply = ['status' => 0, 'msg' => 'status is incorrect'];
		}
		return $reply;
	}

