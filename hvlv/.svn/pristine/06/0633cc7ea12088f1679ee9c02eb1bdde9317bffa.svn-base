	public function sendNoticeToCustomer()
	{
		if (isset($this->mdata["preprared_notice"])&&$this->mdata["preprared_notice"]==1) {
			if ($this->scanCount()>0&&!empty($this->process)&&in_array($this->status,[ImParcel::STATE_CLEAR,ImParcel::STATE_CLEAR_WAIT])) {
				$o = ShipmentProcess::noticeDelivery($this);
				if ($o["status"]) {
					$this->mdata["preprared_notice"] = "done";
					$this->updateMeta();
				}
			}
		}
	}

	public function getHeldReasons()
	{
		$reason = '';
		foreach (self::$held_reasons as $k => $v) {
			if (($this->bwf & $k) > 0) {
				$reason .= empty($reason) ? $v : ';' . $v;
			}
		}
		if (!empty($reason)) {
			$reason = '(' . $reason . ')';
		}
		return $reason;
	}
	public function getExtraInfo()
	{
		$info = '';
		foreach (self::$bwfs as $k => $v) {
			if (($this->bwf & $k) > 0) {
				$info .= empty($info) ? $v : ';' . $v;
			}
		}
		return $info;
	}

	public function updateHeldTrackingReason()
	{
		$tracking = Tracking::model()->find('pid=:pid and type=55 ORDER BY id DESC', [':pid' => $this->id]);
		if (!empty($tracking)) {
			$tracking->activity = 'Customs held' . $this->getHeldReasons();
			$tracking->update('activity');
		}
	}
	/**
	 * this function return the parcel's last  held tracking time.
	 */
	public function getHeldTrackingTime()
	{
		$tracking = Tracking::model()->find(['condition' => 'pid=:pid AND type=55', 'order' => 'id DESC', 'params' => [':pid' => $this->id]]);
		if (!empty($tracking)) {
			return $tracking->dt;
		}
		return false;
	}
	public function getCarrierSeq($sn = 0)
	{
		if (!isset($this->zrate)) {
			return 1;
		}

		$oid = $this->zrate->orgrate->org_id;
		$i = 1;
		foreach ($this->consol->shipments as $p) {
			if ($p->zrate->orgrate->org_id != $oid) {
				continue;
			}
			if ($p->id == $this->id) {
				return $sn == 0 ? $i : $i + $sn - 1;
			}
			$i += $p->pkg;
		}
	}

	public function chargeWeight()
	{
		// because cbm is for each item only , but weight is for total
		// so we should get total cbm by multiplied with pkg
		$totalCbm = $this->cbm * ($this->pkg > 0 ? $this->pkg : 1);
		$cubWeight = $totalCbm * 250;
		if (isset($this->mdata['chargecode'])) {
			$chargecode = $this->mdata['chargecode'];
			$chargeCodeInfo = ImportChargeCode::model()->find('chargecode = :ccode', [':ccode' => $chargecode]);
			if (!empty($chargeCodeInfo)) {
				if (isset($chargeCodeInfo->mdata['cubic_rate_factor'])) {
					switch ($chargeCodeInfo->mdata['cubic_rate_factor']) {
						case 1:
							$ratio = 167;
							break;
						case 2:
							$ratio = 200;
							break;
						default:
							$ratio = 250;
							break;
					}
					$cubWeight = $totalCbm * $ratio;
				}
			}
		}

		// if(!empty($this->mdata['org_rate_id']))
		// {
		// 	$orgRate = OrgRate::model()->findByPk($this->mdata['org_rate_id']);
		// 	if(!empty($orgRate->mdata['sub_type'])&&$orgRate->mdata['sub_type']=='plt')
		// 	{
		// 		$cubWeight = $totalCbm * 333;
		// 	}
		// }


		if (!empty($this->consol->eta) && $this->consol->eta >= "2018-01-01") {
			if ($this->agent_id == 1002 && preg_match("/7RFZ\d{8}/i", $this->ref)) {
				$cubWeight = $totalCbm * 167;
			}
		}
		return round(max($this->weight, $cubWeight, $this->temp_chargeWeight),2);

		/*

	if ( empty($this->mdata['dim']) ||
	!is_array($this->mdata['dim']) ||
	(is_array($this->mdata['dim']) && empty($this->mdata['dim']['w'] * $this->mdata['dim']['h'] * $this->mdata['dim']['d']))) {
	if (!empty($this->cbm) && $totalCbm > 0.0001 && $totalCbm < $this->weight / 180) {
	$vol = $totalCbm * 1000000;
	} else {
	$vol = $this->weight * 5000;
	}
	} else {
	$vol = $this->mdata['dim']['w'] * $this->mdata['dim']['h'] * $this->mdata['dim']['d'];
	}

	$vw = $vol / 1000000 * 200;
	return max($this->weight, $vw);
	 */
	}

	public function courierWeight()
	{
		if(!empty($this->mdata['manifest_weight'])) return $this->mdata['manifest_weight'];
		if (isset($this->mdata['chargecode'])) {
			$chargecode = $this->mdata['chargecode'];
			$chargeCodeInfo = ImportChargeCode::model()->find('chargecode = :ccode', [':ccode' => $chargecode]);
			if (!empty($chargeCodeInfo)) {
				if (!empty($chargeCodeInfo->charge_wt)) {
					return $this->weight;
				}else
				{
					return $this->getCubeWeight();
				}
			}
		}
		return $this->getCubeWeight();
	}

	public function chargeCbm()
	{// maybe useless function
		$cube = $this->cbm;

		if (isset($this->mdata['chargecode'])) {
			$chargecode = $this->mdata['chargecode'];
			$chargeCodeInfo = ImportChargeCode::model()->find('chargecode = :ccode', [':ccode' => $chargecode]);
			if (!empty($chargeCodeInfo)) {
				if (isset($chargeCodeInfo->mdata['cubic_rate_factor'])) {
					switch ($chargeCodeInfo->mdata['cubic_rate_factor']) {
						case 1:
							$ratio = 167;
							break;
						case 2:
							$ratio = 200;
							break;
						default:
							$ratio = 250;
							break;
					}
					$cube = $this->weight / $ratio;
				}
			}
		}
		return max($cube, $this->cbm);
	}

	public function getCouiercost()
	{
		$chargevalue = 0;
		if ($this->agent_id == 1206 && empty($this->mdata['chargecode'])) {
			$chargcode = preg_match('/AMQ\d{7}/i', $p->ref) ? 5813 : 8271;
			$chargevalue = $this->getChargeByChargecode($chargecode, true); //5813    8271-->fastway
			$surcharge=$this->getChargeByChargecode($chargecode,false,null,true,false,true);
			if(!empty($surcharge['amount']))
			{
				$chargevalue+=$surcharge['amount'];
			}
		} else {
			$chargevalue = $this->getRtsEstiInvoice();
		}
		return $chargevalue;
	}

	/**
	 * just guess how much we should take for RTS shipment
	 * @return int
	 */
	public function getRtsEstiInvoice()
	{
		$owner = $this->agent;
		$orgRate = OrgRate::model()->find('org_id = :oid AND type = 40', [':oid' => $owner->id]);
		$amount = $this->getChargePro($owner, $orgRate);
		if (!empty($amount)) {
			$amt2 = $this->getSurchargePro($owner, $orgRate);
			$amount[0]+=$amt2[0];
			return $amount[0];
		}
		return 0;
	}

	/**
	 *
	 */
	public function getStartrackChargeWeight()
	{
		//         if(!preg_match("/7RFZ\d{8}/i", $this->ref)) return 0;
		$reco = ReconciliationLine::model()->find('shipment_no=:ref', [':ref' => $this->ref]);
		if (empty($reco)) {
			return 0;
		} else {
			return round($reco->getCourierToOurWeight(), 2);
		}
	}
	/**
	 * charged item by applied price schedule
	 * @param $orgRate - price based on weight and piece
	 * @return array
	 */
	public function getChargePro(&$owner, &$orgRate, $dtl = true,$isSurcharge=false)
	{

		// get org rate details
		$rateInfo = json_decode($orgRate['meta']);

		// based on basic selected service to calculate the price
		$allServices = OrgRate::getServiceTypes();
		$kg_rate = 0.0; // price rate by kg
		$pc_rate = 0.0; // price rate by piece
		$aupost_rates = [];
		foreach ($allServices as $code => $name) {
			if ($code == 'AU') {
				continue;
			}

			if (!in_array($code, ['DR', 'FR'])) {
				// for local delivery service , we need to calculate price by Australia post price rate
				if ($rateInfo->$code->selected == 1) {
					$kg_rate += floatval($rateInfo->$code->rate);
					if (isset($rateInfo->$code->prate)) {
						$pc_rate += floatval($rateInfo->$code->prate);
					}
				}
			} else {
				// for Australia delivery price
				// if ( $rateInfo->$code->selected == 1 )  // even not selected maybe client select delivery service
				{
					$aupost_rates = $rateInfo->$code; // get BPA, eParcel,Letters extra rate
				}
			}
		}

		// check to see if shipment has delivery service
		$deliveryRate = 0.0;

		// 0 - nothing
		// 1 - service for eParcel
		// 2 - service for BPA
		// 3 - service for Letters

		//we need to check if we charge by pure weight or chargeable weight based on chargecode here.

		$myWeight = $this->chargeWeight();
		if (!isset($this->mdata['chargecode'])) {
			$chargecode = '';
		} else {
			$chargecode = $this->mdata['chargecode'];
		}
	
		$deliveryServiceType = 1; // default all import parcel set as eParcel
		if (isset($this->mdata['delivery_service'])) {
			$deliveryServiceType = intval($this->mdata['delivery_service']);
		}

		if (!empty($chargecode)) {
			$chargecodeInfo = ImportChargeCode::model()->find('chargecode = :cid', [':cid' => $chargecode]);
			if (!empty($chargecodeInfo)) {
				if (!empty($chargecodeInfo->charge_wt)) {
					$myWeight = $this->weight;
				}
				if (!empty($chargecodeInfo->mdata['no_calculate_invoice'])) {
					$deliveryServiceType = 0;
				}
			}
		}
		switch ($deliveryServiceType) {
			case 1:
				$deliveryRate = $this->getRateByEParcel($aupost_rates, $owner);
				break;
			case 2:
				$deliveryRate = $this->getRateByBPA($aupost_rates, $owner);
				break;
			case 3:
				// in case weight more than 500g , you shouldn't use letters
				// default we change to BPA automatically
				if ($myWeight > 0.5) {
					$deliveryRate = $this->getRateByBPA($aupost_rates, $owner);
				} else {
					$deliveryRate = $this->getRateByLetters($aupost_rates, $owner);
				}
			break;
			case 0:
				$kg_rate = 0;
				$pc_rate = 0;
				$deliveryRate = 0;
			break;
		}

		//this is used for break weight charge to record the final charge weight;
		if (!empty($this->tempChargeweight)) {
			$myWeight = $this->tempChargeweight;
		}

		// calculate total amount
		$amt = $kg_rate * $myWeight + $pc_rate * intval($this->pkg) + $deliveryRate;

		// round to 2 decimal
		$amt = round($amt, 2);
		return $dtl ? [$amt, 0, $kg_rate, $myWeight] : $amt;
	}

		/**
	 * charged item by applied price schedule
	 * @param $orgRate - price based on weight and piece
	 * @return array
	 */
	public function getSurchargePro(&$owner, &$orgRate)
	{

		// get org rate details
		$rateInfo = json_decode($orgRate['meta']);

		// based on basic selected service to calculate the price
		$allServices = OrgRate::getServiceTypes();
		$kg_rate = 0.0; // price rate by kg
		$pc_rate = 0.0; // price rate by piece
		$aupost_rates = [];
		foreach ($allServices as $code => $name) {
			if ($code == 'AU') {
				continue;
			}

			if (!in_array($code, ['DR', 'FR'])) {
				// for local delivery service , we need to calculate price by Australia post price rate
				if ($rateInfo->$code->selected == 1) {
					$kg_rate += floatval($rateInfo->$code->rate);
					if (isset($rateInfo->$code->prate)) {
						$pc_rate += floatval($rateInfo->$code->prate);
					}
				}
			} else {
				// for Australia delivery price
				// if ( $rateInfo->$code->selected == 1 )  // even not selected maybe client select delivery service
				{
					$aupost_rates = $rateInfo->$code; // get BPA, eParcel,Letters extra rate
				}
			}
		}

		// check to see if shipment has delivery service
		$deliveryRateArr = [];
		$description = "";
		// 0 - nothing
		// 1 - service for eParcel

		//we need to check if we charge by pure weight or chargeable weight based on chargecode here.

		$myWeight = $this->chargeWeight();
		if (!isset($this->mdata['chargecode'])) {
			$chargecode = '';
		} else {
			$chargecode = $this->mdata['chargecode'];
		}
	
		$deliveryServiceType = 1; // default all import parcel set as eParcel
		if (isset($this->mdata['delivery_service'])) {
			$deliveryServiceType = intval($this->mdata['delivery_service']);
		}

		if (!empty($chargecode)) {
			$chargecodeInfo = ImportChargeCode::model()->find('chargecode = :cid', [':cid' => $chargecode]);
			if (!empty($chargecodeInfo)) {
				if (!empty($chargecodeInfo->charge_wt)) {
					$myWeight = $this->weight;
				}
				if (!empty($chargecodeInfo->mdata['no_calculate_invoice'])) {
					$deliveryServiceType = 0;
				}
			}
		}
		switch ($deliveryServiceType) {
			case 1:
				$deliveryRateArr = $this->getRateByEParcel($aupost_rates, $owner,true);
				break;
			break;
		}
		return [$deliveryRateArr['amount'],[$deliveryRateArr['MHCode'],$deliveryRateArr['MHCharge'],$deliveryRateArr['MHDescription'],$deliveryRateArr['OSCode'],$deliveryRateArr['OSCharge'],$deliveryRateArr['OSDescription'],$deliveryRateArr['RECharge'],$deliveryRateArr['REDescription'],$deliveryRateArr['FuelCharge'],$deliveryRateArr['FuelDescription'],$deliveryRateArr['LevyCharge'],$deliveryRateArr['LevyDescription'],$deliveryRateArr['KpDiscountCharge'],$deliveryRateArr['KpDiscountDescription']],$myWeight];
	}


	/**
	 * @param string $code -- charge code
	 * @param bool $pureWeight
	 *         true - don't care about cube
	 *         false - will compare cube and weight to get maximum weight
	 * @return float|int|mixed
	 */
	public function getChargeByChargecode($code = '', $pureWeight = false, $testWeight = null, $getSelectedRate = false,$isDebug = false,$isSurcharge = false,$forcesCargoProcess = false)
	{
		if(!empty($this->mdata['pe_number']))
		{
			[$amount,$surcharge,$overSize,$manual,$tailgate]= PriceEnquiryService::getPEPriceFromPE($this->mdata['pe_number']);
			if($isSurcharge)
			{
				return ['amount'=>0,'rate'=>$this->mdata['pe_number'],'surcharge'=>0,'MHCharge'=>0,'MHCode'=>$this->mdata['pe_number']." MH",'MHDescription'=>$this->mdata['pe_number']." Manual handling fee $".$manual."+ Tail gate fee $".$tailgate,'OSCode'=>$this->mdata['pe_number']." OS",'OSCharge'=>0,"OSDescription"=>$this->mdata['pe_number']." oversize fee"];
			}else
			{
				return $amount+$surcharge;
			}
		}

		$selectedRate = null;
		$amount = 0;
		$surcharge = 0;
		if ($pureWeight){
			$myWeight = $this->weight;
		} else {
			$myWeight = $this->chargeWeight();
		}

		if (!empty($code)) {
			$chargecode = $code;
		} else {
			if (!isset($this->mdata['chargecode'])) {
				$amount = 0;
				$chargecode = '';
			} else {
				$chargecode = $this->mdata['chargecode'];
			}
		}
		if (!empty($chargecode)) {
			// based on chargecode to get chargecode ID
			$chargecodeInfo = ImportChargeCode::model()->find('chargecode = :cid', [':cid' => $chargecode]);

			// based on chargecode and postcode
			// get zone code
			if (!empty($chargecodeInfo)) {

				// for MH and OS Surcharge
				if($isSurcharge)
				{
					$surchargeArr = $this->calculateMHAndOSSurcharge($chargecodeInfo,$forcesCargoProcess);
					return $surchargeArr;
				}


				if (!empty($chargecodeInfo->charge_wt)) {
					$myWeight = $this->weight;
				}

				if ($testWeight!=null) {
					$myWeight = $testWeight;
				}
				/******************* Letter Part**************************/
				if (preg_match('/LET\d{7}/i', $this->ref)) {
					$letter = $this->determineSize();
					$zoneMap_tmp = '';
					$zoneMap = ZoneMap::model()->findAll('chargecode_id = :cid AND pc_lo <= :pc AND pc_hi >= :pc', [':cid' => $chargecodeInfo['id'], ':pc' => $this->cnee->postcode]);
					if (!empty($zoneMap)) {
						foreach ($zoneMap as $zmap) {
							if (preg_match("/$letter/i", $zmap['z1'])) {
								$zoneMap_tmp = $zmap;
							}
						}
						if (empty($zoneMap_tmp)) {
							$zoneMap_tmp = $zoneMap[0];
						}
						if ($this->weight == 0.25 && (($this->cbwf & 8) > 0)) {
							$myWeight += 0.1;
						} //we do 250 g for big letter.
						$zoneRates = ZoneRate::model()->findAll('chargecode_id = :cid AND weight_lo < :w AND weight_hi >= :w AND zone = :z AND base+item+perkg > 0', [':cid' => $chargecodeInfo['id'], ':w' => $myWeight, ':z' => $zoneMap_tmp['z1']]);
						if (empty($zoneRates)) {
							$zoneRates = ZoneRate::model()->findAll('chargecode_id = :cid AND weight_lo <=:w AND weight_hi >= :w AND zone = :z AND base+item+perkg > 0', [':cid' => $chargecodeInfo['id'], ':w' => $myWeight, ':z' => $zoneMap_tmp['z1']]);
						}
						foreach ($zoneRates as $zoneRate) {
							$temp = $zoneRate['base'] + $zoneRate['item'] + $zoneRate['perkg'] * $myWeight;
							if ($zoneRate['minimum'] > 0) {
								$temp = max($temp, $zoneRate['minimum']);
							}
							if ($temp>$amount) {
								$selectedRate = $zoneRate;
								//$amount = $temp;
							}
							$amount = max($amount, $temp);
						}
					}
				}
				/*************************letter Part Finished*********************************/
				else {
					//for the delivery calculate by CBM we need to change the weight to be CBM
					$cbm = 0;

					if (isset($chargecodeInfo->mdata['calculate_cbm'])&&$chargecodeInfo->mdata['calculate_cbm']==true) {
						$amount = $this->calculateTruckDeliveryChargeCodeByCBM($chargecodeInfo, $selectedRate,$testWeight,$isDebug);
					}elseif(!empty($chargecodeInfo->mdata['calculate_plt'])) {
						$amount = $this->calculateTruckDeliveryChargeCodeByPLT($chargecodeInfo, $selectedRate,$testWeight,$isDebug);
					}else{
						$amount = $this->calculateNormalByWeight($myWeight, $chargecodeInfo, $selectedRate);
					}
				}
			}
		}

		// no chargecode set
		// we use default charge rate
		if ($amount == 0&&empty($isSurcharge)) {
			// if ($myWeight >= 5) {
			// 	$amount = 8.0 + ($myWeight - 5) * 0.36; // default only
			// } else {
			// 	$amount = 8.0;
			// }
			if (isset($this->mdata['chargecode']) && in_array($this->mdata['chargecode'], [6973])) {
				$amount = 0;
			}
		}
		if (!$getSelectedRate) {
			return $amount;
		} else {
			return ['amount'=>$amount,'rate'=>$selectedRate,'surcharge'=>$surcharge];
		}
	}
	public function calculateNormalByWeight($myWeight, $chargecodeInfo, &$selectedRate = null)
	{
		if($chargecodeInfo->chargecode=='5492')
		{
			$dfeapi = new DFEAPI('syd');
			$amount = 0;
			$o = $dfeapi->getRevenue($chargecodeInfo, $this->cnee->suburb, $this->cnee->postcode, $myWeight);
			if($o->code==0)
			{
				$amount = $o->data;
			}else
			{
				$this->tempErrors = $o->msg.$this->cnee->postcode.",ref:".$this->ref;
			}
			return $amount;
		}
		//for the delivery calculate by weight
		$zoneMaps = ZoneMap::model()->findAll('chargecode_id = :cid AND pc_lo <= :pc AND pc_hi >= :pc', [':cid' => $chargecodeInfo['id'], ':pc' => @$this->cnee->postcode]);
		$amount = 0;
		foreach ($zoneMaps as $zoneMapKey => $zoneMap) 
		{
			$amount = 0;
			$checkWeight = $myWeight;
			if(!empty($this->trans[0]) && $this->trans[0]->org_id == 101)
			{
				$checkWeight = $checkWeight/$this->pkg;
				$myWeight = $myWeight/$this->pkg;
			}
			
			if ($checkWeight<0.5) {
				$checkWeight = ceil($checkWeight * 1000) / 1000;
			} else {
				$checkWeight = ceil($checkWeight * 10) / 10;
			}
			
			if (!empty($zoneMap)) {
				$zoneRates = ZoneRate::model()->findAll('chargecode_id = :cid AND weight_lo <:w AND weight_hi >= :w AND zone = :z AND base+item+perkg > 0', [':cid' => $chargecodeInfo['id'], ':w' => $checkWeight, ':z' => $zoneMap['z1']]);
				if (empty($zoneRates)) {
					$zoneRates = ZoneRate::model()->findAll('chargecode_id = :cid AND weight_lo <=:w AND weight_hi >= :w AND zone = :z AND base+item+perkg > 0', [':cid' => $chargecodeInfo['id'], ':w' => $checkWeight, ':z' => $zoneMap['z1']]);
				}

				if($chargecodeInfo->isInternational())
				{
					$country = $this->cnee->country;
					$zone = SystemSetting::getIntZone();
					if(!empty($zone[$country]))
					{
						$zoneRates = ZoneRate::model()->findAll('chargecode_id = :cid AND weight_lo <=:w AND weight_hi >= :w AND zone = :z AND base+item+perkg > 0', [':cid' => $chargecodeInfo['id'], ':w' => $checkWeight, ':z' => $zone[$country]]);
					}
				}
				// get maximum one
				/*
				 * for eParcel if 2 packs with 30kg charge weight.  so we charge 25kg+5Kg;
				 */
				if (empty($zoneRates) && (preg_match("/^AMQ|333UF|33EVH|33EVJ|34AWE\d{7}$/", $this->ref) || (!empty($this->trans[0]) && $this->trans[0]->org_id == 101))) {
					$sql = "SELECT max(weight_hi) as weight_hi FROM `zone_rate` WHERE chargecode_id=:cid AND zone=:z AND base+item+perkg > 0";
					$maxWeight = Yii::app()->db->createCommand($sql)->bindValues([':cid' => $chargecodeInfo['id'], ':z' => $zoneMap['z1']])->queryScalar();
					if ($maxWeight > 0 && $myWeight > $maxWeight) {
						while ($myWeight > $maxWeight) {
							$chargeWeight = $maxWeight;
							$myWeight -= $maxWeight;
							$tempAmount = 0;
							$zoneRates = ZoneRate::model()->findAll('chargecode_id = :cid AND weight_lo <=:w AND weight_hi >= :w AND zone = :z AND base+item+perkg > 0', [':cid' => $chargecodeInfo['id'], ':w' => ceil($chargeWeight * 10) / 10, ':z' => $zoneMap['z1']]);
							foreach ($zoneRates as $zoneRate) {
								$temp = $zoneRate['base'] + $zoneRate['item'] + $zoneRate['perkg'] * $chargeWeight;
								if ($zoneRate['minimum'] > 0) {
									$temp = max($temp, $zoneRate['minimum']);
								}
								if ($temp>$tempAmount) {
									//$tempAmount = $temp;
									$selectedRate = $zoneRate;
								}
								$tempAmount = max($tempAmount, $temp);
							}
							$amount += $tempAmount;
						}
						$zoneRates = ZoneRate::model()->findAll('chargecode_id = :cid AND weight_lo <:w AND weight_hi >= :w AND zone = :z AND base+item+perkg > 0', [':cid' => $chargecodeInfo['id'], ':w' => ceil($myWeight * 10) / 10, ':z' => $zoneMap['z1']]);
						if (empty($zoneRates)) {
							$zoneRates = ZoneRate::model()->findAll('chargecode_id = :cid AND weight_lo <=:w AND weight_hi >= :w AND zone = :z AND base+item+perkg > 0', [':cid' => $chargecodeInfo['id'], ':w' => ceil($myWeight * 10) / 10, ':z' => $zoneMap['z1']]);
						}
						if (empty($zoneRates)) {
							if (isset($this->mdata['chargecode']) && in_array($this->mdata['chargecode'], [6973])) {
								//do nothing
							} else {
								$this->tempErrors = 'Not found charge rate for ' . $this->hbn . ' at weight: ' . $myWeight . ' Kg';
							}
						}
						$tempAmount = 0;
						foreach ($zoneRates as $zoneRate) {
							$temp = $zoneRate['base'] + $zoneRate['item'] + $zoneRate['perkg'] * $myWeight;
							if ($zoneRate['minimum'] > 0) {
								$temp = max($temp, $zoneRate['minimum']);
							}
							if ($temp>$tempAmount) {
								//$tempAmount = $temp;
								$selectedRate = $zoneRate;
							}
							$tempAmount = max($tempAmount, $temp);
						}
						$amount += $tempAmount;
					} else {
						if (isset($this->mdata['chargecode']) && in_array($this->mdata['chargecode'], [6973])) {
							//do nothing
						} else {
							$this->tempErrors = 'Not found charge rate for ' . $this->hbn . ' at weight: ' . $myWeight . ' Kg';
						}
					}
				} else {
					if (empty($zoneRates)) {
						if (isset($this->mdata['chargecode']) && in_array($this->mdata['chargecode'], [6973])) {
							//do nothing
						} else {
							$this->tempErrors = 'Not found charge rate for ' . $this->hbn . ' at weight: ' . $myWeight . ' Kg';
						}
					}
					foreach ($zoneRates as $zoneRate) {
						$itemPrice = $zoneRate['item'];
						$trans = $this->trans;
						if(!empty($trans))
						{
							$trans = end($trans);
							if($trans->org_id == Org::ORGID_COURIER_AUPOST)
							{
								$itemPrice = $itemPrice*$this->pkg;
							}
						}

						if ($zoneRate['nkg'] > 0) {
							// used to break weight charge  45g==>50g; 43g=>50;   93g=>100g;
							$temp = $zoneRate['base'] + $itemPrice+ $zoneRate['perkg'] * ($zoneRate['nkg'] - fmod($myWeight, $zoneRate['nkg']) + $myWeight);
							$this->tempChargeweight = $zoneRate['nkg'] - fmod($myWeight, $zoneRate['nkg']) + $myWeight;
						} else {
							$temp = $zoneRate['base'] + $itemPrice + $zoneRate['perkg'] * $myWeight;
						}
						if ($zoneRate['minimum'] > 0) {
							$temp = max($temp, $zoneRate['minimum']);
						}
						if ($temp>$amount) {
							//$tempAmount = $temp;
							$selectedRate = $zoneRate;
						}
						$amount = max($amount, $temp);
					}
				}
			} else {
				if (isset($this->mdata['chargecode']) && in_array($this->mdata['chargecode'], [6973])) {
					//do nothing
				} else {
					$this->tempErrors = 'ChargeCode:' . @$this->mdata['chargecode'] . ' not found charge rate for ' . $this->hbn . ' at weight: ' . $myWeight . ' Kg' . ' at postcode: ' . @$this->cnee->postcode;
				}
			}

			if($amount>0)
			{
				$this->tempErrors = '';
				break;
			}
		}
		return $amount;
	}
	public function myChargeCBM()
	{
		$calculateCBM= 0;
		$myCBM = $this->getTotalCBM();
		if (isset($this->mdata['chargecode'])) {
			$chargecode = $this->mdata['chargecode'];
			$chargeCodeInfo = ImportChargeCode::model()->find('chargecode = :ccode', [':ccode' => $chargecode]);
			if (!empty($chargeCodeInfo)) {
				if (isset($chargeCodeInfo->mdata['calculate_cbm'])&&$chargeCodeInfo->mdata['calculate_cbm']==true) {
					if (empty($chargeCodeInfo->charge_wt)) {
						$ratio = 250;
						$calculateCBM = round($this->weight/$ratio,2);
					}
				}
			}
		}
		return max($calculateCBM, $myCBM);
	}

	public function calculateTruckDeliveryChargeCodeByCBM($chargecodeInfo, &$selectedRate,$myWeight = false,$isDebug = false)
	{
		$amount=0;
		$cbm = $this->myChargeCBM();
		if(!empty($myWeight)) $cbm = $myWeight;
		//for the delivery calculate by weight
		$zoneMap = ZoneMap::model()->find('chargecode_id = :cid AND pc_lo <= :pc AND pc_hi >= :pc', [':cid' => $chargecodeInfo['id'], ':pc' => $this->cnee->postcode]);
		if(empty($zoneMap))
		{
			$this->tempErrors = 'Not found zone for '.$this->hbn."; ";
			return $amount;
		}
		if($isDebug)
		{
			print_r($zoneMap);
		}
		$zoneRates = ZoneRate::model()->findAll('chargecode_id = :cid AND weight_lo <:w AND weight_hi >= :w AND zone = :z AND minimum+item+perkg > 0', [':cid' => $chargecodeInfo['id'], ':w' => ceil($cbm * 10) / 10, ':z' => $zoneMap['z1']]);
		if (empty($zoneRates)) {
			$zoneRates = ZoneRate::model()->findAll('chargecode_id = :cid AND weight_lo <=:w AND weight_hi >= :w AND zone = :z AND minimum+item+perkg > 0', [':cid' => $chargecodeInfo['id'], ':w' => ceil($cbm * 10) / 10, ':z' => $zoneMap['z1']]);
		}
		if($isDebug)
		{
			print_r($zoneRates);
			echo $cbm;
		}
		if (empty($zoneRates)) {
			if (isset($this->mdata['chargecode']) && in_array($this->mdata['chargecode'], [6973])) {
				//do nothing
			} else {
				$this->tempErrors .= 'Not found charge rate for ' . $this->hbn . ' at CBM: ' . $cbm . ' M3';
			}
		} else {
			foreach ($zoneRates as $zoneRate) {
				$result = 0;
				//if the cbm is lower than the minimum_cbm
				if (!empty($zoneRate['min_incl'])&&$zoneRate['min_incl']>0.0001) {
					if ($cbm<=$zoneRate['min_incl']) {
						$base = max($zoneRate['base'], $zoneRate['minimum']);
						$result = max($base, $cbm*$zoneRate['perkg'])+$zoneRate['item'];
					} else {
						$base = max($zoneRate['base'], $zoneRate['minimum']);
						$leaseCBM = $cbm-floatval($zoneRate['min_incl']);
						// $ncbm = $zoneRate['nkg']>0?$zoneRate['nkg']:1;
						$result = $base+($leaseCBM*$zoneRate['perkg'])+$zoneRate['item'];
					}
				} else {
					$base = max($zoneRate['base'], $zoneRate['minimum']);
					$result = max($base, $cbm*$zoneRate['perkg'])+$zoneRate['item'];
				}

				if($isDebug)
				{
					echo "result:".$result."|";
				}

				if ($result>$amount) {
					//$amount = $result;
					$selectedRate = $zoneRate;
				}
				$amount =max($amount, $result);
			}
		}
		return $amount;
	}

	public function calculateTruckDeliveryChargeCodeByPLT($chargecodeInfo, &$selectedRate,$myWeight = false,$isDebug = false)
	{
		$amount=0;
		$plt = (empty($this->mdata['amzon_pallet'])?0:$this->mdata['amzon_pallet']);
		if(!empty($myWeight)) $plt = $myWeight;
		//for the delivery calculate by weight
		$zoneMap = ZoneMap::model()->find('chargecode_id = :cid AND pc_lo <= :pc AND pc_hi >= :pc', [':cid' => $chargecodeInfo['id'], ':pc' => $this->cnee->postcode]);
		if(empty($zoneMap))
		{
			$this->tempErrors = 'Not found zone for '.$this->hbn."; ";
			return $amount;
		}
		if($isDebug)
		{
			print_r($zoneMap);
		}
		$zoneRates = ZoneRate::model()->findAll('chargecode_id = :cid AND weight_lo <:w AND weight_hi >= :w AND zone = :z AND minimum+item+perkg > 0', [':cid' => $chargecodeInfo['id'], ':w' => ceil($plt * 10) / 10, ':z' => $zoneMap['z1']]);
		if (empty($zoneRates)) {
			$zoneRates = ZoneRate::model()->findAll('chargecode_id = :cid AND weight_lo <=:w AND weight_hi >= :w AND zone = :z AND minimum+item+perkg > 0', [':cid' => $chargecodeInfo['id'], ':w' => ceil($plt * 10) / 10, ':z' => $zoneMap['z1']]);
		}
		if($isDebug)
		{
			print_r($zoneRates);
			echo $plt;
		}
		if (empty($zoneRates)) {
			if (isset($this->mdata['chargecode']) && in_array($this->mdata['chargecode'], [6973])) {
				//do nothing
			} else {
				$this->tempErrors .= 'Not found charge rate for ' . $this->hbn . ' at PLT: ' . $plt . '';
			}
		} else {
			foreach ($zoneRates as $zoneRate) {
				$result = 0;
				//if the cbm is lower than the minimum_cbm
				if (!empty($zoneRate['min_incl'])&&$zoneRate['min_incl']>0.0001) {
					if ($cbm<=$zoneRate['min_incl']) {
						$base = max($zoneRate['base'], $zoneRate['minimum']);
						$result = max($base, $plt*$zoneRate['perkg'])+$zoneRate['item'];
					} else {
						$base = max($zoneRate['base'], $zoneRate['minimum']);
						$leasePLT = $plt-floatval($zoneRate['min_incl']);
						// $ncbm = $zoneRate['nkg']>0?$zoneRate['nkg']:1;
						$result = $base+($leasePLT*$zoneRate['perkg'])+$zoneRate['item'];
					}
				} else {
					$base = max($zoneRate['base'], $zoneRate['minimum']);
					$result = max($base, $plt*$zoneRate['perkg'])+$zoneRate['item'];
				}

				if($isDebug)
				{
					echo "result:".$result."|";
				}
				$amount =max($amount, $result);
			}
		}
		return $amount;
	}

	public function isOversize($chargecodeInfo = false)
	{
		if(empty($this->mdata['chargecode']))
		{
			return 0;
		}

		if(empty($chargecodeInfo))
		{
			$chargecodeInfo = ImportChargeCode::model()->find('chargecode = :cid', [':cid' =>$this->mdata['chargecode']]);
		}
		$truckDeliveryInfo = $chargecodeInfo->mdata['truck_delivery'];
		//$chargeCodeWidth = $truckDeliveryInfo['extra_width'];
		$chargeCodeWidth=120;
		$overSizeCount = 0;
		//if the dimension is longer than limitation
		foreach ($this->packs as $key => $pack)
		{
			if(max($pack['width'], $pack['height'],$pack['length'])>$chargeCodeWidth)
			{
				$overSizeCount++;
			}
		}
		return $overSizeCount;
	}

	//nero use this for kp report if change please remind.
	public function calculateSingleOSRule($chargecodeInfo,$courierSurchargeInfo,$pattern)
	{
		//for oversize fee
		$OSArr = [];
		$OSCodeArr = [];
		$OSChargeArr = [];
		$OSKeyArr = [];
		if(!empty($courierSurchargeInfo))
		{
			if(!empty($this->packs))
			{
				foreach ($this->packs as $key2 => $pack) {
					$OS = null;
					$OSCode = '';
					$OSKey = "";
					$lastOSCost = 0;

					// handling to one pack for MH
					$thisPackDim = [$pack['length'],$pack['width'],$pack['height']];
					rsort($thisPackDim);
					$length = $thisPackDim[0]/100;
					$width = $thisPackDim[1]/100;
					$height = $thisPackDim[2]/100;
					foreach ($courierSurchargeInfo as $key => $value)
					{
						$weight = $pack['weight'];
						$cubeWeight = ($length*$width*$height)*250;

						$thisOS = null;
						$thisOSCode = "";
						$thisCharge = 0;
						$thisOSKey = "";
						if(preg_match('/'.$pattern.'/i', $key))
						{
							if($value['p_shipment']>0)
							{
								$weight = $this->weight;
								$cubeWeight = ($this->cbm*$this->pkg)*250;
								if($weight>$value['kgdwf']&&$weight<$value['kgdwt']&&!empty($value['kgdwt']))
								{
									$thisOS = $value;
									$thisOSCode =  "Weight between ".$value['kgdwf']." to ".$value['kgdwt'];
									$thisOSKey = $key;
								}
								if($cubeWeight>$value['kgcwf']&&$cubeWeight<$value['kgcwt']&&!empty($value['kgcwt']))
								{
									$thisOS = $value;
									$thisOSCode =  "cube Weight between ".$value['kgcwf']." to ".$value['kgcwt'];
									$thisOSKey = $key;
								}
								if(!empty($value['metert']))
								{
									$diagonalLength = number_format(sqrt(pow($length,2)+pow($width,2)+pow($height,2)), 2, '.', '');
									if($diagonalLength>=$value['meterf']&&$diagonalLength<=$value['metert'])
									{
										$thisOS = $value;
										$thisOSCode = "Diagonal Length between ".$value['meterf']." to ".$value['metert'];
										$thisOSKey = $key;
									}

								}

								if(!empty($value['length']))
								{
									if(in_array(@$this->mdata['chargecode'],CargoProcess::$newRuleChargecode)){
										if($length>=$value['length']&&$width>=$value['width']&&$height>=$value['height'])
										{
											$thisOS = $value;
											$thisOSCode = "Limited Length ".$value['length']." Width ".$value['width']." Height ".$value['height'];
											$thisOSKey = $key;
										}
									}else{
										if($length>=$value['length']||$width>=$value['width']||$height>=$value['height'])
										{
											$thisOS = $value;
											$thisOSCode = "Limited Length ".$value['length']." Width ".$value['width']." Height ".$value['height'];
											$thisOSKey = $key;
										}
									}
								}
								
								if(!empty($value['cbm']))
								{
									if($cbm>$value['cbm'])
									{
										$thisOS = $value;
										$thisOSCode = "Over cbm ".$value['cbm'];
										$thisOSKey = $key;
									}
								}

							}else if($value['p_piece']>0)
							{
								if($weight>$value['kgdwf']&&$weight<$value['kgdwt']&&!empty($value['kgdwt']))
								{
									$thisOS = $value;
									$thisOSCode =  "weight between ".$value['kgdwf']." to ".$value['kgdwt'];
									$thisOSKey = $key;
								}
								if($cubeWeight>$value['kgcwf']&&$cubeWeight<$value['kgcwt']&&!empty($value['kgcwt']))
								{
									$thisOS = $value;
									$thisOSCode = "cube Weight between ".$value['kgcwf']." to ".$value['kgcwt'];
									$thisOSKey = $key;
								}
								if(!empty($value['metert']))
								{
									$diagonalLength = number_format(sqrt(pow($length,2)+pow($width,2)+pow($height,2)), 2, '.', '');
									if($diagonalLength>=$value['meterf']&&$diagonalLength<=$value['metert'])
									{
										$thisOS = $value;
										$thisOSCode = "Diagonal Length between ".$value['meterf']." to ".$value['metert'];
										$thisOSKey = $key;
									}

								}

								if(in_array(@$this->mdata['chargecode'],CargoProcess::$newRuleChargecode)){
									if(!empty($value['length']))
									{
										if($length>=$value['length']&&$width>=$value['width']&&$height>=$value['height'])
										{
											$thisOS = $value;
											$thisOSCode = "Limited Length ".$value['length']." Width ".$value['width']." Height ".$value['height'];
											$thisOSKey = $key;
										}
									}
								}else{
									if(!empty($value['length']))
									{
										if($length>=$value['length']||$width>=$value['width']||$height>=$value['height'])
										{
											$thisOS = $value;
											$thisOSCode = "Limited Length ".$value['length']." Width ".$value['width']." Height ".$value['height'];
											$thisOSKey = $key;
										}
									}
								}
								
								
								if(!empty($value['cbm']))
								{
									if($cbm>$value['cbm'])
									{
										$thisOS = $value;
										$thisOSCode = "Over cbm ".$value['cbm'];
										$thisOSKey = $key;
									}
								}

							}
						}
						if(!empty($thisOS))
						{
							$thisCharge = $thisOS['p_piece']+$thisOS['p_shipment'];
							if($thisCharge>$lastOSCost)
							{
								$OS = $thisOS;
								$OSCode = $thisOSCode;
								$lastOSCost = $thisCharge;
								$OSKey = $thisOSKey;
							}
						}
					}
					if(!empty($OS))
					{
						if($OS['p_piece']>0)
						{
							$OSArr[] = $OS;
							$OSCodeArr[] = $OSCode;
							$OSChargeArr[] = $lastOSCost;
							$OSKeyArr[] = $OSKey;
						}else if($OS['p_shipment']>0)
						{
							if(empty($OSArr)||(!empty($OSArr)&&$OS['p_shipment']>$OS['p_shipment']))
							{
								$OSArr = [$OS];
								$OSCodeArr = [$OSCode];
								$OSChargeArr = [$lastOSCost];
								$OSKeyArr = [$OSKey];
							}
						}
					}

				}
			}
		}

		return [$OSArr,$OSCodeArr,$OSChargeArr,$OSKeyArr];
	}

	public function calculateSingleOSCRule($chargecodeInfo,$courierSurchargeInfo,$pattern)
	{
		//for oversize fee
		$OSArr = [];
		$OSCodeArr = [];
		$OSChargeArr = [];
		$OSKeyArr = [];
		if(!empty($courierSurchargeInfo))
		{
			if(!empty($this->packs))
			{
				foreach ($this->packs as $key2 => $pack) {
					$OS = null;
					$OSCode = '';
					$OSKey = "";
					$lastOSCost = 0;

					// handling to one pack for MH
					$thisPackDim = [$pack['length'],$pack['width'],$pack['height']];
					rsort($thisPackDim);
					$length = $thisPackDim[0]/100;
					$width = $thisPackDim[1]/100;
					$height = $thisPackDim[2]/100;
					foreach ($courierSurchargeInfo as $key => $value)
					{
						$weight = $pack['weight'];
						$cubeWeight = ($length*$width*$height)*250;

						$thisOS = null;
						$thisOSCode = "";
						$thisCharge = 0;
						$thisOSKey = "";
						if(preg_match('/'.$pattern.'/i', $key))
						{
							if($value['p_shipment']>0)
							{
								//$weight = $this->weight;
								$weight = $pack['weight'];
								//$cubeWeight = ($this->cbm*$this->pkg)*250;
								if($weight>$value['kgdwf']&&$weight<$value['kgdwt']&&!empty($value['kgdwt']))
								{
									if(!empty($value['length']))
									{
										if($length>=$value['length']&&$width>=$value['width']&&$height>=$value['height'])
										{
											$thisOS = $value;
											$thisOSCode = "Limited Length ".$value['length']." Width ".$value['width']." Height ".$value['height'];
											$thisOSKey = $key;
										}
									}
								}
							}else if($value['p_piece']>0)
							{
								if($weight>$value['kgdwf']&&$weight<$value['kgdwt']&&!empty($value['kgdwt']))
								{
									if(!empty($value['length']))
									{
										if($length>=$value['length']&&$width>=$value['width']&&$height>=$value['height'])
										{
											$thisOS = $value;
											$thisOSCode = "Limited Length ".$value['length']." Width ".$value['width']." Height ".$value['height'];
											$thisOSKey = $key;
										}
									}
								}
							}
						}
						if(!empty($thisOS))
						{
							$thisCharge = $thisOS['p_piece']+$thisOS['p_shipment'];
							if($thisCharge>$lastOSCost)
							{
								$OS = $thisOS;
								$OSCode = $thisOSCode;
								$lastOSCost = $thisCharge;
								$OSKey = $thisOSKey;
							}
						}
					}
					if(!empty($OS))
					{
						if($OS['p_piece']>0)
						{
							$OSArr[] = $OS;
							$OSCodeArr[] = $OSCode;
							$OSChargeArr[] = $lastOSCost;
							$OSKeyArr[] = $OSKey;
						}else if($OS['p_shipment']>0)
						{
							if(empty($OSArr)||(!empty($OSArr)&&$OS['p_shipment']>$OS['p_shipment']))
							{
								$OSArr = [$OS];
								$OSCodeArr = [$OSCode];
								$OSChargeArr = [$lastOSCost];
								$OSKeyArr = [$OSKey];
							}
						}
					}

				}
			}
		}

		return [$OSArr,$OSCodeArr,$OSChargeArr,$OSKeyArr];
	}

	public function calculateMHAndOSSurcharge($chargecodeInfo,$forcesCargoProcess = false)
	{
		$result = [];
		$cbm = $this->myChargeCBM();
		$courierSurchargeInfo = @$chargecodeInfo->mdata['courier_surcharge'];
		//for manual handling fee
		$MHArr = [];
		$MHCodeArr = [];
		$MHChargeArr = [];
		$MHWeightArr = [];
		$MHDescription = "";
		$OSDescription = "";
		if(!empty($courierSurchargeInfo))
		{
			if(!$this->checkIsCargoProcessWithRef()&&!empty($this->packs)&&!$forcesCargoProcess)
			{
				foreach ($this->packs as $key => $pack) {
					$MH = null;
					$MHCode = '';
					$lastMHCost = 0;

					// handling to one pack for MH
					$thisPackDim = [$pack['length'],$pack['width']];
					rsort($thisPackDim);
					$length = $thisPackDim[0]/100;
					$width = $thisPackDim[1]/100;
					$height = $pack['height']/100;
					foreach ($courierSurchargeInfo as $key => $value)
					{
						$thisMH = null;
						$thisMHCode = "";
						$thisCharge = 0;
						$weight = $pack['weight'];
						$cubeWeight = ($length*$width*$height)*250;
						if(preg_match('/MH/i', $key))
						{
							if($value['p_shipment']>0)
							{
								$weight = $this->weight;
								$cubeWeight = ($this->cbm*$this->pkg)*250;
							
								if($weight>$value['kgdwf']&&$weight<$value['kgdwt']&&!empty($value['kgdwt']))
								{
									$thisMH = $value;
									$thisMHCode = "weight between ".$value['kgdwf']." to ".$value['kgdwt'];
								}
								if($cubeWeight>$value['kgcwf']&&$cubeWeight<$value['kgcwt']&&!empty($value['kgcwt']))
								{
									$thisMH = $value;
									$thisMHCode = "cube Weight between ".$value['kgcwf']." to ".$value['kgcwt'];
								}
								if(!empty($value['metert']))
								{
									$diagonalLength = number_format(sqrt(pow($length,2)+pow($width,2)+pow($height,2)), 2, '.', '');
									if($diagonalLength>=$value['meterf']&&$diagonalLength<=$value['metert'])
									{
										$thisMH = $value;
										$thisMHCode = "Diagonal Length ".$value['meterf']." to ".$value['metert'];
									}

								}

								if(!empty($value['length']))
								{
									if($length>=$value['length']||$width>=$value['width']||$height>=$value['height'])
									{
										$thisMH = $value;
										$thisMHCode = "Limited Length ".$value['length']." Width ".$value['width']." Height ".$value['height'];
									}
								}

								if(!empty($value['cbm']))
								{
									if($cbm>$value['cbm'])
									{
										$thisMH = $value;
										$thisMHCode = "Over cbm ".$value['cbm'];
									}
								}
							}else if($value['p_piece']>0)
							{
								if($weight>$value['kgdwf']&&$weight<$value['kgdwt']&&!empty($value['kgdwt']))
								{
									$thisMH = $value;
									$thisMHCode = "weight between ".$value['kgdwf']." to ".$value['kgdwt'];
								}
								if($cubeWeight>$value['kgcwf']&&$cubeWeight<$value['kgcwt']&&!empty($value['kgcwt']))
								{
									$thisMH = $value;
									$thisMHCode = "cube Weight between ".$value['kgcwf']." to ".$value['kgcwt'];
								}
								if(!empty($value['metert']))
								{
									$diagonalLength = number_format(sqrt(pow($length,2)+pow($width,2)+pow($height,2)), 2, '.', '');
									if($diagonalLength>=$value['meterf']&&$diagonalLength<=$value['metert'])
									{
										$thisMH = $value;
										$thisMHCode = "Diagonal Length between ".$value['meterf']." to ".$value['metert'];
									}

								}

								if(!empty($value['length']))
								{
									if($length>=$value['length']||$width>=$value['width']||$height>=$value['height'])
									{
										$thisMH = $value;
										$thisMHCode = "Limited Length ".$value['length']." Width ".$value['width']." Height ".$value['height'];
									}
								}

								if(!empty($value['cbm']))
								{
									if($cbm>$value['cbm'])
									{
										$thisMH = $value;
										$thisMHCode = "Over cbm ".$value['cbm'];
									}
								}
							}
						}
						if(!empty($thisMH))
						{
							$thisCharge = $thisMH['p_piece']+$thisMH['p_shipment'];
							if($thisCharge>$lastMHCost)
							{
								$MH = $thisMH;
								$MHCode = $thisMHCode;
								$lastMHCost = $thisCharge;
							}
						}
					}
					if(!empty($MH))
					{
						if($MH['p_piece']>0)
						{
							$MHArr[] = $MH;
							$MHCodeArr[] = $MHCode;
							$MHChargeArr[] = $lastMHCost;
						}else if($MH['p_shipment']>0)
						{
							if(empty($MHArr)||(!empty($MHArr)&&$MH['p_shipment']>$MH['p_shipment']))
							{

								$MHArr = [$MH];
								$MHCodeArr = [$MHCode];
								$MHChargeArr = [$lastMHCost];
							}
						}
					}

				}
			}
		}


		//for oversize fee
		if($this->checkIsCargoProcessWithRef()||$forcesCargoProcess)
		{
			$courierSurchargeInfo = @$chargecodeInfo->mdata['truck_delivery'];
		}

		[$OSArr,$OSCodeArr,$OSChargeArr,$OSKeyArr] = $this->calculateSingleOSRule($chargecodeInfo,$courierSurchargeInfo,'OS\d{1,2}');

		[$OSCArr,$OSCCodeArr,$OSCChargeArr,$OSCKeyArr] = $this->calculateSingleOSCRule($chargecodeInfo,$courierSurchargeInfo,'OSC');


		$MHCode = "";
		$MHDescription="";
		$lastMHCost = array_sum($MHChargeArr);
		$countMHCode = [];
		foreach ($MHCodeArr as $key => $value)
		{
			if(!empty($countMHCode[$value]))
			{
				$countMHCode[$value] += 1;
			}else
			{
				$countMHCode[$value] = 1;
			}
		}

		foreach ($countMHCode as $key => $value) {
			$MHDescription.="</br>".$key." X ".$value.'pcs ';
		}

		$OSCode = "";
		$OSDescription="";
		$lastOSCost = array_sum($OSChargeArr);
		$numOneOSCCost = array_sum($OSCChargeArr);
		$countOSCode = [];
		foreach ($OSCodeArr as $key => $value)
		{
			if(!empty($countOSCode[$value]))
			{
				$countOSCode[$value] += 1;
			}else
			{
				$countOSCode[$value] = 1;
			}
		}

		foreach ($countOSCode as $key => $value) {
			$OSDescription.="</br>".$key." X ".$value.'pcs ';
		}

		foreach ($OSCChargeArr as $key => $value) {
			if($value>0)
			{
				$OSDescription.="</br>+ ".$OSCKeyArr[$key]." ".$OSCCodeArr[$key]." $".$value;
			}
		}


		$result = ['amount'=>$lastMHCost+$lastOSCost+$numOneOSCCost,'rate'=>'','MHCharge'=>$lastMHCost,'OSCharge'=>$lastOSCost+$numOneOSCCost,'MHCode'=>$MHCode,'MHDescription'=>" Manual handling fee for ".$MHDescription,'OSCode'=>$OSCode,"OSDescription"=>"oversize fee for ".$OSDescription];

		$result['RECharge'] = 0;
		$result['REDescription'] = '';

		//now calculate for remote area surcharge
		if(!empty($this->mdata['org_rate_id']))
		{
			$remoteChargeRate = RemoteChargeRate::model()->find('chargecode_rate_id = :rateId and chargecode_id = :chargecodeId and (postcode=:postcode or CONCAT("0",postcode)=:postcode) and UPPER(suburb) = :suburb and (perkg+base)>0',[":rateId"=>$this->mdata['org_rate_id'],":chargecodeId"=>$chargecodeInfo->id,':postcode'=>$this->cnee->postcode,':suburb'=>strtoupper($this->cnee->suburb)]);
			if(!empty($remoteChargeRate))
			{
				$finalRemoteCharge = 0;
				$thisRemoteChargeRate = 0;
				$wl = 0;
				if($remoteChargeRate->nkg>0)
				{
					$wl = ceil($this->chargeWeight()/ $remoteChargeRate->nkg);
					$thisRemoteChargeRate = $wl*$remoteChargeRate->perkg+$remoteChargeRate->base;
				}else
				{
					$wl = $this->chargeWeight();
					$thisRemoteChargeRate = $wl*$remoteChargeRate->perkg+$remoteChargeRate->base;
				}
				
				$finalRemoteCharge += $thisRemoteChargeRate;

				if($finalRemoteCharge)
				$result['amount']+=$finalRemoteCharge;
				$result['RECharge'] = $finalRemoteCharge;
				$result['REDescription'] = 'Remote Area Charge';
				if($remoteChargeRate->perkg>0)
				{
					$result['REDescription'].='</br>'.$wl.'kg * '.$remoteChargeRate->perkg."/kg";
				}

				if($remoteChargeRate->base>0)
				{
					$result['REDescription'] .='</br>'.$remoteChargeRate->base."/shipment";
				}
			}
		}

		$result['FuelCharge'] = 0;
		$result['FuelDescription'] = '';
		$result['LevyCharge'] = 0;
		$result['LevyDescription'] = '';
		$result['KpDiscountCharge'] = 0;
		$result['KpDiscountDescription'] = '';

		$amount = $this->getChargeByChargecode('',false,null,false,false,false);


		// for percentage Levy




		$eta = "";
		if(!empty($this->consol)){
			if($this->consol->isWDT())
			{
				$parentShipment = $this->getParentShipment();
				if(!empty($parentShipment))
				{
					$eta = $parentShipment->consol->eta;
				}
			}else
			{
				$eta = $this->consol->eta;
			}
		}else{
			$eta = date("Y-m-d");
		}
			

		if(!empty($eta)&&strtotime($eta)>strtotime("2022-08-01"))
		{
			$levy = OrgRateService::shipmentRemotePercentageRate($this);
			if($levy>0)
			{
				$levySurcharge=number_format($levy*$amount, 2, '.', '');	
				$result['amount']+=$levySurcharge;
				$result['LevyCharge'] = $levySurcharge;
				$result['LevyDescription'] = 'Levy Charge('.$amount."*".$levy.')';
			}
		}



		if($this->checkIsCargoProcessWithRef()&&!empty($chargecodeInfo->mdata['truck_delivery']))
		{
			$fuel = 0;
			if(!empty($chargecodeInfo->mdata['truck_delivery']))
			{
				$truckDeliveryInfo = $chargecodeInfo->mdata['truck_delivery'];
				if(!empty($truckDeliveryInfo['fuel_surcharge'])&&$truckDeliveryInfo['fuel_surcharge']>0)
				{
						$fuel = $truckDeliveryInfo['fuel_surcharge'];
				}else
				{
					if(empty($truckDeliveryInfo['fuel_surcharge']))
					{
						if(!empty($eta))
						{
							$fuel = ImportsSystemFuel::getThisMonthFuel($eta,ImportsSystemFuel::KP_TYPE);
						}
					}
				}
			}else
			{
				if(!empty($eta))
				{
					$fuel = ImportsSystemFuel::getThisMonthFuel($eta,ImportsSystemFuel::KP_TYPE);
				}
			}

			if(!empty($fuel))
			{
				$fuelSurcharge=number_format($amount*$fuel, 2, '.', '');		
				$result['amount']+=$fuelSurcharge;
				$result['FuelCharge'] = $fuelSurcharge;
				$result['FuelDescription'] = 'Fuel Charge('.$amount."*".$fuel.')';
			}
		}

		if(!$this->checkIsCargoProcessWithRef())
		{
			$fuel = 0;
			if(!empty($chargecodeInfo->mdata['courier_surcharge']))
			{
				$truckDeliveryInfo = $chargecodeInfo->mdata['courier_surcharge'];
				if(!empty($truckDeliveryInfo['fuel_surcharge'])&&$truckDeliveryInfo['fuel_surcharge']>0)
				{
						$fuel = $truckDeliveryInfo['fuel_surcharge'];
				}else
				{
					if(empty($truckDeliveryInfo['fuel_surcharge']))//only the fuel_surcharge=0
					{
						if(!empty($eta))
						{
							$fuel = ImportsSystemFuel::getThisMonthFuel($eta,ImportsSystemFuel::COURIER_TYPE);
						}
					}
				}
			}else
			{
				if(!empty($eta))
				{
					$fuel = ImportsSystemFuel::getThisMonthFuel($eta,ImportsSystemFuel::COURIER_TYPE);
				}
			}

			if(!empty($fuel))
			{
				$fuelSurcharge=number_format($amount*$fuel, 2, '.', '');		
				$result['amount']+=$fuelSurcharge;
				$result['FuelCharge'] = $fuelSurcharge;
				$result['FuelDescription'] = 'Fuel Charge('.$amount."*".$fuel.')';
			}
		}

		if($this->checkIsCargoProcessWithRef()&&$this->getCargoProcessType()==CargoProcess::NORMAL_CARGO)
		{
			$kpDiscount = 0;
			if(!empty($eta))
			{
				$kpDiscount = ImportsSystemFuel::getThisMonthFuel($eta,ImportsSystemFuel::KP_DISCOUNT_TYPE);
			}

			if(!empty($kpDiscount))
			{
				$discountSurcharge=number_format($amount*$kpDiscount, 2, '.', '');		
				$result['amount']+=$discountSurcharge;
				$result['KpDiscountCharge'] = $discountSurcharge;
				$result['KpDiscountDescription'] = 'Discount('.$amount."*".$kpDiscount.')';
			}
		}
		return $result;
	}




	public function calculateSurcharge($chargecodeInfo, &$selectedRate,$isDebug = false,$amount)
	{
		$result = 0;
		$cbm = $this->myChargeCBM();
		$truckDeliveryInfo = $chargecodeInfo->mdata['truck_delivery'];
		$chargeCodeWidth = $truckDeliveryInfo['extra_width'];
		//if the dimension is longer than limitation
		if(!empty($truckDeliveryInfo['extra_width_fee']))
		{
			if($this->isOversize()>0)
			{
				$result+=$cbm* $truckDeliveryInfo['extra_width_fee'];
			}
		}

		// if the distance is longer than limitation
		if ($truckDeliveryInfo['extra_distance']>0) {
			$distance = GoogleMapAPI::getDistance($this);
			if ($distance>$truckDeliveryInfo['extra_distance']) {
				$countDistance = $distance - $truckDeliveryInfo['extra_distance'];
				$result+=ceil($countDistance / $truckDeliveryInfo['extra_distance_limit'])*$truckDeliveryInfo['extra_distance_fee'];
				if($isDebug)
				{
					echo "distance:".$distance."|distance fee:".(ceil($countDistance / $truckDeliveryInfo['extra_distance_limit'])*$truckDeliveryInfo['extra_distance_fee'])."|PerCBM:".$truckDeliveryInfo['extra_distance_fee']."|";
				}
			}
		}

		if ($this->styp==self::EXPRESS_STYP) {
			if (@$truckDeliveryInfo['express']>1) {
				$result =$result*$truckDeliveryInfo['express'];
			}
		} elseif ($this->styp==self::EXTRA_EXPRESS_STYP) {
			if (@$truckDeliveryInfo['extra_express']>1) {
				$result =$result*$truckDeliveryInfo['extra_express'];
			}
		}

		return $result;
	}


	public function getDiffChargeByChargecode($realWeight = 0, $myWeight = 0, $code = '')
	{
		$amount = 0;
		if (!empty($code)) {
			$chargecode = $code;
		} else {
			if (!isset($this->mdata['chargecode'])) {
				$amount = 0;
				$chargecode = '';
			} else {
				$chargecode = $this->mdata['chargecode'];
			}
		}
		if (!empty($chargecode)) {
			// based on chargecode to get chargecode ID
			$chargecodeInfo = ImportChargeCode::model()->find('chargecode = :cid', [':cid' => $chargecode]);
			// based on chargecode and postcode
			// get zone code
			$zoneMap = ZoneMap::model()->find('chargecode_id = :cid AND pc_lo <= :pc AND pc_hi >= :pc', [':cid' => $chargecodeInfo['id'], ':pc' => $this->cnee->postcode]);
			if (!empty($zoneMap)) {
				$zoneRates = ZoneRate::model()->findAll('chargecode_id = :cid AND weight_lo <:w AND weight_hi >= :w AND zone = :z AND base+item+perkg > 0', [':cid' => $chargecodeInfo['id'], ':w' => ceil($realWeight * 10) / 10, ':z' => $zoneMap['z1']]);
				if (empty($zoneRates)) {
					$zoneRates = ZoneRate::model()->findAll('chargecode_id = :cid AND weight_lo <=:w AND weight_hi >= :w AND zone = :z AND base+item+perkg > 0', [':cid' => $chargecodeInfo['id'], ':w' => ceil($realWeight * 10) / 10, ':z' => $zoneMap['z1']]);
				}
				// get maximum one
				foreach ($zoneRates as $zoneRate) {
					$temp = $zoneRate['perkg'] * ($realWeight - $myWeight);
					$amount = max($amount, $temp);
				}
			}
		}

		return $amount;
	}

	public function genCasualInvoice()
	{
		$reply = ['status' => 1, 'msg' => ''];
		if (!isset($this->mdata['custom_inv'])) {
			$reply['status'] = 0;
			$reply['msg'] = "Please Input the custom inv ammount";
			return $reply;
		}

		/*if(!empty($this->mdata['custom_inv'])){
		foreach($this->mdata['custom_inv']['ccode'] as $i => $c){
		if($c == 'PROCESSING FEE'){
		$this->mdata['cust_duty_lines'] = $this->mdata['custom_inv']['qty'][$i];
		}
		}
		}*/

		$includeGst = false;
		if (($this->bwf & 64) > 0) {
			//DDP
			$to_org = $this->agent_id;
			$orgRate = OrgRate::model()->find('type=40 and org_id=:oid', [':oid' => $to_org]);
			$rateInfo = json_decode($orgRate['meta']);
			if (!empty($this->agent->extra['incl_gst'])) {
				$includeGst = true;
			}

			if (!empty($this->mdata['cust_duty_lines'])) {
				$lineNumber = intval($this->mdata['cust_duty_lines']);
				if (empty($rateInfo->AU->csdcRate) || empty($rateInfo->AU->csdclRate) || empty($rateInfo->AU->csdcapRate)) {
					$errors[] = 'Custom declaration line rate is not set in the org rate for ' . $to_org . '!';
				} else {
					if ($lineNumber <= 10) {
						$amount = floatval($rateInfo->AU->csdcRate);
						$tot += $amount;
						$items[] = [$this->awb, 'Customs Declaration', 1, 0, $rateInfo->AU->csdcRate, $amount];
					} else {
						$amount = number_format(($lineNumber - 10) * floatval($rateInfo->AU->csdclRate), 2, '.', '') + floatval($rateInfo->AU->csdcRate);
						if ($amount > $rateInfo->AU->csdcapRate) {
							$amount = floatval($rateInfo->AU->csdcapRate);
						}
						$process_fee = $amount;
					}
				}
			} else {
				if (!empty($rateInfo->AU->caInvoiceServiceFee)) {
					//if set the service fee at the org rate
					$process_fee = $rateInfo->AU->caInvoiceServiceFee;
				} else {
					//if not set the rate at the org rate
					$process_fee = 100;
				}
			}
		} elseif (($this->bwf & 128) > 0) {
			//DDU  //ddu rate is on the casual customer org
			$to_org = empty($this->owner_id) ? Org::ORGID_IMPORT_CASUAL_CUSTOMER : $this->owner_id;
			$includeGst = true;

			$orgRate = OrgRate::model()->find('type=40 and org_id=:oid', [':oid' => Org::ORGID_IMPORT_CASUAL_CUSTOMER]);
			$rateInfo = json_decode($orgRate['meta']);
			/*
			if (!empty($this->mdata['cust_duty_lines'])) {
			$lineNumber=intval($this->mdata['cust_duty_lines']);
			if (empty($rateInfo->AU->csdcRate)||empty($rateInfo->AU->csdclRate)||empty($rateInfo->AU->csdcapRate)) {
			$errors[]='Custom declaration line rate is not set in the org rate for '.$to_org.'!';
			} else {
			if ($lineNumber<=10) {
			$amount=floatval($rateInfo->AU->csdcRate);
			$tot += $amount;
			$items[] = [$this->awb, 'Customs Declaration', 1, 0, $rateInfo->AU->csdcRate, $amount];
			} else {
			$amount= number_format(($lineNumber-10)*floatval($rateInfo->AU->csdclRate), 2, '.', '')+floatval($rateInfo->AU->csdcRate);
			if ($amount>$rateInfo->AU->csdcapRate) {
			$amount= floatval($rateInfo->AU->csdcapRate);
			}
			$process_fee=$amount;
			}
			}
			} else {*/
			if (!empty($rateInfo->AU->caInvoiceServiceFee) && $rateInfo->AU->caInvoiceServiceFee > 0) {
				//if set the service fee at the org rate
				$process_fee = $rateInfo->AU->caInvoiceServiceFee;
			} else {
				$process_fee = 100;
			}
			//}
		}
		if (!empty($errors)) {
			$reply['status'] = 0;
			$reply['msg'] = implode(";", $errors);
			return $reply;
		}

		// if the agent is 4PX, we need to allocate the invoice to 4PX no matter DDU or DDP
		$invoiceShows  = false;

		if($this->agent_id==Org::ORGID_COURIER_4PX)
		{
			$to_org = Org::ORGID_COURIER_4PX;
			$invoiceShows = true;// show the consignee name
		}

		//$entryfee= floatval($this->mdata['custom_inv_amount']);
		$inv = Invoice::model()->find(['condition' => 'type = 41 AND pid = :pid AND status != 10', 'params' => [':pid' => $this->id], 'order' => 'id DESC']);
		$emptyTheInvLine = false;
		if (empty($inv)) {
			$inv = new Invoice;
		} else {
			// foreach ($inv->lines as $line) {
			// 	$line->inv_id = 0;
			// 	$line->save();
			// }
			if ($inv->status >= 2) {
				$old_inv = $inv;
				$old_inv->createCreditForMe();
				$inv = new Invoice;
				$inv->no = Invoice::genNewInvoiceNo($old_inv->no);
			}
		}
		if(!empty($inv->status)&&$inv->status==Invoice::INVOICE_STATUS_PENDING)
		{
			$emptyTheInvLine = true;
		}
		$inv->date = date('Y-m-d'); // for update we shouldn't change invoice data
		$inv->status = Invoice::INVOICE_STATUS_PENDING; // set as pending which means will send to client for paying via email at night
		$inv->type = Invoice::INVOICE_TYPE_CASUAL; // for custom casual client /DDU
		$inv->dpmt = Invoice::DPMT_IMPORT;
		$inv->currency = 1;
		$inv->to_id = $to_org; //casual client org
		$inv->consol_id = $this->consol_id;
		$inv->pid = $this->id; // in case there is no manifest now
		$inv->dpt_id = 106;
		$inv->status = Invoice::INVOICE_STATUS_PENDING; // set as posted which means will send to client for paying

		if (empty($this->owner_id) && ($this->bwf & 128) > 0) {
			if (!empty($this->process) && !empty($this->process->mdata['cabill_name'])) {
				$inv->mdata['name'] = $this->process->mdata['cabill_name'];
				$inv->mdata['address'] = $this->process->mdata['cabill_addr'];
			} else {
				$cnee = empty($this->receiver->name) ? $this->cnee : $this->receiver;
				$inv->mdata['name'] = !empty($cnee->company) ? $cnee->company : $cnee->name;
				$inv->mdata['address'] = $cnee->fullAddress();
			}
			$inv->mdata['payterm'] = 'COD';
		} else {
			$owner = ($this->bwf & 128) > 0 ? $this->owner : $this->agent;
			$inv->mdata['name'] = $owner->name;
			$inv->mdata['address'] = $owner->getAddress();
			$inv->mdata['payterm'] = empty($owner->extra['payterm']) ? '2 days' : $owner->extra['payterm'] . ' days';
			if($this->owner_id==Org::ORGID_CLIENT_PCAE)
			{
				$inv->mdata['payterm'] = 'COD';
			}
		}

		if($invoiceShows)
		{
			$inv->mdata['name'] = !empty($this->cnee->company) ? $this->cnee->company : $this->cnee->name;
		}

		$inv->mdata['awb'] = isset($this->consol->awb) ? $this->consol->awb : '';
		$inv->due = Invoice::calcDue($inv->date, $inv->mdata['payterm']);
		$total = 0;
		$total_gst = 0;
		$inv->gst = 0;
		$inv->save();
		$inv->refresh();

		if (!empty($old_inv)) {
			$inv->applyPayments($old_inv->payments);
		}

		if (!empty($this->mdata['custom_inv'])) {
			if($emptyTheInvLine)
			{
				$transaction=Yii::app()->db->beginTransaction();
				try {
					$lines = InvLine::model()->findAll("inv_id= :inv_id",[":inv_id"=>$inv->id]);
					foreach ($lines as $key => $line) {
						InvLine::model()->deleteByPk($line->id);
					}
					$transaction->commit();
				} catch (Exception $ex) {
					$transaction->rollback();
					throw $ex;
				}
			}

			foreach ($this->mdata['custom_inv']['qty'] as $i => $q) {
				if (empty($q)) {
					continue;
				}
				$il = new InvLine;
				$il->inv_id = $inv->id;
				$il->ccode = $this->mdata['custom_inv']['ccode'][$i];
				$il->qty = $q;
				$amt = $this->mdata['custom_inv']['amount'][$i];
				switch ($this->mdata['custom_inv']['ccode'][$i]) {
					case 'CUSTOMS DUTY/GST':
						$il->tax = $this->mdata['custom_inv']['tax'][$i];
						$il->det = 'CUSTOMS ENTRY ATTACHED ' . $this->ref;
						$il->gst = $il->tax == 'OUTPUT' ? $amt * 0.1 : 0;
						$il->amount = round($amt + $il->gst, 3);
						$il->model = 'CUSTOMS ENTRY ATTACHED';
						break;
					case 'PROCESSING FEE':
						$amt = empty($amt)?$process_fee:$amt;
						$il->tax = $this->mdata['custom_inv']['tax'][$i];
						$il->det = $this->mdata['custom_inv']['det'][$i];
						$il->gst = round($il->tax == 'OUTPUT' ? $amt * 0.1 : 0);
						$il->amount = round($amt + $il->gst, 3);
						$il->model = 'CUSTOMS ENTRY ATTACHED';
						break;
					default:
						$il->tax = $this->mdata['custom_inv']['tax'][$i];
						$il->det = $this->mdata['custom_inv']['det'][$i];
						$il->gst = $il->tax == 'OUTPUT' ? $amt * 0.1 : 0;
						$il->amount = round($amt + $il->gst, 3);
						$il->model = 'CUSTOMS ENTRY ATTACHED';
						break;
				}

				$old = InvLine::model()->find("inv_id= :inv_id and ccode = :ccode and qty = :qty and amount = :amount and model= :model and gst=:gst and tax = :tax and det=:det", ["inv_id"=>$il->inv_id,"ccode"=>$il->ccode,"qty"=>$il->qty,"amount"=>$il->amount,"model"=>$il->model,"gst"=>$il->gst,"tax"=>$il->tax,"det"=>$il->det]);
				if (empty($old)) {
					$il->save();
				}
				$total += $il->qty * $il->amount;
				$total_gst += $il->gst * $il->qty;
			}
		}

		$inv->total = $total;
		$inv->gst = $total_gst;
		if ($inv->save()) {
			return $reply;
		}
	}

	/*determine the size of letter to choose
	 * just small or large
	 */
	private function determineSize()
	{
		$type = '';
		$dim = [];
		$dim[] = floatval($this->mdata['dim']['h']);
		$dim[] = floatval($this->mdata['dim']['w']);
		$dim[] = floatval($this->mdata['dim']['d']);
		asort($dim);
		$tmp = [];
		foreach ($dim as $value) {
			$tmp[] = $value;
		}
		$weight = $this->weight;
		// later we may need to consider more on the width, length, as h<=0.5 don't mean it's a small letter.
		if ($tmp[0] <= 0.5 && $tmp[1] <= 13 && $tmp[2] <= 24) {
			if ($weight <= 0.250) {
				$type = 'smal';
			} else {
				$type = 'large';
			}
		} else {
			$type = 'large';
		}
		return $type;
	}

	/**
	 * get shipment local delivery price based on Charge code
	 * @param $chargecodeId
	 */
	private function getDeliveryCRateByChargecode($chargecodeId)
	{
		// base on postcode to get charge code
		// currently zone_id = 0 for zone setting price for client
		// for zone_id = 1 or 2 is used  for courier cost using
		$zoneMap = ZoneMap::model()->find('chargecode_id = :cid AND pc_lo <= :code AND pc_hi >= :code', [':cid' => $chargecodeId, ':code' => $this->cnee->postcode]);

		// if not found we set as NSW country
		$zoneCode = 'N1';
		if (!empty($zoneMap) && !empty($zoneMap['z1'])) {
			$zoneCode = $zoneMap['z1'];
		}

		$myWeight = $this->chargeWeight();

		// base charge code to get zone rate
		$zr = ZoneRate::model()->find(" chargecode_id = :cid AND zone = :s AND (weight_lo < :w AND weight_hi >= :w) AND base+item+perkg > 0", [':s' => $zoneCode, ':w' => $myWeight, ':cid' => $chargecodeId]);

		if (empty($zr)) {
			// with a default charge rate
			// normally we shouldn't use default charge
			$r = 0.0;
			if ($myWeight >= 5) {
				$r = 8.0 + ($myWeight - 5) * 0.36; // default only
			} else {
				$r = 8.0;
			}
		} else {
			// amount = price / piece * quantity + price/pkg * weight
			// quantity is one
			$r = $zr['item'] + ($myWeight) * $zr['perkg'];
		}

		return $r;
	}

	/**
	 * get delivery rate based on schedule C default for Australia post office ( id = 101 )
	 * @param int $courierId
	 * @return float
	 */
	private function getDeliveryCRate($courierId = 101)
	{
		// base on postcode to get charge code
		// currently zone_id = 0 for zone setting price for client
		// for zone_id = 1 or 2 is used  for courier cost using
		$zoneMap = ZoneMap::model()->find('org_id = :oid AND zone_id = 0 AND pc_lo <= :code AND pc_hi >= :code', [':oid' => $courierId, ':code' => $this->postcode]);

		// if not found we set as NSW country
		$chargeCode = 'N1';
		if (!empty($zoneMap) && !empty($zoneMap['z1'])) {
			$chargeCode = $zoneMap['z1'];
		}

		// base charge code to get zone rate
		$zr = ZoneRate::model()->with('orgrate')->find("orgrate.type = 80 AND zone = :s AND (weight_lo < :w AND weight_hi >= :w) AND base+item+perkg > 0 AND orgrate.org_id = :oid ", [':s' => $chargeCode, ':w' => $this->weight, ':oid' => $this->agent_id]);

		$myWeight = $this->chargeWeight();
		if (empty($zr)) {
			// with a default charge rate
			// normally we shouldn't use default charge
			$r = 0.0;
			if ($myWeight >= 5) {
				$r = 8.0 + ($myWeight - 5) * 0.36; // default only
			} else {
				$r = 8.0;
			}
		} else {
			// amount = price / piece * quantity + price/pkg * weight
			// quantity is one
			$r = $zr['item'] + ($myWeight) * $zr['perkg'];
		}

		return $r;
	}

	/**
	 * get tranship cost which from third party delivery company API service
	 * @return int
	 */
	public function getTranshipCost()
	{
		$cost = 0;
		$ts = Tranship::model()->find('pid = :pid AND type = 80', [':pid' => $this->id]);
		if (!empty($ts)) {
			$cost = $ts['cost'];
		}
		return round($cost, 2);
	}

	/**
	 * get the invoice related to this shipment
	 * @return float|int
	 */
	public function getShipmentInvoice()
	{
		$total = 0;
		$owner = $this->agent;

		// for sum it is special
		if ($owner->id == 1002) {
			$pc = trim($this->cnee->postcode);
			$zoneMap = ZoneMap::model()->find('org_id = 101 AND zone_id = 0 AND pc_lo <= :p AND pc_hi >= :p', [':p' => $pc]);
			$zoneCode = 'N1';
			if (!empty($zoneMap) && !empty($zoneMap['z1'])) {
				$zoneCode = $zoneMap['z1'];
			}
			$wt = $this->chargeWeight();

			// base charge code to get zone rate
			$zr = ZoneRate::model()->with('orgrate')->find("orgrate.type = 80 AND zone = :s AND (weight_lo < :w AND weight_hi >= :w) AND base+item+perkg > 0 AND orgrate.org_id = 1002 ", [':s' => $zoneCode, ':w' => $wt]);

			if (empty($zr)) {
				// with a default charge rate
				// normally we shouldn't use default charge
				$amt = 0.0;
				if ($wt >= 5) {
					$amt = 8.0 + ($wt - 5) * 0.36; // default only
				} else {
					$amt = 8.0;
				}
			} else {
				// amount = price / piece * quantity + price/pkg * weight
				// quantity is one
				$amt = $zr['item'] + $wt * $zr['perkg'];
			}

			$total = $amt;

			// in case parcel with insurance
			// we add insurance value to total value
			if ($this->insurance > 0) {
				$insuranceRatio = 1;
				if (isset($owner->extra['insurance_invoice_ratio'])) {
					$insuranceRatio = intval($owner->extra['insurance_invoice_ratio']);
				}
				$invInsurance = round($this->insurance * ($insuranceRatio / 100), 2);
				$total += $invInsurance;
			}
		} else {
			// try to get invoice by chargecode
			$total = $this->getChargeByChargecode();
			if ($total == 0) {
				// in case still no value, try our old logic again
				// try to get org price rate
				$orgRate = OrgRate::model()->find('org_id = :oid AND type = 40', [':oid' => $owner->id]);
				if (empty($orgRate)) {
					echo 'Owner: ' . $owner->id . ' price rate is not available yet' . PHP_EOL;
					return 0;
				}

				$amt = $this->getChargePro($owner, $orgRate);

				// in case parcel with insurance
				// we add insurance value to total value
				if ($this->insurance > 0) {
					$insuranceRatio = 1;
					if (isset($owner->extra['insurance_invoice_ratio'])) {
						$insuranceRatio = intval($owner->extra['insurance_invoice_ratio']);
					}
					$invInsurance = round($this->insurance * ($insuranceRatio / 100), 2);
					$total += $invInsurance;
				}
				$total += $amt[0];
			}
		}

		return round($total, 2);
	}

	public function getCostByBPATracking()
	{
		// base on postcode to get BPA charge code
		$zoneMap = ZoneMap::model()->find('org_id = 100 AND pc_lo <= :code AND pc_hi >= :code', [':code' => $this->postcode]);

		// if not found we set as NSW country
		$chargeCode = 'N2';
		if (!empty($zoneMap)) {
			if (!empty($zoneMap['z2'])) {
				// colomun z2 for eparce area, same post code for different service has different charge code
				$chargeCode = $zoneMap['z2'];
			} elseif (!empty($zoneMap['z1'])) {
				$chargeCode = $zoneMap['z1'];
			}
		}

		// base charge code to get zone rate
		// type 60 for BPA rate
		$date = date('Y-m-d');
		$zr = ZoneRate::model()->with('orgrate')->find("orgrate.type = 60 AND zone = :s AND (weight_lo < :w AND weight_hi >= :w) AND base+item+perkg > 0 AND orgrate.org_id = 1 AND orgrate.vfrom <= :today AND (orgrate.vto >= :today OR orgrate.vto = '0000-00-00' OR orgrate.vto is NULL )", [':s' => $chargeCode, ':w' => $this->weight, ':today' => $date]);

		$myWeight = $this->chargeWeight();

		if (empty($zr)) {
			// with a default charge rate
			// normally we shouldn't use default charge
			if ($myWeight >= 5) {
				$r = 8.0 + ($myWeight - 5) * 0.36; // default only
			} else {
				$r = 4.0;
			}
		} else {
			if ($zr['perkg'] > 0.0 && $myWeight > $zr['weight_lo']) {
				$r = $zr['base'] + ($myWeight - $zr['weight_lo']) * $zr['perkg'];
			} else {
				$r = $zr['base'];
			}
		}

		// round about
		// ex. 5.045 -> 5.05
		$r = round($r, 2);
		return $r;
	}

	public function getCostByeParcel()
	{

		// base on postcode to get BPA charge code
		$zoneMap = ZoneMap::model()->find('org_id = 100 AND pc_lo <= :code AND pc_hi >= :code', [':code' => $this->postcode]);

		// if not found we set as NSW country
		$chargeCode = 'N2';
		if (!empty($zoneMap)) {
			if (!empty($zoneMap['z2'])) {
				// colomun z2 for eparce area, same post code for different service has different charge code
				$chargeCode = $zoneMap['z2'];
			} elseif (!empty($zoneMap['z1'])) {
				$chargeCode = $zoneMap['z1'];
			}
		}

		// base charge code to get zone rate
		$date = date('Y-m-d');
		// type 50 for eParcel rate
		$zr = ZoneRate::model()->with('orgrate')->find("orgrate.type = 50 AND zone = :s AND (weight_lo < :w AND weight_hi >= :w) AND base+item+perkg > 0 AND orgrate.org_id = 1 AND orgrate.vfrom <= :today AND (orgrate.vto >= :today OR orgrate.vto = '0000-00-00' OR orgrate.vto is NULL )", [':s' => $chargeCode, ':w' => $this->weight, ':today' => $date]);

		$myWeight = $this->chargeWeight();

		if (empty($zr)) {
			if ($myWeight >= 5) {
				$r = 8.0 + ($myWeight - 5) * 0.36; // default only
			} else {
				$r = 4.0;
			}
		} else {
			$r = $zr->base + $zr->item;
			$wl = $myWeight - ($zr->base > 0 ? $zr->nkg : 0);
			if ($wl > 0 && $zr->nkg > 0) {
				$r += ceil($wl / $zr->nkg) * $zr->perkg;
			}
			if ($zr->minimum > 0 && $r < $zr->minimum) {
				$r = $zr->minimum;
			}
		}
		// round about
		// ex. 5.045 -> 5.05
		$r = round($r, 2);
		return $r;
	}

	public function getRateByBPA(&$aupostRates, &$org)
	{

		// in case delivery service selected as price schedule B
		// don't care about postcode, just charge by kd and pc
		if ($aupostRates->tracking_mode == 2) {
			$r = $this->weight * $aupostRates->st_rate + intval($this->pkg) * $aupostRates->st_prate;
		} elseif ($aupostRates->tracking_mode == 3) {
			// price schedule C

			$r = $this->getDeliveryCRate($org->id);
		} else {
			// base on postcode to get BPA charge code
			$zoneMap = ZoneMap::model()->find('org_id = 100 AND pc_lo <= :code AND pc_hi >= :code', [':code' => $this->postcode]);

			// if not found we set as NSW country
			$chargeCode = 'N2';
			if (!empty($zoneMap)) {
				if (!empty($zoneMap['z2'])) {
					// colomun z2 for eparce area, same post code for different service has different charge code
					$chargeCode = $zoneMap['z2'];
				} elseif (!empty($zoneMap['z1'])) {
					$chargeCode = $zoneMap['z1'];
				}
			}

			// base charge code to get zone rate
			$date = date('Y-m-d');
			$zr = ZoneRate::model()->with('orgrate')->find("orgrate.type = 60 AND zone = :s AND (weight_lo < :w AND weight_hi >= :w) AND base+item+perkg > 0 AND orgrate.org_id = 1 AND orgrate.vfrom <= :today AND (orgrate.vto >= :today OR orgrate.vto = '0000-00-00' OR orgrate.vto is NULL )", [':s' => $chargeCode, ':w' => $this->weight, ':today' => $date]);

			$myWeight = $this->chargeWeight();

			if (empty($zr)) {
				// with a default charge rate
				// normally we shouldn't use default charge
				$r = 0.0;
				if ($myWeight >= 5) {
					$r = 8.0 + ($myWeight - 5) * 0.36; // default only
				} else {
					$r = 4.0;
				}
			} else {
				if ($zr['perkg'] > 0.0 && $myWeight > $zr['weight_lo']) {
					$r = $zr['base'] + ($myWeight - $zr['weight_lo']) * $zr['perkg'];
				} else {
					$r = $zr['base'];
				}
			}

			// add extra post au profit percent
			$r = $r * (1 + $aupostRates->bpa_extra_rate / 100);
		}

		// round about
		// ex. 5.045 -> 5.05
		$r = round($r, 2);

		return $r;
	}

	/**
	 * get related invoice value based on au post rate and org
	 * @param $aupostRates
	 * @param $org
	 * @return float|mixed
	 */
	public function getRateByLetters(&$aupostRates, &$org)
	{

		// we need to calculate weight based on cube and weight
		// sometimes weight is small compare to cube
		$myWeight = $this->chargeWeight();

		// in case delivery service selected as price schedule B
		// don't care about postcode, just charge by kd and pc
		if ($aupostRates->tracking_mode == 2) {
			$r = $myWeight * $aupostRates->st_rate + intval($this->pkg) * $aupostRates->st_prate;
		} elseif ($aupostRates->tracking_mode == 3) {
			// price schedule C

			$r = $this->getDeliveryCRate($org->id);
		} else {
			// get real cmb convert to unit by mm
			$cbm = $this->cbm * 1000 * 1000 * 1000;

			// base charge code to get zone rate
			$date = date('Y-m-d');
			$zoneRates = ZoneRate::model()->with('orgrate')->findAll(['order' => 'minimum ASC',
				'condition' => "orgrate.type = 70 AND orgrate.org_id = 1 AND orgrate.vfrom <= :today AND (orgrate.vto >= :today OR orgrate.vto = '0000-00-00' OR orgrate.vto is NULL )",
				'params' => [':today' => $date]]);

			if (empty($zoneRates)) {
				// with a default charge rate
				// normally we shouldn't use default charge
				$r = 1.75;
			} else {
				$r = 1.75; // default one
				foreach ($zoneRates as $zoneRate) {
					if ($zoneRate['minimum'] >= $cbm && $myWeight >= $zoneRate['weight_lo'] && $myWeight <= $zoneRate['weight_hi']) {
						$r = $zoneRate['base'];
						break;
					}
				}
			}

			// add extra post au profit percent
			$r = $r * (1 + $aupostRates->letters_extra_rate / 100);
		}

		// round about
		// ex. 5.045 -> 5.05
		$r = round($r, 2);

		return $r;
	}

	public function getRateByEParcel(&$aupostRates, &$org,$isSurcharge = false)
	{

		// in case delivery service selected as price schedule B
		// don't care about postcode, just charge by kd and pc
		$r = 0;
		if ($aupostRates->tracking_mode == 2) {
			$r = $this->weight * $aupostRates->ft_rate + intval($this->pkg) * $aupostRates->ft_prate;
		} elseif ($aupostRates->tracking_mode == 3) {
			// price schedule C

			// in case delivery charge code has been set
			// we try to create charge price by charge code
			/*
			if ( isset($aupostRates->dl_chargecode) ){
			$r = $this->getDeliveryCRateByChargecode($aupostRates->dl_chargecode);
			} else {
			$r = $this->getDeliveryCRate($org->id);
			}*/
			// now we based on chargecode in shipment to create invoice or
			// based on previous charge rate setting

			// in case jiacheng , we do special things
			// it is from jiacheng :
			// chargecode set , charged by chargecode
			// not set , charged by org rates
			// it is not from jiacheng
			// ignore any parcles without chargecode
			if ($org->id == Org::ORGID_CLIENT_JIACHENG) {
				if (isset($this->mdata['chargecode'])) {
					$r = $this->getChargeByChargecode('',false,null,false,false,$isSurcharge);
				} else {
					// in case jiacheng,if
					$r = $this->getDeliveryCRate($org->id);
				}
			} else {
				if (isset($this->mdata['chargecode'])) {
					$r = $this->getChargeByChargecode('',false,null,false,false,$isSurcharge);
				}
			}
		} else {

			// base on postcode to get eParcel charge code
			// org id 100 should be australia post code org but it is not now in DB , but doesn't matter just use it
			$zoneMap = ZoneMap::model()->find('org_id = 101 AND pc_lo <= :code AND pc_hi >= :code', [':code' => $this->postcode]);

			// if not found we set as NSW country
			$chargeCode = 'N2';
			if (!empty($zoneMap)) {
				if (!empty($zoneMap['z2'])) {
					// column z2 for eParcel area, same post code for different service has different charge code
					$chargeCode = $zoneMap['z2'];
				} elseif (!empty($zoneMap['z1'])) {
					$chargeCode = $zoneMap['z1'];
				}
			}

			// zone rate saved with org id 1 (System)
			$date = date('Y-m-d');
			$zr = ZoneRate::model()->with('orgrate')->find("orgrate.type = 50 AND zone = :s AND  (weight_lo < :w AND weight_hi >= :w) AND base+item+perkg > 0 AND orgrate.org_id = 1 AND orgrate.vfrom <= :today AND (orgrate.vto >= :today OR orgrate.vto = '0000-00-00' OR orgrate.vto is NULL )", [':w' => $this->weight, ':s' => $chargeCode, ':today' => $date]);

			if (empty($zr)) {
				return false;
			}
			$r = $zr->base + $zr->item;
			$wl = $this->chargeWeight() - ($zr->base > 0 ? $zr->nkg : 0);
			if ($wl > 0 && $zr->nkg > 0) {
				$r += ceil($wl / $zr->nkg) * $zr->perkg;
			}
			if ($zr->minimum > 0 && $r < $zr->minimum) {
				$r = $zr->minimum;
			}

			// add extra post au profit percent
			$r = $r * (1 + $aupostRates->eparcel_extra_rate / 100);
		}

		// round about
		// ex. 5.045 -> 5.05
		if(is_array($r))
		{
			$r['amount'] = round($r['amount'], 2);
			return $r;
		}
		$r = round($r, 2);
		return $r;
	}

	public function statusList()
	{
		$r = ImParcel::$states;
		if (!empty($this->afterArrival)) {
			foreach ($r as $key => $value) {
				if ($key<self::STATE_AIR_ARRIVAL) {
					unset($r[$key]);
				}
			}
		}
		//if(!Acl::hasAccess('B:Export/UpdateParcelAfterConsolidation')){
		//    $r = array_slice($r, 0, 7, true);
		// }
		return $r;
	}

	public function getCharge($owner, $eco = false, $dtl = false)
	{
		$amt = 0;
		$rpf = $eco ? 'eco_rate_' : 'rate_';
		$brate = 0;
		$rate = 0;
		$unit = ceil($this->weight);

		if ($this->weight > 1000) {
			$rate = $owner->extra[$rpf . 'pkg_1000'];
			$amt = $unit * $rate;
		} elseif ($this->weight > 500) {
			$rate = $owner->extra[$rpf . 'pkg_500'];
			$amt = $unit * $rate;
		} elseif ($this->weight > 300) {
			$rate = $owner->extra[$rpf . 'pkg_300'];
			$amt = $unit * $rate;
		} elseif ($this->weight > 100) {
			$rate = $owner->extra[$rpf . 'pkg_100'];
			$amt = $unit * $rate;
		} elseif ($this->weight > 70) {
			$rate = $owner->extra[$rpf . 'pkg_70'];
			$amt = $unit * $rate;
		} elseif ($this->weight > 50) {
			$rate = $owner->extra[$rpf . 'pkg_50'];
			$amt = $unit * $rate;
		} elseif ($this->weight > 30) {
			$rate = $owner->extra[$rpf . 'pkg_30'];
			$amt = $unit * $rate;
		} elseif ($this->weight > 20) {
			$brate = $owner->extra[$rpf . 'base_2'];
			$rate = $owner->extra[$rpf . 'pkg_2'];
			$amt = $unit * $rate;
		} elseif ($this->weight > 1) {
			$brate = $owner->extra[$rpf . 'base_1'];
			$rate = $owner->extra[$rpf . 'pkg_1'];
			$unit = ceil($this->weight * 2) - 1;
			$amt = $unit * $rate;
		} else {
			$brate = $owner->extra[$rpf . 'base_0'];
			$rate = $owner->extra[$rpf . 'pkg_0'];
			$unit = $this->weight > 0.5 ? 1 : 0;
			$amt = $unit * $rate;
		}
		$amt = $brate + $amt;

		return $dtl ? [$amt, $brate, $rate, $unit] : $amt;
	}

	/**
	 * Retrieves a list of models based on the current search/filter conditions.
	 *
	 * Typical usecase:
	 * - Initialize the model fields with values from filter form.
	 * - Execute this method to get CActiveDataProvider instance which will filter
	 * models according to data in model fields.
	 * - Pass data provider to CGridView, CListView or any similar widget.
	 *
	 * @return CActiveDataProvider the data provider that can return the models
	 * based on the search/filter conditions.
	 */
	public function search($pgn = true, $ps = 30, $ec = false, $defaultOrder = true, $ignoreD2z = false,$isBackend=false)
	{
		// @todo Please modify the following code to remove attributes that should not be searched.
		if(!empty($this->ref))
		{
			$pb = ParcelBarcode::model()->find('sub_ref = :subRef',[':subRef'=>$this->ref]);
			if(!empty($pb)) $this->ref = $pb->main_ref;
		}
		$criteria = new CDbCriteria;
		if($this->withSctime)
		{
			$criteria->select = "*,json_value(t.meta,'$.scan_time') as sctime";
		}
		$with = [];
		$smart_comp = function($f, $v) use($criteria){
			if(preg_match('/^\?/', $v)){
				$criteria->compare($f, substr($v,1), true);
			}else{
				$criteria->compare($f, $v, false);
			}
		};
		if (!empty($this->agent_id)) {
			$criteria->compare('agent_id', $this->agent_id, false);
			if (!empty($this->hbn)) {
				$criteria->compare('agent_id', 0, false, 'OR');
				$smart_comp('hbn', $this->hbn);
			}
		} else {
			$smart_comp('hbn', $this->hbn);
		}
		if ($ignoreD2z) {
			$criteria->addCondition('t.cbwf & ' . self::CBWF_D2Z_CONSOL_NOT_FOR_SCAN . '= 0');
		}
	
		$criteria->compare('t.id', $this->id);
		$criteria->compare('t.owner_id', $this->owner_id);
		$criteria->compare('t.consol_id', $this->consol_id);
		$criteria->compare('cnor_id', $this->cnor_id);
		$criteria->compare('cnee_id', $this->cnee_id);
		$criteria->compare('receiver_id', $this->receiver_id);
		$criteria->compare('rec_id', $this->rec_id);
		$criteria->compare('odpt_id', $this->odpt_id);
		// $criteria->compare('t.ddpt_id', $this->getUserDptId());
		if(!empty($this->ddpt_id)&&$this->canUserCheckAll())
		{
			$with[] = 'consol';
			$criteria->addCondition("t.ddpt_id = {$this->ddpt_id} or consol.dpt_id = {$this->ddpt_id}");
		}else
		{
			if(!$isBackend)
			{
				if(!empty($this->getUserDptId())&&empty($this->withSctime))
				{
					$with[] = 'consol';
					$criteria->addCondition("t.ddpt_id = {$this->getUserDptId()} or consol.dpt_id = {$this->getUserDptId()}");
				}
			}
		}

		$criteria->compare('zr_id', $this->zr_id);
		if(isset($this->ot_id))
		{
			$criteria->addCondition('t.ot_id = '.$this->ot_id);
		}
		if (empty($this->status) && empty($this->hbn) && empty($this->ref) && empty($this->mhbns)) {
			$criteria->addCondition('t.status != 100');
		} else {
			$criteria->compare('t.status', $this->status, false);
		}

		if (!empty($this->clear)) {
			$with[] = 'consol';
			$criteria->addCondition("t.ref like 'PICKUP8%' and t.status = 60 and LENGTH(t.ref) < 15 and json_value(consol.meta,'$.ContainerUnloadDate') != '' and t.created >= '2022-01-01'");
		}
		//$criteria->compare('t.type',$this->type);
		$smart_comp('t.ref', $this->ref);
		$smart_comp('cref', $this->cref);
		$criteria->compare('t.styp', $this->styp);
		$criteria->compare('pkg', $this->pkg, true);
		$criteria->compare('t.state', $this->state, true);
		$smart_comp('t.postcode', $this->postcode);
		$criteria->compare('value', $this->value, true);
		$criteria->compare('dvalue', $this->dvalue, true);
		$criteria->compare('tariff', $this->tariff, true);
		$criteria->compare('currency', $this->currency);
		$criteria->compare('weight', $this->weight, true);
		$criteria->compare('wtck', $this->wtck, true);
		$criteria->compare('cbm', $this->cbm, true);
		$criteria->compare('sac', $this->sac);
		$criteria->compare('exm', $this->exm, true);
		$criteria->compare('can', $this->can, true);
		$criteria->compare('scan_no', $this->scan_no);
		$criteria->compare('t.note', $this->note, true);
		$criteria->compare('t.created', $this->created, true);
		if (!empty($this->bagTag)) {
			$with[] = 'bag_tag';
			$smart_comp('bag_tag.bag_tag', $this->bagTag);
		}
		if (!empty($this->afterArrival)) {
			$criteria->addCondition("t.status >= ".self::STATE_AIR_ARRIVAL);
		}
		if (!empty($this->chargecode)) {
			if(is_array($this->chargecode))
			{
				$criteria->addCondition("json_value(t.meta,'$.chargecode') in ('".join("','",$this->chargecode)."')");
			}else
			{
				$criteria->addCondition("json_value(t.meta,'$.chargecode') = '".$this->chargecode."'");
			}
		}

		if(!empty($this->scheDate)){
			$criteria->addCondition("json_value(t.meta,'$.CustomerBookingDate') like '%".$this->scheDate."%'");
		}

		if (!empty($this->is_diff)) {
			$criteria->addCondition("json_value(t.meta,'$.is_diff') like '%".$this->is_diff."%'");
		}

		if (!empty($this->editStreetCode)) {
			$criteria->addCondition("(json_value(t.meta,'$.editStreetCode') & ".$this->editStreetCode.")>0");
		}

		if (!empty($this->customNote)) {
			$criteria->addCondition("json_value(t.meta,'$.custom_note') like '%".$this->customNote."%'");
		}

		if (!empty($this->searchHeld)) {
			$with[] = 'process';
			$criteria->addCondition(" process.status < ".ShipmentProcess::CUSTOM_DONE);
			$criteria->addCondition(" t.status < ".self::STATE_CLEAR);
			if (!empty($this->heldDate)) {
				$with[] = 'tracks';
				$criteria->addCondition(" tracks.type = 55 and tracks.dt like '%".$this->heldDate."%'");
			}
		}
		if (!empty($this->mhbns)) {
			$ns = preg_split('/[\s,;]+/', trim($this->mhbns));
			if (sizeof($ns) > 200) {
				$ns = array_slice($ns, 0, 200);
			}
			$sc1 = new CDbCriteria;
			$sc1->addCondition("1=1");
			foreach ($ns as $key => $n) {
				$ns[$key] = str_replace('"', '', $n);
			}
			$pbs = ParcelBarcode::model()->findAll('sub_ref in ("'.join('","',$ns).'")');
			if(!empty($pbs))
			{
				$ids = array_column($pbs, 'fid');
				$fids = array_unique($ids);
				$sc1->addInCondition("t.id", $fids);
			}
			foreach ($pbs as $key => $pb) {
				foreach ($ns as $key => $n) {
					if($pb->sub_ref==$n||$pb->main_ref==$n) unset($ns[$key]);
				}
			}
			if(!empty($ns))
			{
				if(!empty($pbs))
				{
					$sc1->addInCondition("hbn", $ns, 'OR');
				}else
				{
					$sc1->addInCondition("hbn", $ns);
				}
				$sc1->addInCondition("ref", $ns, 'OR');
				$sc1->addInCondition("cref", $ns, 'OR');
			}

			$criteria->mergeWith($sc1);
		}

		if(!empty($subRefs))
		{
			$pb = ParcelBarcode::model()->find('sub_ref = :subRef',[":subRef"=>$this->ns]);
			if(!empty($pb))
			{

			}
		}
		
		if (!empty($this->fbas)) {
			$ns = preg_split('/[\s.,，;]+/', trim($this->fbas));
			if (sizeof($ns) > 10) {
				$ns = array_slice($ns, 0, 10);
			}
			$fbaCriterias = [];
			foreach ($ns as $key => $n) {
				$n = trim($n);
				if (!empty($n)) {
					$fbaCriterias[] = "json_value(t.meta,'$.amazon_po') like '%${n}%'";
				}
			}
			$criteria->addCondition(" ( ".join(" or ", $fbaCriterias)." ) ");
		}

		if (!empty($this->fbaIds)) {
			$ns = preg_split('/[\s.,，;]+/', trim($this->fbaIds));
			if (sizeof($ns) > 10) {
				$ns = array_slice($ns, 0, 10);
			}
			$fbaCriterias = [];
			foreach ($ns as $key => $n) {
				$n = trim($n);
				if (!empty($n)) {
					$fbaCriterias[] = "json_value(t.meta,'$.amazon_shipment_ids') like '%${n}%'";
				}
			}
			$criteria->addCondition(" ( ".join(" or ", $fbaCriterias)." ) ");
		}

		if (!empty($this->mids)) {
			$criteria->addInCondition("t.id", $this->mids);
		}
		if($this->exInfo==Self::DGBWFCODE)
		{
			$criteria->addCondition('json_value(t.meta,"$.is_dg") = 1');
		}
		if($this->exInfo==Self::DAMAGEBWFCODE)
		{
			$criteria->addCondition('t.bwf & ' . $this->exInfo . ' > 0');
		}
		
		if (!empty($this->bwf)) {
			$criteria->addCondition('t.bwf & ' . $this->bwf . ' > 0');
		}
		if (!empty($this->not_bwf)) {
			$criteria->addCondition('t.bwf & ' . $this->not_bwf . ' = 0');
		}

		if (!empty($this->cbwf)) {
			$criteria->addCondition('t.cbwf & ' . $this->cbwf . ' > 0');
		}

		if (!empty($this->agent_name)) {
			$with[] = 'agent';
			$criteria->addCondition('agent.name LIKE :agt_name OR agent_id = :agt_id');
			$criteria->params[':agt_name'] = '%' . $this->agent_name . '%';
			$criteria->params[':agt_id'] = $this->agent_name;
		}

		if (!empty($this->cnee_name)) {
			$with[] = 'cnee';
			$with[] = 'receiver';
			$criteria->addCondition('cnee.name LIKE :cnee_name OR receiver.name LIKE :cnee_name');
			$criteria->params[':cnee_name'] = '%' . $this->cnee_name . '%';
			// $criteria->compare('cnee.name', $this->cnee_name, true);
		}
		if (!empty($this->cnee_company)) {
			$with[] = 'cnee';
			$criteria->compare('cnee.company', $this->cnee_company, true);
		}
		if (!empty($this->cnee_email)) {
			$with[] = 'cnee';
			$criteria->compare('cnee.email', $this->cnee_email, true);
		}

		if (!empty($this->cnee_tel)) {
			$with[] = 'cnee';
			$criteria->compare('cnee.tel', $this->cnee_tel, true);
		}

		if (!empty($this->cnee_addr)) {
			$with[] = 'cnee';
			$criteria->compare('cnee.address', $this->cnee_addr, true);
		}

		if (!empty($this->cnee_cnid)) {
			$with[] = 'cnee';
			$with[] = 'cnee.cnid';
			$criteria->compare('cnid.no', $this->cnee_cnid, true);
		}

		if (!empty($this->cnor_name)) {
			$with[] = 'cnor';
			$criteria->compare('cnor.name', $this->cnor_name, true);
		}

		if (!empty($this->cnor_tel)) {
			$with[] = 'cnor';
			$criteria->compare('cnor.tel', $this->cnor_tel, true);
		}

		if (!empty($this->consol_no)) {
			$with[] = 'consol';
			$criteria->compare('consol.no', $this->consol_no);
		}

		if (!empty($this->pmc_ake_numbers)) {
			$with[] = 'consol';
			$ns = preg_split('/[\s.,，;]+/', trim($this->pmc_ake_numbers));
			if (sizeof($ns) > 10) {
				$ns = array_slice($ns, 0, 10);
			}
			$fbaCriterias = [];
			foreach ($ns as $key => $n) {
				$n = trim($n);
				if (!empty($n)) {
					$fbaCriterias[] = "json_value(consol.meta,'$.pmc_ake_number') like '%${n}%'";
				}
			}
			$criteria->addCondition(" ( ".join(" or ", $fbaCriterias)." ) ");
		}

		if (!empty($this->unloadDate)) {
			$with[] = 'consol';
			$criteria->addCondition("json_value(consol.meta,'$.ContainerUnloadDate') like '%".$this->unloadDate."%'");
		}

		if(!empty($this->goodsAvailableAddress))
		{
			$with[] = 'consol';
			$criteria->addCondition(' json_value(consol.meta,"$.available_date") is not null and json_value(consol.meta,"$.available_date") != "" and json_value(consol.meta,"$.goods_available_address") = '.$this->goodsAvailableAddress);
		}

		// if(!empty($this->isCustomSearching))
		// {
		// 	$with[] = 'consol';
		// 	$criteria->addCondition(' json_value(consol.meta,"$.available_date") is not null and json_value(consol.meta,"$.available_date") != "" and json_value(consol.meta,"$.goods_available_address") != 4');
		// }


		if (!empty($this->consol_eta)) {
			$with[] = 'consol';
			$criteria->compare('consol.eta', $this->consol_eta, true);
		}

		if (!empty($this->awb_name)) {
			$consol = Consol::model()->findAll('awb like "%'.$this->awb_name.'%" or container_no = "'.$this->awb_name.'"');
			$with[] = 'consol';
			if(!empty($consol))
			{
				$criteria->compare('t.consol_id',array_column($consol,'id'));
			}else
			{
				$criteria->compare('t.consol_id',-1);
			}
		}
		if (!empty($this->process_status)) {
			$with[] = 'process';
			$criteria->compare('process.status', $this->process_status);
			// if($this->process_status<ShipmentProcess::DOCUMENT_CONFIRM)
			// {
			// 	$criteria->addCondition('t.status < '.ImParcel::STATE_CLEAR);
			// }
		}

		if (!empty($this->sea_process_status)) {
			$with[] = 'sea_process';
			$criteria->compare('sea_process.status', $this->sea_process_status);
		}
		if (!empty($this->process_statuses)) {
			$with[] = 'process';
			$criteria->addInCondition('process.status', $this->process_statuses);
		}
		if (!empty($this->process_not_status)) {
			$with[] = 'process';
			$criteria->addNotInCondition('process.status', $this->process_not_status);
		}
		if (!empty($this->process_doc_date)) {
			$with[] = 'process';
			$criteria->compare('process.date', $this->process_doc_date, true);
		}
		if (!empty($this->process_broker)) {
			$with[] = 'process';
			if($this->process_broker==-1)
			{
				$criteria->compare('process.broker_id', 0);
			}else
			{
				$criteria->compare('process.broker_id', $this->process_broker);
			}
		}
		if (!empty($this->sea_process_not_in)) {
			$with[] = 'sea_process';
			$criteria->addNotInCondition('sea_process.status', $this->sea_process_not_in);
		}
		if (!empty($this->item_name)) {
			$criteria->compare('t.items', $this->item_name, true);
		}

		if (!empty($this->rack)) {
			$with[] = 'rack_record';
			$with[] = 'rack_record.location';
			$criteria->addCondition('location.name like "%'.$this->rack.'%"');
		}

		if(!empty($this->searchGatePass))
		{
			$with[] = 'manif';
			//$criteria->addCondition('(manif.type != 50 and man_id > 0) or man_id = 0');
		}else
		{
			$criteria->compare('man_id', $this->man_id);
		}

		if (!empty($this->cargoProcessPreAlert)) {
			$this->addCargoProcessPreAlertCriteria($criteria, $with);
		}

		if(!empty($this->willBeCargoProcess)){
			$with[] = 'consol';
			$with[] = 'cargo_process';
			$with[] = 'cnee';
			$criteria->addCondition('(consol.id >0 and t.scan ="" and json_value(consol.meta,"$.ContainerUnloadDate") >="'.date("Y-m-d",strtotime("+1 day")).'") or (t.scan !="" AND consol.id >0 and cargo_process.id>0 and cargo_process.status = 10)');
			$criteria->addCondition("(t.status < 90 and t.status != 62)");
			$postcode=CargoProcess::OVERSEAPOSTCODE;
			$this->addFBAB2BPreAlertCriteria($criteria, $postcode, "B2B");
		}

		if ($ec) {
			$criteria->mergeWith($ec);
		}

		$sort = new CSort(get_called_class());
		$sort->attributes = [
			'cnor_name' => [
				'asc' => 'cnor.name',
				'desc' => 'cnor.name DESC',
			],
			'cnee_name' => [
				'asc' => 'cnee.name',
				'desc' => 'cnee.name DESC',
			],
			'cnee_addr' => [
				'asc' => 'cnee.address',
				'desc' => 'cnee.address DESC',
			],
			'process_doc_date' => [
				'asc' => 'process.date',
				'desc' => 'process.date DESC',
			],
			'awb_name' => [
				'asc' => 'consol.awb',
				'desc' => 'consol.awb DESC',
			],
			'agent_name' => [
				'asc' => 'agent.name',
				'desc' => 'agent.name DESC',
			],
			'consol_no' => [
				'asc' => 'consol.no',
				'desc' => 'consol.no DESC',
			],
			'consol_eta' => [
				'asc' => 'consol.eta',
				'desc' => 'consol.eta  DESC',
			],
			'meta' => [
				'asc' => 'meta',
				'desc' => 'meta DESC',
			],
			'bag_tag' =>
			[
				'asc' =>'bag_tag.bag_tag',
				'desc' => 'bag_tag.bag_tag DESC'
			],
			'sctime' =>
			[
				'asc' =>'sctime',
				'desc' => 'sctime DESC'
			],

			'*',
		];
		if ($defaultOrder) {
			$sort->defaultOrder = 't.bwf DESC, t.id DESC';
		} else {
			$sort->defaultOrder = 't.id DESC';
		}
		$sob = $sort->getOrderBy();
		$sobs = preg_split('/, */', $sob);
		foreach ($sobs as $ob) {
			if (!strpos($ob, '.')) {
				continue;
			}
			list($m, $f) = explode('.', $ob);
			if (str_replace('`', '', $m) == 't') {
				continue;
			}
			$with[] = $m;
		}

		if (!empty($with)) {
			$criteria->with = array_unique($with);
			$criteria->together = true;
		}

		if (!empty($this->clear)) {
			$sort->defaultOrder = " t.status DESC";
		}
		// in case sub-gridview, we need consol_id set by parent grid view
		$pagerparams = $_GET;
		if ($this->consol_id > 0) {
			$pagerparams['consoleId'] = $this->consol_id;
		}

		return new CActiveDataProvider($this, [
			'criteria' => $criteria,
			'sort' => $sort,
			'pagination' => $pgn ? [
				'pageSize' => $ps,
				'params' => $pagerparams,
			] : false,
		]);
	}

	public function validItems()
	{
		$goods_zh = AppHelper::getAgtSettings('goods_zh') == 1;

		$all = trim(implode('', $this->eitems['g']) . implode('', $this->eitems['q']) . implode('', $this->eitems['v']));
		if (empty($all)) {
			$this->addError('items', 'At least one item detail is required.');
			return false;
		}
		$err = [];
		for ($i = 0; $i < sizeof($this->eitems['g']); $i++) {
			if (empty($this->eitems['g'][$i]) && empty($this->eitems['q'][$i]) && empty($this->eitems['v'][$i])) {
				continue;
			}
			if (empty($this->eitems['g'][$i])) {
				$this->eitems['g'][$i] = false;
				$err[] = 'Item ' . ($i + 1) . ' needs description';
			}
			if (empty($this->eitems['q'][$i])) {
				$this->eitems['q'][$i] = false;
				$err[] = 'Item ' . ($i + 1) . ' needs quantity';
			}
			if (!is_numeric($this->eitems['q'][$i])) {
				$err[] = 'Item ' . ($i + 1) . ' qty has non numeric value';
			}
			if (empty($this->eitems['v'][$i])) {
				$this->eitems['v'][$i] = false;
				$err[] = 'Item ' . ($i + 1) . ' needs unit value';
			}
			if (!is_numeric($this->eitems['v'][$i])) {
				$err[] = 'Item ' . ($i + 1) . ' value has non numeric value';
			}
			//chinese required
			if ($goods_zh && empty($this->eitems['g_zh'][$i])) {
				$this->eitems['g_zh'][$i] = false;
				$err[] = 'Item ' . ($i + 1) . ' needs Chinese description';
			}
			if ($goods_zh && empty($this->eitems['hs'][$i])) {
				$this->eitems['hs'][$i] = false;
				$err[] = 'Item ' . ($i + 1) . ' needs HS code';
			}
		}
		if (empty($err)) {
			return true;
		} else {
			$this->addError('items', implode(", ", $err));
			return false;
		}
	}

	/*
	 * get the chargecode
	 */
	public function getChargecode()
	{
		return isset($this->mdata['chargecode']) ? $this->mdata['chargecode'] : '';
	}

	/*
	 * get the chargecode
	 */
	public function getImportChargecode()//
	{
		if(!empty($this->getChargecode()))
		{
			$icc = ImportChargeCode::model()->find("chargecode=:chargecode",[":chargecode"=>$this->getChargecode()]);
			return $icc;
		}
		return null;
	}

	public function heldReason()
	{
		$heldReasons = [];
		if (!empty($this->mdata['held_reason'])) {
			$reason = $this->mdata['held_reason'];
			// if (preg_match('/DECONSOLIDATION UNDERBOND SATISFIED:(NO|YES)/', $reason, $temp)) {
			// 	if (!empty($temp[1])) {
			// 		$heldReasons['border']['deconsolidation'] = $temp[1];
			// 	}
			// }
			
			// if (preg_match('/CARGO REPORT ACS EVALUATED:(NO|YES)/', $reason, $cargo)) {
			// 	$heldReasons['border']['cargo'] = $cargo[1];
			// }
			
			if (preg_match('/ACS EVALUATION COMPLETE:(NO|YES)/', $reason, $acs)) {
				$heldReasons['border']['acs'] = $acs[1];
			}
			if (preg_match('/AQIS CARGO REPORT EVALUATION COMPLETE:(NO|YES)/', $reason, $aqis)) {
				$heldReasons['aqis'] = $aqis[1];
			}
			if (preg_match('/REQUEST FOR INFORMATION/', $reason, $empp)) {
				$heldReasons['empp'] = true;
			}
			if (preg_match('/CARGO REPORT SAC:(NO|YES)/', $reason, $sac)) {
				$heldReasons['sac'] = $sac[1];
			}
			if ((!empty($heldReasons['sac'])) && $heldReasons['sac'] == 'NO') {
				$ignore_sac = false;
				if (isset($this->mdata['chargecode'])) {
					$chargecode = $this->mdata['chargecode'];
					$chargeCodeInfo = ImportChargeCode::model()->find('chargecode = :ccode', [':ccode' => $chargecode]);
					if (!empty($chargeCodeInfo)) {
						if (isset($chargeCodeInfo->ignore_sac) && $chargeCodeInfo->ignore_sac == 1) {
							$ignore_sac = true;
						}
					}
				}
				if ($ignore_sac && $this->getAUDvalue() < 1000) {
					$this->bwf = $this->bwf | 8;
					$this->bwf = $this->bwf & 4 ^ $this->bwf;
				} else {
					$this->bwf = $this->bwf | 4; //high value
					$this->bwf = $this->bwf & 8 ^ $this->bwf;
				}
			} else {
				$this->bwf = $this->bwf & 4 ^ $this->bwf;
				$this->bwf = $this->bwf & 8 ^ $this->bwf;
			}

			if (!empty($heldReasons['empp'])) {
				$this->bwf = $this->bwf | self::EMPPCODE;
			}else {
				$this->bwf = $this->bwf & self::EMPPCODE ^ $this->bwf;
			}


			if ((!empty($heldReasons['aqis'])) && $heldReasons['aqis'] == 'NO') {
				$this->bwf = $this->bwf | 32;
			} else {
				$this->bwf = $this->bwf & 32 ^ $this->bwf;
			}
			$border = false;
			if (!empty($heldReasons['border'])) {
				foreach ($heldReasons['border'] as $r) {
					if ($r == 'NO') {
						$border = true;
					}
				}
			} else {
				$this->bwf = $this->bwf & 16 ^ $this->bwf;
			}
			if ($border) {
				// if ((($this->bwf & 8) > 0) || (($this->bwf & 32) > 0)) {//2022-07-15 remove high value 

				$reHVBorderTag = true;
				
				if (($this->bwf & 4) > 0 )
				{
					if(!empty($this->process))
					{
						if($this->process->status>ShipmentProcess::MSG_BROKER)
						{
							$reHVBorderTag = false;
						}
					}
				}

				if ((($this->bwf & 4) > 0&&$reHVBorderTag) || (($this->bwf & 8) > 0) || (($this->bwf & 32) > 0)|| (($this->bwf & self::EMPPCODE) > 0)) {
					$this->bwf = $this->bwf & 16 ^ $this->bwf;
				} else {
					$this->bwf = $this->bwf | 16;

					// tick other
					if (preg_match('/CARGO REPORT ACS EVALUATED:NO/', $reason) && preg_match('/ACS EVALUATION COMPLETE:NO/', $reason) && preg_match('/LCL UNDERBOND SATISFIED:YES/', $reason)) {
						$acr_msg = Edimsg::model()->find(['condition' => 'fid = :fid', 'params' => [':fid' => $this->id], 'order' => 'id ASC']);
						if (!empty($acr_msg->dt) && time() - strtotime($acr_msg->dt) > 7200) {
							$this->bwf = $this->bwf | 1024;
						}
					}
				}
			} else {
				$this->bwf = $this->bwf & 16 ^ $this->bwf;
			}
			// $this->update(['bwf']);
		}
	}

