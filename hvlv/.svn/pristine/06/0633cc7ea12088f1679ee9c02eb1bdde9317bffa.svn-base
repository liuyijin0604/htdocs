	public function getRef()
	{
		if (!empty($this->ref)) {
			return $this->ref;
		} else {
			return $this->hbn;
		}
	}

	public function updateDeliveryStatus()
	{
		$this->status = self::DELIVERED;
		if (!$this->hasTracking(90)) {
			$this->addTracking(90, 'Parcels Successfully Delivered');
		}
		$this->save();
	}

	public function updateDeliveryTracking($cargoProcessId = false, $caref = false,$packages = 0,$withStatus = false)
	{
		if($withStatus)
		{
			$this->status = self::DELIVERED;
		}

		if(!empty($cargoProcessId))
		{
			if (!$this->hasCargoProcessTracking(90,$cargoProcessId)) {
			$this->addCargoTracking(90, "{$caref} with {$packages} packages: Parcels Successfully Delivered",'','',0,0,'{"cargo_process_id":"'.$cargoProcessId.'"}',$cargoProcessId);
			}
		}else
		{
			if (!$this->hasTracking(90)) {
			$this->addTracking(90, 'Parcels Successfully Delivered');
			}
		}
		$this->save();
	}

	public function getColorCls()
	{
		return $this->bwf > 0? 'red' : '';
	}

	public function getSZPWarnings($s=true, $d=false)
	{
		return AppHelper::bwf2warning([$this->generateWarning(), self::$warnings], $s, $d);
	}
	public function generateWarning()
	{
		$warnings = 0;
		if (!isset($this->weight)||$this->weight == 0) {
			$warnings = $warnings|16;
		}

		if (!isset($this->cnee)) {
			$warnings = $warnings|4;
		} else {
			if (!isset($this->cnee->address)||$this->cnee->address==""||!isset($this->cnee->suburb)||$this->cnee->suburb==""||!isset($this->cnee->city)||$this->cnee->city==""||!isset($this->cnee->state)||$this->cnee->state==""||!isset($this->cnee->postcode)||$this->cnee->postcode==""||!isset($this->cnee->country)||$this->cnee->country=="") {
				$warnings = $warnings|4;
			}
			if (!isset($this->cnee->tel)||$this->cnee->tel=="") {
				$warnings = $warnings|64;
			}
			if (!isset($this->cnee->name)||$this->cnee->name=="") {
				$warnings = $warnings|128;
			}
		}

		if (!isset($this->dvalue)||$this->dvalue == 0) {
			$warnings = $warnings|512;
		}

		if (!$this->canSAC()) {//USD
			$warnings = $warnings|1;
		}

		return $warnings;
	}
	public function saveNormalDeliveryInfo($deliveryBookingTime)
	{
		if (empty($deliveryBookingTime)) {
			$deliveryBookingTime = null;
		}
		$cargoDeliveryInfo=$this->getCargoDeliveryInfo();
		if (empty($cargoDeliveryInfo)) {
			$cargoDeliveryInfo = new CargoDeliveryInfo();
			$cargoDeliveryInfo->shipment_id = $this->id;
			$cargoDeliveryInfo->delivery_booking_time = $deliveryBookingTime;
			$cargoDeliveryInfo->model = 'ImParcel';
			$cargoDeliveryInfo->save();
			$this->mdata['delivery_booking_time']=$deliveryBookingTime;
			if ($this->status<90) {
				$this->updateDeliveryBookingTime();
			}
		} else {
			$cargoDeliveryInfo->delivery_booking_time = $deliveryBookingTime;
			$this->mdata['delivery_booking_time']=$deliveryBookingTime;
			$this->updateDeliveryBookingTime(true);
			$cargoDeliveryInfo->update('delivery_booking_time');
		}
	}

	public function checkCanBeCargoProcess()
	{
		if(($this->status==self::STATE_CLEAR||$this->status==self::STATE_LOCAL_ARRIVAL||$this->status==self::RTS_RECEIVED||!empty($this->mdata['force_tld_status'])||(in_array($this->status,[ImParcel::STATE_TRANSHIP,ImParcel::STATE_CONCLEAR,self::STATE_HELD,self::STATE_DUTY_HELD,self::STATE_CLEAR_WAIT])&&$this->isParcelPickup()))&&($this->scanCount()>0||!empty($this->mdata['cargo_ignore_scan'])))
		{//&&($this->scan_no == 0||!empty($this->mdata['cargo_ignore_scan']))
			if(in_array($this->agent_id,[1804,3551])&&preg_match("/PICKUP/i", $this->ref))
			{
				return false;
			}

			return true;
		} else {
			return false;
		}
	}
	
	public function getCubicRate()
	{
		if (!empty($this->mdata["chargecode"])) {
			$chargeCode = ImportChargeCode::model()->find(" chargecode = :chargecode ", [":chargecode"=>$this->mdata["chargecode"]]);
			if (@!empty($chargeCode->mdata["cubic_rate_factor"])) {
				return ceil(1000000/ImportChargeCode::$cubic_factors[$chargeCode->mdata["cubic_rate_factor"]]);
			} else {
				return 250;
			}
		} else {
			return 250;
		}
	}

	public function getChargedInvoice($consol = false)
	{
		$appName = Yii::app()->name;
		if($this->isTLA())
		{
			Yii::app()->name = 'TLA';
		}else
		{
			Yii::app()->name = 'HVLV';
		}
		if(!empty($consol))
		{
			$invoices = $consol->invoice;
		}else
		{
			$invoices = @$this->consol->invoice;
		}
		$charge =0;
		if ($invoices!=null) {
			foreach ($invoices as $key => $invoice) {
				if(in_array($invoice->status,[Invoice::INVOICE_STATUS_FULLY_CREDITED,Invoice::INVOICE_STATUS_CACELLED])) continue;
				if (strpos($invoice->no, "IM")!==false||strpos($invoice->no, "DI")!==false) {
					if($this->consol->isTLA())
					{
						Yii::app()->name = 'TLA';
					}else
					{
						Yii::app()->name = 'HVLV';
					}
					$invline = InvLine::model()->find(" inv_id = :invId and fid = :consolId and meta like '%{$this->ref}%' ", [":invId"=>$invoice->id,":consolId"=>$invoice->consol_id]);
					if ($invline != null) {
						if (isset($invline->mdata['items'])) {
							$items = $invline->mdata['items'];
							foreach ($items as $key => $item) {
								if ($item[0]==$this->ref) {
									$charge = $item[5];
									break;
								}
							}
						}
					}
				}
			}
		}
		Yii::app()->name = $appName;

		if (empty($charge)) {
			$charge = $this->getChargeByChargecode();
			$charge =round($charge, 2);
		}

		if ($this->getIsIncludeGst()) {
			$charge = $charge*1.1;
		}
		return $charge;
	}
	
	public function getIsIncludeGst()
	{
		if (!empty($this->agent->extra['incl_gst'])) {
			return true;
		} else {
			return false;
		}
	}

	public function getCneeAddress($type=false)
	{
		if ($type) {
			return $this->cnee->address.", <br>".$this->cnee->suburb.", ".$this->cnee->state.", <br>".$this->cnee->country.", ".$this->cnee->postcode;
		} else {
			return $this->cnee->address.", ".$this->cnee->suburb.", ".$this->cnee->state.", ".$this->cnee->country.", ".$this->cnee->postcode;
		}
	}

	public function getDimension()
	{
		if (!empty($this->mdata['dim']['w'])) {
			return $this->mdata['dim']['w']."cm x".$this->mdata['dim']['h']."cm x".$this->mdata['dim']['d']."cm";
		}
		return "&nbsp;";
	}

