<?php
	$reason='';
	$showLOA = false;
	if (($model->bwf&64)>0||($model->bwf&128)>0) 
	{
		$showLOA =true;
	}


	if ($_GET['r']=='sed') {
		$document="Invoice;Packing List";
	} elseif ($_GET['r']=='rec') {
		$document="LOA";
	} elseif ($_GET['r']=='inv') {
		$document="Payment Receipt";
	} elseif ($_GET['r']=='empp') {
		$document='<ul><li>Commercial Invoice </li><li>Sales Contract</li><li>Purchase link or Purchase order, Payment receipt, goods description and photos</li></ul>';
	} elseif ($_GET['r']=='aqis') {
		$document='<ul><li>Commercial Invoice(which should include products`s photo and material</li></ul>';
	} else {
		$document='';
	}
	if ($_GET['r']=='rec'||$_GET['r']=='sed'||$_GET['r']=='empp'||$_GET['r']=='aqis') {
		if (($model->bwf&4)>0) {
			$reason.='Collect Documents for Custom High Value declaration';
		} elseif (($model->bwf&32)>0) {
			$reason.='Collect Documents for Custom AQIS declaration';
		} elseif (($model->bwf&512)>0) {
			$reason.='Collect Documents for Custom EMPP declaration';
		}
	} elseif ($_GET['r']=='inv') {
		$reason.='Collect receipt for payment for the duty';
	}
?>
	<div class="container">
		<div class="jumbotron">
			<h3 >Parcel Number:<?= $model->ref ?></h3>
			<hr>
			<div class="row">
				<div class="col-md-12"> 
					<h3><b>Reason:</b>&nbsp;&nbsp;<?=$reason?></h3>
					<h3><b>Status:</b>&nbsp&nbsp<?=$model->getStatus()?></h3>
					<h3><b>Document Required:</b><?=$document?></h3>
				</div>
			</div>
		</div>
		<div class="row"></div>
<?php
	$tabs=[];
	$goods=$this->renderPartial('goods_list', ['model'=>$model], true);
	if ($_GET['r']=='sed'||$_GET['r']=='inv'||$_GET['r']=='empp'||$_GET['r']=='aqis') {
		$isActive=true;
		if ($_GET['r']=='inv'&&$model->process->status<ShipmentProcess::PAYMENT_RECEIVED&&$model->process->status>= ShipmentProcess::INFORM_BROKER_PAY) {
			$tab_payment= $this->renderPartial('online_payment', ['model'=>$model], true);
			$tabs[]=  ['label'=>'Online Payment','content'=>$tab_payment,'active' => true];
			$isActive=false;
		}
		$main=$this->renderPartial('main_tab', ['model'=>$model], true);
		$tabs[]=  [ 'label' => 'Upload Documents','content' => $main,'active' => $isActive];
		$tabs[]=  ['label'=>'Goods Information','content'=>$goods];

		if($showLOA)
		{
			$loa_tab=$this->renderPartial('tab_loa', ['model'=>$model], true);
			$tabs[]=  [ 'label' => 'Sign LOA','content' => $loa_tab];
		}

	// } elseif ($_GET['r']!='rec') {
	} else if ($_GET['r'] == 'eny') {
		$sub=$this->renderPartial('op_tab', ['model'=>$model], true);
		$tabs[]= ['label' => 'Download Documents', 'content' => $sub,'active'=>true];
		$tabs[]=  ['label'=>'Goods Information','content'=>$goods];
		$loa_tab=$this->renderPartial('tab_loa', ['model'=>$model], true);
		$tabs[]=  [ 'label' => 'Sign LOA','content' => $loa_tab];
	} else if ($_GET['r']=='rec') {
		$loa_tab=$this->renderPartial('tab_loa', ['model'=>$model], true);
		$tabs[]=  [ 'label' => 'Sign LOA','content' => $loa_tab,'active' => true];
		$tabs[]=  ['label'=>'Goods Information','content'=>$goods];
		$main=$this->renderPartial('main_tab', ['model'=>$model], true);
		$tabs[]=  [ 'label' => 'Upload Documents','content' => $main];
	}
	$this->widget('application.extensions.booster.TbTabs', [
		'id'=>'viw-task-'.$model->id,
		'type'=>'tabs',
		'tabs'=> $tabs,
	]);
?>
		<footer class="footer">
				<p style="margin: auto 320px">&copy; Top Logistics 2018</p>
		</footer>
	</div>
