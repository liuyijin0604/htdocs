<script type="text/javascript">

<?php $url=Yii::app()->createUrl('site/logout');?>
	$(document).ready(function() {
    var isTimerRunning = false; // Variable to track if the timer is currently running

    function startTimer() {
      var countdown = 60; // Number of seconds for the countdown

      // Disable the button and start the countdown
	      $('#generate-captcha').prop('disabled', true);
	      isTimerRunning = true;

	      var timerInterval = setInterval(function() {
	        countdown--;
	        $('#generate-captcha').text(countdown + 's'+'后重新发送');

	        if (countdown <= 0) {
	          clearInterval(timerInterval);
	          $('#generate-captcha').prop('disabled', false).text('重新发送');
	          isTimerRunning = false;
	        }
	      }, 1000);
	    }

	    $('#generate-captcha').click(function() {
	      if (isTimerRunning) {
	        return; // Prevent multiple clicks while the timer is running
	      }

	      var username = $('input[name="LoginForm[user]"]').val();
	      $.ajax({
	        url: '<?=$this->createUrl('site/SendSms');?>',
	        method: 'POST',
	        data: {username: username},
	        success: function(response) {
	          var lastFourDigits = response.substring(response.length - 4);
	          var inputElement = $('<input type="text" class="form-control" name="LoginForm[vvc]" autocomplete="off" />');
	          var phoneInfoElement = $('<span class="phone-info">验证码尾号为' + lastFourDigits + '的手机</span>');
	          $('div.input-group').append(inputElement);
	          inputElement.after(phoneInfoElement);
	          startTimer();
	        },
	        error: function() {
	          console.log('Error occurred during captcha generation.');
	        }
	      });
	    });
	  });
	// // Set timeout variables.
	// var timoutWarning = 3600000; // Display warning in 60 Mins.
