<div  class="pane" id="cargo_process_dp_view_type">
<?=$this->render('sub_type_list',array('dataProvider2'=>$dataProvider2,'dataProvider3'=>$dataProvider3,'name'=>$name));?>
</div>
<script>
    $(function(){
       var tab=$("<?=$_GET['tabid']?>");
       var panel=tab.data('panel');
       $("#cargo_process_dp_view",panel).on('click',"table tbody td",function(){
         var podId=parseInt($(this).parent().children(':nth-child(1)').html());
         var data = {};
        data['pod_id'] = podId;
        $.ajax({
            type : 'GET',
            url : '<?php echo Yii::app()->createAbsoluteUrl("cargoProcess/typeList",array('tabid'=>$_GET['tabid'])) ;?>',
            data: data,
            dataType: 'html',
            success:function(resp){
                $('#cargo_process_dp_view_type').html(resp);
            },
        });
       })

       $("#load_cargo_process",panel).on('click',function(){
                if( confirm('Are you sure to load cargo process?')){
                    $(this).prop('disabled', 'disabled');
                    $.get('<?=$this->createUrl("cargoProcess/loadCargoProcess")?>',function(r){
                        $("#load_cargo_process",panel).removeProp('disabled');
                                if(r=='done'){
                                        myApp.notice('Done', 5000);
                                 }else{
                                        myApp.alert(r, false);   
                                 }
                     });    
                }
            })
   })
</script>

