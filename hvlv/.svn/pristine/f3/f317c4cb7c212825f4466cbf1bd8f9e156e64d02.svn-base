<?php
class ExcoConsol extends Consol{

	public static $my_type = 25;

	public static $states = array(
		10 => 'New',
		20 => 'Confirmed',
		30 => 'Reported',
		40 => 'Acknowledged',
		50 => 'Withdrawn',
		70 => 'Dispatched',
		72 => 'Arrived',
		75 => 'Clearance',
		80 => 'Completed',
		90 => 'Cancelled',
	);

	public static $pols = ['106' => 'AUSYD', '218' => 'AUMEL', '530' => 'AUBNE', '788' => 'AUME2'];

	public static $chargeItems = [
		'channel_clear_cost' => 'Clearance Cost',
		'channel_delivery_cost' => 'Delivery Cost',
		'channel_duty_cost' => 'Duty',
		'channel_others_cost' => 'Channel Others',
	];

	public $ocpd;

	public function rules(){
		$rules = array(
			array('dpt_id, pol, pod, poc, exrate', 'required'),
			array('ocpd', 'safe', 'on'=>'search'),
		);
		return array_merge(parent::rules(), $rules);
	}

	public function relations(){
		$r = parent::relations();
		$r['shipments'] = array(self::HAS_MANY, 'ExParcel', 'consol_id');
		return $r;
	}

	public static function totAccrualMissing(){
		//$sql = "select count(id) from consol where type = 25 AND created >= '2017-07-01' AND created <= '". date('Y-m-d',strtotime('-30 days')) ."' and `no` not  in ( select billing_ref from billing_line where type = "  . BillingLine::BILLING_TYPE_EXPORT  .")";
		$sql = "select count(id) from consol where type = 25 AND created >= '2017-07-01' and `no` not  in ( select billing_ref from billing_line where type = "  . BillingLine::BILLING_TYPE_EXPORT  .")";
		$c = Yii::app()->db->createCommand($sql);
		return  floatval($c->queryScalar());
	}

	public function getPoc(){
		return Yii::t(strtolower(__CLASS__), ExChannel::getName($this->poc));
	}

	public function getPno(){
		if(!empty($p->mdata['pno'])) return $p->mdata['pno'];
		$this->mdata['pno'] = 'P'.(self::model()->count('poc = :poc AND status > 20 AND awb !="" AND id != :id AND etd < :etd', [':poc' => $this->poc, ':id' => $this->id, ':etd' => $this->etd]) + self::model()->count('poc = :poc AND status > 20 AND awb !="" AND id < :id AND etd = :etd', [':poc' => $this->poc, ':id' => $this->id, ':etd' => $this->etd]) + 1);
		$this->save();
		return $this->mdata['pno'];
	}

	public function saveAccrualAirfreightCost(){
		// currently we fix the priority cargo as our ORG
		$fixedOrgId = 954;

		// for export small parcel
		// air freight cost will be separated as three parts
		// `1.  Export documentation fee
		//  2.  Export security fee
		//  3.  Air Freight fee
		//  how to calculate as below:
		/*
		 * doc是固定的$50，security是$0.135/kg，空运是每个港口/kg的报价
		 */

		// save doc fee , if existing just update
		// try to find old one
		$type = 'GL5'; // for doc fee
		$billing = BillingLine::model()->find('billing_ref = :bref AND item_code = :type AND link_id = :lid',[
			':bref' => $this->no,':type' => $type, ':lid' => $this->id
		]);
		if ( empty($billing) ) {
			$citemType = ChargeItemType::model()->find('code = :type' , [':type' => $type]);
			$desc = empty($citemType) ? '' : $citemType->name;
			$billing = new BillingLine();
		   // $org = Org::model()->find('code = :code',[':code' => $this->poc]);
		   // $orgId = empty($org) ? 0 : $org->id;
			$billing->org_id = $fixedOrgId;
			$billing->billing_ref = $this->no;
			$billing->item_code = $type;
			$billing->link_id = $this->id;
			$billing->currency = 1;
			$billing->dpt_id = Org::PCAE_DEPARTMENT_SYDNEY;
			$billing->dpmt = Invoice::DPMT_EXPORT;
			$billing->type = BillingLine::BILLING_TYPE_EXPORT;
			$billing->desc = $desc;
			$billing->gst = 'EXEMPTEXPENSES';
			$billing->price = 0;
			$billing->qty = 1;
			// get related supplier cost gl code
			$billing->charge_code = '91002';
			$billing->op_id =  isset(Yii::app()->user) ? Yii::app()->user->id : 0;
		}
		$billing->org_id = $fixedOrgId;
		$billing->accrual_amount = 50;
		$billing->save();
		$exc = $billing->accrual_amount;

		// save to pl ledger table



		$totWeight = $this->totWeight();
		// save security fee
		$type = 'GL11'; // for security fee
		$billing = BillingLine::model()->find('billing_ref = :bref AND item_code = :type AND link_id = :lid',[
			':bref' => $this->no,':type' => $type, ':lid' => $this->id
		]);
		if ( empty($billing) ) {
			$citemType = ChargeItemType::model()->find('code = :type' , [':type' => $type]);
			$desc = empty($citemType) ? '' : $citemType->name;
			$billing = new BillingLine();
			//$org = Org::model()->find('code = :code',[':code' => $this->poc]);
		   // $orgId = empty($org) ? 0 : $org->id;
			$billing->org_id = $fixedOrgId;
			$billing->billing_ref = $this->no;
			$billing->item_code = $type;
			$billing->link_id = $this->id;
			$billing->currency = 1;
			$billing->dpt_id = Org::PCAE_DEPARTMENT_SYDNEY;
			$billing->dpmt = Invoice::DPMT_EXPORT;
			$billing->type = BillingLine::BILLING_TYPE_EXPORT;
			$billing->desc = $desc;
			$billing->gst = 'EXEMPTEXPENSES';
			$billing->price = 0;
			$billing->qty = 1;
			// get related supplier cost gl code
			$billing->charge_code = '91002';
			$billing->op_id =  isset(Yii::app()->user) ? Yii::app()->user->id : 0;
		}
		$billing->org_id = $fixedOrgId;
		$billing->accrual_amount = number_format(0.135  * $totWeight, 2,'.','');
		$billing->save();
		$exc += $billing->accrual_amount;

		// for air freight fee
		$type = 'GL1'; // for air freight fee
		$billing = BillingLine::model()->find('billing_ref = :bref AND item_code = :type AND link_id = :lid',[
			':bref' => $this->no,':type' => $type, ':lid' => $this->id
		]);
		if ( empty($billing) ) {
			$citemType = ChargeItemType::model()->find('code = :type' , [':type' => $type]);
			$desc = empty($citemType) ? '' : $citemType->name;
			$billing = new BillingLine();
		   // $org = Org::model()->find('code = :code',[':code' => $this->poc]);
		 //   $orgId = empty($org) ? 0 : $org->id;
			$billing->org_id = $fixedOrgId;
			$billing->billing_ref = $this->no;
			$billing->item_code = $type;
			$billing->link_id = $this->id;
			$billing->currency = 1;
			$billing->dpt_id = Org::PCAE_DEPARTMENT_SYDNEY;
			$billing->dpmt = Invoice::DPMT_EXPORT;
			$billing->type = BillingLine::BILLING_TYPE_EXPORT;
			$billing->desc = $desc;
			$billing->gst = 'EXEMPTEXPENSES';
			$billing->price = 0;
			$billing->qty = 1;
			// get related supplier cost gl code
			$billing->charge_code = '91002';
			$billing->op_id =  isset(Yii::app()->user) ? Yii::app()->user->id : 0;
		}
		$rateTag = 'af_'. $this->pol . '_' .$this->pod;
		$rate = 0;
		if ( isset(Yii::app()->params['settings'][$rateTag]['value']) ) {
			$rate = Yii::app()->params['settings'][$rateTag]['value'];
		}
		$billing->org_id = $fixedOrgId;
		$billing->accrual_amount = number_format($rate  * $totWeight,2,'.','') - $exc;
		$billing->save();

	}


	/**
	 * @param $amount
	 */
	public function saveAccrualClearanceCostAmount($amount){
		$this->saveAccrualCostAmount('channel_clear_cost',$amount);
	}

	/**
	 * @param $amount
	 */
	public function saveAccrualDeliveryCostAmount($amount){
		$this->saveAccrualCostAmount('channel_delivery_cost',$amount);
	}

	/**
	 * @param $amount
	 */
	public function saveAccrualDutyCostAmount($amount){
		$this->saveAccrualCostAmount('channel_duty_cost',$amount);
	}

	/**
	 * @param $amount
	 */
	public function saveAccrualOthersCostAmount($amount){
		$this->saveAccrualCostAmount('channel_others_cost',$amount);
	}

	private function saveAccrualCostAmount($type, $amount){
		// try to find old one
		$billing = BillingLine::model()->find('billing_ref = :bref AND item_code = :type AND link_id = :lid',[
		   ':bref' => $this->no,':type' => $type, ':lid' => $this->id
		]);
		if ( empty($billing) ) {
			$billing = new BillingLine();
			$org = Org::model()->find('code = :code',[':code' => $this->poc]);
			$orgId = empty($org) ? 0 : $org->id;
			$billing->org_id = $orgId;
			$billing->billing_ref = $this->no;
			$billing->item_code = $type;
			$billing->link_id = $this->id;
			$billing->currency = 1;
			$billing->dpt_id = Org::PCAE_DEPARTMENT_SYDNEY;
			$billing->dpmt = Invoice::DPMT_EXPORT;
			$billing->type = BillingLine::BILLING_TYPE_EXPORT;
			$billing->desc = $type;
			$billing->gst = 'EXEMPTEXPENSES';
			$billing->price = 0;
			$billing->qty = 1;
			// get related supplier cost gl code
			$billing->charge_code = '91002';
			$billing->op_id =  isset(Yii::app()->user) ? Yii::app()->user->id : 0;
		}
		$billing->accrual_amount = $amount;
		$billing->save();
	}

	public function genNo(){
		$ndf = date('ymd');
		$sn = self::model()->count('no LIKE :n', array(':n' => 'EP'.$ndf.'%')) + 1;
		return 'EP'.$ndf.sprintf('%02s', $sn).ExChannel::getSuffix($this->poc);
	}

