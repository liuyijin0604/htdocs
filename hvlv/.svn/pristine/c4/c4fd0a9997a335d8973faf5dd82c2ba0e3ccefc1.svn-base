						if (confirm('Are you sure to paperwork done?')) {
							$.get('<?= $this->createUrl("cargoProcess/paperworkDone") . "?id=" . $id ?>', function(r) {
								if (r == 'done') {
									myApp.notice('Done', 5000);
								} else {
									myApp.alert(r, false);
								}
								tab.trigger('reload_cargo_process_grid');
							});

						}
