					});

					$('.assign_driver_done', win).on('click', function() {
						if (confirm('Are you sure to Assign Driver Done')) {
							$.get('<?= $this->createUrl("cargoProcess/assignDriverDone") . "?id=" . $id ?>', function(r) {
								if (r == 'done') {
