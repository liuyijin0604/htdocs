						if (confirm('Are you sure to Generate Gate Pass?')) {
							$.get('<?= $this->createUrl("gatepass/generateCargoProcessGatePass") . "?id=" . $id ?>', function(r) {
								r = JSON.parse(r);
								if (r.done == true) {
									window.open("<?= $this->createUrl("cargoProcess/printGatePass") ?>" + "?id=" + r.id, "_blank");
