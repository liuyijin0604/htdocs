<?php

class MQCommand extends CConsoleCommand
{
	private $db;
	private $args;
	private $debug = false;
	public $ts;
	public $day;
	public $hr;
	public $mn;

	public function run($args)
	{
		Yii::app()->name = 'TLA';
		$this->db = Yii::app()->getDb();
		$this->args = $args;
		$this->ts = time();
		$this->day = date('N');
		$this->hr = date('G');
		$this->mn = intval(date('i'));
		Yii::app()->request->hostInfo = 'https://os.toplogistics.com.au';
		
		if (empty($this->mn)) {
			$this->mn = 0;
		}

		foreach ($this->args as $ag) {
			if ($ag == '-d') {
				$this->debug = true;
			}
		}

		if (!empty($args[0]) && method_exists($this, $args[0])) {
			$this->{$args[0]}();
		} else {
			set_error_handler(function($errno, $errstr, $errfile, $errline, $errcontext) {
				if (!(error_reporting() & $errno)) return false;
				throw new ErrorException($errstr, 0, $errno, $errfile, $errline);
			});
			try{
			// if ($this->mn % 25 == 0) {
			// 	$this->log('Start checkMultiID');
			// 	$this->checkMultiID();
			// 	$this->openChaseIdTickets();
			// 	$this->closeIdTickets();
			// 	$this->log('Finish checkMultiID');
			// }

			// if ($this->mn % 25 == 0) {
			// 	$this->log('Start fix0wt');
			// 	$this->fix0wt();
			// 	$this->log('Finish fix0wt');
			// }

			// currently send UBM by checking status: DCLALLOWED return by CARST command
			// so don't call this function now

			// //call TLA cron
			$this->tlaMQ();

			} catch( Exception $e) {
				$trace = $e->getTrace();
				Emailog::sendEmailTo('dev@toplogistics.com.au', $e->getCode().PHP_EOL.$e->getMessage().PHP_EOL.print_r($trace, true)," MQ error");
			}
		}
	}


	public function tlaMQ(){
		//set app name
		[$app_name, Yii::app()->name] = [Yii::app()->name, 'TLA'];
		
		if ($this->mn % 5 == 0) {
			$this->log('Start sequenceHandlingGatepassSubmition');
			$this->sequenceHandlingGatepassSubmition();
			$this->log('Finish sequenceHandlingGatepassSubmition');
			
			$this->log('Start cacheEmailDetailsEvery5Minutes');
			$this->cacheEmailDetailsEvery5Minutes();
			$this->log('Finish cacheEmailDetailsEvery5Minutes');

			$this->log('Start cacheTaskDashEvery5Minutes');
			$this->cacheTaskDashEvery5Minutes();
			$this->log('Finish cacheTaskDashEvery5Minutes');

			$this->log('Start cacheWarehouseProcessEvery5Minutes');
			$this->cacheWarehouseProcessEvery5Minutes();
			$this->log('Finish cacheWarehouseProcessEvery5Minutes');

			$this->log('Start checkScheduledTlaTask');
			$this->checkScheduledTlaTask();
			$this->log('Finish checkScheduledTlaTask');
			
		}

		if ($this->mn % 2 == 0) {
			$this->log('Start custom process cache');
			$this->customProcessCache();
			$this->log('Finish custom process cache');
		}

		if ($this->mn % 5 == 0) {
			$this->log('Start pushHeldShipmentsToCustomProcess');
			$this->pushHeldShipmentsToCustomProcess();
			$this->log('Finish pushHeldShipmentsToCustomProcess');

			$this->log('Start processingMqProcess');
			$this->processingMqProcess();
			$this->log('Finish processingMqProcess');
		}
		

		if ($this->mn % 30 == 0) {
			$this->log('Start fixBagScanData');
			$this->fixBagScanData();
			$this->log('Finish fixBagScanData');

			// $this->log('Start pushingAllScanedConsolToAoutAndManifest');
			// $this->pushingAllScanedConsolToAoutAndManifest();
			// $this->log('Finish pushingAllScanedConsolToAoutAndManifest');

			$this->log('Start deleteDuplicateCustomProcess');
			$this->deleteDuplicateCustomProcess();
			$this->log('Finish deleteDuplicateCustomProcess');

			
		}

		if ($this->mn % 5 == 0) {
			$this->log('Start pushingAllScanedConsolToAoutAndManifest');
			$this->pushingAllScanedConsolToAoutAndManifest();
			$this->log('Finish pushingAllScanedConsolToAoutAndManifest');
		}

		$this->cargoProcessHandler();

		$this->taskHandler();

		if (($this->hr == 23 && $this->mn == 30)) {
			$this->log('Start pushDirectConsolIntoConsolProcessForInvoice');
			$this->pushDirectConsolIntoConsolProcessForInvoice();
			$this->log('Finish pushDirectConsolIntoConsolProcessForInvoice');

			$this->log('calculateMTDEveryDay');
			$this->calculateMTDEveryDay();
			$this->log('calculateMTDEveryDay');


			$this->log('handlingCheckingShipmentToBeInspection');
			//$this->handlingCheckingShipmentToBeInspection();
			$this->log('handlingCheckingShipmentToBeInspection');
		}

		if (($this->hr == 23 && $this->mn == 50)) {

			$this->log('cacheKpiReportMonthly');
			$this->cacheKpiReportMonthly();
			$this->log('cacheKpiReportMonthly');
		}

		if($this->hr == 1 && $this->mn == 20)
		{
			$this->log('Start generateConsolProcessWaitingInvoiceInvoice');
			$this->generateConsolProcessWaitingInvoiceInvoice();
			$this->log('End generateConsolProcessWaitingInvoiceInvoice');
		}


		if($this->hr == 3 && $this->mn == 50)
		{
			$this->log('Start generateConsolProcessWaitingInvoiceInvoice');
			$this->generateConsolProcessWaitingInvoiceInvoice();
			$this->log('End generateConsolProcessWaitingInvoiceInvoice');
		}


		if($this->hr == 7 && $this->mn == 00)
		{
			$this->log('Start generateConsolProcessWaitingInvoiceInvoice');
			$this->generateConsolProcessWaitingInvoiceInvoice();
			$this->log('End generateConsolProcessWaitingInvoiceInvoice');
		}

		if($this->mn%10==0 && $this->hr > 8 && $this->hr < 18)
		{
			$this->log('refreshGatepassSignSummary');
			$this->refreshGatepassSignSummary();
			$this->log('refreshGatepassSignSummary');
		}

		Yii::app()->name = $app_name;
	}
	
	public function cargoProcessHandler()
	{
		if ($this->mn % 10 == 0) {
			$this->log('Start sequenceHandlingGatepassSubmition');
			$this->puttingAllPickupCargoprocessWithGPToDeliveried();
			$this->log('Finish sequenceHandlingGatepassSubmition');
		}
	}

	public function taskHandler()
	{
		if ($this->hr == 12 && $this->mn % 50 == 0) {
			$this->log('Start cleanClosedEmailTask');
			$this->cleanClosedEmailTask();
			$this->log('Finish cleanClosedEmailTask');
		}
	}


	public function sequenceHandlingGatepassSubmition()
	{
		Yii::app()->name = "TLA";
		$allMQCourierSubmit = GatepassCourier::model()->findAll("json_value(meta,'$.isMQ') is not null and json_value(meta,'$.isMQ_handle') is null");
		$handleSubmit = null;
		foreach ($allMQCourierSubmit as $key => $submit)
		{
			$status = $this->checkMQProcessing('MQCourerSubmit'.$submit->mdata['ocourier_id']);
			if(!empty($status))
			{
				echo "processing";
				continue;
			}
			$handleSubmit = $submit;
			break;
		}

		if(!empty($handleSubmit))
		{
			$this->setMQProcessing('MQCourerSubmit'.$handleSubmit->mdata['ocourier_id'],3600);
			$postData = json_decode($handleSubmit->mdata['postData'],true);
			$gatepassService = new GatepassService();
			$result = $gatepassService->handlingGatepassSubmit($postData,$handleSubmit);
			if($result['status']==0)
			{
				print_r($result);
				Emailog::sendEmailTo('dev@toplogistics.com.au', json_encode($result),$handleSubmit->id." gatepass MQ error");
			}

			$handleSubmit->mdata['isMQ_handle'] = 1;
			$handleSubmit->save();
			$this->deleteMQProcessing('MQCourerSubmit'.$handleSubmit->mdata['ocourier_id']);
		}
	}

	public function customProcessCache()
	{
		function funcCustomProcessCache()
		{
			$tableTwoInfo = [];
			$sql = 'SELECT COUNT(*) as number, user_id, type FROM `process_log` WHERE time<=SUBDATE(CURDATE(),INTERVAL -1080 MINUTE) AND time>=SUBDATE(CURDATE(),INTERVAL 360 MINUTE) AND status=1 GROUP BY user_id,type';
			$open_info = Yii::app()->db->createCommand($sql)->queryAll();
			foreach ($open_info as $oneOpenInfo) {
				$tableTwoInfo[$oneOpenInfo['user_id']][$oneOpenInfo['type']] = ['type' => $oneOpenInfo['type'], 'open' => $oneOpenInfo['number'], 'close' => 0, 'total' => 0, 'close_avg' => 0, 'close_avg_percent' => 0];
			}
			$sql = 'SELECT COUNT(*) as number,p.type,p.user_id FROM `shipment_process` t INNER JOIN `process_log` p ON t.id=p.fid  WHERE date<=SUBDATE(CURDATE(),INTERVAL -1080 MINUTE) AND date>=SUBDATE(CURDATE(),INTERVAL 360 MINUTE) AND t.status=24 GROUP by p.type,p.user_id';
			$close_info = Yii::app()->db->createCommand($sql)->queryAll();
			foreach ($close_info as $oneCloseInfo) {
				$tableTwoInfo[$oneCloseInfo['user_id']][$oneCloseInfo['type']]['close'] = $oneCloseInfo['number'];
			}
			$sql = "SELECT count(*) as number, p.user_id,p.type FROM `shipment_process` t INNER JOIN `process_log` p ON t.id=p.fid WHERE t.status<24 AND p.status=1 GROUP by p.user_id , p.type";
			$totalHeldInfo = Yii::app()->db->createCommand($sql)->queryAll();
			$totalHelshipments = 0;
			foreach ($totalHeldInfo as $oneHeldInfo) {
				$totalHelshipments += intval($oneHeldInfo['number']);
				$tableTwoInfo[$oneHeldInfo['user_id']][$oneHeldInfo['type']]['total'] = $oneHeldInfo['number'];
			}

			$sql = 'SELECT MAX(number) FROM (SELECT COUNT(*)/DAY(LAST_DAY(`date`)) * 1.4 as number FROM `shipment_process` WHERE type&4>0 AND status=24 AND `date` > DATE_SUB(DATE_FORMAT(NOW() ,"%Y-%m-01"), INTERVAL 6 MONTH) GROUP BY MONTH(`date`) LIMIT 6) t';
			${'4' . 'close_avg'} = 12;
			ceil(Yii::app()->db->createCommand($sql)->queryScalar());
			$sql = 'SELECT MAX(number) FROM (SELECT COUNT(*)/DAY(LAST_DAY(`date`)) * 1.4 as number FROM `shipment_process` WHERE type&1>0 AND status=24 AND `date` > DATE_SUB(DATE_FORMAT(NOW() ,"%Y-%m-01"), INTERVAL 6 MONTH) GROUP BY MONTH(`date`) LIMIT 6) t';
			${'1' . 'close_avg'} = 3; //ceil(Yii::app()->db->createCommand($sql)->queryScalar());
			$sql = 'SELECT MAX(number) FROM (SELECT COUNT(*)/DAY(LAST_DAY(`date`)) * 1.4 as number FROM `shipment_process` WHERE type&2>0 AND status=24 AND `date` > DATE_SUB(DATE_FORMAT(NOW() ,"%Y-%m-01"), INTERVAL 6 MONTH) GROUP BY MONTH(`date`) LIMIT 6) t';
			${'2' . 'close_avg'} = 3; //ceil(Yii::app()->db->createCommand($sql)->queryScalar());
			$sql = 'SELECT MAX(number) FROM (SELECT COUNT(*)/DAY(LAST_DAY(`date`)) * 1.4 as number FROM `shipment_process` WHERE type&8>0 AND status=24 AND `date` > DATE_SUB(DATE_FORMAT(NOW() ,"%Y-%m-01"), INTERVAL 6 MONTH) GROUP BY MONTH(`date`) LIMIT 6) t';
			${'8' . 'close_avg'} = ceil(Yii::app()->db->createCommand($sql)->queryScalar());
			${'16' . 'close_avg'} = ceil(Yii::app()->db->createCommand($sql)->queryScalar());
			$sql = 'SELECT COUNT(*) FROM `consol` t INNER JOIN `shipment` s ON t.id=s.consol_id WHERE t.eta>=SUBDATE(CURDATE(),INTERVAL 29 DAY) AND t.eta<=CURDATE()';
			$totalShipment = Yii::app()->db->createCommand($sql)->queryScalar();
			$totalShipment = ceil($totalShipment / 30);

			foreach ($tableTwoInfo as $user_id => $typeInfo) {
				foreach (ShipmentProcess::$the_types as $key => $name) {
					if (key_exists($key, $typeInfo)) {
						$tableTwoInfo[$user_id][$key]['close_avg'] = ${$key . 'close_avg'};
						$tableTwoInfo[$user_id][$key]['close_avg_percent'] = (${$key . 'close_avg'} > 0 ? number_format(@intval($tableTwoInfo[$user_id][$key]['close']) / ${$key . 'close_avg'} * 100, 2, '.', '') : 0);
						$tableTwoInfo[$user_id][$key]['totalPercent'] = ($totalShipment > 0 ? number_format(@$tableTwoInfo[$user_id][$key]['total'] / $totalShipment * 100, 2, '.', '') : 0);
						$tableTwoInfo[$user_id][$key]['percent'] = ($totalHelshipments > 0 ? number_format(@$tableTwoInfo[$user_id][$key]['total'] / $totalHelshipments * 100, 2, '.', '') : 0);
					}
				}
			}
			$info = ['tableTwoInfo' => $tableTwoInfo, 'totalShipment' => $totalShipment];
			Service::setCacheData('CustomProcessInfo',$info,86400);
		}
		$this->funcDoMQ('funcCustomProcessCache','funcCustomProcessCache');
	}


	public function puttingAllPickupCargoprocessWithGPToDeliveried()
	{
		function mqgpca()
		{
			$gatepassCouriers = GatepassCourier::model()->findAll("json_value(meta,'$.is_tp') is not null and json_value(meta,'$.is_tp') ='TP' and json_value(meta,'$.isMQ_handle') is null and create_time>'2022-02-01'");
			$fids = [];
			foreach ($gatepassCouriers as $key => $gc) {
				foreach ($gc->lines as $key => $line) {
					$fids[$line->fid] = $line->fid;
				}
			}
			$cargoProcesses = CargoProcess::model()->findAll('type = :type and status<100 and shipment_id in ("'.join('","',$fids).'")',[":type"=>CargoProcess::PICKUP_CARGO]);
			foreach ($cargoProcesses as $key => $ca)
			{
				$ca->processDone();
			}
			foreach ($gatepassCouriers as $key => $gc) {
				$gc->mdata['isMQ_handle'] =1;
				$gc->save();
			}
		}
		$this->funcDoMQ('MQGPCA_PICKUP','mqgpca');
	}

	public function cleanClosedEmailTask()
	{
		function cleanEmailTask()
		{
			$emailTasks = EmailTask::model()->findAll('t.type=10 and status <100');
			foreach ($emailTasks as $key => $emailTask) {
				if(!empty($emailTask->getLinkObj())&&$emailTask->getLinkObj()->status==ImportsMail::STATE_CLOSED)
				{
					$emailTask->status = TlaTask::CLOSE;
					$emailTask->save();
				}
			}
		}

		$this->funcDoMQ('cleanEmailTask','cleanEmailTask');
	}


	public function pushDirectConsolIntoConsolProcessForInvoice()
	{
		function functionPushDirectConsolIntoConsolProcessForInvoice()
		{
			$consols = ImcoConsol::model()->with('process')->findAll("t.awb like 'Direct%' and process.id is null and t.eta >='2021-01-01'");
			foreach ($consols as $key => $consol)
			{
				$consol->newConsolProcess(ConsolProcess::STATE_WAITING_CREATE_INVOICE);
			}
		}

		$this->funcDoMQ('functionPushDirectConsolIntoConsolProcessForInvoice','functionPushDirectConsolIntoConsolProcessForInvoice');
	}

