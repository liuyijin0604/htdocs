				$report = new ReportController('default');
				$report->actionAjaxExportPlGroupReport();
				break;
			
			default:
				# code...
				break;
		}

	}

	public function generateConsolProcessWaitingInvoiceInvoice()
	{
		function funcGenerateConsolProcessWaitingInvoiceInvoice()
		{
			$model=new Consol('search');
			$model->unsetAttributes();
			$model->isBackend = true;
			$model->process_statuses=[ConsolProcess::STATE_WAITING_CREATE_INVOICE];
			$allConsols = $model->search(false)->data;
			foreach ($allConsols as $key => $consol)
			{
				$consol->refresh();
				$ids = [];
				if(!empty($consol->type==Consol::IMCOCONSOLTYPE))
				{
					$ids = array_column($consol->getOrgsInfo(),'id');
				}

				$invoices = Invoice::model()->count("consol_id = :consolId and status not in (8,10,99) ",[":consolId"=>$consol->id]);
				if($invoices>0&&in_array(4018,$ids))
				{
					$consol->process->status = ConsolProcess::STATE_CONSOL_PROCESS_DONE;
					$consol->process->update(['status']);
					continue;
				}

				if(empty($consol->mdata['isAutoGen']))
				{
					if($consol->type==Consol::IMCOCONSOLTYPE)
					{
						$msgs = $consol->genSpecialInvoice(false,false,[],false);
						$checkMsg = join(',',$msgs);
						if(preg_match('/create/i',$checkMsg))
						{
							$consol->mdata['isAutoGen'] = 1;
							$consol->save();
						}else
						{
							if($checkMsg!='Total Amount is 0')
							{
								Emailog::sendEmailTo('gero@toplogistics.com.au', json_encode($consol->no.":".$checkMsg),$consol->no." auto generate consol invoice error");
							}
						}
					}

				}else
				{
					if(empty($consol->process->mdata['process_note'])&&empty($consol->mdata['cfs_address']))
					{
						$consol->process->status = ConsolProcess::STATE_CONSOL_PROCESS_DONE;
						$consol->process->update(['status']);
					}
				}
			}
		}
		$this->funcDoMQ('funcGenerateConsolProcessWaitingInvoiceInvoice','funcGenerateConsolProcessWaitingInvoiceInvoice',7200);
	}


	public function funcDoMQ($key,$func,$time = 3600)
	{
		$status = $this->checkMQProcessing($key);
		if(!empty($status))
		{
			echo "processing";
			return;
		}

		$this->setMQProcessing($key,$time);

		$func();

		$this->deleteMQProcessing($key);
	}

	private function checkMQProcessing($key)
	{
		$mqRecord = Yii::app()->cache->get('MQRecord:'.$key);
		if(!empty($mqRecord))
		{
			echo "xxxxxx";
			return 1;
		}
		return 0;
	}

	private function setMQProcessing($key,$expired=null)
	{
		if(!empty($expired))
		{
			$mqRecord = Yii::app()->cache->set('MQRecord:'.$key,'MQRecord:'.$key,$expired);
		}else
		{
			$mqRecord = Yii::app()->cache->set('MQRecord'.$key,'MQRecord:'.$key);
		}
		return 1;
	}

	private function deleteMQProcessing($key)
	{
		$this->setMQProcessing($key,1);
		return 1;
	}

	public function deleteMQProcessingGo()
	{
		$key = $this->prompt("MQKey");
		$this->setMQProcessing($key,1);
		return 1;
	}

	public function log($m)
	{
		$lf = Yii::app()->basePath.DIRECTORY_SEPARATOR.'runtime'.DIRECTORY_SEPARATOR.'MQ_cmd.log';
		@file_put_contents($lf, date('Y-m-d H:i:s').' '.$m." " . Yii::app()->name . "\n", FILE_APPEND);
	}
}
