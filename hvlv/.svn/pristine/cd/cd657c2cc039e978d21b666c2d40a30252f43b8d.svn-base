	public function fixZeroValueInvoice()
	{
		Yii::app()->name = "TLA";
		$invoices = Invoice::model()->findAll('total = 0 and status in (1,2,3)');
		foreach ($invoices as $key => $invoice) {
			$invoice->getTotal();
			$invoice->save();
		}
	}

	public function fixBagScanData()
	{
		Yii::import('application.modules.whscan.controllers.ShipmentController');
		$cc = new ShipmentController('default');
		$sql = 'SELECT t.id,pid,warehouse,user_id from `shipment_scan` t left join `shipment_scan_process` s on t.id = s.shipment_scan_id where type =5 and scan_time>"'.date('Y-m-d').'" and (s.process=0 or s.process is null)';
		$pids = $this->db->createCommand($sql)->queryAll();
		foreach ($pids as $key => $value) {

			$bagTagCount = ImportBagTag::model()->with('imParcel')->count(["condition"=>"import_bag_id = :import_bag_id and (json_value(imParcel.meta,'$.scan_time') is not null and imParcel.scan_no<imParcel.pkg) ","params"=>[":import_bag_id"=>$value["pid"]],"order"=>'id desc']);
			if($bagTagCount>0)
			{
				$shipmentScanProcess = ShipmentScanProcess::model()->find("shipment_scan_id = ".$value["id"]);
				if(empty($shipmentScanProcess))
				{
					$shipmentScanProcess = new ShipmentScanProcess();
					$shipmentScanProcess->shipment_scan_id = $value["id"];
				}
				$shipmentScanProcess->process = 1;
				$shipmentScanProcess->save();
				continue;
			}

			$importBag = ImportBag::model()->findByPk($value["pid"]);
			$_GET['op']='checkin';
			$_POST['sound'] = "";
			$_POST['location'] = "";
			$_POST['search_container_no'] = "";
			$_POST['barcode'] = $importBag->bag_tag;
			$_POST['tempWarehouse'] = $value["warehouse"];
			$_POST['backend_commend_MQbag'] = 1;
			$cc->actionScan();
			$shipmentScanProcess = ShipmentScanProcess::model()->find("shipment_scan_id = ".$value["id"]);
			if(empty($shipmentScanProcess))
			{
				$shipmentScanProcess = new ShipmentScanProcess();
				$shipmentScanProcess->shipment_scan_id = $value["id"];
			}
			$shipmentScanProcess->process = 1;
			$shipmentScanProcess->save();
		}
	}


	public function checkScheduledTlaTask()
	{
		function funcCheckScheduledTlaTask()
		{
			$tlaTaskService = new TlaTaskService();
			$tlaTaskAll = TlaTask::model()->findAll("status = :status and ((json_value(meta,'$.next_generate_date') is null and ((json_value(meta,'$.reoccuring_start_date') is not null and json_value(meta,'$.reoccuring_start_date')<=:date) or (json_value(meta,'$.reoccuring_start_date') is null and json_value(meta,'$.reoccuring_run') >0))) or json_value(meta,'$.next_generate_date') = :date)",[":status"=>TlaTask::SCHEDULED,':date'=>date("Y-m-d")]);
			foreach ($tlaTaskAll as $key => $tlaTask) {
				$reoccuring = $tlaTask['mdata']['reoccuring'];
				$startDate = !empty($tlaTask->mdata['next_generate_date'])?$tlaTask->mdata['next_generate_date']:date("Y-m-d");

				if(!empty($tlaTask->mdata['reoccuring_start_date']))
				{
					if(strtotime($tlaTask->mdata['reoccuring_start_date'])>strtotime(date('Y-m-d')))
					{
						continue;
					}

				}else
				{
					$tlaTask->mdata['reoccuring_run'] -= 1;

				}

				$ete = $startDate;
				for ($i=0; $i < $tlaTask['mdata']['reoccuring_deadline_days']; $i++) {
					$ete = HolidayHelper::getNextWeekday($ete,'AUSYD');
				}
				
				$ete = $ete." 18:00:00";

				$meta = ["agent_id"=>"".@$tlaTask->mdata["agent_id"]];
				$createdTask= $tlaTaskService->createNewTlaTask($tlaTask->type,"",'',0,$tlaTask->dpt_id,$tlaTask->user_id,$tlaTask->comment,$meta,[],@$tlaTask->mdata['assigned_user'],$ete);

				$fr = new FileRepo('search');
				$fr->unsetAttributes();
				$fr->theTypes[] = FileRepo::TLATASKFILETYPE;
				$fr->fid = $tlaTask->id;
				$files = $fr->search(false)->data;
				foreach ($files as $key => $file) {
					$newFile = new FileRepo();
					$newFile->name = $file->name;
					$newFile->hash = $file->hash;
					$newFile->mime = $file->mime;
					$newFile->size = $file->size;
					$newFile->date = $file->date;
					$newFile->meta = $file->meta;
					$newFile->status = $file->status;
					$newFile->type = $file->type;
					$newFile->fid = $file->fid;
					$newFile->org_id = $file->org_id;
					$newFile->user_id = $file->user_id;
					$newFile->save();
				}

				$nextGenerateDate = "";
				switch ($reoccuring) {
					case TlaTask::WEEKLY:
						$nextGenerateDate = HolidayHelper::next_weeks($startDate);
						break;
					case TlaTask::MONTHLY:
						$nextGenerateDate = HolidayHelper::next_months($startDate);
						break;
					case TlaTask::FORTNIGHTLY:
						$nextGenerateDate = HolidayHelper::next_fortnight($startDate);
						break;
					case TlaTask::DAILY:
						$nextGenerateDate = HolidayHelper::getNextWeekday($startDate,'AUD');
						break;
					
					default:
						# code...
						break;
				}
				$tlaTask->mdata['next_generate_date'] = $nextGenerateDate;

				if(!empty($tlaTask->mdata['reoccuring_start_date']))
				{
					if(strtotime($nextGenerateDate)>strtotime($tlaTask->mdata['reoccuring_end_date']))
					{
						$tlaTask->mdata['next_generate_date'] = "";
					}
					
				}else
				{
					if($tlaTask->mdata['reoccuring_run']==0)
					{
						$tlaTask->mdata['next_generate_date'] = "";
					}
				}

				$tlaTask->save();
			}
		}
		// funcCheckScheduledTlaTask();
		$this->funcDoMQ('funcCheckScheduledTlaTask','funcCheckScheduledTlaTask');
	}

	/* pushEmppToCustomProcess()  is used to check if there are some EMPP,AQIS,Other SHIPMENT NOT go to the Custom Process,
	* if not, create ShipmentProcess and set a flag cbwf|128 to the Shipment
	* ShipmentProcess Params @type =1
	*
	*/
	public function pushHeldShipmentsToCustomProcess()
	{
		function funcPushHeldShipmentsToCustomProcess()
		{
			$sql="SELECT id FROM `shipment` WHERE type=10 AND (bwf&512)>0 AND (cbwf&128)=0";
			$rs=Yii::app()->db->createCommand($sql)->queryAll();
			foreach ($rs as $r) {
				$process= ShipmentProcess::model()->find('pid=:pid', [':pid'=>$r['id']]);
				$shipment= ImParcel::model()->findByPk($r['id']);
				if (empty($process)) {
					$shipment->newShipmentProcess(ShipmentProcess::MSG_NEW, ShipmentProcess::TYPE_EMPP);
				}
				$shipment->cbwf=$shipment->cbwf|128;
				$shipment->update('cbwf');
			}
			$sql="SELECT id FROM `shipment` WHERE type=10 AND (bwf&32)>0 AND (cbwf&128)=0";   //push aquis
			$rs=Yii::app()->db->createCommand($sql)->queryAll();
			foreach ($rs as $r) {
				$process= ShipmentProcess::model()->find('pid=:pid', [':pid'=>$r['id']]);
				$shipment= ImParcel::model()->findByPk($r['id']);
				if (empty($process)) {
					$shipment->newShipmentProcess(ShipmentProcess::MSG_NEW, ShipmentProcess::TYPE_AQIS);
				}
				$shipment->cbwf=$shipment->cbwf|128;
				$shipment->update('cbwf');

			}

			$sql="SELECT id FROM `shipment` WHERE type=10 AND (bwf&4)>0 AND (cbwf&128)=0";   //push high value
			$rs=Yii::app()->db->createCommand($sql)->queryAll();
			foreach ($rs as $r) {
				$process= ShipmentProcess::model()->find('pid=:pid', [':pid'=>$r['id']]);
				$shipment= ImParcel::model()->findByPk($r['id']);
				if (empty($process)) {
					$shipment->newShipmentProcess(ShipmentProcess::MSG_NEW, ShipmentProcess::TYPE_HV);
				}
				$shipment->refresh();
				$shipment->cbwf=$shipment->cbwf|128;
				$shipment->update('cbwf');
				
			}

			$sql="SELECT id FROM `shipment` WHERE type=10 AND (bwf&8)>0 AND (cbwf&128)=0";   //push aquis
			$rs=Yii::app()->db->createCommand($sql)->queryAll();
			foreach ($rs as $r) {
				$process= ShipmentProcess::model()->find('pid=:pid', [':pid'=>$r['id']]);
				$shipment= ImParcel::model()->findByPk($r['id']);
				if (empty($process)) {
					echo "xxxx";
					$shipment->newShipmentProcess(ShipmentProcess::MSG_NEW, ShipmentProcess::TYPE_SAC);
				}
				$shipment->cbwf=$shipment->cbwf|128;
				$shipment->update('cbwf');
			}

			$sql="SELECT id from `shipment` WHERE type=10 AND ((status=55 OR (status>=50 AND (bwf&1024)>0)) AND ((bwf&4)=0 AND (bwf&32)=0 AND (bwf&512)=0 AND (bwf&8)=0)) AND (cbwf&128)=0";
			$rs=Yii::app()->db->createCommand($sql)->queryAll();
			foreach ($rs as $r)
			{
				$shipment=ImParcel::model()->findByPk($r['id']);
				$time=$shipment->getHeldTrackingTime();
				if ((!empty($time)&&(time()- strtotime($time))>86400*7)||($shipment->bwf&ImParcel::BWF_HELD_OTHER)>0) {
					$process= ShipmentProcess::model()->find('pid=:pid', [':pid'=>$r['id']]);
					if (empty($process)) {
						$shipment->newShipmentProcess(ShipmentProcess::MSG_NEW, ShipmentProcess::TYPE_OTHER);
					}
					$shipment->cbwf=$shipment->cbwf|128;
					$shipment->bwf=$shipment->bwf| ImParcel::BWF_HELD_OTHER;
					$shipment->update(['cbwf','bwf']);
				}
			}

			$sql = 'SELECT id FROM `shipment` WHERE type = 10 AND status = 55 AND cbwf & 128 = 0';
			foreach ($rs as $r)
			{
				$shipment = ImParcel::model()->findByPk($r['id']);
				$flag = $shipment->exceedScreenPeriod();
				if ($flag) {
					$process = ShipmentProcess::model()->find('pid = :pid', [':pid' => $r['id']]);
					if (empty($process)) {
						$shipment->newShipmentProcess(ShipmentProcess::MSG_NEW, ShipmentProcess::TYPE_OTHER);
					}
					$shipment->cbwf = $shipment->cbwf | 128;
					$shipment->bwf = $shipment->bwf | ImParcel::BWF_HELD_OTHER;
					$shipment->mdata['screen_period_exceed'] = true;
					$shipment->update(['cbwf', 'bwf', 'meta']);
				}
			}
		}

		$this->funcDoMQ('funcPushHeldShipmentsToCustomProcess','funcPushHeldShipmentsToCustomProcess');
	}

	public function deleteDuplicateCustomProcess()
	{
		$model = new ImParcel('search');
		$model->unsetAttributes();
		if (isset($_GET['ImParcel'])) {
			$model->setAttributes($_GET['ImParcel']);
		}
		$model->process_status = 4;
		$allImParcels = $model->search(false, 30,false,true,false,true)->data;
		foreach ($allImParcels as $key => $model)
		{
			$processesNotWaitingConfirm = ShipmentProcess::model()->count("pid = :pid and status!=4",[":pid"=>$model->id]);
			if($processesNotWaitingConfirm>0)
			{
				$duplicatedWaitingConfirmProcess = ShipmentProcess::model()->find("pid = :pid and status=4",[":pid"=>$model->id]);
				$duplicatedWaitingConfirmProcess->delete();
			}
		}

		$model = new ImParcel('search');
		$model->unsetAttributes();
		if (isset($_GET['ImParcel'])) {
			$model->setAttributes($_GET['ImParcel']);
		}
		$model->process_status = 1;
		$allImParcels = $model->search(false, 30,false,true,false,true)->data;
		foreach ($allImParcels as $key => $model)
		{
			$processesNotWaitingConfirm = ShipmentProcess::model()->count("pid = :pid and status!=1",[":pid"=>$model->id]);
			if($processesNotWaitingConfirm>0)
			{
				$duplicatedWaitingConfirmProcess = ShipmentProcess::model()->find("pid = :pid and status=1",[":pid"=>$model->id]);
				$duplicatedWaitingConfirmProcess->delete();
			}
		}

		$model = new ImParcel('search');
		$model->unsetAttributes();
		if (isset($_GET['ImParcel'])) {
			$model->setAttributes($_GET['ImParcel']);
		}
		$model->process_status = 2;
		$allImParcels = $model->search(false, 30,false,true,false,true)->data;
		foreach ($allImParcels as $key => $model)
		{
			$processesNotWaitingConfirm = ShipmentProcess::model()->count("pid = :pid and status=24",[":pid"=>$model->id]);
			if($processesNotWaitingConfirm>0)
			{
				$duplicatedWaitingConfirmProcess = ShipmentProcess::model()->find("pid = :pid and status=2",[":pid"=>$model->id]);
				$duplicatedWaitingConfirmProcess->delete();
			}
		}


		// custom done all self customs shipments after the date of customs
		$orgs = Org::model()->findAll("json_value(meta,'$.self_customs')=1 and status=1");
		foreach ($orgs as $key => $org)
		{
			$shipmentProcesses = ShipmentProcess::model()->findAll("status <=4 and s_agent_id = :sid and started < :date",[":sid"=>$org->id,":date"=>date("Y-m-d 00:00:00")]);
			foreach ($shipmentProcesses as $key => $shipmentProcess)
			{
				$shipmentProcess->status = ShipmentProcess::CUSTOM_DONE;
				$shipmentProcess->update(["status"]);
			}
		}
		

	}

	public function processingMqProcess()
	{

		function funcProcessingMqProcess()
		{
			$mqProcess = MqProcess::model()->with(['task'])->find("task.status != :taskStatus and process_status = :status",[":taskStatus"=>TlaTask::CLOSE,":status"=>MqProcess::NO_READY]);
			$service = new Service();
			$processingMqCount = $service->getCacheData("processingMq");
			if(empty($processingMqCount))
			{
				$processingMqCount['count'] = 1;
			}else
			{
				$processingMqCount['count'] += 1;
			}
			$processingMqCount = $service->setCacheData("processingMq",$processingMqCount,3600);
			switch ($mqProcess->process_type) {
				case  MqProcess::PLGROUP_REPORT:
					$_GET['mqProcessId'] = $mqProcess->id;
					Yii::import('application.controllers.ReportController');
					$report = new ReportController('default');
					$report->actionAjaxExportPlGroupReport();
					break;
				
				default:
					# code...
					break;
			}



			$processingMqCount = $service->getCacheData("processingMq");
			if(empty($processingMqCount))
			{
				$processingMqCount['count'] = 0;
			}else
			{
				$processingMqCount['count'] = $processingMqCount['count']-1;
			}
			$processingMqCount = $service->setCacheData("processingMq",$processingMqCount,3600);
		}


		$service = new Service();
		$processingMqCount = $service->getCacheData("processingMq");
		if(empty($processingMqCount)||$processingMqCount['count']<Yii::app()->params['processingMqCount'])
		{
			funcProcessingMqProcess();
		}

	}


	public function processingShipmentScanMqProcess()
	{

		$mqProcess = ShipmentScanMqProcess::model()->with(['task'])->find("task.status != :taskStatus and process_status = :status",[":taskStatus"=>TlaTask::CLOSE,":status"=>MqProcess::NO_READY]);
