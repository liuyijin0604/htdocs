	public function actionMarketingEmailUnsubscribe(){

		if(empty($_POST)){
			$this->layout="frontend";
			$this->render('marketing_email_unsubscribe');
			return;
		}
		$strEmailAddress = $_POST['email_address'];
		$objMarketingAddress = MarketingAddress::model()->find('email=:email',[':email'=>$strEmailAddress]);
		if($objMarketingAddress != null){
			$objMarketingAddress->status = 0;
			$objMarketingAddress->save();
			$this->layout="frontend";
			$this->render('marketing_email_unsubscribe_result',['strMessage'=>'Successed']);
			return;
		}
		$this->layout="frontend";
		$this->render('marketing_email_unsubscribe_result',['strMessage'=>'Email Address Not Found.']);
		return;
	}

