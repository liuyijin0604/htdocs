	public function actionContainerAvailability()
	{
		$this->layout = false;
		if(empty($_POST)) {
			$this->render('container_availability');
		} else {
			$models = Consol::model()->findAllByAttributes(['container_no' => $_POST['container_no']]);
			foreach ($models as $model) {
				if (!empty($model->eta)) {
					$model->eta = date('d-m-Y', strtotime($model->eta));
				}
				if (!empty($model->mdata['ContainerUnloadDate'])) {
					$model->mdata['ContainerUnloadDate'] = date('d-m-Y', strtotime($model->mdata['ContainerUnloadDate']));
				}
				if (!empty($model->mdata['available_date'])) {
					$model->mdata['available_date'] = date('d-m-Y', strtotime($model->mdata['available_date']));
				}
				if (!empty($model->mdata['input_storage_date'])) {
					$model->mdata['input_storage_date'] = date('d-m-Y', strtotime($model->mdata['input_storage_date']));
				}
				if (empty($model->mdata['input_storage_date']) && !empty($model->mdata['available_date'])) {
					$model->mdata['input_storage_date'] = $this->addWorkingDays($model->mdata['available_date'], 3)->format('d-m-Y');
				}
			}
			$this->render('container_availability', ['model' => $models, 'status' => 'success']);
		}
	}

	private function addWorkingDays($date, $day)
	{
		if (!($date instanceof \DateTime) || is_string($date)) {
			$date = new \DateTime($date);
		}
		if ($date instanceof \DateTime) {
			$newDate = clone $date;
		}
		if ($day == 0) {
			return $newDate;
		}
		$i = 1;
		while ($i <= abs($day)) {
			$newDate->modify(($day > 0 ? ' +' : ' -') . '1 day');
			$next_day_number = $newDate->format('N');
			if (!in_array($next_day_number, [6, 7])) {
				$i++;
			}
		}
		return $newDate;
	}

	public function actionEditContainerPickupBooking()
	{
		$this->layout = false;
		if (empty($_POST)) {
			$this->render('edit_container_booking_vertify');
		}else
		{
			$pb = PickupBooking::model()->find("booking_number = :booking_number and status = :status",[":booking_number"=>$_POST['booking_number'],":status"=>PickupBooking::PAID]);
			if(empty($pb))
			{
				$this->render('edit_container_booking_vertify',['status' => 'failed', 'msg' => 'We cannot find this booking number in our system, please check your input information and try again.','booking_number'=>$_POST['booking_number']]);
			}else
			{
				$service = new Service();
				$bookingCache = $service->getCacheData($_POST['booking_number']."_edit_booking");
				if(true)
				{
					$token = $pb->getEditToken();
					$bookingCache = $service->setCacheData($_POST['booking_number']."_edit_booking",$token);
					// Send edit booking email to customer
					$emailService = new EmailService();
					$emailService->sendBookingEditEmail($pb,$token);
					$this->render('edit_container_booking_vertify',['status' => 'failed', 'msg' => 'The link has been sent to your booking email, please check the inbox of your booking email.','booking_number'=>$_POST['booking_number']]);
				}else
				{
					$this->render('edit_container_booking_vertify',['status' => 'failed', 'msg' => 'The link has been sent to your booking email, please check the inbox of your booking email.','booking_number'=>$_POST['booking_number']]);
				}
			}
			
		}
	}


	public function actionEditBookingInfo()
	{
		$this->layout = false;
		$service = new Service();
		$bookingNumber = $_GET['booking_number'];
		$token = $_GET['token'];
		$availableDate = null;
		$bookingCache = $service->getCacheData($bookingNumber."_edit_booking");
		if(empty($bookingCache))
		{
			echo "Link was expired";
			return;
		}

		$pb = PickupBooking::model()->find("booking_number = :booking_number and status = :status",[":booking_number"=>$bookingNumber,":status"=>PickupBooking::PAID]);
		if(empty($pb))
		{
			echo "Link was expired";
			return;
		}

		if (empty($_POST))
		{

			$model = $pb->shipment;
			if (!empty($model->consol->mdata['available_date']) && !empty($model->mdata['amzon_pallet']) && ($model->status == ImParcel::STATE_CLEAR || $model->status == ImParcel::STATE_CLEAR_WAIT) && $model->status != ImParcel::DELIVERED) {
				$availableDate = date('Y-m-d H:i:s', strtotime($model->consol->mdata['available_date']));
				$today = date('Y-m-d H:i:s', strtotime('today'));
				if ($availableDate < $today) {
					$availableDate = $today;
				}
				$endDate = date('Y-m-d H:i:s', strtotime($availableDate . '+8 day'));
				$depot="";
				switch($model->consol->dpt_id) {
					case Org::TLA_DEPARTMENT_SYDNEY:
						$depot="Sydney";
						$sql = 'SELECT * FROM pickup_booking WHERE `booking_time` >= "' . $availableDate . '" AND `booking_time` < "' . $endDate . '" AND `status` != 3 AND `booking_number` LIKE "S%"';
						break;
					case Org::TLA_DEPARTMENT_MELBOURNE:
						$depot="Melbourne";
						$sql = 'SELECT * FROM pickup_booking WHERE `booking_time` >= "' . $availableDate . '" AND `booking_time` < "' . $endDate . '" AND `status` != 3 AND `booking_number` LIKE "M%"';
						break;
					case Org::TLA_DEPARTMENT_BRISBANE:
						$depot="Brisbane";
						$sql = 'SELECT * FROM pickup_booking WHERE `booking_time` >= "' . $availableDate . '" AND `booking_time` < "' . $endDate . '" AND `status` != 3 AND `booking_number` LIKE "B%"';
						break;
				}
				$bookings = PickupBooking::model()->findAllBySql($sql);
				$days = [];
				for ($i = 0; $i < 8; $i++) {
					array_push($days, date('Y-m-d', strtotime($availableDate . '+' . $i . ' day')));
				}

				$occupiedSlots = [];
				if (!empty($bookings)) {
					foreach ($bookings as $booking) {
						$bookingDate = explode(" ", $booking->booking_time)[0];
						$bookingTime = explode(" ", $booking->booking_time)[1];

						if (empty($occupiedSlots[$bookingDate])) {
							$occupiedSlots[$bookingDate] = [$bookingTime];
						} else {
							array_push($occupiedSlots[$bookingDate], $bookingTime);
						}
					}
				}

				$bookingDate = explode(" ",$pb->booking_time)[0];
				$bookingTimeArr = explode(":",explode(" ",$pb->booking_time)[1]);
				$bookingTime=$bookingTimeArr[0].":".$bookingTimeArr[1];
				$this->render('edit_booking_info', array(
					'availableDate' => $availableDate,
					'endDate' => $endDate,
					'occupiedSlots' => $occupiedSlots,
					'container_no' => $model->consol->container_no,
					'house_bl' => $model->hbn,
					'packages' => $model->pkg,
					'pallets' => $model->mdata['amzon_pallet'],
					'weight' => $model->weight,
					'volume' => (!empty($model->mdata['total_cbm'])?number_format($model->cbm*$model->pkg,'4','.',''):$model->mdata['total_cbm']),
					'driver_name'=>$pb->driver_name,
					'rego'=>$pb->rego,
					'company_name'=>$pb->company_name,
					'company_email'=>$pb->company_email,
					'depot' => $depot,
					'booking_number'=>$bookingNumber,
					'booking_date'=>$bookingDate,
					'booking_time'=>$bookingTime,
					'token'=>$token
				));
			}else
			{
					echo "Booking information can not be adjusted.";

			}
		}else
		{
			$oldBookingTime = $pb->booking_time;
			$pb->booking_time = $_POST['booking_date'] . ' ' . $_POST['booking_time'] . ':00';
			$pb->driver_name = $_POST['name'];
			$pb->company_name = $_POST['company_name'];
			$pb->company_email = $_POST['email'];
			$pb->rego = $_POST['rego'];

			if($pb->booking_time==$oldBookingTime)
			{
				$pb->save();
				echo $pb->booking_number;
				// Send confirmation email to customer
				$emailService = new EmailService();
				$emailService->sendBookingConfirmationEmail($pb, $pb->shipment->mdata['amzon_pallet']);
			}else
			{
				// Check if the choosen slot has already been occupied, only save this record when the slot is available.
				switch($pb->shipment->consol->dpt_id) {
					case Org::TLA_DEPARTMENT_SYDNEY:
						$sql = 'SELECT `booking_time` FROM pickup_booking WHERE `status` != 3 AND `booking_number` LIKE "S%"';
						//$dependency = new CDbCacheDependency('SELECT MAX(id) FROM pickup_booking WHERE `status` != 3 AND `booking_number` LIKE "S%"');
						break;
					case Org::TLA_DEPARTMENT_MELBOURNE:
						$sql = 'SELECT `booking_time` FROM pickup_booking WHERE `status` != 3 AND `booking_number` LIKE "M%"';
						//$dependency = new CDbCacheDependency('SELECT MAX(id) FROM pickup_booking WHERE `status` != 3 AND `booking_number` LIKE "M%"');
						break;
					case Org::TLA_DEPARTMENT_BRISBANE:
						$sql = 'SELECT `booking_time` FROM pickup_booking WHERE `status` != 3 AND `booking_number` LIKE "B%"';
						//$dependency = new CDbCacheDependency('SELECT MAX(id) FROM pickup_booking WHERE `status` != 3 AND `booking_number` LIKE "B%"');
						break;
				}
				//$slotCheck = Yii::app()->db->cache($depot."54321", $dependency)->createCommand($sql)->queryAll();
				$slotCheck = Yii::app()->db->createCommand($sql)->queryAll();
				if (empty($slotCheck)||!in_array(['booking_time' => $pb->booking_time], $slotCheck)) {
					$pb->save();		// save record to database
					$pb->shipment->mdata['pickup_booking_time'] = $pb->booking_time;
					$pb->shipment->updateMeta();
					echo $pb->booking_number;
					// Send confirmation email to customer
					$emailService = new EmailService();
					$emailService->sendBookingConfirmationEmail($pb, $pb->shipment->mdata['amzon_pallet']);
				}else {
					// Selected slot is occupied, return error message
					echo 'Slot has been occupied, please pick another time slot.';
				}
			}
		}
	}

	public function actionContainerBookingVertify()
	{
		$this->layout = false;
		if (empty($_POST)) {
			$this->render('container_booking_vertify');
		} else {
			$depot = $_POST['depot'];
			$container_no = $_POST['container_no'];
			$connote = $_POST['house_bl'];
			switch($depot) {
				case "Sydney":
					$sql = 'SELECT * FROM shipment WHERE `hbn` = "' . $connote . '" AND `consol_id` IN (SELECT `id` FROM consol WHERE `container_no` = "' . $container_no . '" AND `dpt_id` = 106)';
					break;
				case "Melbourne":
					$sql = 'SELECT * FROM shipment WHERE `hbn` = "' . $connote . '" AND `consol_id` IN (SELECT `id` FROM consol WHERE `container_no` = "' . $container_no . '" AND `dpt_id` = 218)';
					break;
				case "Brisbane":
					$sql = 'SELECT * FROM shipment WHERE `hbn` = "' . $connote . '" AND `consol_id` IN (SELECT `id` FROM consol WHERE `container_no` = "' . $container_no . '" AND `dpt_id` = 530)';
					break;
			}
			$model = ImParcel::model()->findBySql($sql);
			$availableDate = null;

			if (!empty($model)) {
				// For checking whether booking record is already exist
				$bookingCheck = PickupBooking::model()->findBySql('SELECT * FROM pickup_booking WHERE `shipment_id` = "' . $model->id .'" AND `status` = 2');
				//$bookingCheck = null;  // For test
				if (!empty($model->consol->mdata['available_date']) && !empty($model->mdata['amzon_pallet']) && ($model->status == ImParcel::STATE_CLEAR || $model->status == ImParcel::STATE_CLEAR_WAIT) && $model->status != ImParcel::DELIVERED && empty($bookingCheck)) {
					$availableDate = date('Y-m-d H:i:s', strtotime($model->consol->mdata['available_date']));
					$today = date('Y-m-d H:i:s', strtotime('today'));
					if ($availableDate < $today) {
						$availableDate = $today;
					}
					$endDate = date('Y-m-d H:i:s', strtotime($availableDate . '+8 day'));
					switch($depot) {
						case "Sydney":
							$sql = 'SELECT * FROM pickup_booking WHERE `booking_time` >= "' . $availableDate . '" AND `booking_time` < "' . $endDate . '" AND `status` != 3 AND `booking_number` LIKE "S%"';
							break;
						case "Melbourne":
							$sql = 'SELECT * FROM pickup_booking WHERE `booking_time` >= "' . $availableDate . '" AND `booking_time` < "' . $endDate . '" AND `status` != 3 AND `booking_number` LIKE "M%"';
							break;
						case "Brisbane":
							$sql = 'SELECT * FROM pickup_booking WHERE `booking_time` >= "' . $availableDate . '" AND `booking_time` < "' . $endDate . '" AND `status` != 3 AND `booking_number` LIKE "B%"';
							break;
					}
					$bookings = PickupBooking::model()->findAllBySql($sql);
					$days = [];
					for ($i = 0; $i < 8; $i++) {
						array_push($days, date('Y-m-d', strtotime($availableDate . '+' . $i . ' day')));
					}

					$occupiedSlots = [];
					if (!empty($bookings)) {
						foreach ($bookings as $booking) {
							$bookingDate = explode(" ", $booking->booking_time)[0];
							$bookingTime = explode(" ", $booking->booking_time)[1];

							if (empty($occupiedSlots[$bookingDate])) {
								$occupiedSlots[$bookingDate] = [$bookingTime];
							} else {
								array_push($occupiedSlots[$bookingDate], $bookingTime);
							}
						}
					}
					$this->render('container_pickup_booking', array(
						'availableDate' => $availableDate,
						'endDate' => $endDate,
						'occupiedSlots' => $occupiedSlots,
						'container_no' => $container_no,
						'house_bl' => $connote,
						'packages' => $model->pkg,
						'pallets' => $model->mdata['amzon_pallet'],
						'weight' => $model->weight,
						'volume' => (!empty($model->mdata['total_cbm'])?number_format($model->cbm*$model->pkg,'4','.',''):$model->mdata['total_cbm']),
						'depot' => $depot
					));
				} elseif (empty($model->consol->mdata['available_date'])) {
					$this->render('container_booking_vertify', ['status' => 'failed', 'msg' => 'We cannot find available date for this pick up.', 'container_no' => $container_no, 'house_bl' => $connote, 'depot' => $depot]);
				} elseif (empty($model->mdata['amzon_pallet'])) {
					$this->render('container_booking_vertify', ['status' => 'failed', 'msg' => 'The shipment is not avaiable for booking, please contact us by sending email to imports@toplogistics.com.au', 'container_no' => $container_no, 'house_bl' => $connote, 'depot' => $depot]);
				} elseif ($model->status != ImParcel::STATE_CLEAR && $model->status != ImParcel::STATE_CLEAR_WAIT) {
					if ($model->status == ImParcel::DELIVERED) {
						$this->render('container_booking_vertify', ['status'=>'failed', 'msg'=>'This shipment has been successfully picked up.', 'container_no'=>$container_no, 'house_bl'=>$connote, 'depot' => $depot]);
					} else {
						$this->render('container_booking_vertify', ['status' => 'failed', 'msg' => 'The shipment is not Customs cleared, please try again later.', 'container_no' => $container_no, 'house_bl' => $connote, 'depot' => $depot]);
					}	
				} elseif (!empty($bookingCheck)) {
					$this->render('container_booking_vertify', ['status' => 'failed', 'msg' => 'You have already booked a pickup time, please check your company email for booking details.', 'container_no' => $container_no, 'house_bl' => $connote, 'depot' => $depot]);
				}
			} else {
				$this->render('container_booking_vertify', ['status' => 'failed', 'msg' => 'We cannot find this record in our system, please check your input information and try again.', 'container_no' => $container_no, 'house_bl' => $connote, 'depot' => $depot]);
			}
		}
	}

	public function actionContainerPickupBooking()
	{
		if (!empty($_POST)) {
			$containerNo = $_POST['container_no'];
			$hbn = $_POST['house_bl'];
			$depot = $_POST['depot'];
			$sql = 'SELECT * FROM shipment WHERE `hbn` = "' . $hbn . '" AND `consol_id` IN (SELECT `id` FROM consol WHERE `container_no` = "' . $containerNo . '")';
			$shipment = ImParcel::model()->findBySql($sql);
			$fee = 20.00;
			$palletFee = 20.00;
			$wrapFee = 5.00;
			$totalPalletFee = 0.00;
			$totalWrapFee = 0.00;
			if (!empty($shipment->mdata['amzon_pallet']) && $shipment->mdata['amzon_pallet'] > 0) {
				if ($_POST['pallet_requirement'] == 'plain') {
					$fee += $shipment->mdata['amzon_pallet'] * $palletFee;
					$totalPalletFee = $shipment->mdata['amzon_pallet'] * $palletFee;
				}
				if ($_POST['shrink_wrap'] == 'wrap') {
					$fee += $shipment->mdata['amzon_pallet'] * $wrapFee;
					$totalWrapFee = $shipment->mdata['amzon_pallet'] * $wrapFee;
				}
			}

			$pickupBooking = new PickupBooking();
			$pickupBooking->rego = $_POST['rego'];
			$pickupBooking->status = 1;
			$pickupBooking->booking_time = $_POST['booking_date'] . ' ' . $_POST['booking_time'] . ':00';
			$pickupBooking->create_date = date("Y-m-d H:i:s");
			$pickupBooking->driver_name = $_POST['name'];
			$pickupBooking->company_name = $_POST['company_name'];
			$pickupBooking->company_email = $_POST['email'];
			$pickupBooking->fee = $fee;
			$pickupBooking->mdata['container_no'] = $_POST['container_no'];
			$pickupBooking->mdata['house_bl'] = $_POST['house_bl'];
			$pickupBooking->mdata['pallet_requirement'] = $_POST['pallet_requirement'];
			$pickupBooking->mdata['shrink_wrap'] = $_POST['shrink_wrap'];
			$pickupBooking->mdata['pallet_fee'] = $totalPalletFee;
			$pickupBooking->mdata['wrap_fee'] = $totalWrapFee;
			$pickupBooking->note = $_POST['note'];
			$s = date('ymd');
			switch ($depot) {
				case "Sydney":
					$pickupBooking->booking_number = "SBK" . $s . rand(100, 999);
					break;
				case "Melbourne":
					$pickupBooking->booking_number = "MBK" . $s . rand(100, 999);
					break;
				case "Brisbane":
					$pickupBooking->booking_number = "BBK" . $s . rand(100, 999);
					break;
			}
			$pickupBooking->shipment_id = $shipment->id;
			$pickupBooking->ref = $shipment->ref;

			// Check if the choosen slot has already been occupied, only save this record when the slot is available.
			//$slotCheck = PickupBooking::model()->findByAttributes(['booking_time' => $pickupBooking->booking_time]);
			switch($depot) {
				case "Sydney":
					$sql = 'SELECT `booking_time` FROM pickup_booking WHERE `status` != 3 AND `booking_number` LIKE "S%"';
					//$dependency = new CDbCacheDependency('SELECT MAX(id) FROM pickup_booking WHERE `status` != 3 AND `booking_number` LIKE "S%"');
					break;
				case "Melbourne":
					$sql = 'SELECT `booking_time` FROM pickup_booking WHERE `status` != 3 AND `booking_number` LIKE "M%"';
					//$dependency = new CDbCacheDependency('SELECT MAX(id) FROM pickup_booking WHERE `status` != 3 AND `booking_number` LIKE "M%"');
					break;
				case "Brisbane":
					$sql = 'SELECT `booking_time` FROM pickup_booking WHERE `status` != 3 AND `booking_number` LIKE "B%"';
					//$dependency = new CDbCacheDependency('SELECT MAX(id) FROM pickup_booking WHERE `status` != 3 AND `booking_number` LIKE "B%"');
					break;
			}
			//$slotCheck = Yii::app()->db->cache($depot."54321", $dependency)->createCommand($sql)->queryAll();
			$slotCheck = Yii::app()->db->createCommand($sql)->queryAll();
			if (empty($slotCheck)) {
				$pickupBooking->save();		// save record to database
				// Upload files
				if (!empty($_FILES)) {
					$i = 1;
					foreach ($_FILES as $file) {
						if ($file['error'] == 0 && !empty($file['name'])) {
							$fileType = substr($file['type'], strpos($file['type'], "/")+1);
							$file['name'] = $hbn . "-DO-" . $i .'.'. $fileType;
							$target_dir = Yii::app()->basePath . DIRECTORY_SEPARATOR . "runtime" . DIRECTORY_SEPARATOR . "pickup_booking_DO" . DIRECTORY_SEPARATOR;
							if (!is_dir($target_dir)) {
								mkdir($target_dir);
							}
							$target_file = $target_dir . basename($file["name"]);
							move_uploaded_file($file['tmp_name'], $target_file);
							// TODO: create a new file type in FileRepo class istead of 18
							$filerepoId = FileRepo::storeFile($target_file, basename($file["name"]), 200, $shipment->id);
							unlink($target_file);
							$i++;
						}
					}
					echo $pickupBooking->booking_number;
				}
			} elseif (!in_array(['booking_time' => $pickupBooking->booking_time], $slotCheck)) {
				$pickupBooking->save();
				if (!empty($_FILES)) {
					$i = 1;
					foreach ($_FILES as $file) {
						if ($file['error'] == 0 && !empty($file['name'])) {
							$fileType = substr($file['type'], strpos($file['type'], "/")+1);
							$file['name'] = $hbn . "-DO-" . $i .'.'. $fileType;
							$target_dir = Yii::app()->basePath . DIRECTORY_SEPARATOR . "runtime" . DIRECTORY_SEPARATOR . "pickup_booking_DO" . DIRECTORY_SEPARATOR;
							if (!is_dir($target_dir)) {
								mkdir($target_dir);
							}
							$target_file = $target_dir . basename($file["name"]);
							move_uploaded_file($file['tmp_name'], $target_file);
							// TODO: create a new file type in FileRepo class istead of 18
							$filerepoId = FileRepo::storeFile($target_file, basename($file["name"]), 200, $shipment->id);
							unlink($target_file);
							$i++;
						}
					}
					echo $pickupBooking->booking_number;
				}
			} else {
				// Selected slot is occupied, return error message
				echo 'Slot has been occupied, please pick another time slot.';
			}
		}
	}

	public function actionBookingCheckout($bookingNo)
	{
		$this->layout = false;
		$booking = PickupBooking::model()->findByAttributes(['booking_number' => $bookingNo]);
		$sql = 'SELECT * FROM shipment WHERE `hbn` = "' . $booking->mdata['house_bl'] . '" AND `consol_id` IN (SELECT `id` FROM consol WHERE `container_no` = "' . $booking->mdata['container_no'] . '")';
		$imParcel = ImParcel::model()->findBySql($sql);
		$numPallets = intval($imParcel->mdata['amzon_pallet']);
		$this->render('booking_checkout', array('model' => $booking, 'numPallets' => $numPallets));
	}

	public function actionBookingPaymentSuccess($pbn)
	{
		$this->layout = false;
		$booking = PickupBooking::model()->findByAttributes(['booking_number' => $pbn]);
		if (!empty($booking)) {
			$booking->status = 2;
			$booking->save();
			// update shipment, set pickup time
			$shipment = ImParcel::model()->findByPk($booking->shipment_id);
			$shipment->mdata['pickup_booking_time'] = $booking->booking_time;
			$shipment->mdata['pickup_booking_number'] = $booking->booking_number;
			if($booking->mdata['shrink_wrap'] == "wrap") {
				$shipment->mdata['pickup_booking_wrap'] = "Yes";
			} else {
				$shipment->mdata['pickup_booking_wrap'] = "No";
			}
			$shipment->updateMeta();
			
			$service = new Service();
			$cache = $service->getCacheData("BookingInvoice".$pbn);
			if(empty($cache)){
				$service->setCacheData("BookingInvoice".$pbn, 1, 50000);
				// create invoice
				$invoiceService = new InvoiceService();
				$invoiceService->createContainerPickupBookingInvoice($booking);
				// Create invoice line
				$invoiceLineService = new InvLineService();
				$invoiceLineService->createContainerPickupBookingInvLine($pbn, $shipment);
			}


			// Send confirmation email to customer
			$emailService = new EmailService();
			$emailService->sendBookingConfirmationEmail($booking, $shipment->mdata['amzon_pallet']);
			$this->render('payment_success');
		}
	}

	public function actionTermsAndConditions()
	{
		$this->layout = false;
		$this->render('terms_and_conditions');
	}

	public function loadModel($id){

		$model = ShipmentQuestionSubmit::model()->findByPk($id);

		if($model===null)
			throw new CHttpException(404,'The requested page does not exist.');
		return $model;
	}
}