<?php
Yii::app()->clientScript->registerScript('search', "
$('.search-button').click(function(){
	$('.search-form').toggle();
	return false;
});
$('.search-form form').submit(function(){
	$('#word-replace-grid').yiiGridView('update', {
		data: $(this).serialize()
	});
	return false;
});
");
?>

<div  class="pane">
    <div style="right: 20px;position: absolute;">
<a class="jqm_link" href="<?=$this->createUrl('wordReplace/create');?>" title="New Replacement"><div class="icon" style="background-position:-16px 0"></div> New Word</a> &nbsp; 
<a href="<?=$this->createUrl('wordReplace/export');?>" class="export_search" target="_blank"><div style="background-position:-48px -688px" class="icon"></div> Export</a>
<a class="jqm_link" href="<?=$this->createUrl('wordReplace/import');?>" title="Import"><div class="icon" style="background-position:-16px 0"></div> Import</a> &nbsp; 
</div>
<h1>Manage Word Replaces</h1>

<p>
You may optionally enter a comparison operator (<b>&lt;</b>, <b>&lt;=</b>, <b>&gt;</b>, <b>&gt;=</b>, <b>&lt;&gt;</b>
