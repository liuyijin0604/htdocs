</p>

<?php echo CHtml::link('Advanced Search','#',array('class'=>'search-button')); ?>
<div class="search-form" style="display:none">
<?php $this->renderPartial('_search',array(
	'model'=>$model,
)); ?>
</div><!-- search-form -->
<div style="width:70%">
<?php $this->widget('zii.widgets.grid.CGridView', array(
	'id'=>'word-replace-grid',
	'dataProvider'=>$model->search(),
	'filter'=>$model,
	'columns'=>array(
		'id',
		'pre_word',
		'replace_word',
                array('name'=>'type','value'=>'$data->getType()','filter'=>CHtml::dropDownList('WordReplace[type]',$model->type, WordReplace::$types,array('prompt'=>'All'))),
		array('name'=>'status','value'=>'$data->status==0?"Disable":"Enable"', 'filter'=>CHtml::dropDownList('WordReplace[status]',$model->status,array(1=>'Enable',0=>'Disable'),array('prompt'=>'All'))),
		array(
			'class'=>'oButtonColumn',
                        'template'=>'{update}{log}',
                        'buttons'=>array(
                            'update'=>array(
                                'imageUrl'=>false,
                                'visible'=>'true',
                                'options'=>array('class' => 'jqm_link grid_view_btn'),
                            ),
                            'log'=>array(
                                  'imageUrl'=>false,
			          'url'=>'Yii::app()->createUrl("wordReplace/log", ["id" => $data->id])',
				   'options' => array('class' => 'jqm_link grid_view_btn'),
                            ),
                        ),
                    
		),
	),
)); ?>
</div>
