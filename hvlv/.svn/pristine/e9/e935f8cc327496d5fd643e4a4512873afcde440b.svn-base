			$xls->addRow($i++, [$r->created, $r->invoice_no, $r->awb, $r->subtotal, $r->gst, $r->total, empty($r->user) ? '' : $r->user->name, $r->getMatchedErrMessage()]);
		}
		$xls->output('exp_afbilling_import_failed_' . time() . '.xlsx');
	}

