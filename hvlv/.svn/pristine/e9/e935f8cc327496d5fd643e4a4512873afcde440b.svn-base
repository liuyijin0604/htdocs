	public function actionOrgBankAccount($org_id, $currency)
	{
		$org = Org::model()->findByPk($org_id);
		$model = OrgBankAccount::model()->find('org_id = :org_id AND currency = :currency', [':org_id' => $org_id, ':currency' => $currency]);
		if (empty($model)) {
			$model = new OrgBankAccount;
			$model->org_id = $org_id;
			$model->currency = $currency;
		}

		if (empty($_POST)) {
			$this->render('bank_account', ['model' => $model, 'org' => $org]);
		} else {
			$model->attributes = $_POST['OrgBankAccount'];
			$model->save();

			$this->ajaxResult($model);
		}
	}

	public function actionSubmitArrange()
	{
		$selected = Yii::app()->cache->get('billing_streamline_selected_' . session_id()) ? Yii::app()->cache->get('billing_streamline_selected_' . session_id()) : [];

		$data = Billing::getPayListByLine();
		$rs = [];
		foreach ($data as $billing) {
			$rs[$billing->currency][] = $billing;
		}

		foreach ($rs as $currency => $billings) {
			foreach ($billings as $billing) {
				$toPay = (!empty($selected[$billing->id]) ? $selected[$billing->id] : $billing->getBalance());
				if($toPay>$billing->getBalance())
				{
					echo json_encode(['done' => false, 'msg' => $billing->billing_cref.' to pay is larger than balance, please select again']);
					Yii::app()->end();
				}
			}
		}

		foreach ($rs as $currency => $billings) {
			$pa = new PaymentArrange;
			$pa->created = date('Y-m-d');
			$pa->user_id = Yii::app()->user->id;
			$pa->status = PaymentArrange::PAYMENT_ARRANGE_STATUS_REQURING_BOSS_APPROVE;
			$pa->currency = $currency;
			$pa->save();
			foreach ($billings as $billing) {
				$pab = new PaymentArrangeBilling;
				$pab->payment_arrange_id = $pa->id;
				$pab->billing_id = $billing->id;
				$pab->amount = !empty($selected[$billing->id]) ? $selected[$billing->id] : $billing->getBalance();
				$pab->status = PaymentArrange::PAYMENT_ARRANGE_STATUS_REQURING_BOSS_APPROVE;
				$pab->save();
				$billing->status = Billing::BILLING_STATUS_ARRANGED_PAYMENT;
				$billing->update('status');
			}
			$pa->updateTotal();
		}

		Yii::app()->cache->set('billing_streamline_selected_' . session_id(), []);

		echo json_encode(['done' => true, 'msg' => 'Successfully']);
		Yii::app()->end();
	}

	public function actionCreateRecLine($id)
	{
		$model = Reconciliation::model()->findByPk($id);
		$line = new ReconciliationLine;
		$line->parent_id = $model->id;
		$line->invoice_no = $model->invoice_no;
		$line->weight = 0;
		$line->postcode = 0;

		if (empty($_POST)) {
			$this->render('dispute_add_line', ['model' => $model, 'line' => $line]);
		} else {
			$line->attributes = $_POST['ReconciliationLine'];
			if (!empty($_POST['consol'])) {
				$consol = Consol::model()->find('no = :no OR awb = :no', [':no' => $_POST['consol']]);
			}
			$line->consol_id = intval(@$consol->id);
			$line->my_value = 0;

			if ($line->save()) {
				$cant = ReconciliationLine::model()->find('shipment_no = "Can\'t upload line difference" AND value > 0 AND parent_id = :pid', [':pid' => $model->id]);
				$cant->value -= $line->value;
				$cant->postcode = 0;
				$cant->save();
			}

			$this->ajaxResult($line);
		}
	}

	public function actionDisputeDelete($id)
	{
		$rl = ReconciliationLine::model()->find('id = :id', [':id' => $id]);
		$value = $rl->value;
		$rl->postcode = 0;
		$rl->value = 0;
		if ($rl->save()) {
			$cant = ReconciliationLine::model()->find('shipment_no = "Can\'t upload line difference" AND value > 0 AND parent_id = :pid', [':pid' => $rl->parent->id]);
			$cant->value += $value;
			$cant->postcode = 0;
			$cant->save();
		}
		echo json_encode(['done' => true, 'msg' => 'Successfully']);
		Yii::app()->end();
	}

	public function actionDisputeBatchAccept()
	{
		if (!empty($_POST['selectedItems'])) {
			foreach ($_POST['selectedItems'] as $id) {
				$model = ReconciliationLine::model()->find('id = :id', [':id' => $id]);
				$model->mdata['amount'] = number_format($model->value - $model->my_value, 2, '.', '');
				$model->mdata['confirmed'] = true;
				$model->update('meta');

				if (number_format($model->mdata['amount'], 2, '.', '') != 0) {
					$billing = Billing::model()->find(['condition' => 'billing_cref LIKE :cref AND status != 11', 'params' => [':cref' => $model->invoice_no . '%'], 'order' => 'id DESC']);
					if (!empty($billing)) {
						$bl = BillingLine::copy($billing->lines[0]);
						$bl->desc = $model->shipment_no . ' ' . (!empty($_POST['code']) ? $_POST['code'] : 'Dispute Accept');
						$bl->billing_ref = $model->consol->no;
						$bl->billing_cref = $billing->status >= Billing::BILLING_STATUS_POSTED ? explode('-', $billing->billing_cref)[0] . '-' . (intval(explode('-', $billing->billing_cref)[1]) + 1) : $billing->billing_cref;
						$bl->actual_amount = number_format($model->mdata['amount'], 2, '.', '');
						$bl->accrual_amount = number_format($model->mdata['amount'], 2, '.', '');
						$bl->gst_amount = $bl->getGSTValue();
						$bl->save();

						if (!empty($model->shipment)) {
							$model->shipment->mdata['import_billing_id_dispute'] = $bl->id;
							$model->updateMeta();
						}
					}
				}
			}
		}

		echo json_encode(['done' => true, 'msg' => 'Successfully']);
		Yii::app()->end();
	}

	private function checkBankAccount($model)
	{
		$data = $model->getSummary();
		foreach ($data as $line) {
			$org = OrgBankAccount::model()->find('org_id = :org_id AND currency = :currency', [':org_id' => $line['id'], ':currency' => $model->currency]);
			if (empty($org->bank_name)) {
				echo json_encode(['done' => false, 'msg' => 'Bank Account Name of <b>' . $line['name'] . '</b> is empty']);
				Yii::app()->end();
			} else if (empty($org->bank_bsb)) {
				echo json_encode(['done' => false, 'msg' => 'Bank Account BSB of <b>' . $line['name'] . '</b> is empty']);
				Yii::app()->end();
			} else if (empty($org->bank_number)) {
				echo json_encode(['done' => false, 'msg' => 'Bank Account Number of <b>' . $line['name'] . '</b> is empty']);
				Yii::app()->end();
			}
		}
	}

	public function actionUpdatePaymentArrange($id)
	{
		$model = PaymentArrange::model()->findByPk($id);
		if (empty($_POST)) {
			$this->render('update_payment_arrange', ['model' => $model]);
		} else {
			if ($_POST['act_btn'] == 'Approve') {
				if (empty($_POST['bank_account'])) {
					$model->addError('id', 'Bank Account is required');
				} else {
					$this->checkBankAccount($model);
					if (!empty($_POST['desc'])) {
						foreach ($_POST['desc'] as $org => $desc) {
							$model->mdata['desc'][$org] = substr(preg_replace('/\t/', '', $_POST['desc'][$org]), 0, 18);
						}
					}
					$model->mdata['bank_account'] = $_POST['bank_account'];
					try {
						$model->createAba();
					} catch (Exception $ex) {
						$model->addError('id', $ex->getMessage());
						$this->ajaxResult($model);
					}
					$model->status = PaymentArrange::PAYMENT_ARRANGE_STATUS_APPROVED;
					$model->update('status', 'meta');
				}
			} else if ($_POST['act_btn'] == 'Reject') {
				$model->status = PaymentArrange::PAYMENT_ARRANGE_STATUS_REJECTED;
				$model->update('status');
			}
			$this->ajaxResult($model);
		}
	}

	public function actionUpdatePaymentAdminApprove($id)
	{
		if(Acl::hasAccess("D:Billing/streamline/approve_payment_to_pay"))
		{
			$model = PaymentArrange::model()->findByPk($id);
			if (empty($_POST)) {
				$this->render('update_payment_approve', ['model' => $model]);
			} else {
				if ($_POST['operation'] == 'Submit Admin Approve') {
					$paymentArrangeSignature = new PaymentArrangeSignature();
					$paymentArrangeSignature->payment_arrange_id = $model->id;
					$paymentArrangeSignature->signature = $_POST['admin_signature'];
					$paymentArrangeSignature->save();

					$model->comment = $_POST['PaymentArrange']['comment'];
					$model->status = PaymentArrange::PAYMENT_ARRANGE_STATUS_BOSS_APPROVED;
					$model->update('status','comment');
				} else if ($_POST['operation'] == 'Admin Reject') {
					$model->status = PaymentArrange::PAYMENT_ARRANGE_STATUS_ADMIN_REJECTED;
					$model->comment = $_POST['PaymentArrange']['comment'];
					$model->update('status','comment');
				}
				$this->ajaxResult($model);
			}
		}
	}

	public function actionUpdatePaymentArrangeAmount()
	{
		$model = PaymentArrangeBilling::model()->findByPk($_POST['id']);
		$model->amount = $_POST['amount'];
		$model->update('amount');
		$this->ajaxResult($model);
	}

	public function actionExportPaymentArrange($id)
	{
		$model = PaymentArrange::model()->findByPk($id);
		$this->checkBankAccount($model);

		file_put_contents($model->no . '.aba', $model->createAba());

		$xls = new oExcel;
		$xls->setTitle('Summary');
		$i = 1;
		$xls->centerAlignment('A1:F1000');
		$xls->verticalAlignment('A1:F1000');
		$xls->setColWidth([30,24,20,20]);
		$xls->addRow($i++, ['Org Name', 'Amount', 'Bank Account', 'Desc']);
		foreach ($model->getSummary() as $org_id => $line) {
			$xls->addRow($i++, [$line['name'], $line['amount'], $line['bankaccount'], !empty($model->mdata['desc'][$org_id]) ? $model->mdata['desc'][$org_id] : substr(sizeof($line['no']) == 1 ? preg_replace('/\/|\-/', '', $line['no'][0]) : 'up to ' . date('Ymd', strtotime($line['date'])), 0, 18)]);
		}

		$xls->createSheet('Details');
		$xls->goSheet(1);
		$xls->setTitle('Details');
		$i = 1;
		$xls->centerAlignment('A1:F1000');
		$xls->verticalAlignment('A1:F1000');
		$xls->setColWidth([30,18,10,18,24,20]);
		$xls->addRow($i++, ['Inv No','Org Name', 'Total (Excl.GST)', 'GST', 'Total (Incl.GST)', 'Outstanding (Incl.GST)', 'To Pay']);
		foreach ($model->links as $link) {
			$xls->addRow($i++, [$link->billing->billing_cref,$link->billing->cust->name, $link->billing->total - $link->billing->gst, $link->billing->gst, $link->billing->total, $link->billing->getBalance(), $link->amount]);
		}
		$xls->goSheet(0);

		$xls->output($model->no . '.xlsx', '', false);

		$td = Yii::app()->basePath . DIRECTORY_SEPARATOR . "runtime" . DIRECTORY_SEPARATOR;
		$zip = new ZipArchive;
		$zf = $td . $model->no . '.zip';
		$zip->open($zf, ZipArchive::CREATE);
		$zip->addFile($model->no . '.aba');
		$zip->addFile($model->no . '.xlsx');
		$zip->close();

		header("Pragma: public");
		header("Expires: 0");
		header("Cache-Control: must-revalidate, post-check=0, pre-check=0");
		header("Content-Description: File Transfer");
		header("Content-type: application/octet-stream");
		header("Content-Disposition: attachment; filename=\"" . $model->no . ".zip\"");
		header("Content-Transfer-Encoding: binary");
		header("Content-Length: " . filesize($zf));
		readfile($zf);
		unlink($model->no . '.aba');
		unlink($model->no . '.xlsx');
		unlink($zf);
	}

	public function actionDisplayDispute($id)
	{
		$model = $this->loadModel($id);
		$this->render('dispute_list', ['model' => $model]);
	}

	public function actionExport()
	{
		if (empty($_POST)) {
			$this->render('export');
		} else {
			$cond = '';
			if (!empty($_POST['fromdate'])) {
				$cond .= ' AND si.inv_date >= "' . $_POST['fromdate'] . '"';
			}
			if (!empty($_POST['todate'])) {
				$cond .= ' AND si.inv_date <= "' . $_POST['todate'] . '"';
			}
			if (!empty($_POST['supplier_id'])) {
				$cond .= ' AND si.org_id = "' . $_POST['supplier_id'] . '"';
			}
			switch ($_GET['t']) {
				case 'pcae_in_tla':
					$xls = new oExcel;
					$page = 1;

					$invs = [];
					$this->_pitCourier($xls, $invs, $cond, $page);
					$this->_pitBroker($xls, $invs, $cond, $page);
					$this->_pitTerminal($xls, $invs, $cond, $page);
					$this->_pitManual($xls, $invs, $cond, $page);

					$xls->goSheet(0);
					$xls->setTitle('Summary');
					$i = 1;
					$xls->setColWidth([15,20,20]);
					$xls->centerAlignment('A1:D1000');
					$xls->addRow($i++, ['Supplier', 'Invoice No', 'Total (Excl.GST)', 'Total (Incl.GST)']);
					foreach ($invs as $no => $amount) {
						$sql = 'SELECT * FROM hvlv_top.`supplier_invoice` si WHERE si.status < 100 AND si.inv_no = :no' . $cond;
						$rs = Yii::app()->db->createCommand($sql)->bindValues([':no' => $no])->queryAll();
						$xls->addRow($i++, [Org::model()->findByPk($rs[0]['org_id'])->name, $no, $amount, $rs[0]['total']]);
					}

					$xls->output('PCAE in TLA.xlsx');

				case 'tla_in_pcae':
					$xls = new oExcel;
					$page = 1;

					$invs = [];
					$this->_tipCourier($xls, $invs, $cond, $page);
					$this->_tipBroker($xls, $invs, $cond, $page);
					$this->_tipTerminal($xls, $invs, $cond, $page);
					$this->_tipManual($xls, $invs, $cond, $page);

					$xls->goSheet(0);
					$xls->setTitle('Summary');
					$i = 1;
					$xls->setColWidth([15,20,20,20]);
					$xls->centerAlignment('A1:D1000');
					$xls->addRow($i++, ['Supplier', 'Invoice No', 'Total (Excl.GST)', 'Total (Incl.GST)']);
					foreach ($invs as $no => $amount) {
						$sql = 'SELECT * FROM hvlv_db.`supplier_invoice` si WHERE si.status < 100 AND si.inv_no = :no' . $cond;
						$rs = Yii::app()->db->createCommand($sql)->bindValues([':no' => $no])->queryAll();
						$xls->addRow($i++, [Org::model()->findByPk($rs[0]['org_id'])->name, $no, $amount, $rs[0]['total']]);
					}

					$xls->output('TLA in PCAE.xlsx');
			}
		}
	}

	private function _pitCourier(&$xls, &$invs, $cond, &$page)
	{
		$sql = 'SELECT srl.id AS v0, srl.ref AS v1, srl.item_code AS v2, consol.no AS v3, consol.eta AS v4, si.inv_no AS v5, srl.value AS v6, srl.my_value AS v7, (SELECT name FROM hvlv_db.org WHERE id = sr.org_id) AS v8 FROM hvlv_top.`si_reconcile_line` srl JOIN hvlv_top.`si_reconcile` sr ON srl.rec_id = sr.id JOIN hvlv_top.`supplier_invoice` si ON si.id = sr.supplier_invoice_id JOIN hvlv_db.shipment ON shipment.id = srl.fid LEFT JOIN hvlv_db.consol ON consol.type IN (15,70,80) AND consol.id = shipment.consol_id WHERE si.type = 1 AND srl.model = "ImParcel" AND sr.status < 100' . $cond . ' 
		union
		SELECT srl.id AS v0, srl.ref AS v1, srl.item_code AS v2, consol.no AS v3, consol.eta AS v4, si.inv_no AS v5, srl.value AS v6, srl.my_value AS v7, (SELECT name FROM hvlv_db.org WHERE id = sr.org_id) AS v8 FROM hvlv_top.`si_reconcile_line` srl JOIN hvlv_top.`si_reconcile` sr ON srl.rec_id = sr.id JOIN hvlv_top.`supplier_invoice` si ON si.id = sr.supplier_invoice_id LEFT JOIN hvlv_db.consol ON consol.type IN (15,70,80) AND consol.awb = srl.ref WHERE si.type = 1 AND srl.item_code = "letter" AND sr.status < 100' . $cond . ' 
		union
		SELECT srl.id AS v0, srl.ref AS v1, srl.item_code AS v2, consol.no AS v3, consol.eta AS v4, si.inv_no AS v5, srl.value AS v6, srl.my_value AS v7, (SELECT name FROM hvlv_db.org WHERE id = sr.org_id) AS v8 FROM hvlv_top.`si_reconcile_line` srl JOIN hvlv_top.`si_reconcile` sr ON srl.rec_id = sr.id JOIN hvlv_top.`supplier_invoice` si ON si.id = sr.supplier_invoice_id LEFT JOIN hvlv_db.consol ON consol.type IN (15,70,80) AND json_query(consol.meta, "$.elms") LIKE concat("%", srl.ref, "%") WHERE si.type = 1 AND srl.item_code = "letter" AND sr.status < 100' . $cond . ' 
		union
		SELECT DISTINCT(srl.id) AS v0, srl.ref AS v1, srl.item_code AS v2, consol.no AS v3, consol.eta AS v4, si.inv_no AS v5, srl.value AS v6, srl.my_value AS v7, (SELECT name FROM hvlv_db.org WHERE id = sr.org_id) AS v8 FROM hvlv_top.`si_reconcile_line` srl JOIN hvlv_top.`si_reconcile` sr ON srl.rec_id = sr.id JOIN hvlv_top.`supplier_invoice` si ON si.id = sr.supplier_invoice_id JOIN hvlv_db.manifest ON manifest.ref = srl.ref JOIN hvlv_db.mani_map mm ON mm.mani_id = manifest.id JOIN shipment ON mm.fid = shipment.id JOIN consol ON consol.type IN (15,70,80) AND consol.id = shipment.consol_id WHERE si.type = 1 AND srl.item_code = "rts" AND sr.status < 100' . $cond . ' GROUP BY v0';

		$rs = Yii::app()->db->createCommand($sql)->queryAll();
		if (!empty($rs)) {
			$xls->createSheet('Courier');
			$xls->goSheet($page++);
			$xls->setTitle('Courier');
			$i = 1;
			$xls->setColWidth([20,15,15,20,20,20,20,20]);
			$xls->centerAlignment('A1:G1000');
			$xls->addRow($i++, ['Supplier', 'Ref', 'Item Code', 'Consol No', 'Consol ETA', 'Invoice No', 'Amount (Excl.GST)', 'Accrual (Excl.GST)']);

			foreach ($rs as $r) {
				$xls->addRow($i++, [$r['v8'], $r['v1'], $r['v2'], $r['v3'], $r['v4'], $r['v5'], $r['v6'], $r['v7']]);
				if (empty($invs[$r['v5']])) $invs[$r['v5']] = 0;
				$invs[$r['v5']] += $r['v6'];
			}
		}

		// can't find shipment or consol
		$sql = 'SELECT id AS v0, ref AS v1, item_code AS v2, null AS v3, null AS v4, (SELECT inv_no FROM hvlv_top.`supplier_invoice` WHERE id IN (SELECT supplier_invoice_id FROM hvlv_top.`si_reconcile` WHERE id = rec_id)) AS v5, value AS v6, my_value AS v7, (SELECT name FROM hvlv_db.org WHERE id = (SELECT org_id FROM hvlv_top.`supplier_invoice` WHERE id IN (SELECT supplier_invoice_id FROM hvlv_top.`si_reconcile` WHERE id = rec_id))) AS v8 FROM hvlv_top.`si_reconcile_line` WHERE rec_id in (SELECT id FROM hvlv_top.`si_reconcile` WHERE status < 100 AND supplier_invoice_id in (SELECT id FROM hvlv_top.`supplier_invoice` si WHERE type = 1' . $cond . ' )) AND ((item_code != "eparcel" AND item_code != "eparcel-fuel" AND id NOT IN (SELECT v0 FROM (' . $sql . ') a)) OR (item_code = "eparcel" AND id NOT IN (SELECT srl.inline_pid FROM hvlv_top.`si_reconcile_line` srl JOIN hvlv_top.`si_reconcile` sr ON srl.rec_id = sr.id JOIN hvlv_top.`supplier_invoice` si ON si.id = sr.supplier_invoice_id JOIN hvlv_db.shipment ON shipment.id = srl.fid LEFT JOIN hvlv_db.consol ON consol.type IN (15,70,80) AND consol.id = shipment.consol_id WHERE si.type = 1 AND srl.model = "ImParcel" AND sr.status < 100' . $cond . ')))';
		$rs = Yii::app()->db->createCommand($sql)->queryAll();
		if (!empty($rs)) {
			$xls->createSheet('Courier Unknown');
			$xls->goSheet($page++);
			$xls->setTitle('Courier Unknown');
			$i = 1;
			$xls->setColWidth([20,15,15,20,20,20]);
			$xls->centerAlignment('A1:G1000');
			$xls->addRow($i++, ['Supplier', 'Ref', 'Item Code', 'Invoice No', 'Amount (Excl.GST)', 'Accrual (Excl.GST)']);

			foreach ($rs as $r) {
				$xls->addRow($i++, [$r['v8'], $r['v1'], $r['v2'], $r['v5'], $r['v6'], $r['v7']]);
				if (empty($invs[$r['v5']])) $invs[$r['v5']] = 0;
				$invs[$r['v5']] += $r['v6'];
			}
		}

		// auspost adjust
		$sql = 'SELECT v0, v2 AS v1, "eParcel" AS v2, null AS v3, null AS v4, v6 AS v5, v3-v1 AS v6, v5-v4 AS v7 from (SELECT inline_pid AS v0, SUM(value) AS v1, (SELECT ref FROM hvlv_top.si_reconcile_line WHERE id = srl.inline_pid) AS v2, (SELECT value FROM hvlv_top.si_reconcile_line WHERE id = srl.inline_pid) AS v3, sum(my_value) AS v4, (SELECT my_value FROM hvlv_top.si_reconcile_line WHERE id = srl.inline_pid) AS v5, (SELECT inv_no FROM hvlv_top.supplier_invoice WHERE id = (SELECT supplier_invoice_id FROM hvlv_top.si_reconcile WHERE id = rec_id)) AS v6 FROM hvlv_top.si_reconcile_line srl WHERE rec_id in (SELECT id FROM hvlv_top.si_reconcile WHERE status < 100 AND supplier_invoice_id IN (SELECT id FROM hvlv_top.supplier_invoice si WHERE type = 1' . $cond . ')) AND model = "imParcel" GROUP BY inline_pid HAVING v1 != v3) a';
		$rs = Yii::app()->db->createCommand($sql)->queryAll();
		if (!empty($rs)) {
			$xls->createSheet('Auspost Manifest Adjust');
			$xls->goSheet($page++);
			$xls->setTitle('Auspost Manifest Adjust');
			$i = 1;
			$xls->setColWidth([15,15,20,20]);
			$xls->centerAlignment('A1:D1000');
			$xls->addRow($i++, ['Ref', 'Item Code', 'Invoice No', 'Amount (Excl.GST)']);

			foreach ($rs as $r) {
				$consols = Consol::model()->with('shipments.mms.manifest')->findAll('manifest.ref = :ref', [':ref' => $r['v1']]);
				$temp = [];
				foreach ($consols as $consol) {
					$temp[] = $consol->no;
				}
				$xls->addRow($i++, [$r['v1'], $r['v2'], $r['v5'], $r['v6'], implode(', ', $temp)]);
				if (empty($invs[$r['v5']])) $invs[$r['v5']] = 0;
				$invs[$r['v5']] += $r['v6'];
			}
		}
	}

	private function _pitBroker(&$xls, &$invs, $cond, &$page)
	{
		$sql = 'SELECT srl.ref AS v1, srl.item_code AS v2, consol.no AS v3, consol.eta AS v4, si.inv_no AS v5, srl.value AS v6, (SELECT name FROM hvlv_db.org WHERE id = sr.org_id) AS v8 FROM hvlv_top.`si_reconcile_line` srl JOIN hvlv_top.`si_reconcile` sr ON srl.rec_id = sr.id JOIN hvlv_top.`supplier_invoice` si ON si.id = sr.supplier_invoice_id JOIN hvlv_db.shipment ON shipment.id = srl.fid LEFT JOIN hvlv_db.consol ON consol.type IN (15,70,80) AND consol.id = shipment.consol_id WHERE si.type = 2 AND srl.model = "ImParcel" AND sr.status < 100' . $cond;

		$rs = Yii::app()->db->createCommand($sql)->queryAll();
		if (!empty($rs)) {
			$xls->createSheet('Broker');
			$xls->goSheet($page++);
			$xls->setTitle('Broker');
			$i = 1;
			$xls->setColWidth([20,15,15,20,20,20,20]);
			$xls->centerAlignment('A1:F1000');
			$xls->addRow($i++, ['Supplier', 'Ref', 'Item Code', 'Consol No', 'Consol ETA', 'Invoice No', 'Amount (Excl.GST)']);

			foreach ($rs as $r) {
				$xls->addRow($i++, [$r['v8'], $r['v1'], $r['v2'], $r['v3'], $r['v4'], $r['v5'], $r['v6']]);
				if (empty($invs[$r['v5']])) $invs[$r['v5']] = 0;
				$invs[$r['v5']] += $r['v6'];
			}
		}
	}

	private function _pitTerminal(&$xls, &$invs, $cond, &$page)
	{
		$sql = 'SELECT srl.ref AS v1, srl.item_code AS v2, consol.no AS v3, consol.eta AS v4, si.inv_no AS v5, srl.value AS v6, (SELECT name FROM hvlv_db.org WHERE id = sr.org_id) AS v8 FROM hvlv_top.`si_reconcile_line` srl JOIN hvlv_top.`si_reconcile` sr ON srl.rec_id = sr.id JOIN hvlv_top.`supplier_invoice` si ON si.id = sr.supplier_invoice_id LEFT JOIN hvlv_db.consol ON consol.type IN (15,70,80) AND consol.id = srl.fid WHERE si.type = 3 AND sr.status < 100' . $cond;

