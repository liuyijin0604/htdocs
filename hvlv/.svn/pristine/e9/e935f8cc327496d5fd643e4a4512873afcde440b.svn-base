	/**
	 * import priority cargo billling to xero
	 */
	public function actionAjaxPcbImportXero()
	{
		$resp = array('success' => 1, 'msg' => 'All push to xero Successfully');
		if (isset($_FILES) && !empty($_FILES)) {
			$ap_file = empty($_FILES['pcb_file']) ? array() : $_FILES['pcb_file'];
			if (empty($ap_file['tmp_name']) || !is_uploaded_file($ap_file['tmp_name'])) {
				$resp['msg'] = 'Invalid template file';
				echo json_encode($resp);
				return;
			} else {
				$xls = new oExcel;
				$xls->load($ap_file['tmp_name']);
				$data = $xls->getAll();

				// remove title
				unset($data[1]);

				// load all data now
				$billingData = array();
				$preBillingNo = '';
				$xdata = null;
				$xeroXmlData = '';
				foreach ($data as $k => $line) {
					$curBillingNo = trim($line[1]);
					if (!empty($curBillingNo)) {
						// current billing no is not empty
						if (!empty($preBillingNo)) {
							// previous one is not empty
							// if not equal , we should
							// save all previous billing to xero now
							if ($curBillingNo != $preBillingNo) {
								$xeroXmlData .= $this->getPcb2XeroXmlData($billingData);
							}
						}
						// for next one
						$preBillingNo = $curBillingNo;
						$billingData = array($curBillingNo => array(
							'basic' => array(),
							'lines' => array(),
						));
						$billingData[$curBillingNo]['basic']['date'] = trim($line[4]);

					}
					$gst = floatval(trim($line[11]));
					$amount = floatval(trim($line[10]));
					if ($amount <= 0) {
						continue;
					}

					$billingData[$preBillingNo]['lines'][] = array(
						'desc' => trim($line[9]),
						'amount' => $amount,
						'gst' => $gst > 0 ? 'INPUT' : 'EXEMPTEXPENSES',
						'glcode' => trim($line[15]),
					);
				}

				// push last one
				$xeroXmlData .= $this->getPcb2XeroXmlData($billingData);
				$result = $this->sendXeroBulkBilling($xeroXmlData);

				if (!empty($result)) {
					$resp['success'] = 0;
					$resp['msg'] = implode('<br/>', $result);
				}
				echo json_encode($resp);
			}
		} else {
			$resp['success'] = 0;
			$resp['msg'] = 'Invalid billing file';
			echo json_encode($resp);
		}
	}

	/**
	 * @param $invoicesData
	 */
	private function sendXeroBulkBilling(&$billingData)
	{
		$results = array();
		if (empty($billingData)) {
			return;
		}

		$bulkXmlData = '<?xml version="1.0"?><Invoices>';
		$bulkXmlData .= $billingData;
		$bulkXmlData .= '</Invoices>';
		$xeinvoices = new XeInvoices();
		try {
			$xeinvoices->setEndPoint('Invoices');
			$rt = $xeinvoices->bulkSave($bulkXmlData);

			if ($rt) {
				//    Yii::app()->xero->log('Response Data : ' . json_encode(var_export($xeinvoices,true)),Xero::LOG_LEVEL_INFO);

				// loop for all synced invoices
				foreach ($xeinvoices->invoices as $invoice) {

					$invoiceNo = $invoice->invoiceNumber;
					if ($invoice->statusAttributeString == 'ERROR') {
						$results[] = $invoiceNo . ' failed';
					}
				}
			} else {
				Yii::app()->xero->log('Failed to send bulk billing this time', Xero::LOG_LEVEL_ERR);
			}
		} catch (Exception $ecp) {
			$msg = 'Failed to send all billing - ' . $ecp->getMessage();
			Yii::app()->xero->log($msg, Xero::LOG_LEVEL_ERR);
		}

		return $results;
	}

	/**
	 * @param $billingData
	 */
	private function getPcb2XeroXmlData($billingData)
	{
		foreach ($billingData as $bref => $r) {
			$xdata = new stdClass();
			$xdata->no = $bref;
			$xdata->currency = 'AUD'; // default as AUD currently
			$xdata->orgName = 'SHANGHAI YUYANG INT\'L LOGISTICS CO LTD';
			$xdata->orgId = '964';
			$xdata->date = $r['basic']['date'];
			$xdata->due = $xdata->date;
			$xdata->gstType = 1; // exclusive
			$xdata->dpt_id = Org::PCAE_DEPARTMENT_SYDNEY;
			$costs = array();
			foreach ($r['lines'] as $line) {
				$costs[] = array('qty' => 1,
					'description' => $line['desc'],
					'code' => $line['glcode'],
					'amount' => $line['amount'],
					'taxType' => $line['gst'],
					'dept' => '',
				);
			}

			// save to xero now
			if (!empty($costs)) {
				$xdata->lines = $costs;
				return Invoice::getBillingXeroXmlData($xdata);
			}

			break;
		}
		return '';
	}

	/**
	 *
	 */
	public function actionAjaxPortInvoiceImport()
	{
		$resp = array('success' => 1, 'msg' => 'All imported Successfully');
		if (isset($_FILES) && !empty($_FILES)) {
			$ap_file = empty($_FILES['port_file']) ? array() : $_FILES['port_file'];
			if (empty($ap_file['tmp_name']) || !is_uploaded_file($ap_file['tmp_name'])) {
				$resp['msg'] = 'Invalid template file';
				echo json_encode($resp);
				return;
			} else {
				$xls = new oExcel;
				$xls->load($ap_file['tmp_name']);
				$data = $xls->getAll();

				// remove title
				unset($data[1]);

				// load all data now
				$result = array();
				$index = 2;
				$billingdata = array();
				foreach ($data as $k => $line) {

					$consol = trim($line[1]);
					$invoiceRef = trim($line[2]);
					$chargeableWeight = trim($line[3]);
					$supplier = trim($line[4]);
					$cost = floatval($line[5]);
					$chargeCode = trim($line[6]);

					$org = Org::model()->find('code = :code', [':code' => $supplier]);
					if (empty($org)) {
						$result[] = 'Line ' . $index . ' Supplier - ' . $supplier . ' not found';
						continue;
					}

					if (empty($consol) && empty($invoiceRef) && empty($chargeableWeight) && $index > 2) {
						$billingdata['chargecode'] = $chargeCode;
						$billingdata['org_id'] = $org->id;
						$billingdata['cost'] = $cost;
						$errors = BillingLine::savePortBilling($billingdata);
						if (!empty($errors)) {
							$result[] = 'Line ' . $index . ' consol - ' . $consol . ' import error : ' . implode('<br/>', $errors);
						}
					} else {
						if (empty($consol)) {
							$result[] = 'Line ' . $index . ' no Consol';
							continue; // ignore invalid data
						}
						$consoleObj = Consol::model()->find('no = :no', [':no' => $consol]);
						if (empty($consoleObj)) {
							$result[] = 'Line ' . $index . ' Consol - ' . $consol . ' not found';
							continue;
						}

						if ($cost <= 0.0) {
							$result[] = 'Line ' . $index . ' no cost';
							continue;
						}
						$chargeCodeObj = Chargecode::model()->find('status = 1 AND code = :code', [':code' => $chargeCode]);
						if (empty($chargeCodeObj)) {
							$result[] = 'Line ' . $index . ' charge code - ' . $chargeCode . ' not found';
							continue;
						}

						$billingdata = array(
							'org_id' => $org->id,
							'invoice_ref' => $invoiceRef,
							'chargecode' => $chargeCode,
							'chargeable_weight' => $chargeableWeight,
							'consol' => $consol,
							'cost' => $cost,
						);
						$errors = BillingLine::savePortBilling($billingdata);
						if (!empty($errors)) {
							$result[] = 'Line ' . $index . ' consol - ' . $consol . ' import error : ' . implode('<br/>', $errors);
						}
					}
					$index++;

				}

				if (!empty($result)) {
					$resp['success'] = 0;
					$resp['msg'] = implode('<br/>', $result);
				}
				echo json_encode($resp);
			}
		} else {
			$resp['success'] = 0;
			$resp['msg'] = 'Invalid billing file';
			echo json_encode($resp);
		}
	}

	/**
	 * @param $billingData
	 */
	private function createEdiInvoiceImportReportPro($billingData, $afHistory)
	{
		$xls = new oExcel;
		$mfn = 'afbilling_import_report_' . date('Y-m-d') . '_' . time();

		$i = 1;
		$xls->addRow($i++, ['Invoice No.', 'All Total', 'line total', 'Total excluding GST', 'Accrual Total', 'Date', 'Origin', 'Dest', 'ETA', 'ETD', 'Weight', 'Volume', 'Chargeable', 'Line',
			'Job/Console No.', 'AWB', 'Client', 'Desc', 'SubTotal', 'Line Accrual Total', 'GST', 'Total', 'Type', 'OP', 'Match Result']);

		$allTotalNoGstInBilling = 0;
		$allTotalNoGstAccrual = 0;
		foreach ($billingData as $billing) {

			$accrualTotal = 0;

			// in hvlv awb number will be including dash or not
			$dashAwb = substr($billing['awb'], 0, 3) . '-' . substr($billing['awb'], 3);
			$job = EdiJob::model()->find('awb = :awb', [':awb' => $dashAwb]);
			if (!empty($job)) {
				$client = isset($job->owner) ? $job->owner->name : 'unknown';
				$op = User::model()->findByPk($job->user_id);
				$opName = !empty($op) ? $op->fname . '.' . $op->lname : 'unknown';
				$lineIndex = 1;

				// get job cost lines related gl code
				$costGlCodes = array();
				$jobCostLines = BillingLine::model()->findAll('billing_ref = :bref', [':bref' => $job->no]);
				foreach ($jobCostLines as $line) {
					// currently we only statistic for yuyang - 964
					if ($line->org_id == 964) {
						$allTotalNoGstAccrual += $line->accrual_amount;
						$accrualTotal += $line->accrual_amount;
					}
					if (!empty($line->item_code)) {
						$costGlCodes[$line->item_code] = $line;
					}
				}

				// check lines count
				$matched_result = 'MATCHED';
				if (count($billing['lines']) > count($costGlCodes)) {
					$matched_result = 'LINES_COUNT_NOTMATCHED';
				} else {
					// check lines content
					foreach ($billing['lines'] as $line) {
						if (!isset($costGlCodes[$line['glcode']])) {
							$matched_result = 'LINES_GLCODE_NOTMATCHED';
							break;
						} else {
							if ($costGlCodes[$line['glcode']]->accrual_amount < $line['subtotal']) {
								$matched_result = 'DIFF_TOOBIG';
								break;
							}
						}
					}
				}

				foreach ($billing['lines'] as $k => $line) {
					$allTotalNoGstInBilling += $line['subtotal'];
					$lineAccrualTotal = isset($costGlCodes[$line['glcode']]) ? $costGlCodes[$line['glcode']]->accrual_amount : 0;
					$xls->addRow($i++, [$k == 0 ? $billing['number'] : '', $k == 0 ? $billing['total'] : '', $k == 0 ? $billing['linetotal'] : '', $k == 0 ? $billing['subtotal'] : '', $k == 0 ? $accrualTotal : 0, $billing['date'],
						$k == 0 ? $billing['orgin'] : '', $k == 0 ? $billing['dest'] : '', $k == 0 ? $billing['eta'] : '', $k == 0 ? $billing['etd'] : '',
						$k == 0 ? $billing['weight'] : '', $k == 0 ? $billing['volume'] : '',
						$k == 0 ? $billing['chargeWeight'] : '',
						$lineIndex++, $job->no, $dashAwb, $client, $line['desc'],
						$line['subtotal'], $lineAccrualTotal, $line['gstamount'], $line['total'], 'Export Big Parcel', $opName, $matched_result]);
				}
			} else {
				// $consol = ExcoConsol::model()->find('no = :no',[':no' => $cref]);
				$consol = ExcoConsol::model()->find('awb = :awb', [':awb' => $dashAwb]);
				if (!empty($consol)) {

					// get exco console cost lines related gl code
					$costGlCodes = array();
					$jobCostLines = BillingLine::model()->findAll('billing_ref = :bref', [':bref' => $consol->no]);
					foreach ($jobCostLines as $line) {
						if ($line->org_id == 964) {
							$allTotalNoGstAccrual += $line->accrual_amount;
							$accrualTotal += $line->accrual_amount;
						}
						if (!empty($line->item_code)) {
							$costGlCodes[$line->item_code] = $line;
						}
					}

					// check lines count
					$matched_result = 'MATCHED';
					if (count($billing['lines']) > count($costGlCodes)) {
						$matched_result = 'LINES_COUNT_NOTMATCHED';
					} else {
						// check lines content
						foreach ($billing['lines'] as $line) {
							if (!isset($costGlCodes[$line['glcode']])) {
								$matched_result = 'LINES_GLCODE_NOTMATCHED';
								break;
							} else {
								if ($costGlCodes[$line['glcode']]->accrual_amount < $line['subtotal']) {
									$matched_result = 'DIFF_TOOBIG';
									break;
								}
							}
						}
					}

					$client = isset($consol->owner) ? $consol->owner->name : 'unknown';
					$opName = Log::getExconsolCreateUser($consol->id);
					$lineIndex = 1;
					foreach ($billing['lines'] as $k => $line) {
						$allTotalNoGstInBilling += $line['subtotal'];
						$lineAccrualTotal = isset($costGlCodes[$line['glcode']]) ? $costGlCodes[$line['glcode']]->accrual_amount : 0;
						$xls->addRow($i++, [$k == 0 ? $billing['number'] : '', $k == 0 ? $billing['total'] : '', $k == 0 ? $billing['linetotal'] : '', $k == 0 ? $billing['subtotal'] : '', $k == 0 ? $accrualTotal : 0, $billing['date'],
							$k == 0 ? $billing['orgin'] : '', $k == 0 ? $billing['dest'] : '', $k == 0 ? $billing['eta'] : '', $k == 0 ? $billing['etd'] : '',
							$k == 0 ? $billing['weight'] : '', $k == 0 ? $billing['volume'] : '',
							$k == 0 ? $billing['chargeWeight'] : '',
							$lineIndex++, $consol->no, $dashAwb, $client, $line['desc'],
							$line['subtotal'], $lineAccrualTotal, $line['gstamount'], $line['total'], 'Export Small Parcel', $opName, $matched_result]);
					}
				} else {
					$lineIndex = 1;
					foreach ($billing['lines'] as $k => $line) {
						$allTotalNoGstInBilling += $line['subtotal'];
						$lineAccrualTotal = isset($costGlCodes[$line['glcode']]) ? $costGlCodes[$line['glcode']]->accrual_amount : 0;
						$xls->addRow($i++, [$k == 0 ? $billing['number'] : '', $k == 0 ? $billing['total'] : '', $k == 0 ? $billing['linetotal'] : '', $k == 0 ? $billing['subtotal'] : '', $k == 0 ? $accrualTotal : 0, $billing['date'],
							$k == 0 ? $billing['orgin'] : '', $k == 0 ? $billing['dest'] : '', $k == 0 ? $billing['eta'] : '', $k == 0 ? $billing['etd'] : '',
							$k == 0 ? $billing['weight'] : '', $k == 0 ? $billing['volume'] : '',
							$k == 0 ? $billing['chargeWeight'] : '',
							$lineIndex++, '', $dashAwb, '', $line['desc'],
							$line['subtotal'], $lineAccrualTotal, $line['gstamount'], $line['total'], 'Related job/consol not found', '', '']);
					}
				}
			}
		}

		// output total no gst amount
		$xls->addRow($i++, ['']);
		$xls->addRow($i++, ['']);
		$xls->addRow($i++, ['Total Actual', 'Total Accrual', 'diff']);
		$xls->addRow($i, [$allTotalNoGstInBilling, $allTotalNoGstAccrual, number_format($allTotalNoGstInBilling - $allTotalNoGstAccrual, 2, '.', '')]);

		// anyway try to delete processed progress bar file again
		Yii::app()->cache->delete('pid_'.md5(session_id().'ediInvoiceProgress'));

		$tempfile = Yii::app()->basePath . DIRECTORY_SEPARATOR . "runtime" . DIRECTORY_SEPARATOR . $mfn . '.xlsx';

		$xls->output($tempfile, null, false);

		// save last month balance details file
		$filerepoId = FileRepo::storeFile($tempfile, $mfn . '.xlsx', 35, $afHistory->id);

		$afHistory->report_file_id = $filerepoId;
		$afHistory->update('report_file_id');
	}

	/**
	 * import Air freight invoice import
	 * created related report and save them
	 */
	public function actionAjaxAfInvoiceImport()
	{
		Yii::app()->cache->delete('pid_'.md5(session_id().'ediInvoiceProgress'));

		$resp = array('success' => 1, 'msg' => 'Imported Successfully');
		if (isset($_FILES) && !empty($_FILES)) {
			$ap_file = empty($_FILES['af_file']) ? array() : $_FILES['af_file'];
			if (empty($ap_file['tmp_name']) || !is_uploaded_file($ap_file['tmp_name'])) {
				$resp['msg'] = 'Invalid template file';
				echo json_encode($resp);
				return;
			} else {
				$filename = $ap_file['name'];
				if (AFInvoiceReconciliationHistory::fileImportedBefore($filename)) {
					if (isset($_POST['overwrite']) && $_POST['overwrite'] == 1) {
						// if agree to overwrite the old one
						$afImportHistorys = AFInvoiceReconciliationHistory::model()->findAll('hash = :hash', [':hash' => md5($filename)]);
						// clear all old data
						foreach ($afImportHistorys as $afImportHistory) {
							$afImportHistory->invoice_total = 0;
							$afImportHistory->success = 0;
							$afImportHistory->failed = 0;
							$oldInvoices = AFInvoiceReconciliation::model()->findAll('history_id = :hid', [':hid' => $afImportHistory->id]);
							foreach ($oldInvoices as $inv) {
								AFInvoiceReconciliationLine::model()->deleteAll('invoice_id = :iid', [':iid' => $inv->id]);
							}
						}
						// AFInvoiceReconciliation::model()->deleteAll('history_id = :hid',[':hid' => $afImportHistory->id] );
					} else {
						$resp['msg'] = 'The file has been imported already, if you want to overwrite them , please tick overwrite checkbox and try again';
						echo json_encode($resp);
						return;
					}
				}

				$ext = pathinfo($filename, PATHINFO_EXTENSION);
				if (strtolower($ext) != 'xlsx') {
					$resp['msg'] = 'Invalid template file please select .xlsx file';
					echo json_encode($resp);
					return;
				} else {
					$this->saveEdiInvoiceProgressFile(2, 'ready to load file');
					$xls = new oExcel;
					$xls->load($ap_file['tmp_name']);

					$this->saveEdiInvoiceProgressFile(5, 'file data uploaded');

					$sheetsArray = $xls->xls->getAllSheets();

					// normally one sheet for one invoice
					$invoiceCount = count($sheetsArray);
					$sheetCount = $invoiceCount;
					$sheetInvoicesFailed = array();
					if ($invoiceCount <= 0) {
						$resp['msg'] = 'No any valid invoice data found';
						echo json_encode($resp);
						return;
					}

					$data = array();
					foreach ($sheetsArray as $n => $sheet) {
						$data[] = $xls->getAll($sheet);
						unset($sheetsArray[$n]);
					}
					unset($xls);

					$this->saveEdiInvoiceProgressFile(8, 'file data loaded');

					$billings = array();
					$allItemsDesc = array(); // save all invoice related item description;
					$errors = array();
					$dates = [];

					$invoiceProcessedCount = 0;
					$sheetIndex = 1;

					$invoiceCount = 0;
					foreach ($data as $k => $invoice) {
						if (count($invoice) <= 1) {
							$errors[] = 'Failed to get invoice data for sheet index: ' . $sheetIndex;
							$sheetInvoicesFailed[] = array('index' => $sheetIndex, 'error' => 'invalid data');
							$sheetIndex++;
							continue; // invalid one
						}
						$sheetIndex++;

						// convert to real invoice number
						// format : TAX INVOICE 00159458
						$invoiceNumber = trim($invoice[3][3]);
						if (empty($invoiceNumber)) {
							$sheetInvoicesFailed[] = array('index' => $sheetIndex - 1, 'error' => 'no invoice number');
							continue;
						}

						$invoiceCount++;
						$invoiceNumber = trim(substr($invoiceNumber, 12));

						$this->saveEdiInvoiceProgressFile((8 + $invoiceProcessedCount / $invoiceCount * 70), ' process invoice : ' . $invoiceNumber);

						// get consignor and consignee
						$consignor = trim($invoice[16][3]);
						$consignee = trim($invoice[16][27]);

						// some time job format will be
						$cref = trim($invoice[18][3], ' /'); // will job id or console id
						$invoiceDate = oExcel::toDate($invoice[7][42]);
						$invoiceDue = oExcel::toDate($invoice[8][42]);

						preg_match_all('!\d+!', $invoiceNumber, $realInvoiceNumber);
						if (empty($realInvoiceNumber)) {
							$sheetInvoicesFailed[] = array('index' => $sheetIndex - 1, 'error' => 'no invoice number');
							continue;
						}
						$invoiceNumber = array_values(array_slice($realInvoiceNumber[0], -1))[0];

						// try to find weight ,volume and etc . value
						$orgin = '';
						$dest = '';
						$weight = 0;
						$volume = 0;
						$chargeWeight = 0;
						$eta = '';
						$etd = '';
						$awb = '';
						for ($i = 10; $i < 40; $i++) {
							$tag = trim($invoice[$i][3]);
							if ($tag == 'BROKER' || substr($tag, 0, 5) == 'OWNER') {
								$weight = preg_replace('/\s*KG$/', '', trim($invoice[$i + 1][26]));
								$volume = preg_replace('/\s*M3$/', '', trim($invoice[$i + 1][27]));
								$chargeWeight = preg_replace('/\s*KG$/', '', trim($invoice[$i + 1][35]));
								$orgin = trim($invoice[$i + 5][3]); // origin location
								$dest = trim($invoice[$i + 5][27]); // destination
								$awb = trim($invoice[$i + 3][27]); // get awb number
								$eta = oExcel::toDate($invoice[$i + 4][46]);
								$etd = oExcel::toDate($invoice[$i + 4][22]);
								break;
							}
						}

						// get all items
						$items = array();
						// try to find description begin line
						$itemLineIndex = 34; // if not found set as default
						for ($index = 12;; $index++) {
							if ($invoice[$index][3] == 'DESCRIPTION') {
								$itemLineIndex = $index + 2; // item lines begin from next 2 lines
								break;
							}
							// avoid dead loop
							if ($index > 80) {
								break;
							}

						}
						$allLineTotal = 0;
						$lineConstCount = 1;
						for ($index = $itemLineIndex;; $index++) {
							if ($index > 200) {
								break;
							}
							// avoid dead loop
							$lineConstCount++;
							if (empty($invoice[$index][3])) {
								if ($lineConstCount++ < 20) {
									continue;
								} else {
									break;
								}

							}
							if ($invoice[$index][34] == 'SUBTOTAL') {
								break;
							}
							// got subtotal line stop

							$desc = trim($invoice[$index][3]);
							$gstAmount = 0;
							if ($gst = preg_match('/^[\d\.\%]+\=([\d\.]+)$/', trim($invoice[$index][34]), $m)) {
								$gstAmount = $m[1];
							}

							$value = floatval($invoice[$index][42]);

							//append desc
							if (empty($invoice[$index][34]) && empty($value)) {
								$items[sizeof($items) - 1]['desc'] .= "\n" . $desc;
								continue;
							}
							$lineSubTotal = $value;
							$lineTotal = $lineSubTotal + $gstAmount;
							$allLineTotal += $lineTotal;
							// currently GL code will be included in item description as below
							/*
							GL 01-Air Freight
							GL 02-Airway Bill Fee
							GL 03-Amendment charge
							GL 04-Destination Documentation Fee
							GL 05-Doc Fee
							GL 06-Export Build Up Fee - GST
							GL 07-Export Documentation Fee - GST FREE
							GL 08-Export Security Fee - GST
							GL 09-Late Cancellation Fee
							GL 10-Manifest Amendment Fee
							GL 11-Terminal Security
							 */

							$glcode = '';
							$chargeCode = '';

							if (preg_match('/^\s*(GL)[\s0]*(\d{1,3})[\s\->]*(.+)$/i', $desc, $m)) {
								$glcode = $m[1] . $m[2];
								$desc = $m[3];
							}

							if (!empty($glcode)) {
								$chargeCodeModel = ChargeItemType::model()->find('code = :code', [':code' => $glcode]);
								if (!empty($chargeCodeModel)) {
									$chargeCode = $chargeCodeModel->charge_code;
								}
							}

							// we should map old priority cargo invoie to our system
							// 'priority carge side' => 'hvlv side'
							$oldMaps = array(
								'GL7' => 'GL5',
								'GL8' => 'GL11',
							);
							if (isset($oldMaps[$glcode])) {
								$glcode = $oldMaps[$glcode];
							}

							$items[] = array('desc' => $desc, 'gst' => $gst, 'chargecode' => $chargeCode, 'glcode' => $glcode, 'value' => $value, 'subtotal' => $lineSubTotal, 'gstamount' => $gstAmount, 'total' => $lineTotal);
							$allItemsDesc[$desc] = 1;
						}
						// Yii::log(json_encode($items), 'error');

						// try to get subtotal , gst and total
						$subtotal = 0;
						$gst = 0;
						$total = 0;
						for ($index = $index;; $index++) {
							if ($invoice[$index][34] == 'SUBTOTAL') {
								$subtotal = floatval(str_replace(',', '', $invoice[$index][41]));
							}
							if ($invoice[$index][34] == 'ADD GST') {
								$gst = floatval(str_replace(',', '', $invoice[$index][41]));
							}
							if ($invoice[$index][34] == 'TOTAL AUD') {
								$total = floatval(str_replace(',', '', $invoice[$index][41]));
								break;
							}

							if ($index > 400) {
								break;
							}
							// avoid dead loop
						}

						// making up billing array
						$billing = array(
							'number' => $invoiceNumber,
							'awb' => $awb,
							'date' => $invoiceDate,
							'due' => $invoiceDue,
							'cnee' => $consignee,
							'cnor' => $consignor,
							'cref' => $cref,
							'orgin' => $orgin,
							'dest' => $dest,
							'eta' => $eta,
							'etd' => $etd,
							'weight' => $weight,
							'chargeWeight' => $chargeWeight,
							'volume' => $volume,
							'subtotal' => $subtotal,
							'gst' => $gst,
							'total' => $total,
							'linetotal' => $allLineTotal,
							'lines' => $items,
						);

						// check to see if we got duplicata invoice by awb
						if (!empty($awb)) {
							$existing = AFInvoiceReconciliation::model()->find('awb = :awb', [':awb' => $awb]);
							if (!empty($existing)) {
								$msg = $invoiceNumber . ' duplicate in : ' . $existing->invoice_no . ' with awb: ' . $awb;
								$sheetInvoicesFailed[] = array('index' => $sheetIndex - 1, 'error' => $msg);
							}
						}

						// save a reconciliation history
						$month = date('m', strtotime($invoiceDate));
						if (!empty($dates[$month])) {
							$invoiceDate = $dates[$month];
						} else {
							$dates[$month] = date('Y-m-d', strtotime($invoiceDate));
						}
						$afImportHistory = AFInvoiceReconciliationHistory::model()->find('hash = :hash AND created = :created', [':hash' => md5($filename), ':created' => $invoiceDate]);
						if (empty($afImportHistory)) {
							$afImportHistory = new AFInvoiceReconciliationHistory();
							$afImportHistory->hash = md5($filename);
							$afImportHistory->created = date('Y-m-d');
							$afImportHistory->attached_file_id = 0;
							$afImportHistory->invoice_total = 0;
							$afImportHistory->failed = 0;
							$afImportHistory->success = 0;
							$afImportHistory->op_id = Yii::app()->user->id;
							$afImportHistory->save();
							$errs = $afImportHistory->getErrors();
							if (!empty($errs)) {
								$msg = '';
								foreach ($errs as $k => $e) {
									$msg .= implode(' ', $e);
								}
								$resp['msg'] = $msg;
								echo json_encode($resp);
								return;
							}

							// save imported billing file
							$attachedFileId = FileRepo::storeFile($ap_file['tmp_name'], $filename, 36, $afImportHistory->id);
							$afImportHistory->attached_file_id = $attachedFileId;
							$afImportHistory->update('attached_file_id');
						}

						// save billing
						$afModel = $afImportHistory->saveBilling($billing, 954);
						$errs = $afModel->getErrors();
						if (!empty($errs)) {
							$msg = '';
							foreach ($errs as $k => $e) {
								$msg .= implode(' ', $e);
							}
							$sheetInvoicesFailed[] = array('index' => $sheetIndex - 1, 'error' => $msg);
						}

						// begin to match the billing with HVLV system
						if ($this->matchAFInvoiceWithHvlv($afModel)) {
							$afImportHistory->success ++;
						} else {
							$afImportHistory->failed ++;
						}

						// update eventually success and failed count
						$afImportHistory->invoice_total++;
						if (!empty($sheetInvoicesFailed)) {
							$afImportHistory->meta = json_encode($sheetInvoicesFailed);
							$afImportHistory->save();
						} else {
							$afImportHistory->invoice_total = $afImportHistory->totalSuccess + $afImportHistory->totalFailed;
							$afImportHistory->update(['failed', 'success', 'invoice_total']);
						}

						$billings[] = $billing;

						// update processing progress
						$invoiceProcessedCount++;
						$this->saveEdiInvoiceProgressFile((8 + $invoiceProcessedCount / $invoiceCount * 70), ' process invoice : ' . $invoiceNumber . ' done');
						$this->saveEdiInvoiceProgressFile((8 + $invoiceProcessedCount / $invoiceCount * 70), ' reading invoice ' . $invoiceProcessedCount . ' /  ' . $invoiceCount . ' processed');

						// release memory in time
						unset($invoice);
						unset($data[$k]);
					}

					// currently only create a report for edi invoice imported
					// $this->createEdiInvoiceImportReportPro($billings,$afImportHistory);

					// update processing progress
					$this->saveEdiInvoiceProgressFile(100, ' report created ');
				}
			}
		} else {
			$resp['success'] = 0;
			$resp['msg'] = 'Invalid billing file';
		}
		echo json_encode($resp);
	}

	/**
	 * @param $billing
	 */
	private function matchAFInvoiceWithHvlv($billing)
	{
		if (empty($billing) || $billing->matched_result == AFInvoiceReconciliation::MATCHED_RESULT_WRONG_REJECTED) {
			return false;
		}

		$result = true;
		// based on billing awb to search related console or job
		// in hvlv awb number will be including dash or not
		$dashAwb = substr($billing->awb, 0, 3) . '-' . substr($billing->awb, 3);
		$job = EdiJob::model()->find('awb = :awb', [':awb' => $dashAwb]);

		$att = 0;
		// check lines content
		if (empty($billing->lines)) {
			$result = false;
			$billing->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_WRONG_LINES_COUNT_NOTMATCHED;
		} else {
			foreach ($billing->lines as $l) {
				$att += $l->amount;
			}
		}

		if (!empty($job)) {

			// get job cost lines related gl code
			$costGlCodes = array();
			$jobCostLines = BillingLine::model()->findAll('billing_ref = :bref AND org_id in (954, 964)', [':bref' => $job->no]);
			// clear nonexist aline
			foreach ($jobCostLines as $line) {
				if (!empty($line->mdata['aline']) && empty(AFInvoiceReconciliationLine::model()->findByPk($line->mdata['aline']))) {
					unset($line->mdata['aline']);
					$line->update('meta');
				}
			}
			// item_code exist and (empty invoice no or invoice no equal)
			$btt = 0;
			foreach ($jobCostLines as $line) {
				if (!empty($line->item_code) && (empty($line->billing_cref) || ($line->billing_cref == $billing->invoice_no))) {
					$costGlCodes[$line->item_code][] = $line;
					$btt += $line->accrual_amount;
				}
			}

			/* check lines count
			if ( count($billing->lines) > count($costGlCodes) ) {
			$billing->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_WRONG_LINES_COUNT_NOTMATCHED;
			$result = false;
			}
			 */
			// if($att < $btt * 0.8 || $att > $btt * 1.05){
			foreach ($billing->lines as $line) {
				if (!isset($costGlCodes[$line->glcode]) && !empty($_POST['linematch'])) {
					$billing->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_WRONG_LINES_GLCODE_NOTMATCHED;
					$result = false;
				} else if (isset($costGlCodes[$line->glcode])) {
					// we update actual cost
					$flag = 1;
					// check same invoice_no and actual_amount line with aline
					foreach ($costGlCodes[$line->glcode] as $jbCostLine) {
						if (($jbCostLine->billing_cref == $billing->invoice_no) && (floatval($jbCostLine->actual_amount) == floatval($line->amount)) && !empty($jbCostLine->mdata['aline']) && ($jbCostLine->mdata['aline'] == $line->id)) {
							$flag = 0;
						}
					}

					// set same invoice_no and actual_amount line with aline
					if ($flag) {
						foreach ($costGlCodes[$line->glcode] as $jbCostLine) {
							if (($jbCostLine->billing_cref == $billing->invoice_no) && (floatval($jbCostLine->actual_amount) == floatval($line->amount)) && empty($jbCostLine->mdata['aline'])) {
								$jbCostLine->mdata['aline'] = $line->id;
								$jbCostLine->org_id = 954;
								$jbCostLine->update('meta', 'org_id');
								$flag = 0;
								break;
							}
						}
					}

					// set same invoice_no line with info
					if ($flag) {
						foreach ($costGlCodes[$line->glcode] as $jbCostLine) {
							if (empty($jbCostLine->billing_cref)) {
								$jbCostLine->actual_amount = $line->amount;
								$jbCostLine->billing_cref = $billing->invoice_no;
								if ($line->gst > 0) {
									$jbCostLine->gst = 'INPUT';
								} else {
									$jbCostLine->gst = 'EXEMPTEXPENSES';
								}
								$jbCostLine->mdata['aline'] = $line->id;
								$jbCostLine->gst_amount = $jbCostLine->getGSTValue();
								$jbCostLine->org_id = 954;
								$jbCostLine->status = 1;
								$jbCostLine->update('actual_amount', 'billing_cref', 'gst', 'meta', 'gst_amount', 'org_id');
								$flag = 0;
								break;
							}
						}
					}

					// no same invoice_no line
					if ($flag) {
						$bl = new BillingLine;
						$bl->billing_id = 0;
						$bl->org_id = 954;
						$bl->op_id = $billing->op;
						$bl->link_id = $job->id;
						$bl->created = date('Y-m-d');
						$bl->date = date('Y-m-d');
						$bl->due = $bl->date;
						$bl->transaction_date = $bl->date;
						$bl->type = $job->dpmt / 10;
						$bl->dpmt = $job->dpmt;
						if ($line->gst > 0) {
							$bl->gst = 'INPUT';
						} else {
							$bl->gst = 'EXEMPTEXPENSES';
						}
						$bl->status = 1;
						$bl->billing_cref = $billing->invoice_no;
						$bl->billing_ref = $job->no;
						$bl->awb = $job->awb;
						$bl->dpt_id = $job->dpt_id;
						$bl->currency = 1;
						$bl->actual_amount = $line->amount;
						$bl->accrual_amount = 0;
						$bl->gst_amount = $line->gst;
						if ($line->glcode) {
							$charge_item_type = ChargeItemType::model()->find('code = :code', array(':code' => $line->glcode));
							if ($charge_item_type) {
								if ($job->dpmt == 30) {
									$bl->charge_code = $charge_item_type->cost_code;
								} else if ($job->dpmt == 40) {
									$bl->charge_code = $charge_item_type->pl_cost_code;
								}
							}
						}
						$bl->desc = $line->desc;
						$bl->qty = 1;
						$bl->item_code = $line->glcode;
						$bl->price = 0;
						$bl->weight = 0;
						$bl->charge_weight = 0;
						$bl->sync_xero = 0;
						$bl->mdata['aline'] = $line->id;
						$bl->save();
					}
				} else {
					$bls = BillingLine::model()->findAll('billing_cref = :billing_cref AND billing_ref = :billing_ref AND `desc` = :desc AND org_id in (954, 964)', array(':billing_cref' => $billing->invoice_no, ':billing_ref' => $job->no, ':desc' => $line->desc));

					// check same invoice_no and desc with aline
					$flag = 1;
					foreach ($bls as $bl) {
						if (!empty($bl->mdata['aline']) && $bl->mdata['aline'] == $line->id) {
							$flag = 0;
						}
					}

					// set same invoice_no and desc with aline
					if ($flag) {
						foreach ($bls as $bl) {
							if (empty($bl->mdata['aline'])) {
								$bl->mdata['aline'] = $line->id;
								$bl->org_id = 954;
								$bl->update('meta', 'org_id');
							}
						}
					}

					if ($flag) {
						$bl = new BillingLine;
						$bl->billing_id = 0;
						$bl->org_id = 954;
						$bl->op_id = $billing->op;
						$bl->link_id = $job->id;
						$bl->created = date('Y-m-d');
						$bl->date = date('Y-m-d');
						$bl->due = $bl->date;
						$bl->transaction_date = $bl->date;
						$bl->type = $job->dpmt / 10;
						$bl->dpmt = $job->dpmt;
						if ($line->gst > 0) {
							$bl->gst = 'INPUT';
						} else {
							$bl->gst = 'EXEMPTEXPENSES';
						}
						$bl->status = 1;
						$bl->billing_cref = $billing->invoice_no;
						$bl->billing_ref = $job->no;
						$bl->awb = $job->awb;
						$bl->dpt_id = $job->dpt_id;
						$bl->currency = 1;
						$bl->actual_amount = $line->amount;
						$bl->accrual_amount = 0;
						$bl->gst_amount = $line->gst;
						if ($line->glcode) {
							$charge_item_type = ChargeItemType::model()->find('code = :code', array(':code' => $line->glcode));
							if ($charge_item_type) {
								if ($job->dpmt == 30) {
									$bl->charge_code = $charge_item_type->cost_code;
								} else if ($job->dpmt == 40) {
									$bl->charge_code = $charge_item_type->pl_cost_code;
								}
							}
						}
						$bl->desc = $line->desc;
						$bl->qty = 1;
						$bl->item_code = @$line->glcode;
						$bl->price = 0;
						$bl->weight = 0;
						$bl->charge_weight = 0;
						$bl->sync_xero = 0;
						$bl->mdata['aline'] = $line->id;
						$bl->save();
					}
				}
			}
			if (abs($att) < abs($btt) * 0.8 || ($att - $btt) > 50 || abs($att) > abs($btt) * 1.05) {
				$extra_billing_lines = BillingLine::model()->findAll('billing_ref = :billing_ref AND billing_cref != :billing_cref AND org_id in (954, 964)', array(':billing_ref' => $job->no, ':billing_cref' => $billing->invoice_no));
				$ctt = 0;
				$dtt = 0;
				if (!empty($extra_billing_lines)) {
					foreach ($extra_billing_lines as $line) {
						if (!empty($line->billing_cref)) {
							$ctt += $line->actual_amount;
							$dtt += $line->accrual_amount;
						}
					}
				}
				if (abs($att + $ctt) < abs($btt + $dtt) * 0.8 || ($att + $ctt - $btt - $dtt) > 50 || abs($att + $ctt) > abs($btt + $dtt) * 1.05) {
					$billing->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_WRONG_DIFF_TOOBIG;
					$billing->mdata['nt'] = 'diff ' . number_format($att + $ctt - $btt - $dtt, 2) . '; combine with other invoices';
					$result = false;
				} else {
					$billing->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_SUCCESS;
					$billing->mdata['nt'] = 'without line match and combine other invoices';
				}
			} else {
				if ($result) {
					$billing->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_SUCCESS;
					if (empty($_POST['linematch'])) {
						$billing->mdata['nt'] = 'without line match';
					}
				}
			}

			// update them
			$billing->model = 'EdiJob';
			$billing->fid = $job->id;
			$billing->op = $job->user_id;
			$billing->save();
		} else {
			$consol = ExcoConsol::model()->find('awb = :awb', [':awb' => $dashAwb]);
			if (!empty($consol)) {

				// get exco consol billing lines
				$costGlCodes = array();
				$ecxoBillings = BillingLine::model()->findAll('billing_ref = :bref AND org_id in (954, 964)', [':bref' => $consol->no]);
				foreach ($ecxoBillings as $line) {
					if (!empty($line->mdata['aline']) && empty(AFInvoiceReconciliationLine::model()->findByPk($line->mdata['aline']))) {
						unset($line->mdata['aline']);
						$line->update('meta');
					}
				}
				$btt = 0;
				foreach ($ecxoBillings as $line) {
					if (!empty($line->item_code) && (empty($line->billing_cref) || ($line->billing_cref == $billing->invoice_no))) {
						$costGlCodes[$line->item_code][] = $line;
						$btt += $line->accrual_amount;
					}
				}

				// if(($att < $btt * 0.8 || $att > $btt * 1.1) && abs($att-$btt) > 10){
				foreach ($billing->lines as $line) {
					if (!isset($costGlCodes[$line->glcode]) && !empty($_POST['linematch'])) {
						$billing->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_WRONG_LINES_GLCODE_NOTMATCHED;
						$result = false;
					} else if (isset($costGlCodes[$line->glcode])) {
						// we update actual cost
						$flag = 1;
						// check same invoice_no and actual_amount line with aline
						foreach ($costGlCodes[$line->glcode] as $excoCostLine) {
							if (($excoCostLine->billing_cref == $billing->invoice_no) && (floatval($excoCostLine->actual_amount) == floatval($line->amount)) && !empty($excoCostLine->mdata['aline']) && ($excoCostLine->mdata['aline'] == $line->id)) {
								$flag = 0;
							}
						}

						// set same invoice_no and actual_amount line with aline
						if ($flag) {
							foreach ($costGlCodes[$line->glcode] as $excoCostLine) {
								if (($excoCostLine->billing_cref == $billing->invoice_no) && (floatval($excoCostLine->actual_amount) == floatval($line->amount)) && empty($excoCostLine->mdata['aline'])) {
									$excoCostLine->mdata['aline'] = $line->id;
									$excoCostLine->org_id = 954;
									$excoCostLine->update('meta', 'org_id');
									$flag = 0;
									break;
								}
							}
						}

						// set same invoice_no line with info
						if ($flag) {
							foreach ($costGlCodes[$line->glcode] as $excoCostLine) {
								if (empty($excoCostLine->billing_cref)) {
									$excoCostLine->actual_amount = $line->amount;
									$excoCostLine->billing_cref = $billing->invoice_no;
									if ($line->gst > 0) {
										$excoCostLine->gst = 'INPUT';
									} else {
										$excoCostLine->gst = 'EXEMPTEXPENSES';
									}
									$excoCostLine->mdata['aline'] = $line->id;
									$excoCostLine->gst_amount = $excoCostLine->getGSTValue();
									$excoCostLine->org_id = 954;
									$excoCostLine->status = 1;
									$excoCostLine->update('actual_amount', 'billing_cref', 'gst', 'meta', 'gst_amount', 'org_id');
									$flag = 0;
									break;
								}
							}
						}

						// no same invoice_no line
						if ($flag) {
							$bl = new BillingLine;
							$bl->billing_id = 0;
							$bl->org_id = 954;
							$bl->op_id = $billing->op;
							$bl->link_id = $consol->id;
							$bl->created = date('Y-m-d');
							$bl->date = date('Y-m-d');
							$bl->due = $bl->date;
							$bl->transaction_date = $bl->date;
							$bl->type = BillingLine::BILLING_TYPE_EXPORT;
							$bl->dpmt = Invoice::DPMT_EXPORT;
							if ($line->gst > 0) {
								$bl->gst = 'INPUT';
							} else {
								$bl->gst = 'EXEMPTEXPENSES';
							}
							$bl->status = 1;
							$bl->billing_cref = $billing->invoice_no;
							$bl->billing_ref = $consol->no;
							$bl->awb = $consol->awb;
							$bl->dpt_id = $consol->dpt_id;
							$bl->currency = 1;
							$bl->actual_amount = $line->amount;
							$bl->accrual_amount = 0;
							$bl->gst_amount = $line->gst;
							if ($line->glcode) {
								$charge_item_type = ChargeItemType::model()->find('code = :code', array(':code' => $line->glcode));
								if ($charge_item_type) {
									$bl->charge_code = $charge_item_type->cost_code;
								}
							}
							$bl->desc = $line->desc;
							$bl->qty = 1;
							$bl->item_code = $line->glcode;
							$bl->price = 0;
							$bl->weight = 0;
							$bl->charge_weight = 0;
							$bl->sync_xero = 0;
							$bl->mdata['aline'] = $line->id;
							$bl->save();
						}
					} else {
						$bls = BillingLine::model()->findAll('billing_cref = :billing_cref AND billing_ref = :billing_ref AND `desc` = :desc AND org_id in (954, 964)', array(':billing_cref' => $billing->invoice_no, ':billing_ref' => $consol->no, ':desc' => $line->desc));

						// check same invoice_no and desc with aline
						$flag = 1;
						foreach ($bls as $bl) {
							if (!empty($bl->mdata['aline']) && $bl->mdata['aline'] == $line->id) {
								$flag = 0;
							}
						}

						// set same invoice_no and desc with aline
						if ($flag) {
							foreach ($bls as $bl) {
								if (empty($bl->mdata['aline'])) {
									$bl->mdata['aline'] = $line->id;
									$bl->org_id = 954;
									$bl->update('meta', 'org_id');
								}
							}
						}

						if ($flag) {
							$bl = new BillingLine;
							$bl->billing_id = 0;
							$bl->org_id = 954;
							$bl->op_id = $billing->op;
							$bl->link_id = $consol->id;
							$bl->created = date('Y-m-d');
							$bl->date = date('Y-m-d');
							$bl->due = $bl->date;
							$bl->transaction_date = $bl->date;
							$bl->type = BillingLine::BILLING_TYPE_EXPORT;
							$bl->dpmt = Invoice::DPMT_EXPORT;
							if ($line->gst > 0) {
								$bl->gst = 'INPUT';
							} else {
								$bl->gst = 'EXEMPTEXPENSES';
							}
							$bl->status = 1;
							$bl->billing_cref = $billing->invoice_no;
							$bl->billing_ref = $consol->no;
							$bl->awb = $consol->awb;
							$bl->dpt_id = $consol->dpt_id;
							$bl->currency = 1;
							$bl->actual_amount = $line->amount;
							$bl->accrual_amount = 0;
							$bl->gst_amount = $line->gst;
							if ($line->glcode) {
								$charge_item_type = ChargeItemType::model()->find('code = :code', array(':code' => $line->glcode));
								if ($charge_item_type) {
									$bl->charge_code = $charge_item_type->cost_code;
								}
							}
							$bl->desc = $line->desc;
							$bl->qty = 1;
							$bl->item_code = @$line->glcode;
							$bl->price = 0;
							$bl->weight = 0;
							$bl->charge_weight = 0;
							$bl->sync_xero = 0;
							$bl->mdata['aline'] = $line->id;
							$bl->save();
						}
					}
				}
				if (abs($att) < abs($btt) * 0.8 || ($att - $btt) > 50 || abs($att) > abs($btt) * 1.05) {
					$extra_billing_lines = BillingLine::model()->findAll('billing_ref = :billing_ref AND billing_cref != :billing_cref AND org_id in (954, 964)', array(':billing_ref' => $consol->no, ':billing_cref' => $billing->invoice_no));
					$ctt = 0;
					$dtt = 0;
					if (!empty($extra_billing_lines)) {
						foreach ($extra_billing_lines as $line) {
							if (!empty($line->billing_cref)) {
								$ctt += $line->actual_amount;
								$dtt += $line->accrual_amount;
							}
						}
					}
					if (abs($att + $ctt) < abs($btt + $dtt) * 0.8 || ($att + $ctt - $btt - $dtt) > 50 || abs($att + $ctt) > abs($btt + $dtt) * 1.05) {
						$billing->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_WRONG_DIFF_TOOBIG;
						$billing->mdata['nt'] = 'diff ' . number_format($att + $ctt - $btt - $dtt, 2) . '; combine with other invoices';
						$result = false;
					} else {
						$billing->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_SUCCESS;
						$billing->mdata['nt'] = 'without line match and combine other invoices';
					}
				} else {
					if ($result) {
						$billing->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_SUCCESS;
						if (empty($_POST['linematch'])) {
							$billing->mdata['nt'] = 'without line match';
						}
					}
				}

				// update them
				$billing->model = 'ExcoConsol';
				$billing->fid = $consol->id;
				$billing->op = Log::getExconsolCreateUserID($consol->id);
				$billing->save();

			} else {
				$blines = BillingLine::model()->findAll('billing_cref = :billing_cref AND org_id in (954, 964)', array(':billing_cref' => $billing->invoice_no));
				if (!empty($blines)) {
					$btt = 0;
					foreach ($blines as $bline) {
						$btt += $bline->accrual_amount;
					}
					$billing->op = $bline->op_id;
					if (abs($att) < abs($btt) * 0.8 || ($att - $btt) > 50 || abs($att) > abs($btt) * 1.05) {
						$billing->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_WRONG_DIFF_TOOBIG_PREIMPORT;
						$billing->mdata['nt'] = 'diff ' . number_format($att - $btt, 2);
						$result = false;
					} else {
						$billing->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_SUCCESS;
						$billing->mdata['nt'] = 'pre-imported';
					}
				} else {
					$bill = Billing::model()->find('billing_cref = :billing_cref AND org_id in (954, 964)', array(':billing_cref' => $billing->invoice_no));
					if (!empty($bill)) {
						$btt = 0;
						foreach ($bill->lines as $bline) {
							$btt += $bline->accrual_amount;
						}
						$billing->op = Log::getBillingCreateUserID($bill->id);
						if (abs($att) < abs($btt) * 0.8 || ($att - $btt) > 50 || abs($att) > abs($btt) * 1.05) {
							$billing->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_WRONG_DIFF_TOOBIG_PREIMPORT;
							$billing->mdata['nt'] = 'diff ' . number_format($att - $btt, 2);
							$result = false;
						} else {
							$billing->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_SUCCESS;
							$billing->mdata['nt'] = 'pre-imported';
						}
					} else {
						$billing->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_WRONG_AWB_NOTFOUND;
						$result = false;
					}
				}
				$billing->save();
			}
		}
		return $result;
	}

	public function actionAjaxTneInvoiceImport()
	{
		Yii::app()->cache->delete('pid_'.md5(session_id().'ediInvoiceProgress'));

		$resp = array('success' => 1, 'msg' => 'Imported Successfully');
		if (isset($_FILES) && !empty($_FILES)) {
			$ap_file = empty($_FILES['af_file']) ? array() : $_FILES['af_file'];
			if (empty($ap_file['tmp_name']) || !is_uploaded_file($ap_file['tmp_name'])) {
				$resp['msg'] = 'Invalid template file';
				echo json_encode($resp);
				return;
			} else {
				$filename = $ap_file['name'];
				if (AFInvoiceReconciliationHistory::fileImportedBefore($filename)) {
					if (isset($_POST['overwrite']) && $_POST['overwrite'] == 1) {
						// if agree to overwrite the old one
						$afImportHistory = AFInvoiceReconciliationHistory::model()->find('hash = :hash', [':hash' => md5($filename)]);
						// clear all old data
						$oldInvoices = AFInvoiceReconciliation::model()->findAll('history_id = :hid', [':hid' => $afImportHistory->id]);
						foreach ($oldInvoices as $inv) {
							AFInvoiceReconciliationLine::model()->deleteAll('invoice_id = :iid', [':iid' => $inv->id]);
						}
						AFInvoiceReconciliation::model()->deleteAll('history_id = :hid', [':hid' => $afImportHistory->id]);
					} else {
						$resp['msg'] = 'The file has been imported already, if you want to overwrite them , please tick overwrite checkbox and try again';
						echo json_encode($resp);
						return;
					}
				}

				$ext = pathinfo($filename, PATHINFO_EXTENSION);
				if (strtolower($ext) != 'xlsx') {
					$resp['msg'] = 'Invalid template file please select .xlsx file';
					echo json_encode($resp);
					return;
				} else {
					$this->saveEdiInvoiceProgressFile(2, 'ready to load file');
					$xls = new oExcel;
					$xls->load($ap_file['tmp_name']);

					$this->saveEdiInvoiceProgressFile(5, 'file data uploaded');

					$sheetsArray = $xls->xls->getAllSheets();

					// normally one sheet for one invoice
					$invoiceCount = count($sheetsArray);
					$sheetCount = $invoiceCount;
					$sheetInvoicesFailed = array();
					if ($invoiceCount != 1) {
						$resp['msg'] = 'No any valid invoice data found';
						echo json_encode($resp);
						return;
					}

					$data = array();
					foreach ($sheetsArray as $n => $sheet) {
						$data[] = $xls->getAll($sheet);
						unset($sheetsArray[$n]);
					}
					unset($xls);

					$this->saveEdiInvoiceProgressFile(8, 'file data loaded');

					$billings = array();
					$allItemsDesc = array(); // save all invoice related item description;
					$errors = array();
					$successInvoices = 0;
					$failedInvoices = 0;

					$invoiceProcessedCount = 0;
					$sheetIndex = 1;

					// save a reconciliation history
					if (empty($afImportHistory)) {
						$afImportHistory = new AFInvoiceReconciliationHistory();
						$afImportHistory->hash = md5($filename);
						$afImportHistory->created = date('Y-m-d');
						$afImportHistory->op_id = Yii::app()->user->id;
					}
					$afImportHistory->attached_file_id = 0;
					$afImportHistory->invoice_total = $invoiceCount;
					$afImportHistory->failed = 0;
					$afImportHistory->success = 0;
					$afImportHistory->save();
					$errs = $afImportHistory->getErrors();
					if (!empty($errs)) {
						$msg = '';
						foreach ($errs as $k => $e) {
							$msg .= implode(' ', $e);
						}
						$resp['msg'] = $msg;
						echo json_encode($resp);
						return;
					}

					// save imported billing file
					$attachedFileId = FileRepo::storeFile($ap_file['tmp_name'], $filename, 36, $afImportHistory->id);
					$afImportHistory->attached_file_id = $attachedFileId;
					$afImportHistory->update('attached_file_id');

					$invoiceCount = 0;
					foreach ($data as $k => $invoice) {
						if (count($invoice) <= 1) {
							$errors[] = 'Failed to get invoice data for sheet index: ' . $sheetIndex;
							$sheetInvoicesFailed[] = array('index' => $sheetIndex, 'error' => 'invalid data');
							$sheetIndex++;
							continue; // invalid one
						}
						$sheetIndex++;

						// invoice no
						preg_match('/Invoice[#]*\s*(:|：)\s*(IV\d+|INV-\d+)/i', $invoice[2][1], $matches);
						if (!empty($matches[2])) {
							$invoiceNumber = trim($matches[2]);
						}

						// get consigner and consignee
						$consignor = trim($invoice[1][1]);
						// if (empty($consignor)) {
						// 	// manual template
						// 	$consignor = trim($invoice[4][1]) . ' ' . trim($invoice[5][1]) . ' ' . trim($invoice[6][1]) . ' ' . trim($invoice[7][1]);
						// }
						if (empty($consignor)) {
							// default
							$consignor = 'TE EXPRESS Phone: 1300927119 ACCOUNT@TNEGROUP.COM.AU ABN: 17 420 495 098';
						}

						preg_match('/Bill to:\n(([\w]+|\s|\/)+)/i', $invoice[3][1], $matches);
						if (!empty($matches[1])) {
							$consignee = trim($matches[1]);
						}
						// if (empty($consignee)) {
						// 	// manual template
						// 	$consignee = trim($invoice[11][1]) . ' ' . trim($invoice[12][1]) . ' ' . trim($invoice[13][1]) . ' ' . trim($invoice[14][1]);
						// }
						if (empty($consignee)) {
							// default
							$consignee = 'TOP LOGISTICS 6C THE CRESCENT KINGSGROVE 2208 NSW Australia';
						}

						// date
						preg_match_all('/Invoice date\s*:\s*(([\d]+|\/)+)/i', $invoice[2][1], $matches);
						if (!empty($matches[1][0])) {
							$date = explode('/', $matches[1][0]);
							$date = array_reverse($date);
							$invoiceDate = implode('-', $date);
							// $invoiceDate = date('Y-m-d', strtotime($matches[1][0]));
						}
						if (empty($invoiceDate)) {
							// manual template
							preg_match_all('/Invoice date: (([\d]+|\/)+)/i', $invoice[9][1], $matches);
							if (!empty($matches[1][0])) {
								$date = explode('/', $matches[1][0]);
								$date = array_reverse($date);
								$invoiceDate = implode('-', $date);
								// $invoiceDate = date('Y-m-d', strtotime($matches[1][0]));
							}
						}

						// due date
						if (sizeof(array_values(array_filter($invoice[3]))) > 1) {
							preg_match('/Due Date:\n(([\d]+|\/)+)/i', array_values(array_filter($invoice[3]))[1], $matches);
							if (!empty($matches[1])) {
								$date = explode('/', $matches[1]);
								$date = array_reverse($date);
								$invoiceDue = implode('-', $date);
							}
							if (empty($invoiceDue)) {
								// manual template
								preg_match('/(([\d]+|\/)+)/', $invoice[16][1], $matches);
								if (!empty($matches[1])) {
									$date = explode('/', $matches[1]);
									$date = array_reverse($date);
									$invoiceDue = implode('-', $date);
									// $invoiceDue = date('Y-m-d', strtotime($matches[1][0]));
								}
							}
						}
						if (empty($invoiceDue)) {
							$invoiceDue = $invoiceDate;
						}

						foreach ($invoice as $k => $line) {
							if ($k > 1000) {
								break;
							}

							// filter empty and first cell for 7
							$line = array_values(array_filter($line));
							if (sizeof($line) === 7) {
								unset($line[0]);
								$line = array_values($line);
							}

							if (sizeof($line) === 6 && !in_array('ITEM', $line) && !in_array('Item & Description', $line)) {
								$af = new AFInvoiceReconciliation;
								$af->supplier_id = 1133;
								$af->history_id = $afImportHistory->id;
								$af->invoice_no = $invoiceNumber;
								$af->date = $invoiceDate;
								$af->due = $invoiceDue;
								$af->created = $invoiceDate;
								$af->cnee = substr($consignee, 0, 100);
								$af->cnor = substr($consignor, 0, 100);
								$od = explode('-', $line[0]);
								$af->origin = count($od) === 2 ? trim($od[0]) : $od[0];
								$af->dest = count($od) === 2 ? trim($od[1]) : $od[0];
								$af->weight = 0;
								$af->charge_weight = 0;
								$af->volume = 0;
								$af->subtotal = intval($line[5] * 100) / 100;
								$af->gst = ($line[4] === 'GST') ? number_format(round(intval($line[5] * 10)) / 100, 2) : 0;
								// new version
								if (is_numeric($line[4])) {
									$af->subtotal = intval($line[3] * 100) / 100;
									$af->gst = number_format(round(intval($line[3] * 10)) / 100, 2);
								}
								$af->total = number_format($af->subtotal + $af->gst, 2, '.', '');
								$af->matched_result = 0;
								$af->op = 0;
								$af->save();
								if (!empty($af->getErrors())) {
									foreach ($af->getErrors() as $k => $v) {
										yii::log($k . ' ' . $af->attributes[$k] . ' ' . json_encode($v), 'warning');
									}
								}

								$afl = new AFInvoiceReconciliationLine;
								$afl->invoice_id = $af->id;
								$afl->desc = $line[0];
								$afl->gst = $af->gst;
								$afl->glcode = 'GL8';
								$afl->amount = $af->subtotal;
								$afl->save();
								if (!empty($afl->getErrors())) {
									foreach ($afl->getErrors() as $k => $v) {
										yii::log($k . ' ' . $afl->attributes[$k] . ' ' . json_encode($v), 'warning');
									}
								}
							} else if (sizeof($line) === 1) {
								if (preg_match('/[\d]{3}\-[\d]{8}/', $line[0], $matches)) {
									if (!empty($af) && !empty($afl)) {
										$af->awb = str_replace('-', '', $matches[0]);
										$af->mdata['model'][] = ['awb' => $af->awb];
										$af->save();

										$afl->desc .= ' ' . $matches[0];
										$afl->save();
									}
								} else if (preg_match('/(JB\d+\w+)/', $line[0], $matches)) {
									if (!empty($af) && !empty($afl)) {
										$af->mdata['model'][] = ['awb' => $matches[0]];
										$af->save();

										$afl->desc .= ' ' . $matches[0];
										$afl->save();
									}
								} else if (preg_match('/(([\d]+|\/)+)/', $line[0], $matches)) {
									if (!empty($af) && !empty($afl)) {
										$afl->desc .= ' ' . $matches[0];
										if (preg_match('/(43\d{3})/', $matches[0], $m)) {
											$afl->desc = str_replace($m[1], ' ' . date('Y-m-d', strtotime(oExcel::toDate($m[1]))), $afl->desc);
										}
										$afl->save();
									}
								} else {
									if (!empty($af) && !empty($afl)) {
										$afl->desc .= ' ' . $line[0];
										$afl->save();
									}
								}
							} else if (sizeof($line) === 2) {
								foreach ($line as $item) {
									if (preg_match('/Sub\-Total/i', $item)) {
										break 2;
									}
								}
							}

							if (!empty($af) && !empty($afl) && empty($af->awb)) {
								if (preg_match('/[\d]{3}\-[\d]{8}/', $afl->desc, $matches)) {
									$af->awb = str_replace('-', '', $matches[0]);
									$af->mdata['model'][] = ['awb' => $af->awb];
									$af->save();
								} else if (preg_match('/(JB\d+\w+)/', $afl->desc, $matches)) {
									$af->awb = str_replace('-', '', $matches[0]);
									$af->mdata['model'][] = ['awb' => $af->awb];
									$af->save();
								}
							}
						}
					}

					$afinvoices = $afImportHistory->af;
					$invoiceCount = count($afinvoices);
					foreach ($afinvoices as $af) {
						if ($this->matchTneInvoiceWithHvlv($af)) {
							$successInvoices++;
						} else {
							$failedInvoices++;
						}
					}

					// update eventually success and failed count
					$afImportHistory->failed = $failedInvoices;
					$afImportHistory->success = $successInvoices;
					$afImportHistory->invoice_total = $invoiceCount;
					$afImportHistory->created = date('Y-m-d');
					if (!empty($sheetInvoicesFailed)) {
						$afImportHistory->meta = json_encode($sheetInvoicesFailed);
						$afImportHistory->save();
					} else {
						$afImportHistory->update(['failed', 'success', 'invoice_total', 'created']);
					}

					// update processing progress
					$this->saveEdiInvoiceProgressFile(100, ' report created ');
				}
			}
		} else {
			$resp['success'] = 0;
			$resp['msg'] = 'Invalid billing file';
		}
		echo json_encode($resp);
	}

	public function matchTneInvoiceWithHvlv($af)
	{
		if (empty($af)|| $af->matched_result == AFInvoiceReconciliation::MATCHED_RESULT_WRONG_REJECTED) {
			return false;
		}

		if (!empty($af) && !empty($af->lines[0]) && empty($af->awb)) {
			$afl = $af->lines[0];
			if (preg_match('/[\d]{3}\-[\d]{8}/', $afl->desc, $matches)) {
				$af->awb = str_replace('-', '', $matches[0]);
				$af->mdata['model'][] = ['awb' => $af->awb];
				$af->save();
			} else if (preg_match('/(JB\d+\w+)/', $afl->desc, $matches)) {
				$af->awb = str_replace('-', '', $matches[0]);
				$af->mdata['model'][] = ['awb' => $af->awb];
				$af->save();
			}
		}

		$result = true;

		if (empty($af->mdata['model'])) {
			$af->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_WRONG_AWB_NOTFOUND;
			$af->update(['matched_result']);
			$result = false;
		} else {
			$att = $af->subtotal;
			$btt = 0;
			foreach ($af->mdata['model'] as $k => $model) {
				$dashAwb = substr($model['awb'], 0, 3) . '-' . substr($model['awb'], 3);

				$noline = true;
				// check EdiJob
				$job = EdiJob::model()->find('awb like :awb OR no = :no', [':awb' => '%' . $dashAwb . '%', ':no' => $model['awb']]);
				if (!empty($job)) {
					$billingLines = BillingLine::model()->findAll('billing_ref = :bref AND org_id = 1133 AND item_code in ("GL8", "GL7", "GL13")', [':bref' => $job->no]);
					$count = 0;
					foreach ($billingLines as $line) {
						if (!empty($line->mdata['aline']) && $line->mdata['aline'] != $af->lines[0]->id) {
							$otheraf = AFInvoiceReconciliationLine::model()->findByPk($line->mdata['aline']);
							if (empty($otheraf)) {
								$count ++;
							}
						} else {
							$count ++;
						}
					}
					foreach ($billingLines as $line) {
						if (!empty($line->mdata['aline']) && $line->mdata['aline'] != $af->lines[0]->id) {
							$otheraf = AFInvoiceReconciliationLine::model()->findByPk($line->mdata['aline']);
							if (!empty($otheraf)) {
								continue;
							}
						}
						// avoid occupy all invoices
						if ($att == 0) {
							break;
						}
						$btt += $line->accrual_amount;
						sort($af->mdata['model']);
						$line->actual_amount = ($k != count($af->mdata['model']) - 1 || $count-- != 1) ? min($line->accrual_amount, $att) : $att;
						$line->gst_amount = $line->getGSTValue();
						$line->mdata['aline'] = $af->lines[0]->id;
						$line->billing_cref = $af->invoice_no;
						$line->status = 2;
						$line->update('actual_amount', 'meta', 'billing_cref', 'gst_amount', 'status');
						$att -= $line->actual_amount;
						$noline = false;
					}
					$af->mdata['model'][$k] = ['awb' => $model['awb'], 'model' => 'EdiJob', 'id' => $job->id];
					$af->op = $job->user_id;
				}

				// check ExcoConsol
				$exco = ExcoConsol::model()->find('awb like :awb OR no = :no', [':awb' => '%' . $dashAwb . '%', ':no' => $model['awb']]);
				if (!$noline && !empty($exco)) {
					$billingLines = BillingLine::model()->findAll('billing_ref = :bref AND org_id = 1133 AND item_code in ("GL8", "GL7", "GL13")', [':bref' => $exco->no]);
					$count = 0;
					foreach ($billingLines as $line) {
						if (!empty($line->mdata['aline']) && $line->mdata['aline'] != $af->lines[0]->id) {
							$otheraf = AFInvoiceReconciliationLine::model()->findByPk($line->mdata['aline']);
							if (empty($otheraf)) {
								$count ++;
							}
						} else {
							$count ++;
						}
					}
					foreach ($billingLines as $j => $line) {
						if (!empty($line->mdata['aline']) && $line->mdata['aline'] != $af->lines[0]->id) {
							$otheraf = AFInvoiceReconciliationLine::model()->findByPk($line->mdata['aline']);
							if (!empty($otheraf)) {
								continue;
							}
						}
						// avoid occupy all invoices
						if ($att == 0) {
							break;
						}
						$btt += $line->accrual_amount;
						$line->actual_amount = ($k != count($af->mdata['model']) - 1 || $count-- != 1) ? min($line->accrual_amount, $att) : $att;
						$line->gst_amount = $line->getGSTValue();
						$line->mdata['aline'] = $af->lines[0]->id;
						$line->billing_cref = $af->invoice_no;
						$line->status = 2;
						$line->update('actual_amount', 'meta', 'billing_cref', 'gst_amount', 'status');
						$att -= $line->actual_amount;
						$noline = false;
					}
					$af->mdata['model'][$k] = ['awb' => $model['awb'], 'model' => get_class($exco), 'id' => $exco->id];
					$af->op = Log::getExconsolCreateUserID($exco->id);
				}

				if (!$noline) {
					$af->awb = $model['awb'];
				}
			}

			if ($af->subtotal <= $btt) {
				$af->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_SUCCESS;
				unset($af->mdata['nt']);
			} else if ($btt > 0 || !$noline) {
				$af->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_WRONG_DIFF_TOOBIG;
				$result = false;
			} else if ($noline) {
				$bl = new BillingLine;
				$bl->billing_id = 0;
				$bl->org_id = 1133;
				$bl->op_id = $af->op;
				if (!empty($job)) {
					$bl->link_id = $job->id;
					$bl->type = $job->dpmt / 10;
					$bl->dpmt = $job->dpmt;
					$bl->billing_ref = $job->no;
					$bl->awb = $job->awb;
					$bl->dpt_id = $job->dpt_id;
					$bl->currency = 1;
					if ($af->lines[0]->glcode) {
						$charge_item_type = ChargeItemType::model()->find('code = :code', array(':code' => $af->lines[0]->glcode));
						if ($charge_item_type) {
							if ($job->dpmt == 30) {
								$bl->charge_code = $charge_item_type->cost_code;
							} else if ($job->dpmt == 40) {
								$bl->charge_code = $charge_item_type->pl_cost_code;
							}
						}
					}
				} else if (!empty($exco)) {
					$bl->link_id = $exco->id;
					$bl->type = BillingLine::BILLING_TYPE_EXPORT;
					$bl->dpmt = Invoice::DPMT_EXPORT;
					$bl->billing_ref = $exco->no;
					$bl->awb = $exco->awb;
					$bl->dpt_id = $exco->dpt_id;
					$bl->currency = 1;
					$bl->charge_code = 91005;
				} else {
					$af->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_WRONG_AWB_NOTFOUND;
					$af->update(['matched_result', 'meta', 'awb', 'op']);
					return false;
				}
				$bl->created = date('Y-m-d');
				$bl->date = date('Y-m-d');
				$bl->due = $bl->date;
				$bl->transaction_date = $bl->date;
				if ($af->lines[0]->gst > 0) {
					$bl->gst = 'INPUT';
				} else {
					$bl->gst = 'EXEMPTEXPENSES';
				}
				$bl->status = 1;
				$bl->billing_cref = $af->invoice_no;
				$bl->actual_amount = $af->lines[0]->amount;
				$bl->accrual_amount = 0;
				$bl->gst_amount = $af->lines[0]->gst;
				$bl->desc = $af->lines[0]->desc;
				$bl->qty = 1;
				$bl->item_code = $af->lines[0]->glcode;
				$bl->price = 0;
				$bl->weight = 0;
				$bl->charge_weight = 0;
				$bl->sync_xero = 0;
				$bl->mdata['aline'] = $af->lines[0]->id;
				$bl->save();
				$af->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_WRONG_DIFF_TOOBIG;
				$result = false;
			} else {
				$af->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_WRONG_AWB_NOTFOUND;
				$result = false;
			}
			$af->update(['matched_result', 'meta', 'awb', 'op']);
		}

		return $result;
	}

	public function actionAjaxYYInvoiceImport()
	{
		Yii::app()->cache->delete('pid_'.md5(session_id().'ediInvoiceProgress'));

		$resp = array('success' => 1, 'msg' => 'Imported Successfully');
		if (isset($_FILES) && !empty($_FILES)) {
			$ap_file = empty($_FILES['af_file']) ? array() : $_FILES['af_file'];
			if (empty($ap_file['tmp_name']) || !is_uploaded_file($ap_file['tmp_name'])) {
				$resp['msg'] = 'Invalid template file';
				echo json_encode($resp);
				return;
			} else {
				$filename = $ap_file['name'];
				if (AFInvoiceReconciliationHistory::fileImportedBefore($filename)) {
					if (isset($_POST['overwrite']) && $_POST['overwrite'] == 1) {
						// if agree to overwrite the old one
						$afImportHistorys = AFInvoiceReconciliationHistory::model()->findAll('hash = :hash', [':hash' => md5($filename)]);
						// clear all old data
						foreach ($afImportHistorys as $afImportHistory) {
							$afImportHistory->invoice_total = 0;
							$afImportHistory->success = 0;
							$afImportHistory->failed = 0;
							$afImportHistory->update('invoice_total', 'success', 'failed');
							$oldInvoices = AFInvoiceReconciliation::model()->findAll('history_id = :hid', [':hid' => $afImportHistory->id]);
							foreach ($oldInvoices as $inv) {
								AFInvoiceReconciliationLine::model()->deleteAll('invoice_id = :iid', [':iid' => $inv->id]);
							}
						}
						// AFInvoiceReconciliation::model()->deleteAll('history_id = :hid',[':hid' => $afImportHistory->id] );
					} else {
						$resp['msg'] = 'The file has been imported already, if you want to overwrite them , please tick overwrite checkbox and try again';
						echo json_encode($resp);
						return;
					}
				}

				$ext = pathinfo($filename, PATHINFO_EXTENSION);
				if (strtolower($ext) != 'xlsx') {
					$resp['msg'] = 'Invalid template file please select .xlsx file';
					echo json_encode($resp);
					return;
				} else {
					$this->saveEdiInvoiceProgressFile(2, 'ready to load file');
					$xls = new oExcel;
					$xls->load($ap_file['tmp_name']);

					$this->saveEdiInvoiceProgressFile(5, 'file data uploaded');

					$sheetsArray = $xls->xls->getAllSheets();

					// normally one sheet for one invoice
					$invoiceCount = count($sheetsArray);
					$sheetCount = $invoiceCount;
					$sheetInvoicesFailed = array();
					if ($invoiceCount <= 0) {
						$resp['msg'] = 'No any valid invoice data found';
						echo json_encode($resp);
						return;
					}

					$data = array();
					foreach ($sheetsArray as $n => $sheet) {
						$data[] = $xls->getAll($sheet);
						unset($sheetsArray[$n]);
					}
					unset($xls);

					$this->saveEdiInvoiceProgressFile(8, 'file data loaded');

					$billings = array();
					$allItemsDesc = array(); // save all invoice related item description;
					$errors = array();
					$dates = [];

					$invoiceProcessedCount = 0;
					$sheetIndex = 1;

					$invoiceCount = 0;
					foreach ($data as $k => $invoice) {
						if (count($invoice) <= 1) {
							$errors[] = 'Failed to get invoice data for sheet index: ' . $sheetIndex;
							$sheetInvoicesFailed[] = array('index' => $sheetIndex, 'error' => 'invalid data');
							$sheetIndex++;
							continue; // invalid one
						}
						$sheetIndex++;

						// convert to real invoice number
						// format : TAX INVOICE 00159458
						$invoiceNumber = trim($invoice[3][3]);
						if (empty($invoiceNumber)) {
							$sheetInvoicesFailed[] = array('index' => $sheetIndex - 1, 'error' => 'no invoice number');
							continue;
						}

						$invoiceCount++;
						$invoiceNumber = trim(substr($invoiceNumber, 12));

						$this->saveEdiInvoiceProgressFile((8 + $invoiceProcessedCount / $invoiceCount * 70), ' process invoice : ' . $invoiceNumber);

						// get consignor and consignee
						$consignor = trim($invoice[16][3]);
						$consignee = trim($invoice[16][27]);

						// some time job format will be
						$cref = trim($invoice[18][3], ' /'); // will job id or console id
						$invoiceDate = oExcel::toDate($invoice[7][42]);
						$invoiceDue = oExcel::toDate($invoice[8][42]);

						preg_match_all('!\d+!', $invoiceNumber, $realInvoiceNumber);
						if (empty($realInvoiceNumber)) {
							$sheetInvoicesFailed[] = array('index' => $sheetIndex - 1, 'error' => 'no invoice number');
							continue;
						}
						$invoiceNumber = array_values(array_slice($realInvoiceNumber[0], -1))[0];

						// try to find weight ,volume and etc . value
						$orgin = '';
						$dest = '';
						$weight = 0;
						$volume = 0;
						$chargeWeight = 0;
						$eta = '';
						$etd = '';
						$awb = '';
						for ($i = 10; $i < 40; $i++) {
							$tag = trim($invoice[$i][3]);
							if ($tag == 'BROKER' || substr($tag, 0, 5) == 'OWNER') {
								$weight = preg_replace('/\s*KG$/', '', trim($invoice[$i + 1][26]));
								$volume = preg_replace('/\s*M3$/', '', trim($invoice[$i + 1][27]));
								$chargeWeight = preg_replace('/\s*KG$/', '', trim($invoice[$i + 1][35]));
								$orgin = trim($invoice[$i + 5][3]); // origin location
								$dest = trim($invoice[$i + 5][27]); // destination
								$awb = trim($invoice[$i + 3][27]); // get awb number
								$eta = oExcel::toDate($invoice[$i + 4][46]);
								$etd = oExcel::toDate($invoice[$i + 4][22]);
								break;
							}
						}

						// get all items
						$items = array();
						// try to find description begin line
						$itemLineIndex = 34; // if not found set as default
						for ($index = 12;; $index++) {
							if ($invoice[$index][3] == 'DESCRIPTION') {
								$itemLineIndex = $index + 2; // item lines begin from next 2 lines
								break;
							}
							// avoid dead loop
							if ($index > 80) {
								break;
							}

						}
						$allLineTotal = 0;
						$lineConstCount = 1;
						for ($index = $itemLineIndex;; $index++) {
							if ($index > 200) {
								break;
							}
							// avoid dead loop
							$lineConstCount++;
							if (empty($invoice[$index][3])) {
								if ($lineConstCount++ < 20) {
									continue;
								} else {
									break;
								}

							}
							if ($invoice[$index][34] == 'SUBTOTAL') {
								break;
							}
							// got subtotal line stop

							$desc = trim($invoice[$index][3]);
							$gstAmount = 0;
							if ($gst = preg_match('/^[\d\.\%]+\=([\d\.]+)$/', trim($invoice[$index][34]), $m)) {
								$gstAmount = $m[1];
							}

							$value = floatval($invoice[$index][42]);

							//append desc
							if (empty($invoice[$index][34]) && empty($value)) {
								$items[sizeof($items) - 1]['desc'] .= "\n" . $desc;
								continue;
							}
							$lineSubTotal = $value;
							$lineTotal = $lineSubTotal + $gstAmount;
							$allLineTotal += $lineTotal;
							// currently GL code will be included in item description as below
							/*
							GL 01-Air Freight
							GL 02-Airway Bill Fee
							GL 03-Amendment charge
							GL 04-Destination Documentation Fee
							GL 05-Doc Fee
							GL 06-Export Build Up Fee - GST
							GL 07-Export Documentation Fee - GST FREE
							GL 08-Export Security Fee - GST
							GL 09-Late Cancellation Fee
							GL 10-Manifest Amendment Fee
							GL 11-Terminal Security
							 */

							$glcode = '';
							$chargeCode = '';

							if (preg_match('/^\s*(GL)[\s0]*(\d{1,3})[\s\->]*(.+)$/i', $desc, $m)) {
								$glcode = $m[1] . $m[2];
								$desc = $m[3];
							}

							// X-Ray
							if (preg_match('/Examination Fee/i', $desc)) {
								$glcode = 'GL85';
							}

							if (!empty($glcode)) {
								$chargeCodeModel = ChargeItemType::model()->find('code = :code', [':code' => $glcode]);
								if (!empty($chargeCodeModel)) {
									$chargeCode = $chargeCodeModel->charge_code;
								}
							}

							// we should map old priority cargo invoie to our system
							// 'priority carge side' => 'hvlv side'
							$oldMaps = array(
								'GL7' => 'GL5',
								'GL8' => 'GL11',
							);
							if (isset($oldMaps[$glcode])) {
								$glcode = $oldMaps[$glcode];
							}

							$items[] = array('desc' => $desc, 'gst' => $gst, 'chargecode' => $chargeCode, 'glcode' => $glcode, 'value' => $value, 'subtotal' => $lineSubTotal, 'gstamount' => $gstAmount, 'total' => $lineTotal);
							$allItemsDesc[$desc] = 1;
						}
						// Yii::log(json_encode($items), 'error');

						// try to get subtotal , gst and total
						$subtotal = 0;
						$gst = 0;
						$total = 0;
						for ($index = $index;; $index++) {
							if ($invoice[$index][34] == 'SUBTOTAL') {
								$subtotal = floatval(str_replace(',', '', $invoice[$index][41]));
							}
							if ($invoice[$index][34] == 'ADD GST') {
								$gst = floatval(str_replace(',', '', $invoice[$index][41]));
							}
							if ($invoice[$index][34] == 'TOTAL AUD') {
								$total = floatval(str_replace(',', '', $invoice[$index][41]));
								break;
							}

							if ($index > 400) {
								break;
							}
							// avoid dead loop
						}

						// making up billing array
						$billing = array(
							'number' => $invoiceNumber,
							'awb' => $awb,
							'date' => $invoiceDate,
							'due' => $invoiceDue,
							'cnee' => $consignee,
							'cnor' => $consignor,
							'cref' => $cref,
							'orgin' => $orgin,
							'dest' => $dest,
							'eta' => $eta,
							'etd' => $etd,
							'weight' => $weight,
							'chargeWeight' => $chargeWeight,
							'volume' => $volume,
							'subtotal' => $subtotal,
							'gst' => $gst,
							'total' => $total,
							'linetotal' => $allLineTotal,
							'lines' => $items,
						);

						// check to see if we got duplicata invoice by awb
						if (!empty($awb)) {
							$existing = AFInvoiceReconciliation::model()->find('awb = :awb', [':awb' => $awb]);
							if (!empty($existing)) {
								$msg = $invoiceNumber . ' duplicate in : ' . $existing->invoice_no . ' with awb: ' . $awb;
								$sheetInvoicesFailed[] = array('index' => $sheetIndex - 1, 'error' => $msg);
							}
						}

						// save a reconciliation history
						$month = date('m', strtotime($invoiceDate));
						if (!empty($dates[$month])) {
							$invoiceDate = $dates[$month];
						} else {
							$dates[$month] = date('Y-m-d', strtotime($invoiceDate));
						}
						$afImportHistory = AFInvoiceReconciliationHistory::model()->find('hash = :hash AND created = :created', [':hash' => md5($filename), ':created' => date('Y-m-d')]);
						if (empty($afImportHistory)) {
							$afImportHistory = new AFInvoiceReconciliationHistory();
							$afImportHistory->hash = md5($filename);
							$afImportHistory->created = date('Y-m-d');
							$afImportHistory->attached_file_id = 0;
							$afImportHistory->invoice_total = 0;
							$afImportHistory->failed = 0;
							$afImportHistory->success = 0;
							$afImportHistory->op_id = Yii::app()->user->id;
							$afImportHistory->save();
							$errs = $afImportHistory->getErrors();
							if (!empty($errs)) {
								$msg = '';
								foreach ($errs as $k => $e) {
									$msg .= implode(' ', $e);
								}
								$resp['msg'] = $msg;
								echo json_encode($resp);
								return;
							}

							// save imported billing file
							$attachedFileId = FileRepo::storeFile($ap_file['tmp_name'], $filename, 36, $afImportHistory->id);
							$afImportHistory->attached_file_id = $attachedFileId;
							$afImportHistory->update('attached_file_id');
						}

						// save billing
						$afModel = $afImportHistory->saveBilling($billing, 964);
						$errs = $afModel->getErrors();
						if (!empty($errs)) {
							$msg = '';
							foreach ($errs as $k => $e) {
								$msg .= implode(' ', $e);
							}
							$sheetInvoicesFailed[] = array('index' => $sheetIndex - 1, 'error' => $msg);
						}

						// begin to match the billing with HVLV system
						if ($this->matchYYInvoiceWithHvlv($afModel)) {
							$afImportHistory->success ++;
						} else {
							$afImportHistory->failed ++;
						}

						// update eventually success and failed count
						$afImportHistory->invoice_total++;
						if (!empty($sheetInvoicesFailed)) {
							$afImportHistory->meta = json_encode($sheetInvoicesFailed);
							$afImportHistory->save();
						} else {
							$afImportHistory->invoice_total = $afImportHistory->success + $afImportHistory->failed;
							$afImportHistory->update(['failed', 'success', 'invoice_total']);
						}

						$billings[] = $billing;

						// update processing progress
						$invoiceProcessedCount++;
						$this->saveEdiInvoiceProgressFile((8 + $invoiceProcessedCount / $invoiceCount * 70), ' process invoice : ' . $invoiceNumber . ' done');
						$this->saveEdiInvoiceProgressFile((8 + $invoiceProcessedCount / $invoiceCount * 70), ' reading invoice ' . $invoiceProcessedCount . ' /  ' . $invoiceCount . ' processed');

						// release memory in time
						unset($invoice);
						unset($data[$k]);
					}

					// currently only create a report for edi invoice imported
					// $this->createEdiInvoiceImportReportPro($billings,$afImportHistory);

					// update processing progress
					$this->saveEdiInvoiceProgressFile(100, ' report created ');
				}
			}
		} else {
			$resp['success'] = 0;
			$resp['msg'] = 'Invalid billing file';
		}
		echo json_encode($resp);
	}

	private function matchYYInvoiceWithHvlv($billing)
	{
		if (empty($billing) || $billing->matched_result == AFInvoiceReconciliation::MATCHED_RESULT_WRONG_REJECTED) {
			return false;
		}

		if (empty($billing->awb)) {
			return false;
		}

		$result = true;
		// based on billing awb to search related console or job
		// in hvlv awb number will be including dash or not
		$dashAwb = substr($billing->awb, 0, 3) . '-' . substr($billing->awb, 3);
		$job = EdiJob::model()->find('awb = :awb OR no = :awb OR awb = :awb2 OR no = :awb2', [':awb' => $dashAwb, ':awb2' => $billing->awb]);

		$att = 0;
		// check lines content
		if (empty($billing->lines)) {
			$result = false;
			$billing->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_WRONG_LINES_COUNT_NOTMATCHED;
		} else {
			foreach ($billing->lines as $l) {
				$att += $l->amount;
			}
		}

		if (!empty($job)) {

			// get job cost lines related gl code
			$costGlCodes = array();
			$jobCostLines = BillingLine::model()->findAll('billing_ref = :bref AND org_id in (954, 964)', [':bref' => $job->no]);
			// clear nonexist aline
			foreach ($jobCostLines as $line) {
				if (!empty($line->mdata['aline']) && empty(AFInvoiceReconciliationLine::model()->findByPk($line->mdata['aline']))) {
					unset($line->mdata['aline']);
					$line->update('meta');
				}
			}
			// item_code exist and (empty invoice no or invoice no equal)
			$btt = 0;
			foreach ($jobCostLines as $line) {
				if (!empty($line->item_code) && (empty($line->billing_cref) || ($line->billing_cref == $billing->invoice_no))) {
					$costGlCodes[$line->item_code][] = $line;
					$btt += $line->accrual_amount;
				}
			}

			/* check lines count
			if ( count($billing->lines) > count($costGlCodes) ) {
			$billing->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_WRONG_LINES_COUNT_NOTMATCHED;
			$result = false;
			}
			 */
			// if($att < $btt * 0.8 || $att > $btt * 1.05){
			foreach ($billing->lines as $line) {
				if (!isset($costGlCodes[$line->glcode]) && !empty($_POST['linematch'])) {
					$billing->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_WRONG_LINES_GLCODE_NOTMATCHED;
					$result = false;
				} else if (isset($costGlCodes[$line->glcode])) {
					// we update actual cost
					$flag = 1;
					// check same invoice_no and actual_amount line with aline
					foreach ($costGlCodes[$line->glcode] as $jbCostLine) {
						if (($jbCostLine->billing_cref == $billing->invoice_no) && (floatval($jbCostLine->actual_amount) == floatval($line->amount)) && !empty($jbCostLine->mdata['aline']) && ($jbCostLine->mdata['aline'] == $line->id)) {
							$flag = 0;
						}
					}

					// set same invoice_no and actual_amount line with aline
					if ($flag) {
						foreach ($costGlCodes[$line->glcode] as $jbCostLine) {
							if (($jbCostLine->billing_cref == $billing->invoice_no) && (floatval($jbCostLine->actual_amount) == floatval($line->amount)) && empty($jbCostLine->mdata['aline'])) {
								$jbCostLine->mdata['aline'] = $line->id;
								$jbCostLine->org_id = 964;
								$jbCostLine->update('meta', 'org_id');
								$flag = 0;
								break;
							}
						}
					}

					// set same invoice_no line with info
					if ($flag) {
						foreach ($costGlCodes[$line->glcode] as $jbCostLine) {
							if (empty($jbCostLine->billing_cref)) {
								$jbCostLine->actual_amount = $line->amount;
								$jbCostLine->billing_cref = $billing->invoice_no;
								if ($line->gst > 0) {
									$jbCostLine->gst = 'INPUT';
								} else {
									$jbCostLine->gst = 'EXEMPTEXPENSES';
								}
								$jbCostLine->mdata['aline'] = $line->id;
								$jbCostLine->gst_amount = $jbCostLine->getGSTValue();
								$jbCostLine->org_id = 964;
								$jbCostLine->status = 1;
								$jbCostLine->update('actual_amount', 'billing_cref', 'gst', 'meta', 'gst_amount', 'org_id');
								$flag = 0;
								break;
							}
						}
					}

					// no same invoice_no line
					if ($flag) {
						$bl = new BillingLine;
						$bl->billing_id = 0;
						$bl->org_id = 964;
						$bl->op_id = $billing->op;
						$bl->link_id = $job->id;
						$bl->created = date('Y-m-d');
						$bl->date = date('Y-m-d');
						$bl->due = $bl->date;
						$bl->transaction_date = $bl->date;
						$bl->type = $job->dpmt / 10;
						$bl->dpmt = $job->dpmt;
						if ($line->gst > 0) {
							$bl->gst = 'INPUT';
						} else {
							$bl->gst = 'EXEMPTEXPENSES';
						}
						$bl->status = 1;
						$bl->billing_cref = $billing->invoice_no;
						$bl->billing_ref = $job->no;
						$bl->awb = $job->awb;
						$bl->dpt_id = $job->dpt_id;
						$bl->currency = 1;
						$bl->actual_amount = $line->amount;
						$bl->accrual_amount = 0;
						$bl->gst_amount = $line->gst;
						if ($line->glcode) {
							$charge_item_type = ChargeItemType::model()->find('code = :code', array(':code' => $line->glcode));
							if ($charge_item_type) {
								if ($job->dpmt == 30) {
									$bl->charge_code = $charge_item_type->cost_code;
								} else if ($job->dpmt == 40) {
									$bl->charge_code = $charge_item_type->pl_cost_code;
								}
							}
						}
						$bl->desc = $line->desc;
						$bl->qty = 1;
						$bl->item_code = $line->glcode;
						$bl->price = 0;
						$bl->weight = 0;
						$bl->charge_weight = 0;
						$bl->sync_xero = 0;
						$bl->mdata['aline'] = $line->id;
						$bl->save();
					}
				} else {
					$bls = BillingLine::model()->findAll('billing_cref = :billing_cref AND billing_ref = :billing_ref AND `desc` = :desc AND org_id in (954, 964)', array(':billing_cref' => $billing->invoice_no, ':billing_ref' => $job->no, ':desc' => $line->desc));

					// check same invoice_no and desc with aline
					$flag = 1;
					foreach ($bls as $bl) {
						if (!empty($bl->mdata['aline']) && $bl->mdata['aline'] == $line->id) {
							$flag = 0;
						}
					}

					// set same invoice_no and desc with aline
					if ($flag) {
						foreach ($bls as $bl) {
							if (empty($bl->mdata['aline'])) {
								$bl->mdata['aline'] = $line->id;
								$bl->org_id = 964;
								$bl->update('meta', 'org_id');
							}
						}
					}

					if ($flag) {
						$bl = new BillingLine;
						$bl->billing_id = 0;
						$bl->org_id = 964;
						$bl->op_id = $billing->op;
						$bl->link_id = $job->id;
						$bl->created = date('Y-m-d');
						$bl->date = date('Y-m-d');
						$bl->due = $bl->date;
						$bl->transaction_date = $bl->date;
						$bl->type = $job->dpmt / 10;
						$bl->dpmt = $job->dpmt;
						if ($line->gst > 0) {
							$bl->gst = 'INPUT';
						} else {
							$bl->gst = 'EXEMPTEXPENSES';
						}
						$bl->status = 1;
						$bl->billing_cref = $billing->invoice_no;
						$bl->billing_ref = $job->no;
						$bl->awb = $job->awb;
						$bl->dpt_id = $job->dpt_id;
						$bl->currency = 1;
						$bl->actual_amount = $line->amount;
						$bl->accrual_amount = 0;
						$bl->gst_amount = $line->gst;
						if ($line->glcode) {
							$charge_item_type = ChargeItemType::model()->find('code = :code', array(':code' => $line->glcode));
							if ($charge_item_type) {
								if ($job->dpmt == 30) {
									$bl->charge_code = $charge_item_type->cost_code;
								} else if ($job->dpmt == 40) {
									$bl->charge_code = $charge_item_type->pl_cost_code;
								}
							}
						}
						$bl->desc = $line->desc;
						$bl->qty = 1;
						$bl->item_code = @$line->glcode;
						$bl->price = 0;
						$bl->weight = 0;
						$bl->charge_weight = 0;
						$bl->sync_xero = 0;
						$bl->mdata['aline'] = $line->id;
						$bl->save();
					}
				}
			}
			$billing->mdata['att'] = $att;
			$billing->mdata['btt'] = $btt;
			if (abs($att) < abs($btt) * 0.8 || ($att - $btt) > 50 || abs($att) > abs($btt) * 1.05) {
				$extra_billing_lines = BillingLine::model()->findAll('billing_ref = :billing_ref AND billing_cref != :billing_cref AND org_id in (954, 964)', array(':billing_ref' => $job->no, ':billing_cref' => $billing->invoice_no));
				$ctt = 0;
				$dtt = 0;
				if (!empty($extra_billing_lines)) {
					foreach ($extra_billing_lines as $line) {
						if (!empty($line->billing_cref)) {
							$ctt += $line->actual_amount;
							$dtt += $line->accrual_amount;
						}
					}
				}
				if (abs($att + $ctt) < abs($btt + $dtt) * 0.8 || ($att + $ctt - $btt - $dtt) > 50 || abs($att + $ctt) > abs($btt + $dtt) * 1.05) {
					$billing->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_WRONG_DIFF_TOOBIG;
					$billing->mdata['nt'] = 'diff ' . number_format($att + $ctt - $btt - $dtt, 2) . '; combine with other invoices';
					$result = false;
				} else {
					$billing->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_SUCCESS;
					$billing->mdata['nt'] = 'without line match and combine other invoices';
				}
			} else {
				if ($result) {
					$billing->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_SUCCESS;
					if (empty($_POST['linematch'])) {
						$billing->mdata['nt'] = 'without line match';
					}
				}
			}

			// update them
			$billing->model = 'EdiJob';
			$billing->fid = $job->id;
			$billing->op = $job->user_id;
			$billing->save();
		} else {
			$consol = ExcoConsol::model()->find('awb = :awb', [':awb' => $dashAwb]);
			if (!empty($consol)) {

				// get exco consol billing lines
				$costGlCodes = array();
				$ecxoBillings = BillingLine::model()->findAll('billing_ref = :bref AND org_id in (954, 964)', [':bref' => $consol->no]);
				foreach ($ecxoBillings as $line) {
					if (!empty($line->mdata['aline']) && empty(AFInvoiceReconciliationLine::model()->findByPk($line->mdata['aline']))) {
						unset($line->mdata['aline']);
						$line->update('meta');
					}
				}
				$btt = 0;
				foreach ($ecxoBillings as $line) {
					if (!empty($line->item_code) && (empty($line->billing_cref) || ($line->billing_cref == $billing->invoice_no))) {
						$costGlCodes[$line->item_code][] = $line;
						$btt += $line->accrual_amount;
					}
				}

				// if(($att < $btt * 0.8 || $att > $btt * 1.1) && abs($att-$btt) > 10){
				foreach ($billing->lines as $line) {
					if (!isset($costGlCodes[$line->glcode]) && !empty($_POST['linematch'])) {
						$billing->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_WRONG_LINES_GLCODE_NOTMATCHED;
						$result = false;
					} else if (isset($costGlCodes[$line->glcode])) {
						// we update actual cost
						$flag = 1;
						// check same invoice_no and actual_amount line with aline
						foreach ($costGlCodes[$line->glcode] as $excoCostLine) {
							if (($excoCostLine->billing_cref == $billing->invoice_no) && (floatval($excoCostLine->actual_amount) == floatval($line->amount)) && !empty($excoCostLine->mdata['aline']) && ($excoCostLine->mdata['aline'] == $line->id)) {
								$flag = 0;
							}
						}

						// set same invoice_no and actual_amount line with aline
						if ($flag) {
							foreach ($costGlCodes[$line->glcode] as $excoCostLine) {
								if (($excoCostLine->billing_cref == $billing->invoice_no) && (floatval($excoCostLine->actual_amount) == floatval($line->amount)) && empty($excoCostLine->mdata['aline'])) {
									$excoCostLine->mdata['aline'] = $line->id;
									$excoCostLine->org_id = 964;
									$excoCostLine->update('meta', 'org_id');
									$flag = 0;
									break;
								}
							}
						}

						// set same invoice_no line with info
						if ($flag) {
							foreach ($costGlCodes[$line->glcode] as $excoCostLine) {
								if (empty($excoCostLine->billing_cref)) {
									$excoCostLine->actual_amount = $line->amount;
									$excoCostLine->billing_cref = $billing->invoice_no;
									if ($line->gst > 0) {
										$excoCostLine->gst = 'INPUT';
									} else {
										$excoCostLine->gst = 'EXEMPTEXPENSES';
									}
									$excoCostLine->mdata['aline'] = $line->id;
									$excoCostLine->gst_amount = $excoCostLine->getGSTValue();
									$excoCostLine->org_id = 964;
									$excoCostLine->status = 1;
									$excoCostLine->update('actual_amount', 'billing_cref', 'gst', 'meta', 'gst_amount', 'org_id');
									$flag = 0;
									break;
								}
							}
						}

						// no same invoice_no line
						if ($flag) {
							$bl = new BillingLine;
							$bl->billing_id = 0;
							$bl->org_id = 964;
							$bl->op_id = $billing->op;
							$bl->link_id = $consol->id;
							$bl->created = date('Y-m-d');
							$bl->date = date('Y-m-d');
							$bl->due = $bl->date;
							$bl->transaction_date = $bl->date;
							$bl->type = BillingLine::BILLING_TYPE_EXPORT;
							$bl->dpmt = Invoice::DPMT_EXPORT;
							if ($line->gst > 0) {
								$bl->gst = 'INPUT';
							} else {
								$bl->gst = 'EXEMPTEXPENSES';
							}
							$bl->status = 1;
							$bl->billing_cref = $billing->invoice_no;
							$bl->billing_ref = $consol->no;
							$bl->awb = $consol->awb;
							$bl->dpt_id = $consol->dpt_id;
							$bl->currency = 1;
							$bl->actual_amount = $line->amount;
							$bl->accrual_amount = 0;
							$bl->gst_amount = $line->gst;
							if ($line->glcode) {
								$charge_item_type = ChargeItemType::model()->find('code = :code', array(':code' => $line->glcode));
								if ($charge_item_type) {
									$bl->charge_code = $charge_item_type->cost_code;
								}
							}
							$bl->desc = $line->desc;
							$bl->qty = 1;
							$bl->item_code = $line->glcode;
							$bl->price = 0;
							$bl->weight = 0;
							$bl->charge_weight = 0;
							$bl->sync_xero = 0;
							$bl->mdata['aline'] = $line->id;
							$bl->save();
						}
					} else {
						$bls = BillingLine::model()->findAll('billing_cref = :billing_cref AND billing_ref = :billing_ref AND `desc` = :desc AND org_id in (954, 964)', array(':billing_cref' => $billing->invoice_no, ':billing_ref' => $consol->no, ':desc' => $line->desc));

						// check same invoice_no and desc with aline
						$flag = 1;
						foreach ($bls as $bl) {
							if (!empty($bl->mdata['aline']) && $bl->mdata['aline'] == $line->id) {
								$flag = 0;
							}
						}

						// set same invoice_no and desc with aline
						if ($flag) {
							foreach ($bls as $bl) {
								if (empty($bl->mdata['aline'])) {
									$bl->mdata['aline'] = $line->id;
									$bl->org_id = 964;
									$bl->update('meta', 'org_id');
								}
							}
						}

						if ($flag) {
							$bl = new BillingLine;
							$bl->billing_id = 0;
							$bl->org_id = 964;
							$bl->op_id = $billing->op;
							$bl->link_id = $consol->id;
							$bl->created = date('Y-m-d');
							$bl->date = date('Y-m-d');
							$bl->due = $bl->date;
							$bl->transaction_date = $bl->date;
							$bl->type = BillingLine::BILLING_TYPE_EXPORT;
							$bl->dpmt = Invoice::DPMT_EXPORT;
							if ($line->gst > 0) {
								$bl->gst = 'INPUT';
							} else {
								$bl->gst = 'EXEMPTEXPENSES';
							}
							$bl->status = 1;
							$bl->billing_cref = $billing->invoice_no;
							$bl->billing_ref = $consol->no;
							$bl->awb = $consol->awb;
							$bl->dpt_id = $consol->dpt_id;
							$bl->currency = 1;
							$bl->actual_amount = $line->amount;
							$bl->accrual_amount = 0;
							$bl->gst_amount = $line->gst;
							if ($line->glcode) {
								$charge_item_type = ChargeItemType::model()->find('code = :code', array(':code' => $line->glcode));
								if ($charge_item_type) {
									$bl->charge_code = $charge_item_type->cost_code;
								}
							}
							$bl->desc = $line->desc;
							$bl->qty = 1;
							$bl->item_code = @$line->glcode;
							$bl->price = 0;
							$bl->weight = 0;
							$bl->charge_weight = 0;
							$bl->sync_xero = 0;
							$bl->mdata['aline'] = $line->id;
							$bl->save();
						}
					}
				}
				if (abs($att) < abs($btt) * 0.8 || ($att - $btt) > 50 || abs($att) > abs($btt) * 1.05) {
					$extra_billing_lines = BillingLine::model()->findAll('billing_ref = :billing_ref AND billing_cref != :billing_cref AND org_id in (954, 964)', array(':billing_ref' => $consol->no, ':billing_cref' => $billing->invoice_no));
					$ctt = 0;
					$dtt = 0;
					if (!empty($extra_billing_lines)) {
						foreach ($extra_billing_lines as $line) {
							if (!empty($line->billing_cref)) {
								$ctt += $line->actual_amount;
								$dtt += $line->accrual_amount;
							}
						}
					}
					if (abs($att + $ctt) < abs($btt + $dtt) * 0.8 || ($att + $ctt - $btt - $dtt) > 50 || abs($att + $ctt) > abs($btt + $dtt) * 1.05) {
						$billing->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_WRONG_DIFF_TOOBIG;
						$billing->mdata['nt'] = 'diff ' . number_format($att + $ctt - $btt - $dtt, 2) . '; combine with other invoices';
						$result = false;
					} else {
						$billing->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_SUCCESS;
						$billing->mdata['nt'] = 'without line match and combine other invoices';
					}
				} else {
					if ($result) {
						$billing->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_SUCCESS;
						if (empty($_POST['linematch'])) {
							$billing->mdata['nt'] = 'without line match';
						}
					}
				}

				// update them
				$billing->model = 'ExcoConsol';
				$billing->fid = $consol->id;
				$billing->op = Log::getExconsolCreateUserID($consol->id);
				$billing->save();

			} else {
				$blines = BillingLine::model()->findAll('billing_cref = :billing_cref AND org_id in (954, 964)', array(':billing_cref' => $billing->invoice_no));
				if (!empty($blines)) {
					$btt = 0;
					foreach ($blines as $bline) {
						$btt += $bline->accrual_amount;
					}
					$billing->op = $bline->op_id;
					if (abs($att) < abs($btt) * 0.8 || ($att - $btt) > 50 || abs($att) > abs($btt) * 1.05) {
						$billing->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_WRONG_DIFF_TOOBIG_PREIMPORT;
						$billing->mdata['nt'] = 'diff ' . number_format($att - $btt, 2);
						$result = false;
					} else {
						$billing->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_SUCCESS;
						$billing->mdata['nt'] = 'pre-imported';
					}
				} else {
					$bill = Billing::model()->find('billing_cref = :billing_cref AND org_id in (954, 964)', array(':billing_cref' => $billing->invoice_no));
					if (!empty($bill)) {
						$btt = 0;
						foreach ($bill->lines as $bline) {
							$btt += $bline->accrual_amount;
						}
						$billing->op = Log::getBillingCreateUserID($bill->id);
						if (abs($att) < abs($btt) * 0.8 || ($att - $btt) > 50 || abs($att) > abs($btt) * 1.05) {
							$billing->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_WRONG_DIFF_TOOBIG_PREIMPORT;
							$billing->mdata['nt'] = 'diff ' . number_format($att - $btt, 2);
							$result = false;
						} else {
							$billing->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_SUCCESS;
							$billing->mdata['nt'] = 'pre-imported';
						}
					} else {
						$billing->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_WRONG_AWB_NOTFOUND;
						$result = false;
					}
				}
				$billing->save();
			}
		}
		return $result;
	}

	public function actionAjaxSJInvoiceCheck()
	{
		Yii::app()->cache->delete('pid_'.md5(session_id().'ediInvoiceProgress'));

		$resp = array('success' => 1, 'msg' => 'Imported Successfully');
		if (isset($_FILES) && !empty($_FILES)) {
			$ap_file = empty($_FILES['af_file']) ? array() : $_FILES['af_file'];
			if (empty($ap_file['tmp_name']) || !is_uploaded_file($ap_file['tmp_name'])) {
				$resp['msg'] = 'Invalid template file';
				echo json_encode($resp);
				return;
			} else {
				$filename = $ap_file['name'];
				if (AFInvoiceReconciliationHistory::fileImportedBefore($filename)) {
					if (isset($_POST['overwrite']) && $_POST['overwrite'] == 1) {
						// if agree to overwrite the old one
						$afImportHistorys = AFInvoiceReconciliationHistory::model()->findAll('hash = :hash', [':hash' => md5($filename)]);
						// clear all old data
						foreach ($afImportHistorys as $afImportHistory) {
							$afImportHistory->invoice_total = 0;
							$afImportHistory->success = 0;
							$afImportHistory->failed = 0;
							$afImportHistory->update('invoice_total', 'success', 'failed');
							$oldInvoices = AFInvoiceReconciliation::model()->findAll('history_id = :hid', [':hid' => $afImportHistory->id]);
							foreach ($oldInvoices as $inv) {
								AFInvoiceReconciliationLine::model()->deleteAll('invoice_id = :iid', [':iid' => $inv->id]);
							}
						}
						AFInvoiceReconciliation::model()->deleteAll('history_id = :hid',[':hid' => $afImportHistory->id] );
					} else {
						$resp['msg'] = 'The file has been imported already, if you want to overwrite them , please tick overwrite checkbox and try again';
						echo json_encode($resp);
						return;
					}
				}

				$ext = pathinfo($filename, PATHINFO_EXTENSION);
				if (strtolower($ext) != 'xlsx') {
					$resp['msg'] = 'Invalid template file please select .xlsx file';
					echo json_encode($resp);
					return;
				} else {
					$this->saveEdiInvoiceProgressFile(2, 'ready to load file');
					$xls = new oExcel;
					$xls->load($ap_file['tmp_name']);

					$this->saveEdiInvoiceProgressFile(5, 'file data uploaded');

					$sheetsArray = $xls->xls->getAllSheets();

					// normally one sheet for one invoice
					$invoiceCount = count($sheetsArray);
					$sheetCount = $invoiceCount;
					$sheetInvoicesFailed = array();
					if ($invoiceCount <= 0) {
						$resp['msg'] = 'No any valid invoice data found';
						echo json_encode($resp);
						return;
					}

					$data = array();
					foreach ($sheetsArray as $n => $sheet) {
						$data[] = $xls->getAll($sheet);
						unset($sheetsArray[$n]);
					}
					unset($xls);

					$this->saveEdiInvoiceProgressFile(8, 'file data loaded');

					$billings = array();
					$allItemsDesc = array(); // save all invoice related item description;
					$errors = array();
					$dates = [];

					$invoiceProcessedCount = 0;
					$sheetIndex = 1;

					// save a reconciliation history
					if (empty($afImportHistory)) {
						$afImportHistory = new AFInvoiceReconciliationHistory();
						$afImportHistory->hash = md5($filename);
						$afImportHistory->created = date('Y-m-d');
						$afImportHistory->op_id = Yii::app()->user->id;
					}
					$afImportHistory->attached_file_id = 0;
					$afImportHistory->invoice_total = 0;
					$afImportHistory->failed = 0;
					$afImportHistory->success = 0;
					$afImportHistory->save();
					$errs = $afImportHistory->getErrors();
					if (!empty($errs)) {
						$msg = '';
						foreach ($errs as $k => $e) {
							$msg .= implode(' ', $e);
						}
						$resp['msg'] = $msg;
						echo json_encode($resp);
						return;
					}

					// save imported billing file
					$attachedFileId = FileRepo::storeFile($ap_file['tmp_name'], $filename, 36, $afImportHistory->id);
					$afImportHistory->attached_file_id = $attachedFileId;
					$afImportHistory->update('attached_file_id');

					$invoiceCount = 0;
					foreach ($data as $k => $invoice) {
						if (count($invoice) <= 1) {
							$errors[] = 'Failed to get invoice data for sheet index: ' . $sheetIndex;
							$sheetInvoicesFailed[] = array('index' => $sheetIndex, 'error' => 'invalid data');
							$sheetIndex++;
							continue; // invalid one
						}
						$sheetIndex++;

						foreach ($invoice as $line) {
							if (!preg_match('/\d{3}\-\d{8}/', $line[1])) {
								continue;
							}
							$af = new AFInvoiceReconciliation;
							$af->supplier_id = 1008;
							$af->history_id = $afImportHistory->id;
							$af->invoice_no = $line[4];
							$af->awb = $line[1];
							$af->date = date('Y-m-d');
							$af->due = date('Y-m-d');
							$af->created = date('Y-m-d');
							$af->subtotal = $line[3];
							$af->gst = 0;
							$af->total = $line[3];
							$af->matched_result = 0;
							$af->op = 0;
							$af->save();

							$afl = new AFInvoiceReconciliationLine;
							$afl->invoice_id = $af->id;
							$afl->desc = 'Air Freight';
							$afl->gst = 0;
							$afl->glcode = 'GL1';
							$afl->amount = $line[3];
							$afl->save();

							// begin to match the billing with HVLV system
							if ($this->checkSJInvoiceWithHvlv($af)) {
								$afImportHistory->success ++;
							} else {
								$afImportHistory->failed ++;
							}
						}

						// update eventually success and failed count
						if (!empty($sheetInvoicesFailed)) {
							$afImportHistory->meta = json_encode($sheetInvoicesFailed);
							$afImportHistory->save();
						} else {
							$afImportHistory->invoice_total = $afImportHistory->success + $afImportHistory->failed;
							$afImportHistory->update(['failed', 'success', 'invoice_total']);
						}

						// release memory in time
						unset($invoice);
						unset($data[$k]);
					}
				}
			}
		} else {
			$resp['success'] = 0;
			$resp['msg'] = 'Invalid billing file';
		}
		echo json_encode($resp);
	}

	public function checkSJInvoiceWithHvlv($af)
	{
		if (empty($af) || $af->matched_result == AFInvoiceReconciliation::MATCHED_RESULT_WRONG_REJECTED) {
			return false;
		}

		if (empty($af->awb)) {
			$af->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_WRONG_AWB_NOTFOUND;
			$af->update('matched_result');
			return false;
		} else {
			$awbNoDash = str_replace('-', '', $af->awb);
			$dashAwb = substr($awbNoDash, 0, 3) . '-' . substr($awbNoDash, 3);

			$job = EdiJob::model()->find('awb like :awb1 OR awb like :awb2', [':awb1' => '%' . $awbNoDash . '%', ':awb2' => '%' . $dashAwb . '%']);
			if (!empty($job)) {
				$af->model = 'EdiJob';
				$af->fid = $job->id;
				$af->op = $job->user_id;
				$af->update('model', 'fid', 'op');
				$billinglines = BillingLine::model()->findAll('billing_ref = :bref AND item_code = "GL1" AND org_id in (954,964)', [':bref' => $job->no]);
				foreach ($billinglines as $billingline) {
					if ($billingline->actual_amount == $af->subtotal) {
						$af->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_SUCCESS;
						$af->update('matched_result');
						return true;
					} else if ($billingline->accrual_amount == $af->subtotal) {
						$af->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_SUCCESS;
						$af->update('matched_result');
						return true;
					}
				}
				$af->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_WRONG_DIFF_TOOBIG;
				$af->update('matched_result');
				return false;
			} else {
				$af->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_WRONG_AWB_NOTFOUND;
				$af->update('matched_result');
				return false;
			}
		}
	}

