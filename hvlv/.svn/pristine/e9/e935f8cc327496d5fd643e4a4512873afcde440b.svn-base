	private function doAccountingPost()
	{
		$selectedBillingIds = array();
		if (isset($_POST['selectedItems'])) {
			$selectedBillingIds = $_POST['selectedItems'];
		}

		$md = new BillingLine();
		$transactionDate = trim($_POST['transaction_date']);
		$invoiceDate = trim($_POST['invoice_date']);
		$invoiceDue = trim($_POST['invoice_due']);
		if (!empty($selectedBillingIds)) {

			// when customer select billing lines
			// maybe including different invoice reference
			// by when we post to xero we can only post one same invoice reference
			// so here we need to check if multiple invoice reference included
			$allBillingData = array();
			foreach ($selectedBillingIds as $k => $id) {
				$model = BillingLine::model()->findByPk($id);
				if (!empty($model)) {

					if (empty($model->billing_cref)) {
						$billingNumber = $model->no;
					} else {
						$billingNumber = $model->billing_cref;
					}
					if (!empty($transactionDate)) {
						$model->transaction_date = $transactionDate;
					}

					if (!empty($invoiceDate)) {
						$model->date = $invoiceDate;
					}

					if (!empty($invoiceDue)) {
						$model->due = $invoiceDue;
					}

					$model->update(['date', 'transaction_date', 'due']);

					if (!empty($billingNumber) && !isset($allBillingData[$billingNumber])) {
						$allBillingData[$billingNumber] = array();
					}
					$allBillingData[$billingNumber][] = $model;

					// support post multiple invoice number once now
					// we can post xero only with the same invoice reference once
					//if ( count($allBillingData) > 1 ) {
					//    break;
					// }

				}
			}

			$flag = 1;
			$billings = [];
			foreach ($allBillingData as $billingNumber => $lines) {
				$bills = Billing::model()->findAll('billing_cref = :billing_cref', array(':billing_cref' => $billingNumber));
				foreach ($bills as $bill) {
					if (!empty($bill->lines)) {
						foreach ($bill->lines as $line) {
							if ($line->status == 1) {
								$flag = 0;
								$md->addError('id', 'line ' . $line->no . ' in invoice ' . $billingNumber . ' has not been confirmed yet');
							} else if ($line->status == 3) {
								$flag = 0;
								$md->addError('id', 'line ' . $line->no . ' in invoice ' . $billingNumber . ' has been posted');
							} else if ($line->status == 11) {
								continue;
							} else {
								$billings[] = $bill->id;
							}
						}
					}
				}
			}

			if ($flag) {
				$allBillingData = [];
				foreach ($billings as $billingId) {
					$billing = Billing::model()->findByPk($billingId);
					$allBillingData[$billing->billing_cref] = $billing->lines;
				}
			}

			$billingCount = count($allBillingData);
			if ($billingCount >= 1) {
				// will post to xero soon
				$error = $this->postXero($allBillingData);
				if (!empty($error)) {
					$md->addError('id', $error);
				}
			} else if ($billingCount == 0) {
				$md->addError('id', 'Selected Items no invoice reference!');
			}
			//else {
			//    $md->addError('id','Selected Items with different inovice reference!');
			// }

		} else {
			$md->addError('id', 'No item selected');
		}

		$this->ajaxResult($md);
	}

	public function doAccountingSwitchGST()
	{
		$selectedBillingIds = array();
		if (isset($_POST['selectedItems'])) {
			$selectedBillingIds = $_POST['selectedItems'];
		}

		if (!empty($selectedBillingIds)) {
			foreach ($selectedBillingIds as $k => $id) {
				$model = BillingLine::model()->findByPk($id);
				if (!empty($model)) {
					$model->gst = 'INPUT';
					$model->gst_amount = $model->getGSTValue();
					$model->save();
				}
			}
			echo json_encode(array('done' => true, 'msg' => 'Switch Successfully'));
		} else {
			echo json_encode(array('done' => false, 'msg' => 'No item selected'));
		}
		Yii::app()->end();
	}

	/**
	 * post general billing data to xero
	 * @param $billings
	 * @return string
	 */
	private function postGeneralCost2Xero(&$billing)
	{

		$error = '';
		$syncXero = true;
		$org = Org::model()->findByPk($billing->org_id);
		$xdata = new stdClass();
		$xdata->no = $billing->billing_cref;
		$xdata->currency = 'AUD'; // default as AUD currently
		$xdata->orgName = $org->name;
		$xdata->orgId = $org->id;
		$xdata->date = $billing->date;
		$xdata->due = $billing->due;
		$xdata->gstType = 1;
		$xdata->dpt_id = $billing->dpt_id;
		$costs = array();

		foreach ($billing->lines as $line) {
			if (!empty($line->mdata['gdepartment'])) {
				$dept = BillingLine::$general_cost_dpmts[$line->mdata['gdepartment']];
			} else {
				$dept = '';
			}
			$costs[] = array('qty' => $line->qty,
				'description' => $line->desc,
				'code' => $line->charge_code,
				'amount' => $line->price,
				'taxType' => $line->gst,
				'dept' => $dept,
			);
		}

		// save to xero now
		if (!empty($costs)) {
			$xdata->lines = $costs;
			if ($xdata->lines[0]['amount'] > 0) {
				$xero_id = Billing::saveBill2Xero($xdata, true);
				if (!$xero_id) {
					$syncXero = false;
				}
			} else if ($xdata->lines[0]['amount'] < 0) {
				$xero_id = Billing::saveBillCreditNote2Xero($xdata, true);
				if (!$xero_id) {
					$syncXero = false;
				}

			}
		}

		// sync to xero done successfully
		if ($syncXero) {
			$billing->sync_xero = 1;
			$billing->status = 3;
			$billing->xero_id = $xero_id;
			$billing->update(['status', 'sync_xero', 'xero_id']);
			$error = 'Billing ' . $billing->no . 'Sync Xero successfully';
			foreach ($billing->lines as $billingline) {
				$billingline->sync_xero = 1;
				$billingline->status = 3;
				$billingline->date = $billing->date;
				$billingline->due = $billing->due;
				$billingline->transaction_date = $billing->transaction_date;
				$billingline->billing_cref = $billing->billing_cref;
				$billingline->billing_ref = $billing->billing_ref;
				$billingline->update(['status', 'sync_xero', 'date', 'due', 'transaction_date', 'billing_cref', 'billing_ref']);
			}
		} else {
			$error = 'Failed to Sync to Xero';
			$billing->sync_xero = 2;
			$billing->update('sync_xero');
			$error = 'Failed to sync billing ' . $billing->no . ' with xero';
			foreach ($billing->lines as $billingline) {
				$billingline->sync_xero = 2;
				$billingline->update('sync_xero');
			}
		}

		return $error;
	}

	/**
	 * @param $billings
	 * @return string
	 */
	public function postXero(&$billings, $add = false)
	{
		// avoid xero api limitation
		/**
		 * API Rate Limits

		There are limits to the number of API calls that your application can make against a particular Xero organisation.

		Minute Limit: 60 calls in a rolling 60 second window
		Daily Limit: 5000 calls in a rolling 24 hour window
		 */
		$sendCount = 0;

		// currently we don't push to xero , just change billing status only
		$error = '';
		foreach ($billings as $ref => $lines) {
			$syncXero = true;
			foreach ($lines as $billing) {
				$org = Org::model()->findByPk($billing->org_id);
				$xdata = new stdClass();
				$xdata->no = $ref . ($add ? '-' . $add : '');
				// $xdata->currency = 'AUD'; // default as AUD currently
				$xdata->currency = $billing->currency;
				$xdata->orgName = $org->name;
				$xdata->orgId = $org->id;
				$xdata->date = $billing->date;
				$xdata->due = $billing->due;
				$xdata->gstType = 1; // set all as Exclusive
				$xdata->dpt_id = $billing->dpt_id;
				$costs = array();
				break;
			}

			foreach ($lines as $billing) {
				$chargeCode = $billing->charge_code;
				$desc = $billing->desc;
				// in case still empty , we use charge code desc
				if (empty($desc)) {
					$chargeCodeModel = Chargecode::model()->find('status = 1 AND code = :code', [':code' => $chargeCode]);
					if (!empty($chargeCodeModel)) {
						$desc = $chargeCodeModel->name;
					}
				}
				$amount = $billing->actual_amount;
				// for courier billing, have multi dpmts
				$dpmt = null;
				if ($billing->type == 6) {
					// fix general cost that actual_amount includes gst_amount
					// $amount /= 1.1;
					$dpmt = @$billing->mdata['gdepartment'];
				}
				if (empty($dpmt)) {
					$dpmt = !empty(BillingLine::$xero_segments[$billing->type]) ? BillingLine::$xero_segments[$billing->type] : '';
				}
				$costs[] = array('qty' => 1,
					'description' => $desc,
					'code' => $chargeCode,
					'amount' => $amount,
					'taxType' => $billing->gst,
					'dept' => $dpmt,
					'region'=>$billing->getRegion()
				);
			}
			// save to xero now
			if (!empty($costs)) {
				$xdata->lines = $costs;
				// current don't push to xero again
				$total = 0;
				foreach ($xdata->lines as $line) {
					$total += $line['amount'];
				}
				if ($total > 0) {
					$xero_id = Billing::saveBill2Xero($xdata);
					if (!$xero_id) {
						$syncXero = false;
					}
				} else {
					$xero_id = Billing::saveBillCreditNote2Xero($xdata);
					if (!$xero_id) {
						$syncXero = false;
					}
				}
			}

			// sync to xero done successfully
			foreach ($lines as $billing) {
				if ($syncXero) {
					$billing->sync_xero = 1;
					if ($billing->status < 3) $billing->status = 3;
					$billing->update(['status', 'sync_xero']);
				} else {
					$error = 'Failed to Sync to Xero';
					$billing->sync_xero = 2;
					$billing->update('sync_xero');
				}
			}

			foreach ($lines as $billing) {
				if (!empty($billing->billing)) {
					$billing->billing->sync_xero = 1;
					$billing->billing->status = 3;
					$billing->billing->xero_id = $xero_id;
					$bls = BillingLine::model()->findAll('billing_id = :billing_id AND status != 11', array(':billing_id' => $billing->billing->id));
					foreach ($bls as $bl) {
						if ($bl->sync_xero != 1 || $bl->status != 3) {
							$billing->billing->sync_xero = 0;
							$billing->billing->status = 2;
						}
					}
					$billing->billing->update(['sync_xero', 'status', 'xero_id']);
				}
			}

			$sendCount++;
			if ($sendCount > 40) {
				sleep(62); // for next circle time
				$sendCount = 0;
			}

		}
		return $error;
	}

	private function doOpConfirm()
	{
		$selectedBillingIds = array();
		if (isset($_POST['selectedItems'])) {
			$selectedBillingIds = $_POST['selectedItems'];
		}

		$md = new BillingLine();
		$invoice = trim($_POST['invoice_no']);
		if (empty($invoice)) {
			$md->addError('id', 'Invoice No. is mandatory');
		} else {
			if (!empty($selectedBillingIds)) {

				// create a related billing now
				// if existing already just replace old one
				$billingline = BillingLine::model()->findByPk(end($selectedBillingIds));
				$billing = Billing::model()->find('billing_cref = :cref AND org_id = :org_id', [':cref' => $invoice, ':org_id' => $billingline->org_id]);
				if (empty($billing)) {
					$billing = new Billing();
					$orgId = 0;
					$type = BillingLine::BILLING_TYPE_OTHERS;
					$dpmt = 0;
					foreach ($selectedBillingIds as $k => $id) {
						$model = BillingLine::model()->findByPk($id);
						if (!empty($model)) {
							$orgId = $model->org_id;
							$type = $model->type;
							$dpmt = $model->dpmt;
							break;
						}
					}
					$billing->org_id = $orgId;
					$billing->billing_cref = $invoice;
					$billing->created = date('Y-m-d');
					// $billing->currency = 1; // default as AUD
					$billing->currency = $billingline->currency;
					$billing->status = 2; // as confirmed
					$billing->dpmt = $dpmt;
					$billing->type = $type;
					$billing->dpt_id = Org::PCAE_DEPARTMENT_SYDNEY;
					$billing->save();
				} else {
					// remove all old related billing lines
					// $allLines = BillingLine::model()->findAll('billing_id = :bid',[':bid' => $billing->id]);
					// foreach ( $allLines as $line){
					//     $line->billing_id = 0;
					//     $line->update('billing_id');
					// }
					if ($billing->status > 2) {
						$billing->addError('id', 'Invoice has been confirmed');
					}
				}

				$errors = $billing->getErrors();
				if (!empty($errors)) {
					$msg = '';
					foreach ($errors as $e) {
						foreach ($e as $el) {
							$msg .= $el . ' ';
						}
					}
					$md->addError('id', 'Failed to save Billing : ' . $msg);
				} else {
					$totActual = 0;
					foreach ($selectedBillingIds as $k => $id) {
						$model = BillingLine::model()->findByPk($id);
						if (!empty($model)) {
							$model->status = 2;
							$model->billing_id = $billing->id;
							if (!empty($_POST['actual'])) {
								if ($model->actual_amount == 0) {
									$model->actual_amount = $model->accrual_amount;
								}
								$model->gst_amount = $model->getGSTValue();
								$model->update('actual_amount', 'gst_amount');
							}
							$totActual += $model->actual_amount;
							if (!empty($invoice)) {
								$model->billing_cref = $invoice;
							}

							$model->update(['billing_id', 'status', 'billing_cref']);
						}
					}
					if ($totActual > 0) {
						$billing->date = $billing->lines[0]->date;
						$billing->due = $billing->lines[0]->due;
						$billing->transaction_date = $billing->lines[0]->transaction_date;
						$billing->total += $totActual;
						$billing->update('total', 'date', 'due', 'transaction_date');
					}
				}
			} else {
				$md->addError('id', 'No item selected');
			}
		}

		$this->ajaxResult($md);
	}

	/**
	 * push all matched successful billing to xero
	 * @throws CDbException
	 */
	public function actionAfbtoXero()
	{
		if (isset($_POST['tdate'])) {
			// get related air freight billing imported history
			$hid = $_POST['fid'];
			$model = AFInvoiceReconciliationHistory::model()->findByPk($hid);
			$pushXeorBillings = array();
			if (!empty($model)) {
				// get all successed matched billing
				if (in_array($model->af[0]->supplier_id, [954, 964]) && empty($model->mdata['insurance'])) {
					$sBillings = AFInvoiceReconciliation::model()->findAll('history_id = :hid AND matched_result = :mok', [':hid' => $hid, ':mok' => AFInvoiceReconciliation::MATCHED_RESULT_SUCCESS]);
					foreach ($sBillings as $billing) {
						// loop each imported invoice

						// step 1
						// try to get all billing lines based on imported invoiced matched EdiJob or ExcoConsol
						// $r = new $billing->model;
						// $pModel = $r::model()->findByPk($billing->fid);
						// if (!empty($pModel)) {
							// only for not sync with xero billing lines
							$pBillingLines = BillingLine::model()->findAll('billing_cref = :cref AND sync_xero in (0,2) AND status != 11 AND org_id = :org_id', [':cref' => $billing->invoice_no, ':org_id' => $billing->supplier_id]);
							$lineGlCodes = array();

							// get imported invoice including GL codes
							foreach ($billing->lines as $line) {
								$lineGlCodes[$line->glcode] = $line;
							}

							// only push to xero for the matched GL codes in EdiJob or ExcoConsol related billing lines
							foreach ($pBillingLines as $pBillingLine) {
								if (isset($lineGlCodes[$pBillingLine->item_code])) {
									if (!isset($pushXeorBillings[$pBillingLine->billing_cref])) {
										$pushXeorBillings[$pBillingLine->billing_cref] = array();
									}
									// $pBillingLine->transaction_date = $_POST['tdate'];
									// $pBillingLine->date = $_POST['date'];
									// $pBillingLine->due = $_POST['due'];
									$pBillingLine->transaction_date = $billing->etd;
									$pBillingLine->date = $billing->etd;
									$pBillingLine->due = $billing->etd;

									// update billing line tax type as well
									if ($lineGlCodes[$pBillingLine->item_code]->gst > 0) {
										$pBillingLine->gst = 'INPUT';
									} else {
										$pBillingLine->gst = 'EXEMPTEXPENSES';

									}
									$pBillingLine->update(['transaction_date', 'date', 'due', 'gst']);
									$pushXeorBillings[$pBillingLine->billing_cref][] = $pBillingLine;
								}
							}
						// }
					}
				} else if (in_array($model->af[0]->supplier_id, array_merge([1133], Org::$airports))) {
					if ($model->invoice_total == $model->totalSuccess + $model->getMatchedRejectedCount()) {
						$billinglines = BillingLine::model()->findAll('billing_cref = :cref AND status != 3 AND status != 11 AND sync_xero != 1 AND org_id = :org_id', array(':cref' => $model->af[0]->invoice_no, ':org_id' => $model->af[0]->supplier_id));
						if (!empty($billinglines)) {
							$pushXeorBillings[$model->af[0]->invoice_no] = array();
							foreach ($billinglines as $line) {
								$line->transaction_date = $_POST['tdate'];
								$line->date = $_POST['date'];
								$line->due = $_POST['due'];
								if (!empty($line->mdata['aline'])) {
									$aline = AFInvoiceReconciliationLine::model()->findByPk($line->mdata['aline']);
									if ($aline->gst > 0) {
										$line->gst = 'INPUT';
									} else {
										$line->gst = 'EXEMPTEXPENSES';
									}
								}
								$line->gst_amount = $line->getGSTValue();

								$line->update(['transaction_date', 'date', 'due', 'gst', 'gst_amount']);
								$pushXeorBillings[$model->af[0]->invoice_no][$line->id] = $line;
							}
						}
					}
				} else if (in_array($model->af[0]->supplier_id, Org::$brokers)) {
					// $sBillings = AFInvoiceReconciliation::model()->findAll('history_id = :hid AND model is not NULL', [':hid' => $hid]);
					$sBillings = AFInvoiceReconciliation::model()->findAll('history_id = :hid AND matched_result = 1', [':hid' => $hid]);
					foreach ($sBillings as $af) {
						$blines = BillingLine::model()->findAll('billing_cref = :cref AND status != 3 AND sync_xero != 1 AND org_id = :org_id', [':cref' => $af->invoice_no, ':org_id' => $model->af[0]->supplier_id]);
						foreach ($blines as $bline) {
							if (!isset($pushXeorBillings[$af->invoice_no])) {
								$pushXeorBillings[$af->invoice_no] = [];
							}
							$pushXeorBillings[$af->invoice_no][] = $bline;
						}
					}
				} else if (in_array($model->af[0]->supplier_id, [964]) && !empty($model->mdata['insurance'])) {
					if ($model->invoice_total == $model->totalSuccess + $model->getMatchedRejectedCount()) {
						$billinglines = BillingLine::model()->findAll('billing_cref = :cref AND status != 3 AND status != 11 AND sync_xero != 1 AND org_id = :org_id', array(':cref' => $model->af[0]->invoice_no, ':org_id' => $model->af[0]->supplier_id));
						if (!empty($billinglines)) {
							$pushXeorBillings[$model->af[0]->invoice_no] = array();
							foreach ($billinglines as $line) {
								if (!empty($line->mdata['aline'])) {
									$aline = AFInvoiceReconciliationLine::model()->findByPk($line->mdata['aline']);
									if ($aline->gst > 0) {
										$line->gst = 'INPUT';
									} else {
										$line->gst = 'EXEMPTEXPENSES';
									}
								}
								$line->gst_amount = $line->getGSTValue();

								$line->update(['transaction_date', 'date', 'due', 'gst', 'gst_amount']);
								$pushXeorBillings[$model->af[0]->invoice_no][] = $line;
							}
						}
					}
				} else {
					$sBillings = AFInvoiceReconciliation::model()->findAll('history_id = :hid AND matched_result = 1', [':hid' => $hid]);
					foreach ($sBillings as $af) {
						$blines = BillingLine::model()->findAll('billing_cref = :cref AND status != 3 AND sync_xero != 1', [':cref' => $af->invoice_no]);
						foreach ($blines as $bline) {
							if (!isset($pushXeorBillings[$af->invoice_no])) {
								$pushXeorBillings[$af->invoice_no] = [];
							}
							$pushXeorBillings[$af->invoice_no][] = $bline;
						}
					}
				}

				if (!empty($pushXeorBillings)) {
					if (!empty($_POST['add_1'])) {
						$add = 1;
					} else if (!empty($_POST['add_2'])) {
						$add = 2;
					} else {
						$add = false;
					}
					$error = $this->postXero($pushXeorBillings, $add);
					if (!empty($error)) {
						$model->addError('id', $error);
					} else {
						foreach ($pushXeorBillings as $invoice => $billings) {
							// $billing = new Billing;
							// $orgId = 0;
							// $type = BillingLine::BILLING_TYPE_OTHERS;
							// $dpmt = 0;
							// foreach ($billings as $k => $model) {
							// 	if (!empty($model)) {
							// 		$orgId = $model->org_id;
							// 		$type = $model->type;
							// 		$dpmt = $model->dpmt;
							// 		break;
							// 	}
							// }
							// $billing->org_id = $orgId;
							// $billing->billing_cref = $invoice;
							// $billing->created = date('Y-m-d');
							// $billing->currency = 1; // default as AUD
							// $billing->status = 3; // as confirmed
							// $billing->dpmt = $dpmt;
							// $billing->type = $type;
							// $billing->dpt_id = Org::PCAE_DEPARTMENT_SYDNEY;
							// $billing->sync_xero = 1;
							// if ($billing->save()) {
							// 	foreach ($billings as $line) {
							// 		$line->billing_id = $billing->id;
							// 		$line->update('billing_id');
							// 	}
							// }
							foreach ($billings as $line) {
								Billing::linkLine($line, false, $line->status);
							}
						}
					}
				} else {
					if (in_array($model->af[0]->supplier_id, [1133])) {
						if ($model->totalFailed > 0) {
							$model->addError('id', 'Not all lines has been matched');
						} else {
							$model->addError('id', 'This invoice has been synced');
						}
					} else {
						$model->addError('id', 'No any matched billing, all matched billing has been synced');
					}
				}
			}
			$this->ajaxResult($model);
		} else {
			$hid = $_GET['fid'];
			$model = AFInvoiceReconciliationHistory::model()->findByPk($hid);
			$this->render('jqm_afbto_xero', ['model' => $model]);
		}
	}

	/**
	 * update Air freight billing with new AWB
	 * @throws CDbException
	 */
	public function actionAfbUpdateAwb()
	{
		if (isset($_POST['awb'])) {
			// get related air freight billing imported history
			$id = $_POST['afid'];
			$model = AFInvoiceReconciliation::model()->findByPk($id);
			if (!empty($model)) {
				// check to see if OP want to change the billing to general cost
				if (isset($_POST['togc'])) {

					$model->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_POST_BY_GENERAL;
					$model->update('matched_result');

				} else {
					// check to see if awb is existing
					// remember don't push dash in awb number, if you push we will remove it
					$awb = trim($_POST['awb']);
					if (!empty($awb)) {
						// clear old billing line for 954, 964
						if (in_array($model->supplier_id, [954, 964]) && !empty($model->invoice_no) && !preg_match('/insurance/i', $model->history->meta)) {
							$lines = BillingLine::model()->findAll('billing_cref = :cref AND org_id = :org_id', [':cref' => $model->invoice_no, ':org_id' => $model->supplier_id]);
							foreach ($lines as $line) {
								if ($line->accrual_amount == 0) {
									$line->status = 11;
									$line->update('status');
								} else {
									$line->actual_amount = 0;
									$line->gst_amount = 0;
									unset($line->mdata['aline']);
									$line->billing_cref = '';
									$line->status = 1;
									$line->update('actual_amount', 'gst_amount', 'billing_cref', 'meta', 'status');
								}
							}
						}

						$bAwbFound = true;
						$job = null;
						$awbNoDash = str_replace('-', '', $awb);
						$dashAwb = substr($awbNoDash, 0, 3) . '-' . substr($awbNoDash, 3);
						$job = EdiJob::model()->find('awb = :awb OR no = :awb', [':awb' => $dashAwb]);
						$job2 = EdiJob::model()->find('awb = :awb OR no = :awb', [':awb' => $awbNoDash]);
						if (!empty($job)) {
							$model->model = 'EdiJob';
							$model->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_WRONG_DIFF_TOOBIG;
							$model->fid = $job->id;
							if ($model->supplier_id == 1133) {
								$model->mdata['model'][] = ['awb' => $awbNoDash, 'model' => 'EdiJob', 'id' => $job->id];
							}
						} else if (!empty($job2)) {
							$model->model = 'EdiJob';
							$model->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_WRONG_DIFF_TOOBIG;
							$model->fid = $job2->id;
							if ($model->supplier_id == 1133) {
								$model->mdata['model'][] = ['awb' => $awbNoDash, 'model' => 'EdiJob', 'id' => $job2->id];
							}
						} else {
							$consol = Consol::model()->find('awb = :awb OR no = :awb', [':awb' => $dashAwb]);
							$consol2 = Consol::model()->find('awb = :awb OR no = :awb', [':awb' => $awbNoDash]);
							if (!empty($consol)) {
								$model->model = get_class($consol);
								$model->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_WRONG_DIFF_TOOBIG;
								$model->fid = $consol->id;
								if ($model->supplier_id == 1133) {
									$model->mdata['model'][] = ['awb' => $awbNoDash, 'model' => get_class($consol), 'id' => $consol->id];
								}
								$job = $consol;
							} else if (!empty($consol2)) {
								$model->model = get_class($consol2);
								$model->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_WRONG_DIFF_TOOBIG;
								$model->fid = $consol2->id;
								if ($model->supplier_id == 1133) {
									$model->mdata['model'][] = ['awb' => $awbNoDash, 'model' => get_class($consol2), 'id' => $consol2->id];
								}
								$job = $consol2;
							} else {
								$bAwbFound = false;
								$model->addError('id', 'AWB related consol or job not found!');
							}
						}
						if ($bAwbFound) {
							$model->awb = $awbNoDash;
							if ($model->supplier_id == 1133) {
								foreach ($model->mdata['model'] as $k => $awb) {
									if (empty($awb['model'])) {
										unset($model->mdata['model'][$k]);
										sort($model->mdata['model']);
									}
								}
								if ($model->notFoundAwb()) {
									$model->awb = $model->notFoundAwb();
								}
							}
							$model->update('awb', 'fid', 'model', 'meta', 'matched_result');
							// re-matched again now
							// if ($model->model == 'ExcoConsol') {
							//     BillingLine::checkMatchedExconsolRealCost($job);
							// } else {
							//     BillingLine::checkMatchedEdiJobRealCost($job);
							// }
						}
					}

					if (!empty($_POST['update_awb'])) {
						$awbs = $_POST['update_awb'];
						foreach ($awbs as $k => $awb) {
							if ($model->mdata['model'][$k]['awb'] != $awb) {
								if (!empty($model->mdata['model'][$k]['model'])) {
									$awbNoDash = str_replace('-', '', $model->mdata['model'][$k]['awb']);
									$dashAwb = substr($awbNoDash, 0, 3) . '-' . substr($awbNoDash, 3);
									if ($model->mdata['model'][$k]['model'] == 'EdiJob') {
										$item = EdiJob::model()->find('awb = :awb1 OR awb = :awb2 OR no = :awb1 OR no = :awb2', array(':awb1' => $dashAwb, ':awb2' => $awbNoDash));
									} else if ($model->mdata['model'][$k]['model'] == 'ExcoConsol') {
										$item = ExcoConsol::model()->find('awb = :awb1 OR awb = :awb2 OR no = :awb1 OR no = :awb2', array(':awb1' => $dashAwb, ':awb2' => $awbNoDash));
									} else if ($model->mdata['model'][$k]['model'] == 'DmawbConsol') {
										$item = DmawbConsol::model()->find('awb = :awb1 OR awb = :awb2 OR no = :awb1 OR no = :awb2', array(':awb1' => $dashAwb, ':awb2' => $awbNoDash));
									} else if ($model->mdata['model'][$k]['model'] == 'ImcoConsol') {
										$item = ImcoConsol::model()->find('awb = :awb1 OR awb = :awb2 OR no = :awb1 OR no = :awb2', array(':awb1' => $dashAwb, ':awb2' => $awbNoDash));
									}
									if (!empty($item)) {
										$billingLines = BillingLine::model()->findAll('billing_ref = :no', array(':no' => $item->no));
										foreach ($billingLines as $line) {
											if (!empty($line->mdata['aline']) && $line->mdata['aline'] == $model->lines[0]->id) {
												if ($line->accrual_amount == 0) {
													$line->status = 11;
													$line->update('status');
												} else {
													$line->actual_amount = 0;
													$line->gst_amount = 0;
													unset($line->mdata['aline']);
													$line->billing_cref = '';
													$line->status = 1;
													$line->update('actual_amount', 'gst_amount', 'billing_cref', 'meta', 'status');
												}
											}
										}
										$model->mdata['model'][$k]['model'] = get_class($item);
										$model->mdata['model'][$k]['id'] = $item->id;
									} else {
										$model->mdata['model'][$k]['model'] = '';
										$model->mdata['model'][$k]['id'] = '';
									}
								}
								$model->mdata['model'][$k]['awb'] = str_replace('-', '', $awb);
							}
						}
						foreach ($model->mdata['model'] as $k => $item) {
							if (empty($item['awb'])) {
								unset($model->mdata['model'][$k]);
							}
						}
						$model->update('meta');
					}

					if (!empty($_POST['mdata']['shipno'])) {
						$model->mdata['shipno'] = $_POST['mdata']['shipno'];
						$model->update('meta');
					}
				}
			} else {
				$model = new AFInvoiceReconciliation();
				$model->addError('id', 'Billing not found!');
			}

			if (in_array($model->supplier_id, [954])) {
				$this->matchAFInvoiceWithHvlv($model);
			} else if (in_array($model->supplier_id, [964]) && !preg_match('/insurance/i', $model->history->meta)) {
				$this->matchYYInvoiceWithHvlv($model);
			} else if (in_array($model->supplier_id, [1133])) {
				$this->matchTneInvoiceWithHvlv($model);
			} else if (in_array($model->supplier_id, Org::$brokers)) {
				$this->matchBrokerInvoiceWithHvlv($model);
			} else if (in_array($model->supplier_id, [964]) && preg_match('/insurance/i', $model->history->meta)) {
				$this->matchIFInvoiceWithHvlv($model);
			}

			$this->ajaxResult($model);
		} else {
			$id = $_GET['afid'];
			$model = AFInvoiceReconciliation::model()->findByPk($id);
			$this->render('jqm_afb_update_awb', ['model' => $model]);
		}
	}

	public function actionAfbUpdateAwbImport()
	{
		$id = $_GET['afid'];
		$model = AFInvoiceReconciliation::model()->findByPk($id);
		if (empty($_POST['awb'])) {
			$this->render('jqm_afb_update_awb_import', ['model' => $model]);
		} else {
			$awbs = preg_split('/[\s,;]+/', trim($_POST['awb']));

			$not_exist = false;
			// check ImcoConsol / DmawbConsol
			foreach ($awbs as $awb) {
				$awbNoDash = str_replace('-', '', $awb);
				$dashAwb = substr($awbNoDash, 0, 3) . '-' . substr($awbNoDash, 3);
				$consol = Consol::model()->find('awb = :awb1 OR awb = :awb2 OR no = :awb1 OR no = :awb2', [':awb1' => $dashAwb, ':awb2' => $awbNoDash]);

				if (empty($consol) || !in_array(get_class($consol), ['ImcoConsol', 'DmawbConsol'])) {
					$not_exist = true;
					break;
				}
			}

			if (!$not_exist) {
				$model->mdata['import_model'] = [];
				foreach ($awbs as $awb) {
					$awbNoDash = str_replace('-', '', $awb);
					$dashAwb = substr($awbNoDash, 0, 3) . '-' . substr($awbNoDash, 3);
					$consol = Consol::model()->find('awb = :awb1 OR awb = :awb2 OR no = :awb1 OR no = :awb2', [':awb1' => $dashAwb, ':awb2' => $awbNoDash]);

					$bl = new BillingLine;
					$bl->billing_id = 0;
					$bl->org_id = 1133;
					$bl->op_id = $model->op;
					$bl->link_id = $consol->id;
					$bl->type = BillingLine::BILLING_TYPE_IMPORT;
					$bl->dpmt = Invoice::DPMT_IMPORT;
					$bl->billing_ref = $consol->no;
					$bl->awb = $consol->awb;
					$bl->dpt_id = $consol->dpt_id;
					$bl->currency = 1;
					$bl->created = date('Y-m-d');
					$bl->date = date('Y-m-d');
					$bl->due = $bl->date;
					$bl->transaction_date = $bl->date;
					if ($model->lines[0]->gst > 0) {
						$bl->gst = 'INPUT';
					} else {
						$bl->gst = 'EXEMPTEXPENSES';
					}
					$bl->status = 1;
					$bl->billing_cref = $model->invoice_no;
					$bl->actual_amount = number_format(round($model->lines[0]->amount / count($awbs) * 100) / 100, 2);
					$bl->accrual_amount = number_format(round($model->lines[0]->amount / count($awbs) * 100) / 100, 2);
					$bl->gst_amount = number_format(round($model->lines[0]->gst / count($awbs) * 100) / 100, 2);
					$bl->charge_code = 91031;
					$bl->desc = $model->lines[0]->desc;
					$bl->qty = 1;
					$bl->item_code = $model->lines[0]->glcode;
					$bl->price = 0;
					$bl->weight = 0;
					$bl->charge_weight = 0;
					$bl->sync_xero = 0;
					$bl->mdata['aline'] = $model->lines[0]->id;
					$bl->save();

					$model->mdata['import_model'][] = ['awb' => $awb, 'model' => get_class($consol), 'id' => $consol->id];
				}
				$model->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_SUCCESS;
				$model->save();
			}

			if ($not_exist) {
				$not_exist = false;
				// check WmsTask
				foreach ($awbs as $awb) {
					$task = WmsTask::model()->find('id = :id', [':id' => str_replace('T', '', $awb)]);

					if (empty($task)) {
						$not_exist = true;
						break;
					}
				}

				if (!$not_exist) {
					$model->mdata['import_model'] = [];
					foreach ($awbs as $awb) {
						$task = WmsTask::model()->find('id = :id', [':id' => str_replace('T', '', $awb)]);

						$bl = new BillingLine;
						$bl->billing_id = 0;
						$bl->org_id = 1133;
						$bl->op_id = $model->op;
						$bl->link_id = $task->id;
						$bl->type = BillingLine::BILLING_TYPE_3PL;
						$bl->dpmt = Invoice::DPMT_3PL;
						$bl->billing_ref = $task->no;
						$bl->awb = '';
						$bl->dpt_id = 106;
						$bl->currency = 1;
						$bl->created = date('Y-m-d');
						$bl->date = date('Y-m-d');
						$bl->due = $bl->date;
						$bl->transaction_date = $bl->date;
						if ($model->lines[0]->gst > 0) {
							$bl->gst = 'INPUT';
						} else {
							$bl->gst = 'EXEMPTEXPENSES';
						}
						$bl->status = 1;
						$bl->billing_cref = $model->invoice_no;
						$bl->actual_amount = $model->lines[0]->amount / count($awbs);
						$bl->accrual_amount = $model->lines[0]->amount / count($awbs);
						$bl->gst_amount = $model->lines[0]->gst / count($awbs);
						$bl->charge_code = 91022;
						$bl->desc = $model->lines[0]->desc;
						$bl->qty = 1;
						$bl->item_code = $model->lines[0]->glcode;
						$bl->price = 0;
						$bl->weight = 0;
						$bl->charge_weight = 0;
						$bl->sync_xero = 0;
						$bl->mdata['aline'] = $model->lines[0]->id;
						$bl->save();

						$model->mdata['import_model'][] = ['awb' => $awb, 'model' => get_class($task), 'id' => $task->id];
					}
					$model->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_SUCCESS;
					$model->save();
				}
			}

			if ($not_exist) {
				$model->addError('id', 'Not exist');
			}

			$this->ajaxResult($model);
		}
	}

	public function actionSendOp()
	{
		if (isset($_GET['fid'])) {
			// update billing actual amount
			$model = BillingLine::model()->findByPk($_GET['fid']);
			if (!empty($model)) {
				$model->status = 1;
				$model->billing_cref = '';
				$model->billing_id = 0;
				$model->update('status', 'billing_cref', 'billing_id');
			}
			$this->ajaxResult($model);
		}
	}

	public function actionUpdateLineFromAc()
	{
		if (isset($_POST['BillingLine'])) {
			// update billing actual amount
			$model = BillingLine::model()->findByPk($_POST['BillingLine']['id']);
			if (!empty($model)) {
				$model->actual_amount = $_POST['BillingLine']['actual_amount'];
				$model->gst = $_POST['BillingLine']['gst'];
				$model->gst_amount = $model->getGSTValue();
				$pre_billing = Billing::model()->find('billing_cref = :cref', [':cref' => $model->billing_cref]); // pre billing for copy
				$model->billing_cref = $_POST['BillingLine']['billing_cref'];
				if ($model->actual_amount > 0) {
					$billing = Billing::model()->find('billing_cref = :cref', [':cref' => $model->billing_cref]);
					if (empty($billing)) {
						$billing = new Billing();
						$billing->org_id = $pre_billing->org_id;
						$billing->created = date('Y-m-d');
						$billing->type = $pre_billing->type;
						$billing->dpmt = $pre_billing->dpmt;
						$billing->status = 2; // as confirmed
						$billing->billing_cref = $model->billing_cref;
						$billing->dpt_id = $pre_billing->dpt_id;
						$billing->currency = $pre_billing->currency;
						$billing->total = $model->actual_amount;
						$billing->save();
					} else {
						$billing->total += $model->actual_amount;
						$billing->update(['total']);
					}
					$pre_billing->total -= $model->actual_amount;
					$pre_billing->update(['total']);
					$model->billing_id = $billing->id;
					$model->update(['actual_amount', 'gst', 'billing_cref', 'billing_id', 'gst_amount']);
				} else {
					$model->addError('id', 'Actual Amount must be more than zero');
				}
				if (count($pre_billing->lines) == 0) {
					$pre_billing->status = 11;
					$pre_billing->update(['status']);
				}
			}
			$this->ajaxResult($model);
		}
	}

	public function actionAjaxEqualActualAmount()
	{
		$resp = new stdClass();
		$lineId = $_POST['lid'];
		$billing = BillingLine::model()->findByPk($lineId);
		if (!empty($billing)) {
			$billing->actual_amount = $billing->accrual_amount;
			$billing->update('actual_amount');
			$resp->success = 1;
			$resp->id = $lineId;
		} else {
			$resp->success = 0;
			$resp->msg = 'Billing Line not found';
		}
		echo json_encode($resp);
	}

	public function actionUpdateLine()
	{
		if (isset($_POST['BillingLine'])) {
			// update billing actual amount
			$model = BillingLine::model()->findByPk($_POST['BillingLine']['id']);
			if (!empty($model)) {
				$model->actual_amount = $_POST['BillingLine']['actual_amount'];
				$model->gst_amount = $model->getGSTValue();
				$model->update('actual_amount', 'gst_amount');
			}
			$this->ajaxResult($model);
		}
	}

