			foreach ($rs as $r) {
				$xls->addRow($i++, [$r['v8'], $r['v1'], $r['v2'], $r['v3'], $r['v4'], $r['v5'], $r['v6']]);
				if (empty($invs[$r['v5']])) $invs[$r['v5']] = 0;
				$invs[$r['v5']] += $r['v6'];
			}
		}
	}

	private function _pitManual(&$xls, &$invs, $cond, &$page)
	{
		$sql = 'SELECT srl.ref AS v1, srl.item_code AS v2, consol.no AS v3, consol.eta AS v4, si.inv_no AS v5, srl.value AS v6, (SELECT name FROM hvlv_db.org WHERE id = sr.org_id) AS v8 FROM hvlv_top.`si_reconcile_line` srl JOIN hvlv_top.`si_reconcile` sr ON srl.rec_id = sr.id JOIN hvlv_top.`supplier_invoice` si ON si.id = sr.supplier_invoice_id LEFT JOIN hvlv_db.consol ON consol.type IN (15,70,80) AND consol.id = srl.fid WHERE si.type = 4 AND sr.status < 100' . $cond;

		$rs = Yii::app()->db->createCommand($sql)->queryAll();
		if (!empty($rs)) {
			$xls->createSheet('Manual');
			$xls->goSheet($page++);
			$xls->setTitle('Manual');
			$i = 1;
			$xls->setColWidth([20,15,15,20,20,20,20]);
			$xls->centerAlignment('A1:F1000');
			$xls->addRow($i++, ['Supplier', 'Ref', 'Item Code', 'Consol No', 'Consol ETA', 'Invoice No', 'Amount (Excl.GST)']);

			foreach ($rs as $r) {
				$xls->addRow($i++, [$r['v8'], $r['v1'], $r['v2'], $r['v3'], $r['v4'], $r['v5'], $r['v6']]);
				if (empty($invs[$r['v5']])) $invs[$r['v5']] = 0;
				$invs[$r['v5']] += $r['v6'];
			}
		}
	}

	private function _tipCourier(&$xls, &$invs, $cond, &$page)
	{
		$sql = 'SELECT srl.id AS v0, srl.ref AS v1, srl.item_code AS v2, consol.no AS v3, consol.eta AS v4, si.inv_no AS v5, srl.value AS v6, srl.my_value AS v7, (SELECT name FROM hvlv_db.org WHERE id = sr.org_id) AS v8 FROM hvlv_db.`si_reconcile_line` srl JOIN hvlv_db.`si_reconcile` sr ON srl.rec_id = sr.id JOIN hvlv_db.`supplier_invoice` si ON si.id = sr.supplier_invoice_id JOIN hvlv_db.shipment ON shipment.id = srl.fid LEFT JOIN hvlv_db.consol ON consol.type IN (15,70,80) AND consol.id = shipment.consol_id WHERE si.type = 1 AND srl.model = "ImParcel" AND consol.no NOT LIKE "3PL%" AND sr.status < 100' . $cond . ' 
		union
		SELECT srl.id AS v0, srl.ref AS v1, srl.item_code AS v2, consol.no AS v3, consol.eta AS v4, si.inv_no AS v5, srl.value AS v6, srl.my_value AS v7, (SELECT name FROM hvlv_db.org WHERE id = sr.org_id) AS v8 FROM hvlv_db.`si_reconcile_line` srl JOIN hvlv_db.`si_reconcile` sr ON srl.rec_id = sr.id JOIN hvlv_db.`supplier_invoice` si ON si.id = sr.supplier_invoice_id LEFT JOIN hvlv_db.consol ON consol.type IN (15,70,80) AND consol.awb = srl.ref WHERE si.type = 1 AND srl.item_code = "letter" AND consol.no NOT LIKE "3PL%" AND sr.status < 100' . $cond . ' 
		union
		SELECT srl.id AS v0, srl.ref AS v1, srl.item_code AS v2, consol.no AS v3, consol.eta AS v4, si.inv_no AS v5, srl.value AS v6, srl.my_value AS v7, (SELECT name FROM hvlv_db.org WHERE id = sr.org_id) AS v8 FROM hvlv_db.`si_reconcile_line` srl JOIN hvlv_db.`si_reconcile` sr ON srl.rec_id = sr.id JOIN hvlv_db.`supplier_invoice` si ON si.id = sr.supplier_invoice_id LEFT JOIN hvlv_db.consol ON consol.type IN (15,70,80) AND json_query(consol.meta, "$.elms") LIKE concat("%", srl.ref, "%") WHERE si.type = 1 AND srl.item_code = "letter" AND consol.no NOT LIKE "3PL%" AND sr.status < 100' . $cond . ' 
		union
		SELECT DISTINCT(srl.id) AS v0, srl.ref AS v1, srl.item_code AS v2, consol.no AS v3, consol.eta AS v4, si.inv_no AS v5, srl.value AS v6, srl.my_value AS v7, (SELECT name FROM hvlv_db.org WHERE id = sr.org_id) AS v8 FROM hvlv_db.`si_reconcile_line` srl JOIN hvlv_db.`si_reconcile` sr ON srl.rec_id = sr.id JOIN hvlv_db.`supplier_invoice` si ON si.id = sr.supplier_invoice_id JOIN hvlv_db.manifest ON manifest.ref = srl.ref JOIN hvlv_db.mani_map mm ON mm.mani_id = manifest.id JOIN shipment ON mm.fid = shipment.id JOIN consol ON consol.type IN (15,70,80) AND consol.id = shipment.consol_id WHERE si.type = 1 AND srl.item_code = "rts" AND consol.no NOT LIKE "3PL%" AND sr.status < 100' . $cond . ' GROUP BY v0';

		$rs = Yii::app()->db->createCommand($sql)->queryAll();
		if (!empty($rs)) {
			$xls->createSheet('Courier');
			$xls->goSheet($page++);
			$xls->setTitle('Courier');
			$i = 1;
			$xls->setColWidth([20,15,15,20,20,20,20,20]);
			$xls->centerAlignment('A1:G1000');
			$xls->addRow($i++, ['Supplier', 'Ref', 'Item Code', 'Consol No', 'Consol ETA', 'Invoice No', 'Amount (Excl.GST)', 'Accrual (Excl.GST)']);

			foreach ($rs as $r) {
				$xls->addRow($i++, [$r['v8'], $r['v1'], $r['v2'], $r['v3'], $r['v4'], $r['v5'], $r['v6'], $r['v7']]);
				if (empty($invs[$r['v5']])) $invs[$r['v5']] = 0;
				$invs[$r['v5']] += $r['v6'];
			}
		}

		// can't find shipment or consol
		$sql = 'SELECT id AS v0, ref AS v1, item_code AS v2, null AS v3, null AS v4, (SELECT inv_no FROM hvlv_db.`supplier_invoice` WHERE id IN (SELECT supplier_invoice_id FROM hvlv_db.`si_reconcile` WHERE id = rec_id)) AS v5, value AS v6, my_value AS v7, (SELECT name FROM hvlv_db.org WHERE id = (SELECT org_id FROM hvlv_db.`supplier_invoice` WHERE id IN (SELECT supplier_invoice_id FROM hvlv_db.`si_reconcile` WHERE id = rec_id))) AS v8 FROM hvlv_db.`si_reconcile_line` WHERE rec_id in (SELECT id FROM hvlv_db.`si_reconcile` WHERE status < 100 AND supplier_invoice_id in (SELECT id FROM hvlv_db.`supplier_invoice` si WHERE type = 1' . $cond . ' )) AND ((item_code != "eparcel" AND item_code != "eparcel-fuel" AND id NOT IN (SELECT v0 FROM (' . $sql . ') a)) OR (item_code = "eparcel" AND id NOT IN (SELECT srl.inline_pid FROM hvlv_db.`si_reconcile_line` srl JOIN hvlv_db.`si_reconcile` sr ON srl.rec_id = sr.id JOIN hvlv_db.`supplier_invoice` si ON si.id = sr.supplier_invoice_id JOIN hvlv_db.shipment ON shipment.id = srl.fid LEFT JOIN hvlv_db.consol ON consol.type IN (15,70,80) AND consol.id = shipment.consol_id WHERE si.type = 1 AND srl.model = "ImParcel" AND sr.status < 100' . $cond . ')))';
		$rs = Yii::app()->db->createCommand($sql)->queryAll();
		if (!empty($rs)) {
			$xls->createSheet('Courier Unknown');
			$xls->goSheet($page++);
			$xls->setTitle('Courier Unknown');
			$i = 1;
			$xls->setColWidth([20,15,15,20,20,20]);
			$xls->centerAlignment('A1:G1000');
			$xls->addRow($i++, ['Supplier', 'Ref', 'Item Code', 'Invoice No', 'Amount (Excl.GST)', 'Accrual (Excl.GST)']);

			foreach ($rs as $r) {
				$xls->addRow($i++, [$r['v8'], $r['v1'], $r['v2'], $r['v5'], $r['v6'], $r['v7']]);
				if (empty($invs[$r['v5']])) $invs[$r['v5']] = 0;
				$invs[$r['v5']] += $r['v6'];
			}
		}

		// auspost adjust
		$sql = 'SELECT v0, v2 AS v1, "eParcel" AS v2, null AS v3, null AS v4, v6 AS v5, v3-v1 AS v6, v5-v4 AS v7 from (SELECT inline_pid AS v0, SUM(value) AS v1, (SELECT ref FROM hvlv_db.si_reconcile_line WHERE id = srl.inline_pid) AS v2, (SELECT value FROM hvlv_db.si_reconcile_line WHERE id = srl.inline_pid) AS v3, sum(my_value) AS v4, (SELECT my_value FROM hvlv_db.si_reconcile_line WHERE id = srl.inline_pid) AS v5, (SELECT inv_no FROM hvlv_db.supplier_invoice WHERE id = (SELECT supplier_invoice_id FROM hvlv_db.si_reconcile WHERE id = rec_id)) AS v6 FROM hvlv_db.si_reconcile_line srl WHERE rec_id in (SELECT id FROM hvlv_db.si_reconcile WHERE status < 100 AND supplier_invoice_id IN (SELECT id FROM hvlv_db.supplier_invoice si WHERE type = 1' . $cond . ')) AND model = "imParcel" GROUP BY inline_pid HAVING v1 != v3) a';
		$rs = Yii::app()->db->createCommand($sql)->queryAll();
		if (!empty($rs)) {
			$xls->createSheet('Auspost Manifest Adjust');
			$xls->goSheet($page++);
			$xls->setTitle('Auspost Manifest Adjust');
			$i = 1;
			$xls->setColWidth([15,15,20,20]);
			$xls->centerAlignment('A1:D1000');
			$xls->addRow($i++, ['Ref', 'Item Code', 'Invoice No', 'Amount (Excl.GST)']);

			foreach ($rs as $r) {
				$consols = Consol::model()->with('shipments.mms.manifest')->findAll('manifest.ref = :ref', [':ref' => $r['v1']]);
				$temp = [];
				foreach ($consols as $consol) {
					$temp[] = $consol->no;
				}
				$xls->addRow($i++, [$r['v1'], $r['v2'], $r['v5'], $r['v6'], implode(', ', $temp)]);
				if (empty($invs[$r['v5']])) $invs[$r['v5']] = 0;
				$invs[$r['v5']] += $r['v6'];
			}
		}
	}

	private function _tipBroker(&$xls, &$invs, $cond, &$page)
	{
		$sql = 'SELECT srl.id AS v0, srl.ref AS v1, srl.item_code AS v2, consol.no AS v3, consol.eta AS v4, si.inv_no AS v5, srl.value AS v6, (SELECT name FROM hvlv_db.org WHERE id = sr.org_id) AS v8 FROM hvlv_db.`si_reconcile_line` srl JOIN hvlv_db.`si_reconcile` sr ON srl.rec_id = sr.id JOIN hvlv_db.`supplier_invoice` si ON si.id = sr.supplier_invoice_id JOIN hvlv_db.shipment ON shipment.id = srl.fid LEFT JOIN hvlv_db.consol ON consol.type IN (15,70,80) AND consol.id = shipment.consol_id WHERE si.type = 2 AND srl.model = "ImParcel" AND sr.status < 100' . $cond;

		$rs = Yii::app()->db->createCommand($sql)->queryAll();
		if (!empty($rs)) {
			$xls->createSheet('Broker');
			$xls->goSheet($page++);
			$xls->setTitle('Broker');
			$i = 1;
			$xls->setColWidth([20,15,15,20,20,20,20]);
			$xls->centerAlignment('A1:F1000');
			$xls->addRow($i++, ['Supplier', 'Ref', 'Item Code', 'Consol No', 'Consol ETA', 'Invoice No', 'Amount (Excl.GST)']);

			foreach ($rs as $r) {
				$xls->addRow($i++, [$r['v8'], $r['v1'], $r['v2'], $r['v3'], $r['v4'], $r['v5'], $r['v6']]);
				if (empty($invs[$r['v5']])) $invs[$r['v5']] = 0;
				$invs[$r['v5']] += $r['v6'];
			}
		}
	}

