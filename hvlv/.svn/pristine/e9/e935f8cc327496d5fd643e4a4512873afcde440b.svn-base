				$bl->gst = 'INPUT';
			} else {
				$bl->gst = 'EXEMPTEXPENSES';
			}
			$bl->status = 2;
			$bl->billing_cref = $model->invoice_no;
			$bl->desc = $model->lines[0]->desc;
			$bl->qty = 1;
			$bl->price = $model->lines[0]->amount;
			$bl->dpt_id = 106;
			$bl->currency = 1;
			$bl->actual_amount = $model->lines[0]->amount;
			$bl->accrual_amount = $model->lines[0]->amount;
			$bl->gst_amount = $model->lines[0]->gst;
			if ($model->lines[0]->glcode) {
				$charge_item_type = ChargeItemType::model()->find('code = :code', array(':code' => $model->lines[0]->glcode));
				if ($charge_item_type) {
					$bl->charge_code = $charge_item_type->cost_code;
				}
			}
			$bl->weight = 0;
			$bl->charge_weight = 0;
			$bl->item_code = $model->lines[0]->glcode;
			$bl->sync_xero = 0;
			$bl->mdata['aline'] = $model->lines[0]->id;
			$bl->save();

			$model->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_SUCCESS;
			$model->update('matched_result');
			$this->ajaxResult($model);
		}
	}

