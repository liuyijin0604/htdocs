	public function actionDisputeTask()
	{
		$tab = $_GET['tab'];
		if(Acl::hasAccess($this->CaName, true))
		{
			$filtersForm=new FiltersForm;
			if (isset($_GET['FiltersForm'])) {
				$filtersForm->filters=$_GET['FiltersForm'];
			}
			$provide = [];
			$model = new DisputeSupplierTask('search');
			$model->unsetAttributes();
			$model->status != TlaTask::CLOSE;
			if (isset($_GET['DisputeSupplierTask'])) {
				$model->setAttributes($_GET['DisputeSupplierTask']);
				$this->render('dispute_task', array('model' => $model,'tab'=>$tab));
				return;
			}else
			{
				$kpiService = new KpiService();
				$provide = $kpiService->calculateMonthDisputeSupplierTaskKPI(date("Y-m"),true);
				$filteredData=$filtersForm->filter($provide);
				$dataprovider=new CArrayDataProvider($filteredData);
				$dataprovider->pagination=['pageSize' =>999,];
				$sort=new CSort();
				$sort->defaultOrder = "id ASC";
				$dataprovider->sort=$sort;
			}

			$this->render('dispute_task', array('dataProvider'=>[$dataprovider,$filtersForm],'model' => $model,'tab'=>$tab));
		}
	}

