	/**
	 * @param $job
	 * @param $billing
	 * @return array
	 * @throws CDbException
	 */
	private function saveEdiJobBilling(&$job, &$billing)
	{
		$errors = array();
		foreach ($billing['lines'] as $line) {

			// check to see if related edi job line existing
			// if existing  we check to see if actual amount is equal or less than to accrual amount
			$glCode = trim($line['glcode']);
			$jobLine = JobLine::model()->find('job_id = :jid AND ccode = :glcode ', [':jid' => $job->id, ':glcode' => $glCode]);
			if (!empty($jobLine)) {
				$billingPro = BillingLine::model()->find('link_id = :linkid AND type = ' . BillingLine::BILLING_TYPE_AIR_SEA, [':linkid' => $jobLine->id]);
				if (!empty($billingPro)) {

					if (!$billingPro->isBillingClosed()) {
						// calculate total
						$gst = $line['gst'];
						$amount = floatval($line['value']);
						$total = $amount;
						if ($gst) {
							$total += ($total * 10) / 100;
						}
						$total = round($total, 2);

						// if less or equal accrual amount , just push to accounting operation directly
						if ($billingPro->accrual_amount >= $total) {
							// push to accouting operation
							$billingPro->status = 2;
						} else {
							// otherwise just input the accurate amount
							$billingPro->actual_amount = $total;
						}
						$billingPro->update(['status', 'actual_amount']);

						// update related pl ledger as well
						$chargeCodeModel = Chargecode::model()->find('status = 1 AND code = :code', [':code' => $billingPro->charge_code]);
						$chargeCodeId = empty($chargeCodeModel) ? 0 : $chargeCodeModel->id;

						// check accrual cost
						if ($billingPro->accrual_amount > 0) {
							$d = [
								'gl' => $chargeCodeId,
								'fid' => $billingPro->id,
								'model' => 'BillingLine',
								'dpt_id' => $billingPro->dpt_id,
								'lid' => 0,
								'org_id' => $billingPro->org_id,
								'dpmt' => $billingPro->dpmt,
								'grp1' => '',
								'date' => $billingPro->date,
								'amt' => $billingPro->accrual_amount,
								'actual_amt' => $billingPro->actual_amount,
								'gst' => 0,
							];

							//PlLedger::add($d, true, ['org_id', 'dpmt', 'date', 'lid', 'grp1', 'grp2']);
						}

					} else {
						$errors[] = 'Billing line : ' . $billingPro->id . ' is frozen we can not change it ';
					}

				} else {
					$errors[] = 'item : ' . $line['desc'] . ' in invoice : ' . $billing['number'] . ' related billing line not found';
				}
			} else {
				$errors[] = 'item : ' . $line['desc'] . ' in invoice : ' . $billing['number'] . ' related EDI job line not found';
			}
		}
		return $errors;
	}

	/**
	 * @param $consol
	 * @param $billing
	 * @return array
	 */
	private function saveExconsolBilling(&$consol, &$billing)
	{
		$supplierId = 964; // for priority cargo only
		foreach ($billing['lines'] as $line) {
			$bl = BillingLine::model()->find('billing_ref = :ref AND org_id = :oid AND charge_code = :ccode AND type = :type',
				[':type' => BillingLine::BILLING_TYPE_EXPORT,
					':ref' => $consol->no,
					':oid' => $supplierId,
					':ccode' => $line['chargecode']]);

			if (empty($bl)) {
				$bl = new BillingLine();
				$bl->type = BillingLine::BILLING_TYPE_EXPORT;
				$bl->status = 1; // initial pending status
				$bl->link_id = 0;
				$bl->org_id = $supplierId;
				$bl->charge_code = $line['chargecode'];
				$bl->billing_cref = $consol->no;
				$bl->billing_ref = $consol->no;
				$bl->currency = 1; // AUD default
				$bl->weight = $billing['weight'];
				$bl->charge_weight = $billing['chargeWeight'];
				$dashAwb = substr($billing['awb'], 0, 3) . '-' . substr($billing['awb'], 3);
				$bl->awb = $dashAwb;
				$bl->dpt_id = Org::PCAE_DEPARTMENT_SYDNEY;
				$bl->date = $billing['date'];
				$bl->created = $billing['date'];
				$bl->transaction_date = $bl->date;
				$bl->due = $billing['due'];
				$bl->type = BillingLine::BILLING_TYPE_EXPORT; // for export type
				$bl->dpmt = Invoice::DPMT_EXPORT;
			}
			$gst = $line['gst'];
			$total = floatval($line['value']);
			if ($gst) {
				$total += ($total * 10) / 100;
				$bl->gst = 'INPUT'; // gst on expense
			} else {
				$bl->gst = 'EXEMPTEXPENSES'; // gst free expense
			}
			$bl->accrual_amount = $total;
			$bl->actual_amount = $total;
			$bl->save();

			// push to pl ledger table as well
			$chargeCodeModel = Chargecode::model()->find('status = 1 AND code = :code', [':code' => $bl->charge_code]);
			$chargeCodeId = empty($chargeCodeModel) ? 0 : $chargeCodeModel->id;
			$d = [
				'gl' => $chargeCodeId,
				'fid' => $bl->id,
				'model' => 'BillingLine',
				'dpt_id' => $bl->dpt_id,
				'lid' => 0,
				'org_id' => $bl->org_id,
				'dpmt' => $bl->dpmt,
				'grp1' => $consol->id,
				'date' => $bl->created,
				'amt' => $bl->accrual_amount,
				'actual_amt' => $bl->actual_amount,
				'gst' => 0,
			];

			//PlLedger::add($d, true, ['org_id', 'dpmt', 'date', 'lid', 'grp1', 'grp2']);
		}
	}

	public function actionAjaxCheckEdiInvoiceProgress()
	{
		$d = Yii::app()->cache->get('pid_'.md5(session_id().'ediInvoiceProgress'));
		if ($d != false) {
			if ($d['percent'] == 100) {
				Yii::app()->cache->delete('pid_'.md5(session_id().'ediInvoiceProgress'));
			}
			echo json_encode($d);
		} else {
			echo json_encode(["percent" => 100, "message" => 'all done']);
		}
	}

	private function saveEdiInvoiceProgressFile($percent, $message)
	{
		Yii::app()->cache->set('pid_'.md5(session_id().'ediInvoiceProgress'), ['percent' => $percent, 'message' => $message], 300);
	}

	public function actionMngEdiChargecodeMap()
	{
		$this->render('mng_edit_chargecode_map');
	}

	public function actionEdiChargecodeMapgrid()
	{
		if (isset($_POST['ExportChargecodeMap'])) {
			if (empty($_POST['ExportChargecodeMap']['id'])) {
				$model = new ExportChargecodeMap();
			} else {
				$model = ExportChargecodeMap::model()->findByPk($_POST['ExportChargecodeMap']['id']);
			}
			$model->attributes = $_POST['ExportChargecodeMap'];
			$model->save();
			$this->ajaxResult($model);
		}
	}

	public function actionImportBilling()
	{
		switch ($_GET['type']) {
			case 'template': {
				if (isset($_FILES) && !empty($_FILES)) {
					// file exist
					$file = empty($_FILES['import_billing_template']) ? array() : $_FILES['import_billing_template'];
					if (empty($file['tmp_name']) || !is_uploaded_file($file['tmp_name'])) {
						echo json_encode(['msg' => 'Invalid template file']);
						return;
					}

					// valid extension
					$filename = $file['name'];
					$ext = pathinfo($filename, PATHINFO_EXTENSION);
					if (!in_array(strtolower($ext), ['xls', 'xlsx', 'csv'])) {
						echo json_encode(['msg' => 'Invalid template file']);
						return;
					}

					// process data
					$xls = new oExcel;
					$xls->load($file['tmp_name']);
					$data = $xls->getAll($xls->goSheet(0));

					$transaction = Yii::app()->db->beginTransaction();

					$billings = [];
					foreach ($data as $row => $rowData) {
						// title
						if ($row == 1) {
							continue;
						}

						// consol info
						if ($rowData[5]) {
							// check billing ref
							$ret = BillingLine::getModel($rowData[5]);
							$consol = $ret['consol'];
							$nonexist = $ret['nonexist'];

							if ($nonexist) {
								$transaction->rollback();
								echo json_encode(['msg' => 'Line ' . $row . ' Billing Ref is invalid']);
								return;
							}
						}

						if (empty($rowData[8])) {
							$transaction->rollback();
							echo json_encode(['msg' => 'Line ' . $row . ' qty is empty']);
							return;
						}

						// billing info
						// Branch / Department / SupplierName / Invoice# / BillingRef / Currency / Date / DueDate / TransactionDate
						if (($rowData[1] && $rowData[2] && $rowData[3] && $rowData[4] && $rowData[5] && $rowData[6]) || ($rowData[4] && $rowData[5] && $rowData[6])) {
							if (empty($rowData[1])) {
								$rowData[1] = $last_branch;
							} else {
								$last_branch = $rowData[1];
							}
							if (empty($rowData[2])) {
								$rowData[2] = $last_department;
							} else {
								$last_department = $rowData[2];
							}
							if (empty($rowData[3])) {
								$rowData[3] = $last_supplier;
							} else {
								$last_supplier = $rowData[3];
							}
							$org = Org::model()->find('status = 1 AND type IN (15,70) AND (name LIKE :n OR code LIKE :n OR id = :tn)', array(':n' => '%' . $rowData[3] . '%', ':tn' => $rowData[3]));

							// check org
							if (empty($org)) {
								$transaction->rollback();
								echo json_encode(['msg' => 'Line ' . $row . ' Supplier Name is invalid']);
								return;
							}

							if (!array_search($rowData[2], Invoice::$dpmts)) {
								$transaction->rollback();
								echo json_encode(['msg' => 'Line ' . $row . ' Department is invalid']);
								return;
							}

							if (!array_search($rowData[1], Org::dptList())) {
								$transaction->rollback();
								echo json_encode(['msg' => 'Line ' . $row . ' Branch is invalid']);
								return;
							}

							$billing = Billing::model()->find('org_id = :oid AND billing_cref = :cref', array(':oid' => $org->id, ':cref' => $rowData[4]));
							if (empty($billing)) {
								$billing = new Billing('create');
								$billing->org_id = $org->id;
								$billing->created = date('Y-m-d');
								$billing->billing_cref = $rowData[4];
								$billing->billing_ref = $consol->no;
							}
							$billing->status = 2;
							$billing->date = oExcel::toDate($rowData[6]);
							$billing->due = oExcel::toDate($rowData[6]);
							$billing->transaction_date = oExcel::toDate($rowData[6]);
							$billing->dpmt = array_search($rowData[2], Invoice::$dpmts);
							if ($billing->dpmt == 10) {
								$billing->type = 1;
							} else if ($billing->dpmt == 20) {
								$billing->type = 2;
							} else if (in_array($billing->dpmt, [30, 40])) {
								$billing->type = 3;
							}
							$billing->dpt_id = array_search($rowData[1], Org::dptList());
							$billing->currency = array_search('AUD', Invoice::$currencies);
							$billing->save();
							$billings[] = $billing;
						}

						// billing line info
						// Qty / Price / ActualAmount / ChargeCode / TaxRate
						if ($rowData[8] && $rowData[9] && $rowData[10] && $rowData[11] && $rowData[12]) {
							$chargecode = array();
							foreach (Billing::getChargeCodeAll($rowData[11]) as $v) {
								$chargecode[$v['value']] = $v['label'];
							}

							if (!array_search($rowData[11], $chargecode)) {
								$transaction->rollback();
								echo json_encode(['msg' => 'Line ' . $row . ' Charge Code is invalid']);
								return;
							}

							if (!array_search($rowData[12], Invoice::$InvoiceCostTaxRate)) {
								$transaction->rollback();
								echo json_encode(['msg' => 'Line ' . $row . ' Tax Rate is invalid']);
								return;
							}

							if (in_array($billing->org_id, Org::$airports)) {
								$billingline = BillingLine::model()->find('billing_ref = :ref AND (org_id = :org_id OR org_id = 949) AND charge_code = :charge_code AND actual_amount = 0 AND type = :type AND dpmt = :dpmt', array(
									':ref' => $consol->no,
									':org_id' => $billing->org_id,
									':charge_code' => array_search($rowData[11], $chargecode),
									':type' => $billing->type,
									':dpmt' => $billing->dpmt,
								));
							} else {
								$billingline = BillingLine::model()->find('billing_ref = :ref AND org_id = :org_id AND charge_code = :charge_code AND actual_amount = 0 AND type = :type AND dpmt = :dpmt', array(
									':ref' => $consol->no,
									':org_id' => $billing->org_id,
									':charge_code' => array_search($rowData[11], $chargecode),
									':type' => $billing->type,
									':dpmt' => $billing->dpmt,
								));
							}
							if (empty($billingline)) {
								$billingline = new BillingLine('create');
								$billingline->org_id = $billing->org_id;
								$billingline->op_id = Yii::app()->user->id;
								$billingline->created = $billing->created;
								$billingline->date = $billing->date;
								$billingline->due = $billing->due;
								$billingline->transaction_date = $billing->transaction_date;
								$billingline->type = $billing->type;
								$billingline->dpmt = $billing->dpmt;
								$billingline->billing_ref = $consol->no;
								$billingline->awb = $consol->awb;
								$billingline->dpt_id = $billing->dpt_id;
								$billingline->currency = $billing->currency;
							}
							$billingline->org_id = $billing->org_id;
							$billingline->billing_id = $billing->id;
							$billingline->billing_cref = $billing->billing_cref;
							$billingline->gst = array_search($rowData[12], Invoice::$InvoiceCostTaxRate);
							$billingline->desc = trim($rowData[7]);

							// JCEX duplicate line
							if (in_array($billingline->org_id, [1212, 1662, 955, 939, 977])) {
								$dupline = BillingLine::model()->find('`desc` = :desc AND org_id = :org_id AND status != 11', [':desc' => $billingline->desc, ':org_id' => $billingline->org_id]);
								if (!empty($dupline)) {
									$transaction->rollback();
									echo json_encode(['msg' => 'Line ' . $row . ' is duplicate']);
									return;
								}
							}

							$billingline->actual_amount = number_format(round($rowData[8] * $rowData[9] * 100) / 100, 2, '.', '');
							// for airport services
							if (in_array($billingline->org_id, Org::$airports)) {
								// $billingline->accrual_amount = $billingline->actual_amount;
								$billingline->accrual_amount = BillingLine::getAirportAccural($billingline->org_id, $consol->mdata['cgb_wt']);
							}
							$billingline->gst_amount = $billingline->getGSTValue();
							$billingline->charge_code = array_search($rowData[11], $chargecode);
							$billingline->status = $billing->status;
							if (preg_match('/GL\d+/', $billingline->charge_code)) {
								$billingline->item_code = $billingline->charge_code;
								$itemtype = ChargeItemType::model()->find('code = :code', array(':code' => $billingline->item_code));
								$billingline->charge_code = $itemtype->cost_code;
							}
							$billingline->save();
						}
					}

					foreach ($billings as $billing) {
						$billing->check();
					}

					$transaction->commit();
					$this->ajaxResult($billing);
				} else if (isset($_POST['import_billing_template'])) {
					echo json_encode(['msg' => 'file is invalid']);
					return;
				} else {
					$this->render('jqm_import_template', ['type' => 'template']);
				}
			}
			break;
			case 'austway': {
				function getConsol($n) {
					$temp_consols = [];
					// search shipment
					$shipment = Shipment::model()->find('hbn = :n OR ref = :n', [':n' => $n]);
					if (!empty($shipment->consol)) {
						$temp_consols[] = [$shipment->consol, $shipment->weight];
					}
					// search shipment
					if (empty($temp_consols) && preg_match('/ECN/', $n)) {
						$shipment = Shipment::model()->find('hbn = :n OR ref = :n', [':n' => explode('-', $n)[0]]);
						if (!empty($shipment->consol)) {
							$temp_consols[] = [$shipment->consol, $shipment->weight];
						}
					}
					// search consol
					if (empty($temp_consols)) {
						$consol = Consol::model()->find('(awb = :n OR no = :n OR JSON_VALUE(meta, "$.container_no") regexp :n OR JSON_VALUE(meta, "$.house_bill") regexp :n) AND status != 100', [':n' => $n]);
						if (!empty($consol)) {
							$temp_consols[] = [$consol, $consol->totWeight()];
						}
					}
					// search consol
					if (empty($temp_consols)) {
						$temp = str_replace('-', '', $n);
						$temp = substr($temp, 0, 3) . '-' . substr($temp, 3);
						$consol = Consol::model()->find('(awb = :n OR no = :n OR JSON_VALUE(meta, "$.container_no") regexp :n OR JSON_VALUE(meta, "$.house_bill") regexp :n) AND status != 100', [':n' => $temp]);
						if (!empty($consol)) {
							$temp_consols[] = [$consol, $consol->totWeight()];
						}
					}
					// search consol
					if (empty($temp_consols) && preg_match('/[\(|（]([\w*\d*]+)[\)|）]/', $n, $matches) && !empty($matches)) {
						$consol = Consol::model()->find('(awb = :n OR no = :n OR JSON_VALUE(meta, "$.container_no") regexp :n OR JSON_VALUE(meta, "$.house_bill") regexp :n) AND status != 100', [':n' => $matches[1]]);
						if (!empty($consol)) {
							$temp_consols[] = [$consol, $consol->totWeight()];
						}
					}
					// search awb job
					if (empty($temp_consols) && preg_match('/ISA/', $n)) {
						$temp = str_replace(' ', '', $n);
						$temp = substr($temp, 0, 3) . ' ' . substr($temp, 3);
						$shipments = Shipment::model()->findAll('JSON_VALUE(meta, "$.booking_ref") = :n', [':n' => $temp]);
						foreach ($shipments as $shipment) {
							$temp_consols[] = [$shipment->consol, $shipment->weight];
						}
					}

					return $temp_consols;
				}

				if (isset($_FILES) && !empty($_FILES)) {
					// file exist
					$file = empty($_FILES['import_billing_template']) ? array() : $_FILES['import_billing_template'];
					if (empty($file['tmp_name']) || !is_uploaded_file($file['tmp_name'])) {
						echo json_encode(['msg' => 'Invalid template file']);
						return;
					}

					// valid extension
					$filename = $file['name'];
					$ext = pathinfo($filename, PATHINFO_EXTENSION);
					if (!in_array(strtolower($ext), ['xls', 'xlsx', 'csv'])) {
						echo json_encode(['msg' => 'Invalid template file']);
						return;
					}

					if (empty($_POST['invoice_no'])) {
						echo json_encode(['msg' => 'Please input invoice no']);
						return;
					} else {
						$invoice_no = $_POST['invoice_no'];
					}
					if (empty($_POST['invoice_date'])) {
						echo json_encode(['msg' => 'Please input invoice date']);
						return;
					} else {
						$invoice_date = $_POST['invoice_date'];
					}

					// process data
					$xls = new oExcel;
					$xls->load($file['tmp_name']);
					$data = $xls->getAll($xls->goSheet(0));
					if (implode(',', $data[1]) != 'No.,Ref #,CBM,Weight,Amount') {
						echo json_encode(['msg' => 'Upload file template is invalid']);
						return;
					}
					unset($data[1]);

					$transaction = Yii::app()->db->beginTransaction();
					foreach ($data as $row => $rowData) {
						if (!empty($rowData[2]) && is_numeric($rowData[5])) {
							$consols = [];
							$ns = preg_split('/[\s,;\/]+/', trim($rowData[2]));
							foreach ($ns as $n) {
								$consols = array_merge($consols, getConsol($n));
							}
							$totWeight = 0;
							foreach ($consols as $item) {
								$totWeight += $item[1];
							}
							if ($totWeight == 0) {
								$errors[] = 'no recorded weight for ' . $rowData[2] . ' in system';
								continue;
							}
							if ($totWeight < $rowData[4]) {
								$errors[] = 'Weight of ' . $rowData[2] . ' is larger than system ' . $totWeight;
								continue;
							}

							if (empty($consols)) {
								$errors[] = $rowData[2] . ' no consol';
								continue;
							}

							foreach ($consols as $item) {
								$consol = $item[0];
								$weight = $item[1];
								$billing = BillingLine::model()->find('t.desc = :desc AND actual_amount = :actual_amount', [':desc' => $rowData[2] . ' CBM:' . $rowData[3] . ' WT:' . $rowData[4], ':actual_amount' => number_format(round($rowData[5] * $weight * 100 / $totWeight) / 100, 2, '.', '')]);
								if (empty($billing)) {
									$billing = new BillingLine;
									$billing->org_id = Org::ORGID_SUPPLIER_AUSTWAY;
									$billing->created = date('Y-m-d');
									$billing->status = 1;
									$billing->link_id = 0;
									$billing->billing_ref = $consol->no;
									$billing->billing_cref = $invoice_no;
									$billing->dpt_id = $consol->dpt_id;
									$billing->date = $invoice_date;
									$billing->due = $invoice_date;
									$billing->type = BillingLine::BILLING_TYPE_IMPORT;
									$billing->dpmt = Invoice::DPMT_IMPORT;
									$billing->actual_amount = number_format(round($rowData[5] * $weight * 100 / $totWeight) / 100, 2, '.', '');
									$billing->gst = 'INPUT';
									$billing->gst_amount = $billing->getGSTValue();
									$billing->desc = $rowData[2] . ' CBM:' . $rowData[3] . ' WT:' . $rowData[4];
									$billing->charge_code = 91031;
									$billing->save();

									Billing::linkLine($billing, false);
								}
								if ($billing->getErrors()) {
									yii::log(json_encode($billing->getErrors()), 'warning');
								}
							}
						}
					}

					$transaction->commit();
					if (empty($errors)) {
						echo json_encode(['done' => true, 'msg' => 'Successfully']);
						Yii::app()->end();
					} else {
						echo json_encode(['done' => false, 'msg' => implode('<br />', $errors)]);
						Yii::app()->end();
					}
				} else if (isset($_POST['import_billing_template'])) {
					echo json_encode(['msg' => 'file is invalid']);
					return;
				} else {
					$this->render('jqm_import_template', ['type' => 'austway']);
				}
			}
			break;
			// case 'globavend':
			// 	if (!isset($_FILES) || empty($_FILES)) {
			// 		$this->render('jqm_import_template', ['type' => 'globavend']);
			// 	} else {
			// 		// file exist
			// 		$file = empty($_FILES['import_billing_template']) ? array() : $_FILES['import_billing_template'];
			// 		if (empty($file['tmp_name']) || !is_uploaded_file($file['tmp_name'])) {
			// 			echo json_encode(['msg' => 'Invalid template file']);
			// 			return;
			// 		}

			// 		// valid extension
			// 		$filename = $file['name'];
			// 		$ext = pathinfo($filename, PATHINFO_EXTENSION);
			// 		if (!in_array(strtolower($ext), ['xls', 'xlsx', 'csv'])) {
			// 			echo json_encode(['msg' => 'Invalid template file']);
			// 			return;
			// 		}

			// 		// process data
			// 		$xls = new oExcel('CSV');
			// 		$xls->load($file['tmp_name']);
			// 		$data = $xls->getAll($xls->goSheet(0));

			// 		if (empty($_POST['invoice_no'])) {
			// 			echo json_encode(['msg' => 'Invoice No. is empty']);
			// 			return;
			// 		}
			// 		$invoice_no = $_POST['invoice_no'];
			// 		if (empty($_POST['invoice_date'])) {
			// 			echo json_encode(['msg' => 'Invoice Date is empty']);
			// 			return;
			// 		}
			// 		$invoice_date = $_POST['invoice_date'];

			// 		$transaction = Yii::app()->db->beginTransaction();
			// 		$errors = [];
			// 		foreach ($data as $row => $line) {
			// 			if ($row == 1) continue;

			// 			$consols = Consol::model()->findAll('awb LIKE :awb', [':awb' => '%PCAE-JEC-' . substr(date('Ymd', strtotime($line[1])), 2) . '%']);
			// 			$totalWeight = 0;
			// 			$totalPcs = 0;
			// 			foreach ($consols as $consol) {
			// 				$totalWeight += max($consol->totWeight(), floatval(@$consol->mdata['awb_wt']), floatval(@$consol->mdata['cgb_wt']));
			// 				$totalPcs += $consol->totPacks();
			// 			}
			// 			if ($totalWeight < $line[3] && $totalWeight < $line[4]) {
			// 				$errors[] = $line[1] . '\' weight ' . $line[3] . '/' . $line[4] . ' is larger than sum of all consols\' weight ' . $totalWeight;
			// 				continue;
			// 			} else if ($totalPcs < $line[2]) {
			// 				$errors[] = $line[1] . '\' pcs ' . $line[2] . ' is larger than sum of all consols\' pcs ' . $totalPcs;
			// 				continue;
			// 			}

			// 			foreach ($consols as $consol) {
			// 				$billing_line = BillingLine::model()->find('billing_ref = :ref AND billing_cref = :cref AND status != 11 AND `desc` = "Linehaul charges"', [':ref' => $consol->no, ':cref' => $invoice_no]);
			// 				if (empty($billing_line)) {
			// 					$billing_line = new BillingLine;
			// 					$billing_line->type = BillingLine::BILLING_TYPE_IMPORT;
			// 					$billing_line->status = 1;
			// 					$billing_line->link_id = 0;
			// 					$billing_line->billing_cref = $invoice_no;
			// 					$billing_line->date = $invoice_date;
			// 					$billing_line->currency = 4;
			// 					$billing_line->billing_ref = $consol->no;
			// 					$billing_line->actual_amount = $line[6] * max($consol->totWeight(), floatval(@$consol->mdata['awb_wt']), floatval(@$consol->mdata['cgb_wt'])) / $totalWeight / 1.1;
			// 					$billing_line->gst = 'INPUT';
			// 					$billing_line->gst_amount = $billing_line->getGSTValue();
			// 					$billing_line->dpt_id = !empty($consol->dpt_id) ? $consol->dpt_id : Org::PCAE_DEPARTMENT_SYDNEY;
			// 					$billing_line->created = date('Y-m-d');
			// 					$billing_line->transaction_date = $invoice_date;
			// 					$billing_line->due = $invoice_date;
			// 					$billing_line->sync_xero = 0;
