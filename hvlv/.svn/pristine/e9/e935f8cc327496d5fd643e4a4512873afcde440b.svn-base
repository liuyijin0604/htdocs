	public function actionTemplate($type)
	{
		switch ($type) {
			case 'd2z_thc':
				$xls = new oExcel;
				$i = 1;
				$xls->setColWidth([15,15,15,15,15,15,15,15,15,15,15]);
				$xls->addRow($i++, ['', 'AWB', 'DEPOT', '', 'WT', 'PKG', '', 'PROCESSING', 'CARTAGE', 'DOCUMENT', 'HANDLING']);
				$xls->output('d2z_thc.csv');
			break;
			case 'austway':
				$xls = new oExcel;
				$i = 1;
				$xls->setColWidth([15,15,15,15,15]);
				$xls->addRow($i++, ['No.', 'Ref #', 'CBM', 'Weight', 'Amount']);
				$xls->output('austway.csv');
			break;
		}
	}

