	/**
	 * save all export billing lines
	 */
	public function actionExportGrid()
	{
		if (isset($_POST['BillingLine'])) {
			if (!empty($_POST['BillingLine']['id'])) {
				$billing = BillingLine::model()->findByPk($_POST['BillingLine']['id']);
				$exConsole = ExcoConsol::model()->find('no = :cno', [':cno' => $billing->billing_ref]);
			} else {
				$exConsole = ExcoConsol::model()->findByPk($_GET['fid']);
				$billing = new BillingLine();
				$billing->created = date('Y-m-d');
				$billing->status = 1; // initial pending status
				$billing->link_id = 0;
				$billing->billing_ref = !empty($exConsole) ? $exConsole->no : '';
				$billing->awb = !empty($exConsole) ? $exConsole->no : '';
				$billing->dpt_id = !empty($exConsole) ? $exConsole->dpt_id : '';
				$billing->date = date('Y-m-d');
				$billing->due = $billing->date;
				$billing->type = BillingLine::BILLING_TYPE_EXPORT; // for export type
				$billing->dpmt = Invoice::DPMT_EXPORT;
				$billing->actual_amount = 0;

			}
			unset($_POST['BillingLine']['id']);
			$billing->attributes = $_POST['BillingLine'];
			$billing->desc = $billing->charge_code;
			$billing->op_id = Yii::app()->user->id;
			$billing->gst_amount = $billing->getGSTValue();
			$billing->save();

			BillingLine::checkMatchedExconsolRealCost($exConsole);

			$this->ajaxResult($billing);
		}
	}

	/**
	 * save all import billing lines
	 */
	public function actionImportGrid()
	{
		if (isset($_POST['BillingLine'])) {
			if (empty($_POST['BillingLine']['org_id'])) {
				$error = 'Supplier is mandatory';
			} else if (empty($_POST['BillingLine']['charge_code'])) {
				$error = 'Charge code is mandatory';
			} else if (empty($_POST['BillingLine']['accrual_amount'])) {
				// $error = 'Accrual amount is mandatory';
			}

			if (empty($error)) {
				$isUpdate = false;
				if (!empty($_POST['BillingLine']['id'])) {
					$billing = BillingLine::model()->findByPk($_POST['BillingLine']['id']);
					$imConsole = Consol::model()->find('no = :no', [':no' => $billing->billing_ref]);
					$isUpdate = true;
				} else {
					$imConsole = Consol::model()->findByPk($_GET['fid']);
					$billing = new BillingLine();
					$billing->type = BillingLine::BILLING_TYPE_IMPORT;
					$billing->status = 2; // initial pending status
					$billing->link_id = 0;
					$billing->billing_cref = !empty($imConsole) ? $imConsole->no : '';
					$billing->currency = 1; // AUD default
					$billing->weight = isset($imConsole->mdata['awb_wt']) ? $imConsole->mdata['awb_wt'] : 0;
					$billing->charge_weight = isset($imConsole->mdata['cgb_wt']) ? $imConsole->mdata['cgb_wt'] : 0;

					// normally billing reference will be console number
					$billing->billing_ref = !empty($imConsole) ? $imConsole->no : '';
					$billing->awb = !empty($imConsole) ? $imConsole->awb : '';
					$billing->dpt_id = !empty($imConsole) ? $imConsole->dpt_id : Org::PCAE_DEPARTMENT_SYDNEY;
					if ($billing->dpt_id == 0) {
						$billing->dpt_id = Org::PCAE_DEPARTMENT_SYDNEY;
					}

					$billing->date = date('Y-m-d');
					$billing->created = date('Y-m-d');
					$billing->transaction_date = $billing->date;
					$billing->due = $billing->date;
					$billing->type = BillingLine::BILLING_TYPE_IMPORT; // for import type
					$billing->dpmt = Invoice::DPMT_IMPORT;
					$billing->actual_amount = 0;
					$billing->gst = 'EXEMPTEXPENSES';
				}

				// check to see if billing has been frozen
				// if closed we can't change them again
				if (!$billing->isBillingClosed()) {
					if (isset($_POST['BillingLine']['id'])) {
						unset($_POST['BillingLine']['id']);
					}

					if (!empty($billing->billing_cref) && $billing->billing_cref != $_POST['BillingLine']['billing_cref']) {
						Log::add($billing, Log::LOG_TYPE_UPDATE, ['note' => Yii::app()->user->name . ' update billing_cref from ' . $billing->billing_cref . ' to ' . $_POST['BillingLine']['billing_cref']]);
					}
					$billing->attributes = $_POST['BillingLine'];
					$billing->actual_amount = $billing->accrual_amount;
					$billing->sync_xero = 0;
					$billing->op_id = isset(Yii::app()->user) ? Yii::app()->user->id : 0;
					$billing->gst_amount = $billing->getGSTValue();
					$billing->save();
					$errors = $billing->getErrors();

					if (empty($errors)) {
						// once import console related billing changed , we should update related pl ledger as well
						// in case we should ignore delivery cost
						if ($billing->accrual_amount > 0) {

							// in case startrack and toll delivery cost
							// we should changed based on parcel not based on console
							if ($billing->org_id == Org::ORGID_COURIER_TOLL ||
								$billing->org_id == Org::ORGID_COURIER_STARTRACK ||
								$billing->org_id == Org::ORGID_COURIER_AUPOST ||
								$billing->org_id == Org::ORGID_COURIER_FASTWAY) {
								// currently do nothing
								// because accrual cost will be input automatically , you should not change them
								// if you still want to change ....???
							} else {
								// for other billing
								$chargeCodeModel = Chargecode::model()->find('status = 1 AND code = :code', [':code' => $billing->charge_code]);
								$chargeCodeId = empty($chargeCodeModel) ? 0 : $chargeCodeModel->id;
								$d = [
									'gl' => $chargeCodeId,
									'fid' => $billing->id,
									'model' => 'BillingLine',
									'dpt_id' => $billing->dpt_id,
									'lid' => 0,
									'org_id' => $billing->org_id,
									'dpmt' => $billing->dpmt,
									'grp1' => $imConsole->id,
									'date' => $imConsole->eta,
									'amt' => $billing->accrual_amount,
									'gst' => 0,
								];

								//PlLedger::add($d, true, ['org_id', 'dpmt', 'date', 'lid', 'grp1', 'grp2']);
							}
						}
					}
				} else {
					// billing has been frozen , you can't change any more
					// ....
				}

				if (!empty($billing->billing)) {
					$billing->billing->check($billing);
				}

				if ($billing->billing_cref != $billing->billing_ref) {
					Billing::linkLine($billing, false);
				}
			} else {
				$billing = new BillingLine();
				$billing->addError('id', $error);
			}
			$this->ajaxResult($billing);
		}
	}

	public function actionImportGridDelete($id)
	{
		$model = BillingLine::model()->findByPk($id);
		if (!empty($model)) {
			if ($model->accrual_amount > 0) {
				$model->actual_amount = 0;
				$model->billing_cref = '';
				$model->billing_id = 0;
				$model->status = 1;
				$model->update('actual_amount', 'billing_cref', 'billing_id', 'status');
			} else {
				$model->status = 11;
				$model->update('status');
			}
		}
		if ($model->billing) {
			$model->billing->custom_log_note = 'Delete one line';
			$model->billing->save();
		}
		$this->ajaxResult($model);
	}

	public function actionLineGrid()
	{
		if (isset($_POST['BillingLine'])) {
			if (!empty($_POST['BillingLine']['id'])) {
				$billing = BillingLine::model()->findByPk($_POST['BillingLine']['id']);
				unset($_POST['BillingLine']['id']);
				$billing->attributes = $_POST['BillingLine'];
				$billing->gst_amount = $billing->getGSTValue();
				$billing->save();
				$this->ajaxResult($billing);
			}
		}
	}

	public function actionBillingGrid()
	{
		if (isset($_POST['Billing'])) {
			if (!empty($_POST['Billing']['id'])) {
				$billing = Billing::model()->findByPk($_POST['Billing']['id']);
				unset($_POST['Billing']['id']);
				$billing->attributes = $_POST['Billing'];
				if (empty($billing->due)) {
					$billing->due = $billing->date;
				}
				foreach ($billing->lines as $line) {
					$line->date = $billing->date;
					$line->due = $billing->due;
					$line->save();
				}
				if (!empty($_POST['Billing']['client'])) {
					$billing->org_id = $billing->client;
				}
				$billing->save();
				$this->ajaxResult($billing);
			}
		}
	}

	public function actionGeneralCost()
	{
		$model = Billing::model();
		$model->unsetAttributes();
		$model->type = BillingLine::BILLING_TYPE_OTHERS; // only show general cost list
		if (isset($_GET['Billing'])) {
			$model->attributes = $_GET['Billing'];
		}

		$this->render('general_list', ['model' => $model]);
	}

	public function actionGeneralCostlinesGrid($id)
	{

		if (isset($_POST['BillingLine'])) {
			if (empty($_POST['BillingLine']['id'])) {
				// create
				$model = new BillingLine();
				$model->billing_id = $id;
			} else {
				// update
				$model = BillingLine::model()->findByPk($_POST['BillingLine']['id']);
			}
			$model->mdata['gdepartment'] = $_POST['BillingLine']['dept'];
			unset($_POST['BillingLine']['id']);
			unset($_POST['BillingLine']['dept']);
			$model->attributes = $_POST['BillingLine'];
			$model->actual_amount = $model->price * $model->qty;
			$model->gst_amount = $model->getGSTValue();
			// fix general cost that actual_amount includes gst_amount
			// $model->actual_amount = $model->price * $model->qty + $model->gst_amount;
			$model->save();

			// update billing -> pl ledger table as well
			$billing = Billing::model()->findByPk($id);
			if (!empty($billing)) {
				$this->postGeneralCost2PLledger($billing, $billing->dpmt);
			}
			$this->ajaxResult($model);
		}

	}

	public function actionSyncGeneralXero()
	{
		$id = $_GET['fid'];
		$model = $this->loadModel($id);
		if (!empty($model)) {
			$error = $this->postGeneralCost2Xero($model);
			if (!empty($error)) {
				$model->addError('id', $error);
			}
		}
		$this->ajaxResult($model);
	}

	public function actionBillingDetails()
	{
		if (!empty($_GET['fid'])) 
		{
			$id = $_GET['fid'];
			$model = $this->loadModel($id);
			if (!empty($model)) {
				if ($model->type == 5) {
					$this->render('create_general', array('model' => $model));
				} else {
					$this->render('detail', array('id' => $id));
				}
			}
		} else if (!empty($_GET['cref'])) {
			$this->render('detail', array('cref' => $_GET['cref'], 'org_id' => @$_GET['org_id']));
		}
	}

	public function actionGeneralDetails()
	{
		$id = $_GET['fid'];
		$model = $this->loadModel($id);

		// update general cost
		if (isset($_POST['Billing'])) {

			$dpmt = isset($_POST['Billing']['dpmt']) ? $_POST['Billing']['dpmt'] : 0;
			if ($dpmt <= 0) {
				$model->addError('type', 'Billing Department is mandatory!');
				$this->ajaxResult($model, array('id'));
			}
			$billingNo = '';
			if (isset($_POST['Billing']['billing_cref'])) {
				$billingNo = trim($_POST['Billing']['billing_cref']);
				$b = Billing::model()->find('billing_cref = :billing_cref AND id != :id', array(':billing_cref' => $billingNo, ':id' => $id));
				if (!empty($b)) {
					$model->addError('id', 'Invoice No. already exists');
					$this->ajaxResult($model);
				}
			}
			$model->billing_cref = $billingNo;
			$model->attributes = $_POST['Billing'];
			$model->dpmt = $dpmt;
			$model->date = $_POST['Billing']['date'];
			$model->due = $_POST['Billing']['due'];
			$model->save();

			if (isset($_POST['BillingLine'])) {
				if (is_array($_POST['BillingLine']['charge_code'])) {

					foreach ($_POST['BillingLine']['charge_code'] as $i => $a) {
						$il = new BillingLine();
						$il->billing_id = $model->id;
						$il->link_id = $model->id;
						$il->created = date('Y-m-d');
						$il->org_id = $_POST['Billing']['org_id'];
						$il->op_id = Yii::app()->user->id;
						$il->dpt_id = $_POST['Billing']['dpt_id'];
						$il->type = BillingLine::BILLING_TYPE_OTHERS;
						$il->status = 2; // set as confirmed
						$il->charge_code = $a;
						$il->qty = $_POST['BillingLine']['qty'][$i];
						$il->price = $_POST['BillingLine']['price'][$i];
						$il->item_code = $_POST['BillingLine']['item_code'][$i];
						$il->gst = $_POST['BillingLine']['gst'][$i];
						$il->desc = $_POST['BillingLine']['desc'][$i];
						$il->mdata['gdepartment'] = $_POST['BillingLine']['dept'][$i];
						$amount = $il->qty * $il->price;
						if ($amount == 0.0) {
							continue;
						}
						// ignore zero amount

						if ($il->gst == 'INPUT') {
							$il->gst_amount = $amount * 10 / 100;
							// fix general cost that actual_amount includes gst_amount
							// $amount += $il->gst_amount;
						}
						$il->actual_amount = number_format($amount, 2, '.', '');
						$il->accrual_amount = $il->actual_amount;
						$il->save();
						$errors = $il->getErrors();
						if (!empty($errors)) {
							$model->addError('id', 'Failed to save billing : ' . implode(',', $errors));
							$this->ajaxResult($model, array('id'));
						}
					}
				}
			}

			$syncXero = false;
			if (isset($_POST['syncxero'])) {
				$syncXero = true;
			}

			if ($syncXero) {
				$this->postGeneralCost2Xero($model);
			}

			// post the cost to all basic statistic table
			$this->postGeneralCost2PLledger($model, $dpmt);

			$this->ajaxResult($model);

		}
		$this->render('create_general', array('model' => $model));
	}

	public function actionCreate()
	{
		$transaction = Yii::app()->db->beginTransaction();

		$model = Billing::model()->find('org_id = :oid AND billing_cref = :cref', array(':oid' => $_POST['Billing']['org_id'], ':cref' => $_POST['Billing']['billing_cref']));
		if (!empty($model) && $model->status >= 3) {
			$model->addError('id', 'The status of this invoice is posted');
			$this->ajaxResult($model);
		}

		if (!empty($model)) {
			// $model->addError('id', 'This invoice exists in system');
			// $this->ajaxResult($model);
		} else {
			$model = new Billing('create');
			$model->attributes = $_POST['Billing'];
			$model->status = 2;
			$model->created = date('Y-m-d');
			if ($model->dpmt == 10) {
				$model->type = 1;
			} else if ($model->dpmt == 20) {
				$model->type = 2;
			} else if ($model->dpmt == 30) {
				$model->type = 3;
			} else if ($model->dpmt == 40) {
				$model->type = 4;
			} else if ($model->dpmt == 1) {
				$model->type = 6;
			}
		}

		if (isset($_POST['Billing'])) {
			if (empty($_POST['BillingLine']['charge_code'][0]) || !is_array($_POST['BillingLine']['charge_code'])) {
				$model->addError('id', 'Please input at least one billing line');
				$this->ajaxResult($model);
			} else {
				$model->save();
				foreach ($_POST['BillingLine']['charge_code'] as $k => $v) {
					if (empty($v)) {
						continue;
					}

					$line = BillingLine::model()->find('billing_ref = :ref AND org_id = :org_id AND charge_code = :charge_code AND actual_amount = 0 AND type = :type AND dpmt = :dpmt', array(
						':ref' => $model->billing_ref,
						':org_id' => $model->org_id,
						':charge_code' => $_POST['BillingLine']['charge_code'][$k],
						':type' => $model->type,
						':dpmt' => $model->dpmt,
					));
					if (empty($line)) {
						$line = new BillingLine('create');
						$line->org_id = $model->org_id;
						$line->op_id = Yii::app()->user->id;
						$line->dpmt = $_POST['Billing']['dpmt'];
						if ($line->dpmt == 10) {
							$line->type = 1;
						} else if ($line->dpmt == 20) {
							$line->type = 2;
						} else if ($line->dpmt == 30) {
							$line->type = 3;
						} else if ($line->dpmt == 40) {
							$line->type = 4;
						} else if ($line->dpmt == 1) {
							$line->type = 6;
						}
						$line->status = $model->status;
						$line->dpt_id = $model->dpt_id;
						$line->currency = $model->currency;

						$line->billing_ref = trim($_POST['BillingLine']['billing_ref'][$k]);
						$ret = BillingLine::getModel($line->billing_ref);
						$consol = $ret['consol'];
						$nonexist = $ret['nonexist'];
						if ($nonexist) {
							$transaction->rollback();
							$line->addError('id', 'Billing Reference does not exist in system');
							$this->ajaxResult($line);
						}
						$line->billing_ref = $consol->no;
						$line->awb = $consol->awb;
					}
					$line->created = $model->created;
					$line->date = $model->date;
					$line->due = $model->due;
					$line->transaction_date = $model->transaction_date;
					$line->billing_id = $model->id;
					$line->billing_cref = $model->billing_cref;
					$line->gst = $_POST['BillingLine']['gst'][$k];
					$line->desc = $_POST['BillingLine']['desc'][$k] . ((!empty($_POST['BillingLine']['desc'][$k]) && !empty($_POST['BillingLine']['note'][$k])) ? ' - ' : '') . $_POST['BillingLine']['note'][$k];
					$line->qty = $_POST['BillingLine']['qty'][$k];
					$line->price = $_POST['BillingLine']['price'][$k];
					$line->actual_amount = $line->qty * $line->price;
					$line->gst_amount = $line->getGSTValue();
					$line->charge_code = $_POST['BillingLine']['charge_code'][$k];
					if (preg_match('/GL\d+/', $line->charge_code)) {
						$line->item_code = $line->charge_code;
						$itemtype = ChargeItemType::model()->find('code = :code', array(':code' => $line->item_code));
						$line->charge_code = $itemtype->cost_code;
					}
					$line->save();
				}
			}

			$model->check();
		}

		if ($model->getErrors()) {
			$transaction->rollback();
			$this->ajaxResult($model);
		} else {
			$transaction->commit();
			echo json_encode(array('done' => true, 'msg' => 'Successfully', 'data' => $this->render('file', array('model' => $model), true)));
			Yii::app()->end();
		}
	}

	public function actionCreateGeneral()
	{
		$model = new Billing('create');
		if (isset($_POST['Billing'])) {
			$dpmt = isset($_POST['Billing']['dpmt']) ? $_POST['Billing']['dpmt'] : 0;
			if ($dpmt <= 0) {
				$model->addError('type', 'Billing Department is mandatory!');
				$this->ajaxResult($model, array('id'));
			}
			$billingNo = '';
			if (isset($_POST['Billing']['billing_cref'])) {
				$billingNo = trim($_POST['Billing']['billing_cref']);
				$b = Billing::model()->find('billing_cref = :billing_cref', array(':billing_cref' => $billingNo));
				if (!empty($b)) {
					$model->addError('id', 'Invoice No. already exists');
					$this->ajaxResult($model);
				}
			}
			$model->billing_cref = $billingNo;
			$model->attributes = $_POST['Billing'];
			$model->dpmt = $dpmt;
			$model->type = BillingLine::BILLING_TYPE_OTHERS; // for others
			$model->date = $_POST['Billing']['date'];
			$model->due = $_POST['Billing']['due'];
			$model->status = 2; // set as confirmed status
			$model->created = date('Y-m-d');

			$model->save();

			$errors = $model->getErrors();
			if (!empty($errors)) {
				$errMsg = '';
				foreach ($errors as $error) {
					$errMsg .= ' ' . implode(',', $error);
				}
				$model->addError('id', 'Failed to save billing : ' . $errMsg);
				$this->ajaxResult($model, array('id'));
			}

			$syncXero = false;
			if (isset($_POST['syncxero'])) {
				$syncXero = true;
			}

			if (is_array($_POST['BillingLine']['charge_code'])) {
				// check all charge code , must not be empty
				$validChargeCode = true;
				foreach ($_POST['BillingLine']['charge_code'] as $i => $a) {
					if (empty($a)) {
						$validChargeCode = false;
						break;
					}
				}
				if ($validChargeCode) {
					foreach ($_POST['BillingLine']['charge_code'] as $i => $a) {
						$il = new BillingLine();
						$il->billing_id = $model->id;
						$il->link_id = $model->id;
						$il->created = date('Y-m-d');
						$il->org_id = $_POST['Billing']['org_id'];
						$il->op_id = Yii::app()->user->id;
						$il->dpt_id = $_POST['Billing']['dpt_id'];
						$il->dpmt = $dpmt;
						$il->type = BillingLine::BILLING_TYPE_OTHERS;
						$il->status = 2; // set as confirmed
						$il->charge_code = $a;
						$il->qty = $_POST['BillingLine']['qty'][$i];
						$il->price = $_POST['BillingLine']['price'][$i];
						$il->item_code = $_POST['BillingLine']['item_code'][$i];
						$il->gst = $_POST['BillingLine']['gst'][$i];
						$il->desc = $_POST['BillingLine']['desc'][$i];
						$il->dept = $_POST['BillingLine']['dept'][$i];
						$il->mdata['gdepartment'] = $_POST['BillingLine']['dept'][$i];
						$il->date = $_POST['Billing']['date'];
						$il->due = $_POST['Billing']['due'];
						$amount = $il->qty * $il->price;
						if ($amount <= 0.0) {
							continue;
						}
						// ignore zero amount

						if ($il->gst == 'INPUT') {
							$il->gst_amount = $amount * 10 / 100;
							// fix general cost that actual_amount includes gst_amount
							// $amount += $il->gst_amount;
						}
						$il->actual_amount = number_format($amount, 2, '.', '');
						$il->accrual_amount = $il->actual_amount;
						$il->save();
						$errors = $il->getErrors();
						if (!empty($errors)) {
							$model->addError('id', 'Failed to save billing : ' . implode(',', $errors));
							Billing::model()->deleteByPk($model->id);
							$this->ajaxResult($model, array('id'));
						}
					}
				} else {
					$model->addError('id', 'Billing line charge code can not be empty!');
					Billing::model()->deleteByPk($model->id);
					$this->ajaxResult($model, array('id'));
				}
			} else {
				$model->addError('id', 'Billing lines are empty!');
				Billing::model()->deleteByPk($model->id);
				$this->ajaxResult($model, array('id'));
			}

			if ($syncXero) {
				$this->postGeneralCost2Xero($model);
			}

			// post the cost to all basic statistic table
			$this->postGeneralCost2PLledger($model, $dpmt);

			$this->ajaxResult($model, array('id'));
		}
		$model->date = date('Y-m-d');
		$model->due = date('Y-m-d');

		if ($model->dpt_id == 0) {
			$model->dpt_id = Org::PCAE_DEPARTMENT_SYDNEY;
		}
		// set default branch;

		$this->render('create_general', array('model' => $model));
	}

	private function postGeneralCost2PLledger($data, $dpmt = 0)
	{
		// in case dpmt == 1 , we need split the cost to four parts based on General Cost Split percent setting
		if ($dpmt == 1) {
			foreach ($data->lines as $line) {
				// based on charge code get split percent setting
				$chargeCode = $line->charge_code;
				$chargeCodeObj = Chargecode::model()->find('status = 1 AND code = :code', [':code' => $chargeCode]);

				// ERROR , related charge code not found
				if (empty($chargeCodeObj)) {
					continue;
				}

				$splits = GeneralCostSplit::model()->with('chargecode')->find('chargecode.code = :code', [':code' => $chargeCode]);
				if (!empty($splits)) {
					$pps = ['pim' => '10', 'pex' => '20', 'p3pl' => '40', 'paf' => '30'];
					foreach ($pps as $k => $dpmtId) {
						if (!isset($splits->mdata[$k])) {
							continue;
						}

						$d = [
							'gl' => $splits->chargecode_id,
							'fid' => $line->id,
							'model' => 'BillingLine',
							'dpt_id' => $line->dpt_id,
							'lid' => $line->id,
							'org_id' => $line->org_id,
							'dpmt' => $line->dpmt,
							'grp1' => '',
							'date' => $data->date,
							'amt' => $line->actual_amount * $splits->mdata[$k] / 100,
							'actual_amt' => $line->actual_amount * $splits->mdata[$k] / 100,
							'gst' => $line->gst_amount * $splits->mdata[$k] / 100,
						];

						/*$pl = PlLedger::add($d, true, ['org_id', 'gl', 'date', 'lid', 'grp1', 'grp2']);

					$errors = $pl->getErrors();
					if (!empty($errors)) {
					// $msg = implode(',', $errors);
					echo 'Invoice : ' . $line->id . ' failed : ' . PHP_EOL;
					}*/
					}
				} else {
					$d = [
						'gl' => $chargeCodeObj->id,
						'fid' => $line->id,
						'model' => 'BillingLine',
						'dpt_id' => $line->dpt_id,
						'lid' => $line->id,
						'org_id' => $line->org_id,
						'dpmt' => $line->dpmt,
						'grp1' => '',
						'date' => $data->date,
						'amt' => $line->actual_amount,
						'actual_amt' => $line->actual_amount,
						'gst' => $line->gst_amount,
					];

					/*$pl = PlLedger::add($d, true, ['org_id', 'gl', 'date', 'lid', 'grp1', 'grp2']);

				$errors = $pl->getErrors();
				if (!empty($errors)) {
				// $msg = implode(',', $errors);
				echo 'Invoice : ' . $line->id . ' failed : ' . PHP_EOL;
				}*/
				}
			}
		} else {
			foreach ($data->lines as $line) {
				$chargeCode = Chargecode::model()->find('status = 1 AND code = :code', [':code' => $line->charge_code]);

				$d = [
					'gl' => $chargeCode->id,
					'fid' => $line->id,
					'model' => 'BillingLine',
					'dpt_id' => $line->dpt_id,
					'lid' => $line->id,
					'org_id' => $line->org_id,
					'dpmt' => $line->dpmt,
					'grp1' => '',
					'date' => $data->date,
					'amt' => $line->actual_amount,
					'actual_amt' => $line->actual_amount,
					'gst' => $line->gst_amount,
				];

				/*$pl = PlLedger::add($d, true, ['org_id', 'gl', 'date', 'lid', 'grp1', 'grp2']);
			$errors = $pl->getErrors();
			if (!empty($errors)) {
			//$msg = implode(',', $errors);
			echo 'Invoice : ' . $line->id . ' failed : ' . PHP_EOL;
			}*/
			}
		}
	}

	public function actionUpdate()
	{

		if (isset($_POST) && isset($_POST['yt0'])) {
			$op = $_POST['yt0'];
			if ($op == 'Confirm') {
				// do op confirm action
				$this->doOpConfirm();
			} else if ($op == 'Post') {
				$this->doAccountingPost();
			}
		}

		if (isset($_POST) && isset($_POST['yt1'])) {
			$op = $_POST['yt1'];
			if ($op == 'Switch to GST on Expense') {
				$this->doAccountingSwitchGST();
			}
		}

		if (isset($_GET['tab'])) {
			$tab = $_GET['tab'];
			Acl::hasAccess($this->CaName . '/' . $tab, true);
			$model = new BillingLine('search');
			$model->unsetAttributes(); // clear any default values
			$model->setAttribute('type', 3); // for air freight and 3PL only
			if (isset($_GET['BillingLine'])) {
				$model->attributes = $_GET['BillingLine'];
				$model->client = $_GET['BillingLine']['client'];
			}
			if ($tab == 'op') {
				$model->setAttribute('status', 1); // only show confirmed status billing
			} else if ($tab == 'accounting') {
				$model->setAttribute('status', 2); // only show confirmed status billing
			}
			$this->render('tab_' . $tab, array('model' => $model));
		} else {
			$model = new BillingLine('search');
			$model->unsetAttributes(); // clear any default values
			if (isset($_GET['BillingLine'])) {
				$model->attributes = $_GET['BillingLine'];
			}

			$model->setAttribute('status', 1); // only show pending billing
			$model->setAttribute('type', 3); // for air freight and 3PL only
			if (isset($_GET['BillingLine'])) {
				$model->attributes = $_GET['BillingLine'];
			}

			$this->render('list_pro', array('model' => $model));
		}
	}

	public function actionImportUpdate()
	{

		if (isset($_POST) && (isset($_POST['yt1']) || isset($_POST['yt0']))) {
			$op = isset($_POST['yt1']) ? $_POST['yt1'] : '';
			if (empty($op)) {
				$op = isset($_POST['yt0']) ? $_POST['yt0'] : '';
			}

			if ($op == 'Confirm') {
				// do op confirm action
				$this->doOpConfirm();
			} else if ($op == 'Post') {
				$this->doAccountingPost();
			}
		}

		if (isset($_POST) && isset($_POST['yt1'])) {
			$op = $_POST['yt1'];
			if ($op == 'Switch to GST on Expense') {
				$this->doAccountingSwitchGST();
			}
		}

		if (isset($_GET['tab'])) {
			$tab = $_GET['tab'];
