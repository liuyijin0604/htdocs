	/**
	 * view all not matched air freight billing
	 * @param $id
	 */
	public function actionAfInvoiceImportFailedView($id)
	{
		$model = new AFInvoiceReconciliation();
		$model->unsetAttributes();
		$model->history_id = $id;
		if (isset($_GET['AFInvoiceReconciliation'])) {
			unset($_GET['AFInvoiceReconciliation']['inv']);
			unset($_GET['AFInvoiceReconciliation']['note']);
			$model->attributes = $_GET['AFInvoiceReconciliation'];
		}
		$model->checkMatchedResult = 1;

		$invoices = $model->search(false)->data;
		foreach ($invoices as $invoice) {
			if ($invoice->supplier_id == 1133) {
				$this->matchTneInvoiceWithHvlv($invoice);
			} else if ($invoice->supplier_id == 954) {
				$this->matchAFInvoiceWithHvlv($invoice);
			} else if ($invoice->supplier_id == 964 && !preg_match('/insurance/i', $invoice->history->meta)) {
				$this->matchYYInvoiceWithHvlv($invoice);
			} else if (in_array($invoice->supplier_id, Org::$brokers)) {
				$this->matchBrokerInvoiceWithHvlv($invoice);
			} else if ($invoice->supplier_id == 1008) {
				$this->checkSJInvoiceWithHvlv($invoice);
			} else if (in_array($invoice->supplier_id, Org::$airports)) {
				$this->matchAirportsInvoiceWithHvlv($invoice);
			} else if ($invoice->supplier_id == 964 && preg_match('/insurance/i', $invoice->history->meta)) {
				$this->matchIFInvoiceWithHvlv($invoice);
			}
		}

		$this->render('air_freight_billing_failed_view', ['model' => $model, 'id' => $id]);
	}

