			// 					$billing_line->save();

			// 					Billing::linkLine($billing_line, false);
			// 				}

			// 				$billing_line = BillingLine::model()->find('billing_ref = :ref AND billing_cref = :cref AND status != 11 AND `desc` = "Custom clearance charges"', [':ref' => $consol->no, ':cref' => $invoice_no]);
			// 				if (empty($billing_line)) {
			// 					$billing_line = new BillingLine;
			// 					$billing_line->type = BillingLine::BILLING_TYPE_IMPORT;
			// 					$billing_line->status = 1;
			// 					$billing_line->link_id = 0;
			// 					$billing_line->billing_cref = $invoice_no;
			// 					$billing_line->date = $invoice_date;
			// 					$billing_line->currency = 4;
			// 					$billing_line->billing_ref = $consol->no;
			// 					$billing_line->actual_amount = $line[7] * max($consol->totWeight(), floatval(@$consol->mdata['awb_wt']), floatval(@$consol->mdata['cgb_wt'])) / $totalWeight / 1.1;
			// 					$billing_line->gst = 'INPUT';
			// 					$billing_line->gst_amount = $billing_line->getGSTValue();
			// 					$billing_line->dpt_id = !empty($consol->dpt_id) ? $consol->dpt_id : Org::PCAE_DEPARTMENT_SYDNEY;
			// 					$billing_line->created = date('Y-m-d');
			// 					$billing_line->transaction_date = $invoice_date;
			// 					$billing_line->due = $invoice_date;
			// 					$billing_line->sync_xero = 0;
			// 					$billing_line->dpmt = Invoice::DPMT_IMPORT;
			// 					$billing_line->desc = 'Custom clearance charges';
			// 					$billing_line->save();

			// 					Billing::linkLine($billing_line, false);
			// 				}
			// 			}
			// 		}

			// 		if (empty($errors)) {
			// 			$transaction->commit();
			// 			echo json_encode(['done' => true, 'msg' => 'Successfully']);
			// 			Yii::app()->end();
			// 		} else {
			// 			$transaction->rollback();
			// 			echo json_encode(['done' => false, 'msg' => implode('<br />', $errors)]);
			// 			Yii::app()->end();
			// 		}
			// 	}
			// break;
			case 'd2z_thc': {
				if (!isset($_FILES) || empty($_FILES)) {
					$this->render('jqm_import_template', ['type' => 'd2z_thc']);
				} else {
					// file exist
					$file = empty($_FILES['import_billing_template']) ? array() : $_FILES['import_billing_template'];
					if (empty($file['tmp_name']) || !is_uploaded_file($file['tmp_name'])) {
						echo json_encode(['msg' => 'Invalid template file']);
						return;
					}

					// valid extension
					$filename = $file['name'];
					$ext = pathinfo($filename, PATHINFO_EXTENSION);
					if (!in_array(strtolower($ext), ['csv'])) {
						echo json_encode(['msg' => 'Invalid template file, only accept csv']);
						return;
					}

					// process data
					$xls = new oExcel('CSV');
					$xls->load($file['tmp_name']);
					$data = $xls->getAll($xls->goSheet(0));

					if (empty($_POST['invoice_no'])) {
						echo json_encode(['msg' => 'Invoice No. is empty']);
						return;
					}
					$invoice_no = $_POST['invoice_no'];
					if (empty($_POST['invoice_date'])) {
						echo json_encode(['msg' => 'Invoice Date is empty']);
						return;
					}
					$invoice_date = $_POST['invoice_date'];

					$transaction = Yii::app()->db->beginTransaction();
					$errors = [];
					foreach ($data as $row => $line) {
						if ($row == 1) continue;
						if (empty($line[2])) continue;

						$line[8] = str_replace('$', '', $line[8]);
						$line[9] = str_replace('$', '', $line[9]);
						$line[10] = str_replace('$', '', $line[10]);
						$line[11] = str_replace('$', '', $line[11]);

						if (!empty($_POST['amt_type']) && $_POST['amt_type'] == 'gstincl') {
							$line[8] = number_format(round($line[8] * 100 / 1.1, 2) / 100, 2, '.', '');
							$line[9] = number_format(round($line[9] * 100 / 1.1, 2) / 100, 2, '.', '');
							$line[10] = number_format(round($line[10] * 100 / 1.1, 2) / 100, 2, '.', '');
							$line[11] = number_format(round($line[11] * 100 / 1.1, 2) / 100, 2, '.', '');
						}

						if (!empty($_POST['amt_type']) && in_array($_POST['amt_type'], ['gstincl', 'gstexcl'])) {
							$gst_type = 'INPUT';
						} else {
							$gst_type = 'EXEMPTEXPENSES';
						}

						$line[2] = str_replace('-', '', $line[2]);
						$line[2] = substr($line[2], 0, 3) . '-' . substr($line[2], 3);
						$consol = Consol::model()->find('awb = :awb', [':awb' => $line[2]]);
						if (empty($consol)) {
							$errors[] = 'line ' . $row . ' consol does not exist';
							continue;
						}

						$temp_errs = [];

						$wt = floatval(str_replace(',', '', $line[5]));
						$pkg = floatval(str_replace(',', '', $line[6]));

						// check wt and pkg
						$our_wt = !empty($consol->mdata['cgb_wt']) ? $consol->mdata['cgb_wt'] : $consol->totWeight();
						if ($wt > $our_wt) {
							$temp_errs[] = 'line ' . $row . ' wt ' . $wt . 'kg is greater than ours ' . $our_wt . 'kg';
						}
						$our_pkg = $consol->totShipments();
						if ($pkg > $our_pkg + 1) {
							$temp_errs[] = 'line ' . $row . ' pkg ' . $pkg . ' is greater than ours ' . $our_pkg;
						}

						// check processing fee
						if (in_array($consol->dpt_id, [Org::PCAE_DEPARTMENT_SYDNEY, Org::PCAE_DEPARTMENT_MELBOURNE])) {
							$processing_fee = number_format(round($wt * 0.2 * 100, 2) / 100, 2, '.', '');
							if ($line[8] > $processing_fee) {
								$temp_errs[] = 'line ' . $row . ' processing fee ' . $line[8] . ' is greater than expected ' . $processing_fee;
							}
						} else if (in_array($consol->dpt_id, [Org::PCAE_DEPARTMENT_BRISBANE, Org::PCAE_DEPARTMENT_PERTH])) {
							$processing_fee = number_format(round($pkg * 0.46 * 100, 2) / 100, 2, '.', '');
							if ($line[8] > $processing_fee) {
								$temp_errs[] = 'line ' . $row . ' processing fee ' . $line[8] . ' is greater than expected ' . $processing_fee;
							}
						}

						// check cartage fee
						$cartage_fee = number_format(round(max(82.5, $wt * 0.16) * 100, 2) / 100, 2, '.', '');
						if ($line[9] > $cartage_fee) {
							$temp_errs[] = 'line ' . $row . ' cartage fee ' . $line[9] . ' is greater than expected ' . $cartage_fee;
						}

						// check document fee
						if ($line[10] > 52.5) {
							$temp_errs[] = 'line ' . $row . ' document fee ' . $line[10] . ' is greater than expected ' . 52.5;
						}

						// check handling fee
						$handling_fee = number_format(round($wt * 0.525 * 100, 2) / 100, 2, '.', '');
						if ($line[11] > $handling_fee) {
							$temp_errs[] = 'line ' . $row . ' handling fee ' . $line[11] . ' is greater than expected ' . $handling_fee;
						}

						if ($temp_errs) {
							$errors = array_merge($errors, $temp_errs);
							continue;
						}

						$billing_line = BillingLine::model()->find('org_id = :org_id AND billing_ref = :ref AND billing_cref = :cref AND status != 11 AND `desc` = "Processing"', [':org_id' => Org::ORGID_COURIER_D2Z, ':ref' => $consol->no, ':cref' => $invoice_no]);
						if (empty($billing_line)) {
							$billing_line = new BillingLine;
							$billing_line->org_id = Org::ORGID_COURIER_D2Z;
							$billing_line->type = BillingLine::BILLING_TYPE_IMPORT;
							$billing_line->status = 1;
							$billing_line->link_id = 0;
							$billing_line->billing_cref = $invoice_no;
							$billing_line->date = $invoice_date;
							$billing_line->currency = 1;
							$billing_line->billing_ref = $consol->no;
							$billing_line->actual_amount = number_format(floatval($line[8]), 2, '.', '');
							$billing_line->gst = $gst_type;
							$billing_line->gst_amount = $billing_line->getGSTValue();
							$billing_line->dpt_id = !empty($consol->dpt_id) ? $consol->dpt_id : Org::PCAE_DEPARTMENT_SYDNEY;
							$billing_line->created = date('Y-m-d');
							$billing_line->transaction_date = $invoice_date;
							$billing_line->due = $invoice_date;
							$billing_line->sync_xero = 0;
							$billing_line->dpmt = Invoice::DPMT_IMPORT;
							$billing_line->desc = 'Processing';
							$billing_line->charge_code = 91030;
							$billing_line->save();

							Billing::linkLine($billing_line, false);
						}

						$billing_line = BillingLine::model()->find('org_id = :org_id AND billing_ref = :ref AND billing_cref = :cref AND status != 11 AND `desc` = "Cartage"', [':org_id' => Org::ORGID_COURIER_D2Z, ':ref' => $consol->no, ':cref' => $invoice_no]);
						if (empty($billing_line)) {
							$billing_line = new BillingLine;
							$billing_line->org_id = Org::ORGID_COURIER_D2Z;
							$billing_line->type = BillingLine::BILLING_TYPE_IMPORT;
							$billing_line->status = 1;
							$billing_line->link_id = 0;
							$billing_line->billing_cref = $invoice_no;
							$billing_line->date = $invoice_date;
							$billing_line->currency = 1;
							$billing_line->billing_ref = $consol->no;
							$billing_line->actual_amount = number_format(floatval($line[9]), 2, '.', '');
							$billing_line->gst = $gst_type;
							$billing_line->gst_amount = $billing_line->getGSTValue();
							$billing_line->dpt_id = !empty($consol->dpt_id) ? $consol->dpt_id : Org::PCAE_DEPARTMENT_SYDNEY;
							$billing_line->created = date('Y-m-d');
							$billing_line->transaction_date = $invoice_date;
							$billing_line->due = $invoice_date;
							$billing_line->sync_xero = 0;
							$billing_line->dpmt = Invoice::DPMT_IMPORT;
							$billing_line->desc = 'Cartage';
							$billing_line->charge_code = 91031;
							$billing_line->save();

							Billing::linkLine($billing_line, false);
						}

						$billing_line = BillingLine::model()->find('org_id = :org_id AND billing_ref = :ref AND billing_cref = :cref AND status != 11 AND `desc` = "Document"', [':org_id' => Org::ORGID_COURIER_D2Z, ':ref' => $consol->no, ':cref' => $invoice_no]);
						if (empty($billing_line)) {
							$billing_line = new BillingLine;
							$billing_line->org_id = Org::ORGID_COURIER_D2Z;
							$billing_line->type = BillingLine::BILLING_TYPE_IMPORT;
							$billing_line->status = 1;
							$billing_line->link_id = 0;
							$billing_line->billing_cref = $invoice_no;
							$billing_line->date = $invoice_date;
							$billing_line->currency = 1;
							$billing_line->billing_ref = $consol->no;
							$billing_line->actual_amount = number_format(floatval($line[10]), 2, '.', '');
							$billing_line->gst = $gst_type;
							$billing_line->gst_amount = $billing_line->getGSTValue();
							$billing_line->dpt_id = !empty($consol->dpt_id) ? $consol->dpt_id : Org::PCAE_DEPARTMENT_SYDNEY;
							$billing_line->created = date('Y-m-d');
							$billing_line->transaction_date = $invoice_date;
							$billing_line->due = $invoice_date;
							$billing_line->sync_xero = 0;
							$billing_line->dpmt = Invoice::DPMT_IMPORT;
							$billing_line->desc = 'Document';
							$billing_line->charge_code = 91030;
							$billing_line->save();

							Billing::linkLine($billing_line, false);
						}

						$billing_line = BillingLine::model()->find('org_id = :org_id AND billing_ref = :ref AND billing_cref = :cref AND status != 11 AND `desc` = "Handling"', [':org_id' => Org::ORGID_COURIER_D2Z, ':ref' => $consol->no, ':cref' => $invoice_no]);
						if (empty($billing_line)) {
							$billing_line = new BillingLine;
							$billing_line->org_id = Org::ORGID_COURIER_D2Z;
							$billing_line->type = BillingLine::BILLING_TYPE_IMPORT;
							$billing_line->status = 1;
							$billing_line->link_id = 0;
							$billing_line->billing_cref = $invoice_no;
							$billing_line->date = $invoice_date;
							$billing_line->currency = 1;
							$billing_line->billing_ref = $consol->no;
							$billing_line->actual_amount = number_format(floatval($line[11]), 2, '.', '');
							$billing_line->gst = $gst_type;
							$billing_line->gst_amount = $billing_line->getGSTValue();
							$billing_line->dpt_id = !empty($consol->dpt_id) ? $consol->dpt_id : Org::PCAE_DEPARTMENT_SYDNEY;
							$billing_line->created = date('Y-m-d');
							$billing_line->transaction_date = $invoice_date;
							$billing_line->due = $invoice_date;
							$billing_line->sync_xero = 0;
							$billing_line->dpmt = Invoice::DPMT_IMPORT;
							$billing_line->desc = 'Handling';
							$billing_line->charge_code = 91030;
							$billing_line->save();

							Billing::linkLine($billing_line, false);
						}

						// delete useless accrual
						$billing_line = BillingLine::model()->find('org_id = 949 AND charge_code = 91030 AND billing_ref = :ref', [':ref' => $consol->no]);
						if (!empty($billing_line) && $billing_line->status != 11) {
							$billing_line->status = 11;
							$billing_line->update('status');
						}
					}

					if (empty($errors)) {
						$transaction->commit();
						echo json_encode(['done' => true, 'msg' => 'Successfully']);
						Yii::app()->end();
					} else {
						$transaction->rollback();
						echo json_encode(['done' => false, 'msg' => implode('<br />', $errors)]);
						Yii::app()->end();
					}
				}
			}
			break;
			default:
			{
				$this->render('jqm_import_af', array('type' => $_GET['type']));
			}
			break;
		}
	}

	public function actionAjaxBrokerInvoiceImport()
	{
		switch ($_GET['type']) {
			case 'fyn':
				$org_id = Org::ORGID_BROKER_FYN;
			break;
			case 'master':
				$org_id = Org::ORGID_BROKER_MASTER;
			break;
		}

		Yii::app()->cache->delete('pid_'.md5(session_id().'ediInvoiceProgress'));

		$resp = array('success' => 1, 'msg' => 'Imported Successfully');
		if (isset($_FILES) && !empty($_FILES)) {
			$ap_file = empty($_FILES['af_file']) ? array() : $_FILES['af_file'];
			if (empty($ap_file['tmp_name']) || !is_uploaded_file($ap_file['tmp_name'])) {
				$resp['msg'] = 'Invalid template file';
				echo json_encode($resp);
				return;
			} else {
				$filename = $ap_file['name'];
				if (AFInvoiceReconciliationHistory::fileImportedBefore($filename)) {
					if (isset($_POST['overwrite']) && $_POST['overwrite'] == 1) {
						// if agree to overwrite the old one
						$afImportHistorys = AFInvoiceReconciliationHistory::model()->findAll('hash = :hash', [':hash' => md5($filename)]);
						// clear all old data
						foreach ($afImportHistorys as $afImportHistory) {
							$afImportHistory->invoice_total = 0;
							$afImportHistory->success = 0;
							$afImportHistory->failed = 0;
							$oldInvoices = AFInvoiceReconciliation::model()->findAll('history_id = :hid', [':hid' => $afImportHistory->id]);
							foreach ($oldInvoices as $inv) {
								AFInvoiceReconciliationLine::model()->deleteAll('invoice_id = :iid', [':iid' => $inv->id]);
							}
						}
						// AFInvoiceReconciliation::model()->deleteAll('history_id = :hid',[':hid' => $afImportHistory->id] );
					} else {
						$resp['msg'] = 'The file has been imported already, if you want to overwrite them , please tick overwrite checkbox and try again';
						echo json_encode($resp);
						return;
					}
				}

				$ext = pathinfo($filename, PATHINFO_EXTENSION);
				if (strtolower($ext) != 'xlsx') {
					$resp['msg'] = 'Invalid template file please select .xlsx file';
					echo json_encode($resp);
					return;
				} else {
					$this->saveEdiInvoiceProgressFile(2, 'ready to load file');
					$xls = new oExcel;
					$xls->load($ap_file['tmp_name']);

					$this->saveEdiInvoiceProgressFile(5, 'file data uploaded');

					$sheetsArray = $xls->xls->getAllSheets();

					// normally one sheet for one invoice
					$invoiceCount = count($sheetsArray);
					$sheetCount = $invoiceCount;
					$sheetInvoicesFailed = array();
					if ($invoiceCount <= 0) {
						$resp['msg'] = 'No any valid invoice data found';
						echo json_encode($resp);
						return;
					}

					$data = array();
					foreach ($sheetsArray as $n => $sheet) {
						$data[] = $xls->getAll($sheet);
						unset($sheetsArray[$n]);
					}
					unset($xls);

					$this->saveEdiInvoiceProgressFile(8, 'file data loaded');

					$billings = array();
					$allItemsDesc = array(); // save all invoice related item description;
					$errors = array();
					$dates = [];

					$invoiceProcessedCount = 0;
					$sheetIndex = 1;

					$invoiceCount = 0;
					foreach ($data as $k => $invoice) {
						if (count($invoice) <= 1) {
							$errors[] = 'Failed to get invoice data for sheet index: ' . $sheetIndex;
							$sheetInvoicesFailed[] = array('index' => $sheetIndex, 'error' => 'invalid data');
							$sheetIndex++;
							continue; // invalid one
						}
						$sheetIndex++;

						// convert to real invoice number
						// format : TAX INVOICE 00159458
						$invoiceNumber = trim($invoice[3][3]);
						if (empty($invoiceNumber)) {
							$sheetInvoicesFailed[] = array('index' => $sheetIndex - 1, 'error' => 'no invoice number');
							continue;
						}

						$invoiceCount++;
						// $invoiceNumber = trim(substr($invoiceNumber, 12));

						$this->saveEdiInvoiceProgressFile((8 + $invoiceProcessedCount / $invoiceCount * 70), ' process invoice : ' . $invoiceNumber);

						// get consignor and consignee
						if ($invoice[14][3] != 'CONSIGNOR' && $invoice[14][3] != 'SUPPLIER') {
							$consignor = trim($invoice[50][3]);
						} else {
							$consignor = trim($invoice[15][3]);
						}
						if ($invoice[14][27] != 'CONSIGNEE' && $invoice[14][27] != 'IMPORTER') {
							$consignee = trim($invoice[50][27]);
						} else {
							$consignee = trim($invoice[15][27]);
						}
						$consignor = substr($consignor, 0, 100);
						$consignee = substr($consignee, 0, 100);

						// some time job format will be
						if ($invoice[18][3] != 'OWNER / ORDER REFERENCES') {
							$cref = trim($invoice[57][3], ' /');
						} else {
							$cref = trim($invoice[19][3], ' /'); // will job id or console id
						}
						if ($invoice[7][34] != 'INVOICE DATE:') {
							$invoiceDate = date('Y-m-d', strtotime(oExcel::toDate($invoice[7][41])));
						} else {
							$invoiceDate = date('Y-m-d', strtotime(oExcel::toDate($invoice[7][42])));
						}
						if ($invoice[33][34] != 'DUE DATE:' && is_numeric($invoice[33][41])) {
							$invoiceDue = date('Y-m-d', strtotime(oExcel::toDate($invoice[33][41])));
						} else if (is_numeric($invoice[33][42])) {
							$invoiceDue = date('Y-m-d', strtotime(oExcel::toDate($invoice[33][42])));
						}
						if ($invoice[8][34] == 'DUE DATE:' && is_numeric($invoice[8][42])) {
							$invoiceDue = date('Y-m-d', strtotime(oExcel::toDate($invoice[8][42])));
						}
						if (empty($invoiceDue)) {
							$invoiceDue = $invoiceDate;
						}

						preg_match_all('![S|B]\d+(\/\w)*!', $invoiceNumber, $realInvoiceNumber);
						if (empty($realInvoiceNumber)) {
							$sheetInvoicesFailed[] = array('index' => $sheetIndex - 1, 'error' => 'no invoice number');
							continue;
						}
						if (preg_match('/invoice/i', $invoiceNumber)) {
							$invoiceType = 0;
						} else if (preg_match('/credit note/i', $invoiceNumber)) {
							$invoiceType = 1;
						}
						$invoiceNumber = array_values(array_slice($realInvoiceNumber[0], -1))[0];

						// try to find weight ,volume and etc . value
						$orgin = '';
						$dest = '';
						$weight = 0;
						$volume = 0;
						$chargeWeight = 0;
						$eta = '';
						$etd = '';
						$awb = '';
						$shipno = '';
						for ($i = 10; $i < 80; $i++) {
							$tag = trim($invoice[$i][3]);
							$tag2 = trim($invoice[$i][27]);
							if ($tag == 'BROKER' || substr($tag, 0, 5) == 'OWNER' || $tag == 'ORDER NUMBERS / REFERENCE') {
								$weight = preg_replace('/\s*KG$/', '', trim($invoice[$i + 1][27]));
								$volume = preg_replace('/\s*M3$/', '', trim($invoice[$i + 1][38]));
								if (empty($volume)) {
									$volume = preg_replace('/\s*M3$/', '', trim($invoice[$i + 1][35]));
								}
								$chargeWeight = preg_replace('/\s*KG$/', '', trim($invoice[$i + 1][27]));
							} else if ($tag == 'ORIGIN') {
								$orgin = trim($invoice[$i + 1][3]); // origin location
								$dest = trim($invoice[$i + 1][27]); // destination
								if ($invoice[$i][19] != 'ETD') {
									$eta = oExcel::toDate($invoice[$i + 1][45]);
									$etd = oExcel::toDate($invoice[$i + 1][21]);
								} else {
									$eta = oExcel::toDate($invoice[$i][46]);
									$etd = oExcel::toDate($invoice[$i][22]);
								}
							} else if ($tag2 == 'OCEAN BILL OF LADING' || $tag2 == 'MAWB') {
								$awb = trim($invoice[$i + 1][27]); // get awb number

								$reg = 'ECN\s*\d{11}|ECN\s*\d{10}|ECN\s*\d{9}|AHAU\d{7}|AGDSY\d{8}\w{2}|AGDSY\d{8}|HNAU\d{6}';
								if (empty($shipno) && preg_match('/(' . $reg . ')/i', trim($invoice[$i + 1][3]), $matches) || preg_match('/' . $reg . '/i', trim($invoice[$i + 1][39]), $matches)) {
									$shipno = $matches[0];
								}

								if (empty($shipno) && preg_match('/,(\d{9})/i', trim($invoice[$i + 1][39]), $matches)) {
									$shipment = Shipment::model()->find('ref = :shipno AND status != 100', [':shipno' => 'TNT' . $matches[0]]);
									if (!empty($shipment)) {
										$shipno = $shipment->ref;
									} else {
										$shipno = '';
									}
								}

								if (empty($shipno) && preg_match('/PCA (\w*) \//i', trim($invoice[$i - 1][3]), $matches)) {
									$shipno = $matches[1];
								}

								if (empty($shipno)) {
									$shipno = str_replace(',', '', trim($invoice[$i + 1][39]));
								}

								break;
							}
						}

						// get all items
						$items = array();
						// try to find description begin line
						$itemLineIndex = 34; // if not found set as default
						for ($index = 12;; $index++) {
							if ($invoice[$index][3] == 'DESCRIPTION') {
								$itemLineIndex = $index + 2; // item lines begin from next 2 lines
								break;
							}
							// avoid dead loop
							if ($index > 120) {
								break;
							}

						}
						$allLineTotal = 0;
						$lineConstCount = 1;
						for ($index = $itemLineIndex;; $index++) {
							if ($index > 200) {
								break;
							}
							// avoid dead loop
							$lineConstCount++;
							if (empty($invoice[$index][3])) {
								if ($lineConstCount++ < 20) {
									continue;
								} else {
									break;
								}

							}
							if ($invoice[$index][34] == 'SUBTOTAL' || $invoice[$index][33] == 'SUBTOTAL') {
								break;
							}
							// got subtotal line stop

							$desc = trim($invoice[$index][3]);
							$gstAmount = 0;
							if (in_array(trim($invoice[$itemLineIndex-2][34]), ['GST IN AUD', '=IF("Y"<>"N","GST IN AUD","")']) || in_array(trim($invoice[$itemLineIndex-2][35]), ['GST IN AUD', '=IF("Y"<>"N","GST IN AUD","")'])) {
								if ($gst = preg_match('/^[\d\.\%]+\=(-[\d\.]+|[\d\.]+)$/', trim($invoice[$index][34]), $m)) {
									$gstAmount = $m[1];
								}
							} else {
								if (empty(trim($invoice[$index][31]))) {
									continue;
								} else {
									if ($gst = preg_match('/^[\d\.\%]+\=(-[\d\.]+|[\d\.]+)$/', trim($invoice[$index][31]), $m)) {
										$gstAmount = $m[1];
									}
								}
							}

							$value = floatval(str_replace(',', '', $invoice[$index][42]));

							//append desc
							if (empty($invoice[$index][34]) && empty($value) && !empty($items[sizeof($items) - 1]['desc'])) {
								$items[sizeof($items) - 1]['desc'] .= "\n" . $desc;
								continue;
							}
							$lineSubTotal = $value;
							$lineTotal = $lineSubTotal + $gstAmount;
							$allLineTotal += $lineTotal;

							$glcode = '91032';
							$chargeCode = '91032';

							$items[] = array('desc' => $desc, 'gst' => $gst, 'chargecode' => $chargeCode, 'glcode' => $glcode, 'value' => $value, 'subtotal' => $lineSubTotal, 'gstamount' => $gstAmount, 'total' => $lineTotal);
							$allItemsDesc[$desc] = 1;
						}
						// Yii::log(json_encode($items), 'error');

						// try to get subtotal , gst and total
						$subtotal = 0;
						$gst = 0;
						$total = 0;
						for ($index = $index;; $index++) {
							if ($invoice[$index][34] == 'SUBTOTAL') {
								$subtotal = floatval(str_replace(',', '', $invoice[$index][41]));
							} else if ($invoice[$index][33] == 'SUBTOTAL') {
								$subtotal = floatval(str_replace(',', '', $invoice[$index][39]));
							}
							if ($invoice[$index][34] == 'ADD GST') {
								$gst = floatval(str_replace(',', '', $invoice[$index][41]));
							} else if ($invoice[$index][33] == 'ADD GST') {
								$gst = floatval(str_replace(',', '', $invoice[$index][39]));
							}
							if ($invoice[$index][34] == 'TOTAL AUD') {
								$total = floatval(str_replace(',', '', $invoice[$index][41]));
								break;
							} else if ($invoice[$index][33] == 'TOTAL AUD') {
								$total = floatval(str_replace(',', '', $invoice[$index][39]));
								break;
							}

							if ($index > 400) {
								break;
							}
							// avoid dead loop
						}

						// making up billing array
						$billing = array(
							'number' => $invoiceNumber,
							'type' => $invoiceType,
							'awb' => $awb,
							'date' => $invoiceDate,
							'due' => $invoiceDue,
							'cnee' => $consignee,
							'cnor' => $consignor,
							'cref' => $cref,
							'orgin' => $orgin,
							'dest' => $dest,
							'eta' => $eta,
							'etd' => $etd,
							'weight' => $weight,
							'chargeWeight' => $chargeWeight,
							'volume' => $volume,
							'subtotal' => $subtotal,
							'gst' => $gst,
							'total' => $total,
							'linetotal' => $allLineTotal,
							'lines' => $items,
							'shipno' => $shipno,
						);

						// check to see if we got duplicata invoice by awb
						if (!empty($awb)) {
							$existing = AFInvoiceReconciliation::model()->find('awb = :awb', [':awb' => $awb]);
							if (!empty($existing)) {
								$msg = $invoiceNumber . ' duplicate in : ' . $existing->invoice_no . ' with awb: ' . $awb;
								$sheetInvoicesFailed[] = array('index' => $sheetIndex - 1, 'error' => $msg);
							}
						}

						// save a reconciliation history
						$month = date('m', strtotime($invoiceDate));
						if (!empty($dates[$month])) {
							$invoiceDate = $dates[$month];
						} else {
							$dates[$month] = date('Y-m-d', strtotime($invoiceDate));
						}
						$afImportHistory = AFInvoiceReconciliationHistory::model()->find('hash = :hash AND created = :created', [':hash' => md5($filename), ':created' => date('Y-m-d')]);
						if (empty($afImportHistory)) {
							$afImportHistory = new AFInvoiceReconciliationHistory();
							$afImportHistory->hash = md5($filename);
							$afImportHistory->created = date('Y-m-d');
							$afImportHistory->attached_file_id = 0;
							$afImportHistory->invoice_total = 0;
							$afImportHistory->failed = 0;
							$afImportHistory->success = 0;
							$afImportHistory->op_id = Yii::app()->user->id;
							$afImportHistory->save();
							$errs = $afImportHistory->getErrors();
							if (!empty($errs)) {
								$msg = '';
								foreach ($errs as $k => $e) {
									$msg .= implode(' ', $e);
								}
								$resp['msg'] = $msg;
								echo json_encode($resp);
								return;
							}

							// save imported billing file
							$attachedFileId = FileRepo::storeFile($ap_file['tmp_name'], $filename, 36, $afImportHistory->id);
							$afImportHistory->attached_file_id = $attachedFileId;
							$afImportHistory->update('attached_file_id');
						}

						// save billing
						$afModel = $afImportHistory->saveBilling($billing, $org_id);
						$errs = $afModel->getErrors();
						if (!empty($errs)) {
							$msg = '';
							foreach ($errs as $k => $e) {
								$msg .= implode(' ', $e);
							}
							$sheetInvoicesFailed[] = array('index' => $sheetIndex - 1, 'error' => $msg);
						}

						// begin to match the billing with HVLV system
						// import with previous record cause re-approve needed problem
						if ($afModel->history_id == $afImportHistory->id) {
							if ($this->matchBrokerInvoiceWithHvlv($afModel)) {
								$afImportHistory->success ++;
							} else {
								$afImportHistory->failed ++;
							}
						}

						// update eventually success and failed count
						$afImportHistory->invoice_total++;
						if (!empty($sheetInvoicesFailed)) {
							$afImportHistory->meta = json_encode($sheetInvoicesFailed);
							$afImportHistory->save();
						} else {
							$afImportHistory->invoice_total = $afImportHistory->totalSuccess + $afImportHistory->totalFailed;
							$afImportHistory->update(['failed', 'success', 'invoice_total']);
						}

						$billings[] = $billing;

						// update processing progress
						$invoiceProcessedCount++;
						$this->saveEdiInvoiceProgressFile((8 + $invoiceProcessedCount / $invoiceCount * 70), ' process invoice : ' . $invoiceNumber . ' done');
						$this->saveEdiInvoiceProgressFile((8 + $invoiceProcessedCount / $invoiceCount * 70), ' reading invoice ' . $invoiceProcessedCount . ' /  ' . $invoiceCount . ' processed');

						// release memory in time
						unset($invoice);
						unset($data[$k]);
					}

					// currently only create a report for edi invoice imported
					// $this->createEdiInvoiceImportReportPro($billings,$afImportHistory);

					// update processing progress
					$this->saveEdiInvoiceProgressFile(100, ' report created ');
				}
			}
		} else {
			$resp['success'] = 0;
			$resp['msg'] = 'Invalid billing file';
		}
		echo json_encode($resp);	
	}

	// only check invoice
	private function matchBrokerInvoiceWithHvlv($af)
	{
		// dont match rejected billing
		if (empty($af) || $af->matched_result == AFInvoiceReconciliation::MATCHED_RESULT_WRONG_REJECTED) {
			return false;
		}

		$awb1 = str_replace('-', '', $af->awb);
		$awb2 = substr($awb1, 0, 3) . '-' . substr($awb1, 3);
		$awb3 = str_replace(' ', '', $awb1);
		$shipment = Shipment::model()->find('(hbn = :shipno OR ref = :shipno OR ref = :awb1 OR ref = :awb2 OR ref = :awb3) AND status != 100', [':shipno' => $af->mdata['shipno'], ':awb1' => $awb1, ':awb2' => $awb2, ':awb3' => $awb3]);

		// if shipment not exist, try to match consol
		if (empty($shipment)) {
			$consol = Consol::model()->find('trim(awb) = :awb1 OR trim(awb) = :awb2 OR trim(awb) = :awb3', [':awb1' => $awb1, ':awb2' => $awb2, ':awb3' => $awb3]);
		} else {
			$consol = Consol::model()->findByPk($shipment->consol_id);
		}

		// if (empty($consol)) {
		// 	$af->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_WRONG_AWB_NOTFOUND;
		// 	$af->update('matched_result');
		// 	return false;
		// }

		if (!empty($consol)) {
			$af->fid = @$consol->id;
			$af->model = @$consol->getType();
			$af->update('fid', 'model');
		}

		$flag = 1;

		// billing total vs af total
		// get lines for this billing
		$billing_total = 0;
		$blines = BillingLine::model()->findAll('billing_ref = :bref AND org_id = :org_id AND charge_code = :glcode AND billing_cref = :cref AND status != 11', [':bref' => @$consol->no, ':org_id' => $af->supplier_id, ':glcode' => $af->lines[0]->glcode, ':cref' => $af->invoice_no]);
		if (!empty($blines)) {
			foreach ($blines as $bline) {
				$billing_total += $bline->actual_amount;
			}
		}
		$af_total = 0;
		foreach ($af->lines as $afline) {
			$af_total += $afline->amount;
		}

		if ($billing_total == $af_total) {
			$flag = 0;
		}

		// if consol exist, check and create billing lines to match af lines
		if ($flag && !empty($consol)) {
			$blines = BillingLine::model()->findAll('billing_ref = :bref AND org_id = :org_id AND charge_code = :glcode AND status != 11', [':bref' => $consol->no, ':org_id' => $af->supplier_id, ':glcode' => $af->lines[0]->glcode]);

			foreach ($af->lines as $afline) {
				$flag = 1;
				
				// check same invoice_no
				foreach ($blines as $bline) {
					if ($bline->billing_cref == $af->invoice_no && $bline->actual_amount == $afline->amount && $bline->desc == $af->awb . ' ' . $af->mdata['shipno'] . ' ' . preg_replace('/\n/', ' ', $afline->desc) . ' ' . $afline->amount) {
						$flag = 0;
						break;
					}
				}

				// set same chargecode line with info
				if ($flag) {
					foreach ($blines as $bline) {
						if (empty($bline->billing_cref)) {
							$bline->actual_amount = $afline->amount;
							$bline->billing_cref = $af->invoice_no;
							if ($afline->gst > 0) {
								$bline->gst = 'INPUT';
							} else {
								$bline->gst = 'EXEMPTEXPENSES';
							}
							$bline->gst_amount = $bline->getGSTValue();
							$bline->update('actual_amount', 'billing_cref', 'gst', 'gst_amount');
							$flag = 0;
							break;
						}
					}
				}

				// no same chargecode line
				if ($flag) {
					$bline = new BillingLine;
					$bline->billing_id = 0;
					$bline->org_id = $af->supplier_id;
					$bline->op_id = $af->op;
					$bline->link_id = $consol->id;
					$bline->created = date('Y-m-d');
					$bline->date = $af->date;
					$bline->due = $af->due;
					$bline->transaction_date = $af->date;
					$bline->type = BillingLine::BILLING_TYPE_IMPORT;
					$bline->dpmt = Invoice::DPMT_IMPORT;
					if ($afline->gst > 0) {
						$bline->gst = 'INPUT';
					} else {
						$bline->gst = 'EXEMPTEXPENSES';
					}
					$bline->status = 1;
					$bline->billing_cref = $af->invoice_no;
					$bline->billing_ref = $consol->no;
					$bline->awb = $consol->awb;
					$bline->dpt_id = $consol->dpt_id;
					$bline->currency = 1;
					$bline->actual_amount = $afline->amount;
					$bline->accrual_amount = $afline->amount;
					$bline->gst_amount = $afline->gst;
					$bline->charge_code = $afline->glcode;
					$bline->desc = $af->awb . ' ' . $af->mdata['shipno'] . ' ' . preg_replace('/\n/', ' ', $afline->desc) . ' ' . $afline->amount;
					$bline->qty = 1;
					$bline->item_code = $afline->glcode;
					$bline->price = 0;
					$bline->weight = $af->weight;
					$bline->charge_weight = $af->charge_weight;
					$bline->sync_xero = 0;
					$bline->save();
				}
			}
		// if consol not exist, check and create billing lines to match af lines
		} else if ($flag && empty($consol)) {
			$blines = BillingLine::model()->findAll('billing_cref = :cref AND org_id = :org_id AND charge_code = :glcode AND status != 11', [':cref' => $af->invoice_no, ':org_id' => $af->supplier_id, ':glcode' => $af->lines[0]->glcode]);

			foreach ($af->lines as $afline) {
				$flag = 1;
				
				// check same invoice_no
				foreach ($blines as $bline) {
					if ($bline->billing_cref == $af->invoice_no && $bline->actual_amount == $afline->amount && $bline->desc == $af->awb . ' ' . $af->mdata['shipno'] . ' ' . preg_replace('/\n/', ' ', $afline->desc) . ' ' . $afline->amount) {
						$flag = 0;
						break;
					}
				}

				if ($flag) {
					$bline = new BillingLine;
					$bline->billing_id = 0;
					$bline->org_id = $af->supplier_id;
					$bline->op_id = $af->op;
					$bline->link_id = @$consol->id;
					$bline->created = date('Y-m-d');
					$bline->date = $af->date;
					$bline->due = $af->due;
					$bline->transaction_date = $af->date;
					$bline->type = BillingLine::BILLING_TYPE_IMPORT;
					$bline->dpmt = Invoice::DPMT_IMPORT;
					if ($afline->gst > 0) {
						$bline->gst = 'INPUT';
					} else {
						$bline->gst = 'EXEMPTEXPENSES';
					}
					$bline->status = 1;
					$bline->billing_cref = $af->invoice_no;
					$bline->billing_ref = @$consol->no;
					$bline->awb = @$consol->awb;
					$bline->dpt_id = @$consol->dpt_id;
					$bline->currency = 1;
					$bline->actual_amount = $afline->amount;
					$bline->accrual_amount = $afline->amount;
					$bline->gst_amount = $afline->gst;
					$bline->charge_code = $afline->glcode;
					$bline->desc = $af->awb . ' ' . $af->mdata['shipno'] . ' ' . preg_replace('/\n/', ' ', $afline->desc) . ' ' . $afline->amount;
					$bline->qty = 1;
					$bline->item_code = $afline->glcode;
					$bline->price = 0;
					$bline->weight = $af->weight;
					$bline->charge_weight = $af->charge_weight;
					$bline->sync_xero = 0;
					$bline->save();
				}
			}
		}

		// if consol not exist, return, dont check invoice
		if (empty($consol)) {
			$af->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_WRONG_AWB_NOTFOUND;
			$af->update('matched_result');
			return false;
		}

		// check invoice
		$billing_total = 0;
		$blines = BillingLine::model()->findAll('billing_ref = :bref AND org_id = :org_id AND billing_cref = :cref AND status != 11', [':bref' => $consol->no, ':org_id' => $af->supplier_id, ':cref' => $af->invoice_no]);
		foreach ($blines as $bline) {
			$billing_total += $bline->actual_amount;
		}

		// for credit note return success
		if ($billing_total < 0) {
			$af->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_SUCCESS;
			$af->update('matched_result');
			return true;
		}

		// if not credit note and no shipment, return, dont check invoice
		if (empty($shipment)) {
			$af->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_WRONG_AWB_NOTFOUND;
			$af->update('matched_result');
			return false;
		}

		$invoice_total = 0;
		// first check CA
		$invoice = Invoice::model()->find('pid = :pid AND consol_id = :consol_id AND type = :type AND status NOT IN (8,10)', [':pid' => $shipment->id, ':consol_id' => $consol->id, ':type' => Invoice::INVOICE_TYPE_CASUAL]);
		if (!empty($invoice)) {
			$invoice_total = $invoice->total;
		}
		// then check DI
		if (empty($invoice)) {
			$invoices = Invoice::model()->findAll('consol_id = :consol_id AND type = :type AND status NOT IN (8,10)', [':consol_id' => $consol->id, ':type' => Invoice::INVOICE_TYPE_DIRECT_MAWB]);
			foreach ($invoices as $invoice) {
				$invoice_total = $invoice->getCustomBrokerAmount()[1] + $invoice->getCustomBrokerAmount()[2];
				if ($invoice_total > 0) {
					break;
				}
			}
		}
		// then check OT
		if (empty($invoice)) {
			$invoices = Invoice::model()->findAll('consol_id = :consol_id AND type = :type AND status NOT IN (8,10)', [':consol_id' => $consol->id, ':type' => Invoice::INVOICE_TYPE_OTHERS]);
			foreach ($invoices as $invoice) {
				$invoice_total = $invoice->getCustomBrokerAmount()[1] + $invoice->getCustomBrokerAmount()[2];
				if ($invoice->total > 0) {
					break;
				}
			}
		}

		if ($invoice_total < $billing_total + 20) {
			$af->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_WRONG_INVOICE_DIFF;
			$af->mdata['invoice'] = @$invoice->id;
			$af->update('matched_result', 'meta');
			return false;
		} else {
			$af->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_SUCCESS;
			$af->mdata['invoice'] = @$invoice->id;
			$af->update('matched_result', 'meta');
			foreach ($blines as $bline) {
				$bline->to_id = $invoice->to_id;
				$bline->update('to_id');
			}
			return true;
		}
	}

	public function actionAjaxQantasInvoiceImport()
	{
		$org_id = 955;

		Yii::app()->cache->delete('pid_'.md5(session_id().'ediInvoiceProgress'));

		$resp = array('success' => 1, 'msg' => 'Imported Successfully');
		if (isset($_FILES) && !empty($_FILES)) {
			$ap_file = empty($_FILES['af_file']) ? array() : $_FILES['af_file'];
			if (empty($ap_file['tmp_name']) || !is_uploaded_file($ap_file['tmp_name'])) {
				$resp['msg'] = 'Invalid template file';
				echo json_encode($resp);
				return;
			} else {
				$filename = $ap_file['name'];
				if (AFInvoiceReconciliationHistory::fileImportedBefore($filename)) {
					if (isset($_POST['overwrite']) && $_POST['overwrite'] == 1) {
						// if agree to overwrite the old one
						$afImportHistorys = AFInvoiceReconciliationHistory::model()->findAll('hash = :hash', [':hash' => md5($filename)]);
						// clear all old data
						foreach ($afImportHistorys as $afImportHistory) {
							$afImportHistory->invoice_total = 0;
							$afImportHistory->success = 0;
							$afImportHistory->failed = 0;
							$oldInvoices = AFInvoiceReconciliation::model()->findAll('history_id = :hid', [':hid' => $afImportHistory->id]);
							foreach ($oldInvoices as $inv) {
								AFInvoiceReconciliationLine::model()->deleteAll('invoice_id = :iid', [':iid' => $inv->id]);
							}
						}
						AFInvoiceReconciliation::model()->deleteAll('history_id = :hid', [':hid' => $afImportHistory->id]);
					} else {
						$resp['msg'] = 'The file has been imported already, if you want to overwrite them , please tick overwrite checkbox and try again';
						echo json_encode($resp);
						return;
					}
				}

				$ext = pathinfo($filename, PATHINFO_EXTENSION);
				if (strtolower($ext) != 'csv') {
					$resp['msg'] = 'Invalid template file please select .csv file';
					echo json_encode($resp);
					return;
				} else {
					$this->saveEdiInvoiceProgressFile(2, 'ready to load file');
					$xls = new oExcel('CSV');
					$xls->load($ap_file['tmp_name']);

					$this->saveEdiInvoiceProgressFile(5, 'file data uploaded');

					$sheetsArray = $xls->xls->getAllSheets();

					// normally only one sheet
					$invoiceCount = count($sheetsArray);
					$sheetCount = $invoiceCount;
					$sheetInvoicesFailed = array();
					if ($invoiceCount != 1) {
						$resp['msg'] = 'No any valid invoice data found';
						echo json_encode($resp);
						return;
					}

					$data = array();
					foreach ($sheetsArray as $n => $sheet) {
						$data[] = $xls->getAll($sheet);
						unset($sheetsArray[$n]);
					}
					unset($xls);

					$this->saveEdiInvoiceProgressFile(8, 'file data loaded');

					$billings = array();
					$allItemsDesc = array(); // save all invoice related item description;
					$errors = array();
					$successInvoices = 0;
					$failedInvoices = 0;

					$invoiceProcessedCount = 0;
					$sheetIndex = 1;

					$invoiceCount = 0;
					foreach ($data as $k => $invoice) {
						if (count($invoice) <= 1) {
							$errors[] = 'Failed to get invoice data for sheet index: ' . $sheetIndex;
							$sheetInvoicesFailed[] = array('index' => $sheetIndex, 'error' => 'invalid data');
							$sheetIndex ++;
							continue; // invalid one
						}
						$invoiceCount ++;
						$sheetIndex ++;

						// invoice no
						$invoiceNumber = $invoice[2][2];

						// get consigner and consignee
						$consignor = $invoice[2][1];
						$consignee = $invoice[2][4];

						// date and due
						$invoiceDate = date('Y-m-d', strtotime($invoice[2][3]));
						$invoiceDue = date('Y-m-d', strtotime($invoice[2][8]));

						$awb = '';
						unset($invoice[1]);
						foreach ($invoice as $k => $line) {
							if ($k > 1000) {
								break;
							}

							if (empty($line[14]) && empty($line[15])) {
								continue;
							}

							$afImportHistory = AFInvoiceReconciliationHistory::model()->find('hash = :hash AND created = :created', [':hash' => md5($filename), ':created' => date('Y-m-d')]);
							if (empty($afImportHistory)) {
								$afImportHistory = new AFInvoiceReconciliationHistory();
								$afImportHistory->hash = md5($filename);
								$afImportHistory->created = date('Y-m-d');
								$afImportHistory->attached_file_id = 0;
								$afImportHistory->invoice_total = 0;
								$afImportHistory->failed = 0;
								$afImportHistory->success = 0;
								$afImportHistory->op_id = Yii::app()->user->id;
								$afImportHistory->save();
								$errs = $afImportHistory->getErrors();
								if (!empty($errs)) {
									$msg = '';
									foreach ($errs as $k => $e) {
										$msg .= implode(' ', $e);
									}
									$resp['msg'] = $msg;
									echo json_encode($resp);
									return;
								}

								// save imported billing file
								$attachedFileId = FileRepo::storeFile($ap_file['tmp_name'], $filename, 36, $afImportHistory->id);
								$afImportHistory->attached_file_id = $attachedFileId;
								$afImportHistory->update('attached_file_id');
							}

							if (empty($awb) || $awb != $line[11]) {
								$awb = $line[11];

								$af = new AFInvoiceReconciliation;
								$af->supplier_id = $org_id;
								$af->history_id = $afImportHistory->id;
								$af->invoice_no = $invoiceNumber;
								$af->awb = $line[11];
								$af->date = $invoiceDate;
								$af->due = $invoiceDue;
								$af->created = $invoiceDate;
								$af->cnee = $consignee;
								$af->cnor = $consignor;
								$af->weight = 0;
								$af->charge_weight = 0;
								$af->volume = 0;
								$af->subtotal = 0;
								$af->gst = 0;
								$af->total = 0;
								$af->matched_result = 0;
								$af->op = 0;
								$af->save();
							}

							if (!empty($line[14])) {
								$afl = new AFInvoiceReconciliationLine;
								$afl->invoice_id = $af->id;
								$afl->desc = $line[13];
								$afl->amount = str_replace(',', '', str_replace('$', '', $line[14]));
								$afl->gst = str_replace(',', '', str_replace('$', '', $line[15]));
								$afl->glcode = '91030';
								$afl->save();

								$af->subtotal += $afl->amount;
								$af->gst += $afl->gst;
								$af->total = $af->subtotal + $af->gst;
								$af->update('subtotal', 'gst', 'total');
							}
						}

						$afImportHistory->refresh();
						foreach ($afImportHistory->af as $af) {
							// begin to match the billing with HVLV system
							if ($this->matchAirportsInvoiceWithHvlv($af)) {
								$afImportHistory->success ++;
							} else {
								$afImportHistory->failed ++;
							}
						}

						// update eventually success and failed count
						if (!empty($sheetInvoicesFailed)) {
							$afImportHistory->meta = json_encode($sheetInvoicesFailed);
							$afImportHistory->save();
						} else {
							$afImportHistory->invoice_total = $afImportHistory->totalSuccess + $afImportHistory->totalFailed;
							$afImportHistory->update(['failed', 'success', 'invoice_total']);
						}

						// update processing progress
						$invoiceProcessedCount ++;
						$this->saveEdiInvoiceProgressFile((8 + $invoiceProcessedCount / $invoiceCount * 70), ' process invoice : ' . $invoiceNumber . ' done');
						$this->saveEdiInvoiceProgressFile((8 + $invoiceProcessedCount / $invoiceCount * 70), ' reading invoice ' . $invoiceProcessedCount . ' /  ' . $invoiceCount . ' processed');

						// release memory in time
						unset($invoice);
						unset($data[$k]);
					}

					// currently only create a report for edi invoice imported
					// $this->createEdiInvoiceImportReportPro($billings,$afImportHistory);

					// update processing progress
					$this->saveEdiInvoiceProgressFile(100, ' report created ');
				}
			}
		} else {
			$resp['success'] = 0;
			$resp['msg'] = 'Invalid billing file';
		}
		echo json_encode($resp);
	}

	private function matchAirportsInvoiceWithHvlv($af)
	{
		// dont match rejected billing
		if (empty($af) || $af->matched_result == AFInvoiceReconciliation::MATCHED_RESULT_WRONG_REJECTED) {
			return false;
		}

		$awb1 = str_replace('-', '', $af->awb);
		$awb2 = substr($awb1, 0, 3) . '-' . substr($awb1, 3);
		$awb3 = str_replace(' ', '', $awb1);

		$consol = Consol::model()->find('(trim(awb) = :awb1 OR trim(awb) = :awb2 OR trim(awb) = :awb3) AND status != 100', [':awb1' => $awb1, ':awb2' => $awb2, ':awb3' => $awb3]);

		if (empty($consol)) {
			$af->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_WRONG_AWB_NOTFOUND;
			$af->update('matched_result');
			return false;
		}

		if (!empty($consol)) {
			if ($consol->getType() == 'EdiAwbConsol') {
				$job = EdiJob::model()->find('(trim(awb) = :awb1 OR trim(awb) = :awb2 OR trim(awb) = :awb3)', [':awb1' => $awb1, ':awb2' => $awb2, ':awb3' => $awb3]);
				if (empty($job)) {
					$af->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_WRONG_AWB_NOTFOUND;
					$af->update('matched_result');
					return false;
				} else {
					$af->fid = $job->id;
					$af->model = $job->getType();
					$af->update('fid', 'model');

					$consol = $job;
				}
			} else {
				$af->fid = $consol->id;
				$af->model = $consol->getType();
				$af->update('fid', 'model');
			}
		}

		$desc = '';
		foreach ($af->lines as $line) {
			$desc .= $line->desc . ' ' . $line->amount . ' ';
		}

		$billingline = BillingLine::model()->find('billing_ref = :bref AND (org_id = :org_id OR org_id = 949) AND charge_code = :charge_code AND (actual_amount = 0 OR billing_cref = :cref)', [':bref' => $consol->no, ':org_id' => $af->supplier_id, ':charge_code' => $af->lines[0]->glcode, ':cref' => $af->invoice_no]);
		if (empty($billingline)) {
			$billingline = new BillingLine;
			$billingline->op_id = Yii::app()->user->id;
			$billingline->created = $af->created;
			$billingline->date = $af->date;
			$billingline->due = $af->due;
			$billingline->transaction_date = $af->date;
			$billingline->type = BillingLine::BILLING_TYPE_IMPORT;
			$billingline->dpmt = Invoice::DPMT_IMPORT;
			$billingline->billing_ref = $consol->no;
			$billingline->awb = $consol->awb;
			$billingline->dpt_id = 106;
			$billingline->currency = 1;
			$billingline->status = 1;
		}
		$billingline->desc = $desc;
		$billingline->org_id = $af->supplier_id;
		$billingline->billing_cref = $af->invoice_no;
		$billingline->actual_amount = $af->subtotal;
		$billingline->gst = $af->lines[0]->gst ? 'INPUT' : 'EXEMPTEXPENSES';
		$billingline->gst_amount = $billingline->getGSTValue();
		$billingline->charge_code = $af->lines[0]->glcode;
		$billingline->item_code = $af->lines[0]->glcode;
		$billingline->mdata['af'] = $af->id;
		if ($consol->getType() == 'EdiJob') {
			$billingline->accrual_amount = BillingLine::getAirportAccural($af->supplier_id, $consol->mdata['jbv_gw'], true, true);
			$billingline->item_code = 'GL5';
		} else {
			$billingline->accrual_amount = BillingLine::getAirportAccural($af->supplier_id, $consol->mdata['cgb_wt'], (!empty($consol->mdata['air_type']) && ($consol->mdata['air_type'] <= 2)));
		}
		$billingline->save();

		if ($af->subtotal > $billingline->accrual_amount * 1.05) {
			$af->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_WRONG_DIFF_TOOBIG;
			$af->update('matched_result');
		} else {
			$af->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_SUCCESS;
			$af->update('matched_result');
		}

		return true;
	}

	public function actionAjaxMenziesInvoiceImport()
	{
		$org_id = 939;

		// anyway try to delete old processed progress bar file
		Yii::app()->cache->delete('pid_'.md5(session_id().'ediInvoiceProgress'));

		$resp = array('success' => 1, 'msg' => 'Imported Successfully');
		if (isset($_FILES) && !empty($_FILES)) {
			$ap_file = empty($_FILES['af_file']) ? array() : $_FILES['af_file'];
			if (empty($ap_file['tmp_name']) || !is_uploaded_file($ap_file['tmp_name'])) {
				$resp['msg'] = 'Invalid template file';
				echo json_encode($resp);
				return;
			} else {
				$filename = $ap_file['name'];
				if (AFInvoiceReconciliationHistory::fileImportedBefore($filename)) {
					if (isset($_POST['overwrite']) && $_POST['overwrite'] == 1) {
						// if agree to overwrite the old one
						$afImportHistorys = AFInvoiceReconciliationHistory::model()->findAll('hash = :hash', [':hash' => md5($filename)]);
						// clear all old data
						foreach ($afImportHistorys as $afImportHistory) {
							$afImportHistory->invoice_total = 0;
							$afImportHistory->success = 0;
							$afImportHistory->failed = 0;
							$oldInvoices = AFInvoiceReconciliation::model()->findAll('history_id = :hid', [':hid' => $afImportHistory->id]);
							foreach ($oldInvoices as $inv) {
								AFInvoiceReconciliationLine::model()->deleteAll('invoice_id = :iid', [':iid' => $inv->id]);
							}
						}
						AFInvoiceReconciliation::model()->deleteAll('history_id = :hid', [':hid' => $afImportHistory->id]);
					} else {
						$resp['msg'] = 'The file has been imported already, if you want to overwrite them , please tick overwrite checkbox and try again';
						echo json_encode($resp);
						return;
					}
				}

				$ext = pathinfo($filename, PATHINFO_EXTENSION);
				if (strtolower($ext) != 'xml') {
					$resp['msg'] = 'Invalid template file please select .xml file';
					echo json_encode($resp);
					return;
				} else {
					$this->saveEdiInvoiceProgressFile(2, 'ready to load file');
					$xml = simplexml_load_file($ap_file['tmp_name']);

					$this->saveEdiInvoiceProgressFile(5, 'file data uploaded');

					// normally only one file
					$invoiceCount = sizeof($xml->Details);
					if ($invoiceCount <= 0) {
						$resp['msg'] = 'No any valid invoice data found';
						echo json_encode($resp);
						return;
					}

					$header = $xml->Header;
					$data = $xml->Details;
					unset($xml);

					$afImportHistory = AFInvoiceReconciliationHistory::model()->find('hash = :hash AND created = :created', [':hash' => md5($filename), ':created' => date('Y-m-d')]);
					if (empty($afImportHistory)) {
						$afImportHistory = new AFInvoiceReconciliationHistory();
						$afImportHistory->hash = md5($filename);
						$afImportHistory->created = date('Y-m-d');
						$afImportHistory->attached_file_id = 0;
						$afImportHistory->invoice_total = 0;
						$afImportHistory->failed = 0;
						$afImportHistory->success = 0;
						$afImportHistory->op_id = Yii::app()->user->id;
						$afImportHistory->save();
						$errs = $afImportHistory->getErrors();
						if (!empty($errs)) {
							$msg = '';
							foreach ($errs as $k => $e) {
								$msg .= implode(' ', $e);
							}
							$resp['msg'] = $msg;
							echo json_encode($resp);
							return;
						}

						// save imported billing file
						$attachedFileId = FileRepo::storeFile($ap_file['tmp_name'], $filename, 36, $afImportHistory->id);
						$afImportHistory->attached_file_id = $attachedFileId;
						$afImportHistory->update('attached_file_id');
					}

					$errors = [];
					foreach ($data as $k => $detail) {
						$af = AFInvoiceReconciliation::model()->find('invoice_no = :no AND awb = :awb', [':no' => $header->Invoice_No, ':awb' => $detail->Object_Number]);
						if (empty($af)) {
							$af = new AFInvoiceReconciliation;
							$af->supplier_id = $org_id;
							$af->history_id = $afImportHistory->id;
							$af->invoice_no = $header->Invoice_No;
							$af->awb = $detail->Object_Number;
							$af->date = oExcel::toDate($header->Invoice_Date);
							$af->due = date('Y-m-d', strtotime($af->date . ' + 14 days'));
							$af->created = $af->date;
							$af->cnee = $header->Invoice_Name;
							$af->cnor = 'Menzies';
							$af->weight = 0;
							$af->charge_weight = 0;
							$af->volume = 0;
							$af->subtotal = 0;
							$af->gst = 0;
							$af->total = 0;
							$af->matched_result = 0;
							$af->op = 0;
							$af->save();
						}

						$afl = AFInvoiceReconciliationLine::model()->find('invoice_id = :id AND `desc` = :desc', [':id' => $af->id, ':desc' => $detail->Tran_Description]);
						if (empty($afl)) {
							$afl = new AFInvoiceReconciliationLine;
							$afl->invoice_id = $af->id;
							$afl->desc = $detail->Tran_Description;
							$afl->amount = $detail->Tran_Amount;
							$afl->gst = $detail->Tran_VAT;
							$afl->glcode = '91030';
							$afl->save();

							$af->subtotal += floatval($afl->amount);
							$af->gst += floatval($afl->gst);
							$af->total = $af->subtotal + $af->gst;
							$af->update('subtotal', 'gst', 'total');
						}
					}

					$afImportHistory->refresh();
					foreach ($afImportHistory->af as $af) {
						// begin to match the billing with HVLV system
						if ($this->matchAirportsInvoiceWithHvlv($af)) {
							$afImportHistory->success ++;
						} else {
							$afImportHistory->failed ++;
						}
					}

					// update eventually success and failed count
					if (!empty($sheetInvoicesFailed)) {
						$afImportHistory->meta = json_encode($sheetInvoicesFailed);
						$afImportHistory->save();
					} else {
						$afImportHistory->invoice_total = $afImportHistory->totalSuccess + $afImportHistory->totalFailed;
						$afImportHistory->update('success', 'failed', 'invoice_total');
					}

					// update processing progress
					$this->saveEdiInvoiceProgressFile(100, ' report created ');
				}
			}
		} else {
			$resp['success'] = 0;
			$resp['msg'] = 'Invalid billing file';
		}
		echo json_encode($resp);
	}

	public function actionBrokerCheck()
	{
		$orgs = Org::$brokers;

		// billings
		$billings = Billing::model()->with('invoice')->findAll('t.org_id IN (' . implode(',', $orgs) . ') AND t.status != 11 AND (invoice.inv_id IS NULL OR invoice.inv_id = 0 OR invoice.consol_id IS NULL OR invoice.consol_id = 0 OR invoice.shipment_id IS NULL OR invoice.shipment_id = 0)');
		foreach ($billings as $billing) {
			$billing_invoice = BillingInvoice::model()->find('billing_cref = :billing_cref AND org_id = :org_id', [':billing_cref' => $billing->billing_cref, ':org_id' => $billing->org_id]);
			if (empty($billing_invoice)) {
				$billing_invoice = new BillingInvoice;
				$billing_invoice->billing_cref = $billing->billing_cref;
				$billing_invoice->org_id = $billing->org_id;
				$billing_invoice->billing_subtotal = 0;
				$billing_invoice->billing_gst = 0;
				$billinglines = BillingLine::model()->findAll('t.org_id = :org_id AND t.status != 11 AND t.billing_cref LIKE "' . $billing->billing_cref . '%"', [':org_id' => $billing->org_id]);
				foreach ($billinglines as $line) {
					$billing_invoice->billing_subtotal += floatval($line->actual_amount);
					$billing_invoice->billing_gst += floatval($line->gst_amount);
				}
			} else if ($billing_invoice->status > 10) {
				continue;
			}

			// $shipment = @$billing_invoice->shipment;
			$shipment = null;
			$consol = null;
			foreach ($billing->lines as $line) {
				$consol = Consol::model()->find('no = :no', [':no' => $line->billing_ref]);
				// shipment hbn or ref
				$reg = 'ECN\s*\d{11}|ECN\s*\d{10}|ECN\s*\d{9}|AHAU\d{7}|\d{13}|AGDSY\d{8}\w{2}|AGDSY\d{8}|ZV00\d{4}|CPBYKYZ\d{7}|HNAU\d{6}';
				preg_match('/' . $reg . '/i', $line->desc, $matches);
				if (!empty($matches)) {
					$shipment = Shipment::model()->find('(hbn = :shipno OR ref = :shipno) AND status != 100', [':shipno' => str_replace(' ', '', $matches[0])]);
				}

				// line desc [1]
				if (empty($shipment) && !empty($consol)) {
					$reg = [];
					$reg[] = explode(' ', $line->desc)[1];
					$shipment = Shipment::model()->find('(hbn in ("' . implode('","', $reg) . '") OR ref in ("' . implode('","', $reg) . '")) AND status != 100');
				}

				// consol awb or no
				if (empty($shipment) && !empty($consol)) {
					$reg = [];
					$reg[] = $awb1 = str_replace('-', '', $consol->awb);
					$reg[] = $awb2 = substr($awb1, 0, 3) . '-' . substr($awb1, 3);
					$reg[] = $awb3 = str_replace(' ', '', $awb1);
					$reg[] = $consol->no;
					$shipment = Shipment::model()->find('(hbn in ("' . implode('","', $reg) . '") OR ref in ("' . implode('","', $reg) . '")) AND status != 100');
				}
			}

			if (!empty($consol)) {
				$billing_invoice->consol_id = $consol->id;
			} else {
				$billing_invoice->consol_id = 0;
			}
			if (!empty($shipment)) {
				$billing_invoice->shipment_id = $shipment->id;
			} else {
				$billing_invoice->shipment_id = 0;
			}

			// credit note
			if ($billing_invoice->billing_subtotal < 0) {
				$billing_invoice->inv_id = 0;
				$billing_invoice->save();
				continue;
			}

			$billing_invoice->checkInvoice();

			if (empty($billing_invoice->invoice_subtotal)) {
				$billing_invoice->inv_id = 0;
			}
			$billing_invoice->save();
		}

		// lines
		$billinglines = BillingLine::model()->with('invoice')->findAll('t.org_id IN (' . implode(',', $orgs) . ') AND t.status != 11 AND t.billing_id = 0 AND t.billing_cref != t.billing_ref AND (invoice.inv_id IS NULL OR invoice.inv_id = 0 OR invoice.consol_id IS NULL OR invoice.consol_id = 0 OR invoice.shipment_id IS NULL OR invoice.shipment_id = 0)');
		$billings = [];
		foreach ($billinglines as $line) {
			if (empty($billings[$line->billing_cref . '_' . $line->org_id])) {
				$billings[$line->billing_cref . '_' . $line->org_id] = [];
			}
			$billings[$line->billing_cref . '_' . $line->org_id][] = $line;
		}
		foreach ($billings as $cref_orgid => $lines) {
			$cref = explode('_', $cref_orgid)[0];
			$org_id = explode('_', $cref_orgid)[1];
			$billing_invoice = BillingInvoice::model()->find('billing_cref = :billing_cref AND org_id = :org_id', [':billing_cref' => $cref, ':org_id' => $org_id]);
			if (empty($billing_invoice)) {
				$billing_invoice = new BillingInvoice;
				$billing_invoice->billing_cref = $cref;
				$billing_invoice->org_id = $org_id;
				$billing_invoice->billing_subtotal = 0;
				$billing_invoice->billing_gst = 0;
				$billinglines = BillingLine::model()->findAll('t.org_id = :org_id AND t.status != 11 AND t.billing_cref LIKE "' . $cref . '%"', [':org_id' => $org_id]);
				foreach ($billinglines as $line) {
					$billing_invoice->billing_subtotal += floatval($line->actual_amount);
					$billing_invoice->billing_gst += floatval($line->gst_amount);
				}
			} else if ($billing_invoice->status > 10) {
				continue;
			}

			// $shipment = @$billing_invoice->shipment;
			$shipment = null;
			$consol = Consol::model()->find('no = :no', [':no' => $lines[0]->billing_ref]);
			foreach ($lines as $line) {
				// shipment hbn or ref
				$reg = 'ECN\s*\d{11}|ECN\s*\d{10}|ECN\s*\d{9}|AHAU\d{7}|\d{13}|AGDSY\d{8}\w{2}|AGDSY\d{8}|ZV00\d{4}|CPBYKYZ\d{7}|HNAU\d{6}';
				preg_match('/' . $reg . '/i', $line->desc, $matches);
				if (!empty($matches)) {
					$shipment = Shipment::model()->find('(hbn = :shipno OR ref = :shipno) AND status != 100', [':shipno' => str_replace(' ', '', $matches[0])]);
				}

				// line desc [1]
				if (empty($shipment) && !empty($consol)) {
					$reg = [];
					$reg[] = explode(' ', $line->desc)[1];
					$shipment = Shipment::model()->find('(hbn in ("' . implode('","', $reg) . '") OR ref in ("' . implode('","', $reg) . '")) AND status != 100');
				}

				// consol awb or no
				if (empty($shipment) && !empty($consol)) {
					$reg = [];
					$reg[] = $awb1 = str_replace('-', '', $consol->awb);
					$reg[] = $awb2 = substr($awb1, 0, 3) . '-' . substr($awb1, 3);
					$reg[] = $awb3 = str_replace(' ', '', $awb1);
					$reg[] = $consol->no;
					$shipment = Shipment::model()->find('(hbn in ("' . implode('","', $reg) . '") OR ref in ("' . implode('","', $reg) . '")) AND status != 100');
				}
			}

			if (!empty($consol)) {
				$billing_invoice->consol_id = $consol->id;
			} else {
				$billing_invoice->consol_id = 0;
			}
			if (!empty($shipment)) {
				$billing_invoice->shipment_id = $shipment->id;
			} else {
				$billing_invoice->shipment_id = 0;
			}

			// credit note
			if ($billing_invoice->billing_subtotal < 0) {
				$billing_invoice->inv_id = 0;
				$billing_invoice->save();
				continue;
			}

			$billing_invoice->checkInvoice();

			if (empty($billing_invoice->invoice_subtotal)) {
				$billing_invoice->inv_id = 0;
			}
			$billing_invoice->save();
		}

		$model = new BillingInvoice('search');
		$model->unsetAttributes();
		if (isset($_GET['BillingInvoice'])) {
			$model->attributes = $_GET['BillingInvoice'];
		}

		$this->render('broker_check', ['model' => $model]);
	}

	public function actionBrokerCheckUpdate($id)
	{
		$model = BillingInvoice::model()->findByPk($id);
		if (empty($_POST)) {
			$this->render('broker_check_update', ['model' => $model]);
		} else {
			if (!empty($_POST['BillingInvoice']['invoice']['no'])) {
				$invoice = Invoice::model()->find('no = :t OR id = :t', [':t' => $_POST['BillingInvoice']['invoice']['no']]);
			} else {
				$model->inv_id = 0;
			}
			if (!empty($_POST['BillingInvoice']['shipment']['ref'])) {
				$shipment = Shipment::model()->find('hbn = :t OR ref = :t', [':t' => $_POST['BillingInvoice']['shipment']['ref']]);
			} else if (!empty($_POST['BillingInvoice']['shipment']['hbn'])) {
				$shipment = Shipment::model()->find('hbn = :t OR ref = :t', [':t' => $_POST['BillingInvoice']['shipment']['hbn']]);
			} else {
				$model->shipment_id = 0;
			}
			if (!empty($_POST['BillingInvoice']['consol']['no'])) {
				$consol = Consol::model()->find('no = :t OR awb = :t', [':t' => $_POST['BillingInvoice']['consol']['no']]);
			} else {
				$model->consol_id = 0;
			}

			$model->inv_id = !empty($invoice) ? $invoice->id : $model->inv_id;
			$model->shipment_id = !empty($shipment) ? $shipment->id : $model->shipment_id;
			$model->consol_id = !empty($consol) ? $consol->id : $model->consol_id;
			$model->note = !empty($_POST['BillingInvoice']['note']) ? $_POST['BillingInvoice']['note'] : $model->note;
			$model->update('inv_id', 'shipment_id', 'consol_id', 'note');

			if (!empty($invoice)) {
				[$model->inv_id, $model->invoice_subtotal, $model->invoice_gst] = $invoice->getCustomBrokerAmount();
				$model->update('invoice_subtotal', 'invoice_gst');
			} else {
				[$model->invoice_subtotal, $model->invoice_gst] = [0, 0];
				$model->update('invoice_subtotal', 'invoice_gst');
			}

			// result in all line with billing_cref jump to consol with billing_ref
			// if (!empty($consol)) {
			// 	$billinglines = BillingLine::model()->findAll('billing_cref = :cref AND org_id IN (' . implode(',', Org::$brokers) . ')', [':cref' => $model->billing_cref]);
			// 	foreach ($billinglines as $line) {
			// 		$line->billing_ref = $consol->no;
			// 		$line->update('billing_ref');
			// 	}
			// }
			if (!empty($consol)) {
				$billinglines = BillingLine::model()->findAll('billing_cref = :cref AND billing_ref = :ref AND org_id IN (' . implode(',', Org::$brokers) . ')', [':cref' => $model->billing_cref, ':ref' => $consol->no]);
				if (empty($billinglines)) {
					$billinglines = BillingLine::model()->findAll('billing_cref = :cref AND org_id IN (' . implode(',', Org::$brokers) . ')', [':cref' => $model->billing_cref]);
					foreach ($billinglines as $line) {
						$line->billing_ref = $consol->no;
						$line->update('billing_ref');
					}
				}
			}

			if ($model->status > 10) {
				$model->checkInvoice();
				$model->save();
			}

			$this->ajaxResult($model);
		}
	}

	public function actionStreamLine()
	{
		$this->render('stream_line');
	}

	public function actionInvoiceFix($id)
	{
		$model = $this->loadModel($id);
		$model->check();
		$this->ajaxResult($model);
	}

	public function actionRecheck($fid)
	{
		$model = AFInvoiceReconciliationHistory::model()->findByPk($fid);
		foreach ($model->af as $af) {
			$billing_invoice = BillingInvoice::model()->find('billing_cref = :billing_cref', [':billing_cref' => $af->invoice_no]);
			if (!empty($billing_invoice)) {
				if (!empty($billing_invoice->lines)) {
					$billing_invoice->billing_subtotal = 0;
					foreach ($billing_invoice->lines as $line) {
						$billing_invoice->billing_subtotal += $line->actual_amount;
					}
					$billing_invoice->update('billing_subtotal');
				}
				if ($billing_invoice->invoice_subtotal < $billing_invoice->billing_subtotal + 20) {
					$billing_invoice->status = 10;
					$billing_invoice->update('status');
				}
				$billing_invoice->checkStatus();
			}
		}
		$this->ajaxResult($model);
	}

	public function actionPost()
	{
		if (!empty($_POST['selectedItems'])) {
			// $transaction_date = $_POST['transaction_date'];
			// $invoice_date = $_POST['invoice_date'];
			// $invoice_due = $_POST['invoice_due'];

			$billings = [];
			foreach ($_POST['selectedItems'] as $id) {
				$billing = Billing::model()->findByPk($id);
				if (empty($billing->transaction_date) || $billing->transaction_date === '0000-00-00') {
					$billing->transaction_date = $billing->created;
				}
				if (empty($billing->date) || $billing->date === '0000-00-00') {
					$billing->date = date('Y-m-d');
				}
				if (empty($billing->due) || $billing->due === '0000-00-00') {
					$billing->due = $billing->date;
				}
				$billing->update('transaction_date', 'date', 'due');
				// sync billing & line
				foreach ($billing->lines as $line) {
					$line->transaction_date = $billing->transaction_date;
					$line->date = $billing->date;
					$line->due = $billing->due;
					$line->update('transaction_date', 'date', 'due');
				}
				$billings[$billing->billing_cref] = $billing->lines;
			}
			$this->postXero($billings);
			echo json_encode(['done' => true, 'msg' => 'Post successfully']);
			return;
		} else {
			echo json_encode(['done' => false, 'msg' => 'Please select billings']);
			return;
		}
	}

	public function actionLineFix($id)
	{
		if (empty($_POST)) {
			$this->render('jqm_billing_fix', array('id' => $id));
		} else {
			if (!empty($_POST['yt0']) && $_POST['yt0'] == 'Update') {
				$billing = Billing::model()->findByPk($id);
				$billing->currency = $_POST['currency'];
				$billing->mdata['exrate'] = $_POST['exrate'];
				$billing->billing_cref = $_POST['billing_cref'];
				$billing->update('currency', 'meta');

				foreach ($billing->lines as $line) {
					$line->currency = $billing->currency;
					$line->gst_amount = $line->getGSTValue();
					$line->billing_cref = $_POST['billing_cref'];
					$line->update('currency', 'gst_amount', 'line');
				}
			} else if (!empty($_POST['yt1']) && $_POST['yt1'] == 'Repost') {
				$billing = Billing::model()->findByPk($id);
				$billing->custom_log_note = 'Repost';
				$billing->save();
				$billings = [];
				$billings[$billing->billing_cref] = $billing->lines;
				$this->postXero($billings);
			}

			$this->ajaxResult($billing);
		}
	}

	public function actionLineDescSuggest()
	{
		$descs = BillingLine::$desc;

		$suggests = [];
		foreach ($descs as $desc => $code) {
			if (stripos($desc, $_GET['term']) !== false) {
				$suggests[] = ['value' => $desc, 'label' => $desc, 'chargecode' => $code];
			}
		}

		echo json_encode($suggests);
	}

	public function actionDelete($id)
	{
		$model = $this->loadModel($id);
		foreach ($model->lines as $line) {
			if ($line->accrual_amount > 0) {
				$line->actual_amount = 0;
				$line->billing_cref = '';
				$line->billing_id = 0;
				$line->status = 1;
				$line->update('actual_amount', 'billing_cref', 'billing_id', 'status');
			} else {
				$line->status = 11;
				$line->update('status');
			}
		}
		$model->status = 11;
		$model->update('status');
	}

	public function actionBillingcrefCheck($no)
	{
		$billing = Billing::model()->find('billing_cref = :no', [':no' => $no]);
		if (!empty($billing) && $billing->status >= 3) {
			$billing->addError('id', 'The status of this invoice is posted');
			$this->ajaxResult($billing);
		} else {
			$billing = new Billing;
			$this->ajaxResult($billing);
		}
	}

	/**
	 * In Broker Check list, approve afinvoice to set status = 1
	**/
	public function actionApproveAF($afid, $cref)
	{
		$af = AFInvoiceReconciliation::model()->findByPk($afid);
		$af->matched_result = 1;
		$af->update('matched_result');

		$model = BillingInvoice::model()->find('billing_cref = :cref', [':cref' => $cref]);
		$model->status = 20;
		$model->update('status');

		$this->ajaxResult($af);
	}

	public function actionOTInvoice1($id)
	{
		$model = $this->loadModel($id);
		if (empty($_POST)) {
			$this->render('ot_invoice1', ['billing' => $model]);
		} else {
			if (empty($_POST['selectedItems'])) {
				$model->addError('id', 'Please select lines');
			} else {
				$consols = [];
				foreach ($_POST['selectedItems'] as $line) {
					$line = BillingLine::model()->findByPk($line);
					if (empty($consols[$line->billing_ref])) {
						$consols[$line->billing_ref] = [];
					}
					$consols[$line->billing_ref][] = $line;
				}

				foreach ($consols as $ref => $lines) {
					$consol = Consol::model()->find('no = :no', [':no' => $ref]);
					if (!empty($consol)) {
						foreach ($lines as $line) {
							if (!in_array($line->flag, [BillingLine::BILLING_FLAG_MANUAL, BillingLine::BILLING_FLAG_SECOND])) continue;
							$shipment = null;
							if (preg_match('/(7RFZ\d{8}|4XHZ\d{8})/', $line->desc, $m)) {
								$shipment = $m[1];
								$shipment = Shipment::model()->find('ref = :ref', [':ref' => $shipment]);
							}
							if (empty($shipment) && preg_match('/(PCD\d{9}|DKC\d{9}|BPC\d{9})/', $line->desc, $m)) {
								$shipment = $m[1];
								$shipment = Shipment::model()->find('ref = :ref', [':ref' => $shipment]);
							}
							if (empty($shipment)) {
								continue;
							}

							// find invoice or create invoice
							$agent = $shipment->agent->by == 1 ? $shipment->agent : $shipment->agent->owner;
							$invoice = Invoice::model()->find('to_id = :to_id AND consol_id = :consol_id AND pid = :pid AND status != 10', [':to_id' => $agent->id, ':consol_id' => $consol->id, ':pid' => $model->id]);
							if (empty($invoice)) {
								$invoice = new Invoice;
								$invoice->to_id = $agent->id;
								$invoice->consol_id = $consol->id;
								$invoice->pid = $model->id;
								$invoice->dpt_id = 106;
								$invoice->type = Invoice::INVOICE_TYPE_OTHERS;
								$invoice->dpmt = Invoice::DPMT_IMPORT;
								$invoice->currency = 1;
								if ($shipment->agent->by == 1) {
									$invoice->mdata['name'] = $agent->name;
									$invoice->mdata['address'] = $agent->getAddress();
									$invoice->mdata['payterm'] = empty($agent->extra['payterm']) ? 'COD' : $agent->extra['payterm'] . ' days';
								} else {
									$invoice->mdata['suborg'] = $shipment->agent;
									$invoice->mdata['name'] = $shipment->agent->name;
									$invoice->mdata['address'] = $shipment->agent->getAddress();
									$invoice->mdata['payterm'] = empty($shipment->agent->extra['payterm']) ? 'COD' : $shipment->agent->extra['payterm'] . ' days';
								}
								$invoice->date = date('Y-m-d');
								$invoice->due = Invoice::calcDue($invoice->date, $agent->extra['payterm']);
								$invoice->status = Invoice::INVOICE_STATUS_PENDING;
								$invoice->sync_xero = 0;
								$invoice->save();
							}

							// find invoice line or create invoice line
							$il = InvLine::model()->find('det = :det AND inv_id = :inv_id', [':det' => $line->desc, ':inv_id' => $invoice->id]);
							if (empty($il)) {
								$il = new InvLine;
								$il->inv_id = $invoice->id;
								if ($line->flag == BillingLine::BILLING_FLAG_MANUAL) {
									$il->ccode = 'Manual Handling Fee';
									$il->amount = 10;
									$il->qty = $shipment->pkg;
								} else if ($line->flag == BillingLine::BILLING_FLAG_SECOND) {
									$il->ccode = 'Second Delivery Fee';
									// $orgRate = OrgRate::model()->find('org_id = :oid AND type = 40', [':oid' => $agent->id]);
									// $il->amount = $shipment->getChargePro($agent, $orgRate, false) * 0.5;
									if (!empty($shipment->mdata['charge_client_amount'])) {
										$il->amount = floatval($shipment->mdata['charge_client_amount']) * 0.5;
									} else {
										$orgRate = OrgRate::model()->find('type = 40 and org_id = :oid', [':oid' => $shipment->agent_id]);
										$il->amount = floatval($shipment->getChargePro($shipment->agent, $orgRate, false)) * 0.5;
									}
									$il->qty = 1;
								}
								$il->det = $line->desc;
								if (!empty($agent->extra['incl_gst'])) {
									$il->tax = 'OUTPUT';
									$il->gst = $il->amount * 10 / 100;
									$il->amount += $il->gst;
								} else {
									$il->tax = 'EXEMPTOUTPUT';
									$il->gst = 0;
								}
								$il->fid = $consol->id;
								$il->model = $consol->getType();
								$il->save();

								$invoice->getTotal();
								$invoice->update('total');
							}

							$line->mdata['ot_inv'] = $invoice->id;
							$line->update('meta');
						}
					} else if (preg_match('/^T(\d{6,7})$/', $ref, $matches)) {
						$task = WmsTask::model()->findByPk($matches[1]);
						if (!empty($task)) {
							foreach ($lines as $line) {
								if (!in_array($line->flag, [BillingLine::BILLING_FLAG_MANUAL, BillingLine::BILLING_FLAG_SECOND])) continue;
								$shipment = null;
								if (preg_match('/(7RFZ\d{8}|4XHZ\d{8})/', $line->desc, $m)) {
									$shipment = $m[1];
									$shipment = Shipment::model()->find('ref = :ref', [':ref' => $shipment]);
								}
								if (empty($shipment)) {
									$shipment = explode('_', explode(' ', $line->desc)[2])[0];
									$shipment = Shipment::model()->find('ref = :ref', [':ref' => $shipment]);
								}
								if (empty($shipment)) {
									continue;
								}

								// find invoice or create invoice
								$agent = $shipment->agent->by == 1 ? $shipment->agent : $shipment->agent->owner;
								$invoice = Invoice::model()->find('to_id = :to_id AND consol_id = :consol_id AND pid = :pid AND status != 10', [':to_id' => $agent->id, ':consol_id' => $task->id, ':pid' => $model->id]);
								if (empty($invoice)) {
									$invoice = new Invoice;
									$invoice->to_id = $agent->id;
									$invoice->consol_id = $task->id;
									$invoice->pid = $model->id;
									$invoice->dpt_id = 106;
									$invoice->type = Invoice::INVOICE_TYPE_OTHERS;
									$invoice->dpmt = Invoice::DPMT_3PL;
									$invoice->currency = 1;
									if ($shipment->agent->by == 1) {
										$invoice->mdata['name'] = $agent->name;
										$invoice->mdata['address'] = $agent->getAddress();
										$invoice->mdata['payterm'] = empty($agent->extra['payterm']) ? 'COD' : $agent->extra['payterm'] . ' days';
									} else {
										$invoice->mdata['suborg'] = $shipment->agent;
										$invoice->mdata['name'] = $shipment->agent->name;
										$invoice->mdata['address'] = $shipment->agent->getAddress();
										$invoice->mdata['payterm'] = empty($shipment->agent->extra['payterm']) ? 'COD' : $shipment->agent->extra['payterm'] . ' days';
									}
									$invoice->date = date('Y-m-d');
									$invoice->due = Invoice::calcDue($invoice->date, $agent->extra['payterm']);
									$invoice->status = Invoice::INVOICE_STATUS_PENDING;
									$invoice->sync_xero = 0;
									$invoice->save();
								}

								// find invoice line or create invoice line
								$il = InvLine::model()->find('det = :det AND inv_id = :inv_id', [':det' => $line->desc, ':inv_id' => $invoice->id]);
								if (empty($il)) {
									$il = new InvLine;
									$il->inv_id = $invoice->id;
									if ($line->flag == BillingLine::BILLING_FLAG_MANUAL) {
										$il->ccode = 'Manual Handling Fee';
										$il->amount = 10;
										$il->qty = $shipment->pkg;
									} else if ($line->flag == BillingLine::BILLING_FLAG_SECOND) {
										$il->ccode = 'Second Delivery Fee';
										// $orgRate = OrgRate::model()->find('org_id = :oid AND type = 40', [':oid' => $agent->id]);
										// $il->amount = $shipment->getChargePro($agent, $orgRate, false) * 0.5;
										$chargecode = ImportChargeCode::STARTRACK_TNT_3PL;
										$chargeweight = isset($shipment->mdata['charge_client_weight']) ? $shipment->mdata['charge_client_weight'] : (isset($shipment->mdata['chargecode']) ? $shipment->chargeWeight() : $shipment->weight);
										$cost = $task->getChargeByChargecode($chargeweight, $shipment->postcode, $chargecode);
										$il->amount = $cost * 0.5;
										$il->qty = 1;
									}
									$il->det = $line->desc;
									if (!empty($agent->extra['incl_gst'])) {
										$il->tax = 'OUTPUT';
										$il->gst = $il->amount * 10 / 100;
										$il->amount += $il->gst;
									} else {
										$il->tax = 'EXEMPTOUTPUT';
										$il->gst = 0;
									}
									$il->fid = $task->id;
									$il->model = 'WmsInvoiceLine';
									$il->save();

									$invoice->getTotal();
									$invoice->update('total');
								}

								$line->mdata['ot_inv'] = $invoice->id;
								$line->update('meta');
							}
						}
					}
				}
			}
			$this->ajaxResult($model);
		}
	}

	public function actionOTInvoice2($id)
	{
		$model = $this->loadModel($id);
		if (empty($_POST)) {
			$this->render('ot_invoice2', ['billing' => $model]);
		} else {
			if (empty($_POST['selectedItems'])) {
				$model->addError('id', 'Please select lines');
				$this->ajaxResult($model);
			}

			$transaction = Yii::app()->db->beginTransaction();
			try {
				$orgRate = OrgRate::model()->find('type = 40 and org_id = :oid', [':oid' => Org::ORGID_SUPPLIER_GLOBAVEND]);
				$org = Org::model()->findByPk(Org::ORGID_SUPPLIER_GLOBAVEND);

				$consols = [];
				foreach ($_POST['selectedItems'] as $line) {
					$line = BillingLine::model()->findByPk($line);
					if (!empty($line->mdata['ot_inv'])) continue;

					$consol = $line->consol;
					foreach ($consol->shipments as $shipment) {
						$before = $shipment->getChargePro($org, $orgRate);
						$shipment->weight = $shipment->weight * $consol->mdata['awb_wt'] / $consol->totWeight();
						$after = $shipment->getChargePro($org, $orgRate);
						if ($after[0] <= $before[0]) continue;

						$consols[$line->billing_ref . '_' . $line->id][] = [$shipment, $after, $before];
					}
				}

				if (empty($consols)) {
					$model->addError('id', 'No invoice need to create');
					$this->ajaxResult($model);
				}

				foreach ($consols as $ref => $lines) {
					$consol = Consol::model()->find('no = :no', [':no' => explode('_', $ref)[0]]);
					foreach ($lines as $line) {
						$shipment = $line[0];

						// find invoice or create invoice
						$agent = $shipment->agent->by == 1 ? $shipment->agent : $shipment->agent->owner;
						$invoice = Invoice::model()->find('to_id = :to_id AND consol_id = :consol_id AND pid = :pid AND status != 10', [':to_id' => $agent->id, ':consol_id' => $consol->id, ':pid' => $model->id]);
						if (empty($invoice)) {
							$invoice = new Invoice;
							$invoice->to_id = $agent->id;
							$invoice->consol_id = $consol->id;
							$invoice->pid = $model->id;
							$invoice->dpt_id = 106;
							$invoice->type = Invoice::INVOICE_TYPE_OTHERS;
							$invoice->dpmt = Invoice::DPMT_IMPORT;
							$invoice->currency = 1;
							$invoice->mdata['name'] = $agent->name;
							$invoice->mdata['address'] = $agent->getAddress();
							$invoice->mdata['payterm'] = empty($agent->extra['payterm']) ? 'COD' : $agent->extra['payterm'] . ' days';
							$invoice->date = date('Y-m-d');
							$invoice->due = Invoice::calcDue($invoice->date, $agent->extra['payterm']);
							$invoice->status = Invoice::INVOICE_STATUS_PENDING;
							$invoice->sync_xero = 0;
							$invoice->save();
							if (!empty($invoice->getErrors())) yii::log(json_encode($invoice->getErrors()), 'warning');
						}

						// find invoice line or create invoice line
						$il = InvLine::model()->find('det = :det AND inv_id = :inv_id', [':det' => $shipment->ref, ':inv_id' => $invoice->id]);
						if (empty($il)) {
							$il = new Invoice;
							$il->inv_id = $invoice->id;
							$il->det = $shipment->ref . ' weight diff, was ' . $before[3] . 'kg, now ' . $after[3];
							if (!empty($agent->extra['incl_gst'])) {
								$il->tax = 'OUTPUT';
								$il->gst = $il->amount * 10 / 100;
								$il->amount += $il->gst;
							} else {
								$il->tax = 'EXEMPTOUTPUT';
								$il->gst = 0;
							}
							$il->fid = $shipment->id;
							$il->model = 'ImParcel';
							$il->save();
							if (!empty($il->getErrors())) yii::log(json_encode($il->getErrors()), 'warning');
						}
					}
					$invoice->getTotal();
					$invoice->update('total');

					$line = BillingLine::model()->findByPk(explode('_', $ref)[1]);
					$line->mdata['ot_inv'] = $invoice->id;
					$line->update('meta');
				}
				$transaction->commit();
			} catch (Exception $ex) {
				$transaction->rollback();
				throw $ex;
			}

			$this->ajaxResult($model);
		}
	}

	public function actionOTSetup($id)
	{
		if (empty($_POST)) {
			$xls = new oExcel;
			$xls->addRow(1, ['Shipment', 'Code (MHF / SDF)', 'Cost']);
			$xls->output('tnt_ot_template.xlsx');
		} else {
			$model = $this->loadModel($id);

			$file = empty($_FILES['file']) ? [] : $_FILES['file'];
			if (empty($file['tmp_name']) || !is_uploaded_file($file['tmp_name'])) {
				echo json_encode(['done' => false, 'msg' => 'Invalid template file']);
				Yii::app()->end();
			}

			$xls = new oExcel;
			$xls->load($file['tmp_name']);
			$data = $xls->getAll();
			unset($data[1]);

			$err = [];
			foreach ($data as $k => $line) {
				if (empty($line[1])) {
					break;
				}
				$shipment = ImParcel::model()->find('hbn = :r OR ref = :r', [':r' => $line[1]]);
				if (empty($shipment)) {
					$err[] = 'Shipment ' . $line[1] . ' not found in line ' . $k;
					continue;
				}
				$consol = $shipment->consol;

				if ($line[2] == 'MHF' || $line[2] == 'MHP') {
					$desc = 'Manual Handling ' . $shipment->ref;
				} else if ($line[2] == 'SDF' || $line[2] == 'RED') {
					$im_invoice = Invoice::model()->find('consol_id = :consol_id AND to_id = :org_id AND status NOT IN (8, 10) AND type = 10', [':consol_id' => $shipment->consol->id, ':org_id' => $shipment->agent_id]);
					if (empty($im_invoice) && !empty($shipment->agent->owner)) {
						$im_invoice = Invoice::model()->find('consol_id = :consol_id AND to_id = :org_id AND status NOT IN (8, 10) AND type = 10', [':consol_id' => $shipment->consol->id, ':org_id' => $shipment->agent->by]);
					}
					$orgRate = OrgRate::model()->find('org_id = :oid AND type = 40', [':oid' => $shipment->agent->id]);
					$desc = 'Second Delivery ' . $shipment->ref . ' ' . @$im_invoice->no . ' $' . number_format(round($shipment->getChargePro($shipment->agent, $orgRate, false) * 100) / 100, 2);
				} else {
					$err[] = 'Code is invalid in line ' . $k;
					continue;
				}

				$billing = BillingLine::model()->find('billing_cref = :cref AND `desc` = :desc', [':cref' => $model->billing_cref, ':desc' => $desc]);
				if (empty($billing)) {
					$billing = new BillingLine;
					$billing->billing_id = $model->id;
					$billing->status = 11;
					$billing->link_id = 0;
					$billing->org_id = $model->org_id;
					$billing->charge_code = Consol::AU_LOCAL_DELIVERY_COST_GL_CODE;
					$billing->billing_cref = $model->billing_cref;
					$billing->currency = 1;
					$billing->weight = 0;
					$billing->charge_weight = 0;
					if ($consol->owner_id != 114) {
						$billing->billing_ref = $consol->no;
						$billing->type = BillingLine::BILLING_TYPE_IMPORT;
						$billing->dpmt = Invoice::DPMT_IMPORT;
					} else {
						$billing->billing_ref = $shipment->cref;
						$billing->type = BillingLine::BILLING_TYPE_3PL;
						$billing->dpmt = Invoice::DPMT_3PL;
					}
					$billing->awb = $consol->awb;
					$billing->dpt_id = empty($consol->dpt_id) ? Org::PCAE_DEPARTMENT_SYDNEY : $consol->dpt_id;
					$billing->date = $model->date;
					$billing->created = $model->created;
					$billing->transaction_date = $model->transaction_date;
					$billing->due = $model->due;
					$billing->gst = 'INPUT';
					$billing->desc = $desc;
					$billing->accrual_amount = 0;
					if (preg_match('/manual handling/i', $billing->desc)) {
						$billing->flag = 2;
					} else if (preg_match('/second delivery/i', $billing->desc)) {
						$billing->flag = 1;
					}
				}
				$billing->actual_amount = $line[3];
				$billing->gst_amount = $billing->getGSTValue();
				$billing->save();
			}

			if (!empty($err)) {
				echo json_encode(['done' => false, 'msg' => implode('; ', $err)]);
				Yii::app()->end();
			} else {
				echo json_encode(['done' => true, 'msg' => 'Update successfully']);
				Yii::app()->end();
			}
		}
	}

	public function actionUpdateTNEAmount()
	{
		$af = AFInvoiceReconciliation::model()->findByPk($_GET['id']);
		if (empty($_POST)) {
			$this->render('update_tne_amount', ['model' => $af]);
		} else {
			$old_amount = $af->subtotal;
			$new_amount = $_POST['amount'];

			$af->subtotal = $_POST['amount'];
			$af->gst = $_POST['amount'] / 10;
			$af->total = $af->subtotal + $af->gst;
			$af->save();

			$afl = $af->lines[0];
			$afl->amount = $_POST['amount'];
			$afl->gst = $_POST['amount'] / 10;
			$afl->save();

			$bls = BillingLine::model()->findAll('JSON_VALUE(meta, "$.aline") = :aline', [':aline' => $afl->id]);
			foreach ($bls as $k => $bl) {
				if ($bl->actual_amount == $bl->accrual_amount || ($k != count($bls) - 1)) {
					continue;
				}
				$bl->actual_amount - $old_amount + $new_amount;
				$bl->getGSTValue();
				$bl->save();
			}

			$this->ajaxResult($af);
		}
	}

