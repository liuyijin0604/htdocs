	public function actionAjaxIFInvoiceImport()
	{
		Yii::app()->cache->delete('pid_'.md5(session_id().'ediInvoiceProgress'));

		$resp = array('success' => 1, 'msg' => 'Imported Successfully');
		if (isset($_FILES) && !empty($_FILES)) {
			$ap_file = empty($_FILES['af_file']) ? array() : $_FILES['af_file'];
			if (empty($ap_file['tmp_name']) || !is_uploaded_file($ap_file['tmp_name'])) {
				$resp['msg'] = 'Invalid template file';
				echo json_encode($resp);
				return;
			} else {
				$filename = $ap_file['name'];
				if (AFInvoiceReconciliationHistory::fileImportedBefore($filename)) {
					if (isset($_POST['overwrite']) && $_POST['overwrite'] == 1) {
						// if agree to overwrite the old one
						$afImportHistorys = AFInvoiceReconciliationHistory::model()->findAll('hash = :hash', [':hash' => md5($filename)]);
						// clear all old data
						foreach ($afImportHistorys as $afImportHistory) {
							$afImportHistory->invoice_total = 0;
							$afImportHistory->success = 0;
							$afImportHistory->failed = 0;
							$afImportHistory->update('invoice_total', 'success', 'failed');
							$oldInvoices = AFInvoiceReconciliation::model()->findAll('history_id = :hid', [':hid' => $afImportHistory->id]);
							foreach ($oldInvoices as $inv) {
								AFInvoiceReconciliationLine::model()->deleteAll('invoice_id = :iid', [':iid' => $inv->id]);
							}
						}
						AFInvoiceReconciliation::model()->deleteAll('history_id = :hid',[':hid' => $afImportHistory->id] );
					} else {
						$resp['msg'] = 'The file has been imported already, if you want to overwrite them , please tick overwrite checkbox and try again';
						echo json_encode($resp);
						return;
					}
				}

				$ext = pathinfo($filename, PATHINFO_EXTENSION);
				if (strtolower($ext) != 'xlsx' && strtolower($ext) != 'xls') {
					$resp['msg'] = 'Invalid template file please select .xlsx or .xls file';
					echo json_encode($resp);
					return;
				} else {
					$this->saveEdiInvoiceProgressFile(2, 'ready to load file');
					if (strtolower($ext) == 'xlsx') {
						$xls = new oExcel;
					} else if (strtolower($ext) == 'xls') {
						$xls = new oExcel('Excel5');
					}
					$xls->load($ap_file['tmp_name']);

					$this->saveEdiInvoiceProgressFile(5, 'file data uploaded');

					$sheetsArray = $xls->xls->getAllSheets();

					// normally one sheet for one invoice
					$invoiceCount = count($sheetsArray);
					$sheetCount = $invoiceCount;
					$sheetInvoicesFailed = array();
					if ($invoiceCount <= 0) {
						$resp['msg'] = 'No any valid invoice data found';
						echo json_encode($resp);
						return;
					}

					$data = array();
					foreach ($sheetsArray as $n => $sheet) {
						$data[] = $xls->getAll($sheet);
						unset($sheetsArray[$n]);
					}
					unset($xls);

					$this->saveEdiInvoiceProgressFile(8, 'file data loaded');

					$billings = array();
					$allItemsDesc = array(); // save all invoice related item description;
					$errors = array();
					$dates = [];

					$invoiceProcessedCount = 0;
					$sheetIndex = 1;

					// save a reconciliation history
					if (empty($afImportHistory)) {
						$afImportHistory = new AFInvoiceReconciliationHistory();
						$afImportHistory->hash = md5($filename);
						$afImportHistory->created = date('Y-m-d');
						$afImportHistory->op_id = Yii::app()->user->id;
					}
					$afImportHistory->attached_file_id = 0;
					$afImportHistory->invoice_total = 0;
					$afImportHistory->failed = 0;
					$afImportHistory->success = 0;
					$afImportHistory->save();
					$errs = $afImportHistory->getErrors();
					if (!empty($errs)) {
						$msg = '';
						foreach ($errs as $k => $e) {
							$msg .= implode(' ', $e);
						}
						$resp['msg'] = $msg;
						echo json_encode($resp);
						return;
					}

					// save imported billing file
					$attachedFileId = FileRepo::storeFile($ap_file['tmp_name'], $filename, 36, $afImportHistory->id);
					$afImportHistory->attached_file_id = $attachedFileId;
					$afImportHistory->update('attached_file_id');

					$invoiceCount = 0;
					foreach ($data as $k => $invoice) {
						if (count($invoice) <= 1) {
							$errors[] = 'Failed to get invoice data for sheet index: ' . $sheetIndex;
							$sheetInvoicesFailed[] = array('index' => $sheetIndex, 'error' => 'invalid data');
							$sheetIndex++;
							continue; // invalid one
						}
						$sheetIndex++;

						unset($invoice[1]);

						foreach ($invoice as $line) {
							$amount = number_format(round(floatval($line[2]) * 100) / 100, 2, '.', '');

							$af = new AFInvoiceReconciliation;
							$af->supplier_id = 964;
							$af->history_id = $afImportHistory->id;
							$af->invoice_no = '';
							$af->awb = $line[1];
							$af->date = date('Y-m-d', strtotime($line[3]));
							$af->due = date('Y-m-d', strtotime($line[3]));
							$af->created = date('Y-m-d');
							$af->subtotal = $amount;
							$af->gst = 0;
							$af->total = $amount;
							$af->matched_result = 0;
							$af->op = 0;
							$af->save();
							if ($af->getErrors()) {
								yii::log(json_encode($af->getErrors()), 'warning');
							}

							$afl = new AFInvoiceReconciliationLine;
							$afl->invoice_id = $af->id;
							$afl->desc = 'Air Insurance';
							$afl->gst = 0;
							$afl->glcode = 'GL53';
							$afl->amount = $amount;
							$afl->save();

							// begin to match the billing with HVLV system
							if ($this->matchIFInvoiceWithHvlv($af)) {
								$afImportHistory->success ++;
							} else {
								$afImportHistory->failed ++;
							}
						}

						// update eventually success and failed count
						if (!empty($sheetInvoicesFailed)) {
							$afImportHistory->meta = json_encode($sheetInvoicesFailed);
							$afImportHistory->save();
						} else {
							$afImportHistory->invoice_total = $afImportHistory->success + $afImportHistory->failed;
							$afImportHistory->update(['failed', 'success', 'invoice_total']);
						}

						$afImportHistory->mdata['insurance'] = true;
						$afImportHistory->save();

						// release memory in time
						unset($invoice);
						unset($data[$k]);
					}
				}
			}
		} else {
			$resp['success'] = 0;
			$resp['msg'] = 'Invalid billing file';
		}
		echo json_encode($resp);
	}

	public function matchIFInvoiceWithHvlv($af)
	{
		if (empty($af) || $af->matched_result == AFInvoiceReconciliation::MATCHED_RESULT_WRONG_REJECTED) {
			return false;
		}

		if (empty($af->awb)) {
			$af->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_WRONG_AWB_NOTFOUND;
			$af->update('matched_result');
			return false;
		} else {
			$awbNoDash = str_replace('-', '', explode('/', $af->awb)[0]);
			$dashAwb = substr($awbNoDash, 0, 3) . '-' . substr($awbNoDash, 3);

			$job = EdiJob::model()->find('awb like :awb1 OR awb like :awb2 OR no like :awb1 OR no like :awb2', [':awb1' => '%' . $awbNoDash . '%', ':awb2' => '%' . $dashAwb . '%']);
			if (!empty($job)) {
				unset($af->mdata['nt']);
				$af->model = 'EdiJob';
				$af->fid = $job->id;
				$af->op = $job->user_id;
				$af->save();
				$billinglines = BillingLine::model()->findAll('billing_ref = :bref AND item_code IN ("GL52","GL53") AND org_id in (964) AND billing_id = 0', [':bref' => $job->no]);
				// find match amount line
				foreach ($billinglines as $bl) {
					if (empty($bl->mdata['aline']) && $bl->accrual_amount == $af->subtotal) {
						$billingline = $bl;
						break;
					}
					$afline = AFInvoiceReconciliationLine::model()->findByPk($bl->mdata['aline']);
					if ((empty($afline) || $afline->id == $af->lines[0]->id) && $bl->accrual_amount == $af->subtotal) {
						$billingline = $bl;
						break;
					}
				}
				// find empty line
				if (empty($billingline)) {
					foreach ($billinglines as $bl) {
						if (empty($bl->mdata['aline'])) {
							$billingline = $bl;
							break;
						}
						$afline = AFInvoiceReconciliationLine::model()->findByPk($bl->mdata['aline']);
						if (empty($afline) || $afline->id == $af->lines[0]->id) {
							$billingline = $bl;
							break;
						}
					}
				}
				if (empty($billingline)) {
					$billingline = new BillingLine;
					$billingline->billing_id = 0;
					$billingline->org_id = 964;
					$billingline->created = date('Y-m-d');
					$billingline->type = 3;
					$billingline->dpmt = 30;
					$billingline->gst = 'EXEMPTEXPENSES';
					$billingline->status = 2;
					$billingline->billing_cref = '';
					$billingline->billing_ref = $job->no;
					$billingline->awb = $af->awb;
					$billingline->desc = 'Air Insurance';
					$billingline->qty = 0;
					$billingline->price = 0;
					$billingline->dpt_id = 106;
					$billingline->charge_code = 91010;
					$billingline->item_code = 'GL53';
				}
				if ($billingline->date == $af->history->created) {
					$billingline->date = $af->date;
				}
				if ($billingline->due == $af->history->created) {
					$billingline->due = $af->due;
				}
				if ($billingline->transaction_date == $af->history->created) {
					$billingline->transaction_date = $af->date;
				}
				$billingline->actual_amount = $af->subtotal;
				$billingline->currency = 3;
				$billingline->mdata['aline'] = $af->lines[0]->id;
				$billingline->status = 2;
				$billingline->save();

				// accrual currency is aud
				if ($billingline->accrual_amount > 0 && (($billingline->actual_amount / $billingline->accrual_amount) > 3)) {
					$currency = Currency::model()->find('type = 3 AND date = :date', [':date' => $billingline->date]);
					if (empty($currency)) {
						$from = date('Y-m-d', strtotime($billingline->date . ' - 3 day'));
						$to = date('Y-m-d', strtotime($billingline->date . ' + 3 day'));
						$currency = Currency::model()->find('type = 3 AND date > :from AND date < :to', [':from' => $from, ':to' => $to]);
					}
					if (!empty($currency)) {
						$billingline->accrual_amount = number_format($billingline->accrual_amount * $currency->currency, 2, '.', '');
						$billingline->price = number_format($billingline->price * $currency->currency, 3, '.', '');
						$billingline->save();
					}
				}

				if ($billingline->accrual_amount > 0 && ($billingline->actual_amount < ($billingline->accrual_amount * 1.02))) {
					$af->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_SUCCESS;
					$af->save();
					return true;
				}
				$af->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_WRONG_DIFF_TOOBIG;
				$af->mdata['nt'] = 'diff ' . number_format($billingline->actual_amount - $billingline->accrual_amount, 2) . ' greater than 2%';
				$af->save();
				return false;
			} else {
				$af->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_WRONG_AWB_NOTFOUND;
				$af->save();
				return false;
			}
		}
	}

	public function actionIFTemplate()
	{
		$xls = new oExcel;
		$xls->setColWidth([20,20,20]);
		$xls->addRow(1, ['提单号', '保险费(折人民币)', '生效日期']);
		$xls->output('air_insurance_excel_' . date('Y-m-d') . '.xlsx');
	}

	public function actionAfbUpdateInv($fid)
	{
		$model = AFInvoiceReconciliationHistory::model()->findByPk($fid);
		if (empty($_POST)) {
			$this->render('jqm_update_invoice', ['model' => $model]);
		} else {
			$aflines = [];
			foreach ($model->af as $af) {
				if (empty($af->invoice_no)) {
					$af->invoice_no = $_POST['inv'];
					$af->save();
				}

				$aflines[] = $af->lines[0]->id;
			}

			$billinglines = BillingLine::model()->findAll('JSON_VALUE(meta, "$.aline") IN (' . implode(',', $aflines) . ')');
			foreach ($billinglines as $billingline) {
				if (empty($billingline->billing_cref)) {
					$billingline->billing_cref = $_POST['inv'];
					$billingline->save();
				}
			}

			$this->ajaxResult($model);
		}
	}

	public function actionTneConfirm()
	{
		if (empty($_POST)) {
			$id = $_GET['afid'];
			$model = AFInvoiceReconciliation::model()->findByPk($id);
			$this->render('jqm_tne_confirm', array('model' => $model));
		} else {
			$id = $_GET['afid'];
			$model = AFInvoiceReconciliation::model()->findByPk($id);

			$bl = new BillingLine;
			$bl->billing_id = 0;
			$bl->org_id = 1133;
			$bl->op_id = Yii::app()->user->id;
			$bl->link_id = 0;
			$bl->to_id = 0;
			$bl->created = date('Y-m-d');
			$bl->date = $bl->created;
			$bl->due = $bl->created;
			$bl->transaction_date = $bl->created;
			$bl->dpmt = $_POST['dpmt'];
			if ($bl->dpmt == 1) {
				$bl->type = 6;
			} else {
				$bl->type = $bl->dpmt / 10;
			}
