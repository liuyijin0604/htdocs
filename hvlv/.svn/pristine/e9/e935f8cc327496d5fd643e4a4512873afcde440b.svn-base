	/**
	 * @param $id
	 */
	public function actionRejectAFInvoice($id)
	{
		$resp = array('done' => true, 'msg' => '');
		$model = AFInvoiceReconciliation::model()->findByPk($id);
		if (!empty($model)) {
			$model->matched_result = AFInvoiceReconciliation::MATCHED_RESULT_WRONG_REJECTED;
			$model->update('matched_result');

			if (in_array($model->supplier_id, [954, 964])) {
				$billing = Billing::model()->find('billing_cref = :billing_cref', [':billing_cref' => $model->invoice_no]);
				if (!empty($billing)) {
					$billing->status = 11;
					$billing->update('status');
				}
				$lines = BillingLine::model()->findAll('billing_cref = :billing_cref', [':billing_cref' => $model->invoice_no]);
				foreach ($lines as $line) {
					if ($line->accrual_amount > 0) {
						$line->actual_amount = 0;
						$line->billing_cref = '';
						$line->billing_id = 0;
						$line->status = 1;
						$line->update('actual_amount', 'billing_cref', 'billing_id', 'status');
					} else {
						$line->status = 11;
						$line->update('status');
					}
				}
				// not create billing yet
				// $billing->custom_log_note = 'Air Freight Invoice reject billing';
				// $billing->save();
			} else if (in_array($model->supplier_id, [1133]) && !empty($model->mdata['model'])) {
				foreach ($model->mdata['model'] as $job) {
					$job = EdiJob::model()->findByPk($job['id']);
					$lines = BillingLine::model()->findAll('billing_cref = :cref AND billing_ref = :ref', [':cref' => $model->invoice_no, ':ref' => $job->no]);
					foreach ($lines as $line) {
						if (!empty($line->mdata['aline']) && $line->mdata['aline'] == $model->lines[0]->id) {
							if ($line->accrual_amount > 0) {
								$line->actual_amount = 0;
								$line->billing_cref = '';
								$line->billing_id = 0;
								$line->status = 1;
								$line->update('actual_amount', 'billing_cref', 'billing_id', 'status');
							} else {
								$line->status = 11;
								$line->update('status');
							}
							if (!empty($line->billing)) {
								$line->billing->custom_log_note = 'Air Freight Invoice reject line';
								$line->billing->save();
							}
						}
					}
				}
			} else if (in_array($model->supplier_id, Org::$airports) && !empty($model->model)) {
				$consol = Consol::model()->findByPk($model->fid);
				$lines = BillingLine::model()->findAll('billing_cref = :cref AND billing_ref = :ref', [':cref' => $model->invoice_no, ':ref' => $consol->no]);
				foreach ($lines as $line) {
					if (!empty($line->mdata['af']) && $line->mdata['af'] == $model->id) {
						$line->status = 11;
						$line->update('status');
						if (!empty($line->billing)) {
							$line->billing->custom_log_note = 'Air Freight Invoice reject line';
							$line->billing->save();
						}
					}
				}
			}
		} else {
			$resp = array('done' => false, 'msg' => 'Invoice not found');
		}
		echo json_encode($resp);
	}

	/**
	 * @param $id
	 */
	public function actionAfbSyncXeroSuccessView($id)
	{
		// get all sync xero successful lines
		$allMatcheds = AFInvoiceReconciliation::model()->findAll('history_id = :hid AND matched_result = 1', [':hid' => $id]);
		// $history = AFInvoiceReconciliationHistory::model()->findByPk($id);
		// if (!empty($history->af[0]->supplier_id) && in_array($history->af[0]->supplier_id, Org::$brokers)) {
		// 	$allMatcheds = AFInvoiceReconciliation::model()->findAll('history_id = :hid', [':hid' => $id]);
		// }

		$lines = array();
		foreach ($allMatcheds as $line) {
			// check to see if sync with xero successfully
			// try to get all billing lines based on imported invoiced matched EdiJob or ExcoConsol
			if (empty($line->model)) {
				$bls = BillingLine::model()->findAll('billing_cref = :billing_cref AND status != 11', array(':billing_cref' => $line->invoice_no));
				if (!empty($bls)) {
					$flag = 1;
					foreach ($bls as $bl) {
						if ($bl->sync_xero != 1) {
							$flag = 0;
						}

					}
					if ($flag) {
						$lines[$line->id] = $line;
					}

				} else {
					$bill = Billing::model()->find('billing_cref = :billing_cref AND status != 11', array(':billing_cref' => $line->invoice_no));
					if (!empty($bill) && $bill->sync_xero == 1) {
						$lines[$line->id] = $line;
					}
				}
			} else {
				$r = new $line->model;
				$pModel = $r::model()->findByPk($line->fid);
				if (!empty($pModel)) {
					// only for not sync with xero billing lines
					$pBillingLines = BillingLine::model()->findAll('billing_cref = :bref AND sync_xero != 1 AND status != 11', [':bref' => $line->invoice_no]);
					if (empty($pBillingLines)) {
						$lines[$line->id] = $line;
					}
				}
			}
		}

		$data_provider = new CArrayDataProvider($lines, array(
			'id' => 'afb_syncxero_ok',
		));

		$this->render('afb_syncxero_success_view', ['datap' => $data_provider]);
	}

