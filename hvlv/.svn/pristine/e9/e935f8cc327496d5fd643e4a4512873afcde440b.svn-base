	public function actionReport()
	{
		$xls = new oExcel;
		$i = 1;

		switch ($_GET['type']) {
			case 'entry':
				$model = new Billing('search');
				$model->unsetAttributes();
				if (isset($_GET['Billing'])) {
					$model->attributes = $_GET['Billing'];
				}
				$dp = $model->search(false);
				$xls->setColWidth(array(20, 20, 20, 15, 15, 15, 15, 20, 20, 20));
				$xls->addRow($i++, array('No', 'Supplier', 'Invoice #', 'Total', 'Status', 'Currency', 'Branch', 'Created', 'Date', 'Due Date'));
				foreach ($dp->data as $r) {
					$xls->addRow($i++, array($r->no, (empty($r->org_id) || empty($r->cust)) ? "" : $r->cust->shortName(2), $r->billing_cref, $r->total, $r->getStatus(), $r->getCurrency(), $r->getDptName(), $r->created, $r->date, $r->due));
				}
				$xls->output('billing_export_overall_' . time() . '.xlsx');
				break;
			case 'air':
				$model = new BillingLine('search');
				$model->unsetAttributes();
				$model->setAttribute('type', BillingLine::BILLING_TYPE_AIR_SEA);
				if (isset($_GET['BillingLine'])) {
					$model->attributes = $_GET['BillingLine'];
				}
				$dp = $model->search(false);
				$xls->setColWidth(array(20, 20, 20, 20, 15, 15, 15, 15, 20, 20, 20, 20, 20, 20));
				$xls->addRow($i++, array('No', 'Job#', 'Invoice No.', 'Supplier', 'Status', 'Type', 'Currency', 'Dpt', 'Weight', 'Charge Weight', 'Date', 'Due', 'Accrual Amount', 'Actual Amount'));
				foreach ($dp->data as $r) {
					$xls->addRow($i++, array($r->no, $r->billing_ref, $r->billing_cref, (empty($r->org_id) || empty($r->cust)) ? "" : $r->cust->shortName(2), $r->getStatus(), $r->getType(), $r->getCurrency(), $r->getDptName(), $r->weight, $r->charge_weight, $r->date, $r->due, $r->accrual_amount, $r->actual_amount));
				}
				$xls->output('billingline_export_air_freight_' . time() . '.xlsx');
				break;
			case 'import':
				$model = new BillingLine('search');
				$model->unsetAttributes();
				$model->setAttribute('type', BillingLine::BILLING_TYPE_IMPORT);
				if (isset($_GET['BillingLine'])) {
					$model->attributes = $_GET['BillingLine'];
				}
				$dp = $model->search(false);
				$xls->setColWidth(array(20, 20, 20, 20, 20, 15, 15, 15, 15, 20, 20, 20, 20, 20, 20));
				$xls->addRow($i++, array('No', 'Console No.', 'AWB', 'Inovice No.', 'Supplier', 'Status', 'Type', 'Currency', 'Dpt', 'Weight', 'Charge Weight', 'Date', 'Due', 'Accrual Amount', 'Actual Amount'));
				foreach ($dp->data as $r) {
					$xls->addRow($i++, array($r->no, $r->billing_ref, $r->awb, $r->billing_cref, (empty($r->org_id) || empty($r->cust)) ? "" : $r->cust->shortName(2), $r->getStatus(), $r->getType(), $r->getCurrency(), $r->getDptName(), $r->weight, $r->charge_weight, $r->date, $r->due, $r->accrual_amount, $r->actual_amount));
				}
				$xls->output('billingline_export_import_' . time() . '.xlsx');
				break;
			case 'export':
				$model = new BillingLine('search');
				$model->unsetAttributes();
				$model->setAttribute('type', BillingLine::BILLING_TYPE_EXPORT);
				if (isset($_GET['BillingLine'])) {
					$model->attributes = $_GET['BillingLine'];
				}
				$dp = $model->search(false);
				$xls->setColWidth(array(20, 20, 20, 20, 20, 15, 15, 15, 15, 20, 20, 20, 20, 20, 20));
				$xls->addRow($i++, array('No', 'Console No.', 'AWB', 'Inovice No.', 'Supplier', 'Status', 'Type', 'Currency', 'Dpt', 'Weight', 'Charge Weight', 'Date', 'Due', 'Accrual Amount', 'Actual Amount'));
				foreach ($dp->data as $r) {
					$xls->addRow($i++, array($r->no, $r->billing_ref, $r->awb, $r->billing_cref, (empty($r->org_id) || empty($r->cust)) ? "" : $r->cust->shortName(2), $r->getStatus(), $r->getType(), $r->getCurrency(), $r->getDptName(), $r->weight, $r->charge_weight, $r->date, $r->due, $r->accrual_amount, $r->actual_amount));
				}
				$xls->output('billingline_export_export_' . time() . '.xlsx');
				break;
			case 'general':
				$model = new Billing('search');
				$model->unsetAttributes();
				$model->type = BillingLine::BILLING_TYPE_OTHERS;
				if (isset($_GET['Billing'])) {
					$model->attributes = $_GET['Billing'];
				}
				$dp = $model->search(false);
				$xls->setColWidth(array(20, 20, 20, 15, 15, 15, 15, 20, 20, 20));
				$xls->addRow($i++, array('No', 'Supplier', 'Invoice #', 'Total', 'Status', 'Currency', 'Branch', 'Created', 'Date', 'Due Date'));
				foreach ($dp->data as $r) {
					$xls->addRow($i++, array($r->no, (empty($r->org_id) || empty($r->cust)) ? "" : $r->cust->shortName(2), $r->billing_cref, $r->total, $r->getStatus(), $r->getCurrency(), $r->getDptName(), $r->created, $r->date, $r->due));
				}
				$xls->output('billing_export_generalcost_' . time() . '.xlsx');
				break;
			case 'rcvb':
				$model = new Billing('search');
				$model->unsetAttributes();
				$ec = new CDbCriteria;
				$ec->condition = "status in (3,5,7) AND date >= '2018-07-12'";
				if (!empty($_POST['agent_id'])) {
					$ec->condition .= ' AND org_id = ' . $_POST['agent_id'];
				}

				if (!empty($_POST['wid'])) {
					$ec->condition .= ' AND dpt_id = ' . $_POST['wid'];
				}

				if (!empty($_POST['date'])) {
					$ec->condition .= " AND date <= '" . $_POST['date'] . "'";
				}

				$dp = $model->search(false, 0, 't.due ASC', $ec);
				$cus = [];
				foreach ($dp->data as $r) {
					if (!empty($_POST['wid'])) {
						$cus[$r->dpt_id][$r->org_id][] = $r->no;
					} else {
						$cus[1][$r->org_id][] = $r->no;
					}
				}
				$sc = 0;
				if ($_POST['rptyp'] == 'aging') {
					$i = 1;
					$showCredits = !empty($_POST['wcredit']);

					if ($showCredits) {
						$allAtaPayment = PaymentBilling::getTotalAtaPaymentAmountList(date('Y-m-d'));
						$xls->addRow($i++, array('Supplier', 'Supplier ID', '7 Days', '15 Days', '30 Days', '60 Days', '90 Days', '> 90 Days', 'Credits', 'Total'));
						$xls->setColWidth(array(25, 10, 15, 15, 15, 15, 15, 15, 15, 20));
					} else {
						$xls->addRow($i++, array('Supplier', 'Supplier ID', '7 Days', '15 Days', '30 Days', '60 Days', '90 Days', '> 90 Days', 'Total'));
						$xls->setColWidth(array(25, 10, 15, 15, 15, 15, 15, 15, 20));
					}

					$data = [];
					foreach ($cus as $oid => $cs) {
						foreach ($cs as $cid => $rs) {
							if (!isset($data[$cid])) {
								$data[$cid] = ['', 0, 0, 0, 0, 0, 0, 0];
							}
							foreach ($rs as $r) {
								if (empty($data[$cid][0])) {
									$data[$cid][0] = @$r->cust->name;
								}

								$td = ceil((time() - strtotime($r->due)) / 86400);
								$bal = $r->getBalance();
								if ($td > 90) {
									$data[$cid][6] += $bal;
								} else if ($td > 60) {
									$data[$cid][5] += $bal;
								} else if ($td > 30) {
									$data[$cid][4] += $bal;
								} else if ($td > 15) {
									$data[$cid][3] += $bal;
								} else if ($td > 7) {
									$data[$cid][2] += $bal;
								} else {
									$data[$cid][1] += $bal;
								}
								$data[$cid][7] += $bal;
							}
						}
					}

					foreach ($data as $cid => $r) {
						if ($showCredits) {
							$alvPayamount = PaymentBilling::orgTotalAta($cid);
							$total = $r[7] - $alvPayamount;
							if ($alvPayamount > 0) {
								$alvPayamount = '-' . $alvPayamount;
							} else {
								$alvPayamount = '0';
							}

							$xls->addRow($i++, [$r[0], $cid, $r[1], $r[2], $r[3], $r[4], $r[5], $r[6], $alvPayamount, $total]);
							if (isset($allAtaPayment[$cid])) {
								unset($allAtaPayment[$cid]);
							}

						} else {
							$xls->addRow($i++, [$r[0], $cid, $r[1], $r[2], $r[3], $r[4], $r[5], $r[6], $r[7]]);
						}
					}

					if ($showCredits) {
						foreach ($allAtaPayment as $oid => $amount) {
							$org = Org::model()->findByPk($oid);
							$xls->addRow($i++, [$org->name, $oid, '', '', '', '', '', '', '', '-' . $amount]);
						}
					}

					$xls->output('debtor_aging_' . date('Ymd') . '.xlsx');
				}
				break;
			case 'accounting':
				$model = new BillingLine('search');
				$model->unsetAttributes();
				$model->setAttribute('status', 2);
				if (isset($_GET['BillingLine'])) {
					unset($_GET['BillingLine']['billing_total']);
					$model->attributes = $_GET['BillingLine'];
				}
				$dp = $model->search(false);
				$xls->addRow($i++, array('No', 'AWB', 'Invoice No.', 'Operator', 'Supplier', 'Desc', 'Currency', 'Dpt', 'Date', 'Actual Amount', 'GST'));
				foreach ($dp->data as $r) {
					$xls->addRow($i++, array($r->no, $r->awb, $r->billing_cref, ((empty($r->user) || empty($r->user->getName())) ? "" : $r->user->getName()), (empty($r->org_id) || empty($r->cust)) ? "" : $r->cust->shortName(2), $r->desc, $r->getCurrency(), $r->getDptName(), $r->date, $r->actual_amount, $r->gst, $r->billing->total + $r->billing->gst));
				}
				$xls->output('billingline_export_accounting_' . time() . '.xlsx');
				break;
		}
	}

	public function actionRcvb()
