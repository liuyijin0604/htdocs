	public function actionProgressReport()
	{

		// for agent report data model
		$data = array();

		// for mandy id : 347
		// for Jessie id : 503
		$data[] = array('id' => 1, 'type' => 'Accrual Missing',
			'import' => ImcoConsol::totAccrualMissing(),
			'export' => ExcoConsol::totAccrualMissing(),
			'3pl' => array('347' => EdiJob::tot3PLAccrualMissing(347), '503' => EdiJob::tot3PLAccrualMissing(503)),
			'freight' => array('347' => EdiJob::totAirSeaFreightAccrualMissing(347), '503' => EdiJob::totAirSeaFreightAccrualMissing(503)),
		);

		$data[] = array('id' => 2, 'type' => 'Actual Missing',
			'import' => BillingLine::totImportActualMissing(),
			'export' => BillingLine::totExportActualMissing(),
			'3pl' => BillingLine::tot3PLActualMissing(),
			'freight' => BillingLine::totAirSeaFreightMissing());

		$model = new CArrayDataProvider($data, array(
			'id' => 'op_progress_job',
		));

		// for accounting progress report
		$acdata = array();
		$acdata[] = array('id' => 1, 'type' => 'Pending in Hvlv',
			'import' => BillingLine::totAccoutingLinesByType(Invoice::DPMT_IMPORT),
			'export' => BillingLine::totAccoutingLinesByType(Invoice::DPMT_EXPORT),
			'3pl' => BillingLine::totAccoutingLinesByType(Invoice::DPMT_3PL),
			'freight' => BillingLine::totAccoutingLinesByType(Invoice::DPMT_AIRSEA));
		$acmodel = new CArrayDataProvider($acdata, array(
			'id' => 'accounting_progress_job',
		));
		$this->render('op_progress_report', ['model' => $model, 'acmodel' => $acmodel]);
	}

