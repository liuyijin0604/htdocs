	public function actionDisputeConfirmCost($id)
	{
		$model = ReconciliationLine::model()->find('id = :id', [':id' => $id]);
		if (empty($_POST)) {
			$this->render('dispute_confirm_cost', ['model' => $model]);
		} else {
			if (!empty($_POST['consol'])) {
				$consol = Consol::model()->find('no = :no OR awb = :no', [':no' => $_POST['consol']]);
				if (!empty($consol)) {
					$model->consol_id = $consol->id;
					$model->update('consol_id');
				} else {
					$model->addError('id', 'Consol is not found');
					$this->ajaxResult($model);
				}
			}
			if (!empty($_POST['amount']) && $_POST['amount'] <= number_format($model->value - $model->my_value, 2, '.', '')) {
				$model->mdata['amount'] = $_POST['amount'];
				$model->mdata['confirmed'] = true;
				$model->my_value = $_POST['amount'];
				$model->update('meta');
			} else {
				$model->addError('id', 'Amount exceeds diff');
				$this->ajaxResult($model);
			}

			if (number_format($model->mdata['amount'], 2, '.', '') != 0) {
				$billing = Billing::model()->find(['condition' => 'billing_cref LIKE :cref AND status != 11', 'params' => [':cref' => $model->invoice_no . '%'], 'order' => 'id DESC']);
				if (!empty($billing)) {
					$bl = BillingLine::copy($billing->lines[0]);
					$bl->desc = $model->shipment_no . ' ' . (!empty($_POST['code']) ? $_POST['code'] : 'Dispute Accept');
					$bl->billing_ref = $consol->no;
					$bl->billing_cref = $billing->status >= Billing::BILLING_STATUS_POSTED ? explode('-', $billing->billing_cref)[0] . '-' . (intval(explode('-', $billing->billing_cref)[1]) + 1) : $billing->billing_cref;
					$bl->actual_amount = number_format($model->mdata['amount'], 2, '.', '');
					$bl->accrual_amount = number_format($model->mdata['amount'], 2, '.', '');
					$bl->gst_amount = $bl->getGSTValue();
					$bl->save();

					if (!empty($model->shipment)) {
						$model->shipment->mdata['import_billing_id_dispute'] = $bl->id;
						$model->updateMeta();
					}
				}
			}
			$this->ajaxResult($model);
		}
	}

	public function actionSelectPay()
	{
		while (true) {
			try {
				$fp = fopen(Yii::app()->basePath.DIRECTORY_SEPARATOR.'runtime'.DIRECTORY_SEPARATOR.'system_lock'.DIRECTORY_SEPARATOR.'billing_select_pay.lock', 'r');
				flock($fp, LOCK_EX);

				if (!empty($_POST['id'])) {
					$selected = Yii::app()->cache->get('billing_streamline_selected_' . session_id()) ? Yii::app()->cache->get('billing_streamline_selected_' . session_id()) : [];
					if ($_POST['action'] == 'true') {
						$selected[$_POST['id']] = $_POST['amount'];
					} else {
						if (in_array($_POST['id'], array_keys($selected))) unset($selected[$_POST['id']]);
					}
					Yii::app()->cache->set('billing_streamline_selected_' . session_id(), $selected);
				}

				flock($fp, LOCK_UN);
				fclose($fp);
				break;
			} catch (Exception $ex) {
				throw $ex;
			}
		}

		echo json_encode(['done' => true, 'msg' => 'Select successfully']);
		Yii::app()->end();
	}

