	public function actionWidget($name){
		$vf = 'wid_'.$name;
		if(!Acl::hasAccess($this->CaName.'/'.$vf)) return false;
		if($this->getViewFile($vf.Yii::app()->user->grp) !== false){
			$this->render($vf.Yii::app()->user->grp);
		}else{
			$this->render($vf);
		}
	}
	
	public function actionSave(){
		if(!empty($_POST['data'])){
			$wids = array();
			foreach($_POST['data'] as $d){
				$id = $d['name'];
				unset($d['name']);
				$wids[$id] = $d;
			}
			$u = User::model()->findByPk(Yii::app()->user->id);
			$u->dash = $wids;
			$u->save();	
			$this->ajaxResult($u);
		}
	}
	
	/**
	 * Dashboard
	 */
	public function actionIndex(){
		$cols = array();
		$u = User::model()->findByPk(Yii::app()->user->id);
		if(!empty($u->dash)){
			$widgets = $u->dash;
			foreach(self::$widgets as $n=>$w){
				if(empty($widgets[$n])) $widgets[$n] = $w;
				$widgets[$n] = array_merge($w, $widgets[$n]);
			}
		}else{
			$widgets = self::$widgets;
		}
		//merge personal preference;
		foreach($widgets as $n=>$w){
			if(empty(self::$widgets[$n])||($u->dpmt&$w['dpmt'])==0) continue;
			$vf = 'wid_'.$n;
			if(!Acl::hasAccess($this->CaName.'/'.$vf)) continue;
			$cols[$w['col']][$n] = $w;
		}

		$i = 1;
		while($i < 4){
			if(!isset($cols[$i])) $cols[$i] = [];
			$i++;
		}

		$this->render('index', array('cols' => $cols));
	}
}