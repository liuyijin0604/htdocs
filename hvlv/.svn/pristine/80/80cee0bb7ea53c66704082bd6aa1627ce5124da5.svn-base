<?php 
class ImParcelService extends Service
{
    /**
     this service is moved from the gatepass createStorageInvoice function
     *
     * @param  [type] &$shipment [description]
     * @param  [type] $mid       [description]
     * @return [type]            [description]
     */
    public function createStorageInvoiceForDDP($shipment)
    {
        // check to see if related pending invoice existing
        $invoice =null; //Invoice::model()->find('type = :type AND status = :status AND to_id = :aid', array(':type' => Invoice::INVOICE_TYPE_STORAGE_FEE, ':status' => Invoice::INVOICE_STATUS_PENDING, ':aid' => $shipment->agent_id));
        $oldLines = array();
        $oldPayments = array(); 
        if(!empty($shipment->mdata['isOnceGenerated']))// if this function only be called once
        {
            return "";
        }

        if ( empty($invoice) ) {
              /*2019-05-23 gero add*/
            if(!empty($shipment->mdata['cargo_pickup']))//if it is pickup, the storage will be charged to the pickup client
            {
                return "";
            }

            $invoice=Invoice::model()->find(' type = :type and pid = :pid AND to_id = :aid and status !=:status',array(":type"=>Invoice::INVOICE_TYPE_STORAGE_FEE,":pid"=>$shipment->id,':aid' => $shipment->agent_id,':status' => Invoice::INVOICE_STATUS_CACELLED));
            if ( !empty($invoice) ) {
                return "storage invoice exist";
            }

            // not existing yet , just create a new one
            $invoice = new Invoice();
            $invoice->type = Invoice::INVOICE_TYPE_STORAGE_FEE; // for storage fee invoice
            $invoice->to_id = $shipment->agent_id;
            $invoice->man_id = 0; // in case manifest id means nothing
            $invoice->dpt_id = $shipment->ddpt_id;
            $invoice->dpmt = Invoice::DPMT_IMPORT;
            $invoice->pid = $shipment->id;
            // if department not set , we set as sydney warehouse
            if ( empty($invoice->dpt_id) ) {
                $invoice->dpt_id = Org::PCAE_DEPARTMENT_SYDNEY;
            }

            $invoice->status = Invoice::INVOICE_STATUS_PENDING;

            // get invoice currency
            $invoiceCurrency = 1; // default as AUD
            $orgRate = OrgRate::model()->find('org_id = :oid AND type = 40', [':oid' => $shipment->agent_id]);
            if (!empty($orgRate)) $invoiceCurrency = $orgRate['currency'];
            $invoice->currency = $invoiceCurrency;

            // set invoice name , address and pay terms information
            $owner = $shipment->agent;
            $invoice->mdata['name'] = $owner->name;
            $invoice->mdata['address'] = $owner->getAddress();
            $invoice->mdata['payterm'] = empty($owner->extra['payterm']) ? '2 days' : $owner->extra['payterm'] . ' days';

            // here just dummy date , once accounting change to posted , should create new date for the invoice
            $invoice->due = Invoice::calcDue($invoice->date, $invoice->mdata['payterm']);

        }

        $invoice->date = date('Y-m-d'); // here just dummy date , once accounting change to posted , should create new date for the invoice

        // calculate all price based on weight for the shipment
        $items = array();
        $rt = $shipment->getStorageFee();
        if ($rt[0] > 0) { // only save in case charge fee more than zero

            // we save charge days ,in and out date at the last two positions
            $items[] = array($shipment->consol->awb, $shipment->hbn, $shipment->getDesc(), $shipment->pkg, $shipment->weight, $shipment->cbm, $rt[0],$shipment->ref, 0, 0, $rt[1], $shipment->consol->eta, date('Y-m-d'));

            // save or update invoice

            // check org setting to see if storage has GST
            $gst = 0;
            $org = Org::model()->findByPk( $shipment->agent_id );
            if ( isset($org) && isset($org->extra['incl_gst']) ) {
                if ( $org->extra['incl_gst'] == 1 ) {
                    $gst = round($rt[0] * 10 / 100, 2);
                }
            }
            $invoice->total += $rt[0];
            $invoice->gst += $gst;
            $invoice->total += $gst;
            $invoice->save();

            // create related invoice line and attached it to the invoice
            $il = new InvLine;
            $il->inv_id = $invoice->id;
            $il->amount = $rt[0];
            $il->amount += $gst;
            $il->gst = $gst;
            $il->qty = 1;
            $il->mdata['items'] = $items;
            $il->model = 'ImParcel';
            $il->fid = $shipment->id;
            $il->save();
        }

        // add old lines if existing
        if ( !empty($oldLines) ) {
            foreach ( $oldLines as $line ) {
                $invoice->total += $line->amount;
                $invoice->gst += $line->gst;

                // create related invoice line and attached it to the invoice
                $il = new InvLine;
                $il->inv_id = $invoice->id;
                $il->amount = $line->amount;
                $il->gst = $line->gst;
                $il->qty = 1;
                $il->mdata['items'] = $line->mdata['items'];
                $il->model = 'Manifest';
                $il->fid = $line->fid;
                $il->save();
            }
            $invoice->save();
        }

        // apply previous payment if existing
        if ( !empty($oldPayments) ) {
            // apply old payments for the new created invoice
            $invoice->applyPayments($oldPayments);
        }
    }

    public function generateCargoProcessGatePass($id,$assignUser = false,$storage = true)
    {
        // create new gate pass
        $ids = explode(CargoProcess::IP_SEPERATOR,$id);
        $sqlIds = implode($ids,",");
        $fcpModel = CargoProcess::model()->findByPk($ids[0]);//first cargo process
        $dpt_id = empty($fcpModel->shipment->ddpt_id)?106:$fcpModel->shipment->ddpt_id;
        $userId = isset($fcpModel->mdata['assigned_user'])?$fcpModel->mdata['assigned_user']:0;
        $company ="";
        if($userId==0)
        {
            $company = @$fcpModel->driver->name;
        }else
        {
            $company = User::model()->findByPk($userId)->org->name;
        }
        $modelGatePass = new GatePass('create');
        $modelGatePass->dpt_id = $dpt_id;
        $modelGatePass->company = $company;
        if($fcpModel->type==CargoProcess::PICKUP_CARGO)
        {
            $modelGatePass->ref = "Pick Up";
        }else
        {
            $modelGatePass->ref = "truck delivery";
        }
        $modelGatePass->setAttribute('status', 60); // prepare means pending status
        $modelGatePass->save();

        $cpModels = CargoProcess::model()->findAll(" id in ({$sqlIds}) ");
        $shipmentIds = array_column($cpModels,'shipment_id');

        $this->createStorageInvoiceEachParcelWithoutStorage($modelGatePass,$shipmentIds,$cpModels,$storage);

        foreach ($cpModels as $key => $cpModel) {
            $cpModel->gate_pass_id = $modelGatePass->id;
            $cpModel->update('gate_pass_id');
        }
        return $modelGatePass;
    
    }

    public function generateCargoProcessGatePassByJob($id)
    {
        $job = CargoProcessJob::model()->findByPk($id);
        $dpt_id = $job->dpt_id;
        $company = $job->driver->name;
        $modelGatePass = new GatePass('create');
        $modelGatePass->dpt_id = $dpt_id;
        $modelGatePass->company = $company;
        if($job->type==CargoProcessJob::PICKUP_JOB)
        {
            $modelGatePass->ref = "Pick Up";
        }else
        {
            $modelGatePass->ref = "truck delivery";
        }
        $modelGatePass->setAttribute('status', 60); // prepare means pending status
        $modelGatePass->mdata['is_pickuplist'] =1;
        $modelGatePass->mdata['job_no'] =$job->job_no;
        $modelGatePass->mdata['job_name'] =$job->job_name;
        $modelGatePass->save();
        $cpModels = [];
        $jres = CargoProcessJobRelations::model()->findAll(['condition'=>'job_id = :jobId and active = 1','params'=>[":jobId"=>$job->id],'order'=>'sequence']);
        foreach ($jres as $key => $jre) {
             $cpModels[] = $jre->cargo_process;
        }
        $shipmentIds = array_column($cpModels,'shipment_id');

        $this->createStorageInvoiceEachParcelWithoutStorage($modelGatePass,$shipmentIds,$cpModels,false);

        $emailService = new EmailService();
        foreach ($cpModels as $key => $cpModel) {
            $cpModel->gate_pass_id = $modelGatePass->id;
            $cpModel->update('gate_pass_id');

            //Send Generate Pickup List SMS
            //$emailService->sendGeneratePickupListSmsEmail($cpModel);
        }

        $job->gate_pass_id = $modelGatePass->id;
        $job->save();
        return $modelGatePass;
    
    }
    
    private function createStorageInvoiceEachParcelWithoutStorage(&$modelGatePass,$sids,$cpModels = false,$storage = true)
    {
        if(!empty($cpModels))
        {
            foreach ($cpModels as $cpModel) {
                $p = $cpModel->shipment;
                $attr = array(
                    'mani_id' => $modelGatePass->id,
                    'fid' => $p->id,
                );
                if ($p->type == 10) {
                    $attr['model'] = 'ImParcel';
                    $p->man_id=$modelGatePass->id;
                    $p->update('man_id');
                } 
                $mm = new ManiMap;
                $mm->attributes = $attr;
                $mm->status = 10;
                $mm->mdata['cargo_process_id'] = $cpModel->id;
                if(!empty($cpModel->mdata['caref']))
                {
                    $mm->mdata['caref'] = $cpModel->mdata['caref'];
                    $mm->mdata['packages'] = $cpModel->mdata['left_packages'];
                }
                $mm->save();

                // create storage fee for the shipment
                if(empty($p->mdata['rts_org_no'])){
                    if(!empty($p->process)&&($p->bwf&ImParcel::CUSTOM_DDU)>0)  continue; //DDU storage invoice created in the custom prcoess and assign to consignee.
                }
            }
        }else
        {
            foreach ($sids as $id) {
                $p = Shipment::model()->findByPk($id);
                $attr = array(
                    'mani_id' => $modelGatePass->id,
                    'fid' => $id,
                );
                if ($p->type == 10) {
                    $attr['model'] = 'ImParcel';
                    $p->man_id=$modelGatePass->id;
                    $p->update('man_id');
                } elseif ($p->type == 20) {
                    $p = ExParcel::model()->findByPk($id);
                    if (!in_array($p->status, [14, 15, 18, 101, 102])) continue;
                    $attr['model'] = 'ExParcel';
                }
                $mm = new ManiMap;
                $mm->attributes = $attr;
                $mm->status = 10;
                $mm->save();

                // create storage fee for the shipment
                if(empty($p->mdata['rts_org_no'])){
                    if(!empty($p->process)&&($p->bwf&ImParcel::CUSTOM_DDU)>0)  continue; //DDU storage invoice created in the custom prcoess and assign to consignee.
                }
            }
        }
    }

    private function createStorageInvoiceEachParcel(&$modelGatePass,$sids,$cpModels = false,$storage = true)
    {
        if(!empty($cpModels))
        {
            foreach ($cpModels as $cpModel) {
                $p = $cpModel->shipment;
                $attr = array(
                    'mani_id' => $modelGatePass->id,
                    'fid' => $p->id,
                );
                if ($p->type == 10) {
                    $attr['model'] = 'ImParcel';
                    $p->man_id=$modelGatePass->id;
                    $p->update('man_id');
                } 
                $mm = new ManiMap;
                $mm->attributes = $attr;
                $mm->status = 10;
                $mm->mdata['cargo_process_id'] = $cpModel->id;
                if(!empty($cpModel->mdata['caref']))
                {
                    $mm->mdata['caref'] = $cpModel->mdata['caref'];
                    $mm->mdata['packages'] = $cpModel->mdata['left_packages'];
                }
                $mm->save();

                // create storage fee for the shipment
                if(empty($p->mdata['rts_org_no'])){
                    if(!empty($p->process)&&($p->bwf&ImParcel::CUSTOM_DDU)>0)  continue; //DDU storage invoice created in the custom prcoess and assign to consignee.
                    if($storage)
                    {
                        $this->createStorageInvoice($p, $modelGatePass->id);
                    }
                }
            }
        }else
        {
            foreach ($sids as $id) {
                $p = Shipment::model()->findByPk($id);
                $attr = array(
                    'mani_id' => $modelGatePass->id,
                    'fid' => $id,
                );
                if ($p->type == 10) {
                    $attr['model'] = 'ImParcel';
                    $p->man_id=$modelGatePass->id;
                    $p->update('man_id');
                } elseif ($p->type == 20) {
                    $p = ExParcel::model()->findByPk($id);
                    if (!in_array($p->status, [14, 15, 18, 101, 102])) continue;
                    $attr['model'] = 'ExParcel';
                }
                $mm = new ManiMap;
                $mm->attributes = $attr;
                $mm->status = 10;
                $mm->save();

                // create storage fee for the shipment
                if(empty($p->mdata['rts_org_no'])){
                    if(!empty($p->process)&&($p->bwf&ImParcel::CUSTOM_DDU)>0)  continue; //DDU storage invoice created in the custom prcoess and assign to consignee.
                    if($storage)
                    {
                        $this->createStorageInvoice($p, $modelGatePass->id);
                    }
                }
            }
        }
    }

        /**
     * create storage invoice for the client
     * we just push the storage fee into the related client storage invoice pending queue
     * if related pending invoice not existing just create a new one
     * @param $shipment
     * @param $mid - gatepass id
     */
    public function createStorageInvoice(&$shipment, $mid,$checkToDate="",$forceGenerate = false,$toId = null,$withClTime = true)
    {
        if($shipment->hasSubShipments())//||(!empty($shipment->consol)&&$shipment->consol->isWDT()))
        {
             return "mainShipments or subShipments don't need storage invoice";
        }

        // check to see if related pending invoice existing
        $invoice =null; //Invoice::model()->find('type = :type AND status = :status AND to_id = :aid', array(':type' => Invoice::INVOICE_TYPE_STORAGE_FEE, ':status' => Invoice::INVOICE_STATUS_PENDING, ':aid' => $shipment->agent_id));
        $oldLines = array();
        $oldPayments = array(); 
        if(!empty($shipment->mdata['isOnceGenerated'])&&!$forceGenerate)// if this function only be called once
        {
            return "";
        }

        if ( !empty($invoice) ) {
            if ( $invoice->isInvoiceClosed() ) {

                foreach ( $invoice->lines as  $line ) {
                    $oldLines[] = $line;
                }
                $oldPayments = $invoice->createCreditForMe();

                // save to old lines in order to update to the new storage invoice
                $invoice = null; // invoice has been frozen , we can't change it again
            }
        }

        if ( empty($invoice) ) {
              /*2019-05-23 gero add*/
            if(!empty($shipment->mdata['cargo_pickup'])&&!$forceGenerate)//if it is pickup, the storage will be charged to the pickup client
            {
                return "";
            }

            $invoice=Invoice::model()->find(' type = :type and pid = :pid AND to_id = :aid  and status !=:status',array(":type"=>Invoice::INVOICE_TYPE_STORAGE_FEE,":pid"=>$shipment->id,':aid' => $shipment->agent_id,':status' => Invoice::INVOICE_STATUS_CACELLED));
            if ( !empty($invoice) ) {
                return "storage invoice exist";
            }


            // not existing yet , just create a new one
            $invoice = new Invoice();
            $invoice->type = Invoice::INVOICE_TYPE_STORAGE_FEE; // for storage fee invoice
            if(!empty($toId))
            {
                $invoice->to_id = $toId;
            }else
            {
                $invoice->to_id = $shipment->agent_id;
            }
            $invoice->man_id = 0; // in case manifest id means nothing
            $invoice->dpt_id = $shipment->ddpt_id;
            $invoice->dpmt = Invoice::DPMT_IMPORT;
            $invoice->pid = $shipment->id;
            // if department not set , we set as sydney warehouse
            if ( empty($invoice->dpt_id) ) {
                $invoice->dpt_id = Org::PCAE_DEPARTMENT_SYDNEY;
            }
             $invoice->status = Invoice::INVOICE_STATUS_PENDING; // set as pending which means will send to client for paying via email at night

            // $invoice->status = Invoice::INVOICE_STATUS_PENDING;

            // get invoice currency
            $invoiceCurrency = 1; // default as AUD
            $orgRate = OrgRate::model()->find('org_id = :oid AND type = 40', [':oid' => $shipment->agent_id]);
            if (!empty($orgRate)) $invoiceCurrency = $orgRate['currency'];
            $invoice->currency = $invoiceCurrency;

            // set invoice name , address and pay terms information
            if(!empty($toId))
            {
                $owner = Org::model()->findByPk($toId);
            }else
            {
                $owner = $shipment->agent;
            }

            $invoice->mdata['name'] = $owner->name;
            $invoice->mdata['address'] = $owner->getAddress();
            $invoice->mdata['payterm'] = empty($owner->extra['payterm']) ? '2 days' : $owner->extra['payterm'] . ' days';

            // here just dummy date , once accounting change to posted , should create new date for the invoice
            $invoice->due = Invoice::calcDue($invoice->date, $invoice->mdata['payterm']);

        }

        $invoice->date = date('Y-m-d'); // here just dummy date , once accounting change to posted , should create new date for the invoice
        // calculate all price based on weight for the shipment
        $items = array();
        $rt = $shipment->getStorageFee(false,$checkToDate,$withClTime);
        if ($rt[0] > 0) { // only save in case charge fee more than zero

            // we save charge days ,in and out date at the last two positions
            $items[] = array($shipment->consol->awb, $shipment->hbn, $shipment->getDesc(), $shipment->pkg, $shipment->weight, $shipment->cbm, $rt[0],$shipment->ref, 0, 0, $rt[1], $rt[2], (empty($checkToDate)?date('Y-m-d'):$checkToDate));

            // save or update invoice

            // check org setting to see if storage has GST
            $gst = 0;
            $org = Org::model()->findByPk( $shipment->agent_id );
            if ( isset($org) && isset($org->extra['incl_gst']) ) {
                if ( $org->extra['incl_gst'] == 1 ) {
                    $gst = round($rt[0] * 10 / 100, 2);
                }
            }
            $invoice->total += $rt[0];
            $invoice->gst += $gst;
            $invoice->total += $gst;
            $invoice->save();

            // create related invoice line and attached it to the invoice
            $il = new InvLine;
            $il->inv_id = $invoice->id;
            $il->amount = $rt[0];
            $il->amount += $gst;
            $il->gst = $gst;
            $il->qty = 1;
            $il->mdata['items'] = $items;
            $il->model = 'Manifest';
            $il->fid = $mid;
            $il->save();
        }

        // add old lines if existing
        if ( !empty($oldLines) ) {
            foreach ( $oldLines as $line ) {
                $invoice->total += $line->amount;
                $invoice->gst += $line->gst;

                // create related invoice line and attached it to the invoice
                $il = new InvLine;
                $il->inv_id = $invoice->id;
                $il->amount = $line->amount;
                $il->gst = $line->gst;
                $il->qty = 1;
                $il->mdata['items'] = $line->mdata['items'];
                $il->model = 'Manifest';
                $il->fid = $line->fid;
                $il->save();
            }
            $invoice->save();
        }

        // apply previous payment if existing
        if ( !empty($oldPayments) ) {
            // apply old payments for the new created invoice
            $invoice->applyPayments($oldPayments);
        }

        return $invoice;
    }

    public static function getTimePoint(&$p,$type)
    {
        $myTracks = $p->trackingInfo(0,false,false,true);
        $p->myTracks = $myTracks;
        if(!empty($p->myTracks->tracks))
        {
            foreach ($p->myTracks->tracks as $key => $track) {

                if($type==1 && preg_match('/^(Deconsolidation has been done, waiting for despatch)|(Waiting for depatch)/',trim($track[0])))
                {
                    return $track[2];
                }
                 if($type==2 && $track[3]==Tracking::$status[68])
                {
                    return $track[2];
                }
                 if($type==3 && $track[3]==Tracking::$status[69])
                {
                    return $track[2];
                }
                if($type==4 && $track[3]==Tracking::$status[90])
                {
                    return $track[2];
                }
                 if($type==5 && ($key+1) == count($p->myTracks->tracks))
                {
                    return [$track[0],$track[2]];
                }
                if($type==6 && $track[3]==Tracking::$status[55])
                {
                    $pa = explode(' ', trim($track[2]));
                    $pa2=explode('/', $pa[0]);
                    return $pa2[2]."-".$pa2[1]."-".$pa2[0]." ".$pa[1];
                }
            }
        }
        return "";

    }

    public static function saveShipmentIntoLocation($location,$p,$sn,$barcode,$tempWareHouse)
    {
        if(!empty($p))
        {
            $rack = WmsLocation::model()->find("wid =:wid and code = :code",[":wid"=>$tempWareHouse,":code"=>$location]);
            if(empty($rack))
            {
                $rack = new WmsLocation('create');
                $rack->wid = $tempWareHouse;
                $rack->type = WmsLocation::CREATED_PALLET;
                $rack->name = $location;
                $rack->code = $location;
                $rack->save();
            }
            $record = null;
            $record = WmsRackShipment::model()->find("shipment_id = :shipment_id and sno=:sn and barcode=:barcode",[":shipment_id"=>$p->id,":sn"=>$sn,":barcode"=>$barcode]);
            
            if(!empty($record))
            {

                $record->status=WmsRackShipment::REMOVED;
                $record->save();
            }

            $record = new WmsRackShipment('create');
            $record->shipment_id = $p->id;
            $record->sno = $sn;
            $record->sum = 1;
            $record->rack_id = $rack->id;
            $record->barcode = $barcode;
            $record->user_id = User::CurrentUserID();
            $record->save();
        }

    }

    public static function getShipmentFromLocation($location,$tempWareHouse)
    {
        $rack = WmsLocation::model()->find("wid =:wid and (code = :code or name=:code)",[":wid"=>$tempWareHouse,":code"=>$location]);
        if(empty($rack))
        {
          return [];
        }
        $records = [];
        $records = WmsRackShipment::model()->findAll("rack_id = :rackId",[":rackId"=>$rack->id]);
        if(!empty($records))
        {
            $results = [];
            foreach ($records as $key => $re)
            {
                $p = ImParcel::model()->findByPk($re->shipment_id);
                if(!empty($p)&&$p->status<ImParcel::DELIVERED)
                {
                    $results[] = ["shipment"=>$p,"sno"=>$re->sno];
                }
            }

            return $results;
        }else
        {
           return [];
        }

    }

    public static function locationMarkScanned($location,$tempWareHouse,$scanned = true)
    {
            if($scanned)
            {
                    $rack = WmsLocation::model()->find("wid =:wid and (code = :code or name=:code)",[":wid"=>$tempWareHouse,":code"=>$location]);
                    if(!empty($rack))
                    {
                        $rs = WmsRackShipment::model()->with('shipment')->findAll("rack_id=:rack_id and isScanned = 0 and shipment.status<=90",["rack_id"=>$rack->id]);
                        foreach ($rs as $key => $r) {
                            $r->isScanned = 1;
                            $r->save();
                        }

                        if(!empty($rs))
                        {
                            ShipmentScan::genPalletScan($rack, ShipmentScan::PALLET_TYPE, $tempWareHouse,3600);
                        }
                    }
            }else
            {
                $rack = WmsLocation::model()->find("wid =:wid and (code = :code or name=:code)",[":wid"=>$tempWareHouse,":code"=>$location]);
                if(!empty($rack))
                {
                    $rs = WmsRackShipment::model()->with('shipment')->findAll("rack_id=:rack_id and isScanned = 1 and shipment.status<90",["rack_id"=>$rack->id]);
                    foreach ($rs as $key => $r) {
                      $r->isScanned = 0;
                      $r->save();
                    }
                    if(!empty($rs))
                    {
                        ShipmentScan::genPalletScan($rack, ShipmentScan::PALLET_CHECK_TYPE, $tempWareHouse,3600);
                    }
                }
            }

    }

    public static function shipmentMarkScanned($p,$tempWareHouse,$scanned = true)
    {
            if($scanned)
            {
                $groundLabels = [];
                $palletIds = [];
                    $rs = WmsRackShipment::model()->with('shipment')->findAll("shipment_id=:shipment_id and isScanned = 0 and shipment.status<=90",["shipment_id"=>$p->id]);
                    foreach ($rs as $key => $r) {
                        $r->isScanned = 1;
                        $r->save();
                        $pallet = WmsLocation::model()->findByPk($r->rack_id);
                        $palletIds[$r->rack_id] = $r->rack_id;
                    }
                    // first lets check whether this pallet still have other parcels
                    foreach ($palletIds as $key => $palletId)
                    {
                        WarehouseProcessService::checkLocationUsage($palletId);
                    }
            }else
            {
                $rs = WmsRackShipment::model()->with('shipment')->findAll("shipment_id=:shipment_id and isScanned = 1 and shipment.status<90",["shipment_id"=>$p->id]);
                 foreach ($rs as $key => $r) {
                     $r->isScanned = 0;
                     $r->save();
                 }
            }

    }

    public static function moveShipmentBetweenLocations($location1,$location2,$tempWareHouse)
    {
        $check = false;
        $rackFrom = WmsLocation::model()->find("wid =:wid and (code = :code or name=:code)",[":wid"=>$tempWareHouse,":code"=>$location1]);

        $rackTo = WmsLocation::model()->find("wid =:wid and (code = :code or name=:code)",[":wid"=>$tempWareHouse,":code"=>$location2]);
        if(!empty($rackFrom)&&!empty($rackTo))
        {
            $rs = WmsRackShipment::model()->with('shipment')->findAll("rack_id=:rack_id and isScanned = 0 and shipment.status<90",["rack_id"=>$rackFrom->id]);
            foreach ($rs as $key => $r) {
                $r->rack_id = $rackTo->id;
                $r->save();
                $check = true;
            }
        }

        return $check;

    }
    
    public function changeLabel($file,$courierId)
    {
       $data = $this->getFileData($file);
       if(empty($data))
       {
        return $this->getResult(1," empty file");
       }
       $data = $data[0];
       unset($data[1]);
       $rawData = $data;
       $hbnArray = [];
       foreach ($rawData as $key => $d) {
        if(!empty($d[1]))
        {
           $hbnArray[] = $d[1];
        }
       }
       return $this->funcChangeLabel($hbnArray,$courierId);
    }

    public function funcChangeLabel($hbnArray,$courierId)
    {
        $hbns = join("','",$hbnArray);
        if (empty($hbns)) return $this->getResult(1," empty hbn 0 done");
        $shipments = ImParcel::model()->findAll("hbn in ('{$hbns}') and json_value(meta,'is_change_label') is null");
        $count = 0;
        foreach ($shipments as $r) {
            $count++;
            $l = new ChangeShipmentLabel;
            $l->pid = $r->id;
            $l->pref = $r->ref;
            $l->phbn = $r->hbn;

            $courier = OrgRate::model()->findByPk($courierId);

            $r->can = $r->can.$r->ref;
            $r->mdata['is_change_label'] = 1;
            $r->save();
            $r->ref = '';
            $r->createCourierLabel($courier);
            $l->newref = $r->ref;
            $l->save();
        }
        $count;

        $courier = OrgRate::model()->findByPk($courierId);
        $imConsolService = new ImConsolService();
        if($courier->org_id == Org::ORGID_COURIER_DFE_TOP)
        {
            $rs = ImParcel::model()->findAll("hbn in ('{$hbns}') and json_value(meta,'is_change_label') = 1");
            $imConsolService->doDfeManifest($rs);
            return $this->getResult(1,$count." done");
        }

        return $this->getResult(1," no courier selected");
    }

    public static function cancelThirdPartyShipment($shipment)
    {
        if(empty($shipment->mdata['third_party_cancel_status']))
        {
            if(!empty($shipment->mdata['eiz']))
            {
                $alliedAPI = new EizAPI('syd');
                $result = $alliedAPI->cancelShipment([$shipment]);
                if($result->result==true)
                {
                    $shipment->mdata['third_party_cancel_status'] = 1;
                    $shipment->updateMeta();
                }
            }
        }
    }

    public function getImparcelLabel($shipments,$sn = 0,$type = false)
    {
        foreach ($shipments as $key => $model) {
            if(empty($model->mdata['org_rate_id'])) continue;
            if($this->isOtherLabel($model))
            {
                $orgRate=OrgRate::model()->findByPk($model->mdata['org_rate_id']);
                if(preg_match('/MYTOLL/i', $orgRate->code))
                {
                    if(preg_match('/PLT/i', $orgRate->code))
                    {
                        return self::generateMyTollPLTLabel($model,$type,$sn);
                    }

                    return self::generateMyTollLabel($model,$type,$sn);
                }
                
                if(preg_match('/MYBORDER/i', $orgRate->code))
                {
                    return self::generateMyBorderLabel($model,$type,$sn);
                }

                if(preg_match('/UBI_TOLL/i', $orgRate->code))
                {
                    return self::generateUbiTollLabel($model,$type,$sn);
                }

                if(preg_match('/UBI_BORDER/i', $orgRate->code))
                {
                    return self::generateUbiBorderLabel($model,$type,$sn);
                }

                
                if(preg_match('/AUK_TOLL/i', $orgRate->code))
                {
                    return self::generateAukTollLabel($model,$type,$sn);
                }

                if(preg_match('/F&L_HUNTER/',$orgRate->code)){
                    return self::generateLFHunterLabel($model,$type,$sn);
                }


                if(preg_match('/EIZ_/i', $orgRate->code)&&!empty($model->mdata['eiz_id']))
                {
                    // foreach ($model->mdata['eiz']['label'] as $key => $l) {
                    //     $f = tempnam(Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR."temp".DIRECTORY_SEPARATOR, 'pp');
                    //     file_put_contents($f, file_get_contents($l['url']));
                    //     $ps[] = $f;
                    // }
                    // oPDF::mergePDF($ps, 1, true, 'label.pdf');
                    if(!empty($model->mdata['eiz_id']))
                    {
                        if(preg_match('/TOLL/i',$orgRate->code))
                        {
                            return self::generateEizTollLabel($model,$type,$sn);
                        }elseif(preg_match('/allied/i',$orgRate->code))
                        {
                            return self::generateEizAlliedLabel($model,$type,$sn);
                        }elseif(preg_match('/border/i',$orgRate->code))
                        {
                            return self::generateEizBorderLabel($model,$type,$sn);
                        }
                    }
                    return;
                }
            }
        }

        oPDF::renderPDF('label_A6', ['tpl' => '_label-eparcel', 'empty' => false,'rs' => $shipments,'sn'=>$sn],1);
    }

    public static function isOtherLabel($model)
    {
        if(empty($model->mdata['org_rate_id'])) return false;

        $orgRate=OrgRate::model()->findByPk($model->mdata['org_rate_id']);
        if(preg_match('/MYTOLL|UBI_TOLL|UBI_BORDER|EIZ_|AUK_TOLL|MYBORDER|F&L_HUNTER/i', $orgRate->code))
        {
            return true;
        }else
        {
            return false;
        }
        return false;
    }

    public static function getEizLabel($model)
    {
        if(self::isOtherLabel($model))
        {
            $orgRate=OrgRate::model()->findByPk($model->mdata['org_rate_id']);
            if(preg_match('/EIZ_/i', $orgRate->code))
            {
                if(!empty($model->mdata['eiz_id']))
                {
                    if(preg_match('/TOLL/i',$orgRate->code))
                    {
                        return self::generateEizTollLabel($model,true);
                    }elseif(preg_match('/allied/i',$orgRate->code))
                    {
                        return self::generateEizAlliedLabel($model,true);
                    }elseif(preg_match('/border/i',$orgRate->code))
                    {
                        return self::generateEizBorderLabel($model,true);
                    }
                }
            }
            if(preg_match('/UBI_TOLL/i', $orgRate->code))
            {
                return self::generateUbiTollLabel($model,true);
            }
            
            if(preg_match('/UBI_BORDER/i', $orgRate->code))
            {
                return self::generateUbiBorderLabel($model,true);
            }

            if(preg_match('/MYTOLL/i', $orgRate->code))
            {
                if(preg_match('/PLT/i', $orgRate->code))
                {
                    return self::generateMyTollPLTLabel($model,true);
                }

                return self::generateMyTollLabel($model,true);
            }

            if(preg_match('/MYBORDER/i', $orgRate->code))
            {
                return self::generateMyBorderLabel($model,true);
            }

            if(preg_match('/AUK_TOLL/i', $orgRate->code))
            {
                return self::generateAUKTollLabel($model,true);
            }

            if(preg_match('/F&L_HUNTER/',$orgRate->code)){
               return self::generateLFHunterLabel($model,true);
            }

        }

        return null;
    }

    public function getImparcelLabelAllied($shipments,$customerPrint,$sn = 0,$type = false)
    {
        foreach ($shipments as $key => $model) {
            
            if($customerPrint==1){
                return self::generateEizAlliedLabelTPL($model,$type,$sn);
            }
            else{
                if(!empty($model->mdata['eiz']))
                {
                    return self::generateEizAlliedLabel($model,$type,$sn);
                }
                oPDF::renderPDF('label_A6', ['tpl' => '_label-eparcel', 'empty' => false,'rs' => $shipments,'sn'=>$sn],1);
            }
        }
        oPDF::renderPDF('label_A6', ['tpl' => '_label-eparcel', 'empty' => false,'rs' => $shipments,'sn'=>$sn],1);
    }

    public static function generateUbiBorderLabel($model,$tp=false,$sn = 0)
    {
        Yii::import('application.libs.tcpdf.tcpdf_barcodes_1d', true);
        Yii::import('application.libs.tcpdf.tcpdf_barcodes_2d', true);
        Yii::import('application.libs.tcpdf.tcpdf', true);
        $settings = ['payor_account'=>'80518651','serviceDescription'=>'B2C','serviceCode'=>'004'];
        $connote = $model->ref;
        
        $payor = $settings['payor_account'];
        $ps = [];
        $items = [];
        $barcodes = $model->mdata['barcode'];
        $barcodes = explode(',', $barcodes);
        $total_count = count($barcodes);
        $header = $model->mdata['borderLabelTags'];
        $sequence = 0;

        $etowerAPI = EtowerAPI::getAPIInstance($model->mdata['org_rate_id']);
        $RouteCode = BorderAPI::getBorderRouteCode($model);
        $phone = $model->cnee->tel;

        $phone = preg_replace("/[^0-9]/", "", $phone);

        $phone = sprintf("%010d", $phone);

        $desp = date('d/m/Y');
        $receiver_name = $model->cnee->name;
        $receiver_street1 = $model->cnee->address;
        $receiver_street2 = '';
        $receiver_suburb = $model->cnee->suburb;
        $receiver_postcode = $model->cnee->postcode;
        $receiver_state = $model->cnee->state;
        $receiver_phone = $phone;
        $receiver_contact = $model->cnee->name;
        $prepareData = $etowerAPI->prepareData($model,false,$etowerAPI->serviceCode);

        $sender_name = $prepareData->returnName;
        $sender_suburb_state = $prepareData->returnCity ." ".$prepareData->returnState;
        $sender_country = $prepareData->returnCountry;
        $sender_postcode = $prepareData->returnPostcode;
        $sender_phone = $prepareData->shipperPhone;
        $sender_contact = $prepareData->returnName;
        $shippingMethodCode = 'Road express';
        $description_detail = ' ';
        $declaration_person = $prepareData->recipientName;
        $dangerous_good_declarartion = 'I hereby declare that this consingment does not contain dangerous goods';
        $ref = $model->hbn;
        $instruction = '';

        $item_number = 0;

        $volumn = 0;

        $result = [];

        $items = [];

        $mitems = $etowerAPI->getBorderItems($model);
        $kk = 0;
        foreach ($mitems as $key => $item) {
            $refCSLocation = '';
            $refCSSku = '';
            $refCSSkuQty = '';

            $volumn = $item->width * $item->length * $item->height / 1000;

            $item_weight = sprintf("%06d", round($item->weight, 1) * 10);

            $srg = 'N';
            $nsr = 'N';
 
            if ($settings['serviceDescription'] == "B2C"){
                $receiver = "R";
                $adp = 'Y';
            } else {
                $receiver = "B";
                $adp = 'N';
            }
            $item_number += $item->qty;
            $items[] = ['trackingNumber'=>$barcodes[$key]];
        }
           
        $ii = json_encode($items);
        $items = json_decode($ii);

        foreach ($items as $itemkey => $item) {
            $sequence++;
            if($sn!=0 && $itemkey!=($sn-1)) continue;

            $pdf = new \TCPDF(PDF_PAGE_ORIENTATION, PDF_UNIT, 'A6', true, 'UTF-8', false);
            $pdf->setPrintHeader(false);
            $pdf->setPrintFooter(false);

            $pdf->SetDefaultMonospacedFont(PDF_FONT_MONOSPACED);

            $pdf->SetMargins(PDF_MARGIN_LEFT, PDF_MARGIN_TOP, PDF_MARGIN_RIGHT);

            $pdf->SetAutoPageBreak(false, PDF_MARGIN_BOTTOM);

            $pdf->setImageScale(PDF_IMAGE_SCALE_RATIO);

            $pdf->SetFont('verdana', '', 10, '', true);

            $pdf->AddPage('P', '', false, false);
            $toll = '<div style="font-size:13px;font-weight:bold;border:1px solid #000;line-height:530px;">&nbsp;</div>';
            $pdf->writeHTMLCell(103, 100, 1,2, $toll, false, 0, 0, '', true);

            $toll = '<div style="font-size:11px;font-weight:bold;">' . "Carrier:" . '</div>';
            $pdf->writeHTMLCell(30, 4, 8, 2.3, $toll, false, 0, 0, '', true);
            
            $toll = '<div style="font-size:11px；font-weight:bold;">' . "Border Express" . '</div>';
            $pdf->writeHTMLCell(40, 4, 2.1, 6.5, $toll, false, 0, 0, '', true);

            $indicator = '<div style="font-family:Verdana;font-size:20px;font-weight: bold;color: white;text-align: center;line-height:28px;">' . $header[0] . '</div>';
            $pdf->writeHTMLCell(25, 9.1, 28, 2.3, $indicator, 1, 0, 1, '', 0);
            $indicator = '<div style="font-family:Verdana;font-size:20px;font-weight: bold;color: white;text-align: center;line-height:28px;">' . $header[1] . '</div>';
            $pdf->writeHTMLCell(22, 9.1, 50, 2.3, $indicator, 1, 0, 1, '', 0);

            $indicator = '<div style="font-family:Verdana;font-size:20px;font-weight: bold;text-align: center;line-height:28px;">' . $header[2] . '</div>';
            $pdf->writeHTMLCell(28, 9.1, 73.5, 2.3, $indicator, 0, 0, 0, '', 0);

            $toll = '<div style="font-size:13px;font-weight:bold;border:1px solid #000;line-height:494px;">&nbsp;</div>';
            $pdf->writeHTMLCell(103, 100, 1,12, $toll, false, 0, 0, '', true);


            $html = '<div style="font-family:Verdana;font-size:10px;font-weight:bold;">' . 'Shipper:<font style="font-size:10px;">' . $sender_name . '</font></div>';
            $pdf->writeHTMLCell(0, 0, 2.4, 11.7, $html, 0, 0, 0, '', true);

            $INSTRUCTIONS = '<div style="font-family:Verdana;font-size:10px;font-weight: bold">' . "Delivery Instructions:" . '</div>';
            $pdf->writeHTMLCell(0, 0, 48, 12.2, $INSTRUCTIONS, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:10px;font-weight:bold;">' . $sender_suburb_state . '</font></div>';
            $pdf->writeHTMLCell(0, 0, 2.4, 15.7, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:10px;font-weight:bold;">To:</font></div>';
            $pdf->writeHTMLCell(0, 0, 2.4, 19.7, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:14px;font-weight: bold">' . $receiver_name . '</div>';
            $pdf->writeHTMLCell(44, 0, 2.4, 23.6, $html, 0, 0, 0, '', false);

            $html = '<div style="font-family:Verdana;font-size:10px;font-weight: bold">' . $receiver_street1. '</div>';
            $pdf->writeHTMLCell(44, 0, 2.4, 28.6, $html, 0, 0, 0, '', false);

            $html = '<div style="font-family:Verdana;font-size:16px;font-weight: bold">' . $receiver_suburb ."&nbsp;". $receiver_state."&nbsp;".$receiver_postcode . '</div>';
            $pdf->writeHTMLCell(100, 0, 2.4, 34.6, $html, 0, 0, 0, '', false);


            $html = '<div style="font-family:Verdana;font-size:8px;">' . "Contact: " . $receiver_phone . '</div>';
            $pdf->writeHTMLCell(0, 0, 2.4, 40.5, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:8px;">' . "Item Ref: " . $model->hbn. '</div>';
            $pdf->writeHTMLCell(0, 0, 2.4, 43.5, $html, 0, 0, 0, '', true);

             $html = '<div style="font-family:Verdana;font-size:8px;">' . "Cref: " . $model->cref. '</div>';
            $pdf->writeHTMLCell(0, 0, 46, 43.5, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:8px;">CONSIGNMENT:</div>';
            $pdf->writeHTMLCell(0, 0, 2.4, 46.7, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:20px;font-weight:bold;">' . $model->ref . '</div>';
            $pdf->writeHTMLCell(60, 3.5, 2.4, 50, $html, 0, 0, 0, '', false);

            $borderLine = '<div style="font-family:Verdana;font-size:10px;font-weight: bold;color: white;text-align: center;">&nbsp;</div>';
            $pdf->writeHTMLCell(100.5, 2, 2.1, 59, $borderLine, 1, 0, 1, '', 0);

            $html = '<div style="font-family:Verdana;font-size:12px;font-weight: bold;"><font style="font-size:16px;">Label ' . $sequence . '</font> of ' . $total_count . '</div>';
            $pdf->writeHTMLCell(40, 6, 70, 62.6, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:12px;font-weight: bold;"><font style="font-size:14px;">ETA: </div>';
            $pdf->writeHTMLCell(40, 6, 70, 46.6, $html, 0, 0, 0, '', true);


            $barcode_style = array(
                'position' => '',
                'align' => 'C',
                'stretch' => false,
                'fitwidth' => true,
                'cellfitalign' => '',
                'border' => false,
                'hpadding' => 'auto',
                'vpadding' => 'auto',
                'fgcolor' => array(0, 0, 0),
                'bgcolor' => false, //array(255,255,255),
                'text' => false,
                'font' => 'helvetica',
                'fontsize' => 8,
                'stretchtext' => 4
            );
            $pdf->write1DBarcode(chr(241) . "401" . chr(241) . "9347780" . $model->ref, 'C128', 8, 67.6, '', 32, 0.45, $barcode_style, 'N');
            $pdf->SetFontSize(8);
            $pdf->writeHTMLCell(0, 0, 2, 96, '(401) '. "9347780 " . $model->ref, 0, 0, 0, '', true);



            $pdf->write1DBarcode(chr(241) . $item->trackingNumber, 'C128', 8, 108, '', 32, 0.55, $barcode_style, 'N');
            $pdf->writeHTMLCell(0, 0, 3, 136, '(00) ' . substr($item->trackingNumber, 2), 0, 0, 0, '', true);


            

            $f = tempnam(Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR."temp".DIRECTORY_SEPARATOR, 'pp');
            $pdf->Output($f, 'F');
            $ps[] = $f;
        }
        if($tp===3)
        {
            return oPDF::mergePDF($ps, 0, true);
        }elseif($tp)
        {
            return oPDF::mergePDF($ps, 2, false);
        }else
        {
            oPDF::mergePDF($ps, 1, true, 'label.pdf');
        }
    }

