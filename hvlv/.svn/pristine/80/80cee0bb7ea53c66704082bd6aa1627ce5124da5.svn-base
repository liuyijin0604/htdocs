            $pdf->SetFontSize(8);
            $pdf->writeHTMLCell(0, 0, 2, 96, '(421) '. "9347780 " . $model->ref, 0, 0, 0, '', true);



            $pdf->write1DBarcode(chr(241) . $item->trackingNumber, 'C128', 8, 108, '', 32, 0.55, $barcode_style, 'N');
            $pdf->writeHTMLCell(0, 0, 2, 136, '(00) ' . substr($item->trackingNumber, 2), 0, 0, 0, '', true);


            

            $f = tempnam(Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR."temp".DIRECTORY_SEPARATOR, 'pp');
            $pdf->Output($f, 'F');
            $ps[] = $f;
        }
        if($tp===3)
        {
            return oPDF::mergePDF($ps, 0, true);
        }elseif($tp)
        {
            return oPDF::mergePDF($ps, 2, false);
        }else
        {
            oPDF::mergePDF($ps, 1, true, 'label.pdf');
        }
    }

