            $pdf->setPrintFooter(false);

            $pdf->SetDefaultMonospacedFont(PDF_FONT_MONOSPACED);

            $pdf->SetMargins(PDF_MARGIN_LEFT, PDF_MARGIN_TOP, PDF_MARGIN_RIGHT);

            $pdf->SetAutoPageBreak(false, PDF_MARGIN_BOTTOM);

            $pdf->setImageScale(PDF_IMAGE_SCALE_RATIO);

            $pdf->SetFont('verdana', '', 10, '', true);

            $pdf->AddPage('P', '', false, false);

            $toll = '<div style="font-family:Verdana;font-size:10px">' . "From:".$sender_name . '</div>';
            $pdf->writeHTMLCell(80, 4, 2.1, 2.3, $toll, false, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:10px">' . "P/U Phone:".$sender_phone . '</div>';
            $pdf->writeHTMLCell(44, 4, 35.1, 2.3, $html, false, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:10px;"> Date:' . $desp . '</div>';
            $pdf->writeHTMLCell(60, 0, 75.9, 2.2, $html, false, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:10px">'.$sender_address .'</div>';
            $pdf->writeHTMLCell(85, 4, 2.1, 9.3, $html, false, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:10px">Contact:'.$sender_contact .'</div>';
            $pdf->writeHTMLCell(85, 4, 2.1, 15.5, $html, false, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:10px">' . "Phone:".$sender_phone . '</div>';
            $pdf->writeHTMLCell(44, 4, 40.1, 15.5, $html, false, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:10px">' . "Package:".$sequence.' of '.$total_count.'</div>';
            $pdf->writeHTMLCell(44, 4, 75.1, 15.5, $html, false, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:10px">Parcel ID:'.$item->trackingNumber .'</div>';
            $pdf->writeHTMLCell(85, 4, 2.1, 23.5, $html, false, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:15px">Cref:'.$model->cref .'</div>';
            $pdf->writeHTMLCell(85, 4, 2.1, 30.5, $html, false, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:10px">' . "Order Ref:" . '</div>';
            $pdf->writeHTMLCell(44, 4, 65.1, 30.5, $html, false, 0, 0, '', true);

        

            $style = array(
                'border' => false,
                'padding' => -10,
                'bgcolor' => false,
                'fgcolor' => array(0, 0, 0),
                'module_width' => 1,
                'module_height' => 1
            );

            $barcode_style = array(
                'position' => '',
                'align' => 'C',
                'stretch' => false,
                'fitwidth' => true,
                'cellfitalign' => '',
                'border' => false,
                'hpadding' => 'auto',
                'vpadding' => 'auto',
                'fgcolor' => array(0, 0, 0),
                'bgcolor' => false, //array(255,255,255),
                'text' => false,
                'font' => 'helvetica',
                'fontsize' => 8,
                'stretchtext' => 4
            );

            $pdf->write1DBarcode(chr(241) . $item->trackingNumber, 'C128', 0, 35.9, '', 18, 0.55, $barcode_style, 'N');
            $pdf->writeHTMLCell(100, 0, 3.9, 133.5, "<hr>", 0, false, false, false, '');

            // $pdf->StartTransform();
            // $pdf->Rotate(-90);
            // $pdf->SetX(1);
            // $pdf->SetFontSize(7);
            // $pdf->Cell(1, 0, '                         Printed By Allied Express Portal', 0, 0, false, 0, '', 0);
            // $pdf->StopTransform();

            $html = '<div style="font-family:Verdana;font-size:15px">'.$item->trackingNumber .'</div>';
            $pdf->writeHTMLCell(60, 4, 0, 55.5, $html, false, 0, 0, '', true);
            $html = '<div style="font-family:Verdana;font-size:8px">Service:</div>';
            $pdf->writeHTMLCell(20, 4, 43.1, 57.5, $html, false, 0, 0, '', true);


            $service = '<div style="font-family:Verdana;font-size:10px;font-weight: bold;color: white">  Road</div>';
            $pdf->writeHTMLCell(14, 6, 54.1, 55.5, $service, 1, 0, 1, '', true);

            $html = '<div style="font-family:Verdana;font-size:10px">Package:<font style="font-size:15px;">'.$sequence.'</font> of <font style="font-size:15px;">'.$total_count.'</font></div>';
            $pdf->writeHTMLCell(40, 4, 70.1, 53.5, $html, false, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:10px">Weight:'.$item->weight.'</div>';
            $pdf->writeHTMLCell(32, 4, 72.1, 59, $html, false, 0, 0, '', true);


            $to = '<div style="font-family:Verdana;font-size:15px;font-weight: bold;">' . "TO: ".$receiver_name . '</div>';
            $pdf->writeHTMLCell(300, 0, 1, 64, $to, 0, 0, 0, '', true);

            $receiver_street1 = isset($receiver_street1) ? $receiver_street1 : '';
            $receiver_street2 = isset($receiver_street2) ? $receiver_street2 : '';

            $html = '<div style="font-family:Verdana;font-size:11px;line-height:12px;">' . $receiver_street1 . '<br/>' . $receiver_street2 . '</div>';
            $pdf->writeHTMLCell(100, 0, 11, 70, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:8px;line-height:12px;">Item '.$sequence.':' . $item->length.'x'.$item->width.'x'.$item->height . '=' . (($item->length*$item->width*$item->height)/1000000) .'('.$sequence.')</div>';
            $pdf->writeHTMLCell(0, 0, 2.1, 80, $html, 0, 0, 0, '', true);


            $html = '<div style="font-family:Verdana;font-size:16px;font-weight: bold">' . $receiver_suburb . '</div>';
            $pdf->writeHTMLCell(80, 0, 47.1, 80, $html, 0, 0, 0, '', false);

            $html = '<div style="font-family:Verdana;font-size:16px;font-weight: bold">' . $receiver_state . '</div>';
            $pdf->writeHTMLCell(0, 0, 47.1, 90, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:16px;font-weight: bold">' . $depotCode . '</div>';
            $pdf->writeHTMLCell(0, 0, 65.1, 90, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:16px;font-weight: bold">' . $receiver_postcode . '</div>';
            $pdf->writeHTMLCell(20, 0, 85.1, 90, $html, 0, 0, 0, '', true);


            $html = '<div style="font-family:Verdana;font-size:10px;line-height:12px;">Special instruction:</div>';
            $pdf->writeHTMLCell(0, 0, 2.1, 100, $html, 0, 0, 0, '', true);

            // $html = '<div style="font-family:Verdana;font-size:10px;line-height:14px;">Account:EIZLSX</div>';
            // $pdf->writeHTMLCell(0, 0, 2.1, 110, $html, 0, 0, 0, '', true);


            $html = '<div style="font-family:Verdana;font-size:10px;line-height:12px;">Date:'.$desp.'</div>';
            $pdf->writeHTMLCell(0, 0, 37.1, 110, $html, 0, 0, 0, '', true);


            $html = '<div style="font-family:Verdana;font-size:10px;line-height:12px;">Date__________</div>';
            $pdf->writeHTMLCell(30, 0, 72.1, 110, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:10px;line-height:14px;">Name_____________</div>';
            $pdf->writeHTMLCell(0, 0, 2.1, 116, $html, 0, 0, 0, '', true);


            $html = '<div style="font-family:Verdana;font-size:10px;line-height:12px;">Signature___________</div>';
            $pdf->writeHTMLCell(0, 0, 37.1, 116, $html, 0, 0, 0, '', true);


            $html = '<div style="font-family:Verdana;font-size:10px;line-height:12px;">Time__________</div>';
            $pdf->writeHTMLCell(30, 0, 72.1, 116, $html, 0, 0, 0, '', true);

             $html = '<div style="font-family:Verdana;font-size:6px;line-height:14px;">RECEIVED IN GOOD CONDITION. SUBJECT TO CARRIER TERMS AND CONDITIONS.</div>';
            $pdf->writeHTMLCell(0, 0, 12.1, 130, $html, 0, 0, 0, '', true);

            // $pdf->write1DBarcode(chr(241) . $model->hbn, 'C128', 0, 132.9, '', 10, 0.55, $barcode_style, 'N');
            // $html = '<div style="font-family:Verdana;font-size:15px;line-height:14px;">'.$model->hbn.'</div>';
            // $pdf->writeHTMLCell(0, 0, 4.1, 138, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:15px;">'.$model->hbn.'</div>';
            $pdf->writeHTMLCell(0, 0, 4.1, 134, $html, 0, 0, 0, '', true);
            $html = '<div style="font-family:Verdana;font-size:15px;">'.@$model->mdata['oref'].'</div>';
            $pdf->writeHTMLCell(0, 0, 4.1, 140, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:24px;"> ALLIED</div>';
            $pdf->writeHTMLCell(30, 20, 74.1, 136, $html, 1, 0,0, '', true);

            // $service = '<img src="'.Yii::app()->request->hostInfo.Yii::app()->baseUrl.'/images/allied_logo.jpg" width="20px;"> </img>';
            // $pdf->writeHTMLCell(0, 0,0,130, $service, 1, 0, 1, '', true);2

            $f = tempnam(Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR."temp".DIRECTORY_SEPARATOR, 'pp');
            $pdf->Output($f, 'F');
            $ps[] = $f;
        }
        if($tp===3)
        {
            return oPDF::mergePDF($ps, 0, true);
        }elseif($tp)
        {
            return oPDF::mergePDF($ps, 2, false);
        }else
        {
            oPDF::mergePDF($ps, 1, true, 'label.pdf');
        }
    }


    public static function generateEizTollLabel($model,$tp=false,$sn = 0)
    {
        Yii::import('application.libs.tcpdf.tcpdf_barcodes_1d', true);
        Yii::import('application.libs.tcpdf.tcpdf_barcodes_2d', true);
        Yii::import('application.libs.tcpdf.tcpdf', true);
        $settings = ['payor_account'=>'80518651','serviceDescription'=>'B2C','serviceCode'=>'004'];
        $connote = $model->ref;
        
        $payor = $settings['payor_account'];
        $ps = [];
        $items = [];
        
        $total_count = count($model->mdata['eiz']['label']);
        
        $sequence = 0;

        $eizAPI = EizAPI::getAPIInstance($model->mdata['org_rate_id']);

        $depotCode = $eizAPI->getZone($model);

        $phone = $model->cnee->tel;

        $phone = preg_replace("/[^0-9]/", "", $phone);

        $phone = sprintf("%010d", $phone);

        $desp = date('d/m/Y');
        $receiver_name = $model->cnee->name;
        $receiver_street1 = $model->cnee->address;
        $receiver_street2 = '';
        $receiver_suburb = $model->cnee->suburb;
        $receiver_postcode = $model->cnee->postcode;
        $receiver_state = $model->cnee->state;
        $receiver_phone = $phone;
        $receiver_contact = $model->cnee->name;

        $prepareData = $eizAPI->prepareData($model);
        $sender_name = !empty($model->agent->extra['delivery_label_name'])?$model->agent->extra['delivery_label_name']:$prepareData->from_name;

        $sender_suburb_state = $prepareData->from_suburb ." ".$prepareData->from_state;
        $sender_country = $prepareData->from_country;
        $sender_postcode = $prepareData->from_postcode;
        $sender_phone = $prepareData->from_phone;
        $sender_contact = !empty($model->agent->extra['delivery_label_name'])?$model->agent->extra['delivery_label_name']:$prepareData->from_name;
        $consignmentObj = $prepareData->consignments[0]->data;
        $shippingMethodCode = 'Road express';
        $description_detail = ' ';
        $declaration_person = $prepareData->from_name;
        $dangerous_good_declarartion = 'I hereby declare that this consingment does not contain dangerous goods';
        $ref = $model->hbn;
        $instruction = '';

        $item_number = 0;

        $volumn = 0;

        $result = [];

        $items = [];

            $mitems = $model->mdata['eiz']['package'];
            $mitems = json_encode($mitems);
            $mitems = json_decode($mitems);
            $kk = 0;
            foreach ($mitems as $key => $item) {
                $refCSLocation = '';
                $refCSSku = '';
                $refCSSkuQty = '';

                $volumn = $item->width * $item->length * $item->height / 1000;

                $item_weight = sprintf("%06d", round($item->weight, 1) * 10);

                $srg = 'N';
                $nsr = 'N';
 
                if ($settings['serviceDescription'] == "B2C"){
                    $receiver = "R";
                    $adp = 'Y';
                } else {
                    $receiver = "B";
                    $adp = 'N';
                }
                $item_number += $item->qty;
                if ($item->qty > 1) {
                    for ($i = 0; $i < $item->qty; $i++) {
                        $trackingNumber = $model->mdata['eiz']['label'][$kk]['labelNumber'];
                        $items[] = [
                            'labelId' => $model->mdata['eiz']['label'][$kk]['id'],
                            'trackingNumber' => $trackingNumber,
                            'qty' => $item->qty,
                            'width' => $item->width,
                            'weight' => $item->weight,
                            'height' => $item->height,
                            'length' => $item->length,
                            'qrcode' => str_pad($trackingNumber, 22) . str_pad("B", 1) . str_pad($connote, 20) . str_pad(date('ymd'), 6) . str_pad($item_weight, 6) . str_pad(' ', 2) . str_pad(sprintf("%04d", $item->length), 4) . str_pad(sprintf("%04d", $item->width), 4) . str_pad(sprintf("%04d", $item->height), 4) . str_pad(sprintf("%05d", $volumn), 5) . str_pad($settings['serviceCode'], 3) . str_pad(' ', 18) . str_pad('N', 1) . str_pad('N', 1) . str_pad(' ', 10) . str_pad($adp, 1) . str_pad($nsr, 1) . str_pad('N', 1) . str_pad($srg, 1) . str_pad('N', 1) . str_pad(' ', 4) . str_pad('N', 11) . str_pad('S', 1) . str_pad($payor, 10) . str_pad(' ', 9) . str_pad($receiver_name, 40) . str_pad($receiver_street1, 30) . str_pad($receiver_street2, 30) . str_pad($receiver_suburb, 30) . str_pad($receiver_postcode, 10) . str_pad('AU', 2) . str_pad(' ', 14) . str_pad($receiver, 1) . str_pad($receiver_phone, 10) . str_pad(' ', 18) . str_pad('TF2', 3),
                            'refCSLocation' => $refCSLocation,
                            'refCSSku' => $refCSSku,
                            'refCSSkuQty' => $refCSSkuQty
                        ];
                        $kk++;
                    }
                } else {
                    $trackingNumber = $model->mdata['eiz']['label'][$kk]['labelNumber'];
                    $items[] = [
                        'labelId' => $model->mdata['eiz']['label'][$kk]['id'],
                        'trackingNumber' => $trackingNumber,
                        'qty' => $item->qty,
                        'width' => $item->width,
                        'weight' => $item->weight,
                        'height' => $item->height,
                        'length' => $item->length,
                        'qrcode' => str_pad($trackingNumber, 22) . str_pad("B", 1) . str_pad($connote, 20) . str_pad(date('ymd'), 6) . str_pad($item_weight, 6) . str_pad(' ', 2) . str_pad(sprintf("%04d", $item->length), 4) . str_pad(sprintf("%04d", $item->width), 4) . str_pad(sprintf("%04d", $item->height), 4) . str_pad(sprintf("%05d", $volumn), 5) . str_pad($settings['serviceCode'], 3) . str_pad(' ', 18) . str_pad('N', 1) . str_pad('N', 1) . str_pad(' ', 10) . str_pad($adp, 1) . str_pad($nsr, 1) . str_pad('N', 1) . str_pad($srg, 1) . str_pad('N', 1) . str_pad(' ', 4) . str_pad('N', 11) . str_pad('S', 1) . str_pad($payor, 10) . str_pad(' ', 9) . str_pad($receiver_name, 40) . str_pad($receiver_street1, 30) . str_pad($receiver_street2, 30) . str_pad($receiver_suburb, 30) . str_pad($receiver_postcode, 10) . str_pad('AU', 2) . str_pad(' ', 14) . str_pad($receiver, 1) . str_pad($receiver_phone, 10) . str_pad(' ', 18) . str_pad('TF2', 3),
                        'refCSLocation' => $refCSLocation,
                        'refCSSku' => $refCSSku,
                        'refCSSkuQty' => $refCSSkuQty
                    ];
                    $kk++;
                }
            }
           
        $ii = json_encode($items);
        $items = json_decode($ii);

        foreach ($items as $itemkey => $item) {
            $sequence++;
            if($sn!=0 && $itemkey!=($sn-1)) continue;
            $package_dimensions = 'L:' . $item->length . 'cm &nbsp;&nbsp;W:' . $item->width . 'cm &nbsp;&nbsp;H:' . $item->height;
            $item_weight = $item->weight . "KG";

            $pdf = new \TCPDF(PDF_PAGE_ORIENTATION, PDF_UNIT, 'A6', true, 'UTF-8', false);
            $pdf->setPrintHeader(false);
            $pdf->setPrintFooter(false);

            $pdf->SetDefaultMonospacedFont(PDF_FONT_MONOSPACED);

            $pdf->SetMargins(PDF_MARGIN_LEFT, PDF_MARGIN_TOP, PDF_MARGIN_RIGHT);

            $pdf->SetAutoPageBreak(false, PDF_MARGIN_BOTTOM);

            $pdf->setImageScale(PDF_IMAGE_SCALE_RATIO);

            $pdf->SetFont('verdana', '', 10, '', true);

            $pdf->AddPage('P', '', false, false);

            $toll = '<div style="font-family:Verdana;font-size:13px">' . "TOLL" . '</div>';
            $pdf->writeHTMLCell(12, 4, 4.1, 2.3, $toll, false, 0, 0, '', true);

            $carrier = '<div style="font-family:Verdana;font-size:7.5px">' . "IPEC" . '</div>';
            $pdf->writeHTMLCell(0, 0, 24, 2.2, $carrier, false, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:7.5px;">' . $desp . '</div>';
            $pdf->writeHTMLCell(0, 0, 56.9, 2.2, $html, false, 0, 0, '', true);

            $depot = '<div style="font-family:Verdana;font-size:9px;font-weight: bold;;text-align: center">' . $depotCode . '</div>';
            $pdf->writeHTMLCell(10, 5, 79.3, 5.5, $depot, 1, 0, 0, '', 0);

            $indicator = '<div style="font-family:Verdana;font-size:13px;font-weight: bold;color: white;text-align: center">' . "R" . '</div>';
            $pdf->writeHTMLCell(8, 5, 90.7, 5.5, $indicator, 1, 0, 1, '', 0);

            $service = '<div style="font-family:Verdana;font-size:7.5px;font-weight: bold;color: white">' . $shippingMethodCode . '</div>';
            $pdf->writeHTMLCell(75, 4, 2.4, 6.5, $service, 1, 0, 1, '', true);

            $html = '<div style="font-family:Verdana;font-size:10px;font-weight:bold;">' . 'CONNOTE#:<font style="font-size:12px;">' . $connote . '</font></div>';
            $pdf->writeHTMLCell(0, 0, 2.4, 10.7, $html, 0, 0, 0, '', true);

            $to = '<div style="font-family:Verdana;font-size:10px;font-weight: bold;">' . "TO :" . '</div>';
            $pdf->writeHTMLCell(0, 0, 2.4, 15.7, $to, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:10px;">' . $receiver_name . '</div>';
            $pdf->writeHTMLCell(46, 0, 11.3, 15.7, $html, 0, 0, 0, '', true);

            $receiver_street1 = isset($receiver_street1) ? $receiver_street1 : '';
            $receiver_street2 = isset($receiver_street2) ? $receiver_street2 : '';

            $html = '<p style="font-family:Verdana;font-size:11px;line-height:12px;">' . $receiver_street1 . '<br/>' . $receiver_street2 . '</p>';
            $pdf->writeHTMLCell(50, 10, 2.4, 22.5, $html, 0, 0, 0, '', false);

            $html = '<div style="font-family:Verdana;font-size:11px;font-weight: bold">' . $receiver_suburb . '</div>';
            $pdf->writeHTMLCell(44, 0, 2.4, 32.6, $html, 0, 0, 0, '', false);

            $html = '<div style="font-family:Verdana;font-size:12px;font-weight: bold">' . $receiver_postcode . '</div>';
            $pdf->writeHTMLCell(0, 0, 35.2, 36, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:14px;font-weight: bold">' . $receiver_state . '</div>';
            $pdf->writeHTMLCell(0, 0, 2.4, 36, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:8px;">' . "Phone: " . $receiver_phone . '</div>';
            $pdf->writeHTMLCell(0, 0, 2.4, 40.5, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:8px;">' . "Contact: " . $receiver_contact . '</div>';
            $pdf->writeHTMLCell(0, 0, 2.4, 42.7, $html, 0, 0, 0, '', true);

            $INSTRUCTIONS = '<div style="font-family:Verdana;font-size:6px;font-weight: bold">' . "SPECIAL INSTRUCTIONS:" . '</div>';
            $pdf->writeHTMLCell(0, 0, 2.4, 47, $INSTRUCTIONS, 0, 0, 0, '', true);

            $instruction = isset($instruction) ? $instruction : '';

            $html = '<div style="font-family:Verdana;font-size:6.5px;">' . $instruction . '</div>';
            $pdf->writeHTMLCell(43, 3.5, 2.4, 49, $html, 0, 0, 0, '', false);

            $html = '<div style="font-family:Verdana;font-size:10px;font-weight:bold;">Cref:' . $model->cref . '</div>';
            $pdf->writeHTMLCell(43, 3.5, 2.4, 51, $html, 0, 0, 0, '', false);

            $banner = '<div style="font-family:Verdana;font-size:6px;font-weight: bold;text-align: center;color:white;">' . " " . '</div>';
            $pdf->writeHTMLCell(45, 4, 3.4, 57, $banner, 1, 0, 0, '', true);

            $style = array(
                'border' => false,
                'padding' => -10,
                'bgcolor' => false,
                'fgcolor' => array(0, 0, 0),
                'module_width' => 1,
                'module_height' => 1
            );

            $pdf->write2DBarcode($item->qrcode, 'QRCODE,L', 62, 22.5, 60, 60, $style, 'M');

            $dangerous = '<div style="font-family:Verdana;font-size:7px;font-weight: bold;text-align: center">' . "DG'S NO" . '</div>';
            $pdf->writeHTMLCell(12, 6, 3.4, 62, $dangerous, 1, 0, 0, '', true);

            if ($settings['serviceDescription'] == "B2C") {
                $adp = '<div style="font-family:Verdana;font-size:11px;font-weight: bold;">' . "ADP" . '</div>';
                $pdf->writeHTMLCell(12, 6, 18.8, 62.1, $adp, 1, 0, 0, '', true);
            } else {
                $adp = '<div style="font-family:Verdana;font-size:11px;font-weight: bold;">' . "" . '</div>';
                $pdf->writeHTMLCell(12, 6, 18.8, 62.1, $adp, 1, 0, 0, '', true);
            }

            if ($srg == 'Y') {
                $nsr = '<div style="font-family:Verdana;font-size:5px;font-weight: bold;text-align: center">' . "Signature Required" . '</div>';
            } else {
                $nsr = '<div style="font-family:Verdana;font-size:11px;font-weight: bold;text-align: center">' . "NSR" . '</div>';
            }

            $pdf->writeHTMLCell(12, 6, 34.3, 62.2, $nsr, 1, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:8px;font-weight: bold;"><font style="font-size:16px;">' . $sequence . '</font> of ' . $total_count . '</div>';
            $pdf->writeHTMLCell(16, 6, 54.9, 62.6, $html, 1, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:5px;font-weight: bold;text-align: center">' . $package_dimensions . '</div>';
            $pdf->writeHTMLCell(12, 6, 73.4, 62.6, $html, 1, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:10px;font-weight: bold;color:white;text-align: center">' . $item_weight . '</div>';
            $pdf->writeHTMLCell(12, 6, 87.7, 62.6, $html, 1, 0, 1, '', true);

            $barcode_style = array(
                'position' => '',
                'align' => 'C',
                'stretch' => false,
                'fitwidth' => true,
                'cellfitalign' => '',
                'border' => false,
                'hpadding' => 'auto',
                'vpadding' => 'auto',
                'fgcolor' => array(0, 0, 0),
                'bgcolor' => false, //array(255,255,255),
                'text' => false,
                'font' => 'helvetica',
                'fontsize' => 8,
                'stretchtext' => 4
            );
            $pdf->write1DBarcode(chr(241) . "421036" . $receiver_postcode . chr(241) . "403" . $settings['serviceCode'], 'C128', 8, 67.6, '', 32, 0.45, $barcode_style, 'N');
            $pdf->SetFontSize(8);
            $pdf->writeHTMLCell(0, 0, 2, 96, '(421) 036' . $receiver_postcode . ' (403) ' . $settings['serviceCode'], 0, 0, 0, '', true);

            $pdf->write1DBarcode(chr(241) . $item->trackingNumber, 'C128', 8, 99.9, '', 32, 0.55, $barcode_style, 'N');
            $pdf->writeHTMLCell(0, 0, 2, 128, '(00) ' . substr($item->trackingNumber, 2), 0, 0, 0, '', true);

            $pdf->writeHTMLCell(100, 0, 3.9, 133.5, "<hr>", 0, false, false, false, '');

            $pdf->StartTransform();
            $pdf->Rotate(-90);
            $pdf->SetX(1);
            $pdf->SetFontSize(6);
            $pdf->Cell(1, 0, '                                                            Security Screeing Clause', 0, 0, false, 0, '', 0);
            $pdf->StopTransform();

            $pdf->StartTransform();
            $pdf->Rotate(-270);
            $pdf->SetX(35);
            $pdf->SetFontSize(6);
            $pdf->Cell(1, 0, 'Carrier Terms Clause', 0, 0, false, 0, '', 0);
            $pdf->StopTransform();

            $sender = '<div style="font-family:Verdana;font-size:5px;font-weight: bold">' . "FROM: " . '</div>';
            $pdf->writeHTMLCell(0, 0, 4, 133.5, $sender, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:5px;">' . $sender_name . '</div>';
            $pdf->writeHTMLCell(0, 0, 9.5, 133.5, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:5px;">' . $sender_suburb_state . '</div>';
            $pdf->writeHTMLCell(0, 0, 4, 135.2, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:5px;">' . $sender_postcode . '</div>';
            $pdf->writeHTMLCell(0, 0, 4, 136.6, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:5px;font-weight: bold">' . $sender_country . '</div>';
            $pdf->writeHTMLCell(0, 0, 9, 136.6, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:6px;font-weight: bold">' . "Payor A/C: " . $settings['payor_account'] . '</div>';
            $pdf->writeHTMLCell(0, 0, 40, 133.5, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:6px;font-weight: bold;">' . "Contact:" . $sender_contact . '</div>';
            $pdf->writeHTMLCell(30, 0, 40, 135.2, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:6px;font-weight: bold;">' . "PH: " . $sender_phone . '</div>';
            $pdf->writeHTMLCell(0, 0, 40, 137.1, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:12px;">' . "REF: " . $ref . '</div>';
            $pdf->writeHTMLCell(0, 0, 4, 138.1, $html, 0, 0, 0, '', true);

            $description = '<div style="font-family:Verdana;font-size:5px;font-weight: bold;">' . "Description of Goods:" . '</div>';
            $pdf->writeHTMLCell(0, 0, 4, 142.3, $description, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:5px;">' . $description_detail . '</div>';
            $pdf->writeHTMLCell(0, 0, 30.7, 143.3, $html, 0, 0, 0, '', true);

            $declaration = '<div style="font-family:Verdana;font-size:5.5px;font-weight: bold;">' . "DECLARATION BY:" . '</div>';
            $pdf->writeHTMLCell(0, 0, 4, 144.5, $declaration, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:5.5px;">' . $declaration_person . '</div>';
            $pdf->writeHTMLCell(0, 0, 26.3, 144.5, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:5.5px;">' . $dangerous_good_declarartion . '</div>';
            $pdf->writeHTMLCell(0, 0, 4, 146, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:25px;">' . $refCSSkuQty . '</div>';
            $pdf->writeHTMLCell(0, 0, 52, 137.5, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:10px;text-align: left">' . $refCSLocation . '</div>';
            $pdf->writeHTMLCell(40, 0, 62.5, 137.5, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:10px;text-align: left">' . $refCSSku . '</div>';
            $pdf->writeHTMLCell(40, 0, 62.5, 143.5, $html, 0, 0, 0, '', true);

            $f = tempnam(Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR."temp".DIRECTORY_SEPARATOR, 'pp');
            $pdf->Output($f, 'F');
            $ps[] = $f;
        }
        if($tp===3)
        {
            return oPDF::mergePDF($ps, 0, true);
        }elseif($tp)
        {
            return oPDF::mergePDF($ps, 2, false);
        }else
        {
            oPDF::mergePDF($ps, 1, true, 'label.pdf');
        }
    }

    public static function generateUbiTollLabel($model,$tp=false,$sn = 0)
    {
        Yii::import('application.libs.tcpdf.tcpdf_barcodes_1d', true);
        Yii::import('application.libs.tcpdf.tcpdf_barcodes_2d', true);
        Yii::import('application.libs.tcpdf.tcpdf', true);
        $settings = ['payor_account'=>'9352978','serviceDescription'=>'B2C','serviceCode'=>'004'];
        $connote = $model->ref;
        $payor = $settings['payor_account'];
        $ps = [];
        $items = [];
        
        $sequence = 0;
        $etowerAPI = EtowerAPI::getAPIInstance($model->mdata['org_rate_id']);
        $depotCode = $etowerAPI->getZone($model);

        $phone = $model->cnee->tel;

        $phone = preg_replace("/[^0-9]/", "", $phone);

        $phone = sprintf("%010d", $phone);

        $desp = date('d/m/Y');
        $receiver_name = $model->cnee->name;
        $receiver_company = (!empty($model->cnee->company)?$model->cnee->company.'<br/>':"");
        $receiver_street1 = $model->cnee->address;
        $receiver_street2 = '';
        $receiver_suburb = $model->cnee->suburb;
        $receiver_postcode = $model->cnee->postcode;
        $receiver_state = $model->cnee->state;
        $receiver_phone = $phone;
        $receiver_contact = $model->cnee->name;

        $packages = $model->mdata['ubi_toll'];
        $total_count = count($packages);
        $prepareData = $etowerAPI->prepareData($model,false,$etowerAPI->serviceCode);
        $sender_name = $prepareData->returnName;
        $sender_address = $prepareData->returnAddressLine1;
        $sender_suburb_state = $prepareData->returnCity ." ".$prepareData->returnState;
        $sender_country = $prepareData->returnCountry;
        $sender_postcode = $prepareData->returnPostcode;
        $sender_phone = $prepareData->shipperPhone;
        $sender_contact = $prepareData->returnName;
        $shippingMethodCode = ' Express Parcels - Road';
        $description_detail = ' ';
        $declaration_person = $prepareData->returnName;
        $dangerous_good_declarartion = 'I hereby declare that this consingment does not contain dangerous goods';
        $ref = $model->hbn;
        $instruction = '';

        $item_number = 0;

        $volumn = 0;

        $result = [];

        $items = [];

        $mitems = json_encode($packages);
        $mitems = json_decode($mitems);
        $barcodes = explode(',', $model->mdata['barcode']);
        $kk = 0;
        foreach ($mitems as $key => $item) {
                $refCSLocation = '';
                $refCSSku = '';
                $refCSSkuQty = '';

                $volumn = $item->width * $item->length * $item->height / 1000;

                $item_weight = sprintf("%06d", round($item->weight, 1) * 10);

                $srg = 'N';
                $nsr = 'Y';

                if ($settings['serviceDescription'] == "B2C"){
                    $receiver = "R";
                    $adp = 'N';
                } else {
                    $receiver = "B";
                    $adp = 'N';
                }
                $trackingNumber = $barcodes[$key];
                $items[] = [
                    'trackingNumber' => $trackingNumber,
                    'qty' => $item->qty,
                    'width' => $item->width,
                    'weight' => $item->weight,
                    'height' => $item->height,
                    'length' => $item->length,
                    'qrcode' => str_pad($trackingNumber, 22) . str_pad("B", 1) . str_pad($connote, 20) . str_pad(date('ymd'), 6) . str_pad($item_weight, 6) . str_pad(' ', 2) . str_pad(sprintf("%04d", $item->length), 4) . str_pad(sprintf("%04d", $item->width), 4) . str_pad(sprintf("%04d", $item->height), 4) . str_pad(sprintf("%05d", $volumn), 5) . str_pad($settings['serviceCode'], 3) . str_pad(' ', 18) . str_pad('N', 1) . str_pad('N', 1) . str_pad(' ', 10) . str_pad($adp, 1) . str_pad($nsr, 1) . str_pad('N', 1) . str_pad($srg, 1) . str_pad('N', 1) . str_pad(' ', 4) . str_pad(' ', 11) . str_pad('R', 1) . str_pad($payor, 10) . str_pad(' ', 9) . str_pad($receiver_name, 40) . str_pad($receiver_street1, 30) . str_pad($receiver_street2, 30) . str_pad($receiver_suburb, 30) . str_pad($receiver_postcode, 10) . str_pad('AU', 2) . str_pad(' ', 14) . str_pad($receiver, 1) . str_pad($receiver_phone, 10) . str_pad(' ', 18) . str_pad('TF2', 3),
                    'refCSLocation' => $refCSLocation,
                    'refCSSku' => $refCSSku,
                    'refCSSkuQty' => $refCSSkuQty
                ];
            }
           
        $ii = json_encode($items);
        $items = json_decode($ii);

        foreach ($items as $itemkey => $item) {
            $sequence++;
            if($sn!=0 && $itemkey!=($sn-1)) continue;
            $package_dimensions = 'L:' . $item->length . 'cm &nbsp;&nbsp;W:' . $item->width . 'cm &nbsp;&nbsp;H:' . $item->height;
            $item_weight = $item->weight . "KG";

            $pdf = new \TCPDF(PDF_PAGE_ORIENTATION, PDF_UNIT, 'A6', true, 'UTF-8', false);
            $pdf->setPrintHeader(false);
            $pdf->setPrintFooter(false);

            $pdf->SetDefaultMonospacedFont(PDF_FONT_MONOSPACED);

            $pdf->SetMargins(PDF_MARGIN_LEFT, PDF_MARGIN_TOP, PDF_MARGIN_RIGHT);

            $pdf->SetAutoPageBreak(false, PDF_MARGIN_BOTTOM);

            $pdf->setImageScale(PDF_IMAGE_SCALE_RATIO);

            $pdf->SetFont('verdana', '', 10, '', true);

            $pdf->AddPage('P', '', false, false);

            $toll = '<div style="font-family:Verdana;font-size:13px">' . "TOLL" . '</div>';
            $pdf->writeHTMLCell(12, 4, 4.1, 1.3, $toll, false, 0, 0, '', true);

            $carrier = '<div style="font-family:Verdana;font-size:7.5px">' . "IPEC" . '</div>';
            $pdf->writeHTMLCell(0, 0, 24, 2.2, $carrier, false, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:7.5px;">DESP:' . $desp . '</div>';
            $pdf->writeHTMLCell(0, 0, 56.9, 2.2, $html, false, 0, 0, '', true);

            $depot = '<div style="font-family:Verdana;font-size:9px;font-weight: bold;;text-align: center">' . $depotCode . '</div>';
            $pdf->writeHTMLCell(10, 5, 79.3, 5.5, $depot, 1, 0, 0, '', 0);

            $indicator = '<div style="font-family:Verdana;font-size:13px;font-weight: bold;color: white;text-align: center">' . "R" . '</div>';
            $pdf->writeHTMLCell(8, 5, 90.7, 5.5, $indicator, 1, 0, 1, '', 0);

            $service = '<div style="font-family:Verdana;font-size:10px;font-weight: bold;color: white">' . $shippingMethodCode . '</div>';
            $pdf->writeHTMLCell(75, 4, 2.4, 6.5, $service, 1, 0, 1, '', true);

            $html = '<div style="font-family:Verdana;font-size:10px;font-weight:bold;">' . 'CONNOTE#:<font style="font-size:12px;">' . $connote . '</font></div>';
            $pdf->writeHTMLCell(0, 0, 2.4, 10.7, $html, 0, 0, 0, '', true);

            $to = '<div style="font-family:Verdana;font-size:10px;font-weight: bold;">' . "TO :" . '</div>';
            $pdf->writeHTMLCell(0, 0, 2.4, 15.7, $to, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:10px;">' . $receiver_name . '</div>';
            $pdf->writeHTMLCell(46, 0, 11.3, 15.7, $html, 0, 0, 0, '', true);
            $receiver_street1 = isset($receiver_street1) ? $receiver_street1 : '';
            $receiver_street2 = isset($receiver_street2) ? $receiver_street2 : '';

            $html = '<p style="font-family:Verdana;font-size:11px;line-height:12px;">'.$receiver_company. $receiver_street1 . '<br/>' . $receiver_street2 . '</p>';
            $pdf->writeHTMLCell(50, 10, 2.4, 22.5, $html, 0, 0, 0, '', false);

            $html = '<div style="font-family:Verdana;font-size:11px;font-weight: bold">' . $receiver_suburb . '</div>';
            $pdf->writeHTMLCell(44, 0, 2.4, 32.6, $html, 0, 0, 0, '', false);

            $html = '<div style="font-family:Verdana;font-size:12px;font-weight: bold">' . $receiver_postcode . '</div>';
            $pdf->writeHTMLCell(0, 0, 35.2, 36, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:14px;font-weight: bold">' . $receiver_state . '</div>';
            $pdf->writeHTMLCell(0, 0, 2.4, 36, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:8px;">' . "Phone: " . $receiver_phone . '</div>';
            $pdf->writeHTMLCell(0, 0, 2.4, 40.5, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:8px;">' . "Contact: " . $receiver_contact . '</div>';
            $pdf->writeHTMLCell(0, 0, 2.4, 42.7, $html, 0, 0, 0, '', true);

            $INSTRUCTIONS = '<div style="font-family:Verdana;font-size:6px;font-weight: bold">' . "SPECIAL INSTRUCTIONS:" . '</div>';
            $pdf->writeHTMLCell(0, 0, 2.4, 47, $INSTRUCTIONS, 0, 0, 0, '', true);

            $instruction = isset($instruction) ? $instruction : '';

            $html = '<div style="font-family:Verdana;font-size:6.5px;">' . $instruction . '</div>';
            $pdf->writeHTMLCell(43, 3.5, 2.4, 49, $html, 0, 0, 0, '', false);

            $html = '<div style="font-family:Verdana;font-size:10px;font-weight:bold;">Cref:' . $model->cref . '</div>';
            $pdf->writeHTMLCell(43, 3.5, 2.4, 51, $html, 0, 0, 0, '', false);

             $service = '<div style="font-family:Verdana;font-size:10px;font-weight: bold;color: white">  RELEASE DATE:' . $desp . '</div>';
            $pdf->writeHTMLCell(45, 4, 2.4, 57, $service, 1, 0, 1, '', true);

            // $banner = '<div style="font-family:Verdana;font-size:6px;font-weight: bold;text-align: center;color:white;">' . " " . '</div>';
            // $pdf->writeHTMLCell(45, 4, 3.4, 57, $banner, 1, 0, 0, '', true);

            $style = array(
                'border' => false,
                'padding' => -10,
                'bgcolor' => false,
                'fgcolor' => array(0, 0, 0),
                'module_width' => 1,
                'module_height' => 1
            );

            $pdf->write2DBarcode($item->qrcode, 'QRCODE,L', 62, 22.5, 60, 60, $style, 'M');

            $dangerous = '<div style="font-family:Verdana;font-size:7px;font-weight: bold;text-align: center">' . "DG'S NO" . '</div>';
            $pdf->writeHTMLCell(12, 6, 3.4, 62, $dangerous, 1, 0, 0, '', true);

            if ($settings['serviceDescription'] == "B2C") {
                $adp = '<div style="font-family:Verdana;font-size:11px;font-weight: bold;">' . "ATL" . '</div>';
                $pdf->writeHTMLCell(12, 6, 34.3, 62.2, $adp, 1, 0, 0, '', true);
            } else {
                $adp = '<div style="font-family:Verdana;font-size:11px;font-weight: bold;">' . "" . '</div>';
                $pdf->writeHTMLCell(12, 6, 34.3, 62.2, $adp, 1, 0, 0, '', true);
            }

            if ($srg == 'Y') {
                $nsr = '<div style="font-family:Verdana;font-size:5px;font-weight: bold;text-align: center">' . "Signature Required" . '</div>';
            } else {
                $nsr = '<div style="font-family:Verdana;font-size:11px;font-weight: bold;text-align: center">' . "NSR" . '</div>';
            }

            $pdf->writeHTMLCell(12, 6, 18.8, 62.1, $nsr, 1, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:8px;font-weight: bold;"><font style="font-size:16px;">' . $sequence . '</font> of ' . $total_count . '</div>';
            $pdf->writeHTMLCell(16, 6, 54.9, 62.6, $html, 1, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:5px;font-weight: bold;text-align: center">' . $package_dimensions . '</div>';
            $pdf->writeHTMLCell(12, 6, 73.4, 62.6, $html, 1, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:10px;font-weight: bold;color:white;text-align: center">' . $item_weight . '</div>';
            $pdf->writeHTMLCell(12, 6, 87.7, 62.6, $html, 1, 0, 1, '', true);

            $barcode_style = array(
                'position' => '',
                'align' => 'C',
                'stretch' => false,
                'fitwidth' => true,
                'cellfitalign' => '',
                'border' => false,
                'hpadding' => 'auto',
                'vpadding' => 'auto',
                'fgcolor' => array(0, 0, 0),
                'bgcolor' => false, //array(255,255,255),
                'text' => false,
                'font' => 'helvetica',
                'fontsize' => 8,
                'stretchtext' => 4
            );
            $pdf->write1DBarcode(chr(241) . "421036" . $receiver_postcode . chr(241) . "403" . $settings['serviceCode'], 'C128', 8, 67.6, '', 32, 0.45, $barcode_style, 'N');
            $pdf->SetFontSize(8);
            $pdf->writeHTMLCell(0, 0, 2, 96, '(421) 036' . $receiver_postcode . ' (403) ' . $settings['serviceCode'], 0, 0, 0, '', true);

            $pdf->write1DBarcode(chr(241) . $item->trackingNumber, 'C128', 8, 99.9, '', 32, 0.55, $barcode_style, 'N');
            $pdf->writeHTMLCell(0, 0, 2, 128, '(00) ' . substr($item->trackingNumber, 2,strlen($item->trackingNumber)-3).' '.substr($item->trackingNumber, strlen($item->trackingNumber)-1,strlen($item->trackingNumber)), 0, 0, 0, '', true);

            $pdf->writeHTMLCell(100, 0, 3.9, 133.5, "<hr>", 0, false, false, false, '');

            $pdf->StartTransform();
            $pdf->Rotate(-90);
            $pdf->SetX(1);
            $pdf->SetFontSize(6);
            $pdf->Cell(1, 0, '                                                               THIS ITEM WILL BE SUBJECT TO SECURITY SCREEING CLAUSE', 0, 0, false, 0, '', 0);
            $pdf->StopTransform();

            $pdf->StartTransform();
            $pdf->Rotate(-270);
            $pdf->SetX(0);
            $pdf->SetFontSize(6);
            $pdf->Cell(1, 0, 'CARRIER\'S TERMS AND CONDITIONS APPLY', 0, 0, false, 0, '', 0);
            $pdf->StopTransform();

            $sender = '<div style="font-family:Verdana;font-size:5px;font-weight: bold">' . "FROM: " . '</div>';
            $pdf->writeHTMLCell(0, 0, 4, 133.5, $sender, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:5px;">' . $sender_name . '</div>';
            $pdf->writeHTMLCell(0, 0, 9.5, 133.5, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:5px;">' . $sender_suburb_state . '</div>';
            $pdf->writeHTMLCell(0, 0, 4, 135.2, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:5px;">' . $sender_postcode . '</div>';
            $pdf->writeHTMLCell(0, 0, 4, 136.6, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:5px;font-weight: bold">' . $sender_country . '</div>';
            $pdf->writeHTMLCell(0, 0, 9, 136.6, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:6px;font-weight: bold">' . $sender_address. '</div>';
            $pdf->writeHTMLCell(0, 0, 40, 133.5, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:12px;">' . "REF: " . $ref . '</div>';
            $pdf->writeHTMLCell(0, 0, 4, 138.1, $html, 0, 0, 0, '', true);

            $description = '<div style="font-family:Verdana;font-size:5px;font-weight: bold;">' . "Description of Goods:" . '</div>';
            $pdf->writeHTMLCell(0, 0, 4, 142.3, $description, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:5px;">' . $description_detail . '</div>';
            $pdf->writeHTMLCell(0, 0, 30.7, 143.3, $html, 0, 0, 0, '', true);

            $declaration = '<div style="font-family:Verdana;font-size:5.5px;font-weight: bold;">' . "DECLARATION BY:" . '</div>';
            $pdf->writeHTMLCell(0, 0, 4, 144.5, $declaration, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:5.5px;">' . $declaration_person . '</div>';
            $pdf->writeHTMLCell(0, 0, 26.3, 144.5, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:5.5px;">' . $dangerous_good_declarartion . '</div>';
            $pdf->writeHTMLCell(0, 0, 4, 146, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:25px;">' . $refCSSkuQty . '</div>';
            $pdf->writeHTMLCell(0, 0, 52, 137.5, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:10px;text-align: left">' . $refCSLocation . '</div>';
            $pdf->writeHTMLCell(40, 0, 62.5, 137.5, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:10px;text-align: left">' . $refCSSku . '</div>';
            $pdf->writeHTMLCell(40, 0, 62.5, 143.5, $html, 0, 0, 0, '', true);

            $f = tempnam(Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR."temp".DIRECTORY_SEPARATOR, 'pp');
            $pdf->Output($f, 'F');
            $ps[] = $f;
        }
        if($tp===3)
        {
            return oPDF::mergePDF($ps, 0, true);
        }elseif($tp)
        {
            return oPDF::mergePDF($ps, 2, false);
        }else
        {
            oPDF::mergePDF($ps, 1, true, 'label.pdf');
        }
    }

    public static function generateMyTollLabel($model,$tp=false,$sn = 0)
    {
        Yii::import('application.libs.tcpdf.tcpdf_barcodes_1d', true);
        Yii::import('application.libs.tcpdf.tcpdf_barcodes_2d', true);
        Yii::import('application.libs.tcpdf.tcpdf', true);
        $settings = ['payor_account'=>'80691368','serviceDescription'=>'B2C','serviceCode'=>'004'];
        $connote = $model->ref;
        $payor = $settings['payor_account'];
        $ps = [];
        $items = [];
        
        $sequence = 0;
        $mytollAPI = MyTollAPI::getAPIInstance($model->mdata['org_rate_id']);
        $depotCode = $mytollAPI->getZone($model);

        $phone = $model->cnee->tel;

        $phone = preg_replace("/[^0-9]/", "", $phone);

        $phone = sprintf("%010d", $phone);

        $desp = date('d/m/Y');
        $receiver_name = $model->cnee->name;
        $receiver_company = (!empty($model->cnee->company)?$model->cnee->company.'<br/>':"");
        $receiver_street1 = $model->cnee->address;
        $receiver_street2 = '';
        $receiver_suburb = $model->cnee->suburb;
        $receiver_postcode = $model->cnee->postcode;
        $receiver_state = $model->cnee->state;
        $receiver_phone = $phone;
        $receiver_contact = $model->cnee->name;

        $packages = $mytollAPI->getPackages($model);
        $total_count = count($packages);
        $prepareData = $mytollAPI->prepareLabelData($model,false,$mytollAPI->serviceCode);
        $sender_name = $prepareData->returnName;
        $sender_address = $prepareData->returnAddressLine1;
        $sender_suburb_state = $prepareData->returnCity ." ".$prepareData->returnState;
        $sender_country = $prepareData->returnCountry;
        $sender_postcode = $prepareData->returnPostcode;
        $sender_phone = $prepareData->shipperPhone;
        $sender_contact = $prepareData->returnName;
        $shippingMethodCode = $mytollAPI->shippingMethodCode;
        $description_detail = ' ';
        $declaration_person = $prepareData->returnName;
        $dangerous_good_declarartion = 'I hereby declare that this consingment does not contain dangerous goods';
        $ref = $model->hbn;
        $instruction = '';

        $item_number = 0;

        $volumn = 0;

        $result = [];

        $items = [];

        $mitems = json_encode($packages);
        $mitems = json_decode($mitems);
        $barcodes = explode(',', $model->mdata['barcode']);
        $kk = 0;
        foreach ($mitems as $key => $item) {
                $refCSLocation = '';
                $refCSSku = '';
                $refCSSkuQty = '';

                $volumn = $item->width * $item->length * $item->height / 1000;

                $item_weight = sprintf("%06d", round($item->weight, 1) * 10);

                $srg = 'N';
                $nsr = 'Y';

                if ($settings['serviceDescription'] == "B2C"){
                    $receiver = "R";
                    $adp = 'N';
                } else {
                    $receiver = "B";
                    $adp = 'N';
                }
                $trackingNumber = $barcodes[$key];
                $items[] = [
                    'trackingNumber' => $trackingNumber,
                    'qty' => $item->qty,
                    'width' => $item->width,
                    'weight' => $item->weight,
                    'height' => $item->height,
                    'length' => $item->length,
                    'qrcode' => str_pad($trackingNumber, 22) . str_pad("B", 1) . str_pad($connote, 20) . str_pad(date('ymd'), 6) . str_pad($item_weight, 6) . str_pad(' ', 2) . str_pad(sprintf("%04d", $item->length), 4) . str_pad(sprintf("%04d", $item->width), 4) . str_pad(sprintf("%04d", $item->height), 4) . str_pad(sprintf("%05d", $volumn), 5) . str_pad($settings['serviceCode'], 3) . str_pad(' ', 18) . str_pad('N', 1) . str_pad('N', 1) . str_pad(' ', 10) . str_pad($adp, 1) . str_pad($nsr, 1) . str_pad('N', 1) . str_pad($srg, 1) . str_pad('N', 1) . str_pad(' ', 4) . str_pad(' ', 11) . str_pad('R', 1) . str_pad($payor, 10) . str_pad(' ', 9) . str_pad($receiver_name, 40) . str_pad($receiver_street1, 30) . str_pad($receiver_street2, 30) . str_pad($receiver_suburb, 30) . str_pad($receiver_postcode, 10) . str_pad('AU', 2) . str_pad(' ', 14) . str_pad($receiver, 1) . str_pad($receiver_phone, 10) . str_pad(' ', 18) . str_pad('TF2', 3),
                    'refCSLocation' => $refCSLocation,
                    'refCSSku' => $refCSSku,
                    'refCSSkuQty' => $refCSSkuQty
                ];
            }
           
        $ii = json_encode($items);
        $items = json_decode($ii);

        foreach ($items as $itemkey => $item) {
            $sequence++;
            if($sn!=0 && $itemkey!=($sn-1)) continue;
            $package_dimensions = 'L:' . $item->length . 'cm &nbsp;&nbsp;W:' . $item->width . 'cm &nbsp;&nbsp;H:' . $item->height;
            $item_weight = $item->weight . "KG";

            $pdf = new \TCPDF(PDF_PAGE_ORIENTATION, PDF_UNIT, 'A6', true, 'UTF-8', false);
            $pdf->setPrintHeader(false);
            $pdf->setPrintFooter(false);

            $pdf->SetDefaultMonospacedFont(PDF_FONT_MONOSPACED);

            $pdf->SetMargins(PDF_MARGIN_LEFT, PDF_MARGIN_TOP, PDF_MARGIN_RIGHT);

            $pdf->SetAutoPageBreak(false, PDF_MARGIN_BOTTOM);

            $pdf->setImageScale(PDF_IMAGE_SCALE_RATIO);

            $pdf->SetFont('verdana', '', 10, '', true);

            $pdf->AddPage('P', '', false, false);

            $toll = '<div style="font-family:Verdana;font-size:13px">' . "TOLL" . '</div>';
            $pdf->writeHTMLCell(12, 4, 4.1, 1.3, $toll, false, 0, 0, '', true);

            $carrier = '<div style="font-family:Verdana;font-size:7.5px">' . "IPEC" . '</div>';
            $pdf->writeHTMLCell(0, 0, 24, 2.2, $carrier, false, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:7.5px;">DESP:' . $desp . '</div>';
            $pdf->writeHTMLCell(0, 0, 56.9, 2.2, $html, false, 0, 0, '', true);

            $depot = '<div style="font-family:Verdana;font-size:9px;font-weight: bold;;text-align: center">' . $depotCode . '</div>';
            $pdf->writeHTMLCell(10, 5, 79.3, 5.5, $depot, 1, 0, 0, '', 0);

            $indicator = '<div style="font-family:Verdana;font-size:13px;font-weight: bold;color: white;text-align: center">' . "R" . '</div>';
            $pdf->writeHTMLCell(8, 5, 90.7, 5.5, $indicator, 1, 0, 1, '', 0);

            $service = '<div style="font-family:Verdana;font-size:10px;font-weight: bold;color: white">' . $shippingMethodCode . '</div>';
            $pdf->writeHTMLCell(75, 4, 2.4, 6.5, $service, 1, 0, 1, '', true);

            $html = '<div style="font-family:Verdana;font-size:10px;font-weight:bold;">' . 'CONNOTE#:<font style="font-size:12px;">' . $connote . '</font></div>';
            $pdf->writeHTMLCell(0, 0, 2.4, 10.7, $html, 0, 0, 0, '', true);

            $to = '<div style="font-family:Verdana;font-size:10px;font-weight: bold;">' . "TO :" . '</div>';
            $pdf->writeHTMLCell(0, 0, 2.4, 15.7, $to, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:10px;">' . $receiver_name . '</div>';
            $pdf->writeHTMLCell(46, 0, 11.3, 15.7, $html, 0, 0, 0, '', true);

            $receiver_street1 = isset($receiver_street1) ? $receiver_street1 : '';
            $receiver_street2 = isset($receiver_street2) ? $receiver_street2 : '';

            $html = '<p style="font-family:Verdana;font-size:11px;line-height:12px;">'.$receiver_company . $receiver_street1 . '<br/>' . $receiver_street2 . '</p>';
            $pdf->writeHTMLCell(50, 10, 2.4, 22.5, $html, 0, 0, 0, '', false);

            $html = '<div style="font-family:Verdana;font-size:11px;font-weight: bold">' . $receiver_suburb . '</div>';
            $pdf->writeHTMLCell(44, 0, 2.4, 32.6, $html, 0, 0, 0, '', false);

            $html = '<div style="font-family:Verdana;font-size:12px;font-weight: bold">' . $receiver_postcode . '</div>';
            $pdf->writeHTMLCell(0, 0, 35.2, 36, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:14px;font-weight: bold">' . $receiver_state . '</div>';
            $pdf->writeHTMLCell(0, 0, 2.4, 36, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:8px;">' . "Phone: " . $receiver_phone . '</div>';
            $pdf->writeHTMLCell(0, 0, 2.4, 40.5, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:8px;">' . "Contact: " . $receiver_contact . '</div>';
            $pdf->writeHTMLCell(0, 0, 2.4, 42.7, $html, 0, 0, 0, '', true);

            $INSTRUCTIONS = '<div style="font-family:Verdana;font-size:6px;font-weight: bold">' . "SPECIAL INSTRUCTIONS:" . '</div>';
            $pdf->writeHTMLCell(0, 0, 2.4, 47, $INSTRUCTIONS, 0, 0, 0, '', true);

            $instruction = isset($instruction) ? $instruction : '';

            $html = '<div style="font-family:Verdana;font-size:6.5px;">' . $instruction . '</div>';
            $pdf->writeHTMLCell(43, 3.5, 2.4, 49, $html, 0, 0, 0, '', false);

            $html = '<div style="font-family:Verdana;font-size:10px;font-weight:bold;">Cref:' . $model->cref . '</div>';
            $pdf->writeHTMLCell(43, 3.5, 2.4, 51, $html, 0, 0, 0, '', false);

             $service = '<div style="font-family:Verdana;font-size:10px;font-weight: bold;color: white">  RELEASE DATE:' . $desp . '</div>';
            $pdf->writeHTMLCell(45, 4, 2.4, 57, $service, 1, 0, 1, '', true);

            // $banner = '<div style="font-family:Verdana;font-size:6px;font-weight: bold;text-align: center;color:white;">' . " " . '</div>';
            // $pdf->writeHTMLCell(45, 4, 3.4, 57, $banner, 1, 0, 0, '', true);

            $style = array(
                'border' => false,
                'padding' => -10,
                'bgcolor' => false,
                'fgcolor' => array(0, 0, 0),
                'module_width' => 1,
                'module_height' => 1
            );

            $pdf->write2DBarcode($item->qrcode, 'QRCODE,L', 62, 22.5, 60, 60, $style, 'M');

            $dangerous = '<div style="font-family:Verdana;font-size:7px;font-weight: bold;text-align: center">' . "DG'S NO" . '</div>';
            $pdf->writeHTMLCell(12, 6, 3.4, 62, $dangerous, 1, 0, 0, '', true);

            if ($settings['serviceDescription'] == "B2C") {
                $adp = '<div style="font-family:Verdana;font-size:11px;font-weight: bold;">' . "ADP" . '</div>';
                $pdf->writeHTMLCell(12, 6, 18.8, 62.1, $adp, 1, 0, 0, '', true);
            } else {
                $adp = '<div style="font-family:Verdana;font-size:11px;font-weight: bold;">' . "" . '</div>';
                $pdf->writeHTMLCell(12, 6, 18.8, 62.1, $adp, 1, 0, 0, '', true);
            }

            if ($srg == 'Y') {
                $nsr = '<div style="font-family:Verdana;font-size:5px;font-weight: bold;text-align: center">' . "Signature Required" . '</div>';
            } else {
                $nsr = '<div style="font-family:Verdana;font-size:11px;font-weight: bold;text-align: center">' . "NSR" . '</div>';
            }

            $pdf->writeHTMLCell(12, 6, 34.3, 62.2, $nsr, 1, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:8px;font-weight: bold;"><font style="font-size:16px;">' . $sequence . '</font> of ' . $total_count . '</div>';
            $pdf->writeHTMLCell(16, 6, 54.9, 62.6, $html, 1, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:5px;font-weight: bold;text-align: center">' . $package_dimensions . '</div>';
            $pdf->writeHTMLCell(12, 6, 73.4, 62.6, $html, 1, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:10px;font-weight: bold;color:white;text-align: center">' . $item_weight . '</div>';
            $pdf->writeHTMLCell(12, 6, 87.7, 62.6, $html, 1, 0, 1, '', true);

            $barcode_style = array(
                'position' => '',
                'align' => 'C',
                'stretch' => false,
                'fitwidth' => true,
                'cellfitalign' => '',
                'border' => false,
                'hpadding' => 'auto',
                'vpadding' => 'auto',
                'fgcolor' => array(0, 0, 0),
                'bgcolor' => false, //array(255,255,255),
                'text' => false,
                'font' => 'helvetica',
                'fontsize' => 8,
                'stretchtext' => 4
            );
            $pdf->write1DBarcode(chr(241) . "421036" . $receiver_postcode . chr(241) . "403" . $settings['serviceCode'], 'C128', 8, 67.6, '', 32, 0.45, $barcode_style, 'N');
            $pdf->SetFontSize(8);
            $pdf->writeHTMLCell(0, 0, 2, 96, '(421) 036' . $receiver_postcode . ' (403) ' . $settings['serviceCode'], 0, 0, 0, '', true);

            $pdf->write1DBarcode(chr(241) . $item->trackingNumber, 'C128', 8, 99.9, '', 32, 0.55, $barcode_style, 'N');
            $pdf->writeHTMLCell(0, 0, 2, 128, '(00) ' . substr($item->trackingNumber, 2,strlen($item->trackingNumber)-3).' '.substr($item->trackingNumber, strlen($item->trackingNumber)-1,strlen($item->trackingNumber)), 0, 0, 0, '', true);

            $pdf->writeHTMLCell(100, 0, 3.9, 133.5, "<hr>", 0, false, false, false, '');

            $pdf->StartTransform();
            $pdf->Rotate(-90);
            $pdf->SetX(1);
            $pdf->SetFontSize(6);
            $pdf->Cell(1, 0, '                                                               THIS ITEM WILL BE SUBJECT TO SECURITY SCREEING CLAUSE', 0, 0, false, 0, '', 0);
            $pdf->StopTransform();

            $pdf->StartTransform();
            $pdf->Rotate(-270);
            $pdf->SetX(0);
            $pdf->SetFontSize(6);
            $pdf->Cell(1, 0, 'CARRIER\'S TERMS AND CONDITIONS APPLY', 0, 0, false, 0, '', 0);
            $pdf->StopTransform();

            $sender = '<div style="font-family:Verdana;font-size:5px;font-weight: bold">' . "FROM: " . '</div>';
            $pdf->writeHTMLCell(0, 0, 4, 133.5, $sender, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:5px;">' . $sender_name . '</div>';
            $pdf->writeHTMLCell(0, 0, 9.5, 133.5, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:5px;">' . $sender_suburb_state . '</div>';
            $pdf->writeHTMLCell(0, 0, 4, 135.2, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:5px;">' . $sender_postcode . '</div>';
            $pdf->writeHTMLCell(0, 0, 4, 136.6, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:5px;font-weight: bold">' . $sender_country . '</div>';
            $pdf->writeHTMLCell(0, 0, 9, 136.6, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:6px;font-weight: bold">' . $sender_address. '</div>';
            $pdf->writeHTMLCell(0, 0, 40, 133.5, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:12px;">' . "REF: " . $ref . '</div>';
            $pdf->writeHTMLCell(0, 0, 4, 138.1, $html, 0, 0, 0, '', true);

            $description = '<div style="font-family:Verdana;font-size:5px;font-weight: bold;">' . "Description of Goods:" . '</div>';
            $pdf->writeHTMLCell(0, 0, 4, 142.3, $description, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:5px;">' . $description_detail . '</div>';
            $pdf->writeHTMLCell(0, 0, 30.7, 143.3, $html, 0, 0, 0, '', true);

            $declaration = '<div style="font-family:Verdana;font-size:5.5px;font-weight: bold;">' . "DECLARATION BY:" . '</div>';
            $pdf->writeHTMLCell(0, 0, 4, 144.5, $declaration, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:5.5px;">' . $declaration_person . '</div>';
            $pdf->writeHTMLCell(0, 0, 26.3, 144.5, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:5.5px;">' . $dangerous_good_declarartion . '</div>';
            $pdf->writeHTMLCell(0, 0, 4, 146, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:25px;">' . $refCSSkuQty . '</div>';
            $pdf->writeHTMLCell(0, 0, 52, 137.5, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:10px;text-align: left">' . $refCSLocation . '</div>';
            $pdf->writeHTMLCell(40, 0, 62.5, 137.5, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:10px;text-align: left">' . $refCSSku . '</div>';
            $pdf->writeHTMLCell(40, 0, 62.5, 143.5, $html, 0, 0, 0, '', true);

            $f = tempnam(Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR."temp".DIRECTORY_SEPARATOR, 'pp');
            $pdf->Output($f, 'F');
            $ps[] = $f;
        }
        if($tp===3)
        {
            return oPDF::mergePDF($ps, 0, true);
        }elseif($tp)
        {
            return oPDF::mergePDF($ps, 2, false);
        }else
        {
            oPDF::mergePDF($ps, 1, true, 'label.pdf');
        }
    }


