            $html = '<div style="font-family:Verdana;font-size:8px;">' . "Cref: " . $model->cref. '</div>';
            $pdf->writeHTMLCell(0, 0, 65, 40.5, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:8px;">CONSIGNMENT:</div>';
            $pdf->writeHTMLCell(0, 0, 2.4, 49.7, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:20px;font-weight:bold;">' . $model->ref . '</div>';
            $pdf->writeHTMLCell(60, 3.5, 2.4, 52, $html, 0, 0, 0, '', false);

            $borderLine = '<div style="font-family:Verdana;font-size:10px;font-weight: bold;color: white;text-align: center;">&nbsp;</div>';
            $pdf->writeHTMLCell(100.5, 2, 2.1, 59, $borderLine, 1, 0, 1, '', 0);

            $html = '<div style="font-family:Verdana;font-size:12px;font-weight: bold;"><font style="font-size:16px;">Label ' . $sequence . '</font> of ' . $total_count . '</div>';
            $pdf->writeHTMLCell(40, 6, 70, 62.6, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:12px;font-weight: bold;"><font style="font-size:14px;">ETA: </div>';
            $pdf->writeHTMLCell(40, 6, 70, 46.6, $html, 0, 0, 0, '', true);


            $barcode_style = array(
                'position' => '',
                'align' => 'C',
                'stretch' => false,
                'fitwidth' => true,
                'cellfitalign' => '',
                'border' => false,
                'hpadding' => 'auto',
                'vpadding' => 'auto',
                'fgcolor' => array(0, 0, 0),
                'bgcolor' => false, //array(255,255,255),
                'text' => false,
                'font' => 'helvetica',
                'fontsize' => 8,
                'stretchtext' => 4
            );
            $pdf->write1DBarcode(chr(241) . "401" . chr(241) . "9347780" . $model->ref, 'C128', 3, 67.6, 98, 32, 0.45, $barcode_style, 'N');
            $pdf->SetFontSize(8);
            $pdf->writeHTMLCell(0, 0, 15, 96, '(401) '. "9347780 " . $model->ref, 0, 0, 0, '', true);



            $pdf->write1DBarcode(chr(241) . $item->trackingNumber, 'C128',3, 105, 98, 32, 0.55, $barcode_style, 'N');
            $pdf->writeHTMLCell(0, 0, 15, 133, $item->trackingNumber, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:12px;font-weight: bold;"><font style="font-size:14px;">Created: '.$model->created.'</div>';
            $pdf->writeHTMLCell(50, 14, 59, 141, $html, 0, 0, 0, '', true);
            

            $f = tempnam(Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR."temp".DIRECTORY_SEPARATOR, 'pp');
            $pdf->Output($f, 'F');
            $ps[] = $f;
        }
        if($tp===3)
        {
            return oPDF::mergePDF($ps, 0, true);
        }elseif($tp)
        {
            return oPDF::mergePDF($ps, 2, false);
        }else
        {
            oPDF::mergePDF($ps, 1, true, 'label.pdf');
        }
    }

    public static function checkNoneImParcelRTSInvoice($shipment)
    {
        [$app_name, Yii::app()->name] = [Yii::app()->name, 'HVLV APP'];
        $pcae = InvLine::model()->with('invoice')->together(true)->count('model=:m AND fid=:fid AND invoice.type = 36 AND invoice.status < 10', [':m'       => 'ImParcel', ':fid' => $shipment->id]) == 0;
        Yii::app()->name = $app_name;
        
        [$app_name, Yii::app()->name] = [Yii::app()->name, 'TLA'];
        $tla = InvLine::model()->with('invoice')->together(true)->count('model=:m AND fid=:fid AND invoice.type = 36 AND invoice.status < 10', [':m' =>      'ImParcel', ':fid' => $shipment->id]) == 0;
        Yii::app()->name = $app_name;
        return $pcae && $tla;
    }

    public static function getImParcelRTSInvoice($shipment)
    {
        $result = [];
        [$app_name, Yii::app()->name] = [Yii::app()->name, 'HVLV APP'];
        $pcae = Invoice::model()->with('lines')->findAll('lines.model=:m AND lines.fid=:fid AND t.type = 36 AND t.status < 10', [':m'  => 'ImParcel', ':fid' => $shipment->id]);
        Yii::app()->name = $app_name;
        
        [$app_name, Yii::app()->name] = [Yii::app()->name, 'TLA'];
        $tla = Invoice::model()->with('lines')->findAll('lines.model=:m AND lines.fid=:fid AND t.type = 36 AND t.status < 10', [':m' => 'ImParcel', ':fid' => $shipment->id]);
        Yii::app()->name = $app_name;

        return array_merge($pcae,$tla);
    }

    public static function getStartrackInvAmount($p)
    {
        $orgRate = OrgRate::model()->find('org_id = :oid AND type = 40', [':oid' => $p->agent_id]);
        $rate = $p->getChargePro($p->agent, $orgRate, false);
        if (is_numeric($rate) && $rate > 0) {
            return $rate;
        } else {
            return 999;
        }
    }
    public static function getRtsRate($orgId, $p = null)
    {

        $courier = self::getCourier($p);

        // get organizaton price rate
        $orgRate = OrgRate::model()->find('org_id = :oid AND type = 40', [':oid' => $orgId]);
        if (empty($orgRate)) {
            return 0;
        }

        // get org rate details
        $rateInfo = json_decode($orgRate['meta']);
        $code = 'AU'; // RTS fee belongs to Australia local
        $rtsFee = 0;
        if ($courier == 'fastway') {
            if (isset($rateInfo->$code->rts_rate_fast)) {
                $rtsFee = floatval($rateInfo->$code->rts_rate_fast);
            }
        } elseif (in_array($courier, ['startrack', 'tnt','dfe'])) {
            if (isset($rateInfo->$code->rts_rate_star)) {
                $rtsFee = floatval($rateInfo->$code->rts_rate_star) * self::getStartrackInvAmount($p) / 100;
            }
        } elseif ($courier == 'letter') {
            $rtsFee = 0;
        } elseif (isset($rateInfo->$code->rts_rate)) {
            $rtsFee = floatval($rateInfo->$code->rts_rate);
        }
        return $rtsFee;
    }

    public static function getCourier($p)
    {
        $courier = 'aus';

        if (preg_match('/LET\d{7}/i', $p->ref)) {
            $courier = 'letter';
        }else{
            $sql = 'SELECT org_id FROM `tranship` WHERE pid = '.$p->id.' AND connote = "'.$p->ref.'" ORDER BY id DESC LIMIT 1';
            $t = Yii::app()->getDb()->createCommand($sql)->queryScalar();
            if(!empty($t)){
                switch($t){
                    case Org::ORGID_COURIER_FASTWAY:
                        $courier = 'fastway';
                    break;
                    case Org::ORGID_COURIER_STARTRACK:
                        $courier = 'startrack';
                    break;
                    case Org::ORGID_COURIER_TNT:
                        $courier = 'tnt';
                    break;
                    case Org::ORGID_COURIER_TNT_TOP:
                        $courier = 'tnt';
                    break;
                    case Org::ORGID_COURIER_DFE:
                        $courier = 'dfe';
                    break;
                    case Org::ORGID_COURIER_DFE_TOP:
                        $courier = 'dfe';
                    break;
                }
            }
        }
        return $courier;
    }

    public function import3PLSubShipments($file,$testOnly = false,$manifestId,$sheetIndex = 1,$deleteOrgShipment = true)
    {
        $errors=[];
        $successes = [];
        $orgShipments =[];
        $subShipments = [];
        if (!empty($file)) {
            $packagesInfo = $this->getAustwayPackagesData($file['name'],$file['tmp_name'],true); 
            $fileData = $this->getFileData($file);
            if(empty($fileData[$sheetIndex]))
            {
                 $errors[]='<span class="fail_result">Sheet2: Empty Sub Shipment Data</span>';
            }

            if (!empty($errors)) {
               return  $errors;
            }
            $data = $fileData[$sheetIndex];
            unset($data[1]);
            $checkArray=[];

            foreach ($data as $index=> $d)
            {
                if (empty($d[1])) {
                    continue;
                }
                $cref = $d[1];
                $labelOrder = $d[2];
                $blueLabel = $d[3];
                $myCref = $d[4];
                $weight = $d[5];
                $cbm = $d[6];
                $pkg = $d[7];
                $company = $d[8];
                $address = $d[9];
                $suburb = $d[10];
                $postcode = $d[11];
                $consignee = $d[12];
                $tel = $d[13];
                $chargeCode = $d[14];
                $state = $d[15];
                $email = "";
                if(!empty($d[16]))
                {
                    $email = $d[16];
                }
                $extra = [];
                if(!empty($d[17]))
                {
                    $extra['amazon_po'] = $d[17];
                }
                if(!empty($d[18]))
                {
                    $extra['amazon_shipment_ids'] = $d[18];
                }

                if(!empty($d[19]))
                {
                    $extra['pe_number'] = $d[19];
                }
                $myCnee = new Addr;
                $myCnee->address = $address;
                $myCnee->suburb = $suburb;
                $myCnee->postcode = $postcode;
                $myCnee->tel = $tel;
                $myCnee->company = $company;
                $myCnee->name = $consignee;
                $myCnee->state = $state;
                $myCnee->email = $email;
                $labelOrderArr= explode('-', $labelOrder);
                $labelLo  = $labelOrderArr[0];
                $labelHi  = count($labelOrderArr)==1?$labelOrderArr[0]:$labelOrderArr[1];

                if(empty($blueLabel))
                {
                    $errors[] = '<span class="fail_result">Sheet'.($sheetIndex+1).': line '.($index) .': empty blue label </span>';
                    continue;
                }

                if(!is_numeric($labelLo)||!is_numeric($labelHi))
                {
                    $errors[] = '<span class="fail_result">Sheet'.($sheetIndex+1).': line '.($index) .': wrong label order format</span>';
                    continue;
                }else
                {
                    if((($labelHi-$labelLo)+1)!=$pkg)
                    {
                        $errors[] = '<span class="fail_result">Sheet'.($sheetIndex+1).': line '.($index) .': wrong label order doesn\'t match the packages number of shipment</span>';
                        continue;
                    }
                }

                $orgShipment = ImParcel::model()->find(['condition'=>'cref = :cref and status !=100','params'=>[':cref'=>$cref],'order'=>'id desc']);

                if(empty($orgShipment))
                {
                    $errors[] = '<span class="fail_result">Sheet'.($sheetIndex+1).': line '.($index) .': can\'t find customer reference number </span>';
                    continue;
                }

                $orgShipments[$orgShipment->id] = $orgShipment;

                $check = ImParcel::model()->count(['condition'=>'(cref = :cref or hbn =:cref) and status !=100','params'=>[':cref'=>$myCref],'order'=>'id desc']);
                if($check>0)
                {
                    $errors[]='<span class="fail_result">Sheet'.($sheetIndex+1).': line '.($index) .': '.$myCref.' is existed</span>';
                    continue;
                }

                $imcoConsol = ImcoConsol::model()->find('no = :cref and status !=100',[':cref'=>'WDT'.preg_replace('/[a-zA-Z]/', '', $orgShipment->ref)]);
                if(empty($imcoConsol))
                {
                    $imcoConsol = new ImcoConsol();
                    $imcoConsol->no = 'WDT'.preg_replace('/[a-zA-Z]/', '', $orgShipment->ref);
                    $imcoConsol->owner_id = $orgShipment->agent_id; // currently set as top logistics
                    $imcoConsol->pol = 'AUSYD';
                    $imcoConsol->pod = 'AUSYD';
                    $imcoConsol->dpt_id = $orgShipment->ddpt_id;
                    $imcoConsol->eta = date('Y-m-d');
                    $imcoConsol->created = date('Y-m-d');
                    $imcoConsol->status = 10;
                    $imcoConsol->save();

                    if(!$testOnly)
                    {
                        $imcoConsol->save();
                    }
                }
                // if (!empty($d[2])) {
                //     if (in_array($d[2], $checkArray)) {
                //         {echo  '<div style="color:red;">Line '.$index.": connote ".$d[2]. " duplicate".'</div>'; return;}
                //     }
                //     $checkArray[]=$d[2];
                // }
                $o = new stdClass();
                $o->error = [];
                $subShipment = $this->_funcCopyShipment($orgShipment,$myCref,$myCref,$myCnee,$chargeCode,$pkg,$weight,$cbm,true,$extra);
                $subShipment->mdata['blueLabel'] = $blueLabel;
                $subShipment->mdata['labelOrder'] = $labelOrder;
                $subShipment->consol_id = $imcoConsol->id;
                $subShipment->man_id = $manifestId;
                $rc = ChooseShipment::checkShipment($subShipment,$packagesInfo);
                $subShipments[] = $subShipment;
                if(!$rc->success)
                {
                    $errors[] ='<span class="fail_result">Sheet'.($sheetIndex+1).': line '.($index) .': '.implode('; ', $rc->error).'</span>';
                    continue;
                }

                $rt = ChooseShipment::selectServiceByChargeCode($chargeCode, $subShipment,'AU', $testOnly);
                $reply = ChooseShipment::funcAfterSelectServiceByChargeCode($o,$subShipment,$rt,false,$testOnly,true);

                if (!$reply->success) {
                        $errors[]='<span class="fail_result">Sheet'.($sheetIndex+1).': line '.($index) .': '.implode('; ', $reply->error).'</span>';
                }else
                {
                    // if($rt->courier->code==ImportChargeCode::PICKUP_CODE)// 2023-04-01 todo
                    // {
                    //     $errors[] ='<span class="fail_result">Sheet'.($sheetIndex+1).': line '.($index).'Sub Shipment do not allow pickup</span>';
                    //     continue;
                    // }
                    if(!$testOnly)
                    {
                        $importsShipmentRelations = new ImportsShipmentRelations('create');
                        $importsShipmentRelations->cid = $subShipment->id;
                        $importsShipmentRelations->pid = $orgShipment->id;
                        $importsShipmentRelations->label_lo = $labelLo;
                        $importsShipmentRelations->label_hi = $labelHi;
                        $importsShipmentRelations->blue_label = $subShipment->mdata['blueLabel'];
                        $importsShipmentRelations->created = date('Y-m-d H:i:s');
                        $importsShipmentRelations->save();
                        if(!$testOnly)
                        {
                            $imcoConsol->dpt_id = $subShipment->ddpt_id;
                            $imcoConsol->save();
                        }
                    }
                    $successes[] ='<span class="success_result">Sheet'.($sheetIndex+1).': line '.($index) .': '.$reply->msg.'</span>';
                }
            }

            if(!empty($errors))
            {
                if($deleteOrgShipment)
                {
                    foreach($orgShipments as $key => $orgShipment)
                    {
                        if($orgShipment->status<=ImParcel::NEW_STATUS)
                        {
                            $orgShipment->status = 100;
                            $orgShipment->save();
                        }
                    }

                    foreach ($subShipments as $key => $subShipment)
                    {
                        $subShipment->status = 100;
                        $subShipment->save();
                    }
                }
            }
            sleep(2);
            return  [$errors,$successes];
        }
        sleep(2);
        return  [$errors,$successes];
    }

    public function _funcCopyShipment($orgShipment,$hbn,$myCref,$myCnee,$chargeCode,$pkg,$weight,$cbm,$noSave = false,$extra=[])
    {
        $newShipment = new ImParcel('create');
        $newShipment->attributes = $orgShipment->attributes;
        $newShipment->hbn = $hbn;
        $newShipment->cref = $myCref;
        $newShipment->ot_id = 10;
        $cnor = new Addr;
        $cnor->attributes = $orgShipment->cnor->attributes;
        if(!$noSave)
        {
            $cnor->save();
            $newShipment->cnor_id = $cnor->id;
        }else
        {
            $newShipment->cnor = $cnor;
        }
        $cnee = new Addr;
        $cnee->attributes = $orgShipment->cnee->attributes;
        $cnee->address = $myCnee->address;
        $cnee->suburb = $myCnee->suburb;
        $cnee->city = "";
        $cnee->postcode = $myCnee->postcode;
        $cnee->tel = $myCnee->tel;
        $cnee->company = $myCnee->company;
        $cnee->name = $myCnee->name;
        $cnee->state = $myCnee->state;
        $cnee->email = $myCnee->email;
        if(!$noSave)
        {
            $cnee->save();
            $newShipment->cnee_id = $cnee->id;
        }else
        {
            $newShipment->cnee = $cnee;
        }
        $newShipment->eitems = $orgShipment->eitems;
        if(!empty($newShipment->eitems['v']))
        {
            foreach ($newShipment->eitems['v'] as $key => $value) {
                $newShipment->eitems['v'][$key] = 1;
            }
            foreach ($newShipment->eitems['q'] as $key => $value) {
                $newShipment->eitems['q'][$key] = 1;
            }
        }
        $newShipment->mdata = [];
        $newShipment->mdata['chargecode'] = $chargeCode;
        $newShipment->mdata['oref'] = $orgShipment->ref;
        $newShipment->ref = '';
        $newShipment->can = "";
        $newShipment->status = 42;//set as local arrival
        $newShipment->consol_id = 0;
        $newShipment->created = date('Y-m-d');
        $newShipment->weight = $weight;
        $newShipment->pkg =$pkg;
        $newShipment->scan_no = $pkg;
        $newShipment->cbm = $cbm;
        $newShipment->postcode = $myCnee->postcode;
        $newShipment->state = $myCnee->state;
        $newShipment->scan = "";
        $newShipment->mdata['total_cbm'] = round($newShipment->cbm*$pkg,2);
        foreach ($extra as $key => $value) {
            $newShipment->mdata[$key] = $value;
        }

        // save original RTS shipment No.
        $newShipment->note .= $orgShipment->ref;
        $newShipment->bwf = 0;

        return $newShipment;
    }

    public function checkImparcelIsCheckInByBag($p)
    {
       $bagTags = ImportBagTag::model()->findAll('shipment_id = :id ',[':id'=>$p->id]);

       foreach ($bagTags as $key => $bagTag) {
           $check = ShipmentScan::model()->count('pid = :pid and type = :type',[':pid'=>$bagTag->import_bag_id,':type'=>ShipmentScan::BAG_CHECK_TYPE]);
           if($check>0)
           {
             return true; 
           }
       }

       return false;
    }

    public function imparcelScanAll($p)
    {
        $st = 0;
        if(!empty($p->mdata['scan_time']))
        {
            $st = strtotime($p->mdata['scan_time'])+300;
        }else
        {
            $st = $p->consol->getMinScanTime();
            if(!empty($st)) $st = strtotime($st)+300;
        }
        $et = $p->consol->mdata['ctn_comp_time'];
        if(empty($et))
        {
            return "Empty Consol Complete Time";
        }
        $et = strtotime($et);
        if(empty($st))
        {
            $st = $et-1800;
        }
        $diff = $et - $st;

        $scanTime = '';
        if ( !empty($p) ) {
            if($p->pkg > 1000){
                if($p->pkg > 1000){
                    $pt = $st + rand(10, $diff);
                    $p->scan_data[50]['SCAN_ALL'] = date('Y-m-d H:i:s', $pt);
                }
            }else{
                for ($j = 1; $j <= $p->pkg; $j++) {
                    if (!empty($p->scan_data[50][$p->hbn . '-' . $j]))
                    {
                        if(empty($scanTime)||strtotime($p->scan_data[50][$p->hbn.'-'.$j])<strtotime($scanTime))
                        {
                            $scanTime = $p->scan_data[50][$p->hbn.'-'.$j];
                        }
                        continue;
                    }
                    $pt = $st + rand(10, $diff);
                    $p->scan_data[50][$p->hbn . '-' . $j] = date('Y-m-d H:i:s', $pt);
                    if(empty($scanTime)||strtotime($p->scan_data[50][$p->hbn.'-'.$j])<strtotime($scanTime))
                    {
                        $scanTime = $p->scan_data[50][$p->hbn.'-'.$j];
                    }
                }
            }
            if(empty($p->mdata['scan_time'])||$p->mdata['scan_time']!=$scanTime)
            {
                ShipmentScan::genShipmentScan($p, 0, 0, $p->consol->dpt_id, 3600,$p->hbn,$scanTime);
                $p->mdata['scan_time'] = $scanTime;
                $p->updateDeconsolidationTime(false,false,true);
            }
            // $p->updateUnScan();
            $p->save();
            $courier_id = null;
            if (empty($courier_id)) 
            {
                $courier_id=$p->getCourierId();
            }
            $action = "ScanAllByHand";
            GatepassShipment::gatepassScan($p, $courier_id, 1, $p->consol->dpt_id,$action);
            return "Done";
        } else {
            return 'Shipment not found!';
        }
    }

    public function normalScanAll($p){
        $st = time() - rand(2000, 6000);
        if ( !empty($p) ) {
            if($p->pkg > 1000){
                if($p->pkg > 1000){
                    $pt = $st + rand(10, 100 * $i);
                    $p->scan_data[50]['SCAN_ALL'] = date('Y-m-d H:i:s', $pt);
                }
            }else{
                for ($j = 1; $j <= $p->pkg; $j++) {
                    if (!empty($p->scan_data[50][$p->hbn . '-' . $j])) continue;
                    $pt = $st + rand(10, 100 * $j);
                    $p->scan_data[50][$p->hbn . '-' . $j] = date('Y-m-d H:i:s', $pt);
                }
            }
            if (empty($p->mdata['scan_time']))
            {
                $p->mdata['scan_time'] = date('Y-m-d H:i:s', $st);
                $p->updateDeconsolidationTime();
            }
            // $p->updateUnScan();
            $p->mdata['ScanAllByHandWDT'] = 1;
            $p->save();
            $courier_id = null;
            if (empty($courier_id)) 
            {
                $courier_id=$p->getCourierId();
            }
            $action = "ScanAllByHandWDT";
            GatepassShipment::gatepassScan($p, $courier_id, 1, $p->consol->dpt_id,$action);
            return "Done";
        } else {
            return 'Shipment not found!';
        }
    }

    public function shipmentScanAll($p)
    {
        if($p->is3PL())
        {
            return $this->normalScanAll($p);
        }else
        {
            return $this->imparcelScanAll($p);
        }
    }

    public static function isEizToll($model)
    {
        $orgRate = OrgRate::model()->findByPk($model->mdata['org_rate_id']);
        if(preg_match('/EIZ_/i', $orgRate->code)&&!empty($model->mdata['eiz_id']))
        {
            if(!empty($model->mdata['eiz_id']))
            {
                if(preg_match('/TOLL/i',$orgRate->code))
                {
                    return true;
                }else
                {
                    return false;
                }
            }
        }
        return false;
    }

    public function getAustwayPackagesData($fileName,$filePath,$isCheck = true)
    {
        $shipmentDatas = [];
        $xls = new oExcel;
        $dataAll = $xls->getSheetsFileData($filePath,$fileName,true);
        $sheetIndex = 0;
        $check1 = empty($dataAll[1])?"":$dataAll[1][1][1];
        $check2 = empty($dataAll[2])?"":$dataAll[2][1][1];
        if(preg_match('/cref/i', $check1)||trim($check1)=="客户单号")
        {
            $sheetIndex = 1;
        }elseif(preg_match('/cref/i', $check2)||trim($check2)=="客户单号")
        {
            $sheetIndex = 2;
        }
        if($sheetIndex>0)
        {
            $data = $dataAll[$sheetIndex];
            unset($data[1]);
            foreach ($data as $key => $d)
            {
                if(empty($d[1])) continue;
                $qty = $d[2];
                $weight = $d[4];
                $length = $d[6];
                $width = $d[7];
                $height = $d[8];

                for ($i=0; $i < $qty; $i++) {
                    $packObj = new stdClass();
                    $packObj->weight = $weight;
                    $packObj->width = $width;
                    $packObj->height = $height;
                    $packObj->depth = $length;

                    if(empty($shipmentDatas[$d[1]]))
                    {
                        $shipmentDatas[$d[1]] = [$packObj];
                    }else
                    {

                        $shipmentDatas[$d[1]][] = $packObj;
                    }
                }
            }

        }

        return $shipmentDatas;
    }
    public function importAustwayPackagesData($fileName,$filePath,$isCheck = true)
    {
        $errors = [];
        $successes = [];
        $xls = new oExcel;
        $xls->supported($fileName);
        $xls->load($filePath);
        $data = $xls->getAll();
        if (!isset($data[1][1])||!isset($data[1][2])||($data[1][1]!='客户单号'&&$data[1][1]!='客户单号(cref)')||$data[1][2]!='件数')
        {
            $errors[]= '<span class="fail_result">Wrong Template Supplied".</span>';
            return [$errors,$successes];
        }else
        {
            unset($data[1]);
            $shipmentDatas = [];
            foreach ($data as $key => $d)
            {
                if(empty($d[1])) continue;
                $qty = $d[2];
                $weight = $d[4];
                $length = $d[6];
                $width = $d[7];
                $height = $d[8];

                for ($i=0; $i < $qty; $i++) { 
                    if(empty($shipmentDatas[$d[1]]))
                    {
                        $shipmentDatas[$d[1]] = [['weight'=>$weight,'length'=>$length,'width'=>$width,'height'=>$height,'reference'=>0,'cbm'=>0]];
                    }else
                    {
                        $shipmentDatas[$d[1]][] = ['weight'=>$weight,'length'=>$length,'width'=>$width,'height'=>$height,'reference'=>0,'cbm'=>0];
                    }
                }

                if(empty($weight)||empty($length)||empty($width)||empty($height))
                {
                    $errors[] = 'cref '.$d[1] .'： line '.$key.' empty package data';
                }
            }
            foreach ($shipmentDatas as $cref => $s)
            {
                $pkg = count($s);
                $p = ImParcel::model()->find('(cref = :cref or hbn = :cref) and status!=100',[":cref"=>"".$cref]);
                if(!empty($p))
                {
                    $cref = $p->cref;
                }
                $shipmentPackage = ShipmentPackage::model()->find('cref = :cref',[":cref"=>"".$cref]);
                if(empty($p))
                {
                    $totalWeight =0;
                    $cbm=0;
                    $calculateCbm=0;

                    foreach ($s as $index=>$pack){
                        $totalWeight += $pack['weight'];
                        $cbm += $pack['cbm'];
                        $calculateCbm += number_format($pack['length']*$pack['width']*$pack['height']/1000000, 6, '.', '');
                    }
                    $pkg = count($s);
                    $cbm=number_format(max($cbm, $calculateCbm)/$pkg, 6, '.', '');
                    $weight= max(round($totalWeight*100)/100, 0.01);
                    if(empty($shipmentPackage))
                    {
                        $shipmentPackage = new ShipmentPackage();
                    }
                    $shipmentPackage->cref = $cref;
                    $shipmentPackage->packages = json_encode($s);
                    $shipmentPackage->cbm = $cbm;
                    $shipmentPackage->weight = $weight;
                    $shipmentPackage->pkg = $pkg;
                    $shipmentPackage->user_id = User::CurrentUserID();
                    $shipmentPackage->create = date('Y-m-d H:i:s');
                    if(!$isCheck)
                    {
                        $shipmentPackage->save();
                    }
                    $successes[] = 'cref '.$cref .': not found,the data is saved in system and waiting for shipment import';
                    continue;
                }

                if(!$p->canBeUpdated())
                {
                    $errors[] = 'cref '.$cref .': can not be updated';
                    continue;
                }

                if($pkg!=$p->pkg)
                {
                    $errors[] = 'cref '.$cref .': number of packages is '.$pkg.', but system recording is '.$p->pkg;
                    continue;
                }

                $totalWeight =0;
                $cbm=0;
                $calculateCbm=0;
                $opacks = $p->packs;
                $p->packs = [];

                foreach ($s as $index=>$pack){
                    $p->packs[$index] = $pack;
                    $totalWeight += $pack['weight'];
                    $cbm += $p->packs[$index]['cbm'];
                    $calculateCbm += number_format($p->packs[$index]['length']*$p->packs[$index]['width']*$p->packs[$index]['height']/1000000, 6, '.', '');
                }
                $cbm=number_format(max($cbm, $calculateCbm)/$p->pkg, 6, '.', '');
                $p->cbm = $cbm;
                $p->weight= round($totalWeight*100)/100;

                if(!$isCheck)
                {
                    $p->save();
                }

                if(empty($shipmentPackage))
                {
                    $shipmentPackage = new ShipmentPackage();
                    $shipmentPackage->p_packages = json_encode($opacks);
                }
                $shipmentPackage->cref = $cref;
                $shipmentPackage->packages = json_encode($s);
                $shipmentPackage->cbm = $p->cbm;
                $shipmentPackage->weight = $p->weight;
                $shipmentPackage->pkg = $p->pkg;
                $shipmentPackage->user_id = User::CurrentUserID();
                $shipmentPackage->create = date('Y-m-d H:i:s');
                if(!$isCheck)
                {
                    $shipmentPackage->save();
                }

                $successes[] = 'Cref:'.$cref.', ref: '.$p->ref.' update success';

            }
        }

        if(!$isCheck&&empty($errors))
        {
            $manifest=new Manifest();
            $manifest->type=300;
            $manifest->fwd_id= User::currentUserOrgId();
            $manifest->save();
            FileRepo::storeFile($filePath,$fileName, 300, $manifest->id);
        }

        return [$errors,$successes];
    }

    public function checkParcelLabelSurcharge($imparcel,$labelNumber,$itemCode)
    {
        $suStatus = 0;
        $myValue = 0;
        $weight = 0;
        $packCBM - 0;
        $pl = ParcelBarcode::model()->find('sub_ref = :sref',[":sref"=>$labelNumber]);
        if(empty($pl)&&!empty($imparcel))
        {
            $suStatus = 2;
            $myValue = 0;
            return [$suStatus,$myValue,$weight,$packCBM];
        }
        elseif(empty($pl)&&empty($imparcel))
        {
            $suStatus = 0;
            $myValue = 0;
            return [$suStatus,$myValue,$weight,$packCBM];
        }

        $packs = $imparcel->mdata['ubi_toll'];
        $index =0;
        $packsToSingle = [];
        foreach ($packs as $key => $value) {
           for ($i=0; $i < $value['qty']; $i++) {
               $packsToSingle[] = $value;
           }
        }
        $checkPack = $packsToSingle[$pl->sn-1];
        $weight = $checkPack['weight'];
        $packCBM = ($checkPack['length']*$checkPack['width']*$checkPack['width']/1000000);
        if(!empty($imparcel)&&$itemCode=='Tailgate')
        {
            $suStatus = 1;
            $myValue = 72.5;
        }elseif(!empty($imparcel)&&$itemCode=='MH')
        {
            if($checkPack['weight']>=30||$checkPack['length']>=120||$checkPack['width']>=80||$checkPack['width']>=60)
            {
                $suStatus = 1;
                $myValue = 12;
            }
        }elseif(!empty($imparcel)&&$itemCode=='OS')
        {
            if($checkPack['weight']>=35||$checkPack['length']>=180||$checkPack['width']>=180||$checkPack['width']>=180||$packCBM>=0.7)
            {
                $suStatus = 1;
                $myValue = 50;
            }
        }elseif(!empty($imparcel)&&$itemCode=='Onforwarding')
        {
           $remoteCostRate = RemoteChargeRate::model()->find("rate_id = :rateId and (postcode =:postcode or CONCAT('0',postcode)=:postcode) and upper(suburb) = :suburb ",[":rateId"=>ImportChargeCode::MYTOLL_SYD_ID,":postcode"=>$imparcel->cnee->postcode,":suburb"=>strtoupper($imparcel->cnee->suburb)]);
           if($remoteCostRate->base==9.5||$remoteCostRate->base==24.5)
           {
              $suStatus = 1;
              $myValue = $remoteCostRate->base;
           }

        }elseif(!empty($imparcel)&&$itemCode=='Remote')
        {
            $remoteCostRate = RemoteChargeRate::model()->find("rate_id = :rateId and (postcode =:postcode or CONCAT('0',postcode)=:postcode) and upper(suburb) = :suburb ",[":rateId"=>ImportChargeCode::MYTOLL_SYD_ID,":postcode"=>$imparcel->cnee->postcode,":suburb"=>strtoupper($imparcel->cnee->suburb)]);
           if($remoteCostRate->base==62.5)
           {
              $suStatus = 1;
              $myValue = $remoteCostRate->base;
           }

        }elseif(!empty($imparcel)&&$itemCode=='Redelivery')
        {
           $suStatus = 1;
           $myValue = 24;
        }elseif(!empty($imparcel)&&$itemCode=='Book')
        {
           $suStatus = 2;
           $myValue = 0;
        }elseif(!empty($imparcel))
        {
           $suStatus = 2;
           $myValue = 0;
        }

        return [$suStatus,$myValue,$weight,$packCBM];
    }

    public static function updateParcelTollLabels(&$parcel)
    {
        $pkg = $parcel->pkg;
        $barcodes  =empty($parcel->mdata['barcode'])?"":$parcel->mdata['barcode'];
        $barcodeNumbers = count(explode(',', $barcodes));
        if($barcodeNumbers<$pkg)
        {
            if(empty($parcel->mdata['org_rate_id'])) return false;
           $orgRate =  OrgRate::model()->findByPk($parcel->mdata['org_rate_id']);
           if($orgRate->org_id==Org::ORGID_COURIER_TOLL_IPEC)
           {
                self::addMyTollLabel($orgRate->id,$parcel);
           }
        }
    }

    public static function addMyTollLabel($orgRateId,&$p)
    {
        $orgRate = OrgRate::model()->find("id = :id",[":id"=>$orgRateId]);
        $code = OrgRate::model()->findByPk($orgRateId)->code;
        $type = MyTollAPI::RATE_TYPE[$code];
        if(!empty($type))
        {
            
            if ($p->id <= 0) {
                return false;
            }

            $myTollApi = new MyTollAPI($type);
            [$myRef,$barcodes,$newBarcodes,$oldSize] = $myTollApi->addShipmentBarcodes($p);
            $p->mdata['barcode'] = join(',',$barcodes);
            foreach ($newBarcodes as $key => $barcode) {
                $pb = new ParcelBarcode();
                $pb->main_ref = $p->ref;
                $pb->fid = $p->id;
                $pb->sub_ref = $barcode;
                $pb->sn = $oldSize+$key+1;
                $pb->save();
            }
            
            $p->nolog = true;
            $p->update('meta');
            $p->nolog = false;

            return true;
        }

         return false;
    }

    public static function getTotalRackParentNumber(){
        $count = 0;
		$modelImparcels = ImParcel::model()->findAllBySql('select * from shipment where status <90 and scan!=""');
		if(!empty($modelImparcels)){
			foreach ($modelImparcels as $modelImparcel){
				if(date("Y-m-d", strtotime($modelImparcel->getScanTime())) == date("Y-m-d")){
					$count += $modelImparcel->getRackParentNumber();
				}
			}
		}
        return $count;
    }

    public static function getImparcelChargecode($shipment)
    {
        $chargecode = empty($shipment->mdata['chargecode'])?"":$shipment->mdata['chargecode'];
        if($shipment->isWms())
        {
            $chargecode = WmsInvoice::getShipmentWmsChargecode($shipment);
        }
        return $chargecode;
    }

    public static function getImParcelDamageFile($s)
    {
        $files = FileRepo::model()->findAll("fid = :fid and type = :type",[":fid"=>$s->id,":type"=>FileRepo::SHIPMENT_DAMAGE]);
        $thisFiles=[];
        foreach ($files as $key => $file) {
            if(empty($thisFiles[$file->name]))
            {
                $file = FileRepo::model()->find(["condition"=>"fid = :fid and type = :type and name=:name","params"=>[":name"=>$file->name,":fid"=>$s->id,":type"=>FileRepo::SHIPMENT_DAMAGE],"order"=>"id desc"]);
                $thisFiles[$file->name] = $file->getOutUrl();
            }
        }
        return $thisFiles;
    }

    public static function accHeldShipment($shipment)
    {
        if($shipment->status >ImParcel::STATE_HELD)
        {
            if($shipment->agent->getAccBalanceDetails()<0)
            {
                if($shipment->status!=ImParcel::STATE_ACCOUNT_HELD)
                {
                    $shipment->mdata['acc_held_before_status'] =$shipment->status;
                }
                $shipment->update('status');
                $shipment->status = ImParcel::STATE_ACCOUNT_HELD;
                $shipment->update('status','meta');
            }else
            {
                $shipment->update('status');
            }
        }
    }

    public function getAutoImparcelLabel($id,$sn=0)
    {
        $model = ImParcel::model()->findByPk($id);
        if (empty($model)) {
            $model = ImParcelArchive::model()->findByPk($id);
            if (empty($model)) {
                throw new CHttpException(404, 'Page not found!');
            }
        }

        //Toll Boarder label
        $parent = $model->getParentShipment();
        if(!empty($parent)&&(($parent->status!=ImParcel::STATE_LOCAL_ARRIVAL&&$parent->status<ImParcel::STATE_CLEAR)||$parent->status==ImParcel::STATE_CANCELLED))
        {
            echo "not ready for WDT shipments";
            return;
        }

        $copyShipment = $model->getCopyShipment();
        if(!empty($copyShipment))
        {
            $model = $copyShipment;
        }
        
        if(self::isOtherLabel($model))
        {
            $this->getImparcelLabel([$model],$sn);
            return;
        }

        // if($model->isParcelPickup())
        // {
        //     oPDF::renderPDF('label_A6', ['tpl' => '_label_3', 'empty' => false, 'rs' => [$model], 'sn' => $sn]);
        //     return;
        // }

        // Normal label
        oPDF::renderPDF('label_A6', ['tpl' => '_label_1', 'empty' => false, 'rs' => [$model], 'sn' => $sn]);
    }

    public function getAutoImparcelLabelMulti($shipments)
    {
        $normal = [];
        $ps = [];
        $normalLabel = [];
        foreach ($shipments as $key => $d)
        {
            $parent = $d->getParentShipment();
            if(!empty($parent)&&(($parent->status!=ImParcel::STATE_LOCAL_ARRIVAL&&$parent->status<ImParcel::STATE_CLEAR)||$parent->status==ImParcel::STATE_CANCELLED))
            {
                echo "not ready for WDT shipments";
                return;
            }
        }
        
        foreach ($shipments as $key => $d)
        {
            $apiLabel = self::getEizLabel($d);
            if(!empty($apiLabel))
            {
                $ps[] = $apiLabel;
            }else
            {
                $normal[] = $d;
            }
        }

        if(!empty($normal))
        {
            $normalLabel = oPDF::renderPDF('label_A6', ['tpl' => '_label_1', 'empty' => false, 'rs' => $normal, 'sn' => 0],2);
            $ps[] = $normalLabel;
        }

        oPDF::mergePDF($ps, 1, true, 'plabels.pdf');
    }

    public function getAutoImparcelLabelMultiZip($ships)
    {
        $bd=Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR;
        $zip=new ZipArchive();
        $zf=$bd.'TLA_label'.date('Ymd').'.zip';
        $td = Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR.'zip'.time();
        if (!file_exists($td)) {
            mkdir($td);
        }
        $zip->open($zf, ZipArchive::CREATE);

        foreach ($ships as $ship) {
            $parent = $ship->getParentShipment();
            if(!empty($parent)&&(($parent->status!=ImParcel::STATE_LOCAL_ARRIVAL&&$parent->status<ImParcel::STATE_CLEAR)||$parent->status==ImParcel::STATE_CANCELLED))
            {
                echo "not ready for WDT shipments";
                return;
            }
        }

        foreach ($ships as $ship) {
            $rs=[$ship];
            $fn = tempnam($td, $ship->ref."_label");
            $apiLabel = self::getEizLabel($ship);
            if(empty($apiLabel))
            {
                oPDF::renderPDF('label_A6', ["rs"=>$rs], 2, $fn);
                $zip->addFile($fn, $ship->ref."_label.pdf");
            }else
            {
                $zip->addFile($apiLabel, $ship->ref."_label.pdf");
            }
        }
        $zip->close();
        header("Cache-Control: maxage=1");
        header("Content-Description: File Transfer");
        header("Content-type: application/octet-stream");
        header("Content-Disposition: attachment; filename=\"".basename($zf)."\"");
        header("Content-Transfer-Encoding: binary");
        header("Content-Length: ".filesize($zf));
        readfile($zf);
        unlink($zf);
        AppHelper::unlinkRecursive($td);
        Yii::app()->end();
    }

    public static function generateTempLabel($barcode,$containerNo,$consolId,$id,$dptId)
    {
        if(!empty($barcode))
        {
            $model = ImportsUnknownShipment::model()->find("barcode = :barcode",[":barcode"=>$barcode]);
            if(empty($model))
            {
                $model = new ImportsUnknownShipment();
            }
        }else
        {
            $model = new ImportsUnknownShipment();
        }
        
        $model->barcode = $barcode;
        $model->user_id = User::currentUserID();
        $model->create_time = date("Y-m-d H:i:s");
        $model->container_no = trim($containerNo);
        $model->consol_id = $consolId;
        $model->shipment_id = $id;
        $model->dpt_id = $dptId;
        $model->save();
        $model->generateTempBarcode();
        $model->update(["temp_barcode"]);
        return $model;
    }

    public static function genTempLabel($tempId,$tp=false,$v = false)
    {
        $model = ImportsUnknownShipment::model()->findByPk($tempId);
        $model->print = 1;
        $model->update(['print']);
        if(!empty($v))
        {
            return $model;
        }
        Yii::import('application.libs.tcpdf.tcpdf_barcodes_1d', true);
        Yii::import('application.libs.tcpdf.tcpdf_barcodes_2d', true);
        Yii::import('application.libs.tcpdf.tcpdf', true);
        $ps = [];
        $pdf = new \TCPDF(PDF_PAGE_ORIENTATION, PDF_UNIT, 'A6', true, 'UTF-8', false);
        $pdf->setPrintHeader(false);
        $pdf->setPrintFooter(false);

        $pdf->SetDefaultMonospacedFont(PDF_FONT_MONOSPACED);

        $pdf->SetMargins(PDF_MARGIN_LEFT, PDF_MARGIN_TOP, PDF_MARGIN_RIGHT);

        $pdf->SetAutoPageBreak(false, PDF_MARGIN_BOTTOM);

        $pdf->setImageScale(PDF_IMAGE_SCALE_RATIO);

        $pdf->SetFont('verdana', '', 10, '', true);

        $pdf->AddPage('P', '', false, false);

        $barcode_style = array(
                'position' => '',
                'align' => 'C',
                'stretch' => false,
                'fitwidth' => true,
                'cellfitalign' => '',
                'border' => false,
                'hpadding' => 'auto',
                'vpadding' => 'auto',
                'fgcolor' => array(0, 0, 0),
                'bgcolor' => false, //array(255,255,255),
                'text' => false,
                'font' => 'helvetica',
                'fontsize' => 8,
                'stretchtext' => 4
            );
        $pdf->SetFontSize(20);
        $pdf->writeHTMLCell(0, 0, 13, 1, "TLA TEMP LABEL", 0, 0, 0, '', true);

        $pdf->write1DBarcode($model->temp_barcode, 'C128', 3, 20, 98, 32, 0.45, $barcode_style, 'N');
        $pdf->SetFontSize(14);
        $pdf->writeHTMLCell(0, 0, 13, 55, $model->temp_barcode, 0, 0, 0, '', true);
        $pdf->writeHTMLCell(0, 0, 13, 70, $model->barcode, 0, 0, 0, '', true);

        $f = tempnam(Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR."temp".DIRECTORY_SEPARATOR, 'pp');
        $pdf->Output($f, 'F');
        $ps[] = $f;

        if($tp===3)
        {
            return oPDF::mergePDF($ps, 0, true);
        }elseif($tp)
        {
            return oPDF::mergePDF($ps, 2, false);
        }else
        {
            oPDF::mergePDF($ps, 1, true, 'label.pdf');
        }
        return true;
    }
	
	public function generateYlwLabel($id,$output=false){
        $ps = [];
        $numOfPallets = 0;
        $cs = [];
        if(isset($id)){
            $model=$this->loadModel($id);
            if (empty($model)) {
                throw new CHttpException(404, 'Page not found!');
            }

            $parent = $model->getParentShipment();
            if(!empty($parent)&&(($parent->status!=ImParcel::STATE_LOCAL_ARRIVAL&&$parent->status<ImParcel::STATE_CLEAR)||$parent->status==ImParcel::STATE_CANCELLED))
            {
                echo "not ready for WDT shipments";
                return;
            }

            $copyShipment = $model->getCopyShipment();
            if(!empty($copyShipment))
            {
                $model = $copyShipment;
            }

            $pltCodes = WmsLocation::model()->findAll("shipment_id = :shipment_id",[":shipment_id"=>$model->id]);
            if(isset($pltCodes)){
                $cs = array_merge($cs, array_column($pltCodes, "code"));
            }

            if(isset($_POST['previous_label'])&&$_POST['previous_label']==1){               
                if(!isset($pltCodes)){
                    echo "no previous labels.";
                    Yii::app()->end();
                }
                $numOfPallets += count($cs);
            }

            $numOfPallets += $_POST['total_pallets'];
            $cs = array_merge($cs, WmsLocation::genCodes($_POST['total_pallets'], 50, $model->consol->dpt_id, $model->id));      
            if($model->consol->service == ImcoConsol::AIRCONSOL){
                $inputModel=['id'=>$_POST['id'],'date'=>$_POST['date'],'awb'=>$_POST['awb'],'total_pcs'=>$_POST['total_pcs'],'total_pallets'=>$numOfPallets,'notes'=>$_POST['notes']];                
            }
            else{
                $inputModel=['id'=>$_POST['id'],'date'=>$_POST['date'],'cont_no'=>$_POST['cont_no'],'total_pcs'=>$_POST['total_pcs'],'total_pallets'=>$numOfPallets,'notes'=>$_POST['notes']];
            } 

            if(!$output){
                oPDF::renderPDF('label_pallet_yellow', array('model' => $model, 'inputModel' => $inputModel, 'cs' => $cs, 'dup' => false),1,$model->ref.'_plabels.pdf'); 
            } 
            else{
                return oPDF::renderPDF('label_pallet_yellow', array('model' => $model, 'inputModel' => $inputModel, 'cs' => $cs, 'dup' => false),2); 
            }                     

            // $ps[] = oPDF::renderPDF('label_pallet_yellow', array('model' => $model, 'inputModel' => $inputModel, 'cs' => $cs, 'dup' => false),2);
            // oPDF::mergePDF($ps, 1, true, $model->ref.'_plabels.pdf');
        }
    }

    public function checkShipmentPalletLabel($id){
        $model=$this->loadModel($id);
        if(($model->bwf & 4096) > 0){
            return false;
        }
        elseif ($model->status == ImParcel::STATE_SUB_UBM) {
            return false;
        }
        elseif (!isset($model->mdata['org_id']) || $model->mdata['org_id']==114 || $model->mdata['org_id']==199){
            return true;
        }
        // elseif ($model->mdata['org_id']!=114 && $model->mdata['org_id']!=199){
        //  return false;
        // }
        else{
            return false;
        }
    }

    public function loadModel($id)
    {
        $model = null;
        $model=ImParcel::model()->findByPk($id);
        if(empty($model))
        {
            $model=ImParcelArchive::model()->findByPk($id);
        }

        if ($model===null) {
            throw new CHttpException(404, 'The requested page does not exist.');
        }
        return $model;
    }

    
    public function getPalletLabelMulti($shipments)
    {
        $notPintShipment = [];
        $ps = [];
        $cs = [];
        $normalLabel = [];
        $consolNum = $shipments[0]->consol->no;
        $fileName = "";
        foreach ($shipments as $key => $d)
        {
            if (!$this->checkShipmentPalletLabel($d->id)){
                unset($shipments[$key]);
            }
            else
            {
                $notPintShipment[] = $d;
            }
        }

        if(isset($_POST['previous_label'])&&$_POST['previous_label']==1){
            foreach ($shipments as $key => $d)
            {
                $copyShipment = $d->getCopyShipment();
                if(!empty($copyShipment))
                {
                    $d = $copyShipment;
                }

                $pltCodes = WmsLocation::model()->findAll("shipment_id = :shipment_id",[":shipment_id"=>$d->id]);
                $cs = array_column($pltCodes, "code");
                if(!isset($pltCodes)){
                    echo "no previous labels.";
                    Yii::app()->end();
                }
                $numofPallets = count($cs);
                if($d->consol->service == ImcoConsol::AIRCONSOL){
                    $inputModel=['id'=>$d->id,'date'=>$_POST['date'],'awb'=>$_POST['awb'],'total_pcs'=>$d->pkg,'total_pallets'=>$numofPallets,'notes'=>$_POST['notes']];  
                    $fileName = $d->consol->awb;               
                }
                else{
                    $inputModel=['id'=>$d->id,'date'=>$_POST['date'],'cont_no'=>$_POST['cont_no'],'total_pcs'=>$d->pkg,'total_pallets'=>$numofPallets,'notes'=>$_POST['notes']];
                    $fileName = $d->consol->container_no;
                }
                
                $normalLabel = oPDF::renderPDF('label_pallet_yellow', array('model' => $d, 'inputModel' => $inputModel, 'cs' => $cs, 'dup' => false),2);
                $ps[] = $normalLabel;              
            }
            oPDF::mergePDF($ps, 1, true, $fileName.'_plabels.pdf');
            Yii::app()->end();
        }
        
        foreach ($shipments as $key => $d)
        {
            $_POST['total_pallets'] = $d->getNumOfPallets();
            $_POST['total_pcs'] = $d->pkg;
            $ps[] = $this->generateYlwLabel($d->id,true);
            // $copyShipment = $d->getCopyShipment();
            // if(!empty($copyShipment))
            // {
            //     $d = $copyShipment;
            // }
            // $numofPallets = $d->getNumOfPallets();

            // $cs = WmsLocation::genCodes($numofPallets, 50, $d->consol->dpt_id, $d->id);           
            // if($d->consol->service == ImcoConsol::AIRCONSOL){
            //     $inputModel=['id'=>$d->id,'date'=>$_POST['date'],'awb'=>$_POST['awb'],'total_pcs'=>$d->pkg,'total_pallets'=>$numofPallets,'notes'=>$_POST['notes']];
            //     $fileName = $d->consol->awb;               
            // }
            // else{
            //     $inputModel=['id'=>$d->id,'date'=>$_POST['date'],'cont_no'=>$_POST['cont_no'],'total_pcs'=>$d->pkg,'total_pallets'=>$numofPallets,'notes'=>$_POST['notes']];
            //     $fileName = $d->consol->container_no;
            // }   

            // $normalLabel = oPDF::renderPDF('label_pallet_yellow', array('model' => $d, 'inputModel' => $inputModel, 'cs' => $cs, 'dup' => false),2);
            // $ps[] = $normalLabel;           
        }

        oPDF::mergePDF($ps, 1, true, $fileName.'_plabels.pdf');
    }

