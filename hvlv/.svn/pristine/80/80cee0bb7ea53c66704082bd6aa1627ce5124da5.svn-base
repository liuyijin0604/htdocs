    public static function isWithoutCheckIn($p,$sn,$barcode)
    {
        $n = ShipmentScan::model()->count('pid =:pid and pno = :pno and type = 0',[":pid"=>$p->id,":pno"=>$sn]);
        $thisBarcode = $barcode;
        $sallBarcode = $p->hbn.'-'.$sn;
        $rallBarcode = $p->ref.'-'.$sn;
        if(preg_match('/^(808808).*-[\d]+$/', $barcode))
        {
            $ts = explode('-', $barcode);
            $thisBarcode = $ts[0].'-'.(int)$ts[1];
        }
        if(empty($p->scan_data[50])||(empty($p->scan_data[50][strtoupper($barcode)])&&empty($p->scan_data[50][strtoupper($thisBarcode)])&&empty($p->scan_data[50][strtoupper($sallBarcode)])&&empty($p->scan_data[50][strtoupper($rallBarcode)])&&!isset($p->scan_data[50]['SCAN_ALL'])&&$n==0))
        {
            if (preg_match('/-\d{1,5}/i', $barcode)||(!preg_match('/-\d{1,5}/i', $barcode)&&empty($p->scan_data[50]))) {
               return true;
            }
        }
        return false;

    }

