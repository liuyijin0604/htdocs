            $pdf->writeHTMLCell(0, 0, 2.4, 43.5, $html, 0, 0, 0, '', true);

             $html = '<div style="font-family:Verdana;font-size:8px;">' . "Cref: " . $model->cref. '</div>';
            $pdf->writeHTMLCell(0, 0, 46, 43.5, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:8px;">CONSIGNMENT:</div>';
            $pdf->writeHTMLCell(0, 0, 2.4, 46.7, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:20px;font-weight:bold;">' . $model->ref . '</div>';
            $pdf->writeHTMLCell(43, 3.5, 2.4, 50, $html, 0, 0, 0, '', false);

            $borderLine = '<div style="font-family:Verdana;font-size:10px;font-weight: bold;color: white;text-align: center;">&nbsp;</div>';
            $pdf->writeHTMLCell(100.5, 2, 2.1, 59, $borderLine, 1, 0, 1, '', 0);

            $html = '<div style="font-family:Verdana;font-size:12px;font-weight: bold;"><font style="font-size:16px;">Label ' . $sequence . '</font> of ' . $total_count . '</div>';
            $pdf->writeHTMLCell(40, 6, 70, 62.6, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:12px;font-weight: bold;"><font style="font-size:14px;">ETA: </div>';
            $pdf->writeHTMLCell(40, 6, 70, 46.6, $html, 0, 0, 0, '', true);


            $barcode_style = array(
                'position' => '',
