            $indicator = '<div style="font-family:Verdana;font-size:20px;font-weight: bold;color: white;text-align: center;line-height:28px;">' . $header[1] . '</div>';
            $pdf->writeHTMLCell(22, 9.1, 50, 2.3, $indicator, 1, 0, 1, '', 0);

            $indicator = '<div style="font-family:Verdana;font-size:20px;font-weight: bold;text-align: center;line-height:28px;">' . $header[2] . '</div>';
            $pdf->writeHTMLCell(28, 9.1, 73.5, 2.3, $indicator, 0, 0, 0, '', 0);

            $toll = '<div style="font-size:13px;font-weight:bold;border:1px solid #000;line-height:494px;">&nbsp;</div>';
