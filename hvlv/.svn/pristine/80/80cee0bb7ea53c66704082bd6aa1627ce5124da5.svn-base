            if($sn!=0 && $itemkey!=($sn-1)) continue;
            $package_dimensions = 'L:' . $item->length . 'cm &nbsp;&nbsp;W:' . $item->width . 'cm &nbsp;&nbsp;H:' . $item->height;
            $item_weight = $item->weight . "KG";

            $pdf = new \TCPDF(PDF_PAGE_ORIENTATION, PDF_UNIT, 'A6', true, 'UTF-8', false);
            $pdf->setPrintHeader(false);
            $pdf->setPrintFooter(false);

            $pdf->SetDefaultMonospacedFont(PDF_FONT_MONOSPACED);

            $pdf->SetMargins(PDF_MARGIN_LEFT, PDF_MARGIN_TOP, PDF_MARGIN_RIGHT);

            $pdf->SetAutoPageBreak(false, PDF_MARGIN_BOTTOM);

            $pdf->setImageScale(PDF_IMAGE_SCALE_RATIO);

            $pdf->SetFont('verdana', '', 10, '', true);

            $pdf->AddPage('P', '', false, false);

            $toll = '<div style="font-family:Verdana;font-size:13px">' . "TOLL" . '</div>';
            $pdf->writeHTMLCell(12, 4, 4.1, 1.3, $toll, false, 0, 0, '', true);

            $carrier = '<div style="font-family:Verdana;font-size:7.5px">' . $mytollAPI->productCode . '</div>';
            $pdf->writeHTMLCell(0, 0, 15, 2.2, $carrier, false, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:7.5px;">DESP:' . $desp . '</div>';
            $pdf->writeHTMLCell(0, 0, 56.9, 2.2, $html, false, 0, 0, '', true);

            $depot = '<div style="font-family:Verdana;font-size:12px;font-weight: bold;;text-align: center">' . substr($model->ref,-5) . '</div>';
            $pdf->writeHTMLCell(14, 5, 22, 5.5, $depot, 1, 0, 0, '', 0);

            $indicator = '<div style="font-family:Verdana;font-size:13px;font-weight: bold;color: white;text-align: center">' . $depotCode . 'SYD01</div>';
            $pdf->writeHTMLCell(15, 5, 38, 5.5, $indicator, 1, 0, 1, '', 0);

            $service = '<div style="font-family:Verdana;font-size:10px;font-weight: bold;color: white">' . $shippingMethodCode . '</div>';
            $pdf->writeHTMLCell(18, 4, 2.4, 6.5, $service, 1, 0, 1, '', true);

            $html = '<div style="font-family:Verdana;font-size:10px;font-weight:bold;">' . 'CONNOTE#:<font style="font-size:12px;">' . $connote . '</font></div>';
            $pdf->writeHTMLCell(0, 0, 2.4, 10.7, $html, 0, 0, 0, '', true);

            $to = '<div style="font-family:Verdana;font-size:10px;font-weight: bold;">' . "TO :" . '</div>';
            $pdf->writeHTMLCell(0, 0, 2.4, 15.7, $to, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:10px;">' . $receiver_name . '</div>';
            $pdf->writeHTMLCell(46, 0, 11.3, 15.7, $html, 0, 0, 0, '', true);

            $receiver_street1 = isset($receiver_street1) ? $receiver_street1 : '';
            $receiver_street2 = isset($receiver_street2) ? $receiver_street2 : '';

            $html = '<p style="font-family:Verdana;font-size:11px;line-height:12px;">' . $receiver_street1 . '<br/>' . $receiver_street2 . '</p>';
            $pdf->writeHTMLCell(50, 10, 2.4, 22.5, $html, 0, 0, 0, '', false);

            $html = '<div style="font-family:Verdana;font-size:11px;font-weight: bold">' . $receiver_suburb . '</div>';
            $pdf->writeHTMLCell(44, 0, 2.4, 32.6, $html, 0, 0, 0, '', false);

            $html = '<div style="font-family:Verdana;font-size:12px;font-weight: bold">' . $receiver_postcode . '</div>';
            $pdf->writeHTMLCell(0, 0, 35.2, 36, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:14px;font-weight: bold">' . $receiver_state . '</div>';
            $pdf->writeHTMLCell(0, 0, 2.4, 36, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:8px;">' . "Phone: " . $receiver_phone . '</div>';
            $pdf->writeHTMLCell(0, 0, 2.4, 40.5, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:8px;">' . "Contact: " . $receiver_contact . '</div>';
            $pdf->writeHTMLCell(0, 0, 2.4, 42.7, $html, 0, 0, 0, '', true);

            $INSTRUCTIONS = '<div style="font-family:Verdana;font-size:6px;font-weight: bold">' . "SPECIAL INSTRUCTIONS:" . '</div>';
            $pdf->writeHTMLCell(0, 0, 2.4, 47, $INSTRUCTIONS, 0, 0, 0, '', true);

            $instruction = isset($instruction) ? $instruction : '';

            $html = '<div style="font-family:Verdana;font-size:6.5px;">' . $instruction . '</div>';
            $pdf->writeHTMLCell(43, 3.5, 2.4, 49, $html, 0, 0, 0, '', false);

            $html = '<div style="font-family:Verdana;font-size:10px;font-weight:bold;">Cref:' . $model->cref . '</div>';
            $pdf->writeHTMLCell(43, 3.5, 2.4, 51, $html, 0, 0, 0, '', false);

             $service = '<div style="font-family:Verdana;font-size:10px;font-weight: bold;color: white">  RELEASE DATE:' . $desp . '</div>';
            $pdf->writeHTMLCell(45, 4, 2.4, 57, $service, 1, 0, 1, '', true);

            // $banner = '<div style="font-family:Verdana;font-size:6px;font-weight: bold;text-align: center;color:white;">' . " " . '</div>';
            // $pdf->writeHTMLCell(45, 4, 3.4, 57, $banner, 1, 0, 0, '', true);

            $style = array(
                'border' => false,
                'padding' => -10,
                'bgcolor' => false,
                'fgcolor' => array(0, 0, 0),
                'module_width' => 1,
                'module_height' => 1
            );

            $pdf->write2DBarcode($item->qrcode, 'QRCODE,L', 62, 12, 60, 60, $style, 'M');

            $dangerous = '<div style="font-family:Verdana;font-size:7px;font-weight: bold;text-align: center">' . "DG'S NO" . '</div>';
            $pdf->writeHTMLCell(12, 6, 3.4, 62, $dangerous, 1, 0, 0, '', true);

            if ($settings['serviceDescription'] == "B2C") {
                $adp = '<div style="font-family:Verdana;font-size:11px;font-weight: bold;">' . "ADP" . '</div>';
                $pdf->writeHTMLCell(12, 6, 18.8, 62.1, $adp, 1, 0, 0, '', true);
            } else {
                $adp = '<div style="font-family:Verdana;font-size:11px;font-weight: bold;">' . "" . '</div>';
                $pdf->writeHTMLCell(12, 6, 18.8, 62.1, $adp, 1, 0, 0, '', true);
            }

            if ($srg == 'Y') {
                $nsr = '<div style="font-family:Verdana;font-size:5px;font-weight: bold;text-align: center">' . "Signature Required" . '</div>';
            } else {
                $nsr = '<div style="font-family:Verdana;font-size:11px;font-weight: bold;text-align: center">' . "NSR" . '</div>';
            }

            $pdf->writeHTMLCell(12, 6, 34.3, 62.2, $nsr, 1, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:8px;font-weight: bold;"><font style="font-size:16px;">' . $sequence . '</font> of ' . $total_count . '</div>';
            $pdf->writeHTMLCell(16, 6, 54.9, 62.6, $html, 1, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:5px;font-weight: bold;text-align: center">' . $package_dimensions . '</div>';
            $pdf->writeHTMLCell(12, 6, 73.4, 62.6, $html, 1, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:10px;font-weight: bold;color:white;text-align: center">' . $item_weight . '</div>';
            $pdf->writeHTMLCell(12, 6, 87.7, 62.6, $html, 1, 0, 1, '', true);

            $barcode_style = array(
                'position' => '',
                'align' => 'C',
                'stretch' => false,
                'fitwidth' => true,
                'cellfitalign' => '',
                'border' => false,
                'hpadding' => 'auto',
                'vpadding' => 'auto',
                'fgcolor' => array(0, 0, 0),
                'bgcolor' => false, //array(255,255,255),
                'text' => false,
                'font' => 'helvetica',
                'fontsize' => 8,
                'stretchtext' => 4
            );
            $pdf->write1DBarcode(chr(241) . "421036" . $receiver_postcode . chr(241) . "403" . $settings['serviceCode'], 'C128', 8, 67.6, '', 32, 0.45, $barcode_style, 'N');
            $pdf->SetFontSize(8);
            $pdf->writeHTMLCell(0, 0, 2, 96, '(421) 036' . $receiver_postcode . ' (403) ' . $settings['serviceCode'], 0, 0, 0, '', true);

            $pdf->write1DBarcode(chr(241) . $item->trackingNumber, 'C128', 8, 99.9, '', 32, 0.55, $barcode_style, 'N');
            $pdf->writeHTMLCell(0, 0, 2, 128, '(00) ' . substr($item->trackingNumber, 2,strlen($item->trackingNumber)-3).' '.substr($item->trackingNumber, strlen($item->trackingNumber)-1,strlen($item->trackingNumber)), 0, 0, 0, '', true);

            $pdf->writeHTMLCell(100, 0, 3.9, 133.5, "<hr>", 0, false, false, false, '');

            $pdf->StartTransform();
            $pdf->Rotate(-90);
            $pdf->SetX(1);
            $pdf->SetFontSize(6);
            $pdf->Cell(1, 0, '                                                               THIS ITEM WILL BE SUBJECT TO SECURITY SCREEING CLAUSE', 0, 0, false, 0, '', 0);
            $pdf->StopTransform();

            $pdf->StartTransform();
            $pdf->Rotate(-270);
            $pdf->SetX(0);
            $pdf->SetFontSize(6);
            $pdf->Cell(1, 0, 'CARRIER\'S TERMS AND CONDITIONS APPLY', 0, 0, false, 0, '', 0);
            $pdf->StopTransform();

            $sender = '<div style="font-family:Verdana;font-size:5px;font-weight: bold">' . "FROM: " . '</div>';
            $pdf->writeHTMLCell(0, 0, 4, 133.5, $sender, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:5px;">' . $sender_name . '</div>';
            $pdf->writeHTMLCell(0, 0, 9.5, 133.5, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:5px;">' . $sender_suburb_state . '</div>';
            $pdf->writeHTMLCell(0, 0, 4, 135.2, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:5px;">' . $sender_postcode . '</div>';
            $pdf->writeHTMLCell(0, 0, 4, 136.6, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:5px;font-weight: bold">' . $sender_country . '</div>';
            $pdf->writeHTMLCell(0, 0, 9, 136.6, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:6px;font-weight: bold">' . $sender_address. '</div>';
            $pdf->writeHTMLCell(0, 0, 40, 133.5, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:12px;">' . "REF: " . $ref . '</div>';
            $pdf->writeHTMLCell(0, 0, 4, 138.1, $html, 0, 0, 0, '', true);

            $description = '<div style="font-family:Verdana;font-size:5px;font-weight: bold;">' . "Description of Goods:" . '</div>';
            $pdf->writeHTMLCell(0, 0, 4, 142.3, $description, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:5px;">' . $description_detail . '</div>';
            $pdf->writeHTMLCell(0, 0, 30.7, 143.3, $html, 0, 0, 0, '', true);

            $declaration = '<div style="font-family:Verdana;font-size:5.5px;font-weight: bold;">' . "DECLARATION BY:" . '</div>';
            $pdf->writeHTMLCell(0, 0, 4, 144.5, $declaration, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:5.5px;">' . $declaration_person . '</div>';
            $pdf->writeHTMLCell(0, 0, 26.3, 144.5, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:5.5px;">' . $dangerous_good_declarartion . '</div>';
            $pdf->writeHTMLCell(0, 0, 4, 146, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:25px;">' . $refCSSkuQty . '</div>';
            $pdf->writeHTMLCell(0, 0, 52, 137.5, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:10px;text-align: left">' . $refCSLocation . '</div>';
            $pdf->writeHTMLCell(40, 0, 62.5, 137.5, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:10px;text-align: left">' . $refCSSku . '</div>';
            $pdf->writeHTMLCell(40, 0, 62.5, 143.5, $html, 0, 0, 0, '', true);

            $f = tempnam(Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR."temp".DIRECTORY_SEPARATOR, 'pp');
            $pdf->Output($f, 'F');
            $ps[] = $f;
        }
        if($tp===3)
        {
            return oPDF::mergePDF($ps, 0, true);
        }elseif($tp)
        {
            return oPDF::mergePDF($ps, 2, false);
        }else
        {
            oPDF::mergePDF($ps, 1, true, 'label.pdf');
        }
    }

    public static function generateLFHunterLabel($model,$tp=false,$sn = 0){
        Yii::import('application.libs.tcpdf.tcpdf_barcodes_1d', true);
        Yii::import('application.libs.tcpdf.tcpdf_barcodes_2d', true);
        Yii::import('application.libs.tcpdf.tcpdf', true);
        $sequence = 0;
        $total_item_weight = 0;

        $desp = date('d/m/Y');
        $hbn = $model->hbn;
        $connote = $model->ref;
        $service = "1. Road Express";

        $phone = $model->cnee->tel;
        $phone = preg_replace("/[^0-9]/", "", $phone);
        $phone = sprintf("%010d", $phone);

        $receiver_name = $model->cnee->name;
        $receiver_street1 = $model->cnee->address;
        $receiver_suburb = $model->cnee->suburb;
        $receiver_postcode = $model->cnee->postcode;
        $receiver_state = $model->cnee->state;
        $receiver_phone = $phone;

        $receiver_type = !empty($model->cnee->company)?'Business':'Residential';
        
        $strCompanyName = Org::model()->findByPk($model->agent_id)->extra['delivery_label_name'];
        $objDepotOrg = Org::model()->findByPk($model->ddpt_id);


        $sender_name = !empty($strCompanyName)? $strCompanyName:$model->cnor->name;
        $sender_phone = '02 90668200';
        $sender_suburb_state = $objDepotOrg->suburb." ".$objDepotOrg->postcode." ".$objDepotOrg->state;
        //$sender_country = $prepareData->returnCountry;
        $sender_ref = $hbn;
        $sender_account = "FLLPTL";

        $strAdditional = !empty($model->mdata['Tailgate_Pallet'])? "Tail-Lift Truck(Delivery)":"";

        $packages = FLHunterFTP::getPackages($model);
        $total_count = count($packages);

        $mitems = json_encode($packages);
        $mitems = json_decode($mitems);
        $barcodes = explode(',', $model->mdata['barcode']);//$model->mdata['barcode']

        $zone_state = $zone_sub_state = "";

        $objLabelZone = LfHunterLabelZone::model()->find('postcode=:postcode and suburb = :suburb',[':postcode'=>$receiver_postcode,':suburb'=>$receiver_suburb]);
        if(!empty($objLabelZone)){
            $zone_state = $objLabelZone->label_zone;
            $zone_sub_state = $objLabelZone->label_sub_zone;
        }

        
        foreach ($mitems as $key => $item) {
            $item_weight = round($item->weight, 1);
            $item_dim = $item->length/100 ."x". $item->width/100 ."x". $item->height/100;
            $total_item_weight += $item_weight;

            $trackingNumber = $barcodes[$key];
            $items[] = [
                'trackingNumber' => $trackingNumber,
                'qty' => $item->qty,
                'dim' => $item_dim,
                'weight' => $item_weight,
                'qrcode' => $trackingNumber,
            ];
        }

        $ii = json_encode($items);
        $items = json_decode($ii);

        foreach ($items as $itemkey => $item) {
            $sequence++;
            if($sn!=0 && $itemkey!=($sn-1)) continue;

            $pdf = new \TCPDF(PDF_PAGE_ORIENTATION, PDF_UNIT, 'A6', true, 'UTF-8', false);
            $pdf->setPrintHeader(false);
            $pdf->setPrintFooter(false);
            $pdf->SetDefaultMonospacedFont(PDF_FONT_MONOSPACED);
            $pdf->SetMargins(PDF_MARGIN_LEFT, PDF_MARGIN_TOP, PDF_MARGIN_RIGHT);
            $pdf->SetAutoPageBreak(false, PDF_MARGIN_BOTTOM);
            $pdf->setImageScale(PDF_IMAGE_SCALE_RATIO);
            $pdf->SetFont('Verdana', '', 10, '', true);
            $pdf->AddPage('P', '', false, false);

            $hunter = '<div style="font-family:Verdana;font-size:24px;font-weight: bold;">' . "Hunter Express" . '</div>';
            $pdf->writeHTMLCell(60, 8, 3, 1, $hunter, false, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:10.5px;font-weight:bold;">Date:' . $desp . '</div>';
            $pdf->writeHTMLCell(36, 6, 3, 10, $html, false, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:16px;">Consignment:' . $connote . '</div>';
            $pdf->writeHTMLCell(80, 8, 3, 13.5, $html, false, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:10px;">Service:' . $service . '</div>';
            $pdf->writeHTMLCell(60, 8, 3, 19, $html, false, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:24px;font-weight:bold;text-align: center;vertical-align: center;">' . $zone_state . '</div>';
            $pdf->writeHTMLCell(24, 11, 76, 4, $html, true, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:24px;font-weight:bold;text-align: center;vertical-align: center;">' . $zone_sub_state . '</div>';
            $pdf->writeHTMLCell(24, 11, 76, 15, $html, true, 0, 0, '', true);

            $style = array(
                'border' => false,
                'padding' => -10,
                'bgcolor' => false,
                'fgcolor' => array(0, 0, 0),
            );

            $pdf->write2DBarcode($item->qrcode, 'QRCODE,L', 84, 45, 1.5, 1.5, $style, 'M');

            $html = '<div style="font-family:Verdana;font-size:8px;">Sender: ' . $sender_name . '</font></div>';
            $pdf->writeHTMLCell(50, 4, 3, 26, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:8px;">' . $sender_phone . '</font></div>';
            $pdf->writeHTMLCell(50, 4, 12.4, 29, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:8px;">' . $sender_suburb_state . '</font></div>';
            $pdf->writeHTMLCell(50, 4, 12.4, 32, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:13px;">Sender Ref: ' . $sender_ref . '</font></div>';
            $pdf->writeHTMLCell(70, 4, 3, 36, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:13px;">Account: ' . $sender_account . '</font></div>';
            $pdf->writeHTMLCell(70, 4, 3, 40, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:12px;font-weight:bold;">ITEM:' . $sequence . ' of '.$total_count.'</div>';
            $pdf->writeHTMLCell(50, 6, 3, 46, $html, false, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:10px;">Dim: ' . $item->dim . '</font></div>';
            $pdf->writeHTMLCell(50, 4, 3, 50, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:10px;">Dead: ' . $item_weight . 'KG</font></div>';
            $pdf->writeHTMLCell(50, 4, 3, 53, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:10px;">Total Dead: ' . $total_item_weight . 'KG</font></div>';
            $pdf->writeHTMLCell(50, 4, 3, 56, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:10.5px;font-weight:bold;">Receiver ['.$receiver_type.']</div>';
            $pdf->writeHTMLCell(50, 6, 3, 62, $html, false, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:16px;font-weight: bold;">' . $receiver_name . '</div>';
            $pdf->writeHTMLCell(97, 8, 3, 66, $html, false, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:16px;font-weight: bold;">TEL:' . $receiver_phone . '</div>';
            $pdf->writeHTMLCell(70, 8, 3, 72, $html, false, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:16px;font-weight: bold;">' . $receiver_street1 . '</div>';
            $pdf->writeHTMLCell(97, 18, 3, 78, $html, false, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:16px;font-weight: bold;">' .$receiver_suburb.' '. $receiver_state .', '.$receiver_postcode. '</div>';
            $pdf->writeHTMLCell(97, 8, 3, 91, $html, false, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:12px;font-weight: bold;">Additional services:' . '' . '</div>';
            $pdf->writeHTMLCell(97, 18, 3, 97, $html, true, 0, 0, '', true);

            //-----------------------------service add here:
            $html = '<div style="font-family:Verdana;font-size:12px;font-weight: bold;">' . $strAdditional . '</div>';
            $pdf->writeHTMLCell(97, 18, 3, 102, $html, false, 0, 0, '', true);
            
            $html = '<div style="font-family:Verdana;font-size:8px;font-weight: bold;">Instructions:' . $strAdditional . '</div>';
            $pdf->writeHTMLCell(97, 18, 3, 116, $html, false, 0, 0, '', true);
            
            $html = '<div style="font-family:Verdana;font-size:8px;font-weight: bold;">Reference:</div>';
            $pdf->writeHTMLCell(150, 18, 3, 122.5, $html, false, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:12px;font-weight: bold;">Cref:&nbsp;' . $model->cref . '</div>';
            $pdf->writeHTMLCell(150, 18, 45, 118, $html, false, 0, 0, '', true);

            $barcode_style = array(
                'position' => '',
                'align' => 'C',
                'stretch' => false,
                'fitwidth' => true,
                'cellfitalign' => '',
                'border' => false,
                'hpadding' => 'auto',
                'vpadding' => 'auto',
                'fgcolor' => array(0, 0, 0),
                'bgcolor' => false, //array(255,255,255),
                'text' => false,
                'font' => 'helvetica',
                'fontsize' => 8,
                'stretchtext' => 4
            );
            $pdf->SetFontSize(8);

            $pdf->write1DBarcode(chr(241) . $item->trackingNumber, 'C128', 5, 125, 96, 15, 0.55, $barcode_style, 'N');

            $html = '<div style="font-family:Verdana;font-size:12px;font-weight: bold;">' . $item->trackingNumber . '</div>';
            $pdf->writeHTMLCell(47, 18, 33, 138.5, $html, false, 0, 0, '', true);

            $f = tempnam(Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR."temp".DIRECTORY_SEPARATOR, 'pp');
            $pdf->Output($f, 'F');
            $ps[] = $f;
        }
        if($tp===3)
        {
            return oPDF::mergePDF($ps, 0, true);
        }elseif($tp)
        {
            return oPDF::mergePDF($ps, 2, false);
        }else
        {
            oPDF::mergePDF($ps, 1, true, 'label.pdf');
        }
    }

    public static function generateAUKTollLabel($model,$tp=false,$sn = 0)
    {
        Yii::import('application.libs.tcpdf.tcpdf_barcodes_1d', true);
        Yii::import('application.libs.tcpdf.tcpdf_barcodes_2d', true);
        Yii::import('application.libs.tcpdf.tcpdf', true);
        $settings = ['payor_account'=>'80446978','serviceDescription'=>'B2C','serviceCode'=>'004'];
        $connote = $model->ref;
        $payor = $settings['payor_account'];
        $ps = [];
        $items = [];
        
        $sequence = 0;
        $aukAPI = AukAPI::getAPIInstance($model->mdata['org_rate_id']);
        $result = self::getCacheData("AUKTOLL:".$model->ref);
        if(empty($result))
        {
           $aukAPI->getTollLabel($model->ref);
           self::setCacheData("AUKTOLL:".$model->ref,$model->ref,36000);
        }


        $depotCode = $aukAPI->getZone($model);

        $phone = $model->cnee->tel;

        $phone = preg_replace("/[^0-9]/", "", $phone);

        $phone = sprintf("%010d", $phone);

        $desp = date('d/m/Y');
        $receiver_name = $model->cnee->name;
        $receiver_street1 = $model->cnee->address;
        $receiver_street2 = '';
        $receiver_suburb = $model->cnee->suburb;
        $receiver_postcode = $model->cnee->postcode;
        $receiver_state = $model->cnee->state;
        $receiver_phone = $phone;
        $receiver_contact = $model->cnee->name;

        $packages = $aukAPI->getPackages($model);
        $total_count = count($packages);                                                                                                               
        $prepareData = $aukAPI->prepareLabelData($model,false,"IPEC");
        $sender_name = $prepareData->returnName;
        $sender_address = $prepareData->returnAddressLine1;
        $sender_suburb_state = $prepareData->returnCity ." ".$prepareData->returnState;
        $sender_country = $prepareData->returnCountry;
        $sender_postcode = $prepareData->returnPostcode;
        $sender_phone = $prepareData->shipperPhone;
        $sender_contact = $prepareData->returnName;
        $shippingMethodCode =" ROAD EXPRESS";
        $description_detail = ' ';
        $declaration_person = $prepareData->returnName;
        $dangerous_good_declarartion = 'I hereby declare that this consingment does not contain dangerous goods';
        $ref = $model->hbn;
        $instruction = '';

        $item_number = 0;

        $volumn = 0;

        $result = [];

        $items = [];

        $mitems = json_encode($packages);
        $mitems = json_decode($mitems);
        $barcodes = explode(',', $model->mdata['barcode']);
        $kk = 0;
        foreach ($mitems as $key => $item) {
                $refCSLocation = '';
                $refCSSku = '';
                $refCSSkuQty = '';

                $volumn = $item->width * $item->length * $item->height / 1000;

                $item_weight = sprintf("%06d", ceil($item->weight) * 10);

                $srg = 'Y';
                $nsr = 'N';

                if ($settings['serviceDescription'] == "B2C"){
                    $receiver = "R";
                    $adp = 'Y';
                } else {
                    $receiver = "B";
                    $adp = 'Y';
                }
                $trackingNumber = $barcodes[$key];
                $items[] = [
                    'trackingNumber' => $trackingNumber,
                    'qty' => $item->qty,
                    'width' => $item->width,
                    'weight' => $item->weight,
                    'height' => $item->height,
                    'length' => $item->length,
                    'qrcode' => str_pad($trackingNumber, 22) . str_pad("B", 1) . str_pad($connote, 20) . str_pad(date('ymd'), 6) . str_pad($item_weight, 6) . str_pad('0Z', 2) . str_pad(sprintf("%04d", $item->length), 4) . str_pad(sprintf("%04d", $item->width), 4) . str_pad(sprintf("%04d", $item->height), 4) . str_pad(sprintf("%05d", $volumn), 5) . str_pad($settings['serviceCode'], 3) . str_pad(' ', 18) . str_pad('N', 1) . str_pad('N', 1) . str_pad(' ', 10) . str_pad($adp, 1) . str_pad($nsr, 1) . str_pad('N', 1) . str_pad($srg, 1) . str_pad('N', 1) . str_pad(' ', 4) . str_pad(' ', 11) . str_pad('S', 1) . str_pad($payor, 10) . str_pad(' ', 9) . str_pad($receiver_name, 40) . str_pad($receiver_street1, 30) . str_pad($receiver_street2, 30) . str_pad($receiver_suburb, 30) . str_pad($receiver_postcode, 10) . str_pad('AU', 2) . str_pad(' ', 14) . str_pad($receiver, 1) . str_pad($receiver_phone, 10) . str_pad(' ', 18) . str_pad('TF2', 3),
                    'refCSLocation' => $refCSLocation,
                    'refCSSku' => $refCSSku,
                    'refCSSkuQty' => $refCSSkuQty
                ];
            }
           
        $ii = json_encode($items);
        $items = json_decode($ii);

        foreach ($items as $itemkey => $item) {
            $sequence++;
            if($sn!=0 && $itemkey!=($sn-1)) continue;
            $package_dimensions = 'L:' . $item->length . 'cm &nbsp;&nbsp;W:' . $item->width . 'cm &nbsp;&nbsp;H:' . $item->height;
            $item_weight = $item->weight . "KG";

            $pdf = new \TCPDF(PDF_PAGE_ORIENTATION, PDF_UNIT, 'A6', true, 'UTF-8', false);
            $pdf->setPrintHeader(false);
            $pdf->setPrintFooter(false);

            $pdf->SetDefaultMonospacedFont(PDF_FONT_MONOSPACED);

            $pdf->SetMargins(PDF_MARGIN_LEFT, PDF_MARGIN_TOP, PDF_MARGIN_RIGHT);

            $pdf->SetAutoPageBreak(false, PDF_MARGIN_BOTTOM);

            $pdf->setImageScale(PDF_IMAGE_SCALE_RATIO);

            $pdf->SetFont('verdana', '', 10, '', true);

            $pdf->AddPage('P', '', false, false);

            $toll = '<div style="font-family:Verdana;font-size:13px">' . "TOLL" . '</div>';
            $pdf->writeHTMLCell(12, 4, 4.1, 1.3, $toll, false, 0, 0, '', true);

            $carrier = '<div style="font-family:Verdana;font-size:7.5px">' . "IPEC" . '</div>';
            $pdf->writeHTMLCell(0, 0, 24, 2.2, $carrier, false, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:7.5px;">DESP:' . $desp . '</div>';
            $pdf->writeHTMLCell(0, 0, 56.9, 2.2, $html, false, 0, 0, '', true);

            $depot = '<div style="font-family:Verdana;font-size:9px;font-weight: bold;;text-align: center">' . $depotCode . '</div>';
            $pdf->writeHTMLCell(10, 5, 79.3, 5.5, $depot, 1, 0, 0, '', 0);

            $indicator = '<div style="font-family:Verdana;font-size:13px;font-weight: bold;color: white;text-align: center">' . "R" . '</div>';
            $pdf->writeHTMLCell(8, 5, 90.7, 5.5, $indicator, 1, 0, 1, '', 0);

            $service = '<div style="font-family:Verdana;font-size:10px;font-weight: bold;color: white">' . $shippingMethodCode . '</div>';
            $pdf->writeHTMLCell(75, 4, 2.4, 6.5, $service, 1, 0, 1, '', true);

            $html = '<div style="font-family:Verdana;font-size:10px;font-weight:bold;">' . 'CONNOTE#:<font style="font-size:12px;">' . $connote . '</font></div>';
            $pdf->writeHTMLCell(0, 0, 2.4, 10.7, $html, 0, 0, 0, '', true);

            $to = '<div style="font-family:Verdana;font-size:10px;font-weight: bold;">' . "TO :" . '</div>';
            $pdf->writeHTMLCell(0, 0, 2.4, 15.7, $to, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:10px;">' . $receiver_name . '</div>';
            $pdf->writeHTMLCell(46, 0, 11.3, 15.7, $html, 0, 0, 0, '', true);

            $receiver_street1 = isset($receiver_street1) ? $receiver_street1 : '';
            $receiver_street2 = isset($receiver_street2) ? $receiver_street2 : '';

            $html = '<p style="font-family:Verdana;font-size:11px;line-height:12px;">' . $receiver_street1 . '<br/>' . $receiver_street2 . '</p>';
            $pdf->writeHTMLCell(50, 10, 2.4, 22.5, $html, 0, 0, 0, '', false);

            $html = '<div style="font-family:Verdana;font-size:11px;font-weight: bold">' . $receiver_suburb . '</div>';
            $pdf->writeHTMLCell(44, 0, 2.4, 32.6, $html, 0, 0, 0, '', false);

            $html = '<div style="font-family:Verdana;font-size:12px;font-weight: bold">' . $receiver_postcode . '</div>';
            $pdf->writeHTMLCell(0, 0, 35.2, 36, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:14px;font-weight: bold">' . $receiver_state . '</div>';
            $pdf->writeHTMLCell(0, 0, 2.4, 36, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:8px;">' . "Phone: " . $receiver_phone . '</div>';
            $pdf->writeHTMLCell(0, 0, 2.4, 40.5, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:8px;">' . "Contact: " . $receiver_contact . '</div>';
            $pdf->writeHTMLCell(0, 0, 2.4, 42.7, $html, 0, 0, 0, '', true);

            $INSTRUCTIONS = '<div style="font-family:Verdana;font-size:6px;font-weight: bold">' . "SPECIAL INSTRUCTIONS:" . '</div>';
            $pdf->writeHTMLCell(0, 0, 2.4, 47, $INSTRUCTIONS, 0, 0, 0, '', true);

            $instruction = isset($instruction) ? $instruction : '';

            $html = '<div style="font-family:Verdana;font-size:6.5px;">' . $instruction . '</div>';
            $pdf->writeHTMLCell(43, 3.5, 2.4, 49, $html, 0, 0, 0, '', false);

            $html = '<div style="font-family:Verdana;font-size:10px;font-weight:bold;">Cref:' . $model->cref . '</div>';
            $pdf->writeHTMLCell(43, 3.5, 2.4, 51, $html, 0, 0, 0, '', false);

             $service = '<div style="font-family:Verdana;font-size:10px;font-weight: bold;color: white"> Visual Aid Banner</div>';
            $pdf->writeHTMLCell(45, 4, 2.4, 72, $service, 1, 0, 1, '', true);

            // $banner = '<div style="font-family:Verdana;font-size:6px;font-weight: bold;text-align: center;color:white;">' . " " . '</div>';
            // $pdf->writeHTMLCell(45, 4, 3.4, 57, $banner, 1, 0, 0, '', true);

            $style = array(
                'border' => false,
                'padding' => -10,
                'bgcolor' => false,
                'fgcolor' => array(0, 0, 0),
                'module_width' => 1,
                'module_height' => 1
            );

            $pdf->write2DBarcode($item->qrcode, 'QRCODE,L', 62, 22.5, 60, 60, $style, 'M');

            $dangerous = '<div style="font-family:Verdana;font-size:7px;font-weight: bold;text-align: center">' . "DG'S NO" . '</div>';
            $pdf->writeHTMLCell(12, 6, 3.4, 77.2, $dangerous, 1, 0, 0, '', true);

            if ($settings['serviceDescription'] == "B2C") {
                $adp = '<div style="font-family:Verdana;font-size:11px;font-weight: bold;">' . "ADP" . '</div>';
                $pdf->writeHTMLCell(12, 6, 16.8, 77.2, $adp, 1, 0, 0, '', true);
            } else {
                $adp = '<div style="font-family:Verdana;font-size:11px;font-weight: bold;">' . "" . '</div>';
                $pdf->writeHTMLCell(12, 6, 16.8, 77.2, $adp, 1, 0, 0, '', true);
            }

            if ($srg == 'Y') {
                $nsr = '<div style="font-family:Verdana;font-size:5px;font-weight: bold;text-align: center">' . "Signature Required" . '</div>';
            } else {
                $nsr = '<div style="font-family:Verdana;font-size:11px;font-weight: bold;text-align: center">' . "NSR" . '</div>';
            }

            $pdf->writeHTMLCell(12, 6, 29.5, 77.2, $nsr, 1, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:8px;font-weight: bold;"><font style="font-size:16px;">&nbsp;</font></div>';
            $pdf->writeHTMLCell(11, 6, 42.5, 77.2, $html, 1, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:8px;font-weight: bold;"><font style="font-size:16px;">' . $sequence . '</font> of ' . $total_count . '</div>';
            $pdf->writeHTMLCell(16, 6, 54.9, 77.2, $html, 1, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:5px;font-weight: bold;text-align: center">' . $package_dimensions . '</div>';
            $pdf->writeHTMLCell(12, 6, 73.4, 77.2, $html, 1, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:10px;font-weight: bold;color:white;text-align: center">' . $item_weight . '</div>';
            $pdf->writeHTMLCell(12, 6, 87.7, 77.2, $html, 1, 0, 1, '', true);

            $barcode_style = array(
                'position' => '',
                'align' => 'C',
                'stretch' => false,
                'fitwidth' => true,
                'cellfitalign' => '',
                'border' => false,
                'hpadding' => 'auto',
                'vpadding' => 'auto',
                'fgcolor' => array(0, 0, 0),
                'bgcolor' => false, //array(255,255,255),
                'text' => false,
                'font' => 'helvetica',
                'fontsize' => 8,
                'stretchtext' => 4
            );
            $pdf->SetFontSize(8);

            $pdf->write1DBarcode(chr(241) . $item->trackingNumber, 'C128', 5, 85.9, 96, 38, 0.55, $barcode_style, 'N');
            $pdf->writeHTMLCell(0, 0, 18, 120, $item->trackingNumber, 0, 0, 0, '', true);

            $pdf->writeHTMLCell(100, 0, 3.9, 128.5, "<hr>", 0, false, false, false, '');

            $pdf->StartTransform();
            $pdf->Rotate(-90);
            $pdf->SetX(1);
            $pdf->SetFontSize(6);
            $pdf->Cell(1, 0, '                                                               THIS ITEM WILL BE SUBJECT TO SECURITY SCREEING CLAUSE', 0, 0, false, 0, '', 0);
            $pdf->StopTransform();

            $pdf->StartTransform();
            $pdf->Rotate(-270);
            $pdf->SetX(0);
            $pdf->SetFontSize(6);
            $pdf->Cell(1, 0, 'CARRIER\'S TERMS AND CONDITIONS APPLY', 0, 0, false, 0, '', 0);
            $pdf->StopTransform();

            $sender = '<div style="font-family:Verdana;font-size:8px;font-weight: bold">' . "FROM: " . '</div>';
            $pdf->writeHTMLCell(0, 0, 4, 128.8, $sender, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:8px;">' . $sender_name . '</div>';
            $pdf->writeHTMLCell(0, 0, 12.5, 128.8, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:8px;">' . $sender_suburb_state . '</div>';
            $pdf->writeHTMLCell(0, 0, 4, 131.3, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:8px;">' . $sender_postcode . '</div>';
            $pdf->writeHTMLCell(0, 0, 4, 134.1, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:8px;font-weight: bold">' . $sender_country . '</div>';
            $pdf->writeHTMLCell(0, 0, 12.5, 134.1, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:8px;font-weight: bold"> Payor A/C: 80446978</div>';
            $pdf->writeHTMLCell(0, 0, 60, 128.8, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:8px;font-weight: bold"> Contact: AL</div>';
            $pdf->writeHTMLCell(0, 0, 60, 131.7, $html, 0, 0, 0, '', true);

            // $html = '<div style="font-family:Verdana;font-size:8px;font-weight: bold"> PH: ' . $sender_phone. '</div>';
            // $pdf->writeHTMLCell(0, 0, 60, 134.6, $html, 0, 0, 0, '', true);




            $html = '<div style="font-family:Verdana;font-size:12px;">' . "REF: " . $ref . '</div>';
            $pdf->writeHTMLCell(0, 0, 4, 136.1, $html, 0, 0, 0, '', true);

            $description = '<div style="font-family:Verdana;font-size:8px;font-weight: bold;">' . "Description of Goods:" . '</div>';
            $pdf->writeHTMLCell(0, 0, 4, 139.3, $description, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:8px;">' . $description_detail . '</div>';
            $pdf->writeHTMLCell(0, 0, 30.7, 140.3, $html, 0, 0, 0, '', true);

            $declaration = '<div style="font-family:Verdana;font-size:8px;font-weight: bold;">' . "DECLARATION BY:" . '</div>';
            $pdf->writeHTMLCell(0, 0, 4, 141.7, $declaration, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:8px;">' . $declaration_person . '</div>';
            $pdf->writeHTMLCell(0, 0, 26.3, 141.7, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:8px;">' . $dangerous_good_declarartion . '</div>';
            $pdf->writeHTMLCell(0, 0, 4, 144, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:25px;">' . $refCSSkuQty . '</div>';
            $pdf->writeHTMLCell(0, 0, 52, 133.5, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:10px;text-align: left">' . $refCSLocation . '</div>';
            $pdf->writeHTMLCell(40, 0, 62.5, 133.5, $html, 0, 0, 0, '', true);

            $html = '<div style="font-family:Verdana;font-size:10px;text-align: left">' . $refCSSku . '</div>';
            $pdf->writeHTMLCell(40, 0, 62.5, 139.5, $html, 0, 0, 0, '', true);

            $f = tempnam(Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR."temp".DIRECTORY_SEPARATOR, 'pp');
            $pdf->Output($f, 'F');
            $ps[] = $f;
        }
        if($tp===3)
        {
            return oPDF::mergePDF($ps, 0, true);
        }elseif($tp)
        {
            return oPDF::mergePDF($ps, 2, false);
        }else
        {
            oPDF::mergePDF($ps, 1, true, 'label.pdf');
        }
    }

    public static function generateMyBorderLabel($model,$tp=false,$sn = 0)
    {
        Yii::import('application.libs.tcpdf.tcpdf_barcodes_1d', true);
        Yii::import('application.libs.tcpdf.tcpdf_barcodes_2d', true);
        Yii::import('application.libs.tcpdf.tcpdf', true);
        $settings = ['payor_account'=>'80518651','serviceDescription'=>'B2C','serviceCode'=>'004'];
        $connote = $model->ref;
        
        $payor = $settings['payor_account'];
        $ps = [];
        $items = [];
        $barcodes = $model->getParcelLongRef($model->mdata['org_id'],1);
        $total_count = count($barcodes);
        $sequence = 0;

        $borderAPI = BorderAPI::getAPIInstance($model->mdata['org_rate_id']);
        $RouteCode = BorderAPI::getBorderRouteCode($model);
        $phone = $model->cnee->tel;

        $phone = preg_replace("/[^0-9]/", "", $phone);

        $phone = sprintf("%010d", $phone);

        $desp = date('d/m/Y');
        $receiver_name = $model->cnee->name;
        $receiver_company = $model->cnee->company;
        $receiver_street1 = $model->cnee->address;
        $receiver_street2 = '';
        $receiver_suburb = $model->cnee->suburb;
        $receiver_postcode = $model->cnee->postcode;
        $receiver_state = $model->cnee->state;
        $receiver_phone = $phone;
        $receiver_contact = $model->cnee->company;
        $prepareData = $borderAPI->prepareData($model,false,"");

        $sender_name = $prepareData->returnName;
        $sender_suburb_state = $prepareData->returnCity ." ".$prepareData->returnState;
        $sender_country = $prepareData->returnCountry;
        $sender_postcode = $prepareData->returnPostcode;
        $sender_phone = $prepareData->shipperPhone;
        $sender_contact = $prepareData->returnName;
        $shippingMethodCode = 'Road express';
        $description_detail = ' ';
        $declaration_person = $prepareData->recipientName;
        $dangerous_good_declarartion = 'I hereby declare that this consingment does not contain dangerous goods';
        $ref = $model->hbn;
        $instruction = '';

        $item_number = 0;

        $volumn = 0;

        $result = [];

        $items = [];

        $mitems = $borderAPI->getBorderItems($model);
        $kk = 0;
        foreach ($mitems as $key => $item) {
            $refCSLocation = '';
            $refCSSku = '';
            $refCSSkuQty = '';

            $volumn = $item->width * $item->length * $item->height / 1000;

            $item_weight = sprintf("%06d", round($item->weight, 1) * 10);

            $srg = 'N';
            $nsr = 'N';
 
            if ($settings['serviceDescription'] == "B2C"){
                $receiver = "R";
                $adp = 'Y';
            } else {
                $receiver = "B";
                $adp = 'N';
            }
            $item_number += $item->qty;
            $items[] = ['trackingNumber'=>$barcodes[$key],'volumn'=>$volumn,'itemWeight'=>$item_weight];
        }
           
        $ii = json_encode($items);
        $items = json_decode($ii);

        foreach ($items as $itemkey => $item) {
            $sequence++;
            if($sn!=0 && $itemkey!=($sn-1)) continue;

            $pdf = new \TCPDF(PDF_PAGE_ORIENTATION, PDF_UNIT, 'A6', true, 'UTF-8', false);
            $pdf->setPrintHeader(false);
            $pdf->setPrintFooter(false);

            $pdf->SetDefaultMonospacedFont(PDF_FONT_MONOSPACED);

            $pdf->SetMargins(PDF_MARGIN_LEFT, PDF_MARGIN_TOP, PDF_MARGIN_RIGHT);

            $pdf->SetAutoPageBreak(false, PDF_MARGIN_BOTTOM);

            $pdf->setImageScale(PDF_IMAGE_SCALE_RATIO);

            $pdf->SetFont('verdana', '', 10, '', true);

            $pdf->AddPage('P', '', false, false);
            $toll = '<div style="font-size:13px;font-weight:bold;border:1px solid #000;line-height:530px;">&nbsp;</div>';
            $pdf->writeHTMLCell(103, 100, 1,2, $toll, false, 0, 0, '', true);

            $toll = '<div style="font-size:11px;font-weight:bold;">' . "Carrier:" . '</div>';
            $pdf->writeHTMLCell(30, 4, 8, 2.3, $toll, false, 0, 0, '', true);
            
            $toll = '<div style="font-size:11px；font-weight:bold;">' . "Border Express" . '</div>';
            $pdf->writeHTMLCell(40, 4, 2.1, 6.5, $toll, false, 0, 0, '', true);

            $indicator = '<div style="font-family:Verdana;font-size:20px;font-weight: bold;color: white;text-align: center;line-height:28px;">' . $RouteCode . '</div>';
            $pdf->writeHTMLCell(35, 9.1, 35, 2.3, $indicator, 1, 0, 1, '', 0);

            $indicator = '<div style="font-family:Verdana;font-size:20px;font-weight: bold;text-align: center;line-height:28px;">PAR</div>';
            $pdf->writeHTMLCell(28, 9.1, 73.5, 2.3, $indicator, 0, 0, 0, '', 0);

            $toll = '<div style="font-size:13px;font-weight:bold;border:1px solid #000;line-height:494px;">&nbsp;</div>';
            $pdf->writeHTMLCell(103, 100, 1,12, $toll, false, 0, 0, '', true);


            $html = '<div style="font-family:Verdana;font-size:10px;font-weight:bold;">' . 'Shipper:<font style="font-size:10px;">' . $sender_name . '</font></div>';
            $pdf->writeHTMLCell(0, 0, 2.4, 11.7, $html, 0, 0, 0, '', true);

