            $pdf->writeHTMLCell(100, 0, 2.4, 34.6, $html, 0, 0, 0, '', false);


            $html = '<div style="font-family:Verdana;font-size:8px;">' . "Contact: " . $receiver_phone . '</div>';
            $pdf->writeHTMLCell(0, 0, 2.4, 40.5, $html, 0, 0, 0, '', true);

