     public function getFakShipmentsSendingReport()
    {
        $tomorrow = date("Y-m-d", strtotime("+1 day"));
        $calDate = "";
        $check = 3;
        while ($check>0) {
            $calDate = date('Y-m-d', strtotime($tomorrow . '- 1 day'));
            if (!HolidayHelper::checkDateIsHoliday($calDate, Org::TLA_DEPARTMENT_SYDNEY)) {
                $check--;
            }
        }


        $consols = Consol::model()->findAll('json_value(meta,"$.is_fak") = 1 AND (json_value(meta,"$.input_storage_date") = :tomorrow or json_value(meta,"$.available_date") = :calDate ) ',[':tomorrow' => $tomorrow,':calDate' => $calDate]);
        $shipments = [];

        foreach ($consols as $key1 => $consol) {
            if(preg_match('/Charter Link/',$consol->getOwnerName())){
                foreach ($consol->shipments as $key2 => $shipment) {
                    if($shipment->status==ImParcel::DELIVERED || $shipment->status==ImParcel::STATE_SUB_UBM){
                        continue;
                    }
                    else if(!empty($shipment->gatepass_shipment->parent_id) && !empty($shipment->cargo_process)){
                        continue;
                    }
                    else{
                        $shipments[$key1][]=$shipment;
                    }
                }
            }
            else{
                unset($consols[$key1]);
            }            
        }

        return [$consols,$shipments];        
    }

    public function searchFakEamilAdr($consol)
    {
        $email='';
        if(!empty($consol->owner->extra['outturn_email'])){
            $email=$consol->owner->extra['outturn_email'];
        }
        else{
            foreach ($consol->shipments as $key => $shipment) {
                if(!empty($shipment->agent->extra['outturn_email']) && $shipment->agent->id!=3494){
                    $email=$shipment->agent->extra['outturn_email'];
                    break;
                }
            }
        }
        if(empty($email)){
            $email='imports@toplogistics.com.au';
        }
        return $email;
    }

    public function sendFakEmailDaily()
    {
        [$consols,$shipments] = $this->getFakShipmentsSendingReport();
        //$toEmail = 'ray.tang@toplogistics.com.au';
        $cc = 'frank.liu@toplogistics.com.au';          

        foreach ($consols as $key => $consol) {
            // print_r($consol->container_no.'/n');
            $toEmail = $this->searchFakEamilAdr($consol);
            // print_r($this->searchFakEamilAdr($consol).'/n');
            $htmlStr = '';
            if(isset($shipments[$key])){
                $htmlStr .= $this->printFakEmailContent($shipments[$key]);   
            }else
            {
                continue;
            }
            $subject = 'Container: '.$consol->container_no.'  cargo left over, storage start: '.$consol->etd;
            $emailService = new EmailService();
            $emailService->sendNormalEmail($toEmail,$subject,$htmlStr,$cc);         
        }        
    }

