                    $address->country = 'AU';
                    $address->tel = '0000000000';
                    if ($consol->dpt_id == 106) {
                        $address->address = '1233 Canterbury Rd';
                        $address->suburb = 'Punchbowl';
                        $address->state = 'NSW';
                        $address->postcode = '2196';
                    }
                    break;
                case 4063:
                case 2740:  // ZTO
                    $address->name = 'ZTO';
                    $address->country = 'AU';
                    $address->tel = '0000000000';
                    if ($consol->dpt_id == 218) {
                        $address->address = '37-39 Smirth Road';
                        $address->suburb = 'Springvale';
                        $address->state = 'VIC';
                        $address->postcode = '3171';
                    }
                    break;
                case 4483:
                case 3321:  //EBG(AC)
                    $address->name = 'EBG(AC)';
                    $address->country = 'AU';
                    $address->tel = '0000000000';
                    if ($consol->dpt_id == 218) {
                        $address->address = '2/ 34 Efficient Drive';
                        $address->suburb = 'Truganina';
                        $address->state = 'VIC';
                        $address->postcode = '3029';
                    }
                    break;
            }
        }
        $address->save();
        return $address->id;
    }
}
