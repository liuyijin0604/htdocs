<?php 
class LiveChatService extends Service
{
	
    public function saveChat($data){//Json_decode data
        $chatDetail = new LiveChatDetail(); 
        $chatRecords = [];       

        $chatDetail->agent_email = $data->chat->agents[0]->login;        
        $chatDetail->started_timestamp = date('Y-m-d H:i:s',$data->chat->started_timestamp);
        $chatDetail->ended_timestamp = date('Y-m-d H:i:s',$data->chat->ended_timestamp);
        $chatDetail->visitor_name = $data->visitor->name;        
        $chatDetail->visitor_email = $data->visitor->email;
        $chatDetail->visitor_contact_number = @$data->pre_chat_survey[2]->answer;
        $chatDetail->visitor_city = $data->visitor->city;
        $chatDetail->visitor_country = $data->visitor->country;
        $chatDetail->save();

        foreach ($data->chat->messages as $key => $value) {
        	$chatRecord = new LiveChatRecord();
        	$chatRecord->detail_id = $chatDetail->id;
        	$chatRecord->text = $value->text;
        	$chatRecord->time = date('Y-m-d H:i:s',$value->timestamp);

	        switch ($value->user_type) {
	        	case 'agent':
	        		$chatRecord->user_type = LiveChatRecord::USERTYPEAGENT;
	        		break;

	        	case 'visitor':
	        		$chatRecord->user_type = LiveChatRecord::USERTYPEVISITOR;
	        		break;
	        	
	        	default:
	        		// code...
	        		break;
	        }
	        $chatRecord->save();
	        $chatRecords[] = $chatRecord;

        }

        $emailContent = $this->printEmailContent($chatDetail, $chatRecords);
        $this->createEmail($chatDetail, $emailContent);

    }

    public function createChatEmailDaily($Date){    	
    	// $todayChatDetails = LiveChatDetail::model()->findAll(['condition'=>'ended_timestamp > ":ended_timestamp 00:00:00" AND ended_timestamp < ":ended_timestamp 23:59:59"','params'=>[":ended_timestamp"=>$Date], "order"=>'started_timestamp ASC']);
    	$sql = "SELECT * FROM `live_chat_detail` WHERE 	ended_timestamp>'".$Date." 00:00:00' and ended_timestamp<'".$Date." 23:59:59' GROUP BY visitor_email";
    	$todayChatDetails = LiveChatDetail::model()->findAllBySql($sql);
    	$emails = array_column($todayChatDetails, "visitor_email");
    	foreach ($todayChatDetails as $key => $todayChatDetail) {
    		$chatRecords = [];
    		$sql1 = "SELECT * FROM `live_chat_detail` WHERE ended_timestamp>'".$Date." 00:00:00' and ended_timestamp<'".$Date." 23:59:59' AND visitor_email = '".$todayChatDetail->visitor_email."'";
    		$indChatDetails = LiveChatDetail::model()->findAllBySql($sql1);
	    	$ids = array_column($indChatDetails, "id");
	    	foreach ($indChatDetails as $indChatDetail) {
	    		
	    		$temp = LiveChatRecord::model()->findAll(['condition'=>'detail_id = :detail_id','params'=>[":detail_id"=>$indChatDetail->id], "order"=>'time ASC']);
	    		$chatRecords = array_merge($chatRecords, $temp);
	    	}
	    	$emailContent = $this->printEmailContent($todayChatDetail, $chatRecords);
        	$this->createEmail($todayChatDetail, $emailContent);
    	}    	
    }

    public static function createEmail($chatDetail, $message,$is3PL= 0)
	{
		$tmp = Yii::app()->basePath . DIRECTORY_SEPARATOR . 'runtime' . DIRECTORY_SEPARATOR . 'importsmail' . DIRECTORY_SEPARATOR;

		$model = new ImportsMail();
		$fromEmail = $chatDetail->visitor_email; //arrray('display'=>'Name','address'=>'jerry@toplogistics.com.au','is_group'=>false）;
		$addressesTo[] = "importscs@toplogistics.com.au";
		$model->from_email = $fromEmail;
		$model->from_name = $chatDetail->visitor_name;
		if(empty($model->from_name))
		{
			$model->from_name = "unknow";
		}
		$a = trim("Online Chat Transcript");
		if (preg_match_all('/\{EM\d+\}/', $a, $ms)) {
			$a = str_replace($ms[0], '', $a) . ' ' . implode(' ', $ms[0]);
		}
		$a = preg_replace('/(Reply|回复|答复):/', 'Re:', $a);
		$a = preg_replace('/^{(Spam|Definitely Spam|Virus|Disarmed)\??} /', '', $a);
		$a = preg_replace('/Re:\s*Re:(\s*Re:)?(\s*Re:)?(\s*Re:)?/i', 'Re:', $a);
		$model->subject = $a;
		$tempToEmail = ''; //the list to to mail;
		$toEmail = ''; //reply mail. imports or importscs
		$toEmailName = "TLA Customer Service";
		$model->mdata['search']['from'] = trim($model->from_email);
		$model->mdata['search']['subject'] = trim($model->subject);
		$model->mdata['search']['message_id'] = trim($chatDetail->id);
		foreach ($addressesTo as $theToEmail) {
			$tempToEmail .= $theToEmail . ';';
			if (in_array($theToEmail, ['importscs@toplogistics.com.au'])) {
				$toEmail = $theToEmail;
				$toEmailName = $chatDetail->visitor_name;
			}
		}
		// if (empty($toEmail)) {
		// 	foreach ($addressesCc as $theToEmail) {
		// 		if (in_array($theToEmail['address'], ['imports@toplogistics.com.au', 'importscs@toplogistics.com.au', 'finance@toplogistics.com.au'])) {
		// 			$toEmail = $theToEmail['address'];
		// 			$toEmailName = $theToEmail['display'];
		// 			break;
		// 		}
		// 	}
		// }
		$model->mdata['to_email'] = $toEmail;
		if ($toEmail == 'imports@toplogistics.com.au') {
			$model->from_flag = 1;
		} else {
			$model->from_flag = 2;
		}
		if (empty($tempToEmail)) {
			$tempToEmail = "notfoundAdress@notfoundAdress";
		}
		$model->to_email = substr($tempToEmail, 0, 500);
		$model->to_name = substr($toEmailName, 0, 100);
		$model->link_id = $model->getLinkId($model->subject);
		$model->mdata['cc'][]['address'] = trim("importscs@toplogistics.com.au");
		$model->is3pl = $is3PL;
		$model->status = ImportsMail::STATE_NEW;
		$tk = [];
		if(preg_match('/ticket CS\d{1,}/i', $a,$tk))
		{
			$model->ticket = preg_replace('/ticket /i', '', $tk[0]);
			$tkid = explode('CS', $model->ticket)[1]*1;
			if($tkid<17130)
			{
				$model->status = ImportsMail::STATE_CLOSED;
			}

			if(!empty($model->ticket)&&!preg_match('/toplogistics.com.au/i', $model->from_email))
			{
				$ticket = ShipmentQuestionSubmit::model()->find('ticket=:ticket',[":ticket"=>$model->ticket]);
				if(!empty($ticket)&&!empty($ticket->shipmentQuestion))
				{
					$sq = $ticket->shipmentQuestion[0];
					$sq->process_type = ShipmentQuestion::TYPE_RECEIVED;
					$sq->save();
				}
			}
		}
		$ccEmailAddress = '';
		if (!empty($addressesCc)) {
			foreach ($addressesCc as $tempCC) {
				$ccEmailAddress .= $tempCC . ';';
			}
		}
		$model->cc_email = substr($ccEmailAddress, 0, 500);

		$model->plain_body = $message;
		$model->create_time = date('Y-m-d H:i:s');
		// $model->type= $model->checkTheType($model->subject);
		
		$model->checkTheType($is3PL);
		if (!$model->save()) {
			Emailog::sendEmailTo(Emailog::NOTIFY_OP_EMAIL, json_encode($model->getErrors()), "Imports Mail Save Error");
			// Log::log2file(json_encode($model->getErrors()), 'imports_mail_error', "importsMailError");
			return false;
		}
		$model->refresh();
		$model->newMailUser($is3PL);
		if (!empty($model->mdata['tel_op'])) {
			foreach (preg_split("/[;,]+/", $model->mdata['tel_op']) as $tel) {
				if (empty($tel)) {
					continue;
				}
				$model->sendMsg($tel);
			}
		}
		//file_put_contents($tmp . $model->no . ".emz", gzencode($message));
		$tlaTaskService = new TlaTaskService();
		$tlaTaskService->saveEmailToBeEmailTask($model);

		$consolProcessService = new ConsolProcessService();
		$consolProcessService->checkNOAEmail($model);

		return $model;
	}

