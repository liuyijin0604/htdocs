<script>
        function quickReplyChange(id)
        {
                if(confirm("Are you sure to quick reply?"))
                { 
                   var selectFA= $("#quickReply"+id).children('option:selected').val();
                   $.ajax({
                           url: '<?=$this->createUrl("importsMail/quickReply")?>',
                           type: "post",
                           data: {"faqAnswer":selectFA,"id":$("#quickReply"+id).attr("value")},
                           success: function(r) {
                                r= JSON.parse(r);
                               if(r.done)
                                {
                                   myApp.notice('Done', 5000);
                                }else
                                {
                                   myApp.alert(r, false);   
                                }
                                MyFAQTab.trigger('reload_cs_grid');
                            },
                           error: function(e) {
                               console.log(e);
                           }
                       });     
                }
        }
  $( function() {
      var tab=$('#<?=$_GET['tabid']?>');
      var panel=tab.data('panel');
      tab.unbind('reload_imports_mail_list').bind('reload_imports_mail_list', function(){
		$('#imports-email-total-grid-list1').yiiGridView('update');
                $('#imports-email-total-grid-list-my1').yiiGridView('update');
            return false;
	});
       $( "#accordion<?=$_GET['tabid']?>",panel ).accordion({
           collapsible: true,
           active: 0,
           heightStyle: "content"
          });
       $('img').on('error',function(){
           $(this).remove();
       })
       $(".reply_btn",panel).on('click',function(){
          $("#relpy_email_<?=$_GET['tabid']?>",panel).trigger('click');
       });

      $(".reply_park_btn",panel).on('click',function(){
          $("#relpy_park_email_<?=$_GET['tabid']?>",panel).trigger('click');
       });

         $(".forward_btn",panel).on('click',function(){
          $("#forward_email_<?=$_GET['tabid']?>",panel).trigger('click');
       });
       $(".close_without_reply",panel).on('click',function(){
           if(confirm('Are you Sure to Close the email without Reply')){
            $(this).hide();
            $.get('<?=$this->createUrl("importsMail/closeEmail", ["id" => $model->id]);?>', function(r){
                if(r == 'done'){
                    myApp.notice('Done', 5000);
                    tab.trigger('load');
                    tab.trigger('reload_imports_mail_list');
                }else{
                    myApp.alert(r, false);
                }
            });   
           }
           return false;
       });
        $(".park_email",panel).on('click',function(){
           if(confirm('Are you Sure to Park the email without Reply')){
            $(this).hide();
            $.get('<?=$this->createUrl("importsMail/parkEmail", ["id" => $model->id]);?>', function(r){
                if(r == 'done'){
                    myApp.notice('Park', 5000);
                    tab.trigger('load');
                    tab.trigger('reload_imports_mail_list');
                }else{
                    myApp.alert(r, false);
                }
            });   
           }
           return false;
       });
       
       
           $('form#imports-mail-form', panel).on('success', function(e, r){
		tab.trigger('load');
     });

  } );
</script>