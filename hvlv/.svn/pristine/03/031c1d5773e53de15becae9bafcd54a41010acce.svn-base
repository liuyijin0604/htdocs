			'reply_mails' => [self::HAS_MANY, 'ReplyEmail', 'email_id'],
			'attachments' => [self::HAS_MANY, 'FileRepo', 'fid', 'on' => 'attachments.type = 28'],
			'mail_users' => [self::HAS_MANY, 'MailUser', 'mail_id'],
