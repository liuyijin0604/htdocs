	public function getStatus()
	{
		$statusStr = '';
		if (key_exists($this->status, self::$states)) {
			$statusStr .= self::$states[$this->status];
		}
		if(($this->flag&self::FLAG_PARK)>0)
		{
			$statusStr.='[PARK]';
		}
		return $statusStr;
	}
	public function getType()
	{
		$mailTypes = self::$mailTypes+self::$wmsMailTypes;
		if (key_exists($this->type, $mailTypes)) {
			return $mailTypes[$this->type];
		}
		return '';
	}
	/**
	 * @return array validation rules for model attributes.
	 */
	public function rules()
	{
		// NOTE: you should only define rules for those attributes that
		// will receive user inputs.
		return [
			['type, from_email, from_name, to_email, create_time, status', 'required'],
			['subject', 'safe'],
			['link_id, type,uid, op_id, status,flag,from_flag', 'numerical', 'integerOnly' => true],
			['no', 'length', 'max' => 20],
			['from_email,from_name,to_name', 'length', 'max' => 100],
			['to_email', 'length', 'max' => 500],
			['cc_email', 'length', 'max' => 500],
			// The following rule is used by search().
			// @todo Please remove those attributes that should not be searched.
			['id, link_id, type, no, from_email,from_flag,cc_email,ids,no_status,uid,to_time,from_time,plain_body,key_word_search,from_name,flag,assign_types,create_time,date, to_email, to_name, op_id, subject, date, status, meta,ticket', 'safe', 'on' => 'search'],
		];
	}

	/**
	 * @return array relational rules.
	 */
	public function relations()
	{
		// NOTE: you may need to adjust the relation name and the related
		// class name for the relations automatically generated below.
