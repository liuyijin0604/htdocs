<?php

class GoogleReviewController extends Controller
{
	/**
	 * @var string the default layout for the views. Defaults to '//layouts/column2', meaning
	 * using two-column layout. See 'protected/views/layouts/column2.php'.
	 */
	public $layout = '//layouts/column2';

	/**
	 * @return array action filters
	 */
	public function filters()
	{
		return array(
			'accessControl', // perform access control for CRUD operations
			'postOnly + delete', // we only allow deletion via POST request
		);
	}

	/**
	 * Specifies the access control rules.
	 * This method is used by the 'accessControl' filter.
	 * @return array access control rules
	 */
	public function accessRules()
	{
		return array(
			array(
				'allow',  // allow all users to perform 'index' and 'view' actions
				'actions' => array('index', 'view'),
				'users' => array('*'),
			),
			array(
				'allow', // allow authenticated user to perform 'create' and 'update' actions
				'actions' => array('create', 'update'),
				'users' => array('@'),
			),
			array(
				'allow', // allow admin user to perform 'admin' and 'delete' actions
				'actions' => array('admin', 'delete'),
				'users' => array('admin'),
			),
			array(
				'deny',  // deny all users
				'users' => array('*'),
			),
		);
	}

	/**
	 * Displays a particular model.
	 * @param integer $id the ID of the model to be displayed
	 */
	public function actionView($id)
	{
		$this->render('view', array(
			'model' => $this->loadModel($id),
		));
	}

	/**
	 * Creates a new model.
	 * If creation is successful, the browser will be redirected to the 'view' page.
	 */
	public function actionCreate()
	{
		$model = new GoogleReview;

		// Uncomment the following line if AJAX validation is needed
		// $this->performAjaxValidation($model);

		if (isset($_POST['GoogleReview'])) {
			$model->attributes = $_POST['GoogleReview'];
			if ($model->save())
				$this->redirect(array('view', 'id' => $model->id));
		}

		$this->render('create', array(
			'model' => $model,
		));
	}

	/**
	 * Updates a particular model.
	 * If update is successful, the browser will be redirected to the 'view' page.
	 * @param integer $id the ID of the model to be updated
	 */
	public function actionUpdate($id)
	{
		$model = $this->loadModel($id);

		// Uncomment the following line if AJAX validation is needed
		// $this->performAjaxValidation($model);

		if (isset($_POST['GoogleReview'])) {
			$model->attributes = $_POST['GoogleReview'];
			if ($model->save())
				$this->redirect(array('view', 'id' => $model->id));
		}

		$this->render('update', array(
			'model' => $model,
		));
	}

	/**
	 * Deletes a particular model.
	 * If deletion is successful, the browser will be redirected to the 'admin' page.
	 * @param integer $id the ID of the model to be deleted
	 */
	public function actionDelete($id)
	{
		$this->loadModel($id)->delete();

		// if AJAX request (triggered by deletion via admin grid view), we should not redirect the browser
		if (!isset($_GET['ajax']))
			$this->redirect(isset($_POST['returnUrl']) ? $_POST['returnUrl'] : array('admin'));
	}

	/**
	 * Lists all models.
	 */
	public function actionIndex()
	{
		$dataProvider = new CActiveDataProvider('GoogleReview');
		$this->render('index', array(
			'dataProvider' => $dataProvider,
		));
	}

	/**
	 * Manages all models.
	 */
	public function actionAdmin()
	{
		$model = new GoogleReview('search');
		$model->unsetAttributes();  // clear any default values
		
		if (isset($_GET['GoogleReview']))
			$model->attributes = $_GET['GoogleReview'];

		$googleReviewService = new GoogleReviewService();
		$numNewReviewServiceYesterday = $googleReviewService->getNumCount(GoogleReview::DELIVERED, 1);
		$numNewReviewServiceLastWeek = $googleReviewService->getNumCount(GoogleReview::DELIVERED, 7);
		$numNewReviewServiceLastMonth = $googleReviewService->getNumCount(GoogleReview::DELIVERED, 30);
		$numEmailSentYesterday = $googleReviewService->getNumCount(GoogleReview::EMAIL_SENT, 1);
		$numEmailSentLastWeek = $googleReviewService->getNumCount(GoogleReview::EMAIL_SENT, 7);
		$numEmailSentLastMonth = $googleReviewService->getNumCount(GoogleReview::EMAIL_SENT, 30);
		$numNoResponseYesterday = $googleReviewService->getNumCount(GoogleReview::CALLED_NO_ANSWER, 1);
		$numNoResponseLastWeek = $googleReviewService->getNumCount(GoogleReview::CALLED_NO_ANSWER, 7);
		$numNoResponseLastMonth = $googleReviewService->getNumCount(GoogleReview::CALLED_NO_ANSWER, 30);
		$numRefusedYesterday = $googleReviewService->getNumCount(GoogleReview::REFUSED, 1);
		$numRefusedLastWeek = $googleReviewService->getNumCount(GoogleReview::REFUSED, 7);
		$numRefusedLastMonth = $googleReviewService->getNumCount(GoogleReview::REFUSED, 30);
		$this->render('admin', array(
			'model' => $model,
			'numNewReviewServiceYesterday' => $numNewReviewServiceYesterday,
			'numNewReviewServiceLastWeek' => $numNewReviewServiceLastWeek,
			'numNewReviewServiceLastMonth' => $numNewReviewServiceLastMonth,
			'numEmailSentYesterday' => $numEmailSentYesterday,
			'numEmailSentLastWeek' => $numEmailSentLastWeek,
			'numEmailSentLastMonth' => $numEmailSentLastMonth,
			'numNoResponseYesterday' => $numNoResponseYesterday,
			'numNoResponseLastWeek' => $numNoResponseLastWeek,
			'numNoResponseLastMonth' => $numNoResponseLastMonth,
			'numRefusedYesterday' => $numRefusedYesterday,
			'numRefusedLastWeek' => $numRefusedLastWeek,
			'numRefusedLastMonth' => $numRefusedLastMonth
		));
	}

	/**
	 * List all Google Review history records
	 */

	 public function actionHistory()
	 {
		$model = new GoogleReview('search');
		$model->unsetAttributes(); 
		$statistics = new ReportCache('search');
		$statistics->unsetAttributes();

		if (isset($_GET['GoogleReview']))
			$model->attributes = $_GET['GoogleReview'];
		
		if (isset($_GET['ReportCache']))
			$model->attributes = $_GET['ReportCache'];
		$this->render('history_records', array(
			'model' => $model,
			'statistics' => $statistics,
		));
	 }

	/**
	 * Returns the data model based on the primary key given in the GET variable.
	 * If the data model is not found, an HTTP exception will be raised.
	 * @param integer $id the ID of the model to be loaded
	 * @return GoogleReview the loaded model
	 * @throws CHttpException
	 */
	public function loadModel($id)
	{
		$model = GoogleReview::model()->findByPk($id);
		if ($model === null)
			throw new CHttpException(404, 'The requested page does not exist.');
		return $model;
	}

	/**
	 * Performs the AJAX validation.
	 * @param GoogleReview $model the model to be validated
	 */
	protected function performAjaxValidation($model)
	{
		if (isset($_POST['ajax']) && $_POST['ajax'] === 'google-review-form') {
			echo CActiveForm::validate($model);
			Yii::app()->end();
		}
	}

	public function actionSendReviewEmail()
	{
		$id = $_GET['id'];
		$googleReview = new GoogleReview();
		$googleReviewService = new GoogleReviewService();
		$model = $googleReview->findByPk($id);
		if (empty($model->cnee_email)) {
			$googleReviewService->sendReviewSMS($model);
		}
		else {
			$googleReviewService->sendReviewEmail($model);
		}

		$numTimeNow = time();
		$strTimeNow = date("Y-m-d H:i:s", $numTimeNow);

		$model->status = GoogleReview::EMAIL_SENT;
		$model->time_processed = $strTimeNow;
		$model->save();
	}
	
	public function actionFirstCall()
	{
		$id = $_GET['id'];
		$googleReview = new GoogleReview();
		$model = $googleReview->findByPk($id);
		$numTimeNow = time();
		$strTimeNow = date("Y-m-d H:i:s", $numTimeNow);
		$model->status = GoogleReview::FIRST_CALL;
		$model->time_processed = $strTimeNow;
		$model->save();	
	}

	public function actionSecondCall()
	{
		$id = $_GET['id'];
		$googleReview = new GoogleReview();
		$model = $googleReview->findByPk($id);
		$numTimeNow = time();
		$strTimeNow = date("Y-m-d H:i:s", $numTimeNow);
		$model->status = GoogleReview::SECOND_CALL;
		$model->time_processed = $strTimeNow;
		$model->save();	
	}

	public function actionNoResponse()
	{
		$id = $_GET['id'];
		$googleReview = new GoogleReview();
		$model = $googleReview->findByPk($id);
		$numTimeNow = time();
		$strTimeNow = date("Y-m-d H:i:s", $numTimeNow);
		$model->status = GoogleReview::CALLED_NO_ANSWER;
		$model->time_processed = $strTimeNow;
		$model->save();	
	}
	
	public function actionRefused()
	{
		$id = $_GET['id'];
		$googleReview = new GoogleReview();
		$model = $googleReview->findByPk($id);
		$numTimeNow = time();
		$strTimeNow = date("Y-m-d H:i:s", $numTimeNow);		
		$model->time_processed = $strTimeNow;
		$model->status = GoogleReview::REFUSED;
		$model->save();
	}

	public function actionProblem()
	{
		$id = $_GET['id'];
		$googleReview = new GoogleReview();
		$model = $googleReview->findByPk($id);
		$numTimeNow = time();
		$strTimeNow = date("Y-m-d H:i:s", $numTimeNow);		
		$model->time_processed = $strTimeNow;
		if (isset($_POST['problem'])) {
			$model->problem = $_POST['problem'];
			$model->save();
		}
		$this->render('problem', array('model'=>$model));		
	}

	public function actionAddComment()
	{
		$id = $_GET['id'];
		$googleReview = new GoogleReview();
		$model = $googleReview->findByPk($id);
		if (isset($_POST['comment'])) {
			$model->comment = $_POST['comment'];
			$model->save();
		}
		$this->render('comment', array('model'=>$model));
	}

	public function actionAddWeeklyStatistics()
	{
		$model = new ReportCache();
		$model->type = ReportCache::GoogleReviewStatistics;
		$model->status = 1;
		$model->create_time = date("Y-m-d H:i:s", time());
		$model->creater = 1;
		$model->modify_time = date("Y-m-d H:i:s", time());
		$model->modifyer = 1;
		if (isset($_POST['total']) && isset($_POST['rating'])) {
			$meta = [];
			$meta['total'] = $_POST['total'];
			$meta['rating'] = $_POST['rating'];
			$model->meta = json_encode($meta);
			$model->save();
		}
		$this->render('google_review_statistics', array(
			'model' => $model,
		));
	}

	public function actionExport()
	{
		if (empty($_POST)) {
			$this->render('export');
		} else {
			$dateFrom = !empty($_POST['from_date']) ? date('Y-m-d 00:00:00', strtotime($_POST['from_date'])) : date('Y-m-d 00:00:00');
			$dateTo = !empty($_POST['to_date']) ? date('Y-m-d 23:59:59', strtotime($_POST['to_date'])) : date('Y-m-d 23:59:59');
			$sql = 'SELECT * FROM google_review WHERE `time_done` >= "' . $dateFrom . '" AND `time_done` <= "' . $dateTo . '"';
			$reviewRecords = GoogleReview::model()->findAllBySql($sql);

			$xls = new oExcel();
			$i = 1;
			$xls->addRow($i++, array('Hbn', 'Ref', 'Delivery Complete Time', 'Review Time', 'Status', 'Problem'));
			foreach($reviewRecords as $record) {
				$xls->addRow($i++, array($record->hbn, $record->ref, $record->time_done, $record->time_processed, $record->states[$record->status], $record->problem));
			}
			$xls->output('google_review_report.xlsx');
		}
	}

}
