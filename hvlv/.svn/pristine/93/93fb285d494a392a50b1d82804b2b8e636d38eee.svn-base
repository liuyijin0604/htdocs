<?php
class TlaAPI
{

	protected $domain = 'https://api.toplogistics.com.au';
	protected $api_user = 'tla';
	protected $api_key = 'd47bf1edad3c73d2748231e0bf2b891e1737cbde232009f488854b5f325a7c27';

	public function __construct()
	{
	}

	public function createShipment($params = [])
	{
		$params['api_id'] = $this->api_user;
		$params['method'] = 'create';
		return $this->httpPost('shipment', $params);
	}

	public function updateShipment($params = [])
	{
		$params['api_id'] = $this->api_user;
		$params['method'] = 'update';
		return $this->httpPost('shipment', $params);
	}

	public function cancelShipment($params = [])
	{
		$params['api_id'] = $this->api_user;
		$params['method'] = 'cancel';
		return $this->httpPost('shipment', $params);
	}

	public function updateShipmentCustomStatus($params = [])
	{
		$params['api_id'] = $this->api_user;
		$params['method'] = 'updateShipmentStatusForPCAE';
		return $this->httpPost('shipment', $params);
	}

	public function doTNTRouting($params = [])
	{
		$params['api_id'] = $this->api_user;
		$params['method'] = 'doTNTRouting';
		return $this->httpPost('shipment', $params);
	}

	protected function getRequestUrl($endpoint, $params = [])
	{
		if ($params) {
			$endpoint .= '?';
			foreach ($params as $k => $v) {
				$endpoint .= $k . '=' . $v . '&';
			}
		}

		return $this->domain . '/' . $endpoint;
	}

	protected function httpGet($endpoint, $params = [])
	{
		$this->genSign($params);
		// Set the curl parameters.
		$ch = curl_init();
		curl_setopt($ch, CURLOPT_URL, $this->getRequestUrl($endpoint, $params));
		curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, false);
		curl_setopt($ch, CURLOPT_SSL_VERIFYHOST, false);
		curl_setopt($ch, CURLOPT_POST, false);
		curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);

		$httpResponse = curl_exec($ch);
		curl_close($ch);

		if (!$httpResponse) {
			return ['done' => false];
		}

		// Extract the response details
		$this->log2file(json_encode($params));
		$this->log2file($httpResponse);
		$httpParsedResponseAr = json_decode($httpResponse, true);

		if (sizeof($httpParsedResponseAr) == 0) {
			return ['done' => false];
		}

		return array_merge($httpParsedResponseAr, ['done' => true]);
	}

	protected function httpPost($endpoint, $params = [])
	{
		$this->genSign($params);
		// Set the curl parameters
		$ch = curl_init();
		curl_setopt($ch, CURLOPT_URL, $this->getRequestUrl($endpoint));
		curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, false);
		curl_setopt($ch, CURLOPT_SSL_VERIFYHOST, false);

		// $header = [];
		// $header[] = 'Content-Type:application/json';
		// curl_setopt($ch, CURLOPT_HTTPHEADER, $header);
		curl_setopt($ch, CURLOPT_POST, true);
		curl_setopt($ch, CURLOPT_POSTFIELDS, $params);
		curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);

		$httpResponse = curl_exec($ch);
		curl_close($ch);

		if (!$httpResponse) {
			return ['done' => false];
		}

		// Extract the response details
		$this->log2file(json_encode($params));
		$this->log2file($httpResponse);
		$httpParsedResponseAr = json_decode($httpResponse, true);

		if(!is_array($httpParsedResponseAr))
		{
			return ['done' => false,'status' => 0];
		}

		if (sizeof($httpParsedResponseAr) == 0) {
			return ['done' => false];
		}

		return array_merge($httpParsedResponseAr, ['done' => true]);
	}

	protected function httpPut($endpoint, $params = [])
	{
		$this->genSign($params);
		// Set the curl parameters
		$ch = curl_init();
		curl_setopt($ch, CURLOPT_URL, $this->getRequestUrl($endpoint));
		curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, false);
		curl_setopt($ch, CURLOPT_SSL_VERIFYHOST, false);

		// $header = [];
		// $header[] = 'Content-Type:application/json';
		// curl_setopt($ch, CURLOPT_HTTPHEADER, $header);
		curl_setopt($ch, CURLOPT_CUSTOMREQUEST, 'PUT');
		curl_setopt($ch, CURLOPT_POSTFIELDS, $params);
		curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);

		$httpResponse = curl_exec($ch);
		curl_close($ch);

		if (!$httpResponse) {
			return ['done' => false];
		}

		// Extract the response details
		$this->log2file(json_encode($params));
		$this->log2file($httpResponse);
		$httpParsedResponseAr = json_decode($httpResponse, true);

		if(!is_array($httpParsedResponseAr))
		{
			return ['done' => false,'status' => 0];
		}

		if (sizeof($httpParsedResponseAr) == 0) {
			return ['done' => false,'status' => 0];
		}

		return array_merge($httpParsedResponseAr, ['done' => true]);
	}

	protected function genSign(&$params)
	{
		$params['data'] = json_encode($params['data']);
		ksort($params);
		$s = $this->api_key;
		foreach ($params as $k => $v) {
			if ($k == 'sign' || empty($v)) continue;
			$s .= $k . $v;
		}
		$s .= $this->api_key;
		$params['sign'] = strtoupper(md5($s));
	}


