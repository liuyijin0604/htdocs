<?php
include_once('ImcoConsolController.php');
class EdiAwbConsolController extends ImcoConsolController
{
	protected $nonAjax=['export','emps', 'eparcel', 'sac', 'msac','email', 'ap_manifest', 'cp_manifest','exportAddressReport','exportAddressManifestReport', 'exportAout','exportStartrackApLodge' ,'exportApLodge','exportTollApLodge','download','printAllLabels','exportHeldShipments','seaManifest','exportShipmentDetail','exportStartrackMelApLodge','seaOutturnShipments', 'storageLabel', 'd2zAutomation', 'blueAutomation', 'gvAutomation', 'webMation','seaDeliveryOrderTogether','exportCargoReceipt','dgDocument','printBagTags','SeaDO', 'arrivalNotice'];

	public function beforeAction($action){
		if(isset($_POST['EdiAwbConsol'])){
			$_POST['ImcoConsol'] = $_POST['EdiAwbConsol'];
		}
		return parent::beforeAction($action);
	}

	public function actionSeaDO($id)
	{
		$model= $this->loadModel($id);
		oPDF::renderPDF('sea_order_fcl', ['model' => $model], 1, $model->awb.'_DO.pdf');
	}

		//air cargo
	public function actionAcr($id)
	{
		$cn = $this->loadModel($id);
		if (empty($cn->mdata['cnee'])) {
			$cn->addError('meta', 'Consignee Name required');
		}
		if (empty($cn->mdata['cnee_addr'])) {
			$cn->addError('meta', 'Consignee Address required');
		}
		if (empty($cn->mdata['cnor'])) {
			$cn->addError('meta', 'Shipper Name required');
		}
		if (empty($cn->mdata['cnor_addr'])) {
			$cn->addError('meta', 'Shipper Address required');
		}
		if ($cn->hasErrors()) {
			$this->ajaxResult($cn);
		}
		if ($cn->service == 20) {
