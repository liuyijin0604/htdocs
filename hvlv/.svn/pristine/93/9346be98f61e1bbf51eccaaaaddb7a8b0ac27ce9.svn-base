				$cn->save();
			} else {
			 */
			//scr
				if(empty($cn->shipments)){ //fcl only
					$valid = true;
					if (empty($cn->mdata['awb_wt'])) {
						$cn->addError('meta', 'Consol '.$cn->awb.' has no weight.');
						$valid = false;
					}
					if (empty($cn->mdata['cbm'])) {
						$cn->addError('meta', 'Consol '.$cn->awb.' has no CBM.');
						$valid = false;
					}
					if (empty($cn->mdata['b&l_pcs'])) {
						$cn->addError('meta', 'Consol '.$cn->awb.' missing number of packs.');
						$valid = false;
