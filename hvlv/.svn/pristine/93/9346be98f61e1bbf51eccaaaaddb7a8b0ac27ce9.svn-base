						}
						$cnor_addr = trim($cnor_addr, " .,");
						// $cnor_addr = $cnor_addr;

						if (!empty($p->receiver)&&!empty($p->receiver->address)&&!empty($p->receiver->name)&&!empty($p->receiver->postcode)) {
