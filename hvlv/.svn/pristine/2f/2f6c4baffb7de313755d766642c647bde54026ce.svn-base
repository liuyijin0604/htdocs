<script type="text/javascript">
    $(function(){
        function compressImage(base64, callback) {
            var targSize = 256 * 256 //1024KB
            if(base64.length>=7000000)
            {
                targSize = 1024 * 1024;
            }

            if(base64.length<7000000)
            {
                targSize = 512 * 512;
            }

            if (base64.length <= targSize) {
                callback(base64);
                // console.log("直接返回")
                return
            }
            var newImage = new Image();
            console.log(targSize);
            newImage.src = base64;
            console.log(base64.length)
            newImage.setAttribute("crossOrigin", 'Anonymous'); //url为外域时需要  
            newImage.onload = function () {
                var quality = 0.95; //压缩系数0-1之间
                var canvas = document.createElement("canvas");
                var ctx = canvas.getContext("2d");
                canvas.width = parseInt(this.width/4);
                canvas.height = parseInt(this.height/4);
                ctx.clearRect(0, 0, canvas.width,  canvas.height);
                ctx.drawImage(this, 0, 0, canvas.width,  canvas.height);
                var base64 = canvas.toDataURL("image/jpeg", quality);
                //console.log(base64.length + "循环1压缩" + (base64.length / 1024 > 512));
                while (base64.length > targSize) {
                    quality -= 0.05;
                    // 如想确保图片压缩到自己想要的尺寸,如要求在5-10kb之间，请加以下语句，quality初始值根据情况自定
                    //console.log(base64.length + "循环1压缩" + (base64.length / 1024 > 512));
                    // console.log(base64.length + "循环压缩" + quality)
                    base64 = canvas.toDataURL("image/jpeg", quality);
                }
                callback(base64); //必须通过回调函数返回，否则无法及时拿到该值
            }
        }


        $('#takePhoto').on('click',function(){
            $('#GatepassCourier_photos').click();
            return false;
        });

        if($('#gatepass_courier').val()!="TP")
        {
            $('.tp_form').hide();
        }

        $('#GatepassCourier_photos').on('change',function(){
            $('#path').val($(this).val());
            var reader = new FileReader();  
            reader.readAsDataURL(this.files[0]);//调用自带方法进行转换  
            reader.onload = function(e) {
                 compressImage(this.result,function(newBase64){
                                $('#driver_license').val(newBase64);
                                $('#path').attr('src',newBase64);
                                $('#path').show();
                            });
            }
        })

        $('.tp_m_form').hide();
           var MQ = [<?='"'.join('","',GatepassCourier::$gatepassMQ).'"'?>];
           var isMQ= 0;
           for (var i = MQ.length - 1; i >= 0; i--) {
               if(MQ[i]=="<?=@$direct?>")
               {
                   $('#load_shipments').hide();
                   isMQ = 1;
               }
           }

        var signaturePad = new SignaturePad(document.querySelector("canvas"));
         $('button.clear_btn').on("click", function (event) {
             signaturePad.clear();
            });
           $('button.submit_sig').on("click", function (event) {

               var number=$("#shipment_number").val();
               if(number<=0&&!isMQ){
                   alert("There are no shipments waiting for signature");
                    $('#notifc').notify({message: {html: 'There are no shipments waiting for signature!'},type: 'danger'}).show();
                   return false;
               }
             if(!$("textarea[name='search_connote']").val()&&!$("select[name='gatepass_courier']").val()){
                 alert("Please Choose The Courier at first!");
                 $('#notifc').notify({message: {html: 'Please Choose The Courier at first!'},type: 'danger'}).show();
                 return false;
             }

             if(!$("input[name='driver_name']").val()){
                  alert("Please Supply Driver Name!");
                 $('#notifc').notify({message: {html: 'Please Supply Driver Name!'},type: 'danger'}).show();
                 return false;
             }
             if(signaturePad.isEmpty()){
                 alert("Please provide signature at first");
                 $('#notifc').notify({message: {html: 'Please provide signature at first!'},type: 'danger'}).show();
                 return false;
             }
             $('#gatepass_signature').val(signaturePad.toDataURL());
             var gatepass_signature=$('#gatepass_signature').val();
             var warehouse=$("select[name='warehouse']").val();
             var courier=$("select[name='gatepass_courier']").val();
             var type=$("select[name='type']").val();
             var search_context=$("textarea[name='search_connote']").val();
             var gatepass_no = $('#gatepassNo').val();
             var pickupBookingNumber = $('#pickupBookingNumber').val();
             var awb = $('#awb').val();
             var driver_name=$("input[name='driver_name']").val();
             var driver_rego=$("input[name='driver_rego']").val();
             var pickup_date = $('#pickupDate').val();
             //var files = $('#GatepassCourier_photos').prop('files');//获取到文件列表
             var  fileText = $('#driver_license').val();


             var selectedIds = "";
             var notselectedIds ="";
             $('input:checkbox[name=shipmentId]:checked').each(function(i){
                if(0==i){
                 selectedIds = $(this).val();
                }else{
                 selectedIds += (","+$(this).val());
                }
             });

             $('input:checkbox[name=shipmentId]:not(:checked)').each(function(i){
                if(0==i){
                 notselectedIds = $(this).val();
                }else{
                 notselectedIds += (","+$(this).val());
                }
             });

             if(selectedIds==""&&!isMQ)
             {
                 alert("Please Select Parcels!");
                $('#notifc').notify({message: {html: 'Please Select Parcels!'},type: 'danger'}).show();
                 return false;
             }

             $("input[name='driver_rego']").val();
             if(type==0&&!driver_rego){
                 alert("Please Supply Driver Rego!");
                 $('#notifc').notify({message: {html: 'Please Supply Driver Rego!'},type: 'danger'}).show();
                 return false;  
              }
             var ref=$("input[name='ref']").val();
             var data={
                 gatepass_signature,
                 warehouse,
                 courier,
                 search_context,
                 type,
                 driver_name,
                 driver_rego,
                 ref,
                 selectedIds,
                 notselectedIds,
                 gatepass_no,
                 pickup_date,
                 awb,
                 isMQ,
                 pickupBookingNumber,
                 fileText
             };
             $.ajax({
                    url:'<?=$this->createUrl("gatePass/submitGatepass");?>',
                    method: 'POST',
                    data:data,
                    success:function(res){
                         var response=JSON.parse(res);
                              if(response.status == 1){
//                                 alert('Done', 5000);
                                $('#notifc').notify({message: {html: 'done!'}}).show();
                                $("#load_shipments").trigger('click');
                                  signaturePad.clear();
//                                 window.open('../gatePass/genGatepassPdf/id/'+response.id+".app", '_blank');
                              }else{
                                 alert(response.msg);
                                    $('#notifc').notify({message: {html: response.msg},type: 'danger'}).show();
                              }
                          }
                         });
           });
            
        $("#load_shipments").on('click',function(){
            $('#isBreak').val("0");
            $('#loadingCount').html("0");
            $('#loadingCountDiv').show();
             var isBreak = false;
             var warehouse=$("select[name='warehouse']").val();
             var courier=$("select[name='gatepass_courier']").val();
             var search_context=$("textarea[name='search_connote']").val();
             var gatepass_no = $('#gatepassNo').val();
             var pickupBookingNumber = $('#pickupBookingNumber').val();
             var awb = $('#awb').val();
             var pickup_date = $('#pickupDate').val();
             var data={
                 warehouse,
                 courier,
                 search_context,
                 gatepass_no,
                 pickup_date,
                 awb,
                 pickupBookingNumber
             };
            
             $.ajax({
               url:"<?=$this->createUrl('gatePass/index')?>",
               data:data,
               method:"GET",
               success:function(r){
                   $("#gatepass-signature-view").html(r);
                    $('#loadingCountDiv').hide();
                    $('#isBreak').val("1");
                    isBreak = true;
               }
             });

             var tasks = function(){
                 cv = parseInt($('#loadingCount').html())+1;
                 $('#loadingCount').html(cv);
                 if($('#isBreak').val()=="0")
                 {
                    setTimeout(tasks, 1000);
                 }else
                 {
                    return "";
                 }
             };
             setTimeout(tasks, 1000);
//            gapsigApp.btnLoading($(this)); 
            
//            gapsigApp.btnLoading($("#manifest_shipment"),true);  
        });


        $('#gatepass_courier').on('change',function(){
            if($(this).val()=="TP")
            {
                $('.tp_form').show();
            }else
            {
                $('.tp_form').hide();
            }

            if($(this).val()=="moving")
            {
                $('.tp_m_form').show();
            }else
            {
                $('.tp_m_form').hide();
            }

            if($(this).val()=="Other")
            {
                $('.ot_form').show();
            }else
            {
                $('.ot_form').hide();
            }

            $('#load_shipments').show();
            isMQ = 0;
            for (var i = MQ.length - 1; i >= 0; i--) {
                if(MQ[i]==$(this).val()+"")
                {
                    $('#load_shipments').hide();
                    isMQ = 1;
                }
            }


        });
        var driverRegoHistory = "";
        $('#driver_rego').on('blur',function(){
            var rego = $('#driver_rego').val();
            if($("#path").attr('src')==""||($("#path").attr('src')!=""&&rego!=driverRegoHistory))
            {
                $.ajax({
                   url:"<?=$this->createUrl('gatePass/searchDriverLicense')?>"+"?rego="+rego,
                   data:[],
                   method:"GET",
                   success:function(r){
                        var response=JSON.parse(r);
                        if(response.status == 1){
                            driverRegoHistory = rego;
                            $("#driver_name").val(response.driver_name);
                            $("#ref").val(response.ref);
                            compressImage(response.driver_license,function(newBase64){
                                $("#path").attr('src',newBase64);
                                $("#driver_license").val(newBase64);
                                $("#path").show();
                            });
                        }else
                        {
                            $("#path").attr('src',"");
                            $("#driver_license").val("");
                            $("#path").hide();
                        }
                   }
                 });
            }


        });

        $('#load_btn').on('dblclick',function()
        {
            $('#load_shipments').show();
        });

    })
</script>
<?php $this->registerJS(ob_get_clean(),8); ?>

