	}

	private function getWareHouse()
	{
		if(!empty($_POST['tempWarehouse']))
			{
				$tempWareHouse = $_POST['tempWarehouse'];
			}else
			{
				$tempWareHouse=106;
				if (!empty(Yii::app()->session['scan_warehouse']) && Yii::app()->session['scan_warehouse']=='melbourne') {
					$tempWareHouse=218;
				}else if (!empty(Yii::app()->session['scan_warehouse']) && Yii::app()->session['scan_warehouse']=='brisbane') {
								$tempWareHouse=530;
							}
			}

		return $tempWareHouse;
	}
	private function palletScan($barcode,&$r,$groupSound)
	{
		$warehouseProcessService = new WarehouseProcessService();
		$msg = "";
		if(!empty($_POST['palletScan'])&&in_array($_GET['op'],['resort','checkin','status']))
		{
			$tempWareHouse = $this->getWareHouse();
			$results = ImParcelService::getShipmentFromLocation($barcode,$tempWareHouse);
			if(!empty($results))
			{
				$msg.="</br><h2>Location Record:</h2>";
				foreach ($results as $key => $re) {
					$msg.="</br>".$re['shipment']->ref."-".$re['sno']."";
				}
			}
			if($msg == "")
			{
				$msg = "Not Scan Record";
				$r->color = 'red';
				$r->sound = '';
				$r->stop = 0;
				$r->msg = 'Empty Pallet';
				$r->status = 'held';
			}
		} 

		$check1 = false;
		$check2 = false;
		$check3 = false;
		$heldRef = [];
		$notGP = [];
		$notBelong = [];
		foreach ($results as $key => $value) {
			$p = $value['shipment'];
			if($p->status !=ImParcel::STATE_CLEAR && $p->status !=ImParcel::STATE_LOCAL_ARRIVAL&& $p->status !=ImParcel::STATE_COURIER)
			{
				$heldRef[] = $value['shipment']->ref.":".$value['shipment']->getStatus();
				$check1 = true;
			}

			if($_GET['op']=='resort')
			{
				$mms = ManiMap::model()->with('manifest')->findAll('fid = :fid and type =50', [':fid' => $p->id]);
				if(empty($mms)&&empty($p->cargo_process))
				{
				$notGP[] = $value['shipment']->ref.":without gatepass record";
				$check2 = true;
				}
			}
		}

		if($check1||$check2)
		{
			$r->color = 'red';
			$r->sound = '';
			$r->stop = 0;
			$r->msg = 'Abnormal Shipment ';
			$r->status = '';
		}

		$soundArr = [];
		$msgArr = [];
		$statusArr = [];
		$save_p = false;

		if($check1)
		{
			$soundArr[]='held';
			$msgArr[]='Abnormal Shipment '.join('</br>',$heldRef).' In Pallet';
			$statusArr[]='held';
		}

		if($check2)
		{
			$soundArr[]='held';
			$msgArr[]='Abnormal Shipment '.join('</br>',$notGP).' In Pallet';
			$statusArr[]='held';
		}

		$msgArr[] = $msg;

		if($check1||$check2)
		{
			$r->sound = join('-',$soundArr);
			$r->found = join('-',$statusArr);
			$r->msg=join('</br></br>',$msgArr);
			$r->status=join('</br>',$statusArr);
			$groupSound();
			echo json_encode($r);
			Yii::app()->end();
		}
		else
		{
			$save_p = true;
			$soundArr[] = 'pallet-cleared';
			$r->color = 'green';
			$r->sound = join('-',$soundArr);
			$r->stop = 0;
			$r->msg = 'Pallet '.$barcode.$msg;
			$r->status = 'Cleared';
			$r->nosound = 0;
			$r->found = 0;
			$groupSound();
			echo json_encode($r);
			if(function_exists('fastcgi_finish_request')){
				ignore_user_abort(true);
				fastcgi_finish_request();
			}

			if ($_GET['op']=='resort'&&$save_p) 
			{
				$scanout = [];
				$ss = [];
				$trans = Yii::app()->db->beginTransaction();
				try{
					foreach ($results as $key => $value) 
					{
						$p = $value['shipment'];
						$sn = $value['sno'];
						if(empty($scanout[$p->id]))
						{
							$scanout[$p->id] = [$sn];
							$ss[$p->id] = $p;
						}else
						{
							$scanout[$p->id][] = $sn;
						}
						$courier_id=$p->getCourierId();
						ShipmentScan::genShipmentScan($p, ShipmentScan::PALLET_TYPE, $sn, $tempWareHouse, 3600,$p->hbn);
						$scaned = GatepassShipment::gatepassScan($p, $courier_id, $sn, $tempWareHouse);
						$warehouseProcessService->prepareDoneShipment($p->id);
					}
					ImParcelService::locationMarkScanned($barcode,$tempWareHouse,true);

					foreach ($scanout as $key => $sns) 
					{
						$p = $ss[$key];
						$p->mdata['whscan_out'] = date('Y-m-d H:i:s');
						if (!empty($p->mdata['gpscan_time'])&&!is_array($p->mdata['gpscan_time'])) {
							unset($p->mdata['gpscan_time']);
						}
						foreach ($sns as $k => $sn) {
							$p->mdata['gpscan_time'][$sn]=$sn.':'. date('Y-m-d H:i:s');
						}
						if (!empty($p->mdata['gpscan_time'])&&is_array($p->mdata['gpscan_time'])) {
							asort($p->mdata['gpscan_time']);
						}
						$p->save();
					}


					$trans->commit();
				} catch (Exception $ex) {
					$trans->rollback();
					throw $ex;
				}

			}else if($_GET['op']=='checkin'&&$save_p)
			{
				$trans = Yii::app()->db->beginTransaction();
				try{
					foreach ($results as $key => $value) 
					{
						$p = $value['shipment'];
						$sn = $value['sno'];
						$courier_id=$p->getCourierId();
						ShipmentScan::genShipmentScan($p, ShipmentScan::CHECKIN, $sn, $tempWareHouse, 3600,$p->hbn);
					}
					ImParcelService::locationMarkScanned($barcode,$tempWareHouse,false);
					$trans->commit();
				} catch (Exception $ex) {
					$trans->rollback();
					throw $ex;
				}
			}
			Yii::app()->end();
		}
	}


}
