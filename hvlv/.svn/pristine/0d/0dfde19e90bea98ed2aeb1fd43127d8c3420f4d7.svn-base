	{
		$('#address_book').addClass('display_none');
		$('#divChangeAddress').removeClass('display_none');
	}

	function funcBusinessHourNext()
	{
		$('#business_hours').addClass('display_none');
		$('#divShipment').removeClass('display_none');
	}

	function funcBusinessHourPrev()
	{
		$('#business_hours').addClass('display_none');
		$('#address_book').removeClass('display_none');
	}
</script>