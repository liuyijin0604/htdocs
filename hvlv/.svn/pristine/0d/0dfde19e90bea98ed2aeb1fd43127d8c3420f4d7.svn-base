<script type="text/javascript">
	numPkg = <?= $numPkg ?>;
	numWeight = <?= $numWeight ?>;
	strFullAddress = "<?= $strFullAddress ?>";
	isFreeUnloading = <?= $isFreeUnloading ?>;

	isUnloadingResidentialWeight = false;
	isUnloadingResidential = false;
	isUnloadingBusiness = false;
	// isRedelivery = false;

	strSummaryChangeAddress = '';
	strSummaryNewAddress = '';
	strSummaryAddressType = '';
	strSummaryUnloading = '';
	strSummaryUnloadingOptions = '';
	// strSummaryRedelivery = '';
	strSummaryDeliveryTime = '';

	strDivPrevShipment = '';
	strDivPrevUnloadingOptions = '';
	strDivPrevDelivery = '';
	strDivPrevOther = '';
	var hasAddressBook = false;
	var addressBook = '';
	function funcChangeAddress() {
		$("#divChangeAddress").addClass("display_none");
		strChangeAddress = $("input[name='change_address']:checked").val();
		if (strChangeAddress == 'no_change_address') {
			$.ajax({
				method: 'POST',
				url: '<?= Yii::app()->createUrl("booking/checkAddressbook"); ?>',
				data: {
					tel: "<?=$strTel?>"
				},
				success: function(response) {
					res = jQuery.parseJSON(response);
					addressBook = res.addressBook;
					if (res.success == true) {
						//console.log(res);
						// found address book record
						$('#address_book_info').empty();
						let strHtml = '<p style="font-weight: 600;">Address type: <span style="color: red;">'+getAddressType(res.addressBook)+'</span></p>';
						strHtml += '<p style="font-weight: 600;">Authorize to leave at door: <span style="color: red;">'+getAtl(res.addressBook)+'</span></p>';
						strHtml += '<p style="font-weight: 600;">Folklift is available on site to unload: <span style="color: red;">'+getFolklift(res.addressBook)+'</span></p>';
						strHtml += '<p style="font-weight: 600;">We need unloading service: <span style="color: red;">'+getUnloading(res.addressBook)+'</span></p>';
						strHtml += '<p style="font-weight: 600;">Business hours: <span style="color: red;">'+getBusinessHours(res.addressBook)+'</span></p>';
						$('#address_book_info').append(strHtml);
						/* $('p#address_book_type').text('Address type: ' + getAddressType(res.addressBook));
						$('p#address_book_atl').text('Authorize to leave at door: ' + getAtl(res.addressBook));
						$('p#address_book_folklift').text('Folklift is available on site to unload: ' + getFolklift(res.addressBook));
						$('p#address_book_unloading').text('We need unloading service: ' + getUnloading(res.addressBook));
						$('p#address_book_business_hours').text('Business hours: ' + getBusinessHours(res.addressBook)); */
						$('#address_book').removeClass('display_none');
						hasAddressBook = true;
						// set default values according to address book
						switch(res.addressBook.mdata.address_type) {
							case 1:
								$('#address_type_0').attr('checked', 'checked');
								$('input[name="inputIsUnloadingResidential"]').val(true);
								break;
							case 2:
								$('#address_type_1').attr('checked', 'checked');
								$('input[name="inputIsUnloadingResidential"]').val(true);
								break;
							case 3:
								$('#address_type_2').attr('checked', 'checked');
								$('input[name="inputIsUnloadingBusiness"]').val(true);
								break;
							case 4:
								$('#address_type_3').attr('checked', 'checked');
								$('input[name="inputIsUnloadingBusiness"]').val(true);
								break;
							case 5:
								$('#address_type_4').attr('checked', 'checked');
								$('input[name="inputIsUnloadingBusiness"]').val(true);
								break;
							case 6:
								$('#address_type_5').attr('checked', 'checked');
								$('input[name="inputIsUnloadingBusiness"]').val(true);
								break;		
						}
						if (res.addressBook.mdata.authorize_to_leave == 1) {
							$('#leave_at_address_0').attr('checked', 'checked');
						} else {
							$('#leave_at_address_1').attr('checked', 'checked');
						}

						if (res.addressBook.mdata.open != '' && res.addressBook.mdata.close != '') {
							$('#business_open').val(res.addressBook.mdata.open);
							$('#business_close').val(res.addressBook.mdata.close);
						}

						/* if (res.addressBook.mdata.has_folklift == 1 || res.addressBook.mdata.need_unloading_service == 0) {
							$('#business_unloading_0').attr('checked', 'checked');
						} else {
							$('#business_unloading_1').attr('checked', 'checked');
						} */
						if (res.addressBook.mdata.has_folklift == 1) {
							$('#business_unloading_0_0').attr('checked', 'checked');
							//$('input[name="business_unloading_0"]').val('fork');
						} else {
							$('#business_unloading_0_1').attr('checked', 'checked');
							//$('input[name="business_unloading_0"]').val('nofork');
						}
						if (res.addressBook.mdata.need_unloading_service == 1) {
							$('#business_unloading_1_1').attr('checked', 'checked');
							//$('input[name="business_unloading_1"]').val('hand_unloading_service_oversize');
						} else {
							$('#business_unloading_1_0').attr('checked', 'checked');
							//$('input[name="business_unloading_1"]').val('self');
						}
						
					} else {
						strDivPrevShipment = 'divChangeAddress';
						$("#divShipment").removeClass("display_none");
					}
				}
			});
		} else { // change address
			$("#divNewAddress").removeClass("display_none");
		}
	}

	function getAddressType(addressBook)
	{
		let type = addressBook.mdata.address_type;
		let strAddressType = '';
		switch(type) {
			case 1:
				strAddressType = 'Apartment/Unit';
				break;
			case 2:
				strAddressType = 'House/Townhouse';
				break;
			case 3:
				strAddressType = 'Warehouse/Logistic Centre/Storage Centre';
				break;
			case 4:
				strAddressType = 'Shop(Roadside)';
				break;
			case 5:
				strAddressType = 'Shop(Inside Shopping Center)';
				break;
			case 6:
				strAddressType = 'Office Building';
				break;
		}
		return strAddressType;
	}

	function getAtl(addressBook)
	{
		if (addressBook.mdata.authorize_to_leave == 1) {
			return "Yes";
		} else {
			return "No";
		}
	}

	function getFolklift(addressBook)
	{
		if (addressBook.mdata.has_folklift == 1) {
			return "Yes";
		} else {
			return "No";
		}
	}

	function getUnloading(addressBook)
	{
		if (addressBook.mdata.need_unloading_service == 1) {
			return "Yes";
		} else {
			return "No";
		}
	}

	function getBusinessHours(addressBook)
	{
		let strBusinessHours = '';
		if (addressBook.mdata.hasOwnProperty('open') && addressBook.mdata.hasOwnProperty('close')) {
			strBusinessHours = addressBook.mdata.open + ' ~ ' + addressBook.mdata.close;
		}
		return strBusinessHours;
	}

	function funcNewAddress() {

		strLine = $("#address_line").val();
		strStreet = $("#address_street").val();
		strSuburb = $("#address_suburb").val();
		strPostcode = $("#address_postcode").val();
		strFullAddress = strLine + ' ' + strStreet + ' ' + strSuburb + ' ' + strPostcode;

		var listData = new FormData();
		listData.append("caref", $('#caref').val());
		listData.append("strSuburb", strSuburb);
		listData.append("numPostcodeNew", strPostcode);

		htmlobj = $.ajax({
			type: "POST",
			url: "<?= $this->createUrl('booking/changeAddressFee'); ?>",
			data: listData,
			async: false,
			contentType: false,
			processData: false,
		});
		obj = JSON.parse(htmlobj.responseText);
		if (obj.isSuccess) {
			numChangeAddressFee = Math.round(obj.numFee * 110) / 100;
			if (confirm('$' + numChangeAddressFee + ' Fee Applies. Do you want to change address?') == true) {
				$("#inputIsChangeAddress").val(true);
				$("#divNewAddress").addClass("display_none");
				strDivPrevShipment = 'divNewAddress';
				$("#divShipment").removeClass("display_none");
			} else {
				$("#inputIsChangeAddress").val(false);
				$("#divNewAddress").addClass("display_none");
				$("#divChangeAddress").removeClass("display_none");
			}
		} else {
			alert(obj.strMessage);
		}
	}

	function funcNewAddressPrev() {
		$("#inputIsChangeAddress").val(false);
		$("#divNewAddress").addClass("display_none");
		$("#divChangeAddress").removeClass("display_none");
	}

