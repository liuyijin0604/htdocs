			$("#" + strDivPrevDelivery).removeClass("display_none");
		}
		
	}

	function funcNextOther() {
		if(!document.getElementById("agree").checked){
			alert("Please tick the agree checkbox.");
			return false;
		}

		$("#divOther").addClass("display_none");
		$("#divSummary").removeClass("display_none");

		if (hasAddressBook && $('#address_book_correct').is(':checked')) {
			let strHtml = '';
			strHtml += '<h4>Your shipment Information</h4> <p>Ref No.<?= $strHbn ?></p><div>Weight: <?= $numWeight ?> kg<br/>Qty: <?= $numPkg ?> pcs<br/>Volume: <?= $numCBM ?> cbm<br/></div><br/>';
			strHtml += '<p>Your Address: ' + strFullAddress + '</p><p>Your Name: <?= $strName ?></p><p>Your Mobile: <?= $strTel ?></p><p>Your Email: <?= $strEmail ?></p><br/><br/>';
			strHtml += strSummaryChangeAddress;
			strHtml += strSummaryNewAddress;
			strHtml += strSummaryAddressType;
			if (addressBook.mdata.address_type == 1 || addressBook.mdata.address_type == 2) {
				// Residential Address
				strHtml += '<h4>ATL</h4>';
				strHtml += '<p>If no one onsite on the day of delivery, I/We authorised to <span style="color:red;">leave at the address</span>.</p>'
				strHtml += '<p>(a photo will be taken if ATL is selected)</p>';
				if (addressBook.mdata.authorize_to_leave == 1) {
					strHtml += '<p>YES</p><br>';
				} else {
					strHtml += '<p>NO</p><br>';
				}
			} else {
				// Business Address
				if (addressBook.mdata.has_folklift == 1) {
					strHtml += '<h4>Unloading</h4>';
					strHtml += '<p>Fork is available on site to unload</p><br>';
				} else {
					// No folklift
					if (addressBook.mdata.need_unloading_service == 1) {
						// Need unloading service
						strHtml += '<h4>Unloading</h4>';
						strHtml += '<p>We need unloading service</p><br>';
					} else {
						// customer unload items by themselves
						strHtml += '<h4>Unloading</h4>';
						strHtml += '<p>We can unload ourselves in 30 minutes</p><br>';
					}
				}
			}
			strHtml += '<h4>THE SERVICES WE PROVIDE</h4>';
			strHtml += '<p>1.Your shipment will be delivered in the next 5-7 business days or as your request.</p>';
			strHtml += '<p>2.Email notification will be automatically sent one day before the delivery day.</p><br>';
			strHtml += '<h4>THE SERVICES WE DO NOT PROVIDE</h4>';
			strHtml += '<p>1.Moving the cargo upstairs</p>';
			strHtml += '<p>2.Unpacking boxes and removing rubbish</p><br>';
			strHtml += "<br/><br/><p>Contact Us:</p><p>Top Logistics Australia</p><p>Email: cartage@toplogistics.com.au</p><br/><br/>";
			$('#divSummaryDetails').append(strHtml);
			$("#summary").val(strHtml);
		} else {
			//summary details
			strDetailHtml = '<h4>Your shipment Information</h4> <p>Ref No.<?= $strHbn ?></p><div>Weight: <?= $numWeight ?> kg<br/>Qty: <?= $numPkg ?> pcs<br/>Volume: <?= $numCBM ?> cbm<br/></div><br/>';
			strDetailHtml += strSummaryDeliveryTime;
			strDetailHtml += '<p>Your Address: ' + strFullAddress + '</p><p>Your Name: <?= $strName ?></p><p>Your Mobile: <?= $strTel ?></p><p>Your Email: <?= $strEmail ?></p><br/><br/>';

			strDetailHtml += strSummaryChangeAddress;
			strDetailHtml += strSummaryNewAddress;
			strDetailHtml += strSummaryAddressType;
			strDetailHtml += "<h4>Special notes: (30 words max)</h4>";
			strDetailHtml += $("#other_inquery").val();
			strDetailHtml += strSummaryUnloading;
			strDetailHtml += strSummaryUnloadingOptions;
			// strDetailHtml+=strSummaryRedelivery;


			// strDetailHtml+="<h4>Delivery Time Frame</h4><p>Business hours: 9:00-17:00 Monday to Friday.</p><p>Delivery will be within 5 business day after confirmation.</p><p>You will be informed by SMS text the day before delivery.</p><br/>";
			strDetailHtml += "<br/><br/><p>Contact Us:</p><p>Top Logistics Australia</p><p>Email: cartage@toplogistics.com.au</p><br/><br/>";
			//strDetailHtml += "<br/><br/><?= $strHtmlImportantNotice ?><br/><p>Contact Us:</p><p>Top Logistics Australia</p><p>Email: cartage@toplogistics.com.au</p><br/><br/>";
			$("#summary").val(strDetailHtml);
			$("#divSummaryDetails").html(strDetailHtml);
		}
	}

	function funcNextOtherPrev() {
		$("#divOther").addClass("display_none");
		$("#" + strDivPrevOther).removeClass("display_none");

	}

	function funcSubmit() {
		strUrl = window.location.href;
		listData = $('#cargo-confirm-form').serializeArray();
		htmlobj = $.ajax({
			type: "POST",
			url: strUrl,
			data: listData,
			async: false
		});
		obj = JSON.parse(htmlobj.responseText);
		if (obj.isSuccess) {
			window.location.replace(strUrl);
		} else {}

	}

	function funcSubmitPrev() {
		$("#divSummary").addClass("display_none");
		$("#divOther").removeClass("display_none");
	}

	function funcAddressBookNext()
	{
		if ($('#address_book_correct').is(':checked')) {
			$('#address_book').addClass('display_none');
			$('#divUnloadingOptions').addClass('display_none');
			$('#divInputDelivery').removeClass('display_none');
		} else {
			$('#address_book').addClass('display_none');
			$('#business_hours').removeClass('display_none');
		}
		
	}

