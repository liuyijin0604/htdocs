		strSpecialDeliveryTime = $("input[name='special_delivery_time']:checked").val();
		if(strSpecialDeliveryTime == 'yes'){
			$("#divSpecialDeliveryTime").removeClass("display_none");
		}else{
			$("#divSpecialDeliveryTime").addClass("display_none");
		}
	}

