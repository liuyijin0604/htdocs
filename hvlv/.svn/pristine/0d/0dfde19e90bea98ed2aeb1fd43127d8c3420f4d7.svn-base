	function funcNextUnloadingBusiness2() {
		if ($("input[name='business_unloading_1']:checked").val() == "self") {
			$("#divUnloadingOptions").addClass("display_none");
			$('#cb_unloading_street').prop('checked', false);
			strSummaryUnloading = "<h4>Unloading</h4>We can unload ourselves in 30 minutes<br/><br/>";
			strSummaryUnloadingOptions = "<?= $strHtmlProvideForkOrSelf ?>";
			strDivPrevDelivery = "divUnloadingBusiness";
			strDivPrevOther = "divUnloadingBusiness";
			$("<?= $strDivDeliveryOrOther ?>").removeClass("display_none");
		} 
		else if ($("input[name='business_unloading_1']:checked").val() == "hand_unloading_service") {
			$("#divUnloadingOptions").addClass("display_none");
			//for receive unloading fee;
			//$('#cb_unloading_street').prop('checked', true);
			//for not receive;
			$('#cb_unloading_street').prop('checked', false);
			strSummaryUnloading = "<h4>Unloading</h4>We need unloading service<br/><br/>";
			strSummaryUnloadingOptions = "<?= $strHtmlProvideFee ?>";
			strDivPrevDelivery = "divUnloadingBusiness";
			strDivPrevOther = "divUnloadingBusiness";
			$("<?= $strDivDeliveryOrOther ?>").removeClass("display_none");
		} 
		else if($("input[name='business_unloading_1']:checked").val() == "hand_unloading_service_oversize"){
			$("#divUnloadingOptions").addClass("display_none");
			$('#cb_unloading_street_oversize').prop('checked', true);
			strSummaryUnloading = "<h4>Unloading</h4>We need unloading service<br/><br/>";
			strSummaryUnloadingOptions = "<?= $strHtmlProvideFee ?>";
			strDivPrevDelivery = "divUnloadingBusiness";
			strDivPrevOther = "divUnloadingBusiness";
			$("<?= $strDivDeliveryOrOther ?>").removeClass("display_none");
		} 
	}

