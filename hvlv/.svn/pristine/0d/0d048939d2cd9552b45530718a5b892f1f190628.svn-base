	/* this function is used to split the address into Array.
	* each component up to 30 characters.
	* @param ImParcel $shipment
	* @return type
	*/
	public function prepAddrLines($addr)
	{
		$addr = trim($addr);
		$ls = preg_split('/[\n\r;]+/', $addr);
		if (sizeof($ls) == 1 && mb_strlen($addr) > 30) {
			$ls = AppHelper::mbstr_split($addr, 30);
		}
		$ls = array_slice($ls, 0, 2);
		$ls[0] = mb_substr($ls[0], 0, 30);
		if (!empty($ls[1])) {
			$ls[1] = mb_substr($ls[1], 0, 30);
		}
		return $ls;
	}

	public function trackingTnt($connote_no)
	{
		$data=[];
		$url= self::TRACKING_URL.$connote_no;
		$curl=new curl($url);
		$curl->setopt(CURLOPT_TIMEOUT, 600);
		$curl->exec();
		$result=$curl->result;
		$xml = simplexml_load_string($curl->result, "SimpleXMLElement", LIBXML_NOCDATA);
		$json = json_decode(json_encode($xml), true);
		if (isset($json['statusHistory']['status'])) {
			$statuses=$json['statusHistory']['status'];
			if (isset($statuses[0])) {
				foreach ($statuses as $oneStatus) {
					$statusCode=isset($oneStatus['statusCode'])?$oneStatus['statusCode']:"";
					$data[]=[date_format(date_create_from_format("d/m/Y H:i:s", $oneStatus['date']." ".$oneStatus['time']), 'Y-m-d H:i:s'),
						$oneStatus['statusDescription'],
						$oneStatus['depotName'],
						$statusCode
					];
				}
			} elseif (isset($statuses['statusCode'])) {
				$data[]=[ date_format(date_create_from_format("d/m/Y H:i:s", $statuses['date']." ".$statuses['time']), 'Y-m-d H:i:s'),
					$statuses['statusDescription'],
					$statuses['depotName'],
					$statuses['statusCode']
				];
			}
		}
		return $data;
	}
	
	/**
	 * create shipment for self own system;
	 * @param type $shipment
	 */
	public function createOneShipment($shipment)
	{
		$reply=['status'=>true,'msg'=>''];
		$data=['CSurburb'=> $this->collection_suburb,
			"CPostcode"=> $this->collection_postcode,
			"DSuburb"=>$shipment->cnee->suburb,
			"DPostcode"=>$shipment->cnee->postcode,
			"ServiceCode"=> $this->select_service_code,
		];
		$result= $this->getTntRoutingInfoFromTlaHK($data);
		if ($result['status']) {
			$shipment->ref= $this->genTNTConsignmentNo();
			$shipment->mdata['tnt']=$result['routing'];
			$shipment->nolog = true;
			$shipment->save();
			$shipment->nolog = false;
		} else {
			$reply['status']=false;
			$reply['msg']=$result['error'];
		}
		return $reply;
	}
	
	public function checkIfDelivery($suburb, $postcode,$address = '',$orgRateId = false)
	{
		$data=['CSurburb'=> $this->collection_suburb,
			"CPostcode"=> $this->collection_postcode,
			"DSuburb"=>$suburb,
			"DPostcode"=>$postcode,
			"ServiceCode"=> $this->select_service_code,
		];
		$result= $this->getTntRoutingInfoFromTlaHK($data);
		if ($result['status']) {
			if(!empty($orgRateId))
			{
				$orgRate = OrgRate::model()->findByPk($orgRateId);
				$code = $orgRate->code;
				if(preg_match("/amazon/i", $code))
				{
					return $this->isMatchAmazonOrB2B($postcode,$suburb,$address);
				}
			}

			return true;
		} else {
			return false;
		}
	}

	public static function isMatchAmazonOrB2B($postcode,$suburb,$address)
	{
		return AddressService::isMatchAmazonOrB2B($postcode,$suburb,$address);
	}

	public static function isMatchAmazon($postcode,$suburb,$address)
	{
		return AddressService::isMatchAmazon($postcode,$suburb,$address);
	}
	
	private function doRoutingRequest($data)
	{
		$data['DSuburb'] = str_replace("'", "&apos;", $data['DSuburb']);
		$key = $data['CSurburb'].$data['CPostcode'].$data['DSuburb'].$data['DPostcode'].$data['ServiceCode'];

		// if(!empty(SystemSetting::getTntResponse($key)))
		// {
		// 	$cache = SystemSetting::getTntResponse($key);
		// 	$this->log2filerout(
		// 	'Time: '.date('Y-m-d H:i:s')."\n".
		// 		"\nRequest: ". json_encode($data).
		// 		 "\nResponse: ". json_encode($cache)."\n\n"
		// 		);
		// 	return SystemSetting::getTntResponse($key);
		// }

		$reply=['status'=>true,'error'=>'','routing'=>
			['BinNumber'=>'','GatewayDepot'=>'','OnForwardingDepot'=>'','OriginDepot'=>'','Postcode'=>'','Suburb'=>'']];
		$url= self::ROUTING_URL;
		$i = 0;
		while ($i < 6) {
			try {
				$client = new SoapClient($url, [
					'login'=>'routingservice',  //username
					'password'=>'gfMHJS*f',     //password
					'trace' => 1,
					'soap_version' => SOAP_1_1,
					'encoding' => 'UTF-8',
					'stream_context' => stream_context_create([
						'http' => [
							'user_agent' => 'PHPSoapClient',
							'timeout' => 10,
						],
						'ssl' => [
							'verify_peer' => false,
							'verify_peer_name' => false,
						]
					])
				]);
				$result=$client->__soapCall('GetRoutingInformation', ["GetRoutingInformation"=>$data]);
			} catch (SoapFault $fault) {
				if ($i < 5) {
					$i++;
					continue;
				} else {
					$this->log2filerout(
						'Time: '.date('Y-m-d H:i:s')."\nURL: ".$url.
							"\nRequest: ". json_encode($data).
							 "\nResponse: ". json_encode($fault)."\n\n".(empty($client)? '' : $client->__getLastResponse())
							);
					return ['status' => false, 'error' => 'SOAP Fault: (faultcode: {$fault->faultcode}, faultstring: {$fault->faultstring})'];
				}
			}
			break;
		}
		$this->log2filerout(
			'Time: '.date('Y-m-d H:i:s')."\nURL: ".$url.
				"\nRequest: ". json_encode($data).
				 "\nResponse: ". json_encode($result)."\n\n"
				);
		$result=json_decode(json_encode($result), true);
		if (isset($result['GetRoutingInformationResult']['IsServiceSupported'])&&$result['GetRoutingInformationResult']['IsServiceSupported']=='true') {
			$reponseResult=$result['GetRoutingInformationResult'];
			$reply['routing']=[
				'BinNumber'=>$reponseResult['BinNumber'],
				'GatewayDepot'=>$reponseResult['GatewayDepot'],
				'OnForwardingDepot'=>$reponseResult['OnForwardingDepot'],
				'OriginDepot'=>$reponseResult['OriginDepot'],
				'Postcode'=>$reponseResult['Postcode'],
				'Suburb'=>$reponseResult['Suburb'],
			];
			SystemSetting::setTNTResponse($reply,$key);
		} else {
			$reply['status']=false;
			if (!empty($result['GetRoutingInformationResult']['Errors']['RoutingResponseError'])) {
				$errorResult=$result['GetRoutingInformationResult']['Errors']['RoutingResponseError'];
				if (!empty($errorResult['ErrorCode'])) {
					$reply['error'].="(".$errorResult['ErrorCode'].")".$errorResult['ErrorMessage'];
				} elseif (!empty($errorResult[0])) {
					foreach ($errorResult as $oneError) {
						$reply['error'].="(".@$oneError['ErrorCode'].")".@$oneError['ErrorMessage'];
					}
				}
			}

			SystemSetting::setTNTResponse($reply,$key);
		}
		return $reply;
	}

	public function doRoutingRequestPublic($data)
	{
		return $this->doRoutingRequest($data);
	}

	public function getTntRoutingInfoFromTlaHK($data)
	{
		$params = [];
		$params['data'] = $data; 
		$tlaApi = new TlaAPI();
		$result = $tlaApi->doTNTRouting($params);
		if($result['status']==1)
		{
			$data = $result['result'];
			return $data;
		}else
		{
			return ['status'=>false];
		}
	}

	/**
	 * Pre the File and Manifest to TNT
	 * @param type $rs array of shipments
	 * @return boolean
	 * @throws Exception
	 */
	public function preEt12File($rs)
	{
		$lf=Yii::app()->basePath.DIRECTORY_SEPARATOR.'runtime'.DIRECTORY_SEPARATOR  . 'tntapi' . DIRECTORY_SEPARATOR.'tntmanifest'.DIRECTORY_SEPARATOR;
		if (!file_exists($lf)) {
			mkdir($lf);
		}
		$transaction_id= TntAPI::genTransactionId();
		$manifest_id=TntAPI::genManifestId();
		if (empty($transaction_id) || empty($manifest_id)) {
			return false;
		}

		//$fileName="PCAEXP".date("dmHi");
		$fileName="TLA".date("md").substr($manifest_id, -4);
		$file=$lf.$fileName.'.dat';
		$this->log2file('Time: '.date('Y-m-d H:i:s').' transaction_id: '.$transaction_id.' manifest_id: '.$manifest_id.' file: '.$file.PHP_EOL);
		$content='';
		$this->preEt12Header($content, $transaction_id, $manifest_id);
		foreach ($rs as $shipment) {
			$this->log2file($shipment->hbn."\t".$shipment->ref.PHP_EOL);
			$this->preEt12Consignment($content, $manifest_id, $shipment);
		}
		$this->preEt12Tailer($content, $transaction_id);
		file_put_contents($file, $content);
		if ($this->upLoadManifestFile($file,$content)) {
			$this->log2file('FTP upload successful'.PHP_EOL);
			$rate_id = ImportChargeCode::TNT_SYDNEY_ID;
			if ($this->select_service == TntAPI::SERVICE_MEL) {
				$rate_id = ImportChargeCode::TNT_MELBOURNE_ID;
			}
			if ($this->select_service == TntAPI::SERVICE_BNE) {
				$rate_id = ImportChargeCode::TNT_BRISBANE_ID;
			}
			if ($this->select_service == TntAPI::SERVICE_SYD_TOP) {
				$rate_id = ImportChargeCode::TNT_SYDNEY_ID_TOP;
			}

			if ($this->select_service == TntAPI::SERVICE_MEL_TOP) {
				$rate_id = ImportChargeCode::TNT_MELBOURNE_ID_TOP;
			}

			if ($this->select_service == TntAPI::SERVICE_BNE_TOP) {
				$rate_id = ImportChargeCode::TNT_BRISBANE_ID_TOP;
			}

			if ($this->select_service == TntAPI::SERVICE_PER_TOP) {
				$rate_id = ImportChargeCode::TNT_PERTH_ID_TOP;
			}

			$mani = new Manifest;
			$mani->type = 90;
			$mani->fwd_id = Org::ORGID_COURIER_TNT;
			$mani->ref = $fileName;
			$mani->save();
			$transaction=Yii::app()->db->beginTransaction();
			try {
				foreach ($rs as $r) {
					if (empty($r->trans)) {
						$ts=new Tranship();
						$maniMap = new ManiMap();
						$maniMap->mani_id = $mani->id;
						$maniMap->model = 'ImParcel';
						$maniMap->fid = $r->id;
						$maniMap->status = 10;
						$maniMap->mdata['mani_time'] = date('Y-m-d H:i:s');
						$maniMap->save();
					} else {
						$ts=$r->trans[0];
					}
					$r->mdata['manifest_weight']=sprintf('%.03f', $r->weight*0.75);
					$r->updateMeta();
					$ts->org_id = Org::ORGID_COURIER_TNT;  // for Fastway post office
					$ts->man_id = $r->man_id;
					$ts->pid=$r->id;
					$ts->type = 80;  // shipment transfer to a different delivery courier
					$ts->status = 19; // in finally moving status
					$ts->connote = $r->ref;
					$ts->time = date('Y-m-d H:i:s');
					$ts->cost = number_format($this->getTntCost($r, $rate_id), 2, '.', '');
					$ts->mdata['oid']=$transaction_id;
					$ts->save();
				}
				$transaction->commit();
			} catch (Exception $ex) {
				$transaction->rollback();
				throw $ex;
			}
			$this->moveFile($file);
			return true;
		} else {
			//unlink($file);
			return false;
		}
	}
	
	public function getTntCost($shipment, $rate_id=ImportChargeCode::TNT_SYDNEY_ID_TOP)
	{
		$price = 0;
		$postcode = $shipment->postcode;
		$zoneMap = ZoneMap::model()->find('org_id = :oid AND zone_id = :zoneid AND pc_lo <= :code AND pc_hi >= :code', [':oid' =>Org::ORGID_COURIER_TNT ,':zoneid' => 1,':code' => $postcode]);
		$chargeCode = 'N1';
		if (!empty($zoneMap) && !empty($zoneMap['z1'])) {
			$chargeCode = $zoneMap['z1'];
		}
		$weight=$shipment->getCubeWeight();
		$suburb = $shipment->cnee->suburb;
		$zrs = ZoneRate::model()->findAll("zone = :s AND (weight_lo < :w AND weight_hi >= :w) AND rate_id = :rateid AND base+item+perkg > 0 ", [':s' => $chargeCode, ':w' => $weight, ':rateid' => $rate_id]);
		if (!empty($zrs)) {
			// get maximum one
			foreach ($zrs as $zr) {
				$temp = $zr['base'] + $zr['item'];
				if ($zr['nkg'] > 0) {
					$wl = $weight- ($zr['base'] > 0 ? $zr['nkg'] : 0);
					$temp += ceil($wl / $zr['nkg']) * $zr['perkg'];
				} else {
					$temp +=  $weight * $zr['perkg'];
				}
				if ($zr['minimum'] > 0 && $temp < $zr['minimum']) {
					$temp = $zr['minimum'];
				}
				$price = max($price, $temp);
			}
		}

		if($price>0)
		{
			$remoteCostRate = RemoteChargeRate::model()->find("rate_id = :rateId and (postcode =:postcode or CONCAT('0',postcode)=:postcode) and upper(suburb) = :suburb and (perkg+base)>0",[":rateId"=>$rate_id,":postcode"=>$postcode,":suburb"=>strtoupper($suburb)]);
			if(!empty($remoteCostRate))
			{
				$remoteSurcharge = $weight*$remoteCostRate->perkg+$remoteCostRate->base;
				$price+=$remoteSurcharge;
			}

			if(empty($shipment->mdata['is_b2b']))
			{
				if($weight<=35)
				{
					$price = $price + 50;
				}else
				{
					$price = $price + 170;
				}
			}

		}

		return $price;
	}
	
	
	private function preEt12Header(&$content, $transaction_id, $manifest_id)
	{
		$content.= str_pad("A", 1);
		$content.= str_pad($transaction_id, 20, '0', STR_PAD_LEFT);
		$content.= str_pad(" ", 15); //sender interchange address
		$content.= str_pad(" ", 15);  // receiver interchange address
		$content.= str_pad(" ", 12); //trading Partner identifier
		$content.=str_pad("TNT", 3);
		$content.=str_pad(date('YmdHi'), 12);//file generation date and file generation Time
		$content.=str_pad('12', 2);
		$content.=str_pad(" ", 8);//routing effective date
		$content.= str_pad(" ", 3);
		$content.="\n";
		$content.= str_pad("B", 1);
		$content.= str_pad($manifest_id, 10, '0', STR_PAD_LEFT);
		$content.=str_pad($this->select_sender_code, 15);
		$content.= str_pad($this->select_account_number, 10);
		$content.= str_pad("Top Logistics", 30);
		$content.= str_pad($this->collection_address, 30);
		$content.= str_pad(" ", 30);
		$content.= str_pad($this->collection_suburb, 20);
		$content.= str_pad($this->collection_state, 3);
		$content.= str_pad($this->collection_postcode, 4);
		$content.= str_pad(" ", 20);
		$content.= str_pad(" ", 13);
		$content.="\n";
	}

	private function preEt12Consignment(&$content, $manifest_id, ImParcel $shipment)
	{
		$consignment_no=trim($shipment->ref);
		$content.= str_pad("C", 1);
		$content.= str_pad($manifest_id, 10);
		$content.= str_pad($consignment_no, 15);
		$content.= str_pad($shipment->pkg, 3);
		$content.= str_pad(" ", 15);
		$content.= str_pad(" ", 10);//Receiver Account Number
		$content.= str_pad(substr($shipment->cnee->name, 0, 30), 30);  //receiver name
		$cneeAddr= $this->prepAddrLines($shipment->cnee->address);
		$content.= str_pad($cneeAddr[0], 30); //address line1
		$content.= str_pad(isset($cneeAddr[1])?$cneeAddr[1]:"", 30); //address line2
		$content.= str_pad(substr($shipment->cnee->suburb, 0, 20), 20);
		$content.= str_pad(strtoupper($shipment->cnee->state), 3);//state
		$content.= str_pad($shipment->cnee->postcode, 4);
		$content.= str_pad(substr($shipment->cnee->name, 0, 20), 20);
		$content.= str_pad(substr($shipment->cnee->tel, 0, 13), 13);
		$content.=str_pad(date('dmY'), 8);//con note date
		$content.= str_pad("76", 4);  //service
		if(!empty($shipment->mdata['is_dg']))
		{
			$content.= str_pad("1", 1); //dangerous goods flag
		}else
		{
			$content.= str_pad("0", 1); //dangerous goods flag
		}
		$content.= str_pad("S", 1); // Payer flag, here we choose the sender to pay the money
		$content.= str_pad("0", 1); // canlled flag
		$content.= str_pad("0", 1);// foodstuffs flag
		if(empty($shipment->insurance) || floatval($shipment->insurance) == 0 || empty($shipment->mdata['tnt_warranty_class'])){
			$content.= str_pad(" ", 8); //extended Warranty value
		}else{
			$content.= str_pad($shipment->insurance, 8); //extended Warranty value
			$content.= $shipment->mdata['tnt_warranty_class']; //extended Warranty Class
		}
		$content.= str_pad(" ", 3);  //Additional Service1
		$content.= str_pad(" ", 3);  //additional service2
		$content.= str_pad(" ", 3);  //additional service3
		$content.= str_pad(" ", 3);  //additional service4
		$content.= str_pad(" ", 3);  //additional service5
		$content.= str_pad(" ", 9);  //handrate amount
		$content.= str_pad(" ", 9);  //Other Charges
		$content.= str_pad(" ", 30);  //customer Consignment Reference
		$content.="\n";
		// add lines;
		$dimInfo=$shipment->getPackDimensions();
		$singleWeight= sprintf('%.03f', ($shipment->weight/$shipment->pkg)*0.75);
		$singlePackItemQuantity=1;            //($shipment->itemsTotQty()/$shipment->pkg) > 998 ? 998:ceil($shipment->itemsTotQty()/$shipment->pkg);
		for ($index=1; $index<=$shipment->pkg;$index++) {
			$length=sprintf('%.03f', isset($dimInfo[$index-1]['length'])?$dimInfo[$index-1]['length']:10);
			$width=sprintf('%.03f', isset($dimInfo[$index-1]['width'])?$dimInfo[$index-1]['width']:10);
			$height=sprintf('%.03f', isset($dimInfo[$index-1]['height'])?$dimInfo[$index-1]['height']:10);
			$content.= str_pad("F", 1);
			$content.= str_pad($manifest_id, 10);
			$content.= str_pad($consignment_no, 15);
			$content.= str_pad($index, 3);//line sequence
		$content.= str_pad(" ", 15); //Customer Reference, Optional
		$content.= str_pad(substr("carton", 0, 20), 20); //description of goods
		$content.= str_pad(" ", 6); // commodity code
		$content.= str_pad($singlePackItemQuantity, 5);
			$content.= str_pad($singleWeight, 9);  //single line weight
		$content.= str_pad("KG", 2); //Unit of Measure
		$content.= str_pad($length, 7); //length;
		$content.= str_pad($width, 7); //length;
		$content.= str_pad($height, 7); //length;
		$content.= str_pad("CM", 2);
			$content.= str_pad(number_format(($length*$width*$height/1000000), 4, '.', ''), 10);// cubic volume
			$content.= str_pad("CO", 2);
			$content.= str_pad(" ", 5); //Article Qty
		$content.= str_pad(" ", 5); //Garment Qty
		$content.="\n";
		}
		$index=1;
		for ($itemRecordNumber=1;$itemRecordNumber<=ceil($shipment->pkg/8);$itemRecordNumber++) {
			$content.= str_pad("H", 1);
			$content.= str_pad($manifest_id, 10);
			$content.= str_pad($consignment_no, 15);
			$content.= str_pad($itemRecordNumber, 3);
			while ($index<=$shipment->pkg) {
				$content.= str_pad(self::genItemUniqueNumber($consignment_no, $index), 20);
				if ($index%8==0) {
					$index++;
					break;
				}
				$index++;
			}
			$content.="\n";
		}
	}

	private function preEt12Tailer(&$content, $transaciton_id)
	{
		$content.= str_pad("Z", 1);
		$content.= str_pad($transaciton_id, 20);
		$line_number= substr_count($content, "\n")+1;
		$content.= str_pad($line_number, 5);
	}

	public static function genItemUniqueNumber($connote_no, $index)
	{
		$no= self::ITEM_UNIQUE_NUMBER;// $assigned by TNT
		$preFix= substr($connote_no, 0, 3);
		for ($i=0;$i<strlen($preFix);$i++) {
			$no.=(ord($preFix[$i]) - 55);
		}
		$no.=substr($connote_no, 3);
		$no.= sprintf("%03d", $index);
		return $no;
	}
	
	public static function decodePrefix($number)
	{
		$prefix = "";
		for ($i = 0; $i < strlen($number); $i=$i + 2) {
			$prefix.=chr(intval(substr($number, $i, 2)) + 55);
		}
		return $prefix;
	}

