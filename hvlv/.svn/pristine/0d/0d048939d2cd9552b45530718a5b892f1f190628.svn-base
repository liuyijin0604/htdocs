	public function genTNTConsignmentNo()
	{
		if ($this->select_service==self::SERVICE_MEL) {
			return TntAPI::genTNTMelConsignmentNo();
		}
		if ($this->select_service==self::SERVICE_BNE) {
			return TntAPI::genTNTBneConsignmentNo();
		}

		if ($this->select_service==self::SERVICE_SYD_TOP) {
			return TntAPI::genTNTSydConsignmentNoTOP();
		}
		if ($this->select_service==self::SERVICE_MEL_TOP) {
			return TntAPI::genTNTMelConsignmentNoTOP();
		}
		if ($this->select_service==self::SERVICE_BNE_TOP) {
			return TntAPI::genTNTBneConsignmentNoTOP();
		}
		if ($this->select_service==self::SERVICE_PER_TOP) {
			return TntAPI::genTNTPerConsignmentNoTOP();
		}
		
		return TntAPI::genTNTSydConsignmentNo();
	}
	
