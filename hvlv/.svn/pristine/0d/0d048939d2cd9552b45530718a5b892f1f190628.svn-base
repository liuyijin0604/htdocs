	private function __construct($user_id, $user_passwd, $service=self::SERVICE_SYD, $is_test)
	{
		$this->user_id = $user_id;
		$this->user_passwd = $user_passwd;
		$this->is_test = $is_test;
		if (isset(self::$api_accounts[$service])) {
			$selectedAccount = self::$api_accounts[$service];
			$this ->select_account_number = $selectedAccount['account_number'];
			$this->select_sender_code =$selectedAccount['sender_code'];
			$this->select_service = $service;
			$this ->collection_address =$selectedAccount['address'];
			$this ->collection_suburb = $selectedAccount['suburb'];
			$this ->collection_postcode = $selectedAccount['postcode'];
			$this ->collection_state = $selectedAccount['state'];
		}
	}

	public static function getTntInterface($o = 'syd')
	{
		switch ($o) {
			case 'mel':
				$service = self::SERVICE_MEL;
			break;
			case 'bne':
				$service = self::SERVICE_BNE;
			break;
			case 'test':
				$service = self::SERVICE_TEST;
			break;
			case self::str_syd_top:
				$service = self::SERVICE_SYD_TOP;
			break;
			case self::str_mel_top:
				$service = self::SERVICE_MEL_TOP;
			break;
			case self::str_bne_top:
				$service = self::SERVICE_BNE_TOP;
			break;
			case self::str_per_top:
				$service = self::SERVICE_PER_TOP;
			break;
			default:
				$service = self::SERVICE_SYD;
			break;
		}
		return new TntAPI(self::API_USER_ID, self::API_USER_PASSWORD, $service, false);
	}

