		public function cancelShipment($rs){
			$this->preParams($rs, 'N','N');
			$this->doRequest($params,'ProcessConsignmentRequest');
		}

		public function preParams($rs,$finalize='N',$cancel='N'){
		$consignmentProcess=[];
		foreach($rs as $r){
			$oneProcess=[];
			$oneProcess['consignment']= $this->preOneConsignment($r,$finalize,$cancel);
			$oneProcess['consignmentActionList']=
				array(
					'ConsignmentActionType'=>['SUBMIT'],    //GETLABEL     //GETROUTINGDATA  //SUBMIT  'GETROUTINGDATA','GETLABEL', //don't change this order please
				);
			if($finalize=='N'&&$cancel=='N'){
				$oneProcess['consignmentActionList'][ 'ConsignmentActionType'][]='GETROUTINGDATA';
				$oneProcess['consignmentActionList'][ 'ConsignmentActionType'][]='GETLABEL';
			}
			$oneProcess['senderCode']= self::SENDER_CODE;
			$oneProcess['labelType']='C';
			$consignmentProcess[]=$oneProcess;
		}
		$params=array(
			 'Request'=>array(
				 'UserName'=> $this->user_id,
				 'Password'=> $this->user_passwd,
				 'ConsignmentProcessList'=>[
					 'ConsignmentProcess'=>$consignmentProcess, //an array;
				 ], //list of consignment
			 )
		);
		return $params;
	}

	public function preOneConsignment($shipment,$finalize,$cancel){
		$consignment=array();
		if($finalize=='Y'||$cancel=='Y'){
			 $consignment['consignmentNumber']=trim($shipment->ref);
		}else{
				 $consignment['consignmentNumber']= self::genConsignmentNo();
		}
		$consignment['payingAccount']=self::ACCOUNT_NUMBER;
		$consignment['collection']=array(
			'Name'=>substr($shipment->cnor->name,0,30),
			'Address1'=>'6C The Crescent',
			'Suburb'=>'Kingsgrove',
			'State'=>'NSW',
			'Postcode'=>'2208',
		);
		$cneeAddr= $this->prepAddrLines($shipment->cnee->address);
		$consignment['delivery']=array(
			'Name'=>substr($shipment->cnee->name,0,30),
			'Address1'=>$cneeAddr[0],
			'Address2'=>isset($cneeAddr[1])?$cneeAddr[1]:"",
			'Suburb'=>$shipment->cnee->suburb,
			'State'=>$shipment->cnee->state,
			'Postcode'=>$shipment->cnee->postcode,
		);
		if(!empty($shipment->cnee->tel)) $consignment['delivery']['Phone']=$shipment->cnee->auTel();
		$consignment['consignmentDate']=date('dmY');
		$consignment['serviceCode']= $this->getServiceCode();
		$consignment['dangerousGoodsIndicator']='N';
		$consignment['payer']='S';
		$consignment['foodIndicator']='N';
		$consignment['cancelIndicator']=$cancel;/// set default to CancelIndicator at first.
		$consignment['consignmentFinaliseIndicator']=$finalize;  //Our manifest are all finalized!;

		//Prepare packline
		$singleWeight= sprintf('%.03f', $shipment->weight/$shipment->pkg);
		$singlePackItemQuantity=($shipment->itemsTotQty()/$shipment->pkg) > 998 ? 998:ceil($shipment->itemsTotQty()/$shipment->pkg);
		$dimInfo=$shipment->getPackDimensions();
		$packageLine=[];
		 for($index=1;$index<=$shipment->pkg;$index++){
			 $length=isset($dimInfo[$index-1]['length'])?$dimInfo[$index-1]['length']:10;
			 $width=isset($dimInfo[$index-1]['width'])?$dimInfo[$index-1]['width']:10;
			 $height=isset($dimInfo[$index-1]['height'])?$dimInfo[$index-1]['height']:10;
			 $temp=[];
			 $temp['lineSequence']=$index;
			 $temp['itemQuantity']= $singlePackItemQuantity;
			 $temp['DescriptionOfGoods']= substr($shipment->getGoods(),0,20);
			 $temp['lineWeight']=$singleWeight;
			 $temp['weightMeasureUnit']='KG';
			 $temp['itemLength']=$length;
			 $temp['itemWidth']=$width;
			 $temp['itemHeight']=$height;
			 $temp['dimensionMeasureUnit']='CM';
			 $temp['lineVolume']= number_format(($length*$width*$height/1000000),4,'.','');
			 $temp['volumeMeasureUnit']='CO';
			 $packageLine[]=$temp;
		}
		 $consignment['packageLineList']=array(
			'PackageLine'=>$packageLine,
		 );
		 return $consignment;
	}
	***
/
	/**
	 * send the soap request based on specific function
	 *
	 * @param type $data the function parmas, $function, the name of the function that we will call
	 * @return   An array of the response result;
	 *
	 * //need to do adding log about the request and response.
	 *
	 public function savePdfLabel($base64Content=''){
		$lf = Yii::app()->basePath.DIRECTORY_SEPARATOR.'runtime'.DIRECTORY_SEPARATOR  . 'tntLabel' . DIRECTORY_SEPARATOR;
		if(!file_exists($lf)) mkdir ($lf);
		$lf.= uniqid().'tnt.pdf';
		$pdf_decoded= base64_decode($base64Content);
		$pdf= fopen($lf,'w');
		fwrite($pdf, $pdf_decoded);
		$fclose=($pdf);

	}

	 $url=$this->is_test?self::TEST_URL:self::PRODUCTION_URL;
	 $client = new SoapClient($url, array(
			'trace' => 1,
			'soap_version' => SOAP_1_1,
			'encoding' => 'UTF-8',
			'stream_context' => stream_context_create([
				'http' => array(
					'user_agent' => 'PHPSoapClient',
				),
				'ssl' => [
					'verify_peer' => false,
					'verify_peer_name' => false,
				]
			])
		));

	 try {
			$result = $client->{$function}($data);
//            var_dump($result);
		} catch (Exception $ex) {
			echo $ex;
		}
		$sendRequest=$client->__getLastRequest();
		$xmlResponse=$client->__getLastResponse();

		$response = preg_replace("/(<\/?)(\w+):([^>]*>)/", "$1$2$3", $xmlResponse);
		$xml = new SimpleXMLElement($response);
		$body = $xml->xpath('//sBody')[0];
		$responseArray = json_decode(json_encode((array)$body), TRUE);
		$status=@$responseArray[$function."Response"][$function.'Result']['aStatus'];
		$this->log2file('Time: '.date('Y-m-d H:i:s')."\nURL: ".$url."\nFunction: ".$function.
				"\nRequest: ". json_encode($data).
				"\nSend Request: ".$sendRequest.
				"\nStatus: ".$status .
				 "\nResponse: ".$xmlResponse."\n\n"
				);
		if($status=="SUCCESS"){
			return  @$responseArray[$function."Response"][$function.'Result'];
		}else {
			return false;
		}
	}

	 /**
	* Reprint the label for the TNT
	* @param type $shipment which already have TNT consignment number
	*/
	 /**
	 public function rePrintLabel($shipment){
		$data= $this->preReprintLabelParams($shipment);
		$result=$this->doRequest($data,'ReprintLabelRequest');
		$this->savePdfLabel($result['aReprintActionResult']['aLabelPDF']);
	}

	private function preReprintLabelParams($shipment){
		echo $shipment->ref;
		$params=array(
			'Request'=>array(
				'UserName'=> $this->user_id,
				'Password'=> $this->user_passwd,
				'ConsignmentNumber'=>trim($shipment->ref),
				'labelType'=>'C',
			)
		);
		return $params;
	}
	/**
	private function preRrtXmlData(ImParcel $shipment){
		$xml = new SimpleXMLElement('<?xml version="1.0"?><enquiry xmlns="http://www.tntexpress.com.au"></enquiry>');
		$ratedTransitTimeEnquiry=$xml->addChild('ratedTransitTimeEnquiry');
		$cutOffTimeEnquiry=$ratedTransitTimeEnquiry->addChild('cutOffTimeEnquiry');
		$termsOfPayment=$ratedTransitTimeEnquiry->addChild('termsOfPayment');
		$termsOfPayment->addChild('senderAccount', self::ACCOUNT_NUMBER);
		$termsOfPayment->addChild('payer','S');
		$collectionAddress=$cutOffTimeEnquiry->addChild("collectionAddress");
		$deliveryAddress=$cutOffTimeEnquiry->addChild("deliveryAddress");
		$cutOffTimeEnquiry->addChild('shippingDate',date('Y-m-d',strtotime('next tuesday')));
		$cutOffTimeEnquiry->addChild('userCurrentLocalDateTime',date(DATE_ATOM));
		$dangerousGoods=$cutOffTimeEnquiry->addChild('dangerousGoods');
		$dangerousGoods->addChild('dangerous','false');
		$packageLines=$cutOffTimeEnquiry->addChild('packageLines');
		$packageLines->addAttribute('packageType','D');
		$packageLine=$packageLines->addChild('packageLine');
		$singleWeight= ceil($shipment->weight/$shipment->pkg);
		$packageLine->addChild('numberOfPackages',$shipment->pkg);
		$dimensions=$packageLine->addChild('dimensions');
		$dimInfo=$shipment->getPackDimensions();
		$dimensions->addAttribute('unit','cm');
		$dimensions->addChild('length',$dimInfo[0]['length']);
		$dimensions->addChild('width',$dimInfo[0]['width']);
		$dimensions->addChild('height',$dimInfo[0]['height']);
		$weight=$packageLine->addChild('weight');
		$weight->addAttribute('unit','kg');
		$weight->addChild('weight',$singleWeight);
		$collectionAddress->addChild('suburb','Banksmeadow');
		$collectionAddress->addChild('postCode','2019');
		$collectionAddress->addChild('state','NSW');
		$deliveryAddress->addChild('suburb',$shipment->cnee->suburb);
		$deliveryAddress->addChild('postCode',$shipment->cnee->postcode);
		$deliveryAddress->addChild('state',$shipment->cnee->state);
		return $xml->asXML();
	}
	 *
