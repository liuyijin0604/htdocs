		</tr>
		</table>
		<p style="font-size:1.4em"><?=ucwords(strtolower($label->cnee->name));?>
					 <?php if (!empty($label->cnee->company) && $label->cnee->company != $label->cnee->name) {
	echo ", ".substr(ucwords(strtolower($label->cnee->company)), 0, 33);
}?><br />
