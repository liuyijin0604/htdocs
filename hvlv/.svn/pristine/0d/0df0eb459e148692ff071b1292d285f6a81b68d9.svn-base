<table width="100%" border="0" cellspacing="0" cellpadding="0">
	<tr>
		<td width="270" height="130" rowspan="1" style="border-right: 1px solid; font-size: 0.95em;" valign="top"><b>SENDER</b><br />
		<?php
		$oc = OrgContact::model()->find('org_id = :id AND status = 1 AND func & 8 > 1', [':id' => $label->agent_id]);
		$name=$default_rts? Org::COMPANY_NAME_SL : $label->cnor->name;
		$org=$label->agent;
		if (!empty($org->extra['delivery_label_name'])) {
		 	$name=$org->extra['delivery_label_name'];
		}
		$sender_name = $name;
		$ssn1 = false;
		$warehouseAddress=Org::IM_COMPANY_ADDRESS_TLA.'&nbsp;'.Org::IM_COMPANY_CITY_TLA;
		if (preg_match('/33EVH\d{7}/', $label->ref)) {//Melbourne
			$warehouseAddress=Org::IM_COMPANY_ADDRESS_TLA.'&nbsp;'.Org::IM_COMPANY_CITY_TLA;
			// $warehouseAddress="18 Grimes Court <br />DERRIMUT VIC 3026";
		}elseif(preg_match('/33FJV\d{7}/', $label->ref)){ //winit Syd
			$name = 'Online Seller';
			$warehouseAddress="Block A2, 391 Park Road<br />Regents Park, NSW 2143";
			$ssn1 = true;
		}elseif(preg_match('/33FKB\d{7}/', $label->ref)){ //winit mel
			$name = 'Online Seller';
			$warehouseAddress="1-5 Felstead Drive<br />Truganina, VIC 3029";
			$ssn1 = true;
		}elseif(preg_match('/33MBQ\d{7}/', $label->ref)){ //winit mel
			$name = 'Peter - '.$label->agent_id;
			$warehouseAddress="PO Box 7199<br />Wetherill Park, NSW 2164";
			$ssn1 = true;
		}
		if(in_array($label->agent_id, [1427, 1656])){ //d2z
			$warehouseAddress="18 Grimes Court <br />DERRIMUT VIC 3026";
		}

		if (empty($oc) || $default_rts):
		?>
		<?=$name;?>, &nbsp;&nbsp;
		<?=$warehouseAddress?>
		<br>Not to be returned in person</p>
		<?php else:
			echo $oc->name, '<br />',
			$oc->address, '<br />',
			$oc->suburb, ', ', $oc->state, ' ', $oc->postcode;
		endif; ?>
		</td>
		<td valign="top" style="font-size: 16px;">
		<div style="width: 310px; border: 2px solid black;padding:2px; margin-left: 5px;">
			<p align="center" style="font-size:28px;font-weight: bold">Road Transport Only</p>
			<p align="center">Not to be moved by air</p>
			</div>
		</td>
	</tr>
	<tr>
		<td valign="top" height="65"  style="border-top: 1px solid;font-size: 0.90em;">
	<span style="font-size: 1.8em;"><?=$label->hbn;?></span><br /><br />
		<?php
		// show RTS tranship original parcel No.
		if (isset($label->mdata['rts_org_no'])) {
			echo $label->mdata['rts_org_no'] . '(RTS Original)<br/>';
		}
		?>
		Ref: <span style="font-size: 1.3em;"><?=$label->cref;?></span><?php if(in_array($label->agent_id, [650]) && !empty($label->cref)){
	$bc = new TCPDFBarcode($label->cref, 'C128');
	echo '<p style="padding:5px 0">';
	$bc->getBarcodeSVG(2, 40, 'black');
	echo '</p>';
	}
	if (!empty($label->mdata['cust_ref1'])) {
			echo '<br/>Ref1: '.$label->mdata['cust_ref1'];
		}
	$scan_number=$label->ref.($label->pkg > 1? '-'.$pkg_sn : '');
	$b = 3;
	if (in_array($label->agent_id,[1002,2740])) {
		$scan_number=$label->cref;
