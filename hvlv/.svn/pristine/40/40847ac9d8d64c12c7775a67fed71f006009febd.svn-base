    private function createConsol($pallet_request)
    {
        $currentMonth = date('Ym');
        switch ($pallet_request->dpt_id) {
            case 106:
                $consolNumber = 'SPR' . $currentMonth;
                $pol = 'AUSYD';
                $pod = 'AUSYD';
                break;
            case 218:
                $consolNumber = 'MPR' . $currentMonth;
                $pol = 'AUMEL';
                $pod = 'AUMEL';
                break;
            case 530:
                $consolNumber = 'BPR' . $currentMonth;
                $pol = 'AUBNE';
                $pod = 'AUBNE';
                break;
            case 811:
                $consolNumber = 'PPR' . $currentMonth;
                $pol = 'AUPER';
                $pod = 'AUPER';
                break;
            default:
                $consolNumber = 'SPR' . $currentMonth;
                $pol = 'AUSYD';
                $pod = 'AUSYD';
        }
        $sql = 'SELECT * FROM consol WHERE `no` = "' . $consolNumber . '" AND `dpt_id` = ' . $pallet_request->dpt_id . ' AND `status` != ' . ImcoConsol::Status_Cancelled;
        $consol = Consol::model()->findBySql($sql);
        if (!empty($consol)) {
            return $consol->id;
        } else {
            $consol = new ImcoConsol();
            $consol->no = $consolNumber;
            $consol->owner_id = 0;
            $consol->dpt_id = $pallet_request->dpt_id;
            $consol->carrier_id = 0;
            $consol->type = Consol::IMCOCONSOLTYPE;
            $consol->service = 0;
            $consol->pol = $pol;
            $consol->pod = $pod;
            $consol->eta = date('Y-m-d');
            $consol->created = date('Y-m-d');
            $consol->status = ImcoConsol::NEW_TYPE;
            $consol->save();
            return $consol->id;
        }
    }

    /**
     * Generate pallet request based on courier
     */
    public function generatePalletRequestByCourier($consol, $ownerId)
    {
        $errors = [];
        $fastwayShipments = [];
        $courierPleaseShipments = [];
        foreach ($consol->shipments as $shipment) {
            if (ImParcelService::checkGatePassTypeOfShipment($shipment) == Org::ORGID_COURIER_FASTWAY && in_array($shipment->status, [ImParcel::STATE_CLEAR, ImParcel::STATE_LOCAL_ARRIVAL])) {
                array_push($fastwayShipments, $shipment);
            } else if (ImParcelService::checkGatePassTypeOfShipment($shipment) == 'courierplease' && in_array($shipment->status, [ImParcel::STATE_CLEAR, ImParcel::STATE_LOCAL_ARRIVAL])) {
                array_push($courierPleaseShipments, $shipment);
            }
        }

        if (count($fastwayShipments) > 0) {
            $errors = $this->pushShipmentsToPalletRequest($consol, $ownerId, $fastwayShipments, Org::ORGID_COURIER_FASTWAY);
        }

        if (count($courierPleaseShipments) > 0) {
            $errors = $this->pushShipmentsToPalletRequest($consol, $ownerId, $courierPleaseShipments, 'courierplease');
        }

        return $errors;
    }

    private function pushShipmentsToPalletRequest($consol, $ownerId, $shipments, $courier)
    {
        $errors = [];
        if ($consol->service == Consol::AIRCONSOL) {
            switch ($consol->dpt_id) {
                case 106:
                    $ref = 'SPR' . $consol->awb . '_' . $courier;
                    break;
                case 218:
                    $ref = 'MPR' . $consol->awb . '_' . $courier;
                    break;
                case 530:
                    $ref = 'BPR' . $consol->awb . '_' . $courier;
                    break;
                default:
                    $ref = 'SPR' . $consol->awb . '_' . $courier;
            }
        } else if ($consol->service == Consol::SEACONSOL) {
            switch ($consol->dpt_id) {
                case 106:
                    $ref = 'SPR' . $consol->container_no . '_' . $courier;
                    break;
                case 218:
                    $ref = 'MPR' . $consol->container_no . '_' . $courier;
                    break;
                case 530:
                    $ref = 'BPR' . $consol->container_no . '_' . $courier;
                    break;
                default:
                    $ref = 'SPR' . $consol->container_no . '_' . $courier;
            }
        }
        $palletRequest = CargoProcessPlan::model()->findByAttributes(array('ref' => $ref), 'status != 100');
        if (empty($palletRequest)) {
            $palletRequest = new CargoProcessPlan();
            $palletRequest->ref = $ref;
            if ($consol->service == Consol::AIRCONSOL) {
                $palletRequest->mdata['Ref'] = $consol->awb . '_' . $courier;
            } else if ($consol->service == Consol::SEACONSOL) {
                $palletRequest->mdata['Ref'] = $consol->container_no . '_' . $courier;
            }

            // If pallet request already exists, return
            $oldPalletRequest = CargoProcessPlan::model()->findByAttributes(array('ref' => $palletRequest->ref), 'status != 100');
            if (!empty($oldPalletRequest)) {
                array_push($errors, 'Pallet request already exists.');
                return $errors;
            }

            $palletRequest->agent_id = $ownerId;
            $palletRequest->dpt_id = $consol->dpt_id;
            $palletRequest->ot_id = 50; // Department: Top Courier Service
            $palletRequest->type = 30;
            if (!empty($consol->mdata['ContainerUnloadDate'])) {
                $palletRequest->schedule_time = date('Y-m-d H:i:s', strtotime($consol->mdata['ContainerUnloadDate'] . '+1 day'));
                $palletRequest->due_time = date('Y-m-d H:i:s', strtotime($consol->mdata['ContainerUnloadDate'] . '+2 day'));
            } else {
                $palletRequest->schedule_time = date('Y-m-d 00:00:00', strtotime(date('Y-m-d') . '+1 day'));
                $palletRequest->due_time = date('Y-m-d 00:00:00', strtotime(date('Y-m-d') . '+2 day'));
            }

            $weight = 0.0;
            $cbm = 0.0;
            $totalCbm = 0;
            $pkg = 0;
            $hbns = '';
            $shipmentIds = [];
            foreach ($shipments as $s) {
                $weight += $s->weight;
                $totalCbm += $s->cbm * $s->pkg;
                $pkg += $s->pkg;
                $hbns .= $s->hbn . ", ";
                array_push($shipmentIds, $s->id);
            }
            $cbm = round($totalCbm / $pkg, 5);
            if ($courier == Org::ORGID_COURIER_FASTWAY) {
                $pallets = !empty($consol->mdata['pallet_count_fastway']) ? intval($consol->mdata['pallet_count_fastway']) : 0;
                $cages = !empty($consol->mdata['cage_count_fastway']) ? intval($consol->mdata['cage_count_fastway']) : 0;
            } else {
                $pallets = !empty($consol->mdata['pallet_count_courier_plz']) ? intval($consol->mdata['pallet_count_courier_plz']) : 0;
                $cages = !empty($consol->mdata['cage_count_courier_plz']) ? intval($consol->mdata['cage_count_courier_plz']) : 0;
            }
            
            // if cages is odd, pallets = cages + 1; otherwise pallets = cages
            if ($cages % 2 != 0) {
                $palletRequest->pallets = $pallets + $cages + 1;
            } else {
                $palletRequest->pallets = $pallets + $cages;
            }
            $palletRequest->pallets_note = $pallets . " pallets, " . $cages . " cages.";
            $palletRequest->mdata['dim_delivery'] = 1;  // Dimension info: pallets  
            $palletRequest->note = $hbns;

            // if number of pallets = 0: set pallet request status to New; else set it to Confirmed
            if ($palletRequest->pallets == 0) {
                //$palletRequest->status = 10; // status New
                return [];
            } else {
                $palletRequest->status = 20;    // status Confirmed
            }
            $palletRequest->creater = !empty(Yii::app()->user) ? Yii::app()->user->id : 0;
            $palletRequest->create_time = date('Y-m-d H:i:s');
            $palletRequest->need_invoice = 2;   // Need Create Invoice: Cartage
            $palletRequest->weight = $weight;
            $palletRequest->cbm = $cbm;
            $palletRequest->pkg = $pkg;
            $palletRequest->mdata['shipment_ids'] = $shipmentIds;
            $palletRequest->mdata['consol_id'] = $consol->id;
            $palletRequest->mdata['generated_from_consol'] = 1;
            if ($palletRequest->save()){
                $shipmentId = $this->generateShipment($consol, $palletRequest, $ownerId, $courier);
                $imParcel = ImParcel::model()->findByPk($shipmentId);
                if (!empty($imParcel)) {
                    $palletRequest->mdata['cnor']['name'] = $imParcel->cnor->name;
                    $palletRequest->mdata['cnor']['tel'] = $imParcel->cnor->tel;
                    $palletRequest->mdata['cnor']['address'] = $imParcel->cnor->address;
                    $palletRequest->mdata['cnor']['suburb'] = $imParcel->cnor->suburb;
                    $palletRequest->mdata['cnor']['city'] = $imParcel->cnor->city;
                    $palletRequest->mdata['cnor']['state'] = $imParcel->cnor->state;
                    $palletRequest->mdata['cnor']['postcode'] = $imParcel->cnor->postcode;
                    $palletRequest->mdata['cnor']['country'] = $imParcel->cnor->country;
                    $palletRequest->mdata['cnee']['name'] = $imParcel->cnee->name;
                    $palletRequest->mdata['cnee']['tel'] = $imParcel->cnee->tel;
                    $palletRequest->mdata['cnee']['address'] = $imParcel->cnee->address;
                    $palletRequest->mdata['cnee']['suburb'] = $imParcel->cnee->suburb;
                    $palletRequest->mdata['cnee']['city'] = $imParcel->cnee->city;
                    $palletRequest->mdata['cnee']['state'] = $imParcel->cnee->state;
                    $palletRequest->mdata['cnee']['postcode'] = $imParcel->cnee->postcode;
                    $palletRequest->mdata['cnee']['country'] = $imParcel->cnee->country;
                    $palletRequest->mdata['shipment_id'] = $imParcel->ref;
                    $palletRequest->mdata['shipment_id_no'] = $imParcel->id;
                    $palletRequest->save();
                }

                $maniMap = ManiMap::model()->findByAttributes(array('fid' => $shipmentId));
                if (!empty($maniMap)) {
                    foreach ($shipments as $s) {
                        $tempManiMap = new ManiMap();
                        $tempManiMap->mani_id = $maniMap->mani_id;
                        $tempManiMap->model = 'ImParcel';
                        $tempManiMap->fid = $s->id;
                        $tempManiMap->mdata['cargo_process_id'] = $maniMap->mdata['cargo_process_id'];
                        $tempManiMap->status = 10;
                        $tempManiMap->save();
                    }
                }

                $gatepass=new GatepassShipment();
                $gatepass->scan_time=date('Y-m-d H:i:s');
                $gatepass->fid= $shipmentId;
                $gatepass->connote_no=$imParcel->ref;
                $gatepass->sno=0;
                $gatepass->courier_id=114;
                $gatepass->shipment_status=$imParcel->status;
                $gatepass->warehouse=$consol->dpt_id;
                $gatepass->status = 0;
                $gatepass->save();
            } else {
                array_push($errors, 'Pallet request save failed.');
            }
            return $errors;
        } else {
            // update existing one
            if (!in_array($palletRequest->status, array(30, 100))) {
                
                // only update pallet request in status "New" or "Confirmed"
                if ($courier == Org::ORGID_COURIER_FASTWAY) {
                    $pallets = !empty($consol->mdata['pallet_count_fastway']) ? intval($consol->mdata['pallet_count_fastway']) : 0;
                    $cages = !empty($consol->mdata['cage_count_fastway']) ? intval($consol->mdata['cage_count_fastway']) : 0;
                } else {
                    $pallets = !empty($consol->mdata['pallet_count_courier_plz']) ? intval($consol->mdata['pallet_count_courier_plz']) : 0;
                    $cages = !empty($consol->mdata['cage_count_courier_plz']) ? intval($consol->mdata['cage_count_courier_plz']) : 0;
                }
                
                // if cages is odd, pallets = cages + 1; otherwise pallets = cages
                if ($cages % 2 != 0) {
                    $palletRequest->pallets = $pallets + $cages + 1;
                } else {
                    $palletRequest->pallets = $pallets + $cages;
                }
                $palletRequest->pallets_note = $pallets . " pallets, " . $cages . " cages.";
                $palletRequest->save();
            }
            return [];
        }
    }
}
