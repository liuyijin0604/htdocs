	public function fixCargoBookingInvLine()
	{
		Yii::app()->name = "TLA";
		$sql = "SELECT * FROM `hvlv_top`.`invoice` WHERE `no` IN (SELECT `hbn` FROM `hvlv_db`.`cargo_booking`) AND id NOT IN (SELECT inv_id FROM `hvlv_top`.`inv_line`)";
		$invoices = Invoice::model()->findAllBySql($sql);
		foreach($invoices as $invoice){
			$booking = CargoBooking::model()->findByAttributes(['hbn' => $invoice->no]);
			if(!empty($booking)) {
				$invoiceLineService = new InvLineService();
				$basePrice = floatval($booking->mdata['base_price']);
				$overSizeFee = floatval($booking->mdata['oversize_fee']);
				$timedDeliveryFee = floatval($booking->mdata['time_deliver_fee']);
				$unloadingFee = floatval($booking->mdata['unloading_fee']);
				$description = $booking->hbn . ' ' . $booking->other_ref;
				$invoiceLineService->createCargoBookingInvoiceLine($booking, $invoice->id, '#Base Price', $basePrice, $basePrice*0.1, $description, 1, '');
				if ($overSizeFee > 0) {
					$invoiceLineService->createCargoBookingInvoiceLine($booking, $invoice->id, '#Oversize Surcharge', $overSizeFee, $overSizeFee*0.1, $description, 1, '');
				}
				if ($timedDeliveryFee > 0) {
					$invoiceLineService->createCargoBookingInvoiceLine($booking, $invoice->id, '#Timed Delivery', $timedDeliveryFee, $timedDeliveryFee*0.1, $description, 1, 'OUTPUT');
				}
				if ($unloadingFee > 0) {
					$invoiceLineService->createCargoBookingInvoiceLine($booking, $invoice->id, '#Unloading', $unloadingFee, $unloadingFee*0.1, $description, 1, 'OUTPUT');
				}
			}
		}
	}

	public function updateBookingDepot()
	{
		Yii::app()->name = "TLA";
		$sql = "SELECT * FROM pickup_booking WHERE depot_id IS NULL AND (booking_number LIKE 'SBK%' OR booking_number LIKE 'MBK%' OR booking_number LIKE 'BBK%')";
		$bookings = PickupBooking::model()->findAllBySql($sql);
		foreach ($bookings as $booking) {
			if (preg_match('/SBK/i', $booking->booking_number)) {
				$booking->depot_id = 106;
			} elseif (preg_match('/MBK/i', $booking->booking_number)) {
				$booking->depot_id = 218;
			} elseif (preg_match('/BBK/i', $booking->booking_number)) {
				$booking->depot_id = 530;
			}
			$booking->save();
		}
		echo "Done.\n";
	}
}
