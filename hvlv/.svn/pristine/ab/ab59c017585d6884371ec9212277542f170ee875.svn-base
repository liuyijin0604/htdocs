	public function testBooking()
	{
		$sql = 'SELECT * FROM pickup_booking WHERE `booking_time` >= "2022-09-01 00:00:00" AND `booking_time` < "2022-10-31 23:59:59" AND `status` != 3 AND `booking_number` LIKE "S%"';
		$bookings = PickupBooking::model()->findAllBySql($sql);
		$occupiedSlots = [];
		if (!empty($bookings)) {
			foreach ($bookings as $booking) {
				$bookingDate = explode(" ", $booking->booking_time)[0];
				$bookingTime = explode(" ", $booking->booking_time)[1];

				if (empty($occupiedSlots[$bookingDate])) {
					$occupiedSlots[$bookingDate] = [$bookingTime];
				} else {
					array_push($occupiedSlots[$bookingDate], $bookingTime);
				}
			}
		}
		$currentDate = date('Y-m-d');
		$currentTime = date('H:i:s');
		echo $currentDate . "\n" . $currentTime . "\n";
		print_r($occupiedSlots);
	}

	public function testSlot()
	{
		$slots = PickupBookingSlot::model()->findAllByAttributes(['depot' => PickupBookingSlot::DEPOT_SYDNEY]);
		foreach ($slots as $slot) {
			echo $slot->slot_time;
			echo "\n";
		}
		echo "Done.\n";
	}


	public function getFedexAuth()
	{
		$fedexToken = Service::getCacheData('Fedex_Token');
		if (!empty($fedexToken)) {
			$fedexToken = json_decode($fedexToken);
			echo $fedexToken->token;
		} else {
			$fedexAPI = new FedExAPI;
			$token = $fedexAPI->Authorization();
			$fedexToken = new stdClass;
			$fedexToken->token = $token;
			Service::setCacheData('Fedex_Token', json_encode($fedexToken), 3590);
			echo "Yo!\n";
		}
	}


