		// Header content type
		//header("Content-type: application/pdf");

		//header("Content-Length: " . filesize($path));

		// Send the file to the browser.
		//readfile($path);
		print_r($response);
	}

	public function testShopify()
	{
		$custs = WmsAPI::model()->findAll('type = :type AND status = :status', [':type' => WmsAPI::WMS_API_TYPE_SHOPIFY, ':status' => WmsAPI::WMS_API_STATUS_ALL]);
		foreach ($custs as $cust) {
			// elekzon only sync at 9:00 and 12:00
			if ($this->mn == 25 && $cust->org_id == Org::ORGID_3PL_ELEKZON) continue;

			$config = array(
				'store_domain' => $cust->domain,
				'api_key' => $cust->api_key,
				'api_secret' => $cust->api_secret,
				'org_id' => $cust->org_id,
			);
			$shopify = new ShopifyAPI($config);
			$r = $shopify->countOrders('open', 'any');
			while ($r['count'] > 0) {
				$page = ceil($r['count'] / 250);
				$r['count'] -= 250;

				// Get orders
				//$orders = $shopify->getOrders($page, 'open', $status);
				$orders = $shopify->getOrders($page, 'open', 'any');
				if ($orders['done'] == true) {
					$this->_processShopifyOrder($orders, $shopify);
				}
			}
			// $this->_cancelShopifyOrder($shopify);
		}
	}

