	public function manifestLifeStyleOrders()
	{
		$sql = 'SELECT * FROM wms_task WHERE `status` = 99 AND `type` = 3030 AND job_id IN (SELECT id FROM wms_job WHERE org_id = 2939) AND compl_time >= "2022-10-08 00:00:00"';
		$tasks = WmsTask::model()->findAllBySql($sql);
		$DHLOrderIds = [];
		$AusPostOrderIds = [];
		foreach ($tasks as $task) {
			$taskMap = WmsTaskMap::model()->findByAttributes(['task_id' => $task->id]);
			if (!empty($taskMap)) {
				$deliveryTask = WmsTask::model()->findByAttributes(['link_id' => $task->id, 'type' => WmsTask::TYPE_DELIVERY]);
				if (!empty($deliveryTask) && !empty($deliveryTask->mdata['carrier'])) {
					if ($deliveryTask->mdata['carrier'] == 'AusPost') {
						array_push($AusPostOrderIds, $taskMap->fid);
					} elseif ($deliveryTask->mdata['carrier'] == 'DHLGlobalMail') {
						array_push($DHLOrderIds, $taskMap->fid);
					}
				}
			}
		}
		$starShipItApi = new StarShipItAPI();
		$starShipItApi->manifestShippedOrders($AusPostOrderIds);
		$starShipItApi->manifestShippedOrders($DHLOrderIds);
		echo "\n Done. \n";
	}

