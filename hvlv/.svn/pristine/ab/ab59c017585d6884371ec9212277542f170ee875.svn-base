	public function postDearStockAdjustment()
	{
		$stocks = WmsStock::model()->findAllByAttributes(['org_id' => 2939]);
		$postFields = new stdClass;
		$postFields->EffectiveDate = date(DATE_ISO8601, strtotime('now'));
		$postFields->Status = 'DRAFT';
		$postFields->Reference = 'Ninja Initial Adjustment';
		$postFields->Lines = array();
		$ignore = ['', 'S40SSWA-M', 'V1047EU-XS', 'V0621CL-S', 'S1120MA-L', 'V1038MO-L', 'V1435BO-M', 'V1043BT-L', 'V1033BP-M', 'V1044DU-S', 'V1036RE-S', 'S5044DU-L', 'V1045MA-L', 'V1009DC-L', 'V1009DC-M', 'V6034TI-M', 'TX2025BL-M', 'JK3035WL-XL', 'V1331NT-L', 'S0210MA-L', 'V1047EU-L', 'L12VXBL-S', 'V1047EU-M', 'V1331SI-S', 'V1014SV-M', 'CA1001NV', 'V1040RO-M', 'U92GANR-XL', 'U22SPIC-XL', 'V1045MA-S', 'U35SNGA-XS', 'V1036OC-XS', 'U2220WH-XS', 'BX2002BU-S', 'U9335UW-XL', 'U31SMMA-L', 'V1042FU-S'];
		foreach ($stocks as $stock) {
			$prodOrg = WmsProdOrg::model()->findByAttributes(['prod_id' => $stock->prod_id]);

			$tempProd = new stdClass;
			if (!empty($prodOrg)) {
				$prod = WmsProd::model()->findByPk($prodOrg->prod_id);
				if ($prodOrg->sku == '' || in_array($prodOrg->sku, $ignore)) {
					continue;
				}
				if (!empty($prod)) {
					$tempProd->SKU = $prodOrg->sku;
					$tempProd->ProductName = $prod->name;
					$tempProd->Quantity = $stock->qty;
					$tempProd->UnitCost = 1;
					$tempProd->Location = 'PCA Express';
				} else {
					continue;
				}
			} else {
				continue;
			}
			array_push($postFields->Lines, $tempProd);
		}

		$ch = curl_init();

		curl_setopt($ch, CURLOPT_URL, "https://inventory.dearsystems.com/ExternalApi/v2/stockadjustment");
		curl_setopt($ch, CURLOPT_RETURNTRANSFER, TRUE);
		curl_setopt($ch, CURLOPT_HEADER, FALSE);

		curl_setopt($ch, CURLOPT_POST, TRUE);
		curl_setopt($ch, CURLOPT_POSTFIELDS, json_encode($postFields));
		curl_setopt($ch, CURLOPT_HTTPHEADER, array(
			"Content-Type: application/json",
			"api-auth-accountid: 30eb56dc-b33f-4ba5-91c0-2ec4186d9bab",
			"api-auth-applicationkey: 82ddc7c9-1c0e-8df3-7d5a-078e55c1bc64"
		));
		$response = curl_exec($ch);
		curl_close($ch);

		var_dump($response);
	}

