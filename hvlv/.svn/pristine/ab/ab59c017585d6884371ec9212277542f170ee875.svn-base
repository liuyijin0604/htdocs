	public function syncStarShipItUnshippedOrders()
	{
		$starShipItApi = new StarShipItAPI();
		$results = json_decode($starShipItApi->getUnshippedOrders());
		print_r($results);
		//echo json_encode($results);
		$orders = $results->orders;
		$transaction = Yii::app()->db->beginTransaction();
		try {
			if (!empty($orders)) {
				$this->_processStarShipItOrder($orders, $starShipItApi);
			}
			$transaction->commit();
		} catch (Exception $e) {
			$transaction->rollback();
			//$this->log('Sync StarShipIt order fail');
			//print_r($e);
			throw $e;
		}
	}

	public function _processStarShipItOrder($orders, $starShipItApi)
	{
		$errors = [];
		foreach ($orders as $order) {
			$task_map = WmsTaskMap::model()->find('fid = :fid AND platform = "starShipIt"', [':fid' => $order->order_id]);
			if (empty($task_map)) {
				// Get Job
				$job = WmsJob::model()->find('org_id=:oid AND type = 20 and week(`created`,1)=:week', array(':oid' => 2939, ':week' => intval(date('W'))));
				if (empty($job)) {
					$job = new WmsJob;
					$job->org_id = 2939;
					$job->type = 20;
					$job->status = 10;
					$job->ref = '3PL_' . date('Y-m-d');
					$job->dpt_id = 106;
					$job->genNo();
					$job->save();
				}
				if ($job->getErrors()) {
					foreach ($job->getErrors() as $error) {
						//$this->shopifyLog($error[0]);
						$errors[] = $error[0];
					}
				}

				// Create pick&pack task
				$task_errors = [];
				$task = new WmsTask();
				$task->job_id = $job->id;
				$task->type = 3030;
				$task->is_request = 1;
				$task->op_id = 0;
				$task->status = 20;
				$task->bwf = 256;
				$task->dpt_id = $job->dpt_id;
				$task->schd_time = date("Y-m-d H:i:s");
				$task->ref = $order->order_number;
				$prods = [];
				$backorder = false;
				$not_exist = [];
				foreach ($order->items as $item) {
					$prod = null;
					// Get product
					//$prod_map = WmsProdMap::model()->with('prod')->find('t.fid = :fid AND t.platform = "starshipit" AND prod.status = 1', [':fid' => $item->item_id]);
					$prod_map = null;
					if (!empty($prod_map)) {
						$prod = $prod_map->prod;
					} else if (!empty($item->barcode)) {
						$prod = WmsProd::model()->find('ean = :ean AND status = 1', [':ean' => $item->barcode]);
					} else if (!empty($item->sku)) {
						$sql = "SELECT * FROM wms_prod WHERE id = (SELECT DISTINCT prod_id FROM wms_prod_org WHERE SKU='" . $item->sku . "')";
						$prod = WmsProd::model()->findBySql($sql);
						//$prod = WmsProd::model()->with('orgs')->find('orgs.sku = :sku AND orgs.org_id = :org_id AND status = 1', [':sku' => $item->sku, ':org_id' => 2939]);
						// 2020-04-22
						if (empty($prod)) {
							$prod = WmsProd::model()->with('orgs')->find('orgs.sku = :sku AND orgs.org_id = :org_id AND status = 1', [':sku' => str_replace('_', ' ', $item->sku), ':org_id' => 2939]);
						}
					}

					if (empty($prod) && !empty($item->sku)) {
						$pack = WmsProdPack::model()->with('prod')->find('barcode = :barcode AND prod.status = 1', [':barcode' => $item->sku]);
						if (!empty($pack)) {
							$prod = $pack->prod;
							$item->quantity *= $pack->qty;
						}
					}

					if (empty($prod)) {
						$task_errors[] = $item->description . ' ' . $item->sku . ' does not exist in Ninja Logistics';
						if (!isset($not_exist[$item->description])) $not_exist[$item->description] = 0;
						$not_exist[$item->description] += $item->quantity;
						continue;
					}

					if (empty($prods[$prod->id])) $prods[$prod->id] = 0;
					if ($prod->type != WmsProd::WMS_PROD_KIT) {
						$prods[$prod->id] += $item->quantity;
					} else if ($prod->type == WmsProd::WMS_PROD_KIT) {
						// don't record kit, cause backorder
						// $prods[$prod->id] += $item['quantity'];
						foreach ($prod->items as $prod_item) {
							if (!isset($prods[$prod_item->item->id])) $prods[$prod_item->item->id] = 0;
							$prods[$prod_item->item->id] += intval($item->quantity) * $prod_item->qty;
						}
					}
				}
				$items = [];
				foreach ($prods as $prod_id => $qty) {
					$temp_qty = $qty;
					// Get stocks
					$stocks = WmsStock::model()->findAll('prod_id = :prod_id AND org_id = :org_id AND dpt_id = 106 AND qty - qty_res > 0', [':prod_id' => $prod_id, ':org_id' => 2939]);
					if (empty($stocks)) {
						$backorder = true;
						$task_errors[] = $prod->name . ' in ' . $order->order_number . ' quantity is less than ' . $temp_qty . ', only ' . (intval($temp_qty) - intval($qty)) . '.';
						//continue;
					}
					foreach ($stocks as $stock) {
						if ($qty > 0) {
							$items[] = [
								'si' => $stock->id,
								'sn' => $stock->prod->name,
								'pq' => '',
								'cq' => '',
								'uq' => min($qty, $stock->availQty()),
								'pli' => '',
								'pl' => '',
								'nt' => '',
							];
							$qty -= min($qty, $stock->availQty());
						} else {
							break;
						}
					}

					//$sql = "SELECT * FROM wms_prod WHERE id=".$prod_id."";
					$prod = WmsProd::model()->findByPk($prod_id);
					//$prod = WmsProd::model()->findBySql($sql);
					if ($qty > 0) {
						$task_errors[] = $prod->name . ' in ' . $order->order_number . ' quantity is less than ' . $temp_qty . ', only ' . (intval($temp_qty) - intval($qty)) . '.';

						// 2020-06-22 still record item
						$stock = WmsStock::model()->find('prod_id = :prod_id AND org_id = :org_id and dpt_id = 106', [':prod_id' => $prod_id, ':org_id' => 2939]);
						$items[] = [
							'si' => $stock->id,
							'sn' => $stock->prod->name,
							'pq' => '',
							'cq' => '',
							'uq' => $qty,
							'pli' => '',
							'pl' => '',
							'nt' => '',
						];
						$backorder = true;
					}

					if (!empty($not_exist)) {
						foreach ($not_exist as $name => $qty) {
							$items[] = [
								'si' => '',
								'sn' => $name,
								'pq' => '',
								'cq' => '',
								'uq' => $qty,
								'pli' => '',
								'pl' => '',
								'nt' => '',
							];
						}
						$backorder = true;
					}
				}

				if ($task->getErrors()) {
					foreach ($task->getErrors() as $error) {
						//$this->shopifyLog($error[0]);
						$errors[] = $error[0];
					}
				} else {
					if (!empty($task_errors)) {
						foreach ($task_errors as $error) {
							//$this->shopifyLog($error);
							$errors[] = $error;
						}
						if ($backorder) {
							$task->status = 10;
						} else {
							$task->status = 40;
						}
					}
					$task->mdata['note'] = implode('; ', $task_errors);
					$task->new_items = $items;
					//$task->saveItems();
					if ($task->save()) {
						// Delivery
						$task->pickupTask->type = 2120;
						$delivery_task = $task->pickupTask;
						$delivery_task->mdata['carrier'] = $order->carrier;
						$delivery_task->mdata['carrier_service_code'] = $order->carrier_service_code;
						$delivery_task->mdata['cnee']['company'] = @$order->destination->company;
						$delivery_task->mdata['cnee']['name'] = @$order->destination->name;
						$delivery_task->mdata['cnee']['tel'] = !empty(@$order->destination->phone) ? @$order->destination->phone : "0423101775";
						$delivery_task->mdata['cnee']['address'] = @$order->destination->building . ' ' . @$order->destination->street;
						$delivery_task->mdata['cnee']['city'] = @$order->destination->city;
						$delivery_task->mdata['cnee']['suburb'] = @$order->destination->suburb;
						$delivery_task->mdata['cnee']['state'] = @$order->destination->state;
						$delivery_task->mdata['cnee']['postcode'] = @$order->destination->post_code;
						$delivery_task->mdata['cnee']['country'] = @$order->destination->country;
						$delivery_task->mdata['cnee']['email'] = $order->destination->email;
						// elekzon default tnt
						//if ($shopify->org_id == Org::ORGID_3PL_ELEKZON) {
						// $delivery_task->mdata['courier'] = Org::ORGID_COURIER_TNT;
						//if (!empty($order['shipping_lines']) && preg_match('/Standard Shipping|Australia Free Shipping/i', $order['shipping_lines'][0]['code'])) {
						//$delivery_task->mdata['shopify_standard'] = true;
						//}
						//}

						//$delivery_task->chooseCourier();
						$delivery_task->save();


						// Create task map
						$task_map = new WmsTaskMap;
						$task_map->fid = $order->order_id;
						$task_map->platform = 'starshipit';
						$task_map->task_id = $task->id;
						$task_map->save();

						// Create Task Item
						/* $taskItem = WmsTaskItem::model()->findByAttributes(['task_id'=>$task->id]);
						if (empty($taskItem)) {
							$taskItem = new WmsTaskItem();
							$taskItem->task_id = $task->id;
							$taskItem->op_id = 3237;
						} */
					}
				}
			} else {
				/* if (!empty($order['cancelled_at']) || (!empty($order['financial_status']) && $order['financial_status'] == 'voided')) {
					$task_map->task->status = 100;
					$task_map->task->save();
				} */
			}
		}
	}


	public function getTLAShipment()
	{
		$wmsTask = WmsTask::model()->findByPk('5338');
		$shipment = ImParcel::model()->findByPk($wmsTask->mdata['shipment_id'][0]);
		$apiId = "ninjalogistics";
		$apiKey = "62bd9e2a47f6a1cef8340cf487ce2541297de9b8aac153577b48493e7cf89425";
		$method = "get";
		$data = new stdClass;
		$data->ref = $shipment->ref;
		//$data->barcode = "019931265099999891AMQ800013201000935009";
		//$data->base64 = false;
		$data = stripslashes(json_encode($data));
		$s = $apiKey . "api_id" . $apiId . "data" . $data . "method" . $method . $apiKey;
		$sign = MD5($s);
		$ch = curl_init('https://api.toplogistics.com.au/shipment');
		$post = [
			'api_id' => $apiId,
			'method' => $method,
			'data' => $data,
			'sign' => $sign
		];

		curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
		curl_setopt($ch, CURLOPT_POSTFIELDS, $post);
		$response = curl_exec($ch);
		curl_close($ch);
		//$path = 'courier-label\label.pdf';
