	public function stockIn()
	{
		/* $pallets = WmsLocation::model()->findAllByAttributes(['type' => 50, 'status' => 1]);
		foreach($pallets as $pallet) {
			$pltMove = WmsPalletMove::model()->findByAttributes(['pallet_no' => $pallet->code]);
			if(!empty($pltMove)) {
				print_r($pltMove);
				echo "\n";
				$mdata = json_decode($pltMove->meta);
				foreach ($mdata->products as $product) {
					$prod = WmsProd::model()->findByAttributes(['ean' => $product->prod_barcode]);
					if (!empty($prod)) {
						$prodOrg = WmsProdOrg::model()->findByAttributes(['prod_id' => $prod->id]);
						if (!empty($prodOrg)) {
							$stock = WmsStock::model()->findByAttributes(['prod_id' => $prod->id]);
							if (empty($stock)){
								$stock = new WmsStock();
								$stock->prod_id = $prod->id;
								$stock->org_id = $prodOrg->org_id;
								$stock->qty = $product->prod_quantity;
								$stock->qty_res = 0.00;
								$stock->batch = '';
								$stock->sn = '';
								$stock->dpt_id = 106;
								$stock->bwf = 0;
								$stock->save();
								$stock = WmsStock::model()->findByAttributes(['prod_id' => $prod->id]);
							} else {
								
							}
							$stockLocation = new WmsStockLocation();
							$stockLocation->stock_id = $stock->id;
							$stockLocation->location_id = $pallet->id;
							$stockLocation->qty = $product->prod_quantity;
							$stockLocation->save();
						}			
					} else {
						continue;
					}
				}
			}
		} */
		$sql = "SELECT * FROM wms_prod WHERE id IN (SELECT prod_id FROM wms_prod_org WHERE org_id = 2939)";
		$products = WmsProd::model()->findAllBySql($sql);
		foreach ($products as $product) {
			$stock = WmsStock::model()->findByAttributes(['prod_id' => $product->id]);
			// If stock doesn't exist, create a new stock for this product
			if (empty($stock)) {
				$stock = new WmsStock();
				$stock->prod_id = $product->id;
				$stock->org_id = 2939;
				$stock->qty = 0.00;
				$stock->qty_res = 0.00;
				$stock->batch = '';
				$stock->sn = '';
				$stock->dpt_id = 106;
				$stock->bwf = 0;
			}

			// Update stock quantity
			$pltMove = WmsPalletMove::model()->findAllBySql("SELECT * FROM wms_pallet_move WHERE meta LIKE '%" . $product->ean . "%'");
			if (!empty($pltMove)) {		// product exist at pallet move
				foreach ($pltMove as $plt) {
					$mdata = json_decode($plt->meta);
					$pallet = WmsLocation::model()->findByAttributes(['type' => 50, 'code' => $plt->pallet_no]);
					foreach ($mdata->products as $prod) {
						if ($prod->prod_barcode == $product->ean) {
							$stock->qty += $prod->prod_quantity;
							$stock->save();
							$stockLocation = new WmsStockLocation();
							$stockLocation->stock_id = $stock->id;
							if (!empty($pallet)) {
								$stockLocation->location_id = $pallet->id;
								$stockLocation->qty = $prod->prod_quantity;
								$stockLocation->save();

								$taskItem = new WmsTaskItem();
								$taskItem->task_id = 1763;
								$taskItem->op_id = 3237;
								$taskItem->sl_id = 0;
								$taskItem->del = 0;
								$taskItem->mdata = ['gi' => $product->id, 'gn' => $product->name, 'uq' => $stock->qty, 'pl' => '', 'cq' => '', 'ex' => '', 'bn' => '', 'nt' => ''];
								$taskItem->save();

								$ti = WmsTaskItem::model()->findBySql('SELECT * FROM wms_task_item WHERE task_id = 1763 ORDER BY id DESC LIMIT 1');
								$st = WmsStock::model()->findByAttributes(['prod_id' => $product->id]);
								$stockLedger = new WmsStockLedger();
								$stockLedger->ti_id = $ti->id;
								$stockLedger->task_id = 1763;
								$stockLedger->stock_id = $st->id;
								$stockLedger->location_id = $pallet->id;
								$stockLedger->qty_in = $prod->prod_quantity;
								$stockLedger->qty_out = 0.00;
								$stockLedger->bwf = 0;
								$stockLedger->meta = '';
								$stockLedger->save();
							}
						}
					}
				}
			}
		}
		echo "Done.\n";
	}

	public function stockZeroProducts()
	{
		$sql = "SELECT * FROM wms_prod WHERE `type` = 10 AND id IN (SELECT prod_id FROM wms_prod_org WHERE org_id = 3899) AND id NOT IN (SELECT prod_id FROM wms_stock)";
		$products = WmsProd::model()->findAllBySql($sql);
		foreach ($products as $product) {
			$stock = new WmsStock();
			$stock->prod_id = $product->id;
			$stock->org_id = 2939;
			$stock->qty = 0.00;
			$stock->qty_res = 0.00;
			$stock->batch = '';
			$stock->sn = '';
			$stock->dpt_id = 106;
			$stock->bwf = 0;
			$stock->save();
		}
	}

	public function createShipment()
	{
		$model = WmsTask::model()->findByPk(2023);
		$pt = WmsTask::model()->find('type = 3210 AND link_id = :t', [':t' => $model->link_id]);
		$pkg = 0;
		$tw = 0;
		$fw_wt = [];
		$rs = [];
		if (!empty($pt) && !empty($pt->mdata['pkg'])) {
			foreach (json_decode($pt->mdata['pkg'], true) as $pk) {
				if (empty($pk['wt'])) {
					continue;
				}

				$fw_wt[] = $pk['wt']; //store each pack's weight;
				$tw += $pk['wt'];
				$pkg++;
			}
		} else {
			$pkg = 1;
		}

		if (empty($model->mainTask->packTask->mdata['pkg'])) {
			echo 'package amount is zero';
			Yii::app()->end();
		}
		print_r($model->mdata);
		if (
			empty($model->mdata['shipment_id']) || empty($model->mdata['shipment_courier_id']) || $model->mdata['shipment_courier_id'] != $model->mdata['courier'] ||
			($model->mdata['courier'] == Org::ORGID_COURIER_FASTWAY && sizeof($model->mdata['shipment_id']) != $pkg)
		) {
			$rs = $model->toShipment(); //multiple shipments in array
			echo "toShipment Done.\n";
			//ot_id = 10
			foreach ($rs as $i => $objImParcel) {
				$objImParcel->ot_id = WmsTask::OT_ID_3PL;
				//$objImParcel->save();
				print_r($objImParcel);
				$res = $this->createShipmentByApi($objImParcel);
				if ($res != false) {
					$objImParcel->ref = $res->ref;
					$objImParcel->save();
				}
			}
		} else {
			foreach ($model->mdata['shipment_id'] as $sid) {
				$p = Shipment::model()->find('id=:id', array(':id' => $sid));
				if (!empty($p)) {
					$rs[] = $p;
					echo "Shipment already exist.";
				}
			}
		}
	}

	public function createShipmentByApi($shipment)
	{
		//$shipment = ImParcel::model()->findByPk(1);
		echo "createShipmentByApi\n";
		$data = new stdClass;
		$shipper = new stdClass;
		$consignee = new stdClass;
		$items = json_decode($shipment->items);

		$cnor = Addr::model()->findByPk($shipment->cnor_id);
		$shipper->name = $cnor->name;
		$shipper->address = $cnor->address;
		$shipper->state = $cnor->state;
		$shipper->city = $cnor->city;
		$shipper->suburb = $cnor->suburb;
		$shipper->postcode = $cnor->postcode;
		$shipper->phone = $cnor->tel;
		$shipper->email = $cnor->email;

		$cnee = Addr::model()->findByPk($shipment->cnee_id);
		$consignee->name = $cnee->name;
		$consignee->address = $cnee->address;
		$consignee->state = $cnee->state;
		$consignee->city = $cnee->city;
		$consignee->suburb = $cnee->suburb;
		$consignee->postcode = $cnee->postcode;
		$consignee->phone = $cnee->tel;
		$consignee->email = $cnee->email;

		$data->cust_ref = $shipment->cref;
		$data->type = 10;
		$data->packs = $shipment->pkg;
		$data->weight = $shipment->weight;
		$data->packages = [];
		$packages = json_decode($shipment->packages);
		$i = 0;
		foreach ($packages as $package) {
			$data->packages[$i] = $package;
			$i++;
		}
		$data->shipper = $shipper;
		$data->consignee = $consignee;
		$data->items = [["B", $items->g[0], $items->g[0], "", "", $items->q[0], $items->v[0], $items->hs[0], ""]];
		$data->label_type = "AUSPOST";
		$data->clear = "DDU";
		$data->chargecode = "1757";
		//$data->barcode = 1;
		$data->direct = 1;

		$data = stripslashes(json_encode($data));

		echo $data . "\n";

		$apiKey = "6366b2bb8b8d7407a3d46f6fa79a9af3472e1381442b49e637dfc96a0b0d6808";
		$apiId = "api_test";
		$method = "create";

		$s = $apiKey . "api_id" . $apiId . "data" . $data . "method" . $method . $apiKey;
		$sign = MD5($s);
		echo "\n";
		echo $s . "\n";
		echo $sign;
		echo "\n";
		$ch = curl_init('http://branch.toplogistics.com.au:8189/api/shipment');
		$post = [
			'api_id' => $apiId,
			'method' => $method,
			'data' => $data,
			'sign' => $sign
		];

		curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
		curl_setopt($ch, CURLOPT_POSTFIELDS, $post);
		$response = curl_exec($ch);
		curl_close($ch);
		//echo $response;
		$response = json_decode($response);
		if ($response->status == 1) {
			echo "Shipment successfully created.";
			return $response;
		} else {
			echo $response->msg;

			return false;
		}
	}

