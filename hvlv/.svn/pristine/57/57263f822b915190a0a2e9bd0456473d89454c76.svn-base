	private $costValidationResult = [];

	public function rules()
	{
		$rules = [
			['dpt_id, type, pol, pod, eta', 'required'],
		];
		return array_merge(parent::rules(), $rules);
	}

	public function relations()
	{
		$r = parent::relations();
		$r['shipments'] = [self::HAS_MANY, 'ImParcel', 'consol_id'];
		$r['invoice'] = [self::HAS_MANY, 'Invoice', 'consol_id'];
		return $r;
	}

	public function hasInvoice()
	{
		$c = Invoice::model()->with('lines')->count('type = 10 AND lines.model = :m AND lines.fid = :fid', [':m' => 'ImcoConsol', ':fid' => $this->id]);
		return $c > 0;
	}

	
	public function afterSave()
	{
		parent::afterSave();
		$this->toProcess();

		// create some fixed cost
		// currently we only create a Domestic delivery (FIA - IMPORT) cost
		// charge code is : DCART
		Ledger::createDefCostConsole($this->id, Ledger::TYPE_IMPORT_DEF);
	}
	public function beforeSave()
	{
		if(empty($this->mdata['detention_date'])&&!empty($this->eta)&&$this->service==Consol::SEACONSOL)
		{
			$this->mdata['detention_date'] = date('Y-m-d',strtotime('+7 day',strtotime($this->eta)));
		}
		return parent::beforeSave();
	}
				
	public function getEtaToNow()
	{
		if (empty($this->eta)) {
			return 0;
		}
		$etaDay=new DateTime($this->eta, new DateTimeZone('Australia/Sydney'));
		$now=new DateTime('now', new DateTimeZone('Australia/Sydney'));
		$daydiff = $now->diff($etaDay)->format("%a");
		return $daydiff;
	}
				
	/*
	 * create the consol process if not have
	 *
	 */
	public function toProcess()
	{
		if($this->is3PL()) return;
		if ($this->service == 10) {
			if (preg_match("/C\d{8}NZ/i", $this->no)) {
				if (empty($this->process)) {
					if (!empty($this->eta)&&preg_match('/^\d{4}\-\d{2}\-\d{2}$/i', $this->eta)&&$this->eta<='2018-03-10') {
						$this->newConsolProcess(ConsolProcess::STATE_CONSOL_PROCESS_DONE, ConsolProcess::TYPE_NZ);
					} else {
						$this->newConsolProcess(ConsolProcess::STATE_WAITING_CREATE_INVOICE, ConsolProcess::TYPE_NZ);
					}
				} elseif ($this->process->type!= ConsolProcess::TYPE_NZ) {
					$this->newConsolProcess($this->process->status, ConsolProcess::TYPE_NZ);
				}
			} elseif (in_array($this->owner_id, [1206,114])) { //like BFE all finished after created consol,PCA
				if (empty($this->process)) {
					$this->newConsolProcess(ConsolProcess::STATE_CONSOL_PROCESS_DONE, ConsolProcess::TYPE_NO_PROCESS);
				} elseif ($this->process->type!= ConsolProcess::TYPE_NO_PROCESS) {
					$this->newConsolProcess($this->process->status, ConsolProcess::TYPE_NO_PROCESS);
				}
			} elseif (preg_match('/\d{3}-\d{8}/i', $this->awb)) {
				if (empty($this->process)) {
					if (!empty($this->eta)&&preg_match('/^\d{4}\-\d{2}\-\d{2}$/i', $this->eta)&&$this->eta<='2018-03-10') {
						$this->newConsolProcess(ConsolProcess::STATE_CONSOL_PROCESS_DONE, ConsolProcess::TYPE_FULL_PROCESS);
					} else {
						$this->newConsolProcess(ConsolProcess::STATE_WAITING_MAIN_ACR, ConsolProcess::TYPE_FULL_PROCESS);
					}
				} elseif ($this->process->type!= ConsolProcess::TYPE_FULL_PROCESS) {
					$this->newConsolProcess(($this->process->status==ConsolProcess::STATE_NEW)?ConsolProcess::STATE_WAITING_MAIN_ACR:$this->process->status, ConsolProcess::TYPE_FULL_PROCESS);
				} elseif ($this->process->status==ConsolProcess::STATE_NEW) {
					$this->newConsolProcess(ConsolProcess::STATE_WAITING_MAIN_ACR, ConsolProcess::TYPE_FULL_PROCESS);
				}
			} else {
				if (empty($this->process)) {
					if (!empty($this->eta)&&preg_match('/^\d{4}-\d{2}-\d{2}$/i', $this->eta)&&$this->eta<='2018-03-10') {
						$this->newConsolProcess(ConsolProcess::STATE_CONSOL_PROCESS_DONE, ConsolProcess::TYPE_LOCAL_PROCESS);
					} else {
						$this->newConsolProcess(ConsolProcess::STATE_NEW, ConsolProcess::TYPE_LOCAL_PROCESS);
					}
				} elseif ($this->process->type!= ConsolProcess::TYPE_FULL_PROCESS) {
					$this->newConsolProcess($this->process->status, ConsolProcess::TYPE_LOCAL_PROCESS);
				}
			}

			//for szportal confirm Consol
			if($this->status == Consol::CONFIRM_STATUS)
			{
				if(!empty($this->process)&&(empty($this->eta)||$this->eta == '0000-00-00'))
				{
					$this->process->status = ConsolProcess::STATE_NEW;
					$this->process->update(["status"]);
				}
			}


		} elseif ($this->service == 20) { //push to sea process
			if (empty($this->process)) {
				$this->newConsolProcess(1, ConsolProcess::TYPE_CONSOL_SEA, 2);
			} elseif ($this->process->main_type!=2) {
				$this->newConsolProcess(1, ConsolProcess::TYPE_CONSOL_SEA, 2);
			}
		}
	}
				
	public function newConsolProcess($status=1, $type=0, $main_type=1)
	{
		if (empty($this->process)) {
			$process = new ConsolProcess();
			$process->started = date('Y-m-d H:i:s');
			$process->fid = $this->id;
			$process->main_type=$main_type;
		} else {
			$process = $this->process;
		}
		$process->status = $status;
		if ($process->main_type!=$main_type) {
			$process->main_type=$main_type;
			$process->status=1;
		}
		$process->type = $type;
		$process->date = date('Y-m-d H:i:s');
		if ($process->save()) {
			return true;
		}
		return false;
	}
	public function getProcessStatus()
	{
		return isset(ConsolProcess::$states[isset($this->process->status)?$this->process->status:-1])? Yii::t(strtolower(__CLASS__), ConsolProcess::$states[$this->process->status]) : "new";
	}
	public function totHeldShipments($wid=0)
	{
		$sql = 'SELECT COUNT(id) AS t FROM shipment WHERE consol_id = '.$this->id.' AND status in (55,57)';
		if (!empty($wid)) {
			$sql .= ' AND odpt_id = '.$wid;
		}
		$c = Yii::app()->db->createCommand($sql);
		return $c->queryScalar();
	}
	public function totAQISShipments($wid=0,$agentId = 0,$isDetail= false)
	{
		$total = 0;
		$details = [];
		if(!empty($agentId))
		{
			$rs = ImParcel::model()->findAll('agent_id = :agentId AND consol_id = :cid AND (bwf & '.ImParcel::AQISCODE.') > 0', [':agentId' => $agentId,':cid' => $this->id]);
		}else
		{
			$rs = ImParcel::model()->findAll('consol_id = :cid AND (bwf & '.ImParcel::AQISCODE.') > 0', [':cid' => $this->id]);
		}
		foreach ($rs as $key => $p) {
			if($p->isRealAQIS())
			{
				if($isDetail)
				{
					$details[] = $p;
				}else
				{
					$total++;
				}
			}
		}

		if($isDetail)
		{
			return $details;
		}

		return $total;
	}
	public function totEMPPShipments($wid=0)
	{
		$sql = 'SELECT COUNT(id) AS t FROM shipment WHERE consol_id = '.$this->id.' and (bwf&512)>0';
		if (!empty($wid)) {
			$sql .= ' AND odpt_id = '.$wid;
		}
		$c = Yii::app()->db->createCommand($sql);
		return $c->queryScalar();
	}
	public function totDGShipments($wid=0)
	{
		$sql = 'SELECT COUNT(id) AS t FROM shipment WHERE consol_id = '.$this->id.' and json_value(meta,"s.is_dg") = 1';
		if (!empty($wid)) {
			$sql .= ' AND odpt_id = '.$wid;
		}
		$c = Yii::app()->db->createCommand($sql);
