	/**
	 * create invoice for org and shipments
	 * @param $owner
	 * @param $orgRate
	 * @param $shipments
	 * @return array
	 */
	public function genShipmentsInvoicePro(&$owner, &$orgRate, &$shipments,$ignoreScan = false)
	{
		$items = [];
		$tot = 0;

		$isJiacheng = false;
		if ($owner->id == Org::ORGID_CLIENT_JIACHENG) {
			$isJiacheng = true;
		}

		$check = false;
		foreach ($shipments as $p) {
			if($p->scanCount()>0)
			{
				$check = true;
				break;
			}
		}


		foreach ($shipments as $p) {
			if(!$p->is3PL())
			{
				//for org 1247 if the shipment not have chargecode, we don't charge local delivery fee.
							
				if ($p->agent_id==1247&&empty($p->mdata['chargecode'])) {
					continue;
				}
				
				if (empty($p->scan_data[50])&&($p->cbwf&32)==0&&($p->cbwf&64)==0&&!$ignoreScan) {//only the parcel without scan and direct flag will be ignored
					//if not scanned, not generate invoice.
					continue;
				}

				if (preg_match('/^AGDSY\d+$/', $p->hbn)){ //covered in separate direct invoice
					continue;
				}
			}
			if($p->is3PL()&&!$check) continue;

			$amt = $p->getChargePro($owner, $orgRate);		
			$amt2 = $p->getSurchargePro($owner, $orgRate);	//get surcharge	
			if ($amt[0] <= 0) {
				// $p->tempErrors = $p->hbn.' has no rate';
				continue;
			} // ignore zero invoice item

			// in case jiacheng , we need show postcode in description
			// jiacheng agent id : 838
			// when show invoice , we need parse desc field to get postcode
			$desc = $p->getDesc();
			if (!empty($p->mdata['cust_invoice_ref'])) {
				$desc.= '('.$p->mdata['cust_invoice_ref'].')';
			}
			if ($isJiacheng) {
				$desc .= '-'. $p->cnee->postcode;
			}
			if (!empty($p->mdata['letter_aupost'])) {
				$desc=empty($p->mdata['letter_aupost'])?$p->getDesc(): ImParcel::$letter_types[$p->mdata['letter_aupost']];
			}

			$cbm = $p->getTotalCBM();
			$cbm = $cbm == 0.000001 ? "0.000001" : $cbm;
			if (empty($desc)) $desc = 'null';
			else $desc = str_replace('"', '', json_encode($desc));

			$desc = empty($p->mdata['pe_number'])?$desc:$desc." ".$p->mdata['pe_number'];
			$items[] = [$p->ref, $desc, $p->pkg, $p->weight, $cbm, $amt[0], $p->cnee->postcode,$amt[1], $amt[2], $amt[3]];

			if ($amt2[0] > 0||$amt2[0]<0) {
				// $p->tempErrors = $p->hbn.' has no rate';
				// [$deliveryRateArr['amount'],$deliveryRateArr['MHCode'],$deliveryRateArr['MHCharge'],$deliveryRateArr['MHDescription'],$deliveryRateArr['OSCode'],$deliveryRateArr['OSCharge'],$deliveryRateArr['OSDescription']];
				if($amt2[1][1]>0)
				{
					$items[] = [$p->ref, $amt2[1][2], $p->pkg, $p->chargeWeight(), $cbm, $amt2[1][1], $p->cnee->postcode,0,0,0];
				}

				if($amt2[1][4]>0)
				{
					$items[] = [$p->ref,$amt2[1][5], $p->pkg, $p->chargeWeight(), $cbm, $amt2[1][4], $p->cnee->postcode,0,0,0];
				}

				if($amt2[1][6]>0)
				{
					$items[] = [$p->ref,$amt2[1][7], $p->pkg, $p->chargeWeight(), $cbm, $amt2[1][6], $p->cnee->postcode,0,0,0];
				}

				if($amt2[1][8]>0)
				{
					$items[] = [$p->ref,$amt2[1][9], $p->pkg, $p->chargeWeight(), $cbm, $amt2[1][8], $p->cnee->postcode,0,0,0];
				}

				if($amt2[1][10]>0)
				{
					$items[] = [$p->ref,$amt2[1][11], $p->pkg, $p->chargeWeight(), $cbm, $amt2[1][10], $p->cnee->postcode,0,0,0];
				}

				if($amt2[1][12]>0||$amt2[1][12]<0)
				{
					$items[] = [$p->ref,$amt2[1][13], $p->pkg, $p->chargeWeight(), $cbm, $amt2[1][12], $p->cnee->postcode,0,0,0];
				}

			}
			
			if(($p->cbwf&16)>0)
			{
					$cFee = SystemSetting::getCorrectAddressFee();
					$p->mdata['correct_address_fee']=$cFee;
					$items[] = [$p->hbn, 'Correct Address Fee',0, 0, 0, $cFee, 0, 0, 0, 0];
					$tot += $cFee;
			}
			// in case parcel with insurance
			// we add insurance value to total value
			//fastway dont not need to add insurance charge
			if (isset($p->trans) && !empty($p->trans) && $p->trans[0]->org_id == Org::ORGID_COURIER_FASTWAY) {
				//fastway donot need to add insurance charge
			} else {
				if ($p->insurance > 0) {
					$insuranceRatio = 1;
					if (!empty($owner->extra['insurance_invoice_ratio'])) {
						$insuranceRatio = floatval($owner->extra['insurance_invoice_ratio']);
					}
					$invInsurance = round($p->insurance * ($insuranceRatio / 100), 2);
					$p->mdata['insurance_charge_client']=$invInsurance;
					$items[] = [$p->hbn, $p->ref.' Insurance Fee',0, 0, 0, $invInsurance, 0, 0, 0, 0];
					$tot += $invInsurance;
				}

				$ss = new OrgRate('search');
				if (!empty($p->mdata['is_dg'])) {
					$isDg = 1;
					$cus_services = $ss->getCustomerServicePlans($p->agent_id);
					if (isset($cus_services['services']->AU->dg_fee)) {
						$dgFee = $cus_services['services']->AU->dg_fee;
						$invDg = $dgFee;
						$p->mdata['dg_charge_client']=$invDg;
						$items[] = [$p->ref, 'Dangerous Goods Fee',0, 0, 0, $invDg, 0, 0, 0, 0];
						$tot += $invDg;
					}
				}

				// if (($p->bwf&ImParcel::EMPPCODE)>0) {
				// 	$cus_services = $ss->getCustomerServicePlans($p->agent_id);
				// 	if (isset($cus_services['services']->AU->empp_fee)) {
				// 		$emppFee = $cus_services['services']->AU->empp_fee;
				// 		$invEmpp = $emppFee;
				// 		$p->mdata['empp_charge_client']=$invEmpp;
				// 		$items[] = [$p->ref, 'EMPP Handling Fee',0, 0, 0, $invEmpp, 0, 0, 0, 0];
				// 		$tot += $invEmpp;
				// 	}
				// }

				if (($p->bwf&ImParcel::AQISCODE)>0) {
					$cus_services = $ss->getCustomerServicePlans($p->agent_id);
					if (isset($cus_services['services']->AU->aqis_fee)) {
						$aqisFee = $cus_services['services']->AU->aqis_fee;
						$invAqis = $aqisFee;
						$p->mdata['aqis_charge_client']=$invAqis;
						$items[] = [$p->ref, 'AQIS Handling Fee',0, 0, 0, $invAqis, 0, 0, 0, 0];
						$tot += $invAqis;
					}
				}
			}
			//2019-09-10
			if(!empty($p->mdata['changeLabel']))
			{
				$invChangeLabel = round($p->mdata['changeLabel']*SystemSetting::getChangeLabelChargeSetting("unit_price"), 2);
				$items[] =[$p->hbn, 'Change Label Fee',0, 0, 0, $invChangeLabel, 0, 0, 0, 0];
				$tot += $invChangeLabel;
			}
			

			$tot += $amt[0]+$amt2[0];
			$p->mdata['charge_client_amount']= number_format($amt[0]+$amt2[0], 4, '.', '');
			$p->mdata['charge_client_weight']= number_format(isset($amt[3])?$amt[3]:$p->chargeWeight(), 2, '.', '');
			$p->updateMeta();
		}
		$items = array_filter($items, function($v) {
			return !empty($v);
		});
		return [$tot,$items];
	}


	public function genShipmentsInvoice(&$owner, &$orgRate)
	{
		$items = [];
		$tot = 0;

		$isJiacheng = false;
		if ($owner->id == 838) {
			$isJiacheng = true;
		}

		foreach ($this->shipments as $p) {
			$amt = $p->getChargePro($owner, $orgRate);

			// in case jiacheng , we need show postcode in description
			// jiacheng agent id : 838
			// when show invoice , we need parse desc field to get postcode
			$desc = $p->getDesc();
			if ($isJiacheng) {
				$desc .= '-'. $p->cnee->postcode;
			}

			$items[] = [$p->ref, $desc, $p->pkg, $p->weight, $p->cbm, $amt[0], $p->cnee->postcode,$amt[1], $amt[2], $amt[3]];

			// in case parcel with insurance
			// we add insurance value to total value
			if ($p->insurance > 0) {
				$insuranceRatio = 1;
				if (isset($owner->extra['insurance_invoice_ratio'])) {
					$insuranceRatio = floatval($owner->extra['insurance_invoice_ratio']);
				}
				$invInsurance = round($p->insurance * ($insuranceRatio / 100), 2);
				$items[] = [$p->hbn, 'Insurance Fee',0, 0, 0, $invInsurance, 0, 0, 0];
				$tot += $invInsurance;
			}
			$tot += $amt[0];
		}
		return [$tot,$items];
	}

	/**
	 * get all Org information in console
	 * @return array
	 */
	public function getOrgsInfo($billing=false,$withOutAGDSY = false)
	{
		if(!empty($this->shipments)&&$this->shipments[0]->is3PL())
		{
			$org = Org::model()->findByPk(Org::ORGID_CLIENT_PCAE);
			$result=[];
			$result[Org::ORGID_CLIENT_PCAE] = ['id'=>Org::ORGID_CLIENT_PCAE,'name'=>$org->name,'weight'=>0,'AGDSY_weight'=>0];
			return $result;
		}
		$sql = 'SELECT SUM(weight) as tw, agent_id FROM shipment WHERE status < 100 AND consol_id = :cid GROUP BY agent_id';
		$rs = Yii::app()->db->createCommand($sql)->bindValues([':cid' => $this->id])->queryAll();

		$orgs = [];
		foreach($rs as $r){
			$org = Org::model()->findByPk($r['agent_id']);
			$ship_bill_to_id = ($billing && $org->by >1)? $org->by : $org->id;
			$orgs[$ship_bill_to_id] = [
				'id' => $ship_bill_to_id,
				'name' => $billing && $org->by >1? $org->owner->name : $org->name,
				'weight' => round($r['tw']),
				'AGDSY_weight' => 0,
			];

			if($withOutAGDSY){
				$orgs[$ship_bill_to_id]['AGDSY_weight'] = Yii::app()->db->createCommand('SELECT SUM(weight) as tw FROM shipment WHERE status < 100 AND consol_id = :cid AND agent_id = :aid AND hbn LIKE "AGDSY%" GROUP BY agent_id')->bindValues([':cid' => $this->id, ':aid' => $r['agent_id']])->queryScalar();
			}
		}

		return $orgs;
	}

	/**
	 * get all Org information in console
	 * @return array
	 */
	public function getOrgsInfoWithInvoicedOrg()
	{
		$invoices = $this->invoice;
		$to_ids = array_column($invoices, 'to_id');
		$to_ids = array_unique($to_ids);
		$orgs = [];
		$orgInfos = $this->getOrgsInfo();
		foreach ($to_ids as $to_id) 
		{
			if (!isset($orgInfos[$to_id])) 
			{
				$orgInfos[$to_id] = [
					'id' =>$to_id,
					'name' => Org::model()->findByPk($to_id)->name,
					'weight' => 0
				];
			}
		}
		return $orgInfos;
	}

	public function getOrgList($withCasual=true, $billing=false)
	{
		$orgList= $this->getOrgsInfo($billing);
		$tmp=[];
		foreach ($orgList as $key=>$list) {
			$tmp[$key]=$list['name'];
		}
		if ($withCasual) {
			$tmp['1228']='PCA EXPRESS IMPORTS-CASUAL CUSTOMER';
		}
		if ($withCasual) {
			$tmp['3494']='TOP LOGISTICS IMPORTS-CASUAL CUSTOMER';
		}
		return $tmp;
	}

	public function getOrgListForReport($withCasual=true)
	{
		$orgList = $this->getOrgsInfoWithInvoicedOrg();
		$tmp=[];
		foreach ($orgList as $key=>$list) {
			$tmp[$key]=$list['name'];
		}
		if ($withCasual) {
			$tmp['1228']='PCA EXPRESS IMPORTS-CASUAL CUSTOMER';
		}
		if ($withCasual) {
			$tmp['3494']='TOP LOGISTICS IMPORTS-CASUAL CUSTOMER';
		}
		return $tmp;
	}
				
