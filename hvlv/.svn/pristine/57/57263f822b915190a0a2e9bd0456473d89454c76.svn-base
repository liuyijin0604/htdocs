	public function getReportDetailBaseOnAgent()
	{
		$totCost = $this->totCost();
		$orgList=$this->getOrgListForReport(true);
		$tempOrgDetail = $this->getReportDetail();
		$totalWegiht=$this->totWeight();
		$totalCBM =$this->totImCBM();
		$totalRevenue = $this->getTotalInvoice();
		$orgDetail=[];
		$rate = 0;
		foreach ($orgList as $org_id=>$org_name) {
			$rate = 0;
			if ($this->service != self::SEACONSOL)
			{
				$rate = @$tempOrgDetail[$org_id]['sub_weight']/($totalWegiht+0.00001);
			}else
			{
				$rate = @$tempOrgDetail[$org_id]['sub_cbm']/($totalCBM+0.00001);
			}
			
			$orgDetail[$org_id]=['cost'=>$totCost*$rate,'weight'=>@$tempOrgDetail[$org_id]['sub_weight'],'cbm'=>@$tempOrgDetail[$org_id]['sub_cbm'],'number'=>@$tempOrgDetail[$org_id]['number'],'revenue'=>$totalRevenue*$rate];
		}

		unset($this->shipments);
		return $orgDetail;
	}

	
	public function getPoc(){
		return Yii::t(strtolower(__CLASS__), SzpChannel::getName($this->poc));
	}

	//calculate total weight of this consol
	public function totShipWeight()
	{
		return parent::totWeight();
	}

	public function putShipmentIntoConsol($p,$state=false)
	{
		$errors=[];
		$thisService = @$this->mdata["selected_service"];
		if (isset($p)) {
			if (empty($p)) 
			{
				$errors[] = "not shipment";
				return $errors;
			} else 
			{
				//before create consol, we need to check if all the if all the shipments exits;
				$selected_services=[];
				$dpt_id = isset($this->dpt_id)?$this->dpt_id:null;
				$this->checkImparcel($p,$errors, $selected_services,$p->hbn,$dpt_id);
				if(count($errors)>0)
				{
					$errorsTemp =[];
					$errorsTemp['normal'] = $errors[0];
					$errors = $errorsTemp;
				}	

				if($state)
				{
					return $errors;
				}
				//two step
				// 1. clear, air, delivery check
				// 2. di
				//var_dump($selected_services);
				if (sizeof($selected_services)>=1) 
				{
					asort($selected_services);
					$selected_services= array_reverse($selected_services, true);
					$the_service=key($selected_services)-(key($selected_services)&32);
					$the_service = $the_service|$thisService;

					$this->checkServiceErrors($p,$the_service,$errors,$p->hbn);
						
				}
				if (!empty($errors)) 
				{
					return $errors;
				}else
				{
					$transaction=Yii::app()->db->beginTransaction();
					try 
					{
						$this->putImparcelIntoConsol($p);
						$transaction->commit();
					} catch (Exception $ex) 
					{
						$transaction->rollback();
						throw $ex;
					}
				}
				return $errors;
			}
			
		}
	}

	public function checkImparcel(&$p,&$errors, &$selected_services,$h,$dpt_id,$ignore_depot=0)
	{
		if (!empty($p)) 
		{
			if ($p->status>=30&&$p->status!= ImParcel::STATE_LOCAL_ARRIVAL) {
				$errors[]=$h.' status is '. ImParcel::$states[$p->status].' And need to change to New OR Local Arrival';
			}
			if ($p->agent_id==1002) {
				return;
			} //Sum
			// if ($p->agent->overCreditLimit()) {
			// 	$errors[]=$h.' - Client over credit limit, please contact accounts';
			// }
			if (isset($p->mdata['chargecode'])) {
				$serviceTotal=0;
				$chargecode=$p->mdata['chargecode'];
				$chargeCodeInfo = ImportChargeCode::model()->find('chargecode = :ccode', [':ccode' => $chargecode]);
				if (!empty($chargeCodeInfo)&&$chargeCodeInfo->status==1) {
					if (isset($chargeCodeInfo->mdata['selected_service'])&&is_array($chargeCodeInfo->mdata['selected_service'])) {
						// if (empty($chargeCodeInfo->mdata['selected_service'])) {
						// 	return;
						// }
						foreach ($chargeCodeInfo->mdata['selected_service'] as $key=>$value) {
							$serviceTotal=$serviceTotal|$value;
						}
					
						if (key_exists($serviceTotal, $selected_services)) {
							$selected_services[$serviceTotal]+=1;
						} else {
							$selected_services[$serviceTotal]=1;
						}
					}
				}
			}
			if($dpt_id!=null&&($p->ddpt_id > 0 && $p->ddpt_id != $dpt_id)&&empty($ignore_depot)){
				$errors[]=$h.' does not belong to this depot';
			}
		} else 
		{
			$errors[]=$h.' shipment not exists';
		}
	}

	public function checkServiceErrors(&$p,&$the_service,&$errors,$h)
	{
		if (!empty($p)) 
		{
			if ($p->agent_id==1002) {
				return;
			}
			if (isset($p->mdata['chargecode'])) {
				$chargecode=$p->mdata['chargecode'];
				$chargeCodeInfo = ImportChargeCode::model()->find('chargecode = :ccode', [':ccode' => $chargecode]);
				if (!empty($chargeCodeInfo)&&$chargeCodeInfo->status==1) {
					if (isset($chargeCodeInfo->mdata['selected_service'])&&is_array($chargeCodeInfo->mdata['selected_service'])) {
						if (empty($chargeCodeInfo->mdata['selected_service'])) {
							return;
						}
						$left='';
						$left_services='';
						$stotal=0;
						foreach ($chargeCodeInfo->mdata['selected_service'] as $key=>$value) {
							$stotal=$stotal|$value;
						}
										  
						$left=($the_service&$stotal)^$the_service;
						if ($left>0) {
							foreach (ImportChargeCode::$service_types as $l=>$v) {
								if (($l&$left)>0) {
									$left_services.= ImportChargeCode::$service_types[$l].';';
								}
							}
							$errors[]=$h.' shipment with chargecode:'.$p->mdata['chargecode'].' not have service: '.$left_services;
						}
					}
				}
			}
		}
	}

	public function putImparcelIntoConsol(&$p,$wt = null)
	{
		if(empty($p)) return;
		if ($p->status < 30)
		{
			$p->consol_id = $this->id;
			$p->status = 30;

			if (!empty($wt)) {
				$p->weight = $wt;
			}
			if (isset($p->mdata['chargecode'])) {
				$chargeCodeInfo = ImportChargeCode::model()->find('chargecode = :ccode', [':ccode' => $p->mdata['chargecode']]);
				if (!empty($chargeCodeInfo) && $chargeCodeInfo->status==1 && isset($chargeCodeInfo->status_mode) && $chargeCodeInfo->status_mode==1) {
					$p->status= ImParcel::STATE_LOCAL_ARRIVAL;
				}
			}
			$p->scan_no=$p->pkg;
			$p->save();
		}
	}

	public function getCourierList()
	{
		$result = [0=>'All',999=>'Other'];
		$sql = 'SELECT tr.org_id, o.name FROM tranship tr join shipment s on tr.pid = s.id join org o on o.id =tr.org_id WHERE consol_id ='.$this->id.' group by tr.org_id';
		$rs = Yii::app()->db->createCommand($sql)->queryAll();
		foreach ($rs as $key => $r) {
			$result[$r['org_id']] = $r['name'];
		}

		return $result;
	}

	public function getAOutStatus(){
		$result="";
		if(!empty($this->mdata['aoutsent'])&&$this->mdata['aoutsent']==1){
			$result = "Y[D]";
		}elseif (!empty($this->mdata['isclickunpack'])&&$this->mdata['isclickunpack']==1){
			$result = "Y";
		}
		if($this->service==10){
			if(!empty($this->mdata['seaoutreceipt'])&&$this->mdata['seaoutreceipt']==1){
				$result.="[R]";
			}
		}
		return $result;
	}
}
