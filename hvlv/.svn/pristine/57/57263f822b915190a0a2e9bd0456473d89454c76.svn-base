	/**
	 * calculate total of invoice amount for client reporting
	 * @param $owner
	 * @return int
	 */
	public function totInvoice(&$owner)
	{
		$totInvoice = 0;

		if ($owner->code == 'EG2') {
			// in case EPS globe
			// we still use original invoice create logic
			//foreach($this->shipments as $p) {
			//    $amt = $p->getCharge($owner);
			//    $totInvoice += $amt;
			//}
		} else {
			$orgRate = OrgRate::model()->find('org_id = :oid AND type = 40', [':oid' => $owner->id]);
			if (!empty($orgRate)) {
				$result = $this->genShipmentsInvoice($owner, $orgRate);
				$totInvoice = $result[0];
			}
		}
		return floatval($totInvoice);
	}



