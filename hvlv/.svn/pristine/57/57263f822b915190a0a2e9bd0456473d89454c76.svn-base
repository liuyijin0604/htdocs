	public function totClearShipments($wid=0)
	{
		$sql = 'SELECT COUNT(id) AS t FROM shipment WHERE consol_id = '.$this->id.' AND status in (60)';
		if (!empty($wid)) {
			$sql .= ' AND odpt_id = '.$wid;
		}
		$c = Yii::app()->db->createCommand($sql);
