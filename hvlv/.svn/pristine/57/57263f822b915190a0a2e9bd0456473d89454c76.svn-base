	}

	/**
	 * @param $orgId
	 * @param $postcode
	 * @param $weight
	 * @param $adjust  boolean  for brisbane and melbourne service, we need to adding some extra fees.
	 * @return int
	 */
	public static function getCourierTestCostPrice(&$orgRate, $postcode, $weight, $pks = 1, $adjust = false, $suburb = '')
	{
		$price = 0;
		$type="";
		$weight_hi=0;
		$weight_lo =0;
		$zoneMap = null;
		$zoneMaps = null;
		// base on postcode to get related charge code
		if($orgRate->type == OrgRate::COSTRATETESTTYPE)
		{
			//$zoneMap = ZoneMapTest::model()->find('rate_id = :oid AND zone_id = :zoneid AND pc_lo <= :code AND pc_hi >= :code', [':oid' =>$orgRate->id ,':zoneid' => $orgRate->zone_id,':code' => $postcode]);
			$zoneMaps = $orgRate->zoneMapTest;
		}else
		{
			$zoneMaps = $orgRate->org->zoneMap;
			//$zoneMap = ZoneMap::model()->find('org_id = :oid AND zone_id = :zoneid AND pc_lo <= :code AND pc_hi >= :code', [':oid' =>$orgRate->org_id ,':zoneid' => $orgRate->zone_id,':code' => $postcode]);
		}

		foreach ($zoneMaps as $key => $value) 
		{
				if($value["zone_id"]==$orgRate->zone_id&&$value["pc_lo"]<=$postcode&&$value["pc_hi"]>=$postcode)
				{
					$zoneMap=$value;
				}
		}
		// if not found we set as NSW country
		$chargeCode = 'N1';
		if (!empty($zoneMap) && !empty($zoneMap['z1'])) {
			$chargeCode = $zoneMap['z1'];
		}

		// base charge code to get zone rate
		//$zrs = ZoneRate::model()->findAll("zone = :s AND (weight_lo < :w AND weight_hi >= :w) AND rate_id = :rateid AND base+item+perkg > 0 ", [':s' => $chargeCode, ':w' => $weight / $pks, ':rateid' => $orgRate->id]);
		$zrs = [];
		$zoneRates = $orgRate->zoneRate;
		foreach ($zoneRates as $key => $value) 
		{
				if($value["zone"]==$chargeCode&&$value["weight_lo"]<($weight / $pks)&&$value["weight_hi"]>=($weight / $pks))
				{
					$zrs[] =$value;
				}
		}
		$theZr = null;
		if (!empty($zrs)) {

			// get maximum one
			foreach ($zrs as $zr) {
				$temp = $zr['base'] + ($zr['item'] * $pks);
				$type="piece";

				if ($zr['nkg'] > 0) {
					$wl = $weight- ($zr['base'] > 0 ? $zr['nkg'] : 0);
					$temp += ceil($wl / $zr['nkg']) * $zr['perkg'];
					$type ="kg";
				} else {
					$temp +=  $weight * $zr['perkg'];
					if($zr['perkg']>0)
					{
						$type ="kg";
					}
				}
				if ($zr['minimum'] > 0 && $temp < $zr['minimum']) {
					$temp = $zr['minimum'];
					$type ="kg";
				}

				$weight_hi = $zr['weight_hi'];
				$weight_lo = $zr['weight_lo'];
				if($price<=$temp)
				{
					$price = $temp;
					$theZr = $zr;
				}
			}

			if($price!=0){
				$remoteCostRate = RemoteChargeRate::model()->find("rate_id = :rateId and (postcode =:postcode or CONCAT('0',postcode)=:postcode) and upper(suburb) = :suburb and (perkg+base)>0",[":rateId"=>$orgRate->id,":postcode"=>$postcode,":suburb"=>strtoupper($suburb)]);
				if(!empty($remoteCostRate))
				{
					$remotrSurcharge = $weight*$remoteCostRate->perkg+$remoteCostRate->base;
					$price+=$remotrSurcharge;
				}
			}
			
		}
						
		return ['price'=>$price,'type'=>$type,'zr'=>$theZr,'weight_lo'=>$weight_lo,'weight_hi'=>$weight_hi,'pc_lo'=>$zoneMap['pc_lo'],'pc_hi'=>$zoneMap['pc_hi']];
	}


	public static function getHunterCostPrice($orgRate, $suburb, $postcode, $weight, $pks)
	{
		$portcode = HunterPortcode::model()->find('suburb = :suburb AND postcode = :postcode', [':suburb' => $suburb, ':postcode' => $postcode]);
		if (empty($portcode)) {
			$price = 99999;
		} else {
			$price = 0;
			$zr = ZoneRate::model()->find('zone = :zone AND rate_id = :rate_id AND base+item+perkg > 0', [':zone' => $portcode->zonecode, ':rate_id' => $orgRate->id]);
			if (!empty($zr)) {
				$temp = $zr->base + ($zr->item * $pks);
				if ($zr->nkg > 0) {
					$wl = $weight - ($zr->base > 0 ? $zr->nkg : 0);
					$temp += ceil($wl / $zr->nkg) * $zr->perkg;
				} else {
					$temp += $weight * $zr->perkg;
				}
				if ($zr->minimum > 0 && $temp < $zr->minimum) {
					$temp = $zr->minimum;
				}
				$price = max($price, $temp);
			}
		}
		return $price;
	}
				
		 
	public function search($pgn=true, $ps = 30, $ec = false, $forgp = false, $bydate = false, $defaultOrder=false, $createdDate=false)
	{
		// @todo Please modify the following code to remove attributes that should not be searched.

		$criteria=new CDbCriteria;

		$criteria->compare('t.id', $this->id);
		$criteria->compare('t.no', $this->no, true);
		$criteria->compare('t.owner_id', $this->owner_id);
		$criteria->compare('t.dpt_id', $this->dpt_id);
		$criteria->compare('carrier_id', $this->carrier_id);
		$criteria->compare('service', $this->service);
		if(!empty($this->dpt_id)&&$this->canUserCheckAll())
		{
			$criteria->compare('t.dpt_id', $this->dpt_id);
		}else
		{
			$criteria->compare('t.dpt_id', $this->getUserDptId());
		}

		if (empty($this->status)) {
			$criteria->addCondition('t.status != 100');
		}
							 
		$with=[];
		if (!empty($this->process_not_status)) {
			$with[]='process';
			$criteria->addNotInCondition('process.status', $this->process_not_status);
		}
		if (!empty($this->process_status)) {
			$with[]='process';
			$criteria->compare('process.status', $this->process_status);
		}
		if (!empty($this->process_statuses)) {
			$with[]='process';
			$criteria->addInCondition('process.status', $this->process_statuses);
		}
		if (!empty($this->process_types)) {
			$with[]='process';
			$criteria->addInCondition('process.type', $this->process_types);
		}
		if (!empty($this->process_airport)) {
			$with[]='process';
			$criteria->compare('process.airport', $this->process_airport, true);
		}
		if (!empty($this->process_airport_dead)) {
			$with[]='process';
			$criteria->compare('process.airport', $this->process_airport_dead, true);
		}
		if (!empty($this->owner_name)) {
			//$criteria->compare('owner.name',$this->owner_name,true);
			$sql = 'SELECT s.consol_id FROM shipment s INNER JOIN org o on s.agent_id = o.id WHERE o.name LIKE :n GROUP BY s.agent_id, s.consol_id';
			$rs = Yii::app()->db->createCommand($sql)->bindValues([':n' => '%'.$this->owner_name.'%'])->queryAll();
			$cids = [];
			$anotherSql='SELECT s.id FROM consol s INNER JOIN org o ON s.owner_id=o.id WHERE s.owner_id>0 AND o.name LIKE :n';
			$rs1=Yii::app()->db->createCommand($anotherSql)->bindValues([':n'=>'%'.$this->owner_name.'%'])->queryAll();
			foreach ($rs as $r) {
				if (empty($r['consol_id'])) {
					continue;
				}
				$cids[] = $r['consol_id'];
			}
			foreach ($rs1 as $r) {
				if (empty($r['id'])) {
					continue;
				}
				$cids[]=$r['id'];
			}
			$criteria->addInCondition("t.id", $cids);
		}
				 
		if (!empty($this->awb)) {
			$cawb = new CDbCriteria;
			$cawb->compare('t.awb', $this->awb, true);
			$cawb->compare('t.meta', $this->awb, true, 'OR');
			$criteria->mergeWith($cawb);
		} else {
			if ($forgp) {
				$criteria->addCondition('awb is not NULL');
			}
		}
		if (!empty($this->mabws)) {
			$ns = preg_split('/[\s,;]+/', trim($this->mabws));
			if (sizeof($ns) > 1000) {
				$ns = array_slice($ns, 0, 1000);
			}
			$sc1 = new CDbCriteria;
			$sc1->addCondition('t.awb REGEXP "' . implode('|', $ns) . '"');
			$sc1->addCondition('t.meta REGEXP "' . implode('|', $ns) . '"', 'OR');
			$criteria->mergeWith($sc1);
		}
		$criteria->compare('exrate', $this->exrate, true);
		$criteria->compare('airline', $this->airline, true);
		$criteria->compare('flight', $this->flight, true);
		$criteria->compare('pol', $this->pol);
		$criteria->compare('pod', $this->pod);
		$criteria->compare('poc', $this->poc, true);
		$criteria->compare('etd', $this->etd, true);
		$criteria->compare('eta', $this->eta, true);

		if($createdDate)
		{
			$criteria->addCondition(" DATE_SUB(CURDATE(), INTERVAL 60 DAY) <= date(created) ");
		}

		if($this->szportalCreate)
		{
			$criteria->addCondition(" meta like '%szportalCreate%' ");
		}

		if ($forgp) {
			// in case searching for GatePass
			// we only show not cleared console
			$criteria->addCondition('t.status < 90');
		} else {
			$criteria->compare('t.status', $this->status);
		}
		if ($bydate) {
			$criteria->addCondition("t.created >= '2017-01-01'");
		} else {
			$criteria->compare('t.created', $this->created, true);
		}
		if (!empty($this->bwf)) {
			$criteria->addCondition('bwf & ' . $this->bwf . ' > 0');
		}

		if($this->exInfo==ImParcel::DGBWFCODE)
		{
			$with[] = 'shipments';
			$criteria->addCondition('json_value(shipments.meta,"$.is_dg") = 1');
		}
		if($this->exInfo==ImParcel::DAMAGEBWFCODE)
		{
			$with[] = 'shipments';
			$criteria->addCondition('shipments.bwf & ' . $this->exInfo . ' > 0');
		}

		if ($ec) {
			$criteria->mergeWith($ec);
		}
		$sort = new CSort(get_called_class());
		$sort->attributes = [
			'owner_name'=>[
				'asc'=>'owner.name',
				'desc'=>'owner.name DESC',
			],
			'process_airport'=>[
				'asc'=>'process.airport',
				'desc'=>'process.airport DESC',
			],
			'process_airport_dead'=>[
				'asc'=>'process.pick_dead_date',
				'desc'=>'process.pick_dead_date DESC',
			],
			'*',
		];
		if (!$defaultOrder) {
			$sort->defaultOrder='t.id DESC';
		} else {
			$sort->defaultOrder=$defaultOrder;
		}
		$sob = $sort->getOrderBy();
		$sobs = preg_split('/, */', $sob);
		foreach ($sobs as $ob) {
			if (!strpos($ob, '.')) {
				continue;
			}
			list($m, $f) = explode('.', $ob);
			if (str_replace('`', '', $m) == 't') {
				continue;
			}
			$with[] = $m;
		}
		if (!empty($with)) {
			$criteria->with = array_unique($with);
			$criteria->together = true;
		}
				
		return new CActiveDataProvider($this, [
			'criteria'=>$criteria,
			'sort'=>$sort,
			'pagination'=> $pgn? [
				'pageSize' => $ps,
			] : false,
		]);
	}

