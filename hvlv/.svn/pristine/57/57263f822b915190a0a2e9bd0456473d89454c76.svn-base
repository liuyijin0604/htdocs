	public function handlingfee()
	{
		if (!empty($this->mdata['handlingfee'])) {
			return;
		}
		$billing = BillingLine::model()->find('billing_ref = :cref AND charge_code = :ccode', [':cref' => $this->no,':ccode' =>'91030' ]);
		if (!empty($billing)) {
			$this->mdata['handlingfee']=1;
			return;
		} else {
			$billings=BillingLine::model()->findAll('billing_ref = :cref  AND charge_code = :ccode', [':cref' => $this->no,':ccode' => Consol::AU_LOCAL_DELIVERY_COST_GL_CODE]);
			if (!empty($billings)) {
				foreach ($billings as $b) {
					if (preg_match('/HANDLING FEE/i', $b->desc)) {
						$this->mdata['handlingfee']=1;
						return;
					}
				}
				$this->newHandlingFee();
			} else {
				$this->newHandlingFee();
			}
		}
	}
	public function newHandlingFee()
	{
		if (!empty($this->mdata['cgb_wt'])&& is_numeric($this->mdata['cgb_wt'])) {
			$billing = new BillingLine();
			$billing->type = BillingLine::BILLING_TYPE_IMPORT;
			$billing->status = 1; // initial pending status
			$billing->link_id = 0;
			$billing->org_id = 949;
			$billing->charge_code = 91030;
			$billing->billing_cref =$this->no;
			$billing->currency = 1; // AUD default
			$billing->weight = isset($this->mdata['awb_wt']) ? $this->mdata['awb_wt'] : 0;
			$billing->charge_weight = isset($this->mdata['cgb_wt']) ? $this->mdata['cgb_wt'] : 0;

			// normally billing reference will be awb no , if not set we set job ID as reference
			$billing->billing_ref = $this->no;
			$billing->awb = $this->awb;
			$billing->dpt_id = empty($this->dpt_id) ? Org::PCAE_DEPARTMENT_SYDNEY : $this->dpt_id;
			$billing->date = date('Y-m-d');
			$billing->created = date('Y-m-d');
			$billing->transaction_date = $billing->date;
			$billing->due = $billing->date;
			$billing->type = BillingLine::BILLING_TYPE_IMPORT; // for import type
			$billing->dpmt = Invoice::DPMT_IMPORT;
			$billing->actual_amount =0;
			$billing->gst = 'INPUT';
			$billing->accrual_amount =number_format(52.5+0.51*$this->mdata['cgb_wt'], 2, '.', '');
			$billing->desc="DOC HANDLING FEE";
			if ($billing->save()) {
				$this->mdata['handlingfee']=1;
				$this->updateMeta();
			}
		}
	}
	/*
	 * create eparcel weight difference Invocie based on consol and agent_id
	 *
	 */
	public function eParcelWeightDiffInvoice($agent_ids=[])
	{
		if (sizeof($agent_ids)==0) {
			return;
		}
		$orgShipments=[];
		//only when reconciliationLine have the client_check_weight, then we can create the eParcel weight diff Invoice,
		//only for the specify agent_id
		//only for the eParcel
		foreach ($this->shipments as $shipment) {
			if (in_array($shipment->agent_id, $agent_ids)&& preg_match('/AMQ\d{7}/i', $shipment->ref)) {
				$recon=ReconciliationLine::model()->find('shipment_no=:ref', [':ref'=>$shipment->ref]);
				if (!empty($recon->cust_check_weight)) {
					$orgShipments[$shipment->agent_id][]=[$shipment,$recon->weight,$recon->cust_check_weight];
				}
			}
		}
		if (!empty($orgShipments)) {
			foreach ($orgShipments as $oid=>$theShipments) {
				$owner=Org::model()->findByPk($oid);
				$includingGST = false;
				if (isset($owner->extra['incl_gst']) && $owner->extra['incl_gst'] == 1) {
					$includingGST = true;
				}
				$inv = Invoice::model()->find('consol_id = :cid and type=32 and to_id=:to_id', [':cid' =>$this->id,':to_id'=>$oid]);
				$invoiceNo = '';
				$oldPaymentLines = '';
				if (!empty($inv)) {
					if ($inv->isInvoiceClosed()) {
						$inv->createCreditForMe();
						$oldPaymentLines = $inv->payments;
						$invoiceNo = $inv->no;
						$inv = null;
					}
				}
				if (empty($inv)) {
					$inv = new Invoice;
					$inv->type = 32;
					$inv->dpmt = Invoice::DPMT_IMPORT;
					$inv->to_id = $owner->by > 1? $owner->by : $owner->id; // for EPS client
					if($owner->by >1) $inv->mdata['suborg'] = $owner->id;
					$inv->dpt_id = Org::PCAE_DEPARTMENT_SYDNEY; // default set Sydney as warehouse
					$inv->ref = 'eparcel diff' . date('Ymd', strtotime($this->created));
					$inv->currency = 1;
					if (!empty($invoiceNo)) {
						$inv->no =Invoice::genNewInvoiceNo($invoiceNo);
					} //$invoiceNo . '-1';
					$inv->consol_id = $this->id;
					$inv->status = Invoice::INVOICE_STATUS_PENDING;
				}
				$inv->date = date('Y-m-d');
				$inv->save();
				$items = [];
				$tot = 0;
				foreach ($theShipments as $theShip) {
					if (!empty($theShip[0])) {
						$amt=$theShip[0]->getDiffChargeByChargecode($theShip[1], $theShip[2]);
						if ($amt>0) {
							$tot+=$amt;
							$items[]=[$theShip[0]->ref,$theShip[0]->cref,$theShip[0]->postcode,round($theShip[1], 2), round($theShip[2], 2),round(($theShip[1]-$theShip[2]), 2),$amt];
						}
					}
				}
				$gst = 0;
				if ($includingGST) {
					$gst = round($tot * 10 / 100, 2);
					$tot += $gst;
				}
				$tot = round($tot, 2);
				$inv->mdata['awb'] = $this->awb;
				$inv->mdata['name'] = $owner->name;
				$inv->mdata['address'] = $owner->getAddress();
				$inv->mdata['payterm'] = empty($owner->extra['payterm']) ? '2 days' : $owner->extra['payterm'] . ' days';
				$inv->due = Invoice::calcDue($inv->date, $inv->mdata['payterm']);
				$inv->total = $tot;
				$inv->gst = $gst;
				if ($inv->total > 0) { // avoid create invoice with zero amount
					$inv->save();
					$il= InvLine::model()->find('inv_id=:inv_id', [':inv_id'=>$inv->id]);
					if (empty($il)) {
						$il = new InvLine;
						$il->inv_id = $inv->id;
					}
					$il->amount = $inv->total;
					$il->gst = $gst;
					$il->mdata['items'] = $items;
					$il->model = 'ImcoConsol';
					$il->fid = $this->id;
					$il->qty = 1;
					$il->save();
					// apply old payments for the new created invoice
					if (!empty($oldPaymentsList)) {
						$inv->applyPayments($oldPaymentsList);
					}
				}
			}
		}
	}
	
	/*  1=>'Small letter up to 250g',
	 *  2=>'Large Letters up to 125g',
	 *  4=>'Large Letters 125g-250g',
	 *  8=>'Large Letters 250g-500g',
	 */
	public function getLetter()
	{
		$number=['small250'=>0,'large125'=>0,'large250'=>0,'large500'=>0,'priority_small250'=>0,'priority_large125'=>0,'priority_large250'=>0,'priority_large500'=>0];

		$letter_types = [
		1=> 'small250',
		2=> 'large125',
		4=> 'large250',
		8=> 'large500',
		16=> 'priority_small250',
		32=> 'priority_large125',
		64=> 'priority_large250',
		128=> 'priority_large500'
		];

		if (!empty($this->mdata['get_letter_lock'])) {
			Log::log2file("Letter Manifest".$this->no." The Process is Going", "transaction_err_log", "transaction");
			return $number;
		}
		$this->mdata['get_letter_lock']=1;
		$this->updateMeta();
		$transaction = Yii::app()->db->beginTransaction();
		try {
			foreach ($this->shipments as $p) {
				if(empty($p->mdata['letter_aupost'])) continue;
				if (empty($p->mdata['letter_mani']) && in_array($p->status, ImParcel::$allow_manifest_states) && ($p->getOutPkg() == $p->pkg)) {
					$k = $letter_types[$p->mdata['letter_aupost']];
					switch($p->mdata['letter_aupost']){
						case 128:
							if ($p->weight>=0.4) {
								$number['priority_large500']++;
							} else {
								$number['priority_large250']++;
							}
						break;
						case 64:
							$number['priority_large125']++;
						break;
						case 8:
							if ($p->weight>=0.4) {
								$number['large500']++;
							} else {
								$number['large250']++;
							}
						break;
						case 4:
							$number['large125']++;
						break;
						default:
							if(isset($number[$k])) $number[$k]++;
						break;
					}
					$p->mdata['letter_mani']=1;
					// $p->status=60;
					$p->save();
				}
			}
			$transaction->commit();
		} catch (Exception $ex) {
			$transaction->rollback();
			$this->mdata['get_letter_lock']=0;
			$this->updateMeta();
			Log::log2file("Letter Manifest".$this->no."=>".$ex->getMessage(), "transaction_err_log", "transaction");
			throw  $ex;
		}

		foreach ($number as $key => &$value) {
			$value = ceil($value*0.7);
		}
		return $number;
	}
		
		
	public static function getIdByNo($no)
	{
		$inconsol=ImcoConsol::model()->find('no=:no', [':no'=>$no]);
		if (!empty($inconsol)) {
			return $inconsol->id;
		}
			 
		return null;
	}
		
		
	public function getReportDetail()
	{
		$data=[];
		$sql="SELECT COUNT(id) as shipment_no,agent_id,SUM(weight) as sub_weight,SUM(cbm*pkg) as sub_cbm FROM `shipment` WHERE consol_id=:cid GROUP BY agent_id";
		$rs=Yii::app()->db->createCommand($sql)->bindValues([':cid'=>$this->id])->queryAll();
		foreach ($rs as $r) {
			$data[$r['agent_id']]=['number'=>$r['shipment_no'],'sub_weight'=>$r['sub_weight'],'sub_cbm'=>$r['sub_cbm']];
		}
		return $data;
	}

