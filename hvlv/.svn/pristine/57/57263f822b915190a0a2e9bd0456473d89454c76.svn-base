		//$remoteCostRate = RemoteChargeRate::model()->find("rate_id = :rateId and (postcode =:postcode or CONCAT('0',postcode)=:postcode) and upper(suburb) = :suburb ",[":rateId"=>$orgRate->id,":postcode"=>$shipment->cnee->postcode,":suburb"=>strtoupper($shipment->cnee->suburb)]);


