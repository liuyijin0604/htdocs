	public static function getCourierCostPriceForEnquiryRemoteCost($orgRate, $postcode, $weight, $pks = 1, $adjust = false, $suburb = '',$getZoneRate = false,$country = '',$shipment=false)
	{
		$remoteCostRate = RemoteChargeRate::model()->find("rate_id = :rateId and (postcode =:postcode or CONCAT('0',postcode)=:postcode) and upper(suburb) = :suburb and (perkg+base)>0",[":rateId"=>$orgRate->id,":postcode"=>$postcode,":suburb"=>strtoupper($suburb)]);
		if(!empty($remoteCostRate))
			{
				$remotrSurcharge = $weight*$remoteCostRate->perkg+$remoteCostRate->base;
				//$price+=$remotrSurcharge;
