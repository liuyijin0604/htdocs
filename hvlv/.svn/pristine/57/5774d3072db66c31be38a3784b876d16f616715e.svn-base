<?php
class icsFetcher {
	private $_pop;
	private $siteId;
	private $icsSetting;
	private $mainIcsSetting;
	protected $edis = Array();

	function __construct($siteId) {
		if (!extension_loaded('imap')) {
			if (!dl('imap.so')) {
				die("Fetcher Error: This class requires imap extension to run!<br/>");
			}
		}
		$this->siteId = $siteId;
		$this->icsSetting =  Yii::app()->params['otherICS'][$siteId];
		$this->mainIcsSetting = Yii::app()->params['otherICS']['FJT773H'];
		//Open stream connection to the POP server
		$this->_pop= imap_open("{".$this->icsSetting['email_server'].":143/imap/notls/novalidate-cert}INBOX", $this->icsSetting['email'], $this->icsSetting['email_pwd']) or die ("Connection Error: " . imap_last_error()."<br/>");
		if (@imap_num_msg($this->_pop) == 0){
			$errors = imap_errors();
			imap_close($this->_pop);
			echo("No Message found!\n");
			$this->_pop = false;
		}
	}

	public function cleanBox($limit = 0){
		if(empty($this->_pop)) return 0;
		$siteid = $this->icsSetting['testing']? $this->icsSetting['test_site'] : $this->icsSetting['prod_site'];
		
		$i = 0;
		$d = 0;
		foreach(imap_sort($this->_pop,SORTARRIVAL,0) as $mid) {
			if($limit > 0 && $i++ >= $limit) break;
			$header = imap_headerinfo($this->_pop, $mid);
			if(preg_match("/^AAA336C_(\d{14})_".$siteid."/", trim($header->subject), $ns) && trim($header->fromaddress) == $this->icsSetting['customs_email']){
				if(Edimsg::model()->count('mid = :mid AND sender = :sndr AND  dt > DATE_SUB(NOW(), INTERVAL 5 DAY)', [':mid' => ltrim($ns[1], '0'), ':sndr' => 'AAA336C']) > 0){
					imap_delete($this->_pop, $mid);
					echo "1";
					// echo 'DEL '.$ns[1], PHP_EOL;
					$d++;
				}else{
					// echo 'skip '.$mid, PHP_EOL;
				}
			}
		}

		return $d;
	}

	public function fetchMsgFor($fwdfrom = false, $limit = 0){
		if(empty($this->_pop)) return [];
		$siteid = $this->icsSetting['testing']? $this->icsSetting['test_site'] : $this->icsSetting['prod_site'];
		
		$i = 0;
		foreach(imap_sort($this->_pop,SORTARRIVAL,0) as $mid) {
			if($limit > 0 && $i++ >= $limit) break;
			$header = imap_headerinfo($this->_pop, $mid);
			//encrypted message from customs
			if(preg_match("/^AAA336C_\d{14}_".$siteid."/", trim($header->subject)) && (trim($header->fromaddress) == $this->icsSetting['customs_email'] || trim($header->fromaddress) == 'cargo@ccf.abf.gov.au')){
				$this->fetchEncryptedMsg($mid, $header);
				continue;
			}

			//forwarded message not encrypted
			if(preg_match("/AAA336C_\d{14}_".$siteid."/", trim($header->subject)) && ($fwdfrom == $header->from[0]->mailbox."@".$header->from[0]->host || (!$fwdfrom === true))){
				$this->fetchForwardedMsg($mid, $header);
				continue;
			}
		}

		return $this->edis;
	}

	private function fetchEncryptedMsg($mid, $header){
		$msg_enc = $this->saveTmpFile(imap_fetchheader($this->_pop, $mid)."\r\n\r\n".imap_body($this->_pop, $mid));
		$msg_sig = $this->saveTmpFile("");
		if(
			(!empty($this->icsSetting['new_enc_pem'])&&openssl_pkcs7_decrypt($msg_enc, $msg_sig, $this->icsSetting['new_enc_pem'], array($this->icsSetting['new_enc_pem'], $this->icsSetting['pem_pwd'])))
			||openssl_pkcs7_decrypt($msg_enc, $msg_sig, $this->icsSetting['enc_pem'], array($this->icsSetting['enc_pem'], $this->icsSetting['pem_pwd']))
			||openssl_pkcs7_decrypt($msg_enc, $msg_sig, $this->mainIcsSetting['enc_pem'], array($this->mainIcsSetting['enc_pem'], $this->mainIcsSetting['pem_pwd']))
		){
			unlink($msg_enc);
			$this->getAttachedEDI($mid, $header, $msg_sig);
		}else{
			unlink($msg_enc);
		}
	}

	private function fetchForwardedMsg($mid, $header){
		$struct = imap_fetchstructure($this->_pop, $mid);
		if ($struct->type === 1 && ($struct->subtype != 'ALTERNATIVE' && $struct->subtype != 'RELATED')){
			for($i=0; $i<count($struct->parts); $i++) {
				if(isset($struct->parts[$i]->disposition) && (strtoupper($struct->parts[$i]->disposition) === "ATTACHMENT" || strtoupper($struct->parts[$i]->disposition) === "INLINE")) {
					foreach($struct->parts[$i]->dparameters as $key=>$val) {
						if(strtoupper($val->attribute) === "FILENAME" && !empty($val->value) && $val->value == "smime.p7m"){
							$body = "Content-Type: application/pkcs7-mime; name=\"smime.p7m\"\r\nContent-Transfer-Encoding: base64\r\nContent-Disposition: inline;filename=\"smime.p7m\"\r\n\r\n".imap_fetchbody($this->_pop, $mid, $i + 1);
							$msg_sig = $this->saveTmpFile($body);
							$this->getAttachedEDI($mid, $header, $msg_sig);
							break;
						}
					}
				}
			}
		}
	}

	private function getAttachedEDI($mid, $msgheader, $msg_sig){
		$tmp_sig = $this->saveTmpFile("");
		$msg_plain = $this->saveTmpFile("");
		if(openssl_pkcs7_verify($msg_sig, PKCS7_DETACHED | PKCS7_NOVERIFY | PKCS7_NOCHAIN, $tmp_sig, array(), substr($this->icsSetting['enc_pem'], 7), $msg_plain)||(!empty($this->icsSetting['new_enc_pem'])&&openssl_pkcs7_verify($msg_sig, PKCS7_DETACHED | PKCS7_NOVERIFY | PKCS7_NOCHAIN, $tmp_sig, array(), substr($this->icsSetting['new_enc_pem'], 7), $msg_plain))){
			list($header, $body) = explode("\r\n\r\n", file_get_contents($msg_plain), 2);
			preg_match("/filename\=([^\.]+)\.edi/", $header, $m);
			$edi = new StdClass;
			$edi->name = empty($m[1])? '' : trim($m[1]);
			$edi->data = quoted_printable_decode($body);
			$edi->utime = $msgheader->udate;
			$edi->from = $msgheader->fromaddress;
			array_push($this->edis, $edi);
			imap_delete($this->_pop, $mid);
		}
		unlink($tmp_sig);
		unlink($msg_sig);
		unlink($msg_plain);
	}

	protected function saveTmpFile($data) {
		$tmpfname = tempnam(sys_get_temp_dir(), "ICS");
		file_put_contents($tmpfname, $data);
		return $tmpfname;
	}

	//Delete used mails and end session
	public function finish() {
		if(empty($this->_pop)) return false;
		imap_expunge($this->_pop);
		$errors = imap_errors();
		imap_close($this->_pop);
	}

//end of class
}
