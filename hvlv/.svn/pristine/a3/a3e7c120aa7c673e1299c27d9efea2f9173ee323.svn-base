		$bays = ['01', '02', '03', '04', '05', '06', '07'];
		foreach ($prefixes as $prefix) {
			foreach ($bays as $bay) {
				for ($i = 1; $i < 6; $i++) {
					$code = $prefix . '-' . $bay . '-L' . $i;
					$rackBayLeft = WmsLocation::model()->findByAttributes(array('code' => $code));
					if (empty($rackBayLeft)) {
						$rackBayLeft = new WmsLocation();
						$rackBayLeft->wid = 218;
						$rackBayLeft->type = WmsLocation::TYPE_RACK_BAY;
						$rackBayLeft->status = 1;
						$rackBayLeft->name = $code;
						$rackBayLeft->code = $code;
						$rackBayLeft->save();
					}
					$code = $prefix . '-' . $bay . '-R' . $i;
					$rackBayRight = WmsLocation::model()->findByAttributes(array('code' => $code));
