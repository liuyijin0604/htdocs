	public function TrackingTollShipment()
	{
		$request = new stdClass();
		$request->TollMessage = new stdClass;
		$request->TollMessage->Header = $this->GetTrackingHeader();

		$shipment = Shipment::model()->findByPk('10874999');
		$request->TollMessage->TrackAndTrace = $this->GetTrackAndTrace($shipment);


		$jsonRequest = json_encode($request);
		$response = $this->CallTollApi($jsonRequest);
		//file_put_contents("D:/TLA/toll/response/response.json", $result);

		$result = json_decode($response);
		$tollShipments = $result->TollMessage->TrackAndTrace->Response->Shipments->Shipment;
		$prevActivity = '';
		foreach ($tollShipments as $key => $tollShipment) {
			$eventArr = $tollShipment->Events->Event;
			foreach ($eventArr as $event) {
				if ($event->Codes->Code[0]->Description == $prevActivity) {
					continue;
				}
				$pid = $shipment->id;
				$dt = $event->DatePeriodCollection->DatePeriod[0]->DateTime;
				$dt = explode(' ', $dt)[0];
				$dt = str_replace('T', ' ', $dt);
				$dt = str_replace('.000', '', $dt);
				$type = 69;
				$activity = $event->Codes->Code[0]->Description;
				$depot = $event->Locations->Location[0]->PhysicalAddress->Suburb;
				$this->AddTrackingRecord($pid, $dt, $type, $activity, $depot);
				$prevActivity = $activity;
			}
		}
		echo "Done.\n";
	}

	private function GetTrackingHeader()
	{
		$guid = $this->guid();
		$guid = str_replace('{', '', $guid);
		$guid = str_replace('}', '', $guid);
		$dateStr = date("Y-m-d") . "T" . date("H:i:s+10:00");
		$header = new stdClass();
		$header->MessageVersion = "1.0";
		$header->MessageIdentifier = $guid;
		$header->CreateTimestamp = $dateStr;
		$header->DocumentType = "TrackAndTrace";
		$header->Environment = "MYT_SIT1";
		$header->SourceSystemCode = "TE79";
		$header->MessageSender = "TOPLOGISTICS";
		$header->MessageReceiver = "TOLL";
		return $header;
	}

	private function Guid()
	{
		if (function_exists('com_create_guid')) {
			return com_create_guid();
		} else {
			mt_srand((float)microtime() * 10000);
			$charid = strtoupper(md5(uniqid(rand(), true)));
			$hyphen = chr(45);
			$uuid = chr(123) . substr($charid, 0, 8) . $hyphen . substr($charid, 8, 4) . $hyphen . substr($charid, 12, 4) . $hyphen . substr($charid, 16, 4) . $hyphen . substr($charid, 20, 12) . chr(125);
			return $uuid;
		}
	}

	public function GetTrackAndTrace($shipment)
	{
		$traceBody = new stdClass();
		$traceBody->Request = new stdClass();
		$traceBody->Request->SearchTexts = new stdClass();
		$traceBody->Request->SearchTexts->SearchText = [];
		$traceBody->Request->SearchTexts->SearchText[0]["Value"] = $shipment->ref;
		$traceBody->Request->SearchTexts->SearchText[0]["BusinessID"] = "IPEC";
		return $traceBody;
	}

	private function CallTollApi($json)
	{
		$curl = curl_init();

		curl_setopt_array($curl, array(
			CURLOPT_URL => 'https://api.tollgroup.com:6930/ws/TollMessageTrackAndTraceRestService/1.0/tom/enquireTrackTrace',
			CURLOPT_RETURNTRANSFER => true,
			CURLOPT_ENCODING => '',
			CURLOPT_MAXREDIRS => 10,
			CURLOPT_TIMEOUT => 0,
			CURLOPT_FOLLOWLOCATION => true,
			CURLOPT_HTTP_VERSION => CURL_HTTP_VERSION_1_1,
			CURLOPT_CUSTOMREQUEST => 'POST',
			CURLOPT_POSTFIELDS => $json,
			CURLOPT_HTTPHEADER => array(
				'Authorization: Basic bWljaGVsbGVAdG9wbG9naXN0aWNzLmNvbTpRVDlhRjh3azZC',
				'Content-Type: application/json'
			),
		));

		$response = curl_exec($curl);

		curl_close($curl);
		return $response;
	}

	private function AddTrackingRecord($pid, $dt, $type, $activity, $depot)
	{
		$trackingRecord = new Tracking();
		$trackingRecord->pid = $pid;
		$trackingRecord->dt = $dt;
		$trackingRecord->type = $type;
		$trackingRecord->activity = $activity . " - " . $depot;
		$trackingRecord->depot = $depot;
		$trackingRecord->save();
	}

