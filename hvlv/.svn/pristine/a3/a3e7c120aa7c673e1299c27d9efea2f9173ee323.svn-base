		$successEvent->eventCode = "CP";
		$successEvent->eventTime = "2023-07-05 16:38:00";
		$successEvent->eventTimeZone = date_default_timezone_get();
		$successEvent->eventLocation = "Sydney";
		$successEvent->eventDetail = "Customs Clared";
		$successEvent->countryCode = "AU";
		array_push($trackingObj->successList, $successEvent);

		$failEvent->failCode = "C";
		$failEvent->eventTime = "2023-07-05 16:38:00";
		$failEvent->eventTimeZone = date_default_timezone_get();
		$failEvent->eventLocation = "Sydney";
		$failEvent->failDetail = "Customs clearance failed";
		$failEvent->countryCode = "AU";
		array_push($trackingObj->failList, $failEvent);
		array_push($data, $trackingObj);
		//echo json_encode($data);
		$data = '"trackingNumber":"36B36507258901000931509","successList":[{"eventCode":"CP","eventTime":"2023-07-05 16:38:00","eventTimeZone":"Europe\/Berlin","eventLocation":"Sydney","eventDetail":"Customs Clared","countryCode":"AU"}],"failList":[{"failCode":"C","eventTime":"2023-07-05 16:38:00","eventTimeZone":"Europe\/Berlin","eventLocation":"Sydney","failDetail":"Customs clearance failed","countryCode":"AU"}]';
		$content = sprintf("%s%s", $key, $data);
		$md5 = md5($content, true);
		$sign = base64_encode($md5);
		echo $data . "\n";
		echo $sign;
	}

	public function timezone()
	{
		$timezone = new DateTimeZone(date_default_timezone_get());
		$datetime = new DateTime('now', $timezone);
		$offset = $timezone->getOffset($datetime);
		$hours = abs(intdiv($offset, 3600));
		$minutes = abs(intdiv($offset % 3600, 60));
		$timezoneFormatted = sprintf("GMT%s%02d:%02d", ($offset >= 0 ? '+' : '-'), $hours, $minutes);
		echo $timezoneFormatted;
	}

	public function addOrgRate()
	{
		$parameters = json_decode($this->args[1]);

		$orgRate = new OrgRate();
		$orgRate->org_id = $parameters->org_id;
		$orgRate->zone_id = $parameters->zone_id;
		$orgRate->name = $parameters->name;
		$orgRate->code = $parameters->code;
		$orgRate->type = 5;
		$orgRate->vfrom = date('Y-m-d');
		$orgRate->currency = 1;
		$orgRate->mdata['ddpt_id'] = $parameters->depot;
		$orgRate->mdata['cbm_pricing'] = 0;
		$orgRate->mdata['invisible'] = 1;
		$orgRate->updated = date('Y-m-d H:i:s');
		if ($orgRate->save()) {
			echo "Succeed";
		} else {
			echo "Failed";
		}
	}

