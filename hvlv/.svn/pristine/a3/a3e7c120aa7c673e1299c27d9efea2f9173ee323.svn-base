	public function updatePLDptId($from = '', $to = '')
	{
		$from = $this->args[1];
		$to = $this->args[2];

		$sql = 'SELECT * FROM pl_ledger_management WHERE model = "ImP_Manifest" AND `date` >= "' . $from . '" AND `date` <= "' . $to . '"';
		$pls = PlLedger::model()->findAllBySql($sql);

		foreach ($pls as $pl) {
			if ($pl->dpt_id == 0 && $pl->fid != 0) {
				$s = ImParcel::model()->findByPk($pl->fid);
				if (!empty($s)) {
					$pl->dpt_id = $s->ddpt_id;
					$pl->save();
				}
			}
		}

		echo 'Done!';
	}

