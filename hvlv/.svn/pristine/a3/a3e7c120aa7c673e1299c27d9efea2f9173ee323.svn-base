	public function setWordReplaceCreateTime()
	{
		$records = WordReplace::model()->findAll('id > 0');
		foreach ($records as $record) {
			$sql = 'SELECT * FROM `log` WHERE model = "WordReplace" AND lid = ' . $record->id . ' ORDER BY id ASC LIMIT 1'; 
			$log = Log::model()->findBySql($sql);
			if (!empty($log)) {
				$record->created = date('Y-m-d H:i:s', strtotime($log->time));
				$record->save();
			}
		}
		echo 'Done';
	}

	public function insertGatePassCourier()
	{
		$args = json_decode($this->args[1],true);

		$gatepassCourier = new GatepassCourier();
		$gatepassCourier->id = $args['id'];
		$gatepassCourier->type = $args['type'];
		$gatepassCourier->courier_id = $args['courier_id'];
		$gatepassCourier->driver_name = $args['driver_name'];
		$gatepassCourier->driver_rego = $args['driver_rego'];
		$gatepassCourier->ref = $args['ref'];
		$gatepassCourier->create_time = $args['create_time'];
		$gatepassCourier->status = $args['status'];
		$gatepassCourier->meta = $args['meta'];
		$gatepassCourier->user_id = $args['user_id'];
		$gatepassCourier->driver_license_id = $args['driver_license_id'];
		$gatepassCourier->save();

		echo 'insertGatePassCourier complete';
	}

	public function updateGatepassShipment()
	{
		$args = json_decode($this->args[1], true);

		$gpShipments = GatepassShipment::model()->findAllByAttributes(array('fid' => $args['shipment_id']));
		foreach ($gpShipments as $gpShipment) {
			$shipment = Shipment::model()->findByPk($gpShipment->fid);
			$gpShipment->shipment_status = 90;
			$gpShipment->gate_pass_time = $args['gate_pass_time'];
			$gpShipment->parent_id = $args['parent_id'];
			$gpShipment->status = $args['status'];
			$gpShipment->meta = @$args['meta'];
			$gpShipment->save();
		}

		echo 'updateGatepassShipment complete';
	}

	public function clearCargoAddressBook()
	{
		$sql = 'SELECT * FROM cargo_address_book WHERE `status` = 1 LIMIT 1000';
		$addressBooks = CargoAddressBook::model()->findAllBySql($sql);
		foreach ($addressBooks as $addressBook) {
			$addressBook->status = 0;
			$addressBook->update();
		}
		echo 'Clear Address Book Done';
	}

