	public function createRackPerth()
	{
		$prefixes = ['WA', 'WB', 'WC', 'WD', 'WE', 'WF', 'WG', 'WH', 'WI', 'WJ', 'WK', 'WL', 'WM', 'WN', 'WO', 'WP'];
		$bays = ['01', '02', '03', '04', '05', '06', '07', '08', '09', '10', '11', '12', '13', '14', '15'];
		$sixLevels = ['WA', 'WB', 'WJ', 'WK', 'WL', 'WM'];
		$sevenLevels = ['WC', 'WH', 'WI'];
		$eightLevels = ['WD', 'WE'];
		$nineLevels = ['WF', 'WG', 'WN', 'WO', 'WP'];
		foreach ($prefixes as $prefix) {
			foreach ($bays as $bay) {
				if (in_array($prefix, $sixLevels)) {
					for ($i = 1; $i < 7; $i++) {
						$code = $prefix . "-" . $bay . "-L" . $i;
