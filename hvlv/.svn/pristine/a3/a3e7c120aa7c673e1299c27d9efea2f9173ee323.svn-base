	public function extractErrorShipment()
	{
		$result = "{\"errors\":[{\"code\":\"400\",\"name\":\"Bad Request\",\"message\":\"Your combination of suburb, state & postcode doesn't match. Please review and try again.\",\"field\":\"shipments[22].to.destination\"},{\"code\":\"400\",\"name\":\"Bad Request\",\"message\":\"Your combination of suburb, state & postcode doesn't match. Please review and try again.\",\"field\":\"shipments[23].to.destination\"}]}";
		$result = json_decode($result);
		//$pattern = '/\[(.*?)\]/';
		$pattern = '/\[(\d+)\]/'; // Match integer values between square brackets
		$errorShipments = [];
		//print_r($result->errors);
		/* foreach ($result->errors as $error) {
			if (!empty($error->field)) {
				preg_match_all($pattern, $error->field, $matches);
				print_r($matches[1][0]);
			}
		} */
		foreach ($result->errors as $error) {
			if (!empty($error->field)) {
				/* preg_match_all($pattern, $error->field, $matches);
				array_push($errorShipments, $matches[1][0]); */
				$temp = new stdClass;
				preg_match_all($pattern, $error->field, $matches);
				$temp->index = $matches[1][0];
				$temp->message = !empty($error->message) ? $error->message : '';
				array_push($errorShipments, $temp);
			}
		}
		print_r($errorShipments);
	}

