	public function extract_australian_phone_numbers($string)
	{
		// Regular expression pattern to match Australian phone numbers without spaces, country code, or hyphens
		$pattern = '/(?:\+?61|0)?[2-478](?:[ -]?[0-9]){5}[ -]?[0-9]{3}/';

		// Match the pattern in the string and store the results in $matches
		preg_match_all($pattern, $string, $matches);

		// Replace any spaces, country code, or hyphens in the matched phone numbers with an empty string
		$phone_numbers = array_map(function ($number) {
			return preg_replace('/\+?61|[-\s]/', '', $number);
		}, $matches[0]);

		$phone_number = @$phone_numbers[0];

		// Return the cleaned phone numbers as an array
		return $phone_number;
	}

	function testPhone()
	{
		$phone_number = "111111";
		$phone = $this->extract_australian_phone_numbers($phone_number);
		if (strlen($phone) == 9) {
			$phone = '0' . $phone;
		}
		print_r($phone);
	}

