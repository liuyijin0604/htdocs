	public function actionExportFeedbackDetails()
	{
		$xls = new oExcel;
		$xls->setColWidth([20, 20, 20, 20, 20, 20, 20]);
		$i = 1;
		$xls->addRow($i++, ['Email Feedback Details']);
		$xls->mergeCells('A1:H1');
		$xls->setFont('A1', ['bold' => true, 'size' => '20']);
		$xls->centerAlignment('A1');
		$xls->addRow($i++, ['No', 'Ticket','From Email', 'To Email', 'OP ID', 'Reply Time', 'Rating']);

		if (!empty($_GET['op_id'])) {
			$op_id = $_GET['op_id'];
			$sql = "SELECT * FROM imports_mail WHERE `status` = 111 AND `op_id` = " . $op_id . " ORDER BY `date` DESC";
			$response = ImportsMail::model()->findAllBySql($sql);
			foreach($response as $email) {
				$xls->addRow($i++, [$email->no, $email->ticket, $email->from_email, $email->to_email, $email->op_id, $email->date, $email->mdata['rating']]);
			}

		}
		$xls->output('Imports_Mail_Feedback_Report' . date('Ymd') . '.xlsx');
	}
	/**
	 * Returns the data model based on the primary key given in the GET variable.
	 * If the data model is not found, an HTTP exception will be raised.
	 * @param integer $id the ID of the model to be loaded
	 * @return ImportsMail the loaded model
	 * @throws CHttpException
	 */
	public function loadModel($id)
	{
		$model = ImportsMail::model()->findByPk($id);
		if ($model === null) {
			throw new CHttpException(404, 'The requested page does not exist.');
		}
		return $model;
	}
}
