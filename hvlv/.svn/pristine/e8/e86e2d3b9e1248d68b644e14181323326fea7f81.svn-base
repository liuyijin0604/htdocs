	public function actionFilterManage()
	{
		$isWms = !empty($_GET['isWms'])?1:0;
		if (!empty($_POST)) {
			if (!empty($_POST['filter_meta_items'])) {
				$meta_item = json_decode($_POST['filter_meta_items'], true);
				ImportsMailFilter::model()->deleteAll('is3pl = :is3pl',[':is3pl'=>$isWms]);
				foreach ($meta_item as $item) {
					$model = new ImportsMailFilter('search');
					$model->attributes = $item;
					$model->is3pl = $isWms;
					$model->save();
				}
				$this->ajaxResult($model);
			}
		}
		$this->render('filter_manage',['isWms'=>$isWms]);
	}
	public function actionManageUserMap()
	{
		if (!empty($_POST)) {
			if (!empty($_POST['inports_mail_map_user_items'])) {
				$meta_item = json_decode($_POST['inports_mail_map_user_items'], true);
				$history_record = [];
				$new_record = [];
				$isWms = !empty($_POST['isWms'])?1:0;
				$history = ImportsMailUserMap::model()->findAll('is3pl = :is3pl',[':is3pl'=>$isWms]);
				foreach ($history as $h) {
					$history_record[$h->type_id][] = $h->user_id;
				}
				ImportsMailUserMap::model()->deleteAll('is3pl = :is3pl',[':is3pl'=>$isWms]);
				foreach ($meta_item as $key => $value) {
					foreach ($value as $k => $v) {
						if (empty($v) || empty($v['uid'])) {
							continue;
						}
						$model = new ImportsMailUserMap;
						$model->type_id = $k;
						$model->user_id = $v['uid'];
						if (!empty($v['tel'])) {
							$model->tel = $v['tel'];
						}
						$new_record[$k][] = $v['uid'];
						$model->is3pl  = $isWms;
						$model->save();
					}
				}
				$result = $this->getArrayResult($history_record, $new_record);
				ImportsMail::newMappingUserMail($result);
				$this->ajaxResult($model);
			}
		}
	}

	private function getArrayResult($old, $new)
	{
		$result = ['add' => [], 'remove' => []];
		//add first
		$old_keys = array_keys($old);
		$new_keys = array_keys($new);
		if (!empty(array_diff($old_keys, $new_keys))) {
			foreach (array_diff($old_keys, $new_keys) as $onediff) {
				$result['remove'][$onediff] = $old[$onediff];
				unset($old[$onediff]);
			}
		}
		if (!empty(array_diff($new_keys, $old_keys))) {
			foreach (array_diff($new_keys, $old_keys) as $onediff) {
				$result['add'][$onediff] = $new[$onediff];
				unset($new[$onediff]);
			}
		}
		if (!empty($old)) {
			foreach ($old as $key => $value) {
				if (array_diff($old[$key], $new[$key])) {
					$result['remove'][$key] = array_diff($old[$key], $new[$key]);
				}
				if (array_diff($new[$key], $old[$key])) {
					$result['add'][$key] = array_diff($new[$key], $old[$key]);
				}
			}
		}
		return $result;
	}
	/***
	 * Manage Personal Signature
	 */
	public function actionMySignature()
	{
		if (!empty($_POST)) {
			$transaction = Yii::app()->db->beginTransaction();
			try {
				$model = ImportsMailSignature::model()->findByPk($_POST['select_signature']);
				$model->sig_body = $_POST['ImportsMailSignature']['sig_body'];
				ImportsMailSignature::removeDefault();
				$model->status = 1;
				$model->save();
				$transaction->commit();
			} catch (Exception $ex) {
				$transaction->rollback();
			}
			$this->ajaxResult($model);
		}
		$this->render('signature_management');
	}

	public function actionNewSignature()
	{
		$model = new ImportsMailSignature();
		if (!empty($_POST['ImportsMailSignature'])) {
			$model->user_id = Yii::app()->user->id;
			$model->sig_name = $_POST['ImportsMailSignature']['sig_name'];
			$model->sig_body = $_POST['ImportsMailSignature']['new_sig_body'];
			if (!ImportsMailSignature::haveDefaultSignature()) {
				$model->status = 1;
			}
			$model->save();
			$this->ajaxResult($model);
		}

		$this->render('new_signature', ['model' => $model]);
	}

