		$this->render('create_email', ['model' => $model,'data'=>$data]);
	}

	public function actionForward($id)
	{
		$model = new ReplyEmail('search');
		$email = $this->loadModel($id);
		if (isset($_POST['ReplyEmail'])) {
			$model->attributes = $_POST['ReplyEmail'];
			$model->reply_subject = $model->reply_subject . (preg_match('/\{EM\d+\}$/i', $model->reply_subject) ? '' : ' {' . $email->no . '}');

			foreach ($_POST['mdata'] as $k => $v) {
				$model->mdata[$k] = $v;
			}
			$model->email_id = $email->id;
			$model->reply_op = Yii::app()->user->id;
			$model->save();
			if (!empty(Yii::app()->session['uploads'][$_POST['ppupload']][2])) {
				foreach (Yii::app()->session['uploads'][$_POST['ppupload']][2] as $fid) {
					$fr = FileRepo::model()->findByPk($fid);
					$fr->fid = $model->id;
					$fr->save();
				}
			}
			if (!empty($email->attachments)) {
				$transaction = Yii::app()->db->beginTransaction();
				try {
					foreach ($email->attachments as $at) {
						$tempAt = new FileRepo();
						$tempAt->fid = $model->id;
						$tempAt->type = 29;
						$tempAt->name = $at->name;
						$tempAt->hash = $at->hash;
						$tempAt->mime = $at->mime;
						$tempAt->size = $at->size;
						$tempAt->date = $at->date;
						$tempAt->status = $at->status;
						$tempAt->save();
					}
					$transaction->commit();
				} catch (Exception $ex) {
					$transaction->rollback();
				}
			}
			$o = $model->sendMail();
			if ($model->status != 1) {
				$model->addError('id', $o['msg']);
			} else {
				$email->mailUserReply();
			}
			$this->ajaxResult($model);
		}
		//            $model->reply_email=$email->from_email;
		$email->loadContent();
		if($email->isHtmlBody)
		{
			$model->reply_body = $email->getReplyHeader() . @$email->plain_body;
		}else
		{
			$model->reply_body = $email->getReplyHeader() . @$email->tempMailBody;
		}
		
		$model->reply_subject = (preg_match('/^fw:/i', $email->subject) ? '' : 'Fw: ') . $email->subject;
		$model->reply_from = 'imports@toplogistics.com.au';
		/*
		$cc='';
		if (!empty($email->mdata['cc'])) {
		foreach ($email->mdata['cc'] as $c) {
		$cc.=$c['address'].';';
		}
		}
		$model->mdata['cc']=$cc;
		 */
		$this->render('reply_email', ['model' => $model]);
	}

	public function actionTotalEmails()
	{
		$model = new ImportsMail('search');
		if (!empty($_GET['ImportsMail'])) {
			$model->attributes = $_GET['ImportsMail'];
		}
		$isWms = !empty($_GET['isWms'])?1:0;
		$mailTypes = ImportsMail::$mailTypes;
		$importscs_list_id = ImportsMail::$importscs_list_id;
		if($isWms)
		{
			$model->is3pl = 1;
			$mailTypes = ImportsMail::$wmsMailTypes;
			$importscs_list_id = ImportsMail::$wmscs_list_id;
		}else
		{
			$model->is3pl = 0 ;
		}



		$total = 0;
		$provide = [];
		$sql = "SELECT type, COUNT(*) as no,COUNT(if(status=10,1,null)) as n10, COUNT(if(status=20,1,null)) as n20,COUNT(if(status=50,1,null)) as n50, COUNT(if(status=60,1,null)) as n60, COUNT(if(status=100,1,null)) as n100 FROM `imports_mail` WHERE  status not in (100) ".($isWms==1?" and is3pl=1 ":" and is3pl=0 ")." GROUP by type";
		$rs = Yii::app()->db->createCommand($sql)->queryAll();
		foreach ($rs as $index => $r) {
			$total += intval($r['no']);
			$provide[] = ['id' => $index + 1, 'rawType' => $r['type'], 'type' => $mailTypes[$r['type']], 'new' => $r['n10'], 'allocated' => $r['n20'], 'replied' => $r['n50'], 'close' => $r['n60']];
		}
		$filtersForm = new FiltersForm;
		if (isset($_GET['FiltersForm'])) {
			$filtersForm->filters = $_GET['FiltersForm'];
		}
		$filteredData = $filtersForm->filter($provide);
		$dataprovider = new CArrayDataProvider($filteredData);
		$dataprovider->pagination = ['pageSize' => 10];
		$sort = new CSort();
		$sort->attributes = [
			'type' => [
				'asc' => 'type ASC',
				'desc' => 'type DESC',
			],
		];
		$sort->defaultOrder = "type ASC";
		$dataprovider->sort = $sort;
		$this->render('total_list', [
			'model' => $model,
			'dataProvider' => [$dataprovider, $filtersForm],
			'total' => $total,
		]);
	}

	public function actionMyEmails()
	{
		$model = new ImportsMail('search');
		$isWms = !empty($_GET['isWms'])?1:0;
		if (!empty($_GET['ImportsMail'])) {
			$model->attributes = $_GET['ImportsMail'];
		}
		if (!empty($_GET['user_id'])) {
			$user_id = $_GET['user_id'];
		} else {
			$user_id = Yii::app()->user->id;
		}

		$mailTypes = ImportsMail::$mailTypes;
		$model->is3pl = null;
		$importscs_list_id = ImportsMail::$importscs_list_id;

		$mailTypes = ImportsMail::$mailTypes+ImportsMail::$wmsMailTypes;
		$importscs_list_id = ImportsMail::$importscs_list_id+ ImportsMail::$wmscs_list_id;


		$model->myUserId = $user_id;
		$total = 0;
		$provide = [];
		$result = [];
		foreach ($mailTypes as $type => $typeName) {
			$result['type'] = [];
		}
		$log = Log::model()->find('model = "User" AND lid = :lid AND type = 3', [':lid' => $user_id]);
		if(!empty($log))
		{
			$user_create = $log->time;
		}else
		{
			$user_create = '2000-01-01 00:00:00';
		}

		$sql = "SELECT COUNT(*) as number, mail_type FROM `mail_user` mu join `imports_mail` im on mu.mail_id = im.id WHERE CURDATE() <= im.`create_time` AND im.`create_time` >= '" . $user_create . "' AND user_id = " . $user_id . " GROUP BY mail_type";
		$todyOpen = Yii::app()->db->createCommand($sql)->queryAll();
		foreach ($todyOpen as $r) {
			$result[$r['mail_type']]['today_open'] = $r['number'];
		}
		$sql = "SELECT COUNT(*) as number,mail_type FROM `mail_user` WHERE (CURDATE()<=`close_time` or CURDATE()<=`park_time`) AND status=50 AND user_id=" . $user_id . " GROUP BY mail_type";
		$todayReply = Yii::app()->db->createCommand($sql)->queryAll();
		foreach ($todayReply as $r) {
			$result[$r['mail_type']]['today_reply'] = $r['number'];
		}
		$sql = "SELECT COUNT(*) as number,mail_type FROM `mail_user` WHERE CURDATE()<=`park_time` AND status=10 AND user_id=" . $user_id . " GROUP BY mail_type";
		$todayRead = Yii::app()->db->createCommand($sql)->queryAll();
		foreach ($todayRead as $r) {
			$result[$r['mail_type']]['today_park'] = $r['number'];
		}
		$sql = "SELECT COUNT(*) as number, mail_type FROM `mail_user` mu join `imports_mail` im on mu.mail_id = im.id WHERE (mu.status = 10 or ((im.flag&4)>0&&mu.close_time='0000-00-00 00:00:00')) AND im.`create_time` >= '" . $user_create . "' AND user_id = " . $user_id . " GROUP BY mail_type";
		$todayLeft = Yii::app()->db->createCommand($sql)->queryAll();
		foreach ($todayLeft as $r) {
			$result[$r['mail_type']]['today_left'] = $r['number'];
		}
		foreach ($result as $key => $value) {
			if (empty($value)) {
				unset($result[$key]);
			}
		}
		$index = 1;
		$total = 0;
		foreach ($result as $key => $r) {
			$type = @$mailTypes[$key];
			$todayOpen = intval(@$r['today_open']);
			$todayPark = intval(@$r['today_park']);
			$todayReply = intval(@$r['today_reply']);
			$todayLeft = intval(@$r['today_left']);
			$todayTotal = $todayPark + $todayReply;
			$total += $todayLeft;
			$provide[] = ["id" => $index++, 'rawType' => $key, 'type' => $type, 'today_open' => $todayOpen, 'today_park' => $todayPark, 'today_reply' => $todayReply, 'today_total' => $todayTotal, 'left' => $todayLeft];
		}
		$filtersForm = new FiltersForm;
		if (isset($_GET['FiltersForm'])) {
			$filtersForm->filters = $_GET['FiltersForm'];
		}
		$filteredData = $filtersForm->filter($provide);
		$dataprovider = new CArrayDataProvider($filteredData);
		$dataprovider->pagination = ['pageSize' => 10];
		$sort = new CSort();
		$sort->attributes = [
			'type' => [
				'asc' => 'type ASC',
				'desc' => 'type DESC',
			],
		];
		$sort->defaultOrder = "type ASC";
		$dataprovider->sort = $sort;
		$this->render('my_email_list', [
			'model' => $model,
			'dataProvider' => [$dataprovider, $filtersForm],
			'total' => $total,
			'result' => $result,
			'user_id' => $user_id,
			'isWms' => $isWms
		]);
	}

	public function actionRelatedEmail()
	{
		$id = $_GET["id"];
		$action = $_GET["action"];

		$model = new ImportsMail('search');
		$model->is3pl = null;
		$model->myUserId = User::currentUserID();

		$log = Log::model()->find('model = "User" AND lid = :lid AND type = 3', [':lid' => $model->myUserId]);
		if(!empty($log))
		{
			$user_create = $log->time;
		}else
		{
			$user_create = '2000-01-01 00:00:00';
		}


		$ec = new CDbCriteria;
		$ec->addCondition('t.create_time >= "' . $user_create . '"');
		$model->id = ">".$id;
		if($action=="previous")
		{
			$model->id = "<".$id;
			$_GET['sort'] = "t.id.desc";
		}else
		{
			$model->id = ">".$id;
			$_GET['sort'] = "t.id";
		}

		$email = $model->search(true, 1, $ec, false)->data;

		if(!empty($email))
		{
			$this->actionUpdate($email[0]->id);
		}




	}
