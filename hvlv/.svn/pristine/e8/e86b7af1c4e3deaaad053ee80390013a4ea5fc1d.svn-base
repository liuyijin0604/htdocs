<script>
    $(function(){
       var tab=$("<?=$_GET['tabid']?>");
       var panel=tab.data('panel');
       $("#consol_process_dp_view",panel).on('click',"table tbody td",function(){
         var podId=parseInt($(this).parent().children(':nth-child(1)').html());
         var data = {};
        data['pod_id'] = podId;
        $.ajax({
            type : 'GET',
            url : '<?php echo Yii::app()->createAbsoluteUrl("consolProcess/typeList",array('tabid'=>$_GET['tabid'])) ;?>',
            data: data,
            dataType: 'html',
            success:function(resp){
                $('#consol_process_dp_view_type').html(resp);
            },
        });
       })
   })
</script>
