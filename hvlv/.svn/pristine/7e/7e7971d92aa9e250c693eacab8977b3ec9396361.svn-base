	public function transferCheckInReportFormat($rowArrs)
	{
		$result = [];
		foreach ($rowArrs as $key1 => $rows)
		{
			foreach ($rows as $key2 => $r) {
				$org = Org::model()->findByPk($key2);
				$key1Str = $key1;
				$orgName = $org->name;
				$r1 = $r[0];
				$r2 = $r[1];
				$r3 = $r[2];
				$result[] = [$key1Str,$orgName,$r1,$r2,$r3];
			}
		}
		return $result;
	}

	public function getPutawaySortHeldList($wid,$refreshCache = false)
	{
		$key = "syd";
		switch ($wid) {
			case Org::TLA_DEPARTMENT_SYDNEY:
				$key = 'syd';
				break;
			case Org::TLA_DEPARTMENT_MELBOURNE:
				$key = 'mel';
				break;
			case Org::TLA_DEPARTMENT_BRISBANE:
				$key = 'bne';
				break;
			
		}
		$dash = new Dash();
		$sortHeldData1 = $dash->getWareHouseReminder(1,$refreshCache);
		$sortHeldData2 = $dash->getWareHouseReminder(2,$refreshCache);
		$result = [];
		$row2 = ['name'=>'Put in Pallet','Today'=>$sortHeldData2[0][$key.'Today'],'Left'=>$sortHeldData2[0][$key.'Left']];
		$result['sort_held'] = $row2;
		$row = ['name'=>'Put Away','Today'=>$sortHeldData1[0][$key.'Today'],'Left'=>$sortHeldData1[0][$key.'Left']];
		$result['putaway'] = $row;
		$left = ($row2['Left']-$row2['Today'])+($row['Left']-$row['Today']);
		$done = $sortHeldData1[0][$key.'All']+$sortHeldData2[0][$key.'All'];
		$totals = $left+$done;
		
		if(empty($totals))
		{
			$donePercent = "0%";
		}else
		{
			$donePercent = number_format($done*100/$totals,1,'.','')."%";
		}

		$row3 = ['total'=>$totals,'done'=>$done,'donePercent'=>$donePercent,'left'=>$left];
		$result['total'] = $row3;
		return $result;
	}

	public function getPutawaySortHeldDetail($wid,$type)
	{
		$result = [];
		$header = [];
		if($type=='putaway')
		{
			$arrLeft = ReportService::getSortHeldReminder(1);
		}else
		{
			$arrLeft = ReportService::getSortHeldReminder(2);
		}
		$header = ['Connote'=>'connote','Ref'=>'ref','AWB/Container'=>'awb/container','PKG'=>'pkg','Status'=>'status','Location'=>'location','Postcode'=>'postcode','Weight'=>'weight','Scan Date'=>['scan_date','$data["isScanTimeToday"]?"red": ""']];
		$percent = ["35%","35%","10%","20%"];
			$mhbns = "SORTHELD";
			$srtlDepot = Org::model()->findByPk($wid)->name;
			$model = new ImParcel('search');//mhbns
			$model->unsetAttributes();
			$model->ot_id = null;
			$model->status = '<90';
			$temp =[];
			if(!empty($arrLeft))
			{
				if($wid==Org::TLA_DEPARTMENT_SYDNEY){
					$temp = $arrLeft['SYD'];
				}elseif($wid==Org::TLA_DEPARTMENT_MELBOURNE){
					$temp = $arrLeft['MEL'];
				}elseif($wid==Org::TLA_DEPARTMENT_BRISBANE){
					$temp = $arrLeft['BNE'];
				}
				foreach($temp as $ref => $data){
					$mhbns .= ",".$ref;
				}
			}
			$model->mhbns = rtrim($mhbns, ',');
			$datas = $model->search(false)->data;
			foreach ($datas as $key => $d) {
				$result[] = ['id'=>$d->id,'connote'=>$d->hbn,'ref'=>$d->ref,'awb/container'=>(empty($d->consol)?"":($d->consol->service==ImcoConsol::AIRCONSOL?$d->consol->awb:@$d->consol->mdata['container_no'])),'pkg'=>$d->pkg,'status'=>$d->getStatus(),'location'=>$d->getRackName(false,true),'postcode'=>$d->postcode,'weight'=>$d->weight,'scan_date'=>$d->getScanTime(),'isScanTimeToday'=>$d->isScanTimeToday()];
			}
			return [$header,$result,$percent];
	}

	public function getGapsignSummeryList($wid,$isRefresh=false,$isFull = false)
	{
		$cacheKey = "getGapsignSummeryList".$wid;
		if(!$isRefresh)
		{
			$provide = Yii::app()->cache->get($cacheKey);
			if(!empty($provide))
			{
				return json_decode($provide,true);
			}
		}
		$result = [];
		foreach (GatepassCourier::$gatepass_courier as $courier => $title) {
			$model = new GatepassShipment('search');
			$model->status = -1;
			$model->status = 0;
				$warehouse = $wid;
				$awb = '';
				$search_context = '';
				$gatepassNo = '';
				$pickupDate = '';
				$model->warehouse = $warehouse;
				$model->awb = $awb;
				if (!empty($courier)) {
					if ($courier == 101) {
						$model->courier_ids = [101, 1426,Org::ORGID_COURIER_GV_AUPOST];
					}else if($courier == Org::ORGID_COURIER_TNT)
					{
						$model->courier_ids = [Org::ORGID_COURIER_TNT, Org::ORGID_COURIER_TNT_TOP];
					}else if($courier == Org::ORGID_COURIER_DFE)
					{
						$model->courier_ids = [Org::ORGID_COURIER_DFE, Org::ORGID_COURIER_DFE_TOP];
					}
					else {
						$model->courier_id = $courier;
					}
				}

				if (!empty($search_context)) {
					$ids = [0];
					foreach (preg_split("/[;,\n]/", $search_context) as $hbn) {
						if (empty(trim($hbn))) {
							continue;
						}
						$cStr= '';
						if($model->courier_id!='moving')
						{
							$cStr= '(cargo_process.id is null or cargo_process.status = '.CargoProcess::DELETED.') and ';
						}
						$shipment = ImParcel::model()->with(["cargo_process"])->find($cStr.'(hbn=:hbn OR ref=:hbn) AND cbwf&:cbwf=0', array(':hbn' => trim($hbn), ':cbwf' => ImParcel::CBWF_D2Z_CONSOL_NOT_FOR_SCAN));
						if (!empty($shipment)) {
							$ids[] = $shipment->id;
						}
						$model->ids = $ids;
					}

				}

				if ($model->courier_id == 'TP') {
					$gsModel = new GatepassShipment('search');
					$ids = [];
					$ids[] = 0;
					$gsModel->gatepassNo = $gatepassNo;
					$gsModel->pickupDate = $pickupDate;
					if(!empty($_GET['gatepassShipment']))$gsModel->setAttributes($_GET['gatepassShipment']);
					$cargoProcesses = $gsModel->getPreparedTruckOrPickupParcels($search_context,$warehouse);
					foreach ($cargoProcesses as $cargoProcess) {
						$ids[] = $cargoProcess->id;
					}
					$model->ids = [];
					$model->courier_id = 'TP';
					$model->caIds = $ids;
					if(!empty($_GET['gatepassShipment']))$model->setAttributes($_GET['gatepassShipment']);
				}


				if ($model->courier_id == 2797) {
					$ids = [0];
					$shipments = ImParcel::model()->with('gatepass_shipment')->findAll('(t.hbn like :hbn OR t.ref like :hbn) and t.ref LIKE "CPWPA%" and t.agent_id = 2797 and t.status >= 60 and t.status < 90 and t.created > "2020-01-01" and gatepass_shipment.status = 0',[":hbn"=>"%".trim($search_context)."%"]);
					$thisShipments = array_column($shipments, 'id');
					$ids = array_merge($thisShipments,$ids);
					$model->ids = $ids;
					$model->courier_id = null;
				}

				if ($model->courier_id == 2995) {
					$ids = [0];
					$shipments = ImParcel::model()->with('gatepass_shipment')->findAll('(t.hbn like :hbn OR t.ref like :hbn) and t.agent_id = 2995 and t.status >= 60 and t.status < 90 and t.created > "2020-01-01" and gatepass_shipment.status = 0',[":hbn"=>"%".trim($search_context)."%"]);
					$thisShipments = array_column($shipments, 'id');
					$ids = array_merge($thisShipments,$ids);
					$model->ids = $ids;
					$model->courier_id = null;
				}



				$gp = GatepassCourier::model()->findBySql('select * from gatepass_courier g join gatepass_shipment gs on g.id =gs.parent_id where json_value(g.meta,"$.ocourier_id")="'.$courier.'" and gs.warehouse = '.$wid.' order by g.id desc limit 1');
				$itemCount = 0;
				$totalWeight = null;
				$totalCBM = null;

				if($isFull)
				{
					$courierDatas = $model->search()->data;
					if(!empty($courierDatas))
					{
						$totalWeight = 0;
						$totalCBM = 0;
						$ids = array_column($courierDatas, "fid");
						$itemCount = count($courierDatas);
						$ppg = 1000;
						$pgs = ceil($itemCount / $ppg);
						for($i=0; $i<$pgs; $i++){
							$idArray = array_slice($ids, $i*$ppg, $ppg);
							$thisShipments = Shipment::model()->findAll('id in ('.join(',',$idArray).')');
							foreach ($thisShipments as $sk => $shipment)
							{
								$totalWeight+=$shipment->weight;
								$totalCBM+=$shipment->getTotalCBM();
							}
						}
					}

				}else
				{
					$itemCount = $model->search()->getTotalItemCount();
				}
				$result[] = ['Courier'=>$title,'PKG'=>$itemCount,'Weight'=>$totalWeight,'CBM'=>$totalCBM,'courier'=>$courier,'Last Sign'=>empty($gp)?" ":$gp->create_time];
		}

		Yii::app()->cache->set($cacheKey,json_encode($result),86400);

		return $result;

	}

	public function getPreparationSummeryList($wid,$params)
	{
		$result = [];
		if(!empty($params['gatepassNo']))
		{
			$params['pickupDate'] = "";
		}

		$allData = $this->getPreparationCargos($wid,$params);

		foreach ($allData as $key => $d) {
			$type = CargoProcess::$cargoTypeList[$d->type];
			if($d->type==CargoProcess::PICKUP_CARGO)
			{
				if(!empty($result[$d->type]))
				{
					$result[$d->type] = ['Type'=>$type,'Shipments'=>($result[$d->type]['Shipments']+1),'ids'=>$result[$d->type]['ids'].",".$d->id];
				}else
				{
					$result[$d->type] = ['Type'=>$type,'Shipments'=>1,'ids'=>$d->id];
				}

			}else
			{
				if(!empty($params['gatepassNo']))
				{
					$gatepasses = GatePass::model()->with('lines')->findAll(['condition'=>'t.status = 60 and lines.fid = :fid and json_value(lines.meta,"$.cargo_process_id")=:cargoId and ref in ("Pick Up","truck delivery")  and DATE_SUB(CURDATE(), INTERVAL 700 DAY) <= date(t.created) and t.id = :gpno','params'=>[":fid"=>$d->shipment_id,":cargoId"=>$d->id,":gpno"=>$params['gatepassNo']]]);
				}else
				{
					$gatepasses = GatePass::model()->with('lines')->findAll(['condition'=>'t.status = 60 and lines.fid = :fid and json_value(lines.meta,"$.cargo_process_id")=:cargoId and ref in ("Pick Up","truck delivery")  and DATE_SUB(CURDATE(), INTERVAL 700 DAY) <= date(t.created)','params'=>[":fid"=>$d->shipment_id,":cargoId"=>$d->id]]);
				}

				if(!empty($result[$d->type]))
				{
					$result[$d->type] = ['Type'=>$type,'Gatepasses'=>array_merge($result[$d->type]['Gatepasses'],array_column($gatepasses, 'id')),'ids'=>$result[$d->type]['ids'].",".$d->id];
				}else
				{
					$result[$d->type] = ['Type'=>$type,'Gatepasses'=>array_column($gatepasses, 'id'),'ids'=>$d->id];
				}
			}
		}

		foreach ($result as $key => $value) {
			if(isset($value['Gatepasses']))
			{
				$result[$key]['Gatepasses'] = array_unique($result[$key]['Gatepasses']);
				$result[$key]['Gatepasses'] = count($result[$key]['Gatepasses']);
			}
		}

		foreach (CargoProcess::$cargoTypeList as $k=>$v) {
			if(!isset($result[$k])&&$k<5)
			{
				if($k==CargoProcess::PICKUP_CARGO)
				{
					$result[$k] = ['Type'=>CargoProcess::$cargoTypeList[$k],'Shipments'=>0,'ids'=>"9999999999999"];
				}else
				{
					$result[$k] = ['Type'=>CargoProcess::$cargoTypeList[$k],'Gatepasses'=>0,'ids'=>"99999999999999"];
				}
			}
		}

		$pickup = $result[CargoProcess::PICKUP_CARGO];
		unset($result[CargoProcess::PICKUP_CARGO]);
		$result["".CargoProcess::PICKUP_CARGO] = $pickup;

		$resultPrepared = [];
		$allPreparedData = $this->getPreparationCargos($wid,$params,null,true);
		$done = count($allPreparedData);
		$left = count($allData);
		$total = $left +$done;
		if($total==0)
		{
			$donePercent = "0%";
		}else
		{
			$donePercent = number_format($done*100/$total,1,'.','')."%";
		}
		
		$result['total'] = ['total'=>$total,'done'=>$done,'donePercent'=>$donePercent,'left'=>$left];


		return $result;

	}
	private function getPreparationCargos($wid,$params,$type=null,$isPrepared= false)
	{
		$cargo = new CargoProcess('search');
		$cargo->unsetAttributes();
		// $model = new ImParcel('search');
		// $model->unsetAttributes();
		$ddpt_id = $wid;

		if(!empty($params['gatepassNo']))
		{
			$cargo->gatepassNo =$params['gatepassNo'];
		}

		if(!empty($params['pickupDate'])&&empty($params['gatepassNo']))
		{
			$cargo->pickupDate =$params['pickupDate'];
		}
		if(!empty($params['pickupFutureDate'])&&empty($params['gatepassNo']))
		{
			$cargo->pickupBookingTime =$params['pickupFutureDate'];
		}

		if(!empty($type))
		{
			$cargo->type = $type;
		}
		return $cargo->getNeedPrepareParcel(false, 1000,false,true,$wid,null,[],$isPrepared)->data;
	}

	public function getPreparationSummeryGatepassList($wid,$params,$type)
	{
		$result = [];
		$resultPrepared = [];
		$allData = $this->getPreparationCargos($wid,$params,$type);
		$totalNeedGatepass = 0;
		foreach ($allData as $key => $d) {
			if(!empty($params['gatepassNo']))
			{
				$gatepasses = GatePass::model()->with('lines')->findAll(['condition'=>'t.status = 60 and lines.fid = :fid and json_value(lines.meta,"$.cargo_process_id")=:cargoId and ref in ("Pick Up","truck delivery")  and DATE_SUB(CURDATE(), INTERVAL 700 DAY) <= date(t.created) and t.id = :gpno','params'=>[":fid"=>$d->shipment_id,":cargoId"=>$d->id,":gpno"=>$params['gatepassNo']]]);
			}else
			{
				$gatepasses = GatePass::model()->with('lines')->findAll(['condition'=>'t.status = 60 and lines.fid = :fid and json_value(lines.meta,"$.cargo_process_id")=:cargoId and ref in ("Pick Up","truck delivery")  and DATE_SUB(CURDATE(), INTERVAL 700 DAY) <= date(t.created)','params'=>[":fid"=>$d->shipment_id,":cargoId"=>$d->id]]);
			}

			foreach ($gatepasses as $key => $gp)
			{
				if(!empty($result[$gp->id]))
				{
					$result[$gp->id]['HBL'][] = $d->getRef();
					$result[$gp->id]['ids'] = $result[$gp->id]['ids'].",".$d->id;
				}else
				{				
					$result[$gp->id] = ['GPNo'=>$gp->id,'HBL'=>[$d->getRef()],'ids'=>$d->id];
					if($type!=CargoProcess::NORMAL_CARGO)
					{
						$de = AddressService::getShipmentCargoReceipt($d->shipment);
						$result[$gp->id]['Dest'] = $de;
					}
				}
			}
		}


		foreach ($result as $key => $value) {
			if(isset($value['HBL']))
			{
				$result[$key]['HBL'] = count($result[$key]['HBL']);
			}
		}


		return $result;
	}

	private function getGatepassShipments($wid,$params,$type)
	{
		$gatepass = GatePass::model()->findByPk($params['gatepassNo']);
		return $gatepass->lines;
	}

	public function getPreparationGatepassShipments($wid,$params,$type,$gatepassNo,$way = 0)
	{
		$result = [];
		$params['gatepassNo'] = $gatepassNo;
		if($way==0)
		{
			$allData = $this->getPreparationCargos($wid,$params,$type);
		}else
		{
			$allData = $this->getGatepassShipments($wid,$params,$type);
		}

		foreach ($allData as $key => $d) {

				$result[] = $this->getGatepassLineData($d);
		}

		$header = ["AWB"=>"awb","Container No."=>"containerNo","HBN"=>"hbn","REF"=>"ref","Location"=>'location',"ScanOut"=>"scanout","Status"=>"status","Packs"=>"packages","Weight"=>"weight","Driver"=>"driver"];
		return [$header,$result];

	}

	private function getGatepassLineData($d)
	{
		$r = $d->shipment;
		if(empty($r->consol)) return [];
		$gpscanOut = '';
		if (isset($r->mdata['gpscan_time'])) {
			if (is_array($r->mdata['gpscan_time'])) {
				$gpscanOut = implode('<br/>', $r->mdata['gpscan_time']);
			} else {
				$gpscanOut = $r->mdata['gpscan_time'];
			}
		}
		$containerNo = "";
		if($r->consol->service==Consol::SEACONSOL)
		{
			$containerNo = @$r->consol->mdata['container_no'];
		}
		$ref = empty($rc['caref'])?$r->ref:$rc['caref'];
		$packages = empty($rc['packages'])?$r->pkg:$rc['packages'];
		$weight = round($r->weight*$packages/$r->pkg,2);
		//hbn + Rack location
		$strHbn = $r->hbn;
		$listRack = $r->funcGetRackNameList();
		$strRackNameStr = "";
		foreach($listRack as $j=>$strRackName){
			$strRackNameStr = $strRackNameStr.'<br/>'.$strRackName;
		}

		if(!empty($r->cargo_process->mdata['tony_assign_driver'])){
			$assignDriver = $r->cargo_process->mdata['tony_assign_driver'];
		}else{
			$assignDriver = "";
		}
		$awb = (!empty($r->consol->awb)?$r->consol->awb:'');

		return ['id'=>$d->id,'awb'=>$awb,'containerNo'=>$containerNo,'hbn'=>$strHbn,'location'=>$strRackNameStr,'ref'=>$ref,'scanout'=>$gpscanOut,'status'=>$r->getStatus(),'packages'=>$packages,'weight'=>$weight,'driver'=>$assignDriver];
	}

	public function getHeldShipmentGatepassSummary($wid)
	{
		$result = [];
		$totalData = [];
		$yesterday  = HolidayHelper::getLastWeekday(date("Y-m-d"),"AUSYD");
		$gatepasses = GatePass::model()->with('lines')->findAll('t.status = 60 and ref not in ("Pick Up","truck delivery")  and t.created>=:time1 and t.created<=:time2 and dpt_id = :dptId',[':dptId'=>$wid,':time1'=>"2023-01-01 01:00:00",':time2'=>date("Y-m-d")." 17:00:00"]);
		$allTotalShipments = 0;
		$allTotalPkg = 0;
		$allTotalResortShipment = 0;
		$allTotalResort = 0;

		foreach ($gatepasses as $k1 => $gp)
		{
			$row = [$gp->id,$gp->id,0,0];
			$resort = 0;
			$resortShipment = 0;
			$total = 0;
			$totalShipments = 0;
			$totalPkg = 0;
			foreach ($gp->lines as $k2 => $line)
			{	
				$p = $line->shipment;
				$resorts = ShipmentScan::model()->findAll(['condition'=>'pid = :pid and (type = :type or type = :type2)','params'=>[':pid'=>$p->id,':type'=>ShipmentScan::RESORT,':type2'=>ShipmentScan::PALLET_TYPE],'group'=>'pid,pno']);
				$thisResort = count($resorts);
				if($thisResort>0)
				{
					$resortShipment+=1;
				}
				$resort += $thisResort;
				$totalShipments+=1;
				$totalPkg+=$p->pkg;
			}

			if($resortShipment==$totalShipments&&strtotime($gp->created)<strtotime($yesterday))
			{
				continue;
			}

			$row[2] = $totalShipments;
			$row[3] = $totalPkg;
			$row[4] = $resortShipment;
			$row[5] = $resort;
			$allTotalShipments+= $totalShipments;
			$allTotalPkg+= $totalPkg;
			$allTotalResortShipment+= $resortShipment;
			$allTotalResort+= $resort;
			$totalData[$gp->id] = $row;
		}
		if(empty($allTotalShipments))
		{
			$donePercent = "0%";
		}else
		{
			$donePercent = number_format($allTotalResortShipment*100/$allTotalShipments,'1','.','')."%";
		}
		$total=['gatepasses'=>count($totalData),'totalShipments'=>$allTotalShipments,'allTotalPkg'=>$allTotalPkg,'allTotalResortShipment'=>$allTotalResortShipment,'allTotalResort'=>$allTotalResort,'donePercent'=>$donePercent];
		$result = [$total,$totalData];
		return $result;

	}

	public function getPreparationOldGatepassWithoutResorting($wid,$date="")
	{
		$cache = $this->getCacheData("OldGatepassWithoutResorting:".$date."|".$wid);
		if(!empty($cache))
		{
			return $cache;
		}

		$result = [];
		$totalData = [];
		$dateStr = "";

		if(!empty($date))
		{
			$dateStr = ' and created>"'.$date.'"';
		}else
		{
			$dateStr = ' and created>"2022-01-01"';
		}

		if(empty($wid))
		{
			$gatepasses = GatePass::model()->with('lines')->findAll('t.status = 60 and ref not in ("Pick Up","truck delivery") '.$dateStr);
		}else
		{
			$gatepasses = GatePass::model()->with('lines')->findAll('t.status = 60 and ref not in ("Pick Up","truck delivery") and dpt_id = :dptId '.$dateStr,[':dptId'=>$wid]);
		}
		$index = 1;
		foreach ($gatepasses as $k1 => $gp)
		{
			$row = [];
			$isResort = false;
			$shipResort = [];
			foreach ($gp->lines as $k2 => $line)
			{	
				$p = $line->shipment;
				if(empty($p)) continue;
				$resorts = ShipmentScan::model()->findAll(['condition'=>'pid = :pid and (type = :type or type = :type2)','params'=>[':pid'=>$p->id,':type'=>ShipmentScan::RESORT,':type2'=>ShipmentScan::PALLET_TYPE],'group'=>'pid,pno']);
				$thisResort = count($resorts);
				if($thisResort==0)
				{
					$row[] = $this->getGatepassLineData($line);
				}
				$shipResort[$line->id] = (empty($thisResort)?"×":"√");
			}

			foreach ($row as $key => $r) {
				if(empty($r)) continue;
				$r['isResort'] = isset($shipResort[$r['id']])?$shipResort[$r['id']]:"";
				$r['id'] = $index;
				$r['no'] = $gp->id;
				$r['gatepass_time'] = $gp->created;
				$result[] = $r;
				$index+=1;
			}
		}

		$this->setCacheData("OldGatepassWithoutResorting:".$date."|".$wid,$result,1800);
		

		return $result;

	}

	public function prepareDoneShipment($shipmentId)
	{
		$status = false;
		$p = ImParcel::model()->findByPk($shipmentId);
		if(!empty($p->cargo_process))
		{
			$this->prepareDoneOne($p->cargo_process->id);
			$status = true;
		}
		return $status;
	}
	
	public function prepareDoneOne($id)
	{
		$prepareLog = ShipmentWhPrepare::model()->find('cargo_process_id = :id',[':id'=>$id]);
		if(!empty($prepareLog)&&$prepareLog->status==ShipmentWhPrepare::PREPARED)
		{
			return $prepareLog;
		}

		$cargoProcess = CargoProcess::model()->findByPk($id);
		$cjob = null;
		if(!empty($cargoProcess->job_relation))
		{
			$cjob = $cargoProcess->job_relation->job;
			if(!empty($cjob)){
				if($cjob->driver_id==4072){
					$sendEmail = false;
				}else{
					$sendEmail = true;
				}
				
			}
		}
		$p = $cargoProcess->shipment;
		if(empty($prepareLog))
		{
			$prepareLog = new ShipmentWhPrepare();
			$prepareLog->shipment_id = $p->id;
			$prepareLog->cargo_process_id = $id;
			$prepareLog->status = ShipmentWhPrepare::PREPARED;
			$prepareLog->operate_time = date('Y-m-d H:i:s');
			$prepareLog->uid = User::currentUserID();
			$prepareLog->save();
		}else
		{
			$prepareLog->status = ShipmentWhPrepare::PREPARED;
			$prepareLog->operate_time = date('Y-m-d H:i:s');
			$prepareLog->uid = User::currentUserID();
			$prepareLog->save();
		}

		if($cargoProcess->type==CargoProcess::NORMAL_CARGO)
		{
			if(!empty($cargoProcess->job->created)){
				$strDeliveryDate = date('Y-m-d',strtotime($cargoProcess->job->created));
			}

			//$p->addTrackingLimited(Tracking::TYPE_SORTED, "Warehouse preparation done. Delivery date is ".$strDeliveryDate, empty($p->odepot) ? '' : $p->odepot->suburb,  $prepareLog->operate_time);
			//if($sendEmail){
				//EmailService::sendWarehouseCargoSmsEmail($cargoProcess);
			//}
		}

		if(!empty($cargoProcess->mdata['caref']))
		{	
			$ref = $cargoProcess->mdata['caref'];
			$gatePass = GatepassShipment::model()->findAll(" connote_no = :caref ",[":caref"=>$cargoProcess->mdata['caref']]);
			$mdata = ['cargo_process_id'=>$id,'isSub'=>true];
		}else
		{
			$gatePass = GatepassShipment::model()->findAll(" fid =:fid ",[":fid"=>$p->id]);
			$ref = false;
			$mdata = [];
		}

		if(empty($gatePass))//sometime because of held status, the truck delivery or pickup parcel will have not gatepassShipment record, so need to insert it.
		{
			$p = $cargoProcess->shipment;
			$courier_id = null;
			if (empty($courier_id)) 
			{
				$courier_id=$p->getCourierId();
			}
			$action = "ScanAllByPrepared";
			GatepassShipment::gatepassScan($p, $courier_id, 1, $p->consol->dpt_id,$action,$ref,$mdata);
		}

		// subshipment 
		$this->funcSubshipmentSmsEmail($p);

		return $prepareLog;
	}

	public function checkInShipmentToBeInspection($dptId,$day = null)
	{
		$fromTime = date("Y-m-d 00:00:00");
		$toTime = date("Y-m-d 23:00:00");
		if(!empty($day))
		{
			$fromTime = $day." 00:00:00";
			$toTime =  $day." 23:00:00";
		}
		$shipmentScans = ShipmentScan::model()->with('shipment','shipment.consol')->findAll(['condition'=>'t.type = :type and t.scan_time > :fromTime and t.scan_time <:toTime and t.warehouse=:dptId',"params"=>[":type"=>ShipmentScan::CHECKIN,":fromTime"=>$fromTime,":toTime"=>$toTime,":dptId"=>$dptId],"order"=>"consol.id"]);
		$shipmentConsol = [];
		foreach($shipmentScans as $key => $shipmentScan)
		{
			$consolId= $shipmentScan->shipment->consol_id;
			if(!isset($shipmentConsol[$consolId]))
			{
				$shipmentConsol[$consolId]  = [];
			}

			if(empty($shipmentScan->shipment->mdata['org_rate_id']))
			{
				continue;
			}else
			{
				$orgRate = OrgRate::model()->findByPk($shipmentScan->shipment->mdata['org_rate_id']);
				if(empty($orgRate))
				{
					continue;
				}else
				{
					$courierId = $orgRate->org_id;
					if(!in_array($courierId, [Org::ORGID_COURIER_AUPOST,Org::ORGID_COURIER_FASTWAY,Org::ORGID_COURIER_UBI_TOLL,Org::ORGID_COURIER_TOLL_IPEC,Org::ORGID_COURIER_TLA,Org::ORGID_COURIER_PICKUP,Org::ORGID_COURIER_TNT,Org::ORGID_COURIER_TNT_TOP,Org::ORGID_COURIER_BORDER]))
					{
						continue;
					}

					if($courierId == Org::ORGID_COURIER_TLA&&!$shipmentScan->shipment->checkIsCargoProcessWithRef())
					{
						continue;
					}

					if($courierId == Org::ORGID_COURIER_PICKUP&&$shipmentScan->shipment->mdata['org_rate_id']==10498)
					{
						continue;
					}



					if($courierId==Org::ORGID_COURIER_UBI_TOLL||$courierId==Org::ORGID_COURIER_EIZ||$courierId==3460||$courierId==3189||$courierId==4105)
					{
						$courierId = Org::ORGID_COURIER_TOLL_IPEC;
					}

					if($courierId == Org::ORGID_COURIER_PICKUP)
					{
						$courierId = Org::ORGID_COURIER_TLA;
					}
				}
			}


			if(empty($shipmentConsol[$consolId][$courierId]))
			{
				$shipmentConsol[$consolId][$courierId] = [];
			}

			if(!isset($shipmentConsol[$consolId][$courierId][$shipmentScan->pid]))
			{
				$shipmentConsol[$consolId][$courierId][$shipmentScan->pid] = [];
			}

			$shipmentConsol[$consolId][$courierId][$shipmentScan->pid][$shipmentScan->pid."-".$shipmentScan->pno] = $shipmentScan->scan_time;
		}

		$shipmentScans = GatepassShipment::model()->with('shipment','shipment.consol')->findAll(['condition'=>'t.meta = "{\"description\":\"ScanAllByHand\"}" and t.scan_time > :fromTime and t.scan_time <:toTime and t.warehouse=:dptId',"params"=>[":fromTime"=>$fromTime,":toTime"=>$toTime,":dptId"=>$dptId],"order"=>"consol.id"]);
		foreach($shipmentScans as $key => $shipmentScan)
		{
			if($shipmentScan->shipment->consol->isWDT()||$shipmentScan->shipment->consol->service!=Consol::SEACONSOL)
			{
				continue;
			}

			$consolId= $shipmentScan->shipment->consol_id;
			if(!isset($shipmentConsol[$consolId]))
			{
				$shipmentConsol[$consolId]  = [];
			}

			if(empty($shipmentScan->shipment->mdata['org_rate_id']))
			{
				continue;
			}else
			{
				$orgRate = OrgRate::model()->findByPk($shipmentScan->shipment->mdata['org_rate_id']);
				if(empty($orgRate))
				{
					continue;
				}else
				{
					$courierId = $orgRate->org_id;
					if(!in_array($courierId, [Org::ORGID_COURIER_AUPOST,Org::ORGID_COURIER_FASTWAY,Org::ORGID_COURIER_UBI_TOLL,Org::ORGID_COURIER_TOLL_IPEC,Org::ORGID_COURIER_TLA,Org::ORGID_COURIER_PICKUP,Org::ORGID_COURIER_TNT,Org::ORGID_COURIER_TNT_TOP,Org::ORGID_COURIER_BORDER]))
					{
						continue;
					}

					if($courierId == Org::ORGID_COURIER_TLA&&!$shipmentScan->shipment->checkIsCargoProcessWithRef())
					{
						continue;
					}

					if($courierId == Org::ORGID_COURIER_PICKUP&&$shipmentScan->shipment->mdata['org_rate_id']==10498)
					{
						continue;
					}



					if($courierId==Org::ORGID_COURIER_UBI_TOLL||$courierId==Org::ORGID_COURIER_EIZ||$courierId==3460||$courierId==3189||$courierId==4105)
					{
						$courierId = Org::ORGID_COURIER_TOLL_IPEC;
					}

					if($courierId == Org::ORGID_COURIER_PICKUP)
					{
						$courierId = Org::ORGID_COURIER_TLA;
					}
				}
			}


			if(empty($shipmentConsol[$consolId][$courierId]))
			{
				$shipmentConsol[$consolId][$courierId] = [];
			}

			if(!isset($shipmentConsol[$consolId][$courierId][$shipmentScan->fid]))
			{
				$shipmentConsol[$consolId][$courierId][$shipmentScan->fid] = [];
			}

			$shipmentConsol[$consolId][$courierId][$shipmentScan->fid][$shipmentScan->fid."-".$shipmentScan->sno] = $shipmentScan->scan_time;
		}



		$trans = Yii::app()->db->beginTransaction();
		try{
			foreach($shipmentConsol as $consolId => $couriers)
			{
				foreach ($couriers as $courierId => $shipments)
				{
					$numbers = count($shipments);
					if($numbers==0) continue;
					$percentageArr = SystemSetting::getCourierInspectionPercentage($courierId);
					$percentage = $percentageArr[0];
					$isCombine  = $percentageArr[1];
					$inspections = ceil($numbers*$percentage);
					shuffle($shipments);
					$i= 0;
					$shipmentWhInspection =  null;
					if($isCombine)
					{
						$shipmentWhInspection = new ShipmentWhInspection();
						$shipmentWhInspection->courier_id = $courierId;
						$shipmentWhInspection->process_status = ShipmentWhInspection::NEW_STATUS;
						$shipmentWhInspection->dpt_id = $dptId;
						$shipmentWhInspection->isCombine = $isCombine;
						$shipmentWhInspection->created = date('Y-m-d H:i:s');
						$shipmentWhInspection->consol_id = $consolId;
						$shipmentWhInspection->save();
					}

					foreach ($shipments as $shipmentId => $scanTime)
					{
						if(!$isCombine)
						{
							$shipmentWhInspection = new ShipmentWhInspection();
							$shipmentWhInspection->courier_id = $courierId;
							$shipmentWhInspection->process_status = ShipmentWhInspection::NEW_STATUS;
							$shipmentWhInspection->dpt_id = $dptId;
							$shipmentWhInspection->isCombine = $isCombine;
							$shipmentWhInspection->created = date('Y-m-d H:i:s');
							$shipmentWhInspection->consol_id = $consolId;
							$shipmentWhInspection->save();
						}
						
						$thisShipmentId = 0;
						foreach ($scanTime as $s => $v) {
							$thisShipmentId = explode('-', $s)[0];
							break;
						}
						$check = ShipmentWhInspectionRelations::model()->find('pid=:pid and created>:fromTime and created<:toTime',[":pid"=>$thisShipmentId,":fromTime"=>$fromTime,":toTime"=>$toTime]);
						if(!empty($check))
						{
							continue;
						}

						$shipmentWhInspectionRelations = new ShipmentWhInspectionRelations();
						$shipmentWhInspectionRelations->pid = $thisShipmentId;
						$shipmentWhInspectionRelations->process_status = ShipmentWhInspection::NEW_STATUS;
						$shipmentWhInspectionRelations->scan_time = json_encode($scanTime);
						$shipmentWhInspectionRelations->created = $shipmentWhInspection->created;
						$shipmentWhInspectionRelations->inspection_id = $shipmentWhInspection->id;
						$shipmentWhInspectionRelations->save();
						$inspections= $inspections-1;
						if($inspections==0) break;
					}

					if($inspections!=0)
					{
						$shipmentWhInspection->delete();
					}
				}
			}
			$trans->commit();
		} catch (Exception $ex) {
			$trans->rollback();
			throw $ex;
		}


