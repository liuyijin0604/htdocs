	public static function sendSms($phone,$smsMsg,$smsNoticeTag,$smsDateTag,$smsNoticeLog){
		$phone = Addr::auTelValid($phone);
		$check = false;
		if(!empty($phone))
		{
			if(preg_match('/^02/i', $phone)||strlen($phone)<9)
			{
				return "phone number is wrong";
			}else
			{
				$end = strlen($phone);
				$phone = "0".substr($phone,$end-9,$end);
			}

			// $msg = "Dear Valued Customer, We’d like to inform you we are about to arrange the delivery of your goods($hbn). Before that，we will need you to log in $link website，confirm the relevant information. Please reply to us asap. After sending this message, there will be 3 days of free storage time. There will be an extra storage fee If this time is exceeded.";
			$msg = $smsMsg;
			$sms = new Sms();
			$sms->no = $phone;
			$sms->msg = $msg;
			$sms->send();
			if($sms->status!=9) {
				$check = true;
			}else
			{
				if($check)
				{
					return "send SMS failed";
				}else
				{
					return "send email and SMS failed";
				}
			}
		}
		if($check)
		{
		}else
		{
			return "empty phone number consignee";
		}
		return $check;
	}

	public static function sendCargoSmsEmail($cpModel,$emailTemplate,$emailNoticeTag,$emailNoticeLog,$smsMsg,$smsNoticeTag,$smsNoticeLog,$smsDateTag,$body = "")
	{
		$phone = $cpModel->shipment->cnee->tel;
		$phone = Addr::auTelValid($phone);
		$driverName = "";
		$driverPhone = "";
		if(!empty($cpModel->job_relation->job->driver))
		{
			$driverName = $cpModel->job_relation->job->driver->name;
			$driverPhone = $cpModel->job_relation->job->driver->phone;
		}else if(!empty($cpModel->driver))
		{
			$driverName = $cpModel->driver->name;
			$driverPhone = $cpModel->driver->phone;
		}
		$email = $cpModel->shipment->cnee->email;
		$hbn =  $cpModel->shipment->hbn;
		$check = false;
		$link = "https://book.toplogistics.com.au/cargoConfirm?caref=".$cpModel->getRef();
		if(!empty($email))
		{
			$emailLog = new Emailog();
			$emailLog->to_id = 0;
			$emailLog->fid = $cpModel->shipment_id;
			$emailLog->type= $emailTemplate;
			$emailLog->dt = date('Y-m-d H:i:s');
			$emailLog->status = 10;
			$emailLog->prepTemplate();
			$emailLog->tpl->assignSubject('HBN',  $cpModel->shipment->hbn);
			// $emailLog->tpl->assignThese([
			// 	'FILENAME'=>$filename,
			// ]);
			$emailLog->subject = $emailLog->tpl->subject;
			$emailLog->tpl->assignThese([
				'HBN'=>$cpModel->shipment->hbn,
				'LINK'=>$link,
				'DRIVERNAME'=>$driverName,
				'PHONE'=>$driverPhone,
				'NAME'=>$cpModel->shipment->cnee->name
			]);
			if(empty($body))
			{
				$emailLog->body = $emailLog->tpl->getContent();
			}else
			{
				$emailLog->body = $body;
			}
			$emailLog->mdata['to']=$email;
			$emailLog->mdata['fromName']='TLA Cartage';
			$emailLog->mdata['from']='cartage@toplogistics.com.au';
			$emailLog->mdata['cc']=Org::IM_EMAIL;
			$o=$emailLog->sendEmail();
			if($o['status'])
			{
				$cpModel->mdata[$emailNoticeTag] =1;
				$cpModel->mdata[$smsDateTag] = date('Y-m-d H:i:s');
				$cpModel->log($emailNoticeLog);
				$check = true;
			}
		}

		if(!empty($phone))
		{
			if(preg_match('/^02/i', $phone)||strlen($phone)<9)
			{
				if($check)
				{
					return "send email success but phone number is wrong";
				}else
				{
					return "send email failed and phone number is wrong";
				}
			}else
			{
				$end = strlen($phone);
				$phone = "0".substr($phone,$end-9,$end);
			}

			// $msg = "Dear Valued Customer, We’d like to inform you we are about to arrange the delivery of your goods($hbn). Before that，we will need you to log in $link website，confirm the relevant information. Please reply to us asap. After sending this message, there will be 3 days of free storage time. There will be an extra storage fee If this time is exceeded.";
			$msg = $smsMsg;
			$sms = new Sms();
			$sms->no = $phone;
			$sms->msg = $msg;
			$sms->send();
			if($sms->status!=9) {
				$cpModel->mdata[$smsNoticeTag] =1;
				$cpModel->mdata[$smsDateTag] = date('Y-m-d H:i:s');
				$check = true;
				$cpModel->log($smsNoticeLog);
			}else
			{
				if($check)
				{
					return "send SMS failed";
				}else
				{
					return "send email and SMS failed";
				}
			}
		}
		if($check)
		{
			$cpModel->save();
		}else
		{
			return "empty email and phone number consignee";
		}

		return $check;

	}


