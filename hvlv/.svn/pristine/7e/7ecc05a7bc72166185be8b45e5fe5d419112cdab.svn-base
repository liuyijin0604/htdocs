	public function funcSendEmail($strFrom,$strFromname,$strToEmail,$strCc,$strBcc,$strSubject,$strBody,$numType)
	{
		$emailLog = new Emailog();
		$emailLog->to_id = 0;
		$emailLog->fid = 0;
		$emailLog->type= $numType;
		$emailLog->dt = date('Y-m-d H:i:s');
		$emailLog->status = 10;
		$emailLog->mdata['from']=$strFrom;
		$emailLog->mdata['fromName']=$strFromname;
		$emailLog->mdata['to']=$strToEmail;
		$emailLog->mdata['cc']=$strCc;
		$emailLog->mdata['bcc']=$strBcc;
		$emailLog->subject = $strSubject;
		$emailLog->body =$strBody;

		$o=$emailLog->sendEmail();

		if($o['status'])
		{
			return true;
		}else
		{
			return false;
		}
	}

	public function funcSendEmailTpl($orgId,$strFrom,$strFromname,$strToEmail,$strCc,$strBcc,$strSubject,$strBody,$emailType,$fullFilename="",$filename="")
	{
		$emailLog = new Emailog();
		$emailLog->to_id = $orgId;
		$emailLog->fid = 0;
		$emailLog->type= $emailType;
		$emailLog->dt = date('Y-m-d H:i:s');
		$emailLog->status = 10;
        $emailLog->prepTemplate();
        $emailLog->subject = !empty($strSubject)?$strSubject:$emailLog->tpl->subject;
        $emailLog->body = !empty($strBody)?$strBody:$emailLog->tpl->getContent();
        $emailLog->mdata['from']=$strFrom;
		$emailLog->mdata['fromName']=$strFromname;
		$ccList = explode(';', $strCc);
		if(!empty($emailLog->to_id))
		{
			$org = Org::model()->findByPk($emailLog->to_id);
			$thisTo = "";
			if (!empty($org->extra['client_billing_email'])) {
				foreach (preg_split('/[,;]+/i', trim($org->extra['client_billing_email'])) as $to) {
					if(empty($thisTo))
					{
						$thisTo = $to;
					}else
					{
						$ccList[] = $to;
					}
				}
			}else
			{
				return false;
			}
			$emailLog->mdata['to']=$thisTo;
			$emailLog->mdata['cc']=join(';',$ccList);

		}else
		{
			$emailLog->mdata['to']=$strToEmail;
			$emailLog->mdata['cc']=$strCc;
			$emailLog->mdata['bcc']=$strBcc;
		}

		if(empty($fullFilename))
		{
			$o=$emailLog->sendEmail();
		}else
		{
			$o=$emailLog->sendEmail([[$fullFilename,$filename]]);
		}
		if($o['status'])
		{
			return true;
		}else
		{
			return false;
		}
	}

