	public function sendCustomerServiceTrackingEmail($shipment, $courier, $ref, $cc="")
	{
		$emailLog = new Emailog();
		$emailLog->type = Emailog::CUSTOMER_SERVICE_TRACKING_ENQUIRY;
		$emailLog->fid = $shipment->id;
		$emailLog->dt = date('Y-m-d H:i:s');
		$emailLog->to_id = $courier->id;
		$emailLog->status = 10;
		$emailLog->prepTemplate();
		$emailLog->tpl->assignThese([
			'SHIPMENT_NO'=>$ref,
		]);
		$emailLog->subject = $emailLog->tpl->subject;
		$emailLog->body = $emailLog->tpl->getContent();
		if (!empty($courier->extra['outturn_email'])) {
			$emailLog->mdata['to']=$courier->extra['outturn_email'];
		} else {
			$emailLog->mdata['to']=$courier->email;
		}
		$emailLog->mdata['from']='imports@toplogistics.com.au';
		$emailLog->mdata['fromName']='TLA Imports';
		$emailLog->mdata['cc']=$cc;
		$emailLog->sendEmail(); 
	}

	public function sendPireFileToAgent($agentId, $file)
	{
		$agent = Org::model()->findByPk($agentId);
		$emailLog = new Emailog();
		$emailLog->type = Emailog::PIER_FILE;
		$emailLog->fid = $file->id;
		$emailLog->dt = date('Y-m-d H:i:s');
		$emailLog->to_id = $agent->id;
		$emailLog->status = 10;
		$emailLog->prepTemplate();
		$emailLog->tpl->assignSubject('FILENAME',  $file->name);
		$emailLog->tpl->assignThese([
			'ORG_NAME'=>$agent->name,
		]);
		$emailLog->body = $emailLog->tpl->getContent();
		$emailLog->subject = $emailLog->tpl->subject;
		if (!empty($agent->extra['client_billing_email'])) {
			$emailLog->mdata['to']=$agent->extra['client_billing_email'];
		} else {
			$emailLog->mdata['to']=$agent->email;
		}
		$emailLog->mdata['from']='imports@toplogistics.com.au';
		$emailLog->mdata['fromName']='TLA Imports';
		$emailLog->mdata['cc']="imports@toplogistics.com.au";
		$emailLog->attachments = [$file];
		$emailLog->sendEmail(); 
	}

	public function createEmail($model,$files= [])
	{
		$model->mdata['fromName'] = "TLA ".ucfirst(explode("@", $model->mdata["from"])[0]);
		$model->save();
		if(!empty($files))
		{
			$this->saveFiles($files,'Emailog',$model->id,FileRepo::ATTACHMENT);
			$fileRepos = FileRepo::model()->findAll('fid = :fid and type =:type',[":fid"=>$model->id,":type"=>FileRepo::ATTACHMENT]);
			$model->attachments =$fileRepos;
		}
		$result = $model->sendEmail();
		if(!$result['status'])
		{
			$model->addError($result['msg']);
		}
		return $model;
	}


	public function sendImportsMailFeedbackEmail($task)
	{
		$baseUrl = 'https://ims.toplogistics.com.au/customerService/taskFeedback';
		$taskId = $task->id;
		$attributes = ['ticket' => $task->ticket];
		$shipmentQuestionSubmit = ShipmentQuestionSubmit::model()->findByAttributes($attributes);
		/* Filter out internal email address */ 
		$regExp = '/@toplogistics.com.au/i';
		if (preg_match($regExp, $task->from_email)) {
			$toEmail = $task->to_email;
			$toName = $task->to_name;
		} else {
			$toEmail = $task->from_email;
			$toName = $task->from_name;
		}
		/* Read c_note from shipment_question_submit table */
		if (!empty($shipmentQuestionSubmit)) {
			$taskNote = $shipmentQuestionSubmit->c_note;
		} else {
			$taskNote = '';
		}
		/* Only keep first 100 characters of c_note */
		if (strlen($taskNote) > 100) {
			$taskNote = substr($taskNote, 0, 97) . '...';
		}


		$emailLog = new Emailog();
		$emailLog->type = Emailog::TASK_FEEDBACK_EMAIL;
		$emailLog->dt = date('Y-m-d H:i:s');
		$emailLog->status = 10;
		$emailLog->prepTemplate();
		$emailLog->tpl->assignSubject('subject', $task->subject);
		$emailLog->tpl->assignThese([
				'subject' => $task->subject,
				'toName' => $toName,
				'c_note' => $taskNote,
				'baseURL' => $baseUrl,
				'id' => $taskId
				]);
		$emailLog->subject = $emailLog->tpl->subject;
		$emailLog->body = $emailLog->tpl->getContent();
		$emailLog->mdata['to'] = $toEmail;
		$emailLog->mdata['fromName'] = 'TLA Customer Service';
		$emailLog->mdata['from'] = 'donotreply@toplogistics.com.au';
		$emailLog->mdata['cc'] = '';
		$emailLog->sendEmail();
	}

	public function sendPriceEnquiryEmail($pe, $dim)
	{
		$emailLog = new Emailog();
		$emailLog->type = Emailog::PRICE_ENQUIRY_EMAIL;
		$emailLog->dt = date('Y-m-d H:i:s');
		$emailLog->status = 10;
		$emailLog->prepTemplate();
		$emailLog->tpl->assignSubject('peNumber', $pe->code);
		if ($pe->mdata['base_TLD'] == 0) {
			$emailLog->tpl->assignThese([
				'peNumber' => $pe->code, 
				'name' => $pe->name,
				'totalWeight' => $pe->weight,
				'totalDimension' => $dim,
				'totalQuantity' => $pe->quantity,
				'tldBase' => 'Out of service area',
				'tldOversize' => 'Out of service area',
				'tldSubtotal' => 'Out of service area',
				'tldUnloading' => 'Out of service area',
				'tldTotal' => 'Out of service area',
				'tollBase' => '$'.$pe->mdata['base_Toll'],
				'tollOversize' => '$'.$pe->mdata['oversize_Toll'],
				'tollSubtotal' => '$'.$pe->mdata['base_Toll']+$pe->mdata['oversize_Toll'],
				'tollUnloading' => '$0.00',
				'tollTotal' => '$'.$pe->mdata['base_Toll']+$pe->mdata['oversize_Toll']
			]);
		} else {
			$emailLog->tpl->assignThese([
				'peNumber' => $pe->code, 
				'name' => $pe->name,
				'totalWeight' => $pe->weight,
				'totalDimension' => $dim,
				'totalQuantity' => $pe->quantity,
				'tldBase' => '$'.$pe->mdata['base_TLD'],
				'tldOversize' => '$'.$pe->mdata['oversize_TLD'],
				'tldSubtotal' => '$'.$pe->mdata['base_TLD']+$pe->mdata['oversize_TLD'],
				'tldUnloading' => '$'.$pe->mdata['tailgate_TLD'],
				'tldTotal' => '$'.$pe->mdata['base_TLD']+$pe->mdata['oversize_TLD']+$pe->mdata['tailgate_TLD'],
				'tollBase' => '$'.$pe->mdata['base_Toll'],
				'tollOversize' => '$'.$pe->mdata['oversize_Toll'],
				'tollSubtotal' => '$'.$pe->mdata['base_Toll']+$pe->mdata['oversize_Toll'],
				'tollUnloading' => '$0.00',
				'tollTotal' => '$'.$pe->mdata['base_Toll']+$pe->mdata['oversize_Toll']
			]);
		}
		
		$emailLog->subject = $emailLog->tpl->subject;
		$emailLog->body = $emailLog->tpl->getContent();
		$emailLog->mdata['to'] = $pe->email;
		$emailLog->mdata['fromName'] = 'TLA Customer Service';
		$emailLog->mdata['from'] = 'sales@toplogistics.com.au';
		$emailLog->mdata['cc'] = '';
		$emailLog->sendEmail();
	}

	public function sendBookingConfirmationEmail($booking, $pallets,$skipInvoice=false)
	{
		$email = new Emailog();
		$email->type = Emailog::BOOKING_CONFIRMATION;
		$email->dt = date('Y-m-d H:i:s');
		$email->status = 10;
		$email->prepTemplate();
		$email->tpl->assignSubject('pbn', $booking->booking_number);

		// Set collection address
		$tlaAddress = '';
		switch (substr($booking->booking_number, 0, 1)) {
			case "S":
			case "s":
				$tlaAddress = '1/233 Milperra Rd, Bankstown Aerodrome NSW';
				break;
			case "M":
			case "m":
				$tlaAddress = '3B/8 Judge St, Sunshine VIC';
				break;
			case "B":
			case "b":
				$tlaAddress = '6/55 Musgrave Rd, Coopers Plains QLD';
				break;
		}

		if($booking->mdata['pallet_requirement'] == "chep") {
			$plainPallet = "No";
		} else {
			$plainPallet = "Yes";
		}
		if ($booking->mdata['shrink_wrap'] == 'wrap') {
			$wrap = "Yes";
		} else {
			$wrap = "No";
		}

		// Generate Confirmation PDF
		$confirmationData = [];
		$confirmationData['booking_no'] = $booking->booking_number;
		$confirmationData['time'] = date('d-m-Y H:i', strtotime($booking->booking_time));
		$confirmationData['rego'] = $booking->rego;
		$confirmationData['driver'] = $booking->driver_name;
		$confirmationData['company'] = $booking->company_name;
		$confirmationData['palletCount'] = $pallets;
		$confirmationData['plain_pallet'] = $plainPallet;
		$confirmationData['wrap'] = $wrap;
		
		$confirmation_file_dir = Yii::app()->basePath . DIRECTORY_SEPARATOR . "runtime" . DIRECTORY_SEPARATOR . "BookingConfirmation" . DIRECTORY_SEPARATOR;
		if (!is_dir($confirmation_file_dir)) {
			mkdir($confirmation_file_dir);
		}
		$confirmation_file = $confirmation_file_dir . date('Y-m-d') . '-'.$booking->booking_number.'.pdf';
		oPDF::renderPDF('booking_confirmation', ['confirmationData'=>$confirmationData], 2, $confirmation_file);
		$email->tpl->assignThese([
				'pbn' => $booking->booking_number,
				'house_bl' => $booking->mdata['house_bl'],
				'address' => $tlaAddress,
				'booking_time' => date('d-m-Y H:i', strtotime($booking->booking_time)),
				'rego' => $booking->rego,
				'name' => $booking->driver_name,
				'company_name' => $booking->company_name,
				'pallets' => $pallets,
				'plain_pallet' => $plainPallet,
				'wrap' => $wrap,
				'total' => '$' . ($skipInvoice?"0":number_format((float)$booking->fee * 1.1, 2, '.', ''))
		]);
		// Attach files
		$files = [];


		// Generate invoice pdf
		$invoice = Invoice::model()->findByAttributes(['no' => explode("-",$booking->booking_number)[0]]);
		if(!$skipInvoice)
		{
			$tempDirectory = Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR.'zip'.time();
			if (!file_exists($tempDirectory)) {
				mkdir($tempDirectory);
			}
			$fileName=$tempDirectory.DIRECTORY_SEPARATOR.'Invoice_'.$booking->booking_number.'.pdf';
			oPDF::renderPDF('invoice', ['inv'=>$invoice], 2, $fileName);

			array_push($files, [$fileName,'Invoice_'.$invoice->no.'.pdf']);
		}

		array_push($files, [$confirmation_file, 'BookingConfirmation.pdf']);
		$fileRepos = FileRepo::model()->findAllByAttributes(['fid' => $booking->shipment_id, 'type' => FileRepo::BOOKING_DO_FILE]);
		foreach ($fileRepos as $file) {
			array_push($files, [$file->getFile(), $file->name]);			
		}

		$email->subject = $email->tpl->subject;
		$email->body = $email->tpl->getContent();
		$email->mdata['to'] = $booking->company_email;
		$email->mdata['fromName'] = 'TLA Imports Team';
		$email->mdata['from'] = 'donotreply@toplogistics.com.au';
		$email->mdata['cc'] = 'imports@toplogistics.com.au';
		$email->sendEmail($files);
		unlink($confirmation_file);
	}


