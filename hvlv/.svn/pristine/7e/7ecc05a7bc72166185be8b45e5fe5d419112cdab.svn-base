	public static function sendErrorDeliverySms($cpModel){
		$errorType = $cpModel->mdata['CargoProcessErrorType'];
		if($errorType=="Delay"){
			$msg = "HI,".$cpModel->shipment->cnee->name.":
We are sorry to inform you that due to traffic & other reasons, your consignment could not be delivered as planned. We apologise for the inconvenience caused. We will reschedule your shipment as soon as possible and notify you via SMS.";
		}else{
			$msg = "HI,".$cpModel->shipment->cnee->name.":
We are sorry to inform you that your delivery was unsuccessful due to ".$errorType."
We can not go back without further arrangement.";
		}
		
	return self::sendCargoSms($cpModel,$msg,'sendErrorDeliverySms','Send_Error_Delivery_Sms','sent_error_delivery_sms');
	}

	public static function sendPreNotReply($cpModel){
		$hbn = $cpModel->shipment->ref;
		$suburb = $cpModel->shipment->cnee->suburb;
		$unloadingDate = $cpModel->shipment->mdata['ContainerUnloadDate'];
		$link = "https://book.toplogistics.com.au/cargoConfirm?caref=".$cpModel->getRef();
		if(!empty($unloadingDate)&&strtotime($unloadingDate)>strtotime(date('Y-m-d'))){
			$preStrDate = date('Y-m-d',strtotime($unloadingDate) + (2 * 24 * 3600));
			$preEndDate = date('Y-m-d',strtotime($unloadingDate) + (6 * 24 * 3600));
		}else{
			$preStrDate = date('Y-m-d',strtotime(date('Y-m-d')) + (2 * 24 * 3600));
			$preEndDate = date('Y-m-d',strtotime(date('Y-m-d')) + (6 * 24 * 3600));
		}
		$msg = "HI,".$cpModel->shipment->cnee->name.":
Your cosignment ".$hbn." to ".$suburb.", As no confirmation was received. TLA will organise the delivery from ".$preStrDate." to ".$preEndDate.",
delivery will be done based to information form your shipper. Click ".$link." to check.

TOP Logistics Australia
*The text is sent automatically, do not reply.";

		return self::sendCargoSms($cpModel,$msg,'sendPreNotReply','Send_Pre_Not_Reply','send_pre_not_reply');
	}

	public static function sendCargoSms($cpModel,$smsMsg,$smsNoticeTag,$smsDateTag,$smsNoticeLog){
		$phone = $cpModel->shipment->cnee->tel;
		$phone = Addr::auTelValid($phone);
		$check = false;
		if(!empty($phone))
		{
			if(preg_match('/^02/i', $phone)||strlen($phone)<9)
			{
				return "phone number is wrong";
			}else
			{
				$end = strlen($phone);
				$phone = "0".substr($phone,$end-9,$end);
			}

			// $msg = "Dear Valued Customer, We’d like to inform you we are about to arrange the delivery of your goods($hbn). Before that，we will need you to log in $link website，confirm the relevant information. Please reply to us asap. After sending this message, there will be 3 days of free storage time. There will be an extra storage fee If this time is exceeded.";
			$msg = $smsMsg;
			$sms = new Sms();
			$sms->no = $phone;
			$sms->msg = $msg;
			$sms->cargoProcessId = $cpModel->id;
			$sms->send();
			if($sms->status!=9) {
				$cpModel->mdata[$smsNoticeTag] =1;
				$cpModel->mdata[$smsDateTag] = date('Y-m-d H:i:s');
				$check = true;
				$cpModel->log($smsNoticeLog);
			}else
			{
				if($check)
				{
					return "send SMS failed";
				}else
				{
					return "send email and SMS failed";
				}
			}
		}
		if($check)
		{
			$cpModel->save();
		}else
		{
			return "empty phone number consignee";
		}
		return $check;
	}

