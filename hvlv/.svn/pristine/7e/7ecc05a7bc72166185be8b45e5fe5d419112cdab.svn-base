	public static function sendNotPickupCargoSms($cpModel){//not sign gatepass
		if($cpModel->type != Cargoprocess::INTERSTATE_CARGO){
			$msg = "HI,".$cpModel->shipment->cnee->name.":
We are sorry that your shipment was not picked up by the driver. 
We apologize for the delay. 
We will reschedule your shipment as soon as possible and will notify you via SMS.";
			return self::sendCargoSms($cpModel,$msg,'sendNotPickupCargoNotie','Send_Not_PickUp_Cargo_Notice','sent_not_pickup_cargo_notice_date');
		}
	}

	//gatepass
	public static function sendPickupCargoSms($cpModel){//sign gatepass
		$ref = $cpModel->shipment->ref;
		$time =  date('Y-m-d',strtotime($cpModel->job_relation->job->created));
		$destination = !empty($cpModel->job_relation->job->mdata['destination'])? Cargoprocess::$Depot[$cpModel->job_relation->job->mdata['destination']]:$cpModel->shipment->cnee->state;
		if($cpModel->type != Cargoprocess::INTERSTATE_CARGO){
			if(!empty($cpModel->job_relation->job->created)){
				$msg = "HI,".$cpModel->shipment->cnee->name.":
Your consignment ".$ref." has been loaded, and on its way, please ensure someone is at the receiving address to receive it on ".$time;
			}else{
				$msg = "HI,".$cpModel->shipment->cnee->name.":
Your consignment ".$ref." has been loaded, and on its way, please ensure someone is at the receiving address to receive it";
			}
		return self::sendCargoSms($cpModel,$msg,'sendPickupCargoNotie','Send_PickUp_Cargo_Notice','sent_pickup_cargo_notice_date');
		}else{
			$msg = "HI,".$cpModel->shipment->cnee->name.":
Your consignment ".$ref." has been loaded in ".Cargoprocess::$Depot[$cpModel->dpt_id]." and  on its way to ".$destination.".";
		return self::sendCargoSms($cpModel,$msg,'sendPickupCargoNotie','Send_PickUp_Cargo_Notice','sent_pickup_cargo_notice_date');
		}	
	}

	//prepare done
	public static function sendprepareCargoSms($cpModel){//
		if($cpModel->type != Cargoprocess::INTERSTATE_CARGO){
			$hbn = $cpModel->shipment->ref;
			$time =  date('Y-m-d',strtotime($cpModel->job_relation->job->created));
			if(!empty($time)){
				$msg = "HI,".$cpModel->shipment->cnee->name.":
Your consignment ".$hbn." is being sorted and ready for delivery soon, please ensure someone is at the receiving address to receive on ".$time;
			}else{
				$msg = "HI,".$cpModel->shipment->cnee->name.":
Your consignment ".$hbn." is being sorted and ready for delivery soon, please ensure someone is at the receiving address to receive";	
			}
		return self::sendCargoSms($cpModel,$msg,'sendprepareCargoSms','Send_Prepare_Cargo_Sms','send_prepare_cargo_sms');
		}
		
	}

