	public function sendMultiBookingInvoiceEmail($bookingSubmitNo, $pallets,$skipInvoice=false)
	{

		$pbs = PickupBookingSubmit::model()->find("submit_no = :submitNo",[":submitNo"=>$bookingSubmitNo]);
		$email = new Emailog();
		$email->type = Emailog::BOOKING_SUBMIT_CONFIRMATION;
		$email->dt = date('Y-m-d H:i:s');
		$email->status = 10;
		$email->prepTemplate();
		$email->tpl->assignSubject('pbns', $pbs->submit_no);
		$booking = $pbs->booking[0];
		// Set collection address
		$tlaAddress = '';
		switch (substr($booking->booking_number, 0, 1)) {
			case "S":
			case "s":
				$tlaAddress = '1/233 Milperra Rd, Bankstown Aerodrome NSW';
				break;
			case "M":
			case "m":
				$tlaAddress = '3B/8 Judge St, Sunshine VIC';
				break;
			case "B":
			case "b":
				$tlaAddress = '6/55 Musgrave Rd, Coopers Plains QLD';
				break;
		}

		if($booking->mdata['pallet_requirement'] == "chep") {
			$plainPallet = "No";
		} else {
			$plainPallet = "Yes";
		}
		if ($booking->mdata['shrink_wrap'] == 'wrap') {
			$wrap = "Yes";
		} else {
			$wrap = "No";
		}
		$tableStr = '<table border="1" cellpadding="1" cellspacing="1">
 	<tbody>
 		<tr>
 			<td><span style="font-family:Arial,Helvetica,sans-serif"><span style="font-size:14px">Booking#</span></span></td>
 			<td><span style="font-family:Arial,Helvetica,sans-serif"><span style="font-size:14px">Time</span></span></td>
 			<td><span style="font-family:Arial,Helvetica,sans-serif"><span style="font-size:14px">Rego</span></span></td>
 			<td><span style="font-family:Arial,Helvetica,sans-serif"><span style="font-size:14px">Driver Name</span></span></td>
 			<td><span style="font-family:Arial,Helvetica,sans-serif"><span style="font-size:14px">Company Name</span></span></td>
 			<td><span style="font-family:Arial,Helvetica,sans-serif"><span style="font-size:14px">Number of Pallets</span></span></td>
 			<td><span style="font-family:Arial,Helvetica,sans-serif"><span style="font-size:14px">Plain Pallet</span></span></td>
 			<td><span style="font-family:Arial,Helvetica,sans-serif"><span style="font-size:14px">Shrink Wrap</span></span></td>
 			<td><span style="font-family:Arial,Helvetica,sans-serif"><span style="font-size:14px">Total Inc GST</span></span></td>
 		</tr>';
 		$house_bl = [];
 		foreach ($pbs->booking as $key => $booking)
 		{
 			$house_bl[]=$booking->shipment->hbn;
 			$tableStr.= '<tr><td><span style="font-family:Arial,Helvetica,sans-serif"><span style="font-size:14px">'.$booking->booking_number.'</span></span></td>';
 			$tableStr.= '<td><span style="font-family:Arial,Helvetica,sans-serif"><span style="font-size:14px">'.date('d-m-Y H:i', strtotime($booking->booking_time)).'</span></span></td>';
 			$tableStr.= '<td><span style="font-family:Arial,Helvetica,sans-serif"><span style="font-size:14px">'.$booking->rego.'</span></span></td>';
 			$tableStr.= '<td><span style="font-family:Arial,Helvetica,sans-serif"><span style="font-size:14px">'.$booking->driver_name.'</span></span></td>';
 			$tableStr.= '<td><span style="font-family:Arial,Helvetica,sans-serif"><span style="font-size:14px">'.$booking->company_name.'</span></span></td>';
 			$tableStr.= '<td><span style="font-family:Arial,Helvetica,sans-serif"><span style="font-size:14px">'.$pallets.'</span></span></td>';
 			$tableStr.= '<td><span style="font-family:Arial,Helvetica,sans-serif"><span style="font-size:14px">'.$plainPallet.'</span></span></td>';
 			$tableStr.= '<td><span style="font-family:Arial,Helvetica,sans-serif"><span style="font-size:14px">'.$wrap.'</span></span></td>';
 			$tableStr.= '<td><span style="font-family:Arial,Helvetica,sans-serif"><span style="font-size:14px">'.('$' . ($skipInvoice?"0":number_format((float)$booking->fee * 1.1, 2, '.', ''))).'</span></span></td></tr>';
 		}
 		$tableStr .='</tbody></table>';
 		$house_bl = join(',',$house_bl);
		// Generate Confirmation PDF
		$confirmationData = [];
		$confirmationData['booking_no'] = $booking->booking_number;
		$confirmationData['time'] = date('d-m-Y H:i', strtotime($booking->booking_time));
		$confirmationData['rego'] = $booking->rego;
		$confirmationData['driver'] = $booking->driver_name;
		$confirmationData['company'] = $booking->company_name;
		$confirmationData['palletCount'] = $pallets;
		$confirmationData['plain_pallet'] = $plainPallet;
		$confirmationData['wrap'] = $wrap;
		
		$email->tpl->assignThese([
				'tableStr' => $tableStr,
				'house_bl' => $house_bl,
				'address' => $tlaAddress
		]);
		// Attach files
		$files = [];


		// Generate invoice pdf
		$invoice = Invoice::model()->findByAttributes(['no' => $pbs->submit_no]);
		if(!$skipInvoice)
		{
			$tempDirectory = Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR.'zip'.time();
			if (!file_exists($tempDirectory)) {
				mkdir($tempDirectory);
			}
			$fileName=$tempDirectory.DIRECTORY_SEPARATOR.'Invoice_'.$pbs->submit_no.'.pdf';
			oPDF::renderPDF('invoice', ['inv'=>$invoice], 2, $fileName);

			array_push($files, [$fileName,'Invoice_'.$invoice->no.'.pdf']);
		}


		$email->subject = $email->tpl->subject;
		$email->body = $email->tpl->getContent();
		$email->mdata['to'] = $booking->company_email;
		$email->mdata['fromName'] = 'TLA Imports Team';
		$email->mdata['from'] = 'donotreply@toplogistics.com.au';
		$email->mdata['cc'] = 'imports@toplogistics.com.au';
		$email->sendEmail($files);
	}

	public function sendBookingEditEmail($booking, $token)
	{
		$email = new Emailog();
		$email->type = Emailog::BOOKING_EDIT;
		$email->dt = date('Y-m-d H:i:s');
		$email->status = 10;
		$email->prepTemplate();
		$email->tpl->assignSubject('pbn', $booking->booking_number);

		$email->tpl->assignThese([
			'url' => $booking->getEditUrl($token),
		]);

		$email->subject = $email->tpl->subject;
		$email->body = $email->tpl->getContent();
		$email->mdata['to'] = $booking->company_email;
		$email->mdata['fromName'] = 'TLA Imports Team';
		$email->mdata['from'] = 'donotreply@toplogistics.com.au';
		$email->mdata['cc'] = 'imports@toplogistics.com.au';
		$email->sendEmail([]);
	}
	


	/* this is used to send credit limit notice summary
	*
	*/
	public function sendCreditNoticeSummary($limitOrgs)
	{
		$str = "";
		foreach ($limitOrgs as $key => $orgIds)
		{
			$limit = $key."%";
			$str.="<tr><td style='border-left:1px solid #F00;border-top:1px solid #F00;'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;{$limit}&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</td><td style='border-left:1px solid #F00;border-top:1px solid #F00;'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;";

			foreach ($orgIds as $key2 => $orgId) {
				$org = Org::model()->findByPk($orgId);
				$str .="<p>{$org->name}&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</p>";
			}
			$str.="</td></tr>";
		}
		$emailService = new EmailService();
		$toEmail = 'gero@toplogistics.com.au';
		$ccEmail = "christy.yu@toplogistics.com.au;michelle@toplogistics.com.au;finance@toplogistics.com.au;carmen.teh@toplogistics.com.au;op2@toplogistics.com.au;felix.hu@toplogistics.com.au;cs2@toplogistics.com.au;James.C@vic.toplogistics.com.au;colin.liu@qld.toplogistics.com.au";
		$body = "<table style='border-right:1px solid #F00;border-bottom:1px solid #F00;'><tr><th>Credit Limit Percentage</th><th>Org Name</th></tr>".$str."</table>";
		$subject = date("Y-m-d")." TLD Account Limit Summary";
		$emailService->sendNormalEmail($toEmail,$subject,$body,$ccEmail);
	}

	/**
	 * Send Inbound booking error alert email
	 */
	public function sendInboundAlertEmail($booking, $containerNo)
	{
		$email = new Emailog();
		$email->type = Emailog::INBOUND_ERROR_ALERT;
		$email->dt = date('Y-m-d H:i:s');
		$email->status = 10;
		$email->prepTemplate();
		$email->tpl->assignSubject('containerNo', $containerNo);
		$email->tpl->assignSubject('hbn', $booking->ref);
		$email->tpl->assignThese([
			'depot' => $booking->depot_id,
			'bookingNumber' => $booking->booking_number,
			'pickupTime' => $booking->booking_time
		]);

		$email->subject = $email->tpl->subject;
		$email->body = $email->tpl->getContent();
		$email->mdata['to'] = 'imports@toplogistics.com.au';
		$email->mdata['fromName'] = 'TLA Imports Team';
		$email->mdata['from'] = 'donotreply@toplogistics.com.au';
		$email->sendEmail();
	}

	public function sendCargoBookingConfirmationEmail($booking)
	{
		$email = new Emailog();
		$email->type = Emailog::CARGO_BOOKING_CONFIRMATION;
		$email->dt = date('Y-m-d H:i:s');
		$email->status = 10;
		$email->prepTemplate();
		$email->tpl->assignSubject('hbn', $booking->hbn);
		$email->tpl->assignSubject('delivery_date', date('d-m-Y', strtotime($booking->confirmed_date)));
		$email->tpl->assignThese([
			'hbn' => $booking->hbn,
			'booking_no' => $booking->booking_number,
			'delivery_date' => date('d-m-Y', strtotime($booking->confirmed_date)),
			'delivery_time' => $booking->delivery_period,
			'unloading' => $booking->mdata['need_unloading'],
			'other_ref' => !empty($booking->other_ref)?$booking->other_ref:'',
			'base_price' => '$'.$booking->mdata['base_price'],
			'oversize_fee' => '$'.$booking->mdata['oversize_fee'],
			'time_deliver_fee' => '$'.$booking->mdata['time_deliver_fee'],
			'unloading_fee' => '$'.$booking->mdata['unloading_fee'],
			'total' => '$'.number_format((float)$booking->fee*1.1, 2, '.', '')
		]);

		// Attach files
		$files = [];
		// Generate invoice pdf
		if (!empty($booking->mdata['invoiceId'])) {
			$invoice = Invoice::model()->findByPk($booking->mdata['invoiceId']);
			if (!empty($invoice)) {
				$tempDirectory = Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR.'zip'.time();
				if (!file_exists($tempDirectory)) {
					mkdir($tempDirectory);
				}
				$fileName=$tempDirectory.DIRECTORY_SEPARATOR.'Invoice_'.$invoice->no.'.pdf';
				oPDF::renderPDF('invoice', ['inv'=>$invoice], 2, $fileName);
				array_push($files, [$fileName,'Invoice_'.$invoice->no.'.pdf']);
			}
		}

		// Send email
		$org = Org::model()->findByPk($booking->org_id);
		$meta = json_decode($org->meta);
		$toEmail = $meta->outturn_email;
		if (!empty($toEmail)) {
			$email->subject = $email->tpl->subject;
			$email->body = $email->tpl->getContent();
			$email->mdata['to'] = $toEmail;
			$email->mdata['fromName'] = 'TLA Courier Service Team';
			$email->mdata['from'] = 'donotreply@toplogistics.com.au';
			$email->sendEmail($files);
		}
	}
}
