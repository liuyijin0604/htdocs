<?php 
class EmailService extends Service
{

	public function sendAvailableNoticeEmail($shipment)
	{
		if($shipment->status<ImParcel::STATE_HELD)
		{
			return;
		}

		$date = date("d/m/Y",strtotime($shipment->consol->mdata['available_date']));
		$consol = $shipment->consol;
		if(($shipment->bwf & ImParcel::CUSTOM_DDU) == 0)
		{
			return;
		}

		if($shipment->bwf&ImParcel::CUSTOM_DDU)//DDU
		{
			$email=isset($shipment->cnee->email)?$shipment->cnee->email:'';
			if (empty($email)) {
				Log::log2file("Cnee not having cnee email:shipment".$shipment->ref, "available_notice_failed", "account");
				return;
			}
		}else if($shipment->bwf&ImParcel::CUSTOM_DDP)
		{
			$email=isset($shipment->agent->extra['outturn_email'])?$shipment->agent->extra['outturn_email']:'';
			if (empty($email)) {
				Log::log2file("Cnee not having agent email:shipment".$shipment->ref, "available_notice_failed", "account");
				return;
			}
		}

		$term = 0;
		$ss = new OrgRate('search');
		$cus_services = $ss->getCustomerServicePlans($shipment->agent_id);

		if($consol->service==Consol::AIRCONSOL)
		{
			if($consol->isOurWarehouse())
			{
				// if (($shipment->bwf & ImParcel::CUSTOM_DDP) > 0) {
				// 	if (isset($cus_services['services']->AU->str_terms)) 
				// 	{
				// 		$term = $cus_services['services']->AU->str_terms." free calendar";
				// 	}
				// 	return;
				// } elseif
				if(($shipment->bwf & ImParcel::CUSTOM_DDU) > 0) 
				{
					$term = "7 free calendar";
				}
			}else
			{
				if (isset($cus_services['services']->AU->str_oth_terms)) 
				{
					$term = $cus_services['services']->AU->str_oth_terms." free business";
				}else
				{
					$term = "2 free business";
				}
			}

		}else if($consol->service==Consol::SEACONSOL)
		{
			$term = "3 free business";
		}

		$availableDate = $consol->mdata['available_date'];
 
		$clientName = $shipment->getClientName();
		$emailLog = new Emailog();
		$emailLog->fid = $shipment->id;
		$emailLog->type= Emailog::INVOICE_SHIPMENT_AVAILABLE_NOTICE;
		$emailLog->dt = date('Y-m-d H:i:s');
		$emailLog->status = 10;
		$emailLog->prepTemplate();
		$emailLog->tpl->assignThese([
			'SHIPMENT_NO'=>$shipment->ref,
			'STATUS' => ImParcel::$states[$shipment->status],
			'TERM' => $term,
			'AVAILABLE_DATE'=>$availableDate
		]);
		$emailLog->subject = $emailLog->tpl->subject;
		$emailLog->body = $emailLog->tpl->getContent();
		$emailLog->mdata['to']=$email;
		$emailLog->mdata['fromName']='TLA Imports';
		$emailLog->mdata['from']='imports@toplogistics.com.au';
		$emailLog->mdata['cc']='imports@toplogistics.com.au';
		$o=$emailLog->sendEmail();
		if ($o['status']) {
			$shipment->mdata['is_send_available_notice'] = 1;
			$shipment->updateMeta();
		} else {
			echo $o['msg'];
			Log::log2file("Available notice not send correctly:".$shipment->hbn, "available_notice_failed", "account");
		}
	}

	public function sendPickupCargoOutturnEmail($cpModel)
	{
		$path = Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR.'tmpfile'.DIRECTORY_SEPARATOR;
		$filename =  $cpModel->shipment->hbn.'  -  '.$cpModel->shipment->ref.' outturn.pdf';
		$filename = str_replace('/', '-', $filename);
		$fullFilename = $path.$filename;
		$type = "";
		if ($cpModel->shipment->consol->service == 10)
		{
			$type = "Air";
		}else
		{
			$type = "Sea";
		}
		$ps = [];
		$coverpage = oPDF::renderPDF('sea_outturn_coverpage', ['shipment' => $cpModel->shipment], 2);
		$ps[] = $coverpage;
		$tf = oPDF::renderPDF('sea_outturn', ['model' => $cpModel->shipment,'type'=>$type], 2);
		$ps[] = $tf;
		oPDF::mergePDF($ps, 2, true, $fullFilename);


		$email = $cpModel->shipment->cnee->email;
		if(empty($email))
		{
			echo "empty email of consignee";
			return false;
		}
		$email = $email;
		$emailLog = new Emailog();
		$emailLog->to_id = 0;
		$emailLog->fid = $cpModel->shipment->id;
		$emailLog->type= Emailog::PICK_OUTTURN_TEMPLATE;
		$emailLog->dt = date('Y-m-d H:i:s');
		$emailLog->status = 10;
		$emailLog->prepTemplate();
		$emailLog->tpl->assignSubject('HBN',  "outturn - ".$cpModel->shipment->hbn);
		// $emailLog->tpl->assignThese([
		// 	'FILENAME'=>$filename,
		// ]);
		$emailLog->subject = $emailLog->tpl->subject;
		$emailLog->body = $emailLog->tpl->getContent();
		$emailLog->mdata['to']=$email;
		$emailLog->mdata['fromName']='Top Logistics Australia';
		$emailLog->mdata['from']='imports@toplogistics.com.au';
		$emailLog->mdata['cc']='imports@toplogistics.com.au';
		$o=$emailLog->sendEmail([[$fullFilename,$filename]]);
		if(!$o['status'])
		{
			echo $o['msg'];
		}else
		{
			$cpModel->log('Send Outturn email');
		}
		return $o['status'];
	}

	public function sendPickupCargoSeaDOEmail($cpModel)
	{
		$path = Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR.'tmpfile'.DIRECTORY_SEPARATOR;
		$filename =  $cpModel->shipment->hbn.'  -  '.$cpModel->shipment->ref.' delivery_order.pdf';
		$filename = str_replace('/', '-', $filename);
		$fullFilename = $path.$filename;
		$type = "";
		if ($cpModel->shipment->consol->service == 10)
		{
			return false;
			$type = "Air";
		}else
		{
			$type = "Sea";
		}
		$ps = [];
		$tf = oPDF::renderPDF('sea_order', ['model' => $cpModel->shipment,'type'=>2], 2, $tf); 
		$ps[] = $tf;
		oPDF::mergePDF($ps, 2, true, $fullFilename);


		$email = $cpModel->shipment->cnee->email;
		if(empty($email))
		{
			echo "empty email of consignee";
			return false;
		}
		$email = $email;
		$emailLog = new Emailog();
		$emailLog->to_id = 0;
		$emailLog->fid = $cpModel->shipment->id;
		$emailLog->type= Emailog::PICK_OUTTURN_TEMPLATE;
		$emailLog->dt = date('Y-m-d H:i:s');
		$emailLog->status = 10;
		$emailLog->prepTemplate();
		$emailLog->tpl->assignSubject('HBN',  "delivery order - ".$cpModel->shipment->hbn);
		// $emailLog->tpl->assignThese([
		// 	'FILENAME'=>$filename,
		// ]);
		$emailLog->subject = $emailLog->tpl->subject;
		$emailLog->body = $emailLog->tpl->getContent();
		$emailLog->mdata['to']=$email;
		$emailLog->mdata['fromName']='Top Logistics Australia';
		$emailLog->mdata['from']='imports@toplogistics.com.au';
		$emailLog->mdata['cc']='imports@toplogistics.com.au';
		$o=$emailLog->sendEmail([[$fullFilename,$filename]]);
		if(!$o['status'])
		{
			echo $o['msg'];
		}else
		{
			$cpModel->log('Send Outturn email');
		}
		return $o['status'];
	}

