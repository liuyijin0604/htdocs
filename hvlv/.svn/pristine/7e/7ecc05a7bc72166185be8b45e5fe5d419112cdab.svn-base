	public static function sendNormalCargoSmsEmail($cpModel)//only for normal
	{
		$objShipment = $cpModel->shipment;
		$strHbn =  $objShipment->hbn;
		$strWeight = $objShipment->weight;
		$strPkg= $objShipment->pkg;
		$strAddress = $objShipment->cnee->address;
		$phone = substr($objShipment->cnee->tel,-4);

		$link = "https://book.toplogistics.com.au/cargoConfirm?caref=".$cpModel->getRef();
		$tracklink = "https://toplogistics.com.au/?s=".$cpModel->getRef();

		$strFromOverseas = ' from overseas';
		if($cpModel->shipment->ot_id == TplParcel::$my_ot_id){
			$strFromOverseas = '';
		}

		//wms task item
		if(!empty($objShipment->mdata['wmstask_id'])){
			$strProd = '-Product:
';
			$idTask = $objShipment->mdata['wmstask_id'];
			$listWmsTaskItem = WmsTaskItem::model()->findAll('task_id=:task_id',[':task_id'=>$idTask]);
			foreach($listWmsTaskItem as $objItem){
				$strName = $objItem->mdata['sn'];
				if(!empty($strName)){
					$strProd.=' [';
					$objProd = WmsProd::model()->find('name=:name',[':name'=>$strName]);
					if($objProd != null){

						$strProd.= $objProd->brand.' ';
					}
					$strProd.=$strName.']
';
				}
			}
		}

		$strMessage=
'Hi '.$cpModel->shipment->cnee->name.',

This is Top Logistics Australia，We would like to arrange delivery to you'.$strFromOverseas.'.

'.$strProd.'
-Tracking No. '.$strHbn.'
-Weight:'.$strWeight.' kg
-No. Cartons:'.$strPkg.' pcs
-Delivery Address:'.$strAddress.'

Please click here to  '.$link.'  to confirm your delivery details and time.

Please confirm within 24 hours or the delivery might be delayed, or storage fee at $0.15/kg per day applies.

PLS DON’T REPLY TO THIS MSG, FOR DELIVERY UPDATES, PLS VISIT '.$tracklink;
		
		$href = '<a id="link" target = "_blank" onclick="return postcodeVeryfi()" href="' . $link .'">Here</a>';

		$objShipment->addTracking(16,'Send SMS to xxxx'.$phone.' Waiting for confirmation. Or Click '.$href.' to confirm',Org::model()->findByPk($objShipment->ddpt_id)->name);

 		return self::sendCargoSmsEmail($cpModel,Emailog::CARGO_EMAIL_NOTICE,'sendEmailNotie','Send Email Notice',$strMessage,'sendSmsNotie','Send Sms Notice','sent_confirm_sms_date');
	}




