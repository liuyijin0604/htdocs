<?php
if ($model->mdata['pallet_requirement'] == 'chep') {
    $palletFee = 0;
} else {
    $palletFee = $numPallets * 20;
}

if ($model->mdata['shrink_wrap'] == "wrap") {
    $wrapFee = $numPallets * 5;
} else {
    $wrapFee = 0;
}
?>
