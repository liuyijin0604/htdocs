                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                GST 10%:
                                <span><?php echo "$" . number_format((float)$model->fee * 0.1, 2, '.', ''); ?></span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                Total Amount Inc GST:
                                <span><?php echo "$" . number_format((float)$model->fee * 1.1, 2, '.', ''); ?></span>
