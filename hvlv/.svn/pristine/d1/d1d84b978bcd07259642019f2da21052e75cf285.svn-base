        function nextQustion() {
            numCountItem++;
        	let qid = $('#qid').attr("qid");
            let answerid ="";
            let submit_id = <?php echo $_GET['submit_id']; ?>;
            let answerStr = "";
            var urlStr = "?";
            let thisData = [];
            let answersArray = [];
            questionsArray.push(qid);
            document.getElementById("previousQuestionBtn").style.visibility = "visible";
            // alert(questionsArray);
            // alert($('input[name="_answer"]').attr("type"));
            if ($('input[name="_answer"]').attr("type") == "radio"){
                // alert($('input[name="_answer"]:checked')[1].val());
                answerid = $('input[name="_answer"]:checked').val(); 
                urlStr += "answerId="+answerid+"&&";               
            }
            else if($('input[name="_answer"]').attr("type") == "checkbox"){
                let answerids = $('input[name="_answer"]:checked');
                for (let i = 0; i < answerids.length; i++) {
                  answersArray.push(answerids[i].value);
                  // alert(answerids[i].value);
                }
                answerStr = answersArray.toString();
                // alert(answerStr);
                thisData = {"answerStr":answerStr};
            }
            else{
                answerStr = $('input[name="_answer"]').val(); 
                thisData = {"answerStr":answerStr};
            }
            // if (answerid){
            //     answersArray.push(answerid);                                
            // }
            urlStr += "questionId="+qid+"&& submit_id="+submit_id;
            //        alert(qid+"  "+answerid);
   //      	var answers = new FormData(document.getElementById("_answer"));
         	<?php
				$url = $this->createUrl('salesfunnelRequirements/nextQuestion');
			 ?>	             
             // thisData = {"answerStr":answerStr, "answersArray":answersArray};
             // alert(answerStr);
			$.ajax({
			           url: '<?=$url?>'+urlStr,
			           type: "post",
                       data: thisData,
			           processData: true,
			           contentType: "application/x-www-form-urlencoded; charset=UTF-8",
			           success: function(r) {
			           	$('#item').remove();
			           	$('#items').append(r);
                        // alert($('#lid').html());
                        if ($('#lid').html()=="The questionnaire has ended."){
                            document.getElementById("nextQuestionBtn").style.visibility = "hidden";
                        }

			         },
			           error: function(e) {
			               console.log(e);
			           }
			       });	            
			return false;
        }

        function previousQustion() {   
            let submit_id = <?php echo $_GET['submit_id']; ?>;         
            numCountItem--;            
            preQustionId = questionsArray[questionsArray.length-1];
            // alert(questionsArray);
            document.getElementById("nextQuestionBtn").style.visibility = "visible";
   //       alert(preQustionId);
   //       var answers = new FormData(document.getElementById("_answer"));
            <?php
                $url = $this->createUrl('salesfunnelRequirements/preQustion');
             ?> 
            $.ajax({
                       url: '<?=$url?>'+"?preQustionId="+preQustionId+"&& submit_id="+submit_id,
                       type: "post",
                       processData: false,
                       contentType: false,
                       success: function(r) {
                        $('#item').remove();
                        $('#items').append(r);

                        if ($('#qid').html()=="Question 1"){
                            document.getElementById("previousQuestionBtn").style.visibility = "hidden";
                        }
                     },
                       error: function(e) {
                           console.log(e);
                       }
                   });  
            questionsArray.pop();
            answersArray.pop();
            return false;
        }


        function submitForm() {
            numCountItem++;
            let qid = $('#qid').attr("qid");
            let answerid ="";
            let submit_id = <?php echo $_GET['submit_id']; ?>;
            let answerStr = "";
            var urlStr = "?";
            questionsArray.push(qid);
            // alert($('input[name="_answer"]').attr("type"));
            if ($('input[name="_answer"]').attr("type") == "radio" || $('input[name="_answer"]').attr("type") == "checkbox"){
                answerid = $('input[name="_answer"]:checked').val(); 
                urlStr += "answerId="+answerid+"&&";               
            }
            else{
                answerStr = $('input[name="_answer"]').val(); 
            }
            if (answerid){
                answersArray.push(answerid);                                
            }
            urlStr += "questionId="+qid+"&& submit_id="+submit_id;
            //        alert(qid+"  "+answerid);
   //       var answers = new FormData(document.getElementById("_answer"));
            <?php
                $url = $this->createUrl('salesfunnelRequirements/nextQuestion');
             ?>              
             let thisData = {"answerStr":answerStr};
             // alert(answerStr);
            $.ajax({
                       url: '<?=$url?>'+urlStr,
                       type: "post",
                       data: thisData,
                       processData: true,
                       contentType: "application/x-www-form-urlencoded; charset=UTF-8",
                       success: function(r) {
                        $('#item').remove();
                        $('#items').append(r);
                     },
                       error: function(e) {
                           console.log(e);
                       }
                   });  
            return true;

        }

        (function() {
            'use strict'
            // Fetch all the forms we want to apply custom Bootstrap validation styles to
            var forms = document.querySelectorAll('.needs-validation')
            // Loop over them and prevent submission
            Array.prototype.slice.call(forms)
                .forEach(function(form) {
                    form.addEventListener('submit', function(event) {
                        if (!form.checkValidity()) {
                            event.preventDefault()
                            event.stopPropagation()
                        }
                        form.classList.add('was-validated')
                    }, false)
                })
        })()

    </script>
</body>

