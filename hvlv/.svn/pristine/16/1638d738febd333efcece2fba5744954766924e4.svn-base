                            $("#time_4",win).addClass("btn-danger");
                            $("#time_4",win).attr('disabled', true);
                            break;
                        case "08:00:00":
                            $("#time_5",win).removeClass("btn-success");
                            $("#time_5",win).addClass("btn-danger");
                            $("#time_5",win).attr('disabled', true);
                            break;
                        case "08:15:00":
                            $("#time_6",win).removeClass("btn-success");
                            $("#time_6",win).addClass("btn-danger");
                            $("#time_6",win).attr('disabled', true);
                            break;
                        case "08:30:00":
                            $("#time_7",win).removeClass("btn-success");
                            $("#time_7",win).addClass("btn-danger");
                            $("#time_7",win).attr('disabled', true);
                            break;
                        case "08:45:00":
                            $("#time_8",win).removeClass("btn-success");
                            $("#time_8",win).addClass("btn-danger");
                            $("#time_8",win).attr('disabled', true);
                            break;
                        case "09:00:00":
