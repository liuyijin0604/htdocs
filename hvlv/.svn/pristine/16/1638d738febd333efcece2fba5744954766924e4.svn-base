    <script type="text/javascript">

        /**
         * Set booking time value, adjust display
         */
        function setBookingTime(bookingTime, btn_id) {
            var win = $('#jqmw_<?=$_GET["tabid"];?>');
            $("#booking_time",win).val(bookingTime);
            $(".btn-info",win).addClass("btn-success");
            $(".btn-info",win).removeClass("btn-info");

            $(btn_id).removeClass("btn-success");
            $(btn_id).addClass("btn-info");
            $("#btn-example-selected",win).removeClass();
            $("#btn-example-selected",win).addClass("btn btn-info");
            $("#btn-example-occupied",win).removeClass();
            $("#btn-example-occupied",win).addClass("btn btn-danger");
        }


        function isEmail(strEmail)
        {
            var emails = strEmail.split(';');
            for (var i = emails.length - 1; i >= 0; i--)
            {
               if (emails[i].search(/^\w+((-\w+)|(\.\w+))*\@[A-Za-z0-9]+((\.|-)[A-Za-z0-9]+)*\.[A-Za-z0-9]+$/) != -1)
                {
                    
                }
                else
                {
                    return false;
                }
            }
            
            return true;
        }

        // Convert date format
        function dateFormat(inputDate, format) {
            //parse the input date
            const date = new Date(inputDate);

            //extract the parts of the date
            const day = date.getDate();
            const month = date.getMonth() + 1;
            const year = date.getFullYear();

            //replace the month
            format = format.replace("MM", month.toString().padStart(2, "0"));

            //replace the year
            if (format.indexOf("yyyy") > -1) {
                format = format.replace("yyyy", year.toString());
            } else if (format.indexOf("yy") > -1) {
                format = format.replace("yy", year.toString().substr(2, 2));
            }

            //replace the day
            format = format.replace("dd", day.toString().padStart(2, "0"));

            return format;
        }

        $(function() {
            var win = $('#jqmw_<?=$_GET["tabid"];?>');
            var tab = $('#<?=$_GET["tabid"];?>');
            var panel = $('#<?=$_GET["tabid"];?>').data('panel');

            $(".readonly",win).on('keydown paste focus mousedown', function(e) {
                if (e.keyCode != 9) // ignore tab
                    e.preventDefault();
            });
            var availableDate = <?php echo json_encode($availableDate, JSON_HEX_TAG); ?>;
            var endDate = <?php echo json_encode($endDate, JSON_HEX_TAG); ?>;
            availableDate = new Date(availableDate);
            endDate = new Date(endDate);
            endDate.setDate(endDate.getDate() - 1);
            /* var today = new Date();
            if (availableDate.getTime() < today.getTime()) {
                availableDate = today;
            } */
            var exclude = <?php if($depot == 'Melbourne') {
                 echo '["' . implode('", "', ["22-09-2022", "23-09-2022"]) . '"]'; 
                } else {
                    echo '["' . implode('", "', ["22-09-2022"]) . '"]';

                }
                ?>;
            //console.log(exclude);
            $("#booking_date",win).datepicker({
                minDate: availableDate,
                maxDate: endDate,
                changeMonth: true,
                beforeShowDay: function(date) {
                    var day = jQuery.datepicker.formatDate('dd-mm-yy', date);
                    return [!~$.inArray(day, exclude) && (date.getDay() != 0) && (date.getDay() != 6)];
                },
                dateFormat: "dd MM yy"
            });
                    /**
         * Display timeslots based on selected date.
         * Set pickup time.
         */
        $("#booking_date",win).change(function()
        {
            $("#booking_time",win).val(''); // Clear booking time on booking date change.
            $("#timeslot-container",win).show();
            $(".btn-info",win).addClass("btn-success");
            $(".btn-info",win).removeClass("btn-info");
            $(".btn-danger",win).addClass("btn-success");
            $(".btn-danger",win).attr('disabled', false);
            $(".btn-danger",win).removeClass("btn-danger");

            $("#btn-example-selected",win).removeClass("btn-success");
            $("#btn-example-selected",win).addClass("btn-info");
            $("#btn-example-occupied",win).removeClass("btn-success");
            $("#btn-example-occupied",win).addClass("btn-danger");
            var datePicked = $("#booking_date",win).val();
            datePicked = dateFormat(datePicked, 'yyyy-MM-dd'); // Convert date format
            // Read occupied slots array on selected date
            var occupiedSlots = <?php echo json_encode($occupiedSlots, JSON_HEX_TAG); ?>;
