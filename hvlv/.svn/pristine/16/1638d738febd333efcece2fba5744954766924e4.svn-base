        $("form#bookingForm",win).submit(function(event) {
                if(!isEmail($('#email',win).val()))
                {
                    $('#email',win).focus();
                    alert("Company Email is invalid");
                    return false;
                }
                $('#form_submit',win).prop('disabled', true);
                $('#loading-container',win).show();
                event.preventDefault();
                $("#booking_date",win).val(dateFormat($("#booking_date",win).val(), 'yyyy-MM-dd'));
                var formData = new FormData(this);
                $.ajax({
                    url: "<?=$this->createUrl("pickupBooking/editBookingInfo")?>"+"?id=<?=$id?>",
                    type: 'POST',
                    data: formData,
                    enctype: 'multipart/form-data',
                    cache: false,
                    contentType: false,
                    processData: false,
                    success: function(res) {
                        //console.log(formData);
                        console.log(res);
                        //alert('Success');
                        if (res != "Slot has been occupied, please pick another time slot.") {
                            alert("Adjustment has been submitted. You will receive the confirmation email.");
                            $('#form_submit',win).prop('disabled', false);
                            $("#loading-container",win).hide();
                            //window.location.href = "https://www.toplogistics.com.au";
                        } else {
                            alert(res);
                            $('#form_submit',win).prop('disabled', false);
                            $("#loading-container",win).hide();
                        }

                    },
                });
            });

            var depot = "<?php echo $depot; ?>";
            console.log(depot);
            if(depot == "Melbourne") {
                $("#time_1",win).hide();
                $("#time_2",win).hide();
                $("#time_2",win).hide();
                $("#time_2",win).hide();
                $("#time_3",win).hide();
                $("#time_2",win).hide();
                $("#time_4",win).hide();
                $("#time_5",win).hide();
                $("#time_6",win).hide();
                $("#time_7",win).hide();
                $("#time_8",win).hide();
            } else if (depot == "Brisbane") {
                $("#time_1",win).hide();
                $("#time_2",win).hide();
                $("#time_2",win).hide();
                $("#time_2",win).hide();
                $("#time_3",win).hide();
                $("#time_2",win).hide();
                $("#time_4",win).hide();
                $("#time_5",win).hide();
                $("#time_6",win).hide();
                $("#time_7",win).hide();
                $("#time_8",win).hide();
                $("#time_9",win).hide();
                $("#time_10",win).hide();
                $("#slot-group-2",win).css("margin-bottom", "-62px");
            }
            $("#booking_date",win).datepicker( "setDate", new Date('<?=$booking_date?>'));
            $('#booking_time',win).val('<?=$booking_time?>');

        });

    </script>
