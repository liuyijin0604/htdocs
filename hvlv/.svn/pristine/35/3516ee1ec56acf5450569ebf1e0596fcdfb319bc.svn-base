<script type="text/javascript">
$(function(){
	var win = $('#jqmw_<?=$_GET["tabid"];?>');
	$('#editEmail',win).on('click',function(){
		if($('#agent_id',win).val()=='')
		{
			alert('Need to select agent!!');
			return false;
		}
				href = $('#jumpEditEmail',win).attr('href');
				href = "top/invoice/editStatementEmail.app?agent_id="+$('#agent_id',win).val();
				if($('#wid',win).val()!="")
				{
					href += "&&wid="+$('#wid',win).val();
				}
				if($('#suborg_id',win).val()!="")
				{
					href += "&&suborg_id="+$('#suborg_id',win).val();
				}
				if($('#ex_suborg_id',win).val()!="")
				{
					href += "&&ex_suborg_id="+$('#ex_suborg_id',win).val();
				}
				if($('#fromdate',win).val()!="")
				{
					href += "&&fromdate="+$('#fromdate',win).val();
				}
				if($('#postdate',win).val()!="")
				{
					href += "&&postdate="+$('#postdate',win).val();
				}
				if($('#op_id',win).val()!="")
				{
					href += "&&op_id="+$('#op_id',win).val();
				}

				$('input[name="wcredit"]:checked').each(function(){
					href += "&&wcredit="+$(this).val();
				});

				$('input[name="incpending"]:checked').each(function(){
					href += "&&incpending="+$(this).val();
				});
				$('input[name="onbehalf"]:checked').each(function(){
					href += "&&onbehalf="+$(this).val();
				});
				$('input[name="excludedetails"]:checked').each(function(){
					href += "&&excludedetails="+$(this).val();
				});
				$('input[name="orderbydate"]:checked').each(function(){
					href += "&&orderbydate="+$(this).val();
				});


				$('#jumpEditEmail',win).attr('href',href);
				$('#jumpEditEmail',win).click();
				return false;
	});
});
</script>