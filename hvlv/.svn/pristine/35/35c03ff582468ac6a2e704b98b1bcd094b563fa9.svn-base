<script type="text/javascript">
	$(document).ready(function(e){

	var win = $('#jqmw_<?=$_GET["tabid"];?>');

	// current zone rate data
	var curZoneRateData = <?php echo json_encode($orgFlexibleRate->getOrgFlexibleRateByOrgId($orgId)); ?>;

	var allZoneRateData = [];
	var allRowIndex = 0;
	var selectedRowIndex = 0;
	appendCurZoneRateData(curZoneRateData);
	var importInProgress = false;

	function isImportInProgress(){
		return importInProgress;
	}

	function appendCurZoneRateData(rateData){

		$('#zone-rate-weight-range-grid .items tbody td.empty', win).parent().remove();
		var wtpl = $('#zone-rate-weight-range-grid .items tfoot', win);
		var row = wtpl.find('tr').clone();
		for ( var i in rateData ) {
			allRowIndex++;
			var r = wtpl.find('tr').clone();
			$('.add_btn',r).replaceWith('<a href="javascript:;" data-index="'+allRowIndex+'"class="delete_btn" title="Remove">Remove</a>');
			$('input', r).each(function(){
				var n = $(this).attr('name');
				$(this).attr('name', n+'[]');
			});
			$('#zone-rate-weight-range-grid .items tbody', win).append(r);
			r.find('#org_flexible-rate-grid_item').val(rateData[i]['item']);
			r.find('#org_flexible-rate-grid_amount').val(rateData[i]['amount']);
			r.find('#org_flexible-rate-grid_unit').val(rateData[i]['unit']);
			r.find('#org_flexible-rate-grid_minimum').val(rateData[i]['minimum']);

			r.find("input[name='OrgFlexibleRate[branch][]']").each(function(j){
				if(rateData[i]['branch'].indexOf($(this).val())>=0)
				{
					$(this).attr('checked',true);
				}
			});

			r.find("input[name='OrgFlexibleRate[cargo][]']").each(function(j){
				if(rateData[i]['cargo'].indexOf($(this).val())>=0)
				{
					$(this).attr('checked',true);
				}
			});


			r.find("input[name='OrgFlexibleRate[service][]']").each(function(j){
				if(rateData[i]['service'].indexOf($(this).val())>=0)
				{
					$(this).attr('checked',true);
				}
			});

			r.find("input[name='OrgFlexibleRate[rebate][]']").each(function(j){
				if(rateData[i]['rebate']!=null &&rateData[i]['rebate']==$(this).val())
				{
					$(this).attr('checked',true);
				}
			});


			addOneZoneRateByData(allRowIndex,rateData[i]['data']);
		}
	}

	 function addOneZoneRateByData(tag,rateData){
		 var bFound = false;
		 for ( var i in allZoneRateData ) {
			 var oneZone = allZoneRateData[i];
			 if ( oneZone['tag'] == tag ) {
				 bFound = true;
			 }
		 }
		 if ( !bFound ) {
			 var zoneData = {};
			 zoneData['tag'] = tag;
			 zoneData['item'] = '';
			 zoneData['amount'] = 0;
			 zoneData['unit']='';
			 zoneData['minimum']=0;
			 zoneData['branch']='';
			 zoneData['cargo']='';
			 zoneData['service']=0;
			 zoneData['rebate']=0;
			 allZoneRateData.push(zoneData);
		 }
	 }

	 function addOneZoneRate(tag)
	 {
		// check existing or not
		// if not existing just create a new one
		var bFound = false;
		for ( var i in allZoneRateData ) {
			var oneZone = allZoneRateData[i];
			if ( oneZone['tag'] == tag ) {
				bFound = true;
			}
		}
		if ( !bFound ) {
			var zoneData = {};
			zoneData['tag'] = tag;
			zoneData['item'] = '';
			zoneData['amount'] = 0;
			zoneData['unit'] = '';
			zoneData['minimum'] = 0;
			zoneData['branch'] = 0;
			zoneData['cargo'] = 0;
			allZoneRateData.push(zoneData);
		}
	}

	function updateData(dataIndex,item,amount,unit,minimum,branch,cargo,service,rebate)
	{
		// get related zone rate data
		for ( var i in allZoneRateData ) {
			var oneZone = allZoneRateData[i];
			if ( oneZone['tag'] == dataIndex ) {
				allZoneRateData[i]['item'] = item;
				allZoneRateData[i]['amount'] = amount;
				allZoneRateData[i]['unit']=unit;
				allZoneRateData[i]['minimum']=minimum;
				allZoneRateData[i]['branch']=branch;
				allZoneRateData[i]['cargo']=cargo;
				allZoneRateData[i]['service']=service;
				allZoneRateData[i]['rebate']=rebate;
				break;
			}
		}
	}


	function validWeightFrom($fromWeight){
		var lo =  parseFloat($fromWeight.val());
		var hi =  parseFloat($fromWeight.parent().parent().find('#zone-rate-weight-range-grid_weight_hi').val());
		if ( !isNaN(lo) && !isNaN(hi) ) {
			if ( lo > hi ) {
				alert( "low weight must be less than high weight");
				return false;
			}
		}
		return true;
	}

	function validWeightTo($toWeight){
		var hi =  parseFloat($toWeight.val());
		var lo =  parseFloat($toWeight.parent().parent().find('#zone-rate-weight-range-grid_weight_lo').val());
		if ( !isNaN(lo) && !isNaN(hi) ) {
			if ( lo > hi ) {
				alert( "low weight must be less than high weight");
				return false;
			}
		}
		return true;
	}

	$('form#pca-chargecode-rate-form', win).on('success', function(e, r){
	//	win.data('opener').trigger('reload_contact_grid');
		win.jqmHide();
	});


	$('#zone-rate-weight-range-grid .add_btn', win).on('click', function(e){

		e.preventDefault();


		allRowIndex++;
		$('#zone-rate-weight-range-grid .items tbody td.empty', win).parent().remove();
		var r = $(this).parents('tr').clone();
		$('.add_btn',r).replaceWith('<a href="javascript:;" data-index="'+allRowIndex+'"class="delete_btn" title="Remove">Remove</a>');
		$('input', r).each(function(){
			var n = $(this).attr('name');
			$(this).attr('name', n+'[]');
		});
		$('#zone-rate-weight-range-grid .items tbody').append(r);

		addOneZoneRate(allRowIndex);

		return false;
	});

	$('#zone-rate-weight-range-grid', win).on('click','tr',function(e){
		// exclude the dummy row data
		if ( $(this).parent().is("tfoot") ) return;

		// get related zone data related tag
		var tag = $(this).find('.delete_btn').data('index');
	});

	$('#zone-rate-weight-range-grid', win).on('click','.delete_btn',function(e){
		e.preventDefault();
		if ( confirm( 'Are you sure remove the zone rate data?') ) {
			$(this).parents('tr').remove();
			return false;
		}
		return true;
	});

	$('#org-zone-rate-view', win).on('change','input[type=text]',function(e){
		var bFound = false;
		var oneZoneRate = [];
		var rowIndex = 0;
		for ( var i in allZoneRateData ) {
			var oneZone = allZoneRateData[i];
			if ( oneZone['tag'] == selectedRowIndex ) {
				bFound = true;
				oneZoneRate = oneZone['data'];
				rowIndex = i;
				console.log('related zone data found');
				break;
			}
		}
		if ( bFound ) {
			// get code related data item
			var code = $(this).data('code');
			for ( var j in oneZoneRate ) {
				var oneData = oneZoneRate[j];
				if ( oneData['code'] == code ) {
					oneData[$(this).attr('name').replace(/[\[\]]+/,'')] = $(this).val();
					break;
				}
			}
		}
	});

	$('#org-zone-rate-view', win).on('paste','tbody input[type=text]',function(e){
		if (window.clipboardData && window.clipboardData.getData){
			pastedText = window.clipboardData.getData('Text');
		} else if (e.originalEvent.clipboardData && e.originalEvent.clipboardData.getData) {
			pastedText = e.originalEvent.clipboardData.getData('text/plain');
		}

		var ppos = -1;
		var me = $(this);
		var cells = pastedText.trim().split(/[\t\n\r]+/);
		$('#org-zone-rate-view tbody input[type=text]', win).each(function(i){
			if($(this).is(me)) ppos = 0;
			if(ppos >= cells.length) return false;
			if(ppos > -1) $(this).val(cells[ppos++]).trigger('change');
		});
		
		return false;
	});


	$('input[type="submit"]',win).click(function(e){
		//alert('callme');
		e.preventDefault();
		// update all lo and hi weight range
		$('#zone-rate-weight-range-grid', win).find('tr').each(function(e){
			var dataIndex = $(this).find('.delete_btn').data('index');
			if ( !isNaN(dataIndex) ) {
				var item = $(this).find('#org_flexible-rate-grid_item').val();
				var amount = $(this).find('#org_flexible-rate-grid_amount').val();
				var unit = $(this).find('#org_flexible-rate-grid_unit').val();
				var minimum = $(this).find('#org_flexible-rate-grid_minimum').val();
				var branch = '';
				var cargo = '';
				var service = '';
				var rebate = '';
				$(this).find("input[name='OrgFlexibleRate[branch][]']:checked").each(function(i){
					branch += $(this).val()+",";
				});

				$(this).find("input[name='OrgFlexibleRate[cargo][]']:checked").each(function(i){
					cargo += $(this).val()+",";
				});


				$(this).find("input[name='OrgFlexibleRate[service][]']:checked").each(function(i){
					service += $(this).val()+",";
				});

				$(this).find("input[name='OrgFlexibleRate[rebate][]']:checked").each(function(i){
					rebate += $(this).val()+",";
				});



				updateData(dataIndex,item,amount,unit,minimum,branch,cargo,service,rebate);
			}
		});

		var postdata = JSON.stringify(allZoneRateData);
		// ajax post to save them
		var orgId = $('#Org_id', win).val();
		var startDate = $('#start_date<?=$_GET['tabid']?>', win).val();
		var criteria = $('#criteria', win).val();
		$.ajax({
			type : 'POST',
			url : '<?php echo Yii::app()->createAbsoluteUrl("org/saveOrgFlexibleRate") ;?>',
			dataType: 'json',
			data:{ 'oid' : orgId,'start_date' : startDate,'criteria' : criteria,'data' : postdata},
			success:function(resp){
				if ( resp.success == 1 ) {
					myApp.notice('flex rate saved successfully!', 5000);
				} else {
					myApp.alert(resp.msg);
				}
			}
		});

	});

	$("#OrgFlexibleRateVersion",win).on("change",function(e)
	{
		if($(this).val()!=""&&$(this).val()!="0")
		{
			$('#searchVersion',win).attr('href','<?=$this->createUrl('org/viewOrgFlexibleRateVersion',['id'=>$orgId]);?>?version=' + $(this).val());
			$('#searchVersion',win).attr('title','of:<?=$orgId?>version=' + $(this).val());
			$('#searchVersion',win).click();
		}
	});
});
</script>