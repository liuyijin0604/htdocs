<?php

class ConsolProcessController extends Controller
{
	protected $nonAjax=['scanInfo','export'];
	public function actionIndex()
	{
		$filtersForm1=new FiltersForm1;
		$filtersForm=new FiltersForm;
		if (isset($_GET['FiltersForm'])) {
			$filtersForm->filters=$_GET['FiltersForm'];
		}
		if (isset($_GET['FiltersForm1'])) {
			$filtersForm1->filters=$_GET['FiltersForm1'];
		}
		$provide=[];
		$permissionArr = ConsolProcessService::getUserPermission();
		$serviceStr = "";
		$statusStr = "";
		if(!empty($permissionArr[0]))
		{
			$serviceStr = " and service in (".join(',',$permissionArr[0]).")";
		}

		if(!empty($permissionArr[1]))
		{
			$statusStr = " and s.status".$permissionArr[1];
		}

		$sql='SELECT count(*) as number, s.status as status FROM `consol` t INNER JOIN `consol_process` s ON t.id=s.fid WHERE t.status!=100 AND t.type in (15,70) AND s.status<80 AND s.main_type=1 '.$serviceStr.$statusStr.' group by s.status ';
		$rs=Yii::app()->db->createCommand($sql)->queryAll();
		foreach ($rs as $id=>$r) {
			$n1=0;
			$n2=0;
			$n3=0;
			$sql='SELECT count(*) as number FROM `consol` t INNER JOIN `consol_process` s ON t.id=s.fid WHERE t.type in(15,70) AND t.status!=100 AND s.status=:status AND s.main_type=1 AND DATEDIFF(NOW(),eta)<=1 '.$serviceStr.$statusStr;
			$n1=Yii::app()->db->createCommand($sql)->bindValues([':status'=>$r['status']])->queryScalar();
			$sql='SELECT count(*) as number FROM `consol` t INNER JOIN `consol_process` s ON t.id=s.fid WHERE t.type in(15,70)  AND t.status!=100 AND s.status=:status AND s.main_type=1 AND DATEDIFF(NOW(),eta)=2 '.$serviceStr.$statusStr;
			$n2=Yii::app()->db->createCommand($sql)->bindValues([':status'=>$r['status']])->queryScalar();
			$sql='SELECT count(*) as number FROM `consol` t INNER JOIN `consol_process` s ON t.id=s.fid WHERE t.type in(15,70)  AND t.status!=100 AND s.status=:status AND s.main_type=1 AND DATEDIFF(NOW(),eta)>=3 '.$serviceStr.$statusStr;
			$n3=Yii::app()->db->createCommand($sql)->bindValues([':status'=>$r['status']])->queryScalar();
			$provide[]=['id'=>$id,'number'=>$r['number'],'status'=> $r['status'],'day1'=>$n1,'day2'=>$n2,'day3'=>$n3];
		}
		$filteredData=$filtersForm->filter($provide);
		$dataprovider=new CArrayDataProvider($filteredData);
		$dataprovider->pagination=['pageSize' =>10,];
		$sort=new CSort();
		$sort->attributes=[
			'number'=>[
				'asc'=>'number ASC',
				'desc'=>'number DESC',
			],
			'status'=>[
				'asc'=>'status ASC',
				'desc'=>'status DESC',
			],
		];
		$sort->defaultOrder = "status ASC";
		$dataprovider->sort=$sort;


		$provide3=[];
		$sql='SELECT count(*) as number, s.status as status FROM `consol` t INNER JOIN `consol_process` s ON t.id=s.fid WHERE t.status!=100 AND t.type in (15,70) AND s.status not in (80,255) AND s.main_type=2 '.$serviceStr.$statusStr.' group by s.status ';
		$rs=Yii::app()->db->createCommand($sql)->queryAll();
		foreach ($rs as $id=>$r) {
			$n1=0;
			$n2=0;
			$n3=0;
			$sql='SELECT count(*) as number FROM `consol` t INNER JOIN `consol_process` s ON t.id=s.fid WHERE t.type in(15,70) AND t.status!=100 AND s.status=:status AND s.main_type=2 AND DATEDIFF(NOW(),eta)<=14 '.$serviceStr.$statusStr;
			$n1=Yii::app()->db->createCommand($sql)->bindValues([':status'=>$r['status']])->queryScalar();
			$sql='SELECT count(*) as number FROM `consol` t INNER JOIN `consol_process` s ON t.id=s.fid WHERE t.type in(15,70)  AND t.status!=100 AND s.status=:status AND s.main_type=2 AND DATEDIFF(NOW(),eta)>14 AND DATEDIFF(NOW(),eta)<=30 '.$serviceStr.$statusStr;
			$n2=Yii::app()->db->createCommand($sql)->bindValues([':status'=>$r['status']])->queryScalar();
			$sql='SELECT count(*) as number FROM `consol` t INNER JOIN `consol_process` s ON t.id=s.fid WHERE t.type in(15,70)  AND t.status!=100 AND s.status=:status AND s.main_type=2 AND DATEDIFF(NOW(),eta)>=30 '.$serviceStr.$statusStr;
			$n3=Yii::app()->db->createCommand($sql)->bindValues([':status'=>$r['status']])->queryScalar();
			$provide3[]=['id'=>$id,'number'=>$r['number'],'status'=> $r['status'],'day1'=>$n1,'day2'=>$n2,'day3'=>$n3];
		}

		$filteredData3=$filtersForm->filter($provide3);
		$dataprovider3=new CArrayDataProvider($filteredData3);
		$dataprovider3->pagination=['pageSize' =>10,];
		$sort=new CSort();
		$sort->attributes=[
			'number'=>[
				'asc'=>'number ASC',
				'desc'=>'number DESC',
			],
			'status'=>[
				'asc'=>'status ASC',
				'desc'=>'status DESC',
			],
		];
		$sort->defaultOrder = "status ASC";
		$dataprovider3->sort=$sort;


		$provide=[];
		$list=Org::dptList();
		$pod = "";
		if(!empty($permissionArr[0]))
		{
			if(in_array(Consol::AIRCONSOL,$permissionArr[0]))
			{
				$provide[]=['id'=>10,'name'=>'Air Process','type'=>10, 'pod' => $pod];
			}
			if(in_array(Consol::SEACONSOL,$permissionArr[0]))
			{
				$provide[]=['id'=>20,'name'=>'Sea Process','type'=>20, 'pod' => $pod];
			}
			if(!empty($permissionArr[1]))
			{

			}
		}else
		{
			$provide[]=['id'=>10,'name'=>'Air Process','type'=>10, 'pod' => $pod];
			$provide[]=['id'=>20,'name'=>'Sea Process','type'=>20, 'pod' => $pod];
		}
		$provide[]=['id'=>999,'name'=>'Warehouse Process','type'=>999, 'pod' => $pod];

		$filteredData=$filtersForm->filter($provide);
		$dataprovider999=new CArrayDataProvider($filteredData);
		$dataprovider999->pagination=['pageSize' =>10];
		$sort=new CSort();
		$sort->attributes=[
			'number'=>[
				'asc'=>'number ASC',
				'desc'=>'number DESC',
			],
			'status'=>[
				'asc'=>'status ASC',
				'desc'=>'status DESC',
			],
		];
		$sort->defaultOrder = "status ASC";
		$dataprovider999->sort=$sort;

		$kpiService = new KpiService();
		$provide = $kpiService->getConsolProcessMtdKpiReport($permissionArr);
		$list=Org::dptList();
		$pod = "";
		$filteredData=$filtersForm->filter($provide);
		$dataProviderSummary=new CArrayDataProvider($filteredData);
		$dataProviderSummary->pagination=['pageSize' =>10];
		$sort=new CSort();
		$sort->attributes=[
			'number'=>[
				'asc'=>'number ASC',
				'desc'=>'number DESC',
			],
			'status'=>[
				'asc'=>'status ASC',
				'desc'=>'status DESC',
			],
		];
		$sort->defaultOrder = "status ASC";
		$dataProviderSummary->sort=$sort;


		$this->render('index', ['dataProvider999'=>[$dataprovider999,$filtersForm],'dataProvider'=>[$dataprovider,$filtersForm],'dataProvider4'=>[$dataprovider3,$filtersForm],'dataProviderSummary'=>[$dataProviderSummary,$filtersForm],'name'=>'']);
	}
		
	public function actionTypeList()
	{
		$filtersForm = new FiltersForm;
		$filtersForm1 = new FiltersForm1;
		$dpt_id = isset($_GET['pod_id']) ? $_GET['pod_id'] : -1;

		if (isset($_GET['FiltersForm'])) {
		    $filtersForm->filters = $_GET['FiltersForm'];
		}

		if (isset($_GET['FiltersForm1'])) {
		    $filtersForm1->filters = $_GET['FiltersForm1'];
		}

		$provide3 = [];
		$sql = 'SELECT count(*) as number, s.status as status FROM `consol` t 
		        INNER JOIN `consol_process` s ON t.id=s.fid 
		        WHERE t.status != 100 AND t.type in (15,70) AND s.status != 80 
		        AND s.main_type = 1 AND t.dpt_id = :dpt_id 
		        group by s.status ';
		$rs = Yii::app()->db->createCommand($sql)->bindValues([':dpt_id' => $dpt_id])->queryAll();

		foreach ($rs as $id => $r) {
		    $n1 = 0;
		    $n2 = 0;
		    $n3 = 0;

		    $sql = 'SELECT count(*) as number FROM `consol` t 
		            INNER JOIN `consol_process` s ON t.id=s.fid 
		            WHERE t.type in (15,70) AND t.status != 100 AND t.dpt_id = :dpt_id 
		            AND s.status = :status AND s.main_type = 1 
		            AND DATEDIFF(NOW(),eta) <= 1';
		    $n1 = Yii::app()->db->createCommand($sql)
		        ->bindValues([':status' => $r['status'], ':dpt_id' => $dpt_id])
		        ->queryScalar();

		    $sql = 'SELECT count(*) as number FROM `consol` t 
		            INNER JOIN `consol_process` s ON t.id=s.fid 
		            WHERE t.type in (15,70) AND t.status != 100 AND t.dpt_id = :dpt_id 
		            AND s.status = :status AND s.main_type = 1 
		            AND DATEDIFF(NOW(),eta) = 2';
		    $n2 = Yii::app()->db->createCommand($sql)
		        ->bindValues([':status' => $r['status'], ':dpt_id' => $dpt_id])
		        ->queryScalar();

			$params = [
			    ':status' => $r['status'],
			    ':dpt_id' => $dpt_id
			];

			$sql = "SELECT count(*) as number
			        FROM `consol` t 
			        INNER JOIN `consol_process` s ON t.id = s.fid
			        WHERE t.type in (15,70)
			          AND t.status != 100
			          AND s.status = :status
			          AND t.dpt_id = :dpt_id
			          AND s.main_type = 1
			          AND DATEDIFF(NOW(), eta) >= 3";

			$n3 = Yii::app()->db->createCommand($sql)
			    ->bindValues($params)
			    ->queryScalar();

			$provide3[] = [
			    'id' => $id,
			    'number' => $r['number'],
			    'status' => $r['status'],
			    'day1' => $n1,
			    'day2' => $n2,
			    'day3' => $n3
			];
		}


		$filteredData3=$filtersForm1->filter($provide3);
		$dataprovider3=new CArrayDataProvider($filteredData3);
		$dataprovider3->pagination=['pageSize' =>10,];
		$sort=new CSort();
		$sort->attributes=[
			'number'=>[
				'asc'=>'number ASC',
				'desc'=>'number DESC',
			],
			'status'=>[
				'asc'=>'status ASC',
				'desc'=>'status DESC',
			],
		];
		$sort->defaultOrder = "status ASC";
		$dataprovider3->sort=$sort;


		$provide5=[];
		$sql='SELECT count(*) as number, s.status as status FROM `consol` t INNER JOIN `consol_process` s ON t.id=s.fid WHERE t.status!=100 AND t.type in (15,70) AND s.status not in (80,255) AND s.main_type=2 AND  t.dpt_id='.$dpt_id.' group by s.status ';
		$rs=Yii::app()->db->createCommand($sql)->queryAll();
		foreach ($rs as $id=>$r) {
			$n1=0;
			$n2=0;
			$n3=0;
			$sql='SELECT count(*) as number FROM `consol` t INNER JOIN `consol_process` s ON t.id=s.fid WHERE t.type in(15,70) AND t.status!=100 AND t.dpt_id=:dpt_id AND s.status=:status  AND s.main_type=2 AND DATEDIFF(NOW(),eta)<=14';
			$n1=Yii::app()->db->createCommand($sql)->bindValues([':status'=>$r['status'],':dpt_id'=>$dpt_id])->queryScalar();
			$sql='SELECT count(*) as number FROM `consol` t INNER JOIN `consol_process` s ON t.id=s.fid WHERE t.type in(15,70)  AND t.status!=100 AND t.dpt_id=:dpt_id AND s.status=:status AND s.main_type=2 AND DATEDIFF(NOW(),eta)>14 AND DATEDIFF(NOW(),eta)<=30';
			$n2=Yii::app()->db->createCommand($sql)->bindValues([':status'=>$r['status'],':dpt_id'=>$dpt_id])->queryScalar();
			$sql='SELECT count(*) as number FROM `consol` t INNER JOIN `consol_process` s ON t.id=s.fid WHERE t.type in(15,70)  AND t.status!=100 AND s.status=:status AND t.dpt_id=:dpt_id AND s.main_type= 2 AND DATEDIFF(NOW(),eta)>30';
			$n3=Yii::app()->db->createCommand($sql)->bindValues([':status'=>$r['status'],':dpt_id'=>$dpt_id])->queryScalar();
			$provide5[]=['id'=>$id,'number'=>$r['number'],'status'=> $r['status'],'day1'=>$n1,'day2'=>$n2,'day3'=>$n3];
		}
		$filteredData5=$filtersForm1->filter($provide5);
		$dataprovider5=new CArrayDataProvider($filteredData5);
		$dataprovider5->pagination=['pageSize' =>10,];
		$sort=new CSort();
		$sort->attributes=[
			'number'=>[
				'asc'=>'number ASC',
				'desc'=>'number DESC',
			],
			'status'=>[
				'asc'=>'status ASC',
				'desc'=>'status DESC',
			],
		];
		$sort->defaultOrder = "status ASC";
		$dataprovider5->sort=$sort;






		$provide=[];
		$list=Org::dptList();
		$name=isset($list[$dpt_id])?$list[$dpt_id]:"";
		$pod = preg_replace('/\s+.+$/', '', Org::model()->findByPk($_GET["pod_id"])->name);
		$provide[]=['id'=>10,'name'=>'Air Process','type'=>10, 'pod' => $pod];
		$provide[]=['id'=>20,'name'=>'Sea Process','type'=>20, 'pod' => $pod];
		$provide[]=['id'=>999,'name'=>'Warehouse Process','type'=>999, 'pod' => $pod];

		$filteredData=$filtersForm->filter($provide);
		$dataprovider=new CArrayDataProvider($filteredData);
		$dataprovider->pagination=['pageSize' =>10];
		$sort=new CSort();
		$sort->attributes=[
			'number'=>[
				'asc'=>'number ASC',
				'desc'=>'number DESC',
			],
			'status'=>[
				'asc'=>'status ASC',
				'desc'=>'status DESC',
			],
		];
		$sort->defaultOrder = "status ASC";
		$dataprovider->sort=$sort;
		$this->render('sub_type_list', ['dataProvider2'=>[$dataprovider,$filtersForm],'dataProvider3'=>[$dataprovider3,$filtersForm1],'name'=>$name,'dataProvider5'=>[$dataprovider5,$filtersForm1]]);
	}

	public function actionPodList()
	{
		$filtersForm=new FiltersForm;
		$typeId=isset($_GET['type_id'])?$_GET['type_id']:-1;
		if (isset($_GET['FiltersForm'])) {
			$filtersForm->filters=$_GET['FiltersForm'];
		}
		
		$provide1=[];
		$dpts = [
			['id' => -1, 'pod_id' => -1, 'pod' => '    All'],
			['id' => 1, 'pod_id' => 106, 'pod' => '    Sydney'],
			['id' => 2, 'pod_id' => 218, 'pod' => '   Melbourne'],
			['id' => 3, 'pod_id' => 530, 'pod' => '  Brisbane'],
			['id' => 4, 'pod_id' => 811, 'pod' => ' Perth'],
			['id' => 5, 'pod_id' => 529, 'pod' => 'Adelaide'],
			['id' => 6, 'pod_id' => 2936, 'pod' => 'Fremantle'],
		];

		$_GET['name'] = !isset(Consol::$services[$_GET['type_id']])?"Warehouse Process":Consol::$services[$_GET['type_id']];

		foreach($dpts as $dpt){
			if($dpt['pod_id']<0)
			{
				$sql='SELECT count(*) as number FROM `consol` t INNER JOIN `consol_process` s ON t.id=s.fid WHERE t.status!=100 AND t.type in (15,70) AND s.status<80 AND t.service='.$typeId.' ';
			}elseif($typeId==999)
			{
				$sql='SELECT count(*) as number FROM `consol` t INNER JOIN `consol_process` s ON t.id=s.fid WHERE t.status!=100 AND t.type in (15,70) AND s.status=24'.' AND dpt_id= '.$dpt['pod_id'].' ';
			}else
			{
				$sql='SELECT count(*) as number FROM `consol` t INNER JOIN `consol_process` s ON t.id=s.fid WHERE t.status!=100 AND t.type in (15,70) AND s.status<80 AND t.service='.$typeId.' AND dpt_id='.$dpt['pod_id'].' ';
			}
			$rs=Yii::app()->db->createCommand($sql)->queryAll();
			$n = 0;
			if(!empty($rs))
			{
				$n = $rs[0]['number'];
			}
			$dpt['pod'] = $dpt['pod']."(".$n.")";
			$provide1[]=$dpt;
		}

		$dataprovider2=new CArrayDataProvider([]);
		$dataprovider5=new CArrayDataProvider([]);
		$filterData1=$filtersForm->filter($provide1);
		$dataprovider1=new CArrayDataProvider($filterData1);
		$dataprovider1->pagination=['pageSize'=>10];
		$sort=new CSort();
		$sort->defaultOrder = "pod";
		$dataprovider1->sort=$sort;


		$this->render('pod_list', ['dataProvider1'=>[$dataprovider1,$filtersForm]]);
	}
		
	/**
	 * Air and normal consol list;
	 */
	public function actionConsolList()
	{
		$consol=new Consol('search');
		$consol->unsetAttributes();
		$consol->process_not_status=[80];
		$podid=$_GET['pod_id'];
		if($podid>0)
		{
			$consol->dpt_id=$podid;
		};
		$consol->cargoType=@$_GET['ImcoConsol']['cargoType'];
		$consol->service=10;
		if (isset($_GET['Consol'])) {
			$consol->setAttributes($_GET['Consol']);
		}

		if (isset($_GET['status'])) {
			if (!empty($_GET['status'])) {
				$consol->setAttribute('process_status', $_GET['status']);
			}
			$this->renderPartial('_sub_consols', [
				'consol' => $consol,
				'name' => 'All',
			]);
			return;
		}



		$filtersForm=new FiltersForm;
		if (isset($_GET['FiltersForm'])) {
			$filtersForm->filters=$_GET['FiltersForm'];
		}
		$provide=[];
		$dptIdStr = "";
		if($podid>0)
		{
			$dptIdStr = ' AND t.dpt_id='.$podid;
		}

		$permissionArr = ConsolProcessService::getUserPermission();
		$serviceStr = "";
		$statusStr = "";
		if(!empty($permissionArr[0]))
		{
			$serviceStr = " and service in (".join(',',$permissionArr[0]).")";
		}

		if(!empty($permissionArr[1]))
		{
			$statusStr = " and s.status".$permissionArr[1];
		}


		$sql='SELECT count(*) as number, s.status as status FROM `consol` t INNER JOIN `consol_process` s ON t.id=s.fid WHERE t.status!=100 AND t.type in (15,70,90) AND s.status<80 AND main_type=1 '.$dptIdStr.$serviceStr.$statusStr.' group by s.status ';
		$rs=Yii::app()->db->createCommand($sql)->queryAll();
		foreach ($rs as $id=>$r) {
			$n1=0;
			$n2=0;
			$n3=0;
			$sql='SELECT count(*) as number FROM `consol` t INNER JOIN `consol_process` s ON t.id=s.fid WHERE t.type in(15,70,90) AND t.status!=100 AND s.status=:status AND DATEDIFF(NOW(),eta)<=1 AND s.main_type=1 '.$dptIdStr.$serviceStr.$statusStr;
			$n1=Yii::app()->db->createCommand($sql)->bindValues([':status'=>$r['status']])->queryScalar();
			$sql='SELECT count(*) as number FROM `consol` t INNER JOIN `consol_process` s ON t.id=s.fid WHERE t.type in(15,70,90)  AND t.status!=100 AND s.status=:status AND DATEDIFF(NOW(),eta)=2 AND s.main_type=1 '.$dptIdStr.$serviceStr.$statusStr;
			$n2=Yii::app()->db->createCommand($sql)->bindValues([':status'=>$r['status']])->queryScalar();
			$sql='SELECT count(*) as number FROM `consol` t INNER JOIN `consol_process` s ON t.id=s.fid WHERE t.type in(15,70,90)  AND t.status!=100 AND s.status=:status AND DATEDIFF(NOW(),eta)>=3 AND s.main_type=1 '.$dptIdStr.$serviceStr.$statusStr;
			$n3=Yii::app()->db->createCommand($sql)->bindValues([':status'=>$r['status']])->queryScalar();
			$provide[]=['id'=>$id,'number'=>$r['number'],'status'=> $r['status'],'day1'=>$n1,'day2'=>$n2,'day3'=>$n3];
		}
		$filteredData=$filtersForm->filter($provide);
		$dataprovider=new CArrayDataProvider($filteredData);
		$dataprovider->pagination=['pageSize' =>10,];
		$sort=new CSort();
		$sort->attributes=[
			'number'=>[
				'asc'=>'number ASC',
				'desc'=>'number DESC',
			],
			'status'=>[
				'asc'=>'status ASC',
				'desc'=>'status DESC',
			],
		];
		$sort->defaultOrder = "status ASC";
		$dataprovider->sort=$sort;

		$permissionArr = ConsolProcessService::getUserPermission();
		$this->render('consol_list', ['dataProvider'=>[$dataprovider,$filtersForm],'consol'=>$consol,'permissionArr'=>$permissionArr]);
	}
		
	/**
	 * sea consol_list
	 */
	public function actionSeaConsolList()
	{
		$filtersForm=new FiltersForm;
		if (isset($_GET['FiltersForm'])) {
			$filtersForm->filters=$_GET['FiltersForm'];
		}
		$provide=[];
		$result=[];
		$id=1;
		$podid=$_GET['pod_id'];
		$dptIdStr = "";
		if($podid>0)
		{
			$dptIdStr = ' AND t.dpt_id='.$podid;
		}

		$permissionArr = ConsolProcessService::getUserPermission();
		$serviceStr = "";
		$statusStr = "";
		if(!empty($permissionArr[0]))
		{
			$serviceStr = " and service in (".join(',',$permissionArr[0]).")";
		}

		if(!empty($permissionArr[1]))
		{
			$statusStr = " and s.status".$permissionArr[1];
		}


		foreach (ConsolProcess::$newSeaStates as $state=>$name) {
			$sql='SELECT count(*) as number, s.status as status FROM `consol` t INNER JOIN `consol_process` s ON t.id=s.fid WHERE t.status!=100 AND t.type in (15,70) AND s.main_type=2 AND s.status!='.ConsolProcess::SEA_FINISH_STATES.' AND s.status = :status '.$dptIdStr.$serviceStr.$statusStr;
			${$state."exist"}=Yii::app()->db->createCommand($sql)->bindValues([':status'=> $state])->queryScalar();
			$result[$state]=${$state."exist"};
			$n1=0;
			$n2=0;
			$n3=0;
			$sql='SELECT count(*) as number FROM `consol` t INNER JOIN `consol_process` s ON t.id=s.fid WHERE t.type in(15,70) AND t.status!=100 AND DATEDIFF(NOW(),t.eta)<=3 AND s.main_type=2 AND s.status!='.ConsolProcess::SEA_FINISH_STATES.' AND s.status = :status '.$dptIdStr.$serviceStr.$statusStr;
			$n1=Yii::app()->db->createCommand($sql)->bindValues([':status'=>$state])->queryScalar();
			$sql='SELECT count(*) as number FROM `consol` t INNER JOIN `consol_process` s ON t.id=s.fid WHERE t.type in(15,70) AND t.status!=100 AND DATEDIFF(NOW(),t.eta)>3 AND DATEDIFF(NOW(),t.eta)<7 AND s.main_type=2 AND s.status!='.ConsolProcess::SEA_FINISH_STATES.' AND s.status = :status '.$dptIdStr.$serviceStr.$statusStr;
			$n2=Yii::app()->db->createCommand($sql)->bindValues([':status'=>$state])->queryScalar();
			$sql='SELECT count(*) as number FROM `consol` t INNER JOIN `consol_process` s ON t.id=s.fid WHERE t.type in(15,70) AND t.status!=100 AND DATEDIFF(NOW(),t.eta)>=7 AND s.main_type=2 AND s.status!='.ConsolProcess::SEA_FINISH_STATES.' AND s.status = :status '.$dptIdStr.$serviceStr.$statusStr;
			$n3=Yii::app()->db->createCommand($sql)->bindValues([':status'=>$state])->queryScalar();
			$provide[] = ['id' => $id++, 'number' => ${$state . "exist"}, "status" => $state,'status_name'=>$name,'day1'=>$n1,'day2'=>$n2,'day3'=>$n3];
		}
		$filteredData=$filtersForm->filter($provide);
		$dataprovider=new CArrayDataProvider($filteredData);
		$dataprovider->pagination=['pageSize' =>10,];
		$sort=new CSort();
		$sort->defaultOrder = "status ASC";
		$dataprovider->sort=$sort;
		$consol=new Consol('search');
		$consol->unsetAttributes();
		$consol->process_not_status=[ConsolProcess::SEA_FINISH_STATES, ConsolProcess::STATE_CONSOL_PROCESS_DONE];
		if($podid>0)
		{
			$consol->dpt_id=$podid;
		};
		$consol->cargoType=@$_GET['ImcoConsol']['cargoType'];
		$consol->service=20;
		if (isset($_GET['Consol'])) {
			$consol->setAttributes($_GET['Consol']);
		}
		if (isset($_GET['ImcoConsol'])) {
			$imcoAttr = [];
			foreach ($_GET['ImcoConsol'] as $key => $value) {
				if(!empty($value))
				{
					$imcoAttr[$key] = $value;
				}
			}

			$consol->setAttributes($imcoAttr);
		}
		$permissionArr = ConsolProcessService::getUserPermission();
		$this->render('sea_consol_list', ['dataProvider'=>[$dataprovider,$filtersForm],'consol'=>$consol,'permissionArr'=>$permissionArr]);
	}

