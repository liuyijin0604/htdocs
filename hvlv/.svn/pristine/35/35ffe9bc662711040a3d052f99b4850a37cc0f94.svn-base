	private function getExceptionShipmentModel($podId,$consolType)
	{
		$model=new Consol('search');
		$model->unsetAttributes();
		if (!empty($_GET['ImcoConsol'])) {
			$model->setAttributes($_GET['ImcoConsol']);
		}
		if($podId>0)
		{
			$model->dpt_id=$podId;
		}
		$model->service=$consolType;
		$allData = $model->search(false, 30,false,false,false,true)->data;
		$ids = array_column($allData,"id");
		if(empty($ids))
		{
			$ids = -1;
		}

		$model = new ImportsUnknownShipment('search');
		$model->unsetAttributes();
		if(!empty($_GET['ImportsUnknownShipment']))
		{
			$model->setAttributes($_GET['ImportsUnknownShipment']);
		}
		$model->consol_id = $ids;
		return $model;
	}
		
