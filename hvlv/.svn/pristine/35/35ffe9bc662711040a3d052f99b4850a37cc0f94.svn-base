	public function actionSeaOperationUpdate($id)
	{
		$id = $_GET["id"];
		$consol = new Consol();
		$ids = [];
		$result =[];
		$ids = explode(Process::IP_SEPERATOR,$id);

		foreach ($ids as $key => $id) {
			$consol = Consol::model()->findByPk($id);
			$this->saveSeaOperationUpdate($consol);
		}

		echo 'done';
	}

	private function saveSeaOperationUpdate($consol)
	{
		if(!empty($_POST['Consol']['eta']))
		{
			$consol->eta = $_POST['Consol']['eta'];
		}

		$consol->update('eta');
	}

