	public function actionCreateInvoice($id)
	{
		$process = ConsolProcess::model()->findByPk($id);
		$model=$process->consol->getReal();
		$imconsolService = new ImConsolService();
		if (!empty($_POST['mdata'])) {
			foreach ($_POST['mdata'] as $k=>$v) {
				$model->mdata[$k] = $v;
			}
		}
		$model->save();
		// create invoice for special import agent client
		if (!empty($_POST['gen_inv'])) {
			if ($_POST['gen_inv'] == 1) {
				$selectedOrg = !empty($_POST['inv_client_select']) ? [$_POST['inv_client_select']] : [];
				$errors = $model->genSpecialInvoice(false, false, $selectedOrg);
				if (!empty($errors) && (sizeof($errors) > 1 || !in_array($errors[0], ['Invoice created', 'Credit Note created', 'Total Amount does not changed']))) {
					$model->addError('GenInvoice Failed', implode('; ', $errors));
				}
			}
		}
		if (!empty($_POST['gen_air_type_inv'])) {
			if ($_POST['gen_air_type_inv'] == 1) {
				$errors = $model->genLooseInvoice(false);
				if (!empty($errors)) {
					$model->addError('GenInvoice Failed', implode('; ', $errors));
				}
			}
		}
		// create invoice for awb difference
		if (!empty($_POST['gen_awb_inv'])) {
			if ($_POST['gen_awb_inv'] == 1) {
				$errors = $model->genAwbDiffInvoice();
				if (!empty($errors)) {
					$model->addError('GenInvoice Failed', implode('; ', $errors));
				}
			}
		}

		// create invoice for clearance invoice
		if (!empty($_POST['gen_clearance_inv'])) {
			if ($_POST['gen_clearance_inv'] == 1) {
				$errors = $imconsolService->genClearanceInvoice($model);
				if (!empty($errors)) {
					$model->addError('Gen AQ Invoice Failed', implode('; ', $errors));
				}
			}
		}

		if (!empty($model->getErrors())) {
			var_dump($model->getErrors());
		} else {
			echo 'done';
		}
	}
	public function actionGenDirectConsolInvoice($id)
	{
		$process = ConsolProcess::model()->findByPk($id);
		$model=$process->consol->getReal();
		if (!empty($_POST['gen_inv'])) {
			if ($_POST['gen_inv'] == 1) {
				$errors = $model->genInvoice();
				if (!empty($errors)) {
					$model->addError('make Invoice Failed', $errors[0]);
				}
			}
		}
		if (!empty($model->getErrors())) {
			var_dump($model->getErrors());
		} else {
			echo 'done';
		}
	}
	public function actionExport()
	{
		$model=new ImcoConsol('search');
		$model->unsetAttributes();  // clear any default values
		if (isset($_GET['ImcoConsol'])) {
			$model->attributes=$_GET['ImcoConsol'];
		}
		$model->process_not_status=[80];
		$model->dpt_id=$_GET['pod_id'];

		$dp = $model->search(false);
		$xls = new oExcel;
		$i = 1;
		$xls->addRow($i++, ['Consol No','Awb','Customer','Depot','Status','process status','Flight No.', 'eta', 'Process Note', 'No of shipments', 'weight']);
		foreach ($dp->data as $r) {
			$process_status=$r->getProcessStatus();
			$xls->addRow($i++, [$r->no, $r->getReal()->awb, $r->getReal()->getOwnerName(),$r->depot->name,$r->getReal()->getStatus(),$process_status,$r->getReal()->flight,$r->eta,@$r->process->mdata["process_note"],$r->getReal()->totShipments(),$r->getReal()->totWeight()]);
		}
		$xls->output('imco_search_export_'.time().'.xlsx');
	}
	public function actionNotes($id)
	{
		$model = ConsolProcess::model()->findByPk($id);
		Log::add($model, Log::LOG_TYPE_NOTES, ['notes' => $_POST['notes']]);
		$this->ajaxResult($model);
	}

	public function actionSplitConsol()
	{
		$model = new ShadowConsol();
		if(!empty($_POST))
		{
			$consoLNo = $_POST['no'];
			if(empty($consoLNo))
			{
				$model->addError("Consol No. Empty","Consol No. Empty");
				$this->ajaxResult($model);
			}


			$consol = Consol::model()->find("no = :no",[":no"=>$consoLNo]);
			if(empty($consoLNo))
			{
				$model->addError("Consol No. can not be found","Consol No. can not be found");
				$this->ajaxResult($model);
			}
			$consolProcess = $consol->process;
			
			$count = count($consol->shadowMap)+1;

			$shadowConsol = new ShadowConsol('search');
			$shadowConsol->setAttributes($consol->getAttributes());
			if(!empty($_POST['airline']))
			{
				$shadowConsol->airline = $_POST['airline'];
			}
			if(!empty($_POST['flight']))
			{
				$shadowConsol->flight = $_POST['flight'];
			}
			if(!empty($_POST['eta']))
			{
				$shadowConsol->eta = $_POST['eta'];
			}
			$shadowConsol->id = null;
			$shadowConsol->no = $consol->no."-S".$count;
			$shadowConsol->mdata['ubmsent'] = 0;
			$shadowConsol->type = ShadowConsol::$my_type;
			$shadowConsol->save();
			$consolProcessShadow = $shadowConsol->process;
			if(empty($consolProcessShadow))
			{
				$consolProcessShadow = new ConsolProcess();
				$consolProcessShadow->setAttributes($consolProcess->getAttributes());
			}else
			{
				$cid = $consolProcessShadow->id;
				$consolProcessShadow->setAttributes($consolProcess->getAttributes());
				$consolProcessShadow->id = $cid;
			}

			$consolProcessShadow->setAttributes($consolProcess->getAttributes());
			$consolProcessShadow->fid = $shadowConsol->id;
			$consolProcessShadow->status = ConsolProcess::STATE_WAITING_SEND_UBM;
			$consolProcessShadow->save();
			$consolShadowMap = new ConsolShadowMap();
			$consolShadowMap->consol_id = $consol->id;
			$consolShadowMap->shadow_id = $shadowConsol->id;
			$consolShadowMap->save();
			$this->ajaxResult($shadowConsol);


		}else
		{
			$this->render("split_consol");
		}
	}

	public function actionGeneratePortCharge()
	{
		$id = $_GET["id"];
		$consol = $this->loadModel($id);
		$seaConsolService = new SeaConsolService();
		$reconcileService = new ReconcileService();
		$data = $_POST['port_charge'];
		$consol->process->mdata['port_charge'] = $data;
		$consol->process->updateMeta();
		$result = $seaConsolService->updateSeaConsolPortChargeFlexibleRate($consol,$data);
		if($result['done'])
		{
			echo json_encode($reconcileService->generatePortChargeSiReconcile($consol,$data));
		}else
		{
			echo json_encode($result);
		}
	}

	public function actionSeaDocumentationOperation()
	{
		$id = $_GET['id'];
		$processType = $_GET['process_type'];
		$model = $this->loadModel($id);
		if (empty($model->mdata['ubm_dest'])) {
			$model->mdata['ubm_dest'] = $model->getEstID();
			$model->save();
		}
		$this->render("sea_documentation_operation",["processType"=>$processType,'model'=>$model,'process'=>$model->process]);
	}

	public function actionEditCartageEmail()
	{
		$id = $_GET["id"];
		$ids = [];
		if(strpos($id,Process::IP_SEPERATOR))
		{
			$ids = explode(Process::IP_SEPERATOR,$id);
		}else
		{
			$ids[] = $id;
		}

		$seaConsolService = new SeaConsolService();
		[$model,$data] = $seaConsolService->editCartageEmail($_POST,$_GET,$ids);
		if($data===1)
		{
			$this->ajaxResult($model);
		}
		$this->render('//importsMail/create_email', ['model' => $model,'data'=>$data]);

	}

	public function actionExceptionShipmentOperation()
	{
		$model = ImportsUnknownShipment::model()->findByPk($_GET["id"]);
		if(!empty($_POST))
		{
			$model->comment = $_POST['comment'];
			$model->save();
			echo "done";
			return;
		}
		$this->render("exception_shipment_operation",['model'=>$model]);
	}

	public function actionSeaUpdate($id)
	{
		//$model= $this->loadModel($id);
		$process = ConsolProcess::model()->findByPk($id);
		if (!empty($_POST)) {
			// print_r($_POST);
			// print_r($id);
			// Yii::app()->end();
			foreach ($_POST as $k=>$v) {
				$process->mdata[$k]=$v;
			}
			if ($process->save()) {
				echo 'done';
			} else {
				echo 'failed save';
			}
		}
	}
		
	public function loadModel($id)
	{
		$model= Consol::model()->findByPk($id);
		if ($model===null) {
			throw new CHttpException(404, 'The requested page does not exist.');
		}
		return $model;
	}
}
