	public function actionUpdate($id)
	{
		//$model= $this->loadModel($id);
		$process = ConsolProcess::model()->findByPk($id);
		if (!empty($_POST)) {
			foreach ($_POST as $k=>$v) {
				if ($k=='airport') {
					$process->airport=$v;
					continue;
				}
				if ($k=='deadtime_for_pickup') {
					if (preg_match('/(\d{4}\-\d{2}\-\d{2})/i', $v, $m)) {
						$process->pick_dead_date=$m[1]." 16:00:00";
					}
				}
				$process->mdata[$k]=$v;
			}
			if ($process->save()) {
				echo 'done';
			} else {
				echo 'failed save';
			}
		}
	}
	public function actionSendMsgToDriver($id)
	{
		$process = ConsolProcess::model()->findByPk($id);
		$model=$process->consol->getReal();
		if (!empty($_POST['msg_to_driver'])) {
			$model->mdata['msg_to_driver']=$_POST['msg_to_driver'];
			$model->mdata['driver_tel_no']=$_POST['driver_tel_no'];
			$msg= $model->mdata['msg_to_driver'];
			$no=$model->mdata['driver_tel_no'];
			if (Sms::sendMessageLocal($no, $msg)) {
				$model->custom_log_note=$msg;
				$model->save();
			}
			$this->ajaxResult($model);
		}
		if (empty($model->mdata['msg_to_driver'])) {
			$msg="can you go to ".@$model->airport."  to pick up ".@$model->mdata['pmc_for_pickup']." before the dead time:".@$model->mdata['deadtime_for_pickup']." 16:00";
			$model->mdata['msg_to_driver']=$msg;
		}
		$this->render('msg_driver', ['model'=>$model]);
	}
		
