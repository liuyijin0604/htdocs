		]);
	}
	/*
	* change the shipmentProcess status
	*/
	public function actionProcess()
	{
		if (empty($_GET['id'])||empty($_GET['status'])) {
			return false;
		} else {
			$process= ConsolProcess::model()->findByPk($_GET['id']);
			$result = $process->updateStatus($_GET['status']);
			if($result ==1)
			{
				echo 'done';
			}else
			{
				echo $result;
			}
		}
		return true;
	}

