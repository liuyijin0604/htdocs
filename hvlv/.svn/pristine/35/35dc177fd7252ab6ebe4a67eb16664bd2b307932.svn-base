 <script type="text/javascript">
 	$(function(){
 	var tab = $("#<?=$_GET['tabid'];?>");
	var panel = tab.data('panel');
	var ccheck =0;
	var rcheck =0;
	var urcheck = 0;
	function uploading_on(obj) {
		obj.addClass('uploading');
		obj.val('    Uploading');
		obj.prop('disabled', 'disabled');
	}

	function uploading_off(obj) {
		obj.removeClass('uploading');
		obj.val('Submit');
		obj.removeProp('disabled');
	}
    $('#<?=$_GET['tabid'].$title?>_invoice').on('click',function()
	{
		var consolIds = [];
		var refIds = [];

		var consolStr="";
		var refStr="";

		$.each($("input[name='consolIds']:checkbox:checked"),function(){
	        consolIds.push($(this).val());
	    });

	    $.each($("input[name='refs']:checkbox:checked"),function(){
	        refIds.push($(this).val());
	    });

	    for(var i=0;i<consolIds.length;i++){
	    	consolStr+=consolIds[i]+","
	    }

	    for(var i=0;i<refIds.length;i++){
	    	refStr+=refIds[i]+","
	    }

	    if( confirm('Are you sure to Generate <?=$title?> Invoice?'))
	    {
	    	uploading_on($('#<?=$_GET['tabid'].$title?>_invoice'));

	    	var formData = new FormData();
			formData.append('rec_id', <?=$model->id?>);
			formData.append('consolIds',consolStr);
			formData.append('ids', refStr);
			
			$.ajax({
				url: '<?=Yii::app()->createUrl($url)?>',
				type: 'POST',
				data: formData,
				processData: false,
				contentType: false,
				success: function(r) {
					uploading_off($('#<?=$_GET['tabid'].$title?>_invoice'));
	          		r = JSON.parse(r);
	            	if(r.done==true){
	            	     myApp.alert("success");  
	            	}else{
	            	    myApp.alert(r, false);   
	           		}	
				},
				error: function(r) {
					uploading_off($('#<?=$_GET['tabid'].$title?>_invoice'));
					myApp.alert('System error', false);
				}
			});
	    
	    }
	});

	$('#<?=$_GET['tabid'];?>select_all_consol').on('click',function()
	{
		if(ccheck==0)
		{
			$("input[name='consolIds']").click();
			ccheck = 1;
	    }else
	    {
	    	$("input[name='consolIds']").removeAttr("checked");
	    	ccheck = 0;
	    }
	});

	$('#<?=$_GET['tabid'];?>select_all_ref').on('click',function()
	{
		if(rcheck==0)
		{
			$("input[name='refs']").click();
			rcheck = 1;
	    }else
	    {
	    	$("input[name='refs']").removeAttr("checked");
	    	rcheck = 0;
	    }
	});

	$('#<?=$_GET['tabid'];?>select_all_unknown_ref').on('click',function()
	{
		if(rcheck==0)
		{
			$("input[name='unknown_refs']").click();
			urcheck = 1;
	    }else
	    {
	    	$("input[name='unknown_refs']").removeAttr("checked");
	    	urcheck = 0;
	    }
	});


	$('#<?=$_GET['tabid']?>generate_unknow_ot_invoice').on('click',function()
	{
		var unknownCharge = [];
		var unknownDet = [];
		var refIds = [];

		var chargeStr="";
		var refStr="";
		var detStr = "";

		$.each($("input[name='unknown_refs']:checkbox:checked"),function(){
	        refIds.push($(this).val());
	        unknownCharge.push($("#"+$(this).val()+"unknown_refs_charge").val());
	        unknownDet.push($("#"+$(this).val()+"unknown_det").val());
	    });

	    for(var i=0;i<unknownCharge.length;i++){
	    	chargeStr+=unknownCharge[i]+","
	    }

	    for(var i=0;i<unknownDet.length;i++){
	    	detStr+=unknownDet[i]+","
	    }

	    for(var i=0;i<refIds.length;i++){
	    	refStr+=refIds[i]+","
	    }
	    console.log(refIds);

	    if( confirm('Are you sure to Generate Unknown OT Invoice?'))
	    {
	    	uploading_on($('#<?=$_GET['tabid']?>generate_unknow_ot_invoice'));

	    	var formData = new FormData();
			formData.append('rec_id', <?=$model->id?>);
			formData.append('charges',chargeStr);
			formData.append('invoice_dets',detStr);
			formData.append('ids', refStr);
			
			$.ajax({
				url: '<?=Yii::app()->createUrl("siReconcile/generateUnknownSurchargeInvoice")?>',
				type: 'POST',
				data: formData,
				processData: false,
				contentType: false,
				success: function(r) {
					uploading_off($('#<?=$_GET['tabid']?>generate_unknow_ot_invoice'));
	          		r = JSON.parse(r);
	            	if(r.done==true){
	            	     myApp.alert("success");  
	            	}else{
	            	    myApp.alert(r, false);   
	           		}	
				},
				error: function(r) {
					uploading_off($('#<?=$_GET['tabid']?>generate_unknow_ot_invoice'));
					myApp.alert('System error', false);
				}
			});
	    
	    }
	});
	

	$('#<?=$_GET['tabid']?>dispute_unknown_surcharge').on('click',function()
	{
		var unknownCharge = [];
		var unknownDet = [];
		var refIds = [];

		var chargeStr="";
		var refStr="";
		var detStr = "";

		$.each($("input[name='unknown_refs']:checkbox:checked"),function(){
	        refIds.push($(this).val());
	        unknownCharge.push($("#"+$(this).val()+"unknown_refs_charge").val());
	        unknownDet.push($("#"+$(this).val()+"unknown_det").val());
	    });

	    console.log(refIds);

	    if( confirm('Are you sure to Generate Unknown OT Invoice?'))
	    {
	    	uploading_on($('#<?=$_GET['tabid']?>generate_unknow_ot_invoice'));

	    	var formData = new FormData();
			formData.append('rec_id', <?=$model->id?>);
			formData.append('charges',unknownCharge);
			formData.append('invoice_dets',unknownDet);
			formData.append('ids', refIds);
			formData.append('dpmt',<?=$dpmt?>);
			
			$.ajax({
				url: '<?=Yii::app()->createUrl("siReconcile/createUnknownSurchargeDisputeCase")?>',
				type: 'POST',
				data: formData,
				processData: false,
				contentType: false,
				success: function(r) {
					uploading_off($('#<?=$_GET['tabid']?>dispute_unknown_surcharge'));
	          		r = JSON.parse(r);
	            	if(r.done==true){
	            	     myApp.alert("success");  
	            	}else{
	            	    myApp.alert(r, false);   
	           		}	
				},
				error: function(r) {
					uploading_off($('#<?=$_GET['tabid']?>dispute_unknown_surcharge'));
					myApp.alert('System error', false);
				}
			});
	    
	    }
	});

	});
 </script>