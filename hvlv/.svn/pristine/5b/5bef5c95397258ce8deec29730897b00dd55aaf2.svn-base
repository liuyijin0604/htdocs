</div>

<div id="<?=$_GET["tabid"];?>-dropdown-print" class="dropdown dropdown-tip dropdown-relative dropdown-anchor-right">
	<ul class="dropdown-menu">
		<li><a class="print_pdf" href="#" target="_blank">PDF</a></li>
		<li><a class="print_xls" href="#" target="_blank">EXCEL</a></li>
	</ul>
</div>

<script>
$(function() {
	var tab = $("#<?=$_GET['tabid'];?>");
	var panel = tab.data('panel');

	panel.on('click', 'a.grid_print_btn', function() {
		var drop = $("#<?=$_GET["tabid"];?>-dropdown-print");
		$('.print_pdf', drop).attr('href', $(this).attr('href') + '?type=pdf');
		$('.print_xls', drop).attr('href', $(this).attr('href') + '?type=xls');
	});
});
</script>