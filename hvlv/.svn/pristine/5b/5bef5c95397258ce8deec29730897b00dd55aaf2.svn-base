		array('name' => 'type', 'value' => '$data->getType()',
			'filter' => CHtml::dropDownList('Payment[type]', $model->type, $this->t(array('5' => 'Credit Note')), array('prompt' => $this->t('All')))),
		array('name' => 'currency', 'value' => '$data->getCurrency()',
