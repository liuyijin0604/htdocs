			'template' => '{update}{log}{print}',
			'buttons' => array
			(
				'update' => array(
					'imageUrl' => false,
					'visible' => 'true',
					'url' => 'Yii::app()->createUrl("payment/updateCreditNote", ["id" => $data->id])',
