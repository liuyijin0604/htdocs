<?php 
class InvoiceService extends Service
{
	private $urlBase="https://os.toplogistics.com.au";
	public function exportingInvoiceDiff()
	{
			$inv_file = empty($_FILES['inv_file']) ? [] : $_FILES['inv_file'];
			$errors = [];
			if (empty($inv_file['tmp_name'])) {
				$errors[] = "Invalid Template";
			} else {
				if (preg_match('/csv/i', $inv_file['name'])) {
					$xls = new oExcel('CSV');
					$xls->load($inv_file['tmp_name']);
					$data = $xls->getAll();
				} else if (preg_match('/xlsx/i', $inv_file['name'])) {
					$xls = new oExcel;
					$xls->load($inv_file['tmp_name']);
					$data = $xls->getAll();
				} else if (preg_match('/xls/i', $inv_file['name'])) {
					$xls = new oExcel('Excel5');
					$xls->load($inv_file['tmp_name']);
					$data = $xls->getAll();
				}

				if (empty($_POST['rate_option'])) {
					$errors[] = "rate option is empty";
				}
				$head = $data[1];
				// check format
				$correct = false;
				foreach ($data as $k => $line) {
					yii::log(implode(',', $line), 'warning');
					if (implode(',', $line) == 'Invoice No,Invoice Date,Customer,Created By,Label Number,RF,Con Id,Consignment Type,Charge Level,Charge Type,Weight,Parcel Weight (kg),Parcel Length (cm),Parcel Width (cm),Parcel Height (cm),Satchel Size,Date Issued,Pickup Date,Label Cost (Ex GST),Reference,Additional Notes,Pickup Street Address 1,Pickup Street Address 2,Pickup Town,Pickup Postcode,Destination Street Address 1,Destination Street Address 2,Destination Town,Destination  Postcode,Last Scan Desc,Last Scan Date') {
						$correct = true;
						$type = 1;
						unset($data[$k]);
						break;
					}else if($line[3]=="Invoice No"&&$line[1]=="Customer")
					{
						$correct = true;
						$type = 0;
						unset($data[$k]);
						break;
					}else if($line[1]=="Country"&&$line[2]=="Label"&&$line[1]=="Country"&&$line[9]="Banked Courier"&&$line[27]=="New Price")
					{
						$correct = true;
						$type = 2;
						unset($data[$k]);
						break;
					}else if($line[2]=="Consignment No"&&$line[3]=="Receiver Postcode"&&$line[4]=="Billed Weight"&&$line[5]="Volume"&&$line[6]=="Fuel")
					{
						$correct = true;
						$type = 3;
						unset($data[$k]);
						break;
					}
					unset($data[$k]);
				}
				if (!$correct) {
					$errors[] = 'Invalid template file (Try "Save as .xlsx or .csv" in Excel)';
				}

				if(!empty($errors))
				{
					return $errors;
				}

				$errors = [];

				$total = 0;
				$ourTotal = 0;
				$lines1 = [];
				$lines2 = [];
				$this->getFastwayInvoiceLines($data,$type,$lines1,$lines2,$errors);


				return $this->exportDiffData($type,$lines1,$lines2,$errors,$head,$data);
			}
	}
	private function exportDiffData($type,$lines1,$lines2,$errors,$head,$data)
	{
		if(in_array($type, [0,1,3]))
		{
			switch($type)
			{
				case 0:
				case 1:
					$name = 'Fastway';
				case 3:
					$name = 'TNT';
			}
			$xsl=new oExcel();
			$i=1;
			$xsl->addRow($i++, ['ref','invoice','postcode','weight',$name.' Cost','PCAE Cost','Diff']);
			foreach ($lines1 as $key => $line) {
				$xsl->addRow($i++, $line);
			}

			if(!empty($lines2))
			{
				$xsl->addRow($i++, []);
				$xsl->addRow($i++, ["Empty In Consol"]);
				$xsl->addRow($i++, []);
				foreach ($lines2 as $key => $line) {
					$xsl->addRow($i++, $line);
				}
			}
			$tempfile = Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR.'invoice_diff_export.xlsx';
			$xsl->output($tempfile, null, false);
			return [1,$errors];
		}else
		{
			$xsl=new oExcel();
			$i=1;
			$head[] = 'Customer Weight';
			$head[] = 'Manifest Weight';
			$head[] = 'Is Cubic Weight';
			$head[] = 'Calculated Cubic Weight';
			$head[] = 'Calculated Cubic Cost';
			$head[] = 'Weight Cost';
			$head[] = 'Diff-Weight Cost VS Sys Price';
			$head[] = 'Manifest Weight Cost';
			$head[] = 'Manifest Weight Cost VS Sys Price';
			$xsl->addRow($i++, $head);
			foreach ($data as $key => $line) {
				if(empty($line[2])) continue;
				$thisLine = $line;
				$thisLine[12] = gmdate("Y/m/d H:i", intval(($line[12] - 25569) * 3600 * 24));
				$thisLine[] = $lines1[$line[2]][1];
				$thisLine[] = $lines1[$line[2]][2];
				$thisLine[] = $lines1[$line[2]][4];
				$thisLine[] = $lines1[$line[2]][3];
				$thisLine[] = $lines1[$line[2]][5];
				$thisLine[] = $lines1[$line[2]][6];
				$thisLine[] = $lines1[$line[2]][7];
				$thisLine[] = $lines1[$line[2]][8];
				$thisLine[] = $lines1[$line[2]][9];
				$xsl->addRow($i++, $thisLine);
			}

			$tempfile = Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR.'invoice_diff_export.xlsx';
			$xsl->output($tempfile, null, false);
			return [1,$errors];
		}
	}


	private function getFastwayInvoiceLines($data,$type,&$lines1,&$lines2,&$errors)
	{
		if($type!=2)
		{
			foreach ($data as $k => $line) 
			{
				if($type==0)
				{
					$no = $line[2];
					$invoice = $line[3];
				}else if($type ==1)
				{
					$no = $line[5];
					$invoice = $line[1];
				}else if($type == 3)
				{
					$no = $line[2];
					$invoice = $line[1];
				}

				if (empty($no)) {
					continue;
				}

				if($type==0)
				{
					if (!empty($line[6])) {
						$weight = $line[6];
					} else {
						$errors[] = $no.'line ' . $k . ' column 12, weight is empty';
						continue;
					}
		
				}else if($type==1)
				{
					if (!empty($line[12])) {
						$weight = $line[12];
					} else if (preg_match('/300GM/i', $line[16])) {
						$weight = 0.3;
					} else {
						$errors[] = $no.'line ' . $k . ' column 12, weight is empty';
						continue;
					}
					if (empty($line[19])) {
						$errors[] = $no. 'line ' . $k . ' column 19, value is empty';
						continue;
						// $this->ajaxResult($model);
					}
				}else if($type==3)
				{
					if (!empty($line[4])) {
						$weight = $line[4];
					}else{
						$errors[] = $no. 'line ' . $k . ' column 19, value is empty';
						continue;
						// $this->ajaxResult($model);
					}
				}

				$shipment = ImParcel::model()->find('ref = :ref', [':ref' => $no]);
				if($type==0)
				{

					$value = floatval($line[10]);
					$postcode = $line[19];
					$org_rate_id = $_POST['rate_option'];
				}else if($type==1)
				{
					$value = floatval($line[19]);
					$postcode = $line[29];
					$org_rate_id = $_POST['rate_option'];
				}else if($type==3)
				{
					$value = floatval($line[7]);
					$postcode = @$shipment->cnee->postcode;
					$org_rate_id = ImportChargeCode::TNT_SYDNEY_ID;
					if (preg_match("/PCD\d{9}/", $no)) {
						$org_rate_id = ImportChargeCode::TNT_MELBOURNE_ID;
					}
				}

				$ourRated = Shipment::getCourierCostByShipment($no,$org_rate_id,$weight);
				// add real cost to the shipment
				$manifest_weight = $cust_check_weight = $chargevalue = $our_charge_weight = 0;
				if (!empty($shipment)) {
					$ourRate['consol_id'] = $shipment->consol_id;
					$manifest_weight = isset($shipment->mdata['manifest_weight']) ? floatval($shipment->mdata['manifest_weight']) : 0;
					$cust_check_weight = $shipment->weight;
					$our_charge_weight = floatval(isset($shipment->mdata['charge_client_weight']) ? $shipment->mdata['charge_client_weight'] : $shipment->chargeWeight());
					$chargevalue = number_format($shipment->getCouiercost(), 2, '.', '');
				}
				if(empty($shipment->consol_id))
				{
					$lines2[] = [$no, $invoice, $postcode, $weight, $value, $ourRated['price'], ($value-$ourRated['price'])];
				}else
				{
					$lines1[] = [$no, $invoice, $postcode, $weight, $value, $ourRated['price'], ($value-$ourRated['price'])];
				}
			}
		}
		if($type==2)
		{
			//***********************************type = 2 declare *******************************//
			foreach ($data as $k => $line) 
			{
				if($type==2)
				{
					$no = $line[2];
				}
				if (empty($no)) {
					continue;
				}

				if($type==2)
				{

					$value = floatval($line[27]);
					$postcode = $line[39];
				}
				$weight = $line[22];
				$calculatedWeight = round(($line[23]*$line[24]*$line[25])*0.000001*250,2);
				$ourRated = Shipment::getCourierCostByShipment($no, $_POST['rate_option'],$calculatedWeight);
				$ourRatedWeight = Shipment::getCourierCostByShipment($no, $_POST['rate_option'],$weight);
				$manifestWeightCost =  Shipment::getCourierCostByShipment($no, $_POST['rate_option'],@$shipment->mdata['manifest_weight']);
				$isPao = (round($ourRated['price'],2)==$line[27])?"Yes":"No";
				if (empty($ourRated['price'])) {
					$errors[] =' calculated price is empty';
					$isPao = '';
				}


				$shipment = ImParcel::model()->find('ref = :ref', [':ref' => $no]);
				$lines1[$no] = [$no, @$shipment->weight,@$shipment->mdata['manifest_weight'],$calculatedWeight,$isPao,$ourRated['price'],$ourRatedWeight['price'],$ourRatedWeight['price']-$line[19],$manifestWeightCost['price'],$manifestWeightCost['price']-$line[19]];

			}
		}

	}

	public function createContainerPickupBookingInvoice($booking,$isPayWithAccountCode = false)
	{
		$invoice = Invoice::model()->findByAttributes(['no' => $booking->booking_number]);
		if (empty($invoice)){
			$invoice = new Invoice();
			switch (substr($booking->booking_number, 0, 1)) {
				case "S":
				case "s":
					$invoice->dpt_id = 106;	// TLA SYD
					break;
				case "M":
				case "m":
					$invoice->dpt_id = 218;	// TLA MEL
					break;
				case "B":
				case "b":
					$invoice->dpt_id = 530; // TLA BNE
					break;
			}
			$shipment = ImParcel::model()->findByPk($booking->shipment_id);
			$invoice->mdata['delivery_method'] = 2;
			$invoice->mdata['container_info']=(!empty($shipment->consol->mdata['container_no'])?$shipment->consol->mdata['container_no']:'').'-'.(!empty($shipment->consol->mdata['sea_type'])?DmawbConsol::$containerTypes[$shipment->consol->mdata['sea_type']]:'').'-'.(!empty($shipment->consol->mdata['cargo_type'])?$shipment->consol->mdata['cargo_type']:'');
			$name = $booking->company_name;
			if($isPayWithAccountCode)
			{
				$sellRate = SellRate::findImCode($booking->mdata['account_code']);
				$invoice->status = Invoice::INVOICE_STATUS_PENDING;
				$invoice->to_id = $sellRate->org_id;
				$name = $sellRate->org->name;
			}else
			{
				$invoice->to_id = Org::ORGID_IMPORT_CASUAL_CUSTOMER;
				$invoice->status = Invoice::INVOICE_STATUS_PENDING_PAID;
				$invoice->bflag = Invoice::INVOICE_FLAG_PAYPAL;
			}
			$invoice->mdata['awb'] = $shipment->consol->awb;
			$invoice->consol_id = $shipment->consol->id;
			$invoice->pid = $shipment->id;
			$invoice->dpmt = Invoice::DPMT_IMPORT;
			$invoice->type = Invoice::INVOICE_TYPE_PICKUPBOOKING;
			$invoice->currency = Invoice::CURRENCY_AUD;
			$invoice->no = $booking->booking_number;
			$invoice->date = date('Y-m-d');
			$invoice->due = date('Y-m-d');
			$invoice->posted = date('Y-m-d');
			$invoice->gst =  number_format((float)$booking->fee * 0.1, 2, '.', '');
			$invoice->total = $booking->fee+$invoice->gst;
			if(!$isPayWithAccountCode)
			{
				$invoice->is_paypal = 2;
			}
			$invoice->sync_xero = 0;
			$invoice->mdata['name'] = $name;
			$invoice->mdata['address'] = " ";
			$invoice->save();
		}	
	}

	public function createContainerPickupBookingInvoiceMultiple($pb,$isPayWithAccountCode = false)
	{
		if($pb->total<0.0001) return false;

		$invoice = Invoice::model()->findByAttributes(['no' => $pb->submit_no]);
		if (empty($invoice)){
			$invoice = new Invoice();
			switch (substr($pb->submit_no, 0, 1)) {
				case "S":
				case "s":
					$invoice->dpt_id = 106;	// TLA SYD
					break;
				case "M":
				case "m":
					$invoice->dpt_id = 218;	// TLA MEL
					break;
				case "B":
				case "b":
					$invoice->dpt_id = 530; // TLA BNE
					break;
			}
			$booking = $pb->booking[0];
			$shipment = ImParcel::model()->findByPk($booking->shipment_id);
			$invoice->mdata['delivery_method'] = 2;
			$invoice->mdata['container_info']=(!empty($shipment->consol->mdata['container_no'])?$shipment->consol->mdata['container_no']:'').'-'.(!empty($shipment->consol->mdata['sea_type'])?DmawbConsol::$containerTypes[$shipment->consol->mdata['sea_type']]:'').'-'.(!empty($shipment->consol->mdata['cargo_type'])?$shipment->consol->mdata['cargo_type']:'');
			$name = $booking->company_name;
			if($isPayWithAccountCode)
			{
				$sellRate = SellRate::findImCode($booking->mdata['account_code']);
				$invoice->status = Invoice::INVOICE_STATUS_PENDING;
				$invoice->to_id = $sellRate->org_id;
				$name = $sellRate->org->name;
			}else
			{
				$invoice->to_id = Org::ORGID_IMPORT_CASUAL_CUSTOMER;
				$invoice->status = Invoice::INVOICE_STATUS_PENDING_PAID;
				$invoice->bflag = Invoice::INVOICE_FLAG_PAYPAL;
			}
			$invoice->mdata['awb'] = $shipment->consol->awb;
			$invoice->consol_id = $shipment->consol->id;
			$invoice->pid = $shipment->id;
			$invoice->dpmt = Invoice::DPMT_IMPORT;
			$invoice->type = Invoice::INVOICE_TYPE_PICKUPBOOKING;
			$invoice->currency = Invoice::CURRENCY_AUD;
			$invoice->no = $pb->submit_no;
			$invoice->date = date('Y-m-d');
			$invoice->due = date('Y-m-d');
			$invoice->posted = date('Y-m-d');
			foreach ($pb->booking as $key => $booking) {
				$invoice->gst +=  number_format((float)$booking->fee * 0.1, 2, '.', '');
				$invoice->total +=  number_format((float)$booking->fee+((float)$booking->fee * 0.1), 2, '.', '');
			}
			if(!$isPayWithAccountCode)
			{
				$invoice->is_paypal = 2;
			}
			$invoice->sync_xero = 0;
			$invoice->mdata['name'] = $name;
			$invoice->mdata['address'] = " ";
			$invoice->save();
			return true;
		}
		return false;
	}

	public function createCargoBookingInvoice($booking)
	{
		$shipment = ImParcel::model()->findByPk($booking->shipment_id);
		$invoice = Invoice::model()->findByPk(@$booking->mdata['invoiceId']);
		if (empty($invoice)){
			$invoice = new Invoice('create');
			switch ($booking->depot) {
				case 106:
					$invoice->dpt_id = 106;	// TLA SYD
					break;
				case 218:
					$invoice->dpt_id = 218;	// TLA MEL
					break;
				case 530:
					$invoice->dpt_id = 530; // TLA BNE
					break;
				case 811:
					$invoice->dpt_id = 811; // TLA PER
					break;
			}
			$invoice->mdata['delivery_method'] = 2;
			$invoice->mdata['container_info']=(!empty($shipment->consol->mdata['container_no'])?$shipment->consol->mdata['container_no']:'').'-'.(!empty($shipment->consol->mdata['sea_type'])?DmawbConsol::$containerTypes[$shipment->consol->mdata['sea_type']]:'').'-'.(!empty($shipment->consol->mdata['cargo_type'])?$shipment->consol->mdata['cargo_type']:'');
			$org = Org::model()->findByPk($booking->org_id);
			$name = !empty($org)?$org->name:'';
			
			$invoice->to_id = $booking->org_id;
			$invoice->status = Invoice::INVOICE_STATUS_PENDING;
			//$invoice->bflag = Invoice::INVOICE_FLAG_PAYPAL;
			$invoice->mdata['awb'] = $shipment->consol->awb;
			$invoice->consol_id = $shipment->consol->id;
			$invoice->pid = $shipment->id;
			$invoice->dpmt = Invoice::DPMT_COURIER_SERVICE;
			$invoice->type = Invoice::INVOICE_TYPE_OTHERS;
			$invoice->currency = Invoice::CURRENCY_AUD;
			$invoice->sent = 0;
			
			$invoice->date = date('Y-m-d');
			$invoice->due = date('Y-m-d');
			$invoice->posted = date('Y-m-d');
			$invoice->gst =  number_format((float)$booking->fee * 0.1, 2, '.', '');
			$invoice->total = number_format((float)$booking->fee * 1.1, 2, '.','');
			$invoice->sync_xero = 0;
			$invoice->save();
			$invoice->mdata['name'] = $name;
			$invoice->mdata['awb'] = $shipment->consol->awb;
			$invoice->mdata['address'] = $invoice->cust->getAddress();
			$invoice->mdata['payterm'] = empty($invoice->cust->extra['payterm']) ? 'COD' : $invoice->cust->extra['payterm'] . ' days';
			$invoice->save();
			return $invoice->id;
		}	
	}

	public function printInvoice($id)
	{
		if(!empty($_GET['xls']))
		{
			$model = Invoice::model()->findByPk($id);
			$model->exportExcelInvoice();
		}else if (!empty($_GET['inv_b']))
		{
			$model = Invoice::model()->findByPk($id);
			$model->exportExcelInvoiceB();
		}else
		{
			$model = Invoice::model()->findByPk($id);
			if ($model->type != 60)
			{
				$d = ['inv' => $model];
				if (!empty($_GET['obh']))
				{
					switch ($model->to_id) {
						case 1084:
							$d['behalf'] = 'priority';
							break;
					}
				}
				if (in_array($model->to_id, Org::$displayJobRef) && !empty($model->job->mdata['ref']))
				{
					$no = $model->job->mdata['ref'];
				} else {
					$no = $model->no;
				}
				oPDF::renderPDF('invoice', $d, 1, 'Invoice_' . $no . '.pdf');
			}else
			{
				$ps = [];
				$f1 = tempnam(Yii::app()->basePath . "/runtime", "ivp");
				$f2 = tempnam(Yii::app()->basePath . "/runtime", "ivp");
				oPDF::renderPDF('invoice', ['inv' => $model], 2, $f1);
				oPDF::renderPDF('invoice_detail', ['inv' => $model], 2, $f2);
				$ps = [$f1, $f2];
				if ($model->to_id == 1457) {
					$f3 = tempnam(Yii::app()->basePath . "/runtime", "ivp");
					oPDF::renderPDF('stock_detail', ['inv' => $model], 2, $f3);
					$ps[] = $f3;
				}
				oPDF::mergePDF($ps, 1, true, 'Invoice_' . $model->no . '.pdf');
			}
		}
	}


	public function createPaypallink($invoiceId){
		$data = ["invoice_id"=>$invoiceId];
		$paylink = $this->urlBase . '/payInvoice/paypal.app?token=';
		$iv = str_repeat("\x00", openssl_cipher_iv_length('AES-256-CBC'));
		$token = base64_encode(openssl_encrypt(json_encode($data), 'AES-128-CBC', md5(PoliPaymentApi::PAYLINK_KEY), 0, $iv));
		$paylink .= trim($this->safe_b64encode($token));
		return $paylink;
	}

	public function importExcelInv($file,$invoiceDate,$orgId)
	{

		$data = $this->getFileData($file);
		if(empty($data))
		{
			return ["done"=>false,"msg"=>'Invalid Template'];
		}
		$data = $data[0];
		$model = new Invoice('create');
		$model->type = Invoice::INVOICE_TYPE_OTHERS;
		$model->currency = 1;

		unset($data[1]);
		$dpmt = Invoice::INVOICE_TYPE_IMPORT;
		$model->status = 1;
		$model->dpmt = Invoice::INVOICE_TYPE_IMPORT;
		$model->dpt_id = Org::TLA_DEPARTMENT_SYDNEY;
		$model->to_id = $orgId;
		$model->date = $invoiceDate;
		$model->due = $invoiceDate;
		$model->save();
		$total = 0;
		$tgst = 0;
		foreach ($data as $i => $a) {
			if(!empty($a[3])){
				$il = new InvLine;
				$il->inv_id = $model->id;
				$il->ccode = "83000";
				$il->det = $a[1];
				$il->tax = (($a[6]>0)?"OUTPUT":"EXEMPTOUTPUT");
				$il->rebate =0;
				$il->amount = $a[4];
				$gst = 0;
				if ($il->tax == 'OUTPUT') {
					$gst = floatval($il->amount) * 10 / 100;
				}
				$il->amount += $gst;
				$il->gst = $gst;
				$il->qty = $a[3];
				$il->save();
				$total += $il->amount * $il->qty;
				$tgst += $il->gst * $il->qty;
			}
		}
		$model->total = number_format($total, 2, '.', '');
		$model->gst = number_format($tgst, 2, '.', '');
		$model->mdata['name'] = $model->cust->name;
		$model->mdata['address'] = $model->cust->getAddress();
		$model->mdata['payterm'] = empty($model->cust->extra['payterm']) ? 'COD' : $model->cust->extra['payterm'] . ' days';
		if($model->save())
		{
			$model->refresh();
			return ["done"=>true,"msg"=>'Imported Invoice'.$model->no];
		}
		print_r($model->getErrors());
		return ["done"=>false,"msg"=>''];
	}

	public function importInboundTransaction($file)
	{
		$data = $this->getFileData($file);
		$res = new stdClass;
		if (empty($data)) {
			$res->success = false;
			$res->msg = 'Invalid File';
			return $res;
		}
		return $data;
	}

	public function processInboundTransaction($data, $dateFrom, $dateTo)
	{
		$res = new stdClass;
		$res->data = [];
		$res->errMsg = [];
		$refundBookings = [];
		$rawBookings = [];
		if (!empty($data)) {
			for ($i = 2; $i <= count($data[0]); $i++) {
				$transaction = $data[0][$i];
				/* $createDate = $transaction['2'];
				$createDate = str_replace('/', '-', $createDate); */
				// Skip transactions that do not in selected time range.
				/* if (strtotime($createDate) < strtotime($dateFrom) || strtotime($createDate) > strtotime($dateTo)) {
					continue;
				} */
				$description = $transaction['4'];
				$amount = floatval($transaction['6']);
				$consolNo = '';
				$consolNo = @$transaction['8'];
				$bookingData = new stdClass;
				// Skip transactions that have 0 amount
				if ($amount == 0) {
					continue;
				}
				preg_match("/TL\w+[0-9]+/", $description, $matches);
				$bookingNumber = @$matches[0];
				$bookingDate = substr($bookingNumber, 3, 6);
				$dateFrom = str_replace('-','',$dateFrom);
				$dateTo = str_replace('-','',$dateTo);
				// Skip transactions that do not in selected time range.
				if (intval($bookingDate) < intval($dateFrom) || intval($bookingDate) > intval($dateTo)) {
					continue;
				}
				if (!empty($bookingNumber)) {
					// keep a record of refunded bookings
					if (preg_match("/refund/i", $description)) {
						$refundRecord = new stdClass;
						$refundRecord->bookingNumber = $bookingNumber;
						$refundRecord->consolNo = $consolNo;
						$refundRecord->amount = $amount * -1;
						array_push($refundBookings, $refundRecord);
						continue;
					}
					array_push($rawBookings, $bookingNumber);
					$booking = PickupBooking::model()->findByAttributes(['booking_number' => $bookingNumber]);
					if (empty($booking)) {
						if (empty($consolNo)) {
							$res->errMsg[$bookingNumber] = "Booking " . $bookingNumber . " not found, please insert a consol number at row " . $i . " column H.";
							//array_push($res->errMsg, "Booking " . $bookingNumber . " not found, please insert a consol number at row " . $i . " column H.");
							continue;
						} else {
							$consol = Consol::model()->findByAttributes(['no' => $consolNo]);
							if (empty($consol)) {
								$res->errMsg[$bookingNumber] = "Consol number at row " . $i . " column H incorrect, please check your input.";
								//array_push($res->errMsg, "Consol number at row " . $i . " column H incorrect, please check your input.");
								continue;
							} else {
								if (array_key_exists($consol->no, $res->data)) {
									$bookingData->bookingNumber = $bookingNumber;
									$bookingData->amount = $amount;
									array_push($res->data[$consol->no], $bookingData);
								} else {
									$tempArr = [];
									$bookingData->bookingNumber = $bookingNumber;
									$bookingData->amount = $amount;
									array_push($tempArr, $bookingData);
									$res->data[$consol->no] = $tempArr;
								}
							}
						}
					} else {
						if ($booking->status == PickupBooking::INBOUND_ERROR) {
							// Inbound error booking
							if (empty($consolNo) && empty($booking->mdata['container_no'])) {
								$res->errMsg[$bookingNumber] = "Booking " . $bookingNumber . " has error, please insert a consol number at row " . $i . " column H.";
								//array_push($res->errMsg, "Booking " . $bookingNumber . " has error, please insert a consol number at row " . $i . " column H.");
								continue;
							} else {
								if (!empty($consolNo)){
									$consol = Consol::model()->findByAttributes(['no' => $consolNo]);
									if (empty($consol) && !empty($booking->mdata['container_no'])) {
										$consol = Consol::model()->findByAttributes(['container_no' => $booking->mdata['container_no']]);
									}
									if (empty($consol)) {
										$res->errMsg[$bookingNumber] = "Consol number at row " . $i . " column H incorrect, please check your input.";
										continue;
									}
								}
								
								if (array_key_exists($consol->no, $res->data)) {
									$bookingData->bookingNumber = $bookingNumber;
									$bookingData->amount = $amount;
									array_push($res->data[$consol->no], $bookingData);
								} else {
									$tempArr = [];
									$bookingData->bookingNumber = $bookingNumber;
									$bookingData->amount = $amount;
									array_push($tempArr, $bookingData);
									$res->data[$consol->no] = $tempArr;
								}
								
							}
						} else {
							// correct bookings and cancelled bookings
							if (!empty($booking->shipment_id)) {
								$shipment = ImParcel::model()->findByPk($booking->shipment_id);
								if (!empty($shipment)) {
									$consol = Consol::model()->findByPk($shipment->consol_id);
									if (!empty($consol)) {
										if (array_key_exists($consol->no, $res->data)) {
											$bookingData->bookingNumber = $bookingNumber;
											$bookingData->amount = $amount;
											array_push($res->data[$consol->no], $bookingData);
										} else {
											$tempArr = [];
											$bookingData->bookingNumber = $bookingNumber;
											$bookingData->amount = $amount;
											array_push($tempArr, $bookingData);
											$res->data[$consol->no] = $tempArr;
										}
									} else {
										if (empty($consolNo) && empty($booking->mdata['container_no'])) {
											$res->errMsg[$bookingNumber] = "Consol does not exist, line " . $i;
											//array_push($res->errMsg, "Consol does not exist, line " . $i);
											continue;
										} else {
											if (!empty($booking->mdata['container_no'])) {
												$consol = Consol::model()->findByAttributes(['container_no' => $booking->mdata['container_no']]);
											}
											if (empty($consol) && !empty($consolNo)) {
												$consol = Consol::model()->findByAttributes(['no' => $consolNo]);
											}
											
											if (empty($consol)) {
												$res->errMsg[$bookingNumber] = "Consol number at row " . $i . " column H incorrect, please check your input.";
												//array_push($res->errMsg, "Consol number at row " . $i . " column H incorrect, please check your input.");
												continue;
											} else {
												if (array_key_exists($consol->no, $res->data)) {
													$bookingData->bookingNumber = $bookingNumber;
													$bookingData->amount = $amount;
													array_push($res->data[$consol->no], $bookingData);
												} else {
													$tempArr = [];
													$bookingData->bookingNumber = $bookingNumber;
													$bookingData->amount = $amount;
													array_push($tempArr, $bookingData);
													$res->data[$consol->no] = $tempArr;
												}
											}
										}	
									}
								} else {
									if (empty($consolNo) && empty($booking->mdata['container_no'])) {
										$res->errMsg[$bookingNumber] = "Something went wrong on line " . $i . " insert a consol number at column H.";
										//array_push($res->errMsg, "Something went wrong on line " . $i . " insert a consol number at column H.");
										continue;
									} else {
										if (!empty($booking->mdata['container_no'])) {
											$consol = Consol::model()->findByAttributes(['container_no' => $booking->mdata['container_no']]);
										}
										if (empty($consol) && !empty($consolNo)) {
											$consol = Consol::model()->findByAttributes(['no' => $consolNo]);
										}
										if (empty($consol)) {
											$res->errMsg[$bookingNumber] = "Wrong consol number at line " . $i . " column H, check your input.";
											//array_push($res->errMsg, "Wrong consol number at line " . $i . " column H, check your input.");
											continue;
										} else {
											if (array_key_exists($consol->no, $res->data)) {
												$bookingData->bookingNumber = $bookingNumber;
												$bookingData->amount = $amount;
												array_push($res->data[$consol->no], $bookingData);
											} else {
												$tempArr = [];
												$bookingData->bookingNumber = $bookingNumber;
												$bookingData->amount = $amount;
												array_push($tempArr, $bookingData);
												$res->data[$consol->no] = $tempArr;
											}
										}
									}
								}
							} else {
								// booking's shipment_id is empty, normally it's an inbound error or cancelled booking
								if (empty($consolNo) && empty($booking->mdata['container_no'])) {
									$res->errMsg[$bookingNumber] = "Something went wrong at line " . $i . " insert a consol number at column H.";
									//array_push($res->errMsg, "Something went wrong at line " . $i . " insert a consol number at column H.");
									continue;
								} else {
									if (!empty($booking->mdata['container_no'])) {
										$consol = Consol::model()->findByAttributes(['container_no' => $booking->mdata['container_no']]);
									}
									if (empty($consol) && !empty($consolNo)) {
										$consol = Consol::model()->findByAttributes(['no' => $consolNo]);
									}
									if (empty($consol)) {
										$res->errMsg[$bookingNumber] = "Consol number at row " . $i . " column H incorrect, please check your input.";
										//array_push($res->errMsg, "Consol number at row " . $i . " column H incorrect, please check your input.");
										continue;
									} else {
										if (array_key_exists($consol->no, $res->data)) {
											$bookingData->bookingNumber = $bookingNumber;
											$bookingData->amount = $amount;
											array_push($res->data[$consol->no], $bookingData);
										} else {
											$tempArr = [];
											$bookingData->bookingNumber = $bookingNumber;
											$bookingData->amount = $amount;
											array_push($tempArr, $bookingData);
											$res->data[$consol->no] = $tempArr;
										}
									}
								}
							}
						}
					}
				}
			}
			// remove refunded bookings
			foreach ($res->data as $consolNumber => $bookingNumbers) {
				foreach ($bookingNumbers as $key => $value) {
					foreach ($refundBookings as $refundBooking) {
						if ($value->bookingNumber == $refundBooking->bookingNumber) {
							unset($bookingNumbers[$key]);
						}
					}
				}
				unset($res->data[$consolNumber]);
				$res->data[$consolNumber] = $bookingNumbers;
			}

			// ignore refunded records' error message
			foreach ($refundBookings as $key => $refundBooking) {
				if (array_key_exists($refundBooking->bookingNumber, $res->errMsg)) {
					unset($res->errMsg[$refundBooking->bookingNumber]);
				}
				if (in_array($refundBooking->bookingNumber, $rawBookings)) {
					unset($refundBookings[$key]);
				}
			}

			if (count($refundBookings) > 0) {
				foreach ($refundBookings as $rb) {
					$temp = new stdClass;
					if (empty($rb->consolNo)) {
						$res->errMsg[$rb->bookingNumber] = "Refund " . $rb->bookingNumber . " consol number empty.";
					} else {
						$consol = Consol::model()->findByAttributes(['no' => $rb->consolNo]);
						if (empty($consol)) {
							$res->errMsg[$rb->bookingNumber] = "Refund " . $rb->bookingNumber . " Consol number incorrect.";
						} else {
							if (array_key_exists($consol->no, $res->data)) {
								$temp->bookingNumber = $rb->bookingNumber;
								$temp->amount = $rb->amount;
								array_push($res->data[$consol->no], $temp);
							} else {
								$tempArr = [];
								$temp->bookingNumber = $rb->bookingNumber;
								$temp->amount = $rb->amount;
								array_push($tempArr, $temp);
								$res->data[$consol->no] = $tempArr;
							}
						}
					}
				}
			}
		}
		$res->raw = $rawBookings;
		$res->refund = $refundBookings;
		
		// Calculate total amount in file
		$totalAmount = 0;
		foreach ($res->data as $transactionGroup) {
			foreach($transactionGroup as $t) {
				$totalAmount += $t->amount;
			}
		}
		$totalAmount += (count($res->errMsg) * 15.4);
		$res->totalInFile = $totalAmount;
		return $res;
	}

	public function createInboundBookingInvoice($data, $invDate)
	{
		$statisticsData = new stdClass;
		$totalImported = 0;
		$alreadyImported = 0;
		if (!empty($data) && count($data) > 0) {
			foreach ($data as $key => $value) {
				$consol = Consol::model()->findByAttributes(['no' => $key]);
				switch ($consol->dpt_id) {
					case 106:
						$sql = "SELECT * FROM invoice WHERE consol_id = " . $consol->id . " AND `no` LIKE 'IBS-" . $consol->no . "%' AND `status` != 10";
						break;
					case 218:
						$sql = "SELECT * FROM invoice WHERE consol_id = " . $consol->id . " AND `no` LIKE 'IBM-" . $consol->no . "%' AND `status` != 10";
						break;
					case 530:
						$sql = "SELECT * FROM invoice WHERE consol_id = " . $consol->id . " AND `no` LIKE 'IBB-" . $consol->no . "%' AND `status` != 10";
						break;
				}
				$invoices = Invoice::model()->findAllBySql($sql);
				foreach ($invoices as $oldInvoice) {
					$alreadyImported += $oldInvoice->total;
				}
				switch ($consol->dpt_id) {
					case 106:
						$sql = "SELECT * FROM invoice WHERE consol_id = " . $consol->id . " AND `no` LIKE 'IBS-" . $consol->no . "%'";
						break;
					case 218:
						$sql = "SELECT * FROM invoice WHERE consol_id = " . $consol->id . " AND `no` LIKE 'IBM-" . $consol->no . "%'";
						break;
					case 530:
						$sql = "SELECT * FROM invoice WHERE consol_id = " . $consol->id . " AND `no` LIKE 'IBB-" . $consol->no . "%'";
						break;
				}
				$allInvoices = Invoice::model()->findAllBySql($sql);
				$invoice = new Invoice();
				$invoice->dpt_id = $consol->dpt_id;
				$invoice->to_id = Org::ORGID_CLIENT_INBOUND;
				$invoice->status = Invoice::INVOICE_STATUS_POSTED;
				$invoice->consol_id = $consol->id;
				$invoice->dpmt = Invoice::DPMT_IMPORT;
				$invoice->type = Invoice::INVOICE_TYPE_INBOUNDBOOKING;
				$invoice->currency = Invoice::CURRENCY_AUD;
				switch ($consol->dpt_id) {
					case 106:
						$invoice->no = 'IBS-' . $consol->no . '-' . (count($allInvoices) + 1);
						break;
					case 218:
						$invoice->no = 'IBM-' . $consol->no . '-' . (count($allInvoices) + 1);
						break;
					case 530:
						$invoice->no = 'IBB-' . $consol->no . '-' . (count($allInvoices) + 1);
						break;
				}
				$invoice->date = date('Y-m-d', strtotime($invDate));
				$invoice->due = date('Y-m-d', strtotime($invDate));
				$invoice->posted = date('Y-m-d', strtotime($invDate));
				$invoice->mdata['name'] = 'Inbound Technologies Pty Ltd';
				$invoice->mdata['address'] = '';
				$total = 0;
				foreach ($value as $transaction) {
					$invLineCheck = InvLineCheck::model()->findByAttributes(['booking_number' => $transaction->bookingNumber]);
					if (!empty($invLineCheck)) {
						$invoiceLine = InvLine::model()->findByPk($invLineCheck->inv_line_id);
						if (!empty($invoiceLine)) {
							$oldInvoice = Invoice::model()->findByPk($invoiceLine->inv_id);
							if (!empty($oldInvoice) && $oldInvoice->status != Invoice::INVOICE_STATUS_CACELLED) {
								continue;
							} else {
								$total += $transaction->amount;
							}
						} else {
							$total += $transaction->amount;
						}
					} else {
						$total += $transaction->amount;
					}
					//$sql = "SELECT * FROM inv_line WHERE meta LIKE '%\"booking\":\"" . $transaction->bookingNumber . "\"%'";
					/* $invoiceLine = InvLine::model()->findBySql($sql);
					if (!empty($invoiceLine)) {
						continue;
					} else {
						$total += $transaction->amount;
					} */
				}
				if ($total == 0) {
					continue;
				}
				$invoice->total = $total;
				$invoice->gst = number_format((float)($total - $total/1.1), 2, '.', '');
				$invoice->sync_xero = 0;
				if ($invoice->save()) {
					$totalImported += $invoice->total;
					foreach ($value as $transaction) {
						$invLineCheck = InvLineCheck::model()->findByAttributes(['booking_number' => $transaction->bookingNumber]);
						if (empty($invLineCheck)) {
							$invoiceLine = new InvLine();
							$invoiceLine->inv_id = $invoice->id;
							$invoiceLine->model = 'ImcoConsol';
							$invoiceLine->fid = 0;
							$invoiceLine->ccode = 'Inbound Booking';
							$invoiceLine->amount = number_format((float)$transaction->amount, 2, '.', '');
							$invoiceLine->gst = number_format((float)($transaction->amount - $transaction->amount/1.1), 2, '.', '');
							$invoiceLine->det = $transaction->bookingNumber . ' Booking Base Fee';
							$invoiceLine->qty = 1;
							$invoiceLine->mdata["booking"] = $transaction->bookingNumber;
							$invoiceLine->save();
							$invLineCheck = new InvLineCheck();
							$invLineCheck->booking_number = $transaction->bookingNumber;
							$invLineCheck->inv_line_id = $invoiceLine->id;
							$invLineCheck->save();
						} else {
							$invoiceLine = InvLine::model()->findByPk($invLineCheck->inv_line_id);
							if (!empty($invoiceLine)) {
								$oldInvoice = Invoice::model()->findByPk($invoiceLine->inv_id);
								if (empty($oldInvoice) || $oldInvoice->status == Invoice::INVOICE_STATUS_CACELLED) {
									$invoiceLine = new InvLine();
									$invoiceLine->inv_id = $invoice->id;
									$invoiceLine->model = 'ImcoConsol';
									$invoiceLine->fid = 0;
									$invoiceLine->ccode = 'Inbound Booking';
									$invoiceLine->amount = number_format((float)$transaction->amount, 2, '.', '');
									$invoiceLine->gst = number_format((float)($transaction->amount - $transaction->amount/1.1), 2, '.', '');
									$invoiceLine->det = $transaction->bookingNumber . ' Booking Base Fee';
									$invoiceLine->qty = 1;
									$invoiceLine->mdata["booking"] = $transaction->bookingNumber;
									$invoiceLine->save();
									$invLineCheck->booking_number = $transaction->bookingNumber;
									$invLineCheck->inv_line_id = $invoiceLine->id;
									$invLineCheck->save();
								}
							}
						}
					}
				}
			}
		}
		$statisticsData->totalImported = $totalImported;
		$statisticsData->alreadyImported = $alreadyImported;
		return $statisticsData;
	}

	/**
	 * remove special string for URL paramters
	 * @param $string
	 * @return mixed|string
	 */
	private function safe_b64encode($string)
	{
		$data = base64_encode($string);
		$data = str_replace(['+', '/', '='], ['-', '_', ''], $data);
		return $data;
	}
}
