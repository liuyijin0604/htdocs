	public function actionExport($id)
	{
		$model=$this->loadModel($id);
		$csv = [];
		$csv[] = 'TYPE,CONNOTE NO.,REFERENCE,WEIGHT,Volume,CNEE,TEL,ADDRESS,SUBURB,STATE,P/C,DESTINATION,,PCS,COMMODITY,INNER ITEMS,UNIT VALUE,TTL VALUE,CMETER,SHIPPER,SHIPPER ADD,SHIPPER STATE,SHIPPER PC,SHIPPER COUNTRY CODE,SHIPPER CONTACT';
		foreach ($model->shipments as $r) {
			if (($r->cbwf&ImParcel::CBWF_DIRECT_CONSOL_BASE)>0) {
				continue;
			}
			$volume=$r->cbm>0?$r->cbm*$r->pkg:$r->weight/250;
			if ($volume<0.01) {
				$volume=0.01;
			}
			$csv[] = 'parcel,"'.$r->hbn.'","'.$r->ref.'",'.$r->weight.','.sprintf("%.2f", $volume).',"'.$r->cnee->name.'","'.$r->cnee->tel.'","'.str_replace('"', '', $r->cnee->address).'","'.$r->cnee->suburb.'","'.$r->cnee->state.'",'.$r->cnee->postcode.','.$r->cnee->country.','.$r->cnee->country.','.$r->pkg.',"'.implode(',', $r->eitems['g']).'","'.implode(',', $r->eitems['q']).'","'.implode(',', $r->eitems['v']).'",'.$r->dvalue.','.$r->cbm.',"'.$r->cnor->name.'","'.str_replace('"', '', $r->cnor->address).'","'.$r->cnor->state.'",'.$r->cnor->postcode.',"'.$r->cnor->country.'",'.$r->cnor->tel;
		}
		header("Content-type: text/csv");
		header("Content-Disposition: attachment; filename=consol_manifest_".$model->awb.".csv");
		header("Pragma: no-cache");
		header("Expires: 0");
		echo implode("\n", $csv);
	}

			
	/**
		 * Returns a pdf of sea order if the shipment is belong to sea types.
		 * @param integer the ID of the model to be loaded
		 */
	public function actionSeaOrder($id)
	{
		$model= $this->loadModel($id);
		if ($model->service != 20) {
			throw new CHttpException(404, 'Only Sea Type Has Sea Order.');
		}
		oPDF::renderPDF('sea_order_consol', ['model' => $model], 1, $model->no.'.pdf');
	}

	public function actionShipmentsDo($id)
	{
		$model= $this->loadModel($id);
		if ($model->service != 20) {
			throw new CHttpException(404, 'Only Sea Type Has Sea Order.');
		}
		
		$fs = [];
		foreach($model->shipments as $p){
			if(in_array($p->status, [10, 42])) continue;
			$tf = tempnam(Yii::app()->basePath."/runtime", "csdo");
			oPDF::renderPDF('sea_order', ['model' => $p], 2, $tf);
			$fs[] = $tf;
		}
		oPDF::mergePDF($fs, 1, true, $model->no.'.pdf');
	}

	/**
		 * Returns a pdf of sea order if the shipment is belong to sea types.
		 * @param integer the ID of the model to be loaded
		 */
	public function actionCargoReceipt($id)
	{
		$model= $this->loadModel($id);
		if (!empty($model->owner_id == Org::ORGID_COURIER_4PX)) {
			oPDF::renderPDF('cargo_receipt_4px', ['model' => $model], 1, $model->no.'.pdf');
			return;
		} 

		if (!empty($model->mdata['amazon_po'])) {
			oPDF::renderPDF('cargo_receipt_direct', ['model' => $model], 1, $model->no.'.pdf');
		} else {//sea consol
			oPDF::renderPDF('cargo_receipt_other', ['model' => $model], 1, $model->no.'.pdf');
		}
	}
			
	/* *
	 *  search the Amazon Booking ref and return the related consol or shipment
	 * @Param   booking_ref
	 * @return Consol or shipment
	 */
	public function actionAmazonSearch()
	{
		$filtersForm=new FiltersForm();
		if (isset($_GET['FiltersForm'])) {
			$filtersForm->filters=$_GET['FiltersForm'];
		}
		$provide=[];
		if (!empty($_GET['amazon_booking_ref'])||!empty($_GET['amazon_booking_time'])) {
			$amazonBookingRef=$_GET['amazon_booking_ref'];
			$amazonBookingTime=$_GET['amazon_booking_time'];
			$criteria=new CDbCriteria;
			$criteria->addCondition('model!="CargoProcessJob"');
			if (!empty($amazonBookingRef)) {
				$criteria->compare('booking_ref', $amazonBookingRef, true);
			}
			if (!empty($amazonBookingTime)) {
				$criteria->compare('amazon_booking_time', $amazonBookingTime, true);
			}
			$rs= AmazonInfo::model()->findAll($criteria);
			$totalWeight = [];
			foreach ($rs as $r) {
				$p = $r->model::model()->findByPk($r->fid);
				if(empty($p)) continue;
				if(!empty($p->shipment))
				{
					$p = $p->shipment;
				}
				$totalWeight[$p->id] = floatval($p->weight);
			}
			$totalWeight = array_sum($totalWeight);
			foreach ($rs as $index=>$r) {
				$p = $r->model::model()->findByPk($r->fid);
				if(empty($p)) continue;
				if(!empty($p->shipment))
				{
					$p = $p->shipment;
				}
				$thisIndex = ($r->model=='ImParcel'||$r->model=='CargoProcess')?$p->id:$r->fid;
				$provide[$thisIndex]=['id'=>$index,"fid"=>($r->model=='ImParcel'||$r->model=='CargoProcess')?$p->id:$r->fid,'model'=>($r->model=='ImParcel'||$r->model=='CargoProcess')?'ImParcel':$r->model,'no'=>($r->model=='ImParcel'||$r->model=='CargoProcess')?$p->hbn:$p->no,'booking_ref'=>$r->booking_ref,'amazon_booking_time'=>$r->amazon_booking_time,'ref'=>($r->model=='ImParcel'||$r->model=='CargoProcess')?$p->ref:$p->awb,'wt_percent'=>number_format(round($p->weight / $totalWeight * 10000) / 100, 4, '.', '') . '%','consol' => $p->consol->no];
			}
		}
		$filteredData = $filtersForm->filter($provide);
		$dataprovider = new CArrayDataProvider($filteredData, array(
			'pagination' => array(
				'pageSize' => 100,
			),
		));
		if (isset($_GET['amazon_booking_ref'])) {
			$this->render('amazon_part_search', ['dataProvider'=>[$dataprovider,$filtersForm]]);
			return;
		}
		$this->render('amazon_search', ['dataProvider'=>[$dataprovider,$filtersForm]]);
	}
	 
	/**
	 * @param $id
	 * @throws CHttpException
	 */
	public function actionExportStartrackApLodge($id)
	{
		$model = $this->loadModel($id);

		// get order ID firstly
		$orderIds = [];
		foreach ($model->shipments as $s) {
			if (($s->cbwf&ImParcel::CBWF_DIRECT_CONSOL_BASE)>0) {
				continue;
			}
			if (preg_match('/^7RFZ\d{8}/', $s->ref) && !empty($s->trans)) {
				foreach ($s->trans as $tranship) {
					if (!empty($tranship->mdata['oid'])) {
						$orderId = $tranship->mdata['oid'];
						if (!isset($orderIds[$orderId])) {
							$orderIds[$orderId] = $orderId;
						}
					}
				}
			}
		}

		if (!empty($orderIds)) {
			$api = new StarTrackAPI('syd', true);
			$api->getOrderSummary($orderIds);
		} else {
			$model->addError('id', 'No any StarTrack order found!');
			$this->ajaxResult($model);
		}
	}
	 
