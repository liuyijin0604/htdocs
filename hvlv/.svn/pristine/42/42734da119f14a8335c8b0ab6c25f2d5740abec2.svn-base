<?php

class DmawbConsolController extends Controller
{
	protected $nonAjax = ['exportAmazon','export','seaManifest','seaOrder','shipmentsDo','cargoReceipt','exportStartrackApLodge','exportStartrackMelApLodge','seaOutturnShipments','seaDeliveryOrderTogether','exportCurrentSearch'];

	/**
	 * Creates a new model.
	 * If creation is successful, the browser will be redirected to the 'view' page.
	 */
	public function actionCreate()
	{
		$model = new DmawbConsol('create');

		if (isset($_POST['DmawbConsol'])) {
			$model->attributes = $_POST['DmawbConsol'];

			$model->mdata['awb_wt'] = $_POST['mdata']['awb_wt'];
			$model->mdata['cgb_wt'] = $_POST['mdata']['cgb_wt'];
			$model->mdata['shipments'] = $_POST['mdata']['shipments'];
			$model->mdata['item'] = $_POST['mdata']['item'];

			// set department id as sydney warehouse
			// when create invoice will use this value
			if ($model->pod=='AUMEL') {
				$model->dpt_id=Org::PCAE_DEPARTMENT_MELBOURNE;
			} else {
				$model->dpt_id = Org::PCAE_DEPARTMENT_SYDNEY;
			}
			if (empty($model->eta)) {
				$model->eta = date('Y-m-d');
			}

			$model->save();
			$this->ajaxResult($model, ['id']);
		}

		$this->render('create', [
			'model' => $model,
		]);
	}

	/**
	 * Updates a particular model.
	 * If update is successful, the browser will be redirected to the 'view' page.
	 * @param integer $id the ID of the model to be updated
	 */
	public function actionUpdate($id)
	{
		$model = $this->loadModel($id);

		if (!empty($_POST)) {
			if (!empty($_POST['mdata'])) {
				foreach ($_POST['mdata'] as $k=>$v) {
					$model->mdata[$k] = trim($v);
				}
			}

			if(empty($_POST['mdata']['not_apply_org_flexible_rate'])){
				unset($model->mdata['not_apply_org_flexible_rate']);
			}

			if(empty($_POST['mdata']['blockacr'])){
				unset($model->mdata['blockacr']);
			}

			if(empty($_POST['mdata']['skip_cacr'])){
				unset($model->mdata['skip_cacr']);
			}elseif(empty($model->mdata['acr_stat']) || $model->mdata['acr_stat'] < 5){
				$model->mdata['acr_stat'] = 5;
			}

			if (isset($_POST['DmawbConsol'])) {
				// if change etd, and if the shipment already have flight dispatch tracking infor,then we need to update them
				if (!empty($_POST['DmawbConsol']['etd'])) {
					if ($model->etd!=$_POST['DmawbConsol']['etd']) {
						$model->etd=$_POST['DmawbConsol']['etd'];
						$model->mdata['updatedEtd']=1;
						$model->updateFlight();
					}
				}
				
				$model->attributes = $_POST['DmawbConsol'];
				if (empty($model->eta)) {
					$model->eta = $model->created;
				}
			}

			$model->save();
			if (!empty($_POST['AmazonInfo']['booking_ref'])) {
				$amazonInfo=$model->getAmazonInfo();
				$amazonInfo->booking_ref=$_POST['AmazonInfo']['booking_ref'];
				if (!empty($_POST['AmazonInfo']['amazon_booking_time'])) {
					$amazonInfo->amazon_booking_time=$_POST['AmazonInfo']['amazon_booking_time'];
					$shipment=$model->linkShipment(false);
					$shipment->mdata['amazon_booking_time']=$_POST['AmazonInfo']['amazon_booking_time'];
					$shipment->mdata['booking_ref']=$_POST['AmazonInfo']['booking_ref'];
					$shipment->updateMeta();
					$shipment->updateAmazonBookingTime();
				}
				$amazonInfo->update('booking_ref');
			} elseif (empty($_POST['AmazonInfo']['booking_ref'])&&(!empty($model->amazon_info->booking_ref))) {
				$model->amazon_info->booking_ref='';
				$model->amazon_info->update('booking_ref');
			}
			// create invoice for special import agent client
			if (!empty($_POST['gen_inv'])) {
				if ($_POST['gen_inv'] == 1) {
					$errors = $model->genInvoice();
					if (!empty($errors)) {
						$model->addError('make Invoice Failed', $errors[0]);
					}
				}
			}

			$this->ajaxResult($model);
		}

		if (isset($_GET['tab'])) {
			Acl::hasAccess($this->CaName . '/' . $_GET['tab'], true);
			$this->render('tab_' . $_GET['tab'], ['model' => $model]);
		} else {
			$this->render('update', ['model' => $model]);
		}
	}


	public function actionNotes($id)
	{
		$model = $this->loadModel($id);
		if (!empty($_POST['notes'])) {
			$log = Log::add($model, 6, ['notes' => $_POST['notes']]);
			$this->ajaxResult($log);
		}
	}

	public function actionUpdateByNo($no)
	{
		$consol = DmawbConsol::model()->find('no = :no', [':no' => $no]);
		if (!empty($consol)) {
			$this->actionUpdate($consol->id);
		} else {
			throw new CHttpException(404, 'The requested page does not exist.');
		}
	}

	/**
	 * send ACR
	 */
	public function actionAcr($id)
	{
		//air cargo
		$cn = $this->loadModel($id);
		$hwb =$cn->no;
		$airline = substr(trim($cn->airline), 0, 2);
		if (empty($airline)) {
			$airline = preg_replace('/\d+/', '', trim($cn->airline));
		}
		$flight = preg_match('/^\d+$/', $cn->flight) ? $cn->flight : substr($cn->flight, 2);
		$awb = preg_replace('/[^\d]+/', '', $cn->awb);

		if (empty($cn->mdata['cnee'])) {
			$cn->addError('meta', 'Consignee Name required');
		}
		if (empty($cn->mdata['cnee_addr'])) {
			$cn->addError('meta', 'Consignee Address required');
		}
		if (empty($cn->mdata['cnor'])) {
			$cn->addError('meta', 'Shipper Name required');
		}
		if (empty($cn->mdata['cnor_addr'])) {
			$cn->addError('meta', 'Shipper Address required');
		}
		 
		if (empty($cn->mdata['shipments'])) {
			$cn->addError('meta', 'Packs No. required');
		}
		if (empty($cn->mdata['awb_wt'])) {
			$cn->addError('meta', 'Weight required');
		}
		if (empty($cn->mdata['cbm'])) {
			$cn->addError('meta', 'cbm required');
		}
		if ($cn->hasErrors()) {
			$this->ajaxResult($cn);
		}

		$checkErrors = [];
		foreach ($cn->shipments as $i=>$p) 
		{
			foreach ($p->eitems['v'] as $j => $v) {
				if($v==0) $checkErrors[]=$p->ref.' Item Empty Value';
			}

			foreach ($p->eitems['q'] as $k => $q) {
				if($q==0) $checkErrors[]=$p->ref.' Item Empty Quantity';
			}
		}

		if(!empty($checkErrors))
		{
			$cn->addError('meta',json_encode($checkErrors));
			$this->ajaxResult($cn);
			return;
		}

		if (empty($cn->mdata['acr_stat'])&&empty($_GET['sub'])) {
			if ($cn->service == 20) {
				if (empty($cn->awb)) {
					$cn->addError('meta', 'Ocean Bill required');
				}
				if (empty($cn->mdata['container_no'])) {
					$cn->addError('meta', 'Container No. required');
				}
				if (empty($cn->mdata['house_bill'])) {
					$cn->addError('meta', 'House Bill Required');
				}
				if (empty($cn->mdata['item'])) {
					$cn->addError('meta', 'Good Description Required');
				}
				if (empty($cn->flight)) {
					$cn->addError('meta', 'voyage number Required');
				}
				if (empty($cn->airline)) {
					$cn->addError('meta', 'vessel IMO number Required');
				}
				 
				if ($cn->hasErrors()) {
					$this->ajaxResult($cn);
				}
				//sea acr
				$em = new Edimsg;
				$em->dt = date('Y-m-d H:i:s');
				$em->type = 'SEACR-C';
				$em->sender = Yii::app()->params['ics']['testing']? Yii::app()->params['ics']['test_site'] : Yii::app()->params['ics']['prod_site'];
				$em->receiver = Yii::app()->params['ics']['customs_id'];
				$em->status = 19;
				$em->fid = $cn->id;
				$em->save();
				$em->mid = sprintf('%06s', substr($em->id, -6));
				$vn = Edimsg::model()->count('type = :t AND fid = :fid', [':t' => 'SEACR-C', ':fid' => $cn->id]);
			 
				$obl=$cn->awb;// /required ocean bill landing
			$hbl=$cn->mdata['house_bill'];//house bill landing
			 //A document signed and delivered by the Master of a Ship to the consignor. A document of title and a receipt for goods.
			 $voyage_number=$cn->flight ;// like 023s
			 $vessel=$cn->airline; //IMO  like 9235103
			 $container_number=trim($cn->mdata['container_no']);//container no  like OOLU9551594
			 $container_size= DmawbConsol::getContainerCode($cn->mdata['sea_type']);

				// 2008=> 20*8   2095=>20*8*9.5   4008=>40*8    0000=>OTHER
			 $packs=$cn->mdata['shipments'];// the number of packs
			 $cargo_type=$cn->mdata['cargo_type'];           // Import Cargo Type   FCL=>Full Container load           LCL=>Less than Container load   B/B=>Break bulk
			 $goods=$cn->mdata['item'];  //the name of goods like stc. handheld vacuum
			 $weight=$cn->mdata['awb_wt']; //the total weight of the goods// net weight not including packing and carrier equipment
			 $volume=$cn->mdata['cbm']; //  3.190 .....
		 
			 $cnee_name = $cn->mdata['cnee'];
				$cnee_addr = $cn->mdata['cnee_addr'];
				$cnor_name = $cn->mdata['cnor'];
				$cnor_addr = $cn->mdata['cnor_addr'];
				if (!empty($cn->mdata['rece'])&&!empty($cn->mdata['rece_addr'])) {
					$cnee_name= $cn->mdata['rece'];
					$cnee_addr = $cn->mdata['rece_addr'];
				}
				$msg = "UNH+".$em->mid."+CUSCAR:D:99B:UN'
BGM+933:::SEACR+" .$cn->no.($vn>1? '-'.$vn : '').":".$vn."+9'
RFF+BH:".$hbl."'
RFF+MB:".$obl."'
RFF+PQ:CC'
NAD+CN++".Edimsg::strSegment($cnee_name, 35, 2).":".Edimsg::strSegment($cnee_addr, 35, 3)."'
NAD+CZ++".Edimsg::strSegment($cnor_name, 35, 2).":".Edimsg::strSegment($cnor_addr, 35, 3)."'
NAD+AH+".Yii::app()->params['ics']['abn']."::95'
NAD+VW+".Yii::app()->params['ics']['abn']."::95'
TDT+20+".$voyage_number."++11++++".$vessel."::11'
LOC+8+".$cn->pod."::6'
LOC+12+".$cn->pod."::6'
LOC+27+".substr($cn->pol, 0, 2)."::5'
LOC+76+".$cn->pol."::6'
LOC+73+".$cn->pol."::6'
GIS+FFO:109:95'
CNI++:::I'
RFF+AAQ:".$container_number."'
GID+1'
RFF+ACC:".$container_size."'
GID+1'
RFF+ZZZ:1'
GID+1'
PAC+".$packs."'
PAC+++".$cargo_type.":67:95'
PAC+++GENN:121:95'
PAC+++PK:185:95'
FTX+AAA+++".Edimsg::strSegment(str_replace('/', ',', trim($goods, '/')), 512, 5)."'
MEA+AAE+AAL+KG:".sprintf("%.2f", $weight)."'
MEA+AAE+ABJ+CU:".sprintf("%.2f", $volume)."'
MEA+AAE+G+KG:".sprintf("%.2f", $weight)."'
";
				$mc = substr_count($msg, "\n")+1;
				$msg .= "UNT+".$mc."+".$em->mid."'";
				$em->msg = $msg;
				if (Yii::app()->params['ics']['testing']) {
					$em->mdata['test'] = 1;
				}
				//echo $msg;
				$em->status = 20;
				$em->save();
				$cn->mdata['acr_stat'] = 1;
				$cn->status = 30;
				$cn->save();
			} else {//air acr
				if (!preg_match('/^\d{11}$/i', $awb)) {
					$cn->addError('meta', 'awb are not valid');
				}
				if (empty($cn->mdata['dvalue'])) {
					$cn->addError('meta', 'goods value required for air cargo report!');
				}
				
				if ($cn->hasErrors()) {
					$this->ajaxResult($cn);
				}
				$em = new Edimsg;
				$em->dt = date('Y-m-d H:i:s');
				$em->type = 'AIRCR-C';
				$em->sender = Yii::app()->params['ics']['testing'] ? Yii::app()->params['ics']['test_site'] : Yii::app()->params['ics']['prod_site'];
				$em->receiver = Yii::app()->params['ics']['customs_id'];
				$em->status = 19;
				$em->fid = $id;
				$em->save();
				$em->mid = sprintf('%06s', substr($em->id, -6));
				$vn = Edimsg::model()->count('type = :t AND fid = :fid', [':t' => 'AIRCR-C', ':fid' => $cn->id]);

				$cnee_name = $cn->mdata['cnee'];
				$cnee_addr = $cn->mdata['cnee_addr'];
				$cnor_name = $cn->mdata['cnor'];
				$cnor_addr = $cn->mdata['cnor_addr'];
				if (!empty($cn->mdata['rece'])&&!empty($cn->mdata['rece_addr'])) {
					$cnee_name= $cn->mdata['rece'];
					$cnee_addr = $cn->mdata['rece_addr'];
				}

				$msg = "UNH+" . $em->mid . "+CUSCAR:D:99B:UN'
BGM+933:::AIRCR+" . $cn->no . ($vn > 1 ? '-' . $vn : '') . ":" . $vn . "+9'
RFF+PQ:CC'
RFF+HWB:" . $hwb . "'
RFF+MWB:" . $awb . "'
NAD+CN++" . Edimsg::strSegment($cnee_name, 35, 2) . ":" . Edimsg::strSegment($cnee_addr, 35, 3) . "'
NAD+CZ++" . Edimsg::strSegment($cnor_name, 35, 2) . ":" . Edimsg::strSegment($cnor_addr, 35, 3) . "'
NAD+VW+" . Yii::app()->params['ics']['abn'] . "::95'
TDT+20+" . $flight . "++6+" . $airline . "::3'
LOC+8+" . $cn->pod . "::6'
LOC+76+" . $cn->pol . "::6'
LOC+12+" . $cn->pod . "::6'
LOC+91+" . $cn->pol . "::6'
DTM+178:" . date("Ymd", strtotime($cn->eta)) . ":102'
CNI+1'
RFF+UCN:" . $cn->no . "'
MOA+44:" . sprintf("%.2f", $cn->mdata['dvalue']) . ":USD'
GID+1'
PAC+" . $cn->mdata['shipments'] . "'
FTX+AAA+++" . Edimsg::strSegment(str_replace('/', ',', trim($cn->mdata['item'], '/')), 512, 5)   . "'
MEA+AAE+G+KG:" . sprintf("%.2f", $cn->mdata['awb_wt']) . "'
";
				$mc = substr_count($msg, "\n") + 1;
				$msg .= "UNT+" . $mc . "+" . $em->mid . "'";
				$em->msg = $msg;
				if (Yii::app()->params['ics']['testing']) {
					$em->mdata['test'] = 1;
				}
				//echo $msg;
				$em->status = 20;
				$em->save();
				$cn->mdata['acr_stat'] = 1;
				$cn->status = 30;
				$cn->save();
			}
		} elseif (!empty($_GET['sub'])) {
			/***************
			 * sub ACR
			 */
			if ($cn->service == 20) {
				//sea small acr not develop yet
				foreach ($cn->shipments as $i=>$p) {
					if (!$p->canSendACR()) {
						continue;
					}
					if (($p->cbwf&ImParcel::CBWF_DIRECT_CONSOL_BASE)>0) {
						continue;
					}
					if (empty($p->weight)) {
						$cn->addError('meta', 'Shipment '.$p->hbn.' has no weight.');
						continue;
					} elseif (empty($p->dvalue)) {
						$cn->addError('meta', 'Shipment '.$p->hbn.' has no value.');
						continue;
					} elseif (empty($p->pkg)) {
						$cn->addError('meta', 'Shipment '.$p->hbn.' has number of packs.');
						continue;
					}
					$canSac = $p->canSAC();
					$obl=$cn->awb;// /required ocean bill landing
					 $hbl=$cn->mdata['house_bill'];//house bill landing
					 //A document signed and delivered by the Master of a Ship to the consignor. A document of title and a receipt for goods.
					 $voyage_number=$cn->flight ;// like 023s
					 $vessel=$cn->airline; //IMO  like 9235103
					 $container_number=trim($cn->mdata['container_no']);//container no  like OOLU9551594
					 $container_size= DmawbConsol::getContainerCode($cn->mdata['sea_type']);
					$cargo_type=$cn->mdata['cargo_type'];
					if (empty($cargo_type)) {
						$cargo_type="LCL";
					}
					$volume=$p->cbm>0?$p->cbm*$p->pkg:$p->weight/250;
					if ($volume<0.01) {
						$volume=0.01;
					}
					$em = new Edimsg;
					$em->dt = date('Y-m-d H:i:s');
					$em->type = 'SEACR-S';
					$em->sender = Yii::app()->params['ics']['testing']? Yii::app()->params['ics']['test_site'] : Yii::app()->params['ics']['prod_site'];
					$em->receiver = Yii::app()->params['ics']['customs_id'];
					$em->status = 19;
					$em->fid = $p->id;
					$em->save();
					$em->mid = sprintf('%06s', substr($em->id, -6));
					$vn = Edimsg::model()->count('type = :t AND fid = :fid', [':t' => 'SEACR-S', ':fid' => $p->id]) + 1;
					$msg = "UNH+".$em->mid."+CUSCAR:D:99B:UN'
BGM+933:::SEACR+".$p->hbn.($vn>1? '-'.$vn : '').":".$vn."+9'
RFF+PQ:PO'\n";
					if (!empty($hbl)) {
						$msg.="RFF+BM:".$hbl."'\n";
					}
					/**
					 * if shipment have more than two shipments then it should be LCL;
					 */
					if (sizeof($cn->shipments)>2) {
						$count = 0;
						foreach ($cn->shipments as $temp_shipment) {
							if ($temp_shipment->status != 100) {
								$count ++;
							}
						}
						if ($count > 2) {
							$cargo_type="LCL";
						}
					}
					$cnor_name = $p->cnor->name;
					if (!preg_match('/\w/', $cnor_name)) {
						$cnor_name = $p->agent->name;
					}
					$cnor_name = $cnor_name;
					$cnor_addr = $p->cnor->fullAddress(['suburb', 'city', 'state', 'postcode']);
					if (!preg_match('/\w/', $cnor_addr)) {
						$cnor_addr = $p->agent->getAddress(true, false, false);
					}
					$cnor_addr = trim($cnor_addr, " .,");
					$cnor_addr = $cnor_addr;
								
					if (!empty($p->receiver)&&!empty($p->receiver->address)&&!empty($p->receiver->name)&&!empty($p->receiver->postcode)) {
						$cnee_name=$p->receiver->name;
						$cnee_addr = $p->receiver->fullAddress(['suburb', 'city', 'state', 'postcode']);
					} else {
						$cnee_name = $p->cnee->name;
						$cnee_addr = $p->cnee->fullAddress(['suburb', 'city', 'state', 'postcode']);
					}
					$goods = WordReplace::replace($p->getGoods())[0];//use word replace service;
								
					$msg .= "RFF+BH:".$p->hbn."'
RFF+MB:".$obl."'
NAD+AH+".Yii::app()->params['ics']['abn']."::95'
NAD+VW+".Yii::app()->params['ics']['abn']."::95'
NAD+CN++".Edimsg::strSegment($cnee_name, 35, 2).":".Edimsg::strSegment($cnee_addr, 35, 3)."'
NAD+CZ++".Edimsg::strSegment($cnor_name, 35, 2).":".Edimsg::strSegment($cnor_addr, 35, 3)."'
TDT+20+".$voyage_number."++11++++".$vessel."::11'
LOC+8+".$cn->pod."::6'
LOC+12+".$cn->pod."::6'
LOC+27+".substr($cn->pol, 0, 2)."::5'
LOC+76+".$cn->pol."::6'
LOC+73+".$cn->pol."::6'
CNI++:::I'
RFF+AAQ:".$container_number."'
GID+1'
RFF+ACC:".$container_size."'
GID+1'
RFF+ZZZ:1'
".($canSac ? "GIS+SAC:109:95'\n" : "")."GID+1'
PAC+".$p->pkg."'
PAC+++".$cargo_type.":67:95'
PAC+++GENN:121:95'
PAC+++PK:185:95'
FTX+AAA+++".Edimsg::strSegment(str_replace('/', ',', trim($goods, '/')), 512, 5)."'
MEA+AAE+AAL+KG:".sprintf("%.2f", $p->weight)."'
MEA+AAE+ABJ+CU:".sprintf("%.2f", $volume)."'
MEA+AAE+G+KG:".sprintf("%.2f", $p->weight)."'
";
					$mc = substr_count($msg, "\n")+1;
					$msg .= "UNT+".$mc."+".$em->mid."'";
					$em->msg = $msg;
					if (Yii::app()->params['ics']['testing']) {
						$em->mdata['test'] = 1;
					}
					//echo $msg;
					$em->status = 20;
					$em->save();
					$p->status = 50;
					$p->save();
				}
				$cn->status = 30;
				$cn->save();
				$this->ajaxResult($cn);
			} else { //air small acr;
				//check the prohibted words at first
				$errs=[];
				foreach ($cn->shipments as $i=>$p) {
					if (($p->cbwf&ImParcel::CBWF_DIRECT_CONSOL_BASE)>0) {
						continue;
					}
					$temp=WordReplace::replace($p->getGoods())[1];
					if (!empty($temp)) {
						$errs[]="shipment ".$p->ref." ".implode("|", $temp);
					};//use word replace service;
				}
				if(!empty($cn->mdata['house_bill'])){
					$hwb = $cn->mdata['house_bill'];
				}
					
				if (empty($errs)) {
					foreach ($cn->shipments as $i=>$p) {
						// if($p->status > 50 || $p->value >= 1000) continue;
						// don't need to check the value , even more than 1000 we still need to report , but not for SAC
						if ($p->status >= 50 || $p->status == 42) {
							continue;
						}
						if (($p->cbwf&ImParcel::CBWF_DIRECT_CONSOL_BASE)>0) {
							continue;
						}

						if (empty($p->weight)) {
							$cn->addError('meta', 'Shipment '.$p->hbn.' has no weight.');
							continue;
						} elseif (empty($p->dvalue)) {
							$cn->addError('meta', 'Shipment '.$p->hbn.' has no value.');
							continue;
						} elseif (empty($p->pkg)) {
							$cn->addError('meta', 'Shipment '.$p->hbn.' has number of packs.');
							continue;
						}

						// only value < 750USD can SAC
						// or 1000 AUD can be SAC (Self Assessed Clearance) only
						$canSac = $p->canSAC();
						// special one
						// for Michelle don't send sac for this shipment
						// if ( $p->hbn == '8202853606' ) {
						//     $canSac = false;
						//}
						$em = new Edimsg;
						$em->dt = date('Y-m-d H:i:s');
						$em->type = 'AIRCR-S';
						$em->sender = Yii::app()->params['ics']['testing']? Yii::app()->params['ics']['test_site'] : Yii::app()->params['ics']['prod_site'];
						$em->receiver = Yii::app()->params['ics']['customs_id'];
						$em->status = 19;
						$em->fid = $p->id;
						$em->save();
						$em->mid = sprintf('%06s', substr($em->id, -6));
						$vn = Edimsg::model()->count('type = :t AND fid = :fid', [':t' => 'AIRCR-S', ':fid' => $p->id]) + 1;
						$msg = "UNH+".$em->mid."+CUSCAR:D:99B:UN'
BGM+933:::AIRCR+".$p->hbn.($vn>1? '-'.$vn : '').":".$vn."+9'
RFF+PQ:PO'
RFF+AWB:".$hwb."'\n";
						$cnor_name = $p->cnor->name;
						if (!preg_match('/\w/', $cnor_name)) {
							$cnor_name = $p->agent->name;
						}
						$cnor_name = $cnor_name;

						$cnor_addr = $p->cnor->fullAddress(['suburb', 'city', 'state', 'postcode']);
						if (!preg_match('/\w/', $cnor_addr)) {
							$cnor_addr = $p->agent->getAddress(true, false, false);
						}
						$cnor_addr = trim($cnor_addr, " .,");
						$cnor_addr = $cnor_addr;
								
						if (!empty($p->receiver)&&!empty($p->receiver->address)&&!empty($p->receiver->name)&&!empty($p->receiver->postcode)) {
							$cnee_name=$p->receiver->name;
							$cnee_addr = $p->receiver->fullAddress(['suburb', 'city', 'state', 'postcode']);
						} else {
							$cnee_name = $p->cnee->name;
							$cnee_addr = $p->cnee->fullAddress(['suburb', 'city', 'state', 'postcode']);
						}

						//        $goods = $p->getGoods();
					$goods = WordReplace::replace($p->getGoods())[0];//use word replace service;
$msg .= "RFF+HWB:".$p->hbn."'
RFF+MWB:".$awb."'
NAD+CN++".Edimsg::strSegment($cnee_name, 35, 2).":".Edimsg::strSegment($cnee_addr, 35, 3)."'
NAD+CZ++".Edimsg::strSegment($cnor_name, 35, 2).":".Edimsg::strSegment($cnor_addr, 35, 3)."'
NAD+VW+".Yii::app()->params['ics']['abn']."::95'
TDT+20+".$flight."++6+".$airline."::3'
LOC+8+".$cn->pod."::6'
LOC+76+".$cn->pol."::6'
LOC+12+".$cn->pod."::6'
LOC+91+".$cn->pol."::6'
DTM+178:".date("Ymd", strtotime($cn->eta)).":102'
CNI+1'
RFF+UCN:".$p->hbn."'
MOA+44:".sprintf("%.2f", $p->getDvalue()).":USD'
".($canSac ? "GIS+SAC:109:95'\n" : "")."GID+1'
PAC+".$p->pkg."'
FTX+AAA+++".Edimsg::strSegment(str_replace('/', ',', trim($goods, '/')), 512, 5)."'
MEA+AAE+G+KG:".sprintf("%.2f", $p->weight)."'
";
						$mc = substr_count($msg, "\n")+1;
						$msg .= "UNT+".$mc."+".$em->mid."'";
						$em->msg = $msg;
						if (Yii::app()->params['ics']['testing']) {
							$em->mdata['test'] = 1;
						}
						//echo $msg;
						$em->status = 20;
						$em->save();
						$p->status = 50;
						$p->save();
					}
					if (!empty($cn->process)&&$cn->process->status<=ConsolProcess::STATE_WAITING_SUB_ACR) {
						$cn->process->updateStatus(ConsolProcess::STATE_WAITING_SEND_UBM);
					}
				} else {
					$cn->addError('prohibited', implode(';', $errs));
				}
			}
		}
		$this->ajaxResult($cn);
	}

	public function actionSeaManifest($id)
	{
		$model= $this->loadModel($id);
