	/*export amazon require list
	 *
	 */
	public function actionExportAmazon()
	{
		$errors=[];
		$tempShipments=[];
		if (!empty($_POST['amazon_id'])) {
			foreach (preg_split("/[,;\n]/", $_POST['shipments']) as $ref) {
				if (preg_match("/^DW\d{8}[A-Z]{3}$/i", trim($ref))) {
					$temp=DmawbConsol::model()->find('no=:no', [':no'=>$ref]);
					if (empty($temp->mdata['amazon_uqty'])) {
						$errors[]=$ref.' Not have unit Qty';
					}
				} else {
					$temp= Shipment::model()->find('hbn=:no OR ref=:no', [':no'=>$ref]);
				}
				if (empty($temp->mdata['amazon_po'])) {
					$errors[]=$ref.' Not have amazon PO#';
				}
				if (empty($temp->mdata['amazon_shipment_ids'])) {
					$errors[]=$ref.' Not have amazon Shipments Ids';
				}
				if (empty($temp->mdata['amzon_pallet'])) {
					$errors[]=$ref.' Not have pallets';
				}
				$tempShipments[]=$temp;
			}
			if (!empty($errors)) {
				$msg='';
				foreach ($errors as $err) {
					$msg.='<div style="color:red">'.$err."</div>";
				}
				echo $msg;
				return;
			}
			$csv=[];
			$csv[]='ARN,PRO,BOL List,Vendor Name,Pallet Count,Carton Count,Unit Count,PO List';
			foreach ($tempShipments as $index=>$temp) {
				if (get_class($temp)=="DmawbConsol") {
					$csv[]=',,"'.(implode(',', preg_split('/[,;\n]/', $temp->mdata['amazon_po']))).'",,'.$temp->mdata['amzon_pallet'].','.$temp->mdata['shipments'].','.$temp->mdata['amazon_uqty']
								.',"'.(implode(',', preg_split('/[,;\n]/', $temp->mdata['amazon_shipment_ids']))).'"';
				} else {
					$csv[]=',,"'.(implode(',', preg_split('/[,;\n]/', $temp->mdata['amazon_po']))).'",,'.$temp->mdata['amzon_pallet'].','.$temp->pkg.','.$temp->itemsTotQty()
								.',"'.(implode(',', preg_split('/[,;\n]/', $temp->mdata['amazon_shipment_ids']))).'"';
				}
			}
			header("Cache-Control: maxage=1");
			header("Content-type: text/csv");
			header("Content-Disposition: attachment; filename=amazon_".date('YmdHis').".csv");
			echo implode("\n", $csv);
			Yii::app()->end();
		}
		$this->render('export_amazon');
	}
	/**
	 * underbond Movement Request
	 * for tow types. air or sea
	 * @param type $id
	 */
		
		
	public function actionUbm($id)
	{
		$model=$this->loadModel($id);
		if (!empty($_POST)) {
			// in case delete schedule UBM
			if (isset($_POST['delete'])) {
				if ($_POST['delete'] == 'Delete') {
					$this->deleteUbm($model);
					$this->ajaxResult($model);
				}
			}
			if (isset($_POST['force_ubm'])) {
				if ($_POST['force_ubm'] == 'Force Send UBM') {
					$this->forceSendUbm($model);
				}
			}

			$model->attributes=$_POST['DmawbConsol'];
			if (!empty($_POST['mdata'])) {
				foreach ($_POST['mdata'] as $k=>$v) {
					$model->mdata[$k] = $v;
				}
			}
			$model->save();
			$this->preUbm($model);
			$this->ajaxResult($model);
		}
		if (empty($model->mdata['ubm_dest'])) {
			$model->mdata['ubm_dest'] = $model->getEstID();
		}
		
		$this->render('ubm', [
			'model'=>$model,
		]);
	}
		
		
	private function preUbm($model, $force=false)
	{
		//send ubm
		$em = new Edimsg;
		$em->dt = date('Y-m-d H:i:s');
		$em->type = 'UBMREQ';
		$em->sender = Yii::app()->params['ics']['testing']? Yii::app()->params['ics']['test_site'] : Yii::app()->params['ics']['prod_site'];
		$em->receiver = Yii::app()->params['ics']['customs_id'];
		$em->status = 19;
		$em->fid = $model->id;
		if ($model->service == 20) {
			$em->mdata['voyage_number']=$model->flight;
			$em->mdata['vessel']=$model->airline;
			$voyage_number=$model->flight ;// like 023s
			$vessel=$model->airline; //IMO  like 9235103
			$obl=$model->awb;// /required ocean bill landing
			$container_number=trim($model->mdata['container_no']);//container no  like OOLU9551594
			$hbl=$model->mdata['house_bill'];
			$cargo_type=$model->mdata['cargo_type'];
			$em->save();
			$em->mid = sprintf('%06s', substr($em->id, -6));
			$vn = Edimsg::model()->count('type = :t AND fid = :fid', [':t' => 'UBMREQ', ':fid' => $model->id]);
			$msg = "UNH+".$em->mid."+CUSCAR:D:99B:UN'
BGM+31:::UBMREQ+".$model->no.($vn == 1? '' : '-'.$vn).":".$vn."+9'
RFF+ACD:".($model->totShipments() ==1? 'MOV' : 'DCL')."'
NAD+VW+".Yii::app()->params['ics']['abn']."::95'
TDT+1++ROA'
TDT+20+".$voyage_number."++11++++".$vessel."::11'
LOC+4+".$model->mdata['ubm_dest']."::95'
LOC+5+".$model->mdata['ubm_origin']."::95'
LOC+11+".(!empty($model->mdata['ubm_discharge'])?$model->mdata['ubm_discharge']:$model->mdata['ubm_origin'])."::95'
CNI++:::I'
RFF+AAQ:".$container_number."'
GID+1'
PAC+".$model->mdata['shipments']."'
PAC+++PK:185:95'
PAC+++FCL:67:95'
";
			$mc = substr_count($msg, "\n")+1;
			$msg .= "UNT+".$mc."+".$em->mid."'";
			$em->msg = $msg;
			// if (!$force) {
			// 	if (isset($model->mdata['dclallowed'])&&$model->mdata['dclallowed']==1) {
			// 		$model->mdata['ubmsent'] = 1;
			// 		$em->status = 20; // sent
			// 	} else {
			// 		$model->mdata['ubmsent'] = 2;
			// 		$em->status = 18; // on schedule status
			// 	}
			// } else {
			// 	$model->mdata['ubmsent'] = 1;
			// 	$em->status = 20; // sent
			// }
			$model->mdata['ubmsent'] = 1;
			$em->status = 20; // sent

			if (!empty($model->process)) {
				$model->process->updateStatus(ConsolProcess::STATE_UB_ON_SCHEDULE);
			}
			$model->update(['meta']);
			$em->save();
		} else {
			//airline-underbond movement
			$em->mdata['airline'] = $model->airline;
			$em->mdata['flight'] = $model->flight;
			$em->mdata['eta'] = $model->eta;
			$em->mdata['etd'] = $model->etd;

			$em->save();
			$em->mid = sprintf('%06s', substr($em->id, -6));
			$vn = Edimsg::model()->count('type = :t AND fid = :fid', [':t' => 'UBMREQ', ':fid' => $model->id]);
			//$airline = preg_replace('/\d+/', '', trim($model->airline));
			//if(empty($airline)) $airline = preg_replace('/\d+/', '',trim($model->airline));
			//$flight = preg_replace('/[^\d]+/', '', $model->flight);

			$airline = substr(trim($model->airline), 0, 2);
			$flight = substr(trim($model->flight), 2);
			$msg = "UNH+".$em->mid."+CUSCAR:D:99B:UN'
BGM+31:::UBMREQ+".$model->no.($vn == 1? '' : '-'.$vn).":".$vn."+9'
RFF+ACD:MOV'
NAD+VW+".Yii::app()->params['ics']['abn']."::95'
TDT+1++ROA'
TDT+20+".$flight."++6+".$airline."::3'
LOC+4+".$model->mdata['ubm_dest']."::95'
LOC+5+".$model->mdata['ubm_origin']."::95'
LOC+11+".(!empty($model->mdata['ubm_discharge'])?$model->mdata['ubm_discharge']:$model->mdata['ubm_origin'])."::95'
DTM+132:".date("Ymd", strtotime($model->eta)).":102'
CNI++:::I'
RFF+MWB:".str_replace('-', '', $model->awb)."'
GID+1'
PAC+".$model->mdata['shipments']."'
";
			$mc = substr_count($msg, "\n")+1;
			$msg .= "UNT+".$mc."+".$em->mid."'";
			$em->msg = $msg;
			if (Yii::app()->params['ics']['testing']) {
				$em->mdata['test'] = 1;
			}
			if (!$force) {
				if ($this->isAirlineArrived($model->flight, $model->eta)) {
					//echo $msg;
				$em->status = 20; // in queue status
				$model->mdata['ubmsent'] = 1;
				} else {
					$model->mdata['ubmsent'] = 2;
					$em->status = 18; // on schedule status
				}
			} else {
				$em->status = 20; // in queue status
				$model->mdata['ubmsent'] = 1;
			}
			if (!empty($model->process)) {
				$model->process->updateStatus(ConsolProcess::STATE_UB_ON_SCHEDULE);
			}
			$model->update(['meta']);
			$em->save();
		}
	}
	/**
	 * try to delete on the schedule UBM request
	 * @param $console
	 */
	private function deleteUbm($console)
	{
		// try to find them
		$ubmModels = Edimsg::model()->findAll('fid = :fid AND type = :type AND status = 18', [':fid' => $console->id,':type' => 'UBMREQ']);
		foreach ($ubmModels as $ubm) {
			$ubm->delete();
		}
		// reset UBN sent status
		unset($console->mdata['ubmsent']);
		if (!empty($model->process)) {
			$model->process->updateStatus(ConsolProcess::STATE_WAITING_SEND_UBM);
		}
		$console->save();
	}
		
	private function forceSendUbm($model)
	{
		// delete on schedule one if existing
		$this->deleteUbm($model);
		$this->preUbm($model, true);
		$this->ajaxResult($model);
	}

	
	/**
	 * check to see if the flight arrived or not
	 * @param $flight
	 * @param $etd
	 * @return bool
	 */
	private function isAirlineArrived($flight, $etd)
	{
		$arrived = false;

		// call flight tracking logic
		include(Yii::app()->basePath.DIRECTORY_SEPARATOR.'commands/trackingCommand.php');
		$tracking = new trackingCommand('ubm', null);
		$d = $tracking->flight($flight, $etd);
		if (!empty($d)) {
			if ($d[7] == 2) { //arrival

				// if  30 minutes  after arrived
				// we set arrived , so that we can send UBM message
				// get real arrived time
				$laterTime = strtotime($d[5]) + 30 * 60;
				if (time() > $laterTime) {
					$arrived = true;
				}
			}
		}
		return $arrived;
	}
		
