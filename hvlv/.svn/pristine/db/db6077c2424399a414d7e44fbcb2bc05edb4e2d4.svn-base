	public function send(){
		$strMessage = $this->msg;
		// $strPhone = preg_replace('/^/+/', '', $this->no);
		$strPhone = $this->no;
		$cargoProcessId = $this->cargoProcessId;
		$this-> sendSmsNotice($strPhone,$strMessage,$cargoProcessId);
		
		
		$this->status = self::Status_Sent;
		$this->type = self::Type_Local_Arrival;
		
		$this->save();
	}
	
	public function funcIsSuccessSend($from , $to , $message){
		$data = new stdClass;
		$data->messages = array();
		$msg = new stdClass;
		// $msg->body = $this->msg;
		// $msg->to = preg_replace('/^/+/', '', $this->no);
		// $msg->from = 'TopLogistic';
		$msg->body = $message;
		$msg->to = preg_replace('/^/+/', '', $to);
		$msg->from = $from;
		$data->messages [0] = $msg;
		$data = json_encode($data);
		$opts = array('http' => array(
			'method' => 'POST',
			'header'=>array(
						   "Content-type: application/json",
                           "Authorization: Basic bHdqNTU1NTU6QkEyODRDM0MtOTlGRC0zRDE3LUY2NzMtRTNFQjZFQzY0RUEy",
						   'Content-Length: ' . strlen($data),
						   'Host: rest.clicksend.com',
						),
			'content' => $data));
        $context = stream_context_create($opts);
        $strResponse = file_get_contents('https://rest.clicksend.com/v3/sms/send', false, $context);
		$objResponse = json_decode($strResponse);
		if($objResponse->data->messages[0]->status =="SUCCESS"){
			$this->status = 1;
			$isSuccess = true ;
		}
		else{
			$this->status = 9;
			$isSuccess = false ;
		}
		$this->save();
		return $isSuccess;
	}
	
