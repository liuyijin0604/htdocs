	public function sendLocal(){
		$strMessage = $this->msg;
		$strPhone = $this->no;
		$this-> sendSmsNotice($strPhone,$strMessage);
		
		
		// $this->status = self::Status_Sent;
		$this->type = self::Type_Local_Arrival;
		
		$this->status = 99;
		$this->save();
	}

	public function send_yp($sig='PCA宇捷速递'){
		$o = [];
		$o['apikey'] ='c71e0c7d70bac9ffccc06c91ad90aa0a';
		$o['mobile'] = $this->no;
		$o['text'] = '【'.$sig.'】'.$this->msg;
		$data_string = http_build_query($o);
		if($this->debug) echo "Sent ".$data_string."\n";
		$c = new curl('https://sms.yunpian.com/v2/sms/single_send.json');
		$c->setopt(CURLOPT_FOLLOWLOCATION, true);
		$c->setopt(CURLOPT_POST, true);
		$c->setopt(CURLOPT_SSL_VERIFYPEER, false);
		$postr = $c->asPostString($o);
		$c->setopt(CURLOPT_POSTFIELDS, $postr);
		$c->exec();
		if($this->debug) echo 'Received: '.$c->result."\n";
		if(!empty($c->result)){
			$re=json_decode($c->result);
			$this->status = empty($re->code)? 99 : $re->code;
			$this->save();
		}
	}
	
	public function getStatus(){
		return empty(self::$states[$this->status])? '' : self::$states[$this->status];
	}

	/**
	 * Retrieves a list of models based on the current search/filter conditions.
	 *
	 * Typical usecase:
	 * - Initialize the model fields with values from filter form.
	 * - Execute this method to get CActiveDataProvider instance which will filter
	 * models according to data in model fields.
	 * - Pass data provider to CGridView, CListView or any similar widget.
	 *
	 * @return CActiveDataProvider the data provider that can return the models
	 * based on the search/filter conditions.
	 */
	public function search(){
		// @todo Please modify the following code to remove attributes that should not be searched.

		$criteria=new CDbCriteria;

		$criteria->compare('id',$this->id,true);
		$criteria->compare('type',$this->type);
		$criteria->compare('fid',$this->fid,true);
		$criteria->compare('status',$this->status);
		$criteria->compare('no',$this->no,true);
		$criteria->compare('msg',$this->msg,true);
		$criteria->compare('ts',$this->ts,true);

		return new CActiveDataProvider($this, array(
			'criteria'=>$criteria,
		));
	}
	
	public static function sendMessageLocal($no,$msg){
		$sms=new Sms();
		$sms->no=$no;
		$sms->msg=$msg;
		$sms->send();
		if($sms->status==99) return true;
		return false;
	}

	public static function sendCustomsMessageLocal($no,$msg){
		$isSendCustomsMsg = SystemSetting::getCustomsMessageSetting();
		if($isSendCustomsMsg)
		{
			$sms=new Sms();
			$sms->no=$no;
			$sms->msg=$msg;
			$sms->send();
			if($sms->status==99) return true;
			return false;
		}
		return true;
	}
	 
	 public static function SendMessageCn($no,$msg){
		 $sms=new Sms();
		 $sms->no=$no;
		 $sms->msg=$msg;
		 $sms->send_yp();
		 if($sms->status==99) return true;
		 return  false;
	}
	
	public static function checkIdMsg($no,$hbn,$pid){
	   $sql="SELECT t.id FROM `crm` t  INNER JOIN `crm_map` s ON t.id=s.crm_id WHERE t.main_type=20 AND t.type in (10) AND t.status<90 AND t.telephone=:tel";
	   $c=Yii::app()->db->createCommand($sql)->bindValues([':tel'=>$no])->queryScalar();
		if(!empty($c)){
			return false;
		}
		return true;
	}
	/**
	 * Returns the static model of the specified AR class.
	 * Please note that you should have this exact method in all your CActiveRecord descendants!
	 * @param string $className active record class name.
	 * @return Sms the static model class
	 */
	public static function model($className=__CLASS__){
		return parent::model($className);
	}
