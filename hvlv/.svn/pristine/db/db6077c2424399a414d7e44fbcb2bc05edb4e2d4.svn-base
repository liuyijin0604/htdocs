	public function sendSmsNotice($phone,$message,$cargoProcessId =0){
		ModalSmsNotice::Create($phone,$message,$cargoProcessId );
	}
	
	public function receiveSmsNotice(){
		//todo android手机端发短信的异步的，是否发成功会收到一个回执短信，会根据收到的回执是成功或失败设置$states，将sms_notice的记录移到sms表，type为local arrival ,保证短信都统一在sms表里
		
	}
	

	public static function smsUnicode($s){
		$ucs2 = mb_convert_encoding($s, "UCS-2", "auto");
		return bin2hex($ucs2);
	}
	
