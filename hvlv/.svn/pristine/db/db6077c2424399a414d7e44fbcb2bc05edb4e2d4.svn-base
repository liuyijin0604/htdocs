class Sms extends CActiveRecord{
	public $debug;
	public $cargoProcessId =0;

	public static $states = array(
		0 => 'Pending',
		1 => 'Sent',
		9 => 'Error',
	);
	
	public static $types = array(
		0 =>'Normal Message',
		10 => 'Tracking Update',
		20 => 'ID Upload Remider',
		30 => 'Booking Notice',
		40 => 'Local Arrival',
	);
	
	const Status_Pending = 0;
	const Status_Sent = 1;
	const Status_Error = 9;
	
	const Type_Tracking_Update = 10;
	const Type_ID_Upload_Remider = 20;
	const Type_Booking_Notice = 30;
	const Type_Local_Arrival = 40;
	


	/**
	 * @return string the associated database table name
	 */
	public function tableName(){
		return 'sms';
	}

	/**
	 * @return array validation rules for model attributes.
	 */
	public function rules(){
		// NOTE: you should only define rules for those attributes that
		// will receive user inputs.
		return array(
			array('type, fid, status, no, msg, ts', 'safe'),
			array('type, status', 'numerical', 'integerOnly'=>true),
			array('fid', 'length', 'max'=>11),
			array('no', 'length', 'max'=>20),
			array('msg', 'length', 'max'=>200),
			// The following rule is used by search().
			// @todo Please remove those attributes that should not be searched.
			array('id, type, fid, status, no, msg, ts', 'safe', 'on'=>'search'),
		);
	}

