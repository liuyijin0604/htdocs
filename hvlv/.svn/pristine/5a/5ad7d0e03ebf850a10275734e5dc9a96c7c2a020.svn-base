	public function getStatus()
	{
		return isset(static::$states[$this->status])? Yii::t(strtolower(__CLASS__), static::$states[$this->status]) : $this->status;
	}

	/**
	 * @return string the associated database table name
	 */
	public function tableName()
	{
		return 'import_charge_code';
	}

	/**
	 * @return array validation rules for model attributes.
	 */
	public function rules()
	{
		// NOTE: you should only define rules for those attributes that
		// will receive user inputs.
		return [
			['chargecode,org_id', 'required'],
			['status,charge_wt,status_mode,ignore_sac,type', 'numerical', 'integerOnly'=>true],
			['chargecode', 'length', 'max'=>6],
			['couriers', 'length', 'max'=>500],
			['note', 'length', 'max'=>500],
			['created, v_from, v_to,meta,ignore_sac,dpmt', 'safe'],
			// The following rule is used by search().
			// @todo Please remove those attributes that should not be searched.
			['id, chargecode,org_id, couriers, created,oids,status,charge_wt,status_mode,ignore_sac, v_from,type, v_to, note,owner_name,meta,dpmt,description', 'safe', 'on'=>'search'],
		];
	}

	/**
	 * @return array relational rules.
	 */
	public function relations()
	{
		// NOTE: you may need to adjust the relation name and the related
		// class name for the relations automatically generated below.
		return [
			'owner' => [self::BELONGS_TO, 'Org', 'org_id'],
			'allSurcharge' => [self::HAS_MANY, 'ImportsFlexibleSurcharge', 'chargecode_id','on'=>'status!=100'],
			'surcharge' => [self::HAS_MANY, 'ImportsFlexibleSurcharge', 'chargecode_id','on'=>'status!=100 and type!="fuel_surcharge"'],
			'courier_surcharge' => [self::HAS_MANY, 'ImportsFlexibleSurcharge', 'chargecode_id','on'=>'status!=100 and type!="fuel_surcharge" and courier_type="Courier Surcharge"'],
			'truck_delivery' => [self::HAS_MANY, 'ImportsFlexibleSurcharge', 'chargecode_id','on'=>'status!=100 and type!="fuel_surcharge" and courier_type="TLD Surcharge"'],
		];
	}

	/**
	 * if chargecode is empty , we create it now
	 * @return bool
	 */
	public function beforeValidate()
	{
		if (empty($this->chargecode)) {
			$this->chargecode = $this->genChargeCode();
		}
		return true;
	}

	/**
	 * if chargecode is empty , we create it now
	 * @return bool
	 */
	public function beforeSave()
	{
		if (empty($this->dpmt)) $this->dpmt = 10;
		if (empty($this->chargecode)) {
			$this->chargecode = $this->genChargeCode();
		}
		if (!empty($this->couriersObj)) {
			$this->couriers = json_encode($this->couriersObj);
		}
		$this->meta = empty($this->mdata)? '' : json_encode($this->mdata);

		if(!$this->isNewRecord)
		{
			$oldModel = ImportChargeCode::model()->findByPk($this->id);
			if(json_encode($oldModel->getAttributes())!=json_encode($this->getAttributes()))
			{
				$extra = [];
				if($oldModel->couriers!=$this->couriers)
				{
					$oldCourierArr = json_decode($oldModel->couriers,true);
					$newCourierArr = json_decode($this->couriers,true);
					$oldCourierStr = "";
					$newCourierStr = "";
					if(!empty($oldCourierArr))
					{
						$oldOrgRates =  OrgRate::model()->findAll(" id in (".join($oldCourierArr).")");
						foreach ($oldOrgRates as $key => $value) 
						{
							$oldCourierStr .= $value->name.",";
						}
					}
					if(!empty($newCourierArr))
					{
						$newOrgRates =  OrgRate::model()->findAll(" id in (".join($newCourierArr).")");
						foreach ($newOrgRates as $key => $value) {
							$newCourierStr .= $value->name.",";
						}
					}
					$extra["CourierData"] = " Old: ".$oldCourierStr." changed to: ".$newCourierStr;

				}
				$extra["oldData"] = json_encode($oldModel->getAttributes());
				TlaLog::add($this, $this->isNewRecord? 3 : 4, array_merge(['status' => $this->getStatus()], $extra));
			}
		}


		return true;
	}

	public function log($action)
	{
		$extra =["action"=>$action];
		TlaLog::add($this, $this->isNewRecord? 3 : 4, array_merge(['status' => $this->getStatus()], $extra));
	}


	public function afterFind()
	{
		if (!empty($this->meta)) {
			$this->mdata = json_decode($this->meta, true);
		}
		if (!empty($this->couriers)) {
			$this->couriersObj = json_decode($this->couriers, true);
		}
	}

	public static function isActive($chargeCode){
		return ImportChargeCode::model()->count('chargecode = :ccode AND status = 1', [':ccode' => $chargeCode]) > 0;
	}

	public static function isPriorityLetter($chargecode){
		$cc = ImportChargeCode::model()->find('chargecode = :ccode AND status = 1', [':ccode' => $chargeCode]);
		if(empty($cc)) return false;
		return in_array(633, $this->couriersObj) || in_array(636, $this->couriersObj);
	}

	/**
	 * create random 4 digitals charge code
	 * @return string
	 */
	private function genChargeCode()
	{
		$digits = 4;
		$chargecode = '';
		while (true) {
			$chargecode = str_pad(rand(0, pow(10, $digits) - 1), $digits, '0', STR_PAD_LEFT);
			$query = ImportChargeCode::model()->find('chargecode = :ccode', [':ccode' => $chargecode]);
			if (empty($query)) {
				break;
			}
		}
		return $chargecode;
	}

	/**
	 * @return array customized attribute labels (name=>label)
	 */
	public function attributeLabels()
	{
		return [
			'id' => 'ID',
			'chargecode' => 'Chargecode',
			'couriers' => 'Couriers',
			'created' => 'Created',
			'status' => 'Status',
			'v_from' => 'V From',
			'v_to' => 'V To',
			'note' => 'Backend DES',
			'description' => 'FRONT DES'
		];
	}

	/**
	 * Retrieves a list of models based on the current search/filter conditions.
	 *
	 * Typical usecase:
	 * - Initialize the model fields with values from filter form.
	 * - Execute this method to get CActiveDataProvider instance which will filter
	 * models according to data in model fields.
	 * - Pass data provider to CGridView, CListView or any similar widget.
	 *
	 * @return CActiveDataProvider the data provider that can return the models
	 * based on the search/filter conditions.
	 */
	public function search()
	{
		// @todo Please modify the following code to remove attributes that should not be searched.

		$criteria=new CDbCriteria;
				
		$criteria->with = ['owner'];
		$criteria->compare('t.id', $this->id, true);
		$criteria->compare('chargecode', $this->chargecode, true);
		$criteria->compare('couriers', $this->couriers, true);
		$criteria->compare('created', $this->created, true);
		$criteria->compare('t.status', $this->status);
		$criteria->compare('t.type', $this->type);
		$criteria->compare('owner.name', $this->owner_name, true);
		$criteria->compare('v_from', $this->v_from, true);
		$criteria->compare('v_to', $this->v_to, true);
		$criteria->compare('note', $this->note, true);
		$criteria->compare('description', $this->description, true);
		$criteria->compare('t.dpmt', $this->dpmt);
		if (!empty($this->oids)) {
			$criteria->addInCondition('t.org_id', $this->oids);
		}

		return new CActiveDataProvider($this, [
			'criteria'=>$criteria,
			'sort' => [
				'attributes' => [
					'owner_name' => [
						'asc' => 'owner.name',
						'desc' => 'owner.name DESC',
					],
					'*',
				],
			],
			'pagination'=>[
				'pageSize'=>50,
			],
		]);
	}
	/*
	 * To check if the chargecode set up the rate for the postcode on the specify weight;
	 *
	 * @Param    $shipment  Imparcel Model
	 * @return   array with status and msg    1=> find, 0=>not found;
	 */
	public function hasChargeSetUp($shipment)
	{
		$resp=['status'=>false,'msg'=>''];
		if(!empty($shipment->mdata['pe_number']))
		{
			$resp=['status'=>true,'msg'=>''];
			return $resp;
		}
		$isCBM = !empty($this->mdata['calculate_cbm']);
		$chargeWeight = empty($this->charge_wt)? $shipment->chargeWeight() : $shipment->weight;
		$chargeLabel = "Weight";
		if($isCBM){
			$chargeWeight = empty($this->charge_wt)? $shipment->chargeCbm() : $shipment->cbm;
			$chargeLabel = "CBM";
		}

		if($this->chargecode=='5492')
		{
			$dfeApi = new DFEAPI('syd');
			$o = $dfeApi->getRevenue($this,$shipment->cnee->suburb,$shipment->cnee->postcode,$chargeWeight);
			if($o->code==1)
			{
				$resp['msg']='with postcode: '.$shipment->cnee->postcode.' Not in the Chargecode:'.$this->chargecode.' delivery Zone!';
			}else if($o->code==2)
			{
				$resp['msg']='with Weight: '.$shipment->weight.'kg, CBM: '.$shipment->pkg.' &times; '.$shipment->cbm.'M<sup>3</sup>, Chargeble '.$chargeLabel.': '.$chargeWeight.'kg not in the Chargecode: '. $this->chargecode.' weight Range!';
			}else
			{
				$resp['status']=true;
				return $resp;
			}
			return $resp;
		}

		$code = "";
		$courierList = [];

		foreach ($this->couriersObj as $key => $courierId) {
			$courier = OrgRate::model()->findByPk($courierId);
			$courierList[] = $courier->org_id;
		}

		if(!empty($this->couriersObj)&&count($this->couriersObj)==1){
			$courierId= $this->couriersObj[0];
			$courier = OrgRate::model()->findByPk($courierId);
			$code = $courier->code;
		}



		if($code==ImportChargeCode::AUPOST_INTERNATIONAL_CODE)//for international
		{
			$country = $shipment->cnee->country;
			$zone = SystemSetting::getIntZone();
			if(!empty($zone[$country]))
			{
				$zoneRates = ZoneRate::model()->findAll('chargecode_id = :cid AND weight_lo <=:w AND weight_hi >= :w AND zone = :z AND base+item+perkg+minimum > 0', [':cid' => $this->id, ':w' => ceil($theWeight*10)/10, ':z' => $zone[$country]]);
				if (!empty($zoneRates)) {
					$resp['status']=true;
					return $resp;
				}
				$resp['msg']='with Weight: '.$shipment->weight.'kg, CBM: '.$shipment->pkg.' &times; '.$shipment->cbm.'M<sup>3</sup>, Chargeble '.$chargeLabel.': '.$chargeWeight.'kg not in the Chargecode: '. $this->chargecode.' weight Range!';
			}else
			{
				$resp['msg']='with postcode: '.$shipment->cnee->postcode.' Not in the international Chargecode:'.$this->chargecode.' delivery Zone!';
			}

			return $resp;
		}



		$zoneMaps = ZoneMap::model()->findAll('chargecode_id = :cid AND pc_lo <= :pc AND pc_hi >= :pc', [':cid' => $this->id, ':pc' => $shipment->cnee->postcode]);
		if (!empty($zoneMaps)) {
			foreach ($zoneMaps as $zoneMap) {
				$theWeight = $chargeWeight;
				if(((isset($this->mdata['eparcel_single'])&&$this->mdata['eparcel_single']==0)||empty($this->mdata['eparcel_single']))&&$shipment->pkg > 1){
					if(in_array(Org::ORGID_COURIER_AUPOST, $courierList))
					{
						$maxWeight = Yii::app()->db->createCommand('SELECT MAX(weight_hi) FROM `zone_rate` WHERE chargecode_id = :cid AND zone = :z AND base+item+perkg+minimum > 0')->bindValues([':cid' => $this->id, ':z' => $zoneMap['z1']])->queryScalar();
						if($maxWeight < 100){
							$theWeight = $chargeWeight / $shipment->pkg;
						}
					}
				}

				$zoneRates = ZoneRate::model()->findAll('chargecode_id = :cid AND weight_lo <=:w AND weight_hi >= :w AND zone = :z AND base+item+perkg+minimum > 0', [':cid' => $this->id, ':w' => ceil($theWeight*10)/10, ':z' => $zoneMap['z1']]);
				if (!empty($zoneRates)) {
					$resp['status']=true;
					return $resp;
				}
			}
			$resp['msg']='with Weight: '.$shipment->weight.'kg, CBM: '.$shipment->pkg.' &times; '.$shipment->cbm.'M<sup>3</sup>, Chargeble '.$chargeLabel.': '.$chargeWeight.'kg not in the Chargecode: '. $this->chargecode.' weight Range!';
		} else {
			$resp['msg']='with postcode: '.$shipment->cnee->postcode.' Not in the Chargecode:'.$this->chargecode.' delivery Zone!';
		}
		return $resp;
	}
	
	public function isInternational()
	{
		$code = "";
		if(!empty($this->couriersObj)&&count($this->couriersObj)>0){
			$courierId= $this->couriersObj[0];
			$courier = OrgRate::model()->findByPk($courierId);
			$code = $courier->code;
		}

		if($code==ImportChargeCode::AUPOST_INTERNATIONAL_CODE)
		{
			return true;
		}else
		{
			return false;
		}
	}
	/**
	 * Returns the static model of the specified AR class.
	 * Please note that you should have this exact method in all your CActiveRecord descendants!
	 * @param string $className active record class name.
	 * @return ImportChargeCode the static model class
	 */
	public static function model($className=__CLASS__)
	{
		return parent::model($className);
	}
}
