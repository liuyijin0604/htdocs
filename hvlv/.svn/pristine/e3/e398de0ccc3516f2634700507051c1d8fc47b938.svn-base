	public function actionUpdateFile($id)
	{
		$model = ImParcel::model()->findByPk($id);

		// calculate week no
		$inTime = new DateTime(@$model->process->mdata['ssdate'], new DateTimeZone('Australia/Sydney'));
		$outTime = new DateTime('now', new DateTimeZone('Australia/Sydney'));
		$storedDays = $outTime->diff($inTime)->format("%a");
		$weekendDays = !(empty($model->process->mdata['ssdate']))?HolidayHelper::getWeekendDaysBetweenTwoDays($model->process->mdata['ssdate'],date('Y-m-d'),$model->consol->pod):0;
		// calculate week no
		$model->process->mdata['fw'] = floor($storedDays / 7) + 1;
		$model->process->mdata['fd'] = (($storedDays-$weekendDays)+1)>0?($storedDays-$weekendDays)+1:0;
		$model->process->update('meta');

		if ($model === null) {
			throw new CHttpException(404, 'The requested page does not exist.');
		}
		$otype = $model->process->type;

		if((($model->bwf&512)>0)&&($model->process->type&ShipmentProcess::TYPE_EMPP)==0)
		{
			$model->process->type  = $model->process->type|ShipmentProcess::TYPE_EMPP;
		}

		if((($model->bwf&32)>0)&&($model->process->type&ShipmentProcess::TYPE_AQIS)==0)
		{
			$model->process->type  = $model->process->type|ShipmentProcess::TYPE_AQIS;
		}

		if((($model->bwf&4)>0)&&($model->process->type&ShipmentProcess::TYPE_HV)==0)
		{
			$model->process->type  = $model->process->type|ShipmentProcess::TYPE_HV;
		}

		if((($model->bwf&8)>0)&&($model->process->type&ShipmentProcess::TYPE_SAC)==0)
		{
			$model->process->type  = $model->process->type|ShipmentProcess::TYPE_SAC;
		}

		if($otype!=$model->process->type)
		{
			$model->process->update('type');
		}

		$this->render('tab_files', ['model' => $model,'parentTab'=>$_GET['parentTab']]);
	}

