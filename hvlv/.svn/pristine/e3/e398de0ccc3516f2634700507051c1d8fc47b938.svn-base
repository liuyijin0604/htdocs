			// 	$o = $model->sendEmail($files);
			// }else
			// {
				$o = $model->sendEmail($files);
				// $org = Org::model()->findByPk($shipment->agent_id);
				// $email = '';
				// $ccList = [];
				// if (!empty($org->extra['client_billing_email']))
				// {
				// 	foreach (preg_split('/[,;]+/i', trim($org->extra['client_billing_email'])) as $k=>$to) {
				// 		if($k==0)
				// 		{
				// 			$email = $to;
				// 		}else
				// 		{
				// 			$ccList[] = $to;
				// 		}
				// 	}
				// }
				// $model->mdata['to'] = $email;
				// $model->mdata['cc'] = join(';',$ccList);
				// $o = $model->sendEmail();
			// }
			if ($o['status']) {
				$invoice->status = Invoice::INVOICE_STATUS_POSTED;
				$invoice->update('status');
				$process = ShipmentProcess::model()->find('pid=:pid', [':pid' => $model->fid]);
				$process->changeStatus(ShipmentProcess::INFROM_CUSTOMER_PAY);
			}
			AppHelper::unlinkRecursive($tempDirectory);
			$this->ajaxResult($model, ['id'], 'Email Sent Successfully');
		}
		$email = '';
		$ccList = [];
		$shipment = $this->loadModel($id);
		if (($shipment->bwf & ImParcel::CUSTOM_DDP) > 0) {
			$org = Org::model()->findByPk($shipment->agent_id);
			// if($shipment->agent_id==Org::ORGID_COURIER_4PX)
			// {
			// 	$email = 'ar_syd@4px.com;';
			// 	$ccList[] = 'jessiejj@4px.com';
			// }else
			// {
			// 	if (!empty($org->extra['outturn_email'])) {
			// 		foreach (preg_split('/[,;]+/i', trim($org->extra['outturn_email'])) as $to) {
			// 			$email = $to;
			// 			break;
			// 		}
			// 	}
			// }
			if (!empty($org->extra['outturn_email'])) {
					foreach (preg_split('/[,;]+/i', trim($org->extra['outturn_email'])) as $to) {
						$email = $to;
						break;
					}
			}
			$model->type = Emailog::CUSTOM_INVOICE_AGENT;
		} elseif (($shipment->bwf & ImParcel::CUSTOM_DDU) > 0) {
			$email = isset($shipment->cnee->email) ? $shipment->cnee->email : '';
			$model->type = Emailog::CUST_INVOICE_INFORM;
			if($shipment->agent_id==Org::ORGID_COURIER_4PX)
			{
				$org = Org::model()->findByPk($shipment->agent_id);
				if (!empty($org->extra['outturn_email'])) {
						foreach (preg_split('/[,;]+/i', trim($org->extra['outturn_email'])) as $ck =>$to) {
							if($ck==0)
							{
								$email = $to;
							}else
							{
								$ccList[] = $to;
							}
						}
				}
			}
		}
		$model->prepTemplate();
		$model->subject = $model->tpl->subject;
		$model->body = $model->tpl->getContent();

		$model->mdata['to'] = $email;
		if(!empty(Yii::app()->name)&&Yii::app()->name=='TLA')
		{
			$ccList[] = Yii::app()->user->grp == 72 ? Yii::app()->user->email : 'imports@toplogistics.com.au';
			$model->mdata['cc'] = join(';',$ccList);
		}else
		{
			$ccList[] = Yii::app()->user->grp == 72 ? Yii::app()->user->email : 'imports@toplogistics.com.au';
			$model->mdata['cc'] = join(';',$ccList);
		}
		$this->render('create_email', [
			'model' => $model,
		]);
	}

	/*
	 * change the shipmentProcess status
	 */
	public function actionProcess($id)
	{
		if (empty($id) || empty($_POST['custom_status'])) {
			return false;
		} else {
			$process = ShipmentProcess::model()->find('pid=:pid', [':pid' => $id]);
			if (empty($process)) {
				$model = ImParcel::model()->findByPk($id);
				$model->newShipmentProcess($_POST['custom_status']);
			} else {
				$transaction = Yii::app()->db->beginTransaction();
				try {
					$process->changeStatus($_POST['custom_status']);
					if (isset($_POST['broker_id'])) {
						if (!empty($_POST['broker_id']) && $process->broker_id != $_POST['broker_id']) {
							$org = Org::model()->findByPk($_POST['broker_id']);
							if (!empty($org) && preg_match('/04\d{8}/', $org->phone)) {
								Sms::sendCustomsMessageLocal($org->phone, 'Top Logistics ' . $process->shipment->hbn . ' has been assigned to you for customs clearance');
							}

						}
						$process->broker_id = $_POST['broker_id'];
						$process->update('broker_id');
					}
					$process->mdata['inv_terms'] = isset($_POST['inv_terms']) ? $_POST['inv_terms'] : [];
					if (isset($_POST['ssdate'])) {
						$process->mdata['ssdate'] = empty($_POST['ssdate']) ? '' : $_POST['ssdate'];
					}

					if (isset($_POST['direction_due_date'])) {
						$process->mdata['direction_due_date'] = empty($_POST['direction_due_date']) ? '' : $_POST['direction_due_date'];
					}

					if (isset($_POST['cabill_name'])) {
						$process->mdata['cabill_name'] = trim($_POST['cabill_name']);
					}

					if (isset($_POST['cabill_addr'])) {
						$process->mdata['cabill_addr'] = trim($_POST['cabill_addr']);
					}

					if (!empty($process->mdata['ssdate'])) {
						if (!empty($_POST['fw'])) {
							$process->mdata['fw'] = $_POST['fw'];
						} else {
							$process->mdata['fw'] = 1;
						}
					}
					$process->updateMeta();
					if ($_POST['custom_status'] == ShipmentProcess::CUSTOM_DONE||$_POST['custom_status'] == ShipmentProcess::STATE_AQIS_CUSTOMS_DONE)
					{

						if ($process->shipment->status == 57) {
							if($process->shipment->scanCount()>0&&!$process->shipment->isParcelPickup())
							{
								$process->shipment->status = 58;
							}else
							{
								$process->shipment->status = 60;
							}
						}

						ImParcelService::accHeldShipment($process->shipment);

						$process->status = $_POST['custom_status'];
						$process->update('status');
						//$this->checkSendNotice($id);
					}
					$transaction->commit();
				} catch (Exception $ex) {
					$transaction->rollback();
					throw $ex;
				}
			}
			echo 'done';
			return true;
		}
	}

	public function actionHouseWaybill($id)
	{
		$model = $this->loadModel($id);
		if($model->consol->service==Consol::SEACONSOL)
