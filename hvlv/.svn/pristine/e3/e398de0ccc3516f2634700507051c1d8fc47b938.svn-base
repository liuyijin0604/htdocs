	public function actionAssignUser()
	{
		if (!empty($_POST)) {
			$model = new TypeMapUser();
			foreach ($_POST as $key => $value) {
				$type_map = $_POST;
				$r = TypeMapUser::model()->find('type=1 AND map_type=:map_type', [':map_type' => $key]);
				if (!empty($r)) {
					if (empty($value)) {
						$r->status = 0;
					} else {
						$r->status = 1;
						$r->user_id = $value;
					}
					$r->save();
				} else {
					$r = new TypeMapUser();
					$r->type = TypeMapUser::TYPE_CUSTOM_PROCESS;
					$r->map_type = $key;
					$r->user_id = $value;
					$r->status = 1;
					$r->save();
				}
				$rs = ShipmentProcess::model()->findAll('status<24');
				$transaction = Yii::app()->db->beginTransaction();
				try {
					foreach ($rs as $r) {
						foreach ($r->preccesLog as $plog) {
							if ($plog->status != 1) {
								continue;
							}
							$plog->user_id = @$type_map[$plog->type];
							$plog->update('user_id');
						}
					}
					$transaction->commit();
				} catch (Exception $ex) {
					$transaction->rollback();
				}
			}
			$this->ajaxResult($model);
		}

		$this->render('assign_user');
	}

	public function actionExport()
	{
		$model = new ImParcel('search');
		$model->unsetAttributes(); // clear any default values
		if (isset($_GET['ImParcel'])) {
			$model->attributes = $_GET['ImParcel'];
		}
		$model->process_not_status = [24];
		if (!empty($_GET['agent_id'])) {
			if ($_GET['agent_id'] == 1002) {
				$model->agent_id = $_GET['agent_id'];
				$model->not_bwf = 2;
			} elseif ($_GET['agent_id'] == 1401) {
				$model->agent_id = 1002;
				$model->bwf = 2;
			} else {
				$model->agent_id = $_GET['agent_id'];
			}
		}
		$dp = $model->search(false);
		$xls = new oExcel;
		$i = 1;
		$xls->addRow($i++, ['WBN', 'Ref', 'Awb', 'Packages', 'Weight', 'Status', 'process status', 'Agent', 'Sender', 'Sender Tel', 'Cnee Name', 'Cnee Tel', 'Address', 'State', 'Date', 'value(USD)', 'Extra Info','Memo','Note']);

		foreach ($dp->data as $r) {
			if (empty($r->cnee)) {
				continue;
			}
			$ln = $r->getLastLog();
			$extraInfo = $r->getExtraInfo();
			$process_status = $r->getProcessStatus();
			$dd = empty($ln) ? 0 : ceil((time() - strtotime($ln->time)) / 86400);
			$xls->addRow($i++, [$r->hbn, $r->ref, empty($r->consol) ? '' : $r->consol->awb, $r->pkg, $r->weight, $r->getStatus(), $process_status, empty($r->agent) ? '' : $r->agent->name, $r->cnor->name, '="' . $r->cnor->tel . '"', $r->cnee->name, '="' . $r->cnee->tel . '"', $r->cnee->address, $r->cnee->state, $r->created, $r->dvalue, $extraInfo,$r->can,@$r->mdata['custom_note']]);
		}
		$xls->output('imp_search_export_' . time() . '.xlsx');
	}

	public function actionExportHistoryCustomKPIReport(){

		if (empty($_POST)) {
			$this->render('custom_process_time_pick',['type'=>'Total']);
		} else {
			$arrCustomKPIs = CustomsProcessService::getCustomProcessKPIReport($_POST['startdate'],$_POST['enddate']);
			$xls = new oExcel;
			$i = 1;
			$xls->addRow($i++, ['Date','HV Open','HV Close','EMPP Open','EMPP Close','AQIS Open','AQIS Close']);
			foreach($arrCustomKPIs as $startdate => $arrCustomKPI){
				$xls->addRow($i++, [$startdate,$arrCustomKPI[1],$arrCustomKPI[2],$arrCustomKPI[3],$arrCustomKPI[4],$arrCustomKPI[5],$arrCustomKPI[6]]);
			}
			$xls->output('custom_process_export_' . time() . '.xlsx');
		}
	}

	public function actionExportHistoryCustomKPIDetailReport(){

		if (empty($_POST)) {
			$this->render('custom_process_time_pick',['type'=>'Detail']);
		} else {
			$arrCustomKPIs = CustomsProcessService::getCustomProcessOpenRecordsDetail($_POST['startdate'],$_POST['enddate']);
			$xls = new oExcel;
			$i = 1;
			$xls->addRow($i++, ['Date','HBN','REF','HV Open','HV Close','EMPP Open','EMPP Close','AQIS Open','AQIS Close']);
			
			foreach($arrCustomKPIs as $arrCustomKPI){
				$xls->addRow($i++, [$arrCustomKPI[0],$arrCustomKPI[1],$arrCustomKPI[2],$arrCustomKPI[3],$arrCustomKPI[4],$arrCustomKPI[5],$arrCustomKPI[6],$arrCustomKPI[7],$arrCustomKPI[8]]);
			}
			$xls->output('custom_process_detail_export_' . time() . '.xlsx');
		}
	}

	public function actionGetProcessAmount()
	{
		$temp = [];
		$temp['empp_custom'] = ShipmentProcess::getProcessAmount([ShipmentProcess::STATE_EMPP_CUSTOM]);
		$temp['aqis_custom'] = ShipmentProcess::getProcessAmount([ShipmentProcess::STATE_AQIS_CUSTOM]);
		$temp['msg_send'] = ShipmentProcess::getProcessAmount([ShipmentProcess::MSG_SENDER, ShipmentProcess::MSG_CONSIGNEE]);
		$temp['doc_wait'] = ShipmentProcess::getProcessAmount([ShipmentProcess::DOC_RECEIVED]);
		$temp['msg_brok'] = ShipmentProcess::getProcessAmount([ShipmentProcess::MSG_BROKER]);
		$temp['wait_entry'] = ShipmentProcess::getProcessAmount([ShipmentProcess::ENTRY_SEND]);
		$temp['entry_confirm'] = ShipmentProcess::getProcessAmount([ShipmentProcess::ENTRY_CONFIRM, ShipmentProcess::INFORM_BROKER_PAY]);
		$temp['inform_pay'] = ShipmentProcess::getProcessAmount([ShipmentProcess::INFROM_CUSTOMER_PAY]);
		$temp['payment_rec'] = ShipmentProcess::getProcessAmount([ShipmentProcess::PAYMENT_RECEIVED]);
		$temp['confirm_pay'] = ShipmentProcess::getProcessAmount([ShipmentProcess::CONFIRM_PAYMENT]);
		echo json_encode($temp);
	}

	public function actionCustomDetail()
	{
		$type = $_GET['type']; //status
		$index = $_GET['index']; //2=>1-3,3=>3-5, 4=>5+
		$dayName = '';
		if ($index == 2) {
			$dayName = 'Less Than 3 Days';
			$start = -1;
			$end = 3;
		} elseif ($index == 3) {
			$dayName = "3-5 Days";
			$start = 3;
			$end = 5;
		} elseif ($index == 4) {
			$dayName = "5+ Days";
			$start = 5;
			$end = 365;
		}
		$sql = "SELECT t.pid as id, DATEDIFF(NOW(),date) as day_diff FROM `shipment_process` t WHERE status!=24 HAVING day_diff>=:start AND day_diff<:end";
		$rs = Yii::app()->db->createCommand($sql)->bindValues([':start' => $start, ':end' => $end])->queryAll();
		$ids = [];
		foreach ($rs as $r) {
			$ids[] = $r['id'];
		}
		$model = new ImParcel('search');
		$model->unsetAttributes();
		if (isset($_GET['ImParcel'])) {
			$model->setAttributes($_GET['ImParcel']);
		}
		$model->process_statuses = ShipmentProcess::$processTypes[$type];
		$model->mids = $ids;
		$name = ShipmentProcess::$processTypesMap[$type] . "=>" . $dayName;
		$list = AppHelper::setting2List('pods'); ksort($list);
		$this->render('shipment_list', ['model' => $model, 'name' => $name ,'list'=>$list]);
	}
	public function actionCopyEmail($id)
	{
		$from = ImParcel::model()->findByPk($id);
		$process = ShipmentProcess::model()->findByPk($_GET['fid']);
		$to = $process->shipment;
		if (!empty($to->cnee->email)) {
			$to->note .= "email:" . $to->cnee->email;
			$to->update('note');
		}
		$to->cnee->email = $from->cnee->email;
		if ($to->cnee->save()) {
			echo 'done';
		} else {
			echo implode(", ", $to->cnee->getErrors());
		}
	}
	public function actionCopyLoa($id)
	{
		$fromFile = FileRepo::model()->findByPk($id);
		if (!empty($fromFile)) {
			$ifExist = FileRepo::model()->find('fid=:fid and status!=0 AND name=:name', [':fid' => $_GET['fid'], ':name' => $fromFile->name]);
			if (!$ifExist) {
				$fileRepo = new FileRepo;
				$fileRepo->attributes = $fromFile->attributes;
				$fileRepo->type = 19;
				$fileRepo->date = date('Y-m-d H:i:s');
				$fileRepo->fid = $_GET['fid'];
				if ($fileRepo->save()) {
					echo 'done';
				} else {
					var_dump($fileRepo->getErrors());
				}
				return;
			}
		}
		echo 'done';
	}

	public function actionCopyEmailAndLoa()
	{
		$check1 = true;
		$from = ImParcel::model()->findByPk($_GET['eid']);
		$process = ShipmentProcess::model()->findByPk($_GET['efid']);
		$to = $process->shipment;
		if (!empty($to->cnee->email)) {
			$to->note .= "email:" . $to->cnee->email;
			$to->update('note');
		}
		$to->cnee->email = $from->cnee->email;
		if ($to->cnee->save()) {
			$check1 = true;
		} else {
			$check1 = false;
			echo implode(", ", $to->cnee->getErrors());
		}

		$check2 = true;
		$fromFile = FileRepo::model()->findByPk($_GET['lid']);
		if (!empty($fromFile)) {
			$ifExist = FileRepo::model()->find('fid=:fid and status!=0 AND name=:name', [':fid' => $_GET['lfid'], ':name' => $fromFile->name]);
			if (!$ifExist) {
				$fileRepo = new FileRepo;
				$fileRepo->attributes = $fromFile->attributes;
				$fileRepo->type = 19;
				$fileRepo->date = date('Y-m-d H:i:s');
				$fileRepo->fid = $_GET['lfid'];
				if ($fileRepo->save()) {
					$check2 = true;
				} else {
					var_dump($fileRepo->getErrors());
					$check2 = false;
				}
			}
		}
		if($check1&&$check2)
		{
			echo "done";
		}
		return;
	}
	public function actionNotes($id)
	{
		$model = ShipmentProcess::model()->findByPk($id);
		Log::add($model, Log::LOG_TYPE_NOTES, ['notes' => $_POST['notes']]);
		$this->ajaxResult($model);
	}
	public function actionGenerateST($id)
	{
		$model = ImParcel::model()->findByPk($id);
		if (!empty($_POST['ssdate'])) {
			$model->process->mdata['ssdate'] = $_POST['ssdate'];
			$model->process->update('meta');
		}
		$result = $model->createStorageInvoiceWhenDdu();
		if ($result['status'] == 0) {
			$model->addError('id', $result['msg']);
		}
		$this->ajaxResult($model);
	}

	public function actionGenerateInspectionRequestForm($id)
	{
		$model = $this->loadModel($id);
		$customsProcessService = new CustomsProcessService();
		if(!empty($_POST))
		{
			echo json_encode($customsProcessService->generateAQISFile($id,$_POST['type'],$_POST));
			return;
		}

		$setting = $customsProcessService->getInsRequestFormSetting($id);

		$this->render('edit_request_inspection_form', ['model' => $model,'setting'=>$setting,'type'=>"INS_REQUEST_FORM"]);
	}

	public function actionGenerateDisposalRequestForm($id)
	{
		$model = $this->loadModel($id);
		$customsProcessService = new CustomsProcessService();
		if(!empty($_POST))
		{
			echo json_encode($customsProcessService->generateAQISFile($id,$_POST['type'],$_POST));
			return;
		}

		$setting = $customsProcessService->getInsRequestFormSetting($id);

		$this->render('edit_request_disposal_form', ['model' => $model,'setting'=>$setting,'type'=>"DIS_REQUEST_FORM"]);
	}

	public function actionGoNextAqisStatus($id)
	{
		$customsProcessService = new CustomsProcessService();
		echo json_encode($customsProcessService->goNextAqisStatus($id,$_POST['status'],$_POST['action'],$_POST));
	}

	public function actionCreateAqisEmail($id)
	{
		$customsProcessService = new CustomsProcessService();
		if(!empty($_POST))
		{
			echo json_encode($customsProcessService->sendAQISEmail($id,$_POST,$_GET['type'],$_GET['action']));
			return;
		}

		$model = $customsProcessService->getAqisEmail($id,$_GET['type']);
		$this->render('create_email_m', [
			'model' => $model
		]);
	}

	public function loadModel($id)
	{
		$model = ImParcel::model()->findByPk($id);
		if ($model === null) {
			throw new CHttpException(404, 'The requested page does not exist.');
		}
		return $model;
	}

	public function actionShowShipmentList()
	{
		$shipmentNos = $_GET["no"];
		$shipmentNos = explode(",", $shipmentNos);
		echo"<table><thead><td>HBN</td></thead>";
		foreach ($shipmentNos as $key => $shipmentNo) {
			echo "<tr><td>{$shipmentNo}</td></tr>";
		}
		echo "</table>";
	}
}
