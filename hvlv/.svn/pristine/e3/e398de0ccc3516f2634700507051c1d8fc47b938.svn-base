 *
 * @author peter
 */
class CustomProcessController extends Controller
{
	//put your code here
	protected $skipAcl=['upload'];
	protected $nonAjax = ['houseWaybill', 'export','exportHistoryCustomKPIReport','exportHistoryCustomKPIDetailReport','upload'];

	/*
	 * list the shipments that the value is over 1,000, which would need t oreport to custom
	 */

	public function actionCustomList()
	{
		$agentId = 0;
		$value = 1000 * Currency::getExrate()[0];
		$modelShipment = new ImParcel('search');
		$modelShipment->isCustomSearching = 1;
		$modelShipment->unsetAttributes();
		if (isset($_GET['ImParcel'])) {
			$modelShipment->setAttributes($_GET['ImParcel']);
		}
		$modelShipment->process_not_status = [24,200];
		$list = AppHelper::setting2List('pods'); ksort($list);

		if (Yii::app()->user->grp == 72) {
			$modelShipment->setAttribute('process_broker', Yii::app()->user->org);
			//4,10,12,14
			$modelShipment->process_not_status = array_merge([1, 2, 5, 6, 15, 16, 23, 24],array_keys(ShipmentProcess::$aqisStates));
		}
		if (isset($_POST['agent_id']) || isset($_GET['agent_id'])) {
			if (isset($_POST['agent_id'])) {
				if (!empty($_POST['agent_id'])) {
					$modelShipment->setAttribute('agent_id', $_POST['agent_id']);
				}
				$agentId = $_POST['agent_id'];
			} else {
				if (!empty($_GET['agent_id'])) {
					if ($_GET['agent_id'] == 1401) {
						$modelShipment->setAttribute('agent_id', 1002);
						$modelShipment->bwf = 2;
					} else {
						$modelShipment->setAttribute('agent_id', $_GET['agent_id']);
						if ($_GET['agent_id'] == 1002) {
							$modelShipment->not_bwf = 2;
						}
					}
				}
				$agentId = $_GET['agent_id'];
			}
			$this->renderPartial('_sub_shipments', [
				'shipment_model' => $modelShipment,
				'agentId' => $agentId,
				'value' => $value,
				'list' => $list
			]);
		} else {

		$filtersForm = new FiltersForm;
		$filtersForm1 = new FiltersForm1;
		if (isset($_GET['FiltersForm'])) {
			$filtersForm->filters = $_GET['FiltersForm'];
		}
		if (isset($_GET['FiltersForm1'])) {
			$filtersForm1->filters = $_GET['FiltersForm1'];
		}
		$provide = [];
		$sql = "SELECT count(id) as c, case when DATEDIFF(NOW(),date) between 0 and 2 then 'n1' when DATEDIFF(NOW(),date) between 3 and 4 then 'n3' else 'n5' end as dr, case when status between 2 and 3 then 1 when status = 4 then 2 when status = 10 then 3 when status = 12 then 4 when status = 14 or status = 16 then 5 when status = 18 then 6 when status = 20 then 7 when status = 22 then 8 else 0 end as sr FROM `shipment_process` t WHERE status not IN (1,5,6,15,23,24) group by sr, dr";
		$rs = Yii::app()->db->createCommand($sql)->queryAll();
		$anotherProvide = [];
		$kvs = [];
		foreach ($rs as $r) {
			if(!isset($anotherProvide[$r['sr']])){
				if(empty($r['sr'])) continue;
				$anotherProvide[$r['sr']] = [
					'id' => $r['sr'], 
					'name' => ShipmentProcess::$processTypesMap[$r['sr']], 
					'type' => $r['sr']
				];
			}
			$anotherProvide[$r['sr']][$r['dr']] = $r['c'];
		}
		$filteredData1 = $filtersForm1->filter($anotherProvide);
		$dataprovider1 = new CArrayDataProvider($filteredData1);

		//pre the top table data:
		$returnStatics = $this->getStaticOnDayRange();
		$provide = $returnStatics['provide'];

		$info = Service::getCacheData('CustomProcessInfo');
		if(empty($info))
		{
			$tableTwoInfo = [];

			$sql = 'SELECT COUNT(*) as number, user_id, type FROM `process_log` WHERE time<=SUBDATE(CURDATE(),INTERVAL -1080 MINUTE) AND time>=SUBDATE(CURDATE(),INTERVAL 360 MINUTE) AND status=1 GROUP BY user_id,type';
			$open_info = Yii::app()->db->createCommand($sql)->queryAll();
			foreach ($open_info as $oneOpenInfo) {
				$tableTwoInfo[$oneOpenInfo['user_id']][$oneOpenInfo['type']] = ['type' => $oneOpenInfo['type'], 'open' => $oneOpenInfo['number'], 'close' => 0, 'total' => 0, 'close_avg' => 0, 'close_avg_percent' => 0];
			}
			$sql = 'SELECT COUNT(*) as number,p.type,p.user_id FROM `shipment_process` t INNER JOIN `process_log` p ON t.id=p.fid  WHERE date<=SUBDATE(CURDATE(),INTERVAL -1080 MINUTE) AND date>=SUBDATE(CURDATE(),INTERVAL 360 MINUTE) AND t.status=24 GROUP by p.type,p.user_id';
			$close_info = Yii::app()->db->createCommand($sql)->queryAll();
			foreach ($close_info as $oneCloseInfo) {
				$tableTwoInfo[$oneCloseInfo['user_id']][$oneCloseInfo['type']]['close'] = $oneCloseInfo['number'];
			}
			$sql = "SELECT count(*) as number, p.user_id,p.type FROM `shipment_process` t INNER JOIN `process_log` p ON t.id=p.fid WHERE t.status<24 AND p.status=1 GROUP by p.user_id , p.type";
			$totalHeldInfo = Yii::app()->db->createCommand($sql)->queryAll();
			$totalHelshipments = 0;
			foreach ($totalHeldInfo as $oneHeldInfo) {
				$totalHelshipments += intval($oneHeldInfo['number']);
				$tableTwoInfo[$oneHeldInfo['user_id']][$oneHeldInfo['type']]['total'] = $oneHeldInfo['number'];
			}

			$sql = 'SELECT MAX(number) FROM (SELECT COUNT(*)/DAY(LAST_DAY(`date`)) * 1.4 as number FROM `shipment_process` WHERE type&4>0 AND status=24 AND `date` > DATE_SUB(DATE_FORMAT(NOW() ,"%Y-%m-01"), INTERVAL 6 MONTH) GROUP BY MONTH(`date`) LIMIT 6) t';
			${'4' . 'close_avg'} = 12;
			ceil(Yii::app()->db->createCommand($sql)->queryScalar());
			$sql = 'SELECT MAX(number) FROM (SELECT COUNT(*)/DAY(LAST_DAY(`date`)) * 1.4 as number FROM `shipment_process` WHERE type&1>0 AND status=24 AND `date` > DATE_SUB(DATE_FORMAT(NOW() ,"%Y-%m-01"), INTERVAL 6 MONTH) GROUP BY MONTH(`date`) LIMIT 6) t';
			${'1' . 'close_avg'} = 3; //ceil(Yii::app()->db->createCommand($sql)->queryScalar());
			$sql = 'SELECT MAX(number) FROM (SELECT COUNT(*)/DAY(LAST_DAY(`date`)) * 1.4 as number FROM `shipment_process` WHERE type&2>0 AND status=24 AND `date` > DATE_SUB(DATE_FORMAT(NOW() ,"%Y-%m-01"), INTERVAL 6 MONTH) GROUP BY MONTH(`date`) LIMIT 6) t';
			${'2' . 'close_avg'} = 3; //ceil(Yii::app()->db->createCommand($sql)->queryScalar());
			$sql = 'SELECT MAX(number) FROM (SELECT COUNT(*)/DAY(LAST_DAY(`date`)) * 1.4 as number FROM `shipment_process` WHERE type&8>0 AND status=24 AND `date` > DATE_SUB(DATE_FORMAT(NOW() ,"%Y-%m-01"), INTERVAL 6 MONTH) GROUP BY MONTH(`date`) LIMIT 6) t';
			${'8' . 'close_avg'} = ceil(Yii::app()->db->createCommand($sql)->queryScalar());
			${'16' . 'close_avg'} = ceil(Yii::app()->db->createCommand($sql)->queryScalar());
			$sql = 'SELECT COUNT(*) FROM `consol` t INNER JOIN `shipment` s ON t.id=s.consol_id WHERE t.eta>=SUBDATE(CURDATE(),INTERVAL 29 DAY) AND t.eta<=CURDATE()';
			$totalShipment = Yii::app()->db->createCommand($sql)->queryScalar();
			$totalShipment = ceil($totalShipment / 30);

			foreach ($tableTwoInfo as $user_id => $typeInfo) {
				foreach (ShipmentProcess::$the_types as $key => $name) {
					if (key_exists($key, $typeInfo)) {
						$tableTwoInfo[$user_id][$key]['close_avg'] = ${$key . 'close_avg'};
						$tableTwoInfo[$user_id][$key]['close_avg_percent'] = (${$key . 'close_avg'} > 0 ? number_format(@intval($tableTwoInfo[$user_id][$key]['close']) / ${$key . 'close_avg'} * 100, 2, '.', '') : 0);
						$tableTwoInfo[$user_id][$key]['totalPercent'] = ($totalShipment > 0 ? number_format(@$tableTwoInfo[$user_id][$key]['total'] / $totalShipment * 100, 2, '.', '') : 0);
						$tableTwoInfo[$user_id][$key]['percent'] = ($totalHelshipments > 0 ? number_format(@$tableTwoInfo[$user_id][$key]['total'] / $totalHelshipments * 100, 2, '.', '') : 0);
					}
				}
			}
			$info = ['tableTwoInfo' => $tableTwoInfo, 'totalShipment' => $totalShipment];
			Service::setCacheData('CustomProcessInfo',$info);
		}
		$filteredData = $filtersForm->filter($provide);
		$dataprovider = new CArrayDataProvider($filteredData);
		$dataprovider->pagination = ['pageSize' => 15];
		$sort = new CSort();
		$sort->attributes = [
			'number' => [
				'asc' => 'number ASC',
				'desc' => 'number DESC',
			],
			'owner' => [
				'asc' => 'owner ASC',
				'desc' => 'owner DESC',
			],
		];
		$sort->defaultOrder = "number DESC";
		$dataprovider->sort = $sort;
			// $modelShipment->setAttribute('id', -1);
			$modelShipment->setAttribute('agent_id', 0);

			$eta=[];
			$eta[]=CustomsProcessService::getCustomProcessKPIPeriodZeroRecord();
			$eta[]=CustomsProcessService::getCustomProcessKPIPeriodOneRecord();
			$eta[]=CustomsProcessService::getCustomProcessKPIPeriodTwoRecord();
			$eta[]=CustomsProcessService::getCustomProcessKPIPeriodThreeRecord();
			$eta[]=CustomsProcessService::getCustomProcessKPIPeriodFourRecord();
			$provide = CustomsProcessService::convertCustomKPIArr($eta);
			//$dailyDone = CustomsProcessService::getCountTotalCustomProcessDoneCurrentDay();
			$dailyDone = ['EMPPClose'=>0,"AQISClose"=>0,'HVClose'=>0,'EMPPOpen'=>0,"AQISOpen"=>0,'HVOpen'=>0];
			$monthlyRecord = ['EMPPClose'=>0,"AQISClose"=>0,'HVClose'=>0,'EMPPOpen'=>0,"AQISOpen"=>0,'HVOpen'=>0];
			$models = ReportCache::model()->findAll(['condition' => 'type = 1 and status = 1 and DATE_FORMAT(create_time, "%Y%m") = DATE_FORMAT(CURDATE(), "%Y%m")','order'=>'create_time desc']);
			//$model = ReportCache::model()->find('type = 1 and status = 1','order'=>'create_time desc');
			if(!empty($models)){
				$dataModel = json_decode($models[0]->meta);
				$dailyDone['EMPPClose'] = $dataModel->EMPPClose;
				$dailyDone['AQISClose'] = $dataModel->AQISClose;
				$dailyDone['HVClose'] = $dataModel->HVClose;
				foreach($models as $model){
					 $dataMonthlyModel = json_decode($model->meta);
					 $monthlyRecord['EMPPClose'] += $dataMonthlyModel->EMPPClose;
					 $monthlyRecord['AQISClose'] += $dataMonthlyModel->AQISClose;
					 $monthlyRecord['HVClose'] += $dataMonthlyModel->HVClose;
					 $monthlyRecord['EMPPOpen'] += $dataMonthlyModel->EMPPOpen;
					 $monthlyRecord['AQISOpen'] += $dataMonthlyModel->AQISOpen;
					 $monthlyRecord['HVOpen'] += $dataMonthlyModel->HVOpen;
				}
			}
	
			$this->render('custom_list', ['dataProvider' => [$dataprovider, $filtersForm], 'dataProvider1' => [$dataprovider1, $filtersForm1], 'modelShipment' => $modelShipment, 'agentId' => $agentId, 'value' => $value, 'info' => $info, 'eta'=>$provide,'dailydone'=>$dailyDone,'monthlyRecord'=>$monthlyRecord,'list'=>$list]);
		}
	}

	public function getStaticOnDayRange()
	{
		return ShipmentProcess::getStaticOnDayRange();
	}

	/**
	 * the report of the custom process, which include average closing tickets on EMPP, HV ,AQIS during the select Period.
	 * @_POST   start_date, end_date;
	 */
	public function actionReport()
	{
		$filtersForm = new FiltersForm;
		$provide = [];
		if (isset($_GET['FiltersForm'])) {
			$filtersForm->filters = $_GET['FiltersForm'];
		}
		if (!empty($_GET['start_date']) && !empty($_GET['end_date'])) {
			$start_time = $_GET['start_date'];
			$end_time = $_GET['end_date'];
			$end_time = date('Y-m-d', strtotime('+1 day', strtotime($end_time)));
			$show_type = $_GET['show_type'];
			$start_date = new DateTime($start_time, new DateTimeZone('Australia/Sydney'));
			$end_date = new DateTime($end_time, new DateTimeZone('Australia/Sydney'));
			if ($show_type == 0) {
				$groupInfo = [];
				$during = $end_date->diff($start_date)->format('%a');
				$sql = 'SELECT COUNT(*) FROM `consol` t INNER JOIN `shipment` s ON t.id=s.consol_id WHERE t.eta>=SUBDATE(:start,INTERVAL 29 DAY) AND t.eta<=:end';
				$totalShipment = ceil(Yii::app()->db->createCommand($sql)->bindValues([':start' => $start_time, ':end' => $end_time])->queryScalar() / (30 + $during));
				$provide = $this->preReportBaseOnDay($start_time, $end_time, $totalShipment, $during);
			} elseif ($show_type == 2) {
				$start_time = $start_time;
				$end_time = $end_time;
				$during = ceil((strtotime($end_time) - strtotime($start_time)) / 86400);
				$sql = 'SELECT COUNT(*) FROM `consol` t INNER JOIN `shipment` s ON t.id=s.consol_id WHERE t.eta>=SUBDATE(:start,INTERVAL 29 DAY) AND t.eta<=:end';
				$totalShipment = ceil(Yii::app()->db->createCommand($sql)->bindValues([':start' => $start_time, ':end' => $end_time])->queryScalar() / (30 + $during));
				while ($start_time < $end_time) {
					$start_day = date('Y-m-' . "01", strtotime($start_time));
					$end_day = date('Y-m-d', strtotime('+1 Month', strtotime($start_day)));
					$monthDuring = AppHelper::getWorkingDays($start_day, $end_day);
					if ($end_day > date('Y-m-d')) {
						$monthDuring = AppHelper::getWorkingDays($start_day, date('Y-m-d'));
						$end_day = date('Y-m-d', strtotime('+1 day', strtotime(date('Y-m-d'))));
					}
					$tempProvice = $this->preReportBaseOnDay($start_day, $end_day, $totalShipment, $monthDuring);
					foreach ($tempProvice as $oneProvide) {
						$oneProvide['date'] = date('Y-m', strtotime($start_time));
						$provide[] = $oneProvide;
					}
					$start_time = date('Y-m-d', strtotime('+1 Month', strtotime($start_time)));
				}
			} else {
				$sql = "SELECT COUNT(*) as number,date_format(date,'%Y-%m-%d') as day FROM `shipment_process` WHERE type&4>0 AND date<=:end AND date>=:start AND status=24 GROUP by day";
				$hvCloseGroup = Yii::app()->db->createCommand($sql)->bindValues([':start' => $start_time, ':end' => $end_time])->queryAll();
				$sql = "SELECT COUNT(*) as number,date_format(date,'%Y-%m-%d') as day FROM `shipment_process` WHERE type&1>0 AND date<=:end AND date>=:start AND status=24 GROUP by day";
				$emppCloseGroup = Yii::app()->db->createCommand($sql)->bindValues([':start' => $start_time, ':end' => $end_time])->queryAll();
				$sql = "SELECT COUNT(*) as number,date_format(date,'%Y-%m-%d') as day FROM `shipment_process` WHERE type&2>0 AND date<=:end AND date>=:start AND status=24 GROUP by day";
				$aqisCloseGroup = Yii::app()->db->createCommand($sql)->bindValues([':start' => $start_time, ':end' => $end_time])->queryAll();
				$time = $start_time;
				//last month percent
				$duringDay = 30;
				$index = 0;
				$preHvAvgExist = $preEmppAvgExist = $preAqisAvgExist = 0;
				while ($index < $duringDay) {
					$time_end = $time;
					$time = date('Y-m-d', strtotime('-1 day', strtotime($time_end)));
					$sql = "SELECT COUNT(*) FROM `shipment_process` WHERE type&4>0 AND ((`started`>=:start AND `started`<:end) OR (`date`>=:start AND `date`<:end) OR ( `started`<:start AND `date`>:end) OR (`started`<:start and status!=24))";
					$preHvAvgExist += intval(Yii::app()->db->createCommand($sql)->bindValues([':start' => $time, ':end' => $time_end])->queryScalar());
					$sql = "SELECT COUNT(*) FROM `shipment_process` WHERE type&1>0 AND ((`started`>=:start AND `started`<:end) OR (`date`>=:start AND `date`<:end) OR ( `started`<:start AND `date`>:end) OR (`started`<:start and status!=24))";
					$preEmppAvgExist += intval(Yii::app()->db->createCommand($sql)->bindValues([':start' => $time, ':end' => $time_end])->queryScalar());
					$sql = "SELECT COUNT(*) FROM `shipment_process` WHERE type&2>0 AND ((`started`>=:start AND `started`<:end) OR (`date`>=:start AND `date`<:end) OR ( `started`<:start AND `date`>:end) OR (`started`<:start and status!=24))";
					$preAqisAvgExist += intval(Yii::app()->db->createCommand($sql)->bindValues([':start' => $time, ':end' => $time_end])->queryScalar());
					$index++;
				}
				$sql = 'SELECT COUNT(*) FROM `consol` t INNER JOIN `shipment` s ON t.id=s.consol_id WHERE t.eta>=SUBDATE(:start,INTERVAL 29 DAY) AND t.eta<=:start';
				$totalShipment = ceil(Yii::app()->db->createCommand($sql)->bindValues([':start' => $start_time])->queryScalar() / 30);
				$preHvAvgExist = ceil($preHvAvgExist / $duringDay) - $bestHvAvgClose;
				$preEmppAvgExist = ceil($preEmppAvgExist / $duringDay) - $bestEmppAvgClose;
				$preAqisAvgExist = ceil($preAqisAvgExist / $duringDay) - $bestAqisAvgClose;
				$preHvAvgExistPercent = $totalShipment > 0 ? sprintf("%.2f", $preHvAvgExist / $totalShipment * 100) : 0;
				$preEmppAvgExistPercent = $totalShipment > 0 ? sprintf("%.2f", $preEmppAvgExist / $totalShipment * 100) : 0;
				$preAqisAvgExistPercent = $totalShipment > 0 ? sprintf("%.2f", $preAqisAvgExist / $totalShipment * 100) : 0;

				$sql = 'SELECT MAX(number) FROM (SELECT CEIL(COUNT(*)/DAY(LAST_DAY(date(date)))) as number FROM `shipment_process` WHERE type&4>0 AND status=24 AND YEAR(date)="2018"  GROUP BY  MONTH(date)) t';
				$bestHvAvgClose = intval(Yii::app()->db->createCommand($sql)->queryScalar());
				$sql = 'SELECT MAX(number) FROM (SELECT CEIL(COUNT(*)/DAY(LAST_DAY(date(date)))) as number FROM `shipment_process` WHERE type&1>0 AND status=24 AND YEAR(date)="2018"  GROUP BY  MONTH(date)) t';
				$bestEmppAvgClose = intval(Yii::app()->db->createCommand($sql)->queryScalar());
				$sql = 'SELECT MAX(number) FROM (SELECT CEIL(COUNT(*)/DAY(LAST_DAY(date(date)))) as number FROM `shipment_process` WHERE type&2>0 AND status=24 AND YEAR(date)="2018"  GROUP BY  MONTH(date)) t';
				$bestAqisAvgClose = intval(Yii::app()->db->createCommand($sql)->queryScalar());
				$id = 1;
				$time = $start_time;
				while ($time < $end_time) {
					$time_end = date('Y-m-d', strtotime('+1 day', strtotime($time)));
					$sql = "SELECT COUNT(*) FROM `shipment_process` WHERE type&4>0 AND ((`started`>=:start AND `started`<:end) OR (`date`>=:start AND `date`<:end) OR ( `started`<:start AND `date`>:end) OR (`started`<:start and status!=24))";
					$hvDailyExist = intval(Yii::app()->db->createCommand($sql)->bindValues([':start' => $time, ':end' => $time_end])->queryScalar());
					$sql = "SELECT COUNT(*) FROM `shipment_process` WHERE type&1>0 AND ((`started`>=:start AND `started`<:end) OR (`date`>=:start AND `date`<:end) OR ( `started`<:start AND `date`>:end) OR (`started`<:start and status!=24))";
					$emppDailyExist = intval(Yii::app()->db->createCommand($sql)->bindValues([':start' => $time, ':end' => $time_end])->queryScalar());
					$sql = "SELECT COUNT(*) FROM `shipment_process` WHERE type&2>0 AND ((`started`>=:start AND `started`<:end) OR (`date`>=:start AND `date`<:end) OR ( `started`<:start AND `date`>:end) OR (`started`<:start and status!=24))";
					$aqisDailyExist = intval(Yii::app()->db->createCommand($sql)->bindValues([':start' => $time, ':end' => $time_end])->queryScalar());

					$hvClose = $emppClose = $aqisClose = 0;
					foreach ($hvCloseGroup as $tempHvClose) {
						if ($tempHvClose['day'] == $time) {
							$hvClose = $tempHvClose['number'];
							break;
						}
					}
					$hvDailyExist -= $hvClose;
					foreach ($emppCloseGroup as $tempEmppClose) {
						if ($tempEmppClose['day'] == $time) {
							$emppClose = $tempEmppClose['number'];
							break;
						}
					}
					$emppDailyExist -= $emppClose;
					foreach ($aqisCloseGroup as $tempAqisClose) {
						if ($tempAqisClose['day'] == $time) {
							$aqisClose = $tempAqisClose['number'];
							break;
						}
					}
					$aqisDailyExist -= $aqisClose;
					$hvAvgExistPercent = $totalShipment > 0 ? sprintf("%.2f", $hvDailyExist / $totalShipment * 100) : 0;
					$emppAvgExistPercent = $totalShipment > 0 ? sprintf("%.2f", $emppDailyExist / $totalShipment * 100) : 0;
					$aqisAvgExistPercent = $totalShipment > 0 ? sprintf("%.2f", $aqisDailyExist / $totalShipment * 100) : 0;
					$hvClosePercent = sprintf("%.2f", $bestHvAvgClose > 0 ? $hvClose / $bestHvAvgClose * 100 : 0);
					$emppClosePercent = sprintf("%.2f", $bestEmppAvgClose > 0 ? $emppClose / $bestEmppAvgClose * 100 : 0);
					$aqisClosePercent = sprintf("%.2f", $bestAqisAvgClose > 0 ? $aqisClose / $bestAqisAvgClose * 100 : 0);
					if ($hvClose != 0 || $emppClose != 0 || $aqisClose != 0) {
						$provide[] = ['id' => $id++, 'date' => $time, 'type' => 'HV', 'daily_close' => $hvClose, 'best_month_avg_close' => $bestHvAvgClose, 'close_percent' => $hvClosePercent, 'dailyExist' => $hvDailyExist, 'existPercent' => $hvAvgExistPercent, 'preExist' => $preHvAvgExist, 'preExistPercent' => $preHvAvgExistPercent];
						$provide[] = ['id' => $id++, 'date' => $time, 'type' => 'EMPP', 'daily_close' => $emppClose, 'best_month_avg_close' => $bestEmppAvgClose, 'close_percent' => $emppClosePercent, 'dailyExist' => $emppDailyExist, 'existPercent' => $emppAvgExistPercent, 'preExist' => $preEmppAvgExist, 'preExistPercent' => $preEmppAvgExistPercent];
						$provide[] = ['id' => $id++, 'date' => $time, 'type' => 'AQIS', 'daily_close' => $aqisClose, 'best_month_avg_close' => $bestAqisAvgClose, 'close_percent' => $aqisClosePercent, 'dailyExist' => $aqisDailyExist, 'existPercent' => $aqisAvgExistPercent, 'preExist' => $preAqisAvgExist, 'preExistPercent' => $preAqisAvgExistPercent];
					}
					$time = date('Y-m-d', strtotime('+1 day', strtotime($time)));
				}
			}
		}
		$filteredData = $filtersForm->filter($provide);
		$dataprovider = new CArrayDataProvider($filteredData);
		$dataprovider->pagination = ['pageSize' => 30];
		if (!empty($_GET['partial'])) {
			$this->renderPartial('report_search', [
				'dataProvider' => [$dataprovider, $filtersForm], 'totalShipment' => $totalShipment,
			]);
			return;
		}

		$this->render('report', ['dataProvider' => [$dataprovider, $filtersForm], 'totalShipment' => 0]);
	}

	public function preReportBaseOnDay($start_time, $end_time, $totalShipment, $during)
	{
		$totDuring = ceil((strtotime($end_time) - strtotime($start_time)) / 86400);
		if ($totDuring <= 0) {
			$totDuring = 1;
		}
		$provide = [];
		$groupInfo = [];
		$sql = 'SELECT COUNT(*) as number,p.user_id, p.type FROM `shipment_process` t INNER JOIN `process_log` p ON t.id=p.fid WHERE t.date<=:end AND t.date>=:start AND t.status=24 AND p.type!=8 GROUP BY user_id,type';
		$closeInfo = Yii::app()->db->createCommand($sql)->bindValues([':start' => $start_time, ':end' => $end_time])->queryAll();
		foreach ($closeInfo as $oneCloseInfo) {
			$groupInfo[$oneCloseInfo['user_id']][$oneCloseInfo['type']] = ['close' => ceil($oneCloseInfo['number'] / $during)];
		}
		$time = $start_time;
		while ($time < $end_time) {
			$next_day = date('Y-m-d', strtotime('+1 day', strtotime($time)));
			$sql = "SELECT COUNT(*) as number, p.user_id,p.type FROM `shipment_process` s INNER JOIN `process_log` p ON s.id=p.fid  WHERE p.type!=8 AND ((s.`started`>=:start AND  s.`started`<:end) OR ( s.`date`>=:start AND s.`date`<:end) OR ( s.`started`<:start AND s.`date`>:end) OR (s.`started`<:start and s.status!=24)) GROUP BY p.type, p.user_id";
			$result = Yii::app()->db->createCommand($sql)->bindValues([':start' => $time, ':end' => $next_day])->queryAll();
			//            echo $time."==>"; var_dump($result); echo "<br/>";
			foreach ($result as $oneRow) {
				if (isset($groupInfo[$oneRow['user_id']][$oneRow['type']]['exist'])) {
					$groupInfo[$oneRow['user_id']][$oneRow['type']]['exist'] += $oneRow['number'];
				} else {
					$groupInfo[$oneRow['user_id']][$oneRow['type']]['exist'] = $oneRow['number'];
				}
			}

			$time = date('Y-m-d', strtotime('+1 day', strtotime($time)));
		}
		$sql = 'SELECT MAX(number) FROM (SELECT CEIL(COUNT(*)/DAY(LAST_DAY(date(date)))) as number FROM `shipment_process` WHERE type&4>0 AND status=24 AND YEAR(date)="2018"  GROUP BY  MONTH(date)) t';
		${'4' . 'best'} = intval(Yii::app()->db->createCommand($sql)->queryScalar());
		$sql = 'SELECT MAX(number) FROM (SELECT CEIL(COUNT(*)/DAY(LAST_DAY(date(date)))) as number FROM `shipment_process` WHERE type&1>0 AND status=24 AND YEAR(date)="2018"  GROUP BY  MONTH(date)) t';
		${'1' . 'best'} = intval(Yii::app()->db->createCommand($sql)->queryScalar());
		$sql = 'SELECT MAX(number) FROM (SELECT CEIL(COUNT(*)/DAY(LAST_DAY(date(date)))) as number FROM `shipment_process` WHERE type&2>0 AND status=24 AND YEAR(date)="2018"  GROUP BY  MONTH(date)) t';
		${'2' . 'best'} = intval(Yii::app()->db->createCommand($sql)->queryScalar());
		$id = 1;
		foreach ($groupInfo as $user_id => $userGroupInfo) {
			foreach ($userGroupInfo as $type_id => $typeGroupInfo) {
				$groupInfo[$user_id][$type_id]['best'] = ${$type_id . 'best'};
				$groupInfo[$user_id][$type_id]['close_percent'] = ${$type_id . 'best'} > 0 ? number_format(@$groupInfo[$user_id][$type_id]['close'] / ${$type_id . 'best'} * 100, 2, '.', '') : 0;
				$groupInfo[$user_id][$type_id]['exist'] = intval(@$groupInfo[$user_id][$type_id]['exist'] / $totDuring)-@$groupInfo[$user_id][$type_id]['close'];
				$groupInfo[$user_id][$type_id]['exist_percent'] = $totalShipment > 0 ? number_format(intval($groupInfo[$user_id][$type_id]['exist']) / $totalShipment * 100, 2, '.', '') : 0;
				$provide[] = ['id' => $id++, 'user_id' => $user_id, 'user_name' => User::getUserName($user_id), 'daily_close' => intval(@$groupInfo[$user_id][$type_id]['close']), 'type' => ShipmentProcess::$the_types[$type_id],
					'best_month_avg_close' => intval(@$groupInfo[$user_id][$type_id]['best']), 'close_percent' => floatval(@$groupInfo[$user_id][$type_id]['close_percent']),
					'dailyExist' => intval(@$groupInfo[$user_id][$type_id]['exist']), 'existPercent' => floatval(@$groupInfo[$user_id][$type_id]['exist_percent']),
				];
			}
		}
		return $provide;
	}

