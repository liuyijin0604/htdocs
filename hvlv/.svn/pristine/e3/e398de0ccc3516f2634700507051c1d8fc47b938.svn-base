				$model->addError('to', 'to email address need!');
				$this->ajaxResult($model);
			}
			foreach ($invs as $invoice) {
				$fileName = $tempDirectory . DIRECTORY_SEPARATOR . 'Invoice_' . $invoice->no . '.pdf';
				oPDF::renderPDF('invoice', ['inv' => $invoice], 2, $fileName);
				$files[] = [$fileName, 'Invoice_' . $invoice->no . '.pdf'];
			}
			$fileTaxs = FileRepo::model()->findAll("type = 19 AND status in (20,30) AND fid=:fid AND name LIKE '%entryprint%'",[":fid"=>$shipment->id]);
			foreach ($fileTaxs as $key => $ft) {
