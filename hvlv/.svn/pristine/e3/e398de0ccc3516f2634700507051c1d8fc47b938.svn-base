	/* send an email  to told the customer that the goods will be delivery soon.
	 *
	 */
	public function actionNoticeDelivery($id)
	{
		$o = $this->checkSendNotice($id);
		if ($o['status']) {
			echo 'done';
		} else {
			echo $o['msg'];
		}
	}

	public function actionEditNoticeContent()
	{
		if(empty($_POST))
		{
			$id = $_GET["id"];
			$model = $this->loadModel($id);
			$process = ShipmentProcess::model()->find('pid=:pid', [':pid' => $model->id]);
			if (empty($process)) {
				$model->newShipmentProcess(ShipmentProcess::CONFIRM_PAYMENT);
			}
			$emailTpl = ShipmentProcess::getNoticeContent($model);
			if(!empty($process->notice_content))
			{
				$emailTpl->body = $process->notice_content;
			}
			$this->render("notice_content",["model"=>$model,"emailTpl"=>$emailTpl]);
		}else
		{
			$id = $_POST["id"];
			$model=$this->loadModel($id);
			$process = ShipmentProcess::model()->find('pid=:pid', [':pid' => $model->id]);
			if (!empty($process)) {
				$process->notice_content = $_POST['Emailog']['body'];
				$process->update(['notice_content']);
			}
			$this->ajaxResult($model);
		}
	}

	private function checkSendNotice($id)
	{
		$model = $this->loadModel($id);
		$process = ShipmentProcess::model()->find('pid=:pid', [':pid' => $model->id]);
		if (empty($process)) {
			$model->newShipmentProcess(ShipmentProcess::CONFIRM_PAYMENT);
		}
		if(in_array($model->status,[ImParcel::STATE_CLEAR,ImParcel::STATE_CLEAR_WAIT])&&$model->scanCount()>0)
		{
			$o = ShipmentProcess::noticeDelivery($model);
		}else
		{
			$model->mdata['preprared_notice'] = 1;
			$model->updateMeta();
			return ["status"=>false,"msg"=>"prepared"];
		}
		return $o;
	}
	/*require documents  from sender when the parcel is EMPP;
	 *
	 */
	public function actionRequireEmppDocument($id)
	{
		$model = $this->loadModel($id);
		$process = ShipmentProcess::model()->find('pid=:pid', [':pid' => $model->id]);
		if (empty($process)) {
			$model->newShipmentProcess(ShipmentProcess::MSG_NEW, ShipmentProcess::TYPE_EMPP);
		}
		$o = ShipmentProcess::requireEmppDocument($model);
		if ($o['status']) {
			echo 'done';
		} else {
			echo $o['msg'];
		}
	}

	public function actionCreateEmailM($id, $type)
	{
		$model = new Emailog();
		$email = '';
		$from = Yii::app()->user->grp == 72 ? Yii::app()->user->email : 'imports@toplogistics.com.au';
		$cc = Yii::app()->user->grp == 72 ? Yii::app()->user->email : 'imports@toplogistics.com.au';
		// $cc = '';
		$shipment = $this->loadModel($id);
		$model->type = $type;
		switch ($type) {
			case Emailog::EMPP_DOCUMENT:
				$model->to_id = $shipment->agent_id;
				$org = Org::model()->findByPk($shipment->agent_id);
				if (!empty($org->extra['outturn_email'])) {
					$email = trim($org->extra['outturn_email']);
				}
				break;
			case Emailog::CUST_DOCUMENT_CUSTOMER2:
				$model->to_id = $shipment->agent_id;
				$email = $shipment->cnee->email;
				break;
			case Emailog::CUST_DOCUMENT_SENDER:
				$model->to_id = $shipment->agent_id;
				$org = Org::model()->findByPk($shipment->agent_id);
				if (!empty($org->extra['outturn_email'])) {
					$email = trim($org->extra['outturn_email']);
				}
				break;
			case Emailog::CUST_DOCUMENT_BROKER:
				$model->to_id = $shipment->process->broker_id;
				$org = Org::model()->findByPk($model->to_id);
				if (!empty($org->extra['outturn_email'])) {
					$email = trim($org->extra['outturn_email']);
				}
				break;
			case Emailog::AQIS_DOCUMENT:
				$model->to_id = $shipment->agent_id;
				$org = Org::model()->findByPk($shipment->agent_id);
				if (!empty($org->extra['outturn_email'])) {
					$email = trim($org->extra['outturn_email']);
				}
				break;
			case Emailog::EMPP2CUSTOMS:
				$model->to_id = 0;
				$from = Yii::app()->user->email;
				break;
		}

		$model->fid = $id;
		if (isset($_POST['Emailog'])) {
			$model->attributes = $_POST['Emailog'];
			foreach ($_POST['extra'] as $k => $v) {
				$model->mdata[$k] = $v;
			}
			$model->status = 10;
			$model->save();
			if (!empty(Yii::app()->session['uploads'][$_POST['ppupload']][2])) {
				foreach (Yii::app()->session['uploads'][$_POST['ppupload']][2] as $fid) {
					$fr = FileRepo::model()->findByPk($fid);
					$fr->fid = $model->id;
					$fr->save();
				}
			}
			$files = [];
			$tempDirectory = Yii::app()->basePath . DIRECTORY_SEPARATOR . "runtime" . DIRECTORY_SEPARATOR . 'zip' . time();
			if (!file_exists($tempDirectory)) {
				mkdir($tempDirectory);
			}
			//prepare files
			switch ($type) {
				case Emailog::CUST_DOCUMENT_CUSTOMER2:
					$fs = FileRepo::model()->findAll('fid=:fid and type in (19,20) and status in (20,30)', [':fid' => $shipment->id]);
					foreach ($fs as $f) {
						$files[] = [$f->getFile(), $f->name];
					}
					if($shipment->isTLA())
					{
						$files[] = [$file = Yii::app()->basePath . DIRECTORY_SEPARATOR . 'consignee_authorization_letter_template_top.docx', 'consignee_authorization_letter_template_top.docx'];
					}else
					{
						$files[] = [$file = Yii::app()->basePath . DIRECTORY_SEPARATOR . 'consignee_authorization_letter_template.docx', 'consignee_authorization_letter_template.docx'];
					}
					break;
				case Emailog::CUST_DOCUMENT_BROKER:
					$fs = FileRepo::model()->findAll('fid=:fid and type in (19,18,20) and status=30', [':fid' => $shipment->id]);
					foreach ($fs as $f) {
						$files[] = [$f->getFile(), $f->name];
					}
					$fileName = $tempDirectory . DIRECTORY_SEPARATOR . 'house_bill_' . $shipment->hbn . '.pdf';
					if (!preg_match('/^DW\d{8}\w{3}$/', $shipment->hbn)) {
						oPDF::renderPDF('custom_airwaybill', ['model' => $shipment], 2, $fileName);
						$files[] = [$fileName, 'house_bill_' . $shipment->hbn . '.pdf'];
					}
					break;
				case Emailog::EMPP2CUSTOMS:
					$fs = FileRepo::model()->findAll('fid=:fid and type in (19,18,20) and status=30', [':fid' => $shipment->id]);
					foreach ($fs as $f) {
						$files[] = [$f->getFile(), $f->name];
					}
					break;
			}

			$d = $model->sendEmail($files);
			if ($d['status']) {
				switch ($type) {
					case Emailog::EMPP_DOCUMENT:
						$shipment->process->changeStatus(ShipmentProcess::MSG_SENDER);
						break;
					case Emailog::AQIS_DOCUMENT:
						$shipment->process->changeStatus(ShipmentProcess::MSG_SENDER);
						break;
					case Emailog::CUST_DOCUMENT_SENDER:
						$shipment->process->changeStatus(ShipmentProcess::MSG_SENDER);
						break;
					case Emailog::CUST_DOCUMENT_CUSTOMER2:
						$shipment->process->changeStatus(ShipmentProcess::MSG_CONSIGNEE);
						if ((isset($shipment->cnee->tel) && preg_match('/^04\d{8}$/', ($shipment->cnee->auTel())))) {
							$no = $shipment->cnee->auTel();
							$msg = 'This Top Logistics, we just send a notice to your email:' . $shipment->cnee->email . ' for your Parcel ' . $shipment->ref . ' Please reply via the email as ASAP! tel: 02-99257111';
							if (Sms::sendCustomsMessageLocal($no, $msg)) {
								// Log::log2file($shipment->ref . ' no=>' . $no . ' msg:=>' . $msg, 'msg_notice_doucument_send', 'custom');
							}
						}
						break;
					case Emailog::CUST_DOCUMENT_BROKER:
						$shipment->process->changeStatus(ShipmentProcess::MSG_BROKER);
						break;
					case Emailog::AQIS_DOCUMENT:
						$shipment->process->changeStatus(ShipmentProcess::MSG_SENDER);
						break;
					case Emailog::EMPP2CUSTOMS:
						$shipment->process->changeStatus(ShipmentProcess::STATE_EMPP_CUSTOM);
						break;
				}
			} else {
				$model->addErrors([$d['msg']]);
			}
			AppHelper::unlinkRecursive($tempDirectory);
			$this->ajaxResult($model, ['id'], 'Email Sent Successfully');
		}

		$model->prepTemplate();
		$model->subject = $model->tpl->subject;
		$model->body = $model->tpl->getContent();

		$model->mdata['to'] = $email;
		$model->mdata['from'] = $from;
		$model->mdata['cc'] = $cc;
		$this->render('create_email_m', [
			'model' => $model,
		]);
	}
