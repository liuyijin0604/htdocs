	public function actionSendMessage($id)
	{
		$msg = '';
		$model = $this->loadModel($id);
		if (($model->bwf & 64) == 0 && ($model->bwf & 128) == 0 && ($model->bwf & 4) == 0) {
			echo 'Shipment is not DDP OR DDU, Please Check';
			return;
		}
		ShipmentProcess::sendDocumentNotice($model);
		if (($model->bwf & 128) > 0) {
			$r = ShipmentProcess::model()->find('pid=:pid AND status=2 AND date<DATE_SUB(NOW(), INTERVAL 1 DAY)', [':pid' => $model->id]);
			if (!empty($r)) {
				ShipmentProcess::sendDocumentNoticeToCustomer($model);
			}
		}
		echo 'done';
	}

