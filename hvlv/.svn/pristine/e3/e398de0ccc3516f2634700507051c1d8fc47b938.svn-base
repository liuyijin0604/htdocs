					$fr->fid = $model->id;
					$fr->save();
				}
			}

			$files = [];
			$tempDirectory = Yii::app()->basePath . DIRECTORY_SEPARATOR . "runtime" . DIRECTORY_SEPARATOR . 'zip' . time();
			if (!file_exists($tempDirectory)) {
				mkdir($tempDirectory);
			}
			$invs = Invoice::model()->findAll('dpmt=10 AND type IN(41,45) AND pid=:pid AND status not in (11,10,9,8) ORDER BY id DESC', [':pid' => $model->fid]);
			if (empty($invs)) {
