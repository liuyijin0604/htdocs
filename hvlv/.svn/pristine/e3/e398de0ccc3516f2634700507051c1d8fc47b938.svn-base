	/* confirm payment received from customer
	 * 1: change Process status to Confirm_payment
	 * change shipment status to clear (only when duty held);
	 *
	 */
	public function actionPaymentConfirm($id)
	{
		$process = ShipmentProcess::model()->find('pid=:pid', [':pid' => $id]);
		$model = ImParcel::model()->findByPk($id);
		if (empty($process)) {
			$model->newShipmentProcess(ShipmentProcess::CONFIRM_PAYMENT);
		} else {
			$process->status = ShipmentProcess::CONFIRM_PAYMENT;
			$process->update('status');
		}
		if ($model->status == 57) {
//duty held
			$model->status = 58; //change to clear
			$model->update('status');
		}
		echo 'done';
	}

