	public function actionCreateCasualInvoice($id)
	{
		$model = $this->loadModel($id);
		if (empty($model) || ($model->cbwf & 512) > 0) {
			echo 'invoice already created!';
			return;
		}
		if (!isset($model->mdata['custom_inv'])) {
			echo 'please input the invoice amount';
			return;
		}
		
		if (!empty($_POST['ssdate'])) {
			$model->process->mdata['ssdate'] = $_POST['ssdate'];
			$model->process->update('meta');
		}

		$result = $model->genCasualInvoice();
		// use cron regularly generate storage invoice
		$model->createStorageInvoiceWhenDdu();//if DDU the storage fees is paid by consignee.
		if ($result['status'] == 1) {
			// Log::log2file($model->ref . "== create Casual Invoice.", "casual_invoice", "account");
			$model->cbwf = $model->cbwf | 512;
			$model->update('cbwf');

			echo 'done';
		} else {
			echo $result['msg'];
		}
	}
	public function actionSendInvoiceToCasual($id)
	{
		$model = $this->loadModel($id);
		if(strtotime($model->consol->eta) >= strtotime('2020-08-01')){
			Yii::app()->name = 'TLA';
		}
		$process = ShipmentProcess::model()->find('pid=:pid', [':pid' => $model->id]);
		if (empty($process)) {
			$model->newShipmentProcess(16);
		}
		// ||($model->cbwf&512)==0
		if (empty($model) || Invoice::model()->count(
			'dpmt = 10 AND type IN (41,45) AND pid = :pid AND status NOT IN (10,11,9,8,7)', [':pid' => $model->id]) == 0) {
			echo 'invoice not created yet!';
			return;
		}

		// if DDP and credit not exceed then payment confirmed, else waiting for payment
		if(!in_array($model->process,array_keys(ShipmentProcess::$aqisStates)))
		{
		if (($model->bwf & ImParcel::CUSTOM_DDP) > 0 && !$model->agent->overCreditLimit()) {
			$model->process->changeStatus(ShipmentProcess::CONFIRM_PAYMENT);
		} else {
			$model->process->changeStatus(ShipmentProcess::INFROM_CUSTOMER_PAY);
		}
		}

		ShipmentProcess::sendInvoiceToInform($model);
		echo 'done';
	}
