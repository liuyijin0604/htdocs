	public function actionBrokerpaid($id)
	{
		$model = $this->loadModel($id);
		$stayHere = empty($_GET['stay_here'])?false:true;
		$process = ShipmentProcess::model()->find('pid = :pid', [':pid' => $model->id]);
		if (empty($process)) {
			$model->newShipmentProcess(23);
		} else {
			if($stayHere)
			{
				$process->mdata['stay_here'] = $stayHere;
				$process->save();
			}else
			{
				$process->mdata['stay_here'] = $stayHere;
				$process->save();
				$process->changeStatus(ShipmentProcess::BROKER_PAID);
			}
		}
		echo 'done';
	}

