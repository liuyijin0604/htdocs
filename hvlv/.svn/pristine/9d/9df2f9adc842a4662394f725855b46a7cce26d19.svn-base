<script>
$(function(){
    var tab = $('#<?=$_GET["tabid"];?>');
    var panel=tab.data('panel');
    <?php
     $siReconcileListUrl = 'siReconcile/getReconcileList';
     ?>

     $('#si-reconcile-client-view<?=$_GET['tabid']?>',panel).on("click", "table tbody td", function(event){
        // get cargoe id
        var status = parseInt($(this).parent().children(':nth-child(1)').html());
        var data = {};
        data['type'] = <?=$_GET['type']?>;
        data['status'] = status;
        $.ajax({
            type : 'GET',
            url : '<?php echo Yii::app()->createAbsoluteUrl($siReconcileListUrl, ['tabid'=>$_GET['tabid'],'SiReconcile'=>'1']) ;?>',
            data: data,
            dataType: 'html',
            success:function(resp){
                $('#si-reconcile-list-view<?=$_GET['tabid']?>',panel).html(resp);
            },
        });
    }); 
    
    $('.show_all',panel).on('click',function(event){
        $('.show_all',panel).val('searching......');
        var data = {};
        data['type'] = <?=$_GET['type']?>;
        data['SiReconcile'] = {"refs":$('#SiReconcile_refs',panel).val()};
        $.ajax({
            type : 'GET',
            url : '<?php echo Yii::app()->createAbsoluteUrl($siReconcileListUrl, ['tabid'=>$_GET['tabid'],'SiReconcile'=>'1']) ;?>',
            data: data,
            dataType: 'html',
            success:function(resp){
                $('#si-reconcile-list-view<?=$_GET['tabid']?>').html(resp);
                 $('.show_all',panel).val('Show All');
            },
        });
        
    });

    $('a.export_search', panel).on('mousedown', function(){
        var q = $('.filters input, .filters select', panel).serialize();
        $(this).attr('href', $(this).data('baseurl') + '&' + q);
    });

    $('a.manualErrorCheckingCurrentSearch', panel).on('mousedown', function(){
        if(!confirm('Are you sure to error check current search?')){  
          return false;
        }
        var q = $('.filters input, .filters select', panel).serialize();
        $.ajax({
                    url: '<?=$this->createUrl('siReconcile/manualErrorCheckingCurrentSearch')?>'+'?' + q,
                    type: "post",
                    data: [],
                    processData: false,
                    contentType: false,
                    success: function(r) {
                        r = JSON.parse(r);
                        if(r.done)
                         {
                               myApp.notice(r.msg, 5000);
                         }else
                         {
                          myApp.alert(r.msg, false);   
                       }
                       tab.trigger($trigger);
                   },
                    error: function(e) {
                        console.log(e);
                    }
                }); 

        return false;
    });

    $('a.manualLinkingBillingCurrentSearch', panel).on('mousedown', function(){
        if(!confirm('Are you sure to linking current search with billing?')){  
          return false;
        }
        var q = $('.filters input, .filters select', panel).serialize();
        $.ajax({
                    url: '<?=$this->createUrl('siReconcile/manualLinkingBillingCurrentSearch')?>'+'?' + q,
                    type: "post",
                    data: [],
                    processData: false,
                    contentType: false,
                    success: function(r) {
                        r = JSON.parse(r);
                        if(r.done)
                         {
                               myApp.notice(r.msg, 5000);
                         }else
                         {
                          myApp.alert(r.msg, false);   
                       }
                       tab.trigger($trigger);
                   },
                    error: function(e) {
                        console.log(e);
                    }
                }); 

        return false;
    });

    $('a.manualToPayCurrentSearch', panel).on('mousedown', function(){
        if(!confirm('Are you sure to to pay current search?')){  
          return false;
        }
        var q = $('.filters input, .filters select', panel).serialize();
        $.ajax({
                    url: '<?=$this->createUrl('siReconcile/manualToPayCurrentSearch')?>'+'?' + q,
                    type: "post",
                    data: [],
                    processData: false,
                    contentType: false,
                    success: function(r) {
                        r = JSON.parse(r);
                        if(r.done)
                         {
                               myApp.notice(r.msg, 5000);
                         }else
                         {
                          myApp.alert(r.msg, false);   
                       }
                       tab.trigger($trigger);
                   },
                    error: function(e) {
                        console.log(e);
                    }
                }); 

        return false;
    });

    $('a.brokerToPayCurrentSearch', panel).on('mousedown', function(){
        if(!confirm('Are you sure to to pay current search?')){  
          return false;
        }
        var q = $('.filters input, .filters select', panel).serialize();
        $.ajax({
                    url: '<?=$this->createUrl('siReconcile/brokerToPayCurrentSearch')?>'+'?' + q,
                    type: "post",
                    data: [],
                    processData: false,
                    contentType: false,
                    success: function(r) {
                        r = JSON.parse(r);
                        if(r.done)
                         {
                               myApp.notice(r.msg, 5000);
                         }else
                         {
                          myApp.alert(r.msg, false);   
                       }
                       tab.trigger($trigger);
                   },
                    error: function(e) {
                        console.log(e);
                    }
                }); 

        return false;
    });

    $('a.brokerLinkingBillingCurrentSearch', panel).on('mousedown', function(){
        if(!confirm('Are you sure to linking current search with billing?')){  
          return false;
        }
        var q = $('.filters input, .filters select', panel).serialize();
        $.ajax({
                    url: '<?=$this->createUrl('siReconcile/brokerLinkingBillingCurrentSearch')?>'+'?' + q,
                    type: "post",
                    data: [],
                    processData: false,
                    contentType: false,
                    success: function(r) {
                        r = JSON.parse(r);
                        if(r.done)
                         {
                               myApp.notice(r.msg, 5000);
                         }else
                         {
                          myApp.alert(r.msg, false);   
                       }
                       tab.trigger($trigger);
                   },
                    error: function(e) {
                        console.log(e);
                    }
                }); 

        return false;
    });
})
  
</script>