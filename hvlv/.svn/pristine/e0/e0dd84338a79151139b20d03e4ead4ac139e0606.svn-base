jQuery('head').append( '<style type="text/css">   .msg .warn{ color: #c00; font-weight: bold; }   '  + 
'   .msg .note{ color: #0c0; font-weight: bold; font-size: 1.2em; }   '  + 
'   .form-row{ padding-bottom: 10px;}   '  + 
'   .form-row input,select,textarea{ width: 100%;   '  + 
'     max-width: 300px;  '  + 
'    font-size: 1.0 em;    '  + 
'    font-weight: bold; padding: 4px;  '  + 
'     border: 1px solid #ccc; }   '  + 
'     .form-row input:focus{ border-color: #14487E; }   '  + 
'     .form-row input::-webkit-input-placeholder, .form-row input::-moz-placeholder,   '  + 
'     .form-row input:-ms-input-placeholder, .form-row input::-ms-input-placeholder   '  + 
'     { color: #666; font-weight: normal; }	  '  + 
'     .form-row input.error{ background-color: #fdd; }   '  + 
'     .filelist{ padding: 10px; border: 2px solid #ddd; margin-bottom: 10px; width: 100%; float: left; max-width: 400px; box-sizing: border-box;}   '  + 
'     .filelist.droptarget{ background-color: #dfd; }   '  + 
'     .qfile{ width: 175px; float: left; position: relative; margin: 5px; text-align: center; }   '  + 
'     .qfile .side{ text-align: center; font-weight: bold; font-size: 1.2em; }  '  + 
'     .qfile .del{ position: absolute; right: -5px; top: -5px; display: none; border-radius: 10px; width: 20px; height: 20px; line-height: 18px; text-align: center; font-weight: bold; font-size: 18px; cursor: pointer; background: #ccc; color: #c00; transition: 0.5s; }   '  + 
'     .qfile:hover .del{ display: block;}   '  + 
'     .qfile:hover .del:hover{ background: #c00; color: #fff;}   '  + 
'     .qfile .detail{ font-size: 0.8em;}   '  + 
'     .qfile .wait { position: absolute; top: 0; background: rgba(255,255,255, 0.8) url(https://www.pcaexpress.com.au/client/css/images/loading.gif) 50% 60% no-repeat; width: 100%; height: 100%; text-align: center; padding-top: 50px; box-sizing: border-box; display: none; }   '  + 
'     .fields { clear:both; } .buttons{ clear:both; }   '  + 
'     .uploading { position: relative; clear:both; font-size: 1.4em; font-weight: bold; color: #BC3426; line-height: 32px; background: #fff; z-index: 99; padding: 15px 5px; margin-bottom: -50px; display: none; }  '  + 
'     .input-radio {padding-bottom:10px; }    '  + 
'     .the_label{width:80px; display:inline-block;float:left}  '  + 
'       '  + 
'       .filelist {  '  + 
'           padding: 10px;  '  + 
'           border: 2px solid #ddd;  '  + 
'           margin-bottom: 10px;  '  + 
'           float: left;  '  + 
'           width: 100%;  '  + 
'           max-width: 400px;  '  + 
'           box-sizing: border-box;  '  + 
'       }  '  + 
'     '  + 
'       .filelist.droptarget {  '  + 
'           background-color: #dfd;  '  + 
'       }  '  + 
'     '  + 
'       .filelist .ddhint {  '  + 
'           padding: 30px 15px;  '  + 
'           font-size: 1.1em;  '  + 
'       }  '  + 
'     '  + 
'       .swap {  '  + 
'           display: none;  '  + 
'           clear: both;  '  + 
'       }  '  + 
'     '  + 
'       .qfile {  '  + 
'           width: 175px;  '  + 
'           float: left;  '  + 
'           position: relative;  '  + 
'           margin: 5px;  '  + 
'       }  '  + 
'     '  + 
'       .qfile .side {  '  + 
'           text-align: center;  '  + 
'           font-weight: bold;  '  + 
'           font-size: 1.2em;  '  + 
'       }  '  + 
'     '  + 
'       .qfile .del {  '  + 
'           position: absolute;  '  + 
'           right: -5px;  '  + 
'           top: -5px;  '  + 
'           display: none;  '  + 
'           border-radius: 10px;  '  + 
'           width: 20px;  '  + 
'           height: 20px;  '  + 
'           line-height: 18px;  '  + 
'           text-align: center;  '  + 
'           font-weight: bold;  '  + 
'           font-size: 18px;  '  + 
'           cursor: pointer;  '  + 
'           background: #ccc;  '  + 
'           color: #c00;  '  + 
'           transition: 0.5s;  '  + 
'       }  '  + 
'     '  + 
'       .qfile:hover .del {  '  + 
'           display: block;  '  + 
'       }  '  + 
'     '  + 
'       .qfile:hover .del:hover {  '  + 
'           background: #c00;  '  + 
'           color: #fff;  '  + 
'       }  '  + 
'     '  + 
'       .qfile .detail {  '  + 
'           font-size: 0.8em;  '  + 
'       }  '  + 
'     '  + 
'       .qfile .progress {  '  + 
'           height: 10px;  '  + 
'           width: 0%;  '  + 
'           background: #BC3426;  '  + 
'      } </style> ' );
    $(function(){
     var ctnr=$('#pca-query');
     ctnr.html('<div class="msg"></div>  '  + 
     '   <div class="fields">  '  + 
     '       <div class="form-row" id="leibie">  '  + 
     '           <label class="the_label">类别：</label>  '  + 
     '           <select name="types">  '  + 
     '               <option value="10">一般咨询</option>  '  + 
     '               <option value="20">包裹查询</option>  '  + 
     '               <option value="30">理赔</option>  '  + 
     '               <option value="40">业务咨询</option>  '  + 
     '           </select>  '  + 
     '       </div>  '  + 
     '       <div class="form-row danhao">  '  + 
     '           <label class="the_label">单号：</label>  '  + 
     '           <input type="text" class="id_connote" name="id_connote" placeholder="运单号" />  '  + 
     '       </div>  '  + 
     '       <div class="form-row">  '  + 
     '           <label class="the_label">姓名：</label>  '  + 
     '           <input type="text" class="id_name required" name="id_name" />  '  + 
     '       </div>  '  + 
     '       <div class="form-row">  '  + 
     '           <label class="the_label">手机号码：</label>  '  + 
     '           <input type="text" class="id_mobile" name="id_mobile" placeholder="手机号码" />  '  + 
     '       </div>  '  + 
     '       <div class="form-row" id="the_email">  '  + 
     '           <label class="the_label">邮箱地址：</label>  '  + 
     '           <input type="email" class="email_address" name="email_address" />  '  + 
     '       </div>  '  + 
     '       <div class="form-row">  '  + 
     '           <label class="the_label">描述:</label>  '  + 
     '           <textarea rows="6" class="description" name="description"></textarea>  '  + 
     '       </div>  '  + 
     '   </div>  '  + 
     '   <div class="form-row">  '  + 
     '           <input accept="image/*" type="file" class="id_photo" name="id_photo" style="display:none;" />  '  + 
     '       </div>  '  + 
     '   <div class="filelist">  '  + 
     '       <div class="ddhint">请点击[选择文件]加入最多3张图片。</div>  '  + 
     '   </div>  '  + 
     '   <div class="uploading">  '  + 
     '       <img src="css/images/ajaxLoader.gif" width="24" /> 正在上传请稍候，不要离开或关闭页面。  '  + 
     '   </div>  '  + 
     '   <div class="buttons" style="display:relative;">  '  + 
     '   <button class="pickfiles" type="button">选择文件</button>  '  + 
     '       <button class="swap" type="button">正反对调</button>  '  + 
     '        '  + 
     '   </div>  '  + 
     '   <div class="buttons" style="display:relative; margin-top:1em;">  '  + 
     '   <button class="upload" type="submit">提交</button>  '  + 
     '  </div>  ').trigger('onReady');
     $('select[name=types]',ctnr).on('change',function(){
        if($(this).val()==30){
           if($('.danhao',ctnr).val()==undefined){
               $('#leibie',ctnr).after('<div class="form-row danhao"><label class="the_label">单号：</label><input type="text" class="id_connote" name="id_connote" placeholder="运单号" /></div>');
           }
           if($('#shenshu',ctnr).val()==undefined){
                   $('#the_email',ctnr).after('<div class="input-radio" id="shenshu" ><label >申诉理由：</label><label >丢失<label ><input type="radio"  name="reason" value="10" />&nbsp;&nbsp;<label>破损</label><input type="radio"   name="reason" value="20" />&nbsp;&nbsp;<label>其他原因</label><input type="radio"  name="reason" value="30" checked/></div>');
               }
        }else if($(this).val()==10){
               $('.input-radio',ctnr).remove();
               if($('.danhao',ctnr).val()==undefined){
               $('#leibie',ctnr).after('<div class="form-row danhao"><label class="the_label">单号：</label><input type="text" class="id_connote" name="id_connote" placeholder="运单号" /></div>');
           }
        }else if($(this).val()==40){
            $('.danhao',ctnr).remove();
            $('.input-radio',ctnr).remove();
        }else if($(this).val()==20){
           $('.input-radio',ctnr).remove();
           if($('.danhao',ctnr).val()==undefined){
               $('#leibie',ctnr).after('<div class="form-row danhao"><label class="the_label">单号：</label><input type="text" class="id_connote" name="id_connote" placeholder="运单号" /></div>');
           }
        }
    });

   $('button.pickfiles', ctnr).on('click', function(){
       $('input.id_photo').trigger('click');
   });
   $('input.id_photo', ctnr).on('change', function(){
       var t = $(this);
       var m = 3;
       $('.ddhint', ctnr).hide();
       if($('.filelist .qfile').length > 2){
        $('.filelist .qfile').remove();
       }else if($('.filelist .qfile').length == 2){
           m  = 1;
       }

       for(var i = 0; i < Math.min(m, this.files.length); i++){
           lrz(this.files[i], {width: 600, quality: 0.8}).then(function(rst){
               var size = Math.round(parseFloat(rst.fileLen / 1024));
               $('.filelist', ctnr).append('<div class="qfile"><div class="side">Picture</div><div class="del">×</div><div class="preview"><img src="'+rst.base64+'" width="175" height="130" /></div><div class="detail">'+rst.origin.name+' ('+size+' kb)</div><div class="progress"></div></div>');
               if($('.filelist .qfile', ctnr).length > 2){
                   $('button.pickfiles', ctnr).hide();
               }
           });
       }
   });
   
   $('.filelist', ctnr).on('click', '.qfile .del', function(){
       $(this).parent().remove();
       if($('.filelist .qfile').length == 0){
           $('.ddhint', ctnr).show();
       }
       $('button.pickfiles', ctnr).fadeIn();

       return false;
   });
   
    $('button.upload', ctnr).on('click', function(){
       $('.msg', ctnr).empty();
       var v = true;
       var msg = [];
       var data = new FormData();
       var mbl = $('.id_mobile', ctnr).val();
       var eml = $('.email_address', ctnr).val();
       var type = $('select[name=types]',ctnr).val();
       var name=$('.id_name',ctnr).val();
       var desc=$('.description',ctnr).val();
       data.append('tel',mbl);
       data.append('email',eml);
       data.append('type',type);
       data.append('name',name);
       data.append('desc',desc);
 
       $('.filelist .qfile', ctnr).each(function(i){
               var n = 'file'+i;
               var blob = new Blob([$('img', this).attr('src')], {type: "text/plain"});
               data.append(n, blob);
           });
       if(mbl == '' || eml==''){
           msg.push('<span class="warn">为了确保更好的对应，请输入手机号和邮箱地址。</span>');
           v = false;
       }
       if(name == ''){
           msg.push('<span class="warn">为了确保更好的对应，请输入您的姓名。</span>');
           v = false;
       }
       if(desc == ''){
           msg.push('<span class="warn">请输入描述内容。</span>');
           v = false;
       }
       var connote = ctnr.find(".id_connote").val();
       data.append('connote',connote);
       if(type==20||type==30){
           
       if(connote == ''){
           msg.push('<span class="warn">请输入有效单号。</span>');
           v = false;
       }
       }
       if(type==30){
           var reason= $("input:radio[name='reason']:checked",ctnr).val();
           data.append('reason',reason);
       }

      if(v){
           $.ajax({
               method:'POST',
               url: 'https://os.pcaex.com/client/uploadCrm/CheckConnote', 
               processData: false,
               contentType: false,
               data: data,	
               success: function(r){
                    var reply=JSON.parse(r);
            if(reply['status'] == 'done'){
              $('.msg', ctnr).html('<span class="note">创建成功，谢谢'+reply['msg']+'</span>');
               $('.description', ctnr).val('');
               $('.fields input', ctnr).each(function(){
                    $(this).val('');
                });
                $('.filelist .qfile').remove();
                if($('.filelist .qfile').length == 0){
           $('.ddhint', ctnr).show();
       }
           }else{
              $('.msg', ctnr).append('<span class="warn">创建失败 :'+reply['msg']+'，请重试</span><br />');
             }
           },
       error: function(){
               $('.msg', ctnr).append('<span class="warn">提交失败，请重试</span><br />');
           }});
           }else{
           $('.msg', ctnr).html(msg.join('<br />'));	
           }
    });

    });