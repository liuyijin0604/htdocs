        function nextQustion() {
        	let qid = $('#qid').attr("qid");            
            let answerid ="";
            let submit_id = <?php echo $_GET['submit_id']; ?>;
            let answerStr = "";
            var urlStr = "?";
            let thisData = [];
            let answersArray = [];            
            document.getElementById("previousQuestionBtn").style.visibility = "visible";
            // alert(questionsArray);
            // alert($('input[name="_answer"]').attr("type"));
            if ($('input[name="_answer"]').attr("type") == "radio"){
                // alert($('input[name="_answer"]:checked')[1].val());
                answerid = $('input[name="_answer"]:checked').val();
                if( !answerid ) {
                      // $('input[name="_answer"]').parents('p').addClass('warning');
                      alert('Input can not be blank');
                      return false;
                } 
                urlStr += "answerId="+answerid+"&&";               
            }
            else if($('input[name="_answer"]').attr("type") == "checkbox"){
                let answerids = $('input[name="_answer"]:checked');
                for (let i = 0; i < answerids.length; i++) {
                  answersArray.push(answerids[i].value);
                  // alert(answerids[i].value);
                }
                answerStr = answersArray.toString();
                if( !answerStr ) {
                      // $('input[name="_answer"]').parents('p').addClass('warning');
                      alert('Input can not be blank');
                      return false;
                } 
                // alert(answerStr);
                thisData = {"answerStr":answerStr};
            }
            else{
                answerStr = $('input[name="_answer"]').val(); 
                if( !answerStr ) {
                      // $('input[name="_answer"]').parents('p').addClass('warning');
                      alert('Input can not be blank');
                      return false;
                } 
                thisData = {"answerStr":answerStr};
            }
            let nextQustionId = categoryQuesitonIds[questionsArray.length+1];
            numCountItem++;
            questionsArray.push(qid);

            // if (answerid){
            //     answersArray.push(answerid);                                
            // }
            urlStr += "questionId="+qid+"&& submit_id="+submit_id;
            //        alert(qid+"  "+answerid);
   //      	var answers = new FormData(document.getElementById("_answer"));
         	<?php
				$url = $this->createUrl('salesfunnelRequirements/nextQuestion');
			 ?>	             
             // thisData = {"answerStr":answerStr, "answersArray":answersArray};
             // alert(answerStr);
			$.ajax({
			           url: '<?=$url?>'+urlStr,
			           type: "post",
                       data: thisData,
			           processData: true,
			           contentType: "application/x-www-form-urlencoded; charset=UTF-8",
			           success: function(r) {
			           	$('#item').remove();
			           	$('#items').append(r);


                        $.ajax({
                               url: '<?= $this->createUrl('salesfunnelRequirements/checkServiceType')?>'+'?questionId='+nextQustionId,
                               type: "post",
                               processData: false,
                               contentType: false,
                               success: function(r) {
                                var response = JSON.parse(r);
                                    if(!response.done)
                                    {
                                        console.log(response);
                                        alert(response.msg);
                                    }else
                                    {
                                        var service_type = response['service_type'];  
                                        // console.log(submit_id); 
                                        // debugger;                       
                                        $('#category-name').html(service_type);
                                    }
                             },
                               error: function(e) {
                                   console.log(e);
                               }
                           });          

                        if(questionsArray.length+1>0){
                            $('#qid').html("Question "+(questionsArray.length+1)+"/"+(categoryQuesitonIds.length+1));
                            // $('#category-name').html(checkServiceType(<?=$model->question_category ?>));
                            // alert($('#qid').html());
                        }
                        // alert($('#lid').html());
                        if ((questionsArray.length+1)>=(categoryQuesitonIds.length+1)){
                            document.getElementById("nextQuestionBtn").style.visibility = "hidden";
                        }

			         },
			           error: function(e) {
			               console.log(e);
			           }
			       });	            
			return false;
        }

        function previousQustion() { 
            let qid = $('#qid').attr("qid");  
            let submit_id = <?php echo $_GET['submit_id']; ?>;         
            numCountItem--;            
            let preQustionId = questionsArray[questionsArray.length-1];
            // alert(questionsArray);
            document.getElementById("nextQuestionBtn").style.visibility = "visible";
   //       alert(preQustionId);
   //       var answers = new FormData(document.getElementById("_answer"));
            <?php
                $url = $this->createUrl('salesfunnelRequirements/preQustion');
             ?> 
            $.ajax({
                       url: '<?=$url?>'+"?preQustionId="+preQustionId+"&& submit_id="+submit_id,
                       type: "post",
                       processData: false,
                       contentType: false,
                       success: function(r) {
                        $('#item').remove();
                        $('#items').append(r);
                        // alert(qid);


                        $.ajax({
                               url: '<?= $this->createUrl('salesfunnelRequirements/checkServiceType')?>'+'?questionId='+preQustionId,
                               type: "post",
                               processData: false,
                               contentType: false,
                               success: function(r) {
                                var response = JSON.parse(r);
                                    if(!response.done)
                                    {
                                        console.log(response);
                                        alert(response.msg);
                                    }else
                                    {
                                        var service_type = response['service_type'];  
                                        // console.log(submit_id); 
                                        // debugger;                       
                                        $('#category-name').html(service_type);
                                    }
                             },
                               error: function(e) {
                                   console.log(e);
                               }
                           });      


                        if(questionsArray.length+1>0){
                            $('#qid').html("Question "+(questionsArray.length+1)+"/"+(categoryQuesitonIds.length+1));
                            // $('#category-name').html(checkServiceType(<?=$model->question_category ?>));
                            // alert(<?=$model->id ?>);
                        }

                        if (questionsArray.length<=0){
                            document.getElementById("previousQuestionBtn").style.visibility = "hidden";
                        }
                     },
                       error: function(e) {
                           console.log(e);
                       }
                   });  
            questionsArray.pop();
            answersArray.pop();
            return false;
        }

        function submitForm(){
        
            if ($('#lid').html()=="The questionnaire has ended."){
                    let id = <?php echo $_GET['submit_id'] ?>;
                    window.location.replace("<?=$this->createUrl('salesfunnelRequirements/customerSubmit')?>"+"?id="+id);
                    return false;
            }else{
                alert('Your questionnaire has been saved.</br>Please finish the rest of questions with the same email when you feel free.</br>Thank you!');
                return false;
            }
            
        }


