	public function actionWms2xero()
	{
		if (isset($_POST['wid'])) {
			$err = [];
			$uploadFile = empty($_FILES['invoice']) ? [] : $_FILES['invoice'];
			if (empty($uploadFile['tmp_name']) || !is_uploaded_file($uploadFile['tmp_name'])) {
				$err[] = 'Invoice File Required.';
			} else {
				if (FileRepo::sameFile($uploadFile['tmp_name'])) {
					$err[] = 'This Invoice file already uploaded.';
				}
			}
			if (empty($err)) {
				$xls = new oExcel;
				if (!$xls->supported($uploadFile['name'])) {
					foreach ($xls->getError() as $e) {
						$err[] = $e;
					}
				} else {
					$xls->load($uploadFile['tmp_name']);
					$data = $xls->getAll();
					// to be done soon
				}
			}

			$r = new StdClass;
			$r->done = true;
			if (!empty($err)) {
				$res = '<ol class="chklst">';
				foreach ($err as $oneErr) {
					$res .= '<li class="red"><span class="blocking">' . $oneErr . '</span><li>';
				}
				$res .= '</ol>';
				$r->msg = 'Failed to import invoices';
				$r->res = $res;
			} else {
				$r->msg = 'Invoices imported successfully';
				$r->res = '';
			}
			echo json_encode($r);
		} else {
			$this->render('wms2xero');
		}
	}

	public function actionExparinv()
	{
		$cdate = Yii::app()->name == 'PEP' ? date('Y-m-d') : '2018-07-01';
		$bdate = Yii::app()->name == 'PEP' ? '2018-07-01' : '2000-01-01';

		if (!empty($_GET['check'])) {
			$rs = PickupList::model()->findAll(['condition' => 'status < 100 AND bwf & 1 = 0 AND dpt_id = :wid AND created < :cdate AND created >= :bdate', 'params' => [':wid' => $_GET['wid'], ':cdate' => $cdate, ':bdate' => $bdate], 'order' => 'created']);
			echo '<p>Total <b>' . sizeof($rs) . '</b> Receipt Lists</p>';
			$db = Yii::app()->getDb();
			echo '<ol class="chklst">';
			$gtt = 0;
			$okc = 0;
			foreach ($rs as $r) {
				$sql = 'SELECT COUNT(id) AS c, fid, id FROM mani_map WHERE mani_id = :id GROUP BY fid having c > 1';
				$qs = $db->createCommand($sql)->bindValues([':id' => $r->id])->queryAll();
				foreach ($qs as $q) {
					$sql = 'DELETE FROM mani_map WHERE mani_id = :mid AND fid = :fid AND id != :id';
					$db->createCommand($sql)->bindValues([':mid' => $r->id, ':fid' => $q['fid'], ':id' => $q['id']])->execute();
				}

				$err = [];
				//add receiptless to receipt list
				$sql = 'SELECT s.id FROM shipment s LEFT JOIN (SELECT mm.fid FROM mani_map mm INNER JOIN manifest m ON m.id = mm.mani_id WHERE m.type = 40 AND m.fwd_id = :aid AND m.created > DATE_SUB(DATE(:d), INTERVAL 7 DAY)) r ON s.id = r.fid WHERE s.created = DATE(:d) AND s.status NOT IN (8,9,10,100,102,104) AND s.agent_id = :aid AND s.type = 20 AND r.fid IS NULL';
				$ss = $db->createCommand($sql)->bindValues([':d' => $r->created, ':aid' => $r->fwd_id])->queryAll();

				if (!empty($ss)) {
					foreach ($ss as $s) {
						$p = ExParcel::model()->findByPk($s['id']);
						$r->map($p);
					}
				}

				if (empty($r->lines)) {
					$r->status = 100;
					$r->save();
					//echo '<li><a href="'.$this->createUrl('pickupList/update', ['id' => $r->id]).'" class="tab_link" title="'.$r->ref.'">'.$r->ref.' ('.$r->owner->name.')</a> - Empty</li>';
					continue;
				}
				$ipc = 0;
				$stt = 0;
				foreach ($r->lines as $l) {
					$p = $l->mm();
					if (empty($p) || in_array($p->status, [100, 102, 104])) {
						continue;
					}
					$ipc++;
					//check duplicate
					if ($p->status == 12) {
						$c = $db->createCommand('SELECT s.id FROM shipment s INNER JOIN mani_map m ON s.id = m.fid WHERE m.mani_id = :mid AND s.id != :id AND hbn = :hbn AND s.status >= 14')->bindValues([':mid' => $r->id, ':id' => $l->fid, ':hbn' => $p->hbn])->queryScalar();
						if (!empty($c)) {
//cancel duplicate
							$p->status = 100;
							$p->save();
						}
					}

					if ($p->status <= 14) {
//status
						$err[] = '<a href="' . $this->createUrl('exParcel/update', ['id' => $p->id]) . '" class="tab_link" title="' . $p->hbn . '">' . $p->hbn . ' not received</a>';
					} elseif (in_array($p->goodsType(), ['O', 'X']) && ((empty($p->weight) || $p->weight == 0) || ($p->status < 60 && (!empty($p->agent->extra['wt_check']) && (empty($p->wtck) || $p->wtck == 0))))) {
						$err[] = '<a href="' . $this->createUrl('exParcel/update', ['id' => $p->id]) . '" class="tab_link" title="' . $p->hbn . '">' . $p->hbn . ' has no weight</a>';
					}

					if ($p->agent_id != $r->fwd_id && (empty($p->agent->accode) || $p->agent->accode != $r->owner->accode)) {
						//mismatch agent
						$err[] = '<a href="' . $this->createUrl('exParcel/update', ['id' => $p->id]) . '" class="tab_link" title="' . $p->hbn . '">' . $p->hbn . ' agent mismatch</a>';
					}
					//appear in multiple rl
					$mpl = PickupList::model()->with('lines')->findAll('t.id != :mid AND lines.fid = :id', [':id' => $p->id, ':mid' => $r->id]);
					if (!empty($mpl)) {
						$e = '<a href="' . $this->createUrl('exParcel/update', ['id' => $p->id]) . '" class="tab_link" title="' . $p->hbn . '">' . $p->hbn . '</a> appears in other receipt list';
						foreach ($mpl as $pl) {
							$e .= ' <a href="' . $this->createUrl('pickupList/update', ['id' => $pl->id]) . '" class="tab_link" title="' . $pl->ref . '">' . $pl->ref . '</a>';
						}
						$err[] = $e;
					}

					$rate = $p->getAgentRate();
					if (empty($rate[1])) {
						//unable to rate
						$err[] = '<a href="' . $this->createUrl('exParcel/update', ['id' => $p->id]) . '" class="tab_link" title="' . $p->hbn . '">' . $p->hbn . ' unable to rate</a>';
					}
					if (!empty($rate[2])) {
						$stt += $rate[2];
					}
				}

				if (empty($ipc)) {
					continue;
				}

				if (empty($err)) {
					echo '<li><a href="' . $this->createUrl('pickupList/update', ['id' => $r->id]) . '" class="tab_link" title="' . $r->ref . '">' . $r->ref . ' (' . $r->owner->name . ')</a> &asymp;$' . round($stt) . ' - OK</li>';
					$gtt += $stt;
					$okc++;
				} else {
					echo '<li class="red"><a href="' . $this->createUrl('pickupList/update', ['id' => $r->id]) . '" class="tab_link" title="' . $r->ref . '">' . $r->ref . ' (' . $r->owner->name . ')</a> - <span class="blocking">' . sizeof($err) . ' blockings</span><ul><li>';
					echo implode('</li><li>', $err);
					echo '</li></ul></li>';
				}
			}
			echo '</ol>';
			echo '<p>(' . $okc . ') OK Total: &asymp;$' . round($gtt) . '</p>';
		} elseif (!empty($_POST)) {
			$week_start = 6;
			$ais = [];
			$ndyet = [];
			$rs = PickupList::model()->findAll(['condition' => 'bwf & 1 = 0 AND dpt_id = :wid AND created < :cdate AND created >= :bdate', 'params' => [':wid' => $_POST['wid'], 'cdate' => $cdate, ':bdate' => $bdate], 'order' => 'created']);
			foreach ($rs as $r) {
				if (empty($r->lines) || in_array($r->fwd_id, $ndyet)) {
					continue;
				}
				$bd = $r->billdate();
				if (strtotime($bd) > time()) {
					$ndyet[] = $r->fwd_id;
					continue;
				}
				$err = false;
				$pc = 0;
				foreach ($r->lines as $l) {
					$p = $l->mm();
					if (in_array($p->status, [100, 102, 104])) {
						continue;
					}

					if ($p->status == 12) {
						$err = true;
						break;
					}

					if ($p->status == 14 || empty($p->weight) || $p->weight == 0) {
						//missing info
						$err = true;
						break;
					}

					if (in_array($p->goodsType(), ['O', 'X']) && ($p->status < 60 && (!empty($p->agent->extra['wt_check']) && (empty($p->wtck) || $p->wtck == 0)))) {
						//missing weight
						$err = true;
						break;
					}

					if ($p->agent_id != $r->fwd_id && $p->agent->accode != $r->owner->accode) {
						//mismatch agent
						$err = true;
						break;
					}
					$rate = $p->getAgentRate();
					if (empty($rate[1])) {
						//no rate
						$err = true;
						break;
					}
					$pc++;
				}
				if ($err || $pc == 0) {
					// unset($ais[$r->fwd_id][$bd]);
					continue;
				}
				$ais[$r->fwd_id][$bd][] = $r;
			}
			$c = 0;
			$res = '';
			foreach ($ais as $aid => $bds) {
				foreach ($bds as $bd => $rs) {
					$inv = Invoice::createExInv($aid, $bd, $rs);
					if (empty($inv->id)) {
						$res .= '<p>' . $aid . '/' . $bd . ' Error: ' . json_encode($inv->getErrors()) . '</p>';
					} else {
						$res .= '<p><a href="' . $this->createUrl('invoice/print', ['id' => $inv->id]) . '" target="_blank">Invoice ' . $inv->no . '</a> (' . $rs[0]->owner->name . ') created</p>';
					}
					$c++;
				}
			}

			$r = new StdClass;
			$r->done = true;
			$r->msg = 'Invoices created successfully';
			$r->res = $res . '<p style="margin: 20px 0">Total ' . $c . ' Invoices created <a href="' . $this->createUrl('invoice/download', ['type' => 'expinv', 'wid' => $_POST['wid'], 'date' => date('Y-m-d')]) . '" target="_blank"><b>Download All</b></p>';
			echo json_encode($r);
		} else {
			$this->render('exparinv');
		}
	}

	public function actionDownload()
	{
		$d = date('YmdHi', empty($_GET['date']) ? time() : strtotime($_GET['date']));
		$zf = Yii::app()->basePath . DIRECTORY_SEPARATOR . "runtime" . DIRECTORY_SEPARATOR . strtoupper($_GET['type']) . $d . '.zip';
		$zip = new ZipArchive;
		$zip->open($zf, ZipArchive::CREATE);
		$copied = [];
		$td = Yii::app()->basePath . DIRECTORY_SEPARATOR . "runtime" . DIRECTORY_SEPARATOR . 'zip' . time();
		mkdir($td);

		switch ($_GET['type']) {
			case 'expinv':
				$rs = Invoice::model()->findAll('type = 20 AND date = :d', [':d' => $_GET['date']]);
				foreach ($rs as $r) {
					$m = $r->lines[0]->mm();
					if ($m->dpt_id != $_GET['wid']) {
						continue;
					}
					$zip->addFromString('Invoice_' . $r->no . '.pdf', oPDF::renderPDF('invoice', ['inv' => $r], 0));
				}
				break;
			default:
				throw new CHttpException(403, 'Access Denied!');
				break;
		}

		$zip->close();
		header("Cache-Control: maxage=1");
		header("Content-Description: File Transfer");
		header("Content-type: application/octet-stream");
		header('Content-Disposition: attachment; filename="' . basename($zf) . '"');
		header("Content-Transfer-Encoding: binary");
		header("Content-Length: " . filesize($zf));
		readfile($zf);
		unlink($zf);
		AppHelper::unlinkRecursive($td);
		Yii::app()->end();
	}

	public function actionRcvb()
	{
		$this->render('rcvb');
	}

	public function actionWtck()
	{
		$this->render('wtck');
	}

	public function actionExportByCustomer()
	{
		$this->render('export_by_customer');
	}

	public function actionReport()
	{
		$xls = new oExcel;
		$i = 1;
		$setHdr = function () use ($xls, &$i) {
			$xls->addRow($i++, ['Number', 'Department', 'Bill to', 'Agent ID', 'Status', 'Type', 'Branch', 'Date', 'Due', 'Post Date', 'Currency', 'Total', 'Paid', 'Balance']);
			$xls->setColWidth([10, 10, 25, 10, 15, 10, 15, 15, 15, 10, 15, 15, 15, 15, 15]);
		};

		switch ($_GET['type']) {
			case 'expbycust': // export all invoice by customer
				{
					$criteria = new CDbCriteria();
					$criteria->addCondition("to_id = :aid AND date >= :fd AND date <= :td");
					$criteria->params = [':aid' => $_POST['agent_id'], ':fd' => $_POST['from_date'], ':td' => $_POST['to_date']];
					if (isset($_POST['selected_status']) && !empty($_POST['selected_status'])) {
						$criteria->addInCondition('status', $_POST['selected_status']);
					}
					$invoices = Invoice::model()->findAll($criteria);

					if (isset($_POST['bypdf']) && $_POST['bypdf'] == 1) {
						// will export by pdf with the following statistic data
						// 可以做出statement的格式，给客人显示出invoice的日期，金额，gst， total就好
						$allData = [];
						foreach ($invoices as $invoice) {
							$amount = $invoice->total - $invoice->gst;
							$allData[] = [
								'no' => $invoice->no,
								'date' => $invoice->date,
								'gst' => $invoice->gst,
								'amount' => $amount,
								'total' => $invoice->total,
							];
						}
						if (!empty($allData)) {
							$cust = Org::model()->findByPk($_POST['agent_id']);
							$ps = [];
							$td = Yii::app()->basePath . DIRECTORY_SEPARATOR . "runtime" . DIRECTORY_SEPARATOR;
							$tf = tempnam($td, "stmt");
							oPDF::renderPDF('statement_by_customer', ['invs' => $allData, 'cust' => $cust], 2, $tf);
							$ps[] = $tf;
							foreach ($invoices as $r) {
								$tf = tempnam($td, "stmt");
								oPDF::renderPDF('invoice', ['inv' => $r], 2, $tf);
								$ps[] = $tf;
								if ($r->type == 60) {
									$tf2 = tempnam($td, "stmt");
									oPDF::renderPDF('invoice_detail', ['inv' => $r], 2, $tf2);
									$ps[] = $tf2;
									if ($model->to_id == 1457) {
										$f3 = tempnam(Yii::app()->basePath . "/runtime", "ivp");
										oPDF::renderPDF('stock_detail', ['inv' => $model], 2, $f3);
										$ps[] = $f3;
									}
								}
							}
							oPDF::mergePDF($ps, 1, true, 'statement_by_customer_' . $_POST['agent_id'] . '.pdf');
						} else {
							echo 'nothing to do';
						}
					} else {
						foreach ($invoices as $invoice) {
							// if ( $invoice->type != 10 ) continue;
							$xls->addRow($i++, ['Invoice:', $invoice->no, 'Status:', $invoice->getStatus(), 'Date', $invoice->date]);
							$xls->addRow($i++, ['HBN', 'Detail', 'Packages', 'Weight', 'CBM', 'Base Rate', 'Rate', 'Unit', 'Amount']);
							$xls->setFont('A1:I1', ['bold' => true]);
							$qty = 0;
							$wei = 0;
							$cbm = 0;
							$tot = 0;
							foreach ($invoice->lines as $il) {
								if (empty($il->mdata['items'])) {
									continue;
								}
								foreach ($il->mdata['items'] as $si => $r) {
									$xls->addRow($i++, [$r[0], $r[1], $r[2], $r[3], $r[4], $r[6], $r[7], $r[8], $r[5]]);
									$tot += floatval($r[5]);
									$qty += floatval($r[2]);
									$wei += floatval($r[3]);
									$cbm += floatval($r[4]);
								}
							}

							if ($invoice->gst > 0) {
								$gst = round($invoice->gst, 2);
								$xls->addRow($i, ['', 'Sub Total:', $qty, $wei, $cbm, '', '', '', $tot]);
								$xls->setFont('A' . $i . ':I' . $i, ['bold' => true]);
								$i++;
								$xls->addRow($i, ['', '', '', '', '', '', '', 'GST 10.00%:', $gst]);
								$xls->setFont('A' . $i . ':I' . $i, ['bold' => true]);
								$i++;
								$xls->addRow($i, ['', 'Total:', $qty, $wei, $cbm, '', '', '', $invoice->total]);
								$xls->setFont('A' . $i . ':I' . $i, ['bold' => true]);
							} else {
								$xls->addRow($i, ['', 'Total:', $qty, $wei, $cbm, '', '', '', $invoice->total]);
								$xls->setFont('A' . $i . ':I' . $i, ['bold' => true]);
							}
							$i++;
							$xls->addRow($i, ['']);
							$xls->addRow($i++, ['']);
						}
						$xls->output('invoice_by_customer_' . $_POST['agent_id'] . '_' . time() . '.xlsx');
					}
				}
				break;

			case 'search':
				if (Yii::app()->name == 'PEP') {
					$xls->addRow($i++, ['Number', 'No', 'AWB', 'Bill to', 'Agent ID', 'Status', 'Type', 'Branch', 'Date', 'Due', 'Post Date', 'Currency', 'Total', 'Paid', 'Balance', 'Total Weight']);
					$xls->setColWidth([10, 25, 10, 10, 10, 15, 10, 15, 15, 15, 10, 15, 15, 15, 15, 15]);
					$model = new Invoice('search');
					$model->unsetAttributes();
					if (!empty($_GET['Invoice'])) {
						$model->attributes = $_GET['Invoice'];
					}
					$dp = $model->search(false, 0);
					foreach ($dp->data as $r) {
						$xls->addRow($i++, ['="' . $r->no . '"', $r->getModelNo(), $r->getModelAWB(), empty($r->to_id) ? "" : $r->cust->name, $r->to_id, $r->getStatus(), $r->getType(), $r->getBranch(), $r->date, $r->due, $r->posted, $r->getCurrency(), $r->total, $r->paid(), $r->getBalance(), $r->totWeight()]);
					}
					$xls->output('invoice_search_export_' . time() . '.xlsx');
				} else {
					$xls->setColWidth([10, 25, 10, 10, 10, 10, 10, 10, 10, 10, 15, 10, 15, 15, 15, 10, 15, 15, 15, 15, 15]);
					$xls->addRow($i++, ['Number', 'No', 'AWB', 'Priority', '', '', '', '', '', 'Bill to', 'Agent ID', 'Status', 'Type', 'Branch', 'Date', 'Due', 'Post Date', 'Currency', 'Total', 'Paid', 'Balance', 'Total Weight']);
					$xls->mergeCells('D1:I1');
					$xls->addRow($i++, ['', '', '', 'ESF', 'EDF', 'AF', 'OTHER', 'GST', 'SUBTOTAL']);
					$model = new Invoice('search');
					$model->unsetAttributes();
					if (!empty($_GET['Invoice'])) {
						$model->attributes = $_GET['Invoice'];
					}
					$dp = $model->search(false, 0);
					foreach ($dp->data as $r) {
						$job = EdiJob::model()->find('no = :no', [':no' => $r->getModelNo()]);
						if (!empty($job)) {
							$billinglines = BillingLine::model()->findAll('billing_ref = :ref', [':ref' => $job->no]);
							$costs = ['ESF' => 0, 'EDF' => 0, 'AF' => 0, 'OTHER' => 0, 'GST' => 0, 'SUBTOTAL' => 0];
							foreach ($billinglines as $billingline) {
								if ($billingline->item_code == 'GL11') {
									$costs['ESF'] += $billingline->actual_amount;
									$costs['GST'] += $billingline->gst_amount;
								} elseif ($billingline->item_code == 'GL5') {
									$costs['EDF'] += $billingline->actual_amount;
									$costs['GST'] += $billingline->gst_amount;
								} elseif ($billingline->item_code == 'GL1') {
									$costs['AF'] += $billingline->actual_amount;
									$costs['GST'] += $billingline->gst_amount;
								} else {
									$costs['OTHER'] += $billingline->actual_amount;
									$costs['GST'] += $billingline->gst_amount;
								}
								$costs['SUBTOTAL'] += $billingline->actual_amount + $billingline->gst_amount;
							}
							$xls->addRow($i++, ['="' . $r->no . '"', $r->getModelNo(), $r->getModelAWB(), $costs['ESF'], $costs['EDF'], $costs['AF'], $costs['OTHER'], $costs['GST'], $costs['SUBTOTAL'], empty($r->to_id) ? "" : $r->cust->name, $r->to_id, $r->getStatus(), $r->getType(), $r->getBranch(), $r->date, $r->due, $r->posted, $r->getCurrency(), $r->total, $r->paid(), $r->getBalance(), $r->totWeight()]);
						} else {
							$xls->addRow($i++, ['="' . $r->no . '"', $r->getModelNo(), $r->getModelAWB(), '', '', '', '', '', '', empty($r->to_id) ? "" : $r->cust->name, $r->to_id, $r->getStatus(), $r->getType(), $r->getBranch(), $r->date, $r->due, $r->posted, $r->getCurrency(), $r->total, $r->paid(), $r->getBalance(), $r->totWeight()]);
						}
					}
					$xls->output('invoice_search_export_' . time() . '.xlsx');
				}
				break;
			case 'search2':
				$xls->setColWidth([10, 10, 10, 15, 15, 15, 15, 10, 15, 15, 15, 15, 15, 20]);
				$xls->addRow($i++, ['Number', 'Bill to', 'Status', 'Type', 'Branch', 'Department', 'Date', 'Due', 'Post Date', 'Currency', 'Total', 'Paid', 'Balance', 'Allocate Date']);
				$model = new Invoice('search');
				$model->unsetAttributes();
				if (!empty($_GET['Invoice'])) {
					$model->attributes = $_GET['Invoice'];
				}
				$dp = $model->search(false, 0);
				foreach ($dp->data as $r) {
					$date = '';
					foreach ($r->payments as $pay) {
						if ($date) {
							$date .= ' ';
						}
						$date .= $pay->transaction_date;
					}
					$xls->addRow($i++, ['="' . $r->no . '"', empty($r->to_id) ? "" : $r->cust->name, $r->getStatus(), $r->getType(), $r->getBranch(), $r->getDpmt(), $r->date, $r->due, $r->posted, $r->getCurrency(), $r->total, $r->paid(), $r->getBalance(), $date]);
				}
				$xls->output('invoice_search_export_' . time() . '.xlsx');
				break;
			case 'wtck':
				$model = new Invoice('search');
				$model->unsetAttributes();
				$model->date = '>=' . $_POST['from_date'];
				$model->to_id = $_POST['agent_id'];
				$dp = $model->search(false, 0);
				$xls->addRow($i++, ['Invoice Number', 'HBN', 'Type', 'Billed Weight', 'Real Weight', 'Charge', 'Short']);
				$xls->setColWidth([15, 25, 10, 10, 15, 15]);
				foreach ($dp->data as $r) {
					foreach ($r->lines as $l) {
						if (empty($l->mdata['items'])) {
							continue;
						}
						foreach ($l->mdata['items'] as $itm) {
							$p = ExParcel::model()->find('hbn = :r', [':r' => $itm[0]]);
							if (empty($p)) {
								continue;
							}
							$weight = $p->chargeWeight();
							if ($weight > $itm[2]) {
								$rate = $p->getAgentRate(false, false);
								$xls->addRow($i++, ['="' . $r->no . '"', $p->hbn, $itm[4], $itm[2], $weight, $itm[7], $rate[2] - $itm[7]]);
							}
						}
					}
				}
				$xls->output('invoice_weight_check_' . time() . '.xlsx');
				break;
			case 'rcvb':
				$date = !empty($_POST['postdate']) ? $_POST['postdate'] : date('Y-m-d');
				if (in_array($_POST['rptyp'], ['agingnew', 'agingnewmonthly'])) {
					$rs = Invoice::model()->findAll(['condition' => '(status in (' . (empty($_POST['incpending']) ? '' : '1,') . '2,3,7) and date <= :date) OR id IN (select inv.id FROM invoice inv INNER JOIN pay_inv pi ON pi.inv_id = inv.id INNER JOIN payment pay ON pay.id = pi.pay_id WHERE inv.date <= :date AND inv.status IN (6,8,9,11) AND (pay.date > :date OR pi.transaction_date > :date1))', 'params' => [':date' => $date, ':date1' => date('Y-m-d', strtotime($date . ' + 7 day'))], 'order' => 'to_id ASC, currency ASC']);
				} else if (in_array($_POST['rptyp'], ['agingsale'])) {
					$fromdate = !empty($_POST['fromdate']) ? $_POST['fromdate'] : '1970-01-01';
					$rs = Invoice::model()->findAll(['condition' => 'status != 10 AND date >= :fromdate AND date <= :todate', 'params' => [':fromdate' => $fromdate, ':todate' => $date], 'order' => 'to_id ASC, currency ASC']);
				} else {
					$rs = Invoice::model()->findAll(['condition' => '(status in (' . (empty($_POST['incpending']) ? '' : '1,') . '2,3,7) and date <= :date) OR id IN (select inv.id FROM invoice inv INNER JOIN pay_inv pi ON pi.inv_id = inv.id INNER JOIN payment pay ON pay.id = pi.pay_id WHERE inv.date <= :date AND inv.status IN (6,8,9,11) AND pi.transaction_date > :date)', 'params' => [':date' => $date], 'order' => 'due ASC, id ASC']);
				}

				$cus = [];
				foreach ($rs as $r) {
					if (!empty($_POST['wid']) && $r->dpt_id != $_POST['wid']) {
						continue;
					}
					if (!empty($_POST['agent_id']) && $_POST['agent_id'] != $r->to_id) {
						continue;
					}
					if (!empty($_POST['suborg_id']) && (empty($r->mdata['suborg']) || $_POST['suborg_id'] != $r->mdata['suborg'])) {
						continue;
					}
					if (!empty($_POST['ex_suborg_id']) && $_POST['ex_suborg_id'] == $r->mdata['suborg']) {
						continue;
					}
					$cus[empty($_POST['wid']) ? 1 : $r->dpt_id][$r->to_id][] = $r;
				}

				$sc = 0;
				if ($_POST['rptyp'] == 'pdf') {
					$td = Yii::app()->basePath . DIRECTORY_SEPARATOR . "runtime" . DIRECTORY_SEPARATOR;
					$zf = $td . 'Statments_' . (empty($_POST['agent_id']) ? '' : $_POST['agent_id'] . '_') . date('Ymd') . '.zip';
					$_GET['bal'] = 1;
					if (empty($_POST['agent_id'])) {
						$zip = new ZipArchive;
						$zip->open($zf, ZipArchive::CREATE);
					}
					$ps = [];
					foreach ($cus as $wid => $cs) {
						foreach ($cs as $cid => $rs) {
							$tf = tempnam($td, "stmt");
							oPDF::renderPDF('statement', ['invs' => $rs, 'ata' => empty($_POST['wcredit']) ? 0 : Payment::orgTotalAta($cid), 'ps' => Payment::orgAtaDetails($cid)], 2, $tf);
							$ps[] = $tf;
							foreach ($rs as $r) {
								$tf = tempnam($td, "stmt");
								oPDF::renderPDF('invoice', ['inv' => $r], 2, $tf);
								$ps[] = $tf;
								if ($r->type == 60) {
									$tf2 = tempnam($td, "stmt");
									oPDF::renderPDF('invoice_detail', ['inv' => $r], 2, $tf2);
									$ps[] = $tf2;
									if ($model->to_id == 1457) {
										$f3 = tempnam(Yii::app()->basePath . "/runtime", "ivp");
										oPDF::renderPDF('stock_detail', ['inv' => $model], 2, $f3);
										$ps[] = $f3;
									}
								}
							}
							if (empty($_POST['agent_id'])) {
								$zip->addFromString('Statement_' . $cid . '.pdf', oPDF::mergePDF($ps, 3));
							}
						}
					}
					if (!empty($_POST['agent_id'])) {
						oPDF::mergePDF($ps, 1, true, 'Statement_' . $_POST['agent_id'] . '.pdf');
					}
					if (empty($_POST['agent_id'])) {
						$zip->close();
						header("Cache-Control: maxage=1");
						header("Content-Description: File Transfer");
						header("Content-type: application/octet-stream");
						header('Content-Disposition: attachment; filename="' . basename($zf) . '"');
						header("Content-Transfer-Encoding: binary");
						header("Content-Length: " . filesize($zf));
						readfile($zf);
						unlink($zf);
					}
				} elseif ($_POST['rptyp'] == 'xls') {
					$i = 1;
					if (!empty($_POST['suborg_id'])) {
						$subo = Org::model()->findByPk($_POST['suborg_id']);
					}
					foreach ($cus as $wid => $cs) {
						foreach ($cs as $cid => $rs) {
							$xls->addRow($i++, [$cid, $rs[0]->cust->name, empty($subo) ? '' : 'For sub A/C: ' . $subo->name]);
							$xls->addRow($i, ['No', 'Type', 'AWB', 'Date', 'Due', 'Total', 'Paid', 'Balance']);
							$xls->setFont('A' . $i . ':H' . $i, ['bold' => true]);
							$i++;
							$tot = [0, 0, 0];
							foreach ($rs as $r) {
								$paid = $r->paid();
								if ($r->type == 10) {
									// for import invoice
									$awb = '';
									if (!empty($r->mdata['awb'])) {
										$awb = $r->mdata['awb'];
									}
									if (isset($r->lines[0]) && isset($r->lines[0]->mdata['items'])) {
										foreach ($r->lines[0]->mdata['items'] as $si => $ri) {
											// $awb = $ri[0];
											break;
										}
									}
									$xls->addRow($i++, [$r->no, $r->getType(), $awb, $r->date, $r->due, AppHelper::money_format('%i', $r->total), AppHelper::money_format('%i', $paid), AppHelper::money_format('%i', $r->total - $paid)]);
								} else {
									$awb = '';
									if (!empty($r->mdata['awb'])) {
										$awb = $r->mdata['awb'];
									}
									if (empty($awb) && $r->type == 40 && !empty($r->consol_id)) {
										$consol = Consol::model()->find("id=:id", [':id' => $r->consol_id]);
										if (!empty($consol)) {
											$awb = $consol->no;
										}
									}
									$xls->addRow($i++, [$r->no, $r->getType(), $awb, $r->date, $r->due, AppHelper::money_format('%i', $r->total), AppHelper::money_format('%i', $paid), AppHelper::money_format('%i', $r->total - $paid)]);
								}
								$tot[0] += $r->total;
								$tot[1] += $paid;
								$tot[2] += $r->total - $paid;
							}
							
							$ata = empty($_POST['wcredit']) ? 0 : Payment::orgTotalAta($cid);
							if ($ata > 0) {
								$as = Payment::model()->findAll('status = 6 AND ata > 0 AND org_id = :oid', [':oid' => $cid]);
								foreach ($as as $a) {
									$xls->addRow($i++, ['Credit', $a->ref, $a->note, $a->date, '', '', AppHelper::money_format('%i', $a->ata), AppHelper::money_format('%i', 0 - $a->ata)]);
									$tot[1] += $a->ata;
									$tot[2] -= $a->ata;
								}
							}

							$xls->addRow($i++, ['', '', '', '', 'Total:', AppHelper::money_format('%i', $tot[0]), AppHelper::money_format('%i', $tot[1]), AppHelper::money_format('%i', $tot[2])]);
							$xls->addRow($i++, []);
							foreach ($rs as $r) {
								$awb_to = [];
								if (!empty($r->mdata['awb'])) {
									$awb_to = ['MAWB', $r->mdata['awb']];
								} elseif ($r->type == 40 && !empty($r->consol_id)) {
									$consol = Consol::model()->find("id=:id", [':id' => $r->consol_id]);
									if (!empty($consol)) {
										$awb_to = ['MAWB', $consol->no];
									}
								}
								$xls->addRow($i++, array_merge([$r->no, $r->date], $awb_to));
								if ($r->type != 100) {
									$xls->addRow($i, ['HBN', 'Shipper', 'Packages', 'Weight', 'Type', 'Rate', 'Amount']);
									$xls->setFont('A' . $i . ':G' . $i, ['bold' => true]);
									$i++;
									$qty = 0;
									$wei = 0;
									$cbm = 0;
									$tot = 0;
									foreach ($r->lines as $il) {
										if ($r->type == 40 || $r->type == 50) {
											$xls->addRow($i++, [$il->det, $il->ccode, $il->qty, '', '', '', ($il->amount - $il->gst) * $il->qty]);
											$tot += ($il->amount - $il->gst) * $il->qty;
											$qty += $il->qty;
										} else {
											if (empty($il->mdata['items'])) {
												continue;
											}
											foreach ($il->mdata['items'] as $si => $ri) {
												// import has different data format with export invoice
												if ($r->type == 10) {
													// for import invoice
													$charge_wei = round(empty($ri[9]) ? $ri[3] : $ri[9], 2);
													if (preg_match('/LET\d{7}/i', $ri[0])) {
														$p = ImParcel::model()->find('ref=:ref', [':ref' => $ri[0]]);
														if (!empty($p)) {
															$ri[0] .= '(' . $p->hbn . ')';
														}
													}
													$xls->addRow($i++, [$ri[0], $ri[1], 1, $charge_wei, '', '', $ri[5]]);
													$tot += floatval($ri[5]);
													$qty++;
													$wei += $charge_wei;
												} elseif ($r->type == 37) {
													//rts invoice
													$shipment = Shipment::model()->find('hbn=:hbn', [':hbn' => trim($ri[0])]);
													if (!empty($shipment)) {
														$ri[3] = $shipment->ref;
														if (!empty($shipment->mdata['rts_org_no'])) {
															$shipment_orig = Shipment::model()->find('hbn=:hbn', [':hbn' => trim($shipment->mdata['rts_org_no'])]);
															if (isset($shipment_orig)) {
																$ri[3] .= '//' . $shipment_orig->ref;
															}
														}
													}
													$xls->addRow($i++, [$ri[0] . '(' . $ri[3] . ')', $ri[1], 1, '', '', '', $ri[2]]);
													$wei += 0;
													$qty++;
													$tot += floatval($ri[2]);
												} elseif ($r->type == 36) {
													// for rts scan fee
													$xls->addRow($i++, [$ri[0], $ri[1], 1, '', $ri[3], $ri[2], isset($ri[4]) ? $ri[4] : '']);
													$tot += isset($ri[4]) ? floatval($ri[4]) : 0;
													$qty++;
													$wei += 0;
												} elseif ($r->type == 60) {
													$xls->addRow($i++, ['Storage', $ri[0], $ri[1], $ri[2], '', '', $ri[2] * $ri[3]]);
													$tot += floatval($ri[2]) * floatval($ri[3]);
												} else {
													// for export invoice
													$xls->addRow($i++, [$ri[0], $ri[1], 1, $ri[2], $ri[4] . '(' . (empty($ri[5]) ? '' : $ri[5]) . ')', isset($ri[6]) ? $ri[6] : '', isset($ri[7]) ? $ri[7] : '']);
													$tot += isset($ri[7]) ? floatval($ri[7]) : 0;
													$qty++;
													$wei += floatval($ri[2]);
												}
											}
										}
									}
									$xls->addRow($i, ['', 'Total:', $qty, $wei, '', '', $tot]);
									$xls->setFont('A' . $i . ':G' . $i, ['bold' => true]);
									$i++;
									$xls->addRow($i++, []);
								} else {
									$xls->addRow($i, ['HBN', 'Description', 'Unit Price', 'Qty', 'Amount']);
									$xls->setFont('A' . $i . ':E' . $i, ['bold' => true]);
									$i++;
									$description = '';
									$qty = 0;
									$tot = 0;
									foreach ($r->lines as $il) {
										if (empty($il->mdata['items'])) {
											continue;
										}
										foreach ($il->mdata['items'] as $si => $ri) {
											$xls->addRow($i++, [$ri[0], $ri[3], $ri[4], $ri[5], $ri[6]]);
											$qty += intval($ri[5]);
											$tot += floatval($ri[6]);
										}
									}
									$xls->addRow($i, ['', 'Total:', '', $qty, $tot]);
									$xls->setFont('A' . $i . ':E' . $i, ['bold' => true]);
									$i++;
									$xls->addRow($i++, []);
								}
							}
						}
					}
					$xls->output('Statement_' . (empty($_POST['agent_id']) ? 'ALL' : $_POST['agent_id']) . '.xlsx');
				} elseif ($_POST['rptyp'] == 'detail') {
					$td = !empty($_POST['postdate']) ? $_POST['postdate'] : date('Y-m-d');
					foreach ($cus as $oid => $cs) {
						$dpt = Org::model()->findByPk($oid);
						if ($sc > 0) {
							$xls->createSheet(empty($dpt) ? 'Direct' : $dpt->shortName(1));
							$xls->goSheet($sc);
						} else {
							$sheet = $xls->getActiveSheet();
							$sheet->setTitle(empty($dpt) ? 'Direct' : $dpt->shortName(1));
						}
						$i = 1;
						$setHdr();

						foreach ($cs as $cid => $rs) {
							$sr = $i;
							foreach ($rs as $r) {
								$xls->addRow($i++, ['="' . $r->no . '"', $r->getDpmt(), empty($r->to_id) ? "" : $r->cust->name, $r->to_id, $r->getStatus(), $r->getType(), $r->getBranch(), $r->date, $r->due, $r->posted, $r->getCurrency(), $r->total, $r->paidBefore($td), $r->getBalanceBefore($td)]);
							}
							$xls->addRow($i++, ['*Sub Total:', '', '', '', '', '', '', '', '', '', '', '=SUM(L' . $sr . ':L' . ($i - 2) . ')', '=SUM(M' . $sr . ':M' . ($i - 2) . ')', '=SUM(N' . $sr . ':N' . ($i - 2) . ')']);
							// $xls->addRow($i++, []);
						}
						$sc++;
					}
					$xls->output('debtor_detail_' . date('Ymd') . '.xlsx');
				} elseif ($_POST['rptyp'] == 'aging') {
					$i = 1;

					$showCredits = !empty($_POST['wcredit']);

					if ($showCredits) {
						$allAtaPayment = Payment::getTotalAtaPaymentAmountList(date('Y-m-d'));
						$xls->addRow($i++, ['Agent', 'Agent ID', '7 Days', '15 Days', '30 Days', '60 Days', '90 Days', '> 90 Days', 'Credits', 'Total']);
						$xls->setColWidth([25, 10, 15, 15, 15, 15, 15, 15, 15, 20]);
					} else {
						$xls->addRow($i++, ['Agent', 'Agent ID', '7 Days', '15 Days', '30 Days', '60 Days', '90 Days', '> 90 Days', 'Total']);
						$xls->setColWidth([25, 10, 15, 15, 15, 15, 15, 15, 20]);
					}

					$data = [];
					foreach ($cus as $oid => $cs) {
						foreach ($cs as $cid => $rs) {
							if (!isset($data[$cid])) {
								$data[$cid] = ['', 0, 0, 0, 0, 0, 0, 0];
							}
							foreach ($rs as $r) {
								if (empty($data[$cid][0])) {
									$data[$cid][0] = $r->cust->name;
								}
								$td = ceil((strtotime(date('Y-m-d')) - strtotime($r->due)) / 86400);
								$bal = $r->getBalance();
								if ($td > 90) {
									$data[$cid][6] += $bal;
								} elseif ($td > 60) {
									$data[$cid][5] += $bal;
								} elseif ($td > 30) {
									$data[$cid][4] += $bal;
								} elseif ($td > 15) {
									$data[$cid][3] += $bal;
								} elseif ($td > 7) {
									$data[$cid][2] += $bal;
								} else {
									$data[$cid][1] += $bal;
								}
								$data[$cid][7] += $bal;
							}
						}
					}

					foreach ($data as $cid => $r) {
						// get customer all available payment now
						if ($showCredits) {
							$alvPayamount = Payment::orgTotalAta($cid);
							$total = $r[7] - $alvPayamount;
							if ($alvPayamount > 0) {
								$alvPayamount = '-' . $alvPayamount;
							} else {
								$alvPayamount = '0';
							}
							$xls->addRow($i++, [$r[0], $cid, $r[1], $r[2], $r[3], $r[4], $r[5], $r[6], $alvPayamount, $total]);
							if (isset($allAtaPayment[$cid])) {
								unset($allAtaPayment[$cid]);
							}
						} else {
							$xls->addRow($i++, [$r[0], $cid, $r[1], $r[2], $r[3], $r[4], $r[5], $r[6], $r[7]]);
						}
					}

					if ($showCredits) {
						foreach ($allAtaPayment as $oid => $amount) {
							$org = Org::model()->findByPk($oid);
							$xls->addRow($i++, [$org->name, $oid, '', '', '', '', '', '', '', '-' . $amount]);
						}
					}

					$xls->output('debtor_aging_' . date('Ymd') . '.xlsx');
				} elseif ($_POST['rptyp'] == 'pdfnew') {
					if (empty($_POST['agent_id'])) {
						echo 'please choose an agent';
					} else {
						$td = Yii::app()->basePath . DIRECTORY_SEPARATOR . "runtime" . DIRECTORY_SEPARATOR;
						$date = !empty($_POST['postdate']) ? $_POST['postdate'] : date('Y-m-d');
						$fromdate = !empty($_POST['fromdate']) ? $_POST['fromdate'] : '1970-01-01';
						if (!empty($_POST['orderbydate'])) {
							$order = 'date asc, id asc';
						} else {
							$order = 'due asc, id asc';
						}
						if(!empty($_POST['wid'])){
							$rs = Invoice::model()->findAll(['condition' => 'id in (select distinct id from invoice where (to_id = :org_id and status in (' . (empty($_POST['incpending']) ? '' : '1,') . '2,3,7)) and dpt_id = :dpt_id and  date <= :date and date >= :fromdate and total != 0 order by ' . $order . ')', 'params' => [':org_id' => $_POST['agent_id'],':dpt_id'=> $_POST['wid'], ':date' => $date, ':fromdate' => $fromdate], 'order' => $order]);
						}else{
							$rs = Invoice::model()->findAll(['condition' => 'id in (select distinct id from invoice where (to_id = :org_id and status in (' . (empty($_POST['incpending']) ? '' : '1,') . '2,3,7)) and date <= :date and date >= :fromdate and total != 0 order by ' . $order . ')', 'params' => [':org_id' => $_POST['agent_id'], ':date' => $date, ':fromdate' => $fromdate], 'order' => $order]);
						}
						foreach ($rs as $k => $r) {
							if (!empty($_POST['ex_suborg_id']) && $_POST['ex_suborg_id'] == $r->mdata['suborg']) {
								unset($rs[$k]);
							}
						}

						if(!empty($_POST['agent_id'])&&$_POST['agent_id']==Org::ORGID_COURIER_4PX)
						{
							$rs2 = Invoice::model()->findAll("no in ('ST711323','ST719083','ST719086','ST719638','ST722347','ST722617','ST723550','ST724951','ST728146','ST728977','ST729403','ST730606','ST737458','ST739282','ST739381','ST756958','ST756961','ST756964','ST756967','ST761641','ST765673','ST767401','ST767404','ST773353','ST773362','ST773365','ST775243','ST775759','ST775813','ST775819','ST775888','ST776740','ST777952','ST778975','ST779374','ST779377','ST779752','ST779755','ST785680','ST785683','ST785686','ST785692','ST786382','ST792412','ST792415','ST792847','ST792850','ST792853','ST794407','ST794410','ST794638','ST794641','ST794644','ST796759','ST798241','ST798949','ST800518','ST800776','ST800779','ST800782','ST800941','ST801457','ST802624','ST802627','ST804208','ST805006','ST805009','ST807199','ST807859','ST808105','ST808108','ST809080','ST809551','ST809554','ST809557','ST809566','ST809569','ST809572','ST809977','ST810232','ST810235','ST810238','ST810241','ST810841','ST811981','ST812143','ST815518','ST815521','ST817141','ST818110','ST818212','ST818215','ST818398','ST818656','ST818659') and status not in (9,10,99)");

							$rs = array_merge($rs,$rs2);
						}

						$rs = array_values($rs);
						$_GET['bal'] = 1;

						if (empty($rs)) {
							if(!empty($_POST['email']))
							{
								return 'all invoices have been paid';
							}

							echo 'all invoices have been paid';
							return;
						}

						// eva customer
						$org = Org::model()->findByPk($_POST['agent_id']);
						if (!empty($org->extra['sp_id']) && $org->extra['sp_id'] == 305) {
							if (empty($org->extra['statement_invs'])) {
								$org->extra['statement_invs'] = [];
							}
							foreach ($rs as $r) {
								$org->extra['statement_invs'][] = $r->id;
							}
							$org->update('meta');
						}

						$tf = tempnam($td, "stmt");

						$behalf = null;
						if (!empty($_POST['onbehalf']) && !empty($_POST['suborg_id'])) {
							switch ($_POST['agent_id']) {
								case 1084:
									$behalf = 'priority';
									break;
							}
						}

						$ata = empty($_POST['wcredit']) ? 0 : Payment::orgAtaBefore($_POST['agent_id'], date('Y-m-d'), $_POST['wcredit']);
						$myPs = empty($_POST['wcredit']) ? [] : Payment::orgAtaDetailsBefore($_POST['agent_id'], date('Y-m-d'), $_POST['wcredit']);
						if(!empty($_POST['wcredit']))
						{
							$orgParent = Org::model()->findByPk($_POST['agent_id']);
							foreach ($orgParent->childs as $key => $child) {
								$thisAta = Payment::orgAtaBefore($child->id, date('Y-m-d'), $_POST['wcredit']);
								$ata+=$thisAta;
								$thisPs = Payment::orgAtaDetailsBefore($child->id, date('Y-m-d'), $_POST['wcredit']);
								if(!empty($thisPs))
								{
									$myPs = array_merge($thisPs,$myPs);
								}
							}
						}

						oPDF::renderPDF('statement', ['invs' => $rs, 'ata' => $ata, 'ps' => $myPs, 'date' => date('Y-m-d'), 'behalf' => $behalf], 2, $tf);
						$ps[] = $tf;
						if (empty($_POST['excludedetails'])) {
							foreach ($rs as $r) {
								if (!empty($_POST['suborg_id']) && (empty($r->mdata['suborg']) || $_POST['suborg_id'] != $r->mdata['suborg'])) {
									continue;
								}
								if (!empty($_POST['ex_suborg_id']) && $_POST['ex_suborg_id'] == $r->mdata['suborg']) {
									continue;
								}
								$tf = tempnam($td, "stmt");
								oPDF::renderPDF('invoice', ['inv' => $r, 'date' => date('Y-m-d'), 'behalf' => $behalf], 2, $tf);
								$ps[] = $tf;
								if ($r->type == 60) {
									$tf2 = tempnam($td, "stmt");
									oPDF::renderPDF('invoice_detail', ['inv' => $r, 'date' => date('Y-m-d')], 2, $tf2);
									$ps[] = $tf2;
									if ($model->to_id == 1457) {
										$f3 = tempnam(Yii::app()->basePath . "/runtime", "ivp");
										oPDF::renderPDF('stock_detail', ['inv' => $model], 2, $f3);
										$ps[] = $f3;
									}
								}
							}
							if (!empty($_POST['wcredit'])) {
								$orgParent = Org::model()->findByPk($_POST['agent_id']);
								$payments = Payment::orgAtaDetailsBefore($_POST['agent_id'], date('Y-m-d'), $_POST['wcredit']);
								foreach ($payments as $p) {
									$tf3 = tempnam($td, 'cn');
									$p = Payment::model()->find('no = :no', array(':no' => $p['no']));
									oPDF::renderPDF('credit_note', array('credit' => $p), 2, $tf3);
									$ps[] = $tf3;
								}

								foreach ($orgParent->childs as $key => $child) {
									$payments = Payment::orgAtaDetailsBefore($child->id, date('Y-m-d'), $_POST['wcredit']);
									foreach ($payments as $p) {
										$tf3 = tempnam($td, 'cn');
										$p = Payment::model()->find('no = :no', array(':no' => $p['no']));
										oPDF::renderPDF('credit_note', array('credit' => $p), 2, $tf3);
										$ps[] = $tf3;
									}
								}

								foreach ($payments as $p) {
									$tf3 = tempnam($td, 'cn');
									$p = Payment::model()->find('no = :no', array(':no' => $p['no']));
									oPDF::renderPDF('credit_note', array('credit' => $p), 2, $tf3);
									$ps[] = $tf3;
								}
							}
						}

						if(!empty($_POST['email']))
						{
							$td=Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR.'zipemail'.time();
							if (!file_exists($td)) {
								mkdir($td);
							}
							$pdf_file=$td.DIRECTORY_SEPARATOR.'Statement_' . $_POST['agent_id'] . '.pdf';
							oPDF::mergePDF($ps, 2, true, $pdf_file);
							$files=[$pdf_file, basename($pdf_file)];
							return $files;
						}
						oPDF::mergePDF($ps, 1, true, 'Statement_' . $_POST['agent_id'] . '.pdf');
					}
				} else if ($_POST['rptyp'] == 'pdfall') {
					if (empty($_POST['agent_id'])) {
						echo 'please choose an agent';
					} else {
						$td = Yii::app()->basePath . DIRECTORY_SEPARATOR . 'runtime' . DIRECTORY_SEPARATOR;
						$date = !empty($_POST['postdate']) ? $_POST['postdate'] : date('Y-m-d');
						$fromdate = !empty($_POST['fromdate']) ? $_POST['fromdate'] : '1970-01-01';

						$rs = Invoice::model()->findAll(['condition' => 'to_id = :org_id AND date <= :date AND date >= :fromdate AND total != 0', 'params' => [':org_id' => $_POST['agent_id'], ':date' => $date, ':fromdate' => $fromdate], 'order' => 'due asc, id asc']);
						if (empty($rs)) {
							echo 'no invoice';
							return;
						}

						$tf = tempnam($td, 'stmt');
						oPDF::renderPDF('statement', ['invs' => $rs, 'ata' => empty($_POST['wcredit']) ? 0 : Payment::orgAtaBefore($_POST['agent_id'], $date, $_POST['wcredit']), 'ps' => empty($_POST['wcredit']) ? [] : Payment::orgAtaDetailsBefore($_POST['agent_id'], $date, $_POST['wcredit']), 'date' => $date], 2, $tf);
						$ps[] = $tf;
						foreach ($rs as $r) {
							$tf = tempnam($td, 'stmt');
							oPDF::renderPDF('invoice', ['inv' => $r, 'date' => $date], 2, $tf);
							$ps[] = $tf;
							if ($r->type == 60) {
								$tf2 = tempnam($td, 'stmt');
								oPDF::renderPDF('invoice_detail', ['inv' => $r, 'date' => $date], 2, $tf2);
								$ps[] = $tf2;
								if ($model->to_id == 1457) {
									$f3 = tempnam(Yii::app()->basePath . "/runtime", "ivp");
									oPDF::renderPDF('stock_detail', ['inv' => $model], 2, $f3);
									$ps[] = $f3;
								}
							}
						}

						if (!empty($_POST['wcredit'])) {
							$payments = Payment::orgAtaDetailsBefore($_POST['agent_id'], $date, $_POST['wcredit']);
							foreach ($payments as $p) {
								$tf3 = tempnam($td, 'cn');
								$p = Payment::model()->find('no = :no', array(':no' => $p['no']));
								oPDF::renderPDF('credit_note', array('credit' => $p), 2, $tf3);
								$ps[] = $tf3;
								unlink($tf3);
							}
						}
						oPDF::mergePDF($ps, 1, true, 'Statement_All_' . $_POST['agent_id'] . '.pdf');
						foreach ($ps as $key => $tf) {
							unlink($tf);
						}
					}
				} elseif ($_POST['rptyp'] == 'xlsnew') {
					if (empty($_POST['agent_id'])) {
						echo 'please choose an agent';
					} else {
						$date = !empty($_POST['postdate']) ? $_POST['postdate'] : date('Y-m-d');
						$fromdate = !empty($_POST['fromdate']) ? $_POST['fromdate'] : '1970-01-01';
						$i = 1;
						if (!empty($_POST['orderbydate'])) {
							$order = 'date asc, id asc';
						} else {
							$order = 'due asc, id asc';
						}
						$rs = Invoice::model()->findAll(['condition' => 'id in (select distinct id from invoice where (to_id = :org_id and status in (' . (empty($_POST['incpending']) ? '' : '1,') . '2,3,7)) and date <= :date and date >= :fromdate and total != 0 order by ' . $order . ')', 'params' => [':org_id' => $_POST['agent_id'], ':date' => $date, ':fromdate' => $fromdate], 'order' => $order]);
						$cus = [];

						foreach ($rs as $r) {
							if (!empty($_POST['wid']) && $r->dpt_id != $_POST['wid']) {
								continue;
							}
							if (!empty($_POST['suborg_id']) && (empty($r->mdata['suborg']) || $_POST['suborg_id'] != $r->mdata['suborg'])) {
								continue;
							}
							if (!empty($_POST['ex_suborg_id']) && $_POST['ex_suborg_id'] == $r->mdata['suborg']) {
								continue;
							}
							$cus[empty($_POST['wid']) ? 1 : $r->dpt_id][$r->to_id][] = $r;
						}
						if (!empty($_POST['suborg_id'])) {
							$subo = Org::model()->findByPk($_POST['suborg_id']);
						}
						foreach ($cus as $oid => $cs) {
							foreach ($cs as $cid => $rs) {
								$xls->addRow($i++, [$cid, $rs[0]->cust->name, empty($subo) ? '' : 'For sub A/C: ' . $subo->name]);
								$xls->addRow($i, ['No', 'Type', 'AWB', 'Date', 'Due', 'SubTotal', 'GST', 'Total', 'Paid', 'Balance', 'Currency']);
								$xls->setFont('A' . $i . ':I' . $i, ['bold' => true]);
								$i++;
								foreach (Invoice::$currencies as $currency) {
									$tots[$currency] = [0, 0, 0];
								}
								foreach ($rs as $r) {
									$paid = $r->paidBefore($date);
									if ($r->type == 10) {
										// for import invoice
										$awb = '';
										if (!empty($r->mdata['awb'])) {
											$awb = $r->mdata['awb'];
										}
										if (isset($r->lines[0]) && isset($r->lines[0]->mdata['items'])) {
											foreach ($r->lines[0]->mdata['items'] as $si => $ri) {
												// $awb = $ri[0];
												break;
											}
										}
										$xls->addRow($i++, [$r->no, $r->getType(), $awb, $r->date, ($r->type != 100 ? $r->due : $r->posted), AppHelper::number_format('%i', $r->total - $r->gst), AppHelper::number_format('%i', $r->gst), AppHelper::number_format('%i', $r->total), AppHelper::number_format('%i', $paid), AppHelper::number_format('%i', $r->total - $paid), $r->getCurrency()]);
									} else {
										$awb = '';
										if (!empty($r->mdata['awb'])) {
											$awb = $r->mdata['awb'];
										}
										if (empty($awb)) {
											if ($r->type == 40 && !empty($r->consol_id)) {
												$consol = Consol::model()->find("id=:id", [':id' => $r->consol_id]);
												if (!empty($consol)) {
													$awb = $consol->no;
												}
											} elseif (!empty($r->job_id)) {
												$awb = $r->job->awb;
											}
										}
										$xls->addRow($i++, [$r->no, $r->getType(), $awb, $r->date, $r->due, AppHelper::number_format('%i', $r->total - $r->gst), AppHelper::number_format('%i', $r->gst), AppHelper::number_format('%i', $r->total), AppHelper::number_format('%i', $paid), AppHelper::number_format('%i', $r->total - $paid), $r->getCurrency()]);
									}
									$tots[$r->getCurrency()][0] += $r->total;
									$tots[$r->getCurrency()][1] += $paid;
									$tots[$r->getCurrency()][2] += $r->total - $paid;
								}

								foreach (Invoice::$currencies as $index => $currency) {
									$ata = empty($_POST['wcredit']) ? 0 : Payment::orgAtaBefore($cid, $date, $_POST['wcredit'], $index);
									if ($ata > 0) {
										$as = Payment::orgAtaDetailsBefore($cid, $date, $_POST['wcredit'], $index);
										foreach ($as as $a) {
											$xls->addRow($i++, [$a['no'], $a['ref'], $a['note'], $a['date'], '', '', AppHelper::number_format('%i', $a['total']), AppHelper::number_format('%i', 0 - $a['total']), $currency]);
											$tots[$currency][1] += $a['total'];
											$tots[$currency][2] -= $a['total'];
										}
									}
								}
								foreach ($tots as $currency => $tot) {
									if ($tot[0] || $tot[1] || $tot[2]) {
										$xls->addRow($i++, ['', '', '', '', '', '', 'Total:', AppHelper::number_format('%i', $tot[0]), AppHelper::number_format('%i', $tot[1]), AppHelper::number_format('%i', $tot[2]), $currency]);
									}
								}
								$xls->addRow($i++, []);
								foreach ($rs as $r) {
									$awb_to = [];
									if (!empty($r->mdata['awb'])) {
										$awb_to = ['MAWB', $r->mdata['awb']];
									} elseif ($r->type == 40 && !empty($r->consol_id)) {
										$consol = Consol::model()->find("id=:id", [':id' => $r->consol_id]);
										if (!empty($consol)) {
											$awb_to = ['MAWB', $consol->no];
										}
									}
									$xls->addRow($i++, array_merge([$r->no, $r->date], $awb_to));
									if ($r->type == 100) {
										$xls->addRow($i, ['HBN', 'Description', 'Unit Price', 'Qty', 'Amount']);
										$xls->setFont('A' . $i . ':E' . $i, ['bold' => true]);
										$i++;
										$description = '';
										$qty = 0;
										$tot = 0;
										foreach ($r->lines as $il) {
											if (empty($il->mdata['items'])) {
												continue;
											}
											foreach ($il->mdata['items'] as $si => $ri) {
												$xls->addRow($i++, [$ri[0], $ri[3], $ri[4], $ri[5], $ri[6]]);
												$qty += intval($ri[5]);
												$tot += floatval($ri[6]);
											}
										}
										$xls->addRow($i++, ['', 'SubTotal:', '', $qty, $r->total - $r->gst]);
										$xls->addRow($i++, ['', 'GST:', '', '', $r->gst]);
										$xls->addRow($i, ['', 'Total:', '', '', $r->total]);
										$xls->setFont('A' . $i . ':E' . $i, ['bold' => true]);
										$i++;
										$xls->addRow($i++, []);
									} else if ($r->type == 50) {
										$xls->addRow($i, ['Desc', 'GLCode', 'Qty', 'Price', 'Subtotal', 'Gst', 'Total']);
										$xls->setFont('A' . $i . ':G' . $i, ['bold' => true]);
										$i++;
										$qty = 0;
										$tot = 0;
										foreach ($r->lines as $il) {
											$xls->addRow($i++, [$il->det, $il->ccode, $il->qty, $il->amount - $il->gst, ($il->amount - $il->gst) * $il->qty, $il->gst * $il->qty, $il->amount * $il->qty]);
											$tot += ($il->amount - $il->gst) * $il->qty;
											$qty += $il->qty;
										}
										$xls->addRow($i++, ['', 'SubTotal:', '', '', '', '', $r->total - $r->gst]);
										$xls->addRow($i++, ['', 'GST:', '', '', '', '', $r->gst]);
										$xls->addRow($i, ['', 'Total:', '', '', '', '', $r->total]);
										$xls->setFont('A' . $i . ':G' . $i, ['bold' => true]);
										$i++;
										$xls->addRow($i++, []);
									} else if ($r->type == 70) {
										$xls->addRow($i, ['Task', 'Ref', 'Date', 'Desc', 'Price', 'Qty', 'Amount']);
										$xls->setFont('A' . $i . ':F' . $i, ['bold' => true]);
										$i++;
										foreach ($r->lines as $il) {
											foreach ($il->mdata['items'] as $ri) {
												$main = WmsTask::model()->find('id = :id', [':id' => str_replace('T', '', $ri[0])]);
												if (preg_match('/Delivery/', $ri[3])) {
													$task = WmsTask::model()->find('link_id = :id AND type = 2120', [':id' => str_replace('T', '', $ri[0])]);
													if (!empty($task) && !empty($task->mdata['shipment_id'])) {
														$shipments = [];
														foreach ($task->mdata['shipment_id'] as $sid) {
															$s = Shipment::model()->findByPk($sid);
															$shipments[] = $s->ref;
														}
														$xls->addRow($i++, [$ri[0], $main->ref, $ri[2], $ri[3], $ri[4], $ri[5], $ri[6], implode(', ', $shipments)]);
													} else {
														$xls->addRow($i++, [$ri[0], $main->ref, $ri[2], $ri[3], $ri[4], $ri[5], $ri[6]]);
													}
												} else {
													$xls->addRow($i++, [$ri[0], $main->ref, $ri[2], $ri[3], $ri[4], $ri[5], $ri[6]]);
												}
											}
										}
										$xls->addRow($i++, ['', 'SubTotal:', '', '', '', $r->total - $r->gst]);
										$xls->addRow($i++, ['', 'GST:', '', '', '', $r->gst]);
										$xls->addRow($i, ['', 'Total:', '', '', '', $r->total]);
										$xls->setFont('A' . $i . ':F' . $i, ['bold' => true]);
										$xls->addRow($i++, []);
									} else if ($r->type == Invoice::INVOICE_TYPE_WEIGHT_DIFF) {
										$xls->addRow($i, ['No', 'Code', 'Description', 'Amount AUD', 'Qty', 'GST', 'Sub Total']);
										$xls->setFont('A' . $i . ':G' . $i, ['bold' => true]);
										$i++;
										foreach ($r->lines as $k => $il) {
											$xls->addRow($i++, [$k + 1, (!empty($il->getCCodeTypeDesc()) ? $il->getCCodeTypeDesc() : $il->ccode), nl2br($il->det), AppHelper::money_format('%i', $il->amount - $il->gst), $il->qty, $il->getTaxType(), AppHelper::money_format('%i', ($il->amount - $il->gst) * $il->qty)]);
										}

										if ($r->gst > 0) {
											$gst = round($r->gst, 2);
											$xls->addRow($i, ['', '', '', '', '', 'Sub Total:', $r->total - $r->gst]);
											$xls->setFont('A' . $i . ':I' . $i, ['bold' => true]);
											$i++;
											//$tot += $gst;
											$xls->addRow($i, ['', '', '', '', '', 'GST 10.00%:', $r->gst]);
											$xls->setFont('A' . $i . ':I' . $i, ['bold' => true]);
											$i++;
											$xls->addRow($i, ['', '', '', '', '', 'Total:', $r->total]);
											$xls->setFont('A' . $i . ':I' . $i, ['bold' => true]);
											$i++;
										} else {
											$xls->addRow($i, ['', '', '', '', '', 'Total:', $r->total]);
											$xls->setFont('A' . $i . ':I' . $i, ['bold' => true]);
											$i++;
										}
										$xls->addRow($i++, []);
									} else {
										if ($r->type == 60) {
											$xls->addRow($i, ['Desc', 'Product', 'Units', 'Pallets', '', '', 'Amount']);
										} else if ($r->type == 40 || $r->type == 41) {
											$xls->addRow($i, ['Desc', 'Code', 'Qty', 'Amount', 'Subtotal']);
										} else {
											$xls->addRow($i, ['HBN', 'Shipper', 'Packages', 'Weight', 'Type', 'Rate', 'Amount']);
										}
										$xls->setFont('A' . $i . ':G' . $i, ['bold' => true]);
										$i++;
										$qty = 0;
										$wei = 0;
										$cbm = 0;
										$tot = 0;
										foreach ($r->lines as $il) {
											if ($r->type == 40 || $r->type == 41) {
												$xls->addRow($i++, [$il->det, $il->ccode, $il->qty, $il->amount - $il->gst, $il->qty * ($il->amount - $il->gst)]);
												$tot += ($il->amount - $il->gst) * $il->qty;
												$qty += $il->qty;
											} else {
												if (empty($il->mdata['items'])) {
													continue;
												}
												foreach ($il->mdata['items'] as $si => $ri) {
													// import has different data format with export invoice
													if ($r->type == 10) {
														// for import invoice
														$charge_wei = round(empty($ri[9]) ? $ri[3] : $ri[9], 2);
														if (preg_match('/LET\d{7}/i', $ri[0])) {
															$p = ImParcel::model()->find('ref=:ref', [':ref' => $ri[0]]);
															if (!empty($p)) {
																$ri[0] .= '(' . $p->hbn . ')';
															}
														}
														$xls->addRow($i++, [$ri[0], $ri[1], 1, $charge_wei, '', '', $ri[5]]);
														$tot += floatval($ri[5]);
														$qty++;
														$wei += $charge_wei;
													} elseif ($r->type == 37) {
														//rts invoice
														$shipment = Shipment::model()->find('hbn=:hbn', [':hbn' => trim($ri[0])]);
														if (!empty($shipment)) {
															$ri[3] = $shipment->ref;
															if (!empty($shipment->mdata['rts_org_no'])) {
																$shipment_orig = Shipment::model()->find('hbn=:hbn', [':hbn' => trim($shipment->mdata['rts_org_no'])]);
																if (isset($shipment_orig)) {
																	$ri[3] .= '//' . $shipment_orig->ref;
																}
															}
														}
														$xls->addRow($i++, [$ri[0] . '(' . $ri[3] . ')', $ri[1], 1, '', '', '', $ri[2]]);
														$wei += 0;
														$qty++;
														$tot += floatval($ri[2]);
													} elseif ($r->type == 36) {
														// for rts scan fee
														$xls->addRow($i++, [$ri[0], $ri[1], 1, '', $ri[3], $ri[2], isset($ri[4]) ? $ri[4] : '']);
														$tot += isset($ri[4]) ? floatval($ri[4]) : 0;
														$qty++;
														$wei += 0;
													} elseif ($r->type == 60) {
														$xls->addRow($i++, ['Storage', $ri[0], $ri[1], $ri[2], '', '', $ri[2] * $ri[3]]);
														$tot += floatval($ri[2]) * floatval($ri[3]);
													} else {
														// for export invoice
														$xls->addRow($i++, [$ri[0], $ri[1], 1, $ri[2], $ri[4] . '(' . (empty($ri[5]) ? '' : $ri[5]) . ')', isset($ri[6]) ? $ri[6] : '', isset($ri[7]) ? $ri[7] : '']);
														$tot += isset($ri[7]) ? floatval($ri[7]) : 0;
														$qty++;
														$wei += floatval($ri[2]);
													}
												}
											}
										}
										$xls->addRow($i++, ['', 'SubTotal:', $qty, $wei, '', '', $r->total - $r->gst]);
										$xls->addRow($i++, ['', 'GST:', '', '', '', '', $r->gst]);
										$xls->addRow($i++, ['', 'Total:', '', '', '', '', $r->total]);
										$xls->setFont('A' . $i . ':G' . $i, ['bold' => true]);
										$i++;
										$xls->addRow($i++, []);
									}
								}
							}
						}

						$xls->addRow($i++, []);
						// // 2022-11-07 gero add export with credit notes
						// $ataC = empty($_POST['wcredit']) ? 0 : Payment::orgTotalCreditAta($_POST['agent_id']);
						// if ($ataC > 0) {
						// 	$xls->addRow($i++, ['Type', 'Credit Note No.', 'Description', 'Date', 'Balance']);
						// 	$as = Payment::model()->findAll('type = 5 and status in (6,7) AND ata > 0 AND org_id = :oid', [':oid' => $_POST['agent_id']]);
						// 	foreach ($as as $a) {
						// 		$xls->addRow($i++, ['Credit',$a->no, $a->ref, $a->date,  AppHelper::money_format('%i', $a->ata)]);
						// 	}
						// }

						// $xls->addRow($i++, []);

						/////////////////////////////////////////////////////////////////////////////////////////////////////////////
						if(!empty($_POST['email']))
						{
							$td=Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR.'zipemail'.time();
							if (!file_exists($td)) {
								mkdir($td);
							}
							$file_execel=$td.DIRECTORY_SEPARATOR.'Statement_' . (empty($_POST['agent_id']) ? 'ALL' : $_POST['agent_id']) . '.xlsx';
							$xls->output($file_execel, false, false);
							$files=[$file_execel, basename($file_execel)];
							return $files;
						}

						$xls->output('Statement_' . (empty($_POST['agent_id']) ? 'ALL' : $_POST['agent_id']) . '.xlsx');
					}
				}elseif ($_POST['rptyp'] == 'xlsnew2') {
					if (empty($_POST['agent_id'])) {
						echo 'please choose an agent';
					} else {
						$date = !empty($_POST['postdate']) ? $_POST['postdate'] : date('Y-m-d');
						$fromdate = !empty($_POST['fromdate']) ? $_POST['fromdate'] : '1970-01-01';
						$i = 1;
						if (!empty($_POST['orderbydate'])) {
							$order = 'date asc, id asc';
						} else {
							$order = 'due asc, id asc';
						}
						$rs = Invoice::model()->findAll(['condition' => 'id in (select distinct id from invoice where (to_id = :org_id and status in (' . (empty($_POST['incpending']) ? '' : '1,') . '2,3,7)) and date <= :date and date >= :fromdate and total != 0 order by ' . $order . ')', 'params' => [':org_id' => $_POST['agent_id'], ':date' => $date, ':fromdate' => $fromdate], 'order' => $order]);
						$cus = [];

						foreach ($rs as $r) {
							if (!empty($_POST['wid']) && $r->dpt_id != $_POST['wid']) {
								continue;
							}
							if (!empty($_POST['suborg_id']) && (empty($r->mdata['suborg']) || $_POST['suborg_id'] != $r->mdata['suborg'])) {
								continue;
							}
							if (!empty($_POST['ex_suborg_id']) && $_POST['ex_suborg_id'] == $r->mdata['suborg']) {
								continue;
							}
							$cus[empty($_POST['wid']) ? 1 : $r->dpt_id][$r->to_id][] = $r;
						}
						if (!empty($_POST['suborg_id'])) {
							$subo = Org::model()->findByPk($_POST['suborg_id']);
						}
						foreach ($cus as $oid => $cs) {
							foreach ($cs as $cid => $rs) {
								$xls->addRow($i++, [$cid, $rs[0]->cust->name, empty($subo) ? '' : 'For sub A/C: ' . $subo->name]);
								$xls->addRow($i, ['No', 'Type', 'AWB', 'Consol', 'Date', 'Due', 'SubTotal', 'GST', 'Total', 'Paid', 'Balance', 'Currency']);
								$xls->setFont('A' . $i . ':I' . $i, ['bold' => true]);
								$i++;
								foreach (Invoice::$currencies as $currency) {
									$tots[$currency] = [0, 0, 0];
								}
								foreach ($rs as $r) {
									$paid = $r->paidBefore($date);
									if ($r->type == 10) {
										// for import invoice
										$awb = '';
										if (!empty($r->mdata['awb'])) {
											$awb = $r->mdata['awb'];
										}
										if (isset($r->lines[0]) && isset($r->lines[0]->mdata['items'])) {
											foreach ($r->lines[0]->mdata['items'] as $si => $ri) {
												// $awb = $ri[0];
												break;
											}
										}
										$xls->addRow($i++, [$r->no, $r->getType(), $awb, $r->consol->no, $r->date, ($r->type != 100 ? $r->due : $r->posted), AppHelper::number_format('%i', $r->total - $r->gst), AppHelper::number_format('%i', $r->gst), AppHelper::number_format('%i', $r->total), AppHelper::number_format('%i', $paid), AppHelper::number_format('%i', $r->total - $paid), $r->getCurrency()]);
									} else {
										$awb = '';
										if (!empty($r->mdata['awb'])) {
											$awb = $r->mdata['awb'];
										}
										if (empty($awb)) {
