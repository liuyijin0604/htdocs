	public function actionReconciliationExport($id)
	{
		$model = Reconciliation::model()->findByPk($id);
		$xls = new oExcel;
		$mfn = 'Reconciliation_detail_' . $id;
		$i = 1;
		$xls->addRow($i++, ['Ref', 'Consol', 'Invoice', 'Weight(Kg)', 'courier Cubic(M3)', "Real Chargable weight(KG)", "Our Charge Weight(KG)", 'Amount(Excl. GST)', 'Our Cost(Excl. GST)', 'Diff(Our Cost-Amount)', 'Accept Amount(Excl. GST)', 'Our Charge(Excl. GST)']);
		$xls->setFont('A1:L1', ['bold' => true]);
		$totalAmount = 0;
		$totalOurAmount = 0;
		$totalAcceptAmount = 0;
		if ($model->client_type == Reconciliation::D2Z_CLIENT || $model->client_type == Reconciliation::D2Z_DECLARE_TYPE) {
			foreach ($model->getLines() as $il) {
				$xls->addRow($i++, [$il->shipment_no, !empty($il->consol) ? $il->consol->no : "",
					$il->invoice_no, $il->weight, $il->courier_cubic, $il->getCourierToOurWeight(), $il->ourChargeWeight(), $il->getPostage(), $il->my_value, $il->getCostDiff2(), min($il->getPostage(), $il->my_value), $il->my_charge]);
				$totalAmount += $il->getPostage();
				$totalOurAmount += $il->my_value;
				$totalAcceptAmount += min($il->my_charge, $il->my_value);
			}
		} else {
			foreach ($model->getLines() as $il) {
				if ($model->client_type == Reconciliation::UBI_TYPE) {
					$xls->addRow($i++, [$il->shipment_no, !empty($il->consol) ? $il->consol->no : "",
						$il->invoice_no, $il->weight, $il->courier_cubic, $il->getCourierToOurWeight(), $il->ourChargeWeight(), $il->value - floatval(@$il->mdata["fuel_charge"]), $il->my_value, $il->getCostDiff(), min($il->value - floatval(@$il->mdata["fuel_charge"]), $il->my_value), $il->my_charge]);
					$totalAmount += $il->value - floatval(@$il->mdata["fuel_charge"]);
					$totalOurAmount += $il->getMyValue();
					$totalAcceptAmount += min($il->value - floatval(@$il->mdata["fuel_charge"]), $il->my_value);
				} else {
					if (!empty($_GET['dispute'])) {
						if ($il->shipment == 'Admin Fee') {
							continue;
						} else if (in_array($model->client_type, [Reconciliation::STARTRACK_TYPE, Reconciliation::TNT_CLIENT]) && $il->my_value * 1.05 >= $il->value && $il->value + 10 >= $il->value) {
							continue;
						} else if ($il->my_value + 1 >= $il->value) {
							continue;
						}
					}
					$xls->addRow($i++, [$il->shipment_no, !empty($il->consol) ? $il->consol->no : "",
						$il->invoice_no, $il->weight, $il->courier_cubic, $il->getCourierToOurWeight(), $il->ourChargeWeight(), $il->value, $il->getMyValue(), $il->getCostDiff(), min($il->value, $il->getMyValue()), $il->my_charge]);
					$totalAmount += $il->value;
					$totalOurAmount += $il->getMyValue();
					$totalAcceptAmount += min($il->value, $il->getMyValue());
				};
			}
		}
		$xls->addRow($i, array('Total:', '', '', '', '', '', '', $totalAmount, $totalOurAmount, $totalOurAmount - $totalAmount, $totalAcceptAmount));
		$xls->setFont('A' . $i . ':L' . $i, ['bold' => true]);
		$xls->setFont('K' . $i . ':K' . $i, ['color' => ['rgb' => 'ff0000']]);
		$xls->output($mfn . '.xlsx');
	}

