	public function actionUpdate($id)
	{
		$model = $this->loadModel($id);
		if (!empty($_POST['confirm'])) {
			if ($model->status < 2) {
				$model->status = 2;
				$model->sync_xero = 0; // need sync to xero again
				$model->prepare();
				$model->save();
				$this->ajaxResult($model, ['id']);
			}
		}
		if (isset($_POST['payment'])) {
			foreach ($_POST['payment'] as $k => $pay) {
				$pp = empty($k) ? new InvoicePayment : InvoicePayment::model()->findByPk($k);
				$pp->invid = $id;
				$pp->attributes = $pay;
				$pp->save();
			}
			$model->save();
			$this->ajaxResult($model, ['id']);
		}
		$this->render('update', ['model' => $model]);
	}

	public function actionPrint($id)
	{
		if (!empty($_GET['xls'])) {
			$this->actionDetail($id);
		} else if (!empty($_GET['inv_b'])) {
			$model = $this->loadModel($id);
			$model->exportExcelInvoiceB();
		} else {
			$model = $this->loadModel($id);
			if ($model->type != 60) {
				$d = ['inv' => $model];
				if (!empty($_GET['obh'])) {
					switch ($model->to_id) {
						case 1084:
							$d['behalf'] = 'priority';
							break;
					}
				}
				if (in_array($model->to_id, Org::$displayJobRef) && !empty($model->job->mdata['ref'])) {
					$no = $model->job->mdata['ref'];
				} else {
					$no = $model->no;
				}
				oPDF::renderPDF('invoice', $d, 1, 'Invoice_' . $no . '.pdf');
			} else {
				$ps = [];
				$f1 = tempnam(Yii::app()->basePath . "/runtime", "ivp");
				$f2 = tempnam(Yii::app()->basePath . "/runtime", "ivp");
				oPDF::renderPDF('invoice', ['inv' => $model], 2, $f1);
				oPDF::renderPDF('invoice_detail', ['inv' => $model], 2, $f2);
				$ps = [$f1, $f2];
				if ($model->to_id == 1457) {
					$f3 = tempnam(Yii::app()->basePath . "/runtime", "ivp");
					oPDF::renderPDF('stock_detail', ['inv' => $model], 2, $f3);
					$ps[] = $f3;
				}
				oPDF::mergePDF($ps, 1, true, 'Invoice_' . $model->no . '.pdf');
			}
		}
	}

