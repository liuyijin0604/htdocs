	public function actionAupostReconciliation()
	{
		$model = new AupostReconciliation('search');

		if (isset($_POST) && !empty($_POST)) {
			$inv_file = empty($_FILES['inv_file']) ? [] : $_FILES['inv_file'];
			if (empty($inv_file['tmp_name']) || !is_uploaded_file($inv_file['tmp_name'])) {
				$model->addError('id', 'Invalid Aupost Manifest File');
				$this->ajaxResult($model);
			} else {
				if (preg_match('/csv/i', $inv_file['name'])) {
					$xls = new oExcel('CSV');
					$xls->load($inv_file['tmp_name']);
					$data = $xls->getAll();
					unset($data[1]);
				} else {
					$xls = new oExcel;
					$xls->load($inv_file['tmp_name']);
					$data = $xls->getAll();
					unset($data[1]);
				}

				$errors = [];
				$predata = [];
				foreach ($data as $i => $line) {
					if (empty($line[11])) {
						unset($data[$i]);
						continue;
					}
					$predata[] = $line[11];
				}
				$errors = array_merge($errors, $this->hasAnyReconciliationLineExist($predata, 0, Reconciliation::AUPOST_TYPE));
				if (!empty($errors)) {
					$model->addError('id', implode("; ", $errors));
					$this->ajaxResult($model);
				}

				// aupost manifest file is based on shipment
				// we statistic by console
				// so split all shipment into our consol base firstly
				$consolShipments = [];
				$transaction = Yii::app()->db->beginTransaction();
				try {
					foreach ($data as $k => $line) {
						$amq = $line[11]; // AMQ number
						$postcode = $line[22]; // postcode
						$deadweight = floatval($line[40]); // for dead weight
						$weight = floatval($line[42]); // for chargeable weight column
						$value = floatval($line[53]); // actual charge amount
						$invoice_date = explode(' ', $line[3])[0];
						$article_no = $line[38];
						$manifest_no = ReconciliationLine::getManifestNo($amq);
						if (empty($manifest_no) || $manifest_no != $line[6]) {
							$manifest_no = $line[6];
						}
						if ($value <= 0) {
							continue;
						} // ignore no actual charge amount lines
						$value = round($value / 1.1, 2); // real cost ignore GST
						$org_rate_id = ImportChargeCode::SYDNEY_AUPOST_ID;
						if (preg_match("/(AMQ|333UF)\d{7}/", $amq)) {
							$org_rate_id = ImportChargeCode::SYDNEY_AUPOST_ID;
						} elseif (preg_match("/33EVH\d{7}/i", $amq)) {
							$org_rate_id = ImportChargeCode::MELBOUNE_AUPOST_ID;
						} elseif (preg_match("/33EVJ\d{7}/i", $amq)) {
							$org_rate_id = ImportChargeCode::BRISBANE_AUPOST_ID;
						} elseif (preg_match("/33A8Y\d{7}/i", $amq)) {
							$org_rate_id = ImportChargeCode::D2Z_COUNTRY_ID;
						}
						$ourRated = Shipment::getCourierCostByShipment($amq, $org_rate_id, $weight);
						$manifest_weight = $cust_check_weight = 0;
						$shipment = ImParcel::model()->find('ref = :ref', [':ref' => $amq]);
						$ourRate['consol_id'] = $shipment->consol_id;
						if (empty($shipment)) {
							$transaction->rollback();
							$model->addError('id', $amq . ' not found in the system!');
							$this->ajaxResult($model);
						}
						$our_charge_weight = floatval(isset($shipment->mdata['charge_client_weight']) ? $shipment->mdata['charge_client_weight'] : $shipment->chargeWeight());
						if (!empty($shipment)) {
							$manifest_weight = isset($shipment->mdata['manifest_weight']) ? floatval($shipment->mdata['manifest_weight']) : 0;
							$cust_check_weight = $shipment->weight;
							// save actual cost in shipment
							$manifest_weight = isset($shipment->mdata['manifest_weight']) ? floatval($shipment->mdata['manifest_weight']) : 0;
							$cust_check_weight = $shipment->weight;
							// save actual cost in shipment
							// $shipment->mdata['actual_delivery_cost'] = number_format($value, 2, '.', '');
							// aupost multi reconciliation_line for one shipment_no
							$rls = ReconciliationLine::model()->with('parent')->findAll('parent.client_type = 10 AND t.shipment_no = :ref', [':ref' => $amq]);
							$total_value = 0;
							foreach ($rls as $rl) {
								$total_value += $rl->value;
							}
							$shipment->mdata['actual_delivery_cost'] = number_format($total_value, 2, '.', '');
							$shipment->updateMeta();
							$ourcharge = $shipment->getCouiercost();
							$consoleId = $shipment->consol_id;
							if (!isset($consolShipments[$consoleId][$manifest_no])) {
								$consolShipments[$consoleId][$manifest_no] = [];
							}
							$consolShipments[$consoleId][$manifest_no][] = [$amq, $invoice_date, $postcode, $weight, $value, $ourRated, $deadweight, $ourcharge, $manifest_weight, $cust_check_weight, $our_charge_weight, $article_no, $shipment->pkg];
						}
						unset($data[$k]);
					}
					$transaction->commit();
				} catch (Exception $ex) {
					$transaction->rollback();
					Log::log2file("AupostReconciliation=>" . $ex->getMessage(), "transaction_err_log", "transaction");
					$model->addError('id', $ex->getMessage());
					$this->ajaxResult($model);
				}

				// release memory in time
				unset($data);
				// create reconciliation now
				foreach ($consolShipments as $id => $manifests) {
					$imConsole = Consol::model()->findByPk($id);
					foreach ($manifests as $manifest_no => $lines) {
						if (!empty($imConsole)) {
							// for aupost reconciliation in invoice_no field we save console no
							$recModel = AupostReconciliation::model()->find('invoice_no = :invno AND manifest_no = :manino AND client_type = 1', [':invno' => $imConsole->no, ':manino' => $manifest_no]);
							if (empty($recModel)) {
								// create reconsiliation now
								$recModel = new AupostReconciliation();
								$recModel->invoice_no = $imConsole->no;
								// $recModel->invoice_date = $imConsole->created;
								$recModel->invoice_date = oExcel::toDate($lines[0][1]);
								$recModel->manifest_no = $manifest_no;
								$recModel->invoice_total = 0; // first saved with zero will update after all lines
								$recModel->my_total = 0; // first saved with zero will update after all lines
								$recModel->client_type = 1;
								$recModel->save();
								if (!empty($recModel->getErrors())) {
									yii::log(json_encode($recModel->getErrors()), 'warning');
								}

							}
							$total = 0;
							$ourTotal = 0;
							foreach ($lines as $line) {
								$total += $line[3];
								$ourTotal += $line[5]['price'];
								$recData = ReconciliationLine::model()->with('parent')->find('parent.client_type = 1 AND t.shipment_no = :sno AND JSON_VALUE(t.meta, "$.article_no") = :an', [':sno' => $line[0], ':an' => $line[11]]);
								if (empty($recData)) {
									$recData = new ReconciliationLine();
								}
								$recData->parent_id = $recModel->id;
								$recData->invoice_no = $imConsole->no; // for aupost we use invoice_no field to save console number
								$recData->postcode = $line[2];
								$recData->shipment_no = $line[0];
								$recData->weight = number_format($line[3], 2, '.', '');
								$recData->value = number_format($line[4], 2, '.', '');
								$recData->cdeadwt = number_format($line[6], 2, '.', '');
								$recData->consol_id = $line[5]['consol_id'];
								$recData->my_value = number_format($line[5]['price'] / $line[12], 2, '.', '');
								$recData->my_charge = number_format($line[7] / $line[12], 2, '.', '');
								// if (strtotime($recModel->invoice_date) >= strtotime("2020-01-01")) {
								//     $recData->my_charge = number_format($line[7] * 1.024, 2, '.', '');
								// }
								$recData->manifest_weight = number_format($line[8] / $line[12], 2, '.', '');
								$recData->cust_check_weight = number_format($line[9] / $line[12], 2, '.', '');
								$recData->our_charge_weight = number_format($line[10] / $line[12], 2, '.', '');
								$recData->mdata['article_no'] = $line[11];
								$recData->save();
								if (!empty($recData->getErrors())) {
									yii::log(json_encode($recData->getErrors()), 'warning');
								}

							}
							// update reconciliation total now, we need to retrive all the lines, which may be upload last time.

							$recModel->invoice_total = $recModel->getInvoiceTotal();
							$recModel->my_total = $recModel->getMyTotal();
							$recModel->update(['invoice_total', 'my_total']);

							// update console related real aupost delivery cost
							if ($imConsole->owner_id != 114) {
								$imConsole->updateAupostRealCost();
							} else {
								$imConsole->updateWmsDeliveryCost(Org::ORGID_COURIER_AUPOST, $recModel->id);
							}
						} else {
							$recModel = AupostReconciliation::model()->find('invoice_no = :invno AND manifest_no = :manino', [':invno' => $manifest_no, ':manino' => $manifest_no]);
							if (empty($recModel)) {
								// create reconsiliation now
								$recModel = new AupostReconciliation();
								$recModel->invoice_no = $manifest_no;
								$recModel->invoice_date = oExcel::toDate($lines[0][1]);
								$recModel->manifest_no = $manifest_no;
								$recModel->invoice_total = 0; // first saved with zero will update after all lines
								$recModel->my_total = 0; // first saved with zero will update after all lines
								$recModel->save();
							}
							$total = 0;
							$ourTotal = 0;
							$transaction = Yii::app()->db->beginTransaction();
							try {
								foreach ($lines as $line) {
									$total += $line[3];
									$ourTotal += $line[5]['price'];
									$recData = ReconciliationLine::model()->with('parent')->find('parent.client_type = 1 AND t.shipment_no = :sno AND JSON_VALUE(t.meta, "$.article_no") = :an', [':sno' => $line[0], ':an' => $line[11]]);
									if (empty($recData)) {
										$recData = new ReconciliationLine();
									}
									$recData->parent_id = $recModel->id;
									$recData->invoice_no = $manifest_no; // for aupost we use invoice_no field to save console number
									$recData->postcode = $line[2];
									$recData->shipment_no = $line[0];
									$recData->weight = number_format($line[3], 2, '.', '');
									$recData->value = number_format($line[4], 2, '.', '');
									$recData->cdeadwt = number_format($line[6], 2, '.', '');
									$recData->consol_id = $line[5]['consol_id'];
									$recData->my_value = !empty($recData->consol_id) ? number_format($line[5]['price'], 2, '.', '') : 0;
									$recData->my_charge = number_format($line[7], 2, '.', '');
									$recData->manifest_weight = number_format($line[8], 2, '.', '');
									$recData->cust_check_weight = number_format($line[9], 2, '.', '');
									$recData->our_charge_weight = number_format($line[10], 2, '.', '');
									$recData->mdata['article_no'] = $line[11];
									$recData->save();
								}
								$transaction->commit();
							} catch (Exception $ex) {
								$transaction->rollback();
								$model->addError('id', $ex->getMessage());
								$this->ajaxResult($model);
							}
							// update reconciliation total now, we need to retrive all the lines, which may be upload last time.

							$recModel->invoice_total = $recModel->getInvoiceTotal();
							$recModel->my_total = $recModel->getMyTotal();
							$recModel->mdata['noconsol'] = 1;
							$recModel->update(['invoice_total', 'my_total', 'meta']);

							// no console warning
							$model->addError('id', 'shipments in invoice: ' . $manifest_no . ' not in console!');
						}
					}
				}
				$this->ajaxResult($model, ['id']);
			}
		}
		$this->render('reconciliation_aupost', ['model' => $model]);
	}

	public function actionAupostReconciliationRTS()
	{
		$model = new Reconciliation('search');

		if (isset($_POST) && !empty($_POST)) {
			$inv_file = empty($_FILES['inv_file']) ? [] : $_FILES['inv_file'];
			if (empty($inv_file['tmp_name']) || !is_uploaded_file($inv_file['tmp_name'])) {
				$model->addError('id', 'Invalid Aupost Manifest File');
				$this->ajaxResult($model);
			} else {
				if (preg_match('/csv/i', $inv_file['name'])) {
					$xls = new oExcel('CSV');
					$xls->load($inv_file['tmp_name']);
					$data = $xls->getAll();
					unset($data[1]);
				} else {
					$xls = new oExcel;
					$xls->load($inv_file['tmp_name']);
					$data = $xls->getAll();
					unset($data[1]);
				}

				$errors = [];
				$predata = [];
				foreach ($data as $i => $line) {
					if (!(!empty($line[1]) && preg_match('/AP/', $line[1])) && !(!empty($line[2]) && preg_match('/AMQ|333UF|33EVH|33EVJ|33A8Y/', $line[2]))) {
						unset($data[$i]);
						continue;
					}
					if (!empty($line[2]) && preg_match('/AMQ|333UF|33EVH|33EVJ|33A8Y/', $line[2])) {
						$predata[] = $line[2];
					}

				}
				$errors = array_merge($errors, $this->hasAnyReconciliationLineExist($predata, 0, 10));
				if (!empty($errors)) {
					$model->addError('id', implode("; ", $errors));
					$this->ajaxResult($model);
				}

				// aupost manifest file is based on shipment
				// we statistic by console
				// so split all shipment into our consol base firstly
				$consolShipments = [];
				$transaction = Yii::app()->db->beginTransaction();
				try {
					foreach ($data as $k => $line) {
						if (!empty($line[1]) && empty($line[2])) {
							$ap_no = $line[1];
						}

						if (!empty($line[1]) || empty($line[2])) {
							continue;
						}

						if (preg_match('/(AMQ|333UF|33EVH|33EVJ|33A8Y)(\d{7})/', $line[2], $matches)) {
							$amq = $matches[1] . $matches[2];
						} else {
							continue;
						}
						$value = floatval($line[3]); // actual charge amount
						$invoice_date = oExcel::toDate($line[5]);
						$article_no = $line[2];
						$manifest_no = $ap_no;
						$shipment = ImParcel::model()->find('ref = :ref', [':ref' => $amq]);
						if (empty($shipment)) {
							$transaction->rollback();
							$model->addError('id', $amq . ' not found in the system!');
							$this->ajaxResult($model);
						}
						if (!empty($shipment)) {
							$consoleId = $shipment->consol_id;
							if (!isset($consolShipments[$consoleId][$manifest_no])) {
								$consolShipments[$consoleId][$manifest_no] = [];
							}
							$consolShipments[$consoleId][$manifest_no][] = [$amq, $invoice_date, $shipment->postcode, 0, $value, 0, 0, 0, 0, 0, 0, $article_no, $shipment->consol_id];
						}
						unset($data[$k]);
					}
					$transaction->commit();
				} catch (Exception $ex) {
					$transaction->rollback();
					Log::log2file("AupostRTS=>" . $ex->getMessage(), "transaction_err_log", "transaction");
					$model->addError('id', $ex->getMessage());
					$this->ajaxResult($model);
				}
				// release memory in time
				unset($data);
				// create reconciliation now
				foreach ($consolShipments as $id => $manifests) {
					$imConsole = Consol::model()->findByPk($id);
					foreach ($manifests as $manifest_no => $lines) {
						if (!empty($imConsole)) {
							// for aupost reconciliation in invoice_no field we save console no
							$recModel = Reconciliation::model()->find('client_type = 10 AND invoice_no = :invno AND manifest_no = :manino', [':invno' => $imConsole->no, ':manino' => $manifest_no]);
							if (empty($recModel)) {
								// create reconsiliation now
								$recModel = new Reconciliation();
								$recModel->client_type = 10;
								$recModel->invoice_no = $imConsole->no;
								// $recModel->invoice_date = $imConsole->created;
								$recModel->invoice_date = oExcel::toDate($lines[0][1]);
								$recModel->manifest_no = $manifest_no;
								$recModel->invoice_total = 0; // first saved with zero will update after all lines
								$recModel->my_total = 0; // first saved with zero will update after all lines
								$recModel->save();
							}
							$total = 0;
							$transaction = Yii::app()->db->beginTransaction();
							try {
								foreach ($lines as $line) {
									$total += $line[3];
									$recData = ReconciliationLine::model()->with('parent')->find('parent.client_type = 10 AND t.shipment_no = :sno AND JSON_VALUE(t.meta, "$.article_no") = :an', [':sno' => $line[0], ':an' => $line[11]]);
									if (empty($recData)) {
										$recData = new ReconciliationLine();
									}
									$recData->parent_id = $recModel->id;
									$recData->invoice_no = $recModel->manifest_no; // for aupost we use invoice_no field to save console number
									$recData->postcode = $line[2];
									$recData->shipment_no = $line[0];
									$recData->weight = number_format($line[3], 2, '.', '');
									$recData->value = number_format($line[4], 2, '.', '');
									$recData->cdeadwt = number_format($line[6], 2, '.', '');
									$recData->my_value = !empty($recData->consol_id) ? number_format($line[5]['price'], 2, '.', '') : 0;
									$recData->my_charge = number_format($line[7], 2, '.', '');
									$recData->manifest_weight = number_format($line[8], 2, '.', '');
									$recData->cust_check_weight = number_format($line[9], 2, '.', '');
									$recData->our_charge_weight = number_format($line[10], 2, '.', '');
									$recData->consol_id = $line[12];
									$recData->mdata['article_no'] = $line[11];
									$recData->save();

									// trigger rts scan
									if (ShipmentScan::model()->count('pid = :pid AND type = 4', [':pid' => $shipment->id]) == 0) {
										$shipment->status = 80;
										$shipment->mdata['rts_scan_date'] = date('Y-m-d');
										$shipment->cbwf = $shipment->cbwf | 256;
										$shipment->update('status', 'meta', 'cbwf');
										ShipmentScan::genShipmentScan($shipment, 4, 1, 106);
									}
								}
								$transaction->commit();
							} catch (Exception $ex) {
								$transaction->rollback();
								$model->addError('id', $ex->getMessage());
								$this->ajaxResult($model);
							}
							// update reconciliation total now, we need to retrive all the lines, which may be upload last time.

							$recModel->invoice_total = $recModel->getInvoiceTotal();
							$recModel->my_total = $recModel->getMyTotal();
							$recModel->update(['invoice_total', 'my_total']);

							// update console related real aupost delivery cost
							if ($imConsole->owner_id != 114) {
								$imConsole->updateAupostRealCostRTS();
							} else {
								$imConsole->updateWmsRTSCost($recModel->id);
							}
						} else {
							$recModel = Reconciliation::model()->find('client_type = 10 AND invoice_no = :invno AND manifest_no = :manino', [':invno' => $manifest_no, ':manino' => $manifest_no]);
							if (empty($recModel)) {
								// create reconsiliation now
								$recModel = new Reconciliation();
								$recModel->client_type = 10;
								$recModel->invoice_no = $manifest_no;
								$recModel->invoice_date = oExcel::toDate($lines[0][1]);
								$recModel->manifest_no = $manifest_no;
								$recModel->invoice_total = 0; // first saved with zero will update after all lines
								$recModel->my_total = 0; // first saved with zero will update after all lines
								$recModel->save();
							}
							$total = 0;
							$ourTotal = 0;
							$transaction = Yii::app()->db->beginTransaction();
							try {
								foreach ($lines as $line) {
									$total += $line[3];
									$ourTotal += $line[5]['price'];
									$recData = ReconciliationLine::model()->with('parent')->find('parent.client_type = 10 AND t.shipment_no = :sno AND JSON_VALUE(t.meta, "$.article_no") = :an', [':sno' => $line[0], ':an' => $line[11]]);
									if (empty($recData)) {
										$recData = new ReconciliationLine();
									}
									$recData->parent_id = $recModel->id;
									$recData->invoice_no = $manifest_no; // for aupost we use invoice_no field to save console number
									$recData->postcode = $line[2];
									$recData->shipment_no = $line[0];
									$recData->weight = number_format($line[3], 2, '.', '');
									$recData->value = number_format($line[4], 2, '.', '');
									$recData->cdeadwt = number_format($line[6], 2, '.', '');
									$recData->consol_id = $line[5]['consol_id'];
									$recData->my_value = !empty($recData->consol_id) ? number_format($line[5]['price'], 2, '.', '') : 0;
									$recData->my_charge = number_format($line[7], 2, '.', '');
									$recData->manifest_weight = number_format($line[8], 2, '.', '');
									$recData->cust_check_weight = number_format($line[9], 2, '.', '');
									$recData->our_charge_weight = number_format($line[10], 2, '.', '');
									$recData->mdata['article_no'] = $line[11];
									$recData->save();
								}
								$transaction->commit();
							} catch (Exception $ex) {
								$transaction->rollback();
								$model->addError('id', $ex->getMessage());
								$this->ajaxResult($model);
							}
							// update reconciliation total now, we need to retrive all the lines, which may be upload last time.

							$recModel->invoice_total = $recModel->getInvoiceTotal();
							$recModel->my_total = $recModel->getMyTotal();
							$recModel->mdata['noconsol'] = 1;
							$recModel->update(['invoice_total', 'my_total', 'meta']);

							// no console warning
							$model->addError('id', 'shipments in invoice: ' . $manifest_no . ' not in console!');
						}
					}
				}
				$this->ajaxResult($model, ['id']);
			}
		}
		$this->render('reconciliation_aupost_rts', ['model' => $model]);
	}

	public function actionAupostReconciliationInvoice()
	{
		$model = new Reconciliation('search');

		if (isset($_POST) && !empty($_POST)) {
			$inv_file = empty($_FILES['inv_file']) ? [] : $_FILES['inv_file'];
			if (empty($inv_file['tmp_name']) || !is_uploaded_file($inv_file['tmp_name'])) {
				$model->addError('id', 'Invalid Aupost Invoice File');
				$this->ajaxResult($model);
			} else {
				if (preg_match('/csv/i', $inv_file['name'])) {
					$xls = new oExcel('CSV');
					$xls->load($inv_file['tmp_name']);
					$data = $xls->getAll();
					unset($data[1]);
				} else {
					$xls = new oExcel;
					$xls->load($inv_file['tmp_name']);
					$data = $xls->getAll();
					unset($data[1]);
				}

				$invoice_no = $_POST['invoice_no'];
				$invoice_date = $_POST['invoice_date'];

				// aupost manifest file is based on shipment
				// we statistic by console
				// so split all shipment into our consol base firstly
				$transaction = Yii::app()->db->beginTransaction();
				try {
					$lines = [];
					$recModel = Reconciliation::model()->find('client_type = :type AND invoice_no = :invoice_no', [':type' => Reconciliation::AUPOST_INVOICE, ':invoice_no' => $invoice_no]);
					if (empty($recModel)) {
						$recModel = new Reconciliation;
						$recModel->client_type = Reconciliation::AUPOST_INVOICE;
						$recModel->invoice_no = $_POST['invoice_no'];
						$recModel->invoice_date = $_POST['invoice_date'];
						$recModel->manifest_no = '';
						$recModel->invoice_total = 0;
						$recModel->my_total = 0;
						$recModel->flag = 0;
						$recModel->save();
					}
					foreach ($data as $k => $line) {
						$mail_no = !empty($line[10]) ? $line[10] : $line[9];
						$value = round((floatval($line[13]) - floatval($line[14])) * 100, 2) / 100; // actual charge amount
						$ref = $line[9];
						$transaction_id = $line[11];
						if (preg_match('/AP/i', $mail_no) && preg_match('/eparcel/i', $ref)) {
							// eparcel
							$recModels = Reconciliation::model()->findAll('client_type = :type AND manifest_no = :manifest_no', [':type' => Reconciliation::AUPOST_TYPE, ':manifest_no' => $mail_no]);
							$my_value = 0;
							$my_charge = 0;
							foreach ($recModels as $rec) {
								$my_value += $rec->getAcceptTotal();
								foreach ($rec->lines as $recLine) {
									$my_charge += $recLine->my_charge;
								}
							}
							$recData = ReconciliationLine::model()->find('invoice_no = :invoice_no AND shipment_no = :manifest_no AND postcode = "eParcel" AND JSON_VALUE(meta, "$.transaction_id") = :tid', [':invoice_no' => $invoice_no, ':manifest_no' => $mail_no, ':tid' => $transaction_id]);
							if (empty($recData)) {
								$recData = new ReconciliationLine;
								$recData->parent_id = $recModel->id;
								$recData->invoice_no = $invoice_no;
								$recData->shipment_no = $mail_no;
								$recData->postcode = 'eParcel';
								$recData->weight = 0;
								$recData->mdata['transaction_id'] = $transaction_id;
							}
							$recData->value = number_format($value, 2, '.', '');
							$recData->my_value = number_format($my_value, 2, '.', '');
							$recData->my_charge = number_format($my_charge, 2, '.', '');
							$recData->save();
							if (!empty($recData->getErrors())) {
								yii::log(json_encode($recData->getErrors()), 'warning');
							}
						} else if (preg_match('/AP/i', $mail_no) && preg_match('/return to sender/i', $ref)) {
							// rts
							// $recModels = Reconciliation::model()->findAll('client_type = :type AND manifest_no = :manifest_no', [':type' => Reconciliation::AUPOST_TYPE, ':manifest_no' => $mail_no]);
							$recData = ReconciliationLine::model()->find('invoice_no = :invoice_no AND shipment_no = :manifest_no AND postcode = "Return to sender" AND JSON_VALUE(meta, "$.transaction_id") = :tid', [':invoice_no' => $invoice_no, ':manifest_no' => $mail_no, ':tid' => $transaction_id]);
							if (empty($recData)) {
								$recData = new ReconciliationLine;
								$recData->parent_id = $recModel->id;
								$recData->invoice_no = $invoice_no;
								$recData->shipment_no = $mail_no;
								$recData->postcode = 'Return to sender';
								$recData->weight = 0;
								$recData->mdata['transaction_id'] = $transaction_id;
							}
							$recData->value = number_format($value, 2, '.', '');
							$recData->my_value = number_format($value, 2, '.', '');
							$recData->my_charge = 0;
							$recData->save();
							if (!empty($recData->getErrors())) {
								yii::log(json_encode($recData->getErrors()), 'warning');
							}
						} else {
							$accrual_value = 0;

							// elms
							$consol = ElmsConsol::model()->find('awb = :awb', [':awb' => $mail_no]);
							if (!empty($consol)) {
								$bl = BillingLine::model()->find('org_id = :oid AND billing_ref = :ref', [':oid' => Org::ORGID_COURIER_AUPOST, ':ref' => $consol->no]);
								$accrual_value = floatval(@$bl->accrual_amount);
							}

							// imco
							if (empty($consol)) {
								$consol = ImcoConsol::model()->find('JSON_VALUE(meta, "$.elms") = :no OR JSON_QUERY(meta, "$.elms") LIKE :no2', [':no' => $mail_no, ':no2' => '%' . $mail_no . '%']);
								if (!empty($consol)) {
									$bl = BillingLine::model()->find('(org_id = :oid1 OR (org_id = :oid2 AND `desc` LIKE "%LETTER")) AND billing_ref = :ref', [':oid1' => Org::ORGID_COURIER_AUSLETTER, ':oid2' => Org::ORGID_COURIER_AUPOST, ':ref' => $consol->no]);
									$accrual_value = floatval(@$bl->accrual_amount);
								}
							}

							if (!empty($consol)) {
								$type = 'ELMS';
							} else {
								$type = 'UNKNOWN';
							}
							$recData = ReconciliationLine::model()->find('invoice_no = :invoice_no AND shipment_no = :manifest_no AND postcode = :type AND JSON_VALUE(meta, "$.transaction_id") = :tid', [':invoice_no' => $invoice_no, ':manifest_no' => $mail_no, ':type' => $type, ':tid' => $transaction_id]);
							if (empty($recData)) {
								$recData = new ReconciliationLine;
								$recData->parent_id = $recModel->id;
								$recData->invoice_no = $invoice_no;
								$recData->shipment_no = $mail_no;
								$recData->postcode = $type;
								$recData->weight = 0;
								$recData->mdata['transaction_id'] = $transaction_id;
							}
							$recData->value = number_format($value, 2, '.', '');
							$recData->my_value = $accrual_value;
							$recData->my_charge = 0;
							$recData->save();
							if (!empty($recData->getErrors())) {
								yii::log(json_encode($recData->getErrors()), 'warning');
							}
						}
						unset($data[$k]);
					}

					// 2020-06-15
					if (!empty($_POST['invoice_amount'])) {
						$recModel->mdata['invoice_amount'] = $_POST['invoice_amount'];
						$recModel->save();
					}
					$recModel->recordInvoiceAmountDiff();
					FileRepo::storeFile($inv_file['tmp_name'], $inv_file['name'], FileRepo::COURIER_INVOICE_ATTACHMENT, $recModel->id);

					$transaction->commit();
				} catch (Exception $ex) {
					$transaction->rollback();
					Log::log2file("Aupost Invoice => " . $ex->getMessage(), "transaction_err_log", "transaction");
					$model->addError('id', $ex->getMessage());
					$this->ajaxResult($model);
				}
				// release memory in time
				unset($data);
				$this->ajaxResult($model, ['id']);
			}
		}
		$this->render('reconciliation_aupost_invoice', ['model' => $model]);
	}

	public function actionAupostReconciliationLetter()
	{
		if (empty($_FILES)) {
			$this->render('reconciliation_aupost_letter');
		} else {
			$model = new Reconciliation('search');

			$inv_file = empty($_FILES['inv_file']) ? [] : $_FILES['inv_file'];
			if (empty($inv_file['tmp_name']) || !is_uploaded_file($inv_file['tmp_name'])) {
				$model->addError('id', 'Invalid Aupost Letter File');
				$this->ajaxResult($model);
			} else {
				if (preg_match('/csv/i', $inv_file['name'])) {
					$xls = new oExcel('CSV');
					$xls->load($inv_file['tmp_name']);
					$data = $xls->getAll();
					unset($data[1]);
				} else {
					$xls = new oExcel;
					$xls->load($inv_file['tmp_name']);
					$data = $xls->getAll();
					unset($data[1]);
				}

				$errors = [];
				foreach ($data as $i => $line) {
					if (empty($line[14]) || !preg_match('/\d{8}/', $line[14]) || empty($line[9]) || preg_match('/ck/', $line[9])) {
						unset($data[$i]);
					}

				}

				$transaction = Yii::app()->db->beginTransaction();
				try {
					foreach ($data as $k => $line) {
						$consol = ImcoConsol::model()->find('no = :no', [':no' => explode('_', $line[9])[0]]);
						if (empty($consol)) {
							continue;
						}

						$consol->mdata['elms'] = $line[14];
						$consol->save();
					}
					$transaction->commit();
				} catch (Exception $ex) {
					$transaction->rollback();
					Log::log2file("AupostLetter=>" . $ex->getMessage(), "transaction_err_log", "transaction");
					$model->addError('id', $ex->getMessage());
					$this->ajaxResult($model);
				}
				$this->ajaxResult($model);
			}
		}
	}

	public function actionCreateAupostBilling($id)
	{
		$model = Reconciliation::model()->findByPk($id);
		$model->toBilling();
		$this->ajaxResult($model);
	}

	public function actionD2zReconciliation()
	{
		$model = Reconciliation::model();

		if (isset($_POST) && !empty($_POST)) {
			$file = empty($_FILES['inv_file']) ? [] : $_FILES['inv_file'];
			if (empty($_POST['invoice_issue_date']) || !preg_match("/\d{4}-\d{2}-\d{2}/", $_POST['invoice_issue_date'])) {
				$model->addError('id', 'Please input the valid issue date!');
				$this->ajaxResult($model);
			}
			if (empty($file['tmp_name']) || !is_uploaded_file($file['tmp_name'])) {
				$model->addError('id', 'Invalid template file!');
				$this->ajaxResult($model);
			} else {
				$invoice_no = $_POST['invoice_no']; //the first 8 digit of the file Name
				if (empty($invoice_no)) {
					$model->addError('id', 'Invoice No. required!');
					$this->ajaxResult($model);
				}
				$export = empty($_POST['export']) ? false : true;
				if (preg_match('/csv/i', $file['name'])) {
					$xls = new oExcel('CSV');
					$xls->load($file['tmp_name']);
				} else {
					$xls = new oExcel;
					$xls->load($file['tmp_name']);
				}
				$data = $xls->getAll();
				unset($data[1]);
				$preData = [];
				foreach ($data as $d) {
					if (empty($d[1])) {
						continue;
					}
					$preData[] = $d[1];
				}
				$errs = array_merge($this->hasAnyD2zShipmentNotExist($data, 3, $export), $this->hasAnyReconciliationLineExist($preData, $invoice_no, 3, $export));
				if (!empty($errs)) {
					if ($export) {
						$this->exportErrors($model, $errs);
					} else {
						$model->addError('id', implode("; ", $errs));
						$this->ajaxResult($model);
					}
				}
				$lines = [];
				$consol_ids = [];
				$transaction = Yii::app()->db->beginTransaction();
				try {
					foreach ($data as $d) {
						if (empty($d[1])) {
							continue;
						}
						$shipment = ImParcel::model()->find('(hbn = :hbn OR ref = :ref) AND cbwf & 32768 = 0', [':hbn' => trim($d[2]), ':ref' => substr(trim($d[1]), 0, strlen(trim($d[1])) - 11)]);
						$no = $shipment->ref;
						$invoice = $invoice_no;
						$postcode = $shipment->cnee->postcode;
						$weight = floatval($d[4]); //coureir chargeweight;
						$value = floatval(number_format($d[7] / 1.1, 3, '.', '')); //courier charge;
						$total = floatval(number_format($d[7] / 1.1, 3, '.', '')); //courier charge;
						$fuelCharge = floatval(number_format($d[6] / 1, 3, '.', '')); //courier charge;
						if ($value <= 0) {
							continue;
						}
						// $org_rate_id= ImportChargeCode::D2Z_COUNTRY_OLD;
						// if(date('Y-m-d')>'2018-08-20'){
						$d2ztype = "";
						if (isset($shipment->mdata['d2ztype'])) {
							$d2ztype = $shipment->mdata['d2ztype'];
						} else {
							$model->addError('id', 'Shipment No.' . $shipment->ref . ' have not d2ztype!');
							$this->ajaxResult($model);
						}

						$org_rate_id = @ImportChargeCode::$d2z_services["{$d2ztype}"];
						if ($org_rate_id == null) {
							$model->addError('id', 'Shipment No.' . $shipment->ref . ' have not match org_rate in d2z_services!');
							$this->ajaxResult($model);
						}

						// }
						$ourRate = Shipment::getCourierCostByShipment($no, $org_rate_id, $weight);
						$ourRate['consol_id'] = $shipment->consol_id;
						$manifest_weight = isset($shipment->mdata['manifest_weight']) ? floatval($shipment->mdata['manifest_weight']) : 0;
						$cust_check_weight = $shipment->weight;
						$our_charge_weight = floatval(isset($shipment->mdata['charge_client_weight']) ? $shipment->mdata['charge_client_weight'] : $shipment->chargeWeight());
						$shipment->mdata['actual_delivery_cost'] = number_format($total, 2, '.', '');
						$shipment->updateMeta();
						$ourcharge = !empty($shipment->mdata['charge_client_amount']) ? floatval($shipment->mdata['charge_client_amount']) : $shipment->getCouiercost();
						$consoleId = $shipment->consol_id;
						if ($consoleId > 0 && !in_array($consoleId, $consol_ids)) {
							$consol_ids[] = $consoleId;
						}
						$lines[] = [$no, '', $postcode, $weight, $value, $ourRate, 0, $ourcharge, $manifest_weight, $cust_check_weight, $our_charge_weight, 0, $total, $fuelCharge];
					}
					$transaction->commit();
				} catch (Exception $ex) {
					$transaction->rollback();
					throw $ex;
				}
				unset($data);
				unset($shipment);

				$recModel = Reconciliation::model()->find('invoice_no = :invno AND client_type=3', [':invno' => $invoice_no]);
				if (empty($recModel)) {
					// create reconsiliation now
					$recModel = new Reconciliation();
					$recModel->client_type = Reconciliation::D2Z_CLIENT;
					$recModel->invoice_no = $invoice_no;
					$recModel->invoice_date = $_POST['invoice_issue_date'];
					$recModel->invoice_total = 0; // first saved with zero will update after all lines
					$recModel->my_total = 0; // first saved with zero will update after all lines
					$recModel->save();
				}
				$total = 0;
				$ourTotal = 0;
				$transaction = Yii::app()->db->beginTransaction();
				try {
					foreach ($lines as $line) {
						$total += $line[4];
						$ourTotal += $line[5]['price'];
						$recData = ReconciliationLine::model()->find('shipment_no = :sno', [':sno' => $line[0]]);
						if (empty($recData)) {
							$recData = new ReconciliationLine();
						}
						$recData->parent_id = $recModel->id;
						$recData->invoice_no = $invoice_no; // for aupost we use invoice_no field to save console number
						$recData->postcode = $line[2];
						$recData->shipment_no = $line[0];
						$recData->weight = number_format($line[3], 2, '.', '');
						$recData->value = number_format($line[4], 2, '.', '');
						$recData->cdeadwt = number_format($line[6], 2, '.', '');
						$recData->consol_id = $line[5]['consol_id'];
						$recData->my_value = !empty($recData->consol_id) ? number_format($line[5]['price'], 2, '.', '') : 0;
						$recData->my_charge = number_format($line[7], 2, '.', '');
						$recData->manifest_weight = number_format($line[8], 2, '.', '');
						$recData->our_charge_weight = number_format($line[10], 2, '.', '');
						$recData->cust_check_weight = number_format($line[9], 2, '.', '');
						$recData->courier_cubic = number_format($line[11], 3, '.', '');
						$recData->mdata['total_invoice'] = number_format($line[12], 2, '.', '');
						$recData->mdata['fuel_charge'] = number_format($line[13], 2, '.', '');
						$recData->save();
					}
					$transaction->commit();
				} catch (Exception $ex) {
					$transaction->rollback();
					throw $ex;
				}
				// update reconciliation total now
				$recModel->invoice_total = $total;
				$recModel->my_total = $ourTotal;
				$recModel->update(['invoice_total', 'my_total']);
				foreach ($consol_ids as $cid) {
					$consol = Consol::model()->findByPk($cid);
					if (!empty($consol)) {
						$consol->updateCourierRealCost(Org::ORGID_COURIER_D2Z, "33A8Y\d{7}|ZK6\d{7}|33PET\d{7}|33PEN\d{7}|33PEH\d{7}|SJU\d{7}|33G7K\d{7}|33G7L\d{7}|33A93\d{7}");
					}
				}
			}
			$this->ajaxResult($model, ['id']);
		}
		$this->render('reconciliation_d2z');
	}

	public function actionUbiReconciliation()
	{
		$model = Reconciliation::model();

		if (empty($_POST)) {
			$this->render('reconciliation_ubi');
		} else {
			$file = empty($_FILES['inv_file']) ? [] : $_FILES['inv_file'];
			if (empty($_POST['invoice_issue_date']) || !preg_match("/\d{4}-\d{2}-\d{2}/", $_POST['invoice_issue_date'])) {
				$model->addError('id', 'Please input the valid issue date!');
				$this->ajaxResult($model);
			}
			if (empty($file['tmp_name']) || !is_uploaded_file($file['tmp_name'])) {
				$model->addError('id', 'Invalid template file!');
				$this->ajaxResult($model);
			} else {
				$invoice_no = $_POST['invoice_no'];
				if (empty($invoice_no)) {
					$model->addError('id', 'Invoice No. required!');
					$this->ajaxResult($model);
				}
				$export = empty($_POST['export']) ? false : true;
				if (preg_match('/csv/i', $file['name'])) {
					$xls = new oExcel('CSV');
					$xls->load($file['tmp_name']);
				} else {
					$xls = new oExcel;
					$xls->load($file['tmp_name']);
				}
				$data = $xls->getAll();
				unset($data[1]);
				$preData = [];
				$nos = [];
				foreach ($data as $d) {
					if (empty($d[11])) {
						continue;
					}
					$preData[] = $d[11];
					$nos[] = ['no' => $d[11]];
				}
				$errs = [];
				foreach ($this->hasAnyShipmentNotExist($nos) as $err) {
					$errs[] = ['ref' => explode(' ', $err)[0], 'description' => $err];
				}
				$errs = array_merge($errs, $this->hasAnyReconciliationLineExist($preData, $invoice_no, Reconciliation::UBI_TYPE, $export));
				if (!empty($errs)) {
					if ($export) {
						$this->exportErrors($model, $errs);
					} else {
						$model->addError('id', implode("; ", $errs));
						$this->ajaxResult($model);
					}
				}
				$lines = [];
				$consol_ids = [];
				$transaction = Yii::app()->db->beginTransaction();
				try {
					foreach ($data as $d) {
						if (empty($d[11])) {
							continue;
						}
						$shipment = ImParcel::model()->find('(ref = :ref OR hbn = :ref) AND cbwf & 32768 = 0', [':ref' => trim($d[11])]);
						if (empty($shipment)) {
							continue;
						}
						$no = $shipment->ref;
						$invoice = $invoice_no;
						$postcode = $shipment->cnee->postcode;
						$weight = floatval($d[39]); //coureir chargeweight;
						$ddweight = floatval($d[41]);
						$value = number_format(floatval($d[55]), 3, '.', ''); //courier charge;
						$total = number_format(floatval($d[55]), 3, '.', ''); //courier charge;
						$fuelCharge = number_format(floatval($d[54]), 3, '.', ''); //courier charge;
						if ($value <= 0) {
							continue;
						}
						if (preg_match('/UBI - (\w{3}) Trucking/', $d[4], $matches)) {
							$ubitype = strtolower($matches[1]);
						} else {
							$model->addError('id', 'Shipment No.' . $shipment->ref . ' have not ubitype!');
							$this->ajaxResult($model);
						}

						$org_rate_id = @ImportChargeCode::$ubi_services["{$ubitype}"];
						if ($org_rate_id == null) {
							$model->addError('id', 'Shipment No.' . $shipment->ref . ' have not match org_rate in ubi_services!');
							$this->ajaxResult($model);
						}

						$ourRate = Shipment::getCourierCostByShipment($no, $org_rate_id, $weight);
						$ourRate['consol_id'] = $shipment->consol_id;
						$manifest_weight = isset($shipment->mdata['manifest_weight']) ? floatval($shipment->mdata['manifest_weight']) : 0;
						$cust_check_weight = $shipment->weight;
						$our_charge_weight = floatval(isset($shipment->mdata['charge_client_weight']) ? $shipment->mdata['charge_client_weight'] : $shipment->chargeWeight());
						$shipment->mdata['actual_delivery_cost'] = number_format($total, 2, '.', '');
						$shipment->updateMeta();
						$ourcharge = !empty($shipment->mdata['charge_client_amount']) ? floatval($shipment->mdata['charge_client_amount']) : $shipment->getCouiercost();
						$consoleId = $shipment->consol_id;
						if ($consoleId > 0 && !in_array($consoleId, $consol_ids)) {
							$consol_ids[] = $consoleId;
						}
						$lines[] = [$no, '', $postcode, $weight, $value, $ourRate, $ddweight, $ourcharge, $manifest_weight, $cust_check_weight, $our_charge_weight, 0, $total, $fuelCharge];
					}
					$transaction->commit();
				} catch (Exception $ex) {
					$transaction->rollback();
					throw $ex;
				}
				unset($data);
				unset($shipment);

				$recModel = Reconciliation::model()->find('invoice_no = :invno AND client_type = :type', [':invno' => $invoice_no, ':type' => Reconciliation::UBI_TYPE]);
				if (empty($recModel)) {
					// create reconsiliation now
					$recModel = new Reconciliation();
					$recModel->client_type = Reconciliation::UBI_TYPE;
					$recModel->invoice_no = $invoice_no;
					$recModel->invoice_date = $_POST['invoice_issue_date'];
					$recModel->invoice_total = 0; // first saved with zero will update after all lines
					$recModel->my_total = 0; // first saved with zero will update after all lines
					$recModel->save();
				}
				$total = 0;
				$ourTotal = 0;
				$transaction = Yii::app()->db->beginTransaction();
				try {
					foreach ($lines as $line) {
						$total += $line[4];
						$ourTotal += $line[5]['price'];
						$recData = ReconciliationLine::model()->find('shipment_no = :sno AND invoice_no = :no', [':sno' => $line[0], ':no' => $invoice_no]);
						if (empty($recData)) {
							$recData = new ReconciliationLine();
						}
						$recData->parent_id = $recModel->id;
						$recData->invoice_no = $invoice_no; // for aupost we use invoice_no field to save console number
						$recData->postcode = $line[2];
						$recData->shipment_no = $line[0];
						$recData->weight = number_format($line[3], 2, '.', '');
						$recData->value = number_format($line[4], 2, '.', '');
						$recData->cdeadwt = number_format($line[6], 2, '.', '');
						$recData->consol_id = $line[5]['consol_id'];
						$recData->my_value = !empty($recData->consol_id) ? number_format($line[5]['price'], 2, '.', '') : 0;
						$recData->my_charge = number_format($line[7], 2, '.', '');
						$recData->manifest_weight = number_format($line[8], 2, '.', '');
						$recData->our_charge_weight = number_format($line[10], 2, '.', '');
						$recData->cust_check_weight = number_format($line[9], 2, '.', '');
						$recData->courier_cubic = number_format($line[11], 3, '.', '');
						$recData->mdata['total_invoice'] = number_format($line[12], 2, '.', '');
						$recData->mdata['fuel_charge'] = number_format($line[13], 2, '.', '');
						$recData->save();
					}
					$transaction->commit();
				} catch (Exception $ex) {
					$transaction->rollback();
					throw $ex;
				}
				// update reconciliation total now
				$recModel->invoice_total = $total;
				$recModel->my_total = $ourTotal;
				$recModel->update(['invoice_total', 'my_total']);
				foreach ($consol_ids as $cid) {
					$consol = Consol::model()->findByPk($cid);
					if (!empty($consol)) {
						$consol->updateCourierRealCost(Org::ORGID_COURIER_UBI, "33A8Y\d{7}|ZK6\d{7}|33PET\d{7}|33PEN\d{7}|33PEH\d{7}|SJU\d{7}|33G7K\d{7}|33G7L\d{7}|33A93\d{7}|33G7P\d{7}|33G7M\d{7}");

						// delete dup
						$dups = BillingLine::model()->findAll('billing_ref = :ref AND billing_ref = billing_cref AND org_id = :org AND actual_amount = 0', [':ref' => $consol->no, ':org' => Org::ORGID_COURIER_UBI]);
						foreach ($dups as $dup) {
							$dup->status = 11;
							$dup->mdata['ubi_acr'] = true;
							$dup->update('status', 'meta');
						}

						$dups = BillingLine::model()->findAll('billing_ref = :ref AND billing_cref = :cref AND org_id = :org AND `desc` NOT LIKE "%rts%"', [':ref' => $consol->no, ':cref' => $invoice_no, ':org' => Org::ORGID_COURIER_UBI]);
						if (sizeof($dups) > 1) {
							foreach ($dups as $k => $dup) {
								if ($k == 0) {
									continue;
								}

								$dup->status = 11;
								$dup->mdata['ubi_dup'] = true;
								$dup->update('status', 'meta');
							}
						}
					}
				}
			}
			$this->ajaxResult($model, ['id']);
		}
	}

	public function actionUbiReconciliationRTS()
	{
		$model = Reconciliation::model();

		if (empty($_POST)) {
			$this->render('reconciliation_ubi_rts');
		} else {
			$file = empty($_FILES['inv_file']) ? [] : $_FILES['inv_file'];
			if (empty($_POST['invoice_issue_date']) || !preg_match("/\d{4}-\d{2}-\d{2}/", $_POST['invoice_issue_date'])) {
				$model->addError('id', 'Please input the valid issue date!');
				$this->ajaxResult($model);
			}
			if (empty($_POST['invoice_no'])) {
				$model->addError('id', 'Invoice No. required!');
				$this->ajaxResult($model);
			}
			if (empty($file['tmp_name']) || !is_uploaded_file($file['tmp_name'])) {
				$model->addError('id', 'Invalid template file!');
				$this->ajaxResult($model);
			}

			$invoice_no = $_POST['invoice_no'];
			$invoice_date = $_POST['invoice_issue_date'];

			$export = empty($_POST['export']) ? false : true;
			if (preg_match('/csv/i', $file['name'])) {
				$xls = new oExcel('CSV');
				$xls->load($file['tmp_name']);
			} else {
				$xls = new oExcel;
				$xls->load($file['tmp_name']);
			}
			$data = $xls->getAll();
			unset($data[1]);
			$nos = [];
			foreach ($data as $d) {
				if (empty($d[1])) {
					continue;
				}

				$nos = ['no' => substr($d[1], 0, 12)];
			}
			$errs = [];
			foreach ($this->hasAnyShipmentNotExist($nos) as $err) {
				$errs[] = ['ref' => explode(' ', $err)[0], 'description' => $err];
			}
			if (!empty($errs)) {
				if ($export) {
					$this->exportErrors($model, $errs);
				} else {
					$model->addError('id', implode("; ", $errs));
					$this->ajaxResult($model);
				}
			}
			$lines = [];
			$transaction = Yii::app()->db->beginTransaction();
			try {
				foreach ($data as $d) {
					if (empty($d[1])) {
						continue;
					}

					$shipment = ImParcel::model()->find('ref = :ref AND cbwf & 32768 = 0', [':ref' => substr($d[1], 0, 12)]);
					$no = $shipment->ref;
					$invoice = $invoice_no;
					$postcode = $shipment->cnee->postcode;
					$value = floatval(number_format($d[4], 3, '.', '')); //courier charge;
					$total = floatval(number_format($d[6], 3, '.', '')); //courier charge;
					$fuelCharge = floatval(number_format($d[5], 3, '.', '')); //courier charge;
					if ($value <= 0) {
						continue;
					}

					$lines[] = [$no, '', $postcode, '', $value, $total, $fuelCharge];
				}
				$transaction->commit();
			} catch (Exception $ex) {
				$transaction->rollback();
				throw $ex;
			}
			unset($data);

			$recModel = Reconciliation::model()->find('invoice_no = :invno AND client_type = :type', [':invno' => $invoice_no, ':type' => Reconciliation::UBI_RTS]);
			if (empty($recModel)) {
				// create reconsiliation now
				$recModel = new Reconciliation();
				$recModel->client_type = Reconciliation::UBI_RTS;
				$recModel->invoice_no = $invoice_no;
				$recModel->invoice_date = $invoice_date;
				$recModel->invoice_total = 0; // first saved with zero will update after all lines
				$recModel->my_total = 0; // first saved with zero will update after all lines
				$recModel->save();
			}
			$total = 0;
			$ourTotal = 0;
			$transaction = Yii::app()->db->beginTransaction();
			try {
				$consol_ids = [];
				foreach ($lines as $line) {
					$total += $line[4];
					$ourTotal += $line[4];
					$recData = ReconciliationLine::model()->find('shipment_no = :sno AND invoice_no = :no', [':sno' => $line[0], ':no' => $invoice_no]);
					$shipment = ImParcel::model()->find('hbn = :ref OR ref = :ref', [':ref' => $line[0]]);
					if (empty($recData)) {
						$recData = new ReconciliationLine();
					}
					$recData->parent_id = $recModel->id;
					$recData->invoice_no = $invoice_no; // for aupost we use invoice_no field to save console number
					$recData->postcode = $line[2];
					$recData->shipment_no = $line[0];
					$recData->weight = 0;
					$recData->value = number_format($line[4], 2, '.', '');
					$recData->cdeadwt = 0;
					$recData->my_value = number_format($line[4], 2, '.', '');
					$recData->my_charge = 10;
					$recData->manifest_weight = 0;
					$recData->our_charge_weight = 0;
					$recData->cust_check_weight = 0;
					$recData->courier_cubic = 0;
					$recData->consol_id = $shipment->consol_id;
					$recData->mdata['total_invoice'] = number_format($line[5], 2, '.', '');
					$recData->mdata['fuel_charge'] = number_format($line[6], 2, '.', '');
					$recData->save();
					$consol_ids[$shipment->consol_id][] = $recData;

					// trigger rts scan
					if (InvLine::model()->with('invoice')->together(true)->count('model = :m AND fid = :fid AND invoice.type = 36 AND invoice.status < 10', [':m' => 'ImParcel', ':fid' => $shipment->id]) == 0) {
						$shipment->status = 80;
						$shipment->mdata['rts_scan_date'] = date('Y-m-d');
						$shipment->cbwf = $shipment->cbwf | 256;
						$shipment->update('status', 'meta', 'cbwf');
						ShipmentScan::genShipmentScan($shipment, 4, 1, 106);
					}
				}
				$transaction->commit();
			} catch (Exception $ex) {
				$transaction->rollback();
				throw $ex;
			}
			// update reconciliation total now
			$recModel->invoice_total = $total;
			$recModel->my_total = $ourTotal;
			$recModel->update(['invoice_total', 'my_total']);
			foreach ($consol_ids as $cid => $lines) {
				$consol = Consol::model()->findByPk($cid);
				if (empty($consol)) {
					continue;
				}

				$total = 0;
				$fuel = 0;
				foreach ($lines as $line) {
					if (!empty($line->mdata['rts_bl_id'])) {
						continue;
					}

					$total += $line->value;
				}
				foreach ($lines as $line) {
					if (!empty($line->mdata['fuel_bl_id'])) {
						continue;
					}

					$fuel += floatval(@$line->mdata['fuel_charge']);
				}

				if (!empty($total)) {
					$bl = new BillingLine;
					$bl->status = 1; // initial pending status
					$bl->link_id = 0;
					$bl->org_id = Org::ORGID_COURIER_UBI;
					$bl->charge_code = Consol::AU_LOCAL_DELIVERY_COST_GL_CODE;
					$bl->billing_cref = $invoice_no;
					$bl->currency = 1; // AUD default
					$bl->weight = 0;
					$bl->charge_weight = 0;
					$bl->billing_ref = $consol->no;
					$bl->awb = $consol->awb;
					$bl->dpt_id = empty($consol->dpt_id) ? Org::PCAE_DEPARTMENT_SYDNEY : $consol->dpt_id;
					$bl->date = $invoice_date;
					$bl->created = $invoice_date;
					$bl->transaction_date = $invoice_date;
					$bl->due = $invoice_date;
					$bl->type = BillingLine::BILLING_TYPE_IMPORT; // for import type
					$bl->dpmt = Invoice::DPMT_IMPORT;
					$bl->actual_amount = number_format(round($total, 2), 2, '.', '');
					$bl->gst = 'INPUT';
					$bl->gst_amount = $bl->getGSTValue();
					$bl->desc = 'rts';
					$bl->accrual_amount = 0;
					$bl->save();

					Billing::linkLine($bl, false);

					foreach ($lines as $line) {
						if (!empty($line->mdata['rts_bl_id'])) {
							continue;
						}

						$line->mdata['rts_bl_id'] = $bl->id;
						$line->save();
					}
				}

				if (!empty($fuel)) {
					$bl = new BillingLine;
					$bl->status = 1; // initial pending status
					$bl->link_id = 0;
					$bl->org_id = Org::ORGID_COURIER_UBI;
					$bl->charge_code = Consol::AU_LOCAL_DELIVERY_COST_GL_CODE;
					$bl->billing_cref = $invoice_no;
					$bl->currency = 1; // AUD default
					$bl->weight = 0;
					$bl->charge_weight = 0;
					$bl->billing_ref = $consol->no;
					$bl->awb = $consol->awb;
					$bl->dpt_id = empty($consol->dpt_id) ? Org::PCAE_DEPARTMENT_SYDNEY : $consol->dpt_id;
					$bl->date = $invoice_date;
					$bl->created = $invoice_date;
					$bl->transaction_date = $invoice_date;
					$bl->due = $invoice_date;
					$bl->type = BillingLine::BILLING_TYPE_IMPORT; // for import type
					$bl->dpmt = Invoice::DPMT_IMPORT;
					$bl->actual_amount = number_format(round($fuel, 2), 2, '.', '');
					$bl->gst = 'INPUT';
					$bl->gst_amount = $bl->getGSTValue();
					$bl->desc = 'rts fuel';
					$bl->accrual_amount = 0;
					$bl->save();

					Billing::linkLine($bl, false);

					foreach ($lines as $line) {
						if (!empty($line->mdata['fuel_bl_id'])) {
							continue;
						}

						$line->mdata['fuel_bl_id'] = $bl->id;
						$line->save();
					}
				}
			}
			$this->ajaxResult($model);
		}
	}

	public function actionTntReconciliation()
	{
		$model = Reconciliation::model();
		if (isset($_POST) && !empty($_POST)) {
			if (empty($_POST['invoice_issue_date'])) {
				$model->addError('Need Invoice Date', 'Need Invoice Date!');
				$this->ajaxResult($model);
			}

			$file = empty($_FILES['inv_file']) ? [] : $_FILES['inv_file'];
			if (empty($file['tmp_name']) || !is_uploaded_file($file['tmp_name'])) {
				$model->addError('id', 'Invalid template file!');
				$this->ajaxResult($model);
			} else {
				if (preg_match('/csv/i', $file['name'])) {
					$xls = new oExcel('CSV');
				} else {
					$xls = new oExcel;
				}
				$xls->load($file['tmp_name']);
				$data = $xls->getAll();
				unset($data[1]);
				//get invoice no and date to check
				$tempDate = $_POST['invoice_issue_date'];
				$tempDate = oExcel::toDate($tempDate);
				$invoice_date = $tempDate;
				$invoice_no = isset($data[2][6]) ? $data[2][6] : '';
				if (empty($invoice_no)) {
					$model->addError('id', 'Invoice No. not found in the file!');
					$this->ajaxResult($model);
				}
				if (empty($invoice_date)) {
					$model->addError('id', 'Invoice date not found in the file!');
					$this->ajaxResult($model);
				}
				//prepare data hasAnyShipmentNotExist function
				$preParedData = $this->prepareTntData($data);
				unset($data);
				$errors = $this->hasAnyShipmentNotExist($preParedData);
				$refCollection = [];
				//prepare data for hasAnyReconciliationLineExist function
				foreach ($preParedData as $temp) {
					if (empty($temp['no'])) {
						continue;
					}

					$refCollection[] = $temp['no'];
				}
				$errors = array_merge($errors, $this->hasAnyReconciliationLineExist($refCollection));
				if (!empty($errors)) {
					$model->addError('id', implode("; ", $errors));
					$this->ajaxResult($model);
				}
				$lines = [];
				$consol_ids = [];
				$transaction = Yii::app()->db->beginTransaction();
				try {
					foreach ($preParedData as $d) {
						$shipment = ImParcel::model()->find('ref=:ref', [':ref' => $d['no']]);
						$no = trim($d['no']);
						$invoice = $invoice_no;
						$postcode = $shipment->cnee->postcode;
						$weight = $d['chargeweight']; //coureir chargeweight;
						$cubic = $d['cubic'];
						$value = $d['charge']; //courier charge;
						if ($value <= 0) {
							continue;
						}
						$org_rate_id = ImportChargeCode::TNT_SYDNEY_ID;
						if (preg_match("/PCD\d{9}/", $no)) {
							$org_rate_id = ImportChargeCode::TNT_MELBOURNE_ID;
						}
						$ourRate = Shipment::getCourierCostByShipment($no, $org_rate_id, $weight);
						$ourRate['consol_id'] = $shipment->consol_id;
						$manifest_weight = isset($shipment->mdata['manifest_weight']) ? floatval($shipment->mdata['manifest_weight']) : 0;
						$cust_check_weight = $shipment->weight;
						$our_charge_weight = floatval(isset($shipment->mdata['charge_client_weight']) ? $shipment->mdata['charge_client_weight'] : $shipment->chargeWeight());
						$shipment->mdata['actual_delivery_cost'] = number_format($value, 2, '.', '');
						$shipment->updateMeta();
						$ourcharge = !empty($shipment->mdata['charge_client_amount']) ? floatval($shipment->mdata['charge_client_amount']) : $shipment->getCouiercost();
						$consoleId = $shipment->consol_id;
						if (!in_array($consoleId, $consol_ids)) {
							$consol_ids[] = $consoleId;
						}
						$lines[] = [$no, '', $postcode, $weight, $value, $ourRate, 0, $ourcharge, $manifest_weight, $cust_check_weight, $our_charge_weight, $cubic];
					}
					$transaction->commit();
				} catch (Exception $ex) {
					$transaction->rollback();
					throw $ex;
				}
				unset($preParedData);
				$recModel = Reconciliation::model()->find('invoice_no = :invno AND client_type=4', [':invno' => $invoice_no]);
				if (empty($recModel)) {
					// create reconsiliation now
					$recModel = new Reconciliation();
					$recModel->client_type = 4;
					$recModel->invoice_no = $invoice_no;
					$recModel->invoice_date = $invoice_date;
					$recModel->invoice_total = 0; // first saved with zero will update after all lines
					$recModel->my_total = 0; // first saved with zero will update after all lines
					$recModel->save();
				}
				$total = 0;
				$ourTotal = 0;
				$transaction = Yii::app()->db->beginTransaction();
				try {
					foreach ($lines as $line) {
						$total += $line[4];
						$ourTotal += $line[5]['price'];
						$recData = ReconciliationLine::model()->find('shipment_no = :sno', [':sno' => $line[0]]);
						if (empty($recData)) {
							$recData = new ReconciliationLine();
						}
						$recData->parent_id = $recModel->id;
						$recData->invoice_no = $invoice_no; // for aupost we use invoice_no field to save console number
						$recData->postcode = $line[2];
						$recData->shipment_no = $line[0];
						$recData->weight = number_format($line[3], 2, '.', '');
						$recData->value = number_format($line[4], 2, '.', '');
						$recData->cdeadwt = number_format($line[6], 2, '.', '');
						$recData->consol_id = $line[5]['consol_id'];
						$recData->my_value = !empty($recData->consol_id) ? number_format($line[5]['price'], 2, '.', '') : 0;
						$recData->my_charge = number_format($line[7], 2, '.', '');
						$recData->manifest_weight = number_format($line[8], 2, '.', '');
						$recData->our_charge_weight = number_format($line[10], 2, '.', '');
						$recData->cust_check_weight = number_format($line[9], 2, '.', '');
						$recData->courier_cubic = number_format($line[11], 3, '.', '');
						$recData->save();
					}
					$transaction->commit();
				} catch (Exception $ex) {
					$transaction->rollback();
					throw $ex;
				}
				// update reconciliation total now
				$recModel->invoice_total = $total;
				$recModel->my_total = $ourTotal;
				$recModel->update(['invoice_total', 'my_total']);
				foreach ($consol_ids as $cid) {
					$consol = Consol::model()->findByPk($cid);
					if (!empty($consol)) {
						$consol->updateCourierRealCost(Org::ORGID_COURIER_TNT, '(DKC|PCD|BPC)\d{9}');
					}
				}
			}
			$this->ajaxResult($model, ['id']);
		}
		$this->render('reconciliation_tnt');
	}

	public function actionTntReconciliationNew()
	{
		$model = Reconciliation::model();
		if (isset($_POST) && !empty($_POST)) {
			if (empty($_POST['invoice_issue_date'])) {
				$model->addError('Need Invoice Date', 'Need Invoice Date!');
				$this->ajaxResult($model);
			}

			$file = empty($_FILES['inv_file']) ? [] : $_FILES['inv_file'];
			if (empty($file['tmp_name']) || !is_uploaded_file($file['tmp_name'])) {
				$model->addError('id', 'Invalid template file!');
				$this->ajaxResult($model);
			} else {
				if (preg_match('/csv/i', $file['name'])) {
					$xls = new oExcel('CSV');
				} else {
					$xls = new oExcel;
				}
				$xls->load($file['tmp_name']);
				foreach ($xls->xls->getAllSheets() as $k => $sheet) {
					$xls->goSheet($k);
					if ($k == 0) {
						$data['shipment'] = $xls->getAll();
					}

					if ($k == 1) {
						$data['other'] = $xls->getAll();
					}

				}

				if (empty($data['shipment']) || empty($data['other'])) {
					$model->addError('id', 'Invalid template file');
					$this->ajaxResult($model);
				}

				//get invoice no and date to check
				$tempDate = $_POST['invoice_issue_date'];
				$tempDate = oExcel::toDate($tempDate);
				$invoice_date = $tempDate;
				if (empty($_POST['invoice_no'])) {
					$model->addError('id', 'Invoice No. is empty!');
					$this->ajaxResult($model);
				}
				$invoice_no = $_POST['invoice_no'];
				if (empty($invoice_date)) {
					$model->addError('id', 'Invoice date is empty!');
					$this->ajaxResult($model);
				}

				$model = Reconciliation::model()->find('invoice_no = :invno AND client_type = 4', [':invno' => $invoice_no]);
				if (empty($model)) {
					// create reconsiliation now
					$model = new Reconciliation();
					$model->client_type = 4;
					$model->invoice_no = $invoice_no;
					$model->invoice_date = $invoice_date;
					$model->invoice_total = 0; // first saved with zero will update after all lines
					$model->my_total = 0; // first saved with zero will update after all lines
					$model->save();
				}

				$errors = [];
				$this->_TntReconciliationShipment($data['shipment'], $model, $errors);
				$this->_TntReconciliationOther($data['other'], $model, $errors);

				// 2020-06-15
				if (!empty($_POST['invoice_amount'])) {
					$model->mdata['invoice_amount'] = $_POST['invoice_amount'];
					$model->save();
				}
				$model->recordInvoiceAmountDiff();
				FileRepo::storeFile($file['tmp_name'], $file['name'], FileRepo::COURIER_INVOICE_ATTACHMENT, $model->id);
			}
			foreach ($errors as $error) {
				$model->addError('id', $error);
			}
			$this->ajaxResult($model);
		}
		$this->render('reconciliation_tnt');
	}

	private function _TntReconciliationShipment($data, &$model, $errors)
	{
		unset($data[1]);
		//prepare data hasAnyShipmentNotExist function
		$preParedData = $this->prepareTntDataNew($data);
		unset($data);
		$refCollection = [];
		//prepare data for hasAnyReconciliationLineExist function
		foreach ($preParedData as $temp) {
			if (empty($temp['no'])) {
				continue;
			}
			$refCollection[] = $temp['no'];
		}
		$lines = [];
		$consol_ids = [];
		$transaction = Yii::app()->db->beginTransaction();
		try {
			foreach ($preParedData as $d) {
				$shipment = ImParcel::model()->find('ref=:ref', [':ref' => $d['no']]);
				$no = trim($d['no']);
				// $postcode = $shipment->cnee->postcode;
				$weight = $d['chargeweight']; //coureir chargeweight;
				$cubic = $d['cubic'];
				$value = $d['charge']; //courier charge;
				$fuel = $d['fuel'];
				if (empty($shipment)) {
					$lines[] = [$no, '', 0, $weight, $value, 0, 0, 0, 0, 0, 0, $cubic, $fuel];
					continue;
				}
				if ($value <= 0) {
					continue;
				}
				$org_rate_id = ImportChargeCode::TNT_SYDNEY_ID;
				if (preg_match('/PCD\d{9}/', $no)) {
					$org_rate_id = ImportChargeCode::TNT_MELBOURNE_ID;
				} else if (preg_match('/BPC\d{9}/', $no)) {
					$org_rate_id = ImportChargeCode::TNT_BRISBANE_ID;
				}
				$postcode = $shipment->cnee->postcode;
				$ourRate = Shipment::getCourierCostByShipment($no, $org_rate_id, $weight);
				$ourRate['consol_id'] = $shipment->consol_id;
				$manifest_weight = isset($shipment->mdata['manifest_weight']) ? floatval($shipment->mdata['manifest_weight']) : 0;
				$cust_check_weight = $shipment->weight;
				$our_charge_weight = floatval(isset($shipment->mdata['charge_client_weight']) ? $shipment->mdata['charge_client_weight'] : $shipment->chargeWeight());
				$shipment->mdata['actual_delivery_cost'] = number_format($value, 2, '.', '');
				$shipment->updateMeta();
				$ourcharge = !empty($shipment->mdata['charge_client_amount']) ? floatval($shipment->mdata['charge_client_amount']) : $shipment->getCouiercost();
				$consoleId = $shipment->consol_id;
				if (!in_array($consoleId, $consol_ids)) {
					$consol_ids[] = $consoleId;
				}
				$lines[] = [$no, '', $postcode, $weight, $value, $ourRate, 0, $ourcharge, $manifest_weight, $cust_check_weight, $our_charge_weight, $cubic, $fuel];
			}
			$transaction->commit();
		} catch (Exception $ex) {
			$transaction->rollback();
			$model->addError('id', 'Import Error');
			$this->ajaxResult($model);
		}
		unset($preParedData);
		$total = 0;
		$ourTotal = 0;
		$transaction = Yii::app()->db->beginTransaction();
		try {
			foreach ($lines as $line) {
				$recData = ReconciliationLine::model()->find('shipment_no = :sno AND JSON_VALUE(meta, "$.tnt_type") = "Shipment"', [':sno' => $line[0]]);
				if (!empty($recData)) {
					$errors[] = $line[0] . '(Shipment) is duplicated in ' . $recData->invoice_no;
				} else {
					$total += $line[4];
					$ourTotal += $line[5]['price'];

					$recData = new ReconciliationLine();
					$recData->parent_id = $model->id;
					$recData->invoice_no = $model->invoice_no; // for aupost we use invoice_no field to save console number
					$recData->postcode = intval($line[2]);
					$recData->shipment_no = $line[0];
					$recData->weight = number_format($line[3], 2, '.', '');
					$recData->value = number_format($line[4], 2, '.', '');
					$recData->cdeadwt = number_format($line[6], 2, '.', '');
					$recData->consol_id = $line[5]['consol_id'];
					$recData->my_value = !empty($recData->consol_id) ? number_format($line[5]['price'], 2, '.', '') : 0;
					$recData->my_charge = number_format($line[7], 2, '.', '');
					$recData->manifest_weight = number_format($line[8], 2, '.', '');
					$recData->our_charge_weight = number_format($line[10], 2, '.', '');
					$recData->cust_check_weight = number_format($line[9], 2, '.', '');
					$recData->courier_cubic = number_format($line[11], 3, '.', '');
					$recData->mdata['tnt_type'] = 'Shipment';
					$recData->save();
				}

				$recData = ReconciliationLine::model()->find('shipment_no = :sno AND JSON_VALUE(meta, "$.tnt_type") = "Fuel"', [':sno' => $line[0]]);
				if (!empty($recData)) {
					$errors[] = $line[0] . '(Fuel) is duplicated in ' . $recData->invoice_no;
				} else {
					$total += $line[12];
					$ourTotal += $line[12];

					$recData = new ReconciliationLine();
					$recData->parent_id = $model->id;
					$recData->invoice_no = $model->invoice_no; // for aupost we use invoice_no field to save console number
					$recData->postcode = intval($line[2]);
					$recData->shipment_no = $line[0];
					$recData->weight = number_format($line[3], 2, '.', '');
					$recData->value = number_format($line[12], 2, '.', '');
					$recData->cdeadwt = number_format($line[6], 2, '.', '');
					$recData->consol_id = $line[5]['consol_id'];
					$recData->my_value = !empty($recData->consol_id) ? number_format($line[12], 2, '.', '') : 0;
					$recData->my_charge = number_format(0, 2, '.', '');
					$recData->manifest_weight = number_format($line[8], 2, '.', '');
					$recData->our_charge_weight = number_format($line[10], 2, '.', '');
					$recData->cust_check_weight = number_format($line[9], 2, '.', '');
					$recData->courier_cubic = number_format($line[11], 3, '.', '');
					$recData->mdata['tnt_type'] = 'Fuel';
					$recData->save();
				}
			}
			$transaction->commit();
		} catch (Exception $ex) {
			$transaction->rollback();
			$model->addError('id', 'Import Error');
			$this->ajaxResult($model);
		}
		// update reconciliation total now
		$model->invoice_total = $total;
		$model->my_total = $ourTotal;
		$model->update(['invoice_total', 'my_total']);
		foreach ($consol_ids as $cid) {
			$consol = Consol::model()->findByPk($cid);
			if (!empty($consol)) {
				if ($consol->owner_id != 114) {
					$consol->updateTntRealCost(Org::ORGID_COURIER_TNT, '(DKC|PCD|BPC)\d{9}', $model->id);
				} else {
					$consol->updateWmsDeliveryCost(Org::ORGID_COURIER_TNT, $model->id);
				}
			}
		}
	}

	private function _TntReconciliationOther($data, &$model, &$errors)
	{
		unset($data[1]);
		$total = 0;
		$ourTotal = 0;
		$transaction = Yii::app()->db->beginTransaction();
		try {
			foreach ($data as $line) {
				$shipment = ImParcel::model()->find('ref = :ref', [':ref' => $line[1]]);
				$otherLine = ReconciliationLine::model()->find('shipment_no = :no', [':no' => $line[1]]);
				$recLine = ReconciliationLine::model()->find('shipment_no = :no AND JSON_VALUE(meta, "$.tnt_type") = :type AND parent_id = :parent_id', [':no' => $line[1], ':type' => $line[2], ':parent_id' => $model->id]);
				if (!empty($recLine)) {
					$errors[] = $line[1] . '(' . $line[2] . ') is duplicated in ' . $recLine->invoice_no;
				} else {
					$total += $line[3];
					$ourTotal += $line[3];

					$recLine = new ReconciliationLine;
					$recLine->parent_id = $model->id;
					$recLine->invoice_no = $model->invoice_no;
					$recLine->postcode = !empty($shipment->postcode) ? $shipment->postcode : 0;
					$recLine->shipment_no = $line[1];
					$recLine->weight = number_format(floatval(@$otherLine->weight), 2, '.', '');
					$recLine->value = $line[3];
					$recLine->cdeadwt = number_format(floatval(@$otherLine->cdeadwt), 2, '.', '');
					$recLine->my_value = !empty($shipment) ? $line[3] : 0;
					$recLine->my_charge = 0;
					$recLine->manifest_weight = number_format(floatval(@$otherLine->manifest_weight), 2, '.', '');
					$recLine->our_charge_weight = number_format(floatval(@$otherLine->our_charge_weight), 2, '.', '');
					$recLine->cust_check_weight = number_format(floatval(@$otherLine->cust_check_weight), 2, '.', '');
					$recLine->courier_cubic = number_format(floatval(@$otherLine->courier_cubic), 2, '.', '');
					$recLine->consol_id = intval(@$shipment->consol_id);
					$recLine->mdata['tnt_type'] = $line[2];
					$recLine->save();
				}
			}
			$transaction->commit();
		} catch (Exception $ex) {
			$transaction->rollback();
			$model->addError('id', 'Import Error');
			$this->ajaxResult($model);
		}
		// update reconciliation total now
		$model->invoice_total += $total;
		$model->my_total += $ourTotal;
		$model->update(['invoice_total', 'my_total']);
		$model->tntOther();
		// first time may fail and cause reconciliation total != billing total
		$model->refresh();
		$model->tntOther();
	}

	public function actionHunterReconciliation()
	{
		$model = new Reconciliation();
		$params = $this->importCourierReconciliation('reconciliation_hunter', $model, true, true);
		$invoice_no = $params['invoice_no'];
		$data = $params['data'];
		$date = $params['date'];
		$client_type = Reconciliation::HUNTER_TYPE;
		unset($data[1]);
		//get invoice no and date to check
		// $tempDate = @$data[2][1];
		// $tempDate = oExcel::toDate($tempDate);
		$tempDate = $date;
		$invoice_date = $tempDate;
		if (empty($invoice_no)) {
			$model->addError('id', 'Invoice No. not found in the file!');
			$this->ajaxResult($model);
		}
		if (empty($invoice_date)) {
			$model->addError('id', 'Invoice date not found in the file!');
			$this->ajaxResult($model);
		}
		//prepare data hasAnyShipmentNotExist function
		$pd = $this->prepareHunterData($data);
		$preParedData = $pd["parcel"];
		unset($data);
		$errors = $this->hasAnyShipmentNotExist($preParedData);
		$refCollection = [];
		//prepare data for hasAnyReconciliationLineExist function
		foreach ($preParedData as $temp) {
			if (empty($temp['no'])) {
				continue;
			}

			$refCollection[] = $temp['no'];
		}

		$errors = array_merge($errors, $this->hasAnyReconciliationLineExist($refCollection));

		if (!empty($errors)) {
			$model->addError('id', implode("; ", $errors));
			$this->ajaxResult($model);
		}

		$results = $this->processLines($invoice_no, $preParedData, ImportChargeCode::HUNTER_SYDNEY_ID);
		$this->insertPreparedReconciliationData($invoice_no, $invoice_date, $client_type, Org::ORGID_COURIER_HUNTER, '(PB)\d{6}', $results[0], $results[1]);

		$otherData = $pd["other"];
		//$this->processOtherData($otherData,$invoice_date,$invoice_no,$results[1],$results[2]);

		$this->ajaxResult($model, ['id']);
	}

	public function actionEcofReconciliation()
	{
		$model = new Reconciliation();
		$params = $this->importCourierReconciliation('reconciliation_ecof', $model, true);
		$data = $params['data'];
		$date = $params['date'];
		$client_type = Reconciliation::ECOF_TYPE;
		//get invoice no and date to check
		$tempDate = @$date;
		$invoice_date = $tempDate;
		$invoice_no = isset($data[1][2]) ? $data[1][2] : '';
		unset($data[1]);
		if (empty($invoice_no)) {
			$model->addError('id', 'Invoice No. not found in the file!');
			$this->ajaxResult($model);
		}
		if (empty($invoice_date)) {
			$model->addError('id', 'Invoice date not found in the file!');
			$this->ajaxResult($model);
		}
		//prepare data hasAnyShipmentNotExist function
		$preParedData = $this->prepareEcofData($data);

		unset($data);
		$errors = $this->hasAnyShipmentNotExist($preParedData);
		$refCollection = [];
		//prepare data for hasAnyReconciliationLineExist function
		foreach ($preParedData as $temp) {
			if (empty($temp['no'])) {
				continue;
			}

			$refCollection[] = $temp['no'];
		}

		$errors = array_merge($errors, $this->hasAnyReconciliationLineExist($refCollection));

		if (!empty($errors)) {
			$model->addError('id', implode("; ", $errors));
			$this->ajaxResult($model);
		}

		$results = $this->processLines($invoice_no, $preParedData, ImportChargeCode::ECOF_AUPOST_ID);
		$this->insertPreparedReconciliationData($invoice_no, $invoice_date, $client_type, Org::ORGID_COURIER_ECOF, '(33MBQ)\d{7}', $results[0], $results[1]);
		$this->ajaxResult($model, ['id']);
	}

	public function actionGlobavendReconciliation()
	{
		$model = new Reconciliation();
		$params = $this->importCourierReconciliation('reconciliation_globavend', $model, true, false, true);
		$data = $params['data'];
		unset($data[0]);
		unset($data[1]);
		if (empty($params['invoice_no_1'])) {
			$model->addError('id', 'Postage Invocie No. required!');
			$this->ajaxResult($model);
		} else if (empty($params['invoice_no_2'])) {
			$model->addError('id', 'Linehaul & Custom Clearance Invocie No. required!');
			$this->ajaxResult($model);
		}
		$invoice_date = $params['date'];
		$invoice_no_1 = $params['invoice_no_1'];
		$invoice_no_2 = $params['invoice_no_2'];
		$this->processGlobavendPostage($data[2], $model, $invoice_no_1, $invoice_date);
		$this->processGlobavendLinehaulCustom($data[2], $data[3], $model, $invoice_no_2, $invoice_date);
		if (!empty($data[4])) {
			$this->processGlobavendReturn($data[4], $model, $invoice_no_1, $invoice_date);
		}
		$this->ajaxResult($model, ['id']);
	}

	private function processGlobavendPostage($data, &$model, $invoice_no, $invoice_date)
	{
		$client_type = Reconciliation::GLOBAVEND_TYPE;
		unset($data[1]);
		//prepare data hasAnyShipmentNotExist function
		$preParedData = $this->prepareGlobavendData($data);

		unset($data);
		$errors = $this->hasAnyShipmentNotExist($preParedData);
		$refCollection = [];
		//prepare data for hasAnyReconciliationLineExist function
		foreach ($preParedData as $temp) {
			if (empty($temp['no'])) {
				continue;
			}

			$refCollection[] = $temp['no'];
		}

		$errors = array_merge($errors, $this->hasAnyReconciliationLineExist($refCollection));

		if (!empty($errors)) {
			$model->addError('id', implode("; ", $errors));
			return;
		}

		$results = $this->processLines($invoice_no, $preParedData, ImportChargeCode::GLOBAVEND_POSTAGE_ID);
		$this->insertPreparedReconciliationData($invoice_no, $invoice_date, $client_type, Org::ORGID_SUPPLIER_GLOBAVEND, '(ECN)\d*', $results[0], $results[1]);
	}

	private function processGlobavendLinehaulCustom($nos, $data, &$model, $invoice_no, $invoice_date)
	{
		$nos = array_column(array_filter($nos, function ($v) {
			return preg_match('/ECN/', $v[2]);
		}), 2);
		$errors = [];
		$transaction = Yii::app()->db->beginTransaction();

		$wtError_lines = [];
		$pcsError_lines = [];
		foreach ($data as $row => $line) {
			if (!is_numeric($line[1])) {
				continue;
			}

			$date = substr(date('Ymd', strtotime(oExcel::toDate($line[1]))), 2);
			$consols = Consol::model()->findAll('awb LIKE :awb', [':awb' => '%PCAE-JEC-' . $date . '%']);
			if (empty($consols)) {
				$consols = Consol::model()->findAll('awb LIKE :awb AND eta = :eta', [':awb' => '%PCAE-JEC-%', ':eta' => date('Y-m-d', strtotime(oExcel::toDate($line[1])))]);
			}
			if (empty($consols)) {
				$date = date('Y-m-d', strtotime(oExcel::toDate($line[1])));
				for ($i = 0; $i < 5; $i++) {
					$consols = Consol::model()->with('shipments')->findAll('shipments.agent_id = :aid AND eta = :eta', [':aid' => Org::ORGID_IMPORT_JANCO, ':eta' => $date]);
					if (!empty($consols)) {
						break;
					} else {
						$date = date('Y-m-d', strtotime($date . ' - 1 day'));
					}

				}
			}
			if (empty($consols)) {
				$errors[] = 'Consol for ' . date('Y-m-d', strtotime(oExcel::toDate($line[1]))) . ' couldn\'t be found';
			}
			$totalWeight = 0;
			$totalPcs = 0;

			foreach ($consols as $consol) {
				$totalWeight += max($consol->totWeight(), floatval(@$consol->mdata['awb_wt']), floatval(@$consol->mdata['cgb_wt']));
				$totalPcs += $consol->totPacks();
				foreach ($consol->shipments as $shipment) {
					if (array_search($shipment->hbn, $nos) > -1) {
						unset($nos[array_search($shipment->hbn, $nos)]);
					}
				}
			}

			if ($totalWeight < $line[3] && $totalWeight < $line[4]) {
				// $wtError_lines[] = ['line' => $line, 'consols' => $consols];
				// $errors[] = $date . '\' weight ' . $line[3] . '/' . $line[4] . ' is larger than sum of all consols\' weight ' . $totalWeight;
				foreach ($consols as $consol) {
					$consol->mdata['awb_wt'] = $consol->mdata['awb_wt'] * max($line[3], $line[4]) / $totalWeight;
					$consol->mdata['cgb_wt'] = $consol->mdata['cgb_wt'] * max($line[3], $line[4]) / $totalWeight;
					$consol->update('meta');
				}
				$totalWeight = max($line[3], $line[4]);
			} else if ($totalPcs < $line[2]) {
				$pcsError_lines[] = ['line' => $line, 'consols' => $consols];
				continue;
			}

			foreach ($consols as $consol) {
				$billing_line = BillingLine::model()->find('billing_ref = :ref AND billing_cref = :cref AND status != 11 AND `desc` = "Linehaul charges"', [':ref' => $consol->no, ':cref' => $invoice_no]);
				if (empty($billing_line)) {
					$billing_line = new BillingLine;
					$billing_line->type = BillingLine::BILLING_TYPE_IMPORT;
					$billing_line->org_id = Org::ORGID_SUPPLIER_GLOBAVEND;
					$billing_line->status = 1;
					$billing_line->link_id = 0;
					$billing_line->billing_cref = $invoice_no;
					$billing_line->date = $invoice_date;
					$billing_line->currency = 4;
					$billing_line->billing_ref = $consol->no;
					$billing_line->actual_amount = number_format($line[6] * max($consol->totWeight(), floatval(@$consol->mdata['awb_wt']), floatval(@$consol->mdata['cgb_wt'])) / $totalWeight / 1.1, 2, '.', '');
					$billing_line->gst = 'INPUT';
					$billing_line->gst_amount = $billing_line->getGSTValue();
					$billing_line->dpt_id = !empty($consol->dpt_id) ? $consol->dpt_id : Org::PCAE_DEPARTMENT_SYDNEY;
					$billing_line->created = date('Y-m-d');
					$billing_line->transaction_date = $invoice_date;
					$billing_line->due = $invoice_date;
					$billing_line->sync_xero = 0;
					$billing_line->dpmt = Invoice::DPMT_IMPORT;
					$billing_line->desc = 'Linehaul charges';
					$billing_line->charge_code = Consol::CUSTOM_CLEARANCE_GL_CODE;
					$billing_line->save();

					Billing::linkLine($billing_line, false);
				}

				$billing_line = BillingLine::model()->find('billing_ref = :ref AND billing_cref = :cref AND status != 11 AND `desc` = "Custom clearance charges"', [':ref' => $consol->no, ':cref' => $invoice_no]);
				if (empty($billing_line)) {
					$billing_line = new BillingLine;
					$billing_line->type = BillingLine::BILLING_TYPE_IMPORT;
					$billing_line->org_id = Org::ORGID_SUPPLIER_GLOBAVEND;
					$billing_line->status = 1;
					$billing_line->link_id = 0;
					$billing_line->billing_cref = $invoice_no;
					$billing_line->date = $invoice_date;
					$billing_line->currency = 4;
					$billing_line->billing_ref = $consol->no;
					$billing_line->actual_amount = number_format($line[7] * max($consol->totWeight(), floatval(@$consol->mdata['awb_wt']), floatval(@$consol->mdata['cgb_wt'])) / $totalWeight / 1.1, 2, '.', '');
					$billing_line->gst = 'INPUT';
					$billing_line->gst_amount = $billing_line->getGSTValue();
					$billing_line->dpt_id = !empty($consol->dpt_id) ? $consol->dpt_id : Org::PCAE_DEPARTMENT_SYDNEY;
					$billing_line->created = date('Y-m-d');
					$billing_line->transaction_date = $invoice_date;
					$billing_line->due = $invoice_date;
					$billing_line->sync_xero = 0;
					$billing_line->dpmt = Invoice::DPMT_IMPORT;
					$billing_line->desc = 'Custom clearance charges';
					$billing_line->charge_code = Consol::CUSTOM_CLEARANCE_GL_CODE;
					$billing_line->save();

					Billing::linkLine($billing_line, false);
				}
			}
		}

		foreach ($pcsError_lines as $info) {
			$line = $info['line'];
			$consols = $info['consols'];

			$date = substr(date('Ymd', strtotime(oExcel::toDate($line[1]))), 2);
			$consols = Consol::model()->findAll('awb LIKE :awb', [':awb' => '%PCAE-JEC-' . $date . '%']);
			$totalWeight = 0;
			$totalPcs = 0;

			$new_set = [];
			foreach ($consols as $consol) {
				$consol->mdata['temp_wt'] = max($consol->totWeight(), floatval(@$consol->mdata['awb_wt']), floatval(@$consol->mdata['cgb_wt']));
				$totalWeight += $consol->mdata['temp_wt'];
				$totalPcs += $consol->totPacks();
				$new_set[$consol->no] = $consol;
			}

			if ($totalPcs + count($nos) != $line[2]) {
				$errors[] = $date . '\' pcs ' . $line[2] . ' is larger than sum of all consols\' pcs ' . $totalPcs;
				continue;
			}

			foreach ($nos as $no) {
				$consol = Consol::model()->with('shipments')->find('shipments.hbn = :no', [':no' => $no]);
				if (empty($new_set[$consol->no])) {
					$new_set[$consol->no] = $consol;
					$new_set[$consol->no]->mdata['temp_wt'] = 0;
				}

				$new_set[$consol->no]->mdata['temp_wt'] += $shipment->weight;
				$totalWeight += $shipment->weight;
			}

			foreach ($new_set as $consol) {
				$billing_line = BillingLine::model()->find('billing_ref = :ref AND billing_cref = :cref AND status != 11 AND `desc` = "Linehaul charges"', [':ref' => $consol->no, ':cref' => $invoice_no]);
				if (empty($billing_line)) {
					$billing_line = new BillingLine;
					$billing_line->type = BillingLine::BILLING_TYPE_IMPORT;
					$billing_line->org_id = Org::ORGID_SUPPLIER_GLOBAVEND;
					$billing_line->status = 1;
					$billing_line->link_id = 0;
					$billing_line->billing_cref = $invoice_no;
					$billing_line->date = $invoice_date;
					$billing_line->currency = 4;
					$billing_line->billing_ref = $consol->no;
					$billing_line->actual_amount = number_format($line[6] * $consol->mdata['temp_wt'] / $totalWeight / 1.1, 2, '.', '');
					$billing_line->gst = 'INPUT';
					$billing_line->gst_amount = $billing_line->getGSTValue();
					$billing_line->dpt_id = !empty($consol->dpt_id) ? $consol->dpt_id : Org::PCAE_DEPARTMENT_SYDNEY;
					$billing_line->created = date('Y-m-d');
					$billing_line->transaction_date = $invoice_date;
					$billing_line->due = $invoice_date;
					$billing_line->sync_xero = 0;
					$billing_line->dpmt = Invoice::DPMT_IMPORT;
					$billing_line->desc = 'Linehaul charges';
					$billing_line->charge_code = 91032;
					$billing_line->save();

					Billing::linkLine($billing_line, false);
				}

				$billing_line = BillingLine::model()->find('billing_ref = :ref AND billing_cref = :cref AND status != 11 AND `desc` = "Custom clearance charges"', [':ref' => $consol->no, ':cref' => $invoice_no]);
				if (empty($billing_line)) {
					$billing_line = new BillingLine;
					$billing_line->type = BillingLine::BILLING_TYPE_IMPORT;
					$billing_line->org_id = Org::ORGID_SUPPLIER_GLOBAVEND;
					$billing_line->status = 1;
					$billing_line->link_id = 0;
					$billing_line->billing_cref = $invoice_no;
					$billing_line->date = $invoice_date;
					$billing_line->currency = 4;
					$billing_line->billing_ref = $consol->no;
					$billing_line->actual_amount = number_format($line[7] * $consol->mdata['temp_wt'] / $totalWeight / 1.1, 2, '.', '');
					$billing_line->gst = 'INPUT';
					$billing_line->gst_amount = $billing_line->getGSTValue();
					$billing_line->dpt_id = !empty($consol->dpt_id) ? $consol->dpt_id : Org::PCAE_DEPARTMENT_SYDNEY;
					$billing_line->created = date('Y-m-d');
					$billing_line->transaction_date = $invoice_date;
					$billing_line->due = $invoice_date;
					$billing_line->sync_xero = 0;
					$billing_line->dpmt = Invoice::DPMT_IMPORT;
					$billing_line->desc = 'Custom clearance charges';
					$billing_line->charge_code = 91032;
					$billing_line->save();

					Billing::linkLine($billing_line, false);
				}
			}
		}

		if (empty($errors)) {
			$transaction->commit();
		} else {
			$transaction->rollback();
			$model->addError('id', implode("; ", $errors));
		}
	}

	private function processGlobavendReturn($data, &$model, $invoice_no, $invoice_date)
	{
		unset($data[1]);

		$errors = [];
		$transaction = Yii::app()->db->beginTransaction();
		foreach ($data as $line) {
			if (!preg_match('/(UWQ\d{7})/i', $line[1], $matches)) {
				$errors[] = 'invalid ref ' . $line[1];
				break;
			}

			$shipment = Shipment::model()->find('ref = :ref', [':ref' => $matches[1]]);
			if (empty($shipment)) {
				$errors[] = 'not found ref ' . $line[1];
				break;
			}

			$billing_line = BillingLine::model()->find('billing_ref = :ref AND billing_cref = :cref AND status != 11 AND `desc` = :desc', [':ref' => $shipment->consol->no, ':cref' => $invoice_no, ':desc' => 'Return ' . $line[1]]);
			if (empty($billing_line)) {
				$billing_line = new BillingLine;
				$billing_line->type = BillingLine::BILLING_TYPE_IMPORT;
				$billing_line->org_id = Org::ORGID_SUPPLIER_GLOBAVEND;
				$billing_line->status = 1;
				$billing_line->link_id = 0;
				$billing_line->billing_cref = $invoice_no;
				$billing_line->date = $invoice_date;
				$billing_line->currency = 4;
				$billing_line->billing_ref = $shipment->consol->no;
				$billing_line->actual_amount = 9.09;
				$billing_line->gst = 'INPUT';
				$billing_line->gst_amount = $billing_line->getGSTValue();
				$billing_line->dpt_id = !empty($shipment->consol->dpt_id) ? $shipment->consol->dpt_id : Org::PCAE_DEPARTMENT_SYDNEY;
				$billing_line->created = date('Y-m-d');
				$billing_line->transaction_date = $invoice_date;
				$billing_line->due = $invoice_date;
				$billing_line->sync_xero = 0;
				$billing_line->dpmt = Invoice::DPMT_IMPORT;
				$billing_line->desc = 'Return ' . $line[1];
				$billing_line->charge_code = Consol::AU_LOCAL_DELIVERY_COST_GL_CODE;
				$billing_line->save();

				Billing::linkLine($billing_line, false);
			}
		}

		if (empty($errors)) {
			$transaction->commit();
		} else {
			$transaction->rollback();
			$model->addError('id', implode("; ", $errors));
		}
	}

	private function prepareGlobavendData($data)
	{
		$preparedData = [];
		foreach ($data as $d) {
			if (!preg_match("/ECN\d*/i", $d[2])) {
				continue;
			}

			$ref = $d[2];
			//ecof haven't weight
			$charge = $d[9];
			$weight = $d[4];
			$preparedData[] = ['no' => $ref, 'cubic' => 0, 'chargeweight' => $weight, 'charge' => $charge, 'ref' => $ref];
		}
		return $preparedData;
	}

	private function processLines($invoice_no, $preParedData, $org_rate_id)
	{
		$lines = [];
		$consol_ids = [];
		$consolAmountPercent = [];
		$amount = 0;
		$transaction = Yii::app()->db->beginTransaction();
		try {
			foreach ($preParedData as $d) {
				$shipment = ImParcel::model()->find('ref=:ref OR hbn=:ref', [':ref' => $d['no']]);
				$no = trim($d['no']);
				$invoice = $invoice_no;
				$postcode = $shipment->cnee->postcode;
				$weight = $d['chargeweight']; //coureir chargeweight;
				$cubic = $d['cubic'];
				$value = 0;
				$checkValue = explode("$", $d['charge']);
				if (sizeof($checkValue) > 1) {
					$value = $checkValue[1];
				} else {
					$value = $d['charge']; //courier charge;
				}

				if ($value <= 0) {
					continue;
				}

				$isHunter = false;
				if ($org_rate_id == ImportChargeCode::HUNTER_SYDNEY_ID) {
					$isHunter = true;
				}
				$amount += $value;
				$ourRate = Shipment::getCourierCostByShipment($no, $org_rate_id, $weight, $isHunter);
				$ourRate['consol_id'] = $shipment->consol_id;
				$manifest_weight = isset($shipment->mdata['manifest_weight']) ? floatval($shipment->mdata['manifest_weight']) : 0;
				$cust_check_weight = $shipment->weight;
				$our_charge_weight = floatval(isset($shipment->mdata['charge_client_weight']) ? $shipment->mdata['charge_client_weight'] : $shipment->chargeWeight());
				$shipment->mdata['actual_delivery_cost'] = number_format($value, 2, '.', '');
				$shipment->updateMeta();
				$ourcharge = !empty($shipment->mdata['charge_client_amount']) ? floatval($shipment->mdata['charge_client_amount']) : $shipment->getCouiercost();
				$consolId = $shipment->consol_id;
				$consolAmountPercent[$consolId] = @$consolAmountPercent[$consolId] + $value;
				if (!in_array($consolId, $consol_ids)) {
					$consol_ids[] = $consolId;
				}
				$lines[] = [$no, '', $postcode, $weight, $value, $ourRate, 0, $ourcharge, $manifest_weight, $cust_check_weight, $our_charge_weight, $cubic];
			}
			$transaction->commit();
		} catch (Exception $ex) {
			$transaction->rollback();
			throw $ex;
		}

		foreach ($consolAmountPercent as $key => $value) {
			$consolAmountPercent[$key] = $value / $amount;
		}
		unset($preParedData);
		return [$lines, $consol_ids, $consolAmountPercent];
	}

	private function importCourierReconciliation($template, &$model, $needDate = false, $needInvoiceNo = false, $multipleSheets = false)
	{

		if (isset($_POST) && !empty($_POST)) {
			$file = empty($_FILES['inv_file']) ? [] : $_FILES['inv_file'];

			if ($needInvoiceNo) {
				$invoice_no = $_POST['invoice_no'];
				if (empty($invoice_no)) {
					$model->addError('id', 'Invoice No. required!');
					$this->ajaxResult($model);
				}
			}
			if ($needDate) {
				if (empty($_POST['invoice_issue_date']) || !preg_match("/\d{4}-\d{2}-\d{2}/", $_POST['invoice_issue_date'])) {
					$model->addError('id', 'Please input the valid issue date!');
					$this->ajaxResult($model);
				}
			}

			if (empty($file['tmp_name']) || !is_uploaded_file($file['tmp_name'])) {
				$model->addError('id', 'Invalid template file!');
				$this->ajaxResult($model);
			} else {
				if (preg_match('/csv/i', $file['name'])) {
					$xls = new oExcel('CSV');
				} else {
					include_once 'PHPExcel/PHPExcel/IOFactory.php';
					$xls = new oExcel(PHPExcel_IOFactory::identify($file['tmp_name']));
				}

				$xls->load($file['tmp_name']);
				$result = [];

				foreach ($_POST as $k => $v) {
					$result[$k] = $v;
				}

				if (!$multipleSheets) {
					$result['data'] = $xls->getAll();
				} else {
					$result['data'] = [];
					foreach ($xls->xls->getAllSheets() as $sheet) {
						$result['data'][] = $xls->getAll($sheet);
					}
				}

				if ($needDate) {
					$result['date'] = $_POST['invoice_issue_date'];
				}

				if ($needInvoiceNo) {
					$result['invoice_no'] = $_POST['invoice_no'];
				}

				return $result;
			}
		} else {
			$this->render($template);
			Yii::app()->end();
		}
	}

	private function insertPreparedReconciliationData($invoice_no, $invoice_date, $client_type, $courierId, $refCode, $lines, $consol_ids)
	{
		$recModel = Reconciliation::model()->find('invoice_no = :invno AND client_type=:client_type', [':invno' => $invoice_no, ':client_type' => $client_type]);
		if (empty($recModel)) {
			// create reconsiliation now
			$recModel = new Reconciliation();
			$recModel->client_type = $client_type;
			$recModel->invoice_no = $invoice_no;
			$recModel->invoice_date = $invoice_date;
			$recModel->invoice_total = 0; // first saved with zero will update after all lines
			$recModel->my_total = 0; // first saved with zero will update after all lines
			$recModel->save();
		}
		$total = 0;
		$ourTotal = 0;
		$transaction = Yii::app()->db->beginTransaction();
		try {
			foreach ($lines as $line) {
				$total += $line[4];
				$ourTotal += $line[5]['price'];
				$recData = ReconciliationLine::model()->find('shipment_no = :sno', [':sno' => $line[0]]);
				if (empty($recData)) {
					$recData = new ReconciliationLine();
				}
				$recData->parent_id = $recModel->id;
				$recData->invoice_no = $invoice_no; // for aupost we use invoice_no field to save console number
				$recData->postcode = $line[2];
				$recData->shipment_no = $line[0];
				$recData->weight = number_format($line[3], 2, '.', '');
				$recData->value = number_format($line[4], 2, '.', '');
				$recData->cdeadwt = number_format($line[6], 2, '.', '');
				$recData->consol_id = $line[5]['consol_id'];
				$recData->my_value = !empty($recData->consol_id) ? number_format($line[5]['price'], 2, '.', '') : 0;
				$recData->my_charge = number_format($line[7], 2, '.', '');
				$recData->manifest_weight = number_format($line[8], 2, '.', '');
				$recData->our_charge_weight = number_format($line[10], 2, '.', '');
				$recData->cust_check_weight = number_format($line[9], 2, '.', '');
				$recData->courier_cubic = number_format($line[11], 3, '.', '');
				$recData->save();
			}
			$transaction->commit();
		} catch (Exception $ex) {
			$transaction->rollback();
			throw $ex;
		}
		// update reconciliation total now
		$recModel->invoice_total = $total;
		$recModel->my_total = $ourTotal;
		$recModel->update(['invoice_total', 'my_total']);
		foreach ($consol_ids as $cid) {
			$consol = Consol::model()->findByPk($cid);
			if (!empty($consol)) {
				$consol->updateCourierRealCost($courierId, $refCode);
			}
		}
	}
	/**
	 * charge exclude gst;
	 *
	 */
	private function prepareTntData($data)
	{
		$preparedData = [];
		foreach ($data as $d) {
			if (!isset($d[8]) || $d[8] == "") {
				continue;
			}

			$ref = @$d[9];
			if (preg_match("/adjust/i", $ref)) {
				continue;
			}
			//not consider adjust fee;
			$charge = floatval(@$d[34]) - floatval(@$d[33]);
			$preparedData[] = ['no' => $d[8], 'cubic' => floatval(@$d[26]), 'chargeweight' => floatval(@$d[25]), 'charge' => $charge, 'ref' => @$d[9]];
		}
		return $preparedData;
	}

	private function prepareTntDataNew($data)
	{
		$preparedData = [];
		foreach ($data as $d) {
			if (empty($d[2]) || empty($d[6]) || empty($d[7])) {
				continue;
			}

			$ref = $d[2];
			if (preg_match("/adjust/i", $ref)) {
				continue;
			}
			$charge = floatval($d[7]);
			$fuel = floatval($d[6]);
			$preparedData[] = ['no' => $d[2], 'cubic' => floatval(@$d[5]), 'chargeweight' => floatval(@$d[4]), 'charge' => $charge, 'ref' => $d[2], 'fuel' => $d[6]];
		}
		return $preparedData;
	}

	/**
	 * charge exclude gst;
	 *
	 */
	private function prepareHunterData($data)
	{
		$preparedData = [];
		$otherData = [];
		foreach ($data as $d) {

			if (preg_match('/fuel/i', $d[14])) {
				$otherData[] = ['no' => '', 'charge' => $d[15], 'code' => 'Fuel Surcharge'];
			}

			if (!isset($d[5]) || $d[5] == "") {
				continue;
			}

			$ref = @$d[5];

			// if (preg_match("/adjust/i", $ref)) {
			//     continue;
			// }
			//not consider adjust fee;
			$charge = $d[15];
			$preparedData[] = ['no' => $d[5], 'cubic' => 0, 'chargeweight' => floatval(@$d[14]), 'charge' => $charge, 'ref' => @$d[5]];
		}
		return ["parcel" => $preparedData, "other" => $otherData];
	}

	/**
	 * charge exclude gst;
	 *
	 */
	private function prepareEcofData($data)
	{
		$preparedData = [];
		foreach ($data as $d) {
			if (!preg_match("/33MBQ\d{7}/i", @$d[1])) {
				continue;
			}

			$ref = @$d[1];
			//ecof haven't weight
			$charge = @$d[7];
			$weight = @$d[10];
			$preparedData[] = ['no' => $ref, 'cubic' => 0, 'chargeweight' => $weight, 'charge' => $charge, 'ref' => @$ref];
		}
		return $preparedData;
	}

	private function processOtherData($data, $invoice_date, $invoice_no, $consol_ids, $consolAmountPercent)
	{
		$transaction = Yii::app()->db->beginTransaction();
		try {
			foreach ($data as $d) {
				if ($d['code'] == 'Fuel Surcharge') {

					$checkValue = explode("$", $d['charge']);
					$fuelFee = 0;
					if (sizeof($checkValue) > 1) {
						$fuelFee = $checkValue[1];
					} else {
						$fuelFee = $d['charge']; //courier charge;
					}
					// fuel surcharge
					foreach ($consol_ids as $cid) {
						$consol = Consol::model()->findByPk($cid);
						if (!empty($consol) && $consol->owner_id != 114) {
							$line = BillingLine::model()->find('billing_cref = :cref AND billing_ref = :bref AND `desc` like "%shipment%"', [':cref' => $invoice_no, ':bref' => $consol->no]);
							$billing = BillingLine::model()->find('billing_cref = :cref AND billing_ref = :bref AND `desc` = :desc', [':cref' => $invoice_no, ':bref' => $consol->no, ':desc' => $d['code'] . ' ' . $d['charge']]);
							if (!empty($billing)) {
								continue;
							}
							$billing = new BillingLine;
							$billing->mdata['from_rec'] = 0;
							$billing->status = 1;
							$billing->link_id = 0;
							$billing->org_id = $line->org_id;
							$billing->charge_code = Consol::AU_LOCAL_DELIVERY_COST_GL_CODE;
							$billing->billing_cref = $invoice_no;
							$billing->currency = 1;
							$billing->weight = 0;
							$billing->charge_weight = 0;
							$billing->billing_ref = $consol->no;
							$billing->type = BillingLine::BILLING_TYPE_IMPORT;
							$billing->dpmt = Invoice::DPMT_IMPORT;
							$billing->awb = $consol->awb;
							$billing->dpt_id = empty($consol->dpt_id) ? Org::PCAE_DEPARTMENT_SYDNEY : $consol->dpt_id;
							$billing->date = $invoice_date;
							$billing->created = $invoice_date;
							$billing->transaction_date = $invoice_date;
							$billing->due = $invoice_date;
							$billing->actual_amount = number_format(round($consolAmountPercent[$cid] * $fuelFee, 2), 2, '.', '');
							$billing->gst = 'INPUT';
							$billing->gst_amount = $billing->getGSTValue();
							$billing->desc = $d['code'] . ' ' . $fuelFee . '';
							$billing->accrual_amount = number_format(round($consolAmountPercent[$cid] * $fuelFee, 2), 2, '.', '');
							$billing->save();
							Billing::linkLine($billing, false);
						}
					}
				}
			}
			$transaction->commit();
		} catch (Exception $ex) {
			$transaction->rollback();
			throw $ex;
		}
	}

	/**
	 * Lists and search.
