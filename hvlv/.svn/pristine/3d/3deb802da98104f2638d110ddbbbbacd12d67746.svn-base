			$model->model_awb = $_GET['Invoice']['model_awb'];
			unset($_GET['Invoice']['model_awb']);
		}
		if (isset($_GET['Invoice']['model_no'])) {
			$model->model_no = $_GET['Invoice']['model_no'];
			unset($_GET['Invoice']['model_no']);
		}
		if (isset($_GET['Invoice'])) {
			$model->attributes = $_GET['Invoice'];
		}

		$this->render('list', [
