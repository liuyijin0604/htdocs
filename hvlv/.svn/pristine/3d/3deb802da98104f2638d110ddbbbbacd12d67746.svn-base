	public function actionBatchUpdate()
	{
		if (!empty($_POST['selectedItems']) && Acl::hasAccess("B:Invoice/batchUpdate")) {
			$invs = Invoice::model()->findAll('id IN (' . implode(',', $_POST['selectedItems']) . ') AND status = 1');
			foreach ($invs as $inv) {
				$inv->status = $_POST['batch_status'];
				$inv->save();
			}
		}

		echo json_encode(['done' => true, 'msg' => 'Successfully']);
		Yii::app()->end();
	}

