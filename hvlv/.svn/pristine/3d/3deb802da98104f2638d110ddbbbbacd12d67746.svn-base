	private function sendEmail2Agent($data)
	{
		$r = new stdClass;
		$r->success = false;

		include_once 'PHPMailer/class.phpmailer.php';
		include_once 'PHPMailer/class.smtp.php';
		$mail = new PHPMailer();
		// set mail information
		$mail->From = 'finance@toplogistics.com.au';
		$mail->FromName = 'No Reply';
		$mail->Subject = $data['subject'];
		$mail->AltBody = 'To view the message, please use an HTML compatible email viewer!';
		$mail->Body = $data['body'];
		$mail->isHTML(true);

		$mail->AddAddress($data['to_email']);
		if (!$mail->Send()) {
			$r->msg = 'Mailer error : ' . $mail->ErrorInfo;

		} else {
			// send successfully
			$r->success = true;
			$r->msg = 'send email to client successfully';
		}
		return $r;
	}

	/**
	 * Email invoice notice confirm before sending
	 * @param $id
	 * @throws CException
	 * @throws CHttpException
	 */
	public function actionEmail($id)
	{
		if (isset($_POST['EmailTpl'])) {
			$rt = $this->sendEmail2Agent([
				'to_email' => $_POST['toemail'],
				'subject' => $_POST['subject'],
				'body' => $_POST['EmailTpl']['body'],
			]);

			$r = new stdClass();
			$r->done = $rt->success;
			if ($r->done) {
				$r->msg = $this->t('send invoice email notice to client successfully');

			} else {
				$r->msg = $rt->msg;
			}
			echo json_encode($r);
			Yii::app()->end();
		}

		$model = $this->loadModel($id);
		$left_amount = $model->getBalance();

		$tpl = EmailTpl::model()->find('slug = :slug', [':slug' => 'invoice']);
		if (isset($tpl)) {
			$tpl->assign('CLIENT_NAME', $model->mdata['name']);
			$tpl->assign('INV_NO', empty($model->no) ? $model->id : $model->no);
		}

		$this->render('invoice_notice_form', ['tpl' => $tpl]);
	}

	/**
	 * create invoice paylink algorithm as below:
	 * app_url/invoice/pay.app?token=[tokenvaue]
	 * @param $data
	 * @return string
	 */
	private function createPaylink($data)
	{
		$paylink = Yii::app()->createAbsoluteUrl('/') . '/payInvoice/pay.app?token=';
		$iv = str_repeat("\x00", openssl_cipher_iv_length('AES-256-CBC'));
		$token = base64_encode(openssl_encrypt(json_encode($data), 'AES-128-CBC', md5(PoliPaymentApi::PAYLINK_KEY), 0, $iv));
		$paylink .= trim($this->safe_b64encode($token));
		return $paylink;
	}

	private function createPaypallink($data){
		$paylink = Yii::app()->createAbsoluteUrl('/') . '/payInvoice/paypal.app?token=';
		$iv = str_repeat("\x00", openssl_cipher_iv_length('AES-256-CBC'));
		$token = base64_encode(openssl_encrypt(json_encode($data), 'AES-128-CBC', md5(PoliPaymentApi::PAYLINK_KEY), 0, $iv));
		$paylink .= trim($this->safe_b64encode($token));
		return $paylink;
	}

	/**
	 * remove special string for URL paramters
	 * @param $string
	 * @return mixed|string
	 */
	private function safe_b64encode($string)
	{
		$data = base64_encode($string);
		$data = str_replace(['+', '/', '='], ['-', '_', ''], $data);
		return $data;
	}
	private function safe_b64decode($string)
	{
		$data = str_replace(['-', '_'], ['+', '/'], $string);
		$mod4 = strlen($data) % 4;
		if ($mod4) {
			$data .= substr('====', $mod4);
		}
		return base64_decode($data);
	}

	/**
	 * send payment link to client
	 * currently we use POLI as 3rd payment gateway
	 * POLI account as below
	 * Merchant Name Top Logistics
	 *     Merchant Code S6102066
	 * Authentication Code IYPTMKBBHM
	 * Currency Code AUD
	 * Country Code AU
	 * POLi API URL https://poliapi.apac.paywithpoli.com/
	 * @param $id
	 */
	private function sendInvoiceAlert($id)
	{
		// here we need to get payment name and email address
		$model = $this->loadModel($id);

		if (!empty($model)) {
			$invoice_ref = empty($model->no) ? $model->id : $model->no;

			$invoice_data = [
				'fullname' => $model->cust->name,
				'email' => $model->cust->email,
				'amount' => $model->total,
				'invoice_ref' => $invoice_ref,
			];

			$this->sendInvoiceAlertByPoli($invoice_data);
		} else {
			// something wrong
			// invalid invoice number
		}
	}

	private function sendInvoiceAlertByPoli($data)
	{
		$json_builder = '{
			"LinkType":"0",
			"Amount":"' . $data['amount'] . '",
			"CurrencyCode":"AUD",
			"MerchantData":" ' . $data['invoice_ref'] . '",
			"MerchantReference":" ' . $data['invoice_ref'] . '",
			"ConfirmationEmail":"true",
			"AllowCustomerReference":"false",
			"ViaEmail":"true",
			"RecipientName":"' . $data['fullname'] . '",
			"LinkExpiry":"2120-10-24 16:00:00+11",
			"RecipientEmail":"' . $data['email'] . '"
		}';

		$auth = base64_encode(PoliPaymentApi::POLI_MERCHCODE . ':' . PoliPaymentApi::POLI_AUTHCODE);
		$header = [];
		$header[] = 'Content-Type: application/json';
		$header[] = 'Authorization: Basic ' . $auth;

		try {
			$ch = curl_init("https://poliapi.apac.paywithpoli.com/api/POLiLink/Create");

			//See the cURL documentation for more information: http://curl.haxx.se/docs/sslcerts.html
			//We recommend using this bundle: https://raw.githubusercontent.com/bagder/ca-bundle/master/ca-bundle.crt
			//curl_setopt($ch, CURLOPT_CAINFO, "/ca-bundle.crt");
			// curl_setopt($ch, CURLOPT_SSLVERSION, CURL_SSLVERSION_TLSv1_2);

			// currently just disable ssl
			curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, 0);

			curl_setopt($ch, CURLOPT_HTTPHEADER, $header);
			curl_setopt($ch, CURLOPT_HEADER, 0);
			curl_setopt($ch, CURLOPT_POST, 1);
			curl_setopt($ch, CURLOPT_POSTFIELDS, $json_builder);
			curl_setopt($ch, CURLOPT_FOLLOWLOCATION, 1);
			curl_setopt($ch, CURLOPT_RETURNTRANSFER, 1);
			$response = curl_exec($ch);

			if ($response == false) {
				throw new Exception(curl_error($ch), curl_errno($ch));
			}

			curl_close($ch);
		} catch (Exception $e) {
			trigger_error(
				sprintf(
					'Curl failed with error #%d: %s',
					$e->getCode(),
					$e->getMessage()
				),
				E_USER_ERROR
			);

			return false;
		}

		$json = json_decode($response, true);

		// get url token save them for query soon
		if (is_array($json)) {
			// should be error message
			$error = $json['ErrorMessage'];
			echo json_encode($json);
			exit();
		} else {
			// we should save this payment link for checking
			// $payment_link = $json;
		}

		echo 'send invoice to client by email successfully';

		return true;
	}

