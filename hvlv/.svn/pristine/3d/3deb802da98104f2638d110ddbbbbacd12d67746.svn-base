		$totalAmount = 0;
		$totalOurAmount = 0;
		foreach ($model->lines as $il) {
			$xls->addRow($i++, [$il->date, $il->connote, $il->consols, $il->destination, $il->weight, $il->amount, $il->duplicate_count, $il->invoice_refs, $il->getExistingStatus()]);
