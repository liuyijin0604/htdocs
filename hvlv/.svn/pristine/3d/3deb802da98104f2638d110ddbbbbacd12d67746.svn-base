	/**
	 * create last month balance report
	 */
	public function actionCreateBalanceReport_forbackup()
	{
		if (isset($_POST['btn_balance_report'])) {

			// first step we need to close all invoices and payments for last month
			Invoice::closeLastMonthInvoices();

			// !!! NOTE !!!!
			// current we test based on day
			// once go to live please change back to by month only
			// ===========================================================================

			// then go to next step as below
			// create last month balance report now
			// $lastMonthLastDate = date('Y-m-d', strtotime("last day of -1 month"));
			// $lastMonth = date('Y-m',strtotime($lastMonthLastDate));

			$lastMonthLastDate = date('Y-m-d', strtotime("-1 day"));
			$lastMonth = date('Y-m-d', strtotime($lastMonthLastDate));

			$overwriteOldReport = isset($_POST['owrp']) ? true : false;

			$existingReport = BalanceReport::model()->find('date_month = :dm', [':dm' => $lastMonth]);
			if (!empty($existingReport) && !$overwriteOldReport) {
				echo json_encode(
					[
						'success' => 0,
						'msg' => 'Report has been created successfully before, if you want to overwrite it , please tick the overwrite box']
				);
				return;
			}

			// get 2 month before balance  from DB
			// set as last month's last month balance
			//$prev2MonthDate = date('Y-m-d', strtotime("last day of -2 month"));
			//$prev2Month =  date('Y-m',strtotime($prev2MonthDate));

			$prev2MonthDate = date('Y-m-d', strtotime("-2 day"));
			$prev2Month = date('Y-m-d', strtotime($prev2MonthDate));

			$bp = BalanceReport::model()->find('date_month = :dm', [':dm' => $prev2Month]);
			$prev2MonthBalance = 0;
			if (!empty($bp)) {
				$prev2MonthBalance = $bp->current_balance;
			}

			// get last month balance
			// based on posted date in invoice and transaction data in payment line
			// because old duty data , we can't use this logic
			// $lastMonthBalance = Invoice::getAmountByMonth($lastMonthLastDate) - Payment::getPaidAmountByMonth($lastMonthLastDate);
			$lastMonthBalance = 0;

			// get last month occurring invoice balance
			// based on posted date
			$lastMonthOccurringInvoiceAmount = Invoice::getOccurringAmountByMonth($lastMonthLastDate);
			if (empty($lastMonthOccurringInvoiceAmount)) {
				$lastMonthOccurringInvoiceAmount = 0;
			}

			// get last month occurring payment balance
			// based on transaction date
			$lastMonthOccurringPaymentAmount = Payment::getOccurringAmountByMonth($lastMonthLastDate);
			if (empty($lastMonthOccurringPaymentAmount)) {
				$lastMonthOccurringPaymentAmount = 0;
			}

			// save last month balance
			if (!empty($existingReport) && $overwriteOldReport) {
				$bp = $existingReport; // just update old one
			} else {
				$bp = new BalanceReport(); // create a new one
			}
			$bp->created_date = date('Y-m-d');
			$bp->last_balance = $prev2MonthBalance;
			$bp->current_balance = $lastMonthBalance;
			$bp->current_invoice = $lastMonthOccurringInvoiceAmount;
			$bp->current_payment = $lastMonthOccurringPaymentAmount;
			$bp->date_month = $lastMonth;
			$bp->save();
			$rt = $bp->getErrors();
			$errors = '';
			foreach ($rt as $k => $error) {
				if (!empty($errors)) {
					$errors .= ',';
				}
				$errors .= implode(' ', $error);
			}

			if (!empty($errors)) {
				echo json_encode(
					[
						'success' => 0,
						'msg' => $errors]
				);
			} else {

				// save last month balance details by customer
				$note = [];
				$totalBalance = 0;
				$bkFileId = $this->backupLastMonthBalanceDetails($lastMonthLastDate, $bp->id, $totalBalance);
				$bp->current_balance = $totalBalance;
				$bp->save();

				$note['balance_file_id'] = $bkFileId;

				// save last month occurring inoivce details
				$bkFileId = $this->backupLastMonthOccurringInvoiceDetails($lastMonthLastDate, $bp->id);
				$note['invoice_file_id'] = $bkFileId;

				// save last month occurring payment details
				$bkFileId = $this->backupLastMonthOccurringPaymentDetails($lastMonthLastDate, $bp->id);
				$note['payment_file_id'] = $bkFileId;

				$bp->note = json_encode($note);
				$bp->update('note');

				echo json_encode(
					[
						'success' => 1,
						'msg' => 'Report has been created successfully']
				);
			}
		} else {
			echo json_encode(
				[
					'success' => 0,
					'msg' => 'Unknown action']
			);
		}
	}

	public function actionMakeSupay($id, $act)
	{
		$invoice = Invoice::model()->findByPk($id);
		$callback_notification_url = Yii::app()->request->hostInfo . $this->createUrl('supay/supay');
		if (Yii::app()->name == 'TLA') {
			$supay = new SupayAPI(
				$callback_notification_url,
				'',
				'72795',
				'lkjh678jGQDJokl9XQHaHIyfuytttqqq'
			);
		} else {
			$supay = new SupayAPI(
				$callback_notification_url
			);
		}
		if ($act == 'Wechat') {
			$url = $supay->checkoutByWechatPay('invoice ' . $invoice->no, $invoice->no, 'AUD', round($invoice->total * 1, 2));
		} elseif ($act == 'Alipay') {
			$url = $supay->checkoutByAliPay('invoice ' . $invoice->no, $invoice->no, 'AUD', round($invoice->total * 1, 2));
		} elseif ($act == 'Poli') {
			$url = $this->createPaylink(['invoice_id' => $invoice->id]);
		} elseif ($act == 'Paypal'){
			$url = $this->createPaypallink(['invoice_id' => $invoice->id]);
		}
		echo json_encode(['success' => true, 'msg' => 'success', 'url' => $url]);
	}

	/**
	 * back up last month balance report details
	 * @param $lastMonthLastDate
	 * @param $reportId
	 * @return int
	 */
	private function backupLastMonthBalanceDetails($lastMonthLastDate, $reportId, &$allBalance)
	{
		// $lastMonth = date('Y-m',strtotime($lastMonthLastDate));
		$lastMonth = date('Y-m-d', strtotime($lastMonthLastDate));

		$filename = 'balance_report_details' . $lastMonth . '.xlsx';
		$fullPathFile = Yii::app()->basePath . DIRECTORY_SEPARATOR . 'runtime' . DIRECTORY_SEPARATOR . $filename;

		// get last month balance details by customer
		$model = new Invoice('search');
		$model->unsetAttributes();
		$ec = new CDbCriteria;
		$ec->condition = "status IN (2,3,7)"; // posted , overdue, and partially paid
		$ec->condition .= ' AND dpt_id = ' . Org::PCAE_DEPARTMENT_SYDNEY;
		$ec->condition .= " AND posted <= '" . $lastMonthLastDate . "'";
		$dp = $model->search(false, 0, 't.due ASC', $ec);
		$cus = [];
		foreach ($dp->data as $r) {
			$cus[$r->to_id][] = $r;
		}
		$xls = new oExcel;
		$i = 1;
		$totalBalance = 0;
		//  $allUnlinkedPayment = Payment::getTotalUnallocPaymentAmountList($lastMonthLastDate);
		$allAtaPayment = Payment::getTotalAtaPaymentAmountList($lastMonthLastDate);

		foreach ($cus as $cid => $rs) {
			$xls->addRow($i++, [$cid, $rs[0]->cust->name]);
			$xls->addRow($i, ['No', 'Type', 'AWB', 'Date', 'Due', 'Total', 'Paid', 'Balance']);
			$xls->setFont('A' . $i . ':H' . $i, ['bold' => true]);
			$i++;
			$tot = [0, 0, 0];
			foreach ($rs as $k => $r) {
				$paid = $r->getPaidAmountByDate($lastMonthLastDate);
				$awb = '';
				$balance = $r->total - $paid;
				if ($balance == 0) {
					continue;
				}
				if (!empty($r->mdata['awb'])) {
					$awb = $r->mdata['awb'];
				}
				$xls->addRow($i++, [$r->no, $r->getType(), $awb, $r->date, $r->due, $r->total, $paid, $balance]);
				$tot[0] += $r->total;
				$tot[1] += $paid;
				$tot[2] += $balance;
				unset($r); // release memory in time
				unset($rs[$k]); // release memory in time
			}

			$xls->addRow($i++, ['', '', '', '', 'Total:', $tot[0], $tot[1], $tot[2]]);

			// get all overpayment or credit note
			// which are not linked to any invoices yet
			// $opAmount = isset($allUnlinkedPayment[$cid]) ? $allUnlinkedPayment[$cid] : 0 ;
			// if ( $opAmount > 0 ) {
			//   $xls->addRow($i++, ['', '', '', '', '', '', 'Total Credit Notes:', '-' . $opAmount]);
			//  unset($allUnlinkedPayment[$cid]);
			//  }

			$ataAmount = isset($allAtaPayment[$cid]) ? $allAtaPayment[$cid] : 0;
			if ($ataAmount > 0) {
				$xls->addRow($i++, ['', '', '', '', '', '', 'Total Available Payment:', '-' . $ataAmount]);
				unset($allAtaPayment[$cid]);
			}

			$totalBalance += $tot[2];
			//  $totalBalance -= $opAmount;
			$totalBalance -= $ataAmount;
		}
		$xls->addRow($i++, ['']);

		// for all unlinked invoice payment
		/*     foreach ( $allUnlinkedPayment as $oid => $amount ) {
		$org = Org::model()->findByPk($oid);
		$xls->addRow($i++, [$oid, $org->name]);
		$xls->addRow($i++, ['', '', '', '', '', '', 'Total Credit Notes:', '-' . $amount]);
		$totalBalance -= $amount;
		}*/

		// for all still available payment but not linked with any outstanding invoices
		foreach ($allAtaPayment as $oid => $amount) {
			$org = Org::model()->findByPk($oid);
			$xls->addRow($i++, [$oid, $org->name]);
			$xls->addRow($i++, ['', '', '', '', '', '', 'Total Available Payment:', '-' . $amount]);
			$totalBalance -= $amount;
		}

		$xls->addRow($i, ['', '', '', '', '', '', 'Total Balance:', $totalBalance]);
		$xls->output($fullPathFile, '', false);

		// save last month balance details file
		$filerepoId = FileRepo::storeFile($fullPathFile, $filename, 56, $reportId);
		unset($xls);

		// delete origin file
		unlink($fullPathFile);

		$allBalance = $totalBalance;

		return $filerepoId;
	}

	/**
	 * @param $lastMonthLastDate
	 * @param $reportId
	 * @return int
	 */
	private function backupLastMonthOccurringInvoiceDetails($lastMonthLastDate, $reportId)
	{
		//$timeLastMonthLastDate = strtotime($lastMonthLastDate);
		//$lastMonth = date('Y-m',$timeLastMonthLastDate);
		//$lastMonthFirstDate = date('Y-m-01',$timeLastMonthLastDate);

		$oldDate = $lastMonthLastDate;
		$lastMonthLastDate = $oldDate . ' 23:59:59';
		$lastMonth = $oldDate;
		$lastMonthFirstDate = $oldDate . ' 00:00:00';

		$filename = 'balance_report_occurring_invoice_details' . $lastMonth . '.xlsx';
		$fullPathFile = Yii::app()->basePath . DIRECTORY_SEPARATOR . 'runtime' . DIRECTORY_SEPARATOR . $filename;

		// get last month balance details by customer
		$model = new Invoice('search');
		$model->unsetAttributes();
		$ec = new CDbCriteria;
		$ec->condition = "status IN (2,3,7,9,11)"; // posted , overdue, and partially paid
		$ec->condition .= ' AND dpt_id = ' . Org::PCAE_DEPARTMENT_SYDNEY;
		$ec->condition .= " AND posted <= '" . $lastMonthLastDate . "' AND posted >= '" . $lastMonthFirstDate . "'";
		$dp = $model->search(false, 0, 't.id DESC', $ec);
		$cus = [];
		foreach ($dp->data as $r) {
			$cus[$r->to_id][] = $r;
		}
		$xls = new oExcel;
		$i = 1;
		$total = 0;
		foreach ($cus as $cid => $rs) {
			$xls->addRow($i++, [$cid, $rs[0]->cust->name]);
			$xls->addRow($i, ['No', 'Type', 'AWB', 'Date', 'Due', 'Total']);
			$xls->setFont('A' . $i . ':H' . $i, ['bold' => true]);
			$i++;
			$tot = 0;
			foreach ($rs as $k => $r) {
				$awb = '';
				if (!empty($r->mdata['awb'])) {
					$awb = $r->mdata['awb'];
				}
				$xls->addRow($i++, [$r->no, $r->getType(), $awb, $r->posted, $r->due, $r->total]);

				$tot += $r->total;
				unset($r); // release memory in time
				unset($rs[$k]); // release memory in time
			}
			$xls->addRow($i++, ['', '', '', '', 'Total:', $tot]);
			$total += $tot;
		}
		$xls->addRow($i++, ['']);
		$xls->addRow($i, ['', '', '', '', 'Total Amount:', $total]);
		$xls->output($fullPathFile, '', false);

		// save last month balance details file
		$filerepoId = FileRepo::storeFile($fullPathFile, $filename, 57, $reportId);
		unset($xls);

		// delete origin file
		unlink($fullPathFile);

		return $filerepoId;
	}

	/**
	 * @param $lastMonthLastDate
	 * @param $reportId
	 * @return int
	 */
	private function backupLastMonthOccurringPaymentDetails($lastMonthLastDate, $reportId)
	{
		// $timeLastMonthLastDate = strtotime($lastMonthLastDate);
		// $lastMonth = date('Y-m',$timeLastMonthLastDate);
		//  $lastMonthFirstDate = date('Y-m-01',$timeLastMonthLastDate);

		$oldDate = $lastMonthLastDate;
		$lastMonthLastDate = $oldDate . ' 23:59:59';
		$lastMonth = $oldDate;
		$lastMonthFirstDate = $oldDate . ' 00:00:00';

		$filename = 'balance_report_occurring_invoice_details' . $lastMonth . '.xlsx';
		$fullPathFile = Yii::app()->basePath . DIRECTORY_SEPARATOR . 'runtime' . DIRECTORY_SEPARATOR . $filename;

		// get last month balance details by customer
		$model = new Payment('search');
		$model->unsetAttributes();
		$ec = new CDbCriteria;
		$ec->condition = "status IN (1,6)";
		$ec->condition .= " AND transaction_date <= '" . $lastMonthLastDate . "' AND transaction_date >= '" . $lastMonthFirstDate . "'";
		$dp = $model->search(false, 0, $ec);
		$cus = [];
		foreach ($dp->data as $r) {
			$cus[$r->org_id][] = $r;
		}
		$xls = new oExcel;
		$i = 1;
		$total = 0;
		foreach ($cus as $cid => $rs) {
			$xls->addRow($i++, [$cid, $rs[0]->cust->name]);
			$xls->addRow($i, ['Date', 'Transaction Date', 'Type', 'Amount']);
			$xls->setFont('A' . $i . ':H' . $i, ['bold' => true]);
			$i++;
			$tot = 0;
			foreach ($rs as $k => $r) {
				$tot += $r->amount;
				$xls->addRow($i++, [$r->date, $r->transaction_date, $r->getType(), $tot]);
				unset($r); // release memory in time
				unset($rs[$k]); // release memory in time
			}
			$xls->addRow($i++, ['', '', 'Total:', $tot]);
			$total += $tot;
		}
		$xls->addRow($i++, ['']);
		$xls->addRow($i, ['', '', 'Total Amount:', $total]);
		$xls->output($fullPathFile, '', false);

		// save last month balance details file
		$filerepoId = FileRepo::storeFile($fullPathFile, $filename, 58, $reportId);
		unset($xls);

		// delete origin file
		unlink($fullPathFile);

		return $filerepoId;
	}

	/**
	 *  Accounting Manager Tools hub
	 */
	public function actionMngactions()
	{
		if (isset($_POST['btn_close_balance'])) {
			// execute the close accounting balance action
			$rowCount = Invoice::closeLastMonthInvoices();
			$lastMonthLastDate = date('Y-m-d', strtotime("last day of -1 month"));
			echo json_encode(
				[
					'success' => 1,
					'msg' => 'End of ' . $lastMonthLastDate . ' ===> ' . $rowCount . ' invoices have been frozen']
			);
			return;
		}
		$this->render('accounting_mng_actions');
	}

	/**
	 *  sync all with xero
	 */
	public function actionSyncxero()
	{

		// do nothing currently , stop sync with old xero account now
		return;

		// check to see if sync xero switch on or not
		if (Yii::app()->params['settings']['sync_xero_enable']['value'] == 0) {
			$model = new Payment();
			$this->ajaxResult($model, ['id', 'code'], 'sync xero disabled now');
			return;
		}

		include Yii::app()->basePath . DIRECTORY_SEPARATOR . 'commands/XeroCommand.php';
		$newcmd = new XeroCommand(12, 12);
		$newcmd->syncXeroByCall();
		$model = new Invoice();
		$this->ajaxResult($model, ['id', 'code']);
	}

