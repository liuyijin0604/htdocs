				//     $model->sync_xero = 0; // we need re-sync with xero again

				//     $model->total = $tot;
				// }
				if ($model->type == 20) {
					$tot = 0;
					foreach ($model->lines as $il) {
						$pl = $il->mm();
						$items = [];
						$stot = 0;
						foreach ($pl->lines as $l) {
							$p = $l->mm();
							if (in_array($p->status, [100])) {
								continue;
							}
							$rate = $p->getAgentRate(false, false);
							$weight = $p->chargeWeight();
							$typ = $p->goodsType();
							$items[] = [$p->hbn, $p->cnor->name, $weight, $p->cnee->state, $typ, $rate[0], $rate[1]->perkg, $rate[2]];
							$stot += $rate[2];
						}
						$il->amount = $stot;
						$il->mdata['items'] = $items;
						$il->save();
						$tot += $stot;
						$pl->bwf = $pl->bwf | 1;
						$pl->save();
					}
					$model->mdata['name'] = $model->cust->name;
					$model->mdata['address'] = $model->cust->getAddress();
					$model->mdata['payterm'] = empty($model->cust->extra['payterm']) ? 'COD' : $model->cust->extra['payterm'] . ' days';
					$model->due = $model->date; //Invoice::calcDue($r->date, $r->mdata['payterm']);
					$model->status = 2;
					$model->total = $tot;

					// need re-sync with xero
					$model->sync_xero = 0;
					$model->checkPaid();
					$model->save();
				} elseif ($model->type == 100) {
					$org = Org::model()->findByPk($model->to_id);
					$discount = !empty($org->extra['rebate_apply']) ? (100 - floatval($org->extra['rebate_apply'])) / 100 : 1;

					$task = WmsTask::model()->findByPk(substr($model->lines[0]->mdata['items'][0][0], 1));
					$items = [];
					$stot = 0;
					foreach ($task->items as $item) {
						$stock = WmsStock::model()->findByPk($item->mdata['si']);
						if (preg_match('/热敏/', $item->mdata['sn'])) {
							$free = max($task->mdata['thermal_free'], 0);
							if ($item->mdata['uq'] - $free) {
								$items[] = [$task->getNo(), ucwords($task->ref), $task->schd_time, 'CG Delivery - ' . $item->mdata['sn'], round($stock->prod->mdata['price2'] * $discount, 2), ($item->mdata['uq'] - $free), round(($item->mdata['uq'] - $free) * round($stock->prod->mdata['price2'] * $discount, 2), 2)];
							}
							$stot += round(($item->mdata['uq'] - $free) * round($stock->prod->mdata['price2'] * $discount, 2), 2);
							if ($org->extra['thermal'] && $free) {
								$items[] = [$task->getNo(), ucwords($task->ref), $task->schd_time, 'CG Delivery - ' . $item->mdata['sn'] . ' - 免费配送', round(0, 2), $free, round(0, 2)];
							}
						} elseif (preg_match('/缠绕膜/', $item->mdata['sn'])) {
							$free = max($task->mdata['wrapper_free'], 0);
							if ($item->mdata['uq'] - $free) {
								$items[] = [$task->getNo(), ucwords($task->ref), $task->schd_time, 'CG Delivery - ' . $item->mdata['sn'], round($stock->prod->mdata['price2'] * $discount, 2), ($item->mdata['uq'] - $free), round(($item->mdata['uq'] - $free) * round($stock->prod->mdata['price2'] * $discount, 2), 2)];
							}
							if ($org->extra['wrapper'] && $free) {
								$items[] = [$task->getNo(), ucwords($task->ref), $task->schd_time, 'CG Delivery - ' . $item->mdata['sn'] . ' - 免费配送', round(0, 2), $free, round(0, 2)];
							}
							$stot += round(($item->mdata['uq'] - $free) * round($stock->prod->mdata['price2'] * $discount, 2), 2);
						} elseif (preg_match('/透明胶带/', $item->mdata['sn'])) {
							$free = max($task->mdata['tape_free'], 0);
							if ($item->mdata['uq'] - $free) {
								$items[] = [$task->getNo(), ucwords($task->ref), $task->schd_time, 'CG Delivery - ' . $item->mdata['sn'], round($stock->prod->mdata['price2'] * $discount, 2), ($item->mdata['uq'] - $free), round(($item->mdata['uq'] - $free) * round($stock->prod->mdata['price2'] * $discount, 2), 2)];
							}
							if ($org->extra['tape'] && $free) {
								$items[] = [$task->getNo(), ucwords($task->ref), $task->schd_time, 'CG Delivery - ' . $item->mdata['sn'] . ' - 免费配送', round(0, 2), $free, round(0, 2)];
							}
							$stot += round(($item->mdata['uq'] - $free) * round($stock->prod->mdata['price2'] * $discount, 2), 2);
						} else {
							$items[] = [$task->getNo(), ucwords($task->ref), $task->schd_time, 'CG Delivery - ' . $item->mdata['sn'], round($stock->prod->mdata['price'] * $discount, 2), $item->mdata['uq'], round($item->mdata['uq'] * round($stock->prod->mdata['price'] * $discount, 2), 2)];
							$stot += round($item->mdata['uq'] * round($stock->prod->mdata['price'] * $discount, 2), 2);
						}
					}
					if ($task->mdata['freight']) {
						$items[] = [$task->getNo(), ucwords($task->ref), $task->schd_time, 'CG Delivery - Freight fee', $task->mdata['freight'], 1, $task->mdata['freight']];
						$stot += $task->mdata['freight'];
					}

					foreach ($model->lines as $il) {
						$il->amount = $stot;
						$il->mdata['items'] = $items;
						$il->save();
					}
					$model->total = $stot;
					$model->sync_xero = false;
					$model->save();
				}
				break;
		}
		$model->save();
		$this->ajaxResult($model);
	}

