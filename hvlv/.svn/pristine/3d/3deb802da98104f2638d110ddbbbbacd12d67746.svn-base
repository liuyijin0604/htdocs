				$totalAmount += $il->value;
				$totalOurAmount += $il->getMyValue();
				$totalAcceptAmount += min($il->value, $il->getMyValue());
			}
		}
		$xls->addRow($i, array('Total:', '', '', '', '', '', '', $totalAmount, $totalOurAmount, $totalOurAmount - $totalAmount, $totalAcceptAmount));
		$xls->setFont('A' . $i . ':L' . $i, ['bold' => true]);
		$xls->setFont('K' . $i . ':K' . $i, ['color' => ['rgb' => 'ff0000']]);
		$xls->output($mfn . '.xlsx');
	}

	public function actionViewPortInvoiceReconciliation($id)
	{
		$model = PortInvoiceReconciliationLine::model();
		$model->unsetAttributes();
		$model->setAttribute('parent_id', $id);
		if (isset($_GET['PortInvoiceReconciliationLine'])) {
			$model->attributes = $_GET['PortInvoiceReconciliationLine'];
		}
		$this->render('port_invoice_reconciliation_details', ['model' => $model]);
	}

	public function actionViewReconciliation($id)
	{
		$parent = Reconciliation::model()->findByPk($id);
		$model = null;
		if (in_array($parent->getType(), Reconciliation::$declareCourier) || in_array($parent->getType(), Reconciliation::$rtsCourier)) {
			$model = new ReconciliationLineDeclare('search');
		} else {
			$model = new ReconciliationLine('search');
		}

		$model->unsetAttributes();
		if (isset($_GET['ReconciliationLine']) || isset($_GET['ReconciliationLineDeclare'])) {
			$model->attributes = @$_GET['ReconciliationLine'];
			$model->attributes = @$_GET['ReconciliationLineDeclare'];
		}

		$model->setAttribute('parent_id', $id);
		$this->render('reconciliation_details', ['model' => $model]);
	}

	public function actionViewAupostReconciliation($id)
	{
		$rl = ReconciliationLine::model()->find('id = :id', [':id' => $id]);
		if ($rl->postcode == 'eParcel') {
			$temp = [];
			$parents = Reconciliation::model()->findAll('client_type = :type AND manifest_no = :manifest_no', [':type' => Reconciliation::AUPOST_TYPE, ':manifest_no' => $rl->shipment_no]);
			foreach ($parents as $parent) {
				$temp[] = $parent->id;
			}
			$model = new ReconciliationLine('search');
			$ec = new CDbCriteria;
			$ec->addCondition('t.parent_id in (' . implode(',', $temp) . ')');
			$type = Reconciliation::AUPOST_TYPE;
		} else if ($rl->postcode == 'Return to sender') {
			$temp = [];
			$parents = Reconciliation::model()->findAll('client_type = :type AND manifest_no = :manifest_no', [':type' => Reconciliation::AUPOST_RTS, ':manifest_no' => $rl->shipment_no]);
			foreach ($parents as $parent) {
				$temp[] = $parent->id;
			}
			$model = new ReconciliationLine('search');
			$ec = new CDbCriteria;
			$ec->addCondition('t.parent_id in (' . implode(',', $temp) . ')');
			$type = Reconciliation::AUPOST_RTS;
		}
		$this->render('reconciliation_details_aupost', ['model' => $model, 'ec' => $ec, 'manifest_no' => $rl->shipment_no, 'type' => $type]);
	}

