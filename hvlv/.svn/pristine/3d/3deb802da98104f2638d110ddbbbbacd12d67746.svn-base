	public function actionD2zReconciliationDeclare()
	{
		$model = Reconciliation::model();

		if (isset($_POST) && !empty($_POST)) {
			$file = empty($_FILES['inv_file']) ? [] : $_FILES['inv_file'];
			if (empty($file['tmp_name']) || !is_uploaded_file($file['tmp_name'])) {
				$model->addError('id', 'Invalid template file!');
				$this->ajaxResult($model);
			} else {
				$invoice_no = $_POST['invoice_no']; //the first 8 digit of the file Name
				if (empty($invoice_no)) {
					$model->addError('id', 'Invoice No. required!');
					$this->ajaxResult($model);
				}
				$export = empty($_POST['export']) ? false : true;
				$xls = new oExcel();
				$xls->load($file['tmp_name']);
				$data = $xls->getAll();
				unset($data[1]);
				$preData = [];
				$dataCheck = [];
				foreach ($data as $d) {
					if (empty($d[1])) {
						continue;
					}
					$preData[] = $d[1];
					$dataCheck[] = array(1 => $d[1], 2 => $d[1]);
				}
				$errs = array_merge($this->hasAnyD2zShipmentNotExist($dataCheck, 0, $export), $this->hasAnyReconciliationLineNotExist($preData, $invoice_no, Reconciliation::D2Z_DECLARE_TYPE, $export));
				if (!empty($errs)) {
					if ($export) {
						$this->exportErrors($model, $errs);
					} else {
						$model->addError('id', implode("; ", $errs));
						$this->ajaxResult($model);
					}
				}
				$lines = [];
				$consol_ids = [];
				$transaction = Yii::app()->db->beginTransaction();
				try {
					foreach ($data as $d) {
						if (empty($d[1])) {
							continue;
						}
						$shipment = ImParcel::model()->find('(hbn = :hbn OR ref = :ref) AND cbwf & 32768 = 0', [':hbn' => trim($d[2]), ':ref' => substr(trim($d[1]), 0, strlen(trim($d[1])) - 11)]);
						$no = $shipment->ref;
						$weight = floatval($d[3]);
						$declaredWeight = floatval($d[4]);
						$weightDifference = floatval($d[5]);
						$originalCharge = floatval(number_format($d[6] / 1.1, 3, '.', ''));
						$fuelCharge = floatval(number_format($d[8] - $d[7], 3, '.', ''));
						$correctCharge = floatval(number_format($d[8] / 1.1, 3, '.', ''));
						$chargeDifference = floatval(number_format($d[9] / 1.1, 3, '.', ''));

						// $org_rate_id= ImportChargeCode::D2Z_COUNTRY_OLD;
						// if(date('Y-m-d')>'2018-08-20'){
						$d2ztype = "";
						if (isset($shipment->mdata['d2ztype'])) {
							$d2ztype = $shipment->mdata['d2ztype'];
						} else {
							$model->addError('id', 'Shipment No.' . $shipment->ref . ' have not d2ztype!');
							$this->ajaxResult($model);
						}

						$org_rate_id = @ImportChargeCode::$d2z_services["{$d2ztype}"];
						if ($org_rate_id == null) {
							$model->addError('id', 'Shipment No.' . $shipment->ref . ' have not match org_rate in d2z_services!');
							$this->ajaxResult($model);
						}

						// }
						$ourRate = Shipment::getCourierCostByShipment($no, $org_rate_id, $weight);
						$ourRate['consol_id'] = $shipment->consol_id;
						$shipment->mdata['under_declare_cost'] = number_format($chargeDifference, 2, '.', '');
						$shipment->mdata['actual_delivery_cost'] = $correctCharge;
						$shipment->updateMeta();
						$consoleId = $shipment->consol_id;
						if ($consoleId > 0 && !in_array($consoleId, $consol_ids)) {
							$consol_ids[] = $consoleId;
						}
						$lines[] = [$no, '', '', $weight, $declaredWeight, $ourRate, $weightDifference, $originalCharge, $correctCharge, $chargeDifference, $fuelCharge];
					}
					$transaction->commit();
				} catch (Exception $ex) {
					$transaction->rollback();
					throw $ex;
				}
				unset($data);
				unset($shipment);

				$recModel = Reconciliation::model()->find('invoice_no = :invno AND client_type=:type', [':invno' => $invoice_no, ':type' => Reconciliation::D2Z_DECLARE_TYPE]);
				if (empty($recModel)) {
					// create reconsiliation now
					$recModel = new Reconciliation();
					$recModel->client_type = Reconciliation::D2Z_DECLARE_TYPE;
					$recModel->invoice_no = $invoice_no;
					$recModel->invoice_date = $_POST['invoice_issue_date'];
					$recModel->invoice_total = 0; // first saved with zero will update after all lines
					$recModel->my_total = 0; // first saved with zero will update after all lines
					$recModel->save();
				}
				$total = 0;
				$ourTotal = 0;
				$transaction = Yii::app()->db->beginTransaction();
				try {

					foreach ($lines as $line) {
						$recData = ReconciliationLineDeclare::model()->find('shipment_no = :sno', [':sno' => $line[0]]);
						if (empty($recData)) {
							$recData = new ReconciliationLineDeclare();
						}
						$recData->invoice_no = $invoice_no; // for aupost we use invoice_no field to save console number
						$recData->parent_id = $recModel->id;
						$recData->weight = number_format($line[3], 2, '.', '');
						$recData->my_value = !empty($recData->consol_id) ? number_format($line[5]['price'], 2, '.', '') : 0;
						$recData->mdata['declaredWeight'] = $line[4];
						$recData->mdata['weightDifference'] = $line[6];
						$recData->mdata['originalCharge'] = $line[7];
						$recData->mdata['correctCharge'] = $line[8];
						$recData->mdata['chargeDifference'] = $line[9];

						$oRecData = ReconciliationLine::model()->find('shipment_no = :sno', [':sno' => $line[0]]);
						$recData->postcode = $oRecData->postcode;
						$recData->shipment_no = $oRecData->shipment_no;
						$recData->cdeadwt = $oRecData->cdeadwt;
						$recData->my_charge = $oRecData->my_charge;
						$recData->manifest_weight = $oRecData->manifest_weight;
						$recData->our_charge_weight = $oRecData->our_charge_weight;
						$recData->cust_check_weight = $oRecData->cust_check_weight;
						$recData->courier_cubic = $oRecData->courier_cubic;
						$recData->consol_id = $oRecData->consol_id;
						$recData->mdata['total_invoice'] = $recData->value+@$oRecData->mdata['fuel_charge'];
						$recData->mdata['fuel_charge'] = $line[10];
						$recData->mdata['was_weight'] = $oRecData->weight;
						$recData->value = number_format($line[8], 2, '.', '');
						$recData->my_value_m = $oRecData->my_value_m;
						$recData->client_type = Reconciliation::D2Z_DECLARE_TYPE;
						$recData->save();
						//$recData->getChargeWeightDiff(true);
						$total += $recData->value;
						$ourTotal += $line[5]['price'];
					}

					// update reconciliation total now
					$recModel->invoice_total = $total;
					$recModel->my_total = $ourTotal;
					$recModel->update(['invoice_total', 'my_total']);

					$transaction->commit();
				} catch (Exception $ex) {
					$transaction->rollback();
					throw $ex;
				}

				foreach ($consol_ids as $cid) {
					$consol = Consol::model()->findByPk($cid);
					if (!empty($consol)) {
						$consol->updateCourierRealCost(Org::ORGID_COURIER_D2Z, "33A8Y\d{7}|ZK6\d{7}|33PET\d{7}|33PEN\d{7}|33PEH\d{7}|SJU\d{7}|33G7K\d{7}|33G7L\d{7}|33A93\d{7}", true);
					}
				}
			}

			$this->ajaxResult($model, ['id']);
		}
		$this->render('reconciliation_d2z_declare', ["type" => "Declare"]);
	}

	public function actionD2zReconciliationRTS()
	{
		$model = Reconciliation::model();

		if (isset($_POST) && !empty($_POST)) {
			$file = empty($_FILES['inv_file']) ? [] : $_FILES['inv_file'];
			if (empty($file['tmp_name']) || !is_uploaded_file($file['tmp_name'])) {
				$model->addError('id', 'Invalid template file!');
				$this->ajaxResult($model);
			} else {
				$invoice_no = $_POST['invoice_no']; //the first 8 digit of the file Name
				if (empty($invoice_no)) {
					$model->addError('id', 'Invoice No. required!');
					$this->ajaxResult($model);
				}
				$export = empty($_POST['export']) ? false : true;
				$xls = new oExcel();
				$xls->load($file['tmp_name']);
				$data = $xls->getAll();
				unset($data[1]);
				$preData = [];
				$dataCheck = [];
				foreach ($data as $d) {
					if (empty($d[1])) {
						continue;
					}
					$preData[] = $d[1];
					$dataCheck[] = array(1 => $d[1], 2 => $d[1]);
				}
				$errs = array_merge($this->hasAnyD2zShipmentNotExist($dataCheck, Reconciliation::D2Z_RTS_TYPE, $export));
				if (!empty($errs)) {
					if ($export) {
						$this->exportErrors($model, $errs);
					} else {
						$model->addError('id', implode("; ", $errs));
						$this->ajaxResult($model);
					}
				}
				$lines = [];
				$consol_ids = [];
				$transaction = Yii::app()->db->beginTransaction();
				try {
					foreach ($data as $d) {
						if (empty($d[1])) {
							continue;
						}
						$shipment = ImParcel::model()->find('(hbn = :hbn OR ref = :ref) AND cbwf & 32768 = 0', [':hbn' => trim($d[2]), ':ref' => substr(trim($d[1]), 0, strlen(trim($d[1])) - 11)]);
						$no = $shipment->ref;
						$weight = 0; //coureir chargeweight;
						$value = floatval(number_format($d[7] / 1.1, 3, '.', ''));
						$fuel_charge = floatval(number_format($d[6] / 1, 3, '.', ''));
						$RTS_fee = floatval(number_format($d[4] / 1.1, 3, '.', ''));
						$RTS_fee_exclude_GST = 0;
						$postcode = $shipment->cnee->postcode;
						if ($RTS_fee <= 0) {
							continue;
						}
						$shipment->mdata['RTS_cost'] = number_format($value, 2, '.', '');
						$shipment->updateMeta();
						$consoleId = $shipment->consol_id;
						if ($consoleId > 0 && !in_array($consoleId, $consol_ids)) {
							$consol_ids[] = $consoleId;
						}
						$lines[] = [$no, '', '', $value, $fuel_charge, $RTS_fee, $RTS_fee_exclude_GST, $postcode, $consoleId];
					}
					$transaction->commit();
				} catch (Exception $ex) {
					$transaction->rollback();
					throw $ex;
				}
				unset($data);
				unset($shipment);
				$reType = Reconciliation::D2Z_RTS_TYPE;
				$recModel = Reconciliation::model()->find('invoice_no = :invno AND client_type=:type', [':invno' => $invoice_no, ':type' => $reType]);
				if (empty($recModel)) {
					// create reconsiliation now
					$recModel = new Reconciliation();
					$recModel->client_type = $reType;
					$recModel->invoice_no = $invoice_no;
					$recModel->invoice_date = $_POST['invoice_issue_date'];
					$recModel->invoice_total = 0; // first saved with zero will update after all lines
					$recModel->my_total = 0; // first saved with zero will update after all lines
					$recModel->save();
				}
				$total = 0;
				$ourTotal = 0;
				$transaction = Yii::app()->db->beginTransaction();
				try {

					foreach ($lines as $line) {
						$total += $line[3];
						$ourTotal += $line[3];
						$recData = ReconciliationLineDeclare::model()->find('shipment_no = :sno and client_type = :type', [':sno' => $line[0], ':type' => $reType]);
						if (empty($recData)) {
							$recData = new ReconciliationLineDeclare();
						}
						$recData->invoice_no = $invoice_no; // for aupost we use invoice_no field to save console number
						$recData->parent_id = $recModel->id;
						$recData->consol_id = $line[8];
						$recData->weight = 0;
						$recData->value = $line[3];
						$recData->my_value = $line[3];
						$recData->mdata['fuel_charge'] = $line[4];
						$recData->mdata['RTS_fee'] = $line[5];
						$recData->mdata['RTS_fee_exclude_GST'] = $line[6];
						$recData->shipment_no = $line[0];
						$recData->postcode = $line[7];
						$recData->client_type = $reType;
						$recData->save();
					}
					// update reconciliation total now
					$recModel->invoice_total = $total;
					$recModel->my_total = $ourTotal;
					$recModel->update(['invoice_total', 'my_total']);
					$transaction->commit();
				} catch (Exception $ex) {
					$transaction->rollback();
					throw $ex;
				}

				foreach ($consol_ids as $cid) {
					$consol = Consol::model()->findByPk($cid);
					if (!empty($consol)) {
						$consol->updateCourierRealCost(Org::ORGID_COURIER_D2Z, "33A8Y\d{7}|ZK6\d{7}|33PET\d{7}|33PEN\d{7}|33PEH\d{7}|SJU\d{7}|33G7K\d{7}|33G7L\d{7}|33A93\d{7}", false, true);
					}
				}
			}

			$this->ajaxResult($model, ['id']);
		}
		$this->render('reconciliation_d2z_declare', ["type" => "RTS"]);
	}

	private function exportErrors($model, $errs)
	{
		$xls = new oExcel;
		$mfn = 'Reconciliation_import_errors';
		$i = 1;
		$xls->addRow($i++, ['Ref', 'Description']);
		$xls->setFont('A1:J1', ['bold' => true]);
		foreach ($errs as $err) {
			$xls->addRow($i++, [$err['ref'], $err['description']]);
		}
		$tempfile = Yii::app()->basePath . DIRECTORY_SEPARATOR . "runtime" . DIRECTORY_SEPARATOR . $mfn . '.xlsx';
		$xls->output($tempfile, null, false);
		$dlUrl = $this->createUrl('invoice/downloadErrResult');
		$resp = '<span>Error File is ready , Please <a href="' . $dlUrl . '" target="_blank">click me</a> to download now<span>';
		$model->addError($resp, $resp);
		$this->ajaxResult($model);
	}

	public function actionDownloadErrResult()
	{
		$xls = new oExcel;
		$mfn = 'Reconciliation_import_errors';
		$tempfile = Yii::app()->basePath . DIRECTORY_SEPARATOR . "runtime" . DIRECTORY_SEPARATOR . $mfn . '.xlsx';
		$xls->load($tempfile);
		$xls->output($mfn . '.xlsx');
	}

	public function actionCreateSupayForInvoices()
	{
		if (empty($_POST)) {
			$this->render('create_supay_for_invoices');
		} else {
			if (empty($_POST['nos'])) {
				echo json_encode(['done' => false, 'msg' => 'Invoice no(s) is empty']);
				Yii::app()->end();
			} else {
				$ns = preg_split('/[\s,;]+/', trim($_POST['nos']));
				if (sizeof($ns) > 1000) {
					$ns = array_slice($ns, 0, 1000);
				}
				$total = 0;
				foreach ($ns as $n) {
					$inv = Invoice::model()->find('no = :no', [':no' => $n]);
					if (empty($inv)) {
						echo json_encode(['done' => false, 'msg' => 'Invoice ' . $n . ' is not found']);
						Yii::app()->end();
					} else if (!in_array($inv->status, [2, 3])) {
						echo json_encode(['done' => false, 'msg' => 'Invoice ' . $n . ' status is not Posted or Overdue']);
						Yii::app()->end();
					}
					$total += $inv->total;
				}
				if (Yii::app()->name == 'TLA') {
					$supay = new SupayAPI(Yii::app()->request->hostInfo . $this->createUrl('supay/supay'),
						'',
						'72795',
						'lkjh678jGQDJokl9XQHaHIyfuytttqqq'
					);
				}else{
					$supay = new SupayAPI(Yii::app()->request->hostInfo . $this->createUrl('supay/supay'));
				}
				$supay_invoices_id = 'SUPAY' . time();
				$ref = 'invoice ' . implode(',', $ns);
				if ($_POST['act_btn'] == 'WechatPay') {
					$url = $supay->checkoutByWechatPay($ref, $supay_invoices_id, 'AUD', round($total * 1, 2));
				} else if ($_POST['act_btn'] == 'AliPay') {
					$url = $supay->checkoutByAliPay($ref, $supay_invoices_id, 'AUD', round($total * 1, 2));
				}

				if (!empty($url)) {
					foreach ($ns as $n) {
						$inv = Invoice::model()->find('no = :no', [':no' => $n]);
						$inv->mdata['supay_invoices_id'] = $supay_invoices_id;
						$inv->save();
					}

					echo json_encode(['done' => true, 'msg' => 'Successfully', 'url' => $url]);
				} else {
					echo json_encode(['done' => false, 'msg' => 'Failed']);
				}
			}
		}
	}

	public function actionExportAupostReconciliation()
	{
		$from = $_GET['from'];
		$to = $_GET['to'];
		$shipments = [];
		$rls = ReconciliationLine::model()->with('parent', 'shipment')->findAll('parent.client_type = 1 AND shipment.created >= :from AND shipment.created <= :to', [':from' => $from, ':to' => $to]);
		foreach ($rls as $rl) {
			if (empty($shipments[$rl->shipment_id])) {
				$shipments[$rl->shipment_id] = ['act' => 0, 'mani' => $rl->shipment->mdata['manifest_weight'], 'client' => $rl->shipment->weight, 'pkg' => 0];
			}
			$shipments[$rl->shipment_id]['act'] += $rl->cdeadwt;
			$shipments[$rl->shipment_id]['pkg'] += 1;
		}

		$out = new oExcel;
		$i = 1;
		$out->addRow($i++, ['Reference', 'Dpmt', 'Actual Weight', 'Manifest Weight', 'Client Weight', 'Pkg', 'Total Pkg', 'Charge (Actual)', 'Charge (Manifest)', 'Charge (Client)']);
		$rates = [];
		foreach ($shipments as $id => $shipment) {
			$p = ImParcel::model()->findByPk($id);
			if (!empty($p->consol) && preg_match('/3PL/', $p->consol->no)) {
				continue;
			}

			$ref = $p->ref;
			$act = $shipment['act'];
			$mani = $shipment['mani'];
			$client = $shipment['client'];
			$pkg = $shipment['pkg'];

			if (!empty($rates[$p->agent_id])) {
				$orgRate = $rates[$p->agent_id];
			} else {
				$orgRate = OrgRate::model()->find('type = 40 and org_id = :oid', [':oid' => $p->agent_id]);
				$rates[$p->agent_id] = $orgRate;
			}

			if ($p->pkg > $pkg) {
				$p->weight = $act / $pkg * $p->pkg;
				$act = $act . ' / ' . number_format($act / $pkg * $p->pkg, 2, '.', '');
			} else {
				$p->weight = $act;
			}
			$act_value = $p->getChargePro($p->agent, $orgRate, false);
			$p->weight = $mani;
			$mani_value = $p->getChargePro($p->agent, $orgRate, false);
			$p->weight = $client;
			$client_value = $p->getChargePro($p->agent, $orgRate, false);

			$out->addRow($i++, [$ref, $dpmt, $act, $mani, $client, $pkg, $p->pkg, $act_value, $mani_value, $client_value, $p->created]);
		}

		$out->output($from . $to . '.xlsx');
	}

	public function actionToolsInvoiceDiff()
	{
		// print_r($_FILES);
		// print_r($_POST);
		// return;
		if(!empty($_FILES))
		{
			$invoiceService = new InvoiceService();
			$error = $invoiceService->exportingInvoiceDiff();
			if($error!==true&&$error[0]!=1)
			{
				echo json_encode(['msg'=>join(';',$error)]); 
			}else
			{
				if(is_array($error))
				{
					$dlUrl =  $this->createUrl('invoice/downloadInvoiceDiff');
					$msg = '<span> There are '.count($error[1]).' empty records in the imported file and File is ready , Please <a href="'.$dlUrl.'" target="_blank">click me</a> to download now<span>';
					echo json_encode(['msg'=>$msg]); 
				}else
				{
					$dlUrl =  $this->createUrl('invoice/downloadInvoiceDiff');
					$msg = '<span>File is ready , Please <a href="'.$dlUrl.'" target="_blank">click me</a> to download now<span>';
					echo json_encode(['msg'=>$msg]); 
				}
			}

		}else
		{
			$this->render('tools_invoice_diff');
		}
	}

	public function actionDownloadInvoiceDiff()
	{
		$xls = new oExcel;
		$mfn = 'invoice_diff_export';
		$tempfile = Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR.$mfn.'.xlsx';
		$xls->load($tempfile);
		$xls->output($mfn.'.xlsx');
	}

	/**
	 *edit Statement Email
	 * @param Integer $id
	 */
	public function actionEditStatementEmail()
	{
		$orgId = $_GET['agent_id'];
		$org = Org::model()->findByPk($orgId);
		$model = new Emailog();
		$email = new ImportsMail('search');
		if (isset($_POST['Emailog'])) {
			$_POST['email'] = 1;
			$_GET['type'] = 'rcvb';
			foreach (json_decode($_POST['data'],true) as $key => $value) {
				$_POST[$key] = $value;
			}
			$_POST['rptyp'] = 'pdfnew';
			$pdfFile = $this->actionReport();
			if(!is_array($pdfFile))
			{
				$model->addError('id',$pdfFile);
				$this->ajaxResult($model);
				return;
			}
			$_POST['rptyp'] = 'xlsnew';
			$excelFile = $this->actionReport();
			if(!is_array($excelFile))
			{
				return;
			}
			$files =[$pdfFile,$excelFile];
			//                var_dump($_POST['ReplyEmail']);return;
			$model->attributes = $_POST['Emailog'];
			foreach ($_POST['mdata'] as $k => $v) {
				$model->mdata[$k] = $v;
			}
			$model->save();
			// if (!empty(Yii::app()->session['uploads'][$_POST['ppupload']][2])) {
			// 	foreach (Yii::app()->session['uploads'][$_POST['ppupload']][2] as $fid) {
			// 		$fr = FileRepo::model()->findByPk($fid);
			// 		$fr->fid = $model->id;
			// 		$fr->save();
			// 	}
			// }
			$o = $model->sendEmail($files);
			if ($model->status != 1) {
				$model->addError('id', $o['msg']);
			}

			$this->ajaxResult($model);
		}
		$model->type= Emailog::INVOICE_STATEMENT;
		$model->status=10;
		$model->to_id=$orgId;
		$model->dt = date('Y-m-d H:i:s');
		$model->prepTemplate();
		$model->subject = $model->tpl->subject;
		$model->body = $model->tpl->getContent();
		$model->mdata['fromName']='TLA Finance';
		$model->mdata['from']='finance@toplogistics.com.au';
		$model->mdata['cc']='finance@toplogistics.com.au';

		$allEmailReply = explode(';', $org->extra["client_billing_email"]);
		$model->mdata['to'] = $allEmailReply[0];
		$allCCEmail = [];
		$ccEmails = explode(';', $model->mdata['cc']);
		foreach ($ccEmails as $key => $value) {
			$allCCEmail[] = $value;
		}
		if(count($allEmailReply)>1)
		{
			unset($allEmailReply[0]);
			foreach ($allEmailReply as $key => $value) {
				$allCCEmail[] = $value;
			}
		}
		$model->mdata['cc'] = join(';',$allCCEmail);
		$this->render('edit_statement_email', ['model' => $model,'data'=>json_encode($_GET)]);
	}



	public function init()
	{
		if (!empty($_SERVER['REQUEST_URI']) && preg_match('/\/ReconciliationNew|\/FastwayReconciliationNew|\/AupostReconciliation|\/StartrackReconciliation|\/TntReconciliation/i', $_SERVER['REQUEST_URI']) && !empty($_POST)) {
			$ifUploadingManifest = Yii::app()->cache->get('ifUploadingManifest');
			if ($ifUploadingManifest) {
				$model = new Reconciliation;
				$model->addError('id', 'Another courier invoice is being uploaded');
				$this->ajaxResult($model);
			} else {
				Yii::app()->cache->set('ifUploadingManifest', true);
			}
		}
		return parent::init();
	}

	public function ajaxResult($model, $attr=[], $msg='')
	{
		if (!empty($_SERVER['REQUEST_URI']) && preg_match('/\/ReconciliationNew|\/FastwayReconciliationNew|\/AupostReconciliation|\/StartrackReconciliation|\/TntReconciliation/i', $_SERVER['REQUEST_URI'])) {
			Yii::app()->cache->set('ifUploadingManifest', false);
		}
		return parent::ajaxResult($model, $attr, $msg);
	}

	public function actionGenerateShipmentDdpDduInvoice()
	{
		$shipmentId = $_POST['shipmentId'];
		$checkToDate = !empty($_POST['checkToDate'])?$_POST['checkToDate']:"";
		$invoiceShows = !empty($_POST['invoiceShows'])?$_POST['invoiceShows']:"";
		$p = ImParcel::model()->findByPk($shipmentId);
		$imparcelService = new ImParcelService();
        if(($p->bwf&ImParcel::CUSTOM_DDP)>0||(($p->bwf & ImParcel::CUSTOM_DDU) > 0 && empty($p->process)))
        {
        	if(($p->bwf&ImParcel::CUSTOM_DDP)>0)
        	{
        		$invoice = $imparcelService->createStorageInvoice($p, 0,$checkToDate,true);
        	}elseif(($p->bwf & ImParcel::CUSTOM_DDU) > 0 )
        	{
        		$invoice = $imparcelService->createStorageInvoice($p, 0,$checkToDate,true,Org::ORGID_IMPORT_CASUAL_CUSTOMER);
        	}
        	
        	if(!empty($invoice->id))
        	{
        		echo '{"status":1,"msg":"","invoiceId":"'.$invoice->id.'"}';
        	}else
        	{
        		echo '{"status":0,"msg":"Generate DDP Invoice failed,'.@$invoice.'"}';
        	}
        	return;
        }else if(($p->bwf&ImParcel::CUSTOM_DDU)>0)
        {
        	$reply = $p->createStorageInvoiceWhenDdu(false,$checkToDate,$invoiceShows,true);
        }
        echo json_encode($reply);
        return;
	}

	public function actionImportExcelInv()
	{
		Yii::app()->name = "TLA";
		if(empty($_POST))
		{
			$this->render('import_excel_inv');
			return;
		}

		$file = $_FILES['inv_file'];
		$invoiceDate = $_POST['invoice_date'];
		$orgId = @$_POST['org_id'];
		$invoiceService = new InvoiceService();
		$result = $invoiceService->importExcelInv($file,$invoiceDate,$orgId);
		echo json_encode($result);
		return;

	}

	public function actionImportInboundTransactions()
	{
		Yii::app()->name = "TLA";
		if(empty($_POST))
		{
			$this->render('import_inbound_transactions');
			return;
		}

		$file = $_FILES['transaction_file'];
		$invDate = $_POST['invoice_date'];
		$dateFrom = date('y-m-01', strtotime($invDate));
		$dateTo = date('y-m-t', strtotime($invDate));
		$res = new stdClass;
		$res->done = true;
		$res->msg = "Upload Success";
		$invoiceService = new InvoiceService();
		$data = $invoiceService->importInboundTransaction($file);
		$res->processedData = $invoiceService->processInboundTransaction($data, $dateFrom, $dateTo);
		$res->statisticsData = $invoiceService->createInboundBookingInvoice($res->processedData->data, $dateTo);
		echo json_encode($res);

		//$result = $invoiceService->importExcelInv($file,$invoiceDate,$orgId);
		//echo json_encode($result);
		return;
	}


	

	/**
	 * Returns the data model based on the primary key given in the GET variable.
	 * If the data model is not found, an HTTP exception will be raised.
	 * @param integer the ID of the model to be loaded
	 */
	public function loadModel($id)
	{
		if($id >= 500000){
			$app_name = Yii::app()->name;
			Yii::app()->name = 'TLA';
		}
		$model = Invoice::model()->findByPk($id);
		if ($model === null) {
			throw new CHttpException(404, 'The requested page does not exist.');
		}
		return $model;
	}

	/**
	 * Performs the AJAX validation.
	 * @param CModel the model to be validated
	 */
	protected function performAjaxValidation($model)
	{
		if (isset($_POST['ajax']) && $_POST['ajax'] === 'invoice-form') {
			echo CActiveForm::validate($model);
			Yii::app()->end();
		}
	}
}
