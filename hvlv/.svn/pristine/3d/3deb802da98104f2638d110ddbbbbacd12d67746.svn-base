	public function actionPortInvoiceReconciliationNew()
	{
		$model = PortInvoiceReconciliation::model();

		if (isset($_POST) && !empty($_POST)) {
			$inv_file = empty($_FILES['inv_file']) ? [] : $_FILES['inv_file'];
			if (empty($inv_file['tmp_name']) || !is_uploaded_file($inv_file['tmp_name'])) {
				$model->addError('id', 'Invalid teplate file');
				$this->ajaxResult($model);
			} else {
				// check to see if the same reconciliation existing or not
				$invoiceRef = $_POST['ref'];
				$existing = PortInvoiceReconciliation::model()->find('invoice_ref = :invno', [':invno' => $invoiceRef]);
				if (!empty($existing)) {
					if (isset($_POST['replace']) && $_POST['replace'] == 1) {
						// delete all old one
						PortInvoiceReconciliationLine::model()->deleteAll('parent_id = :pid', [':pid' => $existing->id]);
						$existing->delete();
						$existing = null;
					}
				}
				if (empty($existing)) {
					$xls = new oExcel();
					$xls->supported($inv_file['name']);
					$xls->load($inv_file['tmp_name']);
					$data = $xls->getAll();
					unset($data[1]);
					unset($data[2]);

					$total = 0;
					$weight = 0;
					$duplicate_count = 0;
					$notexisting_count = 0;

					// create reconsiliation now
					$pModel = new PortInvoiceReconciliation();
					$pModel->invoice_ref = $invoiceRef;
					$pModel->created = date('Y-m-d');
					$pModel->save();
					$errors = $pModel->getErrors();
					if (empty($errors)) {
						foreach ($data as $k => $line) {
							$connote = trim($line[2]);
							if (empty($connote)) {
								continue;
							}

							// check to see if the same connote existing in the current invoice
							// in the case , we set duplication count in meta field
							$recData = PortInvoiceReconciliationLine::model()->find('parent_id = :pid and connote = :cno', [':pid' => $pModel->id, ':cno' => $connote]);
							if (empty($recData)) {

								// get related consol
								$shipment = ExParcel::model()->find('ref = :ref', [':ref' => $connote]);

								$recData = new PortInvoiceReconciliationLine();
								$recData->parent_id = $pModel->id;
								$recData->date = (floatval($line[1]) - 25569) * 86400;
								$recData->date = date('Y-m-d', $recData->date);
								$recData->connote = $connote;
								$recData->destination = $line[3];
								$tWeight = floatval($line[4]);
								$tAmount = floatval($line[5]);
								$recData->weight = number_format($tWeight, 2, '.', '');
								$recData->amount = number_format($tAmount, 2, '.', '');
								$recData->mdata['invoice_ref'] = $invoiceRef;

								if (!empty($shipment)) {
									$recData->mdata['consol'] = !empty($shipment->consol) ? $shipment->consol->no : ''; // save related console now
								} else {
									$recData->mdata['notfound'] = 1; // the connote not existing in HVLV
									$notexisting_count++;
								}

								$weight += $tWeight;
								$total += $tAmount;
								$recData->save();
							} else {
								if (isset($recData->mdata['dup_count'])) {
									$recData->mdata['dup_count'] = intval($recData->mdata['dup_count']) + 1;
								} else {
									$recData->mdata['dup_count'] = 1;
								}
								$duplicate_count++;
								$recData->updateMeta();
							}

							// check to see if the same connote existing in the another invoice
							$existingModel = PortInvoiceReconciliationLine::model()->findAll('parent_id != :pid and connote = :cno', [':pid' => $pModel->id, ':cno' => $connote]);
							if (!empty($existingModel)) {
								if (isset($recData->mdata['dup_count'])) {
									$recData->mdata['dup_count'] = intval($recData->mdata['dup_count']) + 1;
								} else {
									$recData->mdata['dup_count'] = 1;
								}
								$duplicate_count++;

								$invoiceRefs = isset($recData->mdata['invoice_ref']) ? $recData->mdata['invoice_ref'] : '';
								// save duplicate invoice ref
								foreach ($existingModel as $m) {
									if (!empty($invoiceRefs)) {
										$invoiceRefs .= ',';
									}
									$invoiceRefs .= $m->parent->invoice_ref;
								}
								$recData->mdata['invoice_ref'] = $invoiceRefs;
								$recData->updateMeta();
							}

							$tmpErros = $recData->getErrors();
							if (!empty($tmpErros)) {
								$tmpErros[] = $connote . ' w : ' . $recData->weight;
								$errors = $tmpErros;
								break;
							}
						}

						$pModel->amount = number_format($total, 2, '.', '');
						$pModel->weight = number_format($weight, 2, '.', '');
						$pModel->notexisting_count = $notexisting_count;
						$pModel->duplicate_count = $duplicate_count;
						$pModel->update(['amount', 'weight', 'duplicate_count', 'notexisting_count']);
					}

					if (!empty($errors)) {
						$model->addErrors($errors);
					}
				} else {
					$model->addError('id', 'Sorry the invoice : ' . $invoiceRef . ' has been reconciled before, if you want to replace it , please tick the replace checkbox');
				}
				$this->ajaxResult($model, ['id']);
			}
		}
		$this->render('port_invoice_reconciliation_new');
	}

