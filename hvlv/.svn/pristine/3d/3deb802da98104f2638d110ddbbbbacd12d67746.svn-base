<?php

class InvoiceController extends Controller
{
	protected $nonAjax = ['print', 'detail', 'export', 'notes', 'report', 'download', 'pay', 'poli', 'log', 'reconciliationExport', 'reconciliationExport2', 'portInvoiceReconciliationExport', 'makesupay', 'exportStartractWeightDiff', 'exportReconciliation', 'genStateManual', 'genStateManualExcel', 'downloadErrResult', 'exportManifestAmountDiff', 'exportAupostReconciliation','downloadInvoiceDiff'];

	private function createInvoiceLine($a,$ccode,$det,$tax,$rebate,$qty,$linkto,$pid = 0)
	{
		$il = new InvLine;
		$il->ccode = $ccode;
		$il->det = $det;
		$il->tax = $tax;
		$il->rebate = $rebate;
		$il->linkto = $linkto;
		$il->amount = $a;
		$gst = 0;
		if ($il->tax == 'OUTPUT') {
			$gst = floatval($il->amount) * 10 / 100;
		}
		$il->amount += $gst;
		$il->gst = $gst;
		$il->qty = $qty;
		if($pid>0)
		{
			$il->fid = $pid;
			$il->model="ImParcel";
		}
		// // linked invoice line with related console if needed
		// if (!empty($console)) {
		// 	$il->fid = $console->id;
		// 	$il->model = $console->getType();
		// }
		return $il;
	}
	/**
	 * Displays a particular model.
	 * @param integer $id the ID of the model to be displayed
	 */

	public function actionCreate()
	{
		$model = new Invoice('create');
		$model->type = $_GET['type'];
		$model->currency = 1;
		$psId = [];

		if (isset($_POST['Invoice'])) {
			$dpmt = isset($_POST['Invoice']['dpmt']) ? $_POST['Invoice']['dpmt'] : 0;
			if ($dpmt <= 0) {
				$model->addError('dpmt', 'Invoice Department is mandatory!');
				$this->ajaxResult($model, ['id']);
			}
			if (!is_array($_POST['InvLine']['amount'])) {
				$model->addError('id', 'Invoice lines are empty!');
				$this->ajaxResult($model, ['id']);
			}

			$consoleNo = '';
			$consolId = 0;
			if (isset($_POST['consolno'])) {
				$consoleNo = trim($_POST['consolno']);
			}
			if (!empty($consoleNo)) {
				$console = Consol::model()->find('no = :no', [':no' => $consoleNo]);
			}


			if(empty($console))
			{
				if (!empty($_POST['consolno'])) {
					$model->addError('dpmt', 'Consol No is incorrect!');
					$this->ajaxResult($model, ['id']);
				}
			}else
			{
				$consolId = $console->id;
			}


			// invoice data processing
			$invoiceLine = [];
			foreach ($_POST['InvLine']['amount'] as $i => $a) {
				if(empty($_POST['InvLine']['linkto'][$i]))
				{
					if(!empty($a))
					{
						$il = $this->createInvoiceLine($a,
							$_POST['InvLine']['ccode'][$i],
							$_POST['InvLine']['det'][$i],
							$_POST['InvLine']['tax'][$i],
							$_POST['InvLine']['rebate'][$i],
							$_POST['InvLine']['qty'][$i],"");
						$invoiceLine[$consolId][] = $il;
					}
				}else
				{
					if(!empty($a))
					{
						$refs = explode(";",$_POST['InvLine']['linkto'][$i]);
						foreach ($refs as $l => $v) {
							$refs[$l] = trim($refs[$l]);
							if(empty(trim($v)))
							{
								unset($refs[$l]);
							}
						}

						$ps = ImParcel::model()->findAll("(ref in ('".join("','",$refs)."') or hbn in ('".join("','",$refs)."') or cref in ('".join("','",$refs)."') ) and status !=100");
						if(empty($ps))
						{
							$model->addError('consol_id', 'Can\'t find linkto shipments');
							$this->ajaxResult($model, ['id']);
						}

						$totalWeight = array_sum(array_column($ps,'weight'));
						$size = count($ps);
						$untilAmount = 0;
						foreach ($ps as $key => $p) {
							if($key+1 == $size)
							{
								$thisAmount = $a-$untilAmount;
							}else
							{
								$thisAmount = number_format(($p->weight/$totalWeight)*$a,2,'.','');
							}

							$untilAmount+=$thisAmount;
							$il = $this->createInvoiceLine($thisAmount,
							$_POST['InvLine']['ccode'][$i],
							$_POST['InvLine']['det'][$i]." for ".$p->ref,
							$_POST['InvLine']['tax'][$i],
							$_POST['InvLine']['rebate'][$i],
							$_POST['InvLine']['qty'][$i],$p->ref,$p->id);
							$invoiceLine[$p->consol_id][] = $il;
							$psId[$p->id] = $p->id;
						}
					}
				}
			}

			foreach ($invoiceLine as $consolId => $lines) {
				$total = 0;
				$tgst = 0;
				$model = new Invoice('create');
				$model->type = $_GET['type'];
				$model->currency = 1;
				$model->attributes = $_POST['Invoice'];
				$model->status = 1;
				$awb = '';
				$model->consol_id = $consolId;
				$awb = "";
				if(!empty($consolId))
				{
					$consol  = Consol::model()->findByPk($consolId);
					$awb = $consol->awb;
				}
				if(count($psId)==1)
				{
					$model->pid = join("",$psId);
				}
				$model->save();
				foreach ($lines as $lk => $il) {
					$il->inv_id = $model->id;
					$il->save();
					$total += $il->amount * $il->qty;
					$tgst += $il->gst * $il->qty;
				}
				$model->total = number_format($total, 2, '.', '');
				$model->gst = number_format($tgst, 2, '.', '');
				$model->mdata['awb'] = $awb;
				$model->mdata['name'] = $model->cust->name;
				$model->mdata['address'] = $model->cust->getAddress();
				$model->mdata['payterm'] = empty($model->cust->extra['payterm']) ? 'COD' : $model->cust->extra['payterm'] . ' days';
				$model->save();
			}

			$this->ajaxResult($model, ['id']);
		}

		$model->date = date('Y-m-d');
		$model->due = date('Y-m-d');
		$this->render('create', ['model' => $model]);
	}
	/**
	 * upload startrack courier cost
	 *
	 */
	public function actionStartrackReconciliation()
	{
		$model = Reconciliation::model();
		if (isset($_POST) && !empty($_POST)) {
			$file = empty($_FILES['inv_file']) ? [] : $_FILES['inv_file'];
			if (empty($_POST['invoice_issue_date']) || !preg_match("/\d{4}-\d{2}-\d{2}/", $_POST['invoice_issue_date'])) {
				$model->addError('id', 'Please input the valid issue date!');
				$this->ajaxResult($model);
			}
			if (empty($file['tmp_name']) || !is_uploaded_file($file['tmp_name'])) {
				$model->addError('id', 'Invalid template file!');
				$this->ajaxResult($model);
			} else {
				$invoice_no = $_POST['invoice_no']; //the first 8 digit of the file Name
				if (empty($invoice_no)) {
					$model->addError('id', 'Invoice No. required!');
					$this->ajaxResult($model);
				}
				$allData = $this->getStartrackFileContent($file['tmp_name']);
				$data = $allData['parcel'];
				//no=>7RFZ    cubic, chargeweight, charge
				// $errs = $this->hasAnyShipmentNotExist($data);
				$errs = [];
				$preData = [];
				foreach ($data as $d) {
					if (empty($d['no'])) {
						continue;
					}
					$preData[] = $d['no'];
				}
				// $errs = array_merge($errs, $this->hasAnyReconciliationLineExist($preData));
				if (!empty($errs)) {
					$model->addError('id', implode("; ", $errs));
					$this->ajaxResult($model);
				}
				$lines = [];
				$consol_ids = [];
				$transaction = Yii::app()->db->beginTransaction();
				try {
					foreach ($data as $d) {
						$shipment = ImParcel::model()->find('ref=:ref', [':ref' => $d['no']]);
						$no = trim($d['no']);
						$invoice = $invoice_no;
						// $postcode = $shipment->cnee->postcode;
						$weight = $d['chargeweight']; //coureir chargeweight;
						$cubic = $d['cubic'];
						$value = $d['charge']; //courier charge;
						if (empty($shipment)) {
							$lines[] = [$no, '', 0, $weight, $value, 0, 0, 0, 0, 0, 0, $cubic];
							continue;
						}
						if ($value <= 0) {
							continue;
						}
						$org_rate_id = ImportChargeCode::STARTRACK_SYDNEY;
						if (preg_match("/4XHZ\d{8}/", $no)) {
							$org_rate_id = ImportChargeCode::STARTRACK_MEL;
						}
						$postcode = $shipment->cnee->postcode;
						$ourRate = Shipment::getCourierCostByShipment($no, $org_rate_id, $weight);
						$ourRate['consol_id'] = $shipment->consol_id;
						$manifest_weight = isset($shipment->mdata['manifest_weight']) ? floatval($shipment->mdata['manifest_weight']) : 0;
						$cust_check_weight = $shipment->weight;
						$our_charge_weight = floatval(isset($shipment->mdata['charge_client_weight']) ? $shipment->mdata['charge_client_weight'] : $shipment->chargeWeight());
						$shipment->mdata['actual_delivery_cost'] = number_format($value, 2, '.', '');
						$shipment->updateMeta();
						$ourcharge = !empty($shipment->mdata['charge_client_amount']) ? floatval($shipment->mdata['charge_client_amount']) : $shipment->getCouiercost();
						$consoleId = $shipment->consol_id;
						if (!in_array($consoleId, $consol_ids)) {
							$consol_ids[] = $consoleId;
						}
						$lines[] = [$no, '', $postcode, $weight, $value, $ourRate, 0, $ourcharge, $manifest_weight, $cust_check_weight, $our_charge_weight, $cubic];
					}
					$transaction->commit();
				} catch (Exception $ex) {
					$transaction->rollback();
					$model->addError('id', $ex->getMessage());
					$this->ajaxResult($model);
				}
				unset($data);
				// unset($shipment);

				$recModel = Reconciliation::model()->find('invoice_no = :invno AND client_type=2', [':invno' => $invoice_no]);
				if (empty($recModel)) {
					// create reconsiliation now
					$recModel = new Reconciliation();
					$recModel->client_type = 2;
					$recModel->invoice_no = $invoice_no;
					$recModel->invoice_date = $_POST['invoice_issue_date'];
					$recModel->invoice_total = 0; // first saved with zero will update after all lines
					$recModel->my_total = 0; // first saved with zero will update after all lines
					$recModel->save();
				}
				$total = 0;
				$ourTotal = 0;
				$transaction = Yii::app()->db->beginTransaction();
				try {
					foreach ($lines as $line) {
						$total += $line[4];
						$ourTotal += $line[5]['price'];

						// shipment
						$recData = ReconciliationLine::model()->find('shipment_no = :sno AND JSON_VALUE(meta, "$.st_type") = :code', [':sno' => $line[0], ':code' => 'Shipment']);
						if (empty($recData)) {
							// shipment cost does not exist
							$recData = new ReconciliationLine();
						}
						$recData->parent_id = $recModel->id;
						$recData->invoice_no = $invoice_no; // for aupost we use invoice_no field to save console number
						$recData->postcode = $line[2];
						$shipment = ImParcel::model()->find('ref = :ref', [':ref' => $line[0]]);
						// $pkg = !empty($shipment) ? $shipment->pkg : 1;
						$recData->shipment_no = $line[0];
						$recData->weight = number_format($line[3], 2, '.', '');
						$recData->value += number_format($line[4], 2, '.', '');
						$recData->cdeadwt = number_format($line[6], 2, '.', '');
						$recData->consol_id = $line[5]['consol_id'];
						$recData->my_value = !empty($recData->consol_id) ? number_format($line[5]['price'], 2, '.', '') : 0;
						$recData->my_charge = number_format($line[7], 2, '.', '');
						$recData->manifest_weight = number_format($line[8], 2, '.', '');
						$recData->our_charge_weight = number_format($line[10], 2, '.', '');
						$recData->cust_check_weight = number_format($line[9], 2, '.', '');
						$recData->courier_cubic = number_format($line[11], 3, '.', '');
						$recData->mdata['st_type'] = 'Shipment';
						$recData->save();

						// fuel surcharge
						$recData = ReconciliationLine::model()->find('shipment_no = :sno AND JSON_VALUE(meta, "$.st_type") = :code', [':sno' => $line[0], ':code' => 'Fuel']);
						if (empty($recData)) {
							// shipment cost does not exist
							$recData = new ReconciliationLine();
						}
						$recData->parent_id = $recModel->id;
						$recData->invoice_no = $invoice_no; // for aupost we use invoice_no field to save console number
						$recData->postcode = $line[2];
						$shipment = ImParcel::model()->find('ref = :ref', [':ref' => $line[0]]);
						// $pkg = !empty($shipment) ? $shipment->pkg : 1;
						$recData->shipment_no = $line[0];
						$recData->weight = number_format($line[3], 2, '.', '');
						$recData->value += number_format($line[4] * $allData['fuel'] / 100, 2, '.', '');
						$recData->cdeadwt = number_format($line[6], 2, '.', '');
						$recData->consol_id = $line[5]['consol_id'];
						$recData->my_value = !empty($recData->consol_id) ? number_format($line[5]['price'] * $allData['fuel'] / 100, 2, '.', '') : 0;
						$recData->my_charge = number_format($line[7], 2, '.', '');
						$recData->manifest_weight = number_format($line[8], 2, '.', '');
						$recData->our_charge_weight = number_format($line[10], 2, '.', '');
						$recData->cust_check_weight = number_format($line[9], 2, '.', '');
						$recData->courier_cubic = number_format($line[11], 3, '.', '');
						$recData->mdata['st_type'] = 'Fuel';
						$recData->save();
					}
					$transaction->commit();
				} catch (Exception $ex) {
					$transaction->rollback();
					$model->addError('id', $ex->getMessage());
					$this->ajaxResult($model);
				}
				// update reconciliation total now
				$recModel->invoice_total = $total;
				$recModel->my_total = $ourTotal;
				$recModel->update(['invoice_total', 'my_total']);
				foreach ($consol_ids as $cid) {
					$consol = Consol::model()->findByPk($cid);
					if (!empty($consol)) {
						if ($consol->owner_id != 114) {
							$consol->updateStartrackRealCost($recModel->id);
						} else {
							$consol->updateWmsDeliveryCost(Org::ORGID_COURIER_STARTRACK, $recModel->id);
						}
					}
				}

				// other lines
				$data = $allData['other'];
				$transaction = Yii::app()->db->beginTransaction();
				try {
					foreach ($data as $d) {
						if (!empty($d['no'])) {
							$shipment = ImParcel::model()->find('ref = :ref', [':ref' => $d['no']]);
							// record other surcharge in reconciliation line
							$recData = ReconciliationLine::model()->find('shipment_no = :sno AND value = :value AND JSON_VALUE(meta, "$.st_type") = :code', [':sno' => $d['no'], ':value' => number_format(round($d['charge'], 2), 2, '.', ''), ':code' => $d['code']]);
							if (empty($recData)) {
								// other surcharge does not exist
								$recData = new ReconciliationLine();
							}
							$recData->shipment_no = $d['no'];
							$recData->parent_id = $recModel->id;
							$recData->consol_id = @$shipment->consol_id;
							$recData->value = number_format(round($d['charge'], 2), 2, '.', '');
							$recData->my_value = !empty($shipment) ? number_format(round($d['charge'], 2), 2, '.', '') : 0;
							$recData->invoice_no = $recModel->invoice_no;
							$recData->postcode = 0;
							$recData->weight = 0;
							$recData->mdata['st_type'] = $d['code'];
							// same code
							$checkDup = ReconciliationLine::model()->find('JSON_VALUE(meta, "$.st_type") = :code', [':code' => $d['code']]);
							if (!empty($checkDup)) {
								$recData->my_value = 0;
							}
							$recData->save();
							// manual handling | second delivery | po box
							if (empty($checkDup) && !empty($shipment->consol)) {
								$consol = $shipment->consol;
								$billing = BillingLine::model()->find('billing_cref = :cref AND `desc` = :desc', [':cref' => $invoice_no, ':desc' => $d['code']]);
								if (!empty($billing)) {
									continue;
								}
								$billing = new BillingLine;
								$billing->mdata['from_rec'] = 0;
								$billing->status = 1;
								$billing->link_id = 0;
								if (preg_match('/4XHZ\d{8}/', $shipment->ref)) {
									$billing->org_id = Org::ORGID_COURIER_STARTRACK;
								} else if (preg_match('/7RFZ\d{8}/', $shipment->ref)) {
									$billing->org_id = Org::ORGID_COURIER_STARTRACK;
								}
								$billing->charge_code = Consol::AU_LOCAL_DELIVERY_COST_GL_CODE;
								if ($consol->owner_id == 114) {
									$billing->charge_code = Consol::DELIVERY_3PL_COST_GL_CODE;
								}
								$billing->billing_cref = $invoice_no;
								$billing->currency = 1;
								$billing->weight = 0;
								$billing->charge_weight = 0;
								if ($consol->owner_id != 114) {
									$billing->billing_ref = $consol->no;
									$billing->type = BillingLine::BILLING_TYPE_IMPORT;
									$billing->dpmt = Invoice::DPMT_IMPORT;
								} else {
									$billing->billing_ref = $shipment->cref;
									$billing->type = BillingLine::BILLING_TYPE_3PL;
									$billing->dpmt = Invoice::DPMT_3PL;
								}
								$billing->awb = $consol->awb;
								$billing->dpt_id = empty($consol->dpt_id) ? Org::PCAE_DEPARTMENT_SYDNEY : $consol->dpt_id;
								$billing->date = $_POST['invoice_issue_date'];
								$billing->created = $_POST['invoice_issue_date'];
								$billing->transaction_date = $_POST['invoice_issue_date'];
								$billing->due = $_POST['invoice_issue_date'];
								$billing->actual_amount = number_format(round($d['charge'], 2), 2, '.', '');
								$billing->gst = 'INPUT';
								$billing->gst_amount = $billing->getGSTValue();
								$billing->desc = $d['code'];
								$billing->accrual_amount = number_format(round($d['charge'], 2), 2, '.', '');
								$billing->flag = @$d['flag'];
								$billing->save();
								Billing::linkLine($billing, false);
							}
						} else if ($d['code'] == 'Admin Fee') {
							// record admin fee in reconciliation line
							$recData = ReconciliationLine::model()->find('shipment_no = :sno AND value = :value AND parent_id = :parent_id AND JSON_VALUE(meta, "$.st_type") = :code', [':sno' => 'Admin Fee', ':value' => number_format(round($d['charge'], 2), 2, '.', ''), ':parent_id' => $recModel->id, ':code' => $d['code']]);
							if (empty($recData)) {
								// admin fee does not exist
								$recData = new ReconciliationLine();
							}
							$recData->shipment_no = 'Admin Fee';
							$recData->parent_id = $recModel->id;
							$recData->consol_id = $consol_ids[0];
							$recData->value = number_format(round($d['charge'], 2), 2, '.', '');
							$recData->my_value = number_format(round($d['charge'], 2), 2, '.', '');
							$recData->invoice_no = $recModel->invoice_no;
							$recData->postcode = 0;
							$recData->weight = 0;
							$recData->mdata['st_type'] = $d['code'];
							$recData->save();
							// admin fee
							foreach ($consol_ids as $cid) {
								$consol = Consol::model()->findByPk($cid);
								if (!empty($consol) && $consol->owner_id != 114) {
									$billing = BillingLine::model()->find('billing_cref = :cref AND `desc` = :desc', [':cref' => $invoice_no, ':desc' => $d['code']]);
									if (!empty($billing)) {
										continue;
									}
									$billing = new BillingLine;
									$billing->mdata['from_rec'] = 0;
									$billing->status = 1;
									$billing->link_id = 0;
									$billing->org_id = Org::ORGID_COURIER_STARTRACK;
									$billing->charge_code = Consol::AU_LOCAL_DELIVERY_COST_GL_CODE;
									$billing->billing_cref = $invoice_no;
									$billing->currency = 1;
									$billing->weight = 0;
									$billing->charge_weight = 0;
									$billing->billing_ref = $consol->no;
									$billing->type = BillingLine::BILLING_TYPE_IMPORT;
									$billing->dpmt = Invoice::DPMT_IMPORT;
									$billing->awb = $consol->awb;
									$billing->dpt_id = empty($consol->dpt_id) ? Org::PCAE_DEPARTMENT_SYDNEY : $consol->dpt_id;
									$billing->date = $_POST['invoice_issue_date'];
									$billing->created = $_POST['invoice_issue_date'];
									$billing->transaction_date = $_POST['invoice_issue_date'];
									$billing->due = $_POST['invoice_issue_date'];
									$billing->actual_amount = number_format(round($d['charge'], 2), 2, '.', '');
									$billing->gst = 'INPUT';
									$billing->gst_amount = $billing->getGSTValue();
									$billing->desc = $d['code'];
									$billing->accrual_amount = number_format(round($d['charge'], 2), 2, '.', '');
									$billing->save();
									Billing::linkLine($billing, false);
								}
							}
						} else if ($d['code'] == 'Fuel Surcharge') {
							// fuel surcharge
							foreach ($consol_ids as $cid) {
								$consol = Consol::model()->findByPk($cid);
								if (!empty($consol) && $consol->owner_id != 114) {
									$sql = 'SELECT SUM( IF((my_value * 1.05 < value OR my_value + 10 < value OR consol_id = 0 OR shipment_id = 0) AND JSON_VALUE(meta, "$.confirmed") IS NULL, my_value, value) ) as my_value FROM  `reconciliation_line` where `parent_id` = :pid AND consol_id = :cid AND JSON_VALUE(meta, "$.st_type") = "fuel"';
									$r = Yii::app()->db->createCommand($sql)->bindValues([':pid' => $recModel->id, ':cid' => $cid])->queryAll();
									$amount = round(empty($r[0]['my_value']) ? 0 : $r[0]['my_value'], 2);

									$billing = BillingLine::model()->find('billing_cref = :cref AND billing_ref = :bref AND `desc` = :desc', [':cref' => $invoice_no, ':bref' => $consol->no, ':desc' => $d['code'] . ' @' . $d['charge'] . '%']);
									if (!empty($billing)) {
										continue;
									}
									$billing = new BillingLine;
									$billing->mdata['from_rec'] = 0;
									$billing->status = 1;
									$billing->link_id = 0;
									$billing->org_id = Org::ORGID_COURIER_STARTRACK;
									$billing->charge_code = Consol::AU_LOCAL_DELIVERY_COST_GL_CODE;
									$billing->billing_cref = $invoice_no;
									$billing->currency = 1;
									$billing->weight = 0;
									$billing->charge_weight = 0;
									$billing->billing_ref = $consol->no;
									$billing->type = BillingLine::BILLING_TYPE_IMPORT;
									$billing->dpmt = Invoice::DPMT_IMPORT;
									$billing->awb = $consol->awb;
									$billing->dpt_id = empty($consol->dpt_id) ? Org::PCAE_DEPARTMENT_SYDNEY : $consol->dpt_id;
									$billing->date = $_POST['invoice_issue_date'];
									$billing->created = $_POST['invoice_issue_date'];
									$billing->transaction_date = $_POST['invoice_issue_date'];
									$billing->due = $_POST['invoice_issue_date'];
									$billing->actual_amount = number_format(round($amount, 2), 2, '.', '');
									$billing->gst = 'INPUT';
									$billing->gst_amount = $billing->getGSTValue();
									$billing->desc = $d['code'] . ' @' . $d['charge'] . '%';
									$billing->accrual_amount = number_format(round($amount, 2), 2, '.', '');
									$billing->save();
									Billing::linkLine($billing, false);
								}
							}

							$billings = BillingLine::model()->findAll('billing_cref = :cref AND billing_ref LIKE "T%" AND `desc` NOT LIKE "%manual handling%" AND `desc` NOT LIKE "%second delivery%"', [':cref' => $invoice_no]);
							foreach ($billings as $line) {
								// one task has multiple parcels cant detect dup
								$billing = new BillingLine;
								$billing->mdata['from_rec'] = 0;
								$billing->status = 1;
								$billing->link_id = 0;
								$billing->org_id = $line->org_id;
								$billing->charge_code = Consol::AU_LOCAL_DELIVERY_COST_GL_CODE;
								$billing->billing_cref = $invoice_no;
								$billing->currency = 1;
								$billing->weight = 0;
								$billing->charge_weight = 0;
								$billing->billing_ref = $line->billing_ref;
								$billing->type = BillingLine::BILLING_TYPE_3PL;
								$billing->dpmt = Invoice::DPMT_3PL;
								$billing->awb = $consol->awb;
								$billing->dpt_id = empty($consol->dpt_id) ? Org::PCAE_DEPARTMENT_SYDNEY : $consol->dpt_id;
								$billing->date = $_POST['invoice_issue_date'];
								$billing->created = $_POST['invoice_issue_date'];
								$billing->transaction_date = $_POST['invoice_issue_date'];
								$billing->due = $_POST['invoice_issue_date'];
								$billing->actual_amount = number_format(round($line->actual_amount * $d['charge'] / 100, 2), 2, '.', '');
								$billing->gst = 'INPUT';
								$billing->gst_amount = $billing->getGSTValue();
								$billing->desc = $d['code'] . ' @' . $d['charge'] . '%';
								$billing->accrual_amount = number_format(round($line->actual_amount * $d['charge'] / 100, 2), 2, '.', '');
								$billing->save();
								Billing::linkLine($billing, false);
							}
						}
					}

					// 2020-06-15
					if (!empty($_POST['invoice_amount'])) {
						$recModel->mdata['invoice_amount'] = $_POST['invoice_amount'];
						$recModel->save();
					}

					$billing = Billing::model()->find(['condition' => 'billing_cref = :cref', 'params' => [':cref' => $invoice_no], 'order' => 'id DESC']);
					$billing->save();

					$transaction->commit();
				} catch (Exception $ex) {
					$transaction->rollback();
					$model->addError('id', $ex->getMessage());
					$this->ajaxResult($model);
				}

				if (!empty($allData['fuelTotal'])) {
					$sql = 'SELECT SUM(value) AS sum FROM reconciliation_line WHERE invoice_no = :no AND JSON_VALUE(meta, "$.st_type") = "Fuel"';
					$r = Yii::app()->db->createCommand($sql)->bindValues([':no' => $invoice_no])->queryAll();
					$sum = !empty($r[0]['sum']) ? $r[0]['sum'] : 0;
					if ($allData['fuelTotal'] != $sum) {
						$recData = ReconciliationLine::model()->find('shipment_no = :sno AND parent_id = :parent_id', [':sno' => 'Fuel Adjust', ':parent_id' => $recModel->id]);
						if (empty($recData)) {
							$recData = new ReconciliationLine();
						}
						$recData->shipment_no = 'Fuel Adjust';
						$recData->parent_id = $recModel->id;
						$recData->consol_id = $consol_ids[0];
						$recData->value = number_format(round($allData['fuelTotal'] - $sum, 2), 2, '.', '');
						$recData->my_value = 0;
						$recData->invoice_no = $recModel->invoice_no;
						$recData->postcode = 0;
						$recData->weight = 0;
						$recData->save();
					}
				}
				$recModel->recordInvoiceAmountDiff();
				FileRepo::storeFile($file['tmp_name'], $file['name'], FileRepo::COURIER_INVOICE_ATTACHMENT, $recModel->id);
			}
			$this->ajaxResult($model, ['id']);
		}
		$this->render('reconciliation_startrack', ['model' => $model]);
	}

	private function getStartrackFileContent($file)
	{
		$content = file_get_contents($file);
		$lines = preg_split("/\n/", $content);
		unset($content);
		$total = 0;
		$parcelInfo = [];
		$other = [];
		$fuel = 0;
		$fuelTotal = 0;
		foreach ($lines as $oneLine) {
			$cellContents = preg_split("/,/", $oneLine);
			$no = '';
			$hasAmount = false;
			foreach ($cellContents as $cell) {
				if (preg_match('/7RFZ\d{7}/', $cell) || preg_match('/4XHZ\d{7}/', $cell)) {
					$no = $cell;
					$hasAmount = true;
					break;
				} else if (preg_match('/ADM/', $cell)) {
					$other[] = ['no' => '', 'charge' => ($cellContents[11]), 'code' => 'Admin Fee'];
				} else if (preg_match('/ROADFUELSURCHARGE*@(\d*.\d*)%/', str_replace(' ', '', $cell), $matches)) {
					$other[] = ['no' => '', 'charge' => ($matches[1]), 'code' => 'Fuel Surcharge'];
					$fuel = $matches[1];
					$fuelTotal = $cellContents[11];
				} else if (!empty($cellContents[4]) && !preg_match('/GST/', $cellContents[4])) {
					$no = $cellContents[4];
					$hasAmount = true;
				}
			}
			if ($hasAmount) {
				if (!isset($cellContents[10]) || empty(trim($cellContents[10]))) {
					if (preg_match('/SD1/', $cellContents[52])) {
						// second delivery
						$other[] = ['no' => $no, 'charge' => ($cellContents[11]), 'code' => 'Second Delivery ' . $cellContents[52], 'flag' => 1];
					} else if (preg_match('/MHR/', $cellContents[52])) {
						// manual handling
						$other[] = ['no' => $no, 'charge' => ($cellContents[11]), 'code' => 'Manual Handling ' . $cellContents[52], 'flag' => 2];
					} else if (preg_match('/POB/', $cellContents[52])) {
						// PO BOX
						$other[] = ['no' => $no, 'charge' => ($cellContents[11]), 'code' => 'P.O. BOX ' . $cellContents[52], 'flag' => 4];
					} else if (preg_match('/EXP/', $cellContents[52])) {
						// ROAD EXPRESS FEE
						$other[] = ['no' => $no, 'charge' => ($cellContents[11]), 'code' => 'Road Express Fee ' . $cellContents[52], 'flag' => 8];
					} else {
						// others
						$other[] = ['no' => $no, 'charge' => ($cellContents[11]), 'code' => 'OTHER ' . $cellContents[52], 'flag' => 16];
					}
				} else {
					// normal parcels
					$parcelInfo[] = ['no' => $no, 'cubic' => floatval($cellContents[9]), 'chargeweight' => floatval($cellContents[10]), 'charge' => ($cellContents[11])];
				}
			}
		}
		return ['parcel' => $parcelInfo, 'other' => $other, 'fuel' => $fuel, 'fuelTotal' => $fuelTotal];
	}
	/**
	 * check any shipment exist. or not belong to consol
	 * $data array 1=>no=>shipment ref
	 * @return Array();
	 */
	public function hasAnyShipmentNotExist($data)
	{
		$errs = [];
		foreach ($data as $d) {
			if (!empty($d['no'])) {
				$shipment = ImParcel::model()->find('ref=:ref OR hbn=:ref', [':ref' => trim($d['no'])]);
				if (empty($shipment)) {
					$errs[] = $d['no'] . " not find in the system";
				} elseif ($shipment->consol_id == 0) {
				}
			}
		}
		return $errs;
	}
	/***
	 * data is array of shipment ref array('ref1','ref2')
	 */
	public function hasAnyReconciliationLineExist($data, $invoiceNo = 0, $client_type = 0, $export = false)
	{
		$errs = [];
		foreach ($data as $d) {
			if (!empty($d)) {
				$r = null;
				if ($client_type == 3) {
					$r = ReconciliationLine::model()->find('shipment_no=:ref', [':ref' => substr(trim($d), 0, strlen(trim($d)) - 11)]);
				} else if ($client_type != 0) {
					$r = ReconciliationLine::model()->with('parent')->find('parent.client_type = :type AND shipment_no = :ref', [':type' => $client_type, ':ref' => trim($d)]);
				} else {
					$r = ReconciliationLine::model()->find('shipment_no=:ref', [':ref' => trim($d)]);
				}
				if (!empty($r)) {
					if (!empty($invoiceNo) && ($invoiceNo != @$r->parent->invoice_no)) {
						$errs[] = ['ref' => $d, 'description' => $d . " already exist in our system, the invoice no is " . @$r->parent->invoice_no];
					}

					if (empty($invoiceNo)) {
						$errs[] = ['ref' => $d, 'description' => $d . " already exist in our system, the invoice no is " . @$r->parent->invoice_no];
					}
				}
				// $shipment = ImParcel::model()->find('(hbn = :hbn OR hbn = :ref)', [':hbn' => trim($d), ':ref' => trim($d)]);
				// if (empty($shipment)) {
				//     $errs[] = trim($d) . " not find in the system";
				// }
			}
		}

		if (!$export) {
			foreach ($errs as $key => $value) {
				$errs[$key] = $value['description'];
			}
		}

		return $errs;
	}
	/***
	 * data is array of shipment ref array('ref1','ref2')
	 */
	public function hasAnyReconciliationLineNotExist($data, $invoiceNo = 0, $client_type = 0, $export = false)
	{
		$errs = [];
		foreach ($data as $d) {
			if (!empty($d)) {
				$r = null;
				if ($client_type == Reconciliation::D2Z_DECLARE_TYPE) {
					$r = ReconciliationLine::model()->find('shipment_no=:ref', [':ref' => substr(trim($d), 0, strlen(trim($d)) - 11)]); //for checking the shipment is exist in the reconciliation line
					$rDeclare = ReconciliationLineDeclare::model()->find('shipment_no=:ref and client_type = :type', [':ref' => substr(trim($d), 0, strlen(trim($d)) - 11), "type" => Reconciliation::D2Z_DECLARE_TYPE]); //for checking the shipment is exist in the reconciliation declare line
				} else {
					$r = ReconciliationLine::model()->find('shipment_no=:ref', [':ref' => trim($d)]);
				}

				if (empty($r)) {
					$errs[] = ["ref" => $d, "description" => $d . " not exist in our system, the invoice no is " . @$r->parent->invoice_no];
				}

				if (!empty($rDeclare)) {
					if (!empty($invoiceNo) && ($invoiceNo != @$rDeclare->parent->invoice_no)) {
						$errs[] = ["ref" => $d, "description" => $d . " declare already exist in our system, the invoice no is " . @$rDeclare->parent->invoice_no];
					}

					if (empty($invoiceNo)) {
						$errs[] = ["ref" => $d, "description" => $d . " declare already exist in our system, the invoice no is " . @$rDeclare->parent->invoice_no];
					}
				}
			}
		}

		if (!$export) {
			foreach ($errs as $key => $value) {
				$errs[$key] = $value['description'];
			}
		}

		return $errs;
	}
	public function hasAnyD2zShipmentNotExist($data, $client_type = 0, $export = false)
	{
		$errs = [];
		foreach ($data as $d) {
			if (!empty($d[1])) {
				$ref = substr(trim($d[1]), 0, strlen(trim($d[1])) - 11);
				$shipment = ImParcel::model()->find('(hbn = :hbn OR ref = :ref) AND cbwf & 32768 = 0', [':hbn' => trim($d[2]), ':ref' => substr(trim($d[1]), 0, strlen(trim($d[1])) - 11)]);
				if (empty($shipment)) {
					$errs[] = ["ref" => $ref, "description" => $d[1] . '/' . $d[2] . " not find in the system"];
					// } elseif (empty($shipment->trans[0]->mdata['oid'])) {
					//     $errs[] = ["ref"=>$ref, "description"=> $d[1].'/'.$d[2] . " not manifested"];
					// }
				} else {
					$no_mani = true;
					foreach ($shipment->trans as $tran) {
						if ($tran->mdata['oid'] == 1426) {
							$no_mani = false;
						}
					}
					if ($no_mani) {
						$errs[] = ["ref" => $ref, "description" => $d[1] . '/' . $d[2] . " not manifested"];
					}
				}
				// elseif ($shipment->consol_id == 0)
				// {
				//     $errs[] = $d[2] . " not belong to any Consol";
				// }

				if (!isset($shipment->mdata['d2ztype'])) {
					$errs[] = ["ref" => $ref, "description" => 'Shipment No.' . $ref . ' have not d2ztype!'];
				}

				if (in_array(Reconciliation::$types[$client_type], Reconciliation::$rtsCourier)) {
					if (!$shipment->checkRTSReceived()) {
						$errs[] = ["ref" => $ref, "description" => $ref . " is not RTS received"];
					}
				}
			}
		}

		if (!$export) {
			foreach ($errs as $key => $value) {
				$errs[$key] = $value['description'];
			}
		}
		return $errs;
	}

	/** this is for fastway
	 *
	 * @throws Exception
	 */
	public function actionReconciliationNew()
	{
		$model = Reconciliation::model();
		if (isset($_POST) && !empty($_POST)) {
			$inv_file = empty($_FILES['inv_file']) ? [] : $_FILES['inv_file'];
			if (empty($inv_file['tmp_name']) || !is_uploaded_file($inv_file['tmp_name'])) {
				$model->addError('id', 'Invalid template file');
				$this->ajaxResult($model);
			} else {
				if (preg_match('/csv/i', $inv_file['name'])) {
					$xls = new oExcel('CSV');
					$xls->load($inv_file['tmp_name']);
					$data = $xls->getAll();
				} else {
					$xls = new oExcel;
					$xls->load($inv_file['tmp_name']);
					$data = $xls->getAll();
				}

				// $invoiceDate = trim($data[2][1]);
				// $invoiceDate = substr($invoiceDate, 6, 8);
				// try {
				//     $date = DateTime::createFromFormat('d/m/y', $invoiceDate);
				//     $invoiceDate = $date->format('Y-m-d');
				// } catch (Exception $e) {
				// }
				if (empty($_POST['invoice_date'])) {
					$model->addError('id', 'Invoice date is empty');
					$this->ajaxResult($model);
				} else {
					$invoiceDate = $_POST['invoice_date'];
				}

				if (empty($_POST['rate_option'])) {
					$model->addError('id', 'Cost rate is empty');
					$this->ajaxResult($model);
				}

				// check format
				$correct = false;
				foreach ($data as $k => $line) {
					if (implode(',', $line) == 'Customer,Label Number,Invoice No,RF,Label Colour,Weight,Date Issued,Invoice Date,Pickup Date,Label Cost (Ex GST),Reference,Pickup Street Address1,Pickup Street Address 2,Pickup Town,Pickup Postcode,Destination Street Address 1,Destination Street Address 2,Destination Town,Destination Postcode,UPI' || implode(',', $line) == 'Customer,Label Number,Invoice No,RF,Label Colour,Weight,Date Issued,Invoice Date,Pickup Date,Label Cost (Ex GST),Reference,Pickup Street Address1,Pickup Street Address 2,Pickup Town,Pickup Postcode,Destination Street Address 1,Destination Street Address 2,Destination Town,Destination Postcode' || 'Customer,Label Number,Invoice No,RF,Label Colour,Weight,Date Issued,Invoice Date,Pickup Date,Sale Price,Reference,Pickup Street Address1,Pickup Street Address 2,Pickup Town,Pickup Postcode,Destination Street Address 1,Destination Street Address 2,Destination Town,Destination Postcode,UPI' || implode(',', $line) == 'Customer,Label Number,Invoice No,RF,Label Colour,Weight,Date Issued,Invoice Date,Pickup Date,Sale Price,Reference,Pickup Street Address1,Pickup Street Address 2,Pickup Town,Pickup Postcode,Destination Street Address 1,Destination Street Address 2,Destination Town,Destination Postcode') {
						$correct = true;
						unset($data[$k]);
						break;
					}
					unset($data[$k]);
				}
				if (!$correct) {
					$model->addError('id', 'Invalid template file (Try "Save as .xlsx or .csv" in Excel)');
					$this->ajaxResult($model);
				}

				$errors = [];
				$predata = [];
				$invoiceNo = '';

				foreach ($data as $line) {
					if (empty($line[2])) {
						continue;
					}
					$predata[] = $line[2];
				}

				foreach ($data as $k => $line) {
					$no = $line[2];
					$invoice = trim($line[3]);
					if (empty($invoiceNo)) {
						$invoiceNo = $invoice;
						break;
					}
				}

				$errors = $this->hasAnyReconciliationLineExist($predata, $invoiceNo);
				if (!empty($errors)) {
					$model->addError('id', implode("; ", $errors));
					$this->ajaxResult($model);
				}

				$total = 0;
				$ourTotal = 0;
				$lines = [];
				$consol_ids = [];
				foreach ($data as $k => $line) {
					$no = $line[2];
					if (empty($no)) {
						continue;
					}
					$invoice = trim($line[3]);
					if (empty($invoiceNo)) {
						$invoiceNo = $invoice;
					}
					$weight = $line[6];
					if (empty($line[10])) {
						$model->addError('id', 'line ' . $k . ' value is empty');
						$this->ajaxResult($model);
					}
					$value = $line[10];
					$value = floatval($line[10]);
					//if ( empty($invoiceDate) ) {
					//    $invoiceDate = date('Y-m-d', (intval($line[8]) - 25569) * 86400);
					// }
					$postcode = $line[19];
					$total += floatval($value);
					$ourRated = Shipment::getCourierCostByShipment($no, $_POST['rate_option'], $weight);
					// add real cost to the shipment
					$shipment = ImParcel::model()->find('ref = :ref', [':ref' => $no]);
					$manifest_weight = $cust_check_weight = $chargevalue = $our_charge_weight = 0;
					if (!empty($shipment)) {
						$ourRate['consol_id'] = $shipment->consol_id;
						$manifest_weight = isset($shipment->mdata['manifest_weight']) ? floatval($shipment->mdata['manifest_weight']) : 0;
						$cust_check_weight = $shipment->weight;
						$our_charge_weight = floatval(isset($shipment->mdata['charge_client_weight']) ? $shipment->mdata['charge_client_weight'] : $shipment->chargeWeight());
						$co_id = $shipment->consol_id;
						if (!in_array($co_id, $consol_ids)) {
							$consol_ids[] = $co_id;
						}
						// save actual cost in shipment
						$shipment->mdata['actual_delivery_cost'] = number_format($value, 2, '.', '');
						$shipment->updateMeta();
						$chargevalue = number_format($shipment->getCouiercost(), 2, '.', '');
					}

					$ourTotal += floatval($ourRated['price']);
					$lines[] = [$no, $invoice, $postcode, $weight, $value, $ourRated, $chargevalue, $manifest_weight, $cust_check_weight, $our_charge_weight];
				}

				// check to see if the same reconciliation existing or not
				$existing = Reconciliation::model()->find('invoice_no = :invno', [':invno' => $invoiceNo]);
				if (1 == 1) {
					$recModel = null;
					if (empty($existing)) {
						// create reconsiliation now
						$recModel = new Reconciliation();
					} else {
						// create reconsiliation now
						$recModel = $existing;
					}

					$recModel->client_type = 0; // for fastway only currently
					$recModel->invoice_no = $invoiceNo;
					$recModel->invoice_date = $invoiceDate;
					$recModel->invoice_total = number_format($total, 2, '.', '');
					$recModel->my_total = number_format($ourTotal, 2, '.', '');
					$recModel->save();

					// create reconciliation related lines
					$errors = [];
					$errors = $recModel->getErrors();
					if (empty($errors)) {
						$transaction = Yii::app()->db->beginTransaction();
						try {
							foreach ($lines as $line) {
								$firstCharge = ReconciliationLine::model()->find('shipment_no = :sno', [':sno' => $line[0]]);
								if (!empty($firstCharge)) {
									$recData = $firstCharge;
								} else {
									$recData = new ReconciliationLine();
								}
								$recData->parent_id = $recModel->id;
								$recData->invoice_no = $line[1];
								$recData->postcode = $line[2];
								$recData->shipment_no = $line[0];

								// check to see if has been charged before

								$recData->weight = number_format(floatval($line[3]), 2, '.', '');
								$recData->value = number_format($line[4], 2, '.', '');
								$recData->consol_id = $line[5]['consol_id'];
								$recData->my_value = !empty($recData->consol_id) ? number_format($line[5]['price'], 2, '.', '') : 0;
								$recData->my_charge = number_format($line[6], 2, '.', '');
								$recData->manifest_weight = number_format($line[7], 2, '.', '');
								$recData->cust_check_weight = number_format($line[8], 2, '.', '');
								$recData->our_charge_weight = number_format($line[9], 2, '.', '');
								$recData->save();

								$tmpErros = $recData->getErrors();
								if (!empty($tmpErros)) {
									$errors = $tmpErros;
									break;
								}
							}
							$transaction->commit();
						} catch (Exception $ex) {
							$transaction->rollback();
							$model->addError('id', $ex->getMessage());
							$this->ajaxResult($model);
						}
						//update billingline actual cost based on consol
						if (!empty($consol_ids)) {
							foreach ($consol_ids as $cid) {
								$imConsole = Consol::model()->findByPk($cid);
								if (!empty($imConsole)) {
									// update console related real fastway delivery cost
									if ($imConsole->owner_id != 114) {
										$imConsole->updateFastWayRealCost($recModel->id);
									} else {
										$imConsole->updateWmsDeliveryCost(Org::ORGID_COURIER_FASTWAY, $recModel->id);
									}
								}
							}
						}
					}

					// 2020-06-15
					if (!empty($_POST['invoice_amount'])) {
						$recModel->mdata['invoice_amount'] = $_POST['invoice_amount'];
						$recModel->save();
					}
					$recModel->recordInvoiceAmountDiff();
					FileRepo::storeFile($inv_file['tmp_name'], $inv_file['name'], FileRepo::COURIER_INVOICE_ATTACHMENT, $recModel->id);

					if (!empty($errors)) {
						$model->addErrors($errors);
					}
				} else {
					$model->addError('id', 'Sorry the invoice : ' . $invoiceNo . ' has been reconciled before');
				}
				$this->ajaxResult($model, ['id']);
			}
		}
		$this->render('reconciliation_new', ['type' => 'Old']);
	}

	public function actionFastwayReconciliationNew()
	{
		$model = Reconciliation::model();
		if (empty($_POST)) {
			$this->render('reconciliation_new', ['type' => 'New']);
		} else {
			$inv_file = empty($_FILES['inv_file']) ? [] : $_FILES['inv_file'];
			if (empty($inv_file['tmp_name']) || !is_uploaded_file($inv_file['tmp_name'])) {
				$model->addError('id', 'Invalid template file');
				$this->ajaxResult($model);
			} else {
				if (preg_match('/csv/i', $inv_file['name'])) {
					$xls = new oExcel('CSV');
					$xls->load($inv_file['tmp_name']);
					$data = $xls->getAll();
				} else if (preg_match('/xlsx/i', $inv_file['name'])) {
					$xls = new oExcel;
					$xls->load($inv_file['tmp_name']);
					$data = $xls->getAll();
				} else if (preg_match('/xls/i', $inv_file['name'])) {
					$xls = new oExcel('Excel5');
					$xls->load($inv_file['tmp_name']);
					$data = $xls->getAll();
				}

				if (empty($_POST['invoice_date'])) {
					$model->addError('id', 'Invoice date is empty');
					$this->ajaxResult($model);
				} else {
					$invoiceDate = $_POST['invoice_date'];
				}

				if (empty($_POST['rate_option'])) {
					$model->addError('id', 'Cost rate is empty');
					$this->ajaxResult($model);
				}

				// check format
				$correct = false;
				foreach ($data as $k => $line) {
					yii::log(implode(',', $line), 'warning');
					if (implode(',', $line) == 'Invoice No,Invoice Date,Customer,Created By,Label Number,RF,Con Id,Consignment Type,Charge Level,Charge Type,Weight,Parcel Weight (kg),Parcel Length (cm),Parcel Width (cm),Parcel Height (cm),Satchel Size,Date Issued,Pickup Date,Label Cost (Ex GST),Reference,Additional Notes,Pickup Street Address 1,Pickup Street Address 2,Pickup Town,Pickup Postcode,Destination Street Address 1,Destination Street Address 2,Destination Town,Destination  Postcode,Last Scan Desc,Last Scan Date') {
						$correct = true;
						unset($data[$k]);
						break;
					}
					unset($data[$k]);
				}
				if (!$correct) {
					$model->addError('id', 'Invalid template file (Try "Save as .xlsx or .csv" in Excel)');
					$this->ajaxResult($model);
				}

				$errors = [];
				$predata = [];
				$invoiceNo = '';

				foreach ($data as $line) {
					if (empty($line[2])) {
						continue;
					}
					$predata[] = $line[2];
				}

				foreach ($data as $k => $line) {
					$no = $line[2];
					$invoice = trim($line[1]);
					if (empty($invoiceNo)) {
						$invoiceNo = $invoice;
						break;
					}
				}

				$errors = $this->hasAnyReconciliationLineExist($predata, $invoiceNo);
				if (!empty($errors)) {
					$model->addError('id', implode("; ", $errors));
					$this->ajaxResult($model);
				}

				$total = 0;
				$ourTotal = 0;
				$lines = [];
				$consol_ids = [];
				foreach ($data as $k => $line) {
					$no = $line[5];
					if (empty($no)) {
						continue;
					}
					if (!empty($line[12])) {
						$weight = $line[12];
					} else if (preg_match('/300GM/i', $line[16])) {
						$weight = 0.3;
					} else {
						$model->addError($no, 'line ' . $k . ' column 12, weight is empty');
						continue;
					}
					if (empty($line[19])) {
						$model->addError($no, 'line ' . $k . ' column 19, value is empty');
						continue;
						// $this->ajaxResult($model);
					}
					$value = floatval($line[19]);
					$postcode = $line[29];
					$total += floatval($value);
					$ourRated = Shipment::getCourierCostByShipment($no, $_POST['rate_option'], $weight);
					// add real cost to the shipment
					$shipment = ImParcel::model()->find('ref = :ref', [':ref' => $no]);
					$manifest_weight = $cust_check_weight = $chargevalue = $our_charge_weight = 0;
					if (!empty($shipment)) {
						$ourRate['consol_id'] = $shipment->consol_id;
						$manifest_weight = isset($shipment->mdata['manifest_weight']) ? floatval($shipment->mdata['manifest_weight']) : 0;
						$cust_check_weight = $shipment->weight;
						$our_charge_weight = floatval(isset($shipment->mdata['charge_client_weight']) ? $shipment->mdata['charge_client_weight'] : $shipment->chargeWeight());
						$co_id = $shipment->consol_id;
						if (!in_array($co_id, $consol_ids)) {
							$consol_ids[] = $co_id;
						}
						// save actual cost in shipment
						$shipment->mdata['actual_delivery_cost'] = number_format($value, 2, '.', '');
						$shipment->updateMeta();
						$chargevalue = number_format($shipment->getCouiercost(), 2, '.', '');
					}

					$ourTotal += floatval($ourRated['price']);
					$lines[] = [$no, $invoice, $postcode, $weight, $value, $ourRated, $chargevalue, $manifest_weight, $cust_check_weight, $our_charge_weight];
				}

				// check to see if the same reconciliation existing or not
				$existing = Reconciliation::model()->find('invoice_no = :invno', [':invno' => $invoiceNo]);
				if (1 == 1) {
					$recModel = null;
					if (empty($existing)) {
						// create reconsiliation now
						$recModel = new Reconciliation();
					} else {
						// create reconsiliation now
						$recModel = $existing;
					}

					$recModel->client_type = 0; // for fastway only currently
					$recModel->invoice_no = $invoiceNo;
					$recModel->invoice_date = $invoiceDate;
					$recModel->invoice_total = number_format($total, 2, '.', '');
					$recModel->my_total = number_format($ourTotal, 2, '.', '');
					$recModel->save();

					// create reconciliation related lines
					$errors = [];
					$errors = $recModel->getErrors();
					if (empty($errors)) {
						$transaction = Yii::app()->db->beginTransaction();
						try {
							foreach ($lines as $line) {
								$firstCharge = ReconciliationLine::model()->find('shipment_no = :sno', [':sno' => $line[0]]);
								if (!empty($firstCharge)) {
									$recData = $firstCharge;
								} else {
									$recData = new ReconciliationLine();
								}
								$recData->parent_id = $recModel->id;
								$recData->invoice_no = $line[1];
								$recData->postcode = $line[2];
								$recData->shipment_no = $line[0];

								// check to see if has been charged before

								$recData->weight = number_format($line[3], 2, '.', '');
								$recData->value = number_format($line[4], 2, '.', '');
								$recData->consol_id = $line[5]['consol_id'];
								$recData->my_value = !empty($recData->consol_id) ? number_format($line[5]['price'], 2, '.', '') : 0;
								$recData->my_charge = number_format($line[6], 2, '.', '');
								$recData->manifest_weight = number_format($line[7], 2, '.', '');
								$recData->cust_check_weight = number_format($line[8], 2, '.', '');
								$recData->our_charge_weight = number_format($line[9], 2, '.', '');
								$recData->save();

								$tmpErros = $recData->getErrors();
								if (!empty($tmpErros)) {
									$errors = $tmpErros;
									break;
								}
							}
							$transaction->commit();
						} catch (Exception $ex) {
							$transaction->rollback();
							$model->addError('id', $ex->getMessage());
							$this->ajaxResult($model);
						}
						//update billingline actual cost based on consol
						if (!empty($consol_ids)) {
							foreach ($consol_ids as $cid) {
								$imConsole = Consol::model()->findByPk($cid);
								if (!empty($imConsole)) {
									// update console related real fastway delivery cost
									if ($imConsole->owner_id != 114) {
										$imConsole->updateFastWayRealCost($recModel->id);
									} else {
										$imConsole->updateWmsDeliveryCost(Org::ORGID_COURIER_FASTWAY, $recModel->id);
									}
								}
							}
						}
					}

					// 2020-06-15
					if (!empty($_POST['invoice_amount'])) {
						$recModel->mdata['invoice_amount'] = $_POST['invoice_amount'];
						$recModel->save();
					}
					$recModel->recordInvoiceAmountDiff();
					FileRepo::storeFile($inv_file['tmp_name'], $inv_file['name'], FileRepo::COURIER_INVOICE_ATTACHMENT, $recModel->id);

					if (!empty($errors)) {
						$model->addErrors($errors);
					}
				} else {
					$model->addError('id', 'Sorry the invoice : ' . $invoiceNo . ' has been reconciled before');
				}
				if (!empty($_POST['export'])) {
					$errors = [];
					foreach ($model->getErrors() as $k => $v) {
						foreach ($v as $sv) {
							$errors[] = ['ref' => $k, 'description' => $sv];
						}
						$model->clearErrors($k);
					}
					$this->exportErrors($model, $errors);
				}
				$this->ajaxResult($model, ['id']);
			}
		}
	}

	public function actionReconciliation()
	{
		if (isset($_GET['tab'])) {
			$tab = $_GET['tab'];
			$this->render('tab_' . $tab);
		} else {
			$this->render('reconciliation');
		}
	}

	public function actionExportReconciliation()
	{
		$xls = new oExcel;
		$i = 1;

		switch ($_GET['type']) {
			case 'search':{
					$xls->addRow($i++, ['From', 'Invoice/Consol No', 'Manifest No', 'Invoice/Consol Date', 'Invoice Total', 'My Total', 'my_total_m', 'Deviation', 'Perecent']);
					$xls->setColWidth([10, 15, 15, 15, 10, 10, 10, 10, 10]);

					$model = new Reconciliation('search');
					$model->unsetAttributes();
					if (!empty($_GET['Reconciliation'])) {
						$model->attributes = $_GET['Reconciliation'];
					}
					$dp = $model->search(false);
					foreach ($dp->data as $r) {
						$xls->addRow($i++, [$r->getType(), $r->invoice_no, $r->manifest_no, $r->invoice_date, $r->getInvoiceTotal(), $r->getMyTotal(), $r->getMyTotalManifest(), $r->deviation, $r->percent]);
					}
					$xls->output('invoice_reconciliation_search_export_' . time() . '.xlsx');
				}
				break;
		}
	}

	public function actionExportManifestAmountDiff($id)
	{
		$xls = new oExcel;
		$i = 1;
		$xls->addRow($i++, ['Type', 'Manifest No', 'Invoice Total', 'Manifest Total', 'My Total', 'My Charge', 'Diff(Our Cost-Amount)', 'Diff(OA-A)']);
		$xls->setColWidth([10, 10, 15, 15, 15, 10, 10, 10, 10, 10]);
		$lines = ReconciliationLine::model()->findAll('parent_id = :pid AND postcode = "eParcel"', [':pid' => $id]);
		foreach ($lines as $line) {
			$sql = "SELECT sum(invoice_total) as total FROM `reconciliation` WHERE client_type = 1 and manifest_no = '" . $line->shipment_no . "' AND JSON_VALUE(meta, '$.no_consol') = 0";
			$mani_amount = Yii::app()->db->createCommand($sql)->queryScalar();
			if (abs($mani_amount - $line->value) < 0.01) {
				continue;
			}

			$xls->addRow($i++, [$line->postcode, $line->shipment_no, $line->value, $mani_amount, $line->my_value, $line->my_charge, $line->getCostDiff(), $line->subAmount]);
		}

		$lines = ReconciliationLine::model()->findAll('parent_id = :pid AND postcode = "Return to sender"', [':pid' => $id]);
		foreach ($lines as $line) {
			if ($line->getConsolNos() != '') {
				continue;
			}

			$sql = "SELECT sum(invoice_total) as total FROM `reconciliation` WHERE client_type = 10 and manifest_no = '" . $line->shipment_no . "'";
			$mani_amount = Yii::app()->db->createCommand($sql)->queryScalar();
			$xls->addRow($i++, [$line->postcode, $line->shipment_no, $line->value, $mani_amount, $line->my_value, $line->my_charge, $line->getCostDiff(), $line->subAmount]);
		}

		$lines = ReconciliationLine::model()->findAll('parent_id = :pid AND postcode = "UNKNOWN"', [':pid' => $id]);
		foreach ($lines as $line) {
			$xls->addRow($i++, [$line->postcode, $line->shipment_no, $line->value, 0, $line->my_value, $line->my_charge, $line->getCostDiff(), $line->subAmount]);
		}

		$xls->output('aupost_manifest_amount_diff_' . time() . '.xlsx');
	}

	public function actionExportStartractWeightDiff($id)
	{
		$recs = ReconciliationLine::model()->findAll('parent_id=:pid', [':pid' => $id]);
		$xls = new oExcel();
		$i = 1;
		$xls->addRow($i++, ['Ref', 'Consol', 'Agent', 'Real Chargable weight(KG)', 'Our Chargable Weight(KG)', 'Our Charge(AUD)', 'The Value We Need To Charge(AUD)']);
		foreach ($recs as $rec) {
			if (preg_match("/7RFZ\d{8}/i", $rec->shipment_no)) {
				$shipment = ImParcel::model()->find('ref=:ref', [':ref' => $rec->shipment_no]);
				if (!empty($shipment)) {
					$startrack_weight = $rec->getCourierToOurWeight(); //250 to 167;
					$ourChargeWeight = $rec->ourChargeWeight();
					$shipment->temp_chargeWeight = $startrack_weight;
					$theAmountWeNeedToCharge = $shipment->getCouiercost();
					if ($startrack_weight > $ourChargeWeight) {
						$xls->addRow($i++, [$shipment->ref, !empty($rec->consol) ? $rec->consol->no : "", $shipment->agent->name, $startrack_weight, $ourChargeWeight, $rec->my_charge, $theAmountWeNeedToCharge]);
					}
				}
			}
		}
		$xls->getActiveSheet()->getStyle('A1:F1')->getFont()->setBold(true);
		$xls->getActiveSheet()->getColumnDimension('A')->setWidth(20);
		$xls->getActiveSheet()->getColumnDimension('B')->setWidth(20);
		$xls->getActiveSheet()->getColumnDimension('C')->setWidth(30);
		$xls->getActiveSheet()->getColumnDimension('D')->setWidth(20);
		$xls->getActiveSheet()->getColumnDimension('E')->setWidth(20);
		$xls->getActiveSheet()->getColumnDimension('F')->setWidth(20);
		$xls->output(time() . "_startrack.xlsx");
	}

	public function actionPortInvoiceReconciliationExport($id)
