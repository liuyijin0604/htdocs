				//     $newInvoice->mdata['address'] = $model->cust->getAddress();
				//     $newInvoice->mdata['payterm'] = empty($model->cust->extra['payterm']) ? 'COD' : $model->cust->extra['payterm'] . ' days';
				//     $newInvoice->date = date('Y-m-d');
				//     $newInvoice->due = Invoice::calcDue($newInvoice->date, $model->cust->extra['payterm']);
