<script type="text/javascript">

			var tabSi = $('#<?=$_GET["tabid"];?>');
			var panelSi = $('#<?=$_GET["tabid"];?>').data('panel');

			tabSi.unbind('reload_reconcile_grid').bind('reload_reconcile_grid', function(){
				$('#<?=$_GET["tabid"];?>_reconcile_grid', tabSi.data('panel')).yiiGridView('update');
				return false;
			});

			tabSi.unbind('reload_excofile_grid').bind('reload_excofile_grid', function(){
				$('#<?=$_GET["tabid"];?>_excofile-grid', tabSi.data('panel')).yiiGridView('update');
				return false;
			});

			tabSi.data('panel').off('change', 'select.pfile_status').on('change', 'select.pfile_status', function(){
				$.post('files/status', {'id': $(this).data('id'), 'status': $(this).val() });
			});

			function uploading_on(obj) {
				obj.addClass('uploading');
				obj.val('    Uploading');
				obj.prop('disabled', 'disabled');
			}

			function uploading_off(obj,str) {
				obj.removeClass('uploading');
				obj.val(str);
				obj.removeProp('disabled');
			}

			 $('.error_check_done',panelSi).on('click',function(){
				if( confirm('Are you sure to Error Check Done')){
						$.get('<?=$this->createUrl("siReconcile/updateStatus")."?id=".$model->rec_id."&&status=30"?>',function(r){
							r = JSON.parse(r);
								if(r.done==true){
										myApp.alert(r.msg, false); 
								 }else{
										myApp.alert(r.msg, false);   
							 }
								tabSi.trigger('reload_reconcile_grid');
					 });
				
				}
			});

			$('.rate_check_done',panelSi).on('click',function(){
				if( confirm('Are you sure to Rate Check Done')){
						$.get('<?=$this->createUrl("siReconcile/updateStatus")."?id=".$model->rec_id."&&status=50"?>',function(r){
							r = JSON.parse(r);
								if(r.done==true){
										myApp.alert(r.msg, false); 
								 }else{
										myApp.alert(r.msg, false);   
							 }
								tabSi.trigger('reload_reconcile_grid');
					 });
				
				}
			});

			$('.linking_billing',panelSi).on('click',function(){
				if( confirm('Are you sure to Link Billing')){
						uploading_on($('#linking_billing',panelSi));
						$.get('<?=$this->createUrl("siReconcile/linkBilling")."?id=".$model->rec_id?>',function(r){
							r = JSON.parse(r);
								if(r.done==true){
									uploading_off($('#linking_billing',panelSi),'Linking Billing');
										myApp.alert(r.msg, false); 
								 }else{
								 	uploading_off($('#linking_billing',panelSi),'Linking Billing');
										myApp.alert(r.msg, false);   
							 }
								tabSi.trigger('reload_reconcile_grid');
					 });
				
				}
			});

			$('.linking_billing_done',panelSi).on('click',function(){
				if( confirm('Are you sure to Link Billing Done')){
						$.get('<?=$this->createUrl("siReconcile/updateStatus")."?id=".$model->rec_id."&&status=60"?>',function(r){
							r = JSON.parse(r);
								if(r.done==true){
										myApp.alert(r.msg, false); 
								 }else{
										myApp.alert(r.msg, false);   
							 }
								tabSi.trigger('reload_reconcile_grid');
					 });
				
				}
			});

			$('.updateStatus',panelSi).on('click',function(){
				if( confirm('Are you sure to update status?')){
					var form = new FormData(document.getElementById("si-reconcile-acr_form"));
					 $.ajax({
					            url: '<?=$this->createUrl("siReconcile/updateStatusDirect")."?id=".$model->rec_id?>'+'&&status='+$('#si_reconcile_status',panelSi).val(),
					            type: "post",
					            data: form,
					            processData: false,
					            contentType: false,
					            success: function(r) {
					               	r = JSON.parse(r);
									if(r.done==true){
										myApp.alert(r.msg, false);
									 }else
									 {
										myApp.alert(r.msg, false); 
						             }
						             tab.trigger('reload_reconcile_grid');
						         },
					            error: function(e) {
					                console.log(e);
					            }
					        });			
				}
				return false;
			});

			$('#si_reconcile_status', panelSi).next().on('dblclick', function(){
				if(window.confirm('Are you sure to override status?')){
					$(this).prev().attr('disabled', false);
				}
			});


			$(panelSi).off('click', '#btn-save').on('click', '#btn-save', function() {
				uploading_on($('#btn-save'));

				var formData = new FormData();
				formData.append('id', '<?=$model->rec_id?>');
				formData.append('confirm_inv_file', $('#confirm_inv_file', panelSi)[0].files[0]);
				$.ajax({
					url: '<?=Yii::app()->createUrl("siReconcile/ajaxImportReconciliationConfirmList")?>',
					type: 'POST',
					data: formData,
					processData: false,
					contentType: false,
					success: function(r) {
						uploading_off($('#btn-save'),'submit');
						r = JSON.parse(r);
						if (r.done) {
							myApp.notice(r.msg, 5000);
						} else {
							myApp.alert(r.msg, false);
						}
					},
					error: function(r) {
						uploading_off($('#btn-save'),'submit');
						myApp.alert('System error', false);
					}
				});
		});
</script>


<?php $this->endWidget();?>