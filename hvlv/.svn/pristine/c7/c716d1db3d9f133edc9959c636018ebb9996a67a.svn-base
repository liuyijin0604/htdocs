	public function loadModel($id)
	{
		$model= CargoProcess::model()->findByPk($id);
		if ($model===null) {
			throw new CHttpException(404, 'The requested page does not exist.');
		}
		return $model;

	}

	public function actionUpdateReminder(){
		if(!empty($_POST)){
			$shipment_id = $_POST["id"];
			$actionOption = $_POST["action"];
			$model = ImParcel::model()->findByPk($shipment_id);
			if(!empty($model)){
				$model->mdata["isreminderprint"] = $actionOption;
				if($model->save()){
					echo json_encode([
						'isSuccess' => true,
					]);
					return;
				}
			}
		}
	}
}
