<?php

class CargoProcessController extends Controller
{
	protected $nonAjax=['scanInfo','export','exportAgent','generateCargoReceipt','printGatePass','uploadPOD','uploadSignatureFile','viewDriverJobs','exportAmazonInfo'];
	private $joinSql = "JOIN `shipment` s2 ON c.shipment_id=s2.id 
           left join `addr` ad2 on s2.cnee_id = ad2.id JOIN consol co2 on s2.consol_id = co2.id";

    private $joinSqlC = "JOIN `shipment` s2 ON c.shipment_id=s2.id left join consol co2 on co2.id = s2.consol_id
           left join `addr` ad2 on s2.cnee_id = ad2.id";       

	public function actionIndex()
	{
		$filtersForm1=new FiltersForm1;
		$filtersForm=new FiltersForm;
		if (isset($_GET['FiltersForm'])) {
			$filtersForm->filters=$_GET['FiltersForm'];
		}
		if (isset($_GET['FiltersForm1'])) {
			$filtersForm1->filters=$_GET['FiltersForm1'];
		}

		$dataprovider = $this->getOverviewReport($filtersForm);


		$provide1=SystemSetting::getCargoProcessPodSetting();
		$dataprovider2=new CArrayDataProvider([]);
		$filterData1=$filtersForm1->filter($provide1);
		$dataprovider1=new CArrayDataProvider($filterData1);
		$dataprovider1->pagination=['pageSize'=>10];
		$sort=new CSort();
		$sort->defaultOrder = "pod";
		$dataprovider1->sort=$sort;
		$this->render('index', ['dataProvider1'=>[$dataprovider1,$filtersForm1],'dataProvider'=>[$dataprovider,$filtersForm],'dataProvider2'=>[$dataprovider2,$filtersForm],'dataProvider3'=>[$dataprovider2,$filtersForm1],'name'=>'Select The pod!']);
	}

	private function getOverviewReport(&$filtersForm, $type='')
	{
		$typeStrC="";
		$typeStrCg="";
		if(!empty($type))
		{ 
			$typeStrC = "c.type =  {$type} and ";
			$typeStrCg = "cg.type =  {$type} and ";
		}
		$provide=[];
		$sql="SELECT (@i :=@i + 1) AS id,cg.status,count(*) as number, (SELECT count(*) FROM `cargo_process` c WHERE {$typeStrC} DATEDIFF(NOW(),date)<=1 and c.status=cg.status {$this->getUserStr()}) as day1
			, (SELECT count(*) FROM `cargo_process` c WHERE {$typeStrC} DATEDIFF(NOW(),date)<3 and DATEDIFF(NOW(),date)>1 and c.status=cg.status {$this->getUserStr()} ) as day2
			, (SELECT count(*) FROM `cargo_process` c WHERE {$typeStrC} DATEDIFF(NOW(),date)>=3 and c.status=cg.status {$this->getUserStr()} ) as day3
			FROM `cargo_process` cg JOIN `shipment` s ON cg.shipment_id=s.id,
			(SELECT @i := 0) AS it  WHERE s.status<100 and {$typeStrCg} cg.status<".CargoProcess::PROCESSDONE." {$this->getUserStr(true)} group by cg.status";
		$provide=Yii::app()->db->createCommand($sql)->queryAll();
		$filteredData=$filtersForm->filter($provide);
		$dataprovider=new CArrayDataProvider($filteredData);
		$dataprovider->pagination=['pageSize' =>10,];
		$sort=new CSort();
		$sort->attributes=[
			'number'=>[
				'asc'=>'number ASC',
				'desc'=>'number DESC',
			],
			'status'=>[
				'asc'=>'status ASC',
				'desc'=>'status DESC',
			],
		];
		$sort->defaultOrder = "status ASC";
		$dataprovider->sort=$sort;
		return $dataprovider;
	}
		
	/**
	 * normal consol list;
