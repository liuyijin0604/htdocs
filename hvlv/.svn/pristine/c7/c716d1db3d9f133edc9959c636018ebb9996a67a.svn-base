	/**
	 * normal consol list;
	 */
	public function actionCargoList()
	{
		$this->getCargoList(CargoProcess::NORMAL_CARGO);
	}

	/**
	 * FBA list;
	 */
	public function actionFbaList()
	{
		$this->getCargoList(CargoProcess::FBA_CARGO);
	}

		/**
	 * FBA list;
