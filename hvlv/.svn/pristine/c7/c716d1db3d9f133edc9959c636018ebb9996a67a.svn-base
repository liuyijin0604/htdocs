	private function uploadMultiFile($hash,$isUpdate=true)
	{
		$f = $_FILES['file'];
		$filename = $f['tmp_name'];
		$name = $f['name'];
		if(!is_uploaded_file($filename)) return false;
		$hashArray = explode(CargoProcess::IP_SEPERATOR,$hash);
		$filesize = filesize($filename);
		$date = date('Y-m-d H:i:s');
		$fileHash = hash_file('crc32b', $filename).hash('crc32b', $filesize);
		$finfo = finfo_open(FILEINFO_MIME_TYPE);
		$mime = finfo_file($finfo, $filename);
		$images = [];
		foreach ($hashArray as $key => $thisHash) {
			$fr =CargoProcess::updateUploadSingleFile($filesize,$date,$fileHash,$finfo,$mime,$filename,$name,$thisHash);
			$images[] = $fr;
			if($isUpdate)$this->updateAggPodId($fr);
		}
		return $images;
	}


	private function updateAggPodId($fr)
	{
		$cargoProcess = CargoProcess::Model()->findByPk($fr->fid);
		$cargoProcess->agg_pod_id = $fr->id;
		$cargoProcess->update(["agg_pod_id"]);
	}

	public function actionUploadSignatureFile($hash)
	{
		/*get signature file*/
		$images = $this->uploadMultiFile($hash,false);

		foreach ($images as $key => $image) {
			$thisModel = $this->loadModel($image->fid);
			$thisModel->log("uploadSignatureFile");
			$shipmentModel = $thisModel->shipment;
			$filename = $shipmentModel->id."pod";
			$pdfPath = "";
			/* combine the signature file to the template to be pdfs*/
			if ($thisModel->type == CargoProcess::FBA_CARGO||$thisModel->type == CargoProcess::B2B_CARGO) {
				$pdfPath = oPDF::renderPDF('cargo_receipt', ['model' => $shipmentModel,'image'=>$image], 2, $filename.'.pdf');
			} else {
				$pdfPath = oPDF::renderPDF('cargo_receipt_1', ['model' => $shipmentModel,'image'=>$image], 2, $filename.'.pdf');
			}
			echo Yii::app()->request->hostInfo.Yii::app()->baseUrl."/filerepo/".$image->hash."/".$image->name;

			/*upload pdfs to every shipment*/
			$uploadType = 25;
			$pphash = FileRepo::uploadHash($shipmentModel, $uploadType);
			$filesize = filesize($pdfPath);
			$date = date('Y-m-d H:i:s');
			$filename = $filename.".pdf";
			$name= "pod.pdf";
			$fileHash = hash_file('crc32b', $pdfPath).hash('crc32b', $filesize);
			$finfo = finfo_open(FILEINFO_MIME_TYPE);
			$mime = finfo_file($finfo, $pdfPath);
			$cargoProcess =CargoProcess::model()->findByPk($image->fid);
			if(!empty($cargoProcess->mdata['caref']))
			{
				echo $cargoProcess->id;
				$fr = CargoProcess::updateUploadSingleFile($filesize,$date,$fileHash,$finfo,$mime,$pdfPath,$name,$pphash,true,false,$cargoProcess->id);
			}else
			{
				$fr = CargoProcess::updateUploadSingleFile($filesize,$date,$fileHash,$finfo,$mime,$pdfPath,$name,$pphash,true);
			}
		}

		echo 'DONE';
	}

	public function actionViewAllAgent()
	{
		$filtersForm=new FiltersForm;
		if (isset($_GET['FiltersForm'])) {
			$filtersForm->filters=$_GET['FiltersForm'];
		}


		$truckUserList = User::getTruckUsers();
		$dataproviders =[];

		$dataprovider = $this->getOverviewReport($filtersForm);
		$dataproviderFBA = $this->getOverviewReport($filtersForm,CargoProcess::FBA_CARGO);
		$dataproviderB2B = $this->getOverviewReport($filtersForm,CargoProcess::B2B_CARGO);
		$dataproviderNormal = $this->getOverviewReport($filtersForm,CargoProcess::NORMAL_CARGO);
		$dataproviderPickup = $this->getOverviewReport($filtersForm,CargoProcess::PICKUP_CARGO);

		$dataproviders[] = $dataprovider;

		foreach ($truckUserList  as $key => $truckUser) 
		{
			$sql="SELECT (@i :=@i + 1) AS id,status,count(*) as number, (SELECT count(*) FROM `cargo_process` c WHERE DATEDIFF(NOW(),date)<=1 and c.status=cg.status {$this->getUserStr(false,$key)}) as day1
			, (SELECT count(*) FROM `cargo_process` c WHERE DATEDIFF(NOW(),date)<3 and DATEDIFF(NOW(),date)>1 and c.status=cg.status {$this->getUserStr(false,$key)} ) as day2
			, (SELECT count(*) FROM `cargo_process` c WHERE DATEDIFF(NOW(),date)>=3 and c.status=cg.status {$this->getUserStr(false,$key)} ) as day3
			FROM `cargo_process` cg,
			(SELECT @i := 0) AS it  WHERE status<".CargoProcess::PROCESSDONE." {$this->getUserStr(true,$key)} group by status";
			$provide=[];
			$provide=Yii::app()->db->createCommand($sql)->queryAll();
			$filteredData=$filtersForm->filter($provide);
			$dataprovider=new CArrayDataProvider($filteredData);
			$dataprovider->pagination=['pageSize' =>10,];
			$sort=new CSort();
			$sort->attributes=[
				'number'=>[
					'asc'=>'number ASC',
					'desc'=>'number DESC',
				],
				'status'=>[
					'asc'=>'status ASC',
					'desc'=>'status DESC',
				],
			];
			$sort->defaultOrder = "status ASC";
			$dataprovider->sort=$sort;
			$dataproviders[$key] = $dataprovider;
		}	

		$this->render('viewAllAgent', ['dataProvider'=>[$dataproviders,$filtersForm],'dataProviderFBA'=>[$dataproviderFBA,$filtersForm],'dataProviderB2B'=>[$dataproviderB2B,$filtersForm],'dataProviderNormal'=>[$dataproviderNormal,$filtersForm],'dataProviderPickup'=>[$dataproviderPickup,$filtersForm],'truckUserList'=>$truckUserList]);
	}


	public function actionViewDriverJobs()
	{
		$filtersForm=new FiltersForm;
		if (isset($_GET['FiltersForm'])) {
			$filtersForm->filters=$_GET['FiltersForm'];
		}
		$provide=[];
		$sql="SELECT (@i :=@i + 1) AS id, cg.driver_id, o.name,count(*) as number, (SELECT count(*) FROM `cargo_process` c  join shipment s2  on c.shipment_id = s2.id
             join org o2 on c.driver_id = o2.id WHERE DATEDIFF(NOW(),date)<=1 and c.driver_id=cg.driver_id and c.status= cg.status {$this->getUserStr()} ) as day1
			, (SELECT count(*) FROM `cargo_process` c join shipment s2  on c.shipment_id = s2.id
             join org o2 on c.driver_id = o2.id WHERE DATEDIFF(NOW(),date)<3 and DATEDIFF(NOW(),date)>1 and c.driver_id=cg.driver_id  and c.status= cg.status {$this->getUserStr()} ) as day2
			, (SELECT count(*) FROM `cargo_process` c join shipment s2  on c.shipment_id = s2.id
             join org o2 on c.driver_id = o2.id WHERE DATEDIFF(NOW(),date)>=3 and c.driver_id=cg.driver_id  and c.status= cg.status {$this->getUserStr()} ) as day3 from
			(SELECT @i := 0) AS it,`cargo_process` cg
             join shipment s  on cg.shipment_id = s.id
             join org o on cg.driver_id = o.id
            WHERE cg.status=".CargoProcess::WAITINGDELIVERY." or cg.status = ".CargoProcess::WAITINGAGENTDELIVERY." or cg.status =".CargoProcess::AGENTDELIVERYDONE." or cg.status =".CargoProcess::PROCESSDONE." {$this->getUserStr(true)} group by cg.driver_id order by id";

		$provide=Yii::app()->db->createCommand($sql)->queryAll();
		$filteredData=$filtersForm->filter($provide);
		$dataprovider=new CArrayDataProvider($filteredData);
		$dataprovider->pagination=['pageSize' =>10,];
		$sort=new CSort();
		$sort->attributes=[
			'number'=>[
				'asc'=>'number ASC',
				'desc'=>'number DESC',
			],
			'name' => [
				'asc' => 'name ASC',
				'desc' => 'name DESC',
			],
		];
		$sort->defaultOrder = "status ASC";
		$dataprovider->sort=$sort;
		$cargo=new CargoProcess('search');
		$cargo->unsetAttributes();
		if (isset($_GET['agent_id'])) {
			if (!empty($_GET['agent_id'])) {
				$cargo->setAgentId($_GET['agent_id']);
			}
		}

		if(!empty($_GET['CargoProcess']['searchFrom']))
		{
			$cargo->searchFrom=$_GET['CargoProcess']['searchFrom'];
		}
		if(!empty($_GET['CargoProcess']['searchTo']))
		{
			$cargo->searchTo=$_GET['CargoProcess']['searchTo'];
		}


		if(!empty($_GET['CargoProcess']))
		{
			$cargo->setAttributes($_GET['CargoProcess']);
			if(isset($_GET['CargoProcess']['assignedUser']))
			{
				$cargo->assignedUser = $_GET['CargoProcess']['assignedUser'];
			}
			if(isset($_GET['CargoProcess']['driver_id']))
			{
				$cargo->driver_id = $_GET['CargoProcess']['driver_id'];
			}

			if(!empty($_GET['CargoProcess']['export']))
			{
				$cargo->exportInvoiceList('all');
				return "";
			}

			$this->renderPartial('driver_job_list', [
				'cargo' => $cargo,
				'name' => 'All',
				'cargo_type' => CargoProcess::NORMAL_CARGO
			]);
		} else {
			$cargo->setAttribute('id', -1);
			$this->render('viewDriverJobs', ['dataProvider'=>[$dataprovider,$filtersForm],'cargo'=>$cargo]);
		}
	}

	public function actionExport()
	{
		$cargo=new CargoProcess('search');
		$cargo->unsetAttributes();

		if(!empty($_GET['CargoProcess']))
		{
			$cargo->setAttributes($_GET['CargoProcess']);
			if(isset($_GET['CargoProcess']['assignedUser']))
			{
				$cargo->assignedUser = $_GET['CargoProcess']['assignedUser'];
			}
			if(isset($_GET['CargoProcess']['driver_id']))
			{
				$cargo->driver_id = $_GET['CargoProcess']['driver_id'];
			}
			if(isset($_GET['ImParcel']['consol_no']))
			{
				$cargo->consol_no = $_GET['ImParcel']['consol_no'];
			}
		}

		if(isset($_GET['status']))
		{
			$cargo->status = $_GET['status'];
		}

		$dp = $cargo->search(false, false,false,true,$_GET['pod_id'],$_GET['typ']);

		$xls = new oExcel;
		$i = 1;
		$xls->addRow($i++, ['Connote', 'Ref', 'Agent Id', 'Consol No','ETA','Type', 'AWB', 'Memo', 'Assigned Agent', 'Process Status', 'Status', 'Delivery Booking Time','Booking Ref', 'Note', 'Org Name', 'First Process Time', 'Last Process Time', 'goods available address', 'Package', 'Weight', 'Total CBM', 'Name', 'Tel', 'Address', 'Suburb', 'State', 'Postcode','Region','Amazon PO','FBA ID','Rack']);

		foreach ($dp->data as $r) {
			$myRegion = $r->getRegion($_GET['pod_id']);
			$xls->addRow($i++, ['="'.$r->shipment->hbn.'"', '="'.$r->shipment->ref.'"', $r->shipment->agent_id, $r->shipment->consol->no,$r->shipment->consol->eta,$r->getConsolServiceType(), $r->shipment->consol->awb, $r->shipment->can, $r->mdata['assigned_user'], $r->getStatus(), $r->shipment->getStatus(), $r->deliveryBookingTime,@$r->amazon_info->booking_ref, $r->note, $r->driver->name, $r->getFirstProcessTime(), $r->getLastProcessTime(), @DmawbConsol::$available_address_name[$r->shipment->consol->mdata["goods_available_address"]], $r->shipment->pkg, $r->shipment->weight, $r->getTotalCBM(), $r->shipment->cnee->name, $r->shipment->cnee->tel, $r->shipment->cnee->address, $r->shipment->cnee->suburb, $r->shipment->cnee->state, $r->shipment->cnee->postcode,$myRegion,@$r->shipment->mdata['amazon_po'],@$r->shipment->mdata['amazon_shipment_ids'],$r->shipment->getRackName(false,false)]);
		}


		$xls->output('cargo_process_export_'.time().'.xlsx');
	}

	public function actionExportAgent()
	{
		$cargo=new CargoProcess('search');
		$cargo->unsetAttributes();

		if(!empty($_GET['CargoProcess']))
		{
			$cargo->setAttributes($_GET['CargoProcess']);
			if(isset($_GET['CargoProcess']['assignedUser']))
			{
				$cargo->assignedUser = $_GET['CargoProcess']['assignedUser'];
			}
			if(isset($_GET['CargoProcess']['driver_id']))
			{
				$cargo->driver_id = $_GET['CargoProcess']['driver_id'];
			}
			if(isset($_GET['ImParcel']['consol_no']))
			{
				$cargo->consol_no = $_GET['ImParcel']['consol_no'];
			}
		}

		if(isset($_GET['status']))
		{
			$cargo->status = $_GET['status'];
		}

		$dp = $cargo->search(false, false,false,true,$_GET['pod_id'],$_GET['typ']);
		$sheets = [];
		$allData = $dp->data;
		foreach ($allData as $key => $data) {
			$date = date("Y-m",strtotime($data->logs[0]->time));
			if(!empty($sheets[$date]))
			{
				$sheets[$date][]=$data;
			}else
			{
				$sheets[$date]=[$data];
			}
		}
		$xls = new oExcel;
		$i = 0;
		foreach ($sheets as $key => $datas) {
			if($i!=0)
			{
				$xls->createSheet($key);
				$xls->goSheet($i);
			}else
			{
				$xls->setTitle($key);
			}
			$xls->setColWidthString(['A'=>12,'B'=>12,'C'=>12,'D'=>24,'E'=>24,'F'=>12,'G'=>12,'H'=>12,'I'=>12,'J'=>12,'K'=>12,'L'=>12,'M'=>12,'N'=>24,'O'=>12,'P'=>12,'Q'=>12,'R'=>12,'S'=>12,'T'=>12,'U'=>12,'V'=>12,'W'=>12,'X'=>12,'Y'=>12]);
			$j = 1;
			$xls->addRow($j++, ['货物信息', '', '', '', '', '', '', '', '', '', '', '', '', '', '', '', '', '', '', '', '', '派送信息', '','','']);
			$xls->mergeCells('A1:U1');
			$xls->mergeCells('V1:Y1');
			$xls->addRow($j++, ['序号', '登记日期', '区域', '单号', '重量', '实际尺寸', '体积', 'size diff', '超尺寸备注', '件数', '托拍数量', '货主', '地址', 'Suburb', '邮编', '联系人', '电话', '距离km', 'zone', 'region', '备注', '承运单位', '派送时间','Note','进度备注']);
			foreach ($datas as $key => $cargo) {
				$p = $cargo->shipment;
				$myRegion = $cargo->getRegion($_GET['pod_id']);
				$distance = GoogleMapAPI::getDistance($p);
				if($distance<=30)
				{
					$region = $cargo->getPodName()."-"."1";
				}else if($distance>30 and $distance<=60)
				{
					$region = $cargo->getPodName()."-"."2";
				}elseif($distance>60 and $distance<=90)
				{
					$region = $cargo->getPodName()."-"."3";
				}else
				{
					$region = $cargo->getPodName()."-"."other";
				}
				$xls->addRow($j++, [$key+1,$cargo->getFirstTime(),$cargo->getPodName(),$p->hbn,$p->weight,'',$p->getTotalCBM(),'','',$p->pkg,$p->mdata['amzon_pallet'],$p->agent->name,$p->cnee->address,$p->cnee->suburb,$p->cnee->postcode,$p->cnee->name,$p->cnee->tel,$distance,$region,$myRegion,'','','','','','']);
			}
			$xls->centerAlignment('A1:U1');
			$xls->centerAlignment('V1:Y1');

			$i++;
		}
		$xls->output('cargo_process_agent_export'.time().'.xlsx');
	}

