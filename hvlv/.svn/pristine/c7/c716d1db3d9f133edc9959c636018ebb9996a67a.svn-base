	/**
	 * cargolist;
	 */
	private function getCargoList($cargo_type)
	{
		

		$filtersForm=new FiltersForm;
		$podId=$_GET['pod_id'];
		if (isset($_GET['FiltersForm'])) {
			$filtersForm->filters=$_GET['FiltersForm'];
		}
		$provide=[];
		$joinSql = $cargo_type == CargoProcess::PICKUP_CARGO?$this->joinSqlC:$this->joinSql;
		$pod = SystemSetting::getCargoProcessPodSetting($podId);
		$state = @$pod["postcode"];
		$selectStateStr = "postcode like ";
		$sql ="";
		if(empty($state))
		{
			$state = @$pod["state"];
			$selectStateStr = "state = ";
		}

		$state = "'".$state."'";

		if($cargo_type == CargoProcess::PICKUP_CARGO)
		{
			$sql =" SELECT (@i :=@i + 1) AS id,cg.status,count(*) as number
				, (SELECT count(*) FROM `cargo_process` c ${joinSql} WHERE DATEDIFF(NOW(),date)<=1 and c.status=cg.status and co2.dpt_id ={$podId} {$this->getPostCode($cargo_type)} {$this->getUserStr()} ) as day1
				, (SELECT count(*) FROM `cargo_process` c ${joinSql} WHERE DATEDIFF(NOW(),date)<3 and DATEDIFF(NOW(),date)>1 and c.status=cg.status  and co2.dpt_id ={$podId} {$this->getPostCode($cargo_type)} {$this->getUserStr()} ) as day2
				, (SELECT count(*) FROM `cargo_process` c ${joinSql} WHERE DATEDIFF(NOW(),date)>=3 and c.status=cg.status  and co2.dpt_id ={$podId} {$this->getPostCode($cargo_type)} {$this->getUserStr()} ) as day3
				FROM (SELECT @i := 0) AS it ,`cargo_process` cg JOIN `shipment` s ON cg.shipment_id=s.id 
	            join `addr` ad on s.cnee_id = ad.id
	            join `consol` co on s.consol_id =co.id
				 WHERE cg.status<".CargoProcess::PROCESSDONE." and co.dpt_id ={$podId} {$this->getPostCode($cargo_type,true)} {$this->getUserStr(true)} group by cg.status ";
		}
		else
		{
			$sql =" SELECT (@i :=@i + 1) AS id,cg.status,count(*) as number
				, (SELECT count(*) FROM `cargo_process` c ${joinSql} WHERE DATEDIFF(NOW(),date)<=1 and c.status=cg.status and ad2.{$selectStateStr} {$state} {$this->getPostCode($cargo_type)} {$this->getUserStr()} ) as day1
				, (SELECT count(*) FROM `cargo_process` c ${joinSql} WHERE DATEDIFF(NOW(),date)<3 and DATEDIFF(NOW(),date)>1 and c.status=cg.status  and ad2.{$selectStateStr} {$state} {$this->getPostCode($cargo_type)} {$this->getUserStr()} ) as day2
				, (SELECT count(*) FROM `cargo_process` c ${joinSql} WHERE DATEDIFF(NOW(),date)>=3 and c.status=cg.status and ad2.{$selectStateStr} {$state} {$this->getPostCode($cargo_type)} {$this->getUserStr()} ) as day3
				FROM (SELECT @i := 0) AS it ,`cargo_process` cg JOIN `shipment` s ON cg.shipment_id=s.id 
	            join `addr` ad on s.cnee_id = ad.id
				 WHERE cg.status<".CargoProcess::PROCESSDONE." and ad.{$selectStateStr} {$state} {$this->getPostCode($cargo_type,true)} {$this->getUserStr(true)} group by cg.status ";
		}

		$provide=Yii::app()->db->createCommand($sql)->queryAll();
		$filteredData=$filtersForm->filter($provide);
		$dataprovider=new CArrayDataProvider($filteredData);
		$dataprovider->pagination=['pageSize' =>10,];
		$sort=new CSort();
		$sort->attributes=[
			'number'=>[
				'asc'=>'number ASC',
				'desc'=>'number DESC',
			],
			'status'=>[
				'asc'=>'status ASC',
				'desc'=>'status DESC',
			],
		];
		$sort->defaultOrder = "status ASC";
		$dataprovider->sort=$sort;

		$amazonWeekPlan = [];
		if($cargo_type==CargoProcess::FBA_CARGO)
		{
			$day = date('N');
			if($day<=3)
			{
				$today = date('Y-m-d');
				$thisWeekDayOne = date('Y-m-d',strtotime('-'.($day-1).' day',strtotime($today)));
				$lastWeekDayOne =  date('Y-m-d',strtotime('-7 day',strtotime($thisWeekDayOne)));
				$week1 = [];
				$week2 = [];
				for ($i=0; $i < 5; $i++)
				{
					$iap=ImportsAmazonPlan::model()->find('amazon_booking_time = :abt and dpt_id=:dptId',[':abt'=>$thisWeekDayOne.' 00:00:00',':dptId'=>$podId]);
					$pallet = empty($iap)?'':$iap->pallet;
					$week1[] = [$thisWeekDayOne,$pallet];
					$thisWeekDayOne = HolidayHelper::getNextDay($thisWeekDayOne);

					$iap=ImportsAmazonPlan::model()->find('amazon_booking_time = :abt and dpt_id=:dptId',[':abt'=>$lastWeekDayOne.' 00:00:00',':dptId'=>$podId]);
					$pallet = empty($iap)?'':$iap->pallet;
					$week2[] = [$lastWeekDayOne,$pallet];
					$lastWeekDayOne = HolidayHelper::getNextDay($lastWeekDayOne);
				}
				$amazonWeekPlan = [$week1,$week2];
			}else
			{
				$today = date('Y-m-d');
				$thisWeekDayOne = date('Y-m-d',strtotime('-'.($day-1).' day',strtotime($today)));
				$nextWeekDayOne =  date('Y-m-d',strtotime('+7 day',strtotime($thisWeekDayOne)));
				$week1 = [];
				$week2 = [];
				for ($i=0; $i < 5; $i++)
				{
					$iap=ImportsAmazonPlan::model()->find('amazon_booking_time = :abt and dpt_id=:dptId',[':abt'=>$thisWeekDayOne.' 00:00:00',':dptId'=>$podId]);
					$pallet = empty($iap)?'':$iap->pallet;
					$week1[] = [$thisWeekDayOne,$pallet];
					$thisWeekDayOne = HolidayHelper::getNextDay($thisWeekDayOne);

					$iap=ImportsAmazonPlan::model()->find('amazon_booking_time = :abt and dpt_id=:dptId',[':abt'=>$nextWeekDayOne.' 00:00:00',':dptId'=>$podId]);
					$pallet = empty($iap)?'':$iap->pallet;
					$week2[] = [$nextWeekDayOne,$pallet];
					$nextWeekDayOne = HolidayHelper::getNextDay($nextWeekDayOne);
				}
				$amazonWeekPlan = [$week1,$week2];
			}
		}


		$cargo=new CargoProcess('search');
		$cargo->unsetAttributes();

		if(!empty($_GET['CargoProcess']))
		{
			$cargo->setAttributes($_GET['CargoProcess']);
			if(isset($_GET['CargoProcess']['assignedUser']))
			{
				$cargo->assignedUser = $_GET['CargoProcess']['assignedUser'];
			}
			if(isset($_GET['CargoProcess']['driver_id']))
			{
				$cargo->driver_id = $_GET['CargoProcess']['driver_id'];
			}
			if(isset($_GET['ImParcel']['consol_no']))
			{
				$cargo->consol_no = $_GET['ImParcel']['consol_no'];
			}
			if(isset($_GET['CargoProcess']['exInfo']))
			{
				$cargo->exInfo = $_GET['CargoProcess']['exInfo'];
			}
		}
			
		if (isset($_GET['status'])) {
			if (!empty($_GET['status'])) {
				$cargo->setAttribute('status', $_GET['status']);
			}
			
			if($cargo->status==CargoProcess::PROCESSDONE)
			{
				if(!isset($_GET['CargoProcess']['ref']))
				{
					$cargo->ref ='searching';
				}
			}


			$this->render('_sub_cargos', [
				'cargo' => $cargo,
				'name' => 'All',
				'pod_id'=> $podId,
				'cargo_type' => $cargo_type
			]);
		} else {
			$cargo->setAttribute('id', -1);
			$this->render('cargo_list', ['dataProvider'=>[$dataprovider,$filtersForm],'cargo'=>$cargo,'cargo_type' =>$cargo_type,'amazonWeekPlan'=>$amazonWeekPlan]);
		}
	}

	private function getPostCode($cargoType,$type = false)
	{
		$postCodeStr = "";
		$postcode =CargoProcess::FBAPOSTCODE;
		switch ($cargoType) {
			case CargoProcess::NORMAL_CARGO:
				$postCodeStr ="type =".CargoProcess::NORMAL_CARGO;
				break;
			case CargoProcess::FBA_CARGO:
				$postCodeStr ="type =".CargoProcess::FBA_CARGO;
				break;
			case CargoProcess::B2B_CARGO:
				$postCodeStr ="type =".CargoProcess::B2B_CARGO;
				break;
			case CargoProcess::PICKUP_CARGO:
				$postCodeStr ="type =".CargoProcess::PICKUP_CARGO;
				break;
			default:
				return "";
				break;
		}

		if($type)
		{
			$postCodeStr = " and cg.".$postCodeStr;
		}else
		{
			$postCodeStr = " and c.".$postCodeStr;
		}
		return $postCodeStr;
	}
		
	/**
	 * Air and normal summary;
	 */
	public function actionSummary()
	{
		$preAlert = new ImParcel('search');
		$preAlert->unsetAttributes();
		$preAlert->cargoProcessPreAlert = ["podId"=>'all',"cargoType"=>'all'];
		if(!empty($_GET["ImParcel"]))
		{
			$allEmpty=true;
			foreach ($_GET["ImParcel"] as $key => $value) {
				if(!empty($value)) $allEmpty = false;
			}
			$preAlert->setAttributes($_GET["ImParcel"]);
			if($allEmpty) $preAlert->ref = 'enter ref';
			$this->render('_sub_cargos_pre_alert_summary',["preAlert"=>$preAlert,"podId"=>'all',"cargoType"=>'all']);
			return;
		}else
		{
			$preAlert->ref = 'enter ref';
		}

		$filtersForm=new FiltersForm;
		if (isset($_GET['FiltersForm'])) {
			$filtersForm->filters=$_GET['FiltersForm'];
		}
		$provide=[];
		$sql="SELECT (@i :=@i + 1) AS id, s.agent_id, o.name,count(*) as number, (SELECT count(*) FROM `cargo_process` c  join shipment s2  on c.shipment_id = s2.id
             join org o2 on s2.agent_id = o2.id WHERE DATEDIFF(NOW(),date)<=1 and s.agent_id=s2.agent_id and c.status< ".CargoProcess::PROCESSDONE." {$this->getUserStr()} ) as day1
			, (SELECT count(*) FROM `cargo_process` c join shipment s2  on c.shipment_id = s2.id
             join org o2 on s2.agent_id = o2.id WHERE DATEDIFF(NOW(),date)<3 and DATEDIFF(NOW(),date)>1 and s.agent_id=s2.agent_id  and c.status< ".CargoProcess::PROCESSDONE." {$this->getUserStr()} ) as day2
			, (SELECT count(*) FROM `cargo_process` c join shipment s2  on c.shipment_id = s2.id
             join org o2 on s2.agent_id = o2.id WHERE DATEDIFF(NOW(),date)>=3 and s.agent_id=s2.agent_id  and c.status< ".CargoProcess::PROCESSDONE." {$this->getUserStr()} ) as day3 from
			(SELECT @i := 0) AS it,`cargo_process` cg
             join shipment s  on cg.shipment_id = s.id
             join org o on s.agent_id = o.id
            WHERE cg.status< ".CargoProcess::PROCESSDONE." {$this->getUserStr(true)} group by s.agent_id order by id";

		$provide=Yii::app()->db->createCommand($sql)->queryAll();
		$filteredData=$filtersForm->filter($provide);
		$dataprovider=new CArrayDataProvider($filteredData);
		$dataprovider->pagination=['pageSize' =>10,];
		$sort=new CSort();
		$sort->attributes=[
			'number'=>[
				'asc'=>'number ASC',
				'desc'=>'number DESC',
			],
			'name' => [
				'asc' => 'name ASC',
				'desc' => 'name DESC',
			],
		];
		$sort->defaultOrder = "status ASC";
		$dataprovider->sort=$sort;
		$cargo=new CargoProcess('search');
		$cargo->unsetAttributes();
		if(!empty($_GET['CargoProcess']))
		{
			$cargo->setAttributes($_GET['CargoProcess']);
			if(isset($_GET['CargoProcess']['assignedUser']))
			{
				$cargo->assignedUser = $_GET['CargoProcess']['assignedUser'];
			}
			if(isset($_GET['CargoProcess']['driver_id']))
			{
				$cargo->driver_id = $_GET['CargoProcess']['driver_id'];
			}
			if(isset($_GET['CargoProcess']['consol_no']))
			{
				$cargo->consol_no = $_GET['CargoProcess']['consol_no'];
			}

		}
			
		if (isset($_GET['agent_id'])) {
			if (!empty($_GET['agent_id'])) {
				$cargo->setAgentId($_GET['agent_id']);
			}
			$this->renderPartial('_sub_cargos_summary', [
				'cargo' => $cargo,
				'name' => 'All',
				'cargo_type' => CargoProcess::NORMAL_CARGO
			]);
		} else {
			$cargo->setAttribute('id', -1);
			$this->render('summary', ['dataProvider'=>[$dataprovider,$filtersForm],'cargo'=>$cargo,'preAlert'=>$preAlert]);
		}
	}

	private function getUserStr($type =false,$userId = 0)
	{
		if((User::getCurrentUserType()==User::IMPORT_TRUCK_DELIVERY)||$userId != 0)
		{
			$head ="";
			if($type)
			{
				$head = " and cg.";
			}else
			{
				$head = " and c.";
			}

			if($userId ==0)
			{
				$userId =User::currentUserID();
			}
			return $head."meta like '%\"assigned_user\":\"".$userId."\"%' ";
		}else
		{
			return "";
		}

	}


	public function actionWaitAcr()
	{
		$model=new Consol('search');
		$model->unsetAttributes();
		if (!empty($_GET['Consol'])) {
			$model->setAttributes($_GET['Consol']);
		}
		$model->dpt_id=$_GET['pod_id'];
		$model->service=$_GET['consol_type'];
		$podName=Org::dptList()[$_GET['pod_id']]."-".($_GET['consol_type']==20?"Sea":"Air");
		$model->process_statuses=[ConsolProcess::STATE_WAITING_MAIN_ACR, ConsolProcess::STATE_WAITING_SUB_ACR];
		$model->process_types=[ConsolProcess::TYPE_FULL_PROCESS, ConsolProcess::TYPE_DIRECT_AIR_CONSOL, ConsolProcess::TYPE_DIRECT_SEA_CONSOL];
		$this->render('_sub_consols', ['consol'=>$model,'name'=>$podName.' Waiting ACR']);
	}
		
	public function actionOperation()
	{
		$id = $_GET["id"];
		$cargoProcess = new CargoProcess();
		$ids = [];
		$result =[];
		if(strpos($id,CargoProcess::IP_SEPERATOR))
		{
			$ids = explode(CargoProcess::IP_SEPERATOR,$id);
			$model= $cargoProcess->findByPk($ids[0]);
			$result['ids'] = $id;
		}else
		{
			$model= $cargoProcess->findByPk($id);
		}

		if($model->status== CargoProcess::WAITINGASSIGNDRIVER||$model->status== CargoProcess::AGENTWAITINGASSIGNDRIVER)
		{
			$cargoType = $model->getCargoType();
			$driverType = $model->getShipmentPod();
			$orgModel= new Org();
			$drivers =[];
	        $orgs = $orgModel->findAll(["condition"=>"(cargo_driver_type & ".$driverType.") > 0 and status = 1 ","order"=>'`by` desc']);
	        foreach ($orgs as $key => $org) {
	            if($org->by!=1)
	            {
	                $oname = 'A';
	            }else
	            {
	                $oname = 'system';
	            }
	            $drivers[$org->id] = "(".$oname.")".$org->name;
	        }
			$result['drivers'] =$drivers;
		}

		$result['model'] = $model;
		$this->render('operation_tab', $result);
	}
	public function actionLog($id)
	{
		$model = CargoProcess::model()->findByPk($id);
		if ($model==null) {
			throw new CHttpException(404, 'The requested page does not exist.');
		}
		$this->render('log', [
			'model'=>$model,
		]);
	}
	/*
		 * change the shipmentProcess status
		 */
	public function actionProcess()
	{
		if (empty($_GET['id'])||empty($_GET['status'])) {
			return false;
		} else {
			$process= ConsolProcess::model()->find('fid=:fid', [':fid'=>$_GET['id']]);
			$process->updateStatus($_GET['status']);
		}
		echo 'done';
		return true;
	}

	public function actionLoadCargoProcess()
	{
		$imparcels = ImParcel::model()->findAll(' (status=60||status=42) && scan_no = 0 && ref like \'ECN%\'');
		foreach ($imparcels as $key => $imparcel) {
			$imparcel->saveToCargoProcess();
		}
		echo "done";
	}

	public function actionUploadPOD($hash)
	{
		$f = $_FILES['file'];
		$filename = $f['tmp_name'];
		$name = $f['name'];
		if(!is_uploaded_file($filename)) return false;
		$hashArray = explode(CargoProcess::IP_SEPERATOR,$hash);
		$filesize = filesize($filename);
		$date = date('Y-m-d H:i:s');
		$fileHash = hash_file('crc32b', $filename).hash('crc32b', $filesize);
		$finfo = finfo_open(FILEINFO_MIME_TYPE);
		$mime = finfo_file($finfo, $f['tmp_name']);
		foreach ($hashArray as $key => $thisHash) {
			$fr = CargoProcess::updateUploadSingleFile($filesize,$date,$fileHash,$finfo,$mime,$filename,$name, $thisHash,false,true,false,true);
			$cargoProcess = CargoProcess::Model()->findByPk($fr->mdata['cargo_process_id']);
			$cargoProcess->log("uploadPOD");
			$cargoProcess->agg_pod_id = $fr->id;
			$cargoProcess->update(["agg_pod_id"]);
			if(!empty($cargoProcess->mdata['caref']))
			{
				$cargoProcess->shipment->updatePodTrackingUrl($cargoProcess->id);
			}else
			{
				$cargoProcess->shipment->updatePodTrackingUrl();
			}
		}
		echo 'DONE';
	}

	public function actionUpdate()
	{
		$id = $_GET["id"];
		if(strpos($id,CargoProcess::IP_SEPERATOR))
		{
			$ids = explode(CargoProcess::IP_SEPERATOR,$id);
			$result['ids'] = $id;
			foreach ($ids as $key => $thisId) 
			{
				$this->updateCargoProcess($thisId);
			}
		}else
		{
			$this->updateCargoProcess($id);
		}
		echo "done";
	}

	public function actionApprove(){
		$strInfo="";
		if(!empty($_POST)){
			$cargoid = $_POST["id"];
			$actionOption = $_POST["action"];
			if($actionOption==1){
				$model = $this->loadModel($cargoid);
				if(!empty($model)){
					$model->status = 98;
					$model->mdata['approveuser']= Yii::app()->user->id;
					$strInfo = "Approved";
					if($model->save()){
						echo json_encode([
							'isSuccess' => true,
							'info'=>$strInfo,
						]);
						return;
					}
				}
			}elseif($actionOption==2){
				$model = $this->loadModel($cargoid);
				if(!empty($model)){
					$model->mdata['problemcargo'] = 0;
					$strInfo = "Rejected";
					if($model->save()){
						echo json_encode([
							'isSuccess' => true,
							'info'=>$strInfo,
						]);
						return;
					}
				}
			}
		}
		echo json_encode([
			'isSuccess' => false,
			'info'=>$strInfo,
		]);
		return;
	}

	public function actionAssignUser()
	{
		Yii::import('application.controllers.GatepassController');
		$id = $_GET["id"];
		$_GET["assignedUser"]=1;
		$user_id = $_GET["user_id"];
		$model = $this->loadModel($id);

		if(strpos($id,CargoProcess::IP_SEPERATOR)||$model->getCargoType()==CargoProcess::FBA_CARGO)
		{
			echo "can't assign user to FBA";
			return;
		}else
		{
			$model->assignUser($user_id);
		}
		echo "done";
	}

	private function updateCargoProcess($id)
	{

		$model= CargoProcess::model()->findByPk($id);
		if(isset($_POST["driver_id"]))
		{
			$model->driver_id = $_POST["driver_id"];
		}
		if(isset($_POST["dpt_id"]))
		{
			$model->dpt_id = $_POST["dpt_id"];
		}
		if(isset($_POST["note"]))
		{
			$model->note = $_POST["note"];
		}

		if(isset($_POST["cargo_type"]))
		{
			$model->type = $_POST["cargo_type"];
		}

		if(isset($_POST["pallet"]))
		{
			$model->mdata['pallet'] = $_POST["pallet"];
			$model->mdata['job_pallet_no'] = $_POST["pallet"];
		}

		if(isset($_POST["CargoDeliveryInfo"]))
		{
			if($model->isNotSub())
			{
				$model->saveNormalDeliveryInfo($_POST['CargoDeliveryInfo']['delivery_booking_time']);
				$model->shipment->saveNormalDeliveryInfo($_POST['CargoDeliveryInfo']['delivery_booking_time']);
				$model->copyAmazonAndCargoDeliveryInfo(1);
			}else
			{
				$model->saveNormalDeliveryInfo($_POST['CargoDeliveryInfo']['delivery_booking_time']);
				$model->shipment->saveNormalDeliveryInfo($_POST['CargoDeliveryInfo']['delivery_booking_time']);
			}
		}

		if(isset($_POST["ImParcel"]["pickup_booking_time"]))
		{
			if(empty($_POST["ImParcel"]["pickup_booking_time"]))
			{
				$model->shipment->mdata['pickup_booking_time'] = '';
			}else
			{
				$model->shipment->mdata['pickup_booking_time'] = $_POST["ImParcel"]["pickup_booking_time"];
			}
			$model->shipment->updateMeta();
		}

		if(isset($_POST['AmazonInfo']['booking_ref']))
		{
			if (!empty($_POST['AmazonInfo']['booking_ref'])) 
			{
				// if($model->isNotSub())
				// {
				// 	$obj = $model->shipment;
				// }else
				// {
					$obj = $model;
				// }
				$amazonInfo=$obj->getAmazonInfo();
				$amazonInfo->booking_ref=$_POST['AmazonInfo']['booking_ref'];
				$date = !empty($_POST['AmazonInfo']['amazon_booking_time'])?$_POST['AmazonInfo']['amazon_booking_time']:null;
				if (!empty($_POST['AmazonInfo']['amazon_booking_time'])||!empty($amazonInfo->amazon_booking_time)) {
					$amazonInfo->amazon_booking_time=$date;
					$obj->mdata['amazon_booking_time']=$date;
					$obj->mdata['booking_ref']=$_POST['AmazonInfo']['booking_ref'];
					if ($obj->shipment->status<90) 
					{
						$obj->updateAmazonBookingTime();
					}
				}
				$amazonInfo->save();
				$obj->update(['meta']);
				if($model->isNotSub())
				{
					$model->copyAmazonAndCargoDeliveryInfo(1);
				}
			}

			$amazonDeleteType = 0;
			if (empty($_POST['AmazonInfo']['booking_ref'])&&(!empty($obj->amazon_info->booking_ref))) {
				$amazonDeleteType += 1;
			}
			
			if (empty($_POST['AmazonInfo']['amazon_booking_time'])&&(!empty($obj->amazon_info->amazon_booking_time))) {
				$amazonDeleteType += 2;
			}

			if($amazonDeleteType>0)
			{
				if($amazonDeleteType>=1&&$amazonDeleteType!=2)
				{
					$obj->amazon_info->booking_ref='';
					$obj->mdata['booking_ref']='';
				}

				if($amazonDeleteType>=2)
				{
					$obj->amazon_info->booking_ref='';
					$obj->mdata['amazon_booking_time']='';
					$obj->amazon_info->amazon_booking_time = null;
				}

				$obj->amazon_info->save();
				$obj->update(['meta']);
			}
		}

		$model->save();
	}

	public function actionTypeList()
	{
		$filtersForm=new FiltersForm;
		$filtersForm1=new FiltersForm1;
		$dpt_id=isset($_GET['pod_id'])?$_GET['pod_id']:-1;
		if (isset($_GET['FiltersForm'])) {
			$filtersForm->filters=$_GET['FiltersForm'];
		}
		if (isset($_GET['FiltersForm1'])) {
			$filtersForm1->filters=$_GET['FiltersForm1'];
		}
		$joinSql = $this->joinSql;
		$sql="";
		$provide=[];
		$pod = SystemSetting::getCargoProcessPodSetting($dpt_id);
		$state = @$pod["postcode"];
		$selectStateStr = "postcode like ";
		$sql ="";
		if(empty($state))
		{
			$state = @$pod["state"];
			$selectStateStr = "state = ";
		}

		$state = "'".$state."'";

		$sql="SELECT (@i :=@i + 1) AS id,cg.status,count(*) as number, (SELECT count(*) FROM `cargo_process` c {$joinSql} WHERE DATEDIFF(NOW(),date)<=1 and c.status=cg.status and  ((c.type!=3 and ad2.{$selectStateStr} {$state}) or (c.type=3 and co2.dpt_id = {$dpt_id})) {$this->getUserStr()} ) as day1
			, (SELECT count(*) FROM `cargo_process` c {$joinSql} WHERE DATEDIFF(NOW(),date)<3 and DATEDIFF(NOW(),date)>1 and c.status=cg.status and ((c.type!=3 and ad2.{$selectStateStr} {$state}) or (c.type=3 and co2.dpt_id = {$dpt_id})) {$this->getUserStr()} ) as day2
			, (SELECT count(*) FROM `cargo_process` c {$joinSql} 
			WHERE DATEDIFF(NOW(),date)>=3 and c.status=cg.status and ((c.type!=3 and ad2.{$selectStateStr} {$state}) or (c.type=3 and co2.dpt_id = {$dpt_id})) {$this->getUserStr()} ) as day3
			FROM (SELECT @i := 0) AS it ,`cargo_process` cg JOIN `shipment` s ON cg.shipment_id=s.id join `addr` ad on s.cnee_id = ad.id join consol co on co.id = s.consol_id
			 WHERE cg.status<".CargoProcess::PROCESSDONE." and s.status<100 and ((cg.type!=3 and ad.{$selectStateStr} {$state}) or (cg.type=3 and co.dpt_id = {$dpt_id})) {$this->getUserStr(true)} group by cg.status";



		$numberSql="SELECT count(1) as number,cg.type FROM `cargo_process` cg JOIN `shipment` s ON cg.shipment_id=s.id join `addr` ad on s.cnee_id = ad.id join consol co on co.id = s.consol_id
			 WHERE cg.status<".CargoProcess::PROCESSDONE." and s.status<100 and  ((cg.type!=3 and ad.{$selectStateStr} {$state}) or (cg.type=3 and co.dpt_id = {$dpt_id})) {$this->getUserStr(true)} group by cg.type";
		$numberProvide = Yii::app()->db->createCommand($numberSql)->queryAll();

		$number = [1=>0,2=>0,4=>0,3=>0];
		foreach ($numberProvide as $key => $value) {
			$number[$value['type']] = $value["number"];
		}
		$provide3=Yii::app()->db->createCommand($sql)->queryAll();
		$filteredData3=$filtersForm1->filter($provide3);
		$dataprovider3=new CArrayDataProvider($filteredData3);
		$dataprovider3->pagination=['pageSize' =>10,];
		$sort=new CSort();
		$sort->attributes=[
			'number'=>[
				'asc'=>'number ASC',
				'desc'=>'number DESC',
			],
			'status'=>[
				'asc'=>'status ASC',
				'desc'=>'status DESC',
			],
		];
		$sort->defaultOrder = "status ASC";
		$dataprovider3->sort=$sort;
		$provide=[];
		$list=Org::dptList();
		$name=isset($list[$dpt_id])?$list[$dpt_id]:"";
		$provide[]=['id'=>1,'name'=>'normal('.$number[1].")",'type'=>1,'url'=>'cargoProcess/cargoList','pod'=>$pod["pod"]];
		$provide[]=['id'=>2,'name'=>'FBA('.$number[2].")",'type'=>2,'url'=>'cargoProcess/fbaList','pod'=>$pod["pod"]];
		$provide[]=['id'=>4,'name'=>'B2B('.$number[4].")",'type'=>2,'url'=>'cargoProcess/b2bList','pod'=>$pod["pod"]];
		$provide[]=['id'=>3,'name'=>'pickup('.$number[3].")",'type'=>3,'url'=>'cargoProcess/pickupList','pod'=>$pod["pod"]];

		$filteredData=$filtersForm->filter($provide);
		$dataprovider=new CArrayDataProvider($filteredData);
		$dataprovider->pagination=['pageSize' =>10];
		$sort=new CSort();
		$sort->attributes=[
			'number'=>[
				'asc'=>'number ASC',
				'desc'=>'number DESC',
			],
			'status'=>[
				'asc'=>'status ASC',
				'desc'=>'status DESC',
			],
		];
		$sort->defaultOrder = "status ASC";
		$dataprovider->sort=$sort;
		$this->render('sub_type_list', ['dataProvider2'=>[$dataprovider,$filtersForm],'dataProvider3'=>[$dataprovider3,$filtersForm1],'name'=>$name]);
	}

	
