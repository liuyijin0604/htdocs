</div>
<script>
$(function(){
	var win = $('#jqmw_<?=$_GET["tabid"];?>');
	var tab = $('#<?=$_GET["tabid"];?>');
	var panel = $('#<?=$_GET["tabid"];?>').data('panel'); 
	
	tab.unbind('reload_sea_consol_process_grid').bind('reload_sea_consol_process_grid', function(){
		$('#<?=$_GET["tabid"];?>_consol_process_grid', tab.data('panel')).yiiGridView('update');
		return false;
	});
	
	$('form#sea-process-operation-form',win).on('success',function(){
		tab.trigger('reload_sea_consol_process_grid');
	});

	function save()
	{
		var form = new FormData(document.getElementById("sea-process-operation-form"));
		 $.ajax({
		            url: '<?=$url."?id=".$id?>',
		            type: "post",
		            data: form,
		            processData: false,
		            contentType: false,
		            success: function(r) {
		                if(r=='done')
		                 {
							myApp.notice('Done', 5000);
						 }else
						 {
							myApp.alert(r, false);   
			             }
			             tab.trigger('reload_sea_consol_process_grid');
			         },
		            error: function(e) {
		                console.log(e);
		            }
		        });	
	}

	$('.updateStatus',win).click(function(){
		var selected=$("#consol_process_status").val();
		if(confirm('Are you sure to update status?')){
			$.get('<?=$this->createUrl("consolProcess/process",["id"=>$model->process->id]);?>'+"?status="+selected,function(r){
				if(r == 'done'){
					myApp.notice('Done', 5000);
				}else{
					myApp.alert(r, false);
				}
				tab.trigger('reload_consol_process_grid');
			});
	 	}
	});

	$('.update',win).on('click',function(){
		if( confirm('Are you sure to save?')){	
			save();	
		}
		return false;
	});

	$('.edit_cartage_email',win).on('click',function(){
		$('#cartageLink',win).click();
	});

	$('.update_note',win).on('click',function(){
			var data={};

			var process_note=$('#process_note').val();
			data['process_note']=process_note;
//        console.log(data);
			$.ajax({
					url:'<?=Yii::app()->createURL("consolProcess/seaUpdate",array("id"=>$process->id))?>',
					method:"POST",
					data:data,
					success:function(r){
						 if(r == 'done'){
									myApp.notice('Done', 3000);
							}else{
									myApp.alert(r, false);
							}
							 tab.trigger('reload_sea_consol_process_grid');
						}
			});
		});


});
</script>