<script type="text/javascript">
    $(function(){
        var tab = $('#<?=$_GET["tabid"];?>');
        var panel = tab.data('panel');
        $('form#chargecode-surcharge-import-form', panel).data('custom_success', function(r){
            $('#chargecode_surcharge_rate_import_btn', panel).attr('disabled', false);
            return true;
        });

    });
</script>