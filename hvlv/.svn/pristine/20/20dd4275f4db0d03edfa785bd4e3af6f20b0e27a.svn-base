    }

    public function saveDailyReportDetail($type,$result,$dptId)
    {
        $rc = ReportCache::model()->find("create_time = :createTime and type =:type and dpt_id = :dptId",[":createTime"=>date('Y-m-d 00:00:00'),":type"=>$type,":dptId"=>$dptId]);
        if(empty($rc))
        {
            $rc = new ReportCache();
            $rc->type = $type;
            $rc->status = 1;
            $rc->mdata=$result;
            $rc->create_time = date("Y-m-d 00:00:00");
            $rc->creater = 1;
            $rc->modify_time = date('Y-m-d H:i:s');
            $rc->dpt_id = $dptId;
            $rc->save();
        }else
        {
            $rc->mdata  = $result;
            $rc->update(['meta']);
        }
    }

    public function exportPreAlert($model,$hideCusotmer=false,$depotId=-1) {
        $genTotalWeight =0;
        $title = [];
        $airLineArray = [];
        $qantasAirline = [];
        $menziesAirline = [];
        $dnataAirline = [];
        $otherAirline = [];
        // array_push($title, 'Air');
        foreach ($model as $key => $consolModel) {
            if(preg_match('/MENZIES/i',$consolModel->getDeportOriginAgent())){
                 $menziesAirline[] = $model[$key];
            }
            elseif (preg_match('/DNATA/i',$consolModel->getDeportOriginAgent())) {
                $dnataAirline[] = $model[$key];
            }
            elseif (preg_match('/QANTAS/i',$consolModel->getDeportOriginAgent())) {
                $qantasAirline[] = $model[$key];
            }
            else{
                $otherAirline[] = $model[$key];
            }
        }
        if (!empty($qantasAirline)) {
            $airLineArray[] = $qantasAirline;
        }
        if (!empty($menziesAirline)) {
            $airLineArray[] = $menziesAirline;
        }
        if (!empty($dnataAirline)) {
            $airLineArray[] = $dnataAirline;
        }
        if (!empty($otherAirline)) {
            $airLineArray[] = $otherAirline;
        }
        
        if($depotId==106){ // Air
            array_push($title, "TLA Imports Cargo Picking List SYD");
        }
        elseif($depotId==218){ // Air
            array_push($title, "TLA Imports Cargo Picking List MEL");
        }
        elseif($depotId==811){ // Air
            array_push($title, "TLA Imports Cargo Picking List PER");
        }
        elseif($depotId==-1){ // Air
            array_push($title, "TLA Imports Cargo Picking List ALL");
        }       

        $provideArray=[];
        foreach ($airLineArray as $key => $airLine) {
            $provide=[];
            foreach ($airLine as $key => $value) { 

                $ownerNames="";
                $owner=Org::model()->findBypk(@$value->mdata['owner_id']);
                if (!empty($owner)) {                    
                    $ownerNames=$owner->code;
                }
                else{
                    $ownerIds=array_column(@$value->totOrg(),'org_id');
                    if(!empty($ownerIds)){
                        $criteria = new CDbCriteria();
                        $ownerIdsStr=implode(",", $ownerIds);
                        $criteria->addCondition(" id in ({$ownerIdsStr}) ");
                        $owners=Org::model()->findAll($criteria);
                        $ownerCodes=array_column($owners,'code'); 
                        $ownerNames=implode(",", $ownerCodes);
                    }

                } 
                $provide[]=['doAgent'=>$value->getDeportOriginAgent(),'customer'=>$ownerNames,'mawb'=>$value->awb,'eta'=>$value->eta,'pcs'=>$value->getBLpcs(), 'weight'=>round($value->totWeight()), 'type'=>empty($value->getReal()->mdata["air_type"])?ImcoConsol::$air_types[$value->mdata["air_type"]]:ImcoConsol::$air_types[$value->getReal()->mdata["air_type"]], 'pmc'=>@$value->mdata['pmc_ake_number'], 'note'=>@$value->process->mdata['process_note'], 'consol'=>$value];          
            }
            $filtersForm=new FiltersForm;
            $filteredData=$filtersForm->filter($provide);
            $dataprovider=new CArrayDataProvider($filteredData);
            $sort=new CSort();
            $sort->attributes=[
                'doAgent'=>[
                    'asc'=>'doAgent ASC',
                    'desc'=>'doAgent DESC',
                ],
                'customer'=>[
                    'asc'=>'customer ASC',
                    'desc'=>'customer DESC',
                ],
            ];
            $sort->defaultOrder = "customer ASC";
            $dataprovider->sort=$sort;
            $provideArray[]=$dataprovider;
        }
        $this->generatePreAlertAir($provideArray,$title,'pre_alert_report_',$hideCusotmer);    
    }

    public function generatePreAlertAir($airLineArray,$title=[],$fileName='pre_alert_report_',$hideCusotmer=false){
        $xls = new oExcel;
        $i = 1;
        $xls->setColWidth(array_fill(0, 30, 15));
        $xls->getActiveSheet()->mergeCells('A1:J1');               
        $xls->setFont('A1:F1', array('bold' => true));
        $xls->getActiveSheet()->getStyle('A1:J1')->getAlignment()->setHorizontal(\PHPExcel_Style_Alignment::HORIZONTAL_CENTER);
        $xls->getActiveSheet()->getStyle('A1:J1')->getAlignment()->setVertical(\PHPExcel_Style_Alignment::VERTICAL_CENTER);
        $xls->getActiveSheet()->getStyle('A1:J1')->getFont()->setSize(16)->setBold(true);
        $xls->getActiveSheet()->mergeCells('A2:J2');
        $xls->getActiveSheet()->getStyle('A2:J2')->getFill()->setFillType(\PHPExcel_Style_Fill::FILL_SOLID); 
        $xls->getActiveSheet()->getStyle('A2:J2')->getFill()->getStartColor()->setRGB('33B8FF'); 
        $xls->getActiveSheet()->mergeCells('I3:J3');
        $xls->addRow($i++, $title);
        $i++;
        $xls->addRow($i++, ['','','','','','','','', date('m/d/Y h:i:s a', time())]);
        // print_r($airLineArray[0]->data[0]['weight']+2);
        // Yii::app()->end();
        $genTotalWeight=0;

        foreach ($airLineArray as $key => $airLine) {        
            $xls->addRow($i++, ['', 'Customer','MAWB', 'ETA', 'STATUS', 'PCS', 'WEIGHT', 'TYPE', 'PMC/AKE', 'NOTE']);
            $totalWeight = 0;
            foreach ($airLine->data as $key => $value) {                
                if($this->checkIfEweConsol($value['consol'])){
                    $xls->getActiveSheet()->getStyle('B' . $i . ':C' . $i)->getFill()->setFillType(\PHPExcel_Style_Fill::FILL_SOLID);
                    $xls->getActiveSheet()->getStyle('B' . $i . ':C' . $i)->getFill()->getStartColor()->setRGB('FFC133'); 
                }
                if($this->checkIfDaiPostConsol($value['consol'])){
                    $xls->getActiveSheet()->getStyle('B' . $i . ':C' . $i)->getFill()->setFillType(\PHPExcel_Style_Fill::FILL_SOLID);
                    $xls->getActiveSheet()->getStyle('B' . $i . ':C' . $i)->getFill()->getStartColor()->setRGB('9BDEFD'); 
                }
          
                $xls->addRow($i++, [$value['doAgent'], $value['customer'], $value['mawb'], $value['eta'], '', $value['pcs'], $value['weight'], $value['type'], $value['pmc'], $value['note']]);
                $totalWeight += $value['weight'];
            }
            $xls->addRow($i++, ['', '','TOTAL', '', '', '', $totalWeight, '', '']);
            $genTotalWeight += $totalWeight;
            $xls->getActiveSheet()->getStyle('A' . $i . ':J' . $i)->getFill()->setFillType(\PHPExcel_Style_Fill::FILL_SOLID);
            $xls->getActiveSheet()->getStyle('A' . $i . ':J' . $i)->getFill()->getStartColor()->setRGB('33B8FF'); 
            $i++;
        }
        $xls->addRow($i++, ['', '','GRAND TOTAL', '', '', '', $genTotalWeight, '', '']);

        // Add borders to all cells with data
        $lastRowIndex = $xls->getActiveSheet()->getHighestRow();
        $lastColumnIndex = $xls->getActiveSheet()->getHighestColumn();
        $range = 'A1:J'.$lastRowIndex;
        $BStyle = array(
          'borders' => array(
            'allborders' => array(
              'style' => PHPExcel_Style_Border::BORDER_THIN
            )
          )
        );
        $xls->getActiveSheet()->getStyle($range)->applyFromArray($BStyle);

        if($hideCusotmer){
            $columnIndex = 1; // 列索引从0开始，1表示第二列
            $columnDimension = $xls->getActiveSheet()->getColumnDimensionByColumn($columnIndex);
            $columnDimension->setVisible(false);
        }

        $xls->output($fileName.time().'.xlsx');
    }

    public function checkIfEweConsol($consol){
        $ownerIds = array(4660,4618,4657);
        if(array_intersect($ownerIds,$consol->getOwnerName(true))){
            return true;
        }
        else{
            return false;
        }
    }

    public function checkIfDaiPostConsol($consol){
        $ownerIds = array(4669);
        if(array_intersect($ownerIds,$consol->getOwnerName(true))){
            return true;
        }
        else{
            return false;
        }
    }

    public function exportPreAlertSea($model,$hideCusotmer=false,$depotId=-1) {
        $genTotalWeight =0;
        $title = "";
        // array_push($title, 'Air');

        switch ($depotId) {
            case 106:
                $title="TLA SYD SEA SCHEDULE";
                break;
            case 218:
                $title="TLA MEL SEA SCHEDULE";
                break;
            case 529:
                $title="TLA ADE SEA SCHEDULE";
                break;           
            case 530:
                $title="TLA BNE SEA SCHEDULE";
                break;
             case 811:
                $title="TLA PER SEA SCHEDULE";
                break;
            case 2936:
                $title="TLA FRE SEA SCHEDULE";
                break;
            case -1:
                $title="TLA ALL SEA SCHEDULE";
                break;            
            default:
                // code...
                break;
        }

        $xls = new oExcel;
        $i = 1;
        $xls->setColWidth(array_fill(0, 30, 15));
        $xls->getActiveSheet()->mergeCells('A1:I1');               
        $xls->setFont('A1:I1', array('bold' => true));
        $xls->getActiveSheet()->getStyle('A1:I1')->getAlignment()->setHorizontal(\PHPExcel_Style_Alignment::HORIZONTAL_CENTER);
        $xls->getActiveSheet()->getStyle('A1:I1')->getAlignment()->setVertical(\PHPExcel_Style_Alignment::VERTICAL_CENTER);
        $xls->getActiveSheet()->getStyle('A1:I1')->getFont()->setSize(16)->setBold(true);
        // $xls->getActiveSheet()->mergeCells('A2:I2');
        // $xls->getActiveSheet()->getStyle('A2:I2')->getFill()->setFillType(\PHPExcel_Style_Fill::FILL_SOLID); 
        // $xls->getActiveSheet()->getStyle('A2:I2')->getFill()->getStartColor()->setRGB('33B8FF'); 
        // $xls->getActiveSheet()->mergeCells('J1:K1');
        $xls->addRow($i++, [$title]);
        $xls->addRow($i++, ['', 'Type','CTRN NO.', 'Voyage No', 'ETA', 'Customer', 'Delivery Date', 'Unpack Date', 'Weekday', 'Unpacking Team', 'Time']); 
        $xls->getActiveSheet()->getStyle('A2:K2')->getFont()->setSize(12)->setBold(true);

        foreach ($model as $key => $value) {

            // if(!empty($value->process->mdata['unpacking_team'])){
            //     $xls->getActiveSheet()->getStyle('A' . $i . ':K' . $i)->getFill()->setFillType(\PHPExcel_Style_Fill::FILL_SOLID);
            //     $xls->getActiveSheet()->getStyle('A' . $i . ':K' . $i)->getFill()->getStartColor()->setRGB('FFC133'); 
            // }
            $unpackingDate=@$value->mdata['ContainerUnloadDate'];  
            $unpackingTeams=SeaConsolService::getUnpackingTeam($value);
            $unpackStaff=empty($value->process->mdata['unpacking_team'])?"":$unpackingTeams[@$value->process->mdata['unpacking_team']];
            $weekday=empty($unpackingDate)?"":date('l', strtotime($unpackingDate));            
            $ownerNames="";
            if (!empty($value->mdata['owner_id'])) {
                $owner=Org::model()->findBypk($value->mdata['owner_id']);
                $ownerNames=$owner->code;
            }
            else{
                $ownerIds=array_column(@$value->totOrg(),'org_id');
                if(!empty($ownerIds)){
                    $criteria = new CDbCriteria();
                    $ownerIdsStr=implode(",", $ownerIds);
                    $criteria->addCondition(" id in ({$ownerIdsStr}) ");
                    $owners=Org::model()->findAll($criteria);
                    $ownerCodes=array_column($owners,'code'); 
                    $ownerNames=implode(",", $ownerCodes);
                }

            }           
            
            $xls->addRow($i++, [ORG::$warehouse_list[$value->dpt_id], DmawbConsol::$containerTypes[$value->getReal()->mdata['sea_type']], @$value->mdata['container_no'], $value->flight, $value->eta, $ownerNames, @$value->mdata['pickup'], $unpackingDate, $weekday, $unpackStaff]);
        }

        // Add borders to all cells with data
        $lastRowIndex = $xls->getActiveSheet()->getHighestRow();
        $lastColumnIndex = $xls->getActiveSheet()->getHighestColumn();
        $range = 'A1:K'.$lastRowIndex;
        $BStyle = array(
          'borders' => array(
            'allborders' => array(
              'style' => PHPExcel_Style_Border::BORDER_THIN
            )
          )
        );
        $xls->getActiveSheet()->getStyle($range)->applyFromArray($BStyle);

        if($hideCusotmer){
            $columnIndex = 5; // 列索引从0开始，1表示第二列
            $columnDimension = $xls->getActiveSheet()->getColumnDimensionByColumn($columnIndex);
            $columnDimension->setVisible(false);
        }

        $xls->output('pre_alert_report_sea'.time().'.xlsx');
    }


}

