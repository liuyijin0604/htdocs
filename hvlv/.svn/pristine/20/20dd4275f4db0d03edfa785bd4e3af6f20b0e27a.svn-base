<?php
class ConsolProcessService extends Service
{
    public function getSumConsolProcessCreateToday($dptId)
    {
        $result = [];
        $totalCountNew = $airCountNew = $seaCountNew = 0;
        $totalCbmNew = $airCbmNew = $seaCbmNew = 0;
        $totalWeightNew = $airWeightNew = $seaWeightNew = 0;
        
        $today = date("Y-m-d");
        $yesterday = date("Y-m-d", strtotime("-1 day"));
        // models = all new created consol process at the given dptId from yesterday 17:00 to today 16:59
        $models = ConsolProcess::model()->findAllBySql('SELECT * FROM consol_process WHERE fid IN (SELECT id FROM consol WHERE dpt_id = ' .$dptId. ') AND started >= "' . $yesterday . ' 17:00:00" AND started <= "' . $today . ' 16:59:59"');

        if(!empty($models))
        {
            /**
             * Calculate air and sea consol's count, CBM, and weight.
             * Total = air + sea
             */
            foreach($models as $model) 
            {
                if($model->main_type == 1)
                {
                    $airCountNew++;
                    $airCbmNew += number_format($model->consol->totCBM(), 3, '.', '');
                    $airWeightNew += number_format($model->consol->totWeight(), 3, '.', '');
                }
                if($model->main_type == 2)
                {
                    $seaCountNew++;
                    $seaCbmNew += number_format($model->consol->totCBM(), 3, '.', '');
                    $seaWeightNew += number_format($model->consol->totWeight(), 3, '.', '');
                }
            }
            $totalCountNew = $airCountNew + $seaCountNew;
            $totalCbmNew = $airCbmNew + $seaCbmNew;
            $totalWeightNew = $airWeightNew + $seaWeightNew;
        }

        $result['totalCount'] = $totalCountNew;
        $result['totalCBM'] = $totalCbmNew;
        $result['totalWeight'] = number_format($totalWeightNew, 3, '.', '');

        $result['airCount'] = $airCountNew;
        $result['airCBM'] = $airCbmNew;
        $result['airWeight'] = number_format($airWeightNew, 3, '.', '');

        $result['seaCount'] = $seaCountNew;
        $result['seaCBM'] = $seaCbmNew;
        $result['seaWeight'] = number_format($seaWeightNew, 3, '.', '');

        return $result;
    }

    /**
     * Find all consol processes which have been done (status becomes 80).
     * Use date instead of started.
     * All the rest is the same as new
     */
    public function getSumConsolProcessDoneToday($dptId)
    {
        $result = [];
        $totalCountDone = $airCountDone = $seaCountDone = 0;
        $totalCbmDone = $airCbmDone = $seaCbmDone = 0;
        $totalWeightDone = $airWeightDone = $seaWeightDone = 0;
        $today = date("Y-m-d");
        $yesterday = date("Y-m-d", strtotime("-1 day"));
        $models = ConsolProcess::model()->findAllBySql('SELECT * FROM consol_process WHERE fid IN (SELECT id FROM consol WHERE dpt_id = '.$dptId.') AND date >="'.$yesterday.' 17:00:00" AND date <= "' . $today . ' 16:59:59" AND status = 80');

        if(!empty($models))
        {
            foreach($models as $model)
            {
                if($model->main_type == 1)
                {
                    $airCountDone++;
                    $airCbmDone += $model->consol->totCBM();
                    $airWeightDone += $model->consol->totWeight();
                }
                if($model->main_type == 2)
                {
                    $seaCountDone++;
                    $seaCbmDone += $model->consol->totCBM();
                    $seaWeightDone += $model->consol->totWeight();
                }
            }
            $totalCountDone = $airCountDone + $seaCountDone;
            $totalCbmDone = $airCbmDone + $seaCbmDone;
            $totalWeightDone = $airWeightDone + $seaWeightDone;
        }
        $result['totalCount'] = $totalCountDone;
        $result['totalCBM'] = number_format($totalCbmDone, 3, '.', '');
        $result['totalWeight'] = number_format($totalWeightDone, 3, '.', '');

        $result['airCount'] = $airCountDone;
        $result['airCBM'] = number_format($airCbmDone, 3, '.', '');
        $result['airWeight'] = number_format($airWeightDone, 3, '.', '');

        $result['seaCount'] = $seaCountDone;
        $result['seaCBM'] = number_format($seaCbmDone, 3, '.', '');
        $result['seaWeight'] = number_format($seaWeightDone, 3, '.', '');

        return $result;
    }

    /**
     * Find all consol processes which havn't been done (status != 80)
     */
    public function getSumConsolProcessLeftToday($dptId)
    {
        $result = [];
        $totalCountLeft = $airCountLeft = $seaCountLeft = 0;
        $totalCbmLeft = $airCbmLeft = $seaCbmLeft = 0;
        $totalWeightLeft = $airWeightLeft = $seaWeightLeft = 0;
        $today = date("Y-m-d");
        $yesterday = date("Y-m-d", strtotime("-1 day"));
        $models = ConsolProcess::model()->findAllBySql('SELECT cp.* FROM consol_process cp left outer join consol c on cp.fid = c.id WHERE c.dpt_id = '.$dptId.' AND cp.status != 80 AND c.status !=100');
        if(!empty($models))
        {
            foreach($models as $model)
            {
                if($model->main_type == 1)
                {
                    $airCountLeft++;
                    $airCbmLeft += $model->consol->totCBM();
                    $airWeightLeft += $model->consol->totWeight();
                }
                if($model->main_type == 2)
                {
                    $seaCountLeft++;
                    $seaCbmLeft += $model->consol->totCBM();
                    $seaWeightLeft += $model->consol->totWeight();
                }
            }
            $totalCountLeft = $airCountLeft + $seaCountLeft;
            $totalCbmLeft = $airCbmLeft + $seaCbmLeft;
            $totalWeightLeft = $airWeightLeft + $seaWeightLeft;
        }
        $result['totalCount'] = $totalCountLeft;
        $result['totalCBM'] = number_format($totalCbmLeft, 3, '.', '');
        $result['totalWeight'] = number_format($totalWeightLeft, 3, '.', '');

        $result['airCount'] = $airCountLeft;
        $result['airCBM'] = number_format($airCbmLeft, 3, '.', '');
        $result['airWeight'] = number_format($airWeightLeft, 3, '.', '');

        $result['seaCount'] = $seaCountLeft;
        $result['seaCBM'] = number_format($seaCbmLeft, 3, '.', '');
        $result['seaWeight'] = number_format($seaWeightLeft, 3, '.', '');

        return $result;
    }

    public function getConsolProcessDailyReport($dptId)
    {
        $result = [];
        $todayNew = $this->getSumConsolProcessCreateToday($dptId);
        $todayDone = $this->getSumConsolProcessDoneToday($dptId);
        $todayLeft = $this->getSumConsolProcessLeftToday($dptId);
        $result['todayNew'] = $todayNew;
        $result['todayDone'] = $todayDone;
        $result['todayLeft'] = $todayLeft;

        return $result;
    }

    public static function getConsolProcessRecord($dptId, $reportCacheType)
	{
		$consolProcessService = new ConsolProcessService;
		$arrSydReport = $consolProcessService->getConsolProcessDailyReport($dptId);
		$temp = json_encode($arrSydReport);
		$modelReportCacheSYD = new ReportCache();
		$modelReportCacheSYD->type = $reportCacheType;
		$modelReportCacheSYD->status = ReportCache::Active;
		$modelReportCacheSYD->meta = $temp;
		$modelReportCacheSYD->create_time = date('Y-m-d');
		$modelReportCacheSYD->creater = 1;
		$modelReportCacheSYD->modify_time = date('Y-m-d');
		$modelReportCacheSYD->modifyer = 1;
		$modelReportCacheSYD->save();
	}


    public function checkNOAEmail($email)
    {
        $awb = "";
        $flight = "";
        $airline = "";
        $content = "";
        $terminal = "";
        $emailType = "";
        if(preg_match('/menzie/i',$email->from_email)&&preg_match('/notification\sof\sarrival/i',$email->subject))
        {
            $emailType = "MENZIE";
            if(preg_match('/Airwaybill\snumber:\s(\d{3})\s(\d{4})\s(\d{4})/i',$email->plain_body,$m))
            {
                $content = $email->plain_body;
            }else
            {
                if(!empty($email->attachments))
                {
                    foreach ($email->attachments as $key => $attachment) {
                        if(preg_match('/NOA_/i',$attachment->name))
                        {
                            $content = file_get_contents($attachment->getFile());
                        }
                    }
                }
            }

            if(!empty($content))
            {
                preg_match('/Airwaybill\snumber:\s(\d{3})\s(\d{4})\s(\d{4})/i',$content,$m);
                $awb = $m[1]."-".$m[2].$m[3];
                if(preg_match('/Arriving\sFlight:\s(.*)\sDate/i',$content,$m))
                {
                    $flight = $m[1];
                    $airline = explode(" ",$flight)[0];
                    $flight = explode(" ",$flight)[1];
                }
                if(preg_match('/Terminal\s(Two)\sWarehouse/i',$content,$m))
                {
                    $terminal = $m[1];
                }


            }else
            {
                Emailog::sendEmailTo('dev@toplogistics.com.au', $email->id," NOA Loading Error");
            }

        }elseif(preg_match('/dnata/i',$email->from_email)&&(preg_match('/notification\sof\sarrival/i',$email->subject) ||preg_match('/noae/i',$email->subject) ))
        {
            $emailType = "DNATA";
            if(preg_match('/Airwaybill\snumber:\s(\d{3})\s(\d{4})\s(\d{4})/i',$email->plain_body,$m))
            {
                $content = $email->plain_body;
            }else
            {
                if(!empty($email->attachments))
                {
                    foreach ($email->attachments as $key => $attachment) {
                        if(preg_match('/NOA_/i',$attachment->name))
                        {
                            $content = file_get_contents($attachment->getFile());
                        }
                    }
                }
            }

            if(!empty($content))
            {
                preg_match('/Airwaybill\snumber:\s(\d{3})\s(\d{4})\s(\d{4})/i',$content,$m);
                $awb = $m[1]."-".$m[2].$m[3];
                if(preg_match('/Arriving\sFlight:\s(.*)\sDate/i',$content,$m))
                {
                    $flight = $m[1];
                    $airline = explode(" ",$flight)[0];
                    $flight = explode(" ",$flight)[1];
                }
                if(preg_match('/Terminal\s(Two)\sWarehouse/i',$content,$m))
                {
                    $terminal = $m[1];
                }
            }else
            {
                Emailog::sendEmailTo('dev@toplogistics.com.au', $email->id," NOA Loading Error");
            }
        }elseif(preg_match('/qantas/i',$email->from_email)&&preg_match('/\d{3}-\d{8}\sNotified/i',$email->subject))
        {
            $emailType = "QANTAS";
           if(preg_match('/AWB\sNumber:\s(\d{3}-\d{8})/i',$email->plain_body,$m)&&preg_match('/Status:Notified/i',$email->plain_body,$m))
            {
                $awb = $m[1];
                $flight = "";
                $airline = "";
                $content = $email->plain_body;
            }else
            {
                Emailog::sendEmailTo('dev@toplogistics.com.au', $email->id," NOA Loading Error");
            }
        }

        if(empty($awb)) return false;

        $countConsol = Consol::model()->count("json_value(meta,'$.noa_email_identify') = :noa",[":noa"=>$awb.$flight.$airline.$terminal]);
        if($countConsol>0)
        {
            return false;
        }

        $consol = Consol::model()->find("awb = :awb and status != :status and airline = :airline and (flight=:flight or flight=:flight2 or flight=:flight3)",[":awb"=>$awb,":status"=>ImcoConsol::Status_Cancelled,":airline"=>$airline,":flight"=>$airline.$flight,":flight2"=>$airline." ".$flight,":flight3"=>$flight]);

        if(empty($consol))
        {
            $consol = Consol::model()->find(["condition"=>"awb = :awb and status != :status and (bwf&:bwf)=0","params"=>[":awb"=>$awb,":status"=>ImcoConsol::Status_Cancelled,":bwf"=>Consol::NOA_BWF],"order"=>"id asc"]);
        }

        if(empty($consol))
        {
            $eta = "";
            $depot = "";
            $dptId = 0;
            $shipments = 0;
            if(preg_match("/Date:\s(\d{2})\/(\d{2})\/(\d{4})/i",$content,$m))
            {
                $eta = $m[3]."-".$m[2]."-".$m[1];
            }

            if(preg_match("/syd/i",$content,$m))
            {
                $depot = "AUSYD";
                $dptId = Org::TLA_DEPARTMENT_SYDNEY;
            }

            if(preg_match("/mel/i",$content,$m))
            {
                $depot = "AUMEL";
                $dptId = Org::TLA_DEPARTMENT_MELBOURNE;
            }


            if(preg_match("/bne/i",$content,$m))
            {
                $depot = "AUBNE";
                $dptId = Org::TLA_DEPARTMENT_BRISBANE;
            }

            if(preg_match("/Manifested\spieces\:(.*)(\d{1,4})/i",$content,$m))
            {
                $shipments = $m[2];
            }

            if(empty($depot))
            {
                Emailog::sendEmailTo('dev@toplogistics.com.au', $email->id," NOA Loading Error");
                return false;
            }

            $consol = new DmawbConsol('create');
            $consol->owner_id = Org::ORGID_IMPORT_CASUAL_CUSTOMER;
            $consol->service = Consol::AIRCONSOL;
            $consol->eta = $eta;
            $consol->awb = $awb;
            $consol->dpt_id = $dptId;
            $consol->pod = $depot;
            $consol->flight = $airline.$flight;
            $consol->airline = $airline;
            $consol->mdata['shipments'] = $shipments;
            $consol->mdata['NOA_DMAWBCONSOL'] = 1;
            $consol->save();

        }
        sleep(5);

        $depotArr = ["DNATA106"=>"FC48P","DNATA106TWO"=>"GD06H","DNATA218"=>"FC60D","DNATA530"=>"FC54B","MENZIE106"=>"GF70E","MENZIE218"=>"DJ72A","MENZIE530"=>"FZ49A","QANTAS106"=>"8553P","QANTAS218"=>"9532M","QANTAS530"=>"3450K"];
        $originUbm = $depotArr[$emailType.$consol->dpt_id.strtoupper($terminal)];
        $process = $consol->process;
        $consol->bwf = $consol->bwf|Consol::NOA_BWF;
        $consol->mdata['ubm_origin'] = $originUbm;
        if (empty($consol->mdata['ubm_dest'])) {
            $consol->mdata['ubm_dest'] = $consol->getEstID();
        }
        $consol->mdata['noa_email_identify']=$awb.$flight.$airline.$terminal;
        $consol->save();
        sleep(5);
        if(!empty($process))// process NOA log
        {
            $extra = [];
            $extra["NOA_Email"] = $email->no;
            Log::add($process, $process->isNewRecord ? 3 : 4, array_merge(array('status' => $process->getStatus()), $extra));
        }


        if($process->status<ConsolProcess::STATE_WAITING_AIRPORT_CKIN)
        {
            $edimsg = Edimsg::model()->find("type=:type and fid=:fid and status in (10,18,19,20,30,40,50)",[":type"=>"UBMREQ",":fid"=>$consol->id]);
            if(empty($edimsg))
            {
                $icsService = new IcsService();
                $consol->mdata['NOA_SENT_UB'] = 1;
                $consol->updateMeta();
                if($consol->type==ImcoConsol::$my_type)
                {
                    $icsService->preUbm($consol,true);
                }else
                {
                    $icsService->preDmawbUbm($consol,true);
                }
                $consol->mdata['NOA_SENT_UB'] = 1;
                $consol->updateMeta();
                sleep(5);
            }
        }elseif($process->status==ConsolProcess::STATE_WAITING_AIRPORT_CKIN)
        {
            $process->status = ConsolProcess::STATE_WAITING_NOTIFY_DRIVER_PICKUP;
            $process->update(['status']);
            sleep(5);
        }

        if(!empty($consol))
        {
            $extra = [];
            $extra["NOA_Email"] = $email->no;
            Log::add($consol, $consol->isNewRecord ? 3 : 4, array_merge(array('status' => $consol->getStatus()), $extra));
        }

    }


    public function getUserPermission()
    {
        $userOccupation = User::getCurrentUser()->occupation;
        $service = [];
        $status = [];
        $statusStr = "";
        $major = [];
        $majorStr = "";
        foreach(User::$consolOpOccupation as $key => $value)
        {
            if(($userOccupation&$key)>0)
            {
                if(empty($value[0])) break;
                $service[$value[0]] = $value[0];
                $status[$value[1]] = $value[1];
                $major[$value[2]] = $value[2];
            }

        }

        $sumStatus = array_sum($status);
        $sumMajor = array_sum($major);

        if($sumStatus==1)
        {
            $statusStr = "<".ConsolProcess::STATE_WAITING_WH_SCAN;
        }

        return [$service,$statusStr,$sumMajor,$sumStatus];

    }

    public function getUbSummeryList($saveDetail = false)
    {
        $total = 0;
        $done = 0;
        $left = 0;
        $donePercent = 0;
        $detailData = [];
        $tomorrow = HolidayHelper::getNextDay(date("Y-m-d"));
        $allConsols = Consol::model()->findAll("service = :service and eta = :tomorrow and no not like 'WDT%' and status !=:status and type = :type ",[':tomorrow'=>$tomorrow,':service'=>Consol::AIRCONSOL,':status'=>ImcoConsol::Status_Cancelled,":type"=>ImcoConsol::$my_type]);
        $myUserId = User::model()->find("(occupation &:occupation)>0 and active =1",[":occupation"=>User::CONSOL_UB])->id;
        $consolIds = array_column($allConsols, 'id');
        foreach ($allConsols as $key => $consol)
        {
            $myClass = "";
            switch ($consol->type) {
                case ImcoConsol::$my_type:
                    $myClass = "ImcoConsol";
                    break;

                case DmawbConsol::$my_type:
                    $myClass = "DmawbConsol";
                    break;

            }
            if(empty($myClass)) continue;
            $log = Log::model()->find(["condition"=>"model = :model and lid = :lid and type = :type","params"=>[":model"=>$myClass,":lid"=>$consol->id,":type"=>Log::LOG_TYPE_CREATE],"order"=>"id asc"]);
            if(empty($log)) continue;
            if($log->user_id == $myUserId)
            {
                if($consol->service==Consol::AIRCONSOL)
                {
                    if($consol->process->status==ConsolProcess::STATE_UB_ON_SCHEDULE)
                    {
                        $done+=1;
                    }else
                    {
                        $detailData[] = [$consol->no];
                        $left+=1;
                    }
                    continue;
                }

                if($consol->service==Consol::SEACONSOL)
                {
                    if(($consol->process->sub_status&ConsolProcess::DU_UB)>0||$consol->mdata['ubmsent']==1)
                    {
                        $done+=1;
                    }else
                    {
                        $detailData[] = [$consol->no];
                        $left+=1;
                    }
                    continue;
                }

            }
        }
        if($saveDetail)
        {
            $result= [];
            $result['header'] = ["no"];
            $result['totalData'] = [];
            foreach($detailData as $key => $d)
            {
                $result['totalData'][] = [$d[0]];
            }

            $this->saveDailyReportDetail(ReportCache::TODAY_UB_DAILY,$result,0);
            return;
        }

        $total = $done+$left;

        $donePercent = empty($total)?"0%":((number_format($done/$total,2,'.','')*100)."%");
        return ["total"=>$total,"done"=>$done,"left"=>$left,'donePercent'=>$donePercent,'consolNos'=>$detailData];
    }

    public function getScrAcrSummeryList($saveDetail = false)
    {
        $total = 0;
