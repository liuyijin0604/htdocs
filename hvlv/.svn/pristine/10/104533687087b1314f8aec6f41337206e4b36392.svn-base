				// 	}
				// 	// Pickup
				// } else if ($task->getType() == 'Pickup' && !empty($task->mainTask) && in_array($owner->extra['wms_invoice'], ['all', 'fix_rate']) && !in_array($owner->id, [Org::ORGID_3PL_ECOMATTERS])) {
				// 	if (isset($quote->mdata[WmsOrgQuote::QUOTE_MISC_PICKUP_DELIVERY_MIN_CHARGE])) {
				// 		$stot = 0;
				// 		$items = [];
				// 		if ($quote->mdata[WmsOrgQuote::QUOTE_MISC_PICKUP_DELIVERY_MIN_CHARGE] > 0) {
				// 			$quote_type = WmsOrgQuote::QUOTE_MISC_PICKUP_DELIVERY_MIN_CHARGE;

				// 			$stot = 1 * $quote->mdata[WmsOrgQuote::QUOTE_MISC_PICKUP_DELIVERY_MIN_CHARGE];
				// 			$items[] = [$task->getNo(), ucwords($task->mainTask->ref), empty($task->mainTask->compl_time) ? $task->compl_time : $task->mainTask->compl_time, $task->getType(), $quote->mdata[WmsOrgQuote::QUOTE_MISC_PICKUP_DELIVERY_MIN_CHARGE], 1, 1 * $quote->mdata[WmsOrgQuote::QUOTE_MISC_PICKUP_DELIVERY_MIN_CHARGE]];
				// 		}
				// 	} else {
				// 		$errors[] = "10003 - Please set up a valid charge rate for Pickup or Delivery Minimum Charge in the Rate Management";
