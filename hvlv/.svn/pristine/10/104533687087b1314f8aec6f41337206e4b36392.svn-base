				// 	// Container Unload
				// } else if ($task->getType() == 'Container Unload' && !empty($task->mainTask) && in_array($owner->extra['wms_invoice'], ['stock_in_only', 'all', 'fix_rate']) && !in_array($owner->id, [Org::ORGID_3PL_ECOMATTERS])) {
				// 	if ($owner->extra['wms_invoice'] != 'fix_rate') {
				// 		// if same rate for both ctn size
				// 		if (empty($task->mainTask->mdata['ctn_size']) && !empty($quote->mdata[WmsOrgQuote::QUOTE_UNLOAD_20FT_CONTAINER]) && !empty($quote->mdata[WmsOrgQuote::QUOTE_UNLOAD_40FT_CONTAINER]) && $quote->mdata[WmsOrgQuote::QUOTE_UNLOAD_20FT_CONTAINER] == $quote->mdata[WmsOrgQuote::QUOTE_UNLOAD_40FT_CONTAINER]) {
