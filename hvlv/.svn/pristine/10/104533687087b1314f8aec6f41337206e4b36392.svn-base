				} else if ($dpt_id == Org::TLA_DEPARTMENT_MELBOURNE) {
					$numCourierChargeCode = $this->objQuote->mdata[WmsOrgQuote::QUOTE_COURIER_MEL_CHARGECODE_SF];
				} else if ($dpt_id == Org::TLA_DEPARTMENT_BRISBANE) {
					$numCourierChargeCode = $this->objQuote->mdata[WmsOrgQuote::QUOTE_COURIER_BNE_CHARGECODE_SF];
				}

