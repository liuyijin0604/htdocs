				} else if ($dpt_id == Org::TLA_DEPARTMENT_MELBOURNE) {
					$numCourierChargeCode = $this->objQuote->mdata[WmsOrgQuote::QUOTE_COURIER_MEL_CHARGECODE_UTOLL];
				} else if ($dpt_id == Org::TLA_DEPARTMENT_BRISBANE) {
					$numCourierChargeCode = $this->objQuote->mdata[WmsOrgQuote::QUOTE_COURIER_BNE_CHARGECODE_UTOLL];
				}

				break;
			case Org::ORGID_COURIER_UBI_AP:
				if ($dpt_id == Org::TLA_DEPARTMENT_SYDNEY) {
					$numCourierChargeCode = $this->objQuote->mdata[WmsOrgQuote::QUOTE_COURIER_CHARGECODE_UAP];
				} else if ($dpt_id == Org::TLA_DEPARTMENT_MELBOURNE) {
					$numCourierChargeCode = $this->objQuote->mdata[WmsOrgQuote::QUOTE_COURIER_MEL_CHARGECODE_UAP];
				} else if ($dpt_id == Org::TLA_DEPARTMENT_BRISBANE) {
					$numCourierChargeCode = $this->objQuote->mdata[WmsOrgQuote::QUOTE_COURIER_BNE_CHARGECODE_UAP];
				}

				break;
			case Org::ORGID_COURIER_TLA:
				if ($dpt_id == Org::TLA_DEPARTMENT_SYDNEY) {
					$numCourierChargeCode = $this->objQuote->mdata[WmsOrgQuote::QUOTE_COURIER_CHARGECODE_TLACARGO];
				} else if ($dpt_id == Org::TLA_DEPARTMENT_MELBOURNE) {
					$numCourierChargeCode = $this->objQuote->mdata[WmsOrgQuote::QUOTE_COURIER_MEL_CHARGECODE_TLACARGO];
				} else if ($dpt_id == Org::TLA_DEPARTMENT_BRISBANE) {
					$numCourierChargeCode = $this->objQuote->mdata[WmsOrgQuote::QUOTE_COURIER_BNE_CHARGECODE_TLACARGO];
				}

				break;
			case Org::ORGID_COURIER_FASTWAY:
				if ($dpt_id == Org::TLA_DEPARTMENT_SYDNEY) {
					$numCourierChargeCode = $this->objQuote->mdata[WmsOrgQuote::QUOTE_COURIER_CHARGECODE_FASTWAY];
				} else if ($dpt_id == Org::TLA_DEPARTMENT_MELBOURNE) {
					$numCourierChargeCode = $this->objQuote->mdata[WmsOrgQuote::QUOTE_COURIER_MEL_CHARGECODE_FASTWAY];
				} else if ($dpt_id == Org::TLA_DEPARTMENT_BRISBANE) {
					$numCourierChargeCode = $this->objQuote->mdata[WmsOrgQuote::QUOTE_COURIER_BNE_CHARGECODE_FASTWAY];
				}

				break;
			case Org::ORGID_COURIER_BORDER:
				if ($dpt_id == Org::TLA_DEPARTMENT_SYDNEY) {
					$numCourierChargeCode = $this->objQuote->mdata[WmsOrgQuote::QUOTE_COURIER_CHARGECODE_BORDER];
				} else if ($dpt_id == Org::TLA_DEPARTMENT_MELBOURNE) {
					//$numCourierChargeCode = $this->objQuote->mdata[WmsOrgQuote::QUOTE_COURIER_MEL_CHARGECODE_FASTWAY];
				} else if ($dpt_id == Org::TLA_DEPARTMENT_BRISBANE) {
					//$numCourierChargeCode = $this->objQuote->mdata[WmsOrgQuote::QUOTE_COURIER_BNE_CHARGECODE_FASTWAY];
				}
			case Org::ORGID_COURIER_TOLL_IPEC:
				if ($dpt_id == Org::TLA_DEPARTMENT_SYDNEY) {
					$numCourierChargeCode = $this->objQuote->mdata[WmsOrgQuote::QUOTE_COURIER_CHARGECODE_MYTOLL];
				} else if ($dpt_id == Org::TLA_DEPARTMENT_MELBOURNE) {
					$numCourierChargeCode = $this->objQuote->mdata[WmsOrgQuote::QUOTE_COURIER_MEL_CHARGECODE_MYTOLL];
				} else if ($dpt_id == Org::TLA_DEPARTMENT_BRISBANE) {
					$numCourierChargeCode = $this->objQuote->mdata[WmsOrgQuote::QUOTE_COURIER_BNE_CHARGECODE_MYTOLL];
				}
				break;
			case Org::ORGID_COURIER_AUPOST_EXPRESS:
				if ($dpt_id == Org::TLA_DEPARTMENT_SYDNEY) {
					$numCourierChargeCode = $this->objQuote->mdata[WmsOrgQuote::QUOTE_COURIER_CHARGECODE_AUPOST_EXPRESS];
				}
				break;
		}
		if (empty($numCourierChargeCode)) {
			if ($dpt_id == Org::TLA_DEPARTMENT_SYDNEY) {
				$numCourierChargeCode = $this->objQuote->mdata[WmsOrgQuote::QUOTE_COURIER_CHARGECODE];
			} else if ($dpt_id == Org::TLA_DEPARTMENT_MELBOURNE) {
				$numCourierChargeCode = $this->objQuote->mdata[WmsOrgQuote::QUOTE_COURIER_MEL_CHARGECODE];
			} else if ($dpt_id == Org::TLA_DEPARTMENT_BRISBANE) {
				$numCourierChargeCode = $this->objQuote->mdata[WmsOrgQuote::QUOTE_COURIER_BNE_CHARGECODE];
			}
		}
		return $numCourierChargeCode;
	}
}


class CTask2InvoiceDeliveryTNT extends CTask2InvoiceDelivery
{
	// overwrite , TNT surcharge 
	function funcSurcharge()
	{
		// remote
		$remote = 0;
		if (empty($tnt_remote)) $tnt_remote = json_decode(file_get_contents(Yii::app()->basePath . DIRECTORY_SEPARATOR . 'data' . DIRECTORY_SEPARATOR . 'tnt_remote.json'), true);
		if (!empty($tnt_remote[$this->objTask->mdata['cnee']['state']][$this->objTask->mdata['cnee']['postcode']]) && in_array($this->objTask->mdata['cnee']['suburb'], $tnt_remote[$this->objTask->mdata['cnee']['state']][$this->objTask->mdata['cnee']['postcode']])) {
			$remote += 1;
		}

		// WA
		$wa = false;
		if (!empty($this->objTask->mdata['cnee']['state']) && $this->objTask->mdata['cnee']['state'] == 'WA') {
			$wa = true;
		}

		if (!empty($wa)) {
			$this->listItems[] = [$this->objTask->getNo(), ucwords($this->objTask->mainTask->ref), empty($this->objTask->mainTask->compl_time) ? $this->objTask->compl_time : $this->objTask->mainTask->compl_time, 'West Australia 10% surcharge', number_format($this->numSubtotal * 0.1, 2, '.', ''), 1, number_format($this->numSubtotal * 0.1, 2, '.', '')];
			$this->numSubtotal += number_format($this->numSubtotal * 0.1, 2, '.', '');
		}

		if (!empty($remote)) {
			$this->listItems[] = [$this->objTask->getNo(), ucwords($this->objTask->mainTask->ref), empty($this->objTask->mainTask->compl_time) ? $this->objTask->compl_time : $this->objTask->mainTask->compl_time, 'Remote Fee', 30, $remote, $remote * 30];
			$this->numSubtotal += $remote * 30;
		}


		$listOversize = [ //cm , From<=x<To
			20 => [150, 200],
			40 => [200, 300],
			50 => [300, 400],
			250 => [400, 500],
			450 => [500, 600],
			600 => [600, 99999999],
		];

		$strPackage = $this->objTask->mainTask->packTask->mdata['pkg'];
		if (!empty($strPackage)) {
			//check 
			foreach (json_decode($strPackage, true) as $pkg) {
				if (in_array(null, [$pkg['wt'], $pkg['w'], $pkg['h'], $pkg['d']])) {
					$this->listErrors[] = "pack task have no DIM(cm) " . $this->objTask->mainTask->id;
					return;
				}
			}

			foreach (json_decode($strPackage, true) as $pkg) {
				// oversize fee
				$numOversizeSurcharge = 0;
				$numlengthMax =  max($pkg['w'], $pkg['h'], $pkg['d']);
				foreach ($listOversize as $numPrice => $listRange) {
					$numFrom = $listRange[0];
					$numTo = $listRange[1];
					if ($numlengthMax >= $numFrom && $numlengthMax < $numTo) {
						$numOversizeSurcharge = $numPrice;
					}
				}

				if ($numOversizeSurcharge > 0) {
					$this->listItems[] = [
						$this->objTask->getNo(),
						ucwords($this->objTask->mainTask->ref),
						empty($this->objTask->mainTask->compl_time) ? $this->objTask->compl_time : $this->objTask->mainTask->compl_time,
						'Oversize Fee - ' . $pkg['wt'] . 'KG ' . $pkg['w'] . 'x' . $pkg['h'] . 'x' . $pkg['d'] . 'cm',
						$numOversizeSurcharge,
						1,
						$numOversizeSurcharge
					];
					$this->numSubtotal += $numOversizeSurcharge;
				}

				// manual handling fee
				$numManualHandlingSurcharge = 0;
				if ($pkg['d'] < 20 || $pkg['d'] > 120) {
					$numManualHandlingSurcharge = 15;
				} else if ($pkg['w'] < 10 || $pkg['w'] > 60) {
					$numManualHandlingSurcharge = 15;
				} else if ($pkg['h'] < 1.5 || $pkg['h'] > 120) {
					$numManualHandlingSurcharge = 15;
				} else if ($pkg['wt'] < 0.25 || $pkg['wt'] > 30) {
					$numManualHandlingSurcharge = 15;
				}
				if ($numManualHandlingSurcharge > 0) {
					$this->listItems[] = [
						$this->objTask->getNo(),
						ucwords($this->objTask->mainTask->ref),
						empty($this->objTask->mainTask->compl_time) ? $this->objTask->compl_time : $this->objTask->mainTask->compl_time,
						'Manual Handling Fee - ' . $pkg['wt'] . 'KG ' . $pkg['w'] . 'x' . $pkg['h'] . 'x' . $pkg['d'] . 'cm',
						$numManualHandlingSurcharge,
						1,
						$numManualHandlingSurcharge
					];
					$this->numSubtotal += $numManualHandlingSurcharge;
				}
			}
		}
	}
}

class CTask2InvoiceDeliveryEizAllied extends CTask2InvoiceDelivery
{
	// overwrite , Eiz Toll surcharge 
	function funcSurcharge()
	{

		$listlengthLimit = [ //m
			5.4 => [1.2, 2.39],
			11.93 => [2.4, 3.59],
			25.40 => [3.6, 4.19],
			//450=>[4,9999],
		];
		$listDeadWeightLimit = [ //KG
			6.95 => [0, 23],
			13.50 => [23, 56],
			47 => [56, 90],
			92 => [90, 9999]
		];
		$listCubicWeightLimit = [
			6.95 => [0, 23],
			13.50 => [23, 56],
			47 => [56, 135],
			92 => [135, 9999]
		];

		$strPackage = $this->objTask->mainTask->packTask->mdata['pkg'];
		if (!empty($strPackage)) {
			//check 
			foreach (json_decode($strPackage, true) as $pkg) {
				if (in_array(null, [$pkg['wt'], $pkg['w'], $pkg['h'], $pkg['d']])) {
					$this->listErrors[] = "pack task have no DIM(cm) " . $this->objTask->mainTask->id;
					return;
				}
			}

			foreach (json_decode($strPackage, true) as $pkg) {
				$numlengthSurcharge = 0;
				$numlengthMax =  max($pkg['w'], $pkg['h'], $pkg['d']) / 100; //cm to m
				foreach ($listlengthLimit as $numPrice => $listRange) {
					$numFrom = $listRange[0];
					$numTo = $listRange[1];
					if ($numlengthMax >= $numFrom && $numlengthMax < $numTo) {
						$numlengthSurcharge = $numPrice;
					}
				}

				$numDeadWeightSurcharge = 0;
				$numDeadWeight =  $pkg['wt'];
				foreach ($listDeadWeightLimit as $numPrice => $listRange) {
					$numFrom = $listRange[0];
					$numTo = $listRange[1];
					if ($numDeadWeight >= $numFrom && $numDeadWeight < $numTo) {
						$numDeadWeightSurcharge = $numPrice;
					}
				}

				$numCubicWeightSurcharge = 0;
				$numCubicWeight =  $pkg['w'] * $pkg['h'] * $pkg['d'] * 0.00025; // cm m
				foreach ($listCubicWeightLimit as $numPrice => $listRange) {
					$numFrom = $listRange[0];
					$numTo = $listRange[1];
					if ($numCubicWeight >= $numFrom && $numCubicWeight < $numTo) {
						$numCubicWeightSurcharge = $numPrice;
					}
				}

				$numMaxSurcharge =  max($numlengthSurcharge, $numDeadWeightSurcharge, $numCubicWeightSurcharge);
				if ($numMaxSurcharge > 0) {
					$this->listItems[] = [
						$this->objTask->getNo(),
						ucwords($this->objTask->mainTask->ref),
						empty($this->objTask->mainTask->compl_time) ? $this->objTask->compl_time : $this->objTask->mainTask->compl_time,
						'Oversize Fee - ' . $pkg['wt'] . 'KG ' . $pkg['w'] . 'x' . $pkg['h'] . 'x' . $pkg['d'] . 'cm',
						$numMaxSurcharge,
						1,
						$numMaxSurcharge
					];
					$this->numSubtotal += $numMaxSurcharge;
				}
			}
		}
	}
}

class CTask2InvoiceDeliveryEizToll extends CTask2InvoiceDelivery
{
	// overwrite , Eiz Toll surcharge 
	function funcSurcharge()
	{

		$listlengthLimit = [ //m
			14 => [1.2, 1.8],
			75 => [1.8, 3],
			105 => [3, 4],
			450 => [4, 9999],
		];
		$listDeadWeightLimit = [ //KG
			14 => [30, 35],
			75 => [35, 85],
			105 => [85, 9999],
		];
		$listCubicWeightLimit = [
			14 => [30, 35],
			75 => [35, 85],
			105 => [85, 9999],
		];

		$strPackage = $this->objTask->mainTask->packTask->mdata['pkg'];
		if (!empty($strPackage)) {
			//check 
			foreach (json_decode($strPackage, true) as $pkg) {
				if (in_array(null, [$pkg['wt'], $pkg['w'], $pkg['h'], $pkg['d']])) {
					$this->listErrors[] = "pack task have no DIM(cm) " . $this->objTask->mainTask->id;
					return;
				}
			}

			foreach (json_decode($strPackage, true) as $pkg) {
				$numlengthSurcharge = 0;
				$numlengthMax =  max($pkg['w'], $pkg['h'], $pkg['d']) / 100; //cm to m
				foreach ($listlengthLimit as $numPrice => $listRange) {
					$numFrom = $listRange[0];
					$numTo = $listRange[1];
					if ($numlengthMax >= $numFrom && $numlengthMax < $numTo) {
						$numlengthSurcharge = $numPrice;
					}
				}

				$numDeadWeightSurcharge = 0;
				$numDeadWeight =  $pkg['wt'];
				foreach ($listDeadWeightLimit as $numPrice => $listRange) {
					$numFrom = $listRange[0];
					$numTo = $listRange[1];
					if ($numDeadWeight >= $numFrom && $numDeadWeight < $numTo) {
						$numDeadWeightSurcharge = $numPrice;
					}
				}

				$numCubicWeightSurcharge = 0;
				$numCubicWeight =  $pkg['w'] * $pkg['h'] * $pkg['d'] * 0.00025; // cm m
				foreach ($listCubicWeightLimit as $numPrice => $listRange) {
					$numFrom = $listRange[0];
					$numTo = $listRange[1];
					if ($numCubicWeight >= $numFrom && $numCubicWeight < $numTo) {
						$numCubicWeightSurcharge = $numPrice;
					}
				}

				$numMaxSurcharge =  max($numlengthSurcharge, $numDeadWeightSurcharge, $numCubicWeightSurcharge);
				if ($numMaxSurcharge > 0) {
					$this->listItems[] = [
						$this->objTask->getNo(),
						ucwords($this->objTask->mainTask->ref),
						empty($this->objTask->mainTask->compl_time) ? $this->objTask->compl_time : $this->objTask->mainTask->compl_time,
						'Oversize Fee - ' . $pkg['wt'] . 'KG ' . $pkg['w'] . 'x' . $pkg['h'] . 'x' . $pkg['d'] . 'cm',
						$numMaxSurcharge,
						1,
						$numMaxSurcharge
					];
					$this->numSubtotal += $numMaxSurcharge;
				}
			}
		}
	}
}

