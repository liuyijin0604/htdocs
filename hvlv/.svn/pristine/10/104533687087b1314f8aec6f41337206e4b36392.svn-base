//IOC
class FactoryTask2Invoice
{
	static function Create($objTask, $objQuote, $objOrg)
	{
		if (($objTask->getType() == 'Pallets In' || $objTask->getType() == 'Bulk In') && !empty($objTask->mainTask) && in_array($objOrg->extra['wms_invoice'], ['stock_in_only', 'all', 'fix_rate']) && empty($objTask->mainTask->mdata['return'])) {
			// Pallets In
			return new CTask2InvoicePalletsIn($objTask, $objQuote, $objOrg);
		} else if (in_array($objTask->getType(), ['Pick Unit', 'Pick Carton']) && !empty($objTask->mainTask) && in_array($objOrg->extra['wms_invoice'], ['all', 'fix_rate'])) {
			// Pick Unit or Pick Carton
			return new CTask2InvoicePick($objTask, $objQuote, $objOrg);
		} else if ($objTask->getType() == 'Pack Order' && !empty($objTask->mainTask) && in_array($objOrg->extra['wms_invoice'], ['all', 'fix_rate'])) {
			// Pack Order
			return new CTask2InvoicePack($objTask, $objQuote, $objOrg);
		} else if (in_array($objTask->getType(), ['Delivery', 'Re-delivery']) && !empty($objTask->mainTask) && !empty($objTask->mdata['shipment_id']) && in_array($objOrg->extra['wms_invoice'], ['all', 'fix_rate'])) {
			// Delivery or re-delivery
			if ($objTask->mdata['courier'] == Org::ORGID_COURIER_TNT) {
				return new CTask2InvoiceDeliveryTNT($objTask, $objQuote, $objOrg);
			} else if ($objTask->mdata['courier'] == Org::ORGID_COURIER_EIZ_TOLL) {
				return new CTask2InvoiceDeliveryEizToll($objTask, $objQuote, $objOrg);
			} else if ($objTask->mdata['courier'] == Org::ORGID_COURIER_UBI_TOLL || $objTask->mdata['courier'] == Org::ORGID_COURIER_TOLL_IPEC) {
				return new CTask2InvoiceDeliveryUbiToll($objTask, $objQuote, $objOrg);
			} else if ($objTask->mdata['courier'] == Org::ORGID_COURIER_TLA) {
				return new CTask2InvoiceDeliveryTlaCARGO($objTask, $objQuote, $objOrg);
			} else if ($objTask->mdata['courier'] == Org::ORGID_COURIER_EIZ_ALLIED && empty($objTask->mdata['trackingno'])) {
				return new CTask2InvoiceDeliveryEizAllied($objTask, $objQuote, $objOrg);
			}
			return new CTask2InvoiceDelivery($objTask, $objQuote, $objOrg);
		} else if (in_array($objTask->getType(), ['Pickup']) && !empty($objTask->mainTask) && in_array($objOrg->extra['wms_invoice'], ['all', 'fix_rate'])) {
			return new CTask2InvoicePickUpDelivery($objTask, $objQuote, $objOrg);
		}


		return null;
	}
}
