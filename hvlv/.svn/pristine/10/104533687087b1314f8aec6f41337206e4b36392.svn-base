class WmsInvoice
{
	public static function genWmsService($org, $fd, $ttl, $dpt_id)
	{
		$errors = [];
		$aid = $org->id;
		$owner = Org::model()->findByPk($aid);
		// fd start from saturday
		$fdts = strtotime($fd);
		$wd = date('N', $fdts);
		if ($wd != 6) {
			// $fdts = strtotime($fd . ' -' . ($wd + 1) . ' day');
			// fix regenerate last week invoice
			$fdts = strtotime($fd . ' -' . (($wd + 1) % 7) . ' day');
			$fd = date('Y-m-d', $fdts);
		}
		// generate invoice
		$stot = 0;
		while (strtotime($fd) < strtotime($ttl)) {
			$td = date('Y-m-d', strtotime($fd . ' +7 day'));
			$bd = date('Y-m-d', strtotime($fd . ' +9 day'));
			// only create invoice when date after trigger date
			if ($td > date('Y-m-d')) {
				break;
			}
			/*
			1.    when old invoice status in (1,2,3), credit old invoice and create new invoice
			2.    one time period only have one invoice
			but would cause problem, when override in later month
			need to cancel new create invoice then run genWmsInvoice for that time period
			3.    when old invoice status > 3, there is "check dup below"
			 */
			if ($owner->by == 1) {
				$oldInvoice = Invoice::model()->find(['condition' => 'type = 70 AND to_id = :aid AND date = :bd AND status != 10 AND dpt_id =:dpt_id', 'params' => [':aid' => $aid, ':bd' => $bd, ':dpt_id' => $dpt_id], 'order' => 'id DESC']);
			} else {
				$oldInvoice = Invoice::model()->find(['condition' => 'type = 70 AND to_id = :aid AND date = :bd AND status != 10 AND dpt_id =:dpt_id AND JSON_VALUE(meta, "$.suborg") = :suborg', 'params' => [':aid' => $owner->by, ':suborg' => $aid, ':bd' => $bd, ':dpt_id' => $dpt_id], 'order' => 'id DESC']);
			}
			if (!empty($oldInvoice) && in_array($oldInvoice->status, [1, 2, 3])) {
				$oldInvoice->createCreditForMe();
			}
			$inv = new Invoice;
			$inv->type = Invoice::INVOICE_TYPE_WMS_INVOICE;
			$inv->dpmt = Invoice::DPMT_3PL;
			if (in_array($aid, Org::$airsea_wh)) {
				$inv->dpmt = Invoice::DPMT_AIRSEA;
			}
			$inv->currency = 1;
			$inv->to_id = $aid;
			$inv->date = $bd;
			$inv->status = Invoice::INVOICE_STATUS_PENDING;
			if (!empty($oldInvoice)) {
				if ($oldInvoice->status != 10) {
					$inv->no = Invoice::genNewInvoiceNo($oldInvoice->no);
				} else {
					$inv->no = $oldInvoice->no;
				}
			}
			$inv->dpt_id = $dpt_id;
			$inv->mdata['name'] = $owner->name;
			$inv->mdata['address'] = $owner->getAddress();
			$inv->mdata['payterm'] = empty($owner->extra['payterm']) ? 'COD' : $owner->extra['payterm'] . ' days';
			$inv->mdata['paytype'] = empty($owner->extra['paytype']) ? '' : $owner->extra['paytype'];
			$inv->mdata['billfrom'] = $fd;
			$inv->mdata['billto'] = $td;
			$inv->due = $inv->date;
			if (!empty($owner->extra['payterm'])) {
				$inv->due = date('Y-m-d', strtotime($inv->date . ' + ' . $owner->extra['payterm'] . ' days'));
			}
			$inv->total = 0;
			$inv->gst = 0;
			$inv->save();
			if ($inv->getErrors()) {
				// if new invoice create in later month
				$inv->date = date('Y-m-d');
				$inv->due = date('Y-m-d');
				$inv->posted = date('Y-m-d');
				$inv->save();
			}

			$quote = WmsOrgQuote::model()->find(['condition' => 'org_id = :org_id AND status = 1 AND (JSON_VALUE(meta, "$.whole_sale") IS NULL OR JSON_VALUE(meta, "$.whole_sale") = 0)', 'params' => [':org_id' => $aid], 'order' => 'id DESC']);
			if (empty($quote) && $owner->by != 1) {
				$quote = WmsOrgQuote::model()->find(['condition' => 'org_id = :org_id AND status = 1', 'params' => [':org_id' => $owner->by], 'order' => 'id DESC']);
			}
			if (empty($quote)) {
				$inv->status = Invoice::INVOICE_STATUS_CACELLED;
				$inv->save();
				$errors[] = "10003 - Please set up a valid charge rate quote in the Rate Management";
				return $errors;
			}

			// $min_id = 12000;
			// switch ($aid) {
			// 	case Org::ORGID_3PL_AUSRIVER:
			// 		$min_id = 10000;
			// 		break;
			// 	case Org::ORGID_3PL_ECOMATTERS:
			// 		$min_id = 7500;
			// 		break;
			// 	case Org::ORGID_3PL_SUNNYA:
			// 		$min_id = 212425;
			// 		break;
			// 	case Org::ORGID_3PL_COBAYER:
			// 		$min_id = 350000;
			// 		break;
			// 	case Org::ORGID_3PL_AUSTRALIA_888:
			// 		$min_id = 497457;
			// 		break;
			// }

			$min_id = 0;

			if (!empty($org->extra['3pl_invoice_task_min_id'])) {
				$min_id = $org->extra['3pl_invoice_task_min_id'];
			}
			// bwf & 4 - task auto completed before 2019-07-01, bwf & 16 - task invisible to customer which is stock change
			// $tasks = WmsTask::model()->with('job', 'mainTask')->findAll(['condition' => 'job.org_id = :org_id and mainTask.status = :status and mainTask.compl_time < :to and mainTask.id > :min_id and mainTask.bwf & 4 = 0 and mainTask.bwf & 16 = 0', 'order' => 'mainTask.compl_time ASC', 'params' => [':org_id' => $aid, ':status' => array_search("Completed", WmsTask::$states), ':to' => date('Y-m-d', strtotime($td . ' + 1 day')), ':min_id' => $min_id]]);
			$tasks = WmsTask::model()->with('job', 'mainTask')->findAll(['condition' => 'job.org_id = :org_id and mainTask.status = :status and mainTask.compl_time >= :from and mainTask.compl_time < :to and mainTask.id > :min_id and mainTask.bwf & 4 = 0 and mainTask.bwf & 16 = 0 and mainTask.dpt_id = :dpt_id', 'order' => 'mainTask.compl_time ASC', 'params' => [':org_id' => $aid, ':status' => array_search("Completed", WmsTask::$states), ':from' => date('Y-m-d', strtotime($fd . ' + 1 day')), ':to' => date('Y-m-d', strtotime($td . ' + 1 day')), ':min_id' => $min_id, ':dpt_id' => $dpt_id]]);



			foreach ($tasks as $task) {
				$items = [];


				// Main Task
				if (!empty($task->mainTask) && $task->id == $task->mainTask->actionTask->id && in_array($owner->extra['wms_invoice'], ['all', 'fix_rate'])) {
					$mainTask = $task->mainTask;

					if (!empty($oldInvoice) && in_array($oldInvoice->status, [8, 10])) {
						if ($oldInvoice->status == 8 && count($oldInvoice->payments) == 1 && $oldInvoice->payments[0]->payment->bank != 91) {
							$inv_lines = InvLine::model()->findAll('fid = :id AND model = "WmsInvoiceLine" AND inv_id = :old', array(':id' => $mainTask->id, ':old' => $oldInvoice->id));
						} else {
							$inv_lines = InvLine::model()->findAll('fid = :id AND model = "WmsInvoiceLine" AND inv_id = :old', array(':id' => $mainTask->id, ':old' => $oldInvoice->id));
						}
					} else {
						$inv_lines = [];
					}
					$inv_lines += InvLine::model()->findAll('fid = :id AND model = "WmsInvoiceLine" AND inv_id = 0', array(':id' => $mainTask->id));
					foreach ($inv_lines as $inv_line) {
						if ($inv_line->inv_id == 0) {
							$inv_line->inv_id = $inv->id;
							$inv_line->update('inv_id');
						} else {
							// override invoice cause line lost
							$clone_line = new InvLine;
							$clone_line->inv_id = $inv->id;
							$clone_line->model = $inv_line->model;
							$clone_line->fid = $inv_line->fid;
							$clone_line->ccode = $inv_line->ccode;
							$clone_line->amount = $inv_line->amount;
							$clone_line->gst = $inv_line->gst;
							$clone_line->det = $inv_line->det;
							$clone_line->qty = $inv_line->qty;
							$clone_line->tax = $inv_line->tax;
							$clone_line->mdata = $inv_line->mdata;
							$clone_line->save();
						}
					}

					// plain
					if (!empty($mainTask->mdata['other_plain'])) {
						$line = InvLine::model()->find('fid = :id AND model = "WmsInvoiceLine" AND ccode = "plain"', array(':id' => $mainTask->id));
						if ($line->inv_id == 0) {
							$line->inv_id = $inv->id;
							$line->update('inv_id');
						}
					}

					// chep
					if (!empty($mainTask->mdata['other_chep'])) {
						$line = InvLine::model()->find('fid = :id AND model = "WmsInvoiceLine" AND ccode = "chep"', array(':id' => $mainTask->id));
						if ($line->inv_id == 0) {
							$line->inv_id = $inv->id;
							$line->update('inv_id');
						}
					}

					// wood
					if (!empty($mainTask->mdata['other_wood'])) {
						$line = InvLine::model()->find('fid = :id AND model = "WmsInvoiceLine" AND ccode = "wood"', array(':id' => $mainTask->id));
						if ($line->inv_id == 0) {
							$line->inv_id = $inv->id;
							$line->update('inv_id');
						}
					}

					// return
					if (!empty($mainTask->mdata['return'])) {
						$line = InvLine::model()->find('fid = :id AND model = "WmsInvoiceLine" AND ccode = "return"', array(':id' => $mainTask->id));
						if (empty($line) || ($line->inv_id != $inv->id && in_array($line->invoice, [8, 10]))) {
							$line = new InvLine;
							$line->inv_id = $inv->id;
							$line->amount = 11;
							$line->model = 'WmsInvoiceLine';
							$line->gst = 1;
							$line->mdata['items'][] = [$task->getNo(), ucwords($task->mainTask->ref), empty($task->mainTask->compl_time) ? $task->compl_time : $task->mainTask->compl_time, 'Return fee', 10, 1, 10];
							$line->ccode = 'return';
							$line->det = $mainTask->getType();
							$line->qty = 1;
							$line->fid = $mainTask->id;
							$line->tax = 'OUTPUT';
							$line->save();
						}
						if ($line->inv_id == $inv->id) {
							$line = InvLine::model()->find('fid = :id AND model = "WmsInvoiceLine" AND ccode = "return_unit"', array(':id' => $mainTask->id));
							if (empty($line)) {
								$price = 0.45;
								if (in_array($mainTask->type, [3030])) {
									$unit = sizeof($mainTask->deliveryTask->mdata['shipment_id']);
								} else if (in_array($mainTask->type, [1010])) {
									$unit = sizeof($mainTask->items);
								}
								$line = new InvLine;
								$line->inv_id = $inv->id;
								$line->amount = $price * $unit * 1.1;
								$line->model = 'WmsInvoiceLine';
								$line->gst = $price * $unit * 0.1;
								$line->mdata['items'][] = [$task->getNo(), ucwords($task->mainTask->ref), empty($task->mainTask->compl_time) ? $task->compl_time : $task->mainTask->compl_time, 'Return Goods', $price, $unit, $price * $unit];
								$line->ccode = 'return_unit';
								$line->det = $mainTask->getType();
								$line->qty = 1;
								$line->fid = $mainTask->id;
								$line->tax = 'OUTPUT';
								$line->save();
							}
						}
					}
				}


				// if (in_array($task->getType(), ['Pick Pallet']) && !empty($task->mainTask) && in_array($owner->extra['wms_invoice'], ['all', 'fix_rate'])) {
				// 	$quote_type = WmsOrgQuote::QUOTE_PALLET_OUT;
