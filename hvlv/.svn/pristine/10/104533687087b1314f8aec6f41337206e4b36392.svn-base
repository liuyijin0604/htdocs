				// 			$items[] = [$task->getNo(), ucwords($task->mainTask->ref), empty($task->mainTask->compl_time) ? $task->compl_time : $task->mainTask->compl_time, 'Pallets Out', $price, sizeof($pallets), sizeof($pallets) * $price];
