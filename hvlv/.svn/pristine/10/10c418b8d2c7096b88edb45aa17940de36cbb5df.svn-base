	/*
	* @params  $files array,   component array( fileUrl,filename);
	*/
	
	public function sendEmail($files=[])
	{
		include_once('PHPMailer/class.phpmailer.php');
		require_once('PHPMailer/PHPMailerAutoload.php');///SMTP
		$o=['status'=>false,'msg'=>'Email address not valid!'];
		$mail = new PHPmailer();
		$mail->CharSet = "UTF-8";
		$mail->IsHTML(true);
	
		/***************SMTP*********/
		$mail->isSMTP(); // Set mailer to use SMTP
		$mail->Host = 'mail.toplogistics.com.au'; // Specify main and backup SMTP servers
		$mail->SMTPSecure = 'tls'; // Enable TLS encryption, `ssl` also accepted
		$mail->Port = 587; // TCP port to connect to
		$mail->SMTPAuth = true; // Enable SMTP authentication
		$mail->Username = 'importstest@toplogistics.com.au'; // SMTP username
		$mail->Password = '3g%c2a#76ejiQu22'; /***************SMTP*********/
		
		$mail->Subject = $this->subject;
		$mail->Body = $this->body;
		$mail->AltBody = preg_replace("/[\n\r\t]+/", "\n", strip_tags($this->body));
	
		if (!empty($this->mdata['to'])) {
			foreach (preg_split("/[;,]+/i", $this->mdata['to']) as $to) {
				if (filter_var(trim($to), FILTER_VALIDATE_EMAIL)) {
					$mail->AddAddress(trim($to));//add customer email address
				}
			}
			
			foreach (preg_split("/[;,]+/i", $this->mdata['from']) as $from) {
				if (filter_var(trim($from), FILTER_VALIDATE_EMAIL)) {
					$mail->Sender = trim($from);
					$mail->From=trim($from);
					$mail->FromName=!empty($this->mdata['fromName'])?$this->mdata['fromName']:(explode("@", $from)[0]);
				}
			}
			
			//CC
			if (!empty($this->mdata['cc'])) {
				foreach (preg_split("/[;,]+/i", $this->mdata['cc']) as $cc) {
					if (filter_var(trim($cc), FILTER_VALIDATE_EMAIL)) {
						$mail->AddCC(trim($cc));//add customer email address
					}
				}
			}
			//bcc
			if (!empty($this->mdata['bcc'])) {
				foreach (preg_split('/[,;]+/', $this->mdata['bcc']) as $bcc) {
					if (filter_var(trim($bcc), FILTER_VALIDATE_EMAIL)) {
						$mail->AddBCC(trim($bcc));
					}
				}
			}

			if (!empty($files))
			{
				foreach ($files as $fn) {
					//replace broker name
					if(preg_match('/^AUCustoms[ _\-]+Entry[ ]*Print.+\.pdf$/i', $fn[1])){//$f->type == 19 && 
						$pdf = new modiPDF($fn[0]);
						if(preg_match('/Email Cover Sheet/i', $pdf->rawText()) && $pdf->pageCount() > 1) $pdf->removePage(1);
						if($pdf->replace(['FYN Logistics Australia Pty Lt', 'Mega-Top Cargo Pty Limited  ', 'Master Logistics Pty Ltd    ', 'Compliant Customs Pty Ltd   ','Autumn Customs Services Pty Lt'], ['TLA Appointed Broker  ', 'TLA Appointed Broker', 'TLA Appointed Broker', 'TLA Appointed Broker', 'TLA Appointed Broker'])){
							$mail->AddStringAttachment($pdf->output(0), $fn[1], 'base64', 'application/pdf');
						}
					}else{
						$mail->AddAttachment($fn[0], $fn[1], 'base64');
					}
				}
			}
			foreach ($this->attachments as $att) {
				$mail->AddAttachment($att->getFile(), $att->name, 'base64', $att->mime);
			}
			if ($mail->Send()) {
				$this->status = 30;
				$this->save();
				$o['status']=true;
				$o['msg']='send successfully!';
			} else {
				$o['status']=false;
				$o['msg']=$mail->ErrorInfo;
			}
		}
		return $o;
	}

