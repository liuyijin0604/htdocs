				]);
			break;
		}
		$this->tpl->assign('USER_NAME', isset(Yii::app()->user)?(Yii::app()->user->name):'TLA');
		$this->mdata['to'] = implode(',', $tos);
	}
	
	public function send()
	{
		include_once('PHPMailer/class.phpmailer.php');
		$td = Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR;

		$mail = new PHPMailer();
		$mail->CharSet = 'UTF-8';
		$mail->IsHTML(true);
		$mail->SMTPSecure = 'tls';
		$mail->Host = 'mail.toplogistics.com.au';  // Specify main and backup SMTP servers
        $mail->Port = 587;         
        $mail->SMTPAuth = true; // Enable SMTP authentication
		$mail->Sender   =  empty($this->mdata['from'])? (Yii::app()->user->email == 'admin@system'? 'test@orite.com' : Yii::app()->user->email) : $this->mdata['from'];
		$mail->From     = empty($this->mdata['from'])? (Yii::app()->user->email == 'admin@system'? 'test@orite.com' : Yii::app()->user->email) : $this->mdata['from'];
		$mail->FromName = empty($this->mdata['from_name'])? Yii::app()->user->name : $this->mdata['from_name'];
		$mail->Username = 'imports@toplogistics.com.au'; // SMTP username
		$mail->Password = 'mxK+fU$n&LDK';
		$mail->Subject  = $this->subject;
		$mail->Body = $this->body;
		$mail->AltBody = preg_replace("/[\n\r\t]+/", "\n", strip_tags($this->body));
		
		foreach (preg_split('/[,;]+/', $this->mdata['to']) as $to) {
			$mail->AddAddress(trim($to));
		}
		if (!empty($this->mdata['cc'])) {
			foreach (preg_split('/[,;]+/', $this->mdata['cc']) as $to) {
				$mail->AddCC(trim($to));
			}
		}
		if (!empty($this->mdata['bcc'])) {
			foreach (preg_split('/[,;]+/', $this->mdata['bcc']) as $to) {
				$mail->AddBCC(trim($to));
			}
		}
		switch ($this->type) {
			case 10:
			case 35:
				if (empty($this->fobj)) $this->getFobj();

				if ($invoice->type != 60) {
					$mail->AddStringAttachment(oPDF::renderPDF('invoice', ['inv' => $this->fobj], 0), $this->fobj->no . '.pdf', 'base64', 'application/pdf');
				} else {
					$f1 = tempnam(Yii::app()->basePath."/runtime", "ivp");
					$f2 = tempnam(Yii::app()->basePath."/runtime", "ivp");
					oPDF::renderPDF('invoice', ['inv'=>$invoice], 2, $f1);
					oPDF::renderPDF('invoice_detail', ['inv'=>$invoice], 2, $f2);
					$mail->AddStringAttachment(oPDF::mergePDF([$f1, $f2], 0, true), $this->fobj->no . '.pdf', 'base64', 'application/pdf');
				}
			break;
			case 20:
				$mail->From = 'finance@toplogistics.com.au';
				if (empty($this->fobj)) {
					$this->getFobj();
				}
				$model=new Invoice('search');
				$model->unsetAttributes();
				$model->to_id = $this->fid;
				$ec = new CDbCriteria;
				//$ec->condition = "status IN (2,3,7)";
				// $ec->condition = "status IN (2,3,7) AND type != 50"; // currently ignore EDI invoice
				$ec->condition = "status IN (2,3,7)"; // currently ignore EDI invoice
				$dp = $model->search(false, 0, 't.due ASC', $ec);
				$rs = $dp->data;
				$tf = tempnam($td, "stmt");
				oPDF::renderPDF('statement', ['invs'=>$rs], 2, $tf);
				$ps[] = $tf;
				foreach ($rs as $r) {
					$tf = tempnam($td, "stmt");
					oPDF::renderPDF('invoice', ['inv'=>$r], 2, $tf);
					$ps[] = $tf;
				}
				
				$mail->AddStringAttachment(oPDF::mergePDF($ps, 3), 'Statement_'.$this->fid.'_'.date('Ymd').'.pdf', 'base64', 'application/pdf');
				
				$xls = new oExcel;
				$i = 1;
				$xls->addRow($i, ['No', 'Type','AWB', 'Date', 'Due', 'Total', 'Paid', 'Balance']);
				$xls->setFont('A'.$i.':H'.$i, ['bold' => true]);
				$i++;
				$tot = [0,0,0];
				foreach ($rs as $r) {
					$paid = $r->paid();
					if ($r->type == 10) { // for import invoice
						$awb = '';
						if (isset($r->lines[0]) && isset($r->lines[0]->mdata['items'])) {
							foreach ($r->lines[0]->mdata['items'] as $si => $ri) {
								$awb = $ri[0];
								break;
							}
						}
						$xls->addRow($i++, [$r->no, $r->getType(),$awb, $r->date, $r->due, AppHelper::money_format('%i', $r->total), AppHelper::money_format('%i', $paid), AppHelper::money_format('%i', $r->total - $paid)]);
					} else {
						$xls->addRow($i++, [$r->no, $r->getType(),'', $r->date, $r->due, AppHelper::money_format('%i', $r->total), AppHelper::money_format('%i', $paid), AppHelper::money_format('%i', $r->total - $paid)]);
					}
					$tot[0] += $r->total;
					$tot[1] += $paid;
					$tot[2] += $r->total - $paid;
				}
				
				$xls->addRow($i++, ['', '', '','', 'Total:', AppHelper::money_format('%i', $tot[0]), AppHelper::money_format('%i', $tot[1]), AppHelper::money_format('%i', $tot[2])]);
				$xls->addRow($i++, []);

				foreach ($rs as $r) {
					$xls->addRow($i++, [$r->no, $r->date]);
					$xls->addRow($i, ['HBN', 'Shipper', 'Packages', 'Weight', 'Type', 'Rate', 'Amount']);
					$xls->setFont('A'.$i.':G'.$i, ['bold' => true]);
					$i++;
					$qty = 0;
					$wei = 0;
					$cbm = 0;
					$tot = 0;
					foreach ($r->lines as $il) {
						if (empty($il->mdata['items'])) {
							continue;
						}
						foreach ($il->mdata['items'] as $si => $ri) {
							// import has different data format with export invoice
							if ($r->type == 10) {
								// for import invoice
								$charge_wei = round(empty($ri[9]) ? $ri[3] : $ri[9], 2);
								if (preg_match('/LET\d{7}/i', $ri[0])) {
									$p = ImParcel::model()->find('ref=:ref', [':ref' => $ri[0]]);
									if (!empty($p)) {
										$ri[0] .= '(' . $p->hbn . ')';
									}
								}
								$xls->addRow($i++, [$ri[0], $ri[1], 1, $charge_wei, '', '', $ri[5]]);
								$tot += $ri[5];
								$qty ++;
								$wei += $charge_wei;
							} else { // for import invoice
								$xls->addRow($i++, [$ri[0], $ri[1], 1, $ri[2], $ri[4] . '(' . $ri[5] . ')', $ri[6], $ri[7]]);
								$tot += floatval($ri[7]);
								$qty ++;
								$wei += floatval($ri[2]);
							}
						}
					}
					$xls->addRow($i, ['', 'Total:', $qty, $wei, '', '', $tot]);
					$xls->setFont('A'.$i.':G'.$i, ['bold' => true]);
					$i++;
					$xls->addRow($i++, []);
				}

				$mail->AddStringAttachment($xls->output(null, null, false), 'Statement_'.$this->fid.'_'.date('Ymd').'.xlsx', 'base64');
			break;
		}
		
		foreach ($this->attachments as $att) {
			$mail->AddAttachment($att->getFile(), $att->name, 'base64', $att->mime);
		}

		if ($mail->Send()) {
			$this->status = 30;
			$this->save();
			return true;
		} else {
			echo $this->id, ' - ', $this->mdata['to'], ', ', $mail->ErrorInfo;
			return false;
		}
	}
	
	public function scheduleSend()
	{
		include_once('PHPMailer/class.phpmailer.php');
								
		$mail = new PHPMailer();
		$mail->CharSet = 'UTF-8';
		$mail->IsHTML(true);
		$mail->SMTPSecure = 'tls'; 
        $mail->Port = 587;         
        $mail->SMTPAuth = true;
        $mail->Host = 'mail.toplogistics.com.au';
        $mail->Username = 'imports@toplogistics.com.au'; // SMTP username
		$mail->Password = 'mxK+fU$n&LDK';
		$sender = User::model()->findByPk($this->from_id);
		$mail->From     = $sender->email == 'admin@system'? 'test@orite.com' : $sender->email;
		$mail->FromName = $sender->getName();
		$mail->Subject  = $this->subject;
		$mail->Body = $this->body;
		$mail->AltBody = preg_replace("/[\n\r\t]+/", "\n", strip_tags($this->body));
		//test $mail->AddAddress('test@orite.com');
		
		foreach (preg_split('/[,;]+/', $this->mdata['to']) as $to) {
			$mail->AddAddress(trim($to));
		}
		if (!empty($this->mdata['cc'])) {
			foreach (preg_split('/[,;]+/', $this->mdata['cc']) as $to) {
				$mail->AddCC(trim($to));
			}
		}
		if (!empty($this->mdata['bcc'])) {
			foreach (preg_split('/[,;]+/', $this->mdata['bcc']) as $to) {
				$mail->AddBCC(trim($to));
			}
		}
		
		switch ($this->type) {
			case 40:
			break;
		}
		
		foreach ($this->getRelated('attachments', true) as $att) {
			$mail->AddAttachment($att->getFile(), $att->name, 'base64', $att->mime);
		}
		
		if ($mail->Send()) {
			$this->status = 30;
			$this->save();
			return true;
		} else {
			$this->status = 90;
			$this->save();
			echo $this->id, ' - ', $this->mdata['to'], ', ', $mail->ErrorInfo;
			return false;
		}
	}
	public function customerServiceSend($files)
	{
		include_once('PHPMailer/class.phpmailer.php');
		require_once('PHPMailer/PHPMailerAutoload.php');///SMTP
		$mail = new PHPmailer();
		$mail->CharSet = "UTF-8";
		$mail->IsHTML(true);
		$mail->From     = "importscs@toplogistics.com.au";
		$mail->FromName = "importscs";

		/***************SMTP*********/
		$mail->isSMTP(); // Set mailer to use SMTP
		$mail->Host = 'mail.toplogistics.com.au'; // Specify main and backup SMTP servers
		$mail->SMTPSecure = 'tls'; // Enable TLS encryption, `ssl` also accepted
		$mail->Port = 587; // TCP port to connect to
		$mail->SMTPAuth = true; // Enable SMTP authentication
		$mail->Username = 'imports@toplogistics.com.au'; // SMTP username
		$mail->Password = 'mxK+fU$n&LDK';
		/***************SMTP*********/

		$mail->Subject = $this->subject;
		$mail->Body = $this->body;
		$mail->AltBody = preg_replace("/[\n\r\t]+/", "\n", strip_tags($this->body));
		$o=['status'=>false,'msg'=>'Email address not valid!'];
	
		if (!empty($this->mdata['to'])) {
			$mail->AddAddress(trim($this->mdata['to']));//add customer email address
			
			//CC
			if (!empty($this->mdata['cc'])) {
				foreach (preg_split("/[;,]+/i", $this->mdata['cc']) as $cc) {
					if (filter_var(trim($cc), FILTER_VALIDATE_EMAIL)) {
						$mail->AddCC(trim($cc));//add customer email address
					}
				}
			}
			if (!empty($files)) {
				foreach ($files as $fn) {
					$mail->AddAttachment($fn[0], basename($fn[1]), 'base64');
				}
			}
			foreach ($this->attachments as $att) {
				$mail->AddAttachment($att->getFile(), $att->name, 'base64', $att->mime);
			}
			if ($mail->Send()) {
				$this->status = 30;
				$this->save();
				$o['status']=true;
				$o['msg']='send successfully!';
			} else {
				$o['status']=false;
				$o['msg']=$mail->ErrorInfo;
			}
		}
		return $o;
	}

