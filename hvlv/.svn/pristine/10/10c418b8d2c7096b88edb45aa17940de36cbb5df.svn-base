			case 80:
				$org=Org::model()->findByPk($this->to_id);
				$start=(date('d')<16?date('Y-m-16', strtotime("-1 month")):date('Y-m-01'));
				$end=(date('d')<16?(date('Y-m', strtotime("-1 month")).'-'.date('t', strtotime('last month'))):date('Y-m-15'));
				$dueday=(date('d')<16?date('Y-m-07'):date('Y-m-22'));
				$this->tpl->assignSubject('DAY_RANGE', $start.' to '.$end);
				$this->tpl->assignThese([
