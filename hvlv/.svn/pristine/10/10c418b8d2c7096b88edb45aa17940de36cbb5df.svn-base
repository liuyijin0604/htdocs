			case 66:
				$isair = empty($this->fobj->consol) || $this->fobj->consol->service == 10;
				$isair = empty($this->fobj->consol) || $this->fobj->consol->service == 10 || empty($this->fobj->consol->service);
				$storageNote = "";
				if($isair)
				{
					if(!empty($this->fobj->consol)&&!$this->fobj->consol->isOurWarehouse())
					{
						$storagetRate = 0.2;
						$storageNote = "We will send you a notification email when the cargo is available. And please note your shipment has 2 business days free storage period in our depot after this. Thereafter, we will charge storage of \${$storagetRate}/kg per day, Min \$50.";
					}else
					{
						$days = 0;
						$dayType = "calendar";
					
						if (($this->fobj->bwf & ImParcel::CUSTOM_DDP) > 0) {
							$days = 14;
						} elseif (($this->fobj->bwf & ImParcel::CUSTOM_DDU) > 0) {
							$days = 3;
							$dayType = "business";
						}
						$storagetRate = 0.2;
						$storageNote = "Pls note your shipment has {$days} {$dayType} day free storage period in our depot. Thereafter, we will charge storage of \${$storagetRate}/kg per day!";
					}
				}else
				{
					$days = 3;
					$storageNote = "Pls note after the deconsolidation is done, your shipment has {$days} business day free storage period in our depot. Thereafter, your storage fee will be charged AUD 30/cbm/day + AUD 80/shipment.";
				}


				$this->tpl->assignSubject('SHIPMENT_NO', $this->fobj->hbn);
				$invInfo= $this->fobj->getCasulInvTotal();
