	public function wcaSend()
	{
		include_once('PHPMailer/class.phpmailer.php');
		foreach (explode(',', $this->mdata['to']) as $to) {
			$mail=new PHPmailer();
			$mail->charSet="UTF-8";
			$mail->IsHTML(true);
			$mail->SMTPAuth = true; // Enable SMTP authentication
			$mail->From     = Yii::app()->user->email == 'admin@system'? 'test@orite.com' : Yii::app()->user->email;
			$mail->FromName = Yii::app()->user->name;
			$mail->AddAddress(trim($to));
			$mail->Subject = $this->subject;
			$mail->Body = $this->body;
			$client='';
			$wca= WcaMembers::model()->find('email=:email', [':email'=>$to]);
			if (!empty($wca)) {
				$client=$wca->name;
			}
			$mail->Body= preg_replace("/client_name/i", $client, $mail->Body);
			$mail->AltBody = preg_replace("/[\n\r\t]+/", "\n", strip_tags($this->body));
			foreach ($this->attachments as $att) {
				$mail->AddAttachment($att->getFile(), $att->name, 'base64', $att->mime);
			}
			if ($mail->Send()) {
				$this->status = 30;
				$wcaMember=WcaMembers::model()->find('email=:email', [':email'=>trim($to)]);
				if (!empty($wcaMember)) {
					$wcaMember->sent=1;
					$wcaMember->save();
				}
				$this->save();
				return true;
			} else {
				echo $this->id, ' - ', $this->mdata['to'], ', ', $mail->ErrorInfo;
				return false;
			}
		}
	}

