			case 83:
				$this->tpl->assignSubject('SHIPMENT_NO', $this->fobj->hbn." ".$this->fobj->ref);
				$this->tpl->assignThese([
					'SHIPMENT_NO'=>$this->fobj->hbn,
				]);
