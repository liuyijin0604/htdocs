	public function InvoiceSend($fn= null, $fn2='',$fn3 = null)
	{
		require_once('PHPMailer/PHPMailerAutoload.php');///SMTP
		$o=['status'=>false,'msg'=>'Email address not valid!'];
		$mail = new PHPmailer();
		$mail->CharSet = "UTF-8";
		$mail->IsHTML(true);
	
		/***************SMTP*********/
		$mail->isSMTP(); // Set mailer to use SMTP
		$mail->Host = 'mail.toplogistics.com.au'; // Specify main and backup SMTP servers
		$mail->SMTPSecure = 'tls'; // Enable TLS encryption, `ssl` also accepted
		$mail->Port = 587; // TCP port to connect to
		$mail->SMTPAuth = true; // Enable SMTP authentication
		$mail->Username = 'imports@toplogistics.com.au'; // SMTP username
		$mail->Password = 'mxK+fU$n&LDK'; /***************SMTP*********/
		
		
		$mail->Subject = $this->subject;
		$mail->Body = $this->body;
		$mail->AltBody = preg_replace("/[\n\r\t]+/", "\n", strip_tags($this->body));
		$mail->AddAttachment($fn, basename($fn), 'base64');
		if (!empty($fn2)) {
			$mail->AddAttachment($fn2, basename($fn2), 'base64');
		}
		if (!empty($fn3)) {
			$mail->AddAttachment($fn3, basename($fn3), 'base64');
		}
		if (empty($this->to_id)) return false;

			$org = Org::model()->findByPk($this->to_id);
			if (!empty($org->extra['client_billing_email']) && (empty($org->extra['invoice-feq']) || $org->extra['invoice-feq'] == 'no')) {
				foreach (preg_split('/[,;]+/i', trim($org->extra['client_billing_email'])) as $to) {
					if (empty(trim($to))) {
						continue;
					}
					$mail->AddAddress(trim($to));
				}
			} else if (!empty($org->extra['invoice-rec'])) {
				foreach (preg_split('/[,;]+/i', trim($org->extra['invoice-rec'])) as $to) {
					if (empty(trim($to))) {
						continue;
					}
					$mail->AddAddress(trim($to));
				}
			} else {
				// pcaw set send invoice yes but no invoice recipient
				return false;
			}

				$from='';
				if (!empty($org->extra['op_id'])) {
					$op=User::model()->findByPk($org->extra['op_id']);
					if (!empty($op)) {
						if (!empty($op->email)) {
							$opEmail=$op->email;
							$from=$opEmail;
							$mail->AddCC(trim($opEmail));
						}
					}
				}
				if (!empty($org->extra['op_email'])) {
					foreach (preg_split('/[,;]+/i', trim($org->extra['op_email'])) as $to) {
						$mail->AddCC(trim($to));
					}
				}
						
				$mail->AddCC(trim('finance@toplogistics.com.au'));
				$fromName='';
				if (!empty($from)) {
					$fromName=explode("@", $from)[0];
				}
				$mail->Sender     = "finance@toplogistics.com.au";
				$mail->From     = "finance@toplogistics.com.au";
				$mail->FromName = "TLA Finance";
				if ($mail->Send()) {
					$this->status = 30;
					$this->save();
					return true;
				} else {
					echo $mail->ErrorInfo;
					return false;
				}
	}
	

