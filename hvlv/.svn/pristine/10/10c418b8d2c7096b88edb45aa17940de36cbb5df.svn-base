				$isair = empty($this->fobj->consol) || $this->fobj->consol->service == 10 || empty($this->fobj->consol->service);
				if($isair)
				{
					if(!empty($this->fobj->consol)&&!$this->fobj->consol->isOurWarehouse())
					{
						$storagetRate = 0.2;
						$storageNote = "We will send you a notification email when the cargo is available. And please note your shipment has 2 business days free storage period in our depot after this. Thereafter, we will charge storage of \${$storagetRate}/kg per day, Min \$50.";
					}else
