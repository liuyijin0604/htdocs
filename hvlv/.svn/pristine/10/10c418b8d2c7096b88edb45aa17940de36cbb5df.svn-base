					'SHIPMENT_NO' => $this->fobj->ref,
					'SHIPMENT_HBN' => $this->fobj->hbn,
				]);
			break;
			case 85:
			case 86:
			case 87:
			case 88:
				$this->tpl->assignSubject('SHIPMENT_NO', $this->fobj->ref);
				$this->tpl->assignThese([
					'SHIPMENT_NO'=>$this->fobj->ref,
				]);
			break;
			case 89:
				$this->tpl->assignSubject('SHIPMENT_NO', $this->fobj->hbn);
				$this->tpl->assignThese([
					'SHIPMENT_CUST_REF' => $this->fobj->cref,
					'SHIPMENT_NO' => $this->fobj->hbn,
				]);
			break;
			case 111:
				$this->tpl->assignSubject('SHIPMENT_NO', $this->fobj->ref);
