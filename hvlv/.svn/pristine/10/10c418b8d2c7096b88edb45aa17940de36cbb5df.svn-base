	public function getTemplate()
	{
		$typ2tpl = [
			10 => 'invoice',
			20 => 'statement',
			30 => 'client',
			35 => 'invoice',
			40 => 'outturn',
			50 => 'credit',
			59 => 'rqfenty',
			60 => 'credit_note',
			61 => 'hvdc',
			62 => 'hvdcc',
			63 => 'broker',
			64 => 'entry',
			65 => 'brokerpay',
			66 => 'custinv',
			67 => 'opnotice',
			68 => 'hvdcf',
			69 => 'noticedy',
			70 => 'empp',
			71 => 'rtsnotice',
			72 => 'aqis',
			73 => 'sacn',
			74 => 'exidchase',
			75 => 'cgchangepassword',
			76 => 'custinvagent',
			77 => 'heldnotice',
			78 => 'deliverynotice',
			79 => 'invoicestatment',
			80 => 'invoicenotpaidwarning',
			81 => 'storageinv',
			82 => 'paymentreceived',
			83 => 'empp2customs',
			84 => 'borderotherddu',
			85 => 'prealert',
			86 => 'requestmanifest',
			87 => 'seado',
			88 => 'seaotturn',
			89 => 'borderotherdduremind',
			110 => 'wmsapiemail',
			111 => 'shipmentavailable',
			112 => 'wmscomparsionreport',
			113 => 'wmsstockcheckreport',
			114 => 'uflshortreport',
			115 => 'shopifysyncreport',
			self::WMS_CONSUMER_BACKORDER => 'wmsreport',
			self::WMS_RETAILER_BACKORDER => 'wmsreport',
			self::WMS_GOODS_RETURN => 'wmsreport',
			self::WMS_MINIMUM_STOCK_ALERT => 'wmsreport',
			self::WMS_DELIVERY_DESPATCH_CONSUMER => 'wmsreport',
			self::WMS_DELIVERY_DESPATCH_RETAILER => 'wmsreport',
			self::WMS_INBOUND_DELIVERY_ADVICE => 'wmsreport',
			self::WMS_INBOUND_DELIVERY_REPORT => 'wmsreport',
			self::INVOICE_STATEMENT_3PL => '3plinvoicestatement',
			self::WINIT_NOTICE => 'winitNotice',
			self::FOURPX_NOTICE => '4pxNotice',
			self::PADSTOW_NOTICE => 'padstowNotice',
			self::GC_NOTICE => 'gcNotice',
			self::OTHER_NOTICE => 'otherNotice',
			self::WMS_STOCK_ON_HAND => 'wmsreport',
			self::DFE_API_TEMPLATE =>'dfeapitemplate',
			self::PICK_OUTTURN_TEMPLATE => 'pickupoutturn',
			self::CARGO_EMAIL_NOTICE=>'cargoemailnotice',
			self::CARGO_WH_EMAIL_NOTICE=>'cargowhemailnotice',
			self::CARGO_GP_EMAIL_NOTICE=>'cargogpemailnotice',
			self::CUSTOMER_SERVICE=>'customerservice',
			self::SORRY=>'sorry',
			self::CUSTOMER_SERVICE_TRACKING_ENQUIRY=>'customerservicetrackingenquiry',
			self::B2B_BOOKING_NOTICE => 'b2bbookingnotice',
			self::PACKAGE_INFO_REQUIRING => 'packageinforequiring',
			self::PACKAGE_INFO_REQUIRING2 => 'packageinforequiring2',
			self::TASK_FEEDBACK_EMAIL => 'ImportsMailFeedback',
			self::PIER_FILE=>'pierfile',
			self::INVOICE_TERM_DUE=>'invoice_term_due',
			self::PRICE_ENQUIRY_EMAIL => 'PriceEnquiry',
			self::BOOKING_CONFIRMATION => 'BookingConfirmation',
			self::BOOKING_EDIT => 'BookingEdit',
			self::BOOKING_SUBMIT_CONFIRMATION => 'BookingSubmitConfirmation',
			self::BOOKING_WH_NOTICE => 'BookingWhNotice',
			self::INBOUND_ERROR_ALERT => 'inboundErrorAlert',
			self::CARTAGE_EMAIL => 'CartageEmail',
			self::CARGO_PROCESS =>'CargoProcess'
		];

		$con = null;
		$isTLA = false;
		if(!empty($this->isTLA))
		{
			$isTLA = $this->isTLA;
		}else
		{
			if(!empty($this->fobj))
			{
				if(!empty(get_class($this->fobj)=='Consol'))
				{
					$con = $this->fobj;
				}

				if(!empty(get_class($this->fobj)=='ImParcel'))
				{
					$con = $this->fobj->consol;
				}

				if(!empty(get_class($this->fobj)=='Invoice'))
				{
					
					if(isset($this->fobj->consol_id) && isset($this->fobj->dpmt) && $this->fobj->consol_id > 0 && $this->fobj->dpmt == 10){
						$con = Consol::model()->findByPk($this->fobj->consol_id);
					}
					// create, then change eta to 2020-08-01
					if (!empty($this->fobj->id) && $this->fobj->id < 500000) $con = null;
				}

			}
			if(!empty($con))
			{

				if(in_array($con->type, [Consol::DMAWBCONSOLTYPE,Consol::IMCOCONSOLTYPE,Consol::ELMSCONSOLTYPE])&&!$con->is3PL()&&strtotime($con->eta) >= strtotime('2020-08-01'))
				{
					$isTLA = 1;
				}
			}
		}

		$this->tpl = empty($typ2tpl[$this->type])? new EmailTpl : EmailTpl::getTplBySlug($typ2tpl[$this->type],$isTLA);
	}
	
	public function getFobj()
	{
		switch ($this->type) {
			case 10:
			case 35:
				$this->fobj = Invoice::model()->findByPk($this->fid);
			break;
			case 20:
			case 75:
			case self::INVOICE_STATEMENT_3PL:
				$this->fobj = Org::model()->findByPk($this->fid);
			break;
			case 40:
				$this->fobj = Consol::model()->findByPk($this->fid);
			break;
			case 60:
				$this->fobj = Payment::model()->findByPk($this->fid);
			break;
			case 59:
			case 61:
			case 62:
			case 63:
			case 64:
			case 65:
			case 66:
			case 67:
			case 68:
			case 69:
			case 70:
			case 71:
			case 72:
			case 73:
			case 76:
			case 78:
			case 81:
			case 82:
			case 83:
			case 84:
			case 85:
			case 86:
			case 87:
			case 88:
			case 89:
			case 111:
			case self::CARGO_EMAIL_NOTICE:
			case self::CARGO_WH_EMAIL_NOTICE:
			case self::CARGO_GP_EMAIL_NOTICE:
			case self::PICK_OUTTURN_TEMPLATE:
			case self::WINIT_NOTICE:
			case self::FOURPX_NOTICE:
			case self::GC_NOTICE:
			case self::PADSTOW_NOTICE:
			case self::OTHER_NOTICE:
				$this->fobj = ImParcel::model()->findByPk($this->fid);
			break;
			case 74:
				$this->fobj= ExCrm::model()->findByPk($this->fid);
			break;
			case 112:
				$this->fobj = WmsTask::model()->findByPk($this->fid);
			break;
		}
	}

	public function getFobjName()
	{
		$this->getFobj();
		if (!empty($this->fobj)) {
			if (in_array(get_class($this->fobj), ['Invoice', 'Consol', 'Payment', 'ExCrm']) || preg_match('/Consol/i', get_class($this->fobj))) {
				return $this->fobj->no;
			} else if (in_array(get_class($this->fobj), ['Org'])) {
				return $this->fobj->name;
			} else if (in_array(get_class($this->fobj), ['ImParcel'])) {
				return $this->fobj->ref;
			}
		}
		return '';
	}
	
	public function prepTemplate()
	{
		if (empty($this->fobj)) $this->getFobj();
		if (empty($this->tpl)) $this->getTemplate();
		$tos = [];
		switch($this->type)
		{
			case Emailog::EMPP_DOCUMENT:
			case Emailog::CUST_DOCUMENT_CUSTOMER2:
			case Emailog::CUST_DOCUMENT_SENDER:
			case Emailog::CUST_DOCUMENT_BROKER:
			case Emailog::AQIS_DOCUMENT:
			case Emailog::EMPP2CUSTOMS:
				$isair = empty($this->fobj->consol) || $this->fobj->consol->service == 10 || empty($this->fobj->consol->service);
				if($isair)
				{
					$this->tpl->assignSubject('NO', $this->fobj->consol->awb);
				}else
				{
					$this->tpl->assignSubject('NO', @$this->fobj->consol->mdata['container_no']);
				}
			break;
		}

		switch ($this->type) {
			case 10:
			case 35:
				if(empty($this->fobj->dpmt) || $this->fobj->dpmt == 30)
				{
					$BSB = '032090';
					$accountNumber = '876589';
				}else
				{
					$BSB = '032166';
					$accountNumber = '366789';
				}

				$org = $this->fobj->cust;
				$this->tpl->assignSubject('INV_NO', $this->fobj->no);
				$awb = $this->fobj->getModelAWB();
				$paypalLink = $this->fobj->getPaypalUrl();
				$this->tpl->assignSubject('AWB_NO', empty($awb)? '' : ' / '.$awb);
				$this->tpl->assignThese([
					'CLIENT_NAME' => $org->name,
					'PAYPAL_LINK' => $paypalLink,
				]);
				if ($this->isNewInvoice) {
					$this->tpl->assignThese([
						'OLD_INVOICE' =>'',
						'BSB'=>$BSB,
						'ACCOUNT_NUMBER'=>$accountNumber
					]);
				}
				$this->to_id = $org->id;
				foreach ($org->contactList(1) as $oc) {
					if (!empty($oc->email)) {
						$tos[] = $oc->email;
					}
				}
				if ($this->type == self::INVOICE && !empty($org->extra['invoice-feq']) && $org->extra['invoice-feq'] == 'yes' && !empty($org->extra['invoice-rec'])) {
					$tos = explode(';', str_replace(' ', '', $org->extra['invoice-rec']));
				}
			break;
			case 20:
				$org = $this->fobj;
				$inv = new Invoice();
				$inv->to_id = $org->id;
				$this->tpl->assignSubject('OID', $org->id);
				$this->tpl->assignThese([
					'CLIENT_NAME' => $org->name,
					'TOT_BALANCE' => $inv->statementTotal(false),
				]);
				$this->to_id = $org->id;
				foreach ($org->contactList(1) as $oc) {
					if (!empty($oc->email)) {
						$tos[] = $oc->email;
					}
				}
			break;
			case self::INVOICE_STATEMENT_3PL:
				$org = $this->fobj;
				$inv = new Invoice();
				$inv->to_id = $org->id;
				$this->tpl->assignSubject('CLIENT_NAME', $org->name);
				$this->tpl->assignThese([
					'CLIENT_NAME' => $org->name,
				]);
				$this->to_id = $org->id;
				foreach ($org->contactList(1) as $oc) {
					if (!empty($oc->email)) {
						$tos[] = $oc->email;
					}
				}
			break;
			case 30:
			case 40:
				if (empty($this->to_id)) {
					break;
				}
				$org=Org::model()->findByPk($this->to_id);
				if($this->fobj->service==Consol::SEACONSOL)
				{
					$this->tpl->assignSubject('CON_NO', @$this->fobj->mdata['container_no'].(empty($this->fobj->mdata['house_bill'])? '' : '/'.$this->fobj->mdata['house_bill']));
				}else
				{
					$this->tpl->assignSubject('CON_NO', $this->fobj->awb.(empty($this->fobj->mdata['house_bill'])? '' : '/'.$this->fobj->mdata['house_bill']));
				}
				$this->tpl->assignThese([
					'CLIENT_NAME' => $org->name,
				]);
			break;
			case 60:
				$org = $this->fobj->cust;
				$this->tpl->assignSubject('CREDIT_NO', $this->fobj->no);
				$this->tpl->assignThese([
					'CLIENT_NAME' => $org->name,
				]);
			break;
			case 61:
				if (empty($this->to_id)) {
					break;
				}
				$org=Org::model()->findByPk($this->to_id);
				$this->tpl->assignSubject('SHIPMENT_NO', $this->fobj->ref."--".$this->fobj->hbn);
				$this->tpl->assignThese([
					'CLIENT_NAME' => $org->name,
					'SHIPMENT_NO'=>$this->fobj->ref,
					'CUSTOMER_REF'=>$this->fobj->cref,
					'LINK'=>self::prepareLink($this->fobj->getTheHashUrl(2)),//false means link to sender;
				]);
			break;
			case 62:
				$this->tpl->assignSubject('SHIPMENT_NO', $this->fobj->ref."--".$this->fobj->hbn);
				$this->tpl->assignThese([
					'SHIPMENT_NO'=>$this->fobj->hbn,
					'LINK'=> self::prepareLink($this->fobj->getTheHashUrl(1)),//1 to consignee
					'SHIPMENT_ITEMS'=> $this->fobj->getGoodsItemsForCustomer(),
				]);
			break;
			case 59:
				$org=Org::model()->findByPk($this->to_id);
				$this->tpl->assignSubject('SHIPMENT_NO', $this->fobj->hbn);
				$this->tpl->assignThese([
					'CLIENT_NAME' => $org->name,
					'SHIPMENT_INFO'=> $this->fobj->hbn,
