	public function sendWmsReport($fn)
	{
		include_once('PHPMailer/class.phpmailer.php');
		$o = ['status' => false, 'msg' => ''];

		$mail = new PHPmailer();
		$mail->CharSet = "UTF-8";
		$mail->Subject = $this->subject;
		$mail->Body = $this->body;
		$mail->AltBody = preg_replace("/[\n\r\t]+/", "\n", strip_tags($this->body));
		if (!empty($this->mdata['to'])) {
			foreach (preg_split('/[;,]+/i', $this->mdata['to']) as $to) {
				if (filter_var(trim($to), FILTER_VALIDATE_EMAIL)) {
					$mail->AddAddress(trim($to));
				}
			}
		}
		$mail->AddCC(trim('gero@toplogistics.com.au'));
		if (!empty($fn)) {
			$mail->AddAttachment($fn, basename($fn), 'base64');
		}
		$mail->From = 'gero@toplogistics.com.au';
		$mail->FromName = "PCAE IT TEAM";
		if ($mail->Send()) {
			$this->status = 30;
			$this->save();
			$o['status'] = true;
			$o['msg'] ='send succesfully!';
		} else {
			$o['status'] = false;
			$o['msg'] = $mail->ErrorInfo;
		}
		return $o;
	}

