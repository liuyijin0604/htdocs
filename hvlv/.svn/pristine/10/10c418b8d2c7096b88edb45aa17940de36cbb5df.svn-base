	public function log($m)
	{
		$this->body = $m->Body;
		$this->subject = $m->Subject;
		$this->dt = date('Y-m-d H:i:s');
		$this->save();
	}
	
	public function getFrom()
	{
		$t = User::model()->findByPk($this->from_id);
		if (!empty($t)) {
			return $t->fname;
		} else if (!empty($this->mdata['from'])) {
			return $this->mdata['from'];
		} else {
			return $this->from_id;
		}
	}
	
	public function getTo()
	{
		if (in_array($this->type, [40, 65])) {
			$t = Org::model()->findByPk($this->to_id);
			return empty($t) ? '' : $t->name.': '.$this->mdata['to'];
		}
		if (empty($this->to_id)) {
			foreach ($this->mdata as $k => $v) {
				if ($k == 'to') {
					$es = explode(',', $v);
					$esl = sizeof($es);
					return  $esl > 3 ? implode(', ', array_slice($es, 3)).'('.($esl - 3).' more)' : $v;
				}
			}
		}
		$t = OrgContact::model()->findByPk($this->to_id);
		return empty($t) ? '' : $t->name.' - '.$t->org->name;
	}
	
	public function getType()
	{
		if ($this->type == 0) {
			return 'Manual';
		}
		return self::$types[$this->type];
	}
	
	public function getStatus()
	{
		return empty(self::$states[$this->status])? '' : self::$states[$this->status];
	}
	
	public function getMeta()
	{
		$r = '';
		foreach ($this->mdata as $k=>$v) {
			if ($k == 'fr_att') {
				continue;
			}
			$r .= '<p>'.ucfirst($k).': '.$v.'</p>';
		}
		return $r;
	}
	
	public function showAtts()
	{
		return (empty($this->mdata['fr_att'])? '' : FileRepo::links($this->mdata['fr_att']).' ').FileRepo::links($this->attachments);
	}

	public function getInvNo()
	{
		return empty($this->mdata['invoice'])? 'N/A' : $this->mdata['invoice'];
	}
	
	public function beforeSave()
	{
		if (!empty($this->mdata)) {
			$this->meta = json_encode($this->mdata);
		}
		if (empty($this->from_id)) {
			$this->from_id = empty(Yii::app()->user)?0:Yii::app()->user->id;
		}
		if (empty($this->dt)) {
			$this->dt = date('Y-m-d H:i:s');
		}
		if (empty($this->status)) {
			$this->status = 30;
		}

		if (!empty($this->fobj->consol) && strtotime($this->fobj->consol->eta) >= strtotime('2020-08-01')) {
			if ($this->mdata['from'] == 'imports@pcaexpress.com.au') {
				$this->mdata['from'] = 'imports@toplogistics.com.au';
			}
			if ($this->mdata['fromName'] == 'PCA imports') {
				$this->mdata['fromName'] = 'Top Logistics Australia';
			}
		}

		return true;
	}
	
	public function afterFind()
	{
		if (!empty($this->meta)) {
			$this->mdata = json_decode($this->meta, true);
		}
	}

	/**
	* Retrieves a list of models based on the current search/filter conditions.
	*
	* Typical usecase:
	* - Initialize the model fields with values from filter form.
	* - Execute this method to get CActiveDataProvider instance which will filter
	* models according to data in model fields.
	* - Pass data provider to CGridView, CListView or any similar widget.
	*
	* @return CActiveDataProvider the data provider that can return the models
	* based on the search/filter conditions.
	*/
	public function search()
	{
		// @todo Please modify the following code to remove attributes that should not be searched.

		$criteria=new CDbCriteria;

		$criteria->compare('t.id', $this->id, true);
		$criteria->compare('from_id', $this->from_id, true);
		$criteria->compare('to_id', $this->to_id, true);
		$criteria->compare('t.type', $this->type);
		$criteria->compare('t.status', $this->status);
		$criteria->compare('fid', $this->fid, true);
		$criteria->compare('dt', $this->dt, true);
		$criteria->compare('subject', $this->subject, true);
		$criteria->compare('body', $this->body, true);
		$criteria->compare('scheduled', $this->scheduled, true);
		
		$with = [];

		if (!empty($this->to_name)) {
			$with = ['to','to.org'];
			$dcrit = new CDbCriteria;
			$dcrit->compare('org.name', $this->to_name, true);
			$dcrit->compare('to.name', $this->to_name, true, 'OR');
			$dcrit->compare('t.meta', $this->to_name, true, 'OR');
			$criteria->mergeWith($dcrit);
		}
		
		if (!empty($this->from_name)) {
			$with[] = 'from';
			$dcrit = new CDbCriteria;
			$dcrit->compare('from.name', $this->from_name, true);
			$criteria->mergeWith($dcrit);
		}

		if (!empty($with)) {
			$criteria->with = $with;
			$criteria->together = true;
		}

		return new CActiveDataProvider($this, [
			'criteria'=>$criteria,
			'sort'=>[
				'defaultOrder'=>'t.id DESC',
			],
			'pagination'=>[
				'pageSize'=>'30',
			],
		]);
	}
		
	public static function prepareLink($url)
	{
		$url= preg_replace('/&/', '&amp;', $url);
		return "<a href='$url' >$url</a>";
	}
		
