 foreach($tabs as $key => $tab){
    $href = strpos($tab[0], '/') === false? $this->createUrl('warehouseProcess/processPage',array('tab'=>$tab[0], "tabid" => "tab".$key)) : $tab[0];
    echo '<li><a href="'.$href.'" class="active">'.$tab[1].'</a></li>';
 }
 ?>
