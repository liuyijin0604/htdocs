<?php
class DaipostAPI
{
	public $result;
	public $err;
	public $is_test;
	public $debug;

	public function __construct($debug = false,$type=null)
	{
		$this->debug = $debug;
		if(empty($type)||$type=='SYD')
		{
			$this->fromInfo=[
				'suburb'=>"BANKSTOWN AERODROME",
				'postcode'=>"2200",
				'address'=>"1/233 Milperra Rd",
				'state'=>"NSW"
			];
		}elseif($type=='MEL')
		{
			$this->fromInfo=[
				'suburb'=>"Sunshine",
				'postcode'=>"3020",
				'address'=>"3B/8 Judge St",
				'state'=>"VIC"
			];
		}elseif($type=='BNE')
		{
			$this->fromInfo=[
				'suburb'=>"Coopers Plains",
				'postcode'=>"4108",
				'address'=>"6/55 Musgrave Rd",
				'state'=>"QLD"
			];
		}elseif($type=='PER')
		{
			$this->fromInfo=[
				'suburb'=>"Welshpool",
				'postcode'=>"6106",
				'address'=>"Warehouse, 8 Glenferrie Road",
				'state'=>"WA"
			];
		}

	}
		

	public function request($action, $method='POST', $data=null,$log = true)
	{
		$this->result=false;
		
		$url= ($this->is_test?self::TEST_URL:self::PRODUCTION_URL).$action;
		$c=new curl($url);
		$c->setopt(CURLOPT_CUSTOMREQUEST, strtoupper($method));
		$c->setopt(CURLOPT_RETURNTRANSFER, true);
		$c->setopt(CURLOPT_SSL_VERIFYPEER, false);
		$c->setopt(CURLOPT_TIMEOUT, 600);
		$hdr = $this->build_headers($method, $url);
		if (!empty($data)) {
			$data = AppHelper::safeJsonEncode($data);
			$c->setopt(CURLOPT_POSTFIELDS, $data);
		}
		$c->setopt(CURLOPT_HTTPHEADER, $hdr);
		 
		if (!$c->exec()) {
			throw new Exception('cUrl Error: '.$c->err);
		}
		$this->rescode=$c->rcode;
		$this->result = json_decode($c->result);
		if($log)
		{
			$this->log2file('Time: '.date('Y-m-d H:i:s')."\nURL: ".$url."\nRequest: ".json_encode($data)."\nResponse Code: ".$this->rescode."\nResponse: ".$c->result.PHP_EOL.PHP_EOL);
		}
		return $this->result;
	}

	public function getFtpTracking($ss,$fileName)
	{
		$events = [Tracking::TYPE_HELD=>['CC2','Custom Clearance Delay'],Tracking::TYPE_CLEARED=>['CC4','Customs Cleared'],Tracking::TYPE_HAND_OVER=>['T5','Handed over to Carrier']];
		$xlsave = new oExcel('CSV');
		$xlsave->addRow(1, ["Tracking #","Location","Event State","Event Datetime","Event Code","Event Description"]);
		$start = 2;
		foreach ($ss as $key => $s) 
		{
			$newDaipost = new DaipostAPI(false,Org::$importWarehouseList[$s->consol->dpt_id]);
			if(empty($s->ref)) continue;
			if(!empty($s->tracks))
			{
				foreach ($s->tracks as $k2 => $track)
				{
					if(!empty($track->mdata['sync_daipost'])) continue;
					if(!in_array($track->type,array_keys($events))) continue;

					if(!empty($s->consol->container_no))
					{
						$xlsave->addRow($start, [$s->ref,$newDaipost->fromInfo['suburb'],$newDaipost->fromInfo['state'],date("Y-m-d H:i",strtotime($track->dt)),$events[$track->type][0],$events[$track->type][1]]);
					}else
					{
						$xlsave->addRow($start, [$s->ref,$newDaipost->fromInfo['suburb'],$newDaipost->fromInfo['state'],date("Y-m-d H:i",strtotime($track->dt)),$events[$track->type][0],$events[$track->type][1]]);
					}
					$start++;
				}
			}
		}
		$xlsave->output($fileName, null, false);
		if($start==2) return false;
		return file_get_contents($fileName);
	}

	public function ftpTracking($ss)
	{
		require_once Yii::app()->basePath . '/vendor/autoload.php';
		$man_no = date('YmdHis');
		$mfn = 'TLA_DAIPOST_'.$man_no.'_event.csv';
		$fileName=Yii::app()->basePath.DIRECTORY_SEPARATOR.'runtime'.DIRECTORY_SEPARATOR  . 'DAIPOST' . DIRECTORY_SEPARATOR.'tracking'. DIRECTORY_SEPARATOR.$mfn;
		$sftp = new phpseclib\Net\SFTP('103.230.159.64');
		// Check SFTP Connection
		if ($sftp->login('daipost', 'sdhds^*&j!')) {
			// $lists = $sftp->rawlist('/Manifests');
			$sftp->chdir('tracking');
			$ftpFileData = $this->getFtpTracking($ss,$fileName);
			if(empty($ftpFileData)||$sftp->put($mfn, $ftpFileData)){
				//update tranship
				$trans = Yii::app()->db->beginTransaction();
				try{
					foreach($ss as $s){
						if(empty($s->ref)) continue;
						foreach ($s->tracks as $k2 => $track)
						{
							$track->mdata['sync_daipost'] = 1;
							$track->save();
						}
					}
					$trans->commit();
				} catch (Exception $ex) {
					$trans->rollback();
					unlink($fileName);
					throw $ex;
				}

				return true;
			}else
			{
				echo "failed";
				unlink($fileName);
			}
		}
		return false;
	}

	public function receiveDaipostManifestFile()
	{
		require_once Yii::app()->basePath . '/vendor/autoload.php';
		$sftp = new phpseclib\Net\SFTP('103.230.159.64');
		$rootPath = Yii::app()->basePath.DIRECTORY_SEPARATOR.'runtime'.DIRECTORY_SEPARATOR.'DAIPOST'.DIRECTORY_SEPARATOR.'manifest';
		$imsService = new ImsService(4669,"","AUD");
		// Check SFTP Connection
		if ($sftp->login('daipost', 'sdhds^*&j!')) {
			$sftp->chdir('manifest');
			$get_path = $sftp->pwd();
			$filepaths = $sftp->nlist();
			foreach ($filepaths as $key => $filepath) {
				if($filepath=="."||$filepath=="..") continue;
				$fileCalculator = explode('.', $filepath)[0];
				if($fileCalculator>'1')
				{
					//this table will be also used for Daipost manifest
					$oldRecord = FastwayTrackingFileImport::model()->find('content = :content',[":content"=>$filepath]);
					if(!empty($oldRecord))
					{
						$sftp->delete($filepath);
						continue;
					}

					$result = $sftp->get($filepath);
					$fileFullName = $rootPath.DIRECTORY_SEPARATOR.$filepath;
					file_put_contents($fileFullName, $result);
					$dataArr = oExcel::getFileData($fileFullName);
					$data = $dataArr[0];
					unset($data[1]);
					$dataBarcodes = [];
					if(isset($dataArr[1]))
					{
						$dataBarcodes = $dataArr[1];
					}
					if(isset($dataArr[2]))
					{
						$dataBarcodes = $dataArr[2];
					}

					$shipmentChecks = [];
					$duplicateShipments = [];
					$errors = [];
					$hbns = [];
					$awb = "";
					if(preg_match('/\d{3}\-\d{8}/',$fileFullName,$m))
					{
						$awb = $m[0];
					}
					foreach ($data as $key => $row) {
						$hbns[] = $row[2];
						$row[1] = $row[2];
						$row[13] = preg_replace('/[\x{4e00}-\x{9fa5}]+/u', '', $row[13]);
						$row[13] = preg_replace('/([\x80-\xff]*)/i','',$row[13]);
						$row[13] = str_replace(';', ',', $row[13]);
						if(!empty($row[16])&&$row[16]>0.00001)
						{
							$row[15] = number_format($row[16]/$row[14], 6, '.', '');
						}

						if(in_array($row[2],$shipmentChecks))
						{
							$duplicateShipments[] = $row[2];
						}

						$o = $imsService->prepareData($row,[],true);
						if(empty($o->status))
						{
							$errors[] = $row[2].":".$o->msg;
							continue;
						}

						$o = $imsService->importShipmentWithoutChecking($o->shipmentData,true);
						if(!empty($o->errors))
						{
							$errors[] = $row[2].":".join(";",$o->errors);
						}
						$shipmentChecks[] = $row[2];
					}

					if(!empty($errors)||!empty($duplicateShipments))
					{
						// echo join(",",$existingShipmentErrors)." existing parcels".PHP_EOL."|".join(",",$duplicateShipments)." duplicate parcels".PHP_EOL.join('|'.PHP_EOL,$errors);
						Emailog::sendEmailTo('dev@toplogistics.com.au',join(",",$duplicateShipments)." duplicate parcels".PHP_EOL.join('|'.PHP_EOL,$errors),$filepath." DAIPOST manifest error");
						continue;
					}

					unset($dataBarcodes[1]);
					$barcodeArr = [];
					foreach ($dataBarcodes as $key => $dataBarcode) {
						$barcodeArr[$dataBarcode[1]][] = $dataBarcode[2];
					}
					
					$transaction = Yii::app()->db->beginTransaction();
					try {
						foreach ($data as $key => $row) {
							$row[1] = $row[2];
							$row[13] = preg_replace('/[\x{4e00}-\x{9fa5}]+/u', '', $row[13]);
							$row[13] = preg_replace('/([\x80-\xff]*)/i','',$row[13]);
							$row[13] = str_replace(';', ',', $row[13]);
							if(!empty($row[16])&&$row[16]>0.00001)
							{
								$row[15] = number_format($row[16]/$row[14], 6, '.', '');
							}

							$o = $imsService->prepareData($row,[],true);
							if(empty($o->status))
							{
								$errors[] = $row[2].":".$o->msg;
								continue;
							}
							$o->shipmentData->carrier_injection_point = $row[47];
							$o->shipmentData->carrier_code = $row[48];
							$o->shipmentData->ref = $row[49];
							$barcodes  = [];
							$o->shipmentData->packs = 1;
							if(!empty($barcodeArr[$o->shipmentData->ref]))
							{
								$barcodes  = $barcodeArr[$o->shipmentData->ref];
								$o->shipmentData->packs = count($barcodes);
							}
							$o = $imsService->importShipmentWithoutChecking($o->shipmentData,false);
							$shipment = $o->shipment;
							if($row[48]=="RMX") $row[48] = "FASTWAY";
							$shipment->mdata['carrier_injection_point'] = $row[47];
							$shipment->mdata['carrier_code'] = $row[48];
							$shipment->ref = $row[49];
							$shipment->save();
							if (!empty($row[50])) {
								$pb = new ParcelBarcode();
								$pb->main_ref = $shipment->ref;
								$pb->fid = $shipment->id;
								$pb->sub_ref = $row[50];
								$pb->sn = 1;
								$pb->save();
							}


							foreach ($barcodes as $k2 => $barcode) {
								$pb = new ParcelBarcode();
								$pb->main_ref = $shipment->ref;
								$pb->fid = $shipment->id;
								$pb->sub_ref = $barcode;
								$pb->sn = $k2+1;
								$pb->save();
							}
						}
						$transaction->commit();
					} catch (Exception $ex) {
						$transaction->rollback();
						print_r($o);
						throw $ex;
					}



					$record = new FastwayTrackingFileImport();
					$record->content = $filepath;
					$record->created = date('Y-m-d H:i:s');
					if($record->save())
					{
						$thisFilename = explode(".",$filepath)[0];
						$content = "HBN\n";
						$txtFileFullName = $rootPath.DIRECTORY_SEPARATOR.$thisFilename.".txt";
						foreach ($hbns as $hbnkey => $hbn) {
							$content .=$hbn."\n";
						}
						$fp = fopen($txtFileFullName,"wb");
						fwrite($fp,$content);
						fclose($fp);
						$frid = FileRepo::storeFile($txtFileFullName, $thisFilename.".txt", FileRepo::DAIPOST_MANIFEST_FILE, $record->id);
						$fr = FileRepo::model()->findByPk($frid);
						Emailog::sendEmailTo('imports@toplogistics.com.au',"DAIPOST ".$awb." manifest","DAIPOST ".$awb." manifest","dev@toplogistics.com.au","dev",[$fr]);
						unlink($txtFileFullName);
					}
					$sftp->disconnect();
					return true;
				}

			}
		}

		$sftp->disconnect();
		return false;
	}
	 
	protected function log2file($m, $file='ELabel')
	{
		$lf = Yii::app()->basePath.DIRECTORY_SEPARATOR.'runtime'.DIRECTORY_SEPARATOR . 'UBI' . DIRECTORY_SEPARATOR;
		$lf .= 'ubi_api_'.$file. date('Y-m-d') . '.log';
		return file_put_contents($lf, $m, FILE_APPEND);
	}

}
