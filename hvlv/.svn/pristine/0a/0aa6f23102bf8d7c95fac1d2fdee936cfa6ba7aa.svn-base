    public function actionCalculatePrice()
    {
        if (!empty($_POST)) {
            $data = new stdClass;
            $data->items = json_decode($_POST['items']);
            $data->cbm = 0;
            $data->weight = 0;
            $data->pkg = 0;
            $data->pallets = 0;
            $data->item_type = $_POST['item_type'];
            $data->unloading_location_type = $_POST['unloading_location_type'];
            $unloading = false;
            $data->other_ref = $_POST['other_ref'];
            $data->other_needs = $_POST['other'];
            $data->collection_before = $_POST['pickup_time'];
            $data->delivery_period = $_POST['delivery_time'];
            foreach ($data->items as $item) {
                $cbm = ($item->length/100) * ($item->width/100) * ($item->height/100) * $item->quantity;
                $data->cbm += $cbm;
                $data->weight += ($item->weight * $item->quantity);
                if ($data->item_type == 'cartons') {
                    $data->pkg += $item->quantity;
                } else if ($data->item_type == 'pallets') {
                    $data->pallets += $item->quantity;
                }
            }
            $data->delivery_date_1 = date('Y-m-d', strtotime(str_replace('/', '-', $_POST['pickup_date_1'])));
            $data->delivery_date_2 = !empty($_POST['pickup_date_2']) ? date('Y-m-d', strtotime(str_replace('/', '-', $_POST['pickup_date_2']))) : '';
            
            $collectionAddress = new stdClass;
            $deliveryAddress = new stdClass;

            $collectionAddress->name = $_POST['collection_name'];
            $collectionAddress->tel = $_POST['collection_tel'];
            $collectionAddress->company = $_POST['collection_company'];
            $collectionAddress->email = $_POST['collection_email'];
            $collectionAddress->streetAddress = $_POST['collection_address'];
            $collectionAddress->suburb = $_POST['collection_suburb'];
            $collectionAddress->city = $_POST['collection_city'];
            $collectionAddress->state = $_POST['collection_state'];
            $collectionAddress->postcode = $_POST['collection_postcode'];

            $deliveryAddress->name = $_POST['delivery_name'];
            $deliveryAddress->tel = $_POST['delivery_tel'];
            $deliveryAddress->company = $_POST['delivery_company'];
            $deliveryAddress->email = $_POST['delivery_email'];
            $deliveryAddress->streetAddress = $_POST['delivery_address'];
            $deliveryAddress->suburb = $_POST['delivery_suburb'];
            $deliveryAddress->city = $_POST['delivery_city'];
            $deliveryAddress->state = $_POST['delivery_state'];
            $deliveryAddress->postcode = $_POST['delivery_postcode'];

            $cnorId = $this->saveAddress($collectionAddress);
            $cneeId = $this->saveAddress($deliveryAddress);
            $shipment = $this->saveShipment($data, $cnorId, $cneeId);

            // Save Cargo Booking DO files
            if (!empty($_FILES)) {
                $i = 1;
                $hbn = $shipment->hbn;
                foreach ($_FILES as $fk => $file) {
                    if ($file['error'] == 0 && !empty($file['name'])) {
                        $fileType = substr($file['type'], strpos($file['type'], "/") + 1);
                        $file['name'] = $hbn . "-DO-" . $i . '.' . $fileType;
                        $target_dir = Yii::app()->basePath . DIRECTORY_SEPARATOR . "runtime" . DIRECTORY_SEPARATOR . "cargo_booking_DO" . DIRECTORY_SEPARATOR;
                        if (!is_dir($target_dir)) {
                            mkdir($target_dir);
                        }
                        $target_file = $target_dir . basename($file["name"]);
                        move_uploaded_file($file['tmp_name'], $target_file);
                        // TODO: create a new file type in FileRepo class istead of 18
                        $filerepoId = FileRepo::storeFile($target_file, basename($file["name"]), 200, $shipment->id);
                        unlink($target_file);
                        $i++;
                    }
                }
            }

            $chargecode = '';
            switch ($data->unloading_location_type) {
                case 'b2c':
                    $chargecode = '5791';
                    $unloading = true;
                    break;
                case 'b2b':
                    $chargecode = '1805';
                    break;
                case 'fba':
                    $chargecode = '0499';
                    break;
                case 'interstate':
                    $chargecode = '9536';
                    break;
            }
            
            $basePrice = round($shipment->getChargeByChargecode($chargecode), 2);
            $oversizePrice = $shipment->getChargeByChargecode($chargecode, false, null, true, false, true);
            $oversize = round($oversizePrice['amount'], 2);
            $specificDeliveryTimeFee = 0.00;
            $unloadingFee = 0.00;
            if ($data->delivery_period != 'none' || $data->collection_before != 'none') {
                $specificDeliveryTimeFee = ($basePrice + $oversize) * 0.20;
                /* if ($specificDeliveryTimeFee == 0) {
                    $specificDeliveryTimeFee = 30.00;
                } */
                if ($specificDeliveryTimeFee > 100) {
                    $specificDeliveryTimeFee = 100.00;
                }
            }
            if ($unloading) {
                if ($data->pallets > 0) {
                    $unloadingFee = round((20 * $data->pallets), 2);
                } else {
                    $unloadingFee = 30.00;
                }
            }
            $gst = ($basePrice + $oversize + $specificDeliveryTimeFee + $unloadingFee) * 0.1;
            $total = $basePrice + $oversize + $specificDeliveryTimeFee + $unloadingFee;
            $data->base_price = $basePrice;
            $data->oversize_price = $oversize;
            $data->timed_delivery_fee = $specificDeliveryTimeFee;
            $data->unloading_fee = $unloadingFee;
            $data->gst = $gst;
            $data->total = $total;
            
            if($this->saveCargoBooking($data, $shipment)) {
                $data->success = true;
            } else {
                $data->success = false;
            }
            echo json_encode($data);
        }
    }

    private function saveAddress($address)
    {
        $addr = new Addr();
        $addr->name = $address->name;
        $addr->company = empty($address->company) ? '' : $address->company;
        $addr->address = $address->streetAddress;
        $addr->suburb = $address->suburb;
        $addr->city = $address->city;
        $addr->state = $address->state;
        $addr->postcode = $address->postcode;
        $addr->country = 'Australia';
        $addr->tel = $address->tel;
        $addr->email = $address->email;

        $addr->save();
        return $addr->id;
    }

    private function saveShipment($data, $cnorId, $cneeId)
    {
        $cnor = Addr::model()->findByPk($cnorId);
        $cnee = Addr::model()->findByPk($cneeId);
        switch ($cnor->state) {
            case 'NSW':
                $dpt_id = 106;
                $pol = 'AUSYD';
                break;
            case 'VIC':
                $dpt_id = 218;
                $pol = 'AUMEL';
                break;
            case 'QLD':
                $dpt_id = 530;
                $pol = 'AUBNE';
                break;
            case 'WA':
                $dpt_id = 811;
                $pol = 'AUPER';
                break;
        }
        $day = date('w');
		$week_start = date('Y-m-d', strtotime('-'.($day-1).' days'));
		$week_end = date('Y-m-d', strtotime('+'.(7-$day).' days'));
        $sql = 'SELECT * FROM consol WHERE `owner_id` = ' . Yii::app()->user->org . ' AND `dpt_id` = ' . $dpt_id .' AND `created` >= "' . $week_start . '" AND `created` <= "' . $week_end . '" AND `meta` LIKE "%is_cargo_casual_booking%"';

        $consol = Consol::model()->findBySql($sql);

        if (empty($consol)) {
            $consol = new Consol();
            $consol->pc_id = 0;
            $consol->owner_id = Yii::app()->user->org;
            $consol->dpt_id = $dpt_id;
            $consol->carrier_id = 0;
            $consol->type = Consol::IMCOCONSOLTYPE;
            $consol->service = Consol::AIRCONSOL;
            $consol->exrate = 0.0000;
            $consol->pol = $pol;
            $consol->pod = $pol;
            $consol->eta = date('Y-m-d');
            $consol->created = date('Y-m-d');
            $consol->status = 60;
            $consol->bwf = 0;
            $consol->mdata['is_cargo_casual_booking'] = 1;
            //$consol->mdata['for3PL'] = 1;
            $consol->save();
        }
        
        $shipment = new ImParcel();
        $shipment->consol_id = $consol->id;
        $shipment->agent_id = Yii::app()->user->org;
        $shipment->odpt_id = $dpt_id;
        $shipment->ddpt_id = $dpt_id;
        $shipment->cnor_id = $cnorId;
        $shipment->cnee_id = $cneeId;
        $shipment->status = 10;
        $shipment->type = 10;
        $shipment->hbn = $shipment->genHbn();
        $shipment->ref = $shipment->genBPHbn();
        $shipment->pkg = $data->pkg;
        $shipment->state = $cnee->state;
        $shipment->postcode = $cnee->postcode;
        $shipment->value = 1.00;
        $shipment->dvalue = 1.00;
        $shipment->insurance = 0.00;
        $shipment->currency = 1;
        $shipment->weight = $data->weight;
        $shipment->cbm = $data->cbm;
        $shipment->created = date('Y-m-d');
        $shipment->mdata['amzon_pallet'] = $data->pallets;

        $shipment->save();
        return $shipment;
    }

    private function saveCargoBooking($data, $shipment)
    {
        if (!empty($shipment)) {
            $cargoBooking = new CargoBooking();
            $cargoBooking->create_date = date('Y-m-d H:i:s');
            $cargoBooking->booking_date_1 = $data->delivery_date_1;
            $cargoBooking->booking_date_2 = $data->delivery_date_2;
            $cargoBooking->status = CargoBooking::PENDING;
            $cargoBooking->org_id = Yii::app()->user->org;
            $cargoBooking->shipment_id = $shipment->id;
            $cargoBooking->generateBookingNumber($shipment->consol->dpt_id);
            $cargoBooking->destination = $shipment->cnee_id;
            $cargoBooking->ref = $shipment->ref;
            $cargoBooking->hbn = $shipment->hbn;
            $cargoBooking->depot = $shipment->odpt_id;
            $cargoBooking->mdata['items'] = $data->items;
            $cargoBooking->mdata['need_unloading'] = ($data->unloading_location_type == 'b2c') ? 'Yes' : 'No';
            $cargoBooking->mdata['special_need_othe'] = $data->other_needs;
            $cargoBooking->mdata['collection_before'] = $data->collection_before;
            $cargoBooking->mdata['delivery_before'] = $data->delivery_period;
            $cargoBooking->mdata['base_price'] = $data->base_price;
            $cargoBooking->mdata['oversize_fee'] = $data->oversize_price;
            $cargoBooking->mdata['time_deliver_fee'] = $data->timed_delivery_fee;
            $cargoBooking->mdata['unloading_fee'] = $data->unloading_fee;
            $cargoBooking->other_ref = $data->other_ref;
            $cargoBooking->fee = $data->total;
            if($cargoBooking->save()){
                return true;
            } else {
                return false;
            }
        }
        return false;
    }
}
