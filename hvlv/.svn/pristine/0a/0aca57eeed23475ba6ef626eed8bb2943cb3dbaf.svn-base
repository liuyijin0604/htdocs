	}

	public function testArray()
	{
		$container_no = "SUDU1120519";
		$connote = "TPN1474037827";
		$sql = 'SELECT * FROM shipment WHERE `hbn` = "' . $connote . '" AND `consol_id` IN (SELECT `id` FROM consol WHERE `container_no` = "' . $container_no . '")';
		$model = ImParcel::model()->findBySql($sql);
		$availableDate = null;

		if (!empty($model)) {
			if (!empty($model->consol->mdata['available_date'])) {
				$availableDate = date('Y-m-d H:i:s', strtotime($model->consol->mdata['available_date']));
				$today = date('Y-m-d H:i:s', strtotime('today'));
				if ($availableDate < $today) {
					$availableDate = $today;
				}
				$endDate = date('Y-m-d H:i:s', strtotime($availableDate . '+8 day'));
				$sql = 'SELECT * FROM delivery_record WHERE `booking_time` >= "' . $availableDate . '" AND `booking_time` < "' . $endDate . '"';
				$bookings = DeliveryRecord::model()->findAllBySql($sql);
				$days = [];
				for ($i = 0; $i < 8; $i++) {
					array_push($days, date('Y-m-d', strtotime($availableDate . '+' . $i . ' day')));
				}
				$availableSlots = [];
				foreach ($days as $day) {
					$availableSlots[$day] = [4, 4, 4, 2, 2, 2, 1, 1, 4, 4, 2];
				}

				$occupiedSlots = [];
				if (!empty($bookings)) {
					foreach ($bookings as $booking) {
						$bookingDate = explode(" ", $booking->booking_time)[0];
						$bookingTime = explode(" ", $booking->booking_time)[1];
						if (empty($occupiedSlots[$bookingDate])) {
							$occupiedSlots[$bookingDate] = [$bookingTime];
						} else {
							array_push($occupiedSlots[$bookingDate], $bookingTime);
						}
					}
					if (in_array("12:15:00", $occupiedSlots["2022-08-17"])) {
						echo "occupied";
					}
				}
			}
		}
	}

