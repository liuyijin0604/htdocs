	public function subArray()
	{
		$objMarketingEmail = MarketingEmail::model()->findByPk(54);
		$listMarketingAddress = MarketingAddress::model()->findAll('status=' . MarketingAddress::status_active);
		$filteredEmails = [];
		$emailSubGroups = [];

		foreach ($listMarketingAddress as $objMarketingAddress) {
			foreach ($objMarketingEmail->mdata['Group'] as $group) {
				if ($objMarketingAddress->group == $group) {
					array_push($filteredEmails, $objMarketingAddress);
				}
			}
		}
		$totalEmails = sizeof($filteredEmails);
		if ($totalEmails % 40 == 0) {
			$numOfGroups = $totalEmails / 40;
		} else {
			$numOfGroups = floor($totalEmails / 40 + 1);
		}
		for ($i = 0; $i < $numOfGroups; $i++) {
			array_push($emailSubGroups, array_slice($filteredEmails, $i * 40, 40));
		}
		foreach ($emailSubGroups as $emailSubGroup) {
			$strAddress = '';
			foreach ($emailSubGroup as $emailAddress) {
				$strAddress .= $emailAddress->email . ';';
			}
			echo "Group: \n";
			echo $strAddress;
			echo "\n";
		}
	}

	public function regExpTest()
	{
		$phone = readline('Enter a phone number: ');
		$regExp = '/^(\d)\1+$/';
		while ($phone != 'q') {
			if (preg_match($regExp, $phone) == 1) {
				echo "Invalid.\n";
			} else {
				echo "Valid.\n";
			}
			$phone = readline('Enter a phone number: ');
		}
		echo "Done.";
	}

	public function feedbackEmail()
	{
		$fromTime = '2022-06-22 00:00:00';
		$toTime = '2022-06-22 23:59:59';
		$sql = "SELECT * FROM imports_mail WHERE 
		ticket != '' 
		AND `date` >= '" . $fromTime . "'
		AND `date` <= '" . $toTime . "'
		AND subject NOT LIKE '%Re:%' 
		AND id NOT IN (SELECT id FROM imports_mail WHERE from_email LIKE '%@toplogistics.com.au%' AND to_email LIKE '%@toplogistics.com.au%' AND `date` >= '" . $fromTime . "' AND `date` <= '" . $toTime . "')
		AND from_email NOT LIKE '%@fastway.com.au%'
		AND from_email NOT LIKE '%@tollgroup.com%'
		AND from_email NOT LIKE '%@au.gotoubi.com%'
		AND to_email NOT LIKE '%@fastway.com.au%'
		AND to_email NOT LIKE '%@tollgroup.com%'
		AND to_email NOT LIKE '%@au.gotoubi.com%'
		ORDER BY to_email";

		$emailList = ImportsMail::model()->findAllBySql($sql);	// emailList is ordered by to_email attribute for further use
		$addr1 = '7@ac-logistics.cn';
		$addr2 = '7@ac-logistics.cn;';
		$count = 1;			// default count value of each email address
		$total = 0;
		$prevTo = '';		// store the last email address
		foreach ($emailList as $email) {
			if ($email->date > $email->getDeadline()) {
				//continue;
			}
			if ($prevTo == $email->to_email) {
				$count++;
				// for each duplicated email address, only keep top 10 to send feedback email
				if ($count > 10) {
					continue;
				}
			} else {
				$count = 1;
			}
			echo "From: " . $email->from_email . "\tTo: " . $email->to_email . "\tSubject: " . $email->subject . "\tDeadline: " . $email->getDeadline();
			echo "\n";
			$service = new EmailService();
			$service->sendImportsMailFeedbackEmail($email);

			$email->status = ImportsMail::STATE_FEEDBACK_SENT;
			$email->save();
			// update previous email address
			$prevTo = $email->to_email;
			$total++;
		}
		echo $total;
		echo "\n";
		echo "Done!";
	}

