	public function actionProcessDone($id)
	{
		$id = $_GET['id'];
		$upload_consol = isset($_GET['upload_consol'])?1:0;
		$ids = explode(CargoProcess::IP_SEPERATOR,$id);
		if($upload_consol!=0)
		{
			if(count($ids)>1)
			{
				echo "upload_consol can only use in one shipment";
				return;
			}
		}

		foreach ($ids as $key => $thisId) 
		{
				$model=$this->loadModel($thisId);
				$model->processDone($upload_consol);
		}
		echo 'done';
	}

