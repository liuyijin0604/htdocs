	/**
	 * cargolist;
	 */
	private function getCargoList($cargo_type)
	{
		

		$filtersForm=new FiltersForm;
		$podId=$_GET['pod_id'];
		if (isset($_GET['FiltersForm'])) {
			$filtersForm->filters=$_GET['FiltersForm'];
		}
		$provide=[];
		$joinSql = $cargo_type == CargoProcess::PICKUP_CARGO?$this->joinSqlC:$this->joinSql;
		$pod = SystemSetting::getCargoProcessPodSetting($podId);
		$state = @$pod["postcode"];
		$selectStateStr = "postcode like ";
		$sql ="";
		if(empty($state))
		{
			$state = @$pod["state"];
			$selectStateStr = "state = ";
		}

		$state = "'".$state."'";

		$sql =" SELECT (@i :=@i + 1) AS id,cg.status,count(*) as number
				, (SELECT count(*) FROM `cargo_process` c ${joinSql} WHERE DATEDIFF(NOW(),date)<=1 and c.status=cg.status and s2.status<100 and c.dpt_id ={$podId} and c.type = {$cargo_type} {$this->getUserStr()} ) as day1
				, (SELECT count(*) FROM `cargo_process` c ${joinSql} WHERE DATEDIFF(NOW(),date)<3 and DATEDIFF(NOW(),date)>1 and c.status=cg.status and s2.status<100  and c.dpt_id ={$podId} and c.type = {$cargo_type}  {$this->getUserStr()} ) as day2
				, (SELECT count(*) FROM `cargo_process` c ${joinSql} WHERE DATEDIFF(NOW(),date)>=3 and c.status=cg.status and s2.status<100  and c.dpt_id ={$podId} and c.type = {$cargo_type}  {$this->getUserStr()} ) as day3
				FROM (SELECT @i := 0) AS it ,`cargo_process` cg JOIN `shipment` s ON cg.shipment_id=s.id 
	            join `addr` ad on s.cnee_id = ad.id
				 WHERE cg.status<".CargoProcess::PROCESSDONE." and cg.dpt_id ={$podId} and cg.type = {$cargo_type}  {$this->getUserStr(true)} and s.status<100 group by cg.status ";

		$provide=Yii::app()->db->createCommand($sql)->queryAll();
		$filteredData=$filtersForm->filter($provide);
		$dataprovider=new CArrayDataProvider($filteredData);
		$dataprovider->pagination=['pageSize' =>10,];
		$sort=new CSort();
		$sort->attributes=[
			'number'=>[
				'asc'=>'number ASC',
				'desc'=>'number DESC',
			],
			'status'=>[
				'asc'=>'status ASC',
				'desc'=>'status DESC',
			],
		];
		$sort->defaultOrder = "status ASC";
		$dataprovider->sort=$sort;

		$amazonWeekPlan = [];
		if($cargo_type==CargoProcess::FBA_CARGO)
		{
			$day = date('N');
			if($day<=3)
			{
				$today = date('Y-m-d');
				$thisWeekDayOne = date('Y-m-d',strtotime('-'.($day-1).' day',strtotime($today)));
				$lastWeekDayOne =  date('Y-m-d',strtotime('-7 day',strtotime($thisWeekDayOne)));
				$week1 = [];
				$week2 = [];
				for ($i=0; $i < 7; $i++)
				{
					$iap=ImportsAmazonPlan::model()->find('amazon_booking_time = :abt and dpt_id=:dptId',[':abt'=>$thisWeekDayOne.' 00:00:00',':dptId'=>$podId]);
					$pallet = empty($iap)?'':$iap->pallet;
					$week1[] = [$thisWeekDayOne,$pallet];
					$thisWeekDayOne = HolidayHelper::getNextDay($thisWeekDayOne);

					$iap=ImportsAmazonPlan::model()->find('amazon_booking_time = :abt and dpt_id=:dptId',[':abt'=>$lastWeekDayOne.' 00:00:00',':dptId'=>$podId]);
					$pallet = empty($iap)?'':$iap->pallet;
					$week2[] = [$lastWeekDayOne,$pallet];
					$lastWeekDayOne = HolidayHelper::getNextDay($lastWeekDayOne);
				}
				$amazonWeekPlan = [$week1,$week2];
			}else
			{
				$today = date('Y-m-d');
				$thisWeekDayOne = date('Y-m-d',strtotime('-'.($day-1).' day',strtotime($today)));
				$nextWeekDayOne =  date('Y-m-d',strtotime('+7 day',strtotime($thisWeekDayOne)));
				$week1 = [];
				$week2 = [];
				for ($i=0; $i < 7; $i++)
				{
					$iap=ImportsAmazonPlan::model()->find('amazon_booking_time = :abt and dpt_id=:dptId',[':abt'=>$thisWeekDayOne.' 00:00:00',':dptId'=>$podId]);
					$pallet = empty($iap)?'':$iap->pallet;
					$week1[] = [$thisWeekDayOne,$pallet];
					$thisWeekDayOne = HolidayHelper::getNextDay($thisWeekDayOne);

					$iap=ImportsAmazonPlan::model()->find('amazon_booking_time = :abt and dpt_id=:dptId',[':abt'=>$nextWeekDayOne.' 00:00:00',':dptId'=>$podId]);
					$pallet = empty($iap)?'':$iap->pallet;
					$week2[] = [$nextWeekDayOne,$pallet];
					$nextWeekDayOne = HolidayHelper::getNextDay($nextWeekDayOne);
				}
				$amazonWeekPlan = [$week1,$week2];
			}
		}


		$cargo=new CargoProcess('search');
		$cargo->unsetAttributes();

		if(!empty($_GET['CargoProcess']))
		{
			$cargo->setAttributes($_GET['CargoProcess']);
			if(isset($_GET['CargoProcess']['assignedUser']))
			{
				$cargo->assignedUser = $_GET['CargoProcess']['assignedUser'];
			}
			if(isset($_GET['CargoProcess']['driver_id']))
			{
				$cargo->driver_id = $_GET['CargoProcess']['driver_id'];
			}
			if(isset($_GET['ImParcel']['consol_no']))
			{
				$cargo->consol_no = $_GET['ImParcel']['consol_no'];
			}
			if(isset($_GET['CargoProcess']['exInfo']))
			{
				$cargo->exInfo = $_GET['CargoProcess']['exInfo'];
			}
		}
			
		if (isset($_GET['status'])) {
			if (!empty($_GET['status'])) {
				$cargo->setAttribute('status', $_GET['status']);
			}
			
			if($cargo->status==CargoProcess::PROCESSDONE)
			{
				if(!isset($_GET['CargoProcess']['ref']))
				{
					$cargo->ref ='searching';
				}
			}


			$this->renderPartial('_sub_cargos', [
				'cargo' => $cargo,
				'name' => 'All',
				'pod_id'=> $podId,
				'cargo_type' => $cargo_type,
				'status' => $_GET['status']
			],false, true);
		} else {
			//$cargo->setAttribute('id', -1);
			$this->render('cargo_list', ['dataProvider'=>[$dataprovider,$filtersForm],'cargo'=>$cargo,'cargo_type' =>$cargo_type,'amazonWeekPlan'=>$amazonWeekPlan]);
		}
	}

	/**
	 * cargolist;
	 */
	public function actionCreateCargoJob()
	{
		$cargoType = $_GET['typ'];
		$podId=$_GET['pod_id'];
		$filtersForm=new FiltersForm;
		if (isset($_GET['FiltersForm'])) {
			$filtersForm->filters=$_GET['FiltersForm'];
		}
		$cargo=new CargoProcess('search');
		$cargo->unsetAttributes();
		$cargo->isCreateJob = 1;
		if(!empty($_GET['CargoProcess']))
		{
			$cargo->setAttributes($_GET['CargoProcess']);
			if(isset($_GET['CargoProcess']['assignedUser']))
			{
				$cargo->assignedUser = $_GET['CargoProcess']['assignedUser'];
			}
			if(isset($_GET['CargoProcess']['driver_id']))
			{
				$cargo->driver_id = $_GET['CargoProcess']['driver_id'];
			}
			if(isset($_GET['ImParcel']['consol_no']))
			{
				$cargo->consol_no = $_GET['ImParcel']['consol_no'];
			}
			if(isset($_GET['CargoProcess']['exInfo']))
			{
				$cargo->exInfo = $_GET['CargoProcess']['exInfo'];
			}
		}

		$drivers = TopCourierService::getDriverList($podId);
		$vehicles = TopCourierService::getVehicleList();
		$regions = TopCourierService::getTruckDeliveryRegions($podId);

		if($cargoType==CargoProcess::INTERSTATE_CARGO){
			$cargo->paid_interstate = 1;
		}
			
		$this->render('create_cargo_job', [
				'cargo' => $cargo,
				'pod_id'=> $podId,
				'cargo_type' => $cargoType,
				'drivers' => $drivers,
				'vehicles' => $vehicles,
				'regions' => $regions
		]);
	}

	/**
	 * cargolist;
	 */
	public function actionJobDetails($id)
	{
		$model = CargoProcessJob::model()->findByPk($id);
		$filtersForm=new FiltersForm;
		if (isset($_GET['FiltersForm'])) {
			$filtersForm->filters=$_GET['FiltersForm'];
		}
		$cargo=new CargoProcess('search');
		$cargo->unsetAttributes();
		if($model->type == 6){
			$cargo->isSearchJob = 1;
			$cargo->isInterStateJob = 1;
		}else{
			$cargo->isSearchJob = 1;
		}
		$cargo->jobId = $model->id;
		if(!empty($_GET['CargoProcess']))
		{
			$cargo->setAttributes($_GET['CargoProcess']);
			if(isset($_GET['CargoProcess']['assignedUser']))
			{
				$cargo->assignedUser = $_GET['CargoProcess']['assignedUser'];
			}
			if(isset($_GET['CargoProcess']['driver_id']))
			{
				$cargo->driver_id = $_GET['CargoProcess']['driver_id'];
			}
			if(isset($_GET['ImParcel']['consol_no']))
			{
				$cargo->consol_no = $_GET['ImParcel']['consol_no'];
			}
			if(isset($_GET['CargoProcess']['exInfo']))
			{
				$cargo->exInfo = $_GET['CargoProcess']['exInfo'];
			}
		}

		$drivers = TopCourierService::getDriverList($model->dpt_id);
		$vehicles = TopCourierService::getVehicleList();
			
		$this->render('edit_cargo_job', [
				'model' => $model,
				'cargo' => $cargo,
				'drivers' => $drivers,
				'vehicles' => $vehicles
		]);
	}


	/**
	 * cargolist;
	 */
	private function getCargoJobList($jobType)
	{
		$filtersForm=new FiltersForm;
		$dpt_id=$_GET['pod_id'];
		if (isset($_GET['FiltersForm'])) {
			$filtersForm->filters=$_GET['FiltersForm'];
		}
		$provide=[];
		$sql ="";

		$sql="SELECT (@i :=@i + 1) AS id,status,count(*) as number, (SELECT count(*) FROM `cargo_process_job` c WHERE DATEDIFF(NOW(),created)<=1 and c.status=cg.status {$this->getUserStr()} and dpt_id = {$dpt_id} and type = {$jobType}) as day1
			, (SELECT count(*) FROM `cargo_process_job` c WHERE DATEDIFF(NOW(),created)<3 and DATEDIFF(NOW(),created)>1 and c.status=cg.status {$this->getUserStr()} and dpt_id = {$dpt_id} and type = {$jobType}) as day2
			, (SELECT count(*) FROM `cargo_process_job` c WHERE DATEDIFF(NOW(),created)>=3 and c.status=cg.status {$this->getUserStr()} and dpt_id = {$dpt_id} and type = {$jobType}) as day3
			FROM `cargo_process_job` cg,
			(SELECT @i := 0) AS it  WHERE  status<".CargoProcessJob::PROCESSDONE." {$this->getUserStr(true)} and dpt_id = {$dpt_id} and type = {$jobType} group by status";

		$provide=Yii::app()->db->createCommand($sql)->queryAll();
		$filteredData=$filtersForm->filter($provide);
		$dataprovider=new CArrayDataProvider($filteredData);
		$dataprovider->pagination=['pageSize' =>10,];
		$sort=new CSort();
		$sort->attributes=[
			'number'=>[
				'asc'=>'number ASC',
				'desc'=>'number DESC',
			],
			'status'=>[
				'asc'=>'status ASC',
				'desc'=>'status DESC',
			],
		];
		$sort->defaultOrder = "status ASC";
		$dataprovider->sort=$sort;
		$job=new CargoProcessJob('search');
		$job->unsetAttributes();
		if(!empty($_GET['CargoProcessJob']))
		{
			$job->setAttributes($_GET['CargoProcessJob']);
			//$job->driver_id = $_GET['CargoProcessJob']['driver_id'];
		}
		if (isset($_GET['status'])) {
			if (!empty($_GET['status'])) {
				$job->setAttribute('status', $_GET['status']);
			}
			$this->renderPartial('_sub_jobs', [
				'job' => $job,
				'name' => 'All',
				'pod_id'=> $dpt_id,
				'job_type' => $jobType
			],false, true);
		} else {
			$this->render('job_list', ['dataProvider'=>[$dataprovider,$filtersForm],'job'=>$job,'job_type' =>$jobType]);
		}
	}

	private function getPostCode($cargoType,$type = false)
	{
		$postCodeStr = "";
		$postcode =CargoProcess::FBAPOSTCODE;
		switch ($cargoType) {
			case CargoProcess::NORMAL_CARGO:
				$postCodeStr ="type =".CargoProcess::NORMAL_CARGO;
				break;
			case CargoProcess::FBA_CARGO:
				$postCodeStr ="type =".CargoProcess::FBA_CARGO;
				break;
			case CargoProcess::B2B_CARGO:
				$postCodeStr ="type =".CargoProcess::B2B_CARGO;
				break;
			case CargoProcess::PICKUP_CARGO:
				$postCodeStr ="type =".CargoProcess::PICKUP_CARGO;
				break;
			default:
				return "";
				break;
		}

		if($type)
		{
			$postCodeStr = " and cg.".$postCodeStr;
		}else
		{
			$postCodeStr = " and c.".$postCodeStr;
		}
		return $postCodeStr;
	}
		
	/**
	 * Air and normal summary;
	 */
	public function actionSummary()
	{
		$preAlert = new ImParcel('search');
		$preAlert->unsetAttributes();
		$preAlert->cargoProcessPreAlert = ["podId"=>'all',"cargoType"=>'all'];
		if(!empty($_GET["ImParcel"]))
		{
			$allEmpty=true;
			foreach ($_GET["ImParcel"] as $key => $value) {
				if(!empty($value)) $allEmpty = false;
			}
			$preAlert->setAttributes($_GET["ImParcel"]);
			if($allEmpty) $preAlert->ref = 'enter ref';
			$this->render('_sub_cargos_pre_alert_summary',["preAlert"=>$preAlert,"podId"=>'all',"cargoType"=>'all']);
			return;
		}else
		{
			$preAlert->ref = 'enter ref';
		}

		$filtersForm=new FiltersForm;
		if (isset($_GET['FiltersForm'])) {
			$filtersForm->filters=$_GET['FiltersForm'];
		}
		$provide=[];
		$sql="SELECT (@i :=@i + 1) AS id, s.agent_id, o.name,count(*) as number, (SELECT count(*) FROM `cargo_process` c  join shipment s2  on c.shipment_id = s2.id
             join org o2 on s2.agent_id = o2.id WHERE DATEDIFF(NOW(),date)<=1 and s.agent_id=s2.agent_id and c.status< ".CargoProcess::PROCESSDONE." {$this->getUserStr()} ) as day1
			, (SELECT count(*) FROM `cargo_process` c join shipment s2  on c.shipment_id = s2.id
             join org o2 on s2.agent_id = o2.id WHERE DATEDIFF(NOW(),date)<3 and DATEDIFF(NOW(),date)>1 and s.agent_id=s2.agent_id  and c.status< ".CargoProcess::PROCESSDONE." {$this->getUserStr()} ) as day2
			, (SELECT count(*) FROM `cargo_process` c join shipment s2  on c.shipment_id = s2.id
             join org o2 on s2.agent_id = o2.id WHERE DATEDIFF(NOW(),date)>=3 and s.agent_id=s2.agent_id  and c.status< ".CargoProcess::PROCESSDONE." {$this->getUserStr()} ) as day3 from
			(SELECT @i := 0) AS it,`cargo_process` cg
             join shipment s  on cg.shipment_id = s.id
             join org o on s.agent_id = o.id
            WHERE cg.status< ".CargoProcess::PROCESSDONE." {$this->getUserStr(true)} group by s.agent_id order by id";

		$provide=Yii::app()->db->createCommand($sql)->queryAll();
		$filteredData=$filtersForm->filter($provide);
		$dataprovider=new CArrayDataProvider($filteredData);
		$dataprovider->pagination=['pageSize' =>10,];
		$sort=new CSort();
		$sort->attributes=[
			'number'=>[
				'asc'=>'number ASC',
				'desc'=>'number DESC',
			],
			'name' => [
				'asc' => 'name ASC',
				'desc' => 'name DESC',
			],
		];
		$sort->defaultOrder = "status ASC";
		$dataprovider->sort=$sort;
		$cargo=new CargoProcess('search');
		$cargo->unsetAttributes();
		if(!empty($_GET['CargoProcess']))
		{
			$cargo->setAttributes($_GET['CargoProcess']);
			if(isset($_GET['CargoProcess']['assignedUser']))
			{
				$cargo->assignedUser = $_GET['CargoProcess']['assignedUser'];
			}
			if(isset($_GET['CargoProcess']['driver_id']))
			{
				$cargo->driver_id = $_GET['CargoProcess']['driver_id'];
			}
			if(isset($_GET['CargoProcess']['consol_no']))
			{
				$cargo->consol_no = $_GET['CargoProcess']['consol_no'];
			}

		}
			
		if (isset($_GET['agent_id'])) {
			if (!empty($_GET['agent_id'])) {
				$cargo->setAgentId($_GET['agent_id']);
			}
			$this->renderPartial('_sub_cargos_summary', [
				'cargo' => $cargo,
				'name' => 'All',
				'cargo_type' => CargoProcess::NORMAL_CARGO
			]);
		} else {
			$cargo->setAttribute('id', -1);
			$this->render('summary', ['dataProvider'=>[$dataprovider,$filtersForm],'cargo'=>$cargo,'preAlert'=>$preAlert]);
		}
	}

	private function getUserStr($type =false,$userId = 0)
	{
		if((User::getCurrentUserType()==User::IMPORT_TRUCK_DELIVERY)||$userId != 0)
		{
			$head ="";
			if($type)
			{
				$head = " and cg.";
			}else
			{
				$head = " and c.";
			}

			if($userId ==0)
			{
				$userId =User::currentUserID();
			}
			return $head."meta like '%\"assigned_user\":\"".$userId."\"%' ";
		}else
		{
			return "";
		}

	}


	public function actionWaitAcr()
	{
		$model=new Consol('search');
		$model->unsetAttributes();
		if (!empty($_GET['Consol'])) {
			$model->setAttributes($_GET['Consol']);
		}
		$model->dpt_id=$_GET['pod_id'];
		$model->service=$_GET['consol_type'];
		$podName=Org::dptList()[$_GET['pod_id']]."-".($_GET['consol_type']==20?"Sea":"Air");
		$model->process_statuses=[ConsolProcess::STATE_WAITING_MAIN_ACR, ConsolProcess::STATE_WAITING_SUB_ACR];
		$model->process_types=[ConsolProcess::TYPE_FULL_PROCESS, ConsolProcess::TYPE_DIRECT_AIR_CONSOL, ConsolProcess::TYPE_DIRECT_SEA_CONSOL];
		$this->render('_sub_consols', ['consol'=>$model,'name'=>$podName.' Waiting ACR']);
	}
		
	public function actionOperation()
	{
		$id = $_GET["id"];
		$cargoProcess = new CargoProcess();
		$ids = [];
		$result =[];
		if(strpos($id,CargoProcess::IP_SEPERATOR))
		{
			$ids = explode(CargoProcess::IP_SEPERATOR,$id);
			$model= $cargoProcess->findByPk($ids[0]);
			$result['ids'] = $id;
			$result['ismulti'] = 1;
		}else
		{
			$model= $cargoProcess->findByPk($id);
		}

		if($model->status== CargoProcess::WAITINGASSIGNDRIVER||$model->status== CargoProcess::AGENTWAITINGASSIGNDRIVER)
		{
			$cargoType = $model->getCargoType();
			$driverType = $model->getShipmentPod();
			$orgModel= new Org();
			$drivers =[];
			if(!empty($driverType)){
				$orgs = $orgModel->findAll(["condition"=>"(cargo_driver_type & ".$driverType.") > 0 and status = 1 ","order"=>'`by` desc']);
				foreach ($orgs as $key => $org) {
					if($org->by!=1)
					{
						$oname = 'A';
					}else
					{
						$oname = 'system';
					}
					$drivers[$org->id] = "(".$oname.")".$org->name;
				}
			$result['drivers'] =$drivers;
			}
		}

		$result['model'] = $model;
		if(!empty($model->job_relation_inactive)){
			$objCargoProcessRelation = new CargoProcessJobRelations('search');
			$objCargoProcessRelation->cargo_process_id = $model->id;
			$objCargoProcessRelation->enable = 0;
			$result['objCargoProcessRelation'] = $objCargoProcessRelation;
		}
		$this->render('operation_tab', $result);
	}

	public function actionBidding(){
		$id = $_GET["id"];
		$model = $this->loadModel($id);
		if(!empty($model)){
			if(!empty($model->cargo_process_bidding)){
				$objBidding = $model->cargo_process_bidding;
			}else{
				$objBidding = new CargoProcessBidding;
			}
			if(!empty($model->job_relation->job)){
				$objCargoProcessJob = $model->job_relation->job;
			}
		}
		$this->render('bidding_tab', ['objBidding'=>$objBidding,'model'=>$model,'cargoProcessJob'=>$objCargoProcessJob]);
	}

