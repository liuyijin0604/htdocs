	private function getOverviewReport(&$filtersForm, $type='')
	{
		$typeStrC="";
		$typeStrCg="";
		if(!empty($type))
		{ 
			$typeStrC = "c.type =  {$type} and ";
			$typeStrCg = "cg.type =  {$type} and ";
		}
		$provide=[];
		$sql="SELECT (@i :=@i + 1) AS id,cg.status,count(*) as number, (SELECT count(*) FROM `cargo_process` c WHERE {$typeStrC} DATEDIFF(NOW(),date)<=1 and c.status=cg.status {$this->getUserStr()}) as day1
			, (SELECT count(*) FROM `cargo_process` c WHERE {$typeStrC} DATEDIFF(NOW(),date)<3 and DATEDIFF(NOW(),date)>1 and c.status=cg.status {$this->getUserStr()} ) as day2
			, (SELECT count(*) FROM `cargo_process` c WHERE {$typeStrC} DATEDIFF(NOW(),date)>=3 and c.status=cg.status {$this->getUserStr()} ) as day3
			FROM `cargo_process` cg JOIN `shipment` s ON cg.shipment_id=s.id,
			(SELECT @i := 0) AS it  WHERE s.status<100 and {$typeStrCg} cg.status<".CargoProcess::PROCESSDONE." {$this->getUserStr(true)} group by cg.status";
		$provide=Yii::app()->db->createCommand($sql)->queryAll();
		$filteredData=$filtersForm->filter($provide);
		$dataprovider=new CArrayDataProvider($filteredData);
		$dataprovider->pagination=['pageSize' =>10,];
		$sort=new CSort();
		$sort->attributes=[
			'number'=>[
				'asc'=>'number ASC',
				'desc'=>'number DESC',
			],
			'status'=>[
				'asc'=>'status ASC',
				'desc'=>'status DESC',
			],
		];
		$sort->defaultOrder = "status ASC";
		$dataprovider->sort=$sort;
		return $dataprovider;
	}

	private function getJobOverviewReport(&$filtersForm, $type='')
	{
		$typeStrC="";
		$typeStrCg="";
		if(!empty($type))
		{ 
			$typeStrC = "c.type =  {$type} and ";
			$typeStrCg = "cg.type =  {$type} and ";
		}
		$provide=[];
		$sql="SELECT (@i :=@i + 1) AS id,status,count(*) as number, (SELECT count(*) FROM `cargo_process_job` c WHERE {$typeStrC} DATEDIFF(NOW(),created)<=1 and c.status=cg.status {$this->getUserStr()}) as day1
			, (SELECT count(*) FROM `cargo_process_job` c WHERE {$typeStrC} DATEDIFF(NOW(),created)<3 and DATEDIFF(NOW(),created)>1 and c.status=cg.status {$this->getUserStr()} ) as day2
			, (SELECT count(*) FROM `cargo_process_job` c WHERE {$typeStrC} DATEDIFF(NOW(),created)>=3 and c.status=cg.status {$this->getUserStr()} ) as day3
			FROM `cargo_process_job` cg,
			(SELECT @i := 0) AS it  WHERE {$typeStrCg} status<".CargoProcessJob::PROCESSDONE." {$this->getUserStr(true)} group by status";
		$provide=Yii::app()->db->createCommand($sql)->queryAll();
		$filteredData=$filtersForm->filter($provide);
		$dataprovider=new CArrayDataProvider($filteredData);
		$dataprovider->pagination=['pageSize' =>10,];
		$sort=new CSort();
		$sort->attributes=[
			'number'=>[
				'asc'=>'number ASC',
				'desc'=>'number DESC',
			],
			'status'=>[
				'asc'=>'status ASC',
				'desc'=>'status DESC',
			],
		];
		$sort->defaultOrder = "status ASC";
		$dataprovider->sort=$sort;
		return $dataprovider;
	}
		
