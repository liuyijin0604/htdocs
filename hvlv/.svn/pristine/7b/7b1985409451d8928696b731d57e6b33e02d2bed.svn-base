	/**
		* Return a pdf of cargo receipt for Amazon usage;
		* @param type $id the id of the shipment
	*/
	public function actionGenerateCargoReceipt($id)
	{
		$id = $_GET['id'];
		$ids = explode(CargoProcess::IP_SEPERATOR,$id);
		$sqlIds = implode($ids,",");
		$cpModels = CargoProcess::model()->findAll(" id in ({$sqlIds}) ");
		$shipmentIds = array_column($cpModels,'shipment_id');
		$shipmentModels = [];
		foreach ($cpModels as $key => $value) {
			$shipment = $value->shipment;
			if(!empty($value->mdata['caref']))
			{
				$shipment->ref = $value->mdata['caref'];
				$shipment->weight = round(($value->shipment->weight*$value->mdata['left_packages'])/$value->shipment->pkg,2);
				$shipment->pkg = $value->mdata['left_packages'];
				$shipment->mdata['total_cbm'] = $shipment->cbm*$value->mdata['left_packages'];
				$shipment->amazon_info = $value->amazon_info;
			}
			$shipmentModels[] = $shipment;
		}
		$fileName = "";
		foreach ($shipmentModels as $key => $shipmentModel) {
			$fileName .= $shipmentModel->ref.'_';
		}
		foreach ($cpModels as $key => $cpModel) {
            $cpModel->cargo_receipt = true;
            $cpModel->update('cargo_receipt');
            
        }
        //$this->render('/_pdf/cargo_receipts', ['models' => $shipmentModels]);
		if ($cpModels[0]->getCargoType()==CargoProcess::FBA_CARGO||$cpModels[0]->getCargoType()==CargoProcess::B2B_CARGO){
			oPDF::renderPDF('cargo_receipts', ['models' => $shipmentModels,'cargoType'=>$cpModels[0]->getCargoType(),''], 1, $fileName.'.pdf');
		} else {
			oPDF::renderPDF('cargo_receipts_1', ['models' => $shipmentModels,'cargoType'=>$cpModels[0]->getCargoType()], 1, $fileName.'.pdf');
		}
	}

	/**
	* notice warehouse to prepare cargos;
