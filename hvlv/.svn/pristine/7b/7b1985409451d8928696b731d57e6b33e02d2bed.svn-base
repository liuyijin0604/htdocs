	public function actionProcess()
	{
		if (empty($_GET['id'])||empty($_GET['status'])) {
			return false;
		} else {
			$process= ConsolProcess::model()->find('fid=:fid', [':fid'=>$_GET['id']]);
			$process->updateStatus($_GET['status']);
		}
		echo 'done';
		return true;
	}

	public function actionLoadCargoProcess()
	{
		$imparcels = ImParcel::model()->findAll(' (status=60||status=42) && scan_no = 0 && ref like \'ECN%\'');
		foreach ($imparcels as $key => $imparcel) {
			$imparcel->saveToCargoProcess();
		}
		echo "done";
	}

	public function actionUploadPOD($hash)
	{
		$f = $_FILES['file'];
		$filename = $f['tmp_name'];
		$name = $f['name'];
		if(!is_uploaded_file($filename)) return false;
		$hashArray = explode(CargoProcess::IP_SEPERATOR,$hash);
		$filesize = filesize($filename);
		$date = date('Y-m-d H:i:s');
		$fileHash = hash_file('crc32b', $filename).hash('crc32b', $filesize);
		$finfo = finfo_open(FILEINFO_MIME_TYPE);
		$mime = finfo_file($finfo, $f['tmp_name']);
		foreach ($hashArray as $key => $thisHash) {
			$fr = CargoProcess::updateUploadSingleFile($filesize,$date,$fileHash,$finfo,$mime,$filename,$name, $thisHash,false,true,false,true);
			$cargoProcess = CargoProcess::Model()->findByPk($fr->mdata['cargo_process_id']);
			$cargoProcess->log("uploadPOD");
			$cargoProcess->agg_pod_id = $fr->id;
			$cargoProcess->update(["agg_pod_id"]);
			if(!empty($cargoProcess->mdata['caref']))
			{
				$cargoProcess->shipment->updatePodTrackingUrl($cargoProcess->id);
			}else
			{
				$cargoProcess->shipment->updatePodTrackingUrl();
			}
		}
		echo 'DONE';
	}

	public function actionUploadPODCargoJob()
	{
		$hash = $_GET['hash'];
		$images = $this->uploadMultiFile($hash,false);
		$mainImage = $images[0];
		$cargoJob = CargoProcessJob::model()->findByPk($mainImage->fid);
		$cargoProcesses = $cargoJob->getCargoProcess();
		$hashArray = [];
		$uploadType = FileRepo::CARGOPROCESSJOBPOD;
		foreach ($cargoProcesses as $key => $cp) {
			$pphash = FileRepo::uploadHash($cp, $uploadType);
			$hashArray[] = $pphash;
		}


		$f = $_FILES['file'];
		$filename = $f['tmp_name'];
		$name = $f['name'];
		if(!is_uploaded_file($filename)) return false;
		$filesize = filesize($filename);
		$date = date('Y-m-d H:i:s');
		$fileHash = hash_file('crc32b', $filename).hash('crc32b', $filesize);
		$finfo = finfo_open(FILEINFO_MIME_TYPE);
		$mime = finfo_file($finfo, $f['tmp_name']);
		foreach ($hashArray as $key => $thisHash) {
			$fr = CargoProcess::updateUploadSingleFile($filesize,$date,$fileHash,$finfo,$mime,$filename,$name, $thisHash,false,true,false,true);
			$cargoProcess = CargoProcess::Model()->findByPk($fr->mdata['cargo_process_id']);
			$cargoProcess->log("uploadPOD");
			$cargoProcess->agg_pod_id = $fr->id;
			$cargoProcess->update(["agg_pod_id"]);
			if(!empty($cargoProcess->mdata['caref']))
			{
				$cargoProcess->shipment->updatePodTrackingUrl($cargoProcess->id);
			}else
			{
				$cargoProcess->shipment->updatePodTrackingUrl();
			}
		}
		echo 'DONE';
	}

	public function actionUpdate()
	{
		$id = $_GET["id"];
		if(strpos($id,CargoProcess::IP_SEPERATOR))
		{
			$ids = explode(CargoProcess::IP_SEPERATOR,$id);
			$result['ids'] = $id;
			foreach ($ids as $key => $thisId) 
			{
				$this->updateCargoProcess($thisId);
			}
		}else
		{
			$this->updateCargoProcess($id);
		}
		echo "done";
	}

	public function actionAssignUser()
	{
		Yii::import('application.controllers.GatepassController');
		$id = $_GET["id"];
		$_GET["assignedUser"]=1;
		$user_id = $_GET["user_id"];
		$model = $this->loadModel($id);

		if(strpos($id,CargoProcess::IP_SEPERATOR)||$model->getCargoType()==CargoProcess::FBA_CARGO)
		{
			echo "can't assign user to FBA";
			return;
		}else
		{
			$model->assignUser($user_id);
		}
		echo "done";
	}

	private function updateCargoProcess($id)
	{

		$model= CargoProcess::model()->findByPk($id);
		if(isset($_POST["driver_id"]))
		{
			$model->driver_id = $_POST["driver_id"];
		}
		if(isset($_POST["dpt_id"]))
		{
			$model->dpt_id = $_POST["dpt_id"];
		}
		if(isset($_POST["note"]))
		{
			$model->note = $_POST["note"];
		}
		if(isset($_POST["job_pallet_no"]))
		{
			$model->mdata['job_pallet_no'] = $_POST["job_pallet_no"];
		}
		if(isset($_POST["inputcost"]))
		{
			$model->mdata['inputcost'] = $_POST["inputcost"];
		}
		if(isset($_POST["forklift"]))
		{
			$model->mdata["custconfirmforklift"] = $_POST["forklift"];
		}
		if(isset($_POST["inputcostinterstate"]))
		{
			$model->mdata['inputcostinterstate'] = $_POST["inputcostinterstate"];
		}
		if(isset($_POST["interstateotno"]))
		{
			$model->mdata['interstateotno'] = $_POST["interstateotno"];
		}
		if(isset($_POST["interstatechargecode"]))
		{
			$model->mdata['interstatechargecode'] = $_POST["interstatechargecode"];
			$model->shipment->mdata['interstatechargecode'] = $_POST["interstatechargecode"];
			$model->shipment->save();
		}
		if(isset($_POST["third_part_label_no"]))
		{
			$model->mdata['third_part_label_no'] = $_POST["third_part_label_no"];
		}
		if(isset($_POST["need_invoice"]))
		{
			$model->mdata['need_invoice'] = $_POST["need_invoice"];
		}

		if(isset($_POST["cargo_type"]))
		{
			$model->type = $_POST["cargo_type"];
		}

		if(isset($_POST["pallet"]))
		{
			//$model->mdata['pallet'] = $_POST["pallet"];
			//$model->shipment->mdata['amzon_pallet']=$_POST["pallet"];
		}

		if(isset($_POST["CargoDeliveryInfo"]))
		{
			if($model->isNotSub())
			{
				$model->saveNormalDeliveryInfo($_POST['CargoDeliveryInfo']['delivery_booking_time']);
				$model->copyAmazonAndCargoDeliveryInfo(1);
			}else
			{
				$model->saveNormalDeliveryInfo($_POST['CargoDeliveryInfo']['delivery_booking_time']);
			}
		}

		if(isset($_POST["ImParcel"]["pickup_booking_time"]))
		{
			if(empty($_POST["ImParcel"]["pickup_booking_time"]))
			{
				$model->shipment->mdata['pickup_booking_time'] = '';
			}else
			{
				$model->shipment->mdata['pickup_booking_time'] = $_POST["ImParcel"]["pickup_booking_time"];
			}
			$model->shipment->updateMeta();
		}

		if(isset($_POST['AmazonInfo']['booking_ref']))
		{
			if (!empty($_POST['AmazonInfo']['booking_ref'])) 
			{
				// if($model->isNotSub())
				// {
				// 	$obj = $model->shipment;
				// }else
				// {
					$obj = $model;
				// }
				$amazonInfo=$obj->getAmazonInfo();
				$amazonInfo->booking_ref=$_POST['AmazonInfo']['booking_ref'];
				$date = !empty($_POST['AmazonInfo']['amazon_booking_time'])?$_POST['AmazonInfo']['amazon_booking_time']:null;
				if (!empty($_POST['AmazonInfo']['amazon_booking_time'])||!empty($amazonInfo->amazon_booking_time)) {
					$amazonInfo->amazon_booking_time=$date;
					$obj->mdata['amazon_booking_time']=$date;
					$obj->mdata['booking_ref']=$_POST['AmazonInfo']['booking_ref'];
					if ($obj->shipment->status<90) 
					{
						$obj->updateAmazonBookingTime();
					}
				}
				$amazonInfo->save();
				$obj->update(['meta']);
				if($model->isNotSub())
				{
					$model->copyAmazonAndCargoDeliveryInfo(1);
				}
			}

			$amazonDeleteType = 0;
			if (empty($_POST['AmazonInfo']['booking_ref'])&&(!empty($obj->amazon_info->booking_ref))) {
				$amazonDeleteType += 1;
			}
			
			if (empty($_POST['AmazonInfo']['amazon_booking_time'])&&(!empty($obj->amazon_info->amazon_booking_time))) {
				$amazonDeleteType += 2;
			}

			if($amazonDeleteType>0)
			{
				if($amazonDeleteType>=1&&$amazonDeleteType!=2)
				{
					$obj->amazon_info->booking_ref='';
					$obj->mdata['booking_ref']='';
				}

				if($amazonDeleteType>=2)
				{
					$obj->amazon_info->booking_ref='';
					$obj->mdata['amazon_booking_time']='';
					$obj->amazon_info->amazon_booking_time = null;
				}

				$obj->amazon_info->save();
				$obj->update(['meta']);
			}
		}

		$model->save();

		if(isset($_POST["pallet"])&&is_numeric($_POST["pallet"]))
		{
			self::updateShipmentPallets($model);
		}
	}

	private static function updateShipmentPallets($cargoModel){
		$numPalletsTotal = 0;
		$cargoProcessModels = CargoProcess::model()->findAll('shipment_id = :shipment_id and status !=100',[':shipment_id'=>$cargoModel->shipment_id]);
		foreach($cargoProcessModels as $cargoProcessModel){
			$numPalletsTotal += $cargoProcessModel->mdata['job_pallet_no'];
		}
		if($numPalletsTotal>0){
			$cargoModel->shipment->mdata['amzon_pallet']=$numPalletsTotal;
			$cargoModel->shipment->updateMeta();
		}
	}

	public function actionTypeList()
	{
		$filtersForm=new FiltersForm;
		$filtersForm1=new FiltersForm1;
		$dpt_id=isset($_GET['pod_id'])?$_GET['pod_id']:-1;
		if (isset($_GET['FiltersForm'])) {
			$filtersForm->filters=$_GET['FiltersForm'];
		}
		if (isset($_GET['FiltersForm1'])) {
			$filtersForm1->filters=$_GET['FiltersForm1'];
		}
		$joinSql = $this->joinSql;
		$sql="";
		$provide=[];
		$pod = SystemSetting::getCargoProcessPodSetting($dpt_id);
		$strState = Org::model()->findByPk($dpt_id)->state;
		$state = @$pod["postcode"];
		$selectStateStr = "postcode like ";
		$sql ="";
		if(empty($state))
		{
			$state = @$pod["state"];
			$selectStateStr = "state = ";
		}

		$state = "'".$state."'";

		$sql="SELECT (@i :=@i + 1) AS id,cg.status,count(*) as number, (SELECT count(*) FROM `cargo_process` c {$joinSql} WHERE DATEDIFF(NOW(),date)<=1 and c.status=cg.status and  ((c.type in (1,2) and 
(c.dpt_id = {$dpt_id} or json_value(c.meta,'$.goods_state') = {$state})) ) {$this->getUserStr()} ) as day1
			, (SELECT count(*) FROM `cargo_process` c {$joinSql} WHERE DATEDIFF(NOW(),date)<3 and DATEDIFF(NOW(),date)>1 and c.status=cg.status and ((c.type in (1,2) and 
(c.dpt_id = {$dpt_id} or json_value(c.meta,'$.goods_state') = {$state})) ) {$this->getUserStr()} ) as day2
			, (SELECT count(*) FROM `cargo_process` c {$joinSql} 
			WHERE DATEDIFF(NOW(),date)>=3 and c.status=cg.status and ((c.type in (1,2) and 
(c.dpt_id = {$dpt_id} or json_value(c.meta,'$.goods_state') = {$state})) ) {$this->getUserStr()} ) as day3
			FROM (SELECT @i := 0) AS it ,`cargo_process` cg JOIN `shipment` s ON cg.shipment_id=s.id join `addr` ad on s.cnee_id = ad.id
			 WHERE cg.status<".CargoProcess::PROCESSDONE." and ((cg.type in (1,2) and s.status<100 and (cg.dpt_id = {$dpt_id} or json_value(cg.meta,'$.goods_state') = {$state})) ) {$this->getUserStr(true)} group by cg.status";


		$intetstateReceiveSql = "SELECT * FROM `cargo_process` cg JOIN `shipment` s ON cg.shipment_id=s.id join `addr` ad on s.cnee_id = ad.id
		WHERE cg.status<".CargoProcess::PROCESSDONE." and s.status<100 and ad.state = '".$strState."' and cg.type = 6";
		$numberInterstateProvide = Yii::app()->db->createCommand($intetstateReceiveSql)->queryAll();
		$numReceiveInterstate = count($numberInterstateProvide);

		$numberSql="SELECT count(1) as number,cg.type FROM `cargo_process` cg JOIN `shipment` s ON cg.shipment_id=s.id join `addr` ad on s.cnee_id = ad.id
			 WHERE cg.status<".CargoProcess::PROCESSDONE." and s.status<100 and (cg.dpt_id = {$dpt_id} or json_value(cg.meta,'$.goods_state') = {$state}) {$this->getUserStr(true)} group by cg.type";
		$numberProvide = Yii::app()->db->createCommand($numberSql)->queryAll();

		$number = [1=>0,2=>0,4=>0,3=>0,5=>0,6=>0];
		foreach ($numberProvide as $key => $value) {
			$number[$value['type']] = $value["number"];
		}
		$bookings = CargoBooking::model()->findAllByAttributes(['status'=>2, 'depot'=>$dpt_id]);
		$number[8] = count($bookings);
		$provide3=Yii::app()->db->createCommand($sql)->queryAll();
		$filteredData3=$filtersForm1->filter($provide3);
		$dataprovider3=new CArrayDataProvider($filteredData3);
		$dataprovider3->pagination=['pageSize' =>10,];
		$sort=new CSort();
		$sort->attributes=[
			'number'=>[
				'asc'=>'number ASC',
				'desc'=>'number DESC',
			],
			'status'=>[
				'asc'=>'status ASC',
				'desc'=>'status DESC',
			],
		];
		$sort->defaultOrder = "status ASC";
		$dataprovider3->sort=$sort;
		$provide=[];
		$list=Org::dptList();
		$name=isset($list[$dpt_id])?$list[$dpt_id]:"";
		$provide[]=['id'=>5,'name'=>'Not Assign('.$number[5].")",'type'=>5,'url'=>'topCourierService/palletList','pod'=>$pod["pod"]];
		$provide[]=['id'=>8,'name'=>'Booking('.$number[8].')','type'=>8,'url'=>'cargoBooking/admin','pod'=>$pod['pod']];
		$provide[]=['id'=>1,'name'=>'Normal('.$number[1].")",'type'=>1,'url'=>'topCourierService/cargoList','pod'=>$pod["pod"]];
		$provide[]=['id'=>2,'name'=>'FBA('.$number[2].")",'type'=>2,'url'=>'topCourierService/fbaList','pod'=>$pod["pod"]];
		$provide[]=['id'=>4,'name'=>'B2B('.$number[4].")",'type'=>4,'url'=>'topCourierService/b2bList','pod'=>$pod["pod"]];
		//$provide[]=['id'=>6,'name'=>'PRE B2B('.$number[7].")",'type'=>7,'url'=>'topCourierService/preB2bList','pod'=>$pod["pod"]];
		$provide[]=['id'=>7,'name'=>'Interstate('.$number[6]."-".$numReceiveInterstate.")",'type'=>6,'url'=>'topCourierService/interstateList','pod'=>$pod["pod"]];
		//$provide[]=['id'=>5,'name'=>'Pallet('.$number[5].")",'type'=>5,'url'=>'topCourierService/palletList','pod'=>$pod["pod"]];
		//$provide[]=['id'=>3,'name'=>'pickup('.$number[3].")",'type'=>3,'url'=>'topCourierService/pickupList','pod'=>$pod["pod"]];

		$filteredData=$filtersForm->filter($provide);
		$dataprovider=new CArrayDataProvider($filteredData);
		$dataprovider->pagination=['pageSize' =>10];
		$sort=new CSort();
		$sort->attributes=[
			'number'=>[
				'asc'=>'number ASC',
				'desc'=>'number DESC',
			],
			'status'=>[
				'asc'=>'status ASC',
				'desc'=>'status DESC',
			],
		];
		$sort->defaultOrder = "status ASC";
		$dataprovider->sort=$sort;
		$this->render('sub_type_list', ['dataProvider2'=>[$dataprovider,$filtersForm],'dataProvider3'=>[$dataprovider3,$filtersForm1],'name'=>$name]);
	}

	public function actionJobTypeList()
	{
		$filtersForm=new FiltersForm;
		$filtersForm1=new FiltersForm1;
		$dpt_id=isset($_GET['pod_id'])?$_GET['pod_id']:-1;
		if (isset($_GET['FiltersForm'])) {
			$filtersForm->filters=$_GET['FiltersForm'];
		}
		if (isset($_GET['FiltersForm1'])) {
			$filtersForm1->filters=$_GET['FiltersForm1'];
		}
		$joinSql = $this->joinSql;
		$sql="";
		$provide=[];
		$pod = SystemSetting::getCargoProcessPodSetting($dpt_id);
		$sql ="";
		$sql="SELECT (@i :=@i + 1) AS id,status,count(*) as number, (SELECT count(*) FROM `cargo_process_job` c WHERE DATEDIFF(NOW(),created)<=1 and c.status=cg.status {$this->getUserStr()} and dpt_id = {$dpt_id}) as day1
			, (SELECT count(*) FROM `cargo_process_job` c WHERE DATEDIFF(NOW(),created)<3 and DATEDIFF(NOW(),created)>1 and c.status=cg.status {$this->getUserStr()} and dpt_id = {$dpt_id}) as day2
			, (SELECT count(*) FROM `cargo_process_job` c WHERE DATEDIFF(NOW(),created)>=3 and c.status=cg.status {$this->getUserStr()} and dpt_id = {$dpt_id}) as day3
			FROM `cargo_process_job` cg,
			(SELECT @i := 0) AS it  WHERE  status<".CargoProcessJob::PROCESSDONE." {$this->getUserStr(true)} and dpt_id = {$dpt_id} group by status";

		$intetstateReceiveSql = "SELECT * FROM `cargo_process_job` cg WHERE cg.status<".CargoProcessJob::PROCESSDONE." and json_value(cg.meta,'$.destination') = {$dpt_id}";
		$numberInterstateProvide = Yii::app()->db->createCommand($intetstateReceiveSql)->queryAll();
		$numReceiveInterstate = count($numberInterstateProvide);


		$numberSql="SELECT count(1) as number,cg.type FROM `cargo_process_job` cg WHERE cg.status<".CargoProcessJob::PROCESSDONE." and cg.dpt_id = {$dpt_id} {$this->getUserStr(true)} group by cg.type";
		$numberProvide = Yii::app()->db->createCommand($numberSql)->queryAll();
		$number = [1=>0,2=>0,4=>0,3=>0,5=>0,6=>0];
		foreach ($numberProvide as $key => $value) {
			$number[$value['type']] = $value["number"];
		}
		$provide3=Yii::app()->db->createCommand($sql)->queryAll();
		$filteredData3=$filtersForm1->filter($provide3);
		$dataprovider3=new CArrayDataProvider($filteredData3);
		$dataprovider3->pagination=['pageSize' =>10,];
		$sort=new CSort();
		$sort->attributes=[
			'number'=>[
				'asc'=>'number ASC',
				'desc'=>'number DESC',
			],
			'status'=>[
				'asc'=>'status ASC',
				'desc'=>'status DESC',
			],
		];
		$sort->defaultOrder = "status ASC";
		$dataprovider3->sort=$sort;
		$provide=[];
		$list=Org::dptList();
		$name=isset($list[$dpt_id])?$list[$dpt_id]:"";
		$provide[]=['id'=>1,'name'=>'Normal('.$number[1].")",'type'=>1,'url'=>'topCourierService/cargoJobList','pod'=>$pod["pod"]];
		$provide[]=['id'=>2,'name'=>'FBA('.$number[2].")",'type'=>2,'url'=>'topCourierService/fbaJobList','pod'=>$pod["pod"]];
		$provide[]=['id'=>4,'name'=>'B2B('.$number[4].")",'type'=>4,'url'=>'topCourierService/b2bJobList','pod'=>$pod["pod"]];
		$provide[]=['id'=>5,'name'=>'Pallet('.$number[5].")",'type'=>5,'url'=>'topCourierService/palletJobList','pod'=>$pod["pod"]];
		$provide[]=['id'=>7,'name'=>'Interstate('.$number[6]."-".$numReceiveInterstate.")",'type'=>6,'url'=>'topCourierService/interstateJobList','pod'=>$pod["pod"]];
		// $provide[]=['id'=>3,'name'=>'pickup('.$number[3].")",'type'=>3,'url'=>'topCourierService/pickupList','pod'=>$pod["pod"]];

		$filteredData=$filtersForm->filter($provide);
		$dataprovider=new CArrayDataProvider($filteredData);
		$dataprovider->pagination=['pageSize' =>10];
		$sort=new CSort();
		$sort->attributes=[
			'number'=>[
				'asc'=>'number ASC',
				'desc'=>'number DESC',
			],
			'status'=>[
				'asc'=>'status ASC',
				'desc'=>'status DESC',
			],
		];
		$sort->defaultOrder = "status ASC";
		$dataprovider->sort=$sort;
		$this->render('sub_job_type_list', ['dataProvider2'=>[$dataprovider,$filtersForm],'dataProvider3'=>[$dataprovider3,$filtersForm1],'name'=>$name]);
	}

	
