	public function actionIndex()
	{
		$filtersForm1=new FiltersForm1;
		$filtersForm=new FiltersForm;
		if (isset($_GET['FiltersForm'])) {
			$filtersForm->filters=$_GET['FiltersForm'];
		}
		if (isset($_GET['FiltersForm1'])) {
			$filtersForm1->filters=$_GET['FiltersForm1'];
		}

		$dataprovider = $this->getOverviewReport($filtersForm);
		$provide1=SystemSetting::getCargoProcessPodSetting();
		$dataprovider2=new CArrayDataProvider([]);
		$filterData1=$filtersForm1->filter($provide1);
		$dataprovider1=new CArrayDataProvider($filterData1);
		$dataprovider1->pagination=['pageSize'=>10];
		$sort=new CSort();
		$sort->defaultOrder = "pod";
		$dataprovider1->sort=$sort;
		$this->render('index', ['dataProvider1'=>[$dataprovider1,$filtersForm1],'dataProvider'=>[$dataprovider,$filtersForm],'dataProvider2'=>[$dataprovider2,$filtersForm],'dataProvider3'=>[$dataprovider2,$filtersForm1],'name'=>'Select The pod!']);
	}


	public function actionIndexJob()
	{
		$filtersForm1=new FiltersForm1;
