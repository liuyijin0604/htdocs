	private function uploadMultiFile($hash,$isUpdate=true)
	{
		$f = $_FILES['file'];
		$filename = $f['tmp_name'];
		$name = $f['name'];
		if(!is_uploaded_file($filename)) return false;
		$hashArray = explode(CargoProcess::IP_SEPERATOR,$hash);
		$filesize = filesize($filename);
		$date = date('Y-m-d H:i:s');
		$fileHash = hash_file('crc32b', $filename).hash('crc32b', $filesize);
		$finfo = finfo_open(FILEINFO_MIME_TYPE);
		$mime = finfo_file($finfo, $filename);
		$images = [];
		foreach ($hashArray as $key => $thisHash) {
			$fr =CargoProcess::updateUploadSingleFile($filesize,$date,$fileHash,$finfo,$mime,$filename,$name,$thisHash);
			$images[] = $fr;
			if($isUpdate)$this->updateAggPodId($fr);
		}
		return $images;
	}


	private function updateAggPodId($fr)
	{
		$cargoProcess = CargoProcess::Model()->findByPk($fr->fid);
		$cargoProcess->agg_pod_id = $fr->id;
		$cargoProcess->update(["agg_pod_id"]);
	}

	public function actionUploadSignatureFile($hash)
	{
		/*get signature file*/
		$images = $this->uploadMultiFile($hash,false);

		foreach ($images as $key => $image) {
			$thisModel = $this->loadModel($image->fid);
			$thisModel->log("uploadSignatureFile");
			$shipmentModel = $thisModel->shipment;
			$filename = $shipmentModel->id."pod";
			$pdfPath = "";
			/* combine the signature file to the template to be pdfs*/
			if ($thisModel->type == CargoProcess::FBA_CARGO||$thisModel->type == CargoProcess::B2B_CARGO) {
				$pdfPath = oPDF::renderPDF('cargo_receipt', ['model' => $shipmentModel,'image'=>$image], 2, $filename.'.pdf');
			} else {
				$pdfPath = oPDF::renderPDF('cargo_receipt_1', ['model' => $shipmentModel,'image'=>$image], 2, $filename.'.pdf');
			}
			echo Yii::app()->request->hostInfo.Yii::app()->baseUrl."/filerepo/".$image->hash."/".$image->name;

			/*upload pdfs to every shipment*/
			$uploadType = 25;
			$pphash = FileRepo::uploadHash($shipmentModel, $uploadType);
			$filesize = filesize($pdfPath);
			$date = date('Y-m-d H:i:s');
			$filename = $filename.".pdf";
			$name= "pod.pdf";
			$fileHash = hash_file('crc32b', $pdfPath).hash('crc32b', $filesize);
			$finfo = finfo_open(FILEINFO_MIME_TYPE);
			$mime = finfo_file($finfo, $pdfPath);
			$cargoProcess =CargoProcess::model()->findByPk($image->fid);
			if(!empty($cargoProcess->mdata['caref']))
			{
				echo $cargoProcess->id;
				$fr = CargoProcess::updateUploadSingleFile($filesize,$date,$fileHash,$finfo,$mime,$pdfPath,$name,$pphash,true,false,$cargoProcess->id);
			}else
			{
				$fr = CargoProcess::updateUploadSingleFile($filesize,$date,$fileHash,$finfo,$mime,$pdfPath,$name,$pphash,true);
			}
		}

		echo 'DONE';
	}

