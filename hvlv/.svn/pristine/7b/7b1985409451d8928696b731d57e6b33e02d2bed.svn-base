	public function actionupdateJobPallet(){
		$id = $_POST['id'];
		$numPallets = $_POST['numpallet'];
		$numCost = $_POST['costforCjob'];
		$num_P1 = $_POST['num_P1'];
		$num_P2 = $_POST['num_P2'];
		$num_14P = $_POST['num_14P'];
		$num_SEMI = $_POST['num_SEMI'];
		$num_BW = $_POST['num_BW'];
		//$thirdLabelNo = $_POST['thirdpartlabel'];

		$model= CargoProcessJob::model()->findByPk($id);
		if(!empty($model)){
			$model->mdata['total_job_pallet_no'] = $numPallets;
			$model->mdata['total_job_input_cost'] = $numCost;
			$model->mdata['num_P1'] = $num_P1;
			$model->mdata['num_P2'] = $num_P2;
			$model->mdata['num_14P'] = $num_14P;
			$model->mdata['num_SEMI'] = $num_SEMI;
			$model->mdata['num_BW'] = $num_BW;
			//$model->mdata['third_part_label_no'] = $thirdLabelNo;
			if($model->save()){
				echo json_encode([
					'isSuccess' => true,
				]);
				return;
			}
		}
		echo json_encode([
			'isSuccess' => false,
		]);
		return;
	}
	

	public function actionAssignDriverDone()
	{
		$id = $_GET['id'];
		$ids = explode(CargoProcess::IP_SEPERATOR,$id);
		foreach ($ids as $key => $thisId) 
		{
			$model=$this->loadModel($thisId);
			if($model->status==CargoProcess::WAITINGASSIGNDRIVER)
			{
				$model->updateStatus(CargoProcess::PAPERWORK);
			}else if($model->status==CargoProcess::AGENTWAITINGASSIGNDRIVER)
			{
				$model->shipment->saveTracking(80, "Assigned driver", empty($model->shipment->ddepot) ? '' : $model->shipment->ddepot->suburb, date('Y-m-d h:i:s', time()));
				$model->updateStatus(CargoProcess::WAITINGAGENTDELIVERY);
			}
		}
		echo 'done';
	}


