	public function actionExportCargoProcessJobReport(){
		if (empty($_POST)) {
			$this->render('cargo_process_time_pick',array('type'=>"cargoprocessjob"));
		} else {
			$startDate = $_POST['startdate'];
			$endDate = $_POST['enddate'];

			$objCargoProcessJobs = CargoProcessJob::model()->findAll(
														array(
															'condition'=>'created>=:startday and created <=:endday and dpt_id = 106 and type = 1',
															'params' => array(":startday"=>$startDate,":endday"=>$endDate),
															'order' => 'created',
													));
			$xls = new oExcel;
			$i = 1;
			$xls->setColWidth([20,20,10,15,15]);
			$xls->addRow($i++, ['Job Name','Effective Date','Driver','Capacity[CBM]','Capacity[Count]']);
			foreach($objCargoProcessJobs as $objCargoProcessJob){
				if(!empty($objCargoProcessJob->job_relations)){
					$objVehicle = CargoProcessVehicle::model()->findByPk($objCargoProcessJob->vehicle_id);
					$xls->addRow($i++, [$objCargoProcessJob->job_name,$objCargoProcessJob->created,$objVehicle->vehicle_name,$objCargoProcessJob->getAvailableCBMString(),$objCargoProcessJob->getAvailableCountString()]);
				}
			}
			$xls->output('CargoProcessJob Report ' . date("Y-m-d H:i:s") . '.xlsx');
			
		}
	}

	public function actionExportCargoProcessReport(){
		if (empty($_POST)) {
			$this->render('cargo_process_time_pick',array('type'=>"cargoprocess"));
		} else {
			$startDate = $_POST['startdate'];
			$endDate = $_POST['enddate'];
			//$dateNow = date("Y-m-d",strtotime("now"));
			//$dateWeekDayOne = date('Y-m-d', (time() - ((date('w') == 0 ? 7 : date('w')) - 1) * 24 * 3600));
	
			$objCargoProcesses = CargoProcess::model()->findAll(
													array(
														'condition' => 'started >= :startday and started <= :endday and dpt_id = 106 and type = 1',
														'params'    => array(":startday"=>$startDate,":endday"=>$endDate),
														'order' => 'started',
													));
	
			$xls = new oExcel;
			$i = 1;
			$isAdded=0;
			foreach($objCargoProcesses as $objCargoProcess){
				$numWeekday=date("w",strtotime($objCargoProcess->started));
				if($numWeekday>$isAdded){
					$isAdded = $numWeekday;
					$xls->mergeCells('A'.$i.':I'.$i);
					$xls->addRow($i++, [date("Y-m-d",strtotime($objCargoProcess->started))]);
					$xls->addRow($i++, ['Connote','Ref','Region','Suburb','Postcode','Distance','Weight','CBM','Job Date','Time Difference']);
				}
	
				if(!empty($objCargoProcess->shipment->status)&&$objCargoProcess->shipment->status!=100){
					$dataConnote = $objCargoProcess->getHbn();
					$dataRef = $objCargoProcess->getRef();
					$dataRegion = $objCargoProcess->shipment->getRegion();
					$dataSuburb = $objCargoProcess->shipment->cnee->suburb;
					$dataPostcode = $objCargoProcess->shipment->cnee->postcode;
					$dataDistance = $objCargoProcess->shipment->getDeliveryDistance();
					$dataWeight = $objCargoProcess->shipment->weight;
					$dataCbm = $objCargoProcess->shipment->cbm;
					$dataJobCreated = "";
					$dataDateDifference = "";
					$dataCost = 0;
					$dataRevenul = 0;
					$costRate = OrgRate::model()->findByPk(70);
					$dataCost = round(ImcoConsol::getCourierCostPrice($costRate, $dataPostcode, $dataWeight,1,"",$dataSuburb),2);
					//$dataSurcharge = round(WmsTask::model()->deliveryTaskSurCharge(114,$wmsLength,$wmsWidth,$wmsHeight,$floatWeight),2);
	
					$objCargoProcessJobRelation = CargoProcessJobRelations::model()->find('cargo_process_id=:cId and active = 1',[":cId"=>$objCargoProcess->id]);
					if(!empty($objCargoProcessJobRelation)){
						$dataJobCreated = $objCargoProcessJobRelation->job->created;
						$dataDateDifference = strtotime($objCargoProcessJobRelation->job->created) - strtotime($objCargoProcess->started);
						$dataDateDifference = round($dataDateDifference / (60 * 60 * 24));
					}
					$xls->addRow($i++,[$dataConnote,$dataRef,$dataRegion,$dataSuburb,$dataPostcode,$dataDistance,$dataWeight,$dataCbm,$dataJobCreated,$dataDateDifference]);
				}
			}
			$xls->output('CargoProcess Report ' . date("Y-m-d H:i:s") . '.xlsx');
		}

	}

	public function actionExportWithFee()
	{
		$cargo=new CargoProcess('search');
		$cargo->unsetAttributes();

		if(!empty($_GET['CargoProcess']))
		{
			$cargo->setAttributes($_GET['CargoProcess']);
			if(isset($_GET['CargoProcess']['assignedUser']))
			{
				$cargo->assignedUser = $_GET['CargoProcess']['assignedUser'];
			}
			if(isset($_GET['CargoProcess']['driver_id']))
			{
				$cargo->driver_id = $_GET['CargoProcess']['driver_id'];
			}
			if(isset($_GET['ImParcel']['consol_no']))
			{
				$cargo->consol_no = $_GET['ImParcel']['consol_no'];
			}
		}

		if(isset($_GET['status']))
		{
			$cargo->status = $_GET['status'];
		}

		$dp = $cargo->search(false, false,false,true,$_GET['pod_id'],$_GET['typ']);
		$sheets = [];
		$allData = $dp->data;
		$xls = new oExcel;
		$i = 0;
		$j = 1;
		$xls->addRow($j++, ['序号', '柜号', 'SKP号码', 'postcode', '所属区域', '重量', '体积', '常规收费', '是否有oversize(任何单边超过1.2米)','chargecode','job_pallet_no']);
		foreach ($allData as $key => $cargo) {
			$p = $cargo->shipment;
			$containerNo = empty($p->consol)?"":(empty($p->consol->mdata['container_no'])?$p->consol->awb:$p->consol->mdata['container_no']);
			$result=$cargo->shipment->getChargeByChargecode('',false,null,true,false,true);
			$zone = "";
			if(!empty($result['rate'])&&is_object($result['rate']))
			{
				$zone = $result['rate']->zone;
			}
			$chargecode = @$p->mdata['chargecode'];
			$index = $j;
			$xls->addRow($j++, [$key+1,$containerNo,$p->ref,$p->postcode,$zone,$p->weight,$p->getTotalCBM(),$result['amount'],(empty($p->isOversize())?"No":"Yes"),$chargecode,@$cargo->mdata["job_pallet_no"]]);
			$xls->setNumber('F'.$index.':H'.$index);
		}

		$xls->output('cargo_process_with_fee_export'.time().'.xlsx');
	}

	public function actionExportAgent()
	{
		$cargo=new CargoProcess('search');
		$cargo->unsetAttributes();

		if(!empty($_GET['CargoProcess']))
		{
			$cargo->setAttributes($_GET['CargoProcess']);
			if(isset($_GET['CargoProcess']['assignedUser']))
			{
				$cargo->assignedUser = $_GET['CargoProcess']['assignedUser'];
			}
			if(isset($_GET['CargoProcess']['driver_id']))
			{
				$cargo->driver_id = $_GET['CargoProcess']['driver_id'];
			}
			if(isset($_GET['ImParcel']['consol_no']))
			{
				$cargo->consol_no = $_GET['ImParcel']['consol_no'];
			}
		}

		if(isset($_GET['status']))
		{
			$cargo->status = $_GET['status'];
		}

		$dp = $cargo->search(false, false,false,true,$_GET['pod_id'],$_GET['typ']);
		$sheets = [];
		$allData = $dp->data;
		foreach ($allData as $key => $data) {
			$date = date("Y-m",strtotime($data->logs[0]->time));
			if(!empty($sheets[$date]))
			{
				$sheets[$date][]=$data;
			}else
			{
				$sheets[$date]=[$data];
			}
		}
		$xls = new oExcel;
		$i = 0;
		foreach ($sheets as $key => $datas) {
			if($i!=0)
			{
				$xls->createSheet($key);
				$xls->goSheet($i);
			}else
			{
				$xls->setTitle($key);
			}
			$xls->setColWidthString(['A'=>12,'B'=>12,'C'=>12,'D'=>24,'E'=>24,'F'=>12,'G'=>12,'H'=>12,'I'=>12,'J'=>12,'K'=>12,'L'=>12,'M'=>12,'N'=>24,'O'=>12,'P'=>12,'Q'=>12,'R'=>12,'S'=>12,'T'=>12,'U'=>12,'V'=>12,'W'=>12,'X'=>12,'Y'=>12]);
			$j = 1;
			$xls->addRow($j++, ['货物信息', '', '', '', '', '', '', '', '', '', '', '', '', '', '', '', '', '', '', '', '', '派送信息', '','','']);
			$xls->mergeCells('A1:U1');
			$xls->mergeCells('V1:Y1');
			$xls->addRow($j++, ['序号', '登记日期', '区域', '单号', '重量', '实际尺寸', '体积', 'size diff', '超尺寸备注', '件数', '托拍数量', '货主', '地址', 'Suburb', '邮编', '联系人', '电话', '距离km', 'region', '位置', '备注', '承运单位', '派送时间','Note','进度备注','Job Pallet No']);
			foreach ($datas as $key => $cargo) {
				$p = $cargo->shipment;
				$myRegion = $cargo->getRegion($_GET['pod_id']);
				$distance = GoogleMapAPI::getDistance($p);
				if($distance<=30)
				{
					$region = $cargo->getPodName()."-"."1";
				}else if($distance>30 and $distance<=60)
				{
					$region = $cargo->getPodName()."-"."2";
				}elseif($distance>60 and $distance<=90)
				{
					$region = $cargo->getPodName()."-"."3";
				}else
				{
					$region = $cargo->getPodName()."-"."other";
				}
				$xls->addRow($j++, [$key+1,$cargo->getFirstTime(),$cargo->getPodName(),$p->hbn,$p->weight,'',$p->getTotalCBM(),'','',$p->pkg,$p->mdata['amzon_pallet'],$p->agent->name,$p->cnee->address,$p->cnee->suburb,$p->cnee->postcode,$p->cnee->name,$p->cnee->tel,$distance,$region,$myRegion,'','','','','','',@$cargo->mdata["job_pallet_no"]]);
			}
			$xls->centerAlignment('A1:U1');
			$xls->centerAlignment('V1:Y1');

			$i++;
		}
		$xls->output('cargo_process_agent_export'.time().'.xlsx');
	}

	public function actionSendNormalCargoSmsEmail()
	{
		$id = $_GET["id"];
		$model = $this->loadModel($id);
		$emailService = new EmailService();
		$result = $emailService->sendNormalCargoSmsEmail($model);
		if($result===True)
		{
			echo "done";
		}else
		{
			echo $result;
		}
		return;
	}

	public function actionExportAmazonInfo()
	{
		$id = $_GET["ids"];
		if(strpos($id,CargoProcess::IP_SEPERATOR))
		{
			$xls = new oExcel;
			$i = 1;
			$xls->addRow($i++, ['Amazon PO#', 'Amazon Shipment Id']);
			$ids = explode(CargoProcess::IP_SEPERATOR,$id);
			$result['ids'] = $id;
			$apos = [];
			$aids = [];
			foreach ($ids as $key => $thisId) 
			{
				$cargoProcess = CargoProcess::model()->findByPk($thisId);
				$amazon_po = $cargoProcess->shipment->mdata['amazon_po'];
				$thisPos = preg_split('/[.,;]+/', trim($amazon_po));
				$apos = array_merge($apos,$thisPos);
				$amazon_shipment_ids = $cargoProcess->shipment->mdata['amazon_shipment_ids'];
				$thisIds = preg_split('/[.,;]+/', trim($amazon_shipment_ids));
				$aids = array_merge($aids,$thisIds);
			}
			$xls->addRow($i++, [join(",",$apos),join(",",$aids)]);
			$xls->output('imp_export_amazon_info'.time().'.xlsx');
		}
		echo "done";
	}

	public function actionFbaReport()
	{
		if(!empty($_GET['type']))
		{
			$type = $_GET['type'];
			$ddptId = $_GET['wid'];
			$swid =  $_GET['swid'];
			$dateto = '';
			if(!empty($_GET['dateto']))
			{
				$dateto = $_GET['dateto'];
			}
			if($type==4 &&!empty($_GET['datefrom']))
			{
				$datefrom = $_GET['datefrom'];
			}else
			{
				$datefrom = date('Y-m-d');
			}
			$filtersForm = new FiltersForm();
			$reportService = new ReportService();
			if(!empty($_GET['export']))
			{
				if($type==1)
				{
					$extraTitle =[["Top Logistics Amazon Delivery Forecast"],["Till:".$dateto],[]];
				}else if($type ==2)
				{
					$extraTitle =[["Top Logistics Amazon Delivery Ready To Despatch"],[]];
				}else if($type ==3)
				{
					$extraTitle =[["Top Logistics Amazon Delivery Daily Report"],[]];
				}
				else if($type ==4)
				{
					$extraTitle =[["Top Logistics Amazon Delivery Weekly Report"],[]];
				}
				$report = $reportService->getFbaReport($ddptId,$type,$datefrom,$dateto,$filtersForm,1,$swid);
				$reportService->exportReport($report,$extraTitle);
				echo $this->createUrl('report/downloadFbaReport');
				return;
			}else
			{
				$report = $reportService->getFbaReport($ddptId,$type,$datefrom,$dateto,$filtersForm,false,$swid);
				$this->render("fba_report_content",['dataProvider'=>$report[0],'filter'=>$report[1],'attributes'=>$report[2]]);
			}
		}else
		{
			$this->render("fba_report");
		}
	}

	public function actionSplitShipment()
	{
		$model = new CargoProcess();
		if(!empty($_POST))
		{
			if(empty($_POST['ref'])||empty($_POST['packages']))
			{
				$model->addError("Input ref and packages","Input ref and packages");
				$this->ajaxResult($model);
			}else
			{
				$ref = trim($_POST['ref']);
				if($_POST['packages'])
				{
					$cargoProcess = CargoProcess::model()->with(["shipment"])->find("shipment.ref = :ref",[":ref"=>$ref]);
					if(empty($cargoProcess))
					{
						$model->addError("Can't find the shipment","Can't find the shipment");
						$this->ajaxResult($model);
					}else
					{

						if(!empty($cargoProcess->mdata['sub_shipments']))
						{
							if($cargoProcess->mdata['left_packages']<=$_POST['packages'])
							{
								$model->addError("Only left ".$cargoProcess->mdata['left_packages']." packages","Only left ".$cargoProcess->mdata['left_packages']." packages");
								$this->ajaxResult($model);
							}

							$ssn = count($cargoProcess->mdata['sub_shipments'])+1;
							$suffix = AppHelper::ColNumnerToColCode($ssn);
							$caref = $ref."-".$suffix;
							$model = $cargoProcess->copyAttributes($model);
							$model->gate_pass_id = 0;
							$model->cargo_receipt = 0;
							$model->mdata['left_packages'] = $_POST['packages'];
							$model->mdata['sub_shipments'] = [];
							$model->mdata['caref'] =$caref;
							if($model->save())
							{
								$model->generateGatePass();
								$cargoProcess->mdata['caref'] =$ref."-Main";
								$cargoProcess->mdata['sub_shipments'][] = $caref;
								$cargoProcess->mdata['left_packages'] = $cargoProcess->mdata['left_packages'] - $_POST['packages'];
								$cargoProcess->save();
							}
						}else
						{
							if($cargoProcess->shipment->pkg<=$_POST['packages'])
							{
								$model->addError("Only left ".$cargoProcess->shipment->pkg." packages","Only left ".$cargoProcess->shipment->pkg." packages");
								$this->ajaxResult($model);
							}

							$suffix = AppHelper::ColNumnerToColCode(1);
							$caref = $ref."-".$suffix;
							$model = $cargoProcess->copyAttributes($model);
							$model->gate_pass_id = 0;
							$model->cargo_receipt = 0;

							$model->mdata['left_packages'] = $_POST['packages'];
							$model->mdata['sub_shipments'] = [];
							$model->mdata['caref'] =$caref;
							if($model->save())
							{
								$model->generateGatePass();
								$cargoProcess->mdata['caref'] =$ref."-Main";
								$cargoProcess->mdata['sub_shipments'] = [$caref];
								$cargoProcess->mdata['left_packages'] = $cargoProcess->shipment->pkg - $_POST['packages'];
								$cargoProcess->save();
							}
						}
						$this->ajaxResult($model);
					}
				}
			}
		}else
		{
			$this->render("split_shipment");
		}
	}
	public function actionSubmitCargoJob()
	{
		$ids = explode(',',$_POST['ids']);
		$cargoSequences = explode(',',$_POST['cargoSequence']);
		$data = [];
		$jobName = $_POST['jobName'];
		$driverId = $_POST['driverId'];
		$description = $_POST['description'];
		$dptId =  $_POST['dptId'];	
		$type =  $_POST['type'];
		$vehicleId = $_POST['vehicleId'];
		$created = $_POST['created'];
		foreach ($ids as $key => $id) {
			$data[] = [$id,$cargoSequences[$key]];
		}
		$region = $_POST['region'];
		$directionforcustomer =  $_POST['directionforcustomer'];
		$distance = $_POST['distance'];
		$destination = $_POST['destination'];
		$time = $_POST['time'];
		$isa = !empty($_POST['isa']) ? $_POST['isa'] : '';
		$amazonBookingTime = !empty($_POST['amazon_booking_time']) ? date('Y-m-d H:i:s', strtotime($_POST['amazon_booking_time'])) : '';
		$topCourierService = new TopCourierService();
		$model = $topCourierService->createCargoJob($data,$jobName,$driverId,$description,$dptId,$type,$vehicleId,$region,$directionforcustomer,$distance,$time,$created,$destination, false, $isa, $amazonBookingTime);
		//$model = $topCourierService->createCargoJob($data,$jobName,$driverId,$description,$dptId,$type,$vehicleId);
		$this->ajaxResult($model);
	}

	public function actionSaveCargoJob()
	{
		$temp=$_GET['tab'];
		$ids = explode(',',$_POST['ids']);
		$cargoSequences = explode(',',$_POST['cargoSequence']);
		$jobPalletNo = explode(',',$_POST['jobPalletNo']);
		$data = [];
		$vehicleId = $_POST['vehicleId'];
		$jobName = $_POST['jobName'];
		$driverId = $_POST['driverId'];
		$description = $_POST['description'];
		$created = $_POST['created'];
		$directionforcustomer =  $_POST['directionforcustomer'];
		$distance = $_POST['distance'];
		$destination = $_POST['destination'];
		$time = $_POST['time'];

		$jobId =  $_POST['jobId'];
		foreach ($ids as $key => $id) {
			$data[] = [$id,$cargoSequences[$key],$jobPalletNo[$key]];
		}

		//if no cargoprocesss be choosed. Only save cargo_job
		if(empty($ids[0])){
			$topCourierServiceJob = new TopCourierService();
			$model = $topCourierServiceJob->modifyCargoJob($jobName,$driverId,$description,$jobId,$vehicleId,$directionforcustomer,$distance,$time,$created,$destination);

		}else{
			$topCourierService = new TopCourierService();
			$model = $topCourierService->saveCargoJob($data,$jobName,$driverId,$description,$jobId,$vehicleId,$directionforcustomer,$distance,$time,$created,$destination);
		}

		$this->ajaxResult($model);
	}

	public function actionAddCargosIntoJob($id)
	{
		$model = CargoProcessJob::model()->findByPk($id);
		$filtersForm=new FiltersForm;
		if (isset($_GET['FiltersForm'])) {
			$filtersForm->filters=$_GET['FiltersForm'];
		}
		$cargo=new CargoProcess('search');
		$cargo->unsetAttributes();
		$cargo->isCreateJob = 1;
		if(!empty($_GET['CargoProcess']))
		{
			$cargo->setAttributes($_GET['CargoProcess']);
			if(isset($_GET['CargoProcess']['assignedUser']))
			{
				$cargo->assignedUser = $_GET['CargoProcess']['assignedUser'];
			}
			if(isset($_GET['CargoProcess']['driver_id']))
			{
				$cargo->driver_id = $_GET['CargoProcess']['driver_id'];
			}
			if(isset($_GET['ImParcel']['consol_no']))
			{
				$cargo->consol_no = $_GET['ImParcel']['consol_no'];
			}
			if(isset($_GET['CargoProcess']['exInfo']))
			{
				$cargo->exInfo = $_GET['CargoProcess']['exInfo'];
			}
		}
		$this->render('add_cargo_into_job', [
				'model' => $model,
				'cargo' => $cargo
		]);
	}

