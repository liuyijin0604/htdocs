	public function actionCollectInfoDone()
	{
		$id = $_GET['id'];
		$ids = explode(CargoProcess::IP_SEPERATOR,$id);
		foreach ($ids as $key => $thisId) 
		{
			$model=$this->loadModel($thisId);
			if($model->status==CargoProcess::COLLECTINFO)
			{
				if($model->type==CargoProcess::PICKUP_CARGO)
				{
					if(!empty($_GET['outturn']))
					{
						$emailService = New EmailService();
						if($emailService->sendPickupCargoOutturnEmail($model))
						{
							if(empty($model->shipment->mdata['amzon_pallet']))// for checking pallet info
							{
								echo "send DO success, but ".$model->shipment->ref." has not pallet info.";
							}

							if($model->shipment->status>=ImParcel::STATE_CLEAR||$model->shipment->status==ImParcel::STATE_LOCAL_ARRIVAL)
							{
								$model->mdata['outturn']=1;
								$model->save();
								$model->updateStatus(CargoProcess::WAITINGDELIVERY);
							}else
							{
								$model->mdata['outturn']=1;
								$model->save();
								$model->updateStatus(CargoProcess::HELDSENTOUTTURN);
							}
						}
					}else
					{
						if($model->shipment->status>=ImParcel::STATE_CLEAR||$model->shipment->status==ImParcel::STATE_LOCAL_ARRIVAL)
						{
							$model->updateStatus(CargoProcess::WAITINGDELIVERY);
						}else
						{
							$model->updateStatus(CargoProcess::HELDSENTOUTTURN);
						}
					}
				}else
				{
					//if it is winit
					if($model->isWinit() || $model->is4PX() || $model->isGC())
					{
						if(empty($model->mdata['delivery_booking_time']))
						{
							echo "Empty Delivery Booking Time";
							return;
						}
						$model->updateStatus(CargoProcess::WAITINGWINITBOOKING);
						$model->noticeClientBookingWinit();
					}
					else
					{
						//else:
						$model->updateStatus(CargoProcess::WAITINGASSIGNDRIVER);
					}

				}

			}else if($model->status==CargoProcess::AGENTCOLLECTINFO)
			{
				$model->updateStatus(CargoProcess::AGENTWAITINGASSIGNDRIVER);
				if($model->isSydney())
				{
					$model->noticeWarehouseToPrepare();
				}else
				{
					$model->generateGatePass();
				}
			}
		}
		echo 'done';
	}

