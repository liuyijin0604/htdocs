	public function actionEditVehicle(){
		//check
		$listError = [];
		if(isset($_POST['plate_number'])){
			$obj = CargoProcessVehicle::model()->find('plate_number=:plate_number',[':plate_number'=>$_POST['plate_number']]);
			if($obj != null){
				$listError[] = 'Plate number already exist.';
			}

		}
		if(!is_numeric($_POST['min_cbm'])){
			$listError[] = 'CBM is not a number.';
		}
		if(!is_numeric($_POST['top_width'])){
			$listError[] = 'Width is not a number.';
		}
		if(!is_numeric($_POST['height'])){
			$listError[] = 'Height is not a number.';
		}
		if(!is_numeric($_POST['length'])){
			$listError[] = 'Length is not a number.';
		}

		if(!empty($listError)){
			echo json_encode(['isSuccess'=>false,'listError'=>$listError]);
			return;
		}

		if(isset($_POST['id'])){
			$objTopCourierService = new TopCourierService();
			$objTopCourierService->funcUpdateCargoProcessVehicle(
				$_POST['id'],
				$_POST['type'],
				CargoProcessVehicle::dicEnum2Type[$_POST['type']],
				$_POST['min_cbm'],
				$_POST['min_cbm'],
				$_POST['top_width'],
				$_POST['top_width'],
				$_POST['height'],
				$_POST['length'],
				$_POST['status'],
				0,
				0,
				// $_POST['plate_number'],
				0
			);

			echo json_encode(['isSuccess'=>true]);
			return ;
		}
		else{
			$objTopCourierService = new TopCourierService();
			$objTopCourierService->funcAddCargoProcessVehicle(
				$_POST['type'],
				CargoProcessVehicle::dicEnum2Type[$_POST['type']],
				$_POST['min_cbm'],
				$_POST['min_cbm'],
				$_POST['top_width'],
				$_POST['top_width'],
				$_POST['height'],
				$_POST['length'],
				$_POST['status'],
				0,
				0,
				$_POST['plate_number'],
				0
			);

			echo json_encode(['isSuccess'=>true]);
			return ;
		}
	}

	public function actionExportCitoExcel(){
		$dicOtid2PickupFrom=[
			0=>'CITO',
			10=>'PDK',
		];

		$dicAddress = [
			'CITO'=>[
				'name'=>'cito',
				'street'=>'22 sara grove',
				'suburb'=>'Tottenham',
				'postcode'=>'3012',
				'state'=>'VIC',
			],
			'PDK'=>[
				'name'=>'pdk',
				'street'=>'3b/8 Judge Street',
				'suburb'=>'Sunshine',
				'postcode'=>'3020',
				'state'=>'VIC',
			],
		];

		$xls = new oExcel;
		$xls->addRow(1, [
			// 'customer id',  
			'customer name',  
			// 'manifest_reference',  
			'Service Type',  
			'consignment_type_name',  
			// 'driver_name',  
			// 'run_sheet_name',  
			// 'run_sheet_date',  
			// 'delivery_run_name',  
			'consignment_reference',  
			// 'consignment_data_custom_field_2',  
			'pickup_name',  
			'pickup_street',  
			'pickup_suburb',  
			'pickup_postcode',  
			'pickup_state',  
			'delivery_name',  
			'delivery_street',  
			'delivery_suburb',  
			'delivery_postcode',  
			'delivery_state',  
			'special_instructions',  
			'required_delivery_date',  
			'deliver_by_time',//
			// 'item_code',  
			'description',  
			'qty_item',  
			'pal_item',  
			'cubic_item',  
			'weight_item',  
			'space_item',  
			'length_item',  
			'width_item',  
			'height_item',  
			'value',  
			// 'ci_custom_field_1',  
			// 'ci_custom_field_2'
	   ]);

		$numId = $_GET['id'];
		$listRelation = CargoProcessJobRelations::model()->findALL('job_id=:job_id and active = 1',[':job_id'=>$numId]);
		$i = 2;
		foreach($listRelation as $objRelation){
			$objCargoProcess = $objRelation->cargo_process;
			$objImparcel = $objCargoProcess->shipment;
			$numWeight = $objImparcel->weight;
			$numPkg = $objImparcel->pkg;
			$numWeightAverage = $numWeight/$numPkg;
			$numCBM = $objImparcel->getTotalCBM();

			$length_item = '';
			$width_item = '';
			$height_item = '';
			if(!empty($objImparcel->packs))
			{
				$length_item = $objImparcel->packs[0]['length'];
				$width_item = $objImparcel->packs[0]['width'];
				$height_item = $objImparcel->packs[0]['height'];
			}

			$strPickupFrom = $dicOtid2PickupFrom[$objImparcel->ot_id];

			// Metro Pallets 3. 大包裹 立方数大于等于1，件数无限制
			// Skid 2. 中包裹 重量250KG，立方数小于等于1，件数小于等于20，单件小于等于25KG，长度宽度小于等于1.2米
			// Parcel 1. 小包裹 重量50KG，件数小于等于10，单件小于等于25KG，长度宽度小于等于1.2米
			// Tailgate Pallet 需在shipment或者c-job流程上，加一个tailgate tick box， 当这个框勾上以后，则默认就用这个服务， 不管货物什么尺寸
			$strServiceType = '';
			if($numWeight<=50&&$numPkg<=10&&$numWeightAverage<=25){
				$strServiceType = 'Parcel';
			}
			else if($numWeight<=250&&$numPkg<=20&&$numWeightAverage<=25&&$numCBM<=1){
				$strServiceType = 'Skid';
			}
			if($numCBM>1){
				$strServiceType = 'Metro Pallets';
			}
			if(isset($objImparcel->mdata['Tailgate_Pallet'])&& $objImparcel->mdata['Tailgate_Pallet']== true){
				$strServiceType = 'Tailgate Pallet';
			}

			if($objImparcel->AmazonInfo != null){
				$strTime = date('d-m-Y',strtotime($objImparcel->AmazonInfo->amazon_booking_time));
			}


			$strDescription='';
			$numTotalValue = 0;
			foreach($objImparcel->eitems['g'] as $j=>$g){
				$strDescription.=$g.';';
				$numTotalValue+=$objImparcel->eitems['v'][$j]*$objImparcel->eitems['q'][$j];
			}

			$objCnee = $objImparcel->cnee;
			$xls->addRow($i, [
				'Top Logistics',//'customer name',  
				$strServiceType,//'Service Type',  
				'Point to Point',//'consignment_type_name',  
				$objImparcel->hbn,//'consignment_reference',   
				$dicAddress[$strPickupFrom]['name'],// 'pickup_name',  
				$dicAddress[$strPickupFrom]['street'],// 'pickup_street',  
				$dicAddress[$strPickupFrom]['suburb'],// 'pickup_suburb',  
				$dicAddress[$strPickupFrom]['postcode'],// 'pickup_postcode',  
				$dicAddress[$strPickupFrom]['state'],// 'pickup_state',  
				$objCnee->name,// 'delivery_name',  
				$objCnee->address,// 'delivery_street',  
				$objCnee->suburb,// 'delivery_suburb',  
				$objCnee->postcode,// 'delivery_postcode',  
				$objCnee->state,// 'delivery_state',  
				$objImparcel->note,//'special_instructions',  
				$strTime,//'required_delivery_date',  
				$strTime,//'deliver_by_time',
				$strDescription,//'description',  
				$objImparcel->pkg,//'qty_item',  
				$objImparcel->mdata['amzon_pallet'],//'pal_item',  
				$objImparcel->mdata['total_cbm'],//'cubic_item',  
				$objImparcel->weight,//'weight_item',  
				$objImparcel->mdata['amzon_pallet'],//'space_item',  
				$length_item,// 'length_item',  
				$width_item,// 'width_item',  
				$height_item,// 'height_item',  
				$numTotalValue,//'value',  
		   ]);

			$i++;


		}

		$strFolder = Yii::app()->basePath . DIRECTORY_SEPARATOR . 'runtime' . DIRECTORY_SEPARATOR . 'temp';
		if (!file_exists($strFolder)) {
			mkdir($strFolder);
		}

		$numTime = time();
		$strName = 'cito_'.$numTime.'.xlsx';
		$strFile = $strFolder . DIRECTORY_SEPARATOR .$strName ;

		$xls->output($strFile,null,false);

		$numIdFileRepo = FileRepo::storeFile($strFile, $strName, FileRepo::CARGOPROCESSFILETYPE,$numId);
		$objFileRepo = FileRepo::model()->findByPk($numIdFileRepo);

		$strUrlPrefix = 'https://os.toplogistics.com.au';
		if ($_SERVER['HTTP_HOST'] == 'localhost:82') {
			$strUrlPrefix = 'http://localhost:82';
		}
		$strUrl = $strUrlPrefix . '/filerepo/' . $objFileRepo->hash . '/' . $objFileRepo->name;

		$model = CargoProcessJob::model()->findByPk($numId);
		Log::add($model, Log::LOG_TYPE_NOTES, ['notes' => $strUrl]);



		$xls->output($strName);
	}

	public function actionSendToTony(){
		$cJobId = $_GET['id'];
		$tony = new TonyAPI();
		$isError = $tony->postOrder($cJobId);
		if($isError['code']==1){
			$model = CargoProcessJob::model()->findByPk($cJobId);
			$model->mdata['Post'] = 1;
			$model->save();
			
			echo 'done';
		}else{
			echo 'error';
		}
	}

	public function actionCreateInvoice($id,$type){

		$modelCargo = $this->loadModel($id);

		[$app_name, Yii::app()->name] = [Yii::app()->name, 'TLA'];

		$modelInvoice = new Invoice('create');
		$modelInvoice->type = 40;
		$modelInvoice->currency = 1;
		$modelInvoice->dpmt = 50;
		if($type){
			$to_id = $modelCargo->shipment->agent_id;
		}else{
			$to_id = 3494;//casual
		}
		$modelInvoice->to_id=$to_id;
		$modelInvoice->dpt_id = $modelCargo->dpt_id;

		if (isset($_POST['Invoice'])) {
			$dpmt = isset($_POST['Invoice']['dpmt']) ? $_POST['Invoice']['dpmt'] : 0;
			if ($dpmt <= 0) {
				$modelInvoice->addError('dpmt        ', 'Invoice Department is mandatory!');
				$this->ajaxResult($modelInvoice, ['id']);
			}
			$consoleNo = '';
			if (isset($_POST['consolno'])) {
				$consoleNo = trim($_POST['consolno']);
			}

			$modelInvoice->attributes = $_POST['Invoice'];
			$modelInvoice->to_id =  $_POST['Invoice']['to_id'];
			$modelInvoice->dpt_id = $_POST['Invoice']['dpt_id'];
			$modelInvoice->dpmt = $_POST['Invoice']['dpmt'];
			$modelInvoice->status = 1;

			$awb = '';
			if (!empty($consoleNo)) {
				$console = Consol::model()->find('no = :no', [':no' => $consoleNo]);
			}
			if (!empty($console)) {
				$modelInvoice->consol_id = $console->id;
				$awb = $console->awb;
			} else if (!empty($_POST['consolno'])) {
				$modelInvoice->addError('dpmt', 'Consol No is incorrect!');
				$this->ajaxResult($modelInvoice, ['id']);
			}
			$modelInvoice->save();
			$total = 0;
			$tgst = 0;
			if (is_array($_POST['InvLine']['amount'])) {
				foreach ($_POST['InvLine']['amount'] as $i => $a) {
					if(!empty($a)){
						$il = new InvLine;
						$il->inv_id = $modelInvoice->id;
						$il->ccode = $_POST['InvLine']['ccode'][$i];
						$il->det = $_POST['InvLine']['det'][$i];
						$il->tax = $_POST['InvLine']['tax'][$i];
						$il->amount = $a;
						$gst = 0;
						if ($il->tax == 'OUTPUT') {
							$gst = floatval($il->amount) * 10 / 100;
						}
						$il->amount += $gst;
						$il->gst = $gst;
						$il->qty = empty($_POST['InvLine']['qty'][$i]) ? 1 : $_POST['InvLine']['qty'][$i];

						// linked invoice line with related console if needed
						if (!empty($console)) {
							$il->fid = $console->id;
							$il->model = $console->getType();
						}else{
							$il->fid = $modelCargo->id;
							$il->model = "CargoProcessPlanLine";
						}
						$il->save();
						$total += $il->amount * $il->qty;
						$tgst += $il->gst * $il->qty;
					}
				}
			} else {
					$il = new InvLine;
					$il->inv_id = $modelInvoice->id;
					$il->ccode = $_POST['InvLine']['ccode'];
					$il->det = $_POST['InvLine']['det'];
					$il->tax = $_POST['InvLine']['tax'];
					$il->amount = $_POST['InvLine']['amount'];
					$gst = 0;
					if ($il->tax == 'OUTPUT') {
						$gst = floatval($il->amount) * 10 / 100;
					}
					$il->amount += $gst;
					$il->gst = $gst;
					$il->qty = empty($_POST['InvLine']['qty']) ? 1 : $_POST['InvLine']['qty'];

						// linked invoice line with related console if needed
					if (!empty($console)) {
						$il->fid = $console->id;
						$il->model = $console->getType();
					}else{
						$il->fid = $modelCargo->id;
						$il->model = "CargoProcessRTS";
					}
					$il->save();
					$total += $il->amount * $il->qty;
					$tgst += $il->gst * $il->qty;
			}
			$modelInvoice->total = number_format($total, 2, '.', '');
			$modelInvoice->gst = number_format($tgst, 2, '.', '');
			$modelInvoice->mdata['name'] = $modelInvoice->cust->name;
			$modelInvoice->save();
			Yii::app()->name = $app_name;

			$modelCargo->mdata['system_invoice'] = $modelInvoice->id;
			$modelCargo->save();
			$this->ajaxResult($modelInvoice, ['id']);
		}
		$modelInvoice->date = date('Y-m-d');
		$modelInvoice->due = date('Y-m-d');
		$this->render('create_invoice', ['model' => $modelInvoice,'cargoplan'=>$modelCargo]);
	}

	public function actionApproveRedelivery(){
		$boolApprove = $_POST['approve'];
		$CargoProcessJobRelationId = explode(',',$_POST['id']);
		$modelCargoProcessJobRelation = CargoProcessJobRelations::model()->findByPk($CargoProcessJobRelationId);
		if(!empty($modelCargoProcessJobRelation)){
			$modelCargoProcessJobRelation->isredelivery=$boolApprove;
			$modelCargoProcessJobRelation->save();
			echo json_encode([
				'isSuccess' => true,
			]);
			return;
		}
		echo json_encode([
			'isSuccess' => false,
		]);
		return;
	}

	public function actionDriverScheduleList(){
		$model = new CargoProcessJob;
		$filtersForm = new FiltersForm;
		if (isset($_GET["CargoProcessJob"])) {
			$model->driver_id = $_GET["CargoProcessJob"]['driver_id'];
			$model->week = $_GET["CargoProcessJob"]['week'];
			$provide = CargoProcessJobService::getDriverScheduleByWeek($_GET["CargoProcessJob"]['driver_id'],$_GET["CargoProcessJob"]['week']);
		}else{
			$model->driver_id =2622;
			$model->week = 0;
			$provide =[];
		}
		$filteredDataMonth = $filtersForm->filter($provide);
		$provide = new CArrayDataProvider($filteredDataMonth);
		$provide->pagination = ['pageSize' => 100,];
		$this->render('driver_schedule_report', [
			'model'=>$model,
			'provide'=>$provide,
			'pod_id'=>null,
			//'modelType'=>'Cargo_Porcess',
			//'isReCalculate' => $boolRe
		]);
	}

	public function actionfulfillCargoProcess(){
		$tonyApi = new TonyAPI();
		$modelCJobs = CargoProcessJob::model()->findAllBySql('select * from cargo_process_job where created >= :created and JSON_EXTRACT(meta, "$.Post") = 1',[':created'=>date('Y-m-d',strtotime("-7 day"))]);
		if(!empty($modelCJobs)){
			foreach($modelCJobs as $modelCJob){
				if(!empty($modelCJob)){
					foreach($modelCJob->job_relations as $cargoRelation){
						$modelCargoProcess = CargoProcess::model()->findByPk($cargoRelation->cargo_process_id);
						if(!empty($modelCargoProcess)){
							$tonyApi->fulfillmentCargoProcess($modelCargoProcess->shipment->hbn);
						}
					}
				}
			}
		}
		echo "done";
	}

	public function actionUpdatePallets()
	{
		if (!empty($_POST)) {
			$shipment = ImParcel::model()->findByPk($_POST['shipment_id']);
			$plts = $_POST['plts'];
			if (!empty($shipment)) {
				$shipment->mdata['amzon_pallet'] = $plts;
				if (empty($shipment->mdata['amzon_pallet_type'])) {
					$shipment->mdata['amzon_pallet_type'] = 'Plain';
				}
				$shipment->update(['meta']);
				echo 'done';
			} else {
				echo 'Shipment does not exist.';
			}
		}
	}
}
