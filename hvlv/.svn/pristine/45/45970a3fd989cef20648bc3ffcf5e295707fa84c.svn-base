	public function getType(){
		return Yii::t(strtolower(__CLASS__), $this->type == 0? 'System' : self::$types[$this->type]);
	}
	
	public function getStatus(){
		return Yii::t(strtolower(__CLASS__), self::$states[$this->status]);
	}
	
	public static function links($rs){
		$r = '';
		foreach($rs as $f){
			$r .= '<a href="'.Yii::app()->baseUrl."/filerepo/".$f->hash."/".$f->name.'" title="'.$f->name.'" target="_blank">'.$f->name.' </a> &nbsp; ';
		}
		return empty($r)? Yii::t(strtolower(__CLASS__), 'none') : $r;
	}
	
	public function getUrl(){
		return Yii::app()->baseUrl."/filerepo/".$this->hash."/".urlencode($this->name);
	}

	public function getOutUrl(){
		return "https://file.toplogistics.com.au/".$this->hash."/".urlencode($this->name)."?t=1";
	}
	public function getUrlRelate(){
		return "filerepo/".$this->hash."/".urlencode($this->name);
	}
	public static function gallery($rs, $rel='gallery', $tp = ''){
		$r = '';
		foreach($rs as $i=>$f){
			$r .= '<a href="'.Yii::app()->baseUrl."/filerepo/".$f->hash."/".$f->name.'" rid="'.$f->id.'" rel="'.$rel.'" title="'.$tp.$f->name.'">'.($i==0? '<div class="icon" style="background-position:-48px -560px"></div>' : '').'</a>';
		}
		return $r;
	}
	
	
	public function formatSize(){
		$bytes = $this->size;
		if ($bytes >= 1073741824){
			$bytes = number_format($bytes / 1073741824, 2) . ' GB';
		} elseif ($bytes >= 1048576){
			$bytes = number_format($bytes / 1048576, 2) . ' MB';
		} elseif ($bytes >= 1024){
			$bytes = number_format($bytes / 1024, 2) . ' KB';
		} elseif ($bytes > 1){
			$bytes = $bytes . ' bytes';
		} elseif ($bytes == 1){
			$bytes = $bytes . ' byte';
		} else {
			$bytes = '0 bytes';
		}

		return $bytes;
	}
	
	public function store($f, $hash){//uploaded file
		if(!is_uploaded_file($f['tmp_name'])) return false;
		$this->name = $f['name'];
		$this->size = filesize($f['tmp_name']);
		$this->date = date('Y-m-d H:i:s');
		$this->hash = hash_file('crc32b', $f['tmp_name']).hash('crc32b', $this->size).rand(1000,5000);
		$sup = Yii::app()->session['uploads'][$hash];
		$this->type = $sup[0];
		$finfo = finfo_open(FILEINFO_MIME_TYPE);
		$mime = finfo_file($finfo, $f['tmp_name']);
		$this->mime = empty($mime)? 'application/octet-stream' : $mime;
		$d = Yii::app()->params['fileRepoPath'].DIRECTORY_SEPARATOR.substr($this->hash,0,2);
		if(!is_dir($d)) mkdir($d);
		try
		{
			move_uploaded_file($f['tmp_name'], $d.DIRECTORY_SEPARATOR.$this->hash);
		}catch(Exception $e)
		{

		}
		if(empty($sup[1])){
			$this->fid = 0;
			$this->save();
			if(!isset($sup[2])) $sup[2] = array();
			$sup[2][] = $this->id;
			$su = Yii::app()->session['uploads'];
			$su[$hash] = $sup;
			Yii::app()->session['uploads'] = $su;
		}else{
			$this->fid = $sup[1];
			$this->save();
			if(!isset($sup[2])) $sup[2] = array();
			$sup[2][] = $this->id;
		}
	}

	
	public static function storeFile($f, $name, $type, $fid){
		$fr = new FileRepo;
		$fr->name = $name;
		$fr->size = filesize($f);
		$fr->date = date('Y-m-d H:i:s');
		$fr->hash = hash_file('crc32b', $f).hash('crc32b', $fr->size).rand(1000,5000).'tla';
		$fr->type = $type;
		if($r = self::model()->findByAttributes(array('hash' => $fr->hash, 'type' => $type, 'fid' => $fid))) return $r->id;
		$finfo = finfo_open(FILEINFO_MIME_TYPE);
		$mime = finfo_file($finfo, $f);
		$fr->mime = empty($mime)? 'application/octet-stream' : $mime;
		$d = Yii::app()->params['fileRepoPath'].DIRECTORY_SEPARATOR.substr($fr->hash,0,2);
		if(!is_dir($d)) mkdir($d);
		copy($f, $d.DIRECTORY_SEPARATOR.$fr->hash);
		$fr->fid = $fid;
		$fr->save();
		return $fr->id;
	}

	public static function storeUrlFile($url, $name, $type, $fid){
		$tf = tempnam(Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR, "suf");
		$d = @file_get_contents($url);
		if(empty($d)){
			unlink($tf);
			return 0;
		}else{
			file_put_contents($tf, $d);
		}
		return self::storeFile($tf, $name, $type, $fid);
	}

	public static function storeBase64File($cont, $name, $type, $fid){
		$tf = tempnam(Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR, "b64f");
		file_put_contents($tf, base64_decode($cont));
		$fileid = self::storeFile($tf, $name, $type, $fid);
		unlink($tf);
		return $fileid;
	}
	public static function sameFile($f){
		$hash = hash_file('crc32b', $f).hash('crc32b', filesize($f));
		return self::model()->count('hash = :h', [':h' => $hash]) > 0;
	}

	public function hardDelete(){
		if(self::model()->count('hash = :h', array(':h' => $this->hash)) == 1)	unlink($this->getFile());
		$this->delete();
	}
	
	public function rFile($p){
		$d = Yii::app()->params['fileRepoPath'].DIRECTORY_SEPARATOR.substr($this->hash,0,2);
		$f = $d.DIRECTORY_SEPARATOR.$this->hash;
		if(is_file($f)) return true;
		if(!is_dir($d)) mkdir($d);
		return file_put_contents($d.DIRECTORY_SEPARATOR.$this->hash, base64_decode($p[0]));
	}
	
	public static function hasUploaded($hash, $id){
		if(isset(Yii::app()->session['uploads'][$hash])){
			$sup = Yii::app()->session['uploads'][$hash];
			if(!empty($sup[2])){
				foreach($sup[2] as $f){
					$r = self::model()->findByPk($f);
					$r->fid = $id;
					$r->save();
				}
			}
			$su = Yii::app()->session['uploads'];
			unset($su[$hash]);
			Yii::app()->session['uploads'] = $su;
		}
	}
	
	public function download(){
		header('Expires: '.gmdate('D, d M Y H:i:s', time() + Yii::app()->params['fileCacheTTL']) . ' GMT');
		header('Pragma: cache');
		header('Cache-Control: max-age='.Yii::app()->params['fileCacheTTL']);
		header('Cache-Control: private',false);
		header('Content-Type: '.$this->mime);
		header('Content-Disposition: filename="'.$this->name.'";');
		header('Content-Transfer-Encoding: binary');
		header('Content-Length: '.$this->size);
		if (file_exists(Yii::app()->params['fileRepoPath'].DIRECTORY_SEPARATOR.substr($this->hash,0,2).DIRECTORY_SEPARATOR.$this->hash)) {
			readfile($this->getFile());
		} else {
			$s3Service = new AwsS3Service();
			$data = $s3Service->downloadFile($this);
			$tempFile = Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR. 's3_temp_files' . DIRECTORY_SEPARATOR . $this->hash;
			if(empty($data)){
				unlink($tempFile);
				return 0;
			}else{
				file_put_contents($tempFile, $data);
			}
			readfile($tempFile);
			unlink($tempFile);
		}
		exit();
	}
	
	public function getFile(){
		if (file_exists(Yii::app()->params['fileRepoPath'].DIRECTORY_SEPARATOR.substr($this->hash,0,2).DIRECTORY_SEPARATOR.$this->hash)) {
			return Yii::app()->params['fileRepoPath'].DIRECTORY_SEPARATOR.substr($this->hash,0,2).DIRECTORY_SEPARATOR.$this->hash;
		} else {
			return $this->getS3File();
		}
	}

	public function getS3File()
	{
		$s3Service = new AwsS3Service();
		$data = $s3Service->downloadFile($this);
		$tempFile = Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR. 's3_temp_files' . DIRECTORY_SEPARATOR . $this->hash;
		if(empty($data)){
			unlink($tempFile);
			return 0;
		}else{
			file_put_contents($tempFile, $data);
		}
		return $tempFile;
	}
	
	public static function hasFile($m, $t){
		$r = self::model()->find('status = 1 AND fid = :id AND type = :t', array(':id' => $m->id, ':t' => $t));
		return $r? $r->getFile() : false;
	}
	
	public static function uploadHash($m,$k=0){
		$hash = md5(serialize($m).microtime());
		if(!isset(Yii::app()->session['uploads'])) Yii::app()->session['uploads'] = array();
		$sup = Yii::app()->session['uploads'];
		$sup[$hash] = array($k, $m->id);
		Yii::app()->session['uploads'] = $sup;
		return $hash;
	}
		
	protected function beforeSave(){
		if(!empty($this->mdata)) $this->meta = json_encode($this->mdata);
		return true;
	}
	
	public function afterFind(){
		if(!empty($this->meta)) $this->mdata = json_decode($this->meta, true);
		return true;
	}

	/**
	 * @return array customized attribute labels (name=>label)
