	/**
	 * @return array validation rules for model attributes.
	 */
	public function rules(){
		// NOTE: you should only define rules for those attributes that
		// will receive user inputs.
		return array(
			array('name, hash, mime, size, date, type', 'required'),
			array('meta, fid, status', 'safe'),
			array('size, type, fid, status', 'numerical', 'integerOnly'=>true),
			array('name, hash, mime', 'length', 'max'=>255),
			// The following rule is used by search().
			// Please remove those attributes that should not be searched.
			array('id, name, hash,theTypes,non_status, mime, size, date, meta, status', 'safe', 'on'=>'search'),
		);
	}

