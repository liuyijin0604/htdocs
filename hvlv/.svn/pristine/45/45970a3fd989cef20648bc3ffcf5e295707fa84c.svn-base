			'name' => 'Name',
			'hash' => 'Hash',
			'mime' => 'Mime',
			'size' => 'Size',
			'date' => 'Date',
			'meta' => 'Meta',
			'type' => 'Type',
			'fid' => 'FID',
			'status' => 'Status',
		);
		foreach($al as $k=>$l){
			$al[$k] = Yii::t(strtolower(__CLASS__), $l);
		}
		return $al;
	}

	/**
	 * Retrieves a list of models based on the current search/filter conditions.
	 * @return CActiveDataProvider the data provider that can return the models based on the search/filter conditions.
	 */
	public function search($pgn=true, $ps = 30, $ec = false){
		// Warning: Please modify the following code to remove attributes that
		// should not be searched.

		$criteria=new CDbCriteria;

		/*$criteria->compare('id',$this->id);
		$criteria->compare('name',$this->name,true);
		$criteria->compare('hash',$this->hash,true);
		$criteria->compare('mime',$this->mime,true);
		$criteria->compare('size',$this->size);
		$criteria->compare('meta',$this->meta,true);*/
		$criteria->compare('t.id',$this->id);
		$criteria->compare('name',$this->name,true);
		$criteria->compare('date',$this->date,true);
		$criteria->compare('type',$this->type);
		$criteria->compare('org_id',$this->org_id);
		if (!is_array($this->fid)) {
			$criteria->compare('fid',$this->fid);
		} else {
			$criteria->addCondition('fid IN (' . implode(',', $this->fid) . ')');
		}
		$criteria->compare('status',$this->status);
		if(!empty($this->non_status)){
			$criteria->addNotInCondition('status', $this->non_status);
		}
		if(!empty($this->theStatus)){
			$criteria->addInCondition('status', $this->theStatus);
		}
		if(!empty($this->theTypes)) {
			$criteria->addInCondition('type', $this->theTypes);
		}

		if($ec) $criteria->mergeWith($ec);

		return new CActiveDataProvider($this, array(
			'criteria'=>$criteria,
			'sort'=>array(
				'defaultOrder'=>'t.date DESC',
			),
			'pagination'=> $pgn? array(
				'pageSize'=>$ps,
			) : false,
		));
	}
}