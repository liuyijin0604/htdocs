.update-clear-reason-container-lg {
	position: fixed; 
	right: 10em; 
	top:20em;
}

.the-warning-lg {
	font-size: 3em;
}

.dg-warnings-container-lg {
	position: fixed; 
	right: 10em; 
	top:30em;
}

.dg-warning-lg {
	font-size: 3em;
}

.update-clear-reason-container-sm {
	position: fixed;
	right: 2em;
	top: 26em;
}

.the-warning-sm {
	font-size: 1.5em;
}

.dg-warnings-container-sm {
	position: fixed;
	right: 2em;
	top: 30em;
}

.dg-warning-sm {
	font-size: 1.5em;
}
</style>
<script>
	var w = window.innerWidth;
	$(function() {
		if (w < 1024) {
			$('#update_clear_reason_container').removeClass('update-clear-reason-container-lg');
			$('#update_clear_reason_container').addClass('update-clear-reason-container-sm');
			$('#the_warning').removeClass('the-warning-lg');
			$('#the_warning').addClass('the-warning-sm');
			$('#dg_warnings_container').removeClass('dg-warnings-container-lg');
			$('#dg_warnings_container').addClass('dg-warnings-container-sm');
			$('#dg_warning').removeClass('dg-warning-lg');
			$('#dg_warning').addClass('dg-warning-sm');
		} else {
			$('#update_clear_reason_container').removeClass('update-clear-reason-container-sm');
			$('#update_clear_reason_container').addClass('update-clear-reason-container-lg');
			$('#the_warning').removeClass('the-warning-sm');
			$('#the_warning').addClass('the-warning-lg');
			$('#dg_warnings_container').removeClass('dg-warnings-container-sm');
			$('#dg_warnings_container').addClass('dg-warnings-container-lg');
			$('#dg_warning').removeClass('dg-warning-sm');
			$('#dg_warning').addClass('dg-warning-lg');
		}
	})
</script>
