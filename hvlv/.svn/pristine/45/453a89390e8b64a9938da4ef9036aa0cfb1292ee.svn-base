function funcGetDefaultAddress(orgId, type) {
		var tab = $("#<?= $_GET['tabid']; ?>");
		var panel = tab.data('panel');
		var listData = new FormData();
		listData.append('orgId', orgId);
		htmlobj = $.ajax({
			type: "POST",
			url: "<?= $this->createUrl('cargoProcessPlan/ajaxGetDefaultAddress'); ?>",
			data: listData,
			dataType: 'html',
			async: false,
			contentType: false,
			processData: false,
		});
		obj = JSON.parse(htmlobj.responseText);
		if (obj.isSuccess) {
			//$("#mdata_"+strTemp+"_name").val(obj.name);
			//$("#mdata_"+strTemp+"_tel").val(obj.tel);
			$("input[name='Cnee[address]']",panel).val(obj.address);
			$("input[name='Cnee[suburb]']",panel).val(obj.suburb);
			$("#Cnee_state",panel).val(obj.state);
			$("input[name='Cnee[postcode]']",panel).val(obj.postcode);
		}

	}
</script>