	$('#resend-acr-btn',panel).click(function(e){
		if ( confirm('Are your re-send ACR again?') ) {
			var data={};
			if($('input[name=config_acr]',panel).prop('checked')){
			 data['config_check']=1;
			 data['can_sac']=$('input:radio[name=can_sac]:checked',panel).val();
			}else{
			  data['config_check']=0;
			}
			$.ajax({
				type : 'GET',
				url : '<?php echo Yii::app()->createAbsoluteUrl("ImParcel/ResendACR/" . $model->id ) ;?>',
				data:data,
				dataType: 'json',
				success:function(resp){
					if ( resp.success == 1 ) {
						myApp.notice('the shipment ACR re-sent successfully!', 5000);
					} else {
						myApp.alert(resp.msg);
					}
				}
			});
		}
	});

	$('#items', panel).off('change', '.item_qty,.item_uv').on('change', '.item_qty,.item_uv', calcTot);
