		 $("#sf_submit_btn",panel).on('click', function() {
			  let markNumbers = "";
			  $('#mdata_sea_mark_number',panel).each(function(){
			  	 markNumbers = $(this).val();
			  });
			  let markNumberArray = markNumbers.split(/(?:;| )+/);
			  let isValid = true;
			  let msg = "";
			  console.log(markNumberArray);		  

			  if (markNumberArray.length > 9) {
			    msg = "number of Marks And Numbers can not be over 9";
			    isValid = false;
			  }

			  markNumberArray.forEach(function(markNumber) {
			    if (markNumber.length > 35) {
			      msg = "length of Marks And Numbers can not be over 35";
			      isValid = false;
			    }
			  });

			  if (!isValid) {
			    myApp.alert(msg);
			    e.preventDefault();
			    return false;
			  }
			  else{
			  	return true;
			  }
			});

		 $("#packages_hide",panel).click(function () {		 	
