		 	$("#packages_hide",panel).hide();
		 	$("#packages_show",panel).show();
		 });

		 $("#packages_show",panel).click(function () {
		 	$("#packages_show",panel).hide();
		 	$("#packages",panel).show();
		 	$("#packages_hide",panel).show();
		 });

