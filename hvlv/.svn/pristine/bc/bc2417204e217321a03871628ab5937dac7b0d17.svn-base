	public function fixGatepassShipment()
	{
		$labels = DfeChangeLabel::model()->findAll(['condition'=>'allied_ref not like "AOE%"','group'=>' pid ']);
		foreach ($labels as $key => $label)
		{
			$p = ImParcel::model()->findByPk($label->pid);
			$rateId = $p->mdata['org_rate_id'];
			$r = OrgRate::model()->findByPk($rateId);

			$gatepassShipments = GatepassShipment::model()->findAll("fid = :fid",[":fid"=>$p->id]);
			foreach ($gatepassShipments as $key => $gatepassShipment)
			{
				$gatepassShipment->courier_id = $r->org_id;
				$gatepassShipment->save();
			}
		}
	}

