	private function fixOldAddressP($filename)
	{
		// $fullString = file_get_contents(Yii::app()->basePath.DIRECTORY_SEPARATOR.'runtime'.DIRECTORY_SEPARATOR . 'shipmentapi' . DIRECTORY_SEPARATOR.$filename.".log");
		// // $replacedStr = preg_replace("/[0-9]{4}-[0-1][0-9]-[0-3][0-9] [0-2][0-9]:[0-9][0-9]:[0-9][0-9] {/",",{",$fullString);
		// // file_put_contents(Yii::app()->basePath.DIRECTORY_SEPARATOR.'runtime'.DIRECTORY_SEPARATOR . 'shipmentapi' . DIRECTORY_SEPARATOR."shipment_api_2020-04-29-re.log",$replacedStr);
		// $m=[];
		// $saichengData =preg_match_all("/{\"api_id\":\"saichenglogistics\".*cref.*}\n/",$fullString,$m);
		// file_put_contents(Yii::app()->basePath.DIRECTORY_SEPARATOR.'runtime'.DIRECTORY_SEPARATOR . 'shipmentapi' . DIRECTORY_SEPARATOR.$filename."-re.log",json_encode($m));

		$fullString = file_get_contents(Yii::app()->basePath.DIRECTORY_SEPARATOR.'runtime'.DIRECTORY_SEPARATOR . 'shipmentapi' . DIRECTORY_SEPARATOR.$filename."-re.log");
		
		$data = json_decode($fullString,true)[0];
		$transaction=Yii::app()->db->beginTransaction();
		try {
			foreach ($data as $key => $d) {
				echo "1";
				$oneData = json_decode($d)->data;
				$oneData = json_decode($oneData);
				$cref = $oneData->cref;
				$consignee = $oneData->consignee;
				$p = ImParcel::model()->find('(cbwf & 16)>0 and created >= "2020-04-27" and agent_id = 3113 and cref = "'.$cref.'"');
				//echo '(cbwf&16)>0 and created >= "2020-04-27" and agent_id = 3113 and cref = "'.$cref.'"';
				if(!empty($p)&&isset($p->mdata['oldAddress']))
				{
					$p->mdata['oldAddress']['address'] = $consignee->address;
					$p->mdata['oldAddress']['suburb'] = $consignee->suburb;
					$p->mdata['oldAddress']['state'] = $consignee->state;
					$p->mdata['oldAddress']['postcode'] = $consignee->postcode;
					
					$p->save();
				}
			}
		$transaction->commit();
		} catch (Exception $ex) {
			$transaction->rollback();
			throw $ex;
		}
	}

	public function fixCref()
	{
		$crefs = [''];
		$refs = [''];
		
		$size = count($refs);
		$pagesize = 1000;
		$pages = ceil($size/$pagesize);
		$all = 0;
		// print_r($refs);
		// return;
		for ($i=0; $i < $pages; $i++)
		{
			$transaction=Yii::app()->db->beginTransaction();
			try {
				for ($j=$i*$pagesize; $j < (($i*$pagesize)+$pagesize); $j++)
				{
					if(empty($refs[$j]))
					{
						echo "x".$j;
						break;
					}
					$p = ImParcel::model()->find("ref = :ref",[":ref"=>$refs[$j]]);
					if(!empty($p))
					{
						if(empty($p->cref))
						{
							$p->cref = $crefs[$j];
							$p->save();
						}
					}
					$all++;
				}
				$transaction->commit();
			} catch (Exception $ex) {
				$transaction->rollback();
				throw $ex;
			}
		}

		echo "all".$all."count".$size;

		
	}

