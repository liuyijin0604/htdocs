	public function pdftotxt()
	{
		$p = ImParcel::model()->findByPk(24532465);
		// $eizInfo = '[{"id":5692194,"consignment_id":5573197,"labelNumber":"EIZI14076430","url":"2021\/09\/02\/61308540802ca9.46480328.pdf","data":{"reference":"761_nHURHCOSXw9UjZP"}}]';
		// $eizInfo = json_decode($eizInfo,true);
		$barcodes = [];
		$eizInfo = $p->mdata['eiz']['label'];
		foreach ($eizInfo as $key => $e) {
			$url =  'https://s3.ap-southeast-2.amazonaws.com/eiz.labels/labels/'.$e['url'];
			$f = tempnam(Yii::app()->basePath . DIRECTORY_SEPARATOR . "runtime" . DIRECTORY_SEPARATOR."temp".DIRECTORY_SEPARATOR, 'pp');
			$f2 = tempnam(Yii::app()->basePath . DIRECTORY_SEPARATOR . "runtime" . DIRECTORY_SEPARATOR."temp".DIRECTORY_SEPARATOR, 'check');
			file_put_contents($f, file_get_contents($url));
			$result = oPDF::pdftotxt($f,$f2);
			print_r($result);
			if(preg_match('/(\(00\) )(\d{17})/', $result,$m))
			{
				$barcodes[] = '00'.$m[2];
			}
			$result = preg_split('/\r|\n/', $result);
			print_r($result);
			$header = [$result[4],$result[8],$result[12]];
			break;
		}
		print_r($barcodes);
		print_r($header);
	}

	public function borderRateHandling()
	{
		$xls = new oExcel('csv');
		$xls->load('C:\Users\admin\Downloads\Border Express Rating Zones.csv');
		$data1 = $xls->getAll();

		$xls = new oExcel('csv');
		$xls->load('C:\Users\admin\Downloads\Bex RAS Checker.csv');
		$data2 = $xls->getAll();


		unset($data1[1]);
		unset($data2[1]);
		
		foreach ($data1 as $key => $d1)
		{
			foreach ($data2 as $key2 => $d2)
			{
				if($d1[1]==$d2[2] && $d1[3]==$d2[3] && ($d2[4]== 'RAS2'||$d2[4]== 'RAS3' ))
				{
					unset($data1[$key]);
					break;
				}
			}
		}


		$xlsave = new oExcel;
		$xlsave->addRow(1, ["zone","zone name","postcode","suburb","state"]);
		$start = 2;
		foreach ($data1 as $key => &$d) 
		{
			$xlsave->addRow($start, [$d[5],$d[5],$d[3],$d[1],$d[2]]);
			$start++;
		}
		$xlsave->output('D:\handleData\border.csv', null, false);


	}

