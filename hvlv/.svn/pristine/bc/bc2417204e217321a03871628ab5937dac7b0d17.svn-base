	public function getDailyCheckIn()
	{
		$shipmentScans = ShipmentScan::model()->findAll(['condition'=>'scan_time > "2021-05-01" and type = 0','group'=>'pid,pno','order'=>'scan_time']);
		$datas = [];
		foreach ($shipmentScans as $key => $value) {
			if(!empty($datas[date('Y-m-d',strtotime($value->scan_time))]))
			{
				if(empty($datas[date('Y-m-d',strtotime($value->scan_time))][$value->pid]))
				{
					$datas[date('Y-m-d',strtotime($value->scan_time))][$value->pid] = 1;
				}else
				{
					$datas[date('Y-m-d',strtotime($value->scan_time))][$value->pid] +=1;
				}
			}else
			{
				$datas[date('Y-m-d',strtotime($value->scan_time))] = [];
				$datas[date('Y-m-d',strtotime($value->scan_time))][$value->pid] = 1;
			}
		}
		foreach ($datas as $key => $value) {
			$str = '';
			$str.='\''.$key.'\'';
			$number1 = 0;
			$number2 = 0;
			foreach ($value as $key2 => $value2) {
				$number1 +=1;
				$number2 +=$value2;
			}
			$str.=','.$number1;
			$str.=','.$number2;

			echo $str,PHP_EOL;
		}
	}

	public function fixChaiDanData()
	{
		$ps = TplParcel::model()->with('consol')->findAll('consol.no like "WDT%" and t.status !=100');
		foreach ($ps as $key => $p) {
			$po = Postcode::model()->find('postcode  = :postcode and suburb = :suburb and country = "AU"',[":postcode"=>$p->cnee->postcode,":suburb"=>$p->cnee->suburb]);
			if(!empty($po))
			{
				$p->cnee->state = $po->state;
				$p->postcode = $p->cnee->postcode;
				$p->state = $p->cnee->state;
				$p->save();
				$p->cnee->save();
			}else
			{
				echo $p->hbn,PHP_EOL;
			}
		}
	}

	public function changeShipmentByChargeCode()
	{
		$dataArr = ['TBN1474058965','TBN1474058964','TBN1474058960','TBN1474058958','TBN1474058957','TBN1474058955','TBN1474058951','TBN1474058950','TBN1474058993','TBN1474058992','TBN1474058991','TBN1474058975','TBN1474058971','TBN1474058970','TBN1474058969','TBN1474058968','TBN1474058967','TBN1474058956','TBN1474058953','TBN1474058946','TBN1474058941','TBN1474058989','TBN1474058988','TBN1474058981'];
		foreach ($dataArr as $key => $data) {
			$p = ImParcel::model()->find('hbn = :hbn',[':hbn'=>$data]);
			$chargeCode = 4411;
			$p->mdata['chargecode'] = $chargeCode;
			$p->ref = '';
			$o = new stdClass();
            $o->error = [];
			$rt = ChooseShipment::selectServiceByChargeCode($chargeCode, $p,'AU', true);
            $reply = ChooseShipment::funcAfterSelectServiceByChargeCode($o,$p,$rt,false,true);
            if (!$reply->success) {
                    echo $p->hbn,join('; ', $reply->error),PHP_EOL;
            }else
            {
            	$rt = ChooseShipment::selectServiceByChargeCode($chargeCode, $p,'AU', false);
           		$reply = ChooseShipment::funcAfterSelectServiceByChargeCode($o,$p,$rt,false,false);
           		if (!$reply->success) {
                    echo $p->hbn,join('; ', $reply->error),PHP_EOL;
            	}
            }
		}
	}

	public function changeScanTime()
	{
		$consol = ImcoConsol::model()->findByPk(92032);
		$shipments = $consol->shipments;
		foreach ($shipments as $key => $p) {
			$scan_ts = HolidayHelper::getRandomMinute('2021-06-10 09:04:00',5940);
			$p->mdata['scan_time'] = $scan_ts;
			$p->mdata['is_change_scan_time'] = true;
			if(!empty($p->scan_data[50])&&is_array($p->scan_data[50]))
			{
				foreach ($p->scan_data[50] as $skey => $psc) {
					$p->scan_data[50][$skey] = $scan_ts;
					$scan_ts = HolidayHelper::getRandomMinute('2021-06-10 09:04:00',5940);
				}
			}
			$scan_ts = strtotime($scan_ts);
			$p->updateMetaAndScan();
		}
	}

	public function siToPay()
	{
		Yii::app()->name = 'TLA';
		$siId = $this->prompt('Si Reconcile Id');
		$model = SiReconcile::model()->findByPk($siId);
		$this->parent = $model->parent;
		if ($model->type == SiReconcile::TYPE_COURIER) {
			$this->toPay();
		} else {
			$this->toPay(true);
		}
	}

	public function toPay($split_to_consol = false)
	{
		while (true) {
			try {
				// $fp = fopen(Yii::app()->basePath . DIRECTORY_SEPARATOR . 'runtime' . DIRECTORY_SEPARATOR . 'system_lock' . DIRECTORY_SEPARATOR . 'xero_billing.lock', 'r');
				// flock($fp, LOCK_EX);

				$this->_toPay($split_to_consol);

				// flock($fp, LOCK_UN);
				// fclose($fp);
				break;
			} catch (Exception $ex) {
				throw $ex;
			}
		}
	}

	public function _toPay($split_to_consol = false)
	{
		if(empty($this->parent->inv_date)||$this->parent->inv_date=='0000-00-00')
		{
			$this->addError("empty invoice date","empty invoice date");
			return;
		}
		Yii::app()->name = 'TLA';
		$billing = Billing::model()->find('org_id = :org_id AND billing_cref = :billing_cref AND status != 11', [':org_id' => $this->parent->org_id, ':billing_cref' => $this->parent->inv_no]);
		if (!empty($billing) && empty($billing->mdata['from_supplier_invoice'])) return;
		if (empty($billing)) {
			$billing = new Billing;
			$billing->org_id = $this->parent->org_id;
			$billing->billing_cref = $this->parent->inv_no;
			$billing->created = date('Y-m-d');
			$billing->date = $this->parent->inv_date;
			$billing->due = $this->parent->inv_date;
			$billing->transaction_date = $this->parent->inv_date;
			$billing->currency = $this->parent->currency;
			$billing->type = 0;
			$billing->status = Billing::BILLING_STATUS_CONFIRM;
			$billing->dpt_id = Org::PCAE_DEPARTMENT_SYDNEY;
			$billing->total = $this->parent->total;
			$billing->gst = $this->parent->gst;
		}
		$billing->mdata['from_supplier_invoice'] = $this->parent->id;
		$billing->save();

		if (!$split_to_consol) {
			if (empty($billing->getErrors())) $this->toPayLineToConsolNo($billing);
		} 
	}

	public function toPayLineToConsolNo($billing)
	{
		foreach ($billing->lines as $line) {
			$line->status = 11;
			$line->update('status');
		}

			$this->createBlForXero($billing, $this);
			$billing->refresh();
			$billing->calTotal();
			$billing->checkPaid();
			$billing->nolog = true;
			$billing->update('total', 'gst', 'status');

			if (!empty($this->args[1])) {
				$sync = $this->args[1];
			} else {
				$sync = false;
			}
			if ($billing->sync_xero == 0 || $sync) {
				$billings = [];
				$billings[$billing->billing_cref] = $billing->lines;
				Yii::import('application.controllers.BillingController');
				$bc = new BillingController('default');
				$bc->postXero($billings);

				$billing->refresh();
				if ($billing->status == 2) {
					$bc->postXero($billings, true);
				}
			}
	}

	public function toPayLineToConsolYes($billing)
	{
		$amt_im = [];
		$amt_im_gst = [];
		$amt_3pl = [];
		$amt_3pl_gst = [];
		foreach ($this->lines as $line) {
			if (preg_match('/^eparcel$/i', $line->item_code) || preg_match('/^eparcel-fuel$/i', $line->item_code)) continue;

			if (($line->type & SiReconcileLine::TYPE_3PL) > 0 && Yii::app()->name != 'TLA') {
				$dpmt = '3pl';
			} else {
				$dpmt = 'im';
			}

			// model is consol
			if (preg_match('/consol/i', $line->model)) {
				$consol = Consol::model()->findByPk($line->fid);
				if (!empty($consol)) {
					$no = $consol->no;
				} else {
					$no = 'Null';
				}
			// model is imparcel
			} else if (preg_match('/^imparcel$/i', $line->model)) {
				$shipment = Shipment::model()->findByPk($line->fid);
				if (!empty($shipment->consol)) {
					$no = $shipment->consol->no;
				} else {
					$no = 'Null';
				}
			// item_code is rts
			} else if (preg_match('/^rts$/i', $line->item_code)) {
				$shipment = Shipment::model()->with('manif')->find('manif.ref = :ref', [':ref' => $line->ref]);
				if (!empty($shipment->consol)) {
					$no = $shipment->consol->no;
				} else {
					$no = 'Null';
				}
			// item_code is letter
			} else if (preg_match('/^letter$/i', $line->item_code)) {
				$consol = Consol::model()->find('awb = :ref1 OR json_query(t.meta, "$.elms") LIKE :ref2', [':ref1' => $line->ref, ':ref2' => '%' . $line->ref . '%']);
				if (!empty($consol)) {
					$no = $consol->no;
				} else {
					$no = 'Null';
				}
			} else {
				$no = 'Null';
			}

			if (empty(${'amt_' . $dpmt}[$no])) ${'amt_' . $dpmt}[$no] = 0;
			${'amt_' . $dpmt}[$no] += $line->value;
			if (empty(${'amt_' . $dpmt . '_gst'}[$no])) ${'amt_' . $dpmt . '_gst'}[$no] = 0;
			if ($this->parent->type == 1 && floatval(@$line->mdata['gst']) == 0) {
				${'amt_' . $dpmt . '_gst'}[$no] += $line->value * 0.1;
			} else {
				${'amt_' . $dpmt . '_gst'}[$no] += floatval(@$line->mdata['gst']);
			}
		}
		if (array_sum($amt_im) == 0 && array_sum($amt_3pl) == 0) $amt_im['Null'] = $this->parent->total_ex_gst;

		if (array_sum($amt_im) > 0) {
			foreach ($amt_im as $no => $amount) {
				self::createBlToConsol('Import', $no, $amount, floatval(@$amt_im_gst[$no]), $billing, $this->parent);
				if ($amount > floatval(@$amt_im_gst[$no]) * 10) {
					self::createBlToConsol('Import', $no, $amount - floatval(@$amt_im_gst[$no]) * 10, 0, $billing, $this->parent);
				}
			}
		}

		if (array_sum($amt_3pl) > 0) {
			foreach ($amt_3pl as $no => $amount) {
				self::createBlToConsol('3PL', $no, $amount, floatval(@$amt_3pl_gst[$no]), $billing, $this->parent);
				if ($amount > floatval(@$amt_3pl_gst[$no]) * 10) {
					self::createBlToConsol('3PL', $no, $amount - floatval(@$amt_3pl_gst[$no]) * 10, 0, $billing, $this->parent);
				}
			}
		}

		$billing->refresh();
		$billing->calTotal();
		$billing->checkPaid();
		$billing->nolog = true;
		$billing->update('total', 'gst', 'status');

		// gst adjust
		$bg = number_format($billing->gst, 2, '.', '');
		$sg = number_format($this->parent->gst, 2, '.', '');
		if (number_format(abs($bg - $sg), 2, '.', '') >= 0.01) {
			self::createBlToConsol('Import', 'Adjust', number_format(($sg - $bg) * 10, 2, '.', ''), number_format($sg - $bg, 2, '.', ''), $billing, $this->parent,$this->getBrokerConsolNo());
		}
		$billing->refresh();
		$billing->calTotal();
		$billing->checkPaid();
		$billing->nolog = true;
		$billing->update('total', 'gst', 'status');

		// total adjust
		$bt = number_format($billing->total, 2, '.', '');
		$st = number_format($this->parent->total, 2, '.', '');
		if (number_format(abs($bt - $st), 2, '.', '') >= 0.01) {
			self::createBlToConsol('Import', 'Adjust', number_format($st - $bt, 2, '.', ''), 0, $billing, $this->parent,$this->getBrokerConsolNo());
		}
		$billing->refresh();
		$billing->calTotal();
		$billing->checkPaid();
		$billing->nolog = true;
		$billing->update('total', 'gst', 'status');

		if (!empty($this->args[1])) {
			$sync = $this->args[1];
		} else {
			$sync = false;
		}
		if ($billing->sync_xero == 0 || $sync) {
			$billings = [];
			$billings[$billing->billing_cref] = $billing->lines;
			Yii::import('application.controllers.BillingController');
			$bc = new BillingController('default');
			$bc->postXero($billings);

			$billing->refresh();
			if ($billing->status == 2) {
				$bc->postXero($billings, true);
			}
		} else {
			foreach ($billing->lines as $line) {
				if ($line->status == Billing::BILLING_STATUS_POSTED && $line->sync_xero == 1) continue;

				$line->status = Billing::BILLING_STATUS_POSTED;
				$line->sync_xero = 1;
				$line->update('status', 'sync_xero');
			}
		}
	}

	private function createBlForXero($billing, $si) {
		Yii::app()->name = 'TLA';
		$supplierInvoice  = $si->parent;
		$lines = $this->parent->lines;
		$dptArrs = SystemSetting::getInvoiceRegions();
		$total = [];
		$gst = [];
		$total_ex_gst = [];
		$hasDptIds =[];
		foreach ($dptArrs as $dptId => $region)
		{
			$total[$dptId] = [Invoice::DPMT_IMPORT=>0,Invoice::DPMT_3PL=>0,Invoice::DPMT_COURIER_SERVICE=>0];
			$gst[$dptId] = [Invoice::DPMT_IMPORT=>0,Invoice::DPMT_3PL=>0,Invoice::DPMT_COURIER_SERVICE=>0];
			$total_ex_gst[$dptId] = [Invoice::DPMT_IMPORT=>0,Invoice::DPMT_3PL=>0,Invoice::DPMT_COURIER_SERVICE=>0];
		}

		foreach ($lines as $key => $line)
		{
			if($key>100) continue;
			echo $key;
			$dptId = 106;
			if(empty($line->ref))
			{
				$total[$dptId][Invoice::DPMT_IMPORT]+= $line->amount;
				$gst[$dptId][Invoice::DPMT_IMPORT]+= $line->gst;
				$total_ex_gst[$dptId][Invoice::DPMT_IMPORT]+= $line->amount_ex_gst;
				continue;
			}
			$siLine = SiReconcileLine::model()->find('ref = :ref and rec_id = :rec_id',[':ref'=>$line->ref,':rec_id'=>554341]);

			if(empty($siLine->model)||$siLine->model=='ImParcel')
			{
				$p = Shipment::model()->with('consol')->find('ref = :ref and t.status!=100',[":ref"=>$line->ref]);
				if(!empty($p))
				{
					$dptId = $p->ddpt_id;
					if(!empty($p->consol))
					{
						$dptId = $p->consol->dpt_id;
					}
				}
				if(empty($dptId))
				{
					$dptId = 106;
				}
				$hasDptIds[$dptId] = $dptId;

				if(!empty($p)&&!empty($p->consol)&&$p->consol->is3PL())
				{
					$total[$dptId][Invoice::DPMT_3PL]+= $line->amount;
					$gst[$dptId][Invoice::DPMT_3PL]+= $line->gst;
					$total_ex_gst[$dptId][Invoice::DPMT_3PL]+= $line->amount_ex_gst;
				}elseif(!empty($p)&&$p->isTopCourierServiceDelivery(true))
				{
					$total[$dptId][Invoice::DPMT_COURIER_SERVICE]+= $line->amount;
					$gst[$dptId][Invoice::DPMT_COURIER_SERVICE]+= $line->gst;
					$total_ex_gst[$dptId][Invoice::DPMT_COURIER_SERVICE]+= $line->amount_ex_gst;
				}else
				{
					$total[$dptId][Invoice::DPMT_IMPORT]+= $line->amount;
					$gst[$dptId][Invoice::DPMT_IMPORT]+= $line->gst;
					$total_ex_gst[$dptId][Invoice::DPMT_IMPORT]+= $line->amount_ex_gst;
				}
			}else
			{
				$p = Shipment::model()->with('consol')->find('(ref = :ref or hbn = :ref) and t.status!=100',[":ref"=>$line->ref]);
				$dptId = 106;
				if(!empty($p))
				{
					$dptId = $p->ddpt_id;
					if(!empty($p->consol))
					{
						$dptId = $p->consol->dpt_id;
					}
				}else
				{
					$cn = Consol::model()->find('no = :no or awb=:no',[':no'=>$line->ref]);
					if(!empty($cn))
					{
						$dptId = $cn->dpt_id;
					}
				}
				$hasDptIds[$dptId] = $dptId;

				$glCode = empty($line->mdata['charge_code'])?"xx":$line->mdata['charge_code'];
				$chargeCode = Chargecode::model()->find('code = :code',[":code"=>$glCode]);
				if(empty($chargeCode))
				{
					$total[$dptId][Invoice::DPMT_IMPORT]+= $line->amount;
					$gst[$dptId][Invoice::DPMT_IMPORT]+= $line->gst;
					$total_ex_gst[$dptId][Invoice::DPMT_IMPORT]+= $line->amount_ex_gst;
				}else
				{
				    $total[$dptId][$chargeCode->dpmt]+= $line->amount;
					$gst[$dptId][$chargeCode->dpmt]+= $line->gst;
					$total_ex_gst[$dptId][$chargeCode->dpmt]+= $line->amount_ex_gst;
				}
			}

			print_r($total);
		}
		print_r($total);

		foreach ($hasDptIds as $key => $dptId) 
		{
			foreach ($total[$dptId] as $dpmt => $dpmtValue)
			{
				if(empty($dpmtValue)) continue;
				$gstType = 'INPUT';
				if(abs($gst[$dptId][$dpmt])<=0.01)
				{
					$gstType = 'EXEMPTEXPENSES';
				}
				$bl = BillingLine::model()->find('billing_id = :billing_id AND `desc` = :dpmt AND gst = :gst AND dpt_id = :dpt_id', [':billing_id' => $billing->id, ':dpmt' => $dpmt, ':gst' => $gstType,':dpt_id'=>$dptId]);
				if (empty($bl)) $bl = new BillingLine;
				$bl->billing_id = $billing->id;
				$bl->org_id = $billing->org_id;
				$bl->op_id = 0;
				$bl->link_id = 0;
				$bl->to_id = 0;
				$bl->billing_cref = $billing->billing_cref;
				$bl->dpt_id = $dptId;
				$bl->currency = $billing->currency;
				$bl->created = $billing->created;
				$bl->date = $billing->date;
				$bl->due = $billing->due;
				$bl->transaction_date = $billing->transaction_date;
				$bl->status = Billing::BILLING_STATUS_CONFIRM;
				$bl->gst = $gstType;
				$bl->accrual_amount = number_format($total_ex_gst[$dptId][$dpmt], 2, '.', '');
				$bl->actual_amount =number_format($total_ex_gst[$dptId][$dpmt], 2, '.', '');
				$bl->gst_amount = number_format($gst[$dptId][$dpmt], 2, '.', '');
				if ($dpmt == Invoice::DPMT_IMPORT) {
					$bl->desc = 'Import';
					$bl->type = BillingLine::BILLING_TYPE_IMPORT;
					$bl->dpmt = Invoice::DPMT_IMPORT;
					if (in_array($bl->org_id, Org::$couriers) || $si->type == 1) {
						$bl->charge_code = Consol::AU_LOCAL_DELIVERY_COST_GL_CODE;
					} else if (in_array($bl->org_id, Org::$brokers) || $si->type == 2) {
						$bl->charge_code = 91032;
					} else if (in_array($bl->org_id, Org::$airports) || $si->type == 3) {
						$bl->charge_code = 91030;
					} else {
						$bl->charge_code = !empty($si->lines) && !empty($si->lines[0]->mdata['charge_code']) ? $si->lines[0]->mdata['charge_code'] : '';
					}
				} else if ($dpmt == Invoice::DPMT_3PL) {
					$bl->desc = '3PL';
					$bl->type = BillingLine::BILLING_TYPE_3PL;
					$bl->dpmt = Invoice::DPMT_3PL;
					$bl->charge_code = Consol::DELIVERY_3PL_COST_GL_CODE;
				}else if ($dpmt == Invoice::DPMT_COURIER_SERVICE) {
					$bl->desc = 'Top Courier Service';
					$bl->type = BillingLine::BILLING_TYPE_TOP_COURIER_SERVICE;
					$bl->dpmt = Invoice::DPMT_COURIER_SERVICE;
					$bl->charge_code = Consol::DELIVERY_COURIER_SERVCE_COST_GL_CODE;
				}
				$bl->save();
				print_r($bl);


			}
		}
	}

	public function updateAuspostCogsLine()
	{
		$ts = Tranship::model()->findAll('org_id = :org_id AND cost != 0 AND man_id != 0 AND time >= "2021-06-01"', [':org_id' => Org::ORGID_COURIER_AUPOST]);

		$transaction=Yii::app()->db->beginTransaction();
		try {
			foreach ($ts as $t) 
			{
				if (preg_match('/AMQ/', $t->connote)) 
				{
					if (!empty($t->shipment)) 
					{
						$p = $t->shipment;
						$line = CogsLine::model()->find("charge_code = '91031' and item_code='item' and fid = :fid and model = 'ImParcel'",[":fid"=>$p->id]);
						foreach ($p->trans as $tran) {
							if ($tran->org_id == Org::ORGID_COURIER_AUPOST) {
								if(!empty($line))
								{
									$line->accrual_amount = $tran->cost;
									$line->accrual_gst_amount = number_format($tran->cost*0.1,2,'.','');
									$line->save();
									break;
								}
							}
						}
					}
				}
			}
			$transaction->commit();
		} catch (Exception $ex) {
			$transaction->rollback();
			throw $ex;
		}
	}

	public function refreshConsolCanAllTime()
	{
		$modelId = $this->prompt('ConsolId: ');
		$model=ImcoConsol::model()->findByPk($modelId);
		if(!empty($model->mdata["scanAllIng"]))
		{
			echo json_encode(['done'=>2]);
			return;
		}
		$model->mdata["scanAllIng"] = 1;
		$model->save();
		$st = strtotime($this->prompt('StartTime: '));
		$et = strtotime($this->prompt('endTime: '));
		$diff = $et - $st;
		$transaction=Yii::app()->db->beginTransaction();
		try {
			foreach ($model->shipments as $i => $p) {
				$scanTime = '';
			// scaned before , just ignore
				if ($p->type!=10) {
					continue;
				}
				if ($p->pkg < $p->getOutPkg()) {
					continue;
				}

				if($p->pkg > 1000){
					$pt = $st + rand(intval($diff/10), $diff);
					$p->scan_data[50]['SCAN_ALL'] = date('Y-m-d H:i:s', $pt);
				}else{
					for ($j = 1; $j <= $p->pkg; $j++) {

						$pt = $st + rand(intval($diff/10), $diff);
						$p->scan_data[50][$p->hbn.'-'.$j] = date('Y-m-d H:i:s', $pt);
						echo $p->scan_data[50][$p->hbn.'-'.$j];
						if(empty($scanTime)||strtotime($p->scan_data[50][$p->hbn.'-'.$j])<strtotime($scanTime))
						{
							$scanTime = $p->scan_data[50][$p->hbn.'-'.$j];
						}
					}
				}

				if(empty($p->mdata['scan_time'])||$p->mdata['scan_time']!=$scanTime)
				{
					$firstScanTime = '';
					if(!empty($p->scan_data[50]))
					{
						foreach ($p->scan_data[50] as $key => $value) {
							$firstScanTime = $value;
							break;
						}
					}
					if(strtotime($firstScanTime)<strtotime($scanTime))
					{
						$scanTime = $firstScanTime;
					}
					$p->mdata['scan_time'] = $scanTime;
					$p->updateDeconsolidationTime(false,false,true);
				}
				$p->save();
				$courier_id = null;
				if (empty($courier_id)) 
				{
					$courier_id=$p->getCourierId();
				}
				$action = "ScanAllByHand";
				GatepassShipment::gatepassScan($p, $courier_id, 1, $p->consol->dpt_id,$action);
			}
			$transaction->commit();
		} catch (Exception $ex) {
			$model->mdata["scanAllIng"] = 0;
		    $model->save();
			$transaction->rollback();
			throw $ex;
		}

		$model->mdata["scanAllIng"] = 0;
		$model->save();
		echo json_encode(['done'=>1]);
	}

	public function getShipmentByBarcode()
	{
		$hbns = ['TCN3103004449','TMN3103004470','TMN3103004460','TMN3103004458','TMN3103004451','TMN3103004450','TMN3103004469','TMN3103004468','TMN3103004467','TMN3103004466','TMN3103004465','TMN3103004464','TMN3103004463','TMN3103004462','TMN3103004461','TMN3103004457','TMN3103004456','TMN3103004455','TMN3103004448','TMN3103004459','TMN3103004453','TMN3103004452','202104260929','202104281698','MW-MEL-851303','AXMEL000979','AXMEL000980','AXMEL000981'];
		foreach ($hbns as $key => $hbn) {
			$p = ImParcel::model()->find("hbn =:hbn",[":hbn"=>$hbn]);
			echo $p->hbn."|";
			if(!empty($p->trans))
			{
				$org_id = $p->trans[0]->org_id;
				print_r($p->getParcelLongRef($org_id,true));
			}
			echo PHP_EOL;
		}
	}

	public function changeShipmentTime()
	{
		$shipments = ImParcel::model()->findAll(' ref in ("PICKUP0832550","PICKUP0682454","PICKUP0717770","PICKUP1095257","PICKUP1217909","PICKUP0998801","PICKUP1331768","PICKUP1417484","PICKUP1160120","PICKUP1716296","PICKUP1799345","PICKUP1661660")');
		foreach ($shipments as $key => $p)
		{
			$t = Tracking::model()->find('pid =:pid and type = 60',[":pid"=>$p->id]);
			if(!empty($t))
			{
				$newTime = date("Y-m-d H:i:s",strtotime('+24 hours',strtotime($t->dt)));
				$nt = explode(' ', $newTime);
				$gs = GatepassShipment::model()->findAll('fid =:fid',[":fid"=>$p->id]);
				foreach ($gs as $key => $g) {
					$gt =  explode(' ', $g->gate_pass_time);

					$g->gate_pass_time = $nt[0].' '.$gt[1];
					echo $g->gate_pass_time;
					$g->save();
				}
				$d = Tracking::model()->find('pid =:pid and type = 90',[":pid"=>$p->id]);
				if(!empty($d))
				{
					$d->dt = $g->gate_pass_time;
					$d->save();
					$gc = GatepassCourier::model()->findByPk($g->parent_id);
					$gc->create_time = $d->dt;
					$gc->save();
				}
				$h = Tracking::model()->find('pid =:pid and type = 68',[":pid"=>$p->id]);
				if(!empty($h))
				{
					$h->dt = $g->gate_pass_time;
					$h->save();
				}
			}
		}
	}

	public function eeee()
	{
		  $getTime = date('Y-m-d H:i:s',strtotime('-4 hours'));
        $rs = Tranship::model()->with(['shipment'])->findAll(['condition'=>'t.status IN (11,19) AND org_id IN (:eizId) AND time < :getTime','params'=>[":eizId"=>Org::ORGID_COURIER_ALLIED,":getTime"=>$getTime],"order"=>'t.id desc']);
        $data = [];
        foreach ($rs as $key => $r)
        {
           $data[] = [$r->connote,$r->shipment->postcode];
        }
        return $data;
	}

