	public function combineToll()
	{
		$zoneMap = ZoneMap::model()->findAll('org_id = 3079 and zone_id = 8');
		$finalData = [];
		foreach ($zoneMap as $key => $value) {
			if(!empty($finalData[$value->z1]))
			{
				$finalData[$value->z1] .= ",".$value->pc_hi;
			}else
			{
				$finalData[$value->z1] = $value->pc_hi;
			}
		}
		$xlsave = new oExcel;
		$xlsave->addRow(1, ["zone","zone name","postcode"]);
		$start = 2;
		foreach ($finalData as $key => $value) {
			$getData = $this->combinePostcode($value);
			$xlsave->addRow($start++, [$key,$key,$getData]);
		}
		$xlsave->output('D:\handleData\ubi_border_combine.csv', null, false);
	}

	public function combinePostcode($postcodeStr)
	{
		$postcodeArr = explode(',', $postcodeStr);
		$postcodeArr = array_unique($postcodeArr);
		foreach ($postcodeArr as $key => &$value) {
			$value = str_pad(trim($value),4,0,STR_PAD_LEFT);
		}
		sort($postcodeArr);
				echo join(',',$postcodeArr)."\n";
		$result = [];
		$size = count($postcodeArr);
		$thisResult =[];
		if($size==1)
		{
			$result = $postcodeArr;
		}
		for ($key=0; $key <= ($size-2); $key++) { 

			if(($postcodeArr[$key]+1)!=$postcodeArr[$key+1])
			{
				$thisResult[] =  $postcodeArr[$key];
				if(count($thisResult)==1)
				{
					$result[] = $thisResult[0];
				}else
				{
					$result[] = $thisResult[0].'-'.$thisResult[count($thisResult)-1];
				}
				$thisResult =[];
			}else
			{
				$thisResult[] = $postcodeArr[$key];
				if($key==$size-2)
				{
					$thisResult[] =  $postcodeArr[$key+1];
				}
			}

			if($key==$size-2)
			{
				if(count($thisResult)==1)
				{
					$result[] = $thisResult[0];
				}else if(count($thisResult)>1)
				{
					$result[] = $thisResult[0].'-'.$thisResult[count($thisResult)-1];
				}

				if(($postcodeArr[$key]+1)!=$postcodeArr[$key+1])
				{
					$result[] =  $postcodeArr[$key+1];
				}
			}
		}
		return join(',',$result);
	}


