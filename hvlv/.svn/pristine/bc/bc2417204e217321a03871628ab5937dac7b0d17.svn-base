	public function generateGatepassCourier()
	{
		$dates = ['2022-01-05 14:01:31','2022-01-05 14:01:20','2022-01-07 11:19:31','2022-01-07 11:19:31','2022-01-11 19:11:44'];

		foreach ($dates as $key => $theDay)
		{
			$day = explode(' ', $theDay)[0];
			$time =  explode(' ', $theDay)[1];
			$afterDays = HolidayHelper::getDateByBusinessDays(106,$day,1,1);
			$theTime = $afterDays." ".rand(10,15).":".rand(10,59).":".rand(10,59);
			$myGatepassCourier = GatepassCourier::model()->find(['condition'=>'driver_name = "3pl" and driver_rego = "000000" and courier_id = 0 and json_value(meta,"$.ocourier_id")="TP" and json_value(meta,"$.is_tp")="TP" and date_format(create_time,"%Y-%m-%d")="'.$afterDays.'" ']);

			if(empty($myGatepassCourier))
			{
				$checkGatepassCourier = GatepassCourier::model()->find(['condition'=>'date_format(create_time,"%Y-%m-%d")>="'.$afterDays.'" ','order'=>'id asc']);
				$thisId = 0;
				while(1)
				{
					if(empty($checkGatepassCourier))
					{
						break;
					}
					$thisId = $checkGatepassCourier->id+1;
					$checkGatepassCourier = GatepassCourier::model()->findByPk($thisId);
				}

				$myGatepassCourier = new GatepassCourier();
				if(!empty($thisId))
				{
					$myGatepassCourier->id = $thisId;
				}
				$myGatepassCourier->courier_id = 0;
				$myGatepassCourier->type = 0;
				$myGatepassCourier->driver_name = '3pl';
				$myGatepassCourier->driver_rego = '000000';
				$myGatepassCourier->ref = '';

				$myGatepassCourier->create_time = $theTime;//rand(13,18).":".rand(10,59).":".rand(10,59);
				$myGatepassCourier->status = 0;
