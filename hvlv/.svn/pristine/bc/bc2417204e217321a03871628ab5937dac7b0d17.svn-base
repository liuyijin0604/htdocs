	public function fixSupplierInvoiceToCogsLine()
	{
		$siReconciles = SiReconcile::model()->with('parent')->findAll("json_value(parent.meta,'$.template') = 'TLD-supplier' and confirm_status = 16 ");
		foreach ($siReconciles as $key => $siReconcile)
		{
			foreach ($siReconcile->lines as $key => $line)
			{
				$line->confirm_status = 1+2+4+8;
				$line->update(['confirm_status']);
			}

			$dpmts = SiReconcileDpmt::model()->findAll("si_reconcile_id = :sid",[":sid"=>$siReconcile->id]);
			if(empty($dpmts))
			{
				$reconcileService = new ReconcileService();
				$result = $reconcileService->linkBilling($siReconcile,10);
			}else
			{
				foreach ($dpmts as $key => $dpmt) {
					$reconcileService = new ReconcileService();
					$result = $reconcileService->linkBilling($siReconcile,$dpmt->dpmt);
				}
			}
		}
	}

