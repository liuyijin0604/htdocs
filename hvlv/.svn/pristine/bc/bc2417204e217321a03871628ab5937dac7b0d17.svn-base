			foreach ($data as $key => $d) {
				if($key>=8&&!empty($d[1])&&is_numeric($d[1]))
				{
					if($key==8)
					{
						$row[] = "0.000-".$d[1];
					}else
					{
						$row[] = ($data[$key-1][1]+0.001)."-".$d[1];
					}
					$row[] = "";
					$row[] = "";
					$row[] = "";
					$row[] = "";
				}
			}	
			$rowArr[] = $row;
		}
