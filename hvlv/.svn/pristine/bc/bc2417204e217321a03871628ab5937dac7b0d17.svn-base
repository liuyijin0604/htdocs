	public function cleanData()
	{
		$sql = 'SELECT id from for_delete2';
		$pids = $this->db->createCommand($sql)->queryAll();
		foreach ($pids as $k1 => $d) {
			$sql = "SELECT id from tracking where pid = ".$d['id']." and type = 60 and depot = 'BANKSTOWN AERODROME'";
			$datas = $this->db->createCommand($sql)->queryAll();
			$transaction=Yii::app()->db->beginTransaction();
			try 
			{

				foreach ($datas as $k2 => $v)
				{
					if($k2==0) continue;
					$t = Tracking::model()->findByPk($v['id']);
					$t->delete();
				}
				echo $d['id'];

				$transaction->commit();
			} catch (Exception $ex) {
				$transaction->rollback();
				throw $ex;
			}
		}

	}

