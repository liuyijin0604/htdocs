	public function checkConsolInvoiceStatus()
	{
		$consolNo = $this->prompt('Consol Number: ');
		$consol = Consol::model()->find(' no = :no',[":no"=>$consolNo]);
		$errors = [];
		if (empty($selectedOrg)|| in_array(1206, $selectedOrg)) {
			$errors=$consol->genDirectInvoice();
		}
		if (!empty($errors)) {
			print_r($errors);
		}
		// create invoice based on chargeable or AWB weight
		$awb_wt = 0.0;
		$cgb_wt = 0.0;
		if (isset($consol->mdata['awb_wt'])) {
			$awb_wt = floatval($consol->mdata['awb_wt']);
		}
		if (isset($consol->mdata['cgb_wt'])) {
			$cgb_wt = floatval($consol->mdata['cgb_wt']);
		}
		if ($awb_wt > 0.0 || $cgb_wt > 0.0) {
			// because multiple orgs in console
			// we need to create invoice for each org
			// following the below steps
			// step 1
			// split shipments by Org
			$orgShipments = [];
			foreach ($consol->shipments as $shipment) {
				//if cancelled,not calculate the cost
				if ($shipment->status==100) {
					continue;
				}
				if (!isset($orgShipments[$shipment->agent->id])) {
					$orgShipments[$shipment->agent->id] = [
						'owner' => $shipment->agent,
						'shipments' => []
					];
				}
				$orgShipments[$shipment->agent->id]['shipments'][] = $shipment;
			}

			foreach ($orgShipments  as $id =>  $org) {
				/*
				 * need to delete when the busines logic change, followed by Christy
				 */
				if ($id==1247) {//for ausi river
					if (empty($consol->mdata['org_1247']['cgb_wt'])) {
						continue;
					}
				}
				/*
				 * need to delete when the busines logic change, followed by Christy
				 */
				if (!empty($selectedOrg)) {
					if (!in_array($id, $selectedOrg)) {
						continue;
					}
				}
				$owner = $org['owner'];
				// check to see if we should including GST (default 10%)
				$includingGST = false;
				if (isset($owner->extra['incl_gst']) && $owner->extra['incl_gst'] == 1) {
					$includingGST = true;
				}

				// if existing or not checking
				$inv = null;
				$oldPaymentsList = [];
				$oldInv=null;
				$to_id = $owner->by >1? $owner->by : $owner->id;
				$invoices= Invoice::model()->with('lines')->findAll('type = 10 AND to_id = :id AND lines.model = :m AND lines.fid = :fid AND status in (1,2,3,6,7,9)', [':id' => $to_id, ':m' => 'ImcoConsol', ':fid' => $consol->id]);
				if (sizeof($invoices)>1) {
					$errors[] = 'Console invoice ' . $invoices[0]->no . 'has errors, please contact account for more[901]';
					continue;
				}
				$inv= Invoice::model()->with('lines')->find(['order'=>'t.id DESC','condition'=>'type = 10 AND to_id = :id AND lines.model = :m AND lines.fid = :fid','params'=>[':id' => $to_id, ':m' => 'ImcoConsol', ':fid' => $consol->id]]);
				if (!empty($inv)) {
					if (in_array($inv->status, [Invoice::INVOICE_STATUS_PAID, Invoice::INVOICE_STATUS_PAID_PARTLY_CREDIT]) && !Acl::hasAccess('B:invoice/paidInvoiceCredit')) {
						$errors[] = 'Console invoice ' . $inv->no . 'has been paid before, please contact account for more';
						continue;
					}
					if ($inv->isInvoiceClosed() && ($inv->status < Invoice::INVOICE_STATUS_PAID || ($inv->status == Invoice::INVOICE_STATUS_PAID && Acl::hasAccess('B:invoice/paidInvoiceCredit')))) {
						// in case invoice frozen and create credit for it
						$oldInv=$inv; //store inv  and created credit to it when we successfully create a new invoice;
							
						// create a new invoice the for this month
						$invRef = 'Original Invoice : ' . $inv->no;
						$oldInvoiceNo = $inv->no;
						//TODO
					}
				}
				// if not existing or not pending(1) or posted(2) or overdue(3) we create a new one
				$isUpdate = true;

				// try to get org price rate
				$orgRate = OrgRate::model()->find('org_id = :oid AND type = 40', [':oid' => $owner->id]);
				if (empty($orgRate)) {
					//  $errors[] = 'Owner: ' . $owner->id . ' price rate is not available yet';
					$inv->currency = 1; // default as AUD
				} else {
					$inv->currency = $orgRate['currency'];
				}

				// calculate price based on awb weight
				$items = [];

				// create invoice based on chargeable
				// 1.	Customs Declaration*  AUD85
				//  2.	Airline Document Fee *  AUD50
				// 3.	CMR Fee *  AUD15
				// 4.	Airline Terminal Fee ^  $0.50/kg
				// 5.	Airline Breakbulk Fee^  $0.1/kg
				// 6.	Delivery Fee^   $0.2/kg
				// 7.	Customs Duties & Fees
				$tot = 0;

				// get rate returned as [kg_rate, pc_rate,fixedRates,includingDelivery, airfreightRates]
				$rate = $consol->getChargeRate($owner);

				// in case need to charge for Australia local delivery fee
				if ($rate[3]) {
					$shipments = $org['shipments'];
					$result = $consol->genShipmentsInvoicePro($owner, $orgRate, $shipments);
					print_r($result);
					if ($result[0] > 0) {
						$tot = $result[0];
						$items = $result[1];
					}
					foreach ($shipments as $theShipment) {
						if (!empty($theShipment->tempErrors)) {
							$errors[]=$theShipment->tempErrors;
						}
					}
				}

				$extendsFee = $consol->calculateInvoiceExtendFee($inv,$items,$owner,$tot,$errors);//this only used for seaconsol in imcoconsol
				$items = $extendsFee['items'];
				$inv = $extendsFee['inv'];
				$owner = $extendsFee['owner'];
				$tot = $extendsFee['tot'];
				$errors = $extendsFee['errors'];

				if (!empty($errors)) {
					print_r( $errors);
				}

				// for local australia charge
				$showDetails = 0;
				if (isset($rate[2]) && isset($rate[2]['showdetails'])) {
					$showDetails = $rate[2]['showdetails'];
				}
				$totWeight = 0;
				if ($showDetails) {
					foreach ($org['shipments'] as $shipment) {
						//skip ausriver with chargecode
						if ($id == 1247 && !empty($consol->mdata['charge_code'])) continue;
						$single = $rate[0] * $shipment->weight + $rate[1];
						$totWeight += $shipment->weight;
						//  return array($amt, 0, $kg_rate, $this->weight);
						if ($single > 0) {
							$items[] = [$shipment->hbn, 'Australia Local Charge Fee', 1, $shipment->weight, 0, $single, 0, $rate[0], $shipment->weight];
							$tot += $single;
						}
					}
				} else {
					$org_awb_wt = $cgb_wt;
					if (!empty($consol->mdata['org_'.$id]['cgb_wt'])){
						$org_awb_wt = floatval($consol->mdata['org_'.$id]['cgb_wt']);
					} else {
						$orgs = $consol->getOrgsInfo();
						foreach ($orgs as $oid => $v) {
							$org_awb_wt -= floatval(@$consol->mdata['org_'.$oid]['cgb_wt']);
						}
					}
					$localFee = floatval($rate[0]) * $org_awb_wt + floatval($rate[1]);
					//  return array($amt, 0, $kg_rate, $this->weight);
					if ($localFee > 0) {
						$items[] = [$consol->awb, 'Australia Local Charge Fee', 1, $org_awb_wt, 0, $localFee, 0, $rate[0], $org_awb_wt];
						$tot += $localFee;
					}
				}

				// for air freight charge
				if (!empty($rate[4]) && $rate[4]['rate'] > 0) {

					// in case no real weight , we need to calculate again here
					if ($totWeight <= 0) {
						foreach ($org['shipments'] as $shipment) {
							$totWeight += $shipment->weight;
						}
					}

					if(count($orgShipments) == 1){
						$cw = $cgb_wt;
					}elseif(isset($consol->mdata['org_'.$id]) && isset($consol->mdata['org_'.$id]['cgb_wt'])) {
						$cw = $consol->mdata['org_'.$id]['cgb_wt'];
					}

					if ($cw > 0) {
						$extraAmount =  $rate[4]['rate'] * $cw;
						$tot += $extraAmount;
						$items[] = ['Chargeable Weight', 'Air Freight', 1,$cw, 0, $extraAmount, 0, $rate[4]['rate'],$cw];
					}
				}

				// append another fixed fee
				// for example : DOC fee, THC fee, DLV fee and SAC fee
				$fixdRates = $rate[2];
				$packages = count($org['shipments']);

				// document fee, calculate by per AWB document
				if (isset($fixdRates['doc_rate']) && $fixdRates['doc_rate'] > 0) {
					$docRate = round($fixdRates['doc_rate'], 2);
					$tot += $docRate;
					$items[] = ['DOC', 'DOC Fee', 1, 0, 0, $docRate, 0, $docRate, 0];
				}
				// CMR FEE
				if (isset($fixdRates['crm_rate']) && $fixdRates['crm_rate'] > 0) {
					$cmrRate = round($fixdRates['crm_rate'], 2);
					$tot += $cmrRate;
					$items[] = ['CMR', 'CMR Fee', 1, 0, 0, $cmrRate, 0, $cmrRate, 0];
				}
				// THC fee, calculate by Chargable weight
				if (isset($fixdRates['thc_rate']) && $fixdRates['thc_rate'] > 0 && $cgb_wt > 0) {
					$thcRate = round($fixdRates['thc_rate'] * $cgb_wt, 2);
					$tot += $thcRate;
					$items[] = ['THC', 'THC Fee', $packages, $cgb_wt, 0, $thcRate, 0, $fixdRates['thc_rate'], 0];
				}

				// DLV fee, calculate by awb weight
				if (isset($fixdRates['dlv_rate']) && $fixdRates['dlv_rate'] > 0 && $awb_wt > 0) {
					$dlvRate = round($fixdRates['dlv_rate'] * $awb_wt, 2);
					$tot += $dlvRate;
					$items[] = ['DLV', 'Delivery Charge', $packages, $awb_wt, 0, $dlvRate, 0, $fixdRates['dlv_rate'], 0];
				}

				// Michelle approve calculate by Chargable weight
				// SAC fee, calculate by awb weight and piece
				if (isset($fixdRates['sac_rate']) && $fixdRates['sac_rate'] > 0 && $cgb_wt > 0) {
					$sacRate = round($fixdRates['sac_rate'] * $cgb_wt + $fixdRates['sac_prate'] * $packages, 2);
					$tot += $sacRate;
					$items[] = ['SAC', 'SAC Scan Fee', $packages, $cgb_wt, 0, $sacRate, 0, $fixdRates['sac_rate'], 0];
				}

				//Nz service not include gst
					
				if (preg_match('/C\d{8}NZ/i', $consol->no)) {
					$includingGST=false;
				}
				
				// if including GST we add GST
				$gst = 0;
				if ($includingGST) {
					$gst = round($tot * 10 / 100, 2);
					$tot += $gst;
				}

			}
		} else {
			$errors[] = 'Please set console AWB weight and Chargeable weight firstly';
		}

		return $errors;
	}

	public function getChargePro2()
	{
		$shipmentNo = $this->prompt('Shipment Number: ');
		$orgRateId = $this->prompt('OrgRate: ');
		$orgRate = OrgRate::model()->findByPk($orgRateId);
		$ownerId = $this->prompt('Owner: ');
		$owner = Org::model()->findByPk($ownerId);
		$shipment = ImParcel::model()->find(' ref = :ref',[":ref"=>$shipmentNo]);
		$amt= $shipment->getChargePro($owner,$orgRate);
		print_r($amt);
	}
	public function getChargePro()
	{
		$shipmentNo = $this->prompt('Shipment Number: ');
		$orgRateId = $this->prompt('OrgRate: ');
		$orgRate = OrgRate::model()->findByPk($orgRateId);
		$ownerId = $this->prompt('Owner: ');
		$owner = Org::model()->findByPk($ownerId);
		$shipment = ImParcel::model()->find(' ref = :ref',[":ref"=>$shipmentNo]);
			// get org rate details
		$rateInfo = json_decode($orgRate['meta']);

		// based on basic selected service to calculate the price
		$allServices = OrgRate::getServiceTypes();
		$kg_rate = 0.0; // price rate by kg
		$pc_rate = 0.0; // price rate by piece
		$aupost_rates = [];
		foreach ($allServices as $code => $name) {
			if ($code == 'AU') {
				continue;
			}

			if (!in_array($code, ['DR', 'FR'])) {
				// for local delivery service , we need to calculate price by Australia post price rate
				if ($rateInfo->$code->selected == 1) {
					$kg_rate += floatval($rateInfo->$code->rate);
					if (isset($rateInfo->$code->prate)) {
						$pc_rate += floatval($rateInfo->$code->prate);
					}
				}
			} else {
				// for Australia delivery price
				// if ( $rateInfo->$code->selected == 1 )  // even not selected maybe client select delivery service
				{
					$aupost_rates = $rateInfo->$code; // get BPA, eParcel,Letters extra rate
				}
			}
		}

		// check to see if shipment has delivery service
		$deliveryRate = 0.0;

		// 0 - nothing
		// 1 - service for eParcel
		// 2 - service for BPA
		// 3 - service for Letters

		//we need to check if we charge by pure weight or chargeable weight based on chargecode here.

		$myWeight = $shipment->chargeWeight();
		if (!isset($shipment->mdata['chargecode'])) {
			$chargecode = '';
		} else {
			$chargecode = $shipment->mdata['chargecode'];
		}
	
		$deliveryServiceType = 1; // default all import parcel set as eParcel
		if (isset($shipment->mdata['delivery_service'])) {
			$deliveryServiceType = intval($shipment->mdata['delivery_service']);
		}

		if (!empty($chargecode)) {
			$chargecodeInfo = ImportChargeCode::model()->find('chargecode = :cid', [':cid' => $chargecode]);
			if (!empty($chargecodeInfo)) {
				if (!empty($chargecodeInfo->charge_wt)) {
					$myWeight = $shipment->weight;
				}
				if(!empty($chargecodeInfo->mdata['no_courier'])){
					$deliveryServiceType = 0;
				}
			}
		}

		echo $deliveryServiceType;

		switch ($deliveryServiceType) {
			case 1:
				$deliveryRate = $shipment->getRateByEParcel($aupost_rates, $owner);
				print_r($deliveryRate);
				echo "xxxx";
				break;
			case 2:
				$deliveryRate = $shipment->getRateByBPA($aupost_rates, $owner);
				break;
			case 3:
				// in case weight more than 500g , you shouldn't use letters
				// default we change to BPA automatically
				if ($myWeight > 0.5) {
					$deliveryRate = $shipment->getRateByBPA($aupost_rates, $owner);
				} else {
					$deliveryRate = $shipment->getRateByLetters($aupost_rates, $owner);
				}
			break;
			case 0:
				$kg_rate = 0;
				$pc_rate = 0;
				$deliveryRate = 0;
			break;
		}

		//this is used for break weight charge to record the final charge weight;
		if (!empty($shipment->tempChargeweight)) {
			$myWeight = $shipment->tempChargeweight;
		}

		// calculate total amount
		echo $kg_rate."kg_rate";
		echo $myWeight."myWeight";
		echo $pc_rate."pc_rate";
		echo $deliveryRate."deliveryRate";
		echo $shipment->pkg."pkg";

		$amt = $kg_rate * $myWeight + $pc_rate * intval($shipment->pkg) + $deliveryRate;
		echo $amt;
		// round to 2 decimal
		$amt = round($amt, 2);
		$amt = [$amt, 0, $kg_rate, $myWeight];


		print_r($amt);
	}




	public function checkImInvoice(){
		$cid = $this->prompt('Client ID: ');
		$rs = Invoice::model()->findAll('status < 4 AND type = 10 AND to_id = :id  and date like "%2019-08%" ', [':id' => $cid]);
		$orgRate = OrgRate::model()->find('type=40 and org_id=:oid', [':oid' => $cid]);
		$owner = Org::model()->findByPk($cid);

		foreach($rs as $r){
			$ok = true;
			foreach($r->lines as $l){
				$tt = 0;
				foreach($l->mdata['items'] as $i => $itm){
					$p = ImParcel::model()->find('(hbn = :n OR ref = :n) AND agent_id = :cid', [':n' => $itm[0], ':cid' => $cid]);
					if(empty($p)){
						echo $itm[0].' not found', PHP_EOL;
					}else{
						$amt = $p->getChargePro($owner, $orgRate);
						if($amt[0] != $itm[5]){
							//echo $itm[0].': '.$itm[5].' != '.$amt[0], PHP_EOL;
							$l->mdata['items'][$i][5] = $amt[0];
							$ok = false;
						}
						$tt += $amt[0];
					}
				}
				if($tt != $l->amount){
					//echo $r->no.' line total '.$l->amount.' => '.$tt,PHP_EOL;
					$l->amount = $tt;
					$l->qty = 1;
					$l->save();
				}
			}
			if($ok){
				echo $r->no.' OK', PHP_EOL;
			}else{
				$oamt = $r->total;
				$r->getTotal();
				$r->save();
				echo $r->id.' '.$r->no.' '.$oamt.' => '.$r->total.' updated', PHP_EOL;
			}
		}
	}
	public function checkScan()
	{
		$scan_data = json_decode('{"50":{"KM201907221044-SYD-1":"2019-08-19 08:28:36","KM201907221044-SYD-2":"2019-08-19 08:31:15","KM201907221044-SYD-3":"2019-08-19 08:28:47","KM201907221044-SYD-4":"2019-08-19 08:32:35","KM201907221044-SYD-5":"2019-08-19 08:33:34","KM201907221044-SYD-6":"2019-08-19 08:35:35","KM201907221044-SYD-7":"2019-08-19 08:34:36","KM201907221044-SYD-8":"2019-08-19 08:41:01","KM201907221044-SYD-9":"2019-08-19 08:36:05","KM201907221044-SYD-10":"2019-08-19 08:33:22","KM201907221044-SYD-11":"2019-08-19 08:34:10","KM201907221044-SYD-12":"2019-08-19 08:46:59","KM201907221044-SYD-13":"2019-08-19 08:42:50"}}',true);
		$ref = 'S00001715';
		$hbn = 'KM201907221044-SYD';
		$cref = '';
		$sns = [];
		foreach ($scan_data['50'] as $bc => $t) {
			if (preg_match('/^T\d{6}(' . TollAPI::TOLL_SLID . '|' . TollAPI::TOLL_SLID_OFFPEAK . ')\d{10}/', $bc, $m)) { //Toll
				$sn = substr($m[0], 17, 3);
			} elseif (preg_match('/^(7RFZ|4XHZ)\d{8}' . StarTrackAPI::API_PRODUCT_ID . '\d{5}/', $bc, $m)) { //StarTrack
				$sn = substr($m[0], 15, 5);
			} elseif (preg_match('/^99700160([A-Z]{3})\d{18}/', $bc, $m)) { //eparcel legacy
				$sn = substr($m[0], 18, 2);
			} elseif (preg_match('/^019931265099999891(\w{3,5}\d{7})(\d{11})(\d{23})?$/', $bc, $m)) { //eparcel 2d
				$sn = substr($m[2], 0, 2);
			} elseif (preg_match('/^' . str_replace('/', '', $ref) . '(\d{3})$/', $bc, $m)) { // TNT translated
				$sn = $m[1];
			} elseif (preg_match('/^CP[A-Z]{5}\d{7}(\d{3})$/', $bc, $m)) { //couriers please
				$sn = $m[1];
			} elseif (preg_match('/^SCAU\d{8}(\d{3})\d{3}$/', $bc, $m)) { //saicheng
				$sn = $m[1];
			} elseif (preg_match('/^(ZV|PB|DQ)\d{6}(\d{3})\d{7}$/', $bc, $m)) {	//hunter express
				$sn = $m[2];
			} else if (preg_match('/^QS\d{3}-\w*-(\d{1,3})$/', $bc, $m)) { // master logistic
				$sn = $m[1];
			} else if ($bc == $ref || $bc == $hbn || $bc == $cref) {
				$sn = 1;
			} else {
				if (preg_match('/-\d+$/', $bc)) {
					$thisList = explode('-', $bc);
					if(sizeof($thisList)>2)
					{
						$hbn = $thisList[0];
						$sn = end($thisList);
					}else
					{
						list($hbn, $sn) = explode('-', $bc);
					}
				} else {
					continue;
				}
			}
			$sns[] = ltrim($sn, 0);
		}
		print_r($sns);
		print_r(array_unique($sns));
		return count(array_unique($sns));
	}

