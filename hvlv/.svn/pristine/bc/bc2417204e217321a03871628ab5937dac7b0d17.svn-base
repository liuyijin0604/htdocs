	public function handleFastwayData()
	{
		$xls = new oExcel('CSV');
		$xls->load('D:\handleData\TSS File 01-Aprl-2020.csv');
		$data = $xls->getAll();
		unset($data[1]);
		$zoneArray = [];
		$zones = array_column($data, 5);
		$zones = array_unique($zones);
		foreach ($zones as $key => $zone) {
			if(!empty($zone))
			{
				$zoneArray[$zone]=["zone"=>trim($zone)];
			}
		}
		
		$xlsave = new oExcel;
		$xlsave->addRow(1, ["zone","zone name","postcode"]);
		$start = 2;
		foreach ($zoneArray as $key => &$value) 
		{
			foreach ($data as $key => $d) 
			{
				if(!empty($d[5])&&trim($d[5])==$value['zone'])
				{
					$value["postcode"][] = $d[2];
				}
			}
			$value["postcode"] = array_unique($value["postcode"]);
			$value["postcode"] = join(',',$value["postcode"]);
			$value["postcode"] = $this->combinePostcode($value["postcode"]);
			$xlsave->addRow($start, [$value["zone"],$value["zone"],$value["postcode"]]);
			$start++;
		}
		$xlsave->output('D:\handleData\new_fastway_zone.csv', null, false);
		print_r($zoneArray);

		$postcodes = array_column($data, 2);
		$postcodes = array_unique($postcodes);
		$suburbArr = [];
		foreach($postcodes as $key => $ps) 
		{
			if(!empty($ps))
			{
				$suburbArr[$ps] = [];
				foreach ($data as $key => $d) 
				{
					if(!empty($d[2])&&trim($d[2])==$ps)
					{
						$suburbArr[$ps][] = $d[1];
					}
				}
			}
		}
		ksort($suburbArr);
		echo json_encode($suburbArr);
	}

