	public function fixDFEShipmentsGatepass()
	{
		$shipments = Shipment::model()->findAll('status < 100 and ot_id = 10 and consol_id > 0');
		if (!empty($shipments))
		{
			foreach($shipments as $s)
			{
				$courier_id = null;
				$courier_id=$s->getCourierId();
				$action = "3PL Auto";
				GatepassShipment::gatepassScan($s, $courier_id, 1, $s->consol->dpt_id,$action);
			}
		}
	}

