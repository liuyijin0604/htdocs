			$customers = [];
			$sql = "SELECT distinct(agent_id) as agent_id from shipment_archive where consol_id = ".$consol->id;
			$data = Yii::app()->db->createCommand($sql)->queryAll();
			foreach ($data as $k2 => $value) {
				$customers[] = Org::model()->findByPk($value['agent_id'])->name;
