		unset($data1[1]);

		foreach ($data1 as $key => $d1)
		{
			$remoteCostData = RemoteChargeRate::model()->findAll('rate_id =:rateId and (postcode=:postcode or CONCAT("0",postcode)=:postcode) and UPPER(suburb) = :suburb',[":rateId"=>1007,":postcode"=>$d1[3],":suburb"=>strtoupper($d1[4])]);
			if(empty($remoteCostData))
			{
				unset($data1[$key]);
			}
		}


		$xlsave = new oExcel;
		$xlsave->addRow(1, ["zone","zone name","postcode","suburb","state"]);
		$start = 2;
		foreach ($data1 as $key => &$d) 
		{
			$xlsave->addRow($start, [$d[1],$d[2],$d[3],$d[4],$d[5]]);
			$start++;
		}
		$xlsave->output('D:\handleData\toll_zone_remote.csv', null, false);


