	public function getAuspostManifestTime()
	{
		 $date = $this->prompt('Date(*): ');

		$transaction=Yii::app()->db->beginTransaction();
		try 
		{
			$log_dir = Yii::app()->basePath.DIRECTORY_SEPARATOR.'runtime'.DIRECTORY_SEPARATOR.'auspost'.DIRECTORY_SEPARATOR;
			$t = [0,0,0];
			foreach(glob($log_dir.'auspost_api_'.$date.'.log') as $f){
				$time = preg_match('/\d{4}-\d{2}-\d{2}/', $f,$m);

				$ls = file($f);
				foreach($ls as $l){
					if(preg_match('/^Response: \{"order":\{"order_id":"AP/', $l)){ //order response
						$r = json_decode(trim(substr($l, 10)), true);
						$mani = Manifest::model()->find('type = 90 and ref = :ref',[':ref'=>$r['order']['order_id']]);
						if(empty($mani))
						{	
							$mani = new Manifest();
							$mani->type = 90;
							$mani->created = $m[0]." 23:59:01";
							$mani->ref = $r['order']['order_id'];
						}else
						{
							$mani->created = $m[0]." 23:59:01";
						}

						if(!$mani->save())
						{
							print_r($mani);
							return;
						}

						foreach($r['order']['shipments'] as $s){
							$p = ImParcel::model()->find('hbn = :n', [':n' => $s['shipment_reference']]);
							if(empty($p))
							{
								echo $s['shipment_reference'], ' not found!', PHP_EOL;
								continue;
							}

							$maniMap = ManiMap::model()->with(['manifest'])->find("manifest.type = 90 and model = 'ImParcel' and fid = :fid",[":fid"=>$p->id]);
							if(empty($maniMap))
							{
								$maniMap = new ManiMap();
							}

							$maniMap->mani_id = $mani->id;
							$maniMap->model = 'ImParcel';
							$maniMap->fid = $p->id;
							$maniMap->status = 10;
							$maniMap->mdata['mani_time'] = date('Y-m-d H:i:s',strtotime($r['order']['order_creation_date']));

							if(!$maniMap->save())
							{
								print_r($maniMap);
								return;
							}
						}
						echo $r['order']['order_id'], "\t", $r['order']['order_creation_date'], "\t", $r['order']['order_summary']['total_cost'], "\t", $r['order']['order_summary']['number_of_shipments'], "\t", $r['order']['order_summary']['number_of_items'], PHP_EOL;
						continue;
					}
				}
			}
			$transaction->commit();
		} catch (Exception $ex) {
			$transaction->rollback();
			throw $ex;
		}
	}

	public function getFastwayManifestTime()
	{
		$date = $this->prompt('Date(*): ');
		$shipments = ImParcel::model()->with(['trans'])->findAll('trans.org_id = 115 and trans.status = 19 and t.status>=60 and json_value(trans.meta,"$.fw_consigment_id") is not null and t.created>="2020-04-01"');
		$batchShipments=[];
		foreach ($shipments as $key => $shipment) {
			$maniMap = ManiMap::model()->with('manifest')->findAll(' t.fid = :fid and manifest.type = 90 ',[':fid'=>$shipment->id]);
			if($key%1000==0)
			{
				$batchShipments[]=[];
			}
			if(!empty($maniMap))
			{
				continue;
			}
			$batchShipments[count($batchShipments)-1][]=$shipment;
		}

		foreach ($batchShipments as $key => $batch) 
		{
			$transaction=Yii::app()->db->beginTransaction();
			try 
			{
				foreach ($batch as $p) 
				{
					$mani = Manifest::model()->find('type = 90 and ref = :ref',[':ref'=>"Checkin_".$p->consol->eta]);
					if(empty($mani))
					{	
						$mani = new Manifest();
						$mani->type = 90;
						$mani->created = $p->consol->eta." 00:00:01";
						$mani->ref = $p->consol->eta." 00:00:01";
						$mani->fwd_id = 115;
						$mani->save();
					}

					$maniMap = new ManiMap();
					$maniMap->mani_id = $mani->id;
					$maniMap->model = 'ImParcel';
					$maniMap->fid = $p->id;
					$maniMap->status = 10;
					$maniMap->mdata['mani_time'] =$p->consol->eta;
					if(!$maniMap->save())
					{
						print_r($maniMap);
						return;
					}

					echo "a";
				}

				$transaction->commit();
				echo count($batch);
			} catch (Exception $ex) 
			{
				$transaction->rollback();
				throw $ex;
			}
		}

	}

	public function getStartrackAndTntManifestTime()
	{
		$date = $this->prompt('Date(*): ');
		$shipments = ImParcel::model()->with(['trans','consol'])->findAll('t.status != 100 and trans.org_id in (976,858) and consol_id >0 and consol.etd like "%'.$date.'%"');
		$batchShipments=[];
		foreach ($shipments as $key => $shipment) {
			if($key%1000==0)
			{
				$batchShipments[]=[];
			}
			$batchShipments[count($batchShipments)-1][]=$shipment;
		}

		foreach ($batchShipments as $key => $batch) 
		{
			$transaction=Yii::app()->db->beginTransaction();
			try 
			{
				foreach ($batch as $p) 
				{
					$mani = Manifest::model()->find('type = 90 and ref = :ref',[':ref'=>$p->consol->etd." 00:00:01"]);
					if(empty($mani))
					{	
						$mani = new Manifest();
						$mani->type = 90;
						$mani->created = $p->consol->etd." 00:00:01";
						$mani->ref = $p->consol->etd." 00:00:01";
						$mani->save();
					}

					$maniMap = ManiMap::model()->find("mani_id = :mani_id and model = 'ImParcel' and fid = :fid",[":mani_id"=>$mani->id,":fid"=>$p->id]);
					if(!empty($maniMap))
					{
						continue;
					}

					$maniMap->mani_id = $mani->id;
					$maniMap->model = 'ImParcel';
					$maniMap->fid = $p->id;
					$maniMap->status = 10;
					$maniMap->mdata['mani_time'] =$p->consol->etd;
					if(!$maniMap->save())
					{
						print_r($maniMap);
						return;
					}
				}

				$transaction->commit();
				echo count($batch);
			} catch (Exception $ex) 
			{
				$transaction->rollback();
				throw $ex;
			}
		}

	}
	
	protected function log2file($m, $file="direct_err_")
	{//for direct courier err
		$lf = Yii::app()->basePath.DIRECTORY_SEPARATOR.'runtime'.DIRECTORY_SEPARATOR . 'direct' . DIRECTORY_SEPARATOR;
		$lf .= $file. date('Y-m-d') . '.log';
		return file_put_contents($lf, date('Y-m-d H:i:s').' '.$m."\n", FILE_APPEND);
	}

