	public function putShipmentIntoGatepassCourier()
	{
		$dataArr = [['AGR481','2022-01-05 14:01:31'],['AGR482','2022-01-05 14:01:20'],['AGR483','2022-01-07 11:19:31'],['AGR484','2022-01-07 11:19:31'],['AGR494','2022-01-11 19:11:44']];

		foreach ($dataArr as $key => $d) {
			$theDay = $d[1];
			$shipment = ImParcel::model()->find('ref=:ref',[':ref'=>$d[0]]);
			$gps = GatepassShipment::model()->findAll('fid=:fid',[":fid"=>$shipment->id]);
			$day = explode(' ', $theDay)[0];
			$time =  explode(' ', $theDay)[1];
			$afterDays = HolidayHelper::getDateByBusinessDays(106,$day,1,1);
			$myGatepassCourier = GatepassCourier::model()->find(['condition'=>'driver_name = "3pl" and driver_rego = "000000" and courier_id = 0 and json_value(meta,"$.ocourier_id")="TP" and json_value(meta,"$.is_tp")="TP" and date_format(create_time,"%Y-%m-%d")="'.$afterDays.'" ']);
			foreach ($gps as $key => $gatepassShipment) {
				$gatepassShipment->gate_pass_time = $myGatepassCourier->create_time;
				$gatepassShipment->status = 10;
				$gatepassShipment->parent_id = $myGatepassCourier->id;
				$gatepassShipment->save();
			}

		}	
	}


	public function dealWithGatePassShipment()
	{
		$data1 = [];
		foreach ($data1 as $key => $d) {
			$gatepassShipment = GatepassShipment::model()->findByPk($d);
			//if(empty($gatepassShipment)||!empty($gatepassShipment->parent_id)) continue;

			$p = ImParcel::model()->findByPk($gatepassShipment->fid);
			//$cargoTime = $p->cargo_process->started;
			$t = Tracking::model()->find(['condition'=>'pid = :pid and type = 60','params'=>[":pid"=>$p->id],'order'=>'id desc']);
			$day = $gatepassShipment->scan_time;//$cargoTime;
			if(strtotime($t->dt)>strtotime($day))
			{
				$day  = $t->dt;
			}

			$theDay = $day;
			$day = explode(' ', $theDay)[0];
			$time =  explode(' ', $theDay)[1];
			$scanDate = $day;
