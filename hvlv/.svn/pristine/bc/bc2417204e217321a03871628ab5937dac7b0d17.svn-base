7210000951',20150099],['4357210000952',20150100],['4357210000953',20150102],['4357210000954',20150103],['4357210000955',20150104],['4357210000956',20150105],['4357210000957',20150106],['4357210000958',20154467],['4357210000959',20156357],['4357210000960',20157411],['4357210000961',20157412],['4357210000962',20157413],['4357210000963',20157414],['4357210000964',20157415],['4357210000965',20157416],['4357210000966',20157417],['4357210000967',20157418],['4357210000968',20157442],['4357210000970',20157820],['4357210000971',20157821],['4357210000972',20157822],['4357210000973',20157823],['4357210000974',20157824],['4357210000975',20157825],['4357210000976',20157826],['4357210000977',20157827],['4357210000978',20157828],['4357210000979',20157829],['4357210000980',20157830],['4357210000981',20157831],['4357210000982',20157832],['4357210000983',20157833],['4357210000984',20157834],['4357210000985',20157835],['4357210000986',20157836],['4357210000987',20157837],['4357210000988',20157838],['4357210000989',20157839],['4357210000990',20157840],['4357210000991',20157841],['4357210000992',20157842]];
		$xls = new oExcel;
		$i = 1;
		// $xls->addRow($i++, ['WBN', 'Ref','Awb','Packages', 'Weight', 'Status', 'Agent', 'Sender', 'Sender Tel', 'Cnee Name', 'Cnee Tel', 'Address', 'State', 'Date', 'Delay','Extra Info']);
		$xls->addRow($i++, ['Dfe ref', '件数','重量','体积','create 日期','换单单号', 'consol ETA', 'checkin time', 'manifest time']);
		foreach ($data as $key => $d)
		{
			$sql = "SELECT ref,can,pkg,weight,cbm,created,consol_id,meta from shipment where id = ".$d[1]." union "."SELECT ref,can,pkg,weight,cbm,created,consol_id,meta from shipment_archive where id = ".$d[1];
			$rows = Yii::app()->db->createCommand($sql)->queryAll();
			$row = [$d[0]];
			foreach ($rows as $key => $r) {
				$consol = Consol::model()->findByPk($r['consol_id']);
				$eta = empty($consol)?"":$consol->eta;
				$mdata = json_decode($r['meta'],true);
				$checkin = empty($mdata['scan_time'])?"":$mdata['scan_time'];
				$mani = ManiMap::model()->find(['condition'=>'fid = :fid and json_value(meta,"$.mani_time") is not null ','params'=>[":fid"=>$d[1]],'order'=>'id desc']);
				$fwdId= "";
				if(!empty($mani))
				{
					$manifest = Manifest::model()->findByPk($mani->mani_id);
					$fwdId = $manifest->fwd_id;
				}
				$manifestTime = empty($mani)?"":$mani->mdata["mani_time"];
				$row = [$d[0],$r['pkg'],$r['weight'],$r['cbm'],$r['created'],$r['ref'],$eta,$checkin,$manifestTime,$fwdId];
			}
			if(!empty($row[4])&&strtotime($row[4])>strtotime('2021-01-12'))
			{
				continue;
			}
			$xls->addRow($i++, $row);
		}

		$xls->output( Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR.'dfe_change_label_before_2021-01-12.xlsx',null,false);

	}

	public function fixAustwaySurchargeInvoice()
	{
		Yii::app()->name = "TLA";
		$invoices = ['OT803584','OT803587','OT803593','OT803599','OT803611','OT803614','OT803620','OT803632','OT803650','OT803656','OT803662','OT803665','OT803704','OT803710','OT803716','OT803719','OT803752','OT803755','OT803764','OT803770','OT803773','OT803779','OT803812','OT803818','OT803821','OT803824','OT803827','OT803830','OT803833','OT803836','OT803839','OT803842','OT803851','OT803854','OT803866','OT803887','OT803890','OT803893','OT803896','OT803902','OT803905','OT803908','OT803911','OT803920','OT803926','OT803929','OT803932','OT803935','OT803938','OT803941','OT803944','OT803947','OT803950','OT803953','OT803956','OT803959','OT803962','OT803968','OT803980','OT803983','OT803995','OT804001','OT804019','OT804022','OT804031','OT804034','OT804046','OT804055','OT804061','OT804067','OT804070','OT804073','OT804076','OT804079','OT804082','OT804088','OT804091','OT804094','OT804097','OT804100','OT804103','OT804106','OT804109','OT804115','OT804118','OT804121','OT803197','OT803203','OT803209','OT803212'];
		$tempDirectory = Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR.'geroTesting';
		if (!file_exists($tempDirectory)) {
			mkdir($tempDirectory);
		}
		foreach ($invoices as $key => $value) {
			$invoice = Invoice::model()->find('no = :no',[":no"=>$value]);
			$fileName = $tempDirectory.DIRECTORY_SEPARATOR.'Invoice_'.$invoice->no.'.pdf';
			$excelFile = $invoice->exportExcelInvoice($tempDirectory.DIRECTORY_SEPARATOR,false);
			$fileName2 = '';
			// echo $invoice->no;
			if ($invoice->type != 60) {
				oPDF::renderPDF('invoice', ['inv'=>$invoice], 2, $fileName);
			}

			// $id = explode('OT', $value)[1];
			// print_r(file_get_contents('https://os.toplogistics.com.au/top/invoice/print/'.$id.'.app'));
			// Yii::app()->end();
			// file_put_contents(Yii::app()->basePath.DIRECTORY_SEPARATOR.'runtime'.DIRECTORY_SEPARATOR . $id.'.pdf', file_get_contents('https://os.toplogistics.com.au/top/invoice/print/'.$id.'.app'));
		}
		
	}

