			{
				$lblRequestId = $shipment->mdata['ss_lbl_request_id'];
			}
			$p->mdata['manual_change'] = 1;
			// save tranship information for startrack courier
			$ts = new Tranship;
			$ts->pid = $shipment->id;
			$ts->org_id = Org::ORGID_COURIER_STARTRACK; // for StarTrack
