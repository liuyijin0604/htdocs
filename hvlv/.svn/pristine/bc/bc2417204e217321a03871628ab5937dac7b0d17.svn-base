	public function fixAUX()
	{
		/*
		select t.*,si.inv_no from (SELECT dfe_ref,allied_ref,pid FROM `hvlv_db`.`dfe_change_label` WHERE dfe_ref in ()
group by pid) t left join `hvlv_top`.`si_reconcile_line` s on t.pid =s.fid and s.item_code='item' left join `hvlv_top`.`si_reconcile` sr on s.rec_id = sr.id left join `hvlv_top`.`supplier_invoice` si on si.id = sr.supplier_invoice_id
		*/
