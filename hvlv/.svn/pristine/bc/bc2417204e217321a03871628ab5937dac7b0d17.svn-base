	public function checkSuburb()
	{
		$data = "";
		$dataArr = json_decode($data,true);
		$shipments = $dataArr['shipments'];
		foreach($shipments as $key => $shipment)
		{
			echo $key.$shipment['items'][0]['tracking_details']['consignment_id']."|".$shipment['to']['suburb'], PHP_EOL;
		}
	}
}
