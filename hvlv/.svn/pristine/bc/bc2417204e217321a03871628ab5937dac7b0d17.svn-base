	public function delDIYShipments()
	{
		$consolId = $this->prompt('ConsolId ');
		$shipments = ImParcel::model()->findAll('consol_id = :consolId',[":consolId"=>$consolId]);
		foreach ($shipments as $key => $s) {
			if(preg_match('/SKP/i', $s->ref))
			{
				$s->mdata['cargo_ignore_scan'] = 1;
				$s->save();
				// if(!empty($s->cargo_process))
				// {
				// 	$s->cargo_process->status = CargoProcess::WAITINGASSIGNDRIVER;
				// 	$s->cargo_process->save();
				// }
			}
		}
	}


	public function generateCargoProcessJobAuto()
    {
    	$initItems = CargoProcess::model()->with(['job_relation','shipment'])->findAll('t.status = :status and job_relation.id is null and t.type=:type and agent_id = 3551',[':status'=>CargoProcess::WAITINGASSIGNDRIVER,':type'=>CargoProcess::NORMAL_CARGO]);
        //putting buttle algorithm
        $orgRate = OrgRate::model()->findByPk(928);
        $zoneMaps = ZoneMap::model()->findAll("org_id = :orgId and zone_id = :zoneId",[":orgId"=>$orgRate->org_id,":zoneId"=>$orgRate->zone_id]);

        $used = true;
        while($used)
	    {
	    	$initButtles = [];
	        $initDeliveryZone = [];
	        foreach ($zoneMaps as $key => $z)
	        {
	            if(empty($initDeliveryZone[$z->z1]))
	            {
	                $initDeliveryZone[$z->z1] = [$z->pc_lo];
	            }else
	            {
	                $initDeliveryZone[$z->z1][] = $z->pc_lo;
	            }
	        }

	        foreach ($initDeliveryZone as $key => $dz)
	        {
	            $initButtles[$key] = CargoProcessVehicle::model()->findByPk(1);
	            $initButtles[$key]->dptId = $orgRate->mdata['ddpt_id'];
	            $initButtles[$key]->region = $key;
	            $initButtles[$key]->deliveryZone = $dz;
	        }
	        $savedVehicle = [0];
	        foreach($initButtles as $k1 => $vehicle)
	        {
	            foreach($initItems as $k2 => $cargo)
	            {
	                if($vehicle->isFull($cargo))
	                {
	                    continue;
	                }else
	                {
	                    if($vehicle->canDeliver($cargo))
	                    {
	                        $vehicle->myCargos[] = [$cargo->shipment->getDeliveryDistance(),$cargo];
	                        unset($initItems[$k2]);
	                    }
	                }
	            }

	            if($vehicle->canBeSaveToJob())
	            {
	                $data =[];
	                $cargos = $vehicle->myCargos;
	                $distance = [];
	                foreach ($cargos as $key => $row)
	                {
	                    $distance[$key] = $row[0];
	                }
	                array_multisort($distance, SORT_DESC, $cargos);
	                foreach ($cargos as $kc => $ca) {
	                    $data[$kc] = [$ca[1]->id,$kc+1];
	                }
	                $jobName = $vehicle->region.date('YmdHis');
	                $topCourierService = new TopCourierService();
	                $job = $topCourierService->createCargoJob($data,$jobName,0,'',$vehicle->dptId,CargoProcessJob::NORMAL_JOB,$vehicle->id,$vehicle->region,true);
	                if(!empty($job->id))
	                {
	                	$savedVehicle[] = $job->id;
	            	}
	            }
	        }
	        $size = count($savedVehicle);
	        if(($size-1)==0)
	        {
	            break;
	        }
	    }
    }

    public function calShipment()
	{
		$xls = new oExcel('CSV');
		$xls->load('C:\Users\admin\Downloads\edimsg.csv');
		$data = $xls->getAll();
		unset($data[1]);
		$finalData = [];
		foreach ($data as $key => $d)
		{
			$date = explode('/', $d[3]);
			if(!empty($finalData[$date[0]."-".$date[1]]))
			{
				if(preg_match('/(SKP|MKP|BKP|PKP)/i', $d[2]))
				{
					$finalData[$date[0]."-".$date[1]]['TLD']+=1;
				}else
				{
					$finalData[$date[0]."-".$date[1]]['Courier']+=1;
				}
			}else
			{
				if(preg_match('/(SKP|MKP|BKP|PKP)/i', $d[2]))
				{
					$finalData[$date[0]."-".$date[1]] = ['TLD'=>1,'Courier'=>0];
				}else
				{
					$finalData[$date[0]."-".$date[1]] = ['TLD'=>0,'Courier'=>1];
				}
			}
			
		}
		$xlsave = new oExcel;
		$xlsave->addRow(1, ["Month","TLD","Courier"]);
		$start = 2;
		$sum = 0;
		foreach ($finalData as $key => &$value) 
		{
			$xlsave->addRow($start, [$key,$value["TLD"],$value["Courier"]]);
			$start++;
			$sum+=$value["TLD"];
			$sum+=$value["Courier"];
		}
		$xlsave->output('D:\handleData\3103.csv', null, false);
		echo $sum;

	}

