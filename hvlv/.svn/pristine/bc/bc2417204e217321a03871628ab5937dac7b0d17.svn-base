			$row = [];
			$row[] = "zone code";
			$row[] = "name";
			foreach ($data as $key => $d) {
				if($key>=8&&!empty($d[1])&&is_numeric($d[1]))
				{
					$row[] = "price/piece";
					$row[] = "price/kg";
					$row[] = "base";
					$row[] = "minimum";
					$row[] = "nkg";
				}
			}
			$rowArr[] = $row;
		}
		for ($i=1; $i < 5; $i++) {
			$row = [];
			$row[] = "N".$i;
			$row[] = "Sydney-".$i;
			foreach ($data as $key => $d) {
				if($key>=8&&!empty($d[1])&&is_numeric($d[1]))
				{
					$row[] = 0;
					$row[] = 0;
					$row[] = $d[7+$i];
					$row[] = 0;
					$row[] = 0;
				}
			}
			$rowArr[] = $row;
		}
		$xlsave = new oExcel;
		$start = 1;
		foreach ($rowArr as $key => $row) 
		{
			$xlsave->addRow($start, $row);
			$start++;
		}
		$xlsave->output('D:\handleData\BNE.xlsx', null, false);

	}

	public function reset3PLAupostWeight()
	{
		Yii::app()->name = "TLA";
		$lines = SiReconcileLine::model()->with(['parent'])->findAll('parent.type = 1 and (t.type&32)>0');
		foreach ($lines as $key => $line) {
			if(!empty($line->imparcel)&&$line->imparcel->isWms())
			{
				$line->getChargeWeightDiff(true);
				if($line->isCBMSiReconcileLine())
				{
					$our_charge_weight = floatval(isset($line->imparcel->mdata['charge_client_weight']) ? $line->imparcel->mdata['charge_client_weight'] : $line->imparcel->chargeWeight());
					$line->our_charge_weight = $our_charge_weight;
				}else
				{
					$line->our_charge_weight = $line->imparcel->weight;
				}
				$line->save();
			}
		}
	}

