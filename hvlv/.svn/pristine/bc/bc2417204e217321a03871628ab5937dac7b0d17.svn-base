		echo str_replace('\u00a0', ' ',str_replace('"]', '',str_replace('["', '',json_encode(["xxxxxxxxx"]))));
	}

	public function syncBillingFromXero()
	{
		$day = 35;
		yii::app()->name = 'TLA';
		if (!empty($this->args[1])) {
			$day = $this->args[1];
		}

		// if (yii::app()->name != 'TLA') {
		// 	$xero = new XeroAPI('xero_token_pcaex');
		// } else {
		// 	$xero = new XeroAPI('xero_token_toplog');
		// }

		$count = 0;
		$results = '{"Type":"ACCPAY","Contact":{"ContactID":"af93ab42-55ae-4770-be4b-dccbabbfc6bc","Name":"CITO TRANSPORT"},"Date":"2021-08-03","DueDate":"2021-08-03","LineAmountTypes":"Exclusive","InvoiceNumber":"T00318307","CurrencyCode":"AUD","CurrencyRate":"1","Status":"PAID","SubTotal":"313.6","TotalTax":"31.36","Total":"344.96","InvoiceID":"6f33fd5b-46c0-458e-bfac-924d8364694b","HasAttachments":"false","Payments":[{"Date":"2021-10-19","CurrencyRate":"1","Amount":"13.19","PaymentID":"d7820d2a-8a1b-4951-b46b-a7bc2f4cf5eb"}],"AmountDue":"0","AmountPaid":"13.19","FullyPaidOnDate":"2021-10-19","AmountCredited":"331.77","UpdatedDateUTC":"2021-10-20T06:11:15+00:00","CreditNotes":[{"Date":"2021-09-22","Total":"10.73","CreditNoteID":"cb094545-08fb-465d-8fbc-d55c37f68e42","CreditNoteNumber":"T00321530/A"},{"Date":"2021-09-22","Total":"11.28","CreditNoteID":"2a82eb3f-e6fc-443c-9893-9d9837a70fa8","CreditNoteNumber":"T00321264/A"},{"Date":"2021-09-22","Total":"11.28","CreditNoteID":"2a82eb3f-e6fc-443c-9893-9d9837a70fa8","CreditNoteNumber":"T00321264/A"},{"Date":"2021-09-22","Total":"52.77","CreditNoteID":"66352720-a15c-452c-861d-5ac87a72e49b","CreditNoteNumber":"T00324392/A"},{"Date":"2021-09-22","Total":"11.28","CreditNoteID":"92e66411-db60-4d6c-97df-a839616c6805","CreditNoteNumber":"T00321193/A"},{"Date":"2021-09-22","Total":"11.28","CreditNoteID":"22704ab1-f64b-4386-8a00-87f6e51cd340","CreditNoteNumber":"T00321270/A"},{"Date":"2021-09-22","Total":"11.28","CreditNoteID":"ad551087-c90c-4697-862d-7de3cd3e3c7e","CreditNoteNumber":"T00321006/A"},{"Date":"2021-09-23","Total":"99.95","CreditNoteID":"9e4eeac2-e450-459a-b120-a392b7a26de5","CreditNoteNumber":"L00015763/A"},{"Date":"2021-09-22","Total":"61.6","CreditNoteID":"848360f0-02f0-4b56-924e-e0bec066d0a1","CreditNoteNumber":"T00323226/A"},{"Date":"2021-09-22","Total":"61.6","CreditNoteID":"a9f00f89-c8fc-4953-92fb-cbd92becd19b","CreditNoteNumber":"T00321291/A"}]}';
		$results = [json_decode($results,true)];
		$count ++;

		$not_found = [];
		foreach ($results as $result) {
			$no = $result['InvoiceNumber'];
			// $billing = Billing::model()->with('cust')->find('t.status != 11 AND t.billing_cref = :no AND cust.name = :name', [':no' => $no, ':name' => $result['Contact']['Name']]);
			// if (empty($billing)) {
			// 	$billing = Billing::model()->with('cust')->find('t.status != 11 AND t.billing_cref LIKE :no AND cust.name = :name', [':no' => '%' . explode('-', $no)[0] . '%', ':name' => $result['Contact']['Name']]);
			// }
			$billing = Billing::model()->find(['condition' => 't.xero_id = :xero_id AND t.status != 11', 'params' => [':xero_id' => $result['InvoiceID']], 'order' => 'id DESC']);
			if (empty($billing)) {
				$not_found[] = $no;
				continue;
			}

			// $billing->cust->extra[$xero->key] = $result['Contact']['ContactID'];
			// $billing->cust->sync_xero = false;
			// $billing->cust->update('meta');

			if (!empty($result['Payments'])) {
				foreach ($result['Payments'] as $payment) {
					$pb = PaymentBilling::model()->find('xero_id = :xero_id', [':xero_id' => $payment['PaymentID']]);
					if (empty($pb)) {
						$pb = new PaymentBilling;
						$pb->org_id = $billing->org_id;
						$thisDate = json_decode(json_encode($payment['Date']), true);
						if(is_array($thisDate)&&!empty($thisDate['date']))
						{
							$pb->date = date('Y-m-d', strtotime(json_decode(json_encode($payment['Date']), true)['date']));
						}else
						{
							$pb->date = date('Y-m-d', strtotime($thisDate));
						}
						$pb->transaction_date = $pb->date;
						$pb->type = PaymentBilling::PAYMENT_TYPE_EFT;
						$pb->status = PaymentBilling::PAYMENT_STATUS_POSTED;
						$pb->currency = $billing->currency;
						$pb->amount = 0;
						$pb->xero_id = $payment['PaymentID'];
						$pb->bank = 10;
						$pb->save();
					}

					if (empty($pb->getErrors())) {
						$pbill = PayBill::model()->find('pay_id = :pay_id AND bill_id = :bill_id', [':pay_id' => $pb->id, ':bill_id' => $billing->id]);
						if (empty($pbill)) {
							$pbill = new PayBill;
							$pbill->pay_id = $pb->id;
							$pbill->bill_id = $billing->id;
							$pbill->amount = number_format($payment['Amount'], 2, '.', '');
							$pbill->transaction_date = $pb->date;
							$pbill->save();
						}
					}

					$pb->updateAmount();
				}
			}

			// undo invalid allocation
			$pbills = PayBill::model()->with('payment')->findAll('t.bill_id = :bill_id AND payment.type != :type', [':bill_id' => $billing->id, ':type' => PaymentBilling::PAYMENT_TYPE_CREDIT_NOTE]);
			foreach ($pbills as $pbill) {
				if (!empty($result['Payments'])) {
					foreach ($result['Payments'] as $payment) {
						if ($payment['PaymentID'] == $pbill->payment->xero_id) {
							$pbill->sync_xero = 0;
							$pbill->update('sync_xero');
							continue 2;
						}
					}
				}

				$pbill->sync_xero = 1;
				$pbill->update('sync_xero');
			}

			if (!empty($result['CreditNotes'])) {
				foreach ($result['CreditNotes'] as $credit) {
					$pb = PaymentBilling::model()->find('xero_id = :xero_id', [':xero_id' => $credit['CreditNoteID']]);
					if (empty($pb)) {
						$pb = new PaymentBilling;
						$pb->org_id = $billing->org_id;
						$thisDate = json_decode(json_encode($payment['Date']), true);
						if(is_array($thisDate)&&!empty($thisDate['date']))
						{
							$pb->date = date('Y-m-d', strtotime(json_decode(json_encode($payment['Date']), true)['date']));
						}else
						{
							$pb->date = date('Y-m-d', strtotime($thisDate));
						}
						$pb->transaction_date = $pb->date;
						$pb->type = PaymentBilling::PAYMENT_TYPE_CREDIT_NOTE;
						$pb->status = PaymentBilling::PAYMENT_STATUS_POSTED;
						$pb->currency = $billing->currency;
						$pb->amount = 0;
						$pb->xero_id = $credit['CreditNoteID'];
						$pb->bank = 10;
						$pb->save();
					}

					if (empty($pb->getErrors())) {
						$pbill = PayBill::model()->find('pay_id = :pay_id AND bill_id = :bill_id', [':pay_id' => $pb->id, ':bill_id' => $billing->id]);
						if (empty($pbill)) {
							$pbill = new PayBill;
							$pbill->pay_id = $pb->id;
							$pbill->bill_id = $billing->id;
							$pbill->amount = number_format($credit['Total'], 2, '.', '');
							$pbill->transaction_date = $pb->date;
							$pbill->save();
						}

						$pb->refresh();
						$pb->updateAmount();
						$pb->updateAta();
					}

					if (!empty($credit['CreditNoteNumber'])) {
						$cb = Billing::model()->find('billing_cref = :no AND org_id = :oid', [':no' => $credit['CreditNoteNumber'], ':oid' => $billing->org_id]);
						if (!empty($cb)) {
							if ($pb->ata > 0) {
								$cb->status = Billing::BILLING_STATUS_PARTIALLY_PAID;
							} else {
								$cb->status = Billing::BILLING_STATUS_PAID;
							}
							$cb->update('status');
						}
					}
				}
			}

			$billing->checkPaid();
			$o = Billing::model()->findByPk($billing->id);
			if ($o->status != $billing->status) {
				$billing->update('status');
			}
		}
		yii::log(implode(', ', $not_found), 'warning');
	}

	public function dealWithGatePassShipmentTracking()
	{
				$data1 = [];

				$check = [];
				foreach ($data1 as $key => $id) {

					$gp = GatepassShipment::model()->findByPk($id);
					$tracking = Tracking::model()->find('type = 68 and pid=:pid',[":pid"=>$gp->imparcel->id]);
					if(empty($tracking)) continue;
					if(in_array($tracking->id, $check))
					{
						continue;
					}
					$tracking->dt = $gp->gate_pass_time;
					$tracking->save();
					$check[] = $tracking->id;
				}
				
	}


	public function fixUBIManifest()
	{
		$data = '';
		$result = json_decode($data);
		$err = [];
		$tempShipments = [];
		$tempShipments['8566108003572'] = ImParcel::model()->findByPk(26937124);
		$ubi=new EtowerAPI(false, false);
		if (is_object($result)) {
			if ($result->status=="Failure"||$result->status=="Partial Success") {
				$err[]=$result->message;
			}else
			{
				$result = $result->data;
				$transaction = Yii::app()->db->beginTransaction();
				try {
					
					foreach ($result as $shipmentRef) {
						$ref= $shipmentRef->trackingNo;
						$pb = ParcelBarcode::model()->find('sub_ref=:subRef',[":subRef"=>$ref]);
						if(empty($tempShipments[$pb->main_ref])) continue;
						$s=$tempShipments[$pb->main_ref];
						$trans = $s->trans;
						$tranship = end($trans);
						$orgId = $tranship->org_id;
						$tranship->mdata['oid'] = Org::ORGID_COURIER_UBI;
						$cost = $ubi->getCost($s->mdata['org_rate_id'], $s->cnee->suburb, $s->cnee->postcode, $s->getCubeWeight());
						if($cost->code == 0)
						{
							$tranship->cost= number_format($cost->data, 2, '.', '');
						}
						$tranship->save();

						if(empty($mani))
						{
							$mani = new Manifest;
							$mani->type = 90;
							$mani->fwd_id = $orgId;
							$mani->ref = date('Y-m-d');
							$mani->save();
						}
						$mm = new ManiMap;
						$mm->mani_id = $mani->id;
						$mm->fid = $s->id;
						$mm->model = 'ImParcel';
						$mm->status = 10;
						$mm->mdata['mani_time'] = date('Y-m-d H:i:s');
						$mm->save();
						$s->mdata['manifest_weight'] = ceil($s->weight);
						$s->save();



					}
					$transaction->commit();
				} catch (Exception $ex) {
					$transaction->rollback();
					Log::log2file("UBI".$cn->no."=>".$ex->getMessage(), "transaction_err_log", "transaction");
					throw $ex;
				}
			}
		}
		return $err;
	
	}

	public function fixAuspostManifest()
	{
		$rStr = '';
		$r = json_decode($rStr);

		if (!empty($r->order)) {
			$oid = $r->order->order_id;
			$mani = Manifest::model()->find('type = 90 and ref = :ref',[':ref'=>$oid]);
			if(empty($mani))
			{	
				$mani = new Manifest();
				$mani->fwd_id=101;
				$mani->type = 90;
				$mani->created = date('Y-m-d H:i:s');
				$mani->ref = $oid;
			}else
			{
				$mani->created = date('Y-m-d H:i:s');
			}
			$mani->save();

			// because aupost returned shipment is not the same order with our sending order
			// so here we need to order by HBN again
			$auPostShipments = [];
			foreach ($r->order->shipments as $aushipment) {
				$auPostShipments[$aushipment->shipment_reference] = $aushipment;
			}

			foreach ($auPostShipments as $i => $s) {
				$s = ImParcel::model()->find('ref =:ref',[":ref"=>$i]);
				$maniMap = ManiMap::model()->find("mani_id = :mani_id and model = 'ImParcel' and fid = :fid",[":mani_id"=>$mani->id,":fid"=>$s->id]);
				if(empty($maniMap))
				{
					$maniMap = new ManiMap();
				}

				$maniMap->mani_id = $mani->id;
				$maniMap->model = 'ImParcel';
				$maniMap->fid = $s->id;
				$maniMap->status = 10;
				$maniMap->mdata['mani_time'] = date('Y-m-d H:i:s');
				$maniMap->save();


				$ts = new Tranship;
				$ts->pid = $s->id;
				$ts->org_id = 101;  // for Australia post office
				$ts->man_id = $s->man_id;
				$ts->type = 80;  // shipment transfer to a different delivery courier
				$ts->status = 19; // in finally moving status
				$ts->connote = $s->ref;
				$ts->time = date('Y-m-d H:i:s');
				$ts->mdata['oid'] = $oid;
				$aushipment = $auPostShipments[$s->hbn];
				$ts->mdata['sid'] = $aushipment->shipment_id;

				$costValue = floatval($aushipment->shipment_summary->total_cost - $aushipment->shipment_summary->total_gst);
				if(!empty($s->mdata['org_rate_id']))
				{
					$orgRate = OrgRate::model()->findByPk($s->mdata['org_rate_id']);
					$cost = ImcoConsol::getCourierCostPrice($orgRate, $s->cnee->postcode, $s->weight, $s->pkg, true, $s->cnee->suburb);
					$cost = $cost==99999?0:$cost;
					$ts->cost = round($cost, 2);
				}else
				{
					$ts->cost = round($costValue, 2);
				}

				$ts->save();
				if (!empty($s->mdata['direct_courier'])&&$s->mdata['direct_courier']==2) {
					$s->cbwf=($s->cbwf^32)&$s->cbwf;
					$s->cbwf=$s->cbwf|64;
					$s->mdata['direct_courier']=1;
					$s->updateMeta();
					$s->update(['cbwf']);
				}

			}
		} else {
			foreach ($apa->err as $e) {
				$msg = $e->message;
				if (!empty($e->field) && preg_match('/shipments\[(\d+)\]/', $e->field, $m)) {
					$msg .= ': '.$ss[$m[1]]->hbn;
				}
				$err[] = $msg;
			}
		}
	}

