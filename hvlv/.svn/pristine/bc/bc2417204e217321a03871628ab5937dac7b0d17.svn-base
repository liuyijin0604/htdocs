	private function getDistance($wd,$destinationArr)
	{
		$transaction=Yii::app()->db->beginTransaction();
		try {
			foreach ($destinationArr as $key => $value) {
				$distance = GoogleMapAPI::getDistanceBetweenPostcode($wd,$value["suburb"]." ".$value["state"]." ".$value["country"]." ".$value['postcode']);
				if($distance==null)
				{
					$distance = 0;
				}
				$sql = "INSERT into postcode_distance (origin,destination,distance,suburb,state,country) values ({$wd},\"{$value['postcode']}\",{$distance},\"{$value['suburb']}\",\"{$value['state']}\",'{$value['country']}')";
				echo $sql."\n";
				$this->db->createCommand($sql)->execute();
			}
			$transaction->commit();
		} catch (Exception $ex) {
			$transaction->rollback();
			throw $ex;
		}
	}

