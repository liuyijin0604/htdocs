	public function calculateDFECostDiff()
	{
		$topCourierService = new TopCourierService();
		$check = [];
		$xls = new oExcel;
		$i = 1;
		$xls->addRow($i++, ['dport','original_ref', 'ref','pkg','weight','total_cbm','cal_weight', 'old_cost','new_cost','diff','newCalType','Scan Date','Manifest Date','Storage Date']);
		Yii::app()->name = 'TLA';
		$dfeChangedLabels = DfeChangeLabel::model()->with('imparcel')->findAll(['condition'=>'1=1','group'=>'allied_ref']);
		foreach ($dfeChangedLabels as $key => $dclObj) {
			$check[] = $dclObj->pid;
			$siLine = SiReconcileLine::model()->with('parent')->find('parent.status !=100 and ref = :ref',[":ref"=>$dclObj->imparcel->ref]);
			$originalRef = $dclObj->dfe_ref;
			$p = $dclObj->imparcel;
			$originalOrgRate = 0;
			$newCalType = 'Toll';
			$dport = '';
			if((preg_match('/^(('.DFEAPI::CONSIGNMENT_PREFIX_TOP.')|(246831))\d{7}$/', $originalRef)))
			{
				$originalOrgRate = ImportChargeCode::DFE_ID_TOP;
				$dport = 'SYD';
			}else if((preg_match('/^('.DFEAPI::CONSIGNMENT_PREFIX_TOP_MEL.')\d{7}$/', $originalRef)))
			{
				$originalOrgRate = ImportChargeCode::DFE_MEL_ID_TOP;
			}else if((preg_match('/^('.DFEAPI::CONSIGNMENT_PREFIX_TOP_BNE.')\d{7}$/', $originalRef)))
			{
				$originalOrgRate = ImportChargeCode::DFE_BNE_ID_TOP;
			}else
			{
				if((preg_match('/^(SHD)\d{10}$/', $originalRef)))
				{
					$originalOrgRate = ImportChargeCode::DFE_ID_TOP;
				}else if((preg_match('/^(MHD)\d{10}$/', $originalRef)))
				{
					$originalOrgRate = ImportChargeCode::DFE_MEL_ID_TOP;
				}else if((preg_match('/^(BHD)\d{10}$/', $originalRef)))
				{
					$originalOrgRate = ImportChargeCode::DFE_BNE_ID_TOP;
				}else
				{
					continue;
				}
			}
			if(empty($siLine))
			{
				if($originalOrgRate==ImportChargeCode::DFE_ID_TOP)
				{
					$eizTollId =ImportChargeCode::EIZ_TOLL_ID;
					$tntId = ImportChargeCode::TNT_SYDNEY_ID_TOP;
					$eizAPI = new EizAPI('syd');
					$eizAPIAllied = new EizAPI('syd_allied');
					$tntAPI = TntAPI::getTntInterface('syd_top');
					$checkDistance = 150;
				}elseif($originalOrgRate==ImportChargeCode::DFE_MEL_ID_TOP)
				{
					$eizTollId = ImportChargeCode::EIZ_TOLL_MEL_ID;
					$tntId = ImportChargeCode::TNT_MELBOURNE_ID_TOP;
					$eizAPI = new EizAPI('mel');
					$eizAPIAllied = new EizAPI('mel_allied');
					$tntAPI = TntAPI::getTntInterface('mel_top');
				}elseif($originalOrgRate==ImportChargeCode::DFE_BNE_ID_TOP)
				{
					$tntId = ImportChargeCode::TNT_BRISBANE_ID_TOP;
					$eizTollId = ImportChargeCode::EIZ_TOLL_BNE_ID;
					$distance = GoogleMapAPI::getDistance($p,Org::PCAE_DEPARTMENT_BRISBANE);
					$eizAPI = new EizAPI('bne');
					$eizAPIAllied = new EizAPI('bne_allied');
					$tntAPI = TntAPI::getTntInterface('bne_top');
				}
				$newCost = $eizAPI->getQuoteTollPrice($p);
				if(empty($newCost))
				{
					$newCost = $eizAPI->getQuoteAlliedPrice($p);
					$newCalType = 'Allied';
					if(empty($newCost))
					{
						$newCost = $tntAPI->getTntCost($p,$tntId);
						$newCalType = 'TNT';
					}else
					{
						$newCost = 0;
						$newCalType = '';
					}
				}

				$calWeight = $p->weight;
			}else
			{
				$newCost = $siLine->value;
				$calWeight = $siLine->weight;

			}
			$startDate = date('Y-m-d',strtotime('+3 day',strtotime($p->mdata['scan_time'])));
			$endDate = $p->getManifestDate();
			if($endDate=='2090-01-01')
			{
				$endDate = $topCourierService->getCargoProcessDeliveryDate($p);
			}
			if(empty($startDate)||empty($endDate))
			{
				$storageDate = '';
			}else
			{
				if(strtotime($endDate)<strtotime($startDate))
				{
					$storageDate = 0;
				}else
				{
					$hours = HolidayHelper::checkBetweenHours($endDate,$startDate);
					$days = ceil($hours/24)-1;
					$storageDate  = $days;
				}
			}
			$oldCost = Shipment::getCourierCostByShipment($dclObj->imparcel->ref, $originalOrgRate, $calWeight)['price'];

			if($endDate=='2090-01-01')
			{
				$endDate = '';
				$storageDate = '';
			}
			// echo 'oref:',$originalRef,' oldCost:',$oldCost,' newCost:',$newCost,PHP_EOL;
			$xls->addRow($i++, ['',$originalRef,$dclObj->imparcel->ref,$dclObj->imparcel->pkg,$dclObj->imparcel->weight,$dclObj->imparcel->cbm*$dclObj->imparcel->pkg,$calWeight,$oldCost,$newCost,$newCost-$oldCost,$newCalType,$startDate,$endDate,$storageDate]);
		}

		$xls->output( Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR.'dfe.xlsx',null,false);

	}

	public function getIMInvoiceRev()
	{
		$topCourierService = new TopCourierService();
		$check = [];
		$xls = new oExcel;
		$i = 1;
		$xls->addRow($i++, ['dport','original_ref', 'ref','rev','invoice']);
		$dataArr = [];
		Yii::app()->name = 'TLA';
		foreach ($dataArr as $key => $data) {
			$rev= 0;
			$no = '';
			$p = ImParcel::model()->find('ref = :ref',[':ref'=>$data[2]]);
			$change = DfeChangeLabel::model()->find(['condition'=>'dfe_ref = :ref','params'=>[':ref'=>$data[1]],'order'=>'id desc']);
			if(empty($p)) $p = $change->imparcel;
			if(!empty($p))
			{
				$consol = $p->consol;
				Yii::app()->name = 'TLA';
				if(!empty($consol))
				{
					$invoices = Invoice::model()->findAll(['condition'=>'type = 10 and consol_id = :consolId and status not in (10)','params'=>[":consolId"=>$consol->id],'order'=>'id desc']);

					foreach ($invoices as $key => $inv)
					{
						foreach($inv->lines as $ilKey =>$il)
						{
							if (empty($il->mdata['items'])) continue;
							foreach($il->mdata['items'] as $si=>$sp)
							{
								if(($sp[0]==$data[2]||$sp[0]==$data[1])&&$sp[6]==$p->cnee->postcode&&$sp[5]>0)
								{
									$rev = $sp[5];
									$no = $inv->no;
									break;
								}
							}
							if(!empty($no))
							{
								break;
							}
						}

						if(!empty($no))
						{
							break;
						}
					}
				}
			}
			$xls->addRow($i++, [$data[0],$data[1],$data[2],$rev,$no]);
		}

		$xls->output( Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR.'dfe_rev.xlsx',null,false);

	}

