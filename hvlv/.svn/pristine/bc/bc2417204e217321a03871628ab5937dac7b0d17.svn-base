	public function checkConsolInvoice()
	{
		Yii::app()->name = 'TLA';
		$selectedOrg = [];
		$im = ImcoConsol::model()->findByPk(80448);
		$debug= true;
		$errors = [];
		$msg = [];
		if (empty($selectedOrg)|| in_array(2794, $selectedOrg)) {
			$dIResult=$im->genDirectInvoice();
			$msg = $dIResult["msgs"];
			$errors = $dIResult["errors"];
		}
		if (!empty($errors)) {
			return $errors;
		}
		// create invoice based on chargeable or AWB weight
		$awb_wt = 0.0;
		$cgb_wt = 0.0;
		if (isset($im->mdata['awb_wt'])) {
			$awb_wt = floatval($im->mdata['awb_wt']);
		}
		if (isset($im->mdata['cgb_wt'])) {
			$cgb_wt = floatval($im->mdata['cgb_wt']);
		}
		if ($awb_wt > 0.0 || $cgb_wt > 0.0) {
			// because multiple orgs in console
			// we need to create invoice for each org
			// following the below steps
			// step 1
			// split shipments by Org
			$orgShipments = [];
			foreach ($im->shipments as $shipment) {
				//if cancelled,not calculate the cost
				if ($shipment->status==100) {
					continue;
				}
				if($shipment->is3PL())
				{
					if (!isset($orgShipments[Org::ORGID_CLIENT_PCAE])) {
						$orgShipments[Org::ORGID_CLIENT_PCAE] = [
							'owner' => Org::model()->findByPk(Org::ORGID_CLIENT_PCAE),
							'shipments' => []
						];
					}
					$orgShipments[Org::ORGID_CLIENT_PCAE]['shipments'][] = $shipment;
				}else
				{
					if (!isset($orgShipments[$shipment->agent_id])) {
						$orgShipments[$shipment->agent_id] = [
							'owner' => $shipment->agent,
							'shipments' => []
						];
					}
					$orgShipments[$shipment->agent_id]['shipments'][] = $shipment;
				}
			}

			foreach ($orgShipments  as $id =>  $org) {
				/*
				 * need to delete when the busines logic change, followed by Christy
				 */
				// if ($id==1247) {//for ausi river
				// 	if (empty($this->mdata['org_1247']['cgb_wt'])) {
				// 		continue;
				// 	}
				// }
				/*
				 * need to delete when the busines logic change, followed by Christy
				 */
				if (!empty($selectedOrg)) {
					if (!in_array($id, $selectedOrg)) {
						continue;
					}
				}
				$owner = $org['owner'];
				// check to see if we should including GST (default 10%)
				$includingGST = false;
				if (isset($owner->extra['incl_gst']) && $owner->extra['incl_gst'] == 1) {
					$includingGST = true;
				}

				// if existing or not checking
				$inv = null;
				$oldPaymentsList = [];
				$oldInv=null;
				/**
				 * new invoice rule - there will be multiple open invoices
				**/
				// $invoices= Invoice::model()->with('lines')->findAll('type = 10 AND to_id = :id AND lines.model = :m AND lines.fid = :fid AND status in (1,2,3,6,7,9)', [':id' => $to_id, ':m' => 'ImcoConsol', ':fid' => $this->id]);
				// if (sizeof($invoices)>1) {
				// 	$errors[] = 'Console invoice ' . $invoices[0]->no . 'has errors, please contact account for more[901]';
				// 	continue;
				// }
				if($owner->by >1){
					$to_id = $owner->by;
					$inv= Invoice::model()->with('lines')->find(['order'=>'t.id DESC','condition'=>'type = 10 AND to_id = :id AND lines.model = :m AND lines.fid = :fid AND t.status != 10 AND json_value(t.meta, "$.suborg") = :suborg','params'=>[':id' => $to_id, ':m' => 'ImcoConsol', ':fid' => $im->id, ':suborg' => $owner->id]]);
				}else{
					$to_id = $owner->id;
					$inv= Invoice::model()->with('lines')->find(['order'=>'t.id DESC','condition'=>'type = 10 AND to_id = :id AND lines.model = :m AND lines.fid = :fid AND t.status != 10 AND json_value(t.meta, "$.suborg") IS NULL','params'=>[':id' => $to_id, ':m' => 'ImcoConsol', ':fid' => $im->id]]);
				}
				if (!empty($inv)) {
					// if (in_array($inv->status, [Invoice::INVOICE_STATUS_PAID, Invoice::INVOICE_STATUS_PAID_PARTLY_CREDIT]) && !Acl::hasAccess('B:invoice/paidInvoiceCredit')) {
					// 	$errors[] = 'Console invoice ' . $inv->no . 'has been paid before, please contact account for more';
					// 	continue;
					// }
					// if ($inv->isInvoiceClosed() && ($inv->status < Invoice::INVOICE_STATUS_PAID || ($inv->status == Invoice::INVOICE_STATUS_PAID && Acl::hasAccess('B:invoice/paidInvoiceCredit')))) {
					if ($inv->isInvoiceClosed()) {
						// in case invoice frozen and create credit for it
						$oldInv=$inv; //store inv  and created credit to it when we successfully create a new invoice;
							
						// create a new invoice the for this month
						$invRef = 'Original Invoice : ' . $inv->no;
						$oldInvoiceNo = $inv->no;
						$inv = new Invoice;
						$inv->no =Invoice::genNewInvoiceNo($oldInvoiceNo); //$oldInvoiceNo . '-1';
						$inv->ref = $invRef;
						$inv->date = date('Y-m-d');
						$inv->posted = $inv->date;
						$inv->status = Invoice::INVOICE_STATUS_PENDING; // set as posted which means will send to client for paying
					}
				}
				// if not existing or not pending(1) or posted(2) or overdue(3) we create a new one
				$isUpdate = true;
				if (empty($inv) || (!$weUpdate && $inv->status > 3)) {
					$inv = new Invoice;
					$isUpdate = false;
					if($im->owner_id == Org::ORGID_CLIENT_PCAE)
					{
						$inv->date = $im->created; // for update we shouldn't change invoice data
					}else
					{
						$inv->date = date('Y-m-d'); // for update we shouldn't change invoice data
					}
					$inv->status = Invoice::INVOICE_STATUS_PENDING; // set as pending which means will send to client for paying via email at night
				}

				$inv->type = Invoice::INVOICE_TYPE_IMPORT; // for import parcels
				$inv->dpmt = Invoice::DPMT_IMPORT;
				$inv->to_id = $to_id;
				if($owner->by >1) $inv->mdata['suborg'] = $owner->id;
				$inv->consol_id = $im->id;
				$inv->man_id = 0; // in case there is no manifest now
				$inv->dpt_id = $im->dpt_id;

				// try to get org price rate
				$orgRate = OrgRate::model()->find('org_id = :oid AND type = 40', [':oid' => $owner->id]);
				if (empty($orgRate)) {
					//  $errors[] = 'Owner: ' . $owner->id . ' price rate is not available yet';
					$inv->currency = 1; // default as AUD
				} else {
					$inv->currency = $orgRate['currency'];
				}

				// calculate price based on awb weight
				$items = [];

				// create invoice based on chargeable
				// 1.	Customs Declaration*  AUD85
				//  2.	Airline Document Fee *  AUD50
				// 3.	CMR Fee *  AUD15
				// 4.	Airline Terminal Fee ^  $0.50/kg
				// 5.	Airline Breakbulk Fee^  $0.1/kg
				// 6.	Delivery Fee^   $0.2/kg
				// 7.	Customs Duties & Fees
				$tot = 0;

				// get rate returned as [kg_rate, pc_rate,fixedRates,includingDelivery, airfreightRates]
				$rate = $im->getChargeRate($owner);
				// in case need to charge for Australia local delivery fee
				if ($rate[3]) {
					$shipments = $org['shipments'];
					$result = $this->genShipmentsInvoicePro($owner, $orgRate, $shipments);
					// print_r($result);
					if ($result[0] > 0) {
						$tot = $result[0];
						$items = $result[1];
					}
					foreach ($shipments as $theShipment) {
						if (!empty($theShipment->tempErrors)) {
							$errors[]=$theShipment->tempErrors;
						}
					}
				}
				$im->calculateInvoiceExtendFee($inv,$items,$owner,$tot,$errors);//this only used for seaconsol in imcoconsol
				// $items = $extendsFee['items'];
				// $inv = $extendsFee['inv'];
				// $owner = $extendsFee['owner'];
				// $tot = $extendsFee['tot'];
				// $errors = $extendsFee['errors'];

				if (!empty($errors)) {
					return $errors;
				}

				// for local australia charge
				$showDetails = 0;
				if (isset($rate[2]) && isset($rate[2]['showdetails'])) {
					$showDetails = $rate[2]['showdetails'];
				}
				$totWeight = 0;
				if ($showDetails) {
					foreach ($org['shipments'] as $shipment) {
						//skip ausriver with chargecode
						if ($id == 1247 && !empty($im->mdata['charge_code'])) continue;
						$single = $rate[0] * $shipment->weight + $rate[1];
						$totWeight += $shipment->weight;
						//  return array($amt, 0, $kg_rate, $this->weight);
						if ($single > 0) {
							$items[] = [$shipment->hbn, 'Australia Local Charge Fee', 1, $shipment->weight, 0, $single, 0, $rate[0], $shipment->weight];
							$tot += $single;
						}
					}
				} else {
					$org_awb_wt = $cgb_wt;
					if (!empty($im->mdata['org_'.$id]['cgb_wt'])){
						$org_awb_wt = floatval($im->mdata['org_'.$id]['cgb_wt']);
					} else {
						$orgs = $im->getOrgsInfo();
						foreach ($orgs as $oid => $v) {
							$org_awb_wt -= floatval(@$im->mdata['org_'.$oid]['cgb_wt']);
						}
					}
					$localFee = floatval($rate[0]) * $org_awb_wt + floatval($rate[1]);
					//  return array($amt, 0, $kg_rate, $this->weight);
					if ($localFee > 0) {
						$items[] = [$im->awb, 'Australia Local Charge Fee', 1, $org_awb_wt, 0, $localFee, 0, $rate[0], $org_awb_wt, $org_awb_wt];
						$tot += $localFee;
					}
				}

				// for air freight charge
				if (!empty($rate[4]) && $rate[4]['rate'] > 0 && !empty($im->flight)) {

					// in case no real weight , we need to calculate again here
					if ($totWeight <= 0) {
						foreach ($org['shipments'] as $shipment) {
							$totWeight += $shipment->weight;
						}
					}

					if(count($orgShipments) == 1){
						$cw = $cgb_wt;
					}elseif(isset($im->mdata['org_'.$id]) && isset($im->mdata['org_'.$id]['cgb_wt'])) {
						$cw = $im->mdata['org_'.$id]['cgb_wt'];
					}

					if ($cw > 0) {
						$extraAmount =  $rate[4]['rate'] * $cw;
						$tot += $extraAmount;
						$items[] = ['Chargeable Weight', 'Air Freight', 1,$cw, 0, $extraAmount, 0, $rate[4]['rate'],$cw];
					}
				}

				// append another fixed fee
				// for example : DOC fee, THC fee, DLV fee and SAC fee
				$fixdRates = $rate[2];
				$packages = count($org['shipments']);

				// document fee, calculate by per AWB document
				if (isset($fixdRates['doc_rate']) && $fixdRates['doc_rate'] > 0) {
					$docRate = round($fixdRates['doc_rate'], 2);
					$tot += $docRate;
					$items[] = ['DOC', 'DOC Fee', 1, 0, 0, $docRate, 0, $docRate, 0];
				}
				// CMR FEE
				if (isset($fixdRates['crm_rate']) && $fixdRates['crm_rate'] > 0) {
					$cmrRate = round($fixdRates['crm_rate'], 2);
					$tot += $cmrRate;
					$items[] = ['CMR', 'CMR Fee', 1, 0, 0, $cmrRate, 0, $cmrRate, 0];
				}
				// THC fee, calculate by Chargable weight
				if (isset($fixdRates['thc_rate']) && $fixdRates['thc_rate'] > 0 && $cgb_wt > 0) {
					$thcRate = round($fixdRates['thc_rate'] * $cgb_wt, 2);
					$tot += $thcRate;
					$items[] = ['THC', 'THC Fee', $packages, $cgb_wt, 0, $thcRate, 0, $fixdRates['thc_rate'], 0];
				}

				// DLV fee, calculate by awb weight
				if (isset($fixdRates['dlv_rate']) && $fixdRates['dlv_rate'] > 0 && $awb_wt > 0) {
					$dlvRate = round($fixdRates['dlv_rate'] * $awb_wt, 2);
					$tot += $dlvRate;
					$items[] = ['DLV', 'Delivery Charge', $packages, $awb_wt, 0, $dlvRate, 0, $fixdRates['dlv_rate'], 0];
				}

				// Michelle approve calculate by Chargable weight
				// SAC fee, calculate by awb weight and piece
				if (isset($fixdRates['sac_rate']) && $fixdRates['sac_rate'] > 0 && $cgb_wt > 0) {
					$sacRate = round($fixdRates['sac_rate'] * $cgb_wt + $fixdRates['sac_prate'] * $packages, 2);
					$tot += $sacRate;
					$items[] = ['SAC', 'SAC Scan Fee', $packages, $cgb_wt, 0, $sacRate, 0, $fixdRates['sac_rate'], 0];
				}

				//Nz service not include gst
					
				if (preg_match('/C\d{8}NZ/i', $im->no)) {
					$includingGST=false;
				}
				
				// if including GST we add GST
				$gst = 0;
				if ($includingGST) {
					$gst = round($tot * 10 / 100, 2);
					$tot += $gst;
				}


				$tot = round($tot, 2);
				$inv->mdata['awb'] = $im->awb;
				$inv->mdata['name'] = $owner->name;
				$inv->mdata['address'] = $owner->getAddress();
				$inv->mdata['payterm'] = empty($owner->extra['payterm']) ? '2 days' : $owner->extra['payterm'] . ' days';
				$inv->due = Invoice::calcDue($inv->date, $inv->mdata['payterm']);
				$inv->total = $tot;
				$inv->gst = $gst;

				$new_items = $items;
				$new_items_processed = [];
				foreach ($new_items as $item) {
					$new_items_processed[$item[0].$item[1]] = $item;
				}

				// old invoice items
				$old_total = 0;
				$old_items_processed = [];
				// the first invoice
				if($owner->by >1){
					$old_invoices = Invoice::model()->with('lines')->findAll('type = 10 AND to_id = :id AND lines.model = :m AND lines.fid = :fid AND t.status IN '.(preg_match('/-/', $inv->no)? '(1,2,3,6,7,9)':'(2,3,6,7,9)').' AND json_value(t.meta, "$.suborg") = :suborg', [':id' => $to_id, ':m' => 'ImcoConsol', ':fid' => $im->id, ':suborg' => $owner->id]);
				}else{
					$old_invoices = Invoice::model()->with('lines')->findAll('type = 10 AND to_id = :id AND lines.model = :m AND lines.fid = :fid AND t.status IN '.(preg_match('/-/', $inv->no)? '(1,2,3,6,7,9)':'(2,3,6,7,9)'), [':id' => $to_id, ':m' => 'ImcoConsol', ':fid' => $im->id]);
				}
				foreach ($old_invoices as $invoice) {
					$old_items = $invoice->lines[0]->mdata['items'];
					if (empty($old_items)) continue;
					foreach ($old_items as $item) {
						if (empty($item[9])) $item[9] = $item[8];
						if (empty($old_items_processed[$item[0].$item[1]])) {
							$old_items_processed[$item[0].$item[1]] = $item;
						} else {
							$old_items_processed[$item[0].$item[1]][9] = $item[9];
							$old_items_processed[$item[0].$item[1]][5] += $item[5];
						}
					}
					if($inv->to_id==3441)
					{
						if($invoice->gst==0)
						{
							$invoice->gst = $invoice->total*0.1;
							$invoice->total = $invoice->total*1.1;
						}
					}
					$old_total += $invoice->total;
				}

				// old creditnote items
				if ($owner->by > 1) {
					$old_creditnotes = Payment::model()->findAll('ref = :ref AND status IN (1,6) AND org_id = :org_id AND json_value(t.meta, "$.suborg") = :suborg', [':ref' => 'Wt Diff for Consol: ' . $im->no, ':org_id' => $to_id, ':suborg' => $owner->id]);
				} else {
					$old_creditnotes = Payment::model()->findAll('ref = :ref AND status IN (1,6) AND org_id = :org_id', [':ref' => 'Wt Diff for Consol: ' . $im->no, ':org_id' => $to_id]);
				}
				foreach ($old_creditnotes as $creditnote) {
					foreach ($creditnote->credit_lines as $line) {
						$item[0] = explode(' ', explode(' - ', $line->description)[0])[0];
						$item[1] = implode(' ', array_slice(explode(' ', explode(' - ', $line->description)[0]), 1));
						$no = $item[0] . $item[1];
						preg_match('/Now is (\d*.\d*)kg/i', $line->description, $matches);
						$wt = $matches[1];
						if (empty($old_items_processed[$no])) {
							$old_items_processed[$no] = [$item[0], $item[1], '', '', '', $line->rate, '', '', '', $wt];
						} else {
							$old_items_processed[$no][9] = $wt;
							$old_items_processed[$no][5] -= $line->rate;
						}
					}
					$old_total -= $creditnote->amount;
				}

				$diff = [];
				foreach ($old_items_processed as $ref => $item) {
					if (empty($new_items_processed[$ref])) {
						$diff[] = [$item, []];
					} else if (round($item[5], 2) != round($new_items_processed[$ref][5], 2)) {
						$diff[] = [$item, $new_items_processed[$ref]];
					}
				}
				foreach ($new_items_processed as $ref => $item) {
					if (empty($old_items_processed[$ref])) {
						$diff[] = [[], $item];
					}
				}

				if (!empty($diff)) {
					$new_items = [];
					foreach ($diff as $item) {
						if (empty($item[0])) {
							$new_items[] = $item[1];
						} else if (empty($item[1])) {
							$item[0][5] = '-' . $item[0][5];
							$new_items[] = $item[0];
						} else {
							$item[1][10] = ' - Weight was ' . $item[0][9] . 'kg, Now is ' . $item[1][9] . 'kg';
							$item[1][5] = $item[1][5] - $item[0][5];
							$new_items[] = $item[1];
						}
					}
				}
				if ($inv->total - $old_total >= 0.01) {
					$inv->total = $inv->total - $old_total;
					if ($includingGST) {
						$inv->gst = round($inv->total / 11, 2);
					}
					$inv->save();
					$il = InvLine::model()->find('inv_id = :id', [':id' => $inv->id]);
					if(empty($il)){
						$il = new InvLine;
						$il->inv_id = $inv->id;
					}
					$il->amount = round($inv->total, 2);
					$il->gst = $inv->gst;
					$il->qty = 1;
					if ($inv->gst > 0) {
						$il->tax = 'OUTPUT';
					}
					$il->mdata['items'] = $new_items;
					$il->model = 'ImcoConsol';
					$il->fid = $im->id;
					$il->save();

					$msg[] = 'Invoice created';
				} else if ($old_total - $inv->total >= 0.01) {
					// all previous creditnote has been calculated, just create new
					$payment = new Payment;
					$payment->org_id = $to_id;
					if ($owner->by > 1) $payment->mdata['suborg'] = $owner->id;
					$payment->amount = round($old_total - $inv->total, 2);
					$payment->ata = $payment->amount;
					$payment->ref = 'Wt Diff for Consol: ' . $im->no;
					$payment->date = date('Y-m-d');
					$payment->bank = 91; // manual credit note
					$payment->currency = $inv->currency;
					$payment->status = Payment::PAYMENT_STATUS_POSTED;
					$payment->type = Payment::PAYMENT_TYPE_CREDIT_NOTE;
					$payment->dpmt = 10;
					$payment->mdata['consol'] = $im->no;
					$payment->flag = 1;
					$payment->save();

					$total = 0;
					foreach ($new_items as $item) {
						$il = new CreditLine;
						$il->pid = $payment->id;
						$il->description = $item[0] . ' ' . $item[1] . $item[10];
						$il->rate = floatval($item[5]) * -1;
						$il->qty = 1;
						$il->amount = floatval($item[5]) * -1;
						if ($includingGST) {
							$gst = round($il->amount*0.1, 3);
							$il->tax = 'OUTPUT';
						} else {
							$gst = 0;
							$il->tax = 'EXEMPTOUTPUT';
						}
						$il->gst = $gst;
						$il->amount += $il->gst;
						$il->gst = number_format($il->gst, 3, '.', '');
						$total += $il->amount;
						$il->amount = number_format($il->amount, 2, '.', '');
						$il->save();
					}
					$payment->amount = number_format($total, 2, '.', '');
					$payment->ata = number_format($total, 2, '.', '');
					$payment->save();

					$msg[] = 'Credit Note created';
				} else if ($inv->total == 0) {
					$msg[] = 'Total Amount is 0';
				} else {
					$msg[] = 'Total Amount does not changed';
				}
			}
		} else {
			$errors[] = 'Please set console AWB weight and Chargeable weight firstly';
		}

		if (empty($errors)) $errors = [];
		if (empty($msg)) $msg = [];
		return array_unique(array_merge($errors, $msg));
	}

	public function genShipmentsInvoicePro(&$owner, &$orgRate, &$shipments)
	{
		$items = [];
		$tot = 0;

		$isJiacheng = false;
		if ($owner->id == Org::ORGID_CLIENT_JIACHENG) {
			$isJiacheng = true;
		}
		$i=1;
		$check = true;
		foreach ($shipments as $p) {
			if($p->scanCount()>0)
			{
				$check = true;
			}
		}

		foreach ($shipments as $p) {
			if(!$p->is3PL())
			{
				echo $p->ref;
				//for org 1247 if the shipment not have chargecode, we don't charge local delivery fee.
							
				if ($p->agent_id==1247&&empty($p->mdata['chargecode'])) {
					continue;
				}
				
				if (empty($p->scan_data[50])&&($p->cbwf&32)==0&&($p->cbwf&64)==0) {//only the parcel without scan and direct flag will be ignored
					//if not scanned, not generate invoice.
					continue;
				}

				if (preg_match('/^AGDSY\d+$/', $p->hbn)){ //covered in separate direct invoice
					continue;
				}
			}

			$amt = $p->getChargePro($owner, $orgRate);		
			if ($amt[0] <= 0) {
				echo "x";
				// $p->tempErrors = $p->hbn.' has no rate';
				continue;
			} // ignore zero invoice item

			// in case jiacheng , we need show postcode in description
			// jiacheng agent id : 838
			// when show invoice , we need parse desc field to get postcode
			$desc = $p->getDesc();
			if (!empty($p->mdata['cust_invoice_ref'])) {
				$desc.= '('.$p->mdata['cust_invoice_ref'].')';
			}
			if ($isJiacheng) {
				$desc .= '-'. $p->cnee->postcode;
			}
			if (!empty($p->mdata['letter_aupost'])) {
				$desc=empty($p->mdata['letter_aupost'])?$p->getDesc(): ImParcel::$letter_types[$p->mdata['letter_aupost']];
			}

			$cbm = $p->getTotalCBM();
			$cbm = $cbm == 0.000001 ? "0.000001" : $cbm;
			if (empty($desc)) $desc = 'null';
			else $desc = str_replace('"', '', json_encode($desc));
			$items[] = [$p->ref, $desc, $p->pkg, $p->weight, $cbm, $amt[0], $p->cnee->postcode,$amt[1], $amt[2], $amt[3]];

			if(($p->cbwf&16)>0)
			{
					$cFee = SystemSetting::getCorrectAddressFee();
					$p->mdata['correct_address_fee']=$cFee;
					$items[] = [$p->hbn, 'Correct Address Fee',0, 0, 0, $cFee, 0, 0, 0, 0];
					$tot += $cFee;
			}
			// in case parcel with insurance
			// we add insurance value to total value
			//fastway dont not need to add insurance charge
			if (isset($p->trans) && !empty($p->trans) && $p->trans[0]->org_id == Org::ORGID_COURIER_FASTWAY) {
				//fastway donot need to add insurance charge
			} else {
				if ($p->insurance > 0) {
					$insuranceRatio = 1;
					if (!empty($owner->extra['insurance_invoice_ratio'])) {
						$insuranceRatio = floatval($owner->extra['insurance_invoice_ratio']);
					}
					$invInsurance = round($p->insurance * ($insuranceRatio / 100), 2);
					$p->mdata['insurance_charge_client']=$invInsurance;
					$items[] = [$p->hbn, 'Insurance Fee',0, 0, 0, $invInsurance, 0, 0, 0, 0];
					$tot += $invInsurance;
				}
				$ss = new OrgRate('search');
				if (!empty($p->mdata['is_dg'])) {
					$isDg = 1;
					$cus_services = $ss->getCustomerServicePlans($p->agent_id);
					if (isset($cus_services['services']->AU->dg_fee)) {
						$dgFee = $cus_services['services']->AU->dg_fee;
						$invDg = $dgFee;
						$p->mdata['dg_charge_client']=$invDg;
						$items[] = [$p->ref, 'Dangerous Goods Fee',0, 0, 0, $invDg, 0, 0, 0, 0];
						$tot += $invDg;
					}
				}

				// if (($p->bwf&ImParcel::EMPPCODE)>0) {
				// 	$cus_services = $ss->getCustomerServicePlans($p->agent_id);
				// 	if (isset($cus_services['services']->AU->empp_fee)) {
				// 		$emppFee = $cus_services['services']->AU->empp_fee;
				// 		$invEmpp = $emppFee;
				// 		$p->mdata['empp_charge_client']=$invEmpp;
				// 		$items[] = [$p->ref, 'EMPP Handling Fee',0, 0, 0, $invEmpp, 0, 0, 0, 0];
				// 		$tot += $invEmpp;
				// 	}
				// }

				// if (($p->bwf&ImParcel::AQISCODE)>0) {
				// 	$cus_services = $ss->getCustomerServicePlans($p->agent_id);
				// 	if (isset($cus_services['services']->AU->aqis_fee)) {
				// 		$aqisFee = $cus_services['services']->AU->aqis_fee;
				// 		$invAqis = $aqisFee;
				// 		$p->mdata['aqis_charge_client']=$invAqis;
				// 		$items[] = [$p->ref, 'AQIS Handling Fee',0, 0, 0, $invAqis, 0, 0, 0, 0];
				// 		$tot += $invAqis;
				// 	}
				// }
			}
			//2019-09-10
			if(!empty($p->mdata['changeLabel']))
			{
				$invChangeLabel = round($p->mdata['changeLabel']*SystemSetting::getChangeLabelChargeSetting("unit_price"), 2);
				$items[] =[$p->hbn, 'Change Label Fee',0, 0, 0, $invChangeLabel, 0, 0, 0, 0];
				$tot += $invChangeLabel;
			}

			$tot += $amt[0];
			$p->mdata['charge_client_amount']= number_format($amt[0], 4, '.', '');
			$p->mdata['charge_client_weight']= number_format(isset($amt[3])?$amt[3]:$p->chargeWeight(), 2, '.', '');
			$p->updateMeta();
		}
		$items = array_filter($items, function($v) {
			return !empty($v);
		});
		return [$tot,$items];
	}

