	public function fixWDTConsol()
	{
		$wdtConsols = ImcoConsol::model()->findAll('no like "WDT%" and status=100');
		foreach ($wdtConsols as $key => $consol)
		{
			$check = false;
			$ss = $consol->shipments;
			
			foreach ($ss as $key => $s) {
					if($s->status!=ImParcel::STATE_CANCELLED)
					{
						$check = true;
						break;
					}
			}

			if($check===true)
			{
				$consol->status = 10;
				$consol->save();
				echo $consol->no;
			}
		}
	}

	public function sendSorryEmail()
	{
		$emailList = ["gero@toplogistics.com.au"];

		foreach ($emailList as $key => $value) {
			$files = [];
			$fs= FileRepo::model()->findAll('id in ( 8442961,8440912)');
			foreach ($fs as $f) {
				$files[]=[$f->getFile(), $f->name];
			}
			print_r($files);
			$emailLog = new Emailog();
			$emailLog->fid = 0;
			$emailLog->type= Emailog::SORRY;
			$emailLog->dt = date('Y-m-d H:i:s');
			$emailLog->status = 10;
			$emailLog->prepTemplate();
			$emailLog->subject = $emailLog->tpl->subject;
			$emailLog->body = $emailLog->tpl->getContent();
			$emailLog->mdata['to']=$value;
			$emailLog->mdata['fromName']='TLA Customer Service';
			$emailLog->mdata['from']='importscs@toplogistics.com.au';
			print_r($emailLog->sendEmail($files));
		}

	}

