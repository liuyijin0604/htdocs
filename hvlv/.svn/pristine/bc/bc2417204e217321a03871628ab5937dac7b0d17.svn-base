	public function fixMissAuspostManifest()
	{
		$record = '';

			$r = json_decode($record, true);
			$mani = Manifest::model()->find('type = 90 and ref = :ref',[':ref'=>'2021-08-11AP']);
			$oid = '2021-08-11AP';
			if(empty($mani))
			{	
				$mani = new Manifest();
				$mani->type = 90;
				$mani->created = '2021-08-07 23:31:20';
				$mani->ref = '2021-08-11AP';
			}else
			{
				$mani->created = '2021-08-07 23:31:20';
			}

			if(!$mani->save())
			{
				print_r($mani);
				return;
			}

			foreach($r['shipments'] as $s)
			{
				$p = ImParcel::model()->find('hbn = :n', [':n' => $s['shipment_reference']]);
				if(empty($p))
				{
					echo $s['shipment_reference'], ' not found!', PHP_EOL;
					continue;
				}

				$maniMap = ManiMap::model()->with(['manifest'])->find("manifest.type = 90 and model = 'ImParcel' and fid = :fid",[":fid"=>$p->id]);
				if(empty($maniMap))
				{
					$maniMap = new ManiMap();
				}

				$maniMap->mani_id = $mani->id;
				$maniMap->model = 'ImParcel';
				$maniMap->fid = $p->id;
				$maniMap->status = 10;
				$maniMap->mdata['mani_time'] = date('Y-m-d H:i:s',strtotime($r['order']['order_creation_date']));

				if(!$maniMap->save())
				{
					print_r($maniMap);
					return;
				}
				$trans = null;
				if(!empty($p->trans))
				{
					foreach ($p->trans as $key => $tran) {
						if($tran->org_id==101)
						{

							$trans = $tran;
							break;
						}
					}
					
				}
				if(empty($trans))
				{
					$ts = new Tranship;
					$ts->pid = $p->id;
					$ts->org_id = 101;  // for Australia post office
					$ts->man_id = $p->man_id;
					$ts->type = 80;  // shipment transfer to a different delivery courier
					$ts->status = 19; // in finally moving status
					$ts->connote = $p->ref;
					$ts->time = date('Y-m-d H:i:s');
					$ts->mdata['oid'] = $oid;
					$costValue = Shipment::getCourierCostByShipment($p->ref, $p->mdata['org_rate_id'], $p->weight)['price'];;
					$ts->cost = round($costValue, 2);
					$ts->save();
					if (!empty($p->mdata['direct_courier'])&&$p->mdata['direct_courier']==2) {
						$p->cbwf=($p->cbwf^32)&$p->cbwf;
						$p->cbwf=$p->cbwf|64;
						$p->mdata['direct_courier']=1;
						$p->updateMeta();
						$p->update(['cbwf']);
					}
					// if($p->status<30)
					// {
					// 	$p->status = 30;
					// 	$p->save();
					// }
				}else
				{
					$trans->mdata['sid'] = $s['shipment_id'];
					$trans->save();
				}
			}
			// echo $r['order']['order_id'], "\t", $r['order']['order_creation_date'], "\t", $r['order']['order_summary']['total_cost'], "\t", $r['order']['order_summary']['number_of_shipments'], "\t", $r['order']['order_summary']['number_of_items'], PHP_EOL;
	}

	public function exportTimeReport()
	{
		$model=new ImParcel('search');
		$model->unsetAttributes();  // clear any default values
		$model->mids = [];

		$model->consol_id = '>0';
		$model->status = '>50';

		$xls = new oExcel;
		$i = 1;
		// $xls->addRow($i++, ['WBN', 'Ref','Awb','Packages', 'Weight', 'Status', 'Agent', 'Sender', 'Sender Tel', 'Cnee Name', 'Cnee Tel', 'Address', 'State', 'Date', 'Delay','Extra Info']);
		$xls->addRow($i++, ['包裹追踪号', '柜号 / 提单号','Memo','状态','拆柜时间', '从PCA仓库出库时间', '派送商揽收时间	', '妥投时间', '最后一条追踪轨迹字段', '最后一条追踪轨迹对应的时间']);
		$dp = $model->search(false);
		foreach ($dp->data as $r) {
			$xls->addRow($i++, [$r->ref, @$r->consol->awb."  /  ".@$r->consol->mdata["container_no"],$r->can, ImParcel::$states[$r->status],ImParcelService::getTimePoint($r,1),ImParcelService::getTimePoint($r,2),ImParcelService::getTimePoint($r,3),ImParcelService::getTimePoint($r,4),is_array(ImParcelService::getTimePoint($r,5))?ImParcelService::getTimePoint($r,5)[0]:"",is_array(ImParcelService::getTimePoint($r,5))?ImParcelService::getTimePoint($r,5)[1]:""]);
		}
		$xls->output( Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR.'time_report_'.time().'.xlsx',null,false);
	}

	public function findCBM()
	{
		$final = [];
		$fullString = file_get_contents(Yii::app()->basePath.DIRECTORY_SEPARATOR.'runtime'.DIRECTORY_SEPARATOR . 'shipmentapi' . DIRECTORY_SEPARATOR."shipment_api_2020-07-07.log");
		$saichengData =preg_match_all("/{\"api_id\":\"expressworldwide\".*cref.*update.*}\n/",$fullString,$m);
		$crefArr = ['WBY11392007070001','WBY11252007070005','WBY10782007070001','WBY11662007070002','WBY10772007070002','WBY11052007070001','WBY10622007070002','WBY10712007070001','WBY10412007070001','WBY10252007070002','WBY10082007070001','WBY11092007070003','WBY11092007070002','WBY11662007070001','WBY10082007070002','WBY11092007070001','WBY11162007060001','WBY12492007060002','WBY11192007060003','WBY11252007070006','WBY10752007060001','WBY10752007060002','WBY11512007070001','WBY11622007070002','WBY11392007040001','WBY10802007060001','WBY12482007050001','WBY11682007040001','WBY11372007060001','WBY11122007030001','WBY12472007040001','WBY11552007030001','WBY11192007020001','WBY11892007020001','WBY12472007060001','WBY11192006240001','ECN11662006230002','ECN11192006230001','ECN10242006190001','ECN10012006220006','ECN10232006180001','ECN10682006180002','ECN11362006220001','ECN10412006230001'];
		foreach ($m[0] as $key => $value) {
			$value = str_replace('"{\"', '{\"', $value);
			$value = str_replace('\"}"', '\"}', $value);
			$value = str_replace('\"', '"', $value);
			$data = json_decode($value,true)['data'];
			if(in_array($data['cref'],$crefArr))
			{
				$final[$data['cref']]='update shipment set cbm = '.$data['cbm'].' where cref = "'.$data['cref'].'";';
			}
		}
		
		$fullString = file_get_contents(Yii::app()->basePath.DIRECTORY_SEPARATOR.'runtime'.DIRECTORY_SEPARATOR . 'shipmentapi' . DIRECTORY_SEPARATOR."shipment_api_2020-07-08.log");
		$saichengData =preg_match_all("/{\"api_id\":\"expressworldwide\".*cref.*update.*}\n/",$fullString,$m);
		$crefArr = ['WBY11392007070001','WBY11252007070005','WBY10782007070001','WBY11662007070002','WBY10772007070002','WBY11052007070001','WBY10622007070002','WBY10712007070001','WBY10412007070001','WBY10252007070002','WBY10082007070001','WBY11092007070003','WBY11092007070002','WBY11662007070001','WBY10082007070002','WBY11092007070001','WBY11162007060001','WBY12492007060002','WBY11192007060003','WBY11252007070006','WBY10752007060001','WBY10752007060002','WBY11512007070001','WBY11622007070002','WBY11392007040001','WBY10802007060001','WBY12482007050001','WBY11682007040001','WBY11372007060001','WBY11122007030001','WBY12472007040001','WBY11552007030001','WBY11192007020001','WBY11892007020001','WBY12472007060001','WBY11192006240001','ECN11662006230002','ECN11192006230001','ECN10242006190001','ECN10012006220006','ECN10232006180001','ECN10682006180002','ECN11362006220001','ECN10412006230001'];
		foreach ($m[0] as $key => $value) {
			$value = str_replace('"{\"', '{\"', $value);
			$value = str_replace('\"}"', '\"}', $value);
			$value = str_replace('\"', '"', $value);
			$d = json_decode($value)->data;
			if(in_array($d->cref,$crefArr))
			{
				$cbm=0;
				$calculateCbm=0;
				$packs = [];
				foreach ($d->packages as $index=>$pack){
					$length = 0;
					if(isset($pack->depth))
					{
						$length= $pack->depth;
					}elseif(isset($pack->length))
					{
						$length= $pack->length;
					}

					$packs[$index]=['weight'=>$pack->weight,'length'=>$length,
						'height'=>isset($pack->height)?$pack->height:0,'width'=>isset($pack->width)?$pack->width:0,
						'reference'=>isset($pack->reference)?$pack->reference:0];
					if(!empty($pack->cbm)){
						$packs[$index]['cbm'] = $pack->cbm;//M3
					} elseif($packs[$index]['length']*$packs[$index]['width']*$packs[$index]['height']>0){
						$packs[$index]['cbm']= number_format($packs[$index]['length']*$packs[$index]['width']*$packs[$index]['height']/1000000, 6, '.', '');
					} else {
						$packs[$index]['cbm']=0;
					}

					$cbm += $packs[$index]['cbm'];
					$calculateCbm += number_format($packs[$index]['length']*$packs[$index]['width']*$packs[$index]['height']/1000000, 6, '.', '');
				}
				$cbm=number_format(max($cbm, $calculateCbm)/($index+1), 6, '.', '');

				$final[$data['cref']]='update shipment set cbm = '.$data['cbm'].' where cref = "'.$data['cref'].'";';
			}
		}

		print_r($final);

	}

	public function checkCache()
	{
		$key = $this->prompt('key');
		$result = Yii::app()->cache->get($key);
		print_r($result);
	}

	public function refreshErrorType()
	{
		$id = $this->prompt('id');
		$siReconcile = SiReconcile::model()->findByPk($id);
		$transaction=Yii::app()->db->beginTransaction();
		try {
			foreach($siReconcile->lines as $key => $line) 
			{
				if(in_array($line->item_code, ['eparcel','eparcel-fuel']))
				{
					if(($line->inlines[0]->type&SiReconcileLine::TYPE_3PL)>0)
					{
						$line->type = $line->type|SiReconcileLine::TYPE_3PL;
						$line->update(["type"]);
					}
				}
			}
			$transaction->commit();
		} catch (Exception $ex) {
			$transaction->rollback();
			throw $ex;
		}

	}


	public function generateCogsLineByManifest()
	{
		$datef = $this->prompt('datef');
		$datet = $this->prompt('datet');
		$manifests = Manifest::model()->findAll("type = 90 and created >= :datef and created <= :datet",[":datef"=>$datef,":datet"=>$datet]);
		$aupostInfoArr = [];
		foreach ($manifests as $key => $manifest) {
			$pids = array_column($manifest->lines, 'fid');
			if($manifest->fwd_id == 101)
			{
				$allAPTranships = Tranship::model()->with('shipment')->findAll('shipment.status<=90 and json_value(t.meta,"$.oid") = :apmanifest and org_id = 101',[":apmanifest"=>$manifest->ref]);
				if(!empty($allAPTranships))
				{
					foreach (AusPostAPI::$api_accounts_info as $key => $api_accounts) {
						if(preg_match('/^'.$api_accounts['id'].'/', $allAPTranships[0]->connote))
						{
							$auType = $key;
						}
					}
				}

				/******************* get the eparcel info from auspost api***************************/
				$aus = new AusPostAPI($auType);
				$batchShipments=[];
				$idSidRe = [];
				foreach ($allAPTranships as $key => $apTranship) 
				{
					if($key%200==0)
					{
						$batchShipments[]=[];
					}
					$batchShipments[count($batchShipments)-1][]=$apTranship->mdata['sid'];
					$idSidRe[$apTranship->mdata['sid']] = $apTranship->pid;
				}
				$auShipmentArr = [];
				foreach ($batchShipments as $key => $bs) {
					$thisShipmentArr = $aus->getShipments(join(',',$bs))->shipments;
					if(!empty($thisShipmentArr))
					{
						$auShipmentArr = array_merge($auShipmentArr, $aus->getShipments(join(',',$bs))->shipments);
					}
				}
				
				foreach ($auShipmentArr as $key => $auShipment) {
					$itemArr = [];
					foreach ($auShipment->items as $key => $item) {
						$itemArr[] = [$item->weight,$item->postage_details->price->calculated_price_ex_gst,$item->tracking_details->article_id];
					}
					$fuelSurcharge = isset($auShipment->shipment_summary->fuel_surcharge)?$auShipment->shipment_summary->fuel_surcharge:0;
					$aupostInfoArr[$idSidRe[$auShipment->shipment_id]] = ['itemArr'=>$itemArr,'fuelSurcharge'=>$fuelSurcharge];
				}
				echo "2";
			}
		}


		foreach ($manifests as $key => $manifest) {
			$transaction=Yii::app()->db->beginTransaction();
			try {
				foreach ($manifest->lines as $key => $mani) 
				{
					$p = ImParcel::model()->findByPk($mani->fid);
					$cost = 0;
					foreach ($p->trans as $key => $t) {
						if($t->org_id==$manifest->fwd_id)
						{
							$cost = $t->cost;
							break;
						}
					}
					if(empty($cost))
					{
						continue;
					}
					$cogs = CogsLine::model()->find("charge_code = '91031' and item_code='item' and fid = :fid and model = 'ImParcel'",[":fid"=>$p->id]);
					if(empty($cogs))
					{
						$cogs = new CogsLine();
						$cogs->type = 1;
						$cogs->charge_code = '91031';
						$cogs->status = 1;
						$cogs->org_id = $manifest->fwd_id;
						$cogs->fid = $p->id;
						$cogs->model = 'ImParcel';
						$cogs->created = $p->created;
						$cogs->dpmt = 10;
						$cogs->gst = "INPUT";
						$cogs->desc = "";
						$cogs->qty = 1;
						$cogs->price = 0;
						$cogs->dpt_id = $p->ddpt_id;
						$cogs->currency = 1;
						$cogs->actual_amount = 0;
						if(!empty($aupostInfoArr[$p->id]))
						{
							foreach ($aupostInfoArr[$p->id]['itemArr'] as $key => $item) {
								$cogs->actual_amount += $item[1];
							}
						}
						$cogs->accrual_amount = $cost;
						$cogs->accrual_gst_amount  = $cost*0.1;
						$cogs->actual_gst_amount = 0;
						$cogs->item_code = 'item';
						$cogs->save();
					}else
					{
						if($cogs->actual_amount == 0)
						{
							if(!empty($aupostInfoArr[$p->id]))
							{
								foreach ($aupostInfoArr[$p->id]['itemArr'] as $key => $item) {
									$cogs->actual_amount += $item[1];
								}
								$cogs->actual_gst_amount =$cogs->actual_amount*0.1;
							}
							$cogs->save();
						}
					}
				}
				echo "1";
				$transaction->commit();
			} catch (Exception $ex) {
				$transaction->rollback();
				throw $ex;
			}
		}
	}
	public function splitEmailList()
	{
		$str = '';
		$emailArr = explode(';',$str);
		$pcaexpress = [];
		foreach ($emailArr as $key => $email) {
			if(preg_match('/pcaexpres/', $email))
			{
				$pcaexpress[$email] = $email;
			}
		}

		echo join(',',$pcaexpress);
	}

