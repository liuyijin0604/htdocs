	public function fixAuspostManifest2()
	{
		$shipments = Shipment::model()->findAll("ref in ('AMQ5809369','AMQ5810170','AMQ5810235','AMQ5811002','AMQ5811426','AMQ5811921','AMQ5812107','AMQ5812108','AMQ5812112','AMQ5812240','AMQ5812249','AMQ5812254','AMQ5812370','AMQ5812375','AMQ5812402','AMQ5812594','AMQ5812630','AMQ5812656','AMQ5812662','AMQ5812693','AMQ5812703','AMQ5812723','AMQ5812756','AMQ5812757','AMQ5812770','AMQ5812772','AMQ5812788','AMQ5812789','AMQ5812790','AMQ5812791','AMQ5812811','AMQ5812901','AMQ5812936','AMQ5812938','AMQ5812992','AMQ5813001','AMQ5813018','AMQ5813034','AMQ5813054','AMQ5813056','AMQ5813082','AMQ5813092','AMQ5813093','AMQ5813097','AMQ5813101','AMQ5813102','AMQ5813111','AMQ5813121','AMQ5813126','AMQ5813127','AMQ5813147','AMQ5813192','AMQ5813273','AMQ5813275','AMQ5813278','AMQ5813345','AMQ5813366','AMQ5813406','AMQ5813408','AMQ5813409','AMQ5813414','AMQ5813437','AMQ5813438','AMQ5813439','AMQ5813440','AMQ5813441','AMQ5813447','AMQ5813452','AMQ5813465','AMQ5813491','AMQ5813493','AMQ5813529','AMQ5813609','AMQ5813610','AMQ5813611','AMQ5813612','AMQ5813613','AMQ5813614','AMQ5813615','AMQ5813617','AMQ5813620','AMQ5813629','AMQ5813635','AMQ5813638','AMQ5813639','AMQ5813640','AMQ5813655','AMQ5813659','AMQ5813686','AMQ5813687','AMQ5813688','AMQ5813691','AMQ5813702','AMQ5813795','AMQ5813809','AMQ5813843','AMQ5813844','AMQ5813845','AMQ5813904','AMQ5813905','AMQ5814001')");
		//auspost lodgement
		$ss = [];
		$transaction=Yii::app()->db->beginTransaction();
		$err = [];
		$ars = [];
		
		try {
			foreach ($shipments as $s) {
				if (preg_match('/^(AMQ|333UF|33EVH|33EVJ|34AWE)\d{7}/', $s->ref, $m) && ($s->cbwf&ImParcel::CBWF_DIRECT_CONSOL_BASE)==0) { // only for eParcel shipment and Not sent yet
					// check if manifested
					if (!empty($s->trans)) {
						foreach ($s->trans as $tran) {
							if ($tran->connote == $s->ref) continue 2;
						}
					}

					if(!empty($s->mdata['aupost_return'])){
						if(empty($s->mdata['ap_sid'])) $ars[$s->hbn] = $s;
						continue;
					} else if (!empty($s->mdata['aupost_exp'])) {
						if (empty($s->mdata['ap_sid'])) $aes[$s->hbn] = $s;
						continue;
					}
					// add a feature for logment eparcel before report custom port
					$direct_eparcel=false; //set a flag
					if (!empty($s->mdata['chargecode'])) {
						$chargecodeInfo= ImportChargeCode::model()->find('chargecode=:chargecode AND status=1', [":chargecode"=>$s->mdata['chargecode']]);
						if (!empty($chargecodeInfo)) {
							if (!empty($chargecodeInfo->mdata['direct_courier'])) {
								$direct_eparcel=true;
								$s->mdata['direct_courier']=2;// direct log eparcel 2 means a flag when success we will change it to 1
								$s->updateMeta();
							}
						}
					}
					// only for we received the shipment which means has been scanned in our warehouse
					// and status is cleared $s->getOutPkg() == $s->pkg
					if (($s->getOutPkg() > 0 && in_array($s->status, ImParcel::$allow_manifest_states)) ) {
						$s->cnee->checkPostcode();
						if(strlen($s->cnee->suburb) > 40){
							$err[] = $s->hbn.' suburb too long!';
						}else{
							$ss[$m[1]][] = $s;
						}
					}
				}
			}
			$transaction->commit();
		} catch (Exception $ex) {
			$transaction->rollback();
			throw $ex;
		}

		if (!empty($err)) {
			echo implode('<br />', $err);
			return false;
		}

		$consoleIds=[];

		foreach($ss as $k => $ps){
			$err = $this->doAupostManifest($ps, $k, $consoleIds, null);
		}
		


	
	}

	/**
	 *
	 * @param $ss  Array of shipments
	 * @param $apa  AupostApi Interface for each mild
	 * @return $err Array
	 */
	public function doAupostManifest($sst, $mlid, &$consoleIds, $cn)
	{
		$acc = AusPostAPI::mlid2acc($mlid);
		if(empty($acc)) return false;
		$apa = new AusPostAPI($acc);
		$err=[];
		$shipment_created = in_array($mlid, ['33MBQ']);
		$chargeCode = AusPostAPI::CHARGE_CODE_POD;

		if (!empty($sst)) {

			$max_ppg = 1000;
			$pgs = ceil(count($sst) / $max_ppg);
			$consoleIds = [];
			for($pg = 0; $pg < $pgs; $pg++){
				$ss = array_slice($sst, $pg * $max_ppg, $max_ppg);

					if($shipment_created){
						$r = $apa->createOrderFromShipments($ss, "fix20220908".($pgs>1? '-'.$pg : ''));
					}else{
						$r = $apa->createOrderIncludingShipments($ss, "fix20220908".($pgs>1? '-'.$pg : ''), $chargeCode);
					}
					if (!empty($apa->err)) {
						$oid = "fix".date('Y-m-d H:i:s');
						foreach ($apa->err as $key => $error) {
							$mani = Manifest::model()->find('type = 90 and ref = :ref',[':ref'=>$oid]);
							if(empty($mani))
							{	
								$mani = new Manifest();
								$mani->fwd_id=101;
								$mani->type = 90;
								$mani->created = date('Y-m-d H:i:s');
								$mani->ref = $oid;
							}else
							{
								$mani->created = date('Y-m-d H:i:s');
							}
							$mani->save();

							if($error->code=="44006")
							{
								$ref = $error->context->consignment_id;
								$s = Shipment::model()->find("ref=:ref",[":ref"=>$ref]);
								$maniMap = ManiMap::model()->find("mani_id = :mani_id and model = 'ImParcel' and fid = :fid",[":mani_id"=>$mani->id,":fid"=>$s->id]);
								if(empty($maniMap))
								{
									$maniMap = new ManiMap();
								}

								$maniMap->mani_id = $mani->id;
								$maniMap->model = 'ImParcel';
								$maniMap->fid = $s->id;
								$maniMap->status = 10;
								$maniMap->mdata['mani_time'] = date('Y-m-d H:i:s');
								$maniMap->save();


								$ts = new Tranship;
								$ts->pid = $s->id;
								$ts->org_id = 101;  // for Australia post office
								$ts->man_id = $s->man_id;
								$ts->type = 80;  // shipment transfer to a different delivery courier
								$ts->status = 19; // in finally moving status
								$ts->connote = $s->ref;
								$ts->time = date('Y-m-d H:i:s');
								$ts->mdata['oid'] = $oid;
								$ts->cost = 0;
								if(!empty($s->mdata['org_rate_id']))
								{
									$orgRate = OrgRate::model()->findByPk($s->mdata['org_rate_id']);
									$cost = ImcoConsol::getCourierCostPrice($orgRate, $s->cnee->postcode, $s->weight, $s->pkg, true, $s->cnee->suburb);
									$cost = $cost==99999?0:$cost;
									$ts->cost = round($cost, 2);
								}

								$ts->save();


							}
						}
						
					}
			}
		}
		return  $err;
	}

	public function get22KGSiReconcile()
	{
		$reconcileService = new ReconcileService();
		$appName = $this->prompt('appName');
		Yii::app()->name = $appName;
		//$recId = $this->prompt('recId');
		$lines = SiReconcileLine::model()->with("parent")->findAll('parent.org_id = 101 and item_code = "item" and parent.status !=100 and t.weight>22');
		$reconcileService = new ReconcileService();
		$reconcileService->appName = $appName;
		foreach ($lines as $key => $line)
		{
			if(!empty($line->imparcel)&&$line->imparcel->weight<22&&$line->imparcel->pkg==1&&!$line->imparcel->consol->is3PLOnly())
			{
				$orgRateId = $reconcileService->getOrgRateId($line->imparcel,"");
				if(empty($orgRateId)) continue;
				$oRate = Shipment::getCourierCostByShipment($line->ref, $orgRateId,$line->imparcel->weight);
				Yii::app()->name = "TLA";
				$nRate = Shipment::getCourierCostByShipment($line->ref, $orgRateId,$line->weight);
				Yii::app()->name = "TLA";
				echo $line->imparcel->agent_id,',',$line->ref,',',$line->imparcel->weight,',',$oRate['price'],',',$line->weight,',',$nRate['price'],',',$nRate['price']-$oRate['price'],PHP_EOL;
			}

		}
	}

	public  function deleteSiReconcileAll()
	{
		$appName = $this->prompt('appName');
		Yii::app()->name = $appName;
		$invNo = $this->prompt('inv no');
		$siReconciles = SiReconcile::model()->with(['parent'])->findAll('parent.inv_no in ('.$invNo.') and parent.status !=100');
		foreach ($siReconciles as $key => $siReconcile)
		{
			$siReconcile->status = 100;
			$siReconcile->save();
			$siReconcile->parent->status = 100;
			$siReconcile->parent->save();
			foreach ($siReconcile->lines as $key => $line)
			{
				$csl = CogsLineHasSiReconcileLine::model()->find('si_reconcile_line_id =:lid',[":lid"=>$line->id]);
				if(!empty($csl))
				{
					$c = CogsLine::model()->find('id = :cid',[':cid'=>$csl->cogs_line_id]);
					$c->delete();
					$csl->delete();
				}
			}
		}
	}


	public function cleanPlLedger()
	{
		while(true)
		{
			$sql = "SELECT * from (SELECT fid from pl_ledger where model = 'ImP_Manifest' and amt = 0 group by fid having count(fid) >1) t limit 5000";
			$fids = $this->db->createCommand($sql)->queryAll();
			echo "1";
			if(empty($fids))
			{
				break;
			}
			$fidArr = array_column($fids, 'fid');
			$sql2= " SELECT min(id) as id from pl_ledger where model = 'ImP_Manifest'  and amt = 0 and fid in (".join(',',$fidArr).") group by fid having count(fid) >1 ";
			$minIds = $this->db->createCommand($sql2)->queryAll();
			echo "2";
			$minIdArr = array_column($minIds, 'id');
			$sql3 = " DELETE from pl_ledger where fid in (".join(',',$fidArr).") and model = 'ImP_Manifest'  and amt = 0  and id not in (".join(',',$minIdArr).") ";
			echo $sql3;
			$this->db->createCommand($sql3)->execute();
		}
	}

