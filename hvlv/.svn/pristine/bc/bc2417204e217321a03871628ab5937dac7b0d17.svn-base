	public function getReportDetailBaseOnAgent2()
	{
		$consol = Consol::model()->findByPk(35863);
		$totCost = $consol->totCost();
		$orgList=$consol->getOrgListForReport(true);
		$tempOrgDetail = $consol->getReportDetail();
		$totalWegiht=$consol->totWeight();
		$orgDetail=[];
		print_r($orgList);
		foreach ($orgList as $org_id=>$org_name) {
			$orgDetail[$org_id]=['cost'=>0,'weight'=>@$tempOrgDetail[$org_id]['sub_weight'],
				'number'=>@$tempOrgDetail[$org_id]['number'],'revenue'=> $consol->getTotalInvoiceByOrg($org_id)];
		}

		print_r($orgDetail);

		if(!empty($orgList))
		{
			$haveToidBillings=[];  //op already input to_id billings
								$leftBillings=[];     //left no assign to_id billings
								$courerBillings=[];

			$billings= BillingLine::model()->findAll('billing_ref=:billing_ref AND status != 11 ', [':billing_ref'=> $consol->no]);
			foreach ($billings as $bill) {
				if (empty($bill->to_id)&&in_array($bill->org_id, Org::COURIERS)) {
					$courerBillings[]=$bill;
				} elseif (!empty($bill->to_id)) {
					$haveToidBillings[]=$bill;
				} else {
					$leftBillings[]=$bill;
				}
			}

			foreach ($haveToidBillings as $bi => $oneBill) {
				if (isset($orgDetail[$oneBill->to_id]['cost'])) {
					$orgDetail[$oneBill->to_id]['cost']+= floatval($oneBill->actual_amount>0?$oneBill->actual_amount:$oneBill->accrual_amount);
				} else {
					$orgDetail[$oneBill->to_id]['cost']= floatval($oneBill->actual_amount>0?$oneBill->actual_amount:$oneBill->accrual_amount);
				}
			}
			$courierCost=0;
			$tempCourierCost=0;
			$courierCostOrg=[];
			foreach ($courerBillings as $cBilling) {
				$courierCost+=floatval($cBilling->actual_amount>0?$cBilling->actual_amount:$cBilling->accrual_amount);
			}

			if(!empty($courerBillings))
			{
				foreach ($consol->shipments as $si=>$p) {
					$tempCost=$p->getDeliveryCost();
					if($p->agent_id == 1222)
					{
						echo $p->hbn."bbbbbb".$tempCost."aaaaaaa";
					}
					if (isset($courierCostOrg[$p->agent_id])) {
						$courierCostOrg[$p->agent_id]+=$tempCost;
					} else {
						$courierCostOrg[$p->agent_id]=$tempCost;
					}
					$tempCourierCost+=$tempCost;
				}
			}

			foreach ($courierCostOrg as $org_id=>$cost_delivery) {
				if (isset($orgDetail[$org_id]['cost'])) {
					$orgDetail[$org_id]['cost']+=$cost_delivery;
				} else {
					$orgDetail[$org_id]['cost']=$cost_delivery;
				}
			}

			if (!empty($leftBillings)) {
				$leftBillCost=0;

				foreach ($leftBillings as $bi => $oneBill) {
					$leftBillCost+= floatval($oneBill->actual_amount>0?$oneBill->actual_amount:$oneBill->accrual_amount);
				}
				foreach ($tempOrgDetail as $org_id=>$someDetail) {
					if($totalWegiht==0&&$someDetail['sub_weight']==0)
					{
						$orgDetail[$org_id]['cost']+= round($leftBillCost,2);
					}else
					{
						$orgDetail[$org_id]['cost']+= round($leftBillCost*$someDetail['sub_weight']/($totalWegiht>0?$totalWegiht:$someDetail['sub_weight']), 2);
					}
				}
			}
			if (key_exists(Org::ORGID_IMPORT_CASUAL_CUSTOMER, $orgDetail)) {
				$orgDetail[Org::ORGID_IMPORT_CASUAL_CUSTOMER]['revenue']=$consol->getTotalInvoiceByOrg(Org::ORGID_IMPORT_CASUAL_CUSTOMER);
			}
		}
		$allCost = 0;
		foreach ($orgDetail as $key => $org) 
		{
			$allCost += $org['cost'];
		}
		$leftCost = $totCost-$allCost;
		if($leftCost!=0)
		{
			foreach ($tempOrgDetail as $org_id=>$someDetail) 
			{
				if($totalWegiht==0&&$someDetail['sub_weight']==0)
				{
					$orgDetail[$org_id]['cost']+= round($leftCost,2);
				}else
				{
					$orgDetail[$org_id]['cost']+= round($leftCost*$someDetail['sub_weight']/($totalWegiht>0?$totalWegiht:$someDetail['sub_weight']), 2);
				}
			}
		}

		$allCost = 0;
		foreach ($orgDetail as $key => $org) 
		{
			$allCost += $org['cost'];
		}
		// print_r($orgDetail);
		echo "allCost".$allCost;
		echo "leftCost".$leftCost;
	}

	public function fixTracking()
	{
					//update sea info
		$rs = ImcoConsol::model()->findAll("status <= 60 AND `etd` > DATE_SUB(NOW(), INTERVAL 30 DAY) AND flight != '' AND awb != ''");
		echo '=== Found '.sizeof($rs)." import consol to update sea info. ===\n";
		$dconsols=[];
		$ds= DmawbConsol::model()->findAll("status<= 25 AND `etd` >DATE_SUB(NOW(), INTERVAL 30 DAY) AND flight != '' AND awb !=''");
		foreach($ds as $dc){
			if($dc->service==Consol::SEACONSOL) $dconsols[]=$dc;
		}

		foreach($rs as $r){
			if($r->service==Consol::SEACONSOL) $dconsols[]=$r;
		}

		foreach($dconsols as $r)
		{
			if(empty($r->mdata['slt'])) continue;
			$trans = Yii::app()->db->beginTransaction();
			$polInfor = SystemSetting::getPodSetting(substr($r->pol,0,2),$r->pol);
			$podInfor = SystemSetting::getPodSetting(substr($r->pod,0,2),$r->pod);
			try
			{
				if(!empty($r->mdata['slt']))
				{ //dispatched
					foreach($r->shipments as $p)
					{
						if($p->status == 38||$p->status == 39)
						{
							$check = Tracking::model()->findAll("pid=:pid and type = :type and activity =:activity",[":pid"=>$p->id,":type"=>38,"activity"=>'Sea vessel']);
							if(empty($check))
							{
								$p->addTracking(38, 'Sea vessel', $polInfor[0], $r->etd);
							}

							if(strtotime($r->eta)<=strtotime(Date("Y-m-d")))
							{
								$check = Tracking::model()->findAll("pid=:pid and type = :type and activity =:activity",[":pid"=>$p->id,":type"=>40,"activity"=>'Sea arrived']);
								if(empty($check))
								{
									if($p->status == 39)
									{
										$p->addTracking(40, 'Sea arrived', $podInfor[0], $r->eta);
									}

								}

								if($p->status == 38)
								{
									if(!empty($check))
									{
										$p->status = 39;
										$p->save();
									}
								}
							}
						}
					}
				}

				$trans->commit();
				echo '=== SeaConsol '.$r->no." , Size ".sizeof($rs)." import consol to update sea info. ===\n";
			} catch (Exception $ex) 
			{
				$trans->rollback();
				throw $ex;
			}
			continue;
		}
	}

	public function fixFastWayManifest()
	{
		// create invoice
		Yii::app()->name = 'TLA';
		$consolNo = $this->prompt('Consol No: ');
		$con = ImcoConsol::model()->find('no = :no',[":no"=>$consolNo]);
		$owner = $con->owner;
		$ownerId = $con->owner_id;
		$inv = Invoice::model()->find(" ref = :ref",[":ref"=>'fw'.date('Ymd', strtotime($con->created))]);

		$items = [];
		$tot = 0;

		// for special org 1206 client , we use special charge code
		// to calculate the voice
		$chargeCode = '';
		if ($ownerId == 1206) {
			$chargeCode = 8271;
		}
		$transaction = Yii::app()->db->beginTransaction();
		try {
			foreach ($con->shipments as $i => $p) {
				echo "a";
				$amt = $p->getChargeByChargecode($chargeCode, true);  // fastway with special charge code
				$p->mdata['charge_client_amount']= number_format($amt, 4, '.', '');
				$p->mdata['charge_client_weight']= number_format($p->weight, 2, '.', '');
				$p->updateMeta();
				if (!empty($p->tempChargeweight)) {
					$p->weight=$p->tempChargeweight;
				}
				$items[] = [$p->ref, $p->getDesc() , $p->pkg, $p->weight, $p->cbm, $amt,$p->cnee->postcode];
				$tot += $amt;
			}
			$transaction->commit();
		} catch (Exception $ex) {
			$transaction->rollback();
			Log::log2file("1206 Manifest Creating Invoice".$con->no."=>".$ex->getMessage(), "transaction_err_log", "transaction");
			throw $ex;
		}
		Yii::app()->name = 'TLA';
		$il = new InvLine;
		$il->inv_id = $inv->id;
		$il->ccode = 'EPA';
		$il->mdata['items'] = $items;
		$il->det = $con->no;
		$il->fid = $con->id;
		$il->model = 'ImcoConsol'; // invoice connected with console directly
		$il->amount = round($tot * 1000) / 1000;
		$il->qty = 1;
		Yii::app()->name = 'TLA';
		$il->save();
		Yii::app()->name = 'TLA';
		$inv->getTotal();

		$inv->mdata['name'] = $owner->name;
		$inv->mdata['address'] = $owner->getAddress();
		$inv->mdata['payterm'] = empty($owner->extra['payterm'])? 'COD' : $owner->extra['payterm'].' days';
		$inv->no = 'FW'.$inv->id;
		$inv->save();

		// update console's fastway cost billing
		ImcoConsol::updateImportConsoleBilling([$con->id]);

	}

	public function updatingShipments()
	{
		$shipments = ImParcel::model()->findAll( "  json_value(t.meta,'$.storageHeld') = 1  " );

		$transaction = Yii::app()->db->beginTransaction();
		try 
		{
			foreach ($shipments as $key => $p) 
			{
				$p->mdata['storageHeld'] = 2;
				echo $p->ref;
			}
			$transaction->commit();
		} catch (Exception $ex) {
			$transaction->rollback();
			throw $ex;
		}
	}

	public function testReconciliationFix()
	{
		$res = ReconciliationLine::model()->findAll('consol_id = 0');			
		foreach ($res as $key => $re) 
		{
			if(empty($re->consol_id))// when use the pre-manifest, sometimes the consol message is lost
			{
				echo $re->shipment_no;
				echo "AAA";
				$re->consol_id = $re->shipment->consol_id;
				if(!empty($re->consol_id))
				{
					echo "BBB";
					$consol = Consol::model()->findByPk($re->consol_id);;
					switch ($re->parent->client_type) {
						case Reconciliation::FASTWAY_TYPE:
						echo "CCC";
							// update console related real fastway delivery cost
							if ($consol->owner_id != 114) {
								$consol->updateFastWayRealCost($recModel->id);
							} else {
								$consol->updateWmsDeliveryCost(Org::ORGID_COURIER_FASTWAY,$re->parent_id);
							}
							break;
						case Reconciliation::AUPOST_TYPE:
							if ($consol->owner_id != 114) {
								$consol->updateAupostRealCost();
							} else {
								$consol->updateWmsDeliveryCost(Org::ORGID_COURIER_AUPOST, $re->parent_id);
							}
							break;
						case Reconciliation::STARTRACK_TYPE:
							if ($consol->owner_id != 114) {
									$consol->updateStartrackRealCost($re->parent_id);
							} else {
								$consol->updateWmsDeliveryCost(Org::ORGID_COURIER_STARTRACK, $re->parent_id);
							}
							break;
						case Reconciliation::D2Z_CLIENT:
							$consol->updateCourierRealCost(Org::ORGID_COURIER_D2Z, "33A8Y\d{7}|ZK6\d{7}|33PET\d{7}|33PEN\d{7}|33PEH\d{7}|SJU\d{7}|33G7K\d{7}|33A93\d{7}");
							break;
						case Reconciliation::TNT_CLIENT:
							$consol->updateCourierRealCost(Org::ORGID_COURIER_TNT, '(DKC|PCD|BPC)\d{9}');
							break;
						case Reconciliation::HUNTER_TYPE:
							$consol->updateCourierRealCost(Org::ORGID_COURIER_HUNTER,'(PB)\d{6}');
							break;
						case Reconciliation::ECOF_TYPE:
							$consol->updateCourierRealCost(Org::ORGID_COURIER_ECOF,'(33MBQ)\d{7}');
							break;
						
						default:
							# code...
							break;
					}
					$re->update('consol_id');
					echo "DDD";
				}

			}
		}
		
	}

