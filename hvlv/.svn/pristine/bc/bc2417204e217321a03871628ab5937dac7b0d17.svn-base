	public function fixSpSiReconcile()
	{
		Yii::app()->name = 'TLA';
		$siReconcileLines = SiReconcileLine::model()->findAll('rec_id = 557512');
		$reconcileService = new ReconcileService();
		$transaction=Yii::app()->db_tla->beginTransaction();
		try {
			foreach ($siReconcileLines as $key => $line)
			{
				$p = ImParcel::model()->find('ref = :ref',[":ref"=>$line->ref]);
				if(!empty($p))
				{
					$reconcileService->refreshShipment($line,"refresh");
				}

			}
			$transaction->commit();
		} catch (Exception $ex) {
			$transaction->rollback();
			throw $ex;
		}
	}

	public function fixSpSiReconcile2()
	{
		Yii::app()->name = 'TLA';
		$siReconcileLines = SiReconcileLine::model()->findAll('rec_id = 523532 and json_value(t.meta,"$.for_fix") = 1');

		$transaction=Yii::app()->db_tla->beginTransaction();
		$transaction2=Yii::app()->db->beginTransaction();
		try {
			foreach ($siReconcileLines as $key => $line)
			{
				$p = ImParcel::model()->find('ref = :ref',[":ref"=>$line->ref]);
				if(!empty($p))
				{
					$line->confirm_status = $line->confirm_status+15;
					DisputeLine::model()->deleteAll('si_reconcile_line_id = :sId',[':sId'=>$line->id]);
					// $dispute = DisputeLine::model()->find('si_reconcile_line_id = :sId',[':sId'=>$line->id]);
					// if(!empty($dispute))
					// {
					// 	$dispute->status = DisputeLine::Deleted;//DisputeLine::model()->deleteAll('si_reconcile_line_id = :sId',[':sId'=>$line->id]);
					// 	$dispute->save();
					// }
					$line->save();
				}

			}
			$transaction->commit();
			$transaction2->commit();
		} catch (Exception $ex) {
			$transaction->rollback();
			$transaction2->rollback();
			throw $ex;
		}
	}

