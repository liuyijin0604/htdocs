	public function dealWithGatePassShipment2()
	{
		$data1 = [];
		foreach ($data1 as $key => $d) {
			$gatepassShipment = GatepassShipment::model()->findByPk($d);
			$p = ImParcel::model()->findByPk($gatepassShipment->fid);
			$t = Tracking::model()->find(['condition'=>'pid = :pid and type = 60','params'=>[":pid"=>$p->id],'order'=>'id desc']);

			$scanDate = date('Y-m-d',strtotime($gatepassShipment->scan_time));
			$resortingRecord = ShipmentScan::model()->find('pid = :pid and type = 1',[':pid'=>$gatepassShipment->fid]);
			if(!empty($resortingRecord))
			{
				echo $gatepassShipment->connote_no;
				$scanDate = date('Y-m-d',strtotime($resortingRecord->scan_time));
			}
			$day = $scanDate;
			if(strtotime($t->dt)>strtotime($scanDate))
			{
				$scanDate = $t->dt;
			}
			$scanDate = date('Y-m-d',strtotime($scanDate));
			$gatepassCourier = null;
			$backupScanDate = $scanDate;
			while (empty($gatepassCourier)&&strtotime($scanDate)<time()) {
				$scanDate = HolidayHelper::getDateByBusinessDays(106,$scanDate,1,1);
				$gatepassCourier = GatepassCourier::model()->find(['condition'=>'courier_id = 101 and create_time>"'.$scanDate.'"','order'=>'id']);
			}

			if(!empty($gatepassCourier))
			{
				
				$myGatepassCourier = GatepassCourier::model()->find(['condition'=>'courier_id = 101 and create_time="'.$gatepassCourier->create_time.'" ']);
				if(!empty($myGatepassCourier))
				{
					$gatepassShipment->gate_pass_time = $myGatepassCourier->create_time;
					$gatepassShipment->status = 10;
					$gatepassShipment->parent_id = $myGatepassCourier->id;
					$gatepassShipment->save();
				}else
				{
					$check = 1;
					$thisId = $gatepassCourier->id +1;
					while (!empty($check)) {
						$thisId = $thisId +1;
						$check = GatepassCourier::model()->findByPk($thisId);
					}
					$myGatepassCourier = new GatepassCourier();
					$myGatepassCourier->courier_id = 101;
					$myGatepassCourier->id = $thisId;
					$myGatepassCourier->type = 0;
					$myGatepassCourier->driver_name = $gatepassCourier->driver_name;
					$myGatepassCourier->driver_rego = $gatepassCourier->driver_rego;
					$myGatepassCourier->ref = $gatepassCourier->ref;
					$myGatepassCourier->create_time = $gatepassCourier->create_time;
					$myGatepassCourier->status = $gatepassCourier->status;
					$gatepassCourier->mdata['ocourier_id'] = 101;
					$myGatepassCourier->meta = json_encode($gatepassCourier->mdata);
					$myGatepassCourier->mdata = $gatepassCourier->mdata;
					$myGatepassCourier->user_id =  $gatepassCourier->user_id;
					$myGatepassCourier->save();

					$gatepassShipment->gate_pass_time = $myGatepassCourier->create_time;
					$gatepassShipment->status = 10;
					$gatepassShipment->parent_id = $myGatepassCourier->id;
					$gatepassShipment->save();
				}
			}
		}
	}

	public function dealWithGatePassShipment3()
	{
		$data1 = [];
		foreach ($data1 as $key => $d) {
			$gatepassShipment = GatepassShipment::model()->findByPk($d);
			$p = ImParcel::model()->findByPk($gatepassShipment->fid);
			$t = Tracking::model()->find(['condition'=>'pid = :pid and type = 60','params'=>[":pid"=>$p->id],'order'=>'id desc']);

			$scanDate = date('Y-m-d',strtotime($gatepassShipment->scan_time));
			$resortingRecord = ShipmentScan::model()->find('pid = :pid and type = 1',[':pid'=>$gatepassShipment->fid]);
			if(!empty($resortingRecord))
			{
				echo $gatepassShipment->connote_no;
				$scanDate = date('Y-m-d',strtotime($resortingRecord->scan_time));
			}
			$day = $scanDate;
			if(strtotime($t->dt)>strtotime($scanDate))
			{
				$scanDate = $t->dt;
			}
			$scanDate = date('Y-m-d',strtotime($scanDate));
			$gatepassCourier = null;
			$backupScanDate = $scanDate;

			$after3Days = HolidayHelper::getDateByBusinessDays(106,$scanDate,1,1);

			if(strtotime($after3Days)>strtotime(date("Y-m-d")))
			{
				$after3Days = date("Y-m-d");
			}

			$myGatepassCourier = GatepassCourier::model()->find(['condition'=>'driver_name = "Ted" and driver_rego = "Xo12eb" and courier_id = 2619 and date_format(create_time,"%Y-%m-%d")="'.$after3Days.'" ']);
