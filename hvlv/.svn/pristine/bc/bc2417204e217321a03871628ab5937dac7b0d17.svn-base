AMQ5640167","T973779","1","1.82","0.000001",7.62,"3802",0,0,"1.82"],["AMQ5640168","T973803","1","2.99","0.000001",12.37,"6174",0,0,"2.99"],["AMQ5640169","T973815","1","1.83","0.000001",4.48,"2000",0,0,"1.83"],["AMQ5640170","T973827","1","3.75","0.000001",16.06,"4670",0,0,"3.75"],["AMQ5640172","T974793","1","0.43","0.000001",7.16,"2539",0,0,"0.43"],["AMQ5640173","T974805","1","0.37","0.000001",4.29,"2100",0,0,"0.37"],["AMQ5640188","T974721","1","1.65","0.000001",9.85,"2577",0,0,"1.65"],["AMQ5640189","T975273","1","4.35","0.000001",9.4,"2208",0,0,"4.35"],["AMQ5640190","T974781","1","0.17","0.000001",6.09,"5153",0,0,"0.17"],["AMQ5640205","T973959","1","4.79","0.000001",4.93,"2131",0,0,"4.79"],["AMQ5640206","T975057","1","0.30","0.000001",4.29,"2160",0,0,"0.30"],["AMQ5640207","T975081","1","0.15","0.000001",6.09,"4555",0,0,"0.15"],["AMQ5640208","T975117","1","0.15","0.000001",6.09,"6066",0,0,"0.15"],["AMQ5640209","T975141","1","0.29","0.000001",6.09,"4305",0,0,"0.29"],["AMQ5640214","T975177","1","2.60","0.000001",11.96,"7004",0,0,"2.60"],["AMQ5640216","T975561","2","3.97","0.000001",4.7,"2137",0,0,"3.97"],["AMQ5640217","T975603","1","2.00","0.000001",9.4,"2208",0,0,"2.00"],["AMQ5640223","T975213","1","0.49","0.000001",5.51,"2285",0,0,"0.49"],["AMQ5640225","T975225","1","0.77","0.000001",7.05,"3754",0,0,"0.77"],["AMQ5640227","T975303","1","0.88","0.000001",5.9,"2765",0,0,"0.88"],["AMQ5640228","T975315","1","1.54","0.000001",4.48,"2171",0,0,"1.54"],["AMQ5640232","T975609","1","1.00","0.000001",9.4,"2208",0,0,"1.00"],["AMQ5640236","T975651","1","1.00","0.000001",9.4,"2208",0,0,"1.00"],["AMQ5640241","T975339","1","2.12","0.000001",4.62,"2170",0,0,"2.12"],["AMQ5640242","T975549","1","0.84","0.000001",7.05,"3757",0,0,"0.84"]]';
