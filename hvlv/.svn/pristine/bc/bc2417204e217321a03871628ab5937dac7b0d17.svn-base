	public function fixdnataData()
	{
		Yii::app()->name = "TLA";
		$data = ['SYD3098587','SYD3098780','SYD3101944','SYD3102148'];//['SYD3094710','SYD3095110','SYD3095316','SYD3095542','SYD3095746','SYD3095962','SYD3096185','SYD3096261','SYD3096681',
		foreach ($data as $key => $d) {

			$transaction=Yii::app()->db->beginTransaction();
			try
			{
				
				$billing = Billing::model()->find(' status = 7 and billing_cref=:cref ',[":cref"=>$d]);
				foreach ($billing->lines as $key => $line) {
					$line->delete();
				}

				$billingChange = Billing::model()->find('billing_cref=:cref ',[":cref"=>$d."-RE"]);
				$su = SupplierInvoice::model()->with('rec')->find('inv_no = :invNo and (rec.status = 50 or rec.status = 60)',[":invNo"=>$d]);

				if(empty($billingChange))
				{
					$su->inv_no = $d."-RE";
					$su->save();
					$su->rec->toPay(true);
					$billingChange = Billing::model()->find('billing_cref=:cref ',[":cref"=>$d."-RE"]);
				}else
				{
					$su = SupplierInvoice::model()->with('rec')->find('inv_no = :invNo and (rec.status = 50 or rec.status = 60)',[":invNo"=>$d."-RE"]);
				}

				foreach ($billingChange->lines as $line) {
					$bb = new BillingLine();
					$bb->billing_id= $billing->id;
					$bb->org_id = $line->org_id;
					$bb->op_id = $line->op_id;
					$bb->link_id = $line->link_id;
					$bb->to_id = $line->to_id;
					$bb->created = $line->created;
					$bb->date = $line->date;
					$bb->due = $line->due;
					$bb->transaction_date = $line->transaction_date;
					$bb->type = $line->type;
					$bb->dpmt = $line->dpmt;
					$bb->gst = $line->gst;
					$bb->status = $line->status;
					$bb->billing_cref = $line->billing_cref;
					$bb->billing_ref = $line->billing_ref;
					$bb->awb = $line->awb;
					$bb->desc = $line->desc;
					$bb->qty = $line->qty;
					$bb->price = $line->price;
					$bb->dpt_id = $line->dpt_id;
					$bb->currency = $line->currency;
					$bb->no = $line->no;
					$bb->actual_amount = $line->actual_amount;
					$bb->accrual_amount = $line->accrual_amount;
					$bb->gst_amount = $line->gst_amount;
					$bb->charge_code = $line->charge_code;
					$bb->weight = $line->weight;
					$bb->charge_weight = $line->charge_weight;
					$bb->item_code = $line->item_code;
					$bb->sync_xero = $line->sync_xero;
					$bb->flag = $line->flag;
					$bb->meta = $line->meta;
					$bb->save();
				}
				foreach ($billingChange->lines as $line) {
					if ($line->accrual_amount > 0) {
						$line->actual_amount = 0;
						$line->billing_cref = '';
						$line->billing_id = 0;
						$line->status = 1;
						$line->update('actual_amount', 'billing_cref', 'billing_id', 'status');
					} else {
						$line->status = 11;
						$line->update('status');
					}
				}
				$billingChange->status = 11;
				$billingChange->update('status');

				$su->inv_no = $d;
				$su->save();

				$transaction->commit();
			} catch (Exception $ex) {
				$transaction->rollback();
				throw $ex;
			}

		}
		
	}

	public function getBorderWithoutRemote()
	{
		$zoneMap = ZoneMap::model()->findAll('org_id = 3447 and zone_id = 1');
		$finalData = [];
		$xlsave = new oExcel;
		$xlsave->addRow(1, ["zone","zone name","postcode",'suburb','state']);
		$start = 2;
		foreach ($zoneMap as $key => $value) {
			$myborderRemote = RemoteChargeRate::model()->findAll('rate_id = 769 and postcode=:postcode and suburb = :suburb',[":postcode"=>$value->pc_lo,":suburb"=>$value->suburb]);
			if(!empty($myborderRemote)) continue;
			$xlsave->addRow($start++, [$value->z1,$value->z1,$value->pc_lo,$value->suburb,$value->state]);
		}
		$xlsave->output('D:\handleData\my_border_without_remote.csv', null, false);
	}

	public function combineBorder()
	{
		$zoneMap = ZoneMap::model()->findAll('org_id = 3447 and zone_id = 1');
		$finalData = [];
		foreach ($zoneMap as $key => $value) {
			if(!empty($finalData[$value->z1]))
			{
				$finalData[$value->z1] .= ",".$value->pc_hi;
			}else
			{
				$finalData[$value->z1] = $value->pc_hi;
			}
		}
		$xlsave = new oExcel;
		$xlsave->addRow(1, ["zone","zone name","postcode"]);
		$start = 2;
		foreach ($finalData as $key => $value) {
			$getData = $this->combinePostcode($value);
			$xlsave->addRow($start++, [$key,$key,$getData]);
		}
		$xlsave->output('D:\handleData\hunter_combine.csv', null, false);
	}

