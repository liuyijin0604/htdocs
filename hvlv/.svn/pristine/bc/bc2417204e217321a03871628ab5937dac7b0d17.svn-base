		$transaction=Yii::app()->db->beginTransaction();
		try {
			foreach ($shipments as $key => $p) {
				$trans = null;
				if(!empty($p->trans))
				{
					foreach ($p->trans as $key => $tran) {
						if($tran->org_id==101)
						{

							$trans = $tran;
							break;
						}
					}
					
				}
				if(empty($trans))
				{
					$ts = new Tranship;
					$ts->pid = $p->id;
					$ts->org_id = 101;  // for Australia post office
					$ts->man_id = $p->man_id;
					$ts->type = 80;  // shipment transfer to a different delivery courier
					$ts->status = 19; // in finally moving status
					$ts->connote = $p->ref;
					$ts->time = date('Y-m-d H:i:s');
					$ts->mdata['oid'] = '101';
					$ts->cost = 0;
					$ts->save();
				}else
				{
					$trans->mdata['oid'] = '101';
					$trans->save();
				}
			}
			$transaction->commit();
		} catch (Exception $ex) {
			$transaction->rollback();
			throw $ex;
		}
	}

