	public function cleanPlAndManifest()
	{
		$sql = 'SELECT p.fid from pl_ledger p join consol c on p.grp1=c.id join mani_map ma on ma.fid = p.fid and ma.model="ImParcel" join manifest m on m.id = ma.mani_id and m.type=90 where p.gl = 101 and p.model="ImP_Manifest" AND p.dpmt = 10 AND m.created >= "2020-01-01 00:00:00" AND m.created <= "2020-06-30 23:00:00" AND c.no not like "3PL%" AND weight >0 and p.grp2 = 115 and p.fid not in (SELECT ma.fid from mani_map ma join manifest m on m.id = ma.mani_id and m.type=90 and m.fwd_id = 115 join tranship tr on tr.pid = ma.fid join shipment s on s.id=tr.pid where tr.org_id = 115 and m.created > "2020-01-01" group by ma.fid)group by p.fid ORDER BY `date` ASC';

		$datas = $this->db->createCommand($sql)->queryAll();

		$batchShipments=[];
		foreach ($datas as $key => $d) {
			if($key%20==0)
			{
				$batchShipments[]=[];
			}
			$batchShipments[count($batchShipments)-1][]=$d;
		}

		foreach ($batchShipments as $bk => $batch) 
		{

			$transaction=Yii::app()->db->beginTransaction();
			try 
			{
				foreach ($batch as $key => $bat) 
				{
					$mas = ManiMap::model()->findAll('fid = :fid',[":fid"=>$bat['fid']]);
					foreach ($mas as $key => $ma) 
					{
						$manifest = Manifest::model()->findByPk($ma->mani_id);
						if($manifest->type ==90 and $manifest->fwd_id==0)
						{
							ManiMap::model()->deleteAll('fid = :fid',[":fid"=>$bat['fid']]);
							PlLedger::model()->deleteAll('fid = :fid',[":fid"=>$bat['fid']]);
						}
					}
				}
			$transaction->commit();
			} catch (Exception $ex) {
				$transaction->rollback();
				throw $ex;
			}
			echo $bk;
		}
	}
