	public function recoveryCloseTime()
	{
		$logs = TlaLog::model()->findAll("meta = '{\"status\":\"Done\"}'");
		foreach ($logs as $key => $log) {
			$tlaTask = TlaTask::model()->findByPk($log->lid);
			if(empty($tlaTask)) continue;
			if($tlaTask->status == TlaTask::DONE)
			{
				$tlaTask->status = TlaTask::CLOSE;
				$tlaTask->save();
				foreach ($tlaTask->tlaTaskUsers as $key2 => $u) {
					if(empty($u->close_time)||$u->close_time=="0000-00-00 00:00:00")
					{
									echo "xxx";
						$u->status = TlaTask::CLOSE;
						$u->close_time = $log->time;
						$u->save();
					}
				}
			}
		}
	}

