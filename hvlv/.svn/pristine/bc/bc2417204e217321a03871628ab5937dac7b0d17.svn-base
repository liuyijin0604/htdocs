S CREEK STATION","0872 LAMBINA","0872 MACDONNELL RANGE","0872 MURPUTJA","0872 NAPPERBY STATION","0872 PIPALYATJARA","0872 TELEGRAPH STATION","0872 TIEYON","0872 UMUWA","0872 WANNAN","0872 WATARRU","0872 YUNYARINYI","0873 AMOONGUNA","0873 ARUMBERA","0873 CONNELLAN","0873 ILPARPA","0873 ROSS","0874 IRLPME","0874 MOUNT JOHNS","0874 UNDOOLYA","0874 IRLPME","0874 MOUNT JOHNS","0874 UNDOOLYA","0875 FLYNN","0875 LARAPINTA","0875 FLYNN","0875 LARAPINTA","0880 GAPUWIYAK","0880 GOVE","0880 GUNYANGARA","0880 NHULUNBUY","0880 YIRRKALA","0885 ALYANGULA","0885 GROOTE EYLANDT","0886 JABIRU"];
