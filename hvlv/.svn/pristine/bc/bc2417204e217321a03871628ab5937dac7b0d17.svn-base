	public function checkingModifyAddress()
	{
		$ref = $this->prompt('Ref: ');
		$chargecode = $this->prompt('chargecode: ');
		$p = ImParcel::model()->find('ref = :ref',[":ref"=>$ref]);
		$o = new StdClass();
		$consignee = $p->cnee;
		$country = 'AU';
		$result = ChooseShipment::modifyAddress($consignee,$o,$country,$chargecode);
		print_r($result);
		if($result->isModified==1)
		{
			$o->data = new stdClass();
			$o->data->oldAddress = $result->oldAddress;
			$o->data->newAddress = $result->newAddress;
			$p->mdata['newAddress'] = $result->newAddress;
			$p->mdata['oldAddress'] = $result->oldAddress;
			$p->mdata['editStreetCode'] = $result->editCode;
			$p->cbwf = $p->cbwf | 16;
			$p->cnee = $consignee;
			$p->cnee->save();
			$p->save();
		}else if($result->isModified==2)
		{
			$p->cbwf = $p->cbwf | 16;
			if(!empty($result->tempAddress))
			{
				$p->mdata['tempAddress'] = $result->tempAddress;
			}
			$p->mdata['oldAddress'] = $result->oldAddress;
			$p->mdata['editStreetCode'] = $result->editCode;
			$p->cnee = $consignee;
			$p->cnee->save();
			$p->save();
		}

		echo $p->cbwf;
	}

