	public function fixConsolBagScanningData()
	{
		$consolId = $this->prompt('consolId: ');
		Yii::import('application.modules.whscan.controllers.ShipmentController');
		$cc = new ShipmentController('default');
		$sql = 'SELECT pid,warehouse,user_id FROM `shipment_scan` where pid in (select id from import_bag where bag_tag in (select distinct(bag_tag) from import_bag_tag where shipment_id in (SELECT id FROM `shipment` WHERE consol_id = '.$consolId.' and scan_no !=0)) ) and type =5';
		$pids = $this->db->createCommand($sql)->queryAll();
		foreach ($pids as $key => $value) {

			$importBag = ImportBag::model()->findByPk($value["pid"]);
			$_GET['op']='checkin';
			$_POST['sound'] = "";
			$_POST['location'] = "";
			$_POST['search_container_no'] = "";
			$_POST['barcode'] = $importBag->bag_tag;
			$_POST['tempWarehouse'] = $value["warehouse"];
			$cc->actionScan();
		}
	}

