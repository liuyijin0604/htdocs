	public function fixFastwayTracking()
	{
		$agentId = $this->prompt('ShipmentId: ');
		$fss = ImParcel::model()->with('trans')->findAll("agent_id = :agentId and (ref like '2X%' or ref like 'QX%') and created>'2021-05-01' and t.status <=60 and json_value(trans.meta,'$.oid') is not null",[":agentId"=>$agentId]);
		$fw = new FastwayAPI(true);

		foreach($fss as $s){
				$result = $fw->addTracking($s->ref, 'PP2', time() - rand(1800, 3600));
				$result = $fw->addTracking($s->ref, 'PP5', time());
		}
	}

	public function plInvoice()
	{
		Yii::app()->name = 'TLA';
		$invoices = Invoice::model()->findAll('no like "DT%" and status !=10');
		$xlsave = new oExcel;
		$xlsave->addRow(1, ["no","delivery","deliveryGst","handling","handlingGst","total","totalGst","amount"]);
		$start = 2;
		$sum = 0;
		foreach ($invoices as $key => $invoice) 
		{
			$total = 0;
			$totalGst = 0;
			$delivery = 0;
			$deliveryGst = 0;
			$handling = 0;
			$handlingGst = 0;
			foreach ($invoice->lines as $key => $li) {
				foreach ($li->mdata['items'] as $key => $item) {
					$total += $item[5];
					$totalGst += $item[5]*0.1;
					if($item[0]=='3PLHF')
					{
						$handling = $item[5];
						$handlingGst = $item[5]*0.1;
					}else
					{
						$delivery += $item[5];
						$deliveryGst += $item[5]*0.1;
					}
				}
			}
			$xlsave->addRow($start, [$invoice->no,$delivery,$deliveryGst,$handling,$handlingGst,$total,$totalGst,$invoice->total]);
			$start++;
		}
		$xlsave->output('3plInvoice.csv', null, false);
	}

