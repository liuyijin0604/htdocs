	public function tntManifest()
	{
		$shipments = ImParcel::model()->findAll(" ref in ('TLS000001715') ");
		$err=[];
		$ss=['syd' => [], 'mel' => [], 'bne' => [],'syd_top'=>[],'mel_top'=>[],'per_top'=>[]];//manifest shipments;
		foreach ($shipments as $s) {
					// if(preg_match("/TLS\d{9}/i", $s->ref)){
					// 	$ss['syd_top'][] = $s;
					// }else
					if(preg_match("/LMA\d{9}/i", $s->ref)){
						$ss['mel_top'][] = $s;
					}else if(preg_match("/TLS\d{9}/i", $s->ref)){
						$ss['syd_top'][] = $s;
					}else if(preg_match("/LPC\d{9}/i", $s->ref)){
						$ss['per_top'][] = $s;
					}
		}

		foreach($ss as $o => $oss){
			if(empty($oss)) continue;
			$tnt= TntAPI::getTntInterface($o);
			if ($tnt->preEt12File($oss)) {
			} else {
				$err[] = "TNT manifest Failed";
			}
		}
	}

