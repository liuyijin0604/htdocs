	public function fixLogZw()
	{
		$importZwStorages = ImportZwStorage::model()->findAll('id >0');
		$transaction=Yii::app()->db->beginTransaction();
		try {
			foreach($importZwStorages as $s)
			{
				foreach ($s->log as $key => $log) 
				{
					$thisLog = new Log();
					$thisLog->time = $log->time;
					$thisLog->type = $log->type;
					$thisLog->model = $log->model;
					$thisLog->lid = $log->lid;
					$thisLog->meta = $log->meta;
					$thisLog->extra = $log->extra;
					$thisLog->user_id = $log->user_id;
					$thisLog->save();
				}
			}
			$transaction->commit();
		} catch (Exception $ex) {
			$transaction->rollback();
			throw $ex;
		}

	}

