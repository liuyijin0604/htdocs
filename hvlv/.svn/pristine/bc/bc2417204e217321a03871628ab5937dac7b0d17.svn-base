","33G7K824331101000935108","33G7K824331001000935101","33G7K824330801000935108","33G7K824330101000935109","33G7K824330001000935102","33G7K824329801000935102","33G7K824329701000935105","33G7K824329601000935108","33G7K824328901000935100","33G7K824328701000935106","33G7K824328601000935109","33G7K824328501000935102","33G7K824328401000935105","33G7K824328101000935104","33G7K824328001000935107","33G7K824327901000935101","33G7K824327701000935107","33G7K824327501000935103","33G7K824327301000935109","33G7K824327201000935102","33G7K824327001000935108","33G7K824326901000935102","33G7K824326801000935105","33G7K824326701000935108","33G7K824326501000935104","33G7K824326401000935107","33G7K824326301000935100","33G7K824326001000935109","33G7K824325701000935109","33G7K824325501000935105","33G7K824325401000935108","33G7K824325301000935101","33G7K824325201000935104","33G7K824325101000935107","33G7K824325001000935100","33G7K824324801000935107","33G7K824324601000935103","33G7K824324701000935100","33G7K824324501000935106","33G7K824324401000935109","33G7K824324301000935102","33G7K824324101000935108","33G7K824323601000935104","33G7K824323101000935109","33G7K824323001000935102","33G7K824322901000935106","33G7K824322701000935102","33G7K824304701000935106","33G7K824298801000935103") and status != 100');
		$transaction=Yii::app()->db->beginTransaction();
		try {
		foreach($shipments as $i=>$p){
//                    if(($p->bwf&4)<=0)                        continue;
			echo $p->ref."\n";
			$os = Edimsg::model()->findAll("status = 50 AND type = 'AIRCR-S' AND fid = :id AND sender =:sender", [':id' => $p->id,':sender'=>$senderSite]);
			$omid = null;
			if(!empty($os)){
				foreach($os as $o){
					if(preg_match('/MWB:'.$oawb.'/', $o->msg) && preg_match('/BGM\+933:::AIRCR\+([^\+:]+):\d+\+9\'/', $o->msg, $m)){
						$omid = $m[1];
						break;
					}
				}
			}
			if(empty($omid)){
				echo 'Original MSG not found for ', $p->hbn, "\n";
				continue;
			}
			$em = new Edimsg;
			$em->dt = date('Y-m-d H:i:s');
			$em->type = 'AIRCR-S';
			$em->sender = $senderSite;
			$em->receiver = Yii::app()->params['ics']['customs_id'];
			$em->status = 19;
			$em->fid = $p->id;
			$em->save();
			$em->mid = sprintf('%06s', substr($em->id, -6));
			$vn = Edimsg::model()->count('type = :t AND fid = :fid AND sender =:sender', [':t' => 'AIRCR-S', ':fid' => $p->id,':sender'=>$senderSite]) + 1;
			$msg = "UNH+".$em->mid."+CUSCAR:D:99B:UN'
BGM+933:::AIRCR+".$omid.":".$vn."+50'
RFF+HWB:".$p->hbn."'
RFF+MWB:".$oawb."'
TDT+20+".$flight."++6+".$airline."::3'
DTM+178:".date("Ymd", strtotime($cn->eta)).":102'
";
			$mc = substr_count($msg, "\n")+1;
			$msg .= "UNT+".$mc."+".$em->mid."'";
			$em->msg = $msg;
			$em->status = 20;
			$em->save();
		}
			$transaction->commit();
		} catch (Exception $ex) {
			$transaction->rollback();
			throw $ex;
		}
		echo "Done\n";
	}

