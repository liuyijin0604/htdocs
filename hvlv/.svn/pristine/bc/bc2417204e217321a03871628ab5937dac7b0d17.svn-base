	public function fixCargoProcessPickupDeliveryStatus()
	{
		$datas = ["PICKUP8073206","PICKUP8104664","PICKUP8496239"];
		foreach($datas as $key1 => $d)
		{
			$p = ImParcel::model()->find('ref=:ref',[':ref'=>$d]);
			$check = GatepassShipment::model()->find("fid = :fid and connote_no = :d and parent_id!=0",[":d"=>$d,":fid"=>$p->id]);
			if(empty($check))
			{
				echo $d."|empty";
				continue;
			}

			foreach ($p->tracks as $key3 => $t) {
				if($t->type ==60)
				{
					if(strtotime($t->dt)>strtotime($check->gate_pass_time))
					{
						$day = explode(" ", $t->dt)[0];
						$time = explode(" ", $check->gate_pass_time)[1];
						$day = HolidayHelper::getDateByBusinessDays(106,$day,1,1);
						$checks = GatepassShipment::model()->findAll("fid = :fid and connote_no = :d and parent_id!=0",[":d"=>$d,":fid"=>$p->id]);
						foreach ($checks as $key4 => $cccc) {
							$cccc->gate_pass_time = $day." ".$time;
							$cccc->save();
						}
						$gg= GatepassCourier::model()->findByPk($check->parent_id);
						$gg->create_time = $day." ".$time;
						$gg->save();
						$check->gate_pass_time = $day." ".$time;
					}
				}
			}
			$cas = CargoProcess::model()->findAll("shipment_id = :pid",[":pid"=>$p->id]);
			foreach ($cas as $key2 => $ca) {
				$ca->processDone();
				
				echo "cvvcvv";
				foreach ($p->tracks as $key3 => $t) {
					if($t->type==68 || $t->type==90)
					{
						echo $t->id;
						$t->dt = $check->gate_pass_time;
						$t->save();
					}
				}
				echo "1";
			}
		}
		
	}

