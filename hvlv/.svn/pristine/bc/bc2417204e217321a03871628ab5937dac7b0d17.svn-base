	public function calculateAllDeviation()
	{
		$id = $this->prompt('Start Id ');
		$count = Yii::app()->getDb()->createCommand(' select count(1) as amount from reconciliation where id <'.$id)->queryAll()[0]['amount'];
		$size = 1000;
		$pages = ceil($count/$size);
		$re = [];
		for ($page=1; $page <= $pages; $page++) { 
			$criteria = new CDbCriteria; 
			$criteria->addCondition(' id <'.$id);
			$criteria->limit = $page*$size;
			$criteria->offset = ($page-1)*$size; 
			$criteria->order= ' id desc ';
			$re = Reconciliation::model()->findAll($criteria);
			$transaction = Yii::app()->db->beginTransaction();
			try 
			{
				foreach ($re as $key => $value) 
				{
					$value->getWeightDeviation(true);
					echo $value->id."done";
				}
				$transaction->commit();
			} catch (Exception $ex) {
				$transaction->rollback();
				throw $ex;
			}
		}
	}

