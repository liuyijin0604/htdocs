	public function getMonthConsolData()
	{
		$months = ["2022-06","2022-07","2022-08"];
		$dptIds = [530];
		foreach ($months as $key => $month)
		{
			$provide = [];
			if(empty($months[$key+1])) break;

			foreach ($dptIds as $key2 => $dptId)
			{
				$orgName = Org::model()->findByPk($dptId)->name;
				$consols = Consol::model()->findAll(" awb like '%-%' and service = 10 and no not like '%3PL%' and  eta >= :dayFrom and eta < :dayTo and dpt_id=:dptId and status !=100 and t.no not like 'WDT%' ",[":dayFrom"=>$months[$key]."-01",":dayTo"=>$months[$key+1]."-01",":dptId"=>$dptId]);
				foreach ($consols as $ckey => $consol)
				{
					$chargeWeight = 0;
					// $shipments = $consol->mdata["cgb_wt"];
					// if(empty($shipments))
					// {
					// 	$shipments = ImParcelArchive::model()->findAll("consol_id = :consolId and status!=100",[":consolId"=>$consol->id]);
					// }
					// foreach ($shipments as $key4 => $model)
					// {
					// 	$chargeWeight += (isset($model->mdata['charge_client_weight'])?$model->mdata['charge_client_weight']:(isset($model->mdata['chargecode'])?$model->chargeWeight():$model->weight));
					// }
					echo $consol->no;
					$provide[] = [$consol->eta,$orgName,$consol->no,$consol->awb,(empty($consol->mdata["cgb_wt"])?0:$consol->mdata["cgb_wt"])];
				}

			}

			$xlsave = new oExcel;
			$xlsave->addRow(1, ["Month","Depot","Consol No","AWB","ChargeWeight"]);
			$start = 2;
			foreach ($provide as $key => $value) {
				$xlsave->addRow($start++, $value);
			}
			$xlsave->output( Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR.$month.'_consol_month_data.xlsx',null,false);
		}

	}

	public function calMonthConsolSummary()
	{
		//$data = ["2021-01","2021-02","2021-03","2021-04","2021-05","2021-06","2021-07","2021-08","2021-09","2021-10","2021-11","2021-12","2022-01","2022-02","2022-03","2022-04","2022-05","2022-06"];
		$data = ["2022-06","2022-07"];
		$dptIds = [106,218,530];
		$provide = [];
		foreach ($dptIds as $key => $dptId) {
			foreach ($data as $key => $d) {
				$xls = new oExcel;
				$xls->load('D:\handleData\\'.$d.'_consol_month_data.xlsx');
				$sheetDatas = $xls->getAll();
				unset($sheetDatas[1]);
				$chargeWeight = 0;
				foreach ($sheetDatas as $key => $sheetData)
				{
					if($sheetData[2]=="Sydney Warehouse"&&$dptId!=106)
					{
						continue;
					}else if($sheetData[2]=="Melbourne Warehouse"&&$dptId!=218)
					{
						continue;
					}else if($sheetData[2]=="Brisbane Warehouse"&&$dptId!=530)
					{
						continue;
					}
					$chargeWeight+=intval($sheetData[5]);
				}
				$provide[]=[$d,$dptId,$chargeWeight];
			}
		}
		$xlsave = new oExcel;
		$xlsave->addRow(1, ["Month","Depot","ChargeWeight"]);
		$start = 2;
		foreach ($provide as $key => $value) {
			$xlsave->addRow($start++, $value);
		}
		$xlsave->output( 'D:/handleData/summary_consol_month_data.xlsx',null,false);
	}

	public function getTntTollData()
	{
		$month1 = $this->prompt('month: ');
		$month2 = $this->prompt('month2: ');
		$shipments = Shipment::model()->with("consol")->findAll("consol.eta >= :month1 and consol.eta <:month2 and t.status !=100 and json_value(t.meta,'$.org_id') in (976,3466,3752,3079) and ref not like '33%'",[":month1"=>$month1,":month2"=>$month2]);
		$provide = [];
		foreach ($shipments as $key => $shipment)
		{
			$row = [$shipment->hbn,$shipment->weight,$shipment->cbm*$shipment->pkg,$shipment->cnee->address,$shipment->cnee->postcode,$shipment->cnee->suburb];
			foreach ($shipment->packs as $key => $value) {
				$row[] = $value["length"];
				$row[] = $value["weight"];
				$row[] = $value["height"];
			}

			$provide[] = $row;

		}

		$xlsave = new oExcel;
		$xlsave->addRow(1, ["HBN","Weight","Total CBM","Address","Postcode","Suburb","Length","Width","Height","Length","Width","Height","Length","Width","Height","Length","Width","Height","Length","Width","Height","Length","Width","Height","Length","Width","Height","Length","Width","Height"]);
		$start = 2;
		foreach ($provide as $key => $value) {
			$xlsave->addRow($start++, $value);
		}
		$xlsave->output( Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR.'tnt_toll_data.xlsx',null,false);
	}

	public function calBK()
	{
		$provide = [];
		$xls = new oExcel;
		$xls->load('D:\handleData\od.xlsx');
		$sheetDatas = $xls->getAll();

		foreach ($sheetDatas as $key => $sheetData)
		{
			preg_match('/\((.*)\)/', $sheetData[1],$m);
			$provide[]=[$m[1],$sheetData[4],$sheetData[3],$sheetData[2]];
		}
		$xlsave = new oExcel;
		$xlsave->addRow(1, ["ZONE","kg","base","minimum"]);
		$start = 2;
		foreach ($provide as $key => $value) {
			$xlsave->addRow($start++, $value);
		}
		$xlsave->output( 'D:/handleData/zone.xlsx',null,false);
	}

	public function recalculateRevenue()
	{ 
		$data = [];
		foreach ($data as $key => $d) {
			$p = ImParcel::model()->find('ref=:ref',[":ref"=>$d[0]]);
			$oRevenue = $p->getChargeByChargecode();
			$newRevenue = $p->getChargeByChargecode('',false,$d[1]);
			echo $p->ref,',',$oRevenue,',',$p->weight,',',$newRevenue,',',$d[1],PHP_EOL;
		}
		
	}

