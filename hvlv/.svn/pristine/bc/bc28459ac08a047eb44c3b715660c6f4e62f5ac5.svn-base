	public function actionExRatesGrid($id)
	{
		if (isset($_POST['SellRate'])) {

			$isUpdate = false;
			if (empty($_POST['SellRate']['id'])) { //create
				$model = new SellRate;
				$model->org_id = $id;
				$model->type = 20;
				$model->currency = 1;
			} else { //update
				$isUpdate = true;
				$model = SellRate::model()->findByPk($_POST['SellRate']['id']);
			}

			// add log to trace who change the rates
			$org = Org::model()->findByPk($id);
			$data = $_POST['SellRate'];

			if ($isUpdate) {
				$msg = 'code:' . $model->code . '->' . $data['code'] . ' perkg:' . $model->perkg . '->' . $data['perkg'] . ' item:' . $model->item . '->' . $data['item'] . ' from:' . $model->vfrom . '->' . $data['vfrom'] . ' to:' . $model->vto . '->' . $data['vto'];
				$notes = ['update rate' => $msg];
			} else {
				$msg = 'code:' . $data['code'] . ' perkg:' . $data['perkg'] . ' item:' . $data['item'] . ' from:' . $data['vfrom'] . ' to:' . $data['vto'];
				$notes = ['create new rate' => $msg];
			}
			Log::add($org, Log::LOG_TYPE_MISC, $notes);
			$model->attributes = $_POST['SellRate'];
			$model->by_id = Yii::app()->user->id;
			$model->save();
			$this->ajaxResult($model);
		}
	}

