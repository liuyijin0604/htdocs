<?php

class OrgController extends Controller
{
	protected $nonAjax = array('exportCostRate', 'export', 'updateQuote', 'createOrgInBatch','exportSurcharge');

	/**
	 * Displays a particular model.
	 * @param integer $id the ID of the model to be displayed
	 */
	public function actionView($id)
	{
		$this->render('view', array(
			'model' => $this->loadModel($id),
		));
	}

	/**
	 *  sync all orgs to xero
	 */
	public function actionSyncxero()
	{

		// don't link wihth xero now
		return;

		Org::sync2Xero();
		$model = new Org;
		$this->ajaxResult($model, array('id', 'code'));
	}

	/**
	 * Creates a new model.
	 * If creation is successful, the browser will be redirected to the 'view' page.
	 */
	public function actionCreate()
	{

		if (!Acl::hasAccess('B:Org/Create')) {
			die('invalid access');
		}

		$model = new Org;
		// Uncomment the following line if AJAX validation is needed
		// $this->performAjaxValidation($model);

		if (isset($_POST['Org'])) {
			$model->attributes = $_POST['Org'];
			$model->extra = empty($_POST['extra']) ? array() : $_POST['extra'];
			if (Yii::app()->name == 'PEP' && !in_array($model->type, [60, 65])) {
				CHttpException(403, 'Access Denied!');
			}

			$model->save();
			$this->ajaxResult($model, array('id', 'code'));
		} else {
			// set default value for Client or Agent organization
			$model->extra['wthreshold'] = 5;
			$model->extra['credit_init_date'] = date('Y-m-d');
			$model->extra['creditlimit'] = 1;
			$model->extra['creditterms'] = 1; // credit

		}

		$model->status = 1;
		$model->country = 'Australia';
		$this->render('create', array(
			'model' => $model,
			'own' => false,
		));
	}
	/*
	 * create org in a batch
	 */
	public function actionCreateOrgInBatch()
	{
		if (!Acl::hasAccess('B:Org/Create')) {
			die('invalid access');
		}
		if (!empty($_POST)) {
			$file = $_FILES['org_detail_file'];
			if (empty($file['tmp_name'])) {
				echo "<div style='color:red;'>No File Uploaded</div>";
				return;
			}
			$xls = new oExcel();
			$xls->supported(($file['name']));
			$xls->load($file['tmp_name']);
			$data = $xls->getAll();
			unset($data[1]);
			$os = [];
			$hasErrors = false;
			foreach ($data as $d) {
				if (empty($d[5])) {
					continue;
				}

				$os[] = $resp = $this->checkDataForCreateOrg($d);
				if (!$resp->status) {
					$hasErrors = true;
				}
			}
			if ($hasErrors) {
				foreach ($os as $index => $o) {
					if (!$o->status) {
						echo "<div style='color:red;'>Line " . ($index + 2) . ': ' . $o->msg . "</div>";
					}
				}
				return;
			}
			$os = [];
			foreach ($data as $d) {
				foreach ($data as $d) {
					if (empty($d[5])) {
						continue;
					}

					$os[] = $this->createOrgFrom($d);
				}
			}
			foreach ($os as $index => $o) {
				echo "<div style='color:" . ($o->status ? 'green' : 'red') . "'>Line " . ($index + 2) . ": " . $o->msg . '</div>';
			}
			return;
		}
		$this->render('create_org_in_batch');
	}

	private function checkDataForCreateOrg($d)
	{
		$o = new stdClass();
		$o->status = 1;
		$o->msg = '';
		if (Org::model()->find('name Like :name', array(':name' => '%' . $d[5] . '%'))) {
			$o->status = 0;
			$o->msg = '[10000]-The Org Name already Exist!';
			return $o;
		}
		if (empty($d[12])) {
			$o->status = 0;
			$o->msg = '[10001]-Country Information required!';
			return $o;
		}
		if (empty($d[13]) || empty($d[15])) {
			$o->status = 0;
			$o->msg = '[10002]-Phone And Email Information required!';
			return $o;
		}
		if (empty($d[16]) || empty($d[17])) {
			$o->status = 0;
			$o->msg = '[10003]-Outturn Email And Client Billing Email Information required!';
			return $o;
		}
		if (!empty($d[3]) && !Org::model()->findByPk(intval($d[3]))) {
			$o->status = 0;
			$o->msg = '[10004]-The Belong To Org Not found in the System';
			return $o;
		}
		if (!empty($d[4]) && !User::model()->find('email=:email', array(':email' => trim($d[4])))) {
			$o->status = 0;
			$o->msg = '[10005]-The Account Manager Not found in the System';
			return $o;
		}
		return $o;
	}

	public function createOrgFrom($d)
	{
		$o = new stdClass();
		$o->status = 1;
		$o->msg = '';
		$model = new Org;
		$model->name = trim($d[5]);
		$model->abn = trim($d[6]);
		$model->accode = trim($d[7]);
		$model->address = trim($d[8]);
		$model->suburb = trim($d[9]);
		$model->state = trim($d[10]);
		$model->postcode = trim($d[11]);
		$model->country = trim($d[12]);
		$model->phone = trim($d[13]);
		$model->email = trim($d[15]);
		$model->fax = trim($d[14]);
		$model->status = 1;
		$model->code = trim($d[2]);
		$model->type = in_array(intval($d[1]), Org::$types) ? intval($d[1]) : 30;
		if (!empty($d[3])) {
			$model->by = $d[3];
		}

		if (!empty($d[4])) {
			$model->manager = $model->extra['op_id'] = User::model()->find('email=:email', array(':email' => trim($d[4])))->id;
		}
		$model->extra['wthreshold'] = 5;
		$model->extra['credit_init_date'] = date('Y-m-d');
		$model->extra['creditlimit'] = 1;
		$model->extra['creditterms'] = 1; // credit
		$model->extra['outturn_email'] = trim($d[16]);
		$model->extra['client_billing_email'] = trim($d[17]);
		$model->extra['op_email'] = trim($d[18]);
		$model->extra['delivery_label_name'] = trim($d[19]);
		$model->extra['printer_id'] = trim($d[20]);
		if ($model->save()) {
			$o->msg = 'Org: ' . $model->name . '  Org Id :' . $model->id;
		} else {
			$o->status = 0;
			$o->msg = implode(' ', $model->getErrors());
		}
		return $o;
	}
	/**
	 * export searched orgs
	 */
	public function actionExport()
	{
		$xls = new oExcel;
		$i = 1;
		$xls->addRow($i++, array('ID', 'Type', 'Code', 'Name', 'Phone', 'Email', 'Status'));
		switch ($_GET['type']) {
			case 'search':
				$model = new Org('search');
				$model->unsetAttributes();
				if (!empty($_GET['Org'])) {
					$model->attributes = $_GET['Org'];
				}

				$dp = $model->search(false, 0);
				foreach ($dp->data as $r) {
					$xls->addRow($i++, array($r->id, $r->getType(), $r->code, $r->name, $r->phone, $r->email, $r->getStatus()));
				}
				$xls->output('org_search_export_' . time() . '.xlsx');
				break;
		}

		Yii::app()->end();
	}
	/**
	 * Updates a particular model.
	 * If update is successful, the browser will be redirected to the 'view' page.
	 * @param integer $id the ID of the model to be updated
	 */
	public function actionUpdate($id)
	{
		$model = $this->loadModel($id);
		$own = $model->id == Yii::app()->user->org;
		if (Yii::app()->name == 'PEP' && !in_array($model->type, [60, 65])) {
			CHttpException(403, 'Access Denied!');
		}

		// Uncomment the following line if AJAX validation is needed
		// $this->performAjaxValidation($model);
		if (isset($_POST['Org'])) {
			if ($own) {
				unset($_POST['Org']['status']);
				unset($_POST['Org']['type']);
			}
			$model->attributes = $_POST['Org'];
			if (!empty($_POST['extra'])) {
				$cmsg = [];
				$clf = ['sp_id' => 'Sales Person', 'op_id' => 'Account Manager', 'credit_ext_date' => 'Extend Until','credit_action'=>'Credit Action','creditlimit' => 'Credit Limit', 'creditterms' => 'Credit Term'];
				foreach ($_POST['extra'] as $k => $v) {
					if (!Acl::hasAccess('B:Org/ManageCredit') && in_array($k, ['credit_action','creditlimit', 'creditterms', 'credit_payment_method', 'credit_init_date', 'credit_ext_date', 'consum_postpay', 'rural_surcharge', 'rebate_rate', 'rebate_start', 'apply_rebate', 'use_sr1', 'credit_lock', 'name_validation'])) {
						continue;
					}

					if (isset($clf[$k]) && (!isset($model->extra[$k]) || $model->extra[$k] != $v)) {
						if (in_array($k, ['sp_id', 'op_id'])) {
							$name = empty($v) ? '' : User::model()->findByPk($v)->getName();
							$cmsg[] = $clf[$k] . ':' . ($name == '' ? 'EMPTY' : $name);
						} else {
							$cmsg[] = $clf[$k] . ':' . ($v == '' ? 'EMPTY' : $v);
						}
					}

					$model->extra[$k] = $v;
				}

				// fill in payterm according to creditterms
				if (!empty($model->extra['creditterms']) && $model->extra['creditterms'] > 1 && empty($model->extra['payterm'])) {
					$model->extra['payterm'] = $model->extra['creditterms'];
				}

				if (!empty($cmsg)) {
					Log::add($model, 4, array('note' => implode(', ', $cmsg)));
				}

				foreach (['thermal', 'wrapper', 'tape', 'company_customer', 'carton_label', 'incl_gst', 'credit_payment_method', 'consum_postpay', '3pl_service_setup', 'rural_surcharge', 'apply_rebate', 'use_sr1', 'id_nophoto', 'wt_check', 'wt_own', 'pos_pu', 'credit_lock', 'tla', 'auspost', 'fastway', 'tnt', 'eiztoll', 'sf', 'allied','ubitoll','ubiaupost','credit_action','is_show_driver_cost', 'name_validation'] as $k) {
					if (empty($_POST['extra'][$k])) {
						$model->extra[$k] = 0;
					}

				}
			}

			$model->cargo_driver_type = empty($_POST['cargo_driver_type']) ? 0 : array_sum($_POST['cargo_driver_type']);

			$model->save();
			$systemSetting = SystemSetting::model()->findByAttributes(array('key' => 'word_replace_clients'));
			
			if (!empty($systemSetting)) {
				if(!empty($_POST['extra']['name_validation']) && !in_array($model->id, $systemSetting->mdata['org_ids'])) {
					array_push($systemSetting->mdata['org_ids'], $model->id);
				} else if (empty($_POST['extra']['name_validation']) && ($key = array_search($model->id, $systemSetting->mdata['org_ids'])) != false) {
					unset($systemSetting->mdata['org_ids'][$key]);
				} else {
				}
				$systemSetting->save();
			}
			$this->ajaxResult($model);
		}

		if (isset($_GET['tab'])) {
			Acl::hasAccess($this->CaName . '/' . $_GET['tab'], true);
			$this->render('tab_' . $_GET['tab'], array('model' => $model, 'own' => $own));
		} else {
			$this->render('update', array('model' => $model, 'own' => $own));
		}
	}

	/**
	 * update WMS rates
	 * @param $id
	 */
	public function actionUpdateQuote()
	{
		$quote = WmsOrgQuote::model()->findByPk($_GET['fid']);

		if (!empty($_POST)) {
			$quote->note = $_POST['note'];
			$quote->vfrom = $_POST['vfrom'];
			$quote->vto = $_POST['vto'];
			$quote->status = $_POST['WmsOrgQuote']['status'];
			$quote->mdata['whole_sale'] = $_POST['WmsOrgQuote']['mdata']['whole_sale'];

			if (strtotime($quote->vfrom) > strtotime($quote->vto)) {
				$quote->addError('id', 'valid to date must be on late of valid from date ');
				$this->ajaxResult($quote);
			}

			if (WmsOrgQuote::isValidDateSpan($quote->org_id, $quote->vfrom, $quote->vto, $quote->id)) {
				// save quote details
				$quotes = $quote->type == 1 ? WmsOrgQuote::$newChgcodes : WmsOrgQuote::$chgcodes;
				foreach ($quotes as $k => $v) {
					if ($k % 1000 == 0) {
						continue;
					}

					if (isset($_POST[$k])) {
						$quote->mdata[$k] = $_POST[$k];
					}
					if ($k == WmsOrgQuote::QUOTE_PALLET_STORAGE_WEEK || $k == WmsOrgQuote::QUOTE_CBM_STORAGE_WEEK) {
						if ($_POST['storage_type'] == 'pallet') {
							$org = Org::model()->findByPk($quote->org_id);
							$org->extra['storage_charge_type'] = WmsOrgQuote::QUOTE_PALLET_STORAGE_WEEK;
							$org->sync_xero = false;
							$org->updateMeta();
							$quote->mdata[WmsOrgQuote::QUOTE_PALLET_STORAGE_WEEK] = $_POST['storage'];
							$quote->mdata[WmsOrgQuote::QUOTE_CBM_STORAGE_WEEK] = '';
						} else {
							$org = Org::model()->findByPk($quote->org_id);
							$org->extra['storage_charge_type'] = WmsOrgQuote::QUOTE_CBM_STORAGE_WEEK;
							$org->sync_xero = false;
							$org->updateMeta();
							$quote->mdata[WmsOrgQuote::QUOTE_CBM_STORAGE_WEEK] = $_POST['storage'];
							$quote->mdata[WmsOrgQuote::QUOTE_PALLET_STORAGE_WEEK] = '';
						}
					}
					if (isset($_POST['extra_packing'])) {
						$quote->mdata['extra_packing'] = $_POST['extra_packing'];
					}
				}

				$quote->save();
			} else {
				$quote->addError('id', 'The same date span existing');
			}

			$this->ajaxResult($quote);
		}

		$this->render('update_wms_quote', array('model' => $quote));
	}

	/**
	 * Creates a new model.
	 * If creation is successful, the browser will be redirected to the 'view' page.
	 */
	public function actionCreateQuote($id)
	{

		$model = $this->loadModel($id);
		$type = 0;
		if (isset($_GET['type']) && $_GET['type'] == 1) {
			$type = 1; //new wms quotes
		}

		if (!empty($_POST)) {
			$wmsQuote = new WmsOrgQuote();
			$wmsQuote->note = $_POST['note'];
			$wmsQuote->vfrom = $_POST['vfrom'];
			$wmsQuote->vto = $_POST['vto'];
			$wmsQuote->org_id = $_POST['orgid'];
			$wmsQuote->status = $_POST['WmsOrgQuote']['status'];
			$_POST['type'] == 1 ? $wmsQuote->type = 1 : $wmsQuote->type = 0;

			if (strtotime($wmsQuote->vfrom) > strtotime($wmsQuote->vto)) {
				$wmsQuote->addError('id', 'valid to date must be on late of valid from date ');
				$this->ajaxResult($wmsQuote);
			}

			if (WmsOrgQuote::isValidDateSpan($wmsQuote->org_id, $wmsQuote->vfrom, $wmsQuote->vto)) {
				// save quote details
				$quotes = $_POST['type'] == 1 ? WmsOrgQuote::$newChgcodes : WmsOrgQuote::$chgcodes;
				foreach ($quotes as $k => $quote) {
					if ($k % 1000 == 0) {
						continue;
					}

					if (isset($_POST[$k])) {
						$wmsQuote->mdata[$k] = $_POST[$k];
					}
				}

				$wmsQuote->save();
			} else {
				$wmsQuote->addError('id', 'The same date span existing');
			}

			$this->ajaxResult($wmsQuote);
		}

		// check to see if load data from specified template
		$quoteTemplate = array();
		if (isset($_GET['code'])) {
			$quoteTemplate = WmsOrgQuote::getOrgQuotesByCode($_GET['code']);
		}
		$this->render('create_quote', array(
			'model' => $model, 'quote' => $quoteTemplate, 'type' => $type,
		));
	}

	public function actionEditQuoteTemplate()
	{
		$model = $this->loadModel(114);
		$this->render('wms_rates_template', array('model' => $model));
	}

	/**
	 * create edit job template
	 * @param $id
	 */
	public function actionCreateEdiJobTemplate($id)
	{
		$model = EdiJobTemplate::model()->findByPk($id);
		if (empty($model)) {
			$model = new EdiJobTemplate();
		}

		$org = null;
		$oid = 0;
		if (isset($_GET['oid'])) {
			$oid = $_GET['oid'];
			$org = Org::model()->findByPk($oid);
		}
		if (isset($_POST['JobLine'])) {
			// save EDI job template
			$errors = $this->saveEdiJobTemplate($id, $oid);
			if (!$errors && !empty($errors)) {
				$model->addErrors($errors);
			}

			$this->ajaxResult($model);
		}

		$this->render('edi_job_template', ['model' => $model]);
	}
	/**
	 * save EDI job template
	 */
	private function saveEdiJobTemplate($id, $oid)
	{

		$valid_from = date('Y-m-d'); // $_POST['EdiJobTemplate']['valid_from'];
		$valid_to = '2020-12-31'; //$_POST['EdiJobTemplate']['valid_to'];

		$invoiceLines = array();
		if (is_array($_POST['JobLine']['ccode'])) {
			foreach ($_POST['JobLine']['ccode'] as $i => $a) {
				$line = array(
					'ccode' => $a,
					'desc' => $_POST['JobLine']['desc'][$i],
					'qty' => empty($_POST['JobLine']['qty'][$i]) ? 1 : $_POST['JobLine']['qty'][$i],
					'rate' => empty($_POST['JobLine']['rate'][$i]) ? 0 : $_POST['JobLine']['rate'][$i],
					'inv_gst' => empty($_POST['JobLine']['inv_gst'][$i]) ? 0 : $_POST['JobLine']['inv_gst'][$i],
				);
				$invoiceLines[] = $line;
			}
		}
		$costLines = array();
		if (is_array($_POST['BillingLine']['item_code'])) {
			foreach ($_POST['BillingLine']['item_code'] as $i => $a) {
				$line = array(
					'item_code' => $a,
					'desc' => $_POST['BillingLine']['desc'][$i],
					'org_id' => empty($_POST['BillingLine']['org_id'][$i]) ? 0 : $_POST['BillingLine']['org_id'][$i],
					'qty' => empty($_POST['BillingLine']['qty'][$i]) ? 1 : $_POST['BillingLine']['qty'][$i],
					'price' => empty($_POST['BillingLine']['price'][$i]) ? 0 : $_POST['BillingLine']['price'][$i],
					'gst' => empty($_POST['BillingLine']['gst'][$i]) ? 0 : $_POST['BillingLine']['gst'][$i],
				);
				$costLines[] = $line;
			}
		}
		$jobTemplate = null;
		if ($id > 0) {
			$jobTemplate = EdiJobTemplate::model()->findByPk($id);
		}
		$existingInvoiceLines = array();
		$existingCostLines = array();
		if (empty($jobTemplate)) {
			$jobTemplate = new EdiJobTemplate();
			$jobTemplate->user_id = Yii::app()->user->id;
			$jobTemplate->owner_id = $oid;
			$jobTemplate->created = date('Y-m-d H:i:s');
			$jobTemplate->status = 1;
		} else {
			$metaData = json_decode($jobTemplate->meta);
			$existingInvoiceLines = $metaData->invoice;
			// delete some one if existing
			$dels = $_POST['invoice_dels'];
			if (!empty($dels)) {
				$dels = explode('-', $dels);
				foreach ($dels as $del) {
					unset($existingInvoiceLines[$del - 1]);
				}
			}
			$existingCostLines = $metaData->cost;
			// delete some one if existing
			$dels = $_POST['cost_dels'];
			if (!empty($dels)) {
				$dels = explode('-', $dels);
				foreach ($dels as $del) {
					unset($existingCostLines[$del - 1]);
				}
			}
		}

		$jobTemplate->valid_from = $valid_from;
		$jobTemplate->valid_to = $valid_to;
		$jobTemplate->name = $_POST['EdiJobTemplate']['name'];

		if (!empty($existingCostLines)) {
			$costLines = array_merge($costLines, $existingCostLines);
		}
		if (!empty($existingInvoiceLines)) {
			$invoiceLines = array_merge($invoiceLines, $existingInvoiceLines);
		}
		$jobTemplate->meta = json_encode(array('invoice' => $invoiceLines, 'cost' => $costLines));
		$jobTemplate->save();

		$errors = $jobTemplate->getErrors();
		if (empty($errors)) {
			return true;
		} else {
			return $errors;
		}
	}

	/**
	 * @param $id
	 */
	public function actionEdiInvoiceLinesGrid($id)
	{

		if (isset($_POST['JobLine'])) {
			$id = $_POST['JobLine']['id'];
			$orgId = floor($id / 100);
			$lineId = $id % 100 - 1;

			$ediTemplate = EdiJobTemplate::model()->find('id = :oid', [':oid' => $orgId]);
			$newLine = array(
				'ccode' => $_POST['JobLine']['ccode'],
				'desc' => $_POST['JobLine']['desc'],
				'qty' => empty($_POST['JobLine']['qty']) ? 1 : $_POST['JobLine']['qty'],
				'rate' => empty($_POST['JobLine']['rate']) ? 0 : $_POST['JobLine']['rate'],
				'inv_gst' => empty($_POST['JobLine']['inv_gst']) ? 0 : $_POST['JobLine']['inv_gst'],
			);

			$metaData = json_decode($ediTemplate->meta);
			$lines = $metaData->invoice;
			foreach ($lines as $k => $line) {
				if ($k == $lineId) {
					$lines[$k] = $newLine;
					break;
				}
			}
			$newMetaData['invoice'] = $lines;
			$newMetaData['cost'] = $metaData->cost;
			$ediTemplate->meta = json_encode($newMetaData);
			$ediTemplate->save();

			$this->ajaxResult($ediTemplate);
		}
	}

	/**
	 * @param $id
	 */
	public function actionEdiCostLinesGrid($id)
	{

		if (isset($_POST['BillingLine'])) {
			$id = $_POST['BillingLine']['id'];
			$orgId = floor($id / 100);
			$lineId = $id % 100 - 1;

			$ediTemplate = EdiJobTemplate::model()->find('id = :oid', [':oid' => $orgId]);
			$newLine = array(
				'item_code' => $_POST['BillingLine']['item_code'],
				'desc' => $_POST['BillingLine']['desc'],
				'qty' => empty($_POST['BillingLine']['qty']) ? 1 : $_POST['BillingLine']['qty'],
				'price' => empty($_POST['BillingLine']['price']) ? 0 : $_POST['BillingLine']['price'],
				'gst' => empty($_POST['BillingLine']['gst']) ? 0 : $_POST['BillingLine']['gst'],
				'org_id' => $_POST['BillingLine']['org_id'],
			);

			$metaData = json_decode($ediTemplate->meta);
			$lines = $metaData->cost;
			foreach ($lines as $k => $line) {
				if ($k == $lineId) {
					$lines[$k] = $newLine;
					break;
				}
			}
			$newMetaData['cost'] = $lines;
			$newMetaData['invoice'] = $metaData->invoice;
			$ediTemplate->meta = json_encode($newMetaData);
			$ediTemplate->save();

			$this->ajaxResult($ediTemplate);
		}
	}

	/**
	 * get basic template list
	 */
	public function actionAjaxGetEdiBasicTemplate()
	{
		$resp = array('data' => array(), 'success' => 0);
		$tid = $_POST['tid'];
		$template = EdiJobBasicTemplate::model()->find('id = :oid', [':oid' => $tid]);
		if (!empty($template) && !empty($template->meta)) {
			$resp['data'] = json_decode($template->meta);
			$resp['name'] = $template->name;
			$resp['success'] = 1;
		}
		echo json_encode($resp);
	}

	/**
	 * get template content
	 */
	public function actionAjaxGetEdiTemplate()
	{
		$resp = array('data' => array(), 'success' => 0);
		$tid = $_POST['tid'];
		$template = EdiJobTemplate::model()->find('id = :oid', [':oid' => $tid]);
		if (!empty($template) && !empty($template->meta)) {
			$resp['data'] = json_decode($template->meta);

			// add supplier name for org id
			foreach ($resp['data']->cost as $k => $cost) {
				$cost->supplier_name = '';
				$org = Org::model()->findByPk($cost->org_id);
				if (!empty($org)) {
					$cost->supplier_name = $org->name;
				}

				$resp['data']->cost[$k] = $cost;
			}

			$resp['name'] = $template->name;

			$resp['success'] = 1;
		}
		echo json_encode($resp);
	}

	/**
	 * get org related edi template title list only for operator selection
	 */
	public function actionAjaxGetEdiTemplateList()
	{
		$resp = array('data' => array(), 'success' => 0);
		$oid = $_POST['org'];
		$templates = EdiJobTemplate::model()->findAll('owner_id = :oid', [':oid' => $oid]);
		$tList = array();
		foreach ($templates as $t) {
			$tList[] = array('id' => $t->id, 'name' => $t->name);
		}
		$resp['data'] = $tList;
		$resp['success'] = 1;
		echo json_encode($resp);
	}

	/**
	 * save all pca price for specified charge code
	 */
	public function actionSavePcaZonePrice()
	{
		$chargeCodeId = $_POST['cid'];

		$data = $_POST['data'];
		$data = json_decode($data, true);

		if (!empty($data) && !empty($chargeCodeId)) {
			$trans = Yii::app()->db->beginTransaction();
			try {
				$chargeCode = ImportChargeCode::model()->findByPk($chargeCodeId);
				TlaLog::add($chargeCode, $chargeCode->isNewRecord? 3 : 4, array_merge(['status' => $chargeCode->getStatus()], ["log"=>"Save Chargcode Zone Price"]));
				$startDate = $_POST['start_date'];
				$criteria = $_POST['criteria'];

				// gero add for calculate from kg to CBM
				if (isset($_POST['calculate_cbm']) && $_POST['calculate_cbm'] == 1) {
					$chargeCode->mdata['calculate_cbm'] = true;
					$chargeCode->mdata['calculate_plt'] = false;
					$chargeCode->mdata['minimum_cbm'] = $_POST['minimum_cbm'];
				} else {
					$chargeCode->mdata['calculate_cbm'] = false;
				}

				if (isset($_POST['calculate_plt']) && $_POST['calculate_plt'] == 1) {
					$chargeCode->mdata['calculate_plt'] = true;
					$chargeCode->mdata['calculate_cbm'] = false;
				} else {
					$chargeCode->mdata['calculate_plt'] = false;
				}

				$chargeCode->mdata['criteria'] = $criteria;


				$chargeCode->save();
				$allZoneRateZoneRate = ZoneRate::model()->findAll('chargecode_id = :cid', array(':cid' => $chargeCodeId));
				$vc = ZoneRateBk::model()->find(["condition"=>'chargecode_id = :cid', "params"=>[':cid' => $chargeCodeId],"order"=>"version desc"]);
				if(!empty($vc))
				{
					$version = $vc->version+1;
				}else
				{
					$version = 1;
				}

				foreach($allZoneRateZoneRate as $rate)
				{
					$zoneRateBk = new ZoneRateBk();
					$zoneRateBk->rate_id = $rate->rate_id;
					$zoneRateBk->chargecode_id = $rate->chargecode_id;
					$zoneRateBk->weight_lo = $rate->weight_lo;
					$zoneRateBk->weight_hi = $rate->weight_hi;
					$zoneRateBk->zone = $rate->zone;
					$zoneRateBk->zone_name = $rate->zone_name;

					$zoneRateBk->item = $rate->item;
					$zoneRateBk->base = $rate->base;
					$zoneRateBk->perkg = $rate->perkg;
					$zoneRateBk->nkg = $rate->nkg;
					$zoneRateBk->minimum = $rate->minimum;
					$zoneRateBk->min_incl = $rate->min_incl;
					$zoneRateBk->gst = $rate->gst;
					$zoneRateBk->levy = $rate->levy;
					$zoneRateBk->start_date = $rate->start_date;
					$zoneRateBk->create_user = User::currentUserID();
					$zoneRateBk->version = $version;
					$zoneRateBk->save();
				}

				// step 1 - clear all old zone rate data
				ZoneRate::model()->deleteAll('chargecode_id = :cid', array(':cid' => $chargeCodeId));

				// step 2 - update all with new zone rate data
				foreach ($data as $wRates) {
					$lo = $wRates['lo'];
					$hi = $wRates['hi'];
					$nkg = $wRates['nkg'];
					if ($hi <= 0 || $nkg < 0) {
						continue;
					}
					// ignore invalid one
					foreach ($wRates['data'] as $rate) {
						$zoneRate = new ZoneRate();
						$zoneRate->rate_id = 0;
						$zoneRate->chargecode_id = $chargeCodeId;
						$zoneRate->weight_lo = $lo;
						$zoneRate->weight_hi = $hi;
						$zoneRate->zone = $rate['code'];
						$zoneRate->zone_name = $rate['name'];

						$zoneRate->item = $rate['ppc'];
						$zoneRate->base = $rate['base'];
						$zoneRate->perkg = $rate['pkg'];
						$zoneRate->nkg = $nkg;
						$zoneRate->minimum = $rate['minimum'];
						$zoneRate->min_incl = $rate['min_incl'];
						$zoneRate->gst = 1;
						$zoneRate->levy = 0;
						$zoneRate->start_date = $startDate;
						$zoneRate->save();
					}
				}
				$trans->commit();
			} catch (Exception $ex) {
				$trans->rollback();
				throw $ex;
			}
		}

		$resp = array('success' => 1);
		echo json_encode($resp);

	}

	/**
	 * save all pca price for specified charge code
	 */
	public function actionSaveOrgFlexibleRate()
	{
		$orgId = $_POST['oid'];
		$startDate = $_POST['start_date'];
		$criteria = $_POST['criteria'];

		$data = $_POST['data'];
		$data = json_decode($data, true);
		if (!empty($data) && !empty($orgId)) {
			$trans = Yii::app()->db->beginTransaction();
			try {
				$orgFlexibleRateBk= new OrgFlexibleRateBk();
				$vc = $orgFlexibleRateBk->find(["condition"=>'org_id = :orgId and fid=0 and model=""', "params"=>[':orgId' => $orgId],"order"=>"version desc"]);
				if(!empty($vc))
				{
					$version = $vc->version+1;
				}else
				{
					$version = 1;
				}

				$orgFlexibleRateBks = OrgFlexibleRateBk::model()->findAll('org_id = :orgId and fid=0 and model=""', array(':orgId' => $orgId));
				foreach ($orgFlexibleRateBks as $key => $value) {
					$value->criteria = $criteria;
					$value->save();
				}

				$orgFlexibleRate= new OrgFlexibleRate();
				$orgFlexibleRateBks = $orgFlexibleRate->findAll('org_id = :orgId and fid=0 and model=""', array(':orgId' => $orgId));
				foreach ($orgFlexibleRateBks as $key => $value) {
					$orgFlexibleRateBk = new OrgFlexibleRateBk();
					$orgFlexibleRateBk->item =    $value->item;
					$orgFlexibleRateBk->amount =  $value->amount;
					$orgFlexibleRateBk->unit =    $value->unit;
					$orgFlexibleRateBk->minimum = $value->minimum;
					$orgFlexibleRateBk->branch =  $value->branch;
					$orgFlexibleRateBk->cargo =   $value->cargo;
					$orgFlexibleRateBk->service = $value->service;
					$orgFlexibleRateBk->org_id =  $value->org_id;
					$orgFlexibleRateBk->user_id=  $value->user_id;
					$orgFlexibleRateBk->create =  $value->create;
					$orgFlexibleRateBk->rebate =  $value->rebate;
					$orgFlexibleRateBk->version = $version;
					$orgFlexibleRateBk->create_user = User::currentUserID();
					$orgFlexibleRateBk->start_date = $value->start_date;
					$orgFlexibleRateBk->criteria = $criteria;
					$orgFlexibleRateBk->save();
				}



				OrgFlexibleRate::model()->deleteAll('org_id = :orgId and fid=0 and model=""', array(':orgId' => $orgId));

				// step 2 - update all with new zone rate data
				foreach ($data as $wRates) {
					if(empty($wRates['item'])) continue;
					$item = $wRates['item'];
					$amount = $wRates['amount'];
					$unit = $wRates['unit'];
					$minimum = $wRates['minimum'];
					$branch = rtrim($wRates['branch'],",");
					$cargo = rtrim($wRates['cargo'],",");
					$service = rtrim($wRates['service'],",");
					$rebate = rtrim($wRates['rebate'],",");
					
					$orgFlexibleRate = new OrgFlexibleRate();
					$orgFlexibleRate->item = $item;
					$orgFlexibleRate->amount = $amount;
					$orgFlexibleRate->unit = $unit;
					$orgFlexibleRate->minimum = $minimum;
					$orgFlexibleRate->branch = $branch;
					$orgFlexibleRate->cargo = $cargo;
					$orgFlexibleRate->service = $service;
					$orgFlexibleRate->org_id = $orgId;
					$orgFlexibleRate->user_id=User::currentUserId();
					$orgFlexibleRate->create = date('Y-m-d H:i:s');
					$orgFlexibleRate->rebate = $rebate;
					$orgFlexibleRate->start_date = $startDate;
					$orgFlexibleRate->criteria = $criteria;
					$orgFlexibleRate->save();
				}
				$trans->commit();
			} catch (Exception $ex) {
				$trans->rollback();
				throw $ex;
			}
		}

		$resp = array('success' => 1);
		echo json_encode($resp);

	}

