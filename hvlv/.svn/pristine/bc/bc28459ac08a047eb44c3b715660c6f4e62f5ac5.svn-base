	/**
	 * save all org related price based on zone
	 */
	public function actionSaveZonePrice()
	{
		$data = json_decode($_POST['data'], true);
		if (!empty($data) && !empty($_POST['rid'])) {
			$trans = Yii::app()->db->beginTransaction();
			try {
				$or = OrgRate::model()->findByPk($_POST['rid']);
				$or->mdata['ddpt_id'] = $_POST['ddpt'];
				$or->mdata['cbm_pricing'] = $_POST['cbm'];
				$or->mdata['plt_pricing'] = 0;
				if(!empty($_POST['plt']))
				{
					$or->mdata['cbm_pricing'] = 0;
					$or->mdata['plt_pricing'] = $_POST['plt'];
				}
				$or->mdata['mlids'] = trim($_POST['mlids']);
				$or->mdata['fuel'] = trim($_POST['fuel']);
				$or->mdata['can_dg'] = trim($_POST['can_dg']);
				$or->mdata['dimension_requiring'] = trim($_POST['dimension_requiring']);
				$or->mdata['business_type'] = $_POST['bsstype'];
				if($or->type==90)
				{
					$or->mdata['truck_delivery'] = $_POST['cbm_data']['truck_delivery'];
					$or->mdata['minimum_cbm'] = $_POST['minimum_cbm'];
				}
				$or->save();
				// step 1 - clear all old zone rate data
				ZoneRate::model()->deleteAll('rate_id = :rid', array(':rid' => $_POST['rid']));

				// step 2 - update all with new zone rate data
				foreach ($data as $wRates) {
					$lo = $wRates['lo'];
					$hi = $wRates['hi'];
					foreach ($wRates['data'] as $rate) {
						$zoneRate = new ZoneRate();
						$zoneRate->rate_id = $_POST['rid'];
						$zoneRate->weight_lo = $lo;
						$zoneRate->weight_hi = $hi;
						$zoneRate->zone = $rate['code'];
						$zoneRate->zone_name = $rate['name'];
						$zoneRate->item = $rate['ppc'];
						$zoneRate->base = $rate['base'];
						$zoneRate->perkg = $rate['pkg'];
						$zoneRate->nkg = $rate['nkg'];
						$zoneRate->minimum = $rate['minimum'];
						$zoneRate->min_incl = $rate['min_incl'];
						$zoneRate->gst = 1;
						$zoneRate->levy = 0;
						$zoneRate->save();
						// Yii::log($zoneRate->id.json_encode($zoneRate->getErrors()), 'error');
					}
				}
				$trans->commit();
			} catch (Exception $ex) {
				$trans->rollback();
				throw $ex;
			}
			Log::add($or->org, 4, ['note' => 'Updated flex rate ' . $or->name]);
			$this->ajaxResult($or);
		} else {
			echo json_encode(['success' => 0, 'msg' => 'No rates supplied']);
		}
	}

