	private function importChargecodeZoneMapData($chargecodeId, &$data)
	{
		$index = 0;

		foreach ($data as $row) {
			if ($index < 1) {
				$index++;
				continue;
			}
			if (empty($row[1])) {
				continue;
			}

			if (preg_match('/([0-9|\,|\-|\s]*)/', $row[3], $matches)) {
				if ($matches[1] != $row[3]) {
					echo json_encode(['done' => false, 'msg' => 'Contains character other than<br>numbers or - or , or space']);
					Yii::app()->end();
				}
			} else {
				echo json_encode(['done' => false, 'msg' => 'Contains character other than<br>numbers or - or , or space']);
				Yii::app()->end();
			}
		}

		// clear old data
		ZoneMap::model()->deleteAll('chargecode_id = :cid', [':cid' => $chargecodeId]);
		FileRepo::model()->deleteAll('type = 55 and fid = :cid', [':cid' => $chargecodeId]);

		$trans = Yii::app()->db->beginTransaction();
		try {
				foreach ($data as $row) {
					if ($index < 1) {
						$index++;
						continue;
					}
					if (empty($row[1])) {
						continue;
					}

					$code = $row[1];
					$name = $row[2];
					$postcodes = explode(',', $row[3]);
					foreach ($postcodes as $postcode) {

						// try to find -
						$postCodesSpan = explode('-', $postcode);
						if (count($postCodesSpan) == 2) {
							$start = intval($postCodesSpan[0]);
							$end = intval($postCodesSpan[1]);

						} else {
							// only one post code
							$start = $end = intval($postCodesSpan[0]);
						}

						// if existing , do nothing
						//$zoneMap = ZoneMap::model()->find('org_id = :oid and z1 = :code and pc_lo = :pclo and pc_hi = :pchi',[':oid' => $orgId,':code' => $code,':pclo' => $start,':pchi' => $end]);
						//if ( empty($zoneMap) )
						{
							$zoneMap = new ZoneMap();
							$zoneMap->setAttributes(array(
								'org_id' => 0,
								'zone_id' => 1,
								'chargecode_id' => $chargecodeId,
								'z1' => $code,
								'zone_name' => $name,
								'pc_lo' => $start,
								'pc_hi' => $end,
							));
							$zoneMap->save();
						}
					}
				}

			$trans->commit();
		} catch (Exception $ex) {
			$trans->rollback();
			throw $ex;
		}
	}


	/**
	 * @param $orgId
	 * @param $data
	 */
	private function importOrgRemoteCostRateData($orgRate, &$data)
	{
		$index = 0;
		// clear old data
		RemoteChargeRate::model()->deleteAll('rate_id = :rateId', [':rateId' => $orgRate->id]);

		$index = 1;
		unset($data[1]);
		$finalData = [];

		foreach ($data as $key => $row) {
			$postcode = $row[1];
			$suburb = $row[2];
			$type = $row[3];
			$value = $row[4];
			$myKey = $postcode.$suburb;
			$postcodeTo = $row[5];
			if(empty($finalData[$myKey]))
			{
				if($type =='perkg')
				{
					$finalData[$myKey] = [0,$postcode,$suburb,$value,0,0,$postcodeTo];
				}elseif($type=='base')
				{
					$finalData[$myKey] = [0,$postcode,$suburb,0,$value,0,$postcodeTo];
				}elseif($type=='levy')
				{
					$finalData[$myKey] = [0,$postcode,$suburb,0,0,$value,$postcodeTo];
				}
			}else
			{
				if($type =='perkg')
				{
					$finalData[$myKey][3] = $value;
				}elseif($type=='base')
				{
					$finalData[$myKey][4] = $value;
				}elseif($type=='levy')
				{
					$finalData[$myKey][5] = $value;
				}
			}
		}

		$trans = Yii::app()->db->beginTransaction();
		try {
				foreach ($finalData as $row)
				{
					if (empty($row[1])) {
						continue;
					}
					$postcode = $row[1];
					$suburb = $row[2];
					$perkg = $row[3];
					$base = $row[4];
					$levy = $row[5];
					$postcodeTo = $row[6];

					$remoteChargeRate = new RemoteChargeRate();
					$remoteChargeRate->rate_id = $orgRate->id;
					$remoteChargeRate->postcode = $postcode;
					$remoteChargeRate->suburb = $suburb;
					$remoteChargeRate->perkg = $perkg;
					$remoteChargeRate->base = $base;
					$remoteChargeRate->levy = $levy;
					$remoteChargeRate->postcode_to = $postcodeTo;
					$remoteChargeRate->save();
				}
				$trans->commit();
			} catch (Exception $ex) {
				$trans->rollback();
				throw $ex;
			}
	}

	/**
	 * @param $orgId
	 * @param $data
	 */
	private function importOrgRemoteChargeRateData($chargecode, &$data)
	{
		$errors = [];
		$index = 0;
		// clear old data
		RemoteChargeRate::model()->deleteAll('chargecode_id = :chargecodeId', [':chargecodeId' => $chargecode->id]);

		$index = 1;
		unset($data[1]);
		$combineData = [];
		foreach ($data as $key => $row) {
			if(empty($row[1])) continue;
			if(empty($combineData[0]))
			{
				$combineData[0] = [['',$row[1],$row[2],$row[3],$row[4]]];
			}else
			{
				$combineData[0][] = ['',$row[1],$row[2],$row[3],$row[4]];
			}
		}

		foreach ($combineData as $k => $data)
		{
			$orgRate = OrgRate::model()->find("name = :name",[":name"=>$k]);
			if(empty($orgRate))
			{
				$errors[] = $k." rate is not existed";
				continue;
			}

			$finalData = [];

			foreach ($data as $key => $row) {
				if(empty($row[1])) continue;
				$postcode = $row[1];
				$suburb = $row[2];
				$type = $row[3];
				$value = $row[4];
				$myKey = $postcode.$suburb;
				if(empty($finalData[$myKey]))
				{
					if($type =='perkg')
					{
						$finalData[$myKey] = [0,$postcode,$suburb,$value,0,0];
					}elseif($type=='base')
					{
						$finalData[$myKey] = [0,$postcode,$suburb,0,$value,0];
					}elseif($type=='levy')
					{
						$finalData[$myKey] = [0,$postcode,$suburb,0,0,$value];
					}
				}else
				{
					if($type =='perkg')
					{
						$finalData[$myKey][3] = $value;
					}elseif($type=='base')
					{
						$finalData[$myKey][4] = $value;
					}elseif($type=='levy')
					{
						$finalData[$myKey][5] = $value;
					}
				}
			}

			$trans = Yii::app()->db->beginTransaction();
			try {
					foreach ($finalData as $row)
					{
						if (empty($row[1])) {
							continue;
						}
						$postcode = $row[1];
						$suburb = $row[2];
						$perkg = $row[3];
						$base = $row[4];
						$levy = $row[5];

						$remoteChargeRate = new RemoteChargeRate();
						$remoteChargeRate->chargecode_rate_id = 0;
						$remoteChargeRate->chargecode_id = $chargecode->id;
						$remoteChargeRate->postcode = $postcode;
						$remoteChargeRate->suburb = $suburb;
						$remoteChargeRate->perkg = $perkg;
						$remoteChargeRate->base = $base;
						$remoteChargeRate->levy = $levy;
						$remoteChargeRate->save();
					}
					$trans->commit();
				} catch (Exception $ex) {
					$trans->rollback();
					throw $ex;
				}
		}
		return $errors;
	}



	/**
	 * @param $orgId
	 * @param $data
	 */
	private function importOrgZoneMapData($orgId, $zoneId, &$data)
	{
		$index = 0;

		// clear old data
		ZoneMap::model()->deleteAll('org_id = :oid AND zone_id = :zoneid', [':oid' => $orgId, ':zoneid' => $zoneId]);

		foreach ($data as $row) {
			if ($index < 1) {
				$index++;
				continue;
			}
			if (empty($row[1])) {
				continue;
			}

			$code = $row[1];
			$name = $row[2];
			$postcodes = explode(',', $row[3]);
			if(!empty($row[4])&&!empty($row[5]))
			{
				$zoneMap = new ZoneMap();
				$zoneMap->org_id = $orgId;
				$zoneMap->zone_id = intval($zoneId);
				$zoneMap->z1 = $code;
				$zoneMap->zone_name = $name;
				$zoneMap->pc_lo = $row[3];
				$zoneMap->pc_hi = $row[3];
				$zoneMap->suburb = $row[4];
				$zoneMap->state = $row[5];
				$zoneMap->save();
				continue;
			}

			foreach ($postcodes as $postcode) {

				// try to find -
				$postCodesSpan = explode('-', $postcode);
				if (count($postCodesSpan) == 2) {
					$start = intval($postCodesSpan[0]);
					$end = intval($postCodesSpan[1]);

				} else {
					// only one post code
					$start = $end = intval($postCodesSpan[0]);
				}

				// if existing , do nothing
				//$zoneMap = ZoneMap::model()->find('org_id = :oid and z1 = :code and pc_lo = :pclo and pc_hi = :pchi',[':oid' => $orgId,':code' => $code,':pclo' => $start,':pchi' => $end]);
				//if ( empty($zoneMap) )
				{
					$zoneMap = new ZoneMap();
					$zoneMap->setAttributes(array(
						'org_id' => $orgId,
						'zone_id' => intval($zoneId),
						'z1' => $code,
						'zone_name' => $name,
						'pc_lo' => $start,
						'pc_hi' => $end,
					));
					$zoneMap->save();
				}
			}
		}
	}

	public function actionApproval($id)
	{
		$model = $this->loadModel($id);
		if ($model && !empty($_POST['status'])) {
			if (!empty($_POST['reason'])) {
				$model->logExtra['reason'] = $_POST['reason'];
			}
			$model->status = $_POST['status'];
			$model->save();
			$this->ajaxResult($model);
		} else {
			throw new CHttpException(400, 'Invalid request. Please do not repeat this request again.');
		}
	}

	public function actionMy()
	{
		$this->actionUpdate(Yii::app()->user->org);
	}

	/**
	 * Lists and search.
	 */
	public function actionList()
	{
		$model = new Org('search');
		$model->unsetAttributes(); // clear any default values
		if (isset($_GET['Org'])) {
			$model->attributes = $_GET['Org'];
		}

		$this->render('list', array('model' => $model));
	}

	public function actionListDueOrg()
	{
		$filtersForm = new FiltersForm;
		if (isset($_GET['FiltersForm'])) {
			$filtersForm->filters = $_GET['FiltersForm'];
		}

		$provide = [];
		$sql = 'SELECT to_id FROM `invoice` WHERE status in (2,3,7) AND date>"2018-01-29" and dpmt in (10,30,40) and dpt_id=106 GROUP by to_id';
		$db = Yii::app()->db;
		$rs = $db->createCommand($sql)->queryAll();
		$oids = [];
		foreach ($rs as $r) {
			$org = Org::model()->findByPk($r['to_id']);
			$term_credit = $org->getCurrentCreditTerm();
			$credit_percent = $org->getCurrentCreditOfLimit();
			$credit_ammount = (isset($org->extra['creditlimit']) ? floatval($org->extra['creditlimit']) : 0);
			$credit_left = (1 - $credit_percent) * $credit_ammount;
			if (empty($term_credit[3])) {
				continue;
			}

			if ($term_credit[3] > 0) {
				continue;
			}
			$provide[] = array('key' => $r['to_id'], 'id' => $r['to_id'], 'name' => $org->name, 'invoice' => $term_credit[1], 'left_term' => $term_credit[0], 'invoice_date' => $term_credit[2], 'code' => $org->code, 'credit_left' => $credit_left, 'credit' => $credit_ammount, 'percent' => $credit_percent * 100);
		}
		$filteredData = $filtersForm->filter($provide);
		$dataprovider = new CArrayDataProvider($filteredData);
		$dataprovider->pagination = array('pageSize' => 30);
		$sort = new CSort();
		$sort->attributes = array(
			'name' => array(
				'asc' => 'name ASC',
				'desc' => 'name DESC',
			),
			'left_term' => array(
				'asc' => 'left_term ASC',
				'desc' => 'left_term DESC',
			),
			'invoice_date' => array(
				'asc' => 'invoice_date ASC',
				'desc' => 'invoice_date DESC',
			),
			'percent' => array(
				'asc' => 'percent ASC',
				'desc' => 'percent DESC',
			),
			'credit_left' => array(
				'asc' => 'credit_left ASC',
				'desc' => 'credit_left DESC',
			),
			'credit' => array(
				'asc' => 'credit ASC',
				'desc' => 'credit DESC',
			),
		);
		$sort->defaultOrder = "left_term ASC";
		$dataprovider->sort = $sort;
		$this->render('list_due_org', array('dataProvider' => [$dataprovider, $filtersForm]));
	}

