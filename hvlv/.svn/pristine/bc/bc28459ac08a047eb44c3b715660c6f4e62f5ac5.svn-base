	/**
	 *
	 */
	public function actionAjaxImportZoneCost()
	{
		$orgRate = OrgRate::model();
		$msg = 'Import Successfully';
		$template_file = empty($_FILES['zone_cost_rate_file']) ? array() : $_FILES['zone_cost_rate_file'];
		if (empty($template_file['tmp_name']) || !is_uploaded_file($template_file['tmp_name'])) {
			$orgRate->addError('error', 'Invalid template file');
			$this->ajaxResult($orgRate);
		} else {
			$xls = new oExcel;
			$xls->load($template_file['tmp_name']);
			$data = $xls->getAll();
			$startDate = @$_POST['start_date'];
			$criteria = @$_POST['criteria'];

			if(empty($_POST['chargecode_id']))
			{
				$orgRateId = $_POST['OrgRate']['id'];
				$orgRate = OrgRate::model()->findByPk($orgRateId);
				$name = $orgRate->name;
			}else
			{
				$orgRate = ImportChargeCode::model()->findByPk($_POST['chargecode_id']);
				TlaLog::add($orgRate, $orgRate->isNewRecord? 3 : 4, array_merge(['status' => $orgRate->getStatus()], ["log"=>"import Zone Cost"]));
				$orgRateId = $_POST['chargecode_id'];
				$name = $orgRate->chargecode;
			}
			$importOrgZoneMapName = $data[2][1];
			if (stripos($importOrgZoneMapName, $name) === false&&empty($_POST['chargecode_id'])) {
				$orgRate->addError('error', 'Import file does not match with current org zone');
			} else {
				// import org zone cost rate
				// remove first three title rows
				unset($data[1]);
				unset($data[2]);
				unset($data[3]);
				$this->importOrgZoneCostRateData($orgRateId, $data,@$_POST['chargecode_id'],$startDate,$criteria);
			}
		}

		// get all new data again
		$zoneRate = new ZoneRate();
		if(empty($_POST['chargecode_id']))
		{
			$newData = array(
				'wranges' => $zoneRate->getZoneRateWeightRangeByArray($orgRateId),
				'zcostrate' => ZoneMap::getOrgZoneMap($orgRate->org_id, $orgRate->zone_id),
			);
		}else
		{
			$newData = array(
				'wranges' => $zoneRate->getZoneRateWeightRangeByArray($orgRateId,$_POST['chargecode_id']),
				'zcostrate' => ZoneMap::getChargecodeZoneMap($orgRateId),
			);
		}

		$this->ajaxResult($orgRate, $newData, $msg);
	}

	/**
	 * import all org cost rate data
	 * @param $rateId
	 * @param $data
	 */
	public function importOrgZoneCostRateData($rateId, &$data,$isChargecode = false,$startDate = null,$criteria = null)
	{
		// step 1
		// calculate how many weight range we have
		$rows = count($data[4]);
		$rows = $rows - 2; // minus zone code and name
		$weightRangeNums = $rows / 5; // each weight range has five fields
		$weightRanges = array();
		for ($index = 1; $index <= $weightRangeNums; $index++) {
			$weightRangeTitle = $data[4][3 + ($index - 1) * 5];
			$weightRange = explode('-', $weightRangeTitle);
			$weight_lo = floatval(trim($weightRange[0]));
			$weight_hi = floatval(trim($weightRange[1]));
			$weightRanges[] = array(
				'wlo' => $weight_lo,
				'whi' => $weight_hi,
			);
		}

		// step 2
		// remove row 4(weight range) and 5(header)
		unset($data[4]);
		unset($data[5]);
		// step 3
		// import all new cost rate data
		// delete all old data
		if(empty($isChargecode))
		{
			ZoneRate::model()->deleteAll('rate_id = :rateid', [':rateid' => $rateId]);
		}else
		{
			$chargeCode=ImportChargeCode::model()->findByPk($rateId);
			$chargeCode->mdata['criteria'] = $criteria;
			$chargeCode->save();
			$allZoneRateZoneRate = ZoneRate::model()->findAll('chargecode_id = :cid', array(':cid' => $rateId));
			$vc = ZoneRateBk::model()->find(["condition"=>'chargecode_id = :cid', "params"=>[':cid' => $rateId],"order"=>"version desc"]);
			if(!empty($vc))
			{
				$version = $vc->version+1;
			}else
			{
				$version = 1;
			}

			foreach($allZoneRateZoneRate as $rate)
			{
				$zoneRateBk = new ZoneRateBk();
				$zoneRateBk->rate_id = $rate->rate_id;
				$zoneRateBk->chargecode_id = $rate->chargecode_id;
				$zoneRateBk->weight_lo = $rate->weight_lo;
				$zoneRateBk->weight_hi = $rate->weight_hi;
				$zoneRateBk->zone = $rate->zone;
				$zoneRateBk->zone_name = $rate->zone_name;

				$zoneRateBk->item = $rate->item;
				$zoneRateBk->base = $rate->base;
				$zoneRateBk->perkg = $rate->perkg;
				$zoneRateBk->nkg = $rate->nkg;
				$zoneRateBk->minimum = $rate->minimum;
				$zoneRateBk->min_incl = $rate->min_incl;
				$zoneRateBk->gst = $rate->gst;
				$zoneRateBk->levy = $rate->levy;
				$zoneRateBk->start_date = $rate->start_date;
				$zoneRateBk->create_user = User::currentUserID();
				$zoneRateBk->version = $version;
				$zoneRateBk->save();
			}
			ZoneRate::model()->deleteAll('chargecode_id = :chargecode_id', [':chargecode_id' => $rateId]);
		}

		foreach ($data as $row) {
		    $zoneCode = $row[1];
		    $zoneName = $row[2];
		    if(empty($zoneCode)) continue;
    
		    // get weight range 1 cost rate data
		    foreach ($weightRanges as $k => $ranges) {
			    	$ppc = $row[3 + intval($k) * 5];
			    	$pkg = $row[4 + intval($k) * 5];
			    	$base = $row[5 + intval($k) * 5];
			    	$minimum = $row[6 + intval($k) * 5];
			    	$nkg = $row[7 + intval($k) * 5];
    
			    	// try to update or insert new zone cost rate for org
			    	if(empty($isChargecode))
			    	{
			    		$zoneRate = ZoneRate::model()->find('rate_id  = :rid AND zone = :zone AND weight_lo = :wlo AND weight_hi = :whi',
			    		[':rid' => $rateId, ':zone' => $zoneCode, ':wlo' => $ranges['wlo'], ':whi' => $ranges['whi']]);
			    		$rateName = 'rate_id';
			    	}else
			    	{
			    		$zoneRate = ZoneRate::model()->find('chargecode_id  = :rid AND zone = :zone AND weight_lo = :wlo AND weight_hi = :whi',
			    		[':rid' => $rateId, ':zone' => $zoneCode, ':wlo' => $ranges['wlo'], ':whi' => $ranges['whi']]);
			    		$rateName = 'chargecode_id';
			    	}
			    	
			    	if (empty($zoneRate)) {
			    		// insert new one
			    		$zoneRate = new ZoneRate();
			    		$zoneRate->attributes = array(
			    			$rateName => $rateId,
			    			'zone' => $zoneCode,
			    			'zone_name' => $zoneName,
			    			'weight_lo' => $ranges['wlo'],
			    			'weight_hi' => $ranges['whi'],
			    			'base' => number_format($base, 3, '.', ''),
			    			'item' => number_format($ppc, 3, '.', ''),
			    			'perkg' => number_format($pkg, 3, '.', ''),
			    			'minimum' => number_format($minimum, 3, '.', ''),
			    			'nkg' => number_format($nkg, 2, '.', ''),
			    			'gst' => 1,
			    			'levy' => 0
			    		);
			    		$zoneRate->start_date = $startDate;
    
			    	} else {
			    		// just update
			    		$zoneRate->attributes = array(
			    			'zone_name' => $zoneName,
			    			'weight_lo' => $ranges['wlo'],
			    			'weight_hi' => $ranges['whi'],
			    			'base' => number_format($base, 3, '.', ''),
			    			'item' => number_format($ppc, 3, '.', ''),
			    			'perkg' => number_format($pkg, 3, '.', ''),
			    			'minimum' => number_format($minimum, 3, '.', ''),
			    			'nkg' => number_format($nkg, 2, '.', '')
			    		);
			    		$zoneRate->start_date = $startDate;
			    	}
    				
			    	$zoneRate->save();
    
			}
		}
	}

	/**
	 * save charge code
	 */
	public function actionAjaxSaveChargecodeZonemap()
	{
		$resp = array('success' => 1, 'msg' => 'import successfully');
		$template_file = empty($_FILES['org-zonemap']) ? array() : $_FILES['org-zonemap'];
		if (empty($template_file['tmp_name']) || !is_uploaded_file($template_file['tmp_name'])) {
			$resp['msg'] = 'Invalid template file';
			echo json_encode($resp);
			return;
		} else {
			$xls = new oExcel;
			$xls->load($template_file['tmp_name']);
			$data = $xls->getAll();
			if(isset($data[1]))
			{
				unset($data[1]);
			}
			$chargecodeId = $_POST['ImportChargeCode']['id'];
			$importChargecode = ImportChargeCode::model()->findByPk($chargecodeId);
			TlaLog::add($importChargecode, $importChargecode->isNewRecord? 3 : 4, array_merge(['status' => $importChargecode->getStatus()], ["log"=>"import Chargecode Zone Map"]));
			// import org zone map data
			$this->importChargecodeZoneMapData($chargecodeId, $data);

			//save file
			FileRepo::storeFile($template_file['tmp_name'], $template_file['name'], 55, $chargecodeId);

		}

		echo json_encode($resp);
	}

