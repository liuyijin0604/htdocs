	/**
	 * Returns the data model based on the primary key given in the GET variable.
	 * If the data model is not found, an HTTP exception will be raised.
	 * @param integer the ID of the model to be loaded
	 */
	public function loadModel($id)
	{
		$model = Org::model()->findByPk($id);
		if ($model === null) {
			throw new CHttpException(404, 'The requested page does not exist.');
		}

		return $model;
	}

	/**
	 * Performs the AJAX validation.
	 * @param CModel the model to be validated
	 */
	protected function performAjaxValidation($model)
	{
		if (isset($_POST['ajax']) && $_POST['ajax'] === 'org-form') {
			echo CActiveForm::validate($model);
			Yii::app()->end();
		}
	}

	/**
	 * save selected service
	 */
	public function actionAjaxSaveService()
	{

		$orgId = $_POST['oid'];
		$currency = $_POST['currency'];
		$selectedServices = $_POST['services'];
		$valid_from_date = $_POST['vfrom'];
		$valid_to_date = $_POST['vto'];
		if (empty($valid_to_date)) {
			$valid_to_date = '0000-00-00';
		}

		$org_rate_id = 0;
		if (isset($_POST['orid'])) {
			$org_rate_id = intval($_POST['orid']);
		}

		$model_org_rate = OrgRate::model()->findByPk($org_rate_id);
		if (empty($model_org_rate)) {
			$model_org_rate = new OrgRate();
			$model_org_rate->setAttributes(array(
				'org_id' => $orgId,
				'type' => 40, // PCAE rate
				'name' => 'PCAE Rate',
				'code' => 'pcae_rate',
			));
		}

		$model_org_rate->setAttributes(array(
			'vfrom' => $valid_from_date,
			'vto' => $valid_to_date,
			'currency' => $currency,
			'updated' => date('Y-m-d H:i:s'),
		));
		$model_org_rate->mdata = $selectedServices;

		$model_org_rate->save();

		echo json_encode(array('success' => 1));

	}

	/**
	 * update org price template data
	 */
	public function actionAjaxUpdatePriceTemplate()
	{

		// in case there is a validate price template B , you can't save this one
		$tpl = new SellRate();
		$tpl->org_id = $_POST['oid'];
		$tplb = $tpl->getValidPriceTpl(50);
		if (!empty($tplb)) {
			echo json_encode(array('success' => 0, 'err' => "There is a valid price template by weight only, you can't save this again"));
			return;
		}

		$type = $_POST['type'];
		$currency = $_POST['currency'];
		$orgId = $_POST['oid'];
		$weightPrice = $_POST['wp'];
		$piecePrice = $_POST['pp'];
		$vfrom = $_POST['vf'];
		$vto = $_POST['vt'];
		$tpl_id = $_POST['tid'];

		// for calculate by weight and piece
		// we use base field to save weight price
		// item field to save piece price
		$sellRate = SellRate::model()->findByPk($tpl_id);
		if (empty($sellRate)) {
			$sellRate = new SellRate();
		}
		$sellRate->setAttributes(array(
			'org_id' => $orgId,
			'code' => 'XX', // actually we don't need this for price template just padding
			'currency' => $currency,
			'type' => $type,
			'vfrom' => $vfrom,
			'vto' => $vto,
			'base' => $weightPrice,
			'item' => $piecePrice,
		));
		$sellRate->save();

		echo json_encode(array('success' => 1));

	}

	/**
	 * update org price template B data
	 */
	public function actionAjaxUpdatePriceTemplateB()
	{

		// in case there is a validate price template B , you can't save this one
		$tpl = new SellRate();
		$tpl->org_id = $_POST['oid'];
		$tpla = $tpl->getValidPriceTpl(40);
		if (!empty($tpla)) {
			echo json_encode(array('success' => 0, 'err' => "There is a valid price template by weight and piece, you can't save this again"));
			return;
		}

		$type = $_POST['type'];
		$currency = $_POST['currency'];
		$orgId = $_POST['oid'];
		$baseUnit = $_POST['bu'];
		$basePrice = $_POST['bp'];
		$fixedPrice = $_POST['fp'];
		$stepUnit = $_POST['su'];
		$priceRate = $_POST['sp'];
		$vfrom = $_POST['vf'];
		$vto = $_POST['vt'];
		$tpl_id = $_POST['tid'];

		// for calculate by weight only
		// we use min field to save base unit
		// item field to save step unit
		// base field to save base price
		// nkg field to save price rate
		$sellRate = SellRate::model()->findByPk($tpl_id);
		if (empty($sellRate)) {
			$sellRate = new SellRate();
		}
		$sellRate->setAttributes(array(
			'org_id' => $orgId,
			'code' => 'XX', // actually we don't need this for price template just padding
			'currency' => $currency,
			'type' => $type,
			'vfrom' => $vfrom,
			'vto' => $vto,
			'base' => $basePrice,
			'perkg' => $fixedPrice,
			'item' => $stepUnit,
			'min' => $baseUnit,
			'nkg' => $priceRate,
		));
		$sellRate->save();

		echo json_encode(array('success' => 1));

	}

