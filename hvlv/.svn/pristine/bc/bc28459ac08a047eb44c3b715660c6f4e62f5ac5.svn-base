	public function actionImportRate()
	{
		$model = Org::model()->findByPk($_POST['Org']['id']);
		if (!empty($_FILES['rate_excel'])) {
			$xls = new oExcel;
			$err = [];
			if (!$xls->supported($_FILES['rate_excel']['name'])) {
				foreach ($xls->getError() as $e) {
					$err[] = $e;
				}
			} else {
				$xls->load($_FILES['rate_excel']['tmp_name']);
				$data = $xls->getAll();
				if (implode('', $data[1]) != "TypeProductbarcodeskuCartonsQtyschedule timeexpirenotebatch") {
					$err[] = "template wrong";
				}

				unset($data[1]);

				$quote = new WmsOrgQuote();
				$quote->org_id = $model->id;
				$quote->type = 0;
				foreach ($data as $item) {
					$code = $item[1];
					$value = $item[4];
					if ($code == 'status') {
						$quote->status = $value;
					} else if ($code == 'vfrom' || $code == 'vto') {
						if (!is_numeric($value)) {
							echo json_encode(array('done' => false, 'msg' => 'Date ' . $value . ' is wrong'));
							Yii::app()->end();
						}
						$quote->$code = date('Y-m-d', ($value - 25569) * 24 * 60 * 60);
					} else {
						if ($code == 'storage') {
							$storage = $value;
							continue;
						} else if ($code == 'storage_type') {
							if ($value) {
								$model->extra['storage_charge_type'] = WmsOrgQuote::QUOTE_CBM_STORAGE_WEEK;
								$model->sync_xero = false;
								$model->save();
								$quote->mdata[WmsOrgQuote::QUOTE_PALLET_STORAGE_WEEK] = '';
								$quote->mdata[WmsOrgQuote::QUOTE_CBM_STORAGE_WEEK] = $storage;
							} else {
								$model->extra['storage_charge_type'] = WmsOrgQuote::QUOTE_PALLET_STORAGE_WEEK;
								$model->sync_xero = false;
								$model->save();
								$quote->mdata[WmsOrgQuote::QUOTE_PALLET_STORAGE_WEEK] = $storage;
								$quote->mdata[WmsOrgQuote::QUOTE_CBM_STORAGE_WEEK] = '';
							}
						} else if ($code == 'box' && $value) {
							$quote->mdata['extra_packing'][] = 'box';
						} else if ($code == 'wrapper' && $value) {
							$quote->mdata['extra_packing'][] = 'wrapper';
						} else if ($code) {
							$quote->mdata[$code] = $value;
						}
					}
				}
				if (WmsOrgQuote::isValidDateSpan($quote->org_id, $quote->vfrom, $quote->vto)) {
					$quote->save();
					echo json_encode(array('done' => true, 'msg' => 'Import successfully'));
					Yii::app()->end();
				} else {
					echo json_encode(array('done' => false, 'msg' => 'The same date span existing'));
					Yii::app()->end();
				}
			}
		} else {
			echo json_encode(array('done' => false, 'msg' => 'No file is submitted'));
			Yii::app()->end();
		}
	}

	public function actionGetDueDay()
	{
		if (!empty($_GET['org_id']) && !empty($org = Org::model()->findByPk($_GET['org_id']))) {
			if (!empty($term = $org->extra['payterm'])) {
				echo date('Y-m-d', strtotime('+' . $term . ' day', strtotime(date('Y-m-d'))));
				return;
			}
		}
		echo date('Y-m-d');
		return;
	}

	public function actionChangePassword($id)
	{
		$model = Org::model()->findByPk($id);
		if (!empty($_GET['confirm'])) {
			$model->extra['password'] = '';
			$model->sync_xero = false;
			$model->save();
			$this->ajaxResult($model);
		} else {
			$this->render('change_password', array('model' => $model));
		}
	}

	public function actionGetFuelSurcharge($id)
	{
		$model = Org::model()->findByPk($id);
		$this->render('fuel_surcharge', ['model' => $model]);
	}

	public function actionSetFuelSurcharge()
	{
		if (empty($_POST['FiltersForm']['month']) || empty($_POST['FiltersForm']['rate'])) {
			echo json_encode(['done' => false, 'msg' => 'Save failed, month or rate is empty']);
		} else if (!preg_match('/\d{4}-\d{2}/', $_POST['FiltersForm']['month'])) {
			echo json_encode(['done' => false, 'msg' => 'Save failed, month is invalid']);
		} else if ($_POST['FiltersForm']['rate'] <= 0 || $_POST['FiltersForm']['rate'] >= 100) {
			echo json_encode(['done' => false, 'msg' => 'Save failed, rate is invalid']);
		} else {
			SystemSetting::setAupostFuelChargeSetting($_POST['FiltersForm']);
			echo json_encode(['done' => true, 'msg' => 'Save successfully']);
		}
	}

	public function actionDeleteFuelSurcharge($month)
	{
		SystemSetting::deleteAupostFuelChargeSetting($month);
	}

	public function actionEditNote()
	{
		$id = empty($_GET['id'])?0:$_GET['id'];
		if(!empty($id))
		{
			$model = GeneralNote::model()->findByPk($id);
			$orgId= $model->fid;
		}else
		{
			$model = new GeneralNote();
			$orgId= $_GET['orgId'];
		}

		if(isset($_POST['GeneralNote'])){
			$model->model="Org";
			$model->attributes=$_POST['GeneralNote'];
			$model->fid = $orgId;
			$model->save();
			$this->ajaxResult($model);
		}
		$this->render('edit_note', ['model' => $model,'id'=>$id,'orgId'=>$orgId]);
	}

}
