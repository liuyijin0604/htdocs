		if (!empty(Yii::app()->session['scan_warehouse']) && Yii::app()->session['scan_warehouse']=='melbourne') {
			$tempWareHouse=218;
		}else if (!empty(Yii::app()->session['scan_warehouse']) && Yii::app()->session['scan_warehouse']=='brisbane') {
			$tempWareHouse=530;
		}
		return $tempWareHouse;
	}
	


