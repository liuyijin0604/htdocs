        ['name'=>'awb_name','header'=>'awb','type'=>'raw','value'=>'empty($data->consol)?"":$data->consol->awb',],
        ['name'=>'consol_eta','header'=>'eta','type'=>'raw','value'=>'@$data->consol->eta','htmlOptions'=>['width'=>'80px'],'cssClassExpression' => 'isset($data->consol)?(@$data->consol->getEtaToNow()>5? "cloumn_red" : ""):""'],
        ['name'=>'pkg','htmlOptions'=>['width'=>'10px'],'filterHtmlOptions'=>['style'=>'width:10px']],
        ['name' => 'consol_no', 'type'=>'raw', 'value' => 'empty($data->consol_id)? "" : "<a href=\"".Yii::app()->createURL(preg_match("/DW\d{8}/i",@$data->consol->no)?"dmawbConsol/update":"imcoConsol/update", array("id" => $data->consol_id))."\" class=\"tab_link\" title=\"".$data->consol->no."\">".$data->consol->no."</a>"',],
        ['name' => 'status', 'value' => '$data->getStatus()',
            'filter'=>CHtml::dropDownList('ImParcel[status]', $shipment_model->status, $this->t(ImParcel::$states), ['prompt'=>$this->t('All')]),],
        ['name' => 'ddpt_id', 'value' => '@$data->depot->name',
            'filter'=>CHtml::dropDownList('ImParcel[ddpt_id]', $shipment_model->ddpt_id, $this->t(Org::dptList()), ['prompt'=>$this->t('All')]),],
        ['name' => 'cnee_name', 'type' => 'raw', 'value'=>function ($data) {
            $cnee = empty(@$data->receiver->name)? $data->cnee : $data->receiver;

