<script>
function funcTimeReport(){
    var value=$("#selectTimeReport").val();

    if(value=='consol'){
        $('#loading-container').show();
        window.open("<?=$this->createUrl('reports/consol')?>","_self");
    }
    if(value=='shipment'){
        $('#loading-container').show();
        window.open("<?=$this->createUrl('shipment/timeReport')?>","_self");
    }
    
}

function funcAccountingReport(){
    var value=$("#selectAccountingReport").val();

    if(value=='invoice'){
        $('#loading-container').show();
        window.open("<?=$this->createUrl('accounts/index')?>","_self");
    }
    if(value=='dispute'){
        $('#loading-container').show();
        window.open("<?=$this->createUrl('accounts/dispute')?>","_self");
    }
    
}

// When user clicked a link, display a loading animation 
// and prevent any click event before next page is loaded.
$(document).ready(function() {
    $('.dash-item-link').click(function (event) {
        //debugger;
        $('#loading-container').show();
    });
});
</script>