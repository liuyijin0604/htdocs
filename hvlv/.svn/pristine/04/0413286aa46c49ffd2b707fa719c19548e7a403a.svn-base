	public function beforeAction($action){
		$this->layout="ims";
		if(!Yii::app()->user->isGuest){
			$this->org = Org::model()->findByPk(Yii::app()->user->org);
						$this->type = 'im';
		}
		return parent::beforeAction($action);
	}
		
	public  function actionIndex(){
		if(isset($_POST['ShipmentQuestionSubmit']))
		{
			$errors = [];
			$ref = @$_POST['ShipmentQuestionSubmit']['mhbns'];
			$shipment = ImParcel::model()->find('ref = :ref',[":ref"=>$ref]);
			$c_note = @$_POST['ShipmentQuestionSubmit']['c_note'];
			$email = @$_POST['ShipmentQuestionSubmit']['email'];
			$faq = @$_POST['faq'];
			$model=new ShipmentQuestionSubmit();
			if(empty($faq))
			{
				$errors[] = "Require select a question";
			}
			if(empty($c_note))
			{
				$errors[] = "Require notes";
			}
			if(empty($email))
			{
				$errors[] = "Require email";
			}else
			{
				$email = trim($email);
				$email2 = explode("<", $email);
				$email = $email2[0];
				$email = preg_replace('/;/', '', $email);
				if(!preg_match('/^(\w)+(\.\w+)*@(\w|-|_)+((\.\w+)+)$/', $email))
				{
					$errors[] = "Email is incorrect";
				}
			}
			if(!empty($errors))
			{
				$model->addErrors($errors);
				$this->ajaxResult($model);
			}

			$model=new ShipmentQuestionSubmit();
			if(isset($_POST['ShipmentQuestionSubmit']['c_note']))
			{
				$shipments= null;
				$model->attributes=$_POST['ShipmentQuestionSubmit'];
				$model->mhbns = @$_POST['ShipmentQuestionSubmit']["mhbns"];
				if (!empty($model->mhbns)) {
						$ns = preg_split('/[\s,;]+/', trim($model->mhbns));
						if (sizeof($ns) > 200) {
							$ns = array_slice($ns, 0, 200);
						}
						$sc1 = new CDbCriteria;
						$sc1->addInCondition("hbn", $ns);
						$sc1->addInCondition("ref", $ns, 'OR');
						$sc1->addInCondition("cref", $ns, 'OR');
						$shipments = ImParcel::model()->findAll($sc1);
						$sc1->compare("ShipmentQuestionSubmit.org_id", $this->org->id);
						$sqs = ShipmentQuestion::model()->with(["Shipment","ShipmentQuestionSubmit"])->findAll($sc1);
						// if(!empty($sqs))
						// {
						// 	$model->addError("Questions about ImParcels are submitted","Questions about ImParcels are submitted");
						// 	foreach ($sqs as $key => $value) {
						// 		$model->addError("Ticket:".$value->ShipmentQuestionSubmit->ticket." Ref:".$value->Shipment->ref,"Ticket:".$value->ShipmentQuestionSubmit->ticket." Ref:".$value->Shipment->ref);
						// 	}
						// 	$this->ajaxResult($model);
						// }
				}
				$model->org_id = $this->org->id;
				$model->date = date("Y-m-d H:i:s");
				$model->faq = CsFaq::model()->findByPk($_POST['faq'])->content;
				$model->email = $email;
				$model->type = ShipmentQuestionSubmit::USERGENERATE;
				$model->save();
				$model->refresh();
				if($shipments!=null)
				{
					foreach ($shipments as $key => $shipment) {


						$shipmentQuestion = new ShipmentQuestion();
						$shipmentQuestion->shipment_id= $shipment->id;
						// $shipmentQuestion->c_note= "none";
						// $shipmentQuestion->s_note= "none";
						$shipmentQuestion->submit_id= $model->id;
						$shipmentQuestion->faq = CsFaq::model()->findByPk($_POST['faq'])->content;
						$shipmentQuestion->mdata["items"] = "";//ShipmentQuestionSubmit::getItems($_POST['ShipmentQuestion']['mdata']['items'],$model,$shipment);
						// $shipmentQuestion->faq_answer = "none";
						$shipmentQuestion->save();
						ShipmentQuestionSubmit::saveFiles($_FILES,$shipmentQuestion,true);
					}
				}else
				{
					$shipmentQuestion = new ShipmentQuestion();
					$shipmentQuestion->shipment_id= 0;
					// $shipmentQuestion->c_note= "none";
					// $shipmentQuestion->s_note= "none";
					$shipmentQuestion->submit_id= $model->id;
					$shipmentQuestion->faq = CsFaq::model()->findByPk($_POST['faq'])->content;
					$shipmentQuestion->mdata["items"] = "";//ShipmentQuestionSubmit::getItems($_POST['ShipmentQuestion']['mdata']['items'],$model,$shipment);
					// $shipmentQuestion->faq_answer = "none";
					$shipmentQuestion->save();
					ShipmentQuestionSubmit::saveFiles($_FILES,$shipmentQuestion,true);
				}
				//ShipmentQuestionSubmit::sendNoticeSystemMessageToStaff($faq,count($shipments),$model->ticket);
				$customerServiceService = new CustomerServiceService();
				$customerServiceService->transferCustomerServiceCaseToBeEmail($model->ticket);

			    $this->ajaxResult($model);
			}
		}
		$shipmentQuestionSubmit=new ShipmentQuestionSubmit();

		$model=new ShipmentQuestion('search');
		$model->unsetAttributes();  // clear any default values
		$model->org_id = Yii::app()->user->org;
		
		if(isset($_GET['ShipmentQuestion']))
		{
			$model->setAttributes($_GET['ShipmentQuestion']);
			if(isset($_GET['ShipmentQuestion']['ref']))
			{
				$model->setRef($_GET['ShipmentQuestion']['ref']);
			}
				if(isset($_GET["ShipmentQuestion"]["date"]))
			{
				$model->setDate($_GET["ShipmentQuestion"]["date"]);
			}
		}
		if(isset($_GET['ref']))
		{
			$model->setRef($_GET['ref']);
		}
		if(isset($_GET['ref']))
		{
			$faqListArr = CsFaq::model()->findAll(" status = :status and type = 0",[":status"=>CsFaq::active]);
		}else
		{
			$faqListArr = CsFaq::model()->findAll(" status = :status and type = 1",[":status"=>CsFaq::active]);
		}

		$faqList= [];
		$faqList = [""=>"Please Select"];
		foreach ($faqListArr as $key => $value) {
			$faqList["".$value['id']] = $value['content'];
		}

		$result= array(
			'model'=>$model,'org'=>$this->org,'faqList'=>$faqList,'shipmentQuestionSubmit'=>$shipmentQuestionSubmit
		);

		if(isset($_GET['ref']))
		{
			$result['singleCheck']=true;
		}

		$this->renderPartial('index',$result);
	}

	public function actionCneeShipmentQuery()
	{
		if(empty($_POST['ShipmentQuestionSubmit']['mhbns']))//for checking the ticket or go to the submittion page
		{
			$this->layout="frontend";
			$shipment = ImParcel::model()->find(" ref = :ref and status != :status",[":ref"=>@$_GET['ref'],":status"=>ImParcel::STATE_CANCELLED]);
			$type = !empty($_GET['type'])?$_GET['type']:0;
			$model=new ShipmentQuestionSubmit('search');
			$model->mhbns = $shipment->ref;
			$model->unsetAttributes();  // clear any default values
			$faqListArr = CsFaq::model()->findAll(" status = :status and type = 0",[":status"=>CsFaq::active]);
			$trackingListArr = CsFaq::model()->findAll(" status = :status and type = 2",[":status"=>CsFaq::active]);
			$faqList= [];
			$trackingList = [];
			$faqList = [""=>"Please Select"];
			$trackingList = [""=>"Please Select"];
			if(empty($type))
			{
				foreach ($faqListArr as $key => $value) 
				{
					$faqList["".$value['id']] = $value['frontend_content'];
				}
				foreach ($trackingListArr as $key => $value)
				{
					$trackingList["".$value['id']] = $value['frontend_content'];
				}
				$result= array('model'=>$model,'org'=>null,'faqList'=>$faqList,'trackingList'=>$trackingList);
				$this->render('frontend_index',$result);// submittion page
			}else
			{
				$ticket = @$_GET['ticket'];
				$ref = @$_GET['ref'];
				$model = ShipmentQuestion::model()->with(["ShipmentQuestionSubmit","Shipment"])->find(" ShipmentQuestionSubmit.ticket = :ticket and Shipment.ref = :ref",[":ticket"=>$ticket,":ref"=>"$ref"]);
				$result= array('model'=>$model,'org'=>null);
				$this->render('frontend_check',$result);//checking page
			}
		}else// for submitting the question
		{
			$errors = [];
			$ref = @$_POST['ShipmentQuestionSubmit']['mhbns'];
			$email = @$_POST['ShipmentQuestionSubmit']['email'];
			$shipment = ImParcel::model()->find('ref = :ref',[":ref"=>$ref]);
			$c_note = @$_POST['ShipmentQuestionSubmit']['c_note'];
			$faq = @$_POST['ShipmentQuestionSubmit']['faq'];
			$trackingOption = @$_POST['ShipmentQuestionSubmit']['tracking'];
			$model=new ShipmentQuestionSubmit();
			if(empty($email))
			{
				$errors[] = "Require email address";
			}else
			{
				$email = trim($email);
				$email = preg_replace('/;/', '', $email);
			}


			if(empty($faq))
			{
				$errors[] = "Require faq";
			}
			// if(empty($faq))
			// {
			// 	$errors[] = "Require select a question";
			// }
			if(empty($c_note) && $_POST['ShipmentQuestionSubmit']['tracking'] != '30')
			{
				$errors[] = "Require notes";
			}
			if(!empty($errors))
			{
				$model->addErrors($errors);
				$this->ajaxResult($model);
			}

			if(!empty($shipment!=null))
			{
				/**
				 * Automatically send enquiry email to courier when customer selected 'Shipment Tracking' -> 'Track Shipment (Already with courier)'
				 */
				if ($trackingOption == '30') {
					$tranship = Tranship::model()->find(" connote = :connote ",[":connote"=>$ref]);
					$courier = Org::model()->findByPk($tranship->org_id);
					$emailService = new EmailService();
					$emailService->sendCustomerServiceTrackingEmail($shipment, $courier, $ref, $email);
					echo "<script type='text/javascript'>alert('A message has been submitted to the courier. You will receive a reminder when they reply.'); window.location.href = 'https://www.toplogistics.com.au/';</script>";
				}
				$faq = CsFaq::model()->findByPk($faq);
				$model->setAttributes($_POST['ShipmentQuestionSubmit']);
				if ($trackingOption == '30') {
					$model->c_note = CsFaq::model()->findByPk($trackingOption)->frontend_content;
				}
				$model->date = date("Y-m-d H:i:s");
				$model->faq = $faq->content;
				$model->type = ShipmentQuestionSubmit::FRONTENDGENERATE;
				$model->save();
				$model->refresh();

				$shipmentQuestion = new ShipmentQuestion();
				$shipmentQuestion->shipment_id= $shipment->id;
				// $shipmentQuestion->c_note= "none";
				// $shipmentQuestion->s_note= "none";
				$shipmentQuestion->submit_id= $model->id;
				$shipmentQuestion->faq = $faq->content;
				$shipmentQuestion->mdata['items'] = "";//$_POST['ShipmentQuestion']['mdata']['items'];
				// $shipmentQuestion->faq_answer = "none";
				$shipmentQuestion->save();

				ShipmentQuestionSubmit::saveFiles($_FILES,$shipmentQuestion,true);
				$customerServiceService = new CustomerServiceService();
				$customerServiceService->transferCustomerServiceCaseToBeEmail($model->ticket);

				// $objEmailService = new EmailService;
				// $objEmailService->sendCneeShipmentQuery($ref.'<br>'.$email.'<br>'.$c_note) ;
			     echo "<script type='text/javascript'>alert('Submit Success'); window.location.href = 'https://www.toplogistics.com.au/';</script>";
			}
		}
	}

	public function actionPayByPaypal()
	{
		$invoiceNo = $_GET['no'];
		$invoice = Invoice::model()->find('no = :no',[":no"=>$invoiceNo]);
		if($invoice->status==Invoice::INVOICE_STATUS_PAID)
		{
			echo "<script type='text/javascript'> alert('This invoice had been paid');window.location.href = 'https://www.toplogistics.com.au';</script>";
			return;
		}
		$invoiceService = new InvoiceService();
		echo "<script type='text/javascript'> window.location.href = '".$invoiceService->createPaypallink($invoice->id)."';</script>";
	}

	public function actionReview()
	{
		$this->layout=false;
		$this->render('review');
	}

	public function actionSubmitLowRatingReview()
	{
		if (!empty($_POST["comment"])) {
			$comment = $_POST["comment"];
			$rating = $_POST["rating"];
			$emailService = new EmailService();
			$toEmail = 'peter@toplogistics.com.au, david.ren@toplogistics.com.au, joanna.zhang@toplogistics.com.au';
			$str = "Rating:  <b>" . $rating . "</b><br>User comments:  " . $comment;
			$subject = "Customer Feedback. Rating: " .$rating;
			$emailService->sendNormalEmail($toEmail, $subject, $str);
		} else {
			return;
		}
	}

