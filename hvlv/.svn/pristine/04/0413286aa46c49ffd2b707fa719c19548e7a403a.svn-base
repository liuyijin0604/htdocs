	public function actionBookingSuccess($pbn)
	{
		$this->layout = false;
		$booking = PickupBooking::model()->findByAttributes(['booking_number' => $pbn]);
		if (!empty($booking)) {
			$booking->status = 2;
			$booking->mdata['temp_skip_paid'] = 1;
			$booking->save();
			// update shipment, set pickup time
			$shipment = ImParcel::model()->findByPk($booking->shipment_id);
			$shipment->mdata['pickup_booking_time'] = $booking->booking_time;
			$shipment->mdata['pickup_booking_number'] = $booking->booking_number;
			if($booking->mdata['shrink_wrap'] == "wrap") {
				$shipment->mdata['pickup_booking_wrap'] = "Yes";
			} else {
				$shipment->mdata['pickup_booking_wrap'] = "No";
			}
			$shipment->updateMeta();

			// Send confirmation email to customer
			$emailService = new EmailService();
			$emailService->sendBookingConfirmationEmail($booking, $shipment->mdata['amzon_pallet'],true);
		}
	}

	public function actionBookingSuccessWithAccountCode($pbn)
	{
		$this->bookingSuccessWithPayment($pbn,true);
	}

	public function actionBlukSubmitNote()
	{
		// print_r($_POST);
		// Yii::app()->end();
		if(!empty($_POST['selectedShipments'])){
			$criteria = new CDbCriteria();
			$shipmentIds = implode(',', $_POST['selectedShipments']);
			$criteria->addCondition(" id in ({$shipmentIds}) ");
			$shipments = Shipment::model()->findAll($criteria);			
		}

		$shipmentQuestionSubmit=new ShipmentQuestionSubmit();
		$model=new ShipmentQuestion('search');
		$model->unsetAttributes();  // clear any default values
		$model->org_id = Yii::app()->user->org;
		
		if(isset($_POST['selectedShipments']))
		{
			$shipmentIds = implode(',',$_POST['selectedShipments']);
			$criteria = new CDbCriteria();
			$criteria->addCondition(" id in ({$shipmentIds}) ");
			$shipments = Shipment::model()->findAll($criteria);

			if(isset($_POST['ImParcel']['ref']))
			{
				$model->setRef($_POST['ImParcel']['ref']);
			}
		}
		if(isset($_POST['ImParcel']['ref']))
		{
			$model->setRef($_POST['ImParcel']['ref']);
		}
		if(isset($_POST['ImParcel']['ref']))
		{
			$faqListArr = CsFaq::model()->findAll(" status = :status and type = 0",[":status"=>CsFaq::active]);
		}else
		{
			$faqListArr = CsFaq::model()->findAll(" status = :status and type = 1",[":status"=>CsFaq::active]);
		}

		$faqList= [];
		$faqList = [""=>"Please Select"];
		foreach ($faqListArr as $key => $value) {
			$faqList["".$value['id']] = $value['content'];
		}

		$result= array(
			'model'=>$model,'org'=>$this->org,'faqList'=>$faqList,'shipmentQuestionSubmit'=>$shipmentQuestionSubmit
		);

		if(!empty($shipments))
		{
			$result['singleCheck']=true;
			$result['shipmentIds']=$shipmentIds;
			$result['shipments']=$shipments;
		}
		// print_r($shipmentIds);

		$renderedContent = $this->renderPartial('bulk_submit_note',$result, true);

		// $renderedContent = $this->renderPartial('myView', $data, true);

		// 将渲染的内容作为JSON数据返回给客户端
		echo json_encode(array('content' => $renderedContent));
	}

	public function actionUploadBlukNote()
	{
		// print_r($_POST);
		// Yii::app()->end();
		if(isset($_POST['ShipmentQuestionSubmit']))
		{
			$errors = [];
			$ids = @$_POST['ShipmentQuestionSubmit']['shipmentIds'];
			// $criteria->addCondition(" id in ({$ids}) ");
			// $shipment = ImParcel::model()->findAll($criteria);
			$c_note = @$_POST['ShipmentQuestionSubmit']['c_note'];
			$email = @$_POST['ShipmentQuestionSubmit']['email'];
			$faq = @$_POST['faq'];
			$model=new ShipmentQuestionSubmit();
			if(empty($faq))
			{
				$errors[] = "Require select a question";
			}
			if(empty($c_note))
			{
				$errors[] = "Require notes";
			}
			if(empty($email))
			{
				$errors[] = "Require email";
			}else
			{
				$email = trim($email);
				$email2 = explode("<", $email);
				$email = $email2[0];
				$email = preg_replace('/;/', '', $email);
				if(!preg_match('/^(\w)+(\.\w+)*@(\w|-|_)+((\.\w+)+)$/', $email))
				{
					$errors[] = "Email is incorrect";
				}
			}
			if(!empty($errors))
			{
				$model->addErrors($errors);
				$this->ajaxResult($model);
			}

			$model=new ShipmentQuestionSubmit();
			if(isset($_POST['ShipmentQuestionSubmit']['c_note']))
			{
				$shipments= null;
				unset($_POST['ShipmentQuestionSubmit']['shipmentIds']);
				$model->attributes=$_POST['ShipmentQuestionSubmit'];
			
				if (!empty($ids)) {
					$sc = new CDbCriteria();
					$sc->addCondition("t.id in ({$ids}) ");
					$shipments = ImParcel::model()->findAll($sc);
					$sc->compare("ShipmentQuestionSubmit.org_id", $this->org->id);
					$sqs = ShipmentQuestion::model()->with(["Shipment","ShipmentQuestionSubmit"])->findAll($sc);
					// if(!empty($sqs))
					// {
					// 	$model->addError("Questions about ImParcels are submitted","Questions about ImParcels are submitted");
					// 	foreach ($sqs as $key => $value) {
					// 		$model->addError("Ticket:".$value->ShipmentQuestionSubmit->ticket." Ref:".$value->Shipment->ref,"Ticket:".$value->ShipmentQuestionSubmit->ticket." Ref:".$value->Shipment->ref);
					// 	}
					// 	$this->ajaxResult($model);
					// }
				}
				$model->org_id = $this->org->id;
				$model->date = date("Y-m-d H:i:s");
				$model->faq = CsFaq::model()->findByPk($_POST['faq'])->content;
				$model->email = $email;
				$model->type = ShipmentQuestionSubmit::USERGENERATE;
				$model->save();
				$model->refresh();
				if($shipments!=null)
				{
					foreach ($shipments as $key => $shipment) {


						$shipmentQuestion = new ShipmentQuestion();
						$shipmentQuestion->shipment_id= $shipment->id;
						// $shipmentQuestion->c_note= "none";
						// $shipmentQuestion->s_note= "none";
						$shipmentQuestion->submit_id= $model->id;
						$shipmentQuestion->faq = CsFaq::model()->findByPk($_POST['faq'])->content;
						$shipmentQuestion->mdata["items"] = "";//ShipmentQuestionSubmit::getItems($_POST['ShipmentQuestion']['mdata']['items'],$model,$shipment);
						// $shipmentQuestion->faq_answer = "none";
						$shipmentQuestion->save();
						ShipmentQuestionSubmit::saveFiles($_FILES,$shipmentQuestion,false);
					}
				}else
				{
					$shipmentQuestion = new ShipmentQuestion();
					$shipmentQuestion->shipment_id= 0;
					// $shipmentQuestion->c_note= "none";
					// $shipmentQuestion->s_note= "none";
					$shipmentQuestion->submit_id= $model->id;
					$shipmentQuestion->faq = CsFaq::model()->findByPk($_POST['faq'])->content;
					$shipmentQuestion->mdata["items"] = "";//ShipmentQuestionSubmit::getItems($_POST['ShipmentQuestion']['mdata']['items'],$model,$shipment);
					// $shipmentQuestion->faq_answer = "none";
					$shipmentQuestion->save();
					ShipmentQuestionSubmit::saveFiles($_FILES,$shipmentQuestion,true);
				}
				//ShipmentQuestionSubmit::sendNoticeSystemMessageToStaff($faq,count($shipments),$model->ticket);
				$customerServiceService = new CustomerServiceService();
				$customerServiceService->transferCustomerServiceCaseToBeEmail($model->ticket);

			    $this->ajaxResult($model);
			}
		}
	}

	private function multipleBookingSuccessWithPayment($pbn,$isPayWithAccountCode)
	{
		$this->layout = false;
		$pb = PickupBookingSubmit::model()->findByAttributes(['submit_no' => $pbn]);
		foreach ($pb->booking as $key => $booking)
		{
			$booking->status = 2;
			$booking->save();
			// update shipment, set pickup time
			$shipment = ImParcel::model()->findByPk($booking->shipment_id);
			$shipment->mdata['pickup_booking_time'] = $booking->booking_time;
			$shipment->mdata['pickup_booking_number'] = $booking->booking_number;
			if($booking->mdata['shrink_wrap'] == "wrap") {
				$shipment->mdata['pickup_booking_wrap'] = "Yes";
			} else {
				$shipment->mdata['pickup_booking_wrap'] = "No";
			}
			$shipment->updateMeta();
		}

		if (!empty($pb)) {
			$booking->status = 2;
			$booking->save();
			// update shipment, set pickup time
			$shipment = ImParcel::model()->findByPk($booking->shipment_id);
			$shipment->mdata['pickup_booking_time'] = $booking->booking_time;
			$shipment->mdata['pickup_booking_number'] = $booking->booking_number;
			if($booking->mdata['shrink_wrap'] == "wrap") {
				$shipment->mdata['pickup_booking_wrap'] = "Yes";
			} else {
				$shipment->mdata['pickup_booking_wrap'] = "No";
			}
			$shipment->updateMeta();

			$service = new Service();
			$cache = $service->getCacheData("BookingInvoice".$pbn);
			if(empty($cache)){
				$service->setCacheData("BookingInvoice".$pbn, 1, 50000);
				// create invoice
				$invoiceService = new InvoiceService();
				$result = $invoiceService->createContainerPickupBookingInvoiceMultiple($pb,$isPayWithAccountCode);

				if($result)
				{
					// Create invoice line
					$invoiceLineService = new InvLineService();
					$invoiceLineService->createContainerPickupBookingInvLineMultiple($pb->submit_no,$isPayWithAccountCode);
				}
			}

			// Send confirmation email to customer
			$emailService = new EmailService();
			$emailService->sendMultiBookingInvoiceEmail($pb->submit_no, $shipment->mdata['amzon_pallet']);
		}
	}

	private function sendSubmitBookingConfirm($pbn,$isPayWithAccountCode)
	{
		$this->layout = false;
		$pb = PickupBookingSubmit::model()->findByAttributes(['submit_no' => $pbn]);
		foreach ($pb->booking as $key => $booking)
		{
			// update shipment, set pickup time
			$shipment = ImParcel::model()->findByPk($booking->shipment_id);
			// Send confirmation email to customer
			$emailService = new EmailService();
			$emailService->sendBookingConfirmationEmailOnly($booking, $shipment->mdata['amzon_pallet']);
		}
	}


	private function bookingSuccessWithPayment($pbn,$isPayWithAccountCode)
	{
		$this->layout = false;
		$booking = PickupBooking::model()->findByAttributes(['booking_number' => $pbn]);
		if (!empty($booking)) {
			$booking->status = 2;
			$booking->save();
			// update shipment, set pickup time
			$shipment = ImParcel::model()->findByPk($booking->shipment_id);
			$shipment->mdata['pickup_booking_time'] = $booking->booking_time;
			$shipment->mdata['pickup_booking_number'] = $booking->booking_number;
			if($booking->mdata['shrink_wrap'] == "wrap") {
				$shipment->mdata['pickup_booking_wrap'] = "Yes";
			} else {
				$shipment->mdata['pickup_booking_wrap'] = "No";
			}
			$shipment->updateMeta();

			$service = new Service();
			$cache = $service->getCacheData("BookingInvoice".$pbn);
			if(empty($cache)){
				$service->setCacheData("BookingInvoice".$pbn, 1, 50000);
				// create invoice
				$invoiceService = new InvoiceService();
				$invoiceService->createContainerPickupBookingInvoice($booking,$isPayWithAccountCode);
				// Create invoice line
				$invoiceLineService = new InvLineService();
				$invoiceLineService->createContainerPickupBookingInvLine($pbn, $shipment,$isPayWithAccountCode);
			}

			// Send confirmation email to customer
			$emailService = new EmailService();
			$emailService->sendBookingConfirmationEmail($booking, $shipment->mdata['amzon_pallet']);
		}
	}

