	}

	public function actionContainerAvailability()
	{
		$this->layout = false;
		if(empty($_POST)) {
			$this->render('container_availability');
		} else {
			$models = Consol::model()->findAllByAttributes(['container_no' => $_POST['container_no']]);
			foreach ($models as $model) {
				if (!empty($model->eta)) {
					$model->eta = date('d-m-Y', strtotime($model->eta));
				}
				if (!empty($model->mdata['ContainerUnloadDate'])) {
					$model->mdata['ContainerUnloadDate'] = date('d-m-Y', strtotime($model->mdata['ContainerUnloadDate']));
				}
				if (!empty($model->mdata['available_date'])) {
					$model->mdata['available_date'] = date('d-m-Y', strtotime($model->mdata['available_date']));
				}
				if (!empty($model->mdata['input_storage_date'])) {
					$model->mdata['input_storage_date'] = date('d-m-Y', strtotime($model->mdata['input_storage_date']));
				}
				if (empty($model->mdata['input_storage_date']) && !empty($model->mdata['available_date'])) {
					$model->mdata['input_storage_date'] = $this->addWorkingDays($model->mdata['available_date'], 3)->format('d-m-Y');
				}
			}
			$this->render('container_availability', ['model' => $models, 'status' => 'success']);
		}
	}

	private function addWorkingDays($date, $day)
	{
		if (!($date instanceof \DateTime) || is_string($date)) {
			$date = new \DateTime($date);
		}
		if ($date instanceof \DateTime) {
			$newDate = clone $date;
		}
		if ($day == 0) {
			return $newDate;
		}
		$i = 1;
		while ($i <= abs($day)) {
			$newDate->modify(($day > 0 ? ' +' : ' -') . '1 day');
			$next_day_number = $newDate->format('N');
			if (!in_array($next_day_number, [6, 7])) {
				$i++;
			}
		}
		return $newDate;
	}

	public function actionEditContainerPickupBooking()
	{
		$this->layout = false;
		if (empty($_POST)) {
			$this->render('edit_container_booking_vertify');
		}else
		{
			$pb = PickupBooking::model()->find("booking_number = :booking_number and status = :status",[":booking_number"=>$_POST['booking_number'],":status"=>PickupBooking::PAID]);
			if(empty($pb))
			{
				$this->render('edit_container_booking_vertify',['status' => 'failed', 'msg' => 'We cannot find this booking number in our system, please check your input information and try again.','booking_number'=>$_POST['booking_number']]);
			}else
			{
				$service = new Service();
				$bookingCache = $service->getCacheData($_POST['booking_number']."_edit_booking");
				if(true)
				{
					$token = $pb->getEditToken();
					$bookingCache = $service->setCacheData($_POST['booking_number']."_edit_booking",$token);
					// Send edit booking email to customer
					$emailService = new EmailService();
					$emailService->sendBookingEditEmail($pb,$token);
					$this->render('edit_container_booking_vertify',['status' => 'failed', 'msg' => 'The link has been sent to your booking email, please check the inbox of your booking email.','booking_number'=>$_POST['booking_number']]);
				}else
				{
					$this->render('edit_container_booking_vertify',['status' => 'failed', 'msg' => 'The link has been sent to your booking email, please check the inbox of your booking email.','booking_number'=>$_POST['booking_number']]);
				}
			}
			
		}
	}


	public function actionEditBookingInfo()
	{
		$this->layout = false;
		$service = new Service();
		$bookingNumber = $_GET['booking_number'];
		$token = $_GET['token'];
		$availableDate = null;
		$bookingCache = $service->getCacheData($bookingNumber."_edit_booking");
		if(empty($bookingCache))
		{
			echo "Link was expired";
			return;
		}

		$pb = PickupBooking::model()->find("booking_number = :booking_number and status = :status",[":booking_number"=>$bookingNumber,":status"=>PickupBooking::PAID]);
		if(empty($pb))
		{
			echo "Link was expired";
			return;
		}

		if (empty($_POST))
		{

			$model = $pb->shipment;
			if (!empty($model->consol->mdata['available_date']) && !empty($model->mdata['amzon_pallet']) && ($model->status == ImParcel::STATE_CLEAR || $model->status == ImParcel::STATE_CLEAR_WAIT) && $model->status != ImParcel::DELIVERED) {
				$availableDate = date('Y-m-d H:i:s', strtotime($model->consol->mdata['available_date']));
				$today = date('Y-m-d H:i:s', strtotime('today'));
				if ($availableDate < $today) {
					$availableDate = $today;
				}
				$endDate = date('Y-m-d H:i:s', strtotime($availableDate . '+8 day'));
				$depot="";
				switch($model->consol->dpt_id) {
					case Org::TLA_DEPARTMENT_SYDNEY:
						$depot="Sydney";
						$sql = 'SELECT * FROM pickup_booking WHERE `booking_time` >= "' . $availableDate . '" AND `booking_time` < "' . $endDate . '" AND `status` != 3 AND `booking_number` LIKE "S%"';
						break;
					case Org::TLA_DEPARTMENT_MELBOURNE:
						$depot="Melbourne";
						$sql = 'SELECT * FROM pickup_booking WHERE `booking_time` >= "' . $availableDate . '" AND `booking_time` < "' . $endDate . '" AND `status` != 3 AND `booking_number` LIKE "M%"';
						break;
					case Org::TLA_DEPARTMENT_BRISBANE:
						$depot="Brisbane";
						$sql = 'SELECT * FROM pickup_booking WHERE `booking_time` >= "' . $availableDate . '" AND `booking_time` < "' . $endDate . '" AND `status` != 3 AND `booking_number` LIKE "B%"';
						break;
				}
				$bookings = PickupBooking::model()->findAllBySql($sql);
				$days = [];
				for ($i = 0; $i < 8; $i++) {
					array_push($days, date('Y-m-d', strtotime($availableDate . '+' . $i . ' day')));
				}

				$occupiedSlots = [];
				if (!empty($bookings)) {
					foreach ($bookings as $booking) {
						$bookingDate = explode(" ", $booking->booking_time)[0];
						$bookingTime = explode(" ", $booking->booking_time)[1];

						if (empty($occupiedSlots[$bookingDate])) {
							$occupiedSlots[$bookingDate] = [$bookingTime];
						} else {
							array_push($occupiedSlots[$bookingDate], $bookingTime);
						}
					}
				}

				$bookingDate = explode(" ",$pb->booking_time)[0];
				$bookingTimeArr = explode(":",explode(" ",$pb->booking_time)[1]);
				$bookingTime=$bookingTimeArr[0].":".$bookingTimeArr[1];
				$staticTimeSlot = ["7"=>["7:00","7:15","7:30","7:45"],"8"=>["8:00","8:15","8:30","8:45"],"9"=>["9:00","9:15","9:30","9:45"],"10"=>["","","10:00","10:30"],"11"=>["","","11:00","11:30"],"12"=>["","","12:00","12:30"],"13"=>["","","","13:00"],"14"=>["","","","14:00"],"15"=>["15:00","15:15","15:30","15:45"],"16"=>["16:00","16:15","16:30","16:45"],"17"=>["","","","17:30"]];
				$timeSlot = [];

				$slots = PickupBookingSlot::model()->findAll(['condition'=>'depot = :depot and status = 1',"params"=>[":depot"=>$model->consol->dpt_id],'order'=>" slot_time "]);
				foreach ($slots as $key => $value) {
					$vr = explode(":",$value->slot_time);
					$v1 = intval($vr[0]);
					$timeSlot[$v1][] = $v1.":".$vr[1];
				}

				foreach ($timeSlot as $key => $value) {
					$less = 6-count($value);
					if($less>0)
					{
						$createArr = [];
						for ($i=0; $i < $less; $i++) { 
							$createArr[] = "";
						}
						foreach ($value as $key2 => $value2) {
							$createArr[] = $value2;
						}
						$timeSlot[$key] = $createArr;
					}
				}


				$this->render('edit_booking_info', array(
					'availableDate' => $availableDate,
					'endDate' => $endDate,
					'occupiedSlots' => $occupiedSlots,
					'container_no' => $model->consol->container_no,
					'house_bl' => $model->hbn,
					'packages' => $model->pkg,
					'pallets' => $model->mdata['amzon_pallet'],
					'weight' => $model->weight,
					'volume' => (!empty($model->mdata['total_cbm'])?number_format($model->cbm*$model->pkg,'4','.',''):$model->mdata['total_cbm']),
					'driver_name'=>$pb->driver_name,
					'rego'=>$pb->rego,
					'company_name'=>$pb->company_name,
					'company_email'=>$pb->company_email,
					'depot' => $depot,
					'booking_number'=>$bookingNumber,
					'booking_date'=>$bookingDate,
					'booking_time'=>$bookingTime,
					'token'=>$token,
					'staticTimeSlot'=>$timeSlot
				));
			}else
			{
					echo "Booking information can not be adjusted.";

			}
		}else
		{
			$oldBookingTime = $pb->booking_time;
			$pb->booking_time = $_POST['booking_date'] . ' ' . $_POST['booking_time'] . ':00';
			$pb->driver_name = $_POST['name'];
			$pb->company_name = $_POST['company_name'];
			$pb->company_email = $_POST['email'];
			$pb->rego = $_POST['rego'];

			// backend limit booking time <2 hour
			$diffHours = HolidayHelper::hourDiffBetweenTwoDays($pb->booking_time,date("Y-m-d H:i:s"));
			if($diffHours<2)
			{
				echo 'Slot has been occupied, please pick another time slot.';
				return;
			}

			if($pb->booking_time==$oldBookingTime)
			{
				$pb->save();
				echo $pb->booking_number;
				// Send confirmation email to customer
				$emailService = new EmailService();
				$emailService->sendBookingConfirmationEmail($pb, $pb->shipment->mdata['amzon_pallet']);
			}else
			{
				// Check if the choosen slot has already been occupied, only save this record when the slot is available.
				switch($pb->shipment->consol->dpt_id) {
					case Org::TLA_DEPARTMENT_SYDNEY:
						$sql = 'SELECT `booking_time` FROM pickup_booking WHERE `status` != 3 AND `booking_number` LIKE "S%"';
						//$dependency = new CDbCacheDependency('SELECT MAX(id) FROM pickup_booking WHERE `status` != 3 AND `booking_number` LIKE "S%"');
						break;
					case Org::TLA_DEPARTMENT_MELBOURNE:
						$sql = 'SELECT `booking_time` FROM pickup_booking WHERE `status` != 3 AND `booking_number` LIKE "M%"';
						//$dependency = new CDbCacheDependency('SELECT MAX(id) FROM pickup_booking WHERE `status` != 3 AND `booking_number` LIKE "M%"');
						break;
					case Org::TLA_DEPARTMENT_BRISBANE:
						$sql = 'SELECT `booking_time` FROM pickup_booking WHERE `status` != 3 AND `booking_number` LIKE "B%"';
						//$dependency = new CDbCacheDependency('SELECT MAX(id) FROM pickup_booking WHERE `status` != 3 AND `booking_number` LIKE "B%"');
						break;
				}
				//$slotCheck = Yii::app()->db->cache($depot."54321", $dependency)->createCommand($sql)->queryAll();
				$slotCheck = Yii::app()->db->createCommand($sql)->queryAll();
				if (empty($slotCheck)||!in_array(['booking_time' => $pb->booking_time], $slotCheck)) {
					$pb->save();		// save record to database
					$pb->shipment->mdata['pickup_booking_time'] = $pb->booking_time;
					$pb->shipment->updateMeta();
					echo $pb->booking_number;
					// Send confirmation email to customer
					$emailService = new EmailService();
					$emailService->sendBookingConfirmationEmail($pb, $pb->shipment->mdata['amzon_pallet']);
				}else {
					// Selected slot is occupied, return error message
					echo 'Slot has been occupied, please pick another time slot.';
				}
			}
		}
	}

	public function actionContainerBookingVertify()
	{
		$this->layout = false;
		if (empty($_POST)) {
			$this->render('container_booking_vertify');
		} else {
			$direct = $_POST['direct'];
			$depot = $_POST['depot'];
			$containerNoArr = $_POST['container_no'];
			$connoteArr = $_POST['house_bl'];
			$finalResult = [];
			$error = 0;
			$dataArr = [];
			$checkHbns = [];
			foreach ($containerNoArr as $key => $value) {
				$container_no = $containerNoArr[$key];
				$connote = $connoteArr[$key];
				if(empty($depot)||empty($container_no)||empty($connote))
				{
					$thisResult = ["status"=>0,"msg"=>"Please input the container number and house bill number"];
					$finalResult[$key] = $thisResult;
					$error = 1;
					continue;
				}

				if(in_array($connote,$checkHbns))
				{
					$thisResult = ["status"=>0,'msg'=>'This house bill is duplicated'];
					$finalResult[$key] = $thisResult;
					$error = 1;
					continue;
				}

				$checkHbns[] = $connote;
				$thisResult = [];
				$result = $this->handlingSingleBookingSlot($depot,$container_no,$connote);// this function will process the result for every booking slot
				if(!empty($result['status']))
				{
					$dataArr[] = $result['data'];// when it is successful, push data into the arr for the final render operation
					$thisResult = ["status"=>$result['status'],'msg'=>''];
				}else
				{
					$thisResult = ["status"=>$result['status'],'msg'=>$result['msg']];//when it is failed ,get the message for frontend
					$error = 1;
				}
				$finalResult[$key] = $thisResult;
			}

			if(empty($direct))
			{
				echo json_encode(['error'=>$error,'data'=>$finalResult]);
				return;
			}

			if($error==0&&!empty($direct))
			{
				$staticTimeSlot = ["7"=>["7:00","7:15","7:30","7:45"],"8"=>["8:00","8:15","8:30","8:45"],"9"=>["9:00","9:15","9:30","9:45"],"10"=>["","","10:00","10:30"],"11"=>["","","11:00","11:30"],"12"=>["","","12:00","12:30"],"13"=>["","","","13:00"],"14"=>["","","","14:00"],"15"=>["15:00","15:15","15:30","15:45"],"16"=>["16:00","16:15","16:30","16:45"],"17"=>["","","","17:30"]];
				$timeSlot = [];
				switch ($depot) {
					case 'Sydney':
						$dptId= Org::TLA_DEPARTMENT_SYDNEY;
						break;
					case 'Melbourne':
						$dptId= Org::TLA_DEPARTMENT_MELBOURNE;
						break;
					case 'Brisbane':
						$dptId= Org::TLA_DEPARTMENT_BRISBANE;
						break;
					
					default:
						$dptId= Org::TLA_DEPARTMENT_SYDNEY;
						break;
				}

				$slots = PickupBookingSlot::model()->findAll(['condition'=>'depot = :depot and status = 1',"params"=>[":depot"=>$dptId],'order'=>" slot_time "]);
				foreach ($slots as $key => $value) {
					$vr = explode(":",$value->slot_time);
					$v1 = intval($vr[0]);
					$timeSlot[$v1][] = $v1.":".$vr[1];
				}

				foreach ($timeSlot as $key => $value) {
					$less = 6-count($value);
					if($less>0)
					{
						$createArr = [];
						for ($i=0; $i < $less; $i++) { 
							$createArr[] = "";
						}
						foreach ($value as $key2 => $value2) {
							$createArr[] = $value2;
						}
						$timeSlot[$key] = $createArr;
					}
				}
				$this->render('container_pickup_booking',['data'=>$dataArr,'staticTimeSlot'=>$timeSlot]);
			}else
			{
				$this->render('container_booking_vertify');
			}
		}
	}

	private function handlingSingleBookingSlot($depot,$container_no,$connote)
	{	
		if(empty($depot)||empty($container_no)||empty($connote))
		{
			return ["status"=>0,"msg"=>"Please input the container number and house bill number"];
		}

		switch($depot) {
			case "Sydney":
				$sql = 'SELECT * FROM shipment WHERE `hbn` = "' . $connote . '" AND `consol_id` IN (SELECT `id` FROM consol WHERE ((`container_no` = "' . $container_no . '" AND `service` = 20) OR (`awb` = "' . $container_no . '" AND `service` = 10)) AND `dpt_id` = 106)';
				break;
			case "Melbourne":
				$sql = 'SELECT * FROM shipment WHERE `hbn` = "' . $connote . '" AND `consol_id` IN (SELECT `id` FROM consol WHERE ((`container_no` = "' . $container_no . '" AND `service` = 20) OR (`awb` = "' . $container_no . '" AND `service` = 10)) AND `dpt_id` = 218)';
				break;
			case "Brisbane":
				$sql = 'SELECT * FROM shipment WHERE `hbn` = "' . $connote . '" AND `consol_id` IN (SELECT `id` FROM consol WHERE ((`container_no` = "' . $container_no . '" AND `service` = 20) OR (`awb` = "' . $container_no . '" AND `service` = 10)) AND `dpt_id` = 530)';
				break;
		}
		$model = ImParcel::model()->findBySql($sql);
		$availableDate = null;
		if (!empty($model)) {
			if ($model->consol->service == Consol::SEACONSOL) {
				// Handle sea consol booking
				// For checking whether booking record is already exist
				$bookingCheck = PickupBooking::model()->findBySql('SELECT * FROM pickup_booking WHERE `shipment_id` = "' . $model->id .'" AND `status` = 2');
				//$bookingCheck = null;  // For test
				if (!empty($model->consol->mdata['available_date']) && !empty($model->mdata['amzon_pallet']) && ($model->status == ImParcel::STATE_CLEAR || $model->status == ImParcel::STATE_CLEAR_WAIT) && $model->status != ImParcel::DELIVERED && $model->status != ImParcel::STATE_SUB_UBM && empty($bookingCheck)) {
					$availableDate = date('Y-m-d H:i:s', strtotime($model->consol->mdata['available_date']));
					$today = date('Y-m-d H:i:s', strtotime('today'));
					if ($availableDate < $today) {
						$availableDate = $today;
					}
					$endDate = date('Y-m-d H:i:s', strtotime($availableDate . '+8 day'));
					switch($depot) {
						case "Sydney":
							$sql = 'SELECT * FROM pickup_booking WHERE `booking_time` >= "' . $availableDate . '" AND `booking_time` < "' . $endDate . '" AND `status` != 3 AND `booking_number` LIKE "S%"';
							break;
						case "Melbourne":
							$sql = 'SELECT * FROM pickup_booking WHERE `booking_time` >= "' . $availableDate . '" AND `booking_time` < "' . $endDate . '" AND `status` != 3 AND `booking_number` LIKE "M%"';
							break;
						case "Brisbane":
							$sql = 'SELECT * FROM pickup_booking WHERE `booking_time` >= "' . $availableDate . '" AND `booking_time` < "' . $endDate . '" AND `status` != 3 AND `booking_number` LIKE "B%"';
							break;
					}
					$bookings = PickupBooking::model()->findAllBySql($sql);
					$days = [];
					for ($i = 0; $i < 8; $i++) {
						array_push($days, date('Y-m-d', strtotime($availableDate . '+' . $i . ' day')));
					}

					$occupiedSlots = [];
					if (!empty($bookings)) {
						foreach ($bookings as $booking) {
							$bookingDate = explode(" ", $booking->booking_time)[0];
							$bookingTime = explode(" ", $booking->booking_time)[1];

							if (empty($occupiedSlots[$bookingDate])) {
								$occupiedSlots[$bookingDate] = [$bookingTime];
							} else {
								array_push($occupiedSlots[$bookingDate], $bookingTime);
							}
						}
					}
					return array(
						'status' => 1, 
						'data'=>[
						'availableDate' => $availableDate,
						'endDate' => $endDate,
						'occupiedSlots' => $occupiedSlots,
						'container_no' => $container_no,
						'house_bl' => $connote,
						'packages' => $model->pkg,
						'pallets' => $model->mdata['amzon_pallet'],
						'weight' => $model->weight,
						'volume' => (empty($model->mdata['total_cbm'])?number_format($model->cbm*$model->pkg,'4','.',''):$model->mdata['total_cbm']),
						'depot' => $depot,
						'pallet_type'=>@$model->mdata["amzon_pallet_type"]
						]
					);
				} elseif (empty($model->consol->mdata['available_date'])) {
					return ['status' => 0, 'msg' => 'We cannot find available date for this pick up.', 'container_no' => $container_no, 'house_bl' => $connote, 'depot' => $depot];
				} elseif (empty($model->mdata['amzon_pallet'])) {
					return ['status' => 0, 'msg' => 'The shipment is not avaiable for booking, please contact us by sending email to imports@toplogistics.com.au', 'container_no' => $container_no, 'house_bl' => $connote, 'depot' => $depot];
				} elseif ($model->status != ImParcel::STATE_CLEAR && $model->status != ImParcel::STATE_CLEAR_WAIT) {
					if ($model->status == ImParcel::DELIVERED) {
						return ['status'=>0, 'msg'=>'This shipment has been successfully picked up.', 'container_no'=>$container_no, 'house_bl'=>$connote, 'depot' => $depot];
					} elseif ($model->status == ImParcel::STATE_SUB_UBM) {
						return ['status'=>0, 'msg'=>'Please book with per lowest bill', 'container_no'=>$container_no, 'house_bl'=>$connote, 'depot' => $depot];
					} else {
						return ['status' => 0, 'msg' => 'The shipment is not Customs cleared, please try again later.', 'container_no' => $container_no, 'house_bl' => $connote, 'depot' => $depot];
					}	
				} elseif (!empty($bookingCheck)) {
					return ['status' => 0, 'msg' => 'You have already booked a pickup time, please check your company email for booking details.', 'container_no' => $container_no, 'house_bl' => $connote, 'depot' => $depot];
				}
			} elseif ($model->consol->service == Consol::AIRCONSOL) {
				// Handle air consol booking
				// For checking whether booking record is already exist
				$bookingCheck = PickupBooking::model()->findBySql('SELECT * FROM pickup_booking WHERE `shipment_id` = "' . $model->id .'" AND `status` = 2');
				//$bookingCheck = null;  // For test

				/**
				 * For air consol only, according to IT task IT00378232 requirements
				 * If there is no pallet, set number of pallets to 1
				 * 2023-01-11
				 */
				if (empty($model->mdata['amzon_pallet']) || $model->mdata['amzon_pallet'] <= 0) {
					$model->mdata['amzon_pallet'] = 1;
					$model->updateMeta();
				}
				if (($model->status == ImParcel::STATE_CLEAR || $model->status == ImParcel::STATE_CLEAR_WAIT) && $model->status != ImParcel::DELIVERED && $model->status != ImParcel::STATE_SUB_UBM && empty($bookingCheck)) {
					/**
					 * For air consol only, according to IT task IT00378232 requirements
					 * If no available date, set available date to first scan date +1 day
					 * 2023-01-11
					 */
					if (!empty($model->consol->mdata['available_date'])) {
						$availableDate = date('Y-m-d H:i:s', strtotime($model->consol->mdata['available_date']));
					} elseif (!empty($model->mdata['scan_time'])) {
						$availableDate = date('Y-m-d H:i:s', strtotime($model->mdata['scan_time'] . ' +1 day'));
						$model->consol->mdata['available_date'] = $availableDate;
						$model->consol->updateMeta();
					} else {
						return ['status' => 0, 'msg' => 'We cannot find available date for this pick up.', 'container_no' => $container_no, 'house_bl' => $connote, 'depot' => $depot];
					}
					$endDate = date('Y-m-d H:i:s', strtotime($availableDate . '+8 day'));
					switch($depot) {
						case "Sydney":
							$sql = 'SELECT * FROM pickup_booking WHERE `booking_time` >= "' . $availableDate . '" AND `booking_time` < "' . $endDate . '" AND `status` != 3 AND `booking_number` LIKE "S%"';
							break;
						case "Melbourne":
							$sql = 'SELECT * FROM pickup_booking WHERE `booking_time` >= "' . $availableDate . '" AND `booking_time` < "' . $endDate . '" AND `status` != 3 AND `booking_number` LIKE "M%"';
							break;
						case "Brisbane":
							$sql = 'SELECT * FROM pickup_booking WHERE `booking_time` >= "' . $availableDate . '" AND `booking_time` < "' . $endDate . '" AND `status` != 3 AND `booking_number` LIKE "B%"';
							break;
					}
					$bookings = PickupBooking::model()->findAllBySql($sql);
					$days = [];
					for ($i = 0; $i < 8; $i++) {
						array_push($days, date('Y-m-d', strtotime($availableDate . '+' . $i . ' day')));
					}

					$occupiedSlots = [];
					if (!empty($bookings)) {
						foreach ($bookings as $booking) {
							$bookingDate = explode(" ", $booking->booking_time)[0];
							$bookingTime = explode(" ", $booking->booking_time)[1];

							if (empty($occupiedSlots[$bookingDate])) {
								$occupiedSlots[$bookingDate] = [$bookingTime];
							} else {
								array_push($occupiedSlots[$bookingDate], $bookingTime);
							}
						}
					}
					$pallets = 1;
					if (!empty($model->mdata['amzon_pallet'])) {
						$pallets = $model->mdata['amzon_pallet'];
					}
					return array(
						'status' => 1, 
						'data'=>[
						'availableDate' => $availableDate,
						'endDate' => $endDate,
						'occupiedSlots' => $occupiedSlots,
						'container_no' => $container_no,
						'house_bl' => $connote,
						'packages' => $model->pkg,
						'pallets' => $pallets,
						'weight' => $model->weight,
						'volume' => (empty($model->mdata['total_cbm'])?number_format($model->cbm*$model->pkg,'4','.',''):$model->mdata['total_cbm']),
						'depot' => $depot,
						'pallet_type'=>@$model->mdata["amzon_pallet_type"]
						]
					);
				} elseif ($model->status != ImParcel::STATE_CLEAR && $model->status != ImParcel::STATE_CLEAR_WAIT) {
					if ($model->status == ImParcel::DELIVERED) {
						return ['status'=>0, 'msg'=>'This shipment has been successfully picked up.', 'container_no'=>$container_no, 'house_bl'=>$connote, 'depot' => $depot];
					} elseif ($model->status == ImParcel::STATE_SUB_UBM) {
						return ['status'=>0, 'msg'=>'Please book with per lowest bill', 'container_no'=>$container_no, 'house_bl'=>$connote, 'depot' => $depot];
					} else {
						return ['status' => 0, 'msg' => 'The shipment is not Customs cleared, please try again later.', 'container_no' => $container_no, 'house_bl' => $connote, 'depot' => $depot];
					}
				} elseif (!empty($bookingCheck)) {
					return ['status' => 0, 'msg' => 'You have already booked a pickup time, please check your company email for booking details.', 'container_no' => $container_no, 'house_bl' => $connote, 'depot' => $depot];
				}
			}
		} else {
			return ['status' => 0, 'msg' => 'We cannot find this record in our system, please check your input information and try again.', 'container_no' => $container_no, 'house_bl' => $connote, 'depot' => $depot];
		}
	}

	public function actionContainerPickupBooking()
	{
		if (!empty($_POST)) {
			echo json_encode($this->saveBookingSubmit());
		}
	}

	private function saveBookingSubmit()
	{
		$hbnArr = $_POST['house_bl'];
		$accountCode = empty($_POST['account_code'])?"":$_POST['account_code'];
		$rego = $_POST['rego_default'];
		$name = $_POST['name_default'];
		$company_name = $_POST['company_name_default'];
		$email = $_POST['email_default'];
		$resultArr = [];
		$errors = [];
		$fee = 0;
		$dateTimeArr = [];
		foreach ($hbnArr as $i => $hbn) {
			$booking_date = $_POST['booking_date'][$i];
			$booking_time = $_POST['booking_time'][$i];
			$dateTimeArr[] = $booking_date." ".$booking_time;
		}

		if(count(array_unique($dateTimeArr))!=count($hbnArr))
		{
			$errors[] = "Duplicated pickup date and time selected";
		}

		if(!empty($errors))
		{
			return ["status"=>3,"msg"=>join(",",$errors)];
		}


		foreach ($hbnArr as $i => $hbn) {
			$containerNo = $_POST['container_no'][$i];
			$depot = $_POST['depot'];
			$palletRequirement = $_POST['pallet_requirement_'.$i][0];
			$shrinkWrap = $_POST['shrink_wrap_'.$i][0];
			$booking_date = $_POST['booking_date'][$i];
			$booking_time = $_POST['booking_time'][$i];
			$rego = !empty($_POST['rego'][$i])?$_POST['rego'][$i]:$rego;
			$name =  !empty($_POST['name'][$i])?$_POST['name'][$i]:$name;
			$company_name =  !empty($_POST['company_name'][$i])?$_POST['company_name'][$i]:$company_name;
			$email =  !empty($_POST['email'][$i])?$_POST['email'][$i]:$email;


			$note = $_POST['note'][$i];
			$thisResult = $this->saveSingleBooking($containerNo,$depot,$hbn,$accountCode,$rego,$name,$company_name,$email,$palletRequirement,$shrinkWrap,$booking_date,$booking_time,$note);
			if($thisResult['status'])
			{
				$resultArr[$hbn.'-'.$i] = $thisResult['msg'];
				$fee+=$thisResult['fee'];
			}else
			{
				$errors[$hbn] = $thisResult["msg"];
			}
		}
		if(empty($errors))
		{
			$pickupBookingSubmit = new PickupBookingSubmit();
			$pickupBookingSubmit->generateSubmitNumber(date("Y-m-d H:i:s"),$depot);
			$pickupBookingSubmit->created = date("Y-m-d H:i:s");
			$pickupBookingSubmit->fee = $fee;
			$pickupBookingSubmit->gst = $pickupBookingSubmit->fee*0.1;
			$pickupBookingSubmit->total = $fee*1.1;
			$pickupBookingSubmit->save();
			$bookingStatus = [];
			foreach ($hbnArr as $i => $hbn) {
				$bookingNumber = $resultArr[$hbn.'-'.$i];
				$pickupBooking = PickupBooking::model()->find("booking_number = :bookingNumber",[":bookingNumber"=>$bookingNumber]);
				$pickupBooking->submit_id = $pickupBookingSubmit->id;
				$pickupBooking->booking_number = $pickupBookingSubmit->submit_no."-".($i+1);
				if (!empty($_FILES)) {
					$j = 1;
					foreach ($_FILES as $fk=> $file) {
						if(preg_match("/file_{$i}/",$fk))
						{
							if ($file['error'] == 0 && !empty($file['name'])) {
								$fileType = substr($file['type'], strpos($file['type'], "/")+1);
								$file['name'] = $hbn . "-DO-" . $j .'.'. $fileType;
								$target_dir = Yii::app()->basePath . DIRECTORY_SEPARATOR . "runtime" . DIRECTORY_SEPARATOR . "pickup_booking_DO" . DIRECTORY_SEPARATOR;
								if (!is_dir($target_dir)) {
									mkdir($target_dir);
								}
								$target_file = $target_dir . basename($file["name"]);
								move_uploaded_file($file['tmp_name'], $target_file);
								// TODO: create a new file type in FileRepo class istead of 18
								$filerepoId = FileRepo::storeFile($target_file, basename($file["name"]), 200, $pickupBooking->shipment_id);
								unlink($target_file);
								$j++;
							}
						}
					}

					if(!empty($accountCode))
					{
						$pickupBooking->status = PickupBooking::PAID;
						$pickupBooking->mdata['pay_with_account_code'] = 1;
						$pickupBooking->save();
						$bookingStatus[] = 2;
					}else
					{
						$pickupBooking->save();
						$bookingStatus[] = 1;
					}
				}

			}

			if(round(array_sum($bookingStatus))==round((2*count($hbnArr))))
			{
				$this->sendSubmitBookingConfirm($pickupBookingSubmit->submit_no,false);
				$this->multipleBookingSuccessWithPayment($pickupBookingSubmit->submit_no,true);
				return ["status"=>2,"msg"=>$pickupBookingSubmit->submit_no];
			}elseif(round(array_sum($bookingStatus))==round(count($hbnArr)))
			{
				return ["status"=>1,"msg"=>$pickupBookingSubmit->submit_no];
			}

		}else
		{
			foreach ($resultArr as $i => $bookingNumber) {
				$pickupBooking = PickupBooking::model()->find("booking_number = :bookingNumber",[":bookingNumber"=>$bookingNumber]);
				$pickupBooking->status = PickupBooking::CANCELLED;
				$pickupBooking->update(['status']);
			}
			return ["status"=>3,"msg"=>join(",",$errors)];
		}
	}
	private function saveSingleBooking($containerNo,$depot,$hbn,$accountCode,$rego,$name,$company_name,$email,$palletRequirement,$shrinkWrap,$booking_date,$booking_time,$note)
	{
		$sql = 'SELECT * FROM shipment WHERE `hbn` = "' . $hbn . '" AND `consol_id` IN (SELECT `id` FROM consol WHERE (`container_no` = "' . $containerNo . '" AND `service` = 20) OR (`awb` = "' . $containerNo . '" AND `service` = 10))';
		$shipment = ImParcel::model()->findBySql($sql);
		$palletFee = SystemSetting::getSetting("BookingFee","palletFee");
		$wrapFee = SystemSetting::getSetting("BookingFee","wrapFee");
		$baseFee = SystemSetting::getSetting("BookingFee","baseFee");
		$totalPalletFee = 0.00;
		$totalWrapFee = 0.00;
		$discount = 0;
		$percentage = 1;
		if(!empty($accountCode))
		{
			$accountCode = SellRate::findImCode($accountCode);
			if(empty($accountCode))
			{
				return ["status"=>false,"msg"=>'Account Code is invalid.'];
			}
			$percentage = $percentage-$accountCode->item;
		}
		// backend limit booking time <2 hour
		$diffHours = HolidayHelper::hourDiffBetweenTwoDays($booking_date . ' ' . $booking_time . ':00',date("Y-m-d H:i:s"));
		if($diffHours<2)
		{
			return ["status"=>false,"msg"=>'House bl '.$hbn.' : Slot has been occupied, please pick another time slot.'];
		}

		$baseFee = $baseFee*$percentage;
		$fee = $baseFee;
		if (!empty($shipment->mdata['amzon_pallet']) && $shipment->mdata['amzon_pallet'] > 0) {
			if ($palletRequirement == 'plain') {
				$fee += $shipment->mdata['amzon_pallet'] * $palletFee*$percentage;
				$totalPalletFee = $shipment->mdata['amzon_pallet'] * $palletFee*$percentage;
			}
			if ($shrinkWrap == 'wrap') {
				$fee += $shipment->mdata['amzon_pallet'] * $wrapFee*$percentage;
				$totalWrapFee = $shipment->mdata['amzon_pallet'] * $wrapFee*$percentage;
			}
		}

		$pickupBooking = new PickupBooking();
		$pickupBooking->rego = $rego;
		$pickupBooking->status = 1;
		$pickupBooking->booking_time = $booking_date . ' ' . $booking_time . ':00';
		$pickupBooking->create_date = date("Y-m-d H:i:s");
		$pickupBooking->driver_name = $name;
		$pickupBooking->company_name = $company_name;
		$pickupBooking->company_email = $email;
		$pickupBooking->fee = $fee;
		$pickupBooking->mdata['depot'] = $depot;
		$pickupBooking->mdata['container_no'] = $containerNo;
		$pickupBooking->mdata['house_bl'] = $hbn;
		$pickupBooking->mdata['pallet_requirement'] = $palletRequirement;
		$pickupBooking->mdata['shrink_wrap'] = $shrinkWrap;
		$pickupBooking->mdata['pallet_fee'] = $totalPalletFee;
		$pickupBooking->mdata['wrap_fee'] = $totalWrapFee;
		$pickupBooking->mdata['base_fee'] = $baseFee;

		if(!empty($accountCode))
		{
			$pickupBooking->mdata['account_code'] = $accountCode->code;
		}

		$pickupBooking->note = $note;
		$pickupBooking->generateBookingNumber($depot);
		$pickupBooking->shipment_id = $shipment->id;
		$pickupBooking->ref = $shipment->ref;

		// Check if the choosen slot has already been occupied, only save this record when the slot is available.
		//$slotCheck = PickupBooking::model()->findByAttributes(['booking_time' => $pickupBooking->booking_time]);
		switch($depot) {
			case "Sydney":
				$sql = 'SELECT `booking_time` FROM pickup_booking WHERE `status` != 3 AND `booking_number` LIKE "S%"';
				//$dependency = new CDbCacheDependency('SELECT MAX(id) FROM pickup_booking WHERE `status` != 3 AND `booking_number` LIKE "S%"');
				$pickupBooking->depot_id = 106;
				break;
			case "Melbourne":
				$sql = 'SELECT `booking_time` FROM pickup_booking WHERE `status` != 3 AND `booking_number` LIKE "M%"';
				//$dependency = new CDbCacheDependency('SELECT MAX(id) FROM pickup_booking WHERE `status` != 3 AND `booking_number` LIKE "M%"');
				$pickupBooking->depot_id = 218;
				break;
			case "Brisbane":
				$sql = 'SELECT `booking_time` FROM pickup_booking WHERE `status` != 3 AND `booking_number` LIKE "B%"';
				//$dependency = new CDbCacheDependency('SELECT MAX(id) FROM pickup_booking WHERE `status` != 3 AND `booking_number` LIKE "B%"');
				$pickupBooking->depot_id = 530;
				break;
		}
		//$slotCheck = Yii::app()->db->cache($depot."54321", $dependency)->createCommand($sql)->queryAll();
		$slotCheck = Yii::app()->db->createCommand($sql)->queryAll();
		if (empty($slotCheck)||!in_array(['booking_time' => $pickupBooking->booking_time], $slotCheck))
		{
			$pickupBooking->save();
			return ["status"=>true,"msg"=>$pickupBooking->booking_number,"fee"=>$pickupBooking->fee];
		} else {
			// Selected slot is occupied, return error message.
			return ["status"=>false,"msg"=>'House bl '.$hbn.' : Slot has been occupied, please pick another time slot.'];
		}
	}

	public function actionBookingCheckout($bookingNo)
	{
		$this->layout = false;
		$booking = PickupBooking::model()->findByAttributes(['booking_number' => $bookingNo]);
		$sql = 'SELECT * FROM shipment WHERE `hbn` = "' . $booking->mdata['house_bl'] . '" AND `consol_id` IN (SELECT `id` FROM consol WHERE WHERE (`container_no` = "' . $booking->mdata['container_no'] . '" AND `service` = 20) OR (`awb` = "' . $booking->mdata['container_no'] . '" AND `service` = 10))';
		$imParcel = ImParcel::model()->findBySql($sql);
		$numPallets = intval($imParcel->mdata['amzon_pallet']);
		$this->render('booking_checkout', array('model' => $booking, 'numPallets' => $numPallets));
	}

