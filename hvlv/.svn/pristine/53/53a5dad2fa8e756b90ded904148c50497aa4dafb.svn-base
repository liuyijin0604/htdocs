                }
                if (empty($oc) || $default_rts) :
                ?>
                    <?php switch($label->ddpt_id) {
                        case 106:
                            echo $name . '<br />' . Org::IM_COMPANY_ADDRESS_TLA . '<br />' . Org::IM_COMPANY_CITY_TLA;
                            break;
                        case 218:
                            echo $name . '<br />' . Org::WAREHOUSE_ADDRESS_MEL . '<br />' . Org::WAREHOUSE_CITY_MEL;
                            break;
                        case 530:
                            echo $name . '<br />' . Org::WAREHOUSE_ADDRESS_BNE . '<br />' . Org::WAREHOUSE_CITY_BNE;
                            break;
                        case 811:
                            echo $name . '<br />' . Org::WAREHOUSE_ADDRESS_PER . '<br />' . Org::WAREHOUSE_CITY_PER;
                            break;
                        default:
                            echo $name . '<br />' . Org::IM_COMPANY_ADDRESS_TLA . '<br />' . Org::IM_COMPANY_CITY_TLA;
                    } ?>
                <?php else :
                    echo $oc->name, '<br />',
