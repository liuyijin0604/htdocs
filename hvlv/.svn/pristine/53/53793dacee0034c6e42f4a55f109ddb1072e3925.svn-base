 <?php
 $tabs = array(
	array('tla_task_list',$this->t('My Tla Task List'), true),
  array('closed_by_assigned_user', $this->t('Need You Confirm'),true),
  array('closed_tla_task_need_confirm_list', $this->t('Need Assignor Confirm'),true),
 );
 foreach($tabs as $tab){
	if(Acl::hasAccess($this->CaName.'/'.$tab[0]) && $tab[1]){
    $isMineStr="";
    if($isMine)
    {
      $isMineStr = 'id = "my_tla_task_tab_'.$tab[0].'"';
    }
		$href = strpos($tab[0], '/') === false? $this->createUrl('tlaTask/getTlaTaskList',array('tab'=>$tab[0], "tabid" => $_GET["tabid"],"user_id" => $user_id)) : $tab[0];
		echo '<li><a href="'.$href.'">'.$tab[1].'<span style="color:red" '.$isMineStr.'></span>'.'</a></li>';
	}
 }
 ?>
  </ul>
