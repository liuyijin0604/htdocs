                    $_POST['weight'],
                    $_POST['length'],
                    $_POST['width'],
                    $_POST['height'],
                    $_POST['quantity'],
                    $_POST['note'],
                    '',
                    '',
                    PriceEnquiry::status_new
                );
            } else {
            }

            echo json_encode(['isSuccess' => true]);
            return;
        } else {
            // get
            if (isset($_GET['id'])) {
                $numId = $_GET['id'];
                $objPriceEnquiry = PriceEnquiry::model()->findByPk($numId);
            } else {
                $objPriceEnquiry = new PriceEnquiry;
                $objPriceEnquiry->status = PriceEnquiry::status_new;
            }

            $this->layout = 'pe';
