/**
 * POS
**/

var posApp = {
	auth: false,
	user: '',
	baseUrl: '',
	pleaseWait: 'Please Wait',
	popped: ('state' in window.history && window.history.state !== null),
	init: function(){
		var t = this;
		var initUrl = window.location.href;
		$('body').on('submit', 'form:not(.ifrm-form)', function(evt){
			var f = $(this);
			if(!f.data('ajaxf')){
				f.ajaxForm({
					success: function(r,s,x,f) {
						//bit 1 no reset, 2 custom-success, 4 no lock submit button
						var bit = Number(f.data('bit')) || 0;
						if((bit & 2) > 0){
							f.trigger('success', [r,s,x,f]);
							return false;
						}
						f.trigger('before-success', [r]);
						if(r.done === true){
							$('#notifc').notify({message: {html: r.msg}}).show();
							f.trigger('success', [r]);
							if((bit & 1) === 0) f.resetForm();
						}else{
							$('#notifc').notify({message: {html: r.msg}, type: 'danger'}).show();
							f.trigger('error', [r]);
						}
						t.btnLoading($('button[type=submit]', f), true);
					},
					beforeSubmit: function(a,f,o){
						f.trigger('before-submit');
						if(f.data('invalid') === true){
							return false;
						}else{
							var bit = Number(f.data('bit')) || 0;
							if((bit & 4) === 0) t.btnLoading($('button[type=submit]', f));
							return true;
						}
					},
					dataType: 'json',
				});
				f.data('ajaxf', true);
				f.submit();
				return false;
			}
		}).on('click', '.breadcrumbs a, a.ajax-link', function(e){
			t.toPage($(this).attr("href"), true);
			e.preventDefault();
		});

		$('#lf_capcha').click(function(){
			$(this).attr('src', t.baseUrl+'site/captcha?'+Math.random());
		});

		$(window).on('popstate', function(e){
			var pop0 = !t.popped && location.href == initUrl;
  			t.popped = true
  			if(pop0) return;
    		t.toPage(window.location.href, false);
		});


		$('.nav .dropdown-menu').on('click', 'a', function(){
			$('.navbar-toggle:visible').trigger('click');
		});

		$('a.confirm_link').on('click', function(){
			return window.confirm('Are you sure?');
		});
	},
	showLogin: function(){
		$('#modal-login').modal({backdrop: 'static'});
		$('#lf_capcha').trigger('click');
	},
	toPage: function(l,p){
		if(window.history && p) window.history.pushState(null, "", l);
		$('#main').load(l, function(r, s, x) {
			if(s == "error") $('#notifc').notify({message: {html: r}, type: 'danger'}).show();
		});
	},
	btnLoading: function(b,d){
		if(d === true){
			b.attr('disabled', false).html(b.data('oc'));
		}else{
			b.data('oc', b.html());
			b.attr('disabled', true).html('<span class="glyphicon glyphicon-refresh glyphicon-refresh-animate"></span> '+this.pleaseWait);
		}
	},
	afterAuth: function(n){
		this.user = n;
		$('#uinfo').html('Logged in as <b>'+n+'</b>, at '+((new Date()).toLocaleString()));
	},
	loadMenu: function(){

	}
};

$(function(){
	$('#login-form').on('before-success', function(e,r){
		if(r.valid){
			r.done = true;
			r.msg = 'Login Successful';
			posApp.toPage(window.location.href);
			posApp.afterAuth(r.name);
			$('#modal-login').modal('hide');
		}else{
			r.msg = 'Login Failed';
			$('#modal-login .modal-content').effect('shake');
		}
	});
	posApp.init();
});

	</script>
