	/**
	 * get all tranships
	 * @return bool|string
	 */
	public function getTranships()
	{
		if (empty($this->trans)) {
			return false;
		}
		$r = [];
		
		foreach ($this->trans as $t) {
			$r[] = (isset($t->carrier) ? $t->carrier->code : '') .': '.$t->connote;
		}
		
		return implode("\n", $r);
	}

	public function hasMovingTrans(){
		$sql = 'SELECT id FROM tranship WHERE pid = :id AND status IN (11, 19) LIMIT 1';
		return !empty(Yii::app()->db->createCommand($sql)->bindValues([':id' => $this->id])->queryScalar());
	}

	/**
	 * return RTS tracking number
	 * @return bool|string
	 */
	public function getRTSTranshipNo()
	{
		$rtsNo = '';
		foreach ($this->trans as $t) {
			if ($t->type == 90) {
				$rtsNo = $t->connote;
				break;
			}
		}
		return $rtsNo;
	}


