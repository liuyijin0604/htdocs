	/**
	 * Retrieves a list of models based on the current search/filter conditions.
	 *
	 * Typical usecase:
	 * - Initialize the model fields with values from filter form.
	 * - Execute this method to get CActiveDataProvider instance which will filter
	 * models according to data in model fields.
	 * - Pass data provider to CGridView, CListView or any similar widget.
	 *
	 * @return CActiveDataProvider the data provider that can return the models
	 * based on the search/filter conditions.
	 */
	public function search($pgn=true, $ps = 30, $ec = false, $defaultOrder=true,$isBackend = false)
	{
		// @todo Please modify the following code to remove attributes that should not be searched.

		$criteria=new CDbCriteria;
		if (!empty($this->agent_id)) {
			$criteria->compare('t.agent_id', $this->agent_id, false);
			if (!empty($this->hbn)) {
				$criteria->compare('t.agent_id', 0, false, 'OR');
				$criteria->compare('hbn', $this->hbn, true);
			}
		} else {
			$criteria->compare('hbn', $this->hbn, true);
		}
			   
		$criteria->compare('t.id', $this->id,true);
		$criteria->compare('t.owner_id', $this->owner_id);
		$criteria->compare('consol_id', $this->consol_id);
		$criteria->compare('cnor_id', $this->cnor_id);
		$criteria->compare('cnee_id', $this->cnee_id);
		$criteria->compare('receiver_id', $this->receiver_id);
		$criteria->compare('notify_id', $this->notify_id);
		$criteria->compare('man_id', $this->man_id);
		$criteria->compare('rec_id', $this->rec_id);
		$criteria->compare('odpt_id', $this->odpt_id);
		// $criteria->compare('t.ddpt_id', $this->ddpt_id);
		// $criteria->compare('t.ddpt_id', $this->getUserDptId());
		if(!empty($this->ddpt_id)&&$this->canUserCheckAll())
		{
			$with[] = 'consol';
			$criteria->addCondition("t.ddpt_id = {$this->ddpt_id} or consol.dpt_id = {$this->ddpt_id}");
		}else
		{
			if(!empty($this->getUserDptId())&&!$isBackend)
			{
				$criteria->addCondition("t.ddpt_id = {$this->getUserDptId()} or consol.dpt_id = {$this->getUserDptId()}");
			}
		}

		$criteria->compare('zr_id', $this->zr_id);
		$criteria->compare('ot_id', $this->ot_id);
		if (empty($this->status) && empty($this->hbn)&&empty($this->ref)) {
			$criteria->addCondition('t.status != 100');
		} else {
			$criteria->compare('t.status', $this->status);
		}
		//$criteria->compare('t.type',$this->type);
		$criteria->compare('ref', $this->ref, true);
		$criteria->compare('cref', $this->cref, true);
		$criteria->compare('t.styp', $this->styp);
		$criteria->compare('pkg', $this->pkg, true);
		$criteria->compare('t.state', $this->state, true);
		$criteria->compare('t.postcode', $this->postcode, true);
		$criteria->compare('value', $this->value, true);
		$criteria->compare('dvalue', $this->dvalue, true);
		$criteria->compare('tariff', $this->tariff, true);
		$criteria->compare('currency', $this->currency);
		$criteria->compare('weight', $this->weight, true);
		$criteria->compare('wtck', $this->wtck, true);
		$criteria->compare('cbm', $this->cbm, true);
		$criteria->compare('sac', $this->sac);
		$criteria->compare('exm', $this->exm, true);
		$criteria->compare('can', $this->can, true);
		$criteria->compare('scan_no', $this->scan_no);
		$criteria->compare('t.note', $this->note, true);
		$criteria->compare('t.created', $this->created, true);

		if (!empty($this->mhbns)) {
			$ns = preg_split('/[\s,;]+/', trim($this->mhbns));
			if (sizeof($ns) > 1000) {
				$ns = array_slice($ns, 0, 1000);
			}
			$sc1 = new CDbCriteria;
			$sc1->addInCondition("hbn", $ns);
			$sc1->addInCondition("ref", $ns, 'OR');
			$sc1->addInCondition("cref", $ns, 'OR');
			$criteria->mergeWith($sc1);
		}

		if (!empty($this->mids)) {
			$criteria->addCondition('t.id in ('.join(',',$this->mids).') ');
		}

		if (!empty($this->bwf)) {
			$criteria->addCondition('t.bwf & ' . $this->bwf . ' > 0');
		}
		if (!empty($this->not_bwf)) {
			$criteria->addCondition('t.bwf & ' . $this->not_bwf . ' = 0');
		}

		if (!empty($this->cbwf)) {
			$criteria->addCondition('t.cbwf & ' . $this->cbwf . ' > 0');
		}

		$with = [];
		if (!empty($this->agent_name)) {
			$with[] = 'agent';
			$criteria->addCondition('agent.name LIKE :agt_name OR t.agent_id = :agt_id');
			$criteria->params[':agt_name'] = '%'.$this->agent_name.'%';
			$criteria->params[':agt_id'] = $this->agent_name;
		}

		if (!empty($this->cnee_name)) {
			$with[] = 'cnee';
			$criteria->compare('cnee.name', $this->cnee_name, true);
		}

		if (!empty($this->cnee_tel)) {
			$with[] = 'cnee';
			$criteria->compare('cnee.tel', $this->cnee_tel, true);
		}

		if (!empty($this->cnee_addr)) {
			$with[] = 'cnee';
			$criteria->compare('cnee.address', $this->cnee_addr, true);
		}

		if (!empty($this->cnee_cnid)) {
			$with[] = 'cnee';
			$with[] = 'cnee.cnid';
			$criteria->compare('cnid.no', $this->cnee_cnid, true);
		}

		if (!empty($this->cnor_name)) {
			$with[] = 'cnor';
			$criteria->compare('cnor.name', $this->cnor_name, true);
		}

		if (!empty($this->cnor_tel)) {
			$with[] = 'cnor';
			$criteria->compare('cnor.tel', $this->cnor_tel, true);
		}

		if (!empty($this->consol_no)) {
			$with[] = 'consol';
			$criteria->compare('consol.no', $this->consol_no, true);
		}
		if (!empty($this->consol_eta)) {
			$with[] = 'consol';
			$criteria->compare('consol.eta', $this->consol_eta, true);
		}
		
		if (!empty($this->awb_name)) {
			$with[]='consol';
			$criteria->compare('consol.awb', $this->awb_name, true);
		}
		
		if (!empty($this->process_status)) {
			$with[] = 'process';
			$criteria->compare('process.status', $this->process_status);
		}
		
		if (!empty($this->process_statuses)) {
			$with[] = 'process';
			$criteria->addInCondition('process.status', $this->process_statuses);
		}
		
		if (!empty($this->process_not_status)) {
			$with[] = 'process';
			$criteria->addNotInCondition('process.status', $this->process_not_status);
		}
		
		if (!empty($this->process_doc_date)) {
			$with[] = 'process';
			$criteria->compare('process.date', $this->process_doc_date, true);
		}
		
		if (!empty($this->process_broker)) {
			$with[] = 'process';
			$criteria->compare('process.broker_id', $this->process_broker);
		}
		
		if (!empty($this->item_name)) {
			$criteria->compare('t.items', $this->item_name, true);
		}

		if (!empty($this->rts_scan_date)) {
			$with[] = 'rts_record';
			$criteria->addCondition('rts_record.record_time like "%'.$this->rts_scan_date.'%"');
		}

		if (!empty($_GET['sort'])&&($_GET['sort']=='rts_scan_date'||$_GET['sort']=='rts_scan_date.desc')) {
			$with[] = 'rts_record';
		}

		if ($ec) {
			$criteria->mergeWith($ec);
		}
		
		$sort = new CSort(get_called_class());
		$sort->attributes = [
			'cnor_name'=>[
				'asc'=>'cnor.name',
				'desc'=>'cnor.name DESC',
			],
			'cnee_name'=>[
				'asc'=>'cnee.name',
				'desc'=>'cnee.name DESC',
			],
			'cnee_addr'=>[
				'asc'=>'cnee.address',
				'desc'=>'cnee.address DESC',
			],
			'process_doc_date'=>[
				'asc'=>'process.date',
				'desc'=>'process.date DESC'
			],
			'awb_name'=>[
				'asc'=>'consol.awb',
				'desc'=>'consol.awb DESC',
			],
			'agent_name'=>[
				'asc'=>'agent.name',
				'desc'=>'agent.name DESC',
			],
			'consol_no'=>[
				'asc'=>'consol.no',
				'desc'=>'consol.no DESC',
			],
			'consol_eta'=>[
				'asc'=>'consol.eta',
				'desc'=>'consol.eta  DESC',
			],
			'meta'=>[
				'asc'=>'meta',
				'desc'=>'meta DESC',
			],
			'rts_scan_date'=>[
				'asc'=>'rts_record.record_time',
				'desc'=>'rts_record.record_time desc',
			],
						
			'*',
		];
		if ($defaultOrder) {
			$sort->defaultOrder = 't.bwf DESC, t.id DESC';
		} else {
			$sort->defaultOrder = 't.id DESC';
		}

		$sob = $sort->getOrderBy();
		$sobs = preg_split('/, */', $sob);
		foreach ($sobs as $ob) {
			if (!strpos($ob, '.')) {
				continue;
			}
			list($m, $f) = explode('.', $ob);
			if (str_replace('`', '', $m) == 't') {
				continue;
			}
			$with[] = $m;
		}

		if (!empty($with)) {
			$criteria->with = array_unique($with);
			$criteria->together = true;
		}

		// in case sub-gridview, we need consol_id set by parent grid view
		$pagerparams = $_GET;
		if ($this->consol_id  > 0) {
			$pagerparams['consoleId'] = $this->consol_id;
		}

		return new CActiveDataProvider($this, [
			'criteria'=>$criteria,
			'sort'=>$sort,
			'pagination'=> $pgn? [
				'pageSize' => $ps,
				'params' => $pagerparams,
			] : false,
		]);
	}

	public function getLocation($o=false)
	{
		$sl = StorageLog::findItem($this);
		if (empty($sl)) {
			return '';
		}
		return $o? $sl->storage : $sl->storage->name;
	}

	public function getClientEntry()
	{
		if (!empty($this->mdata["client_entry"])) {
			$cltent = $this->mdata['client_entry'];
			if (!empty($cltent["items"]["g"])) {
				$gs = [];
				foreach ($cltent["items"]["g"] as $gi => $g) {
					$gs[] = $cltent["items"]["q"][$gi]." * ".$g;
				}
				return implode(' ', $gs);
			}
		}
	}

	public function hasInsurance()
	{
		return !empty(InvLine::model()->find('ccode = "Shipment Insurance" AND fid = :fid', [':fid' => $this->id]));
	}
  	
  	public function updateAllFiles()
  	{
  		$files = FileRepo::model()->findAll(" fid = :fid and type = :type and status = :status",[":fid"=>$this->id,":type"=>FileRepo::IMPORTPODFILE, ":status"=>FileRepo::PENDING]);
  		foreach ($files as $key => $file) {
  			$file->status = FileRepo::ACTIVE;
  			$file->update(["status"]);
  		}
  	}

	/**
	 * @param $shipmentRef
	 * @return int
	 */
	public static function getCourierCostByShipment($shipmentRef, $org_rate_id, $chargeWeight = null,$isHunter = false,$noRemote = false,$isNoFuel = false,$month="",$cargoProcessId = null)
	{
		$orgRate = OrgRate::model()->findByPk($org_rate_id);
		$price = 0;
		$consolId = 0;
		$shipment = Shipment::model()->find('(ref = :ref OR hbn = :ref OR can = :ref) and status !=100', [':ref' => $shipmentRef]);
		if (!empty($shipment)) {
			if($orgRate->code==ImportChargeCode::FASTWAY_SYD_COST_CODE)
			{
				if(!empty($chargeWeight))
				{
					$chargeWeight = $shipment->getFastwayWeight($chargeWeight);
				}
			}


			$consolId = empty($shipment->consol_id)?0:$shipment->consol_id;
			if (empty($chargeWeight)) {
				$weight = $shipment->weight;
			} else {
				$weight = $chargeWeight;
			}
			/*************************************************For CBM courier******************************************/
			if($orgRate->type==OrgRate::CBM_COST_RATE)
			{
				$amount = self::calculateCourierCostByCBMPricing($shipment,$orgRate,$chargeWeight);
				return ['price' => $amount, 'consol_id' => 0];

			}
			/*******************************************For DFE***********************************************************/
			if(in_array($orgRate->org_id,[Org::ORGID_COURIER_DFE,Org::ORGID_COURIER_DFE_TOP]))
			{
				$o = DFEAPI::getCost($org_rate_id, $shipment->cnee->suburb, $shipment->cnee->postcode, $weight);
				if($o->msg=='success')
				{
					return ['price' => $o->data, 'consol_id' => $consolId];
				}
			}

			if(in_array($orgRate->org_id,[Org::ORGID_COURIER_EIZ_TOLL]))
			{
				$o = EizAPI::getCost($org_rate_id, $shipment->cnee->suburb, $shipment->cnee->postcode, $weight);
				if($o->msg=='success')
				{
					return ['price' => $o->data, 'consol_id' => $consolId];
				}
			}

			if(in_array($orgRate->org_id,[Org::ORGID_COURIER_UBI])&&!preg_match('/LOCAL/i', $orgRate->code))
			{
				$o = EtowerAPI::getCost($org_rate_id, $shipment->cnee->suburb, $shipment->cnee->postcode, $weight,false,$shipment);
				if($o->msg=='success')
				{
					return ['price' => $o->data, 'consol_id' => $consolId];
				}
			}

			if(in_array($orgRate->org_id,[Org::ORGID_COURIER_TOLL_IPEC]))
			{
				$o = MyTollAPI::getCost($org_rate_id, $shipment->cnee->suburb, $shipment->cnee->postcode, $weight,$noRemote,false,$shipment);
				if($o->msg=='success')
				{
					return ['price' => $o->data, 'consol_id' => $consolId];
				}
			}

			if(in_array($orgRate->org_id,[Org::ORGID_COURIER_BORDER]))
			{
				$o = BorderAPI::getCost($org_rate_id, $shipment->cnee->suburb, $shipment->cnee->postcode, $weight);
				if($o->msg=='success')
				{
					return ['price' => $o->data, 'consol_id' => $consolId];
				}
			}

			if(in_array($orgRate->org_id,[Org::ORGID_COURIER_FL_HUNTER]))
			{
				$o = FLHunterFTP::getCost($org_rate_id, $shipment->cnee->suburb, $shipment->cnee->postcode, $weight,$noRemote,$isNoFuel);
				if($o->msg=='success')
				{
					return ['price' => $o->data, 'consol_id' => $consolId];
				}
			}

			if(in_array($orgRate->org_id,[Org::ORGID_COURIER_ALLIED_TOP]))
			{
				$o = HvlvJavaAPI::getCost($org_rate_id, $shipment->cnee->suburb, $shipment->cnee->postcode, $weight,false,false,$isNoFuel);
				if($o->msg=='success')
				{
					return ['price' => $o->data, 'consol_id' => $consolId];
				}
			}

			/*************************************For general*****************************************************/
			$zoneMap = ZoneMap::model()->find(
				'org_id = :oid AND zone_id = :zoneid AND pc_lo <= :code AND pc_hi >= :code',
				[':oid' => $orgRate->org_id, ':zoneid' => $orgRate->zone_id, ':code' => $shipment->cnee->postcode]
			);

			$chargeCode = 'xxxxxxx';
			if (!empty($zoneMap) && !empty($zoneMap['z1'])) {
				$chargeCode = $zoneMap['z1'];
			}

			if($isHunter)//hunter use hunter_postcode_mapping
			{
				$chargeCode = HunterPortcode::model()->find('suburb = :suburb AND postcode = :postcode',
				[':suburb' => strtoupper(trim($shipment->cnee->suburb)), ':postcode' => $shipment->cnee->postcode]
				);
				if($chargeCode!=null)
				{
					$chargeCode = $chargeCode['zonecode'];
				}
			}

			if($orgRate->org_id==Org::ORGID_COURIER_AUPOST)
			{
				$weight = $weight/$shipment->pkg;
			}
			// base charge code to get zone rate
			$zrs = ZoneRate::model()->findAll(
				"zone = :s AND (weight_lo < :w AND weight_hi >= :w) AND rate_id = :rateid AND base+item+perkg > 0 ",
				[':s' => $chargeCode, ':w' => $weight, ':rateid' => $orgRate->id]
			);
			if($orgRate->code==ImportChargeCode::AUPOST_INTERNATIONAL_CODE)//for international
			{
				$country = $shipment->cnee->country;
				$zone = SystemSetting::getIntZone();
				if(!empty($zone[$country]))
				{
					$zrs = ZoneRate::model()->findAll('rate_id = :cid AND weight_lo <=:w AND weight_hi >= :w AND zone = :z AND base+item+perkg+minimum > 0', [':cid' => $orgRate->id, ':w' => $weight, ':z' => $zone[$country]]);
				}
			}

			if($shipment->checkIsCargoProcessWithRef())
			{
				$cost = CargoProcessService::getShipmentCargoProcessCost($shipment,$cargoProcessId);
				return  ['price' => $cost, 'consol_id' => $consolId];
			}

			if (!empty($zrs)) {
				foreach ($zrs as $zr) {
					$temp = $zr['base'] + ($zr['item'] * $shipment->pkg);
					if ($zr['nkg'] > 0) {
						$wl = $weight - ($zr['base'] > 0 ? $zr['nkg'] : 0);
						$temp += ceil($wl / $zr['nkg']) * $zr['perkg'];
					} else {
						$temp += $weight * $zr['perkg'];
					}
					if ($zr['minimum'] > 0 && $temp < $zr['minimum']) {
						$temp = $zr['minimum'];
					}
					$price = max($price, $temp);

					if(!$isNoFuel)
					{
						if(in_array($orgRate->org_id,[ORG::ORGID_COURIER_UBI,ORG::ORGID_COURIER_GV_AUPOST]))
						{
							$month = empty($month)?date("Y-m"):$month;
							$auspostFuelSetting = SystemSetting::getAupostFuelChargeSetting();
							if(!empty($auspostFuelSetting[$month]))
							{
								$price=$price+($price*(floatval($auspostFuelSetting[$month])/100));
							}

						}else
						{
							if(!empty($orgRate->mdata["fuel"]))
							{
								$price=$price+($price*$orgRate->mdata["fuel"]);
							}
						}
					}

				}
			}
		}
		if ($org_rate_id == ImportChargeCode::GLOBAVEND_POSTAGE_ID) {
			$price *= 1.021 * 1.03; 
		}
		return ['price' => $price, 'consol_id' => $consolId];
	}

	public static function calculateCourierCostByCBMPricing($shipment,$orgRate,$chargeWeight)
	{
		$amount=0;
		$cbm = $chargeWeight;
		//for the delivery calculate by weight
		$zoneMap = ZoneMap::model()->find('org_id = :oid AND zone_id = :zoneid AND pc_lo <= :code AND pc_hi >= :code',
				[':oid' => $orgRate->org_id, ':zoneid' => $orgRate->zone_id, ':code' => $shipment->cnee->postcode]);
		$chargeCode = 'N1';
		if (!empty($zoneMap) && !empty($zoneMap['z1'])) {
			$chargeCode = $zoneMap['z1'];
		}
		$zoneRates = ZoneRate::model()->findAll("zone = :s AND (weight_lo < :w AND weight_hi >= :w) AND rate_id = :rateid AND minimum+item+perkg > 0 ",
				[':s' => $chargeCode, ':w' =>ceil(floatval($cbm) * 10) / 10, ':rateid' => $orgRate->id]);
		if (empty($zoneRates)) {
			$zoneRates = ZoneRate::model()->findAll("zone = :s AND (weight_lo < :w AND weight_hi >= :w) AND rate_id = :rateid AND minimum+item+perkg > 0 ",
				[':s' => $chargeCode, ':w' =>ceil($cbm * 10) / 10, ':rateid' => $orgRate->id]);
		}
		if (empty($zoneRates)) {
			return 0;
		} else {
			foreach ($zoneRates as $zoneRate) {
				$result = 0;
				//if the cbm is lower than the minimum_cbm
				if (!empty($zoneRate['min_incl'])) {
					if ($cbm<=$zoneRate['min_incl']) {
						$base = max($zoneRate['base'], $zoneRate['minimum']);
						$result = max($base, $cbm*$zoneRate['perkg'])+$zoneRate['item'];
					} else {
						$base = max($zoneRate['base'], $zoneRate['minimum']);
						$leaseCBM = $cbm-floatval($zoneRate['min_incl']);
						// $ncbm = $zoneRate['nkg']>0?$zoneRate['nkg']:1;
						$result = $base+($leaseCBM*$zoneRate['perkg'])+$zoneRate['item'];
					}
				} else {
					$base = max($zoneRate['base'], $zoneRate['minimum']);
					$result = max($base, $cbm*$zoneRate['perkg'])+$zoneRate['item'];
				}

				$truckDeliveryInfo = $orgRate->mdata['truck_delivery'];
				$chargeCodeWidth = $truckDeliveryInfo['extra_width'];
				//if the dimension is longer than limitation
				if (@max(@$shipment->mdata['dim']['w'], @$shipment->mdata['dim']['h'], @$shipment->mdata['dim']['d'])>$chargeCodeWidth) {
					$result+=$cbm* $truckDeliveryInfo['extra_width_fee'];
				}

				// if the distance is longer than limitation
				if ($truckDeliveryInfo['extra_distance']>0) {
					$distance = GoogleMapAPI::getDistance($shipment);

					if ($distance>$truckDeliveryInfo['extra_distance']) {
						$countDistance = $distance - $truckDeliveryInfo['extra_distance'];
						$result+=ceil($countDistance / $truckDeliveryInfo['extra_distance_limit'])*$truckDeliveryInfo['extra_distance_fee'];
					}
				}

				if ($shipment->styp==Imparcel::EXPRESS_STYP) {
					if (@$truckDeliveryInfo['express']>1) {
						$result =$result*$truckDeliveryInfo['express'];
					}
				} elseif ($shipment->styp==Imparcel::EXTRA_EXPRESS_STYP) {
					if (@$truckDeliveryInfo['extra_express']>1) {
						$result =$result*$truckDeliveryInfo['extra_express'];
					}
				}

				if ($truckDeliveryInfo['fuel_surcharge']>0) {
					$fuel_surcharge = 1+$truckDeliveryInfo['fuel_surcharge'];
					$result=$result*$fuel_surcharge;
				}
				if ($result>$amount) {
					//$amount = $result;
					$selectedRate = $zoneRate;
				}
				$amount =max($amount, $result);
			}
		}
		return $amount;

	}

	public function isTLA()
	{
		if($this->type==10 && !empty($this->consol_id)&& !empty($this->consol)&& (strtotime($this->consol->eta)>=strtotime('2020-08-01')||strtotime($this->consol->created)>=strtotime('2020-08-01')))
		{
			return $this->consol->isTLA() ? true : false;
		}else if (preg_match('/^T/', $this->hbn)&&strtotime($this->created)>=strtotime('2020-08-01'))
		{
			return true;
		}
		return false;
	}

	public function getFastwayWeight($chargeWeight)
	{
		$fw = new FastwayAPI(true, false, 'syd');
		$weight = $fw->roundWeight($chargeWeight,$this->cnee->state);
		if(preg_match('/^2X/i', $this->ref)&&$weight<=0.3)
		{
			return 0.51;
		}
	}

	public function getCubeWeight()
	{
		// because cbm is for each item only , but weight is for total
		// so we should get total cbm by multiplied with pkg
		$totalCbm = $this->cbm * ($this->pkg > 0 ? $this->pkg : 1);
		$cubWeight = $totalCbm * 250;
		return round(max($this->weight, $cubWeight),2);
	}

	public function getSingleCubeWeight()
	{
		// because cbm is for each item only , but weight is for total
		// so we should get total cbm by multiplied with pkg
		$cbm = $this->cbm;
		$cubWeight = $cbm * 250;
		return round(max($this->weight/$this->pkg, $cubWeight),2);
	}

	public function isTopCourierServiceDelivery($isCal = false)
	{
		if(!empty($this->cargo_process)&&$this->cargo_process->status!=CargoProcess::DELETED)
		{
			if($isCal)
			{
				if (!empty($this->trans))
				{
					foreach ($this->trans as $ts) {
						if ($ts->connote != $this->ref) {
							return false;
						}
						
						if (!empty($ts->mdata['oid'])) {
							return false;
						}
					}
				}
			}
			return true;
		}else
		{
			return false;
		}
	}

	public function getRegion()
	{
		$dptId = $this->ddpt_id;
		if(empty($this->ddpt_id))
		{
			if(!empty($this->consol_id))
			{
				$dptId = $this->consol->dpt_id;
			}
		}

		if(empty($dptId))
		{
			return "";
		}

		if(!empty($this->mdata['region']))
		{
			return $this->mdata['region'];
		}else
		{
			$orgRate = OrgRate::model()->find("code = :code and json_value(meta,'$.ddpt_id') = :dptId",[":code"=>ImportChargeCode::AUSTWAY_TRUCK_ZONE_CODE,":dptId"=>$dptId]);
			if(!empty($orgRate))
			{
		        $zoneMaps = ZoneMap::model()->findAll("org_id = :orgId and zone_id = :zoneId  and pc_hi>=:postcode and pc_lo<=:postcode",[":orgId"=>$orgRate->org_id,":zoneId"=>$orgRate->zone_id,":postcode"=>$this->cnee->postcode]);
		        foreach ($zoneMaps as $key => $z) {
		        	$this->mdata['region'] = $z->z1;
		        	$pre = $this->nolog;
		        	$this->nolog = true;
		        	$this->updateMeta();
		        	$this->nolog = $pre;
		        	return $z->z1;
		        }
	    	}
			return "";
		}
	}

	public function getTLDRegion()
	{
		$region = $this->getRegion();
		$dptId = $this->ddpt_id;
		if(empty($this->ddpt_id))
		{
			if(!empty($this->consol_id))
			{
				$dptId = $this->consol->dpt_id;
			}
		}
		
		if (!empty($region) && !empty($dptId) && $dptId == 106) { // Only print region information for Sydney depot
			if ($this->pkg > 5) {
				return "";
			}
			$packages = empty($this->packages)?[]:json_decode($this->packages);
			$weightValidate = true;
			foreach ($packages as $package) {
				if ($package->weight > 30) {
					$weightValidate = false;
					break;
				}
			}
			if ($weightValidate) {
				if (preg_match('/northeast/i', $region)) {
					return preg_replace('/northeast/i', 'NE', $region);
				} else if (preg_match('/northwest/i', $region)) {
					return preg_replace('/northwest/i', 'NW', $region);
				} else if (preg_match('/southeast/i', $region)) {
					return preg_replace('/southeast/i', 'SE', $region);
				} /*else if (preg_match('/southwest/i', $region)) {
					return preg_replace('/southwest/i', 'SW', $region); 
				}*/ else if (preg_match('/NORTH EAST/i', $region)) {
					return preg_replace('/NORTH EAST/i', 'NE', $region);
				} else if (preg_match('/NORTH WEST/i', $region)) {
					return preg_replace('/NORTH WEST/i', 'NW', $region);
				} else if (preg_match('/SOUTH EAST/i', $region)) {
					return preg_replace('/SOUTH EAST/i', 'SE', $region);
				}/* else if (preg_match('/SOUTH WEST/i', $region)) {
					return preg_replace('/SOUTH WEST/i', 'SW', $region);
				} else if (preg_match('/OUTER EAST/i', $region)) {
					return preg_replace('/OUTER EAST/i', 'OE', $region);
				} else if (preg_match('/OUTER WEST/i', $region)) {
					return preg_replace('/OUTER WEST/i', 'OW', $region);
				} else if (preg_match('/east/i', $region)) {
					return preg_replace('/east/i', 'E', $region);
				} else if (preg_match('/south/i', $region)) {
					return preg_replace('/south/i', 'S', $region);
				} else if (preg_match('/west/i', $region)) {
					return preg_replace('/west/i', 'W', $region);
				}*/ else if (preg_match('/north/i', $region)) {
					return preg_replace('/north/i', 'N', $region);
				} else {
					return '';
				}
			} else {
				return '';
			}
		} else {
			return "";
		}
	}

	public function getCargoProcessJobNo()
	{
		if(!empty($this->cargo_process))
		{
			if(!empty($this->cargo_process->job_relation))
			{
				if(!empty($this->cargo_process->job_relation->job))
				{
					return $this->cargo_process->job_relation->job->job_no;
				}
			}
		}
		return "";
	}

	public function getCargoProcessJobPalletNo()
	{
		if(!empty($this->cargo_process))
		{
			return empty($this->cargo_process->mdata['job_pallet_no'])?"":$this->cargo_process->mdata['job_pallet_no'];
		}
		return "";
	}

	public function checkIsCargoProcessWithRef()
	{
		if ((preg_match("/SKP|MKP|BKP|PKP|PICKUP/i", $this->ref))||!empty($this->mdata['cargo_delivery'])||!empty($this->mdata['cargo_pickup']))
		{
			return true;
		}
		return false;
	}

	public function checkIsKPWithRef()
	{
		if ((preg_match("/SKP|MKP|BKP|PKP/i", $this->ref))||!empty($this->mdata['cargo_delivery']))
		{
			return true;
		}
		return false;
	}

	public function getDpmt()
	{
		if($this->isTopCourierServiceDelivery(true))
		{
			return Invoice::DPMT_COURIER_SERVICE;
		}else if($this->is3PL())
		{
			return Invoice::DPMT_3PL;
		}
		return Invoice::DPMT_IMPORT;
	}

	public function getPalletData()
	{
		if(!empty($this->palletData))
		{
			return $this->palletData;
		}
		if(!empty($this->mdata['amzon_pallet']))
		{
			$weight = max($this->weight/$this->mdata['amzon_pallet'],($this->getTotalCBM()*330)/$this->mdata['amzon_pallet']);
			$this->palletData = [$this->mdata['amzon_pallet'],$this->getTotalCBM()/$this->mdata['amzon_pallet'],$weight];
			return $this->palletData;
		}
		$this->palletData = [0,0,0];
		return $this->palletData;
	}

	public function canBeDelete()
	{
		if(!empty($this->consol)&&$this->consol->isWDT())
		{
			$re = ImportsShipmentRelations::model()->find("cid = :cid",[":cid"=>$this->id]);
			if(!empty($re))
			{
				return $re->original->canBeUpdate();
			}
		}
		return $this->canBeUpdate();
	}

	public function canBeUpdate()
	{
		if($this->status <= ImParcel::NEW_STATUS||$this->status==ImParcel::STATE_CANCELLED)
		{
			return true;
		}
		
		if($this->status == ImParcel::STATE_LOCAL_ARRIVAL&&!(!empty($this->consol)&&$this->consol->isWDT()))
		{
			return true;
		}


		return false;
	}

	public function isWms()
	{
		if(preg_match('/^T\d{6,7}$/', $this->cref)&&!empty($this->mdata['wmstask_id']))
		{
			return true;
		}else
		{
			return false;
		}
	}

