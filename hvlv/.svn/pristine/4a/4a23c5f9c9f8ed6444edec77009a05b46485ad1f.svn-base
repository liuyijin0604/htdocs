	/**
	 * get RTS shipment reshipping invoice html link content
	 */
	public function getRtsReshippingInvoiceLink()
	{
		// check to see if related pending invoice existing
		$invLines = InvLine::model()->findAll('model = :model AND fid = :fid', [':model' => 'ImParcel','fid' => $this->getRTSTranshipNoId()]);
		$invoice = null;
		if (!empty($invLines)) {
			// try to check related invoice belongs to RTS fee or not
			foreach ($invLines as $invLine) {
				$invoiceRts = Invoice::model()->findByPk($invLine->inv_id);
				if (!empty($invoiceRts) && $invoiceRts->type == Invoice::INVOICE_TYPE_RTS_RESEND_FEE) {
					$invoice = $invoiceRts;
					break;
				}
			}
		}
		if (!empty($invoice)) {
			$linkContent = "<a href=\"".Yii::app()->createURL("invoice/update", ["id" => $invoice->id])."\" class=\"tab_link\" title=\"".$invoice->no."\">".$invoice->no."</a>";
			return $linkContent;
		}
		return '';
	}


	/**
	 * get RTS invoice No.
	 * @return string
	 */
	public function getRtsInvoiceNo()
	{
		// check to see if related pending invoice existing
		$invLines = InvLine::model()->findAll('model = :model AND fid = :fid', [':model' => 'ImParcel','fid' => $this->id]);
		$invoice = null;
		if (!empty($invLines)) {
			// try to check related invoice belongs to RTS fee or not
			foreach ($invLines as $invLine) {
				$invoiceRts = Invoice::model()->findByPk($invLine->inv_id);
				if (!empty($invoiceRts) && $invoiceRts->type == Invoice::INVOICE_TYPE_RTS_RESEND_FEE) {
					$invoice = $invoiceRts;
					break;
				}
			}
		}
		if (!empty($invoice)) {
			return $invoice->no;
		}
		return '';
	}

	/**
	 * courier cost saved in tranship with cost field
	 * @return int
	 */
	public function getCourierCost()
	{
		$cost = 0;
		foreach ($this->trans as $t) {
			if ($t->type == 80) { // delivery courier
				$cost += $t->cost;
			}
		}
		return round($cost, 2);
	}

	public function getFirstTrack()
	{
		return Tracking::model()->find(['condition' => 'pid = :id', 'params' => [':id' => $this->id], 'order' => 't.id ASC']);
	}

	public function getLastTrack()
	{
		return Tracking::model()->find(['condition' => 'pid = :id', 'params' => [':id' => $this->id], 'order' => 't.id DESC']);
	}

	public function getFirstLog()
	{
		return empty($this->logs)? false : $this->logs[0];
	}

	public function getLastLog()
	{
		return empty($this->logs)? false : $this->logs[sizeof($this->logs) - 1];
	}

	public function log($action)
	{
		$extra =["action"=>$action];
		Log::add($this, $this->isNewRecord? 3 : 4, array_merge(['status' => $this->getStatus()], $extra));
	}

	public function cleanItems()
	{
		if (empty($this->eitems['q'])) {
			return;
		}
		$cis = [];

		if (!empty($this->eitems['w'])) {
			foreach ($this->eitems['w'] as $i => $w) {
				$this->eitems['w'][$i] = sprintf('%0.2f', $w);
			}
		}

		foreach ($this->eitems['q'] as $i => $q) {
			if (empty($q)) {
				$cis[] = $i;
			}
		}
		rsort($cis);
		foreach ($cis as $i) {
			foreach ($this->eitems as $k => $a) {
				unset($this->eitems[$k][$i]);
			}
		}

		//reset keys
		foreach ($this->eitems as $k => $a) {
			if (is_array($a)) {
				$this->eitems[$k] = array_values($a);
			}
		}
	}

	public function beforeValidate()
	{
		if (!parent::beforeValidate()) {
			return false;
		}
		if ($this->cnee_id > 0) {
			if (empty($this->state)) {
				$this->state = $this->cnee->state;
			}
			if (empty($this->postcode)) {
				$this->postcode = $this->cnee->postcode;
			}
		}
		return true;
	}
	
	public function beforeSave()
	{
		if (!empty($this->mdata)) {
			$this->meta = json_encode($this->mdata);
		}
		if (!empty($this->packs)) {
			$this->packages= json_encode($this->packs);
		}
		if (!empty($this->scan_data)) {
			$this->scan = json_encode($this->scan_data);
		}
		if (!empty($this->eitems)) {
			$this->items = json_encode($this->eitems);
		}
		if (empty($this->created)) {
			$this->created = date('Y-m-d');
		}
		if (empty($this->status)) {
			$this->status = 10;
		}
		if (empty($this->hbn)) {
			$this->hbn = $this->genHbn();
		}
		$this->hbn = strtoupper(trim($this->hbn));
		return true;
	}

	public function genHbn()
	{
		$pfx = 'ECN';
		if(time() >= strtotime('2020-08-01')) $pfx = 'TCN'; 
		if(time() >= strtotime('2020-12-30'))
		{
			$pfx = 'TC';
			if(!empty(Consol::$consolPrefix[$this->ddpt_id]))
			{
				$pfx = Consol::$consolPrefix[$this->ddpt_id];
			}
			$pfx = $pfx.'N';
		}

		return ($this->agent_id > 0)? $pfx . sprintf('%03s', $this->agent_id) . sprintf('%06s', $this->agent->getLabelNumber()) : '';
	}

	public function gen3PLHbn()
	{
		$pfx = 'SKP'; 
		if(time() >= strtotime('2020-12-30'))
		{
			
			if(($this->ddpt_id)==106)
			{
				$pfx = 'SKP'; 
			}
			else if(($this->ddpt_id)==218)
			{
				$pfx = 'MKP'; 
			}
			else if(($this->ddpt_id)==530)
			{
				$pfx = 'BKP'; 
			}
		}
		return ($this->agent_id > 0)? $pfx . sprintf('%02s', "88") .sprintf('%04s', $this->agent_id). sprintf('%04s', $this->agent->getLabelNumber()) : '';
		//return ($this->agent_id > 0)? $pfx . sprintf('%03s', "8888") . sprintf('%06s', $this->agent->getLabelNumber()) : '';
	}

	public function genBPHbn()
	{
		$pfx = 'SKP'; 
		if(time() >= strtotime('2020-12-30'))
		{
			
			if(($this->ddpt_id)==106)
			{
				$pfx = 'SKP'; 
			}
			else if(($this->ddpt_id)==218)
			{
				$pfx = 'MKP'; 
			}
			else if(($this->ddpt_id)==530)
			{
				$pfx = 'BKP'; 
			}
		}
		return ($this->agent_id > 0)? $pfx . sprintf('%02s', "PR") .sprintf('%04s', $this->agent_id). sprintf('%04s', $this->agent->getLabelNumber()) : '';
	}
	
	public function afterSave()
	{
		if ((!$this->nolog && !empty($this))||$this->status==100) {
			$extra = empty($this->custom_log_note)? [] : ['note' => $this->custom_log_note];
			Log::add($this, $this->isNewRecord? 3 : 4, array_merge(['status' => $this->getStatus()], $extra),$this->fixUserId,$this->fixTime);
		}
			
	}
	
	public function afterFind()
	{
		if (!empty($this->packages)) {
			$this->packs= json_decode($this->packages, true);
		}
		if (!empty($this->scan)) {
			$this->scan_data = json_decode($this->scan, true);
			$cachedData = Service::getJavaCacheData('scan:'.$this->id);
			foreach ($cachedData as $k => $d) {
				$this->scan_data[50][$k] = $d["time"];
			}
		}
		if (!empty($this->items)) {
			$this->eitems = json_decode($this->items, true);
		}

		if ($this->isTLA() && Yii::app() instanceof CWebApplication) [$app_name, Yii::app()->name] = [Yii::app()->name, 'TLA'];

		// sometime we got mdata['dim'] as stdClass Object still don't know why it occured
		// so we just force convert to array once object found for mdata['dim'] member
		/*if ( isset($this->mdata['dim']) && !is_array($this->mdata['dim']) && get_class($this->mdata['dim']) === 'stdClass' ) {
			$this->mdata['dim'] = json_decode(strtolower(json_encode($this->mdata['dim'])), true);
			$this->updateMeta();
		}*/
		return parent::afterFind();
	}

	public function updateMeta($nolog=true)
	{
		$this->nolog = $nolog;
		$this->meta = json_encode($this->mdata);
		$this->update(['meta']);
	}

	public function updateMetaAndScan($nolog=true)
	{
		$this->nolog = $nolog;
		$this->meta = json_encode($this->mdata);
		if (!empty($this->scan_data)) {
			$this->scan = json_encode($this->scan_data);
		}
		$this->update(['meta','scan']);
	}

	public function getScanTime()
	{
		return empty($this->mdata['scan_time'])? '' : $this->mdata['scan_time'];
	}

	public function isScanTimeToday()
	{
		if(!empty($this->mdata['scan_time'])){
			if($this->mdata['scan_time']<date('Y-m-d')){
				return true;
			}
		}
		return false;
	}
	
	public function getCarrier()
	{
		return empty($this->zrate)? '' : $this->zrate->orgrate->org->name;
	}
	
	public function getCarrierCode()
	{
		return empty($this->zrate)? '' : $this->zrate->orgrate->org->code;
	}

	public function getGoods()
	{
		if (empty($this->eitems['g'])) {
			return '';
		}
		return implode('/', empty($this->eitems['g'])? [] : $this->eitems['g']);
	}

	public function getGoodsDescription()
	{
		$str = [];
		foreach ($this->eitems['g'] as $key => $value) {
			$str[]=$this->eitems['g'][$key].":".$this->eitems['q'][$key];
		}
		
		return join("|",$str);
	}

	public function itemsTotQty()
	{
		$t = 0;
		if (empty($this->eitems['q'])) {
			return $t;
		}
		foreach ($this->eitems['q'] as $q) {
			$t += $q;
		}
		return $t;
	}
	
	public function getWarnings($s=true, $d=false)
	{
		return AppHelper::bwf2warning($this, $s, $d);
	}
	
	public function scanBarcode($attr)
	{
		$b = $attr[0]; // barcode
		$d = $attr[1]; // depart id same with warehouse id
		$t = $attr[2]; // parcel status
		
		if (strpos($b, '-') > 0) {
			list($hbn, $sn) = explode('-', $b);
		} else {
			$hbn = $b;
			$sn = 0;
		}
		
		$p = self::model()->find('hbn = :h', [':h' => $hbn]);
		if (empty($p) || (empty($sn) && $p->pkg > 1)) {
			$o = ['id' => 0, 'bc' => $b];
		} else {
			$o = $p->attributes;
			$o['bc'] = $b;
			foreach ($p->cnee->attributes as $k=>$v) {
				$o['cnee_'.$k] = $v;
			}
			foreach ($p->cnor->attributes as $k=>$v) {
				$o['cnor_'.$k] = $v;
			}
			if (empty($p->scan_data[$t][$sn])) {
				if (!isset($p->scan_data[$t])) {
					$p->scan_data[$t] = [];
				}
				$p->scan_data[$t][$sn] = time();
				$sc = sizeof($p->scan_data[$t]);
				$p->odpt_id = $d;
				if ($sc == $p->pkg) {
					$p->status = $t;
				}
				$p->save();
				$o['dup'] = 0;
			} else {
				$sc = sizeof($p->scan_data[$t]);
				$o['dup'] = 1;
			}
			$o['sc'] = $sc;
		}
		return $o;
	}
	
	//rAPI
	public function rSave($attrs)
	{
		if (empty($attrs->id)) {//new
			$cnor = new Addr;
			$cnee = new Addr;
			$par = new static();
		} else {//update
			$par = self::model()->findByPk($attrs->id);
			$cnor = $par->cnor;
			$cnee = $par->cnee;
		}
		
		foreach ($attrs as $k=>$v) {
			if (preg_match('/^cnee_/', $k)) {
				$cnee->{substr($k, 5)} = $v;
			} elseif (preg_match('/^cnor_/', $k)) {
				$cnor->{substr($k, 5)} = $v;
			} else {
				if ($par->hasAttribute($k)) {
					$par->{$k} = $v;
				} elseif (in_array($k, ['custom_log_note', 'nolog'])) {
					$par->{$k} = $v;
				}
			}
		}
		
		if (!empty($attrs->eitems)) {
			$par->eitems = (array) $attrs->eitems;
		}
		
		$cnor->save();
		$cnee->save();
		$par->cnor_id = $cnor->id;
		$par->cnee_id = $cnee->id;
		$par->state = $cnee->state;
		$par->postcode = $cnee->postcode;
		$par->save();
		//Yii::log(var_export($par->getErrors(), true), 'error');
		return $par;
	}
	
	public function rFind($q, $p)
	{
		$r = self::model()->find($q, $p);
		if ($r) {
			$o = $r->attributes;
			foreach ($r->cnee->attributes as $k=>$v) {
				$o['cnee_'.$k] = $v;
			}
			foreach ($r->cnor->attributes as $k=>$v) {
				$o['cnor_'.$k] = $v;
			}
			$o['meta'] = $r->meta;
			
			return $o;
		}
		return false;
	}
	
	public function rSearch($criteria)
	{
		$rs = self::model()->findAll($criteria);
		$ra = [];
		$i = 0;
		foreach ($rs as $r) {
			$o = $r->attributes;
			$o['client'] = empty($r->owner)? '' : $r->owner->user;
			$ra[] = $o;
		}
		return $ra;
	}
	
