	public function getOdpt()
	{
		if (empty($this->odpt_id)) {
			return '';
		}
		$n = preg_replace('/Warehouse/i', '', $this->odepot->name);
		return trim($n);
	}

	public function validItems()
	{
		$this->cleanItems();
		if (empty($this->eitems['q'])) {
			$this->addError('items', Yii::t(strtolower(__CLASS__), 'Pelase enter at least one item'));
			return false;
		}
		$valid = true;

		foreach ($this->eitems['q'] as $i => $q) {
			if (!is_numeric($q)) {
				$this->addError('items', Yii::t(strtolower(__CLASS__), 'Item {item}: quantity has non numeric value', ['{item}' => $this->eitems['g'][$i]]));
				$valid = false;
			}
			$v = $this->eitems['v'][$i];
			if (!empty($v) && !is_numeric($v)) {
				$this->addError('items', Yii::t(strtolower(__CLASS__), 'Item {item}: value has non numeric value', ['{item}' => $this->eitems['g'][$i]]));
				$valid = false;
			}
		}
		
		return $valid;
	}

	public function importMultiItems($gs, $qs, $vs, $hs='')
	{
		if (preg_match('/[;,\/]+/', $gs) > 0 || (!empty($qs) && strpos('/[;,\/]+/', $qs) > 0) ||  (!empty($vs) && strpos('/[;,\/]+/', $vs) > 0)) {//read multiple item
			$gd = preg_split('/[;,\/]+/', $gs);
			$it = preg_split('/[;,\/]+/', $qs);
			$uv = preg_split('/[;,\/]+/', $vs);
			$hsa = preg_split('/[;,\/]+/', $hs);
			$valid = true;

			if (sizeof($gd) != sizeof($it) || sizeof($gd) != sizeof($uv) || sizeof($it) != sizeof($uv)) {
				$this->addError('items', 'Items description, quantity, value have different counts.');
				$valid = false;
			}

			if (!empty($hs)) {
				if (sizeof($hsa) != sizeof($it)) {
					$this->addError('items', 'Items HS code have different counts.');
					$valid = false;
				}
			}

			if (!$valid) {
				return $this->getErrors();
			}

			$this->eitems = [
				'g' => [],
				'q' => [],
				'hs' => [],
				'v' => [],
			];
			
			foreach ($gd as $g) {
				$this->eitems['g'][] = $g;
			}

			foreach ($it as $i=>$t) {
				if (!is_numeric($t)) {
					$this->addError('items', 'Items quantity has non numeric value.');
					continue;
				}
				$this->eitems['q'][] = $t;
				$this->eitems['hs'][] = empty($hsa[$i])? $hs : $hsa[$i];
			}

			$tv = 0;
			foreach ($uv as $t) {
				if (!is_numeric($t)) {
					$this->addError('items', 'Items value has non numeric value.');
					continue;
				}
				$this->eitems['v'][] = $t;
				$tv += $t;
			}
			$this->value = number_format((float)$tv, 2, '.', '') ;
		} else {//single item
			$this->eitems = [
				'g' => [$gs],
				'q' => [$qs],
				'hs' => [$hs],
				'v' => [$vs],
			];
		}
		
		return $this->getErrors();
	}

	/**
	 * check to see if the value of parcel can be SAC
	 *  only value < 750USD can SAC
	 *  or 1000 AUD can be SAC (Self Assessed Clearance) only
	 * @param $p
	 * @return bool
	 */
	public function canSAC($after=false)
	{

		// in case we should ignore SAC setting , will always return false
		if (($this->bwf&ImParcel::BWF_NON_SAC)>0) {
			return false;
		}

		if (isset($this->mdata['ignore_sac']) && $this->mdata['ignore_sac']) {
			return false;
		}
		
		$sac_aud_value = 1000;
		//2.from chargcode setting to determine if sac >400 instead of 1000;
		if (!$after) {
			if (isset($this->mdata['chargecode'])) {
				$chargecode= $this->mdata['chargecode'];
				$chargeCodeInfo = ImportChargeCode::model()->find('chargecode = :ccode', [':ccode' => $chargecode]);
				if (!empty($chargeCodeInfo)&&$chargeCodeInfo->status==1) {
					if (($this->bwf&ImParcel::BWF_SAC)>0) {
						$this->sac = 1;
						$sac_aud_value=1000;
					}else if (isset($chargeCodeInfo->ignore_sac)&&$chargeCodeInfo->ignore_sac==1) {
						$sac_aud_value=500;
					}
				}
			}
		}
		//3. according value
		if ($this->currency == 1) { // AUD no more than 1000
			$canSac = ($this->sac && $this->dvalue <= $sac_aud_value) ? true : false;
		} else {
			$exchage_rate = 0.750 ; // default one
			$exchage_rate= Currency::getExrate(empty($this->consol->etd)? '' : $this->consol->etd, $this->currency)[0];
			if (isset($this->mdata['exchange_rate']) && $this->mdata['exchange_rate'] > 0.0) {
				$exchage_rate = floatval($this->mdata['exchange_rate']);
			}
			$sacValue = $sac_aud_value * $exchage_rate;
			$canSac = ($this->sac && $this->dvalue <= $sacValue) ? true : false;
		}
		return $canSac;
	}

	public function getStatus()
	{
		return isset(static::$states[$this->status])? Yii::t(strtolower(__CLASS__), static::$states[$this->status]) : $this->status;
	}

	/*
	 * get the value based on AUS
	 * Dollar
	 */
	public function getValue()
	{
		return $this->currency == 1? $this->dvalue : round($this->dvalue/Currency::getExrate('', $this->currency)[0], 2);
	}

	public function getDesc()
	{
		return empty($this->cref)? $this->cnee->nameInit().', '.$this->state.' '.$this->postcode : $this->cref;
	}

	public function getAwb()
	{
		if (empty($this->consol_id)) {
			return false;
		}
		if (empty($this->consol->awb)) {
			if (empty($this->consol->mdata['subc'])) {
				return false;
			}
			$sql = "SELECT m.id FROM manifest m INNER JOIN mani_map mm ON mm.mani_id = m.id WHERE m.type = 60 AND m.consol_id = ".$this->consol_id." AND mm.fid = ".$this->id;
			$mid = Yii::app()->db->createCommand($sql)->queryScalar();
			foreach ($this->consol->mdata['subc'] as $sc) {
				$pids = explode(',', $sc['pids']);
				if (in_array($mid, $pids)) {
					return $sc['awb'];
				}
			}
		} else {
			return $this->consol->awb;
		}
	}
	public function isManifest()
	{
		if(!empty($this->trans))
		{
			$trans = $this->trans;
			$tran = end($trans);
			if(!empty($tran->mdata['oid']))
			{
				return true;
			}
		}
		return false;
	}

	public function getCopyShipment()
	{
		if(!empty($this->mdata['copy_shipment_id']))
		{
			$cship = TplParcel::model()->findByPk($this->mdata['copy_shipment_id']);
			return $cship;
		}
		return null;

	}

	public function trackingInfo($ttt = 0, $live_update = true,$front = true,$api = false)
	{
		$copyShipment = $this->getCopyShipment();
		if(!empty($copyShipment))
		{
			return $copyShipment->trackingInfo($ttt ,$live_update,$front,$api);
		}

		// if (empty($ttt) && (in_array($this->agent_id, [800, 861]) || $this->agent->by == 861)) {
		// 	return false;
		// }
		// if (!empty($ttt) && $ttt != $this->agent_id) {
		// 	return false;
		// }

		if (empty($this->tracks)) {
			return false;
		}
		
		if($live_update && strtotime($this->created) > time() - 8640000){
			if ($this->type == 20 && in_array($this->status, [80, 90])) {
				include_once(Yii::app()->basePath.DIRECTORY_SEPARATOR.'commands'.DIRECTORY_SEPARATOR.'trackingCommand.php');
				$tc = new trackingCommand('tracking', 'run');
				$tc->run(['update', $this->hbn]);
				$this->refresh();
			//@exec(Yii::app()->basePath.DIRECTORY_SEPARATOR.'yiic tracking update '.$this->hbn);
			} elseif ($this->type==10 && $this->status>=60 && $this->isManifest()) {
				if (!preg_match("/(7RFZ|4XHZ)\d{8}/i", $this->ref)&&!preg_match("/(24683|24751)\d{8}/i", $this->ref)) {
					include_once(Yii::app()->basePath.DIRECTORY_SEPARATOR.'commands'.DIRECTORY_SEPARATOR.'trackingCommand.php');
					$tc = new trackingCommand('tracking', 'run');
					$tc->run(['update', $this->hbn]);
					//@exec(Yii::app()->basePath.DIRECTORY_SEPARATOR.'yiic tracking update '.$this->hbn);
					$this->refresh();
				}
			}
		}

		foreach ($this->tracks as $t) {
			if (empty($t['depot'])) {
				continue;
			}
			$t1 = $t;
			break;
		}

		$odpt = "";
		$consol =$this->consol;
		if(!empty($consol))
		{
			$polInfo = SystemSetting::getPodSetting(substr($this->consol->pol,0,2),$this->consol->pol);
			$odpt = !empty($polInfo)?$polInfo[0]:"";
		}else
		{
			$odpt = "";
		}

		$o = new stdClass;
		$o->odpt = $odpt;
		$amap = [];
		switch ($this->type) {
			case 10:  // import parcel
			case 30:  // co parcel
				$df = 'd/m/Y';
				$dtf = 'd/m/Y H:i:s';
				$ddpts = [
					'NSW' => 'Sydney',
					'VIC' => 'Melbourne',
					'QLD' => 'Brisbane',
				];
				$o->ddpt = empty($ddpts[$this->state])? 'AU' : $ddpts[$this->state];
				if (empty($t1)) {
					$o->eta = date('d/m/Y', strtotime('+4 day'));
				} else {
					$o->eta = date('d/m/Y', strtotime($t1['dt'] . ' +4 day'));
				}
				$o->cs_link = 'https://ims.toplogistics.com.au/customerService/cneeShipmentQuery.app?ref='.$this->ref;
				$amap = ['Customs Held' => '<b style="color:#BE3426">Customs Held</b>'];
				$status = ImParcel::$states[$this->status];
			break;
			case 20: // export parcel
				$df = 'Y-m-d';
				$dtf = 'Y-m-d H:i:s';
				$o->ddpt = '中国'.(empty($this->state)?  '' : $this->state);
				$o->eta = ''; //date($df, strtotime($t1['dt'].' +10 day'));
				$status = ExParcel::$states[$this->status];
				$o->ot = OriginTrace::model()->count('pid = :pid AND bdate IS NOT NULL', [':pid' => $this->id]) > 0;
				$o->cnid = !empty($this->cnee->cnid_id);
				$o->consol = empty($this->consol_id)? '' : $this->consol->no;
				$o->cnee = $this->cnee->name;
			break;
			case 50: // export direct parcel
				$df = 'Y-m-d';
				$dtf = 'Y-m-d H:i:s';
				$o->ddpt = '中国'.(empty($this->state)?  '' : $this->state);
				$o->eta = date($df, strtotime($t1['dt'].' +2 day'));
				$status = ExDirect::$states[$this->status];
			break;
		}
		$o->odate = empty($t1)? '' : date($df, strtotime($t1['dt']));
		$o->ttk = empty($this->trans)? '' : $this->trans[sizeof($this->trans) - 1]->infoLink(true);
		$o->status = $status;
		$o->manifest_status = $this->getManifestStatus();
		$o->ref = $this->ref;
		$o->tracks = [];

		$clearanceKey = "";
		$lastStatus = "";

		foreach ($this->tracks as $key => $t) {//because the custom may release cargo and held cargo multiple times, so find the last state
			if($t->type==Tracking::CLEARED_TYPE)
			{
				$clearanceKey = $key;
			}
		}
		foreach ($this->tracks as $key => $t) {
			if($this->type == 10&&!$this->is3PL()&&preg_match('/os.pcaex.com/', $t->activity))
			{
				$t->activity = str_replace('os.pcaex.com', 'os.toplogistics.com.au', $t->activity);
			}
			if(($t->type<70||$t->type>90) && in_array($this->agent_id, Org::getSpecialOrgByType(1))&&$front)
			{
				continue;
			}

			if (isset($amap[$t->activity])) {
				$t->activity = $amap[$t->activity];
			}
			if($t->type==Tracking::CLEARED_TYPE&&$key==$clearanceKey&&!in_array($this->agent_id, Org::getSpecialOrgByType(0))&&$front)
			{
				if($this->type == ImParcel::$my_type && @$this->scanCount()==0)//this is for showing the cleared tracking data only when the parcel is scanned
				{
					$t= isset($this->tracks[$key-1])?$this->tracks[$key-1]:null;
					$o->status = "";
					break;
				}
			}

			$thisTrackingStatus = $t->getTrackingStatus($lastStatus);
			$lastStatus = $thisTrackingStatus;
			$o->tracks[] = [$t->activity, $t->depot, date($dtf, strtotime($t->dt)),$thisTrackingStatus];

			if (empty($o->odate) && $this->type == 50 && $t->type == 50) {
				$o->odate = date($df, strtotime($t->dt));
			}
		}

		//add clearance track
		if ($this->type == 20 && $t->type == 50 && strtotime($t->dt) < (time() - 172800)) {
			$bt = strtotime($t->dt);
			$q = ceil((time() - 172800 - $bt) / 172800);
			for ($i = 0; $i < $q; $i++) {
				$v = ($this->id + $i * 13) % 600;
				$dt = $bt + 172800 * ($i+1) + $v * ($v % 2 == 0? 1 : -1);
				$o->tracks[] = ['清关处理中，请等待', $t->depot, date($dtf, $dt)];
			}
		}
		if ($this->type == 20 && strtotime($this->created) > strtotime('2018-06-30')){
			$o->tracks[] = ['<b style="background: #ff0">Tracking info provided on behalf of <a href="http://www.turtle-express.net/" target="_blank" style="color:#c00">PEP</a></b>', 'NOTICE', '2018-07-01'];
		}
		
		$o->lastscan = !empty($t)?date($dtf, strtotime($t->dt)):"";

		// for import parcel, we check to see if we should and more virtual transit status
		// logic :
		// if last scan time over 3 days still not deliveried
		// we should insert on virtual transit
		//        if ( $this->type == 10 && ($this->status < 90 && $this->status > 55) ) {
//
		//            // currently for Australia post only
		//            if ( preg_match('/^AMQ\d{7}/', $this->ref) ) {
//
		//                // check to see if we should stop add virtual shipping events
		//                // flag will be set in trackingCommand.php auPost Function
		//                if ( !isset($this->mdata['virtual_event_stop']) ) {
		//                    $lastTime = new DateTime($t->dt, new DateTimeZone('Australia/Sydney'));
		//                    $curTime = new DateTime('now', new DateTimeZone('Australia/Sydney'));
		//                    $spanDays = $curTime->diff($lastTime)->format("%a");
		//                    if ($spanDays > 3) {
//
		//                        $spanUnit = floor($spanDays / 3);
		//                        $timeLastSpan = strtotime($t->dt);
		//                        for ($i = 0; $i < $spanUnit; $i++) {
		//                            // insert virtual one
		//                            $this->addTracking(70, 'In Transit In Australia', '', date('Y-m-d h:i:s', $timeLastSpan + ($i + 1) * 3 * 86400));
		//                            $o->tracks[] = array('In Transit In Australia', 0, date($dtf, $timeLastSpan + ($i + 1) * 3 * 86400));
		//                        }
		//                    }
		//                }
		//            }
		//        }

		return $o;
	}
	
	public function rating($or)
	{
		$z = ZoneMap::getZone($or->org_id, $this->postcode);
		if (!$z) {
			return false;
		}
		$zrs = ZoneRate::model()->findAll("rate_id = :rid AND (zone = :z OR zone = '') AND weight_hi >= :w", ['rid' => $or->id, ':z' => $z, ':w' => $this->weight]);
		if (empty($zrs)) {
			return false;
		}
		
		$rs = [];
		foreach ($zrs as $zr) {
			$rs[] = [$zr->id, $this->getRate($zr), $zr];
		}
		return $rs;
	}

	public function getManifestStatus()
	{
		if (!empty($this->trans)) {
			foreach ($this->trans as $ts) {
				if ($ts->connote != $this->ref) {
					continue;
				}
				if (!empty($ts->mdata['oid'])) {
					// in case Aupost or Startrack
					// only when trhanship order id existing which means has been lodged
					return "[M]";
				}
			}
		}
		return "";
	}
	
	public function getPerformanceDates()
	{
		$dates = [null,null,null];
		foreach ($this->tracks as $t) {
			if (in_array($t->type, [12,18]) && empty($dates[0])) {
				$dates[0] = substr($t->dt, 0, 10);
				if ($t->type == 18) {
					$dates[5] = $dates[0];
				}
			} elseif ($t->type == 18 && empty($dates[5])) {
				$dates[5] = substr($t->dt, 0, 10);
			} elseif ($t->type == 38 && empty($dates[1])) {
				$dates[1] = substr($t->dt, 0, 10);
			} elseif ($t->type == 90) {
				$dates[2] = substr($t->dt, 0, 10);
				break;
			}
		}
		if (!empty($dates[0]) && !empty($dates[1])) {
			$dates[3] = ceil((strtotime($dates[1]) - strtotime($dates[0])) / 86400);
		}
		if (!empty($dates[0]) && !empty($dates[2])) {
			$dates[4] = ceil((strtotime($dates[2]) - strtotime($dates[0])) / 86400);
		}

		return $dates;
	}
	
	public function bestRate()
	{
		$rs = OrgRate::model()->findAll('type < 30 AND vfrom <= :today AND (vto >= :today OR vto IS NULL)', [':today' => (empty($this->consol->eta) || $this->consol->eta == '0000-00-00')? date('Y-m-d') : $this->consol->eta]);
		$rate = false;
		$rid = 0;
		foreach ($rs as $or) {
			$ras = $this->rating($or);
			if (!$ras) {
				continue;
			}
			foreach ($ras as $ra) {
				if ($rate === false || $ra[1] < $rate) {
					$rid = $ra[0];
					$rate = $ra[1];
				}
			}
		}
		$this->zr_id = $rid;
		$this->save();
	}
	
	public function getRate($zr=null)
	{
		if (empty($zr)) {
			$zr = $this->zrate;
		}
		$r = $zr->base;
		if ($zr->perkg > 0) {
			$r += ($zr->nkg > 1? ceil($this->weight/$zr->nkg) : $this->weight) * $zr->perkg;
		}
		if ($r < $zr->minimum) {
			$r = $zr->minimum;
		}
		if ($zr->gst == 2) {
			$r *= 1.1;
		}
		
		return round($r*100)/100;
	}
	
	public function getSellRate()
	{
		if (empty($this->zr_id)) {
			return false;
		}
		if ($this->weight > 5) {
			$rid = 4;
		} else {
			$rid = $this->zrate->orgrate->org_id == 101? 4 : 5;
		}
		
		$zr = ZoneRate::model()->find("rate_id = :rid AND (zone = :z OR zone = '') AND weight_lo <= :w AND weight_hi > :w", ['rid' => $rid, ':z' => $this->zrate->zone, ':w' => $this->weight]);
		if (empty($zr)) {
			return false;
		}
		$r = $zr->base;
		if ($zr->perkg > 0) {
			$r += $this->weight * $zr->perkg;
		}
		if ($r < $zr->minimum) {
			$r = $zr->minimum;
		}
		
		return [$zr->id, round($r*100)/100, $zr];
	}
	
	public function addTracking($type, $act, $dpt='', $dt = '', $tid = 0, $srid = 0, $meta='')
	{
		$dt = empty($dt)? date('Y-m-d H:i:s') : $dt;
		$t = Tracking::model()->find('pid = :pid AND dt = :dt AND type = :type', [':pid' => $this->id, ':dt' => $dt, ':type' => $type]);
		if ($t) {
			return $t;
		}
		$t = new Tracking('create');
		$t->pid = $this->id;
		$t->tid = $tid;
		$t->srid = $srid;
		$t->dt = $dt;
		$t->activity = $act;
		$t->depot = $dpt;
		$t->type = $type;
		$t->meta = $meta;
		$t->save();
		return $t;
	}

	public function addTrackingLimited($type, $act, $dpt='', $dt = '', $tid = 0, $srid = 0, $meta='')
	{
		$dt = empty($dt)? date('Y-m-d H:i:s') : $dt;
		$t = Tracking::model()->find('pid = :pid AND type = :type', [':pid' => $this->id, ':type' => $type]);
		if ($t) {
			return $t;
		}
		$t = new Tracking('create');
		$t->pid = $this->id;
		$t->tid = $tid;
		$t->srid = $srid;
		$t->dt = $dt;
		$t->activity = $act;
		$t->depot = $dpt;
		$t->type = $type;
		$t->meta = $meta;
		$t->save();
		$this->updateTranshipTime();
		return $t;
	}

	public function updateTracking($type, $act, $dpt='', $dt = '', $tid = 0, $srid = 0, $meta='')
	{
		$this->updateTranshipTime();
		$dt = empty($dt)? date('Y-m-d H:i:s') : $dt;
		$t = Tracking::model()->find('pid = :pid AND type = :type', [':pid' => $this->id, ':type' => $type]);
		if (!empty($t))
		{
			$t->activity = $act;
			$t->save();
			return $t;
		}
		$t = new Tracking('create');
		$t->pid = $this->id;
		$t->tid = $tid;
		$t->srid = $srid;
		$t->dt = $dt;
		$t->activity = $act;
		$t->depot = $dpt;
		$t->type = $type;
		$t->meta = $meta;
		$t->save();
		return $t;
	}

	//only for FL Hunter
	public function addActTrackingLimited($type, $act, $dpt='', $dt = '', $tid = 0, $srid = 0, $meta=''){
		$dt = empty($dt)? date('Y-m-d H:i:s') : $dt;
		if($act=="Delivered"){
			$type = 90;
		}

		$t = Tracking::model()->find('pid = :pid AND type = :type And activity = :act And dt = :dt', [':pid' => $this->id, ':act' => $act, ':dt'=>$dt,':type'=>$type]);
		if ($t) {
			return $t;
		}
		
		$t = new Tracking('create');
		$t->pid = $this->id;
		$t->tid = $tid;
		$t->srid = $srid;
		$t->dt = $dt;
		$t->activity = $act;
		$t->depot = $dpt;
		$t->type = $type;
		$t->meta = $meta;
		$t->save();

		if($this->status<90){
			//if($act=="InTransit"){
				$this->status = ImParcel::STATE_COURIER;
				$this->save();
			//}
		}

		if($act=="Delivered"){
			$this->status = ImParcel::DELIVERED;
			$this->save();
		}

		return $t;
	}

	public function updateTranshipTime()
	{
		$sql = 'UPDATE tranship SET time = NOW() WHERE pid = :pid';
		Yii::app()->db->createCommand($sql)->bindValues([':pid' => $this->id])->execute();
		// foreach ($this->trans as $key => $t) {
		// 	$t->time = date("Y-m-d H:i:s");
		// 	$t->save();
		// }
	}
	
	/**
	 * check if the shipment already have a tracking of the same type
	 * @$params $type
	 * @return  boolean
	 */
	public function hasTracking($type)
	{
		$t= Tracking::model()->find('pid=:pid AND type=:type AND json_value(t.meta,"$.cargo_process_id") is null', [':pid'=>$this->id,':type'=>$type]);
		if ($t) {
			return true;
		}
		return false;
	}

	public function hasCargoProcessTracking($type,$cargoProcessId)
	{
		$t= Tracking::model()->find('pid=:pid AND type=:type AND json_value(t.meta,"$.cargo_process_id") = :cid', [':pid'=>$this->id,':type'=>$type,':cid'=>$cargoProcessId]);
		if ($t) {
			return true;
		}
		return false;
	}

	public function hasTrackingToday($type){
		$now_time = strtotime(date('Y-m-d H:i:s'));
		$t= Tracking::model()->find('pid=:pid AND type=:type order by dt desc', [':pid'=>$this->id,':type'=>$type]);
		if ($t) {
			if(!empty($t->dt)){
				$show_time= strtotime($t->dt);
				$dur = $now_time - $show_time;
				if($dur < 3600){
					return true;
				}
				return false;
			}
		}
		return false;
	}

	/**
	 * get if the shipment already have a tracking of the same type
	 * @$params $type
	 * @return  boolean
	 */
	public function getTracking($type)
	{
		$t= Tracking::model()->find('pid=:pid AND type=:type order by dt desc', [':pid'=>$this->id,':type'=>$type]);
		if ($t) {
			return $t;
		}
		return false;
	}

