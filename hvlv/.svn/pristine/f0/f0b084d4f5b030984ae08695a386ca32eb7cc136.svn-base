<script type="text/javascript">
    $(function(){
        var tab = $('#<?=$_GET["tabid"];?>');
        var panel = tab.data('panel');
        $('input.send_btn', panel).on('click', function(){
            var me = $(this);
            me.prop('disabled', true);
            $.get('<?=$this->createURL("dmawbConsol/acr", ["id" => $model->id]);?>', function(r){
                if(r.done){
                    myApp.notice(r.msg);
                }else{
                    myApp.alert(r.msg);
                }
                me.prop('disabled', true);
            }, 'json');
        });
         $('input.send_sub_btn', panel).on('click', function(){
            $.get('<?=$this->createURL("dmawbConsol/acr", ["id" => $model->id,'sub'=>1]);?>', function(r){
                var me = $(this);
                me.prop('disabled', true);
                if(r.done){
                    myApp.notice(r.msg);
                }else{
                    myApp.alert(r.msg);
                }
                me.prop('disabled', true);
            }, 'json');
        });

      $('#<?=$sacname;?>', panel).on('ac_after_select', function(evt, ui){
        $("#mdata_cnee_postcode", panel).val(ui.item['pc']);
        $('#mdata_cnee_state', panel).val(ui.item['st']);
    });
    });
</script>