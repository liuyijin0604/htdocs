	public function validateAddress()
	{
		$agt_id = empty($this->user)? -1 : (empty($this->user->org_id)? -1: $this->user->org_id);
		if($agt_id < 0 && empty($this->user->org_id) && !empty($this->user->org)) $agt_id = $this->user->org;
		if($agt_id!=Org::ORGID_CLIENT_PCAE)
		{
			echo "wrong org";
			return;
		}
		$d = $this->ctlr->data;
		$suburb = $d->suburb;
		$state = $d->state;
		$postcode = $d->postcode;
		$apiService = new AusPostAPI('syd');
		if (is_object($d)) {
			$result = $apiService->validateAddress($suburb, $state, $postcode);
			if($result===true)
			{
				$o=['status' => 1, 'msg' => 'valid','result'=>$result];
			}else
			{
				$o=['status' => 1, 'msg' => 'invalid','result'=>$result];
			}
		} else {
			$o=['status' => 0, 'msg' => 'Json data malformatted'];
		}
		$this->log(json_encode($o));
		echo json_encode($o);
	}

	public function doTNTRouting()
	{
		$agt_id = empty($this->user)? -1 : (empty($this->user->org_id)? -1: $this->user->org_id);
		if($agt_id < 0 && empty($this->user->org_id) && !empty($this->user->org)) $agt_id = $this->user->org;
		if($agt_id!=Org::ORGID_CLIENT_PCAE)
		{
			echo "wrong org";
			return;
		}
		$d = $this->ctlr->data;
		$data = [];
		$data['CSurburb'] = $d->CSurburb;
		$data['CPostcode'] = $d->CPostcode;
		$data['DSuburb'] = $d->DSuburb;
		$data['DPostcode'] = $d->DPostcode;
		$data['ServiceCode'] = $d->ServiceCode;
		$apiService = TntAPI::getTntInterface('syd_top');
		if (is_object($d)) {
			$result = $apiService->doRoutingRequestPublic($data);
			if(!empty($result))
			{
				$o=['status' => 1, 'msg' => 'valid','result'=>$result];
			}
		} else {
			$o=['status' => 0, 'msg' => 'Json data malformatted'];
		}
		$this->log(json_encode($o));
		echo json_encode($o);
	}

	public function receiveTrackingInfo()
	{
		$agt_id = empty($this->user)? -1 : (empty($this->user->org_id)? -1: $this->user->org_id);
		if($agt_id < 0 && empty($this->user->org_id) && !empty($this->user->org)) $agt_id = $this->user->org;
		if($agt_id!=Org::ORGID_CLIENT_TRACKING)
		{
			echo "wrong org";
			return;
		}
		$d = $this->ctlr->data;
