			}else
			{
				$o=['status' => 0, 'msg' => 'failed','result'=>$result];
			}
		} else {
			$o=['status' => 0, 'msg' => 'Json data malformatted'];
		}
		$this->log(json_encode($o));
		echo json_encode($o);
	}


