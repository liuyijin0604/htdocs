$inv_tot = 0;
if (!empty($model->mdata['custom_inv']['qty']) && is_array($model->mdata['custom_inv']['qty'])) {
	foreach ($model->mdata['custom_inv']['qty'] as $i => $q) {
		if (empty($q)) {
			continue;
		}
		$inv_tot += $q * floatval($model->mdata['custom_inv']['amount'][$i]);
	}
}
