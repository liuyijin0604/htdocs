	$('.update_note',win).click(function(){
		var note=$('#custom_note',win).val();
		var data={"custom_note":note,"id":<?=$model->id?>};
		$.ajax({
				url:'<?=Yii::app()->createUrl('customProcess/update')?>',
				data:data,
				method:'POST',
				success:function(r){
					if(r == 'done'){
