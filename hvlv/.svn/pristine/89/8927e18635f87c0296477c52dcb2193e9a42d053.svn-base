		// 	Yii::import('application.controllers.ImcoConsolController');
		// 	$cc = new ImcoConsolController('default');
		// 	$cc->actionAupost($consol->id);
		// 	$cc->actionAupostInt($consol->id);
		// }

		$consols = ImcoConsol::model()->findAll(" json_value(t.meta,'$.for3PL') = 1 and no like 'TS%' and json_value(t.meta,'$.is_generate_3pl') is null ".'and owner_id!='.Org::ORGID_CLIENT_PCAE.' and owner_id!='.Org::ORGID_CLIENT_SF);
		foreach ($consols as $key => $consol) {
			if(empty($consol->mdata['awb_wt']))
			{
				$consol->mdata['awb_wt'] = 1;
			}
			$consol->genSpecialInvoice(false, false, [$consol->owner_id]);
			$consol->mdata['is_generate_3pl'] = 1;
			$consol->save();
			echo $consol->id;
		}
	}

