	public function fulfillCargoProcess(){
		$tonyApi = new TonyAPI();
		$modelCJobs = CargoProcessJob::model()->findAllBySql('select * from cargo_process_job where created >= :created and JSON_EXTRACT(meta, "$.Post") = 1',[':created'=>date('Y-m-d',strtotime("-7 day"))]);
		if(!empty($modelCJobs)){
			foreach($modelCJobs as $modelCJob){
				if(!empty($modelCJob)){
					foreach($modelCJob->job_relations as $cargoRelation){
						$modelCargoProcess = CargoProcess::model()->findByPk($cargoRelation->cargo_process_id);
						if(!empty($modelCargoProcess)){
							$tonyApi->fulfillmentCargoProcess($modelCargoProcess->shipment->hbn);
						}
					}
				}
			}
		}
	}

