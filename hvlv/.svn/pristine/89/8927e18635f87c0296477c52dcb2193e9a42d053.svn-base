	public function syncInvoiceFromXero($day = 30)
	{
		Yii::app()->name = 'TLA';
		if (!empty($this->args[1])) {
			$day = $this->args[1];
		}

		$xero = new XeroAPI('xero_token_toplog');

		$count = 0;
		$results = $xero->get('Accounting\Invoice', ['Type' => 'ACCREC', 'ModifiedAfter' => date('Y-m-d H:i:s', strtotime(date('Y-m-d H:i:s') . ' - ' . $day . ' day'))]);
		$count ++;

		$store_invoices = [];
		$store_payments = [];
		$store_accounts = [];
		$store_creditnotes = [];

		// do reconcile
		foreach ($results as $result) {
			// get xero inv and hvlv inv
			$result['InvoiceNumber'] = explode('-', $result['InvoiceNumber'])[0];
			$inv = Invoice::model()->find(['condition' => 't.no LIKE :no AND t.status IN (2,3,7,11) AND t.total >= :total1 AND t.total <= :total2', 'params' => [':no' => '%' . $result['InvoiceNumber'] . '%', ':total1' => $result['Total'] - 0.2, ':total2' => $result['Total'] + 0.2], 'order' => 'id DESC']);
			if (empty($inv) || ($result['AmountPaid'] == 0 && $result['AmountCredited'] == 0)) {
				continue;
			}
			if ($inv->total != $result['Total']) {
				$inv->mdata['before_xero_rounding'] = $inv->total;
				if($result['Total']!=$inv->getTotal())
				{
					$inv->total = $result['Total'];
				}
				$inv->update('meta', 'total', 'gst');
			}
			if (!empty($store_invoices[$result['InvoiceID']])) {
				$xero_inv = $store_invoices[$result['InvoiceID']];
			} else {
				$xero_inv = $xero->getByID('Accounting\Invoice', $result['InvoiceID']);
				$count ++;
			}
			$store_invoices[$result['InvoiceID']] = $xero_inv;

			$inv->cust->extra[$xero->key] = $xero_inv['Contact']['ContactID'];
			$inv->cust->sync_xero = false;
			$inv->cust->update('meta');

			// check allocate payment
			if (!empty($xero_inv['Payments'])) {
				foreach ($xero_inv['Payments'] as $item) {
					// get xero pay and hvlv pay
					try {
						if (!empty($store_payments[$item['PaymentID']])) {
							$xero_payment = $store_payments[$item['PaymentID']];
						} else {
							$xero_payment = $xero->getByID('Accounting\BatchPayment', $item['PaymentID']);
							$count ++;
						}
						$store_payments[$item['PaymentID']] = $xero_payment;
						if (!empty($xero_payment) && !empty($xero_payment->getPayment())) {
							$pay_id = $xero_payment->getBatchPaymentID();
							$amount = $xero_payment->getAmount();
							foreach ($xero_payment->getPayment() as $pay) {
								if ($pay['Invoice']['InvoiceID'] == $result['InvoiceID']) {
									if (!empty($store_payments[$pay['PaymentID']])) {
										$pay = $store_payments[$pay['PaymentID']];
									} else {
										$pay = $xero->getByID('Accounting\Payment', $pay['PaymentID']);
										$count ++;
									}
									$store_payments[$pay['PaymentID']] = $pay;
									$time = $pay['UpdatedDateUTC'];
								}
							}
						} else {
							$xero_payment = $xero->getByID('Accounting\Payment', $item['PaymentID']);
							$count ++;
							$store_payments[$item['PaymentID']] = $xero_payment;
							$time = $xero_payment['UpdatedDateUTC'];
							$pay_id = $xero_payment['PaymentID'];
							$amount = $xero_payment['Amount'];
						}
					} catch (Exception $ex) {
						if (!empty($store_payments[$item['PaymentID']])) {
							$xero_payment = $store_payments[$item['PaymentID']];
						} else {
							$xero_payment = $xero->getByID('Accounting\Payment', $item['PaymentID']);
							$count ++;
						}
						$store_payments[$item['PaymentID']] = $xero_payment;
						$time = $xero_payment['UpdatedDateUTC'];
						$pay_id = $xero_payment['PaymentID'];
						$amount = $xero_payment['Amount'];
					}
					// check old payment
					if (empty($time) || strtotime($time->format('Y-m-d H:i:s')) < strtotime(date('Y-m-d H:i:s') . ' - ' . $day . ' day')) {
						continue;
					}

					$payment = Payment::model()->find('xero_id = :xero_id AND status != 9', [':xero_id' => $pay_id]);

					// get xero account and hvlv account
					// if (!empty($store_accounts[$item['Account']['AccountID']])) {
					// 	$xero_account = $store_accounts[$item['Account']['AccountID']];
					// } else {
					// 	$xero_account = $xero->getByID('Accounting\Account', $item['Account']['AccountID']);
					// 	$count ++;
					// }
					// $store_accounts[$item['Account']['AccountID']] = $xero_account;
					// $account = BankAccount::model()->find('xero_id = :xero_id', [':xero_id' => $xero_account['AccountID']]);

					// further check pay_inv
					if (empty($payment)) {
						$pay_inv = PayInv::model()->with('payment')->find('t.inv_id = :inv_id AND t.amount = :amount AND payment.status != 9 AND payment.xero_id = ""', [':inv_id' => $inv->id, ':amount' => $item['Amount']]);
						if (!empty($pay_inv)) {
							$payment = $pay_inv->payment;
							$payment->xero_id = $pay_id;
							$payment->save();

							$msg = 'Sync payment with xero for invoice ' . $inv->no . ' ' . $payment->no;
							$tmp = Yii::app()->basePath . DIRECTORY_SEPARATOR . 'runtime' . DIRECTORY_SEPARATOR . 'xero' . DIRECTORY_SEPARATOR;
							file_put_contents($tmp . 'xero_sync.log', date('Y-m-d H:i:s') . ' ' . $msg . "\n", FILE_APPEND);

							$pay_inv->sync_xero = 1;
							$pay_inv->save();
						}
					}

					if (empty($payment)) {
						$payment = new Payment;
						$payment->org_id = $inv->to_id;
						$payment->date = $xero_payment['Date']->format('Y-m-d');
						$payment->transaction_date = $xero_payment['Date']->format('Y-m-d');
						$payment->status = Payment::PAYMENT_STATUS_POSTED;
						$payment->dpmt = $inv->dpmt;
						$payment->bank = 0;
						$payment->currency = array_search($xero_inv['CurrencyCode'], Invoice::$currencies);
						$payment->amount = $amount;
						$payment->ref = !empty($xero_payment['BatchPaymentID']) ? '' : $xero_payment['Reference'];
						$payment->ata = 0;
						$payment->type = Payment::PAYMENT_TYPE_EFT;
						$payment->xero_id = $pay_id;
						$payment->save();

						if ($payment->getErrors()) {
							$payment->date = date('Y-m-d');
							$payment->save();
						}

						$msg = 'New payment created for invoice ' . $inv->no . ' ' . $payment->no;
						$tmp = Yii::app()->basePath . DIRECTORY_SEPARATOR . 'runtime' . DIRECTORY_SEPARATOR . 'xero' . DIRECTORY_SEPARATOR;
						file_put_contents($tmp . 'xero_sync.log', date('Y-m-d H:i:s') . ' ' . $msg . "\n", FILE_APPEND);
					}

					$pay_inv = PayInv::model()->with('payment')->find('t.inv_id = :inv_id AND t.pay_id = :pay_id AND payment.status != 9', [':inv_id' => $inv->id, ':pay_id' => $payment->id]);
					if (empty($pay_inv)) {
						$pay_inv = new PayInv;
						$pay_inv->inv_id = $inv->id;
						$pay_inv->pay_id = $payment->id;
						$pay_inv->amount = $item['Amount'];
						$pay_inv->transaction_date = $item['Date']->format('Y-m-d');
						if ($paymemnt->currency != $inv->currency) {
							$pay_inv->exrate = $item['CurrencyRate'];
						} else {
							$pay_inv->exrate = 1;
						}
						$pay_inv->sync_xero = 1;
						$pay_inv->save();

						$payment->updateAta();

						$msg = 'New pay_inv created for invoice ' . $inv->no . ' ' . $payment->no;
						$tmp = Yii::app()->basePath . DIRECTORY_SEPARATOR . 'runtime' . DIRECTORY_SEPARATOR . 'xero' . DIRECTORY_SEPARATOR;
						file_put_contents($tmp . 'xero_sync.log', date('Y-m-d H:i:s') . ' ' . $msg . "\n", FILE_APPEND);
					}
				}
			}

			// check allocate credit note
			if (!empty($xero_inv['CreditNotes'])) {
				foreach ($xero_inv['CreditNotes'] as $item) {
					// get xero credit and hvlv credit
					if (!empty($store_creditnotes[$item['CreditNoteID']])) {
						$xero_credit = $store_creditnotes[$item['CreditNoteID']];
					} else {
						$xero_credit = $xero->getByID('Accounting\CreditNote', $item['CreditNoteID']);
						$count ++;
					}
					$store_creditnotes[$item['CreditNoteID']] = $xero_credit;
					$credit = Payment::model()->find('no = :no', [':no' => explode('-', $item['CreditNoteNumber'])[0]]);

					if (!empty($credit)) {
						if (empty($credit->xero_id) || $credit != $item['CreditNoteID']) {
							$credit->xero_id = $item['CreditNoteID'];
							$credit->update('xero_id');
						}
					} else if (empty($credit)) {
						continue;
					}

					$pay_inv = PayInv::model()->find('inv_id = :inv_id AND pay_id = :pay_id', [':inv_id' => $inv->id, ':pay_id' => $credit->id]);
					if (empty($pay_inv)) {
						$pay_inv = new PayInv;
						$pay_inv->inv_id = $inv->id;
						$pay_inv->pay_id = $credit->id;
						foreach ($xero_credit['Allocations'] as $alloc) {
							if (explode('-', $alloc['Invoice']['InvoiceNumber'])[0] == explode('-', $inv->no)[0]) {
								$pay_inv->amount = $alloc['AppliedAmount'];
							}
						}
						$pay_inv->transaction_date = date('Y-m-d');
						$pay_inv->exrate = 1;
						$pay_inv->sync_xero = 1;
						$pay_inv->save();

						$credit->updateAta();
					} else if ($pay_inv->sync_xero == 0) {
						$pay_inv->sync_xero = 1;
						$pay_inv->save();
					}
				}
			}

			$inv->refresh();
			$inv->checkPaid();
			$inv->save();
		}
		// feedback xero reconcile creditnote
		foreach ($results as $result) {
			// get xero inv and hvlv inv
			$result['InvoiceNumber'] = explode('-', $result['InvoiceNumber'])[0];
			$inv = Invoice::model()->with('payments', 'payments.payment')->find(['condition' => 't.no LIKE :no AND t.status IN (6,8) AND payments.sync_xero = 0 AND payment.type = 5 AND payment.bank = 91 AND payment.status = 6', 'params' => [':no' => '%' . $result['InvoiceNumber'] . '%'], 'order' => 't.id DESC']);
			if (empty($inv) || ($result['AmountCredited'] == 0)) {
				continue;
			}
			if (!empty($store_invoices[$result['InvoiceID']])) {
				$xero_inv = $store_invoices[$result['InvoiceID']];
			} else {
				$xero_inv = $xero->getByID('Accounting\Invoice', $result['InvoiceID']);
				$count ++;
			}
			$store_invoices[$result['InvoiceID']] = $xero_inv;

			// check allocate credit note
			if (!empty($xero_inv['CreditNotes'])) {
				foreach ($xero_inv['CreditNotes'] as $item) {
					// get xero credit and hvlv credit
					if (!empty($store_creditnotes[$item['CreditNoteID']])) {
						$xero_credit = $store_creditnotes[$item['CreditNoteID']];
					} else {
						$xero_credit = $xero->getByID('Accounting\CreditNote', $item['CreditNoteID']);
						$count ++;
					}
					$store_creditnotes[$item['CreditNoteID']] = $xero_credit;
					$credit = Payment::model()->find('no = :no', [':no' => explode('-', $item['CreditNoteNumber'])[0]]);

					if (!empty($credit)) {
						if (empty($credit->xero_id) || $credit != $item['CreditNoteID']) {
							$credit->xero_id = $item['CreditNoteID'];
							$credit->update('xero_id');
						}
					} else if (empty($credit)) {
						continue;
					}

					$pay_inv = PayInv::model()->find('inv_id = :inv_id AND pay_id = :pay_id', [':inv_id' => $inv->id, ':pay_id' => $credit->id]);
					if (!empty($pay_inv)) {
						$pay_inv->sync_xero = 1;
						$pay_inv->save();
					}
				}
			}
		}

		$msg = 'Total API Calls: ' . $count;
		$tmp = Yii::app()->basePath . DIRECTORY_SEPARATOR . 'runtime' . DIRECTORY_SEPARATOR . 'xero' . DIRECTORY_SEPARATOR;
		file_put_contents($tmp . 'xero_sync.log', date('Y-m-d H:i:s') . ' ' . $msg . "\n", FILE_APPEND);
	}

	public function syncBillingFromXero($day = 10)
	{
		yii::app()->name = 'TLA';
		if (!empty($this->args[1])) {
			$day = $this->args[1];
		}

		if (yii::app()->name != 'TLA') {
			$xero = new XeroAPI('xero_token_pcaex');
		} else {
			$xero = new XeroAPI('xero_token_toplog');
		}

		$count = 0;
		$results = $xero->get('Accounting\Invoice', ['Type' => 'ACCPAY', 'ModifiedAfter' => date('Y-m-d H:i:s', strtotime(date('Y-m-d H:i:s') . ' - ' . $day . ' day'))]);
		$count ++;

		$not_found = [];
		foreach ($results as $result) {
			$no = $result['InvoiceNumber'];
			// $billing = Billing::model()->with('cust')->find('t.status != 11 AND t.billing_cref = :no AND cust.name = :name', [':no' => $no, ':name' => $result['Contact']['Name']]);
			// if (empty($billing)) {
			// 	$billing = Billing::model()->with('cust')->find('t.status != 11 AND t.billing_cref LIKE :no AND cust.name = :name', [':no' => '%' . explode('-', $no)[0] . '%', ':name' => $result['Contact']['Name']]);
			// }
			$billing = Billing::model()->find(['condition' => 't.xero_id = :xero_id AND t.status != 11', 'params' => [':xero_id' => $result['InvoiceID']], 'order' => 'id DESC']);
			if (empty($billing)) {
				$not_found[] = $no;
				continue;
			}

			$billing->cust->extra[$xero->key] = $result['Contact']['ContactID'];
			$billing->cust->sync_xero = false;
			$billing->cust->update('meta');

			if (!empty($result['Payments'])) {
				foreach ($result['Payments'] as $payment) {
					$pb = PaymentBilling::model()->find('xero_id = :xero_id', [':xero_id' => $payment['PaymentID']]);
					if (empty($pb)) {
						$pb = new PaymentBilling;
						$pb->org_id = $billing->org_id;
						$thisDate = json_decode(json_encode($payment['Date']), true);
						if(is_array($thisDate)&&!empty($thisDate['date']))
						{
							$pb->date = date('Y-m-d', strtotime(json_decode(json_encode($payment['Date']), true)['date']));
						}else
						{
							$pb->date = date('Y-m-d', strtotime($thisDate));
						}

						$pb->transaction_date = $pb->date;
						$pb->type = PaymentBilling::PAYMENT_TYPE_EFT;
						$pb->status = PaymentBilling::PAYMENT_STATUS_POSTED;
						$pb->currency = $billing->currency;
						$pb->amount = 0;
						$pb->xero_id = $payment['PaymentID'];
						$pb->bank = 10;
						$pb->save();
					}

					if (empty($pb->getErrors())) {
						$pbill = PayBill::model()->find('pay_id = :pay_id AND bill_id = :bill_id', [':pay_id' => $pb->id, ':bill_id' => $billing->id]);
						if (empty($pbill)) {
							$pbill = new PayBill;
							$pbill->pay_id = $pb->id;
							$pbill->bill_id = $billing->id;
							$pbill->amount = number_format($payment['Amount'], 2, '.', '');
							$pbill->transaction_date = $pb->date;
							$pbill->save();
						}
					}

					$pb->updateAmount();
				}
			}

			// undo invalid allocation
			$pbills = PayBill::model()->with('payment')->findAll('t.bill_id = :bill_id AND payment.type != :type', [':bill_id' => $billing->id, ':type' => PaymentBilling::PAYMENT_TYPE_CREDIT_NOTE]);
			foreach ($pbills as $pbill) {
				if (!empty($result['Payments'])) {
					foreach ($result['Payments'] as $payment) {
						if ($payment['PaymentID'] == $pbill->payment->xero_id) {
							$pbill->sync_xero = 0;
							$pbill->update('sync_xero');
							continue 2;
						}
					}
				}

				$pbill->sync_xero = 1;
				$pbill->update('sync_xero');
			}

			if (!empty($result['CreditNotes'])) {
				foreach ($result['CreditNotes'] as $credit) {
					$pb = PaymentBilling::model()->find('xero_id = :xero_id', [':xero_id' => $credit['CreditNoteID']]);
					if (empty($pb)) {
						$pb = new PaymentBilling;
						$pb->org_id = $billing->org_id;
						$thisDate = json_decode(json_encode($payment['Date']), true);
						if(is_array($thisDate)&&!empty($thisDate['date']))
						{
							$pb->date = date('Y-m-d', strtotime(json_decode(json_encode($payment['Date']), true)['date']));
						}else
						{
							$pb->date = date('Y-m-d', strtotime($thisDate));
						}
						$pb->transaction_date = $pb->date;
						$pb->type = PaymentBilling::PAYMENT_TYPE_CREDIT_NOTE;
						$pb->status = PaymentBilling::PAYMENT_STATUS_POSTED;
						$pb->currency = $billing->currency;
						$pb->amount = 0;
						$pb->xero_id = $credit['CreditNoteID'];
						$pb->bank = 10;
						if (!empty($credit['CreditNoteNumber']))
						{
							$pb->mdata['CreditNoteNumber'] = $credit['CreditNoteNumber'];
						}

						$pb->save();
					}else
					{
						if (!empty($credit['CreditNoteNumber'])&&empty($pb->mdata['CreditNoteNumber']))
						{
							$pb->mdata['CreditNoteNumber'] = $credit['CreditNoteNumber'];
							$pb->save();
						}
					}

					if (empty($pb->getErrors())) {
						$pbill = PayBill::model()->find('pay_id = :pay_id AND bill_id = :bill_id', [':pay_id' => $pb->id, ':bill_id' => $billing->id]);
						if (empty($pbill)) {
							$pbill = new PayBill;
							$pbill->pay_id = $pb->id;
							$pbill->bill_id = $billing->id;
							$pbill->amount = number_format($credit['Total'], 2, '.', '');
							$pbill->transaction_date = $pb->date;
							$pbill->save();
						}

						$pb->refresh();
						$pb->updateAmount();
						$pb->updateAta();
					}


					if (!empty($credit['CreditNoteNumber'])) {
						$cb = Billing::model()->find('billing_cref = :no AND org_id = :oid', [':no' => $credit['CreditNoteNumber'], ':oid' => $billing->org_id]);
						if (!empty($cb)) {
							if ($pb->ata > 0) {
								$cb->status = Billing::BILLING_STATUS_PARTIALLY_PAID;
							} else {
								$cb->status = Billing::BILLING_STATUS_PAID;
							}
							$cb->update('status');
						}
					}
				}

				// In here, we will check the dispute supplier Task
				$si = SupplierInvoice::model()->find('inv_no = :inv_no AND status < 100', [':inv_no' => $billing->billing_cref]);
				if (!empty($si))
				{
					$siR = SiReconcile::model()->find('supplier_invoice_id = :supplier_invoice_id AND t.status < 100', [':supplier_invoice_id' => $si->id]);
					$checkStr = "";
					if(!empty($siR->mdata['disputeCreditNote']))
					{
						$checkStr = json_encode($siR->mdata['disputeCreditNote']);
					}
					$siR->mdata['disputeCreditNote']=[];
					foreach ($billing->payments as $p) {
						if (isset($p->payment) && ($p->payment->type == 5) && ($p->payment->status == 6)) {
							$creditNoteNumber = empty($p->payment->mdata["CreditNoteNumber"])?"":$p->payment->mdata["CreditNoteNumber"];
							$siR->mdata['disputeCreditNote'][$p->pay_id.$p->bill_id]=[$creditNoteNumber=>$p->amount];
						}
					}
					
					if(!empty($siR->mdata['disputeCreditNote']))
					{
						if(json_encode($siR->mdata['disputeCreditNote'])!=$checkStr)
						{
							$siR->save();
						}
					}

					// In here, we will check the dispute supplier Task
					$disputeTasks = DisputeSupplierTask::model()->findAll(['condition'=>' model="SiReconcile" and fid =:fid and status!=:status','params'=>[':fid'=>$siR->id,':status'=>TlaTask::DELETED]]);
					/******************************************/

					$credit = $billing->getCredit();
					$least = $credit;
					foreach ($disputeTasks as $k2 => $disputeTask)
					{
						if(!empty($disputeTask->mdata['dispute_id']))
						{
							$disputeAmount = $disputeTask->getDisputeAmount();
							if($disputeAmount<0.00001) continue;
							if(!isset($disputeTask->mdata['disputeLeast']))
							{
								$disputeTask->mdata['disputeLeast'] = $disputeAmount;
							}
							if(($disputeAmount-$least)<=0.00001)
							{
								if($disputeTask->mdata['disputeLeast']>0.00001)
								{
									$disputeTask->mdata['disputeLeast'] = 0;
									$disputeTask->done();
									$disputeTask->updateMeta();
								}
							}else
							{
								if(!isset($disputeTask->mdata['disputeLeast'])||$disputeTask->mdata['disputeLeast']!=($disputeAmount-$least))
								{
									$disputeTask->mdata['disputeLeast'] = $disputeAmount-$least;
									$disputeTask->updateMeta();
								}
							}
							$least = $least-$disputeAmount;
							if($least<=0.00001)
							{
								break;
							}
						}
					}
				}
			}

			$billing->checkPaid();
			$o = Billing::model()->findByPk($billing->id);
			if ($o->status != $billing->status) {
				$billing->update('status');
			}
		}
		yii::log(implode(', ', $not_found), 'warning');
	}

