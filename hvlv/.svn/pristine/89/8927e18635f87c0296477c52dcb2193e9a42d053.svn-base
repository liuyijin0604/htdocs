	/*create rts consol each month/
	*
	*/
	public function createRtsConsol()
	{
		Yii::app()->name = 'TLA';
		$debug= empty($this->args[1])?0:$this->args[1];
		if (!$debug) {
			if ($this->day!=7) {
				return;
			}
		}
		$consol=ImcoConsol::model()->find('awb=:awb', [':awb'=>'RTS'.date('Ym')]);
		if (empty($consol)) {
			$consol=new ImcoConsol();
			$consol->dpt_id=106;
			$consol->awb='RTS'.date('Ym');
			$consol->pol = 'AUSYD';
			$consol->pod = 'AUSYD';
			$consol->eta = date('Y-m-d');
			$consol->created = date('Y-m-d');
			$consol->status = 60;
			$consol->save();
		}
		$month="2017-11";
		// failed to put some parcel into consol
		// $invs=Invoice::model()->findAll('type=37 AND consol_id=0 AND date>=:start and date<=:end', [":start"=>date('Y-m-01'),":end"=>date('Y-m-t')]); //rts fee and rts resend fee
		$invs=Invoice::model()->findAll('type=37 AND consol_id=0 AND date>=:start and date<=:end', [":start"=>date('Y-m-d', strtotime(date('Y-m-01') . ' - 24 days')),":end"=>date('Y-m-t')]); //rts fee and rts resend fee
		$transaction=Yii::app()->db->beginTransaction();
		try {
			foreach ($invs as $inv) {
				foreach ($inv->lines as $il) {
					foreach ($il->mdata['items'] as $si=>$sp) {
						if (!empty($sp[3])) {
							$p=ImParcel::model()->find('ref=:ref', [':ref'=>$sp[3]]);
							if (!empty($p)&&$p->consol_id==0) {
								$p->consol_id=$consol->id;
								$p->update(['consol_id']);
							}
						}
					}
				}
				$inv->consol_id=$consol->id;
				$inv->update(['consol_id']);
			}
			$transaction->commit();
		} catch (Exception $ex) {
			$transaction->rollback();
		}
		$consoleIds = [$consol->id];
		ImcoConsol::updateImportConsoleBilling($consoleIds);
		$consol->updateAupostRealCost();
		$consol->updateFastWayRealCost();
		//resending fee. $10
		$transaction=Yii::app()->db->beginTransaction();
		try {
			$invoices = Invoice::model()->findAll('date>=:start and date<=:end AND type=:type AND consol_id=0', [':type' => Invoice::INVOICE_TYPE_RTS_FEE,':start'=>date('Y-m-01'),':end'=>date('Y-m-t')]);
			foreach ($invoices as $inv) {
				$inv->consol_id=$consol->id;
				$inv->update('consol_id');
			}
			$transaction->commit();
		} catch (Exception $ex) {
			$transaction->rollback();
		}
		echo 'done!';
	}
	public function attachStorageInvoiceToConsol()
	{
		$invoices = Invoice::model()->findAll('date>="2018-01-01" AND type=:type AND consol_id=0', [':type' => Invoice::INVOICE_TYPE_STORAGE_FEE]);
		$transaction = Yii::app()->db->beginTransaction();
		try {
			foreach ($invoices as $inv) {
				if (!empty($inv->lines)) {
					$il = $inv->lines[0];
					$hbn = @$il->mdata['items'][0][1];
					if (!empty($hbn)) {
						$shipment = ImParcel::model()->find('hbn=:hbn', [':hbn' => $hbn]);
						if (!empty($shipment->consol_id)) {
							$inv->consol_id = $shipment->consol_id;
							$inv->update('consol_id');
						}
					}
				}
			}
			$transaction->commit();
		} catch (Exception $ex) {
			$transaction->rollback();
		}
	}

	public function directCourier($extra=false)
	{
		$imConsolService = new ImConsolService();
		/* 1.get the shipment that not manifest yet cbwfs 32
		*
		* 2. if not have tranship, group
		*
		* 3.Manifested
		*
		* 4.create tranship
		*
		* 5.make a log about the manifest yet?
		*
			 * $extra manifest at 10:00AM FOR 1316 org, other org manifest at night
		*/
		if ($this->args[1] == 1) {
			$extra = true;
		}
		$ss = [];
		$ss_stone = [];
		$ss_mel = [];
		$ss_d2z = [];
		$ss_ubi = [];
		$ss_fsw = [];
		$ss_dfe = [];
		$ss_ini = [];
		$ss_per = [];
		$ss_gv_syd = [];
		$ss_gv_mel = [];
		$ss_gv_bne = [];
		$ss_gv_per = [];
		$ss_gv_mel2 = [];
		$os=[];
		if ($extra) {
			// 八达通 - 1316，SFC1 - 900, wandamei
			$rs=ImParcel::model()->findAll('cbwf&32>0  AND agent_id IN (1206,1316,1900,2198,2716,2797,3189) and created>DATE_SUB(NOW(), INTERVAL 60 DAY) AND status < 100 AND ref not in ("34KHW1006401","34KG61018133","34KHX1045798","34KG61041705","34KHX1033119","34KHW1016423","34KHY1033644","34KG61062547","34KHX1068598","34KG61059238","34KHX1052214","34KHX1044143","34KHX1052217","34KG61060113","34KG61051425")');
		} else {
			$rs=ImParcel::model()->findAll('cbwf&32>0 AND created>DATE_SUB(NOW(), INTERVAL 60 DAY) AND status < 100 AND ref not in ("34KHW1006401","34KG61018133","34KHX1045798","34KG61041705","34KHX1033119","34KHW1016423","34KHY1033644","34KG61062547","34KHX1068598","34KG61059238","34KHX1052214","34KHX1044143","34KHX1052217","34KG61060113","34KG61051425")');
		}
		// get related all shipment ids
		// we need save shipment id to get task map as well
		// so that we can modify task bwf status once lodge successfully
		$pces = [];
		foreach ($rs as $s) {
			if (preg_match('/^(AMQ|33EVH|33EVJ|333UF|34AWE|LH|CH|34KHX|34KG6|34KHY|34KHW|34WMP)\d{7}/', $s->ref) && empty($s->trans)&&empty($s->mdata['direct_courier'])) { // make sure it is aupost parcel
				$s->cnee->checkPostcode();
				if (!preg_match('/[A-z]+/i', $s->cnee->name)) {
					$pces[] = $s->hbn.': consignee name has not English characters';
					continue;
				}
				if(strlen($s->cnee->suburb) > 40){
					$pces[] = $s->hbn.' suburb too long!';
					continue;
				}
				if(!empty($s->mdata['aupost_return'])){
					if(empty($s->mdata['ap_sid'])) $ars[$s->hbn] = $s;
					continue;
				} elseif(!empty($s->mdata['aupost_exp'])) {
					if (empty($s->mdata['ap_sid'])) $aes[$s->hbn] = $s;
					continue;
				}elseif (preg_match("/^AMQ\d{7}/", $s->ref)) {
					$ss[] = $s;
				} elseif (preg_match("/^333UF\d{7}/", $s->ref)) {
					$ss_stone[]=$s;
				} elseif (preg_match("/^33EVH\d{7}/", $s->ref)) {
					$ss_mel[]=$s;
				} elseif (preg_match("/^33EVJ\d{7}/", $s->ref)) {
					$ss_bri[]=$s;
				} elseif (preg_match("/^34AWE\d{7}/", $s->ref)) {
					$ss_per[]=$s;
				} elseif (preg_match("/^LH/", $s->ref)) {
					$ss_ini[]=$s;
				} elseif (preg_match("/^CH/", $s->ref)) {
					$ss_ini[]=$s;
				} elseif (preg_match("/^34KHX\d{7}/", $s->ref)) {
					$ss_gv_syd[]=$s;
				} elseif (preg_match("/^34KG6\d{7}/", $s->ref)) {
					$ss_gv_mel[]=$s;
				} elseif (preg_match("/^34KHY\d{7}/", $s->ref)) {
					$ss_gv_bne[]=$s;
				} elseif (preg_match("/^34KHW\d{7}/", $s->ref)) {
					$ss_gv_per[]=$s;
				} elseif (preg_match("/^34WMP\d{7}/", $s->ref)) {
					$ss_gv_mel2[]=$s;
				}
			} else if (!empty($s->trans[0]) && $s->trans[0]->org_id == Org::ORGID_COURIER_D2Z && empty($s->mdata['direct_courier'])) {
				if($s->trans[0]->status > 10) $ss_d2z[] = $s;
			} else if (!empty($s->trans[0]) && $s->trans[0]->org_id == Org::ORGID_COURIER_UBI && empty($s->mdata['direct_courier'])) {
				if($s->trans[0]->status > 10) $ss_ubi[] = $s;
			} else if (!empty($s->trans[0]) && $s->trans[0]->org_id == Org::ORGID_COURIER_FASTWAY && empty($s->mdata['direct_courier'])) {
				$ss_fsw[] = $s;
			} else if (!empty($s->trans[0]) && $s->trans[0]->org_id == Org::ORGID_COURIER_DFE_TOP && empty($s->mdata['direct_courier'])) {
				$ss_dfe[] = $s;
			} else {
				$os[]=$s;
			}
		}
		if (!empty($ss)) {
			$apa = new AusPostAPI('syd');
			$this->logAupostManifestForDirect($ss, $apa, $pces);
		}
		if (!empty($ss_stone)) {
			$apa= new AusPostAPI('stone');
			$this->logAupostManifestForDirect($ss_stone, $apa, $pces);
		}
		if (!empty($ss_mel)) {
			$apa= new AusPostAPI('mel');
			$this->logAupostManifestForDirect($ss_mel, $apa, $pces);
		}
		if (!empty($ss_bri)) {
			$apa= new AusPostAPI('bne');
			$this->logAupostManifestForDirect($ss_bri, $apa, $pces);
		}
		if (!empty($ss_per)) {
			$apa= new AusPostAPI('per');
			$this->logAupostManifestForDirect($ss_per, $apa, $pces);
		}

		if (!empty($ss_gv_syd)) {
			$apa= new GvAusPostAPI('GVSYD');
			$this->logGVAupostManifestForDirect($ss_gv_syd, $apa, $pces);
		}
		if (!empty($ss_gv_mel)) {
			$apa= new GvAusPostAPI('GVMEL');
			$this->logGVAupostManifestForDirect($ss_gv_mel, $apa, $pces);
		}
		if (!empty($ss_gv_bne)) {
			$apa= new GvAusPostAPI('GVBNE');
			$this->logGVAupostManifestForDirect($ss_gv_bne, $apa, $pces);
		}
		if (!empty($ss_gv_per)) {
			$apa= new GvAusPostAPI('GVPER');
			$this->logGVAupostManifestForDirect($ss_gv_per, $apa, $pces);
		}
		if (!empty($ss_gv_mel2)) {
			$apa= new GvAusPostAPI('GVMEL2');
			$this->logGVAupostManifestForDirect($ss_gv_mel2, $apa, $pces);
		}


		if (!empty($ss_ini)) {
			$imConsolService->funcDoAuspostIntManifest($ss_ini,$pces);
		}

		if (!empty($ars)) {
			$arrayPrefix2ShipmentArray = $imConsolService->funcArrayPrefix2ShipmentArray($ars);
			foreach($arrayPrefix2ShipmentArray as $Prefix => $ShipmentArray){
				$imConsolService->doAupostReturnManifest($ShipmentArray,$Prefix);
			}
		}


		if (!empty($aes)) {
			// $this->doAupostExpressManifest($aes, $cn);
			$arrayPrefix2ShipmentArray = $imConsolService->funcArrayPrefix2ShipmentArray($aes);
			foreach($arrayPrefix2ShipmentArray as $Prefix => $ShipmentArray){
				$imConsolService->doAupostExpressManifest($ShipmentArray,$Prefix);
			}
		}


		
		if (!empty($ss_d2z)) {
			$this->logD2zManifestForDirect($ss_d2z);
		}
		if (!empty($ss_ubi)) {
			$this->logUbiManifestForDirect($ss_ubi);
		}
		if (!empty($ss_fsw)) {
			$this->logFastwayManifestForDirect($ss_fsw);
		}
		if (!empty($ss_dfe)) {
			$this->logDFEManifestForDirect($ss_dfe);
		}
		// foreach ($os as $s) {
		// 	$s->cbwf=($s->cbwf^32)&$s->cbwf;
		// 	$s->update(['cbwf']);
		// }
	}

	public function logD2zManifestForDirect($sst)
	{

		$d2z = new D2zShipAPI('auto');
		$max_ppg = 500;
		$pgs = ceil(count($sst) / $max_ppg);

		for($pg = 0; $pg < $pgs; $pg++){
			$shipments = array_slice($sst, $pg * $max_ppg, $max_ppg);
			// fix d2z use reserved connote number range
			foreach ($shipments as $shipment) {
				if ($shipment->trans[0]->status == 10) $needCreate[] = $shipment;
			}
			if (!empty($needCreate)) $result = $d2z->createConsignments($needCreate, true);
			$result = $d2z->allocate_shipments($shipments, 'DC_'.date('YmdHis').($pgs>1? '-'.$pg : ''));
			if (!empty($result['responseMessage']) && in_array($result['responseMessage'], ['Shipment allocation Successful', 'Shipment Allocated Successfully'])) {
				$transaction=Yii::app()->db->beginTransaction();
				try {
					foreach ($shipments as $s) {
						$ts = Tranship::model()->find('pid = :id', [':id' => $s->id]);
						$ts->mdata['oid'] = Org::ORGID_COURIER_D2Z;
						if ($ts->save()) {
							$s->mdata['direct_courier'] = 1;
							$s->cbwf = ($s->cbwf ^ 32) & $s->cbwf;
							$s->update(['meta', 'cbwf']);
						}
					}
					$transaction->commit();
				} catch (Exception $ex) {
					$transaction->rollback();
					throw $ex;
				}
			}
		}
	}

	public function logUbiManifestForDirect($sst)
	{
		$imConsolService = new ImConsolService();
		$max_ppg = 300;
		$pgs = ceil(count($sst) / $max_ppg);

		for($pg = 0; $pg < $pgs; $pg++){
			$shipments = array_slice($sst, $pg * $max_ppg, $max_ppg);
			$err = $imConsolService->doUbiManifest($shipments);
			if(empty($err)){
				$transaction=Yii::app()->db->beginTransaction();
				try {
					foreach ($shipments as $s) {
						$s->mdata['direct_courier'] = 1;
						$s->cbwf = ($s->cbwf ^ 32) & $s->cbwf;
						$s->update(['meta', 'cbwf']);
					}
					$transaction->commit();
				} catch (Exception $ex) {
					$transaction->rollback();
					throw $ex;
				}
			}
		}
	}

	public function logFastwayManifestForDirect($sst){
		$fssSyd = [];
		$fssMel = [];
		$fssArr = [];
		foreach ($sst as $key => $s) {
				$orgRate = null;
				if(!empty($s->mdata['org_rate_id']))
				{
					$orgRate = OrgRate::model()->findByPk($s->mdata['org_rate_id']);
				}

				if(empty($orgRate)||!preg_match('/mel/i', $orgRate->code))
				{
					$fssSyd[] = $s;
				}else
				{
					$fssMel[] = $s;
				}
		}

		$fssArr = [[$fssSyd,'syd'],[$fssMel,'mel']];
		$err = ['Fastway Manifest Error'];
		$fw = new FastwayAPI(true);


		foreach ($fssArr as $key => $fss)
		{
			//lodge manifest
			$ms = [];
			foreach($fss as $s){
				if($s->trans[0]->status == 10){
					$ms[] = $s;
				}
			}


			$result = $fw->ftpManifest($ms,$fss[1]);
			if($result == false) return;

			$transaction=Yii::app()->db->beginTransaction();
			try { //push events
				foreach($fss[0] as $s){
					$result = $fw->addTracking($s->ref, 'PP2', time() - rand(1800, 3600));
					$result = $fw->addTracking($s->ref, 'PP5', time());
					if ($result) {
						$s->mdata['direct_courier'] = 1;
						$s->cbwf = ($s->cbwf ^ 32) & $s->cbwf | 64;
						$s->update(['meta', 'cbwf']);
					}
				}
				$transaction->commit();
			} catch (Exception $ex) {
				$transaction->rollback();
				throw $ex;
			}
		}
	}

