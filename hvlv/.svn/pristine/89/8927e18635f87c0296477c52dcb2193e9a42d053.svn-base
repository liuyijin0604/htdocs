	public function autoResendUBIManifest()
	{
		$tr = Tranship::model()->findAll("org_id = 3079 and (connote like '33G7K%' or connote like '33G7L%' or connote like '349PU%' or connote like '349PV%') and json_value(meta,'$.oid') is null and id >= 18150883");
		foreach ($tr as $key => $t) {
			$p = $t->imparcel;
			if(!empty($p->mdata['updated_ubi_weight'])&&$p->status!=ImParcel::STATE_CANCELLED)
			{
				$ubi=new UbiAPI(false, false);
				$result=$ubi->manifestAU([$p]);
				if (is_object($result)) {
					if ($result->status=="Failure"||$result->status=='Failed'||$result->status=="Partial Success") {
						$err[]=$result->message;
					}else
					{
						$shipmentRef = $result;
						$transaction = Yii::app()->db->beginTransaction();
						try {
							$ref= substr($shipmentRef->trackingNo, 0, -11);
							$s=$p;
							$trans = $s->trans;
							$tranship = end($trans);
							$orgId = $tranship->org_id;
							$tranship->mdata['oid'] = Org::ORGID_COURIER_UBI;
							$tranship->cost= number_format($ubi->getCost($s), 2, '.', '');
							$tranship->save();

							if(empty($mani))
							{
								$mani = new Manifest;
								$mani->type = 90;
								$mani->fwd_id = $orgId;
								$mani->ref = date('Y-m-d');
								$mani->save();
							}
							$mm = new ManiMap;
							$mm->mani_id = $mani->id;
							$mm->fid = $s->id;
							$mm->model = 'ImParcel';
							$mm->status = 10;
							$mm->mdata['mani_time'] = date('Y-m-d H:i:s');
							$mm->save();
							$s->mdata['manifest_weight'] = ceil($s->weight);
							$s->save();
							$transaction->commit();
						} catch (Exception $ex) {
							$transaction->rollback();
							Log::log2file("UBI".$cn->no."=>".$ex->getMessage(), "transaction_err_log", "transaction");
							throw $ex;
						}
					}
				}
			}
		}
	}

	public function updateTaskNoticeMessage()
	{
		$tlaTaskUsers = TlaTaskUser::model()->with(['task'])->findAll(['condition'=>'task.type != 10 and t.status <100 and is_notice = 0 and create_time>"2022-04-05"','group'=>'task_id']);
		$messages = [];
		foreach ($tlaTaskUsers as $key => $obj) {
			if(!empty($messages[$obj->user_id][$obj->task->getType()]))
			{
				$messages[$obj->user_id][$obj->task->getType()] += 1;
			}else
			{
				$messages[$obj->user_id][$obj->task->getType()] = 1;
			}
		}
		foreach ($tlaTaskUsers as $key => $obj) {
			$obj->is_notice = 1;
			$obj->save();
		}

		foreach ($messages as $userId => $m) {
			$msg = "You have new ";
			$taskMessage = Message::model()->find('to_id = :userId and type =1',[":userId"=>$userId]);
			if(empty($taskMessage))
			{
				$taskMessage = new Message();
				foreach ($m as $type => $number) {
					$msg.=$type.":".$number.";";
				}
			}else
			{
				if($taskMessage->status==Message::NEWMESSAGE)
				{
					$msgRe = str_replace("You have new ", '', $taskMessage->msg);
					$msgArr = explode(";", $msgRe);
					foreach ($msgArr as $key2 => $value2) {
						if(!empty($value2))
						{
							$dataArr=explode(":", $value2);
							if(!empty($m[$dataArr[0]]))
							{
								$m[$dataArr[0]] += intval($dataArr[1]);
							}else
							{
								$m[$dataArr[0]] = $dataArr[1];
							}
						}
					}
				}

				foreach ($m as $type => $number) {
						$msg.=$type.":".$number.";";
				}
			}
			$taskMessage->from_id = 0;
			$taskMessage->to_id = $userId;
			$taskMessage->type = 1;
			$taskMessage->msg = $msg;
			$taskMessage->status = 0;
			$taskMessage->time = date('Y-m-d H:i:s');
			$taskMessage->save();
		}
	}

	public function checkConsolUpdateArrival()
	{
		$consols = ImcoConsol::model()->findAll('json_value(meta,"$.updateArrival]") = 1');

		foreach ($consols as $key => $model)
		{
			if(strtotime($model->etd)<strtotime(date('Y-m-d')))
			{
				$transaction=Yii::app()->db->beginTransaction();
				try {
					$model->updateFlight(true);
					$model->updateSea();
					$model->mdata['updateArrival'] = 0;
					$model->update(['meta']);
					$transaction->commit();
				} catch (Exception $ex) {
					$transaction->rollback();
					throw $ex;
				}
			}
		}
	
	}

