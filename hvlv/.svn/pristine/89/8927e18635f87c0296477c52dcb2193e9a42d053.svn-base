				// $this->syncTollTrack();
				// $this->log('Finish syncTollTrack');
			}

			if ($this->hr % 1 == 0 && $this->mn == 0) {
				$this->log('Start deconciliation times');
				$this->prepareDeconciliationTimes();
				$this->log('Finish deconciliation times');
			}

			if ($this->hr == 10 && $this->mn == 15) {
				$this->sendInvoiceTermDue();
			}

			if ($this->hr == 4 && $this->mn == 00){
				$this->updateCargoProcessOTInvoice();
			}

			if ($this->hr == 4 && $this->mn == 15 ){
				$this->manifestToGV();
