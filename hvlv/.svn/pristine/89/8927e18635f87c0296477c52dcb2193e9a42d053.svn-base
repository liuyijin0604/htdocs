		}
	}

	public function doCin7Out($task)
	{
		$task->refresh();
		// $task->mdata['synced' . $task->status] = true;
		// $task->bwf = ($task->bwf ^ 256) & $task->bwf;
		// $task->update('meta', 'bwf');

		// cin7 out
		// write back tracking no
		$cin7_task = WmsTaskMap::model()->find('task_id = :id AND platform = "cin7"', [':id' => $task->id]);
		if (!empty($cin7_task)) {
			if ($task->status == 99) {
				$cust = WmsAPI::model()->find('org_id = :org_id', [':org_id' => $task->job->org_id]);
				$config = array(
					'user' => $cust->api_key,
					'key' => $cust->api_secret,
					'org_id' => $cust->org_id,
				);
				$cin7 = new Cin7API($config);
				// if (!empty($task->deliveryTask->mdata['shipment_id'])) {
				// 	// foreach ($task->actionTask->items as $item) {
				// 	// 	$stock = WmsStock::model()->findByPk($item->mdata['si']);
				// 	// 	$sku = $stock->prod->getSku($cust->org_id);
				// 	// 	if (empty($items[$sku])) {
				// 	// 		$items[$sku] = 0;
				// 	// 	}
				// 	// 	$items[$sku] += $item->mdata['uq'];
				// 	// }

				// 	$vcourier = $task->_getCourierNameAndRef();
				// 	$refs = $vcourier[0];
				// 	$courier = $vcourier[1];
				// 	if (!empty($courier)) {
				// 		$cin7->completeOrder($cin7_task->fid, $courier, $refs);
				// 	}
				// }

				if (!empty($task->deliveryTask)) {
					$vcourier = $task->_getCourierNameAndRef();
					$refs = $vcourier[0];
					$courier = $vcourier[1];
					$result = $cin7->completeOrder($cin7_task->fid, $courier, $refs);
				}
			} else if ($task->status == 10) {
				$cust = WmsAPI::model()->find('org_id = :org_id', [':org_id' => $task->job->org_id]);
				$config = array(
					'user' => $cust->api_key,
					'key' => $cust->api_secret,
					'org_id' => $cust->org_id,
				);
				$cin7 = new Cin7API($config);
				$result = $cin7->errorOrder($cin7_task->fid);
			} else if ($task->status == 20 || $task->status == 30) {
				$cust = WmsAPI::model()->find('org_id = :org_id', [':org_id' => $task->job->org_id]);
				$config = array(
					'user' => $cust->api_key,
					'key' => $cust->api_secret,
					'org_id' => $cust->org_id,
				);
				$cin7 = new Cin7API($config);
				$result = $cin7->receiverOrder($cin7_task->fid);
			}
		}

		if (isset($result['success']) && $result['success'] == true) {
			$task->mdata['synced' . $task->status] = true;
			$task->bwf = ($task->bwf ^ 256) & $task->bwf;
			$task->update('meta', 'bwf');
		}
	}

	public function doUflOut($task)
	{
		$task->refresh();
		$task->mdata['synced' . $task->status] = true;
		$task->bwf = ($task->bwf ^ 256) & $task->bwf;
		$task->update('meta', 'bwf');

		// complete hook ufl
		if (!empty($task->mdata['api_hook']) && empty($task->mdata['api_comp'])){
			sleep(1);
			if($task->mdata['api_hook'] == 'ufl'){
				$api = new UflAPI;
				if (!empty($task->mdata['sourceLinkId'])) {
					$data = [
						'completedDate' => date('Y-m-d H:i:s'),
						'completedTimeZone' => date('GMT+8'),
						'sourceLinkId' => $task->mdata['sourceLinkId'],
						'orderSPT' => $task->mdata['orderSPT'],
					];
					if (!empty($task->deliveryTask->mdata['shipment_id'])) {
						$vcourier = $task->_getCourierNameAndRef();
						$data['courierBillNo'] = implode(', ', $vcourier[0]);
						$data['courierName'] = $vcourier[1];
					}
				} else {
					$data = [];
				}
				$r = $api->outboundUpdate($task->mdata['api_meta']['customer'], $task->ref, 'RS', $data);
				if(!empty($r) && preg_match('/success/', $r['result'])){
					$task->mdata['api_comp'] = 1;
					$task->updateMeta();
				} else {
					$task->bwf |= 256;
					$task->update('bwf');
				}
			}
		}
	}

	public function checkBackOrderInventory()
	{
		$tasks = WmsTask::model()->with('job')->findAll('t.type IN (3020,3030) AND t.is_request = 1 AND job.org_id IN (' . implode(',', WmsTask::$checkBackOrders) . ') AND t.status = 10');
		echo count($tasks) . PHP_EOL;
		foreach ($tasks as $task) {
			$flag = true;
			foreach ($task->items as $item) {
				if (empty($item->mdata['pi'])) {
					if (empty($item->mdata['sn'])) {
						$flag = false;
						continue;
					}

					$prod = WmsProd::model()->find('(ean = :ean OR name = :ean) AND status = 1', [':ean' => $item->mdata['sn']]);
					if (empty($prod)) {
						$prod = WmsProd::model()->with('orgs')->find('orgs.sku = :sku AND status = 1', [':sku' => $item->mdata['sn']]);
					}
					if (empty($prod)) {
						$flag = false;
						continue;
					}

					$item->mdata['pi'] = $prod->id;
					$item->mdata['sn'] = $prod->name;
					$item->update('meta');
				}

				$stock = WmsStock::model()->find(['select' => 'SUM(qty) AS qty, SUM(qty_res) AS qty_res', 'condition' => 'prod_id = :prod_id AND org_id = :org_id', 'params' => [':prod_id' => $item->mdata['pi'], ':org_id' => $task->job->org_id]]);
				if ($stock->qty - $stock->qty_res < $item->mdata['uq']) {
					$item->mdata['nt'] = 'short, only have ' . ($stock->qty - $stock->qty_res);
					$item->update('meta');
					$flag = false;
					continue;
				}
			}

			// if (!empty($task->mdata['errs'])) {
			// 	foreach ($task->mdata['errs'] as $err) {
			// 		if (preg_match('/Product not found/i', $err['message'])) {
			// 			$flag = false;
			// 		}
			// 	}
			// }

			if ($flag) {
				echo $task->id . PHP_EOL;
				$task->status = 20;
				$task->update('status');
				$task->refresh();
				foreach ($task->items as $item) {
					$stocks = WmsStock::model()->findAll('prod_id = :prod_id AND org_id = :org_id AND qty - qty_res > 0', [':prod_id' => $item->mdata['pi'], ':org_id' => $task->job->org_id]);
					$qty = $item->mdata['uq'];
					foreach ($stocks as $stock) {
						if ($qty <= 0) {
							break;
						}
						$uq = min($qty, $stock->availQty());

						$new_item = new WmsTaskItem;
						$new_item->task_id = $item->task_id;
						$new_item->op_id = $item->op_id;
						$new_item->ts = $item->ts;
						$new_item->mdata = [
							'si' => $stock->id,
							'sn' => $stock->prod->name,
							'pq' => '',
							'cq' => '',
							'uq' => $uq,
							'pli' => '',
							'pl' => '',
							'nt' => '',
							'pi' => $stock->prod->id,
						];
						$new_item->save();
						$new_item->toStock();
						$qty -= $uq;
					}
					$item->del = 1;
					$item->meta_changed = false;
					$item->save();
				}
			}
		}
	}

	public function sendShortReport()
	{
		$tasks = WmsTask::model()->with('job')->findAll('t.type IN (3020,3030) AND t.is_request = 1 AND job.org_id IN (' . Org::ORGID_3PL_LIFESTYLE . ') AND t.status = 10');
		if (empty($tasks)) return;

		$xls = new oExcel;
		$i = 1;
		$xls->setColWidth(array(20,15,30,30,15,50,10,10));
		$xls->addRow($i++, ['Order Create date', 'Ref #', 'Email', 'Status', 'SKU', 'Product Name', 'Requested Qty', 'Stock Qty']);
		foreach ($tasks as $task) {
			foreach ($task->items as $item) {
				if (empty($item->mdata['pi']) && empty($item->mdata['sn'])) continue;

				$prod = WmsProd::model()->findByPk($item->mdata['pi']);
				if (!empty($prod)) {
					$stock = WmsStock::model()->find(['select' => 'SUM(qty) AS qty, SUM(qty_res) AS qty_res', 'condition' => 'prod_id = :prod_id AND org_id = :org_id', 'params' => [':prod_id' => $item->mdata['pi'], ':org_id' => $task->job->org_id]]);
					if ($stock->qty - $stock->qty_res < $item->mdata['uq']) {
						$sku = WmsProdOrg::model()->find('prod_id = :prod_id AND org_id = :org_id', [':prod_id' => $item->mdata['pi'], ':org_id' => $task->job->org_id]);
						$xls->addRow($i++, [date('Y-m-d', strtotime($task->createlog->time)), $task->ref, @$task->deliveryTask->mdata['cnee']['email'], $task->getEasyshipStatus(), @$sku->sku, $prod->name, intval($item->mdata['uq']), intval($stock->qty - $stock->qty_res)]);
					}
				} else {
					$xls->addRow($i++, [date('Y-m-d', strtotime($task->createlog->time)), $task->ref, @$task->deliveryTask->mdata['cnee']['email'], $task->getEasyshipStatus(), $item->mdata['sn'], $item->mdata['sn'], intval($item->mdata['uq']), 0]);
				}
			}
		}
		$xls->output('daily_report_' . date('Ymd') . '.xlsx', null, false);

		$emailLog = new Emailog();
		$emailLog->type = Emailog::UFL_SHORT_REPORT;
		$emailLog->fid = 0;
		$emailLog->dt = date('Y-m-d H:i:s');
		$emailLog->to_id = 0;
		$emailLog->status = 10;
		$emailLog->prepTemplate();
		$emailLog->subject = $emailLog->tpl->subject;
		$emailLog->body = $emailLog->tpl->getContent();
		$emailLog->sendUFLShortReport('daily_report_' . date('Ymd') . '.xlsx', null, false);

		unlink('daily_report_' . date('Ymd') . '.xlsx');
	}

	public function sendAvailableNoticeToCnee()
	{
		$shipments = ImParcel::model()->with(["consol","process"])->findAll("json_value(consol.meta,'$.available_date') is not null and (to_days(json_value(consol.meta,'$.available_date'))) >= to_days('2019-12-12') and json_value(t.meta,'$.is_send_available_notice') is null and (t.bwf & 128 >0 or t.bwf & 64 >0) and process.status !=24");
		$emailService = new EmailService();
		foreach ($shipments as $key => $p) {
			try
			{
				$emailService->sendAvailableNoticeEmail($p);
			}catch(Exception $ex)
			{
				$this->log(" send Email Error ".$p->hbn);
			}
		}
	}

	public function refreshReconciliationLine()
	{
		$lines = ReconciliationLine::model()->findAll('consol_id = 0 and shipment_id >0');
		try 
		{
			foreach ($lines as $line) 
			{
			 	$line->getConsol();
			}
				

		} catch (Exception $ex) {

			Log::log2file("refreshReconciliationLine".$line->shipment_id."=>".$ex->getMessage(), "transaction_err_log", "transaction");
			throw $ex;
		}
	}

	public function uflSendComplete()
	{
		$tasks = WmsTask::model()->with('job')->findAll('t.type IN (3020,3030) AND t.is_request = 1 AND job.org_id IN (' . implode(',', Org::$easyships) . ') AND t.status = 99 AND JSON_VALUE(t.meta, "$.api_comp") = 1 AND JSON_VALUE(t.meta, "$.api_ship") IS NULL');
		foreach ($tasks as $task) {
			$task->easyshipScanOut();
			sleep(1);
		}
	}

	public function checkPalletIn()
	{
		$tasks = WmsTask::model()->findAll('type = 1010 AND status = 99 AND id > 220000 AND JSON_VALUE(meta, "$.dpmt") = "大货" AND JSON_VALUE(meta, "$.email_sent") IS NULL AND compl_time >= "2020-02-01"');
		function md_array_unique($a) {
			$ra = [];
			foreach ($a as $k => $v) {
				if (is_array($v)) {
					$ra = array_merge($ra, md_array_unique($v));
				} else {
					$ra[] = $v;
				}
			}
			return array_unique($ra);
		};
		foreach ($tasks as $model) {
			$xls = new oExcel;
			$i = 1;
			$xls->setColWidth(array(30, 15, 15, 15, 15, 10, 10, 15, 10, 15, 10, 15, 10, 10, 30));
			$xls->addRow($i++, array('Comparison Job #' . $model->job->no, $model->getNo()));
			$xls->addRow($i++, array('Date: ' . date('Y-m-d')));
			$xls->addRow($i++, array('Prod. Name', 'Prod. Brand', 'Prod. Model', 'Prod. EAN', 'Expiry Date', 'Batch', 'Request Cartons', 'Request Unit', 'Actual Cartons', 'Actual Unit', 'Carton Diff', 'Unit Diff', 'Pallets', 'Mixed Pallets', 'Notes'));
			$rows = [];
			$eb = 9;
			foreach ($model->items as $k => $itm) {
				if (empty($itm->mdata['cq']) && empty($itm->mdata['uq'])) {
					continue;
				}

				if (!empty($itm->mdata['si'])) {
					$stock = WmsStock::model()->findByPk($itm->mdata['si']);
				} else {
					$stock = WmsStock::creget($model->job->org_id, $itm->mdata);
				}

				if(!empty($itm->mdata['uq']) && empty($itm->mdata['cq'])){
					$pp = WmsProdPack::model()->find('type = 10 AND prod_id = :pid', [':pid' => $stock->prod_id]);
					if(!empty($pp) && $pp->qty > 0 && ($itm->mdata['uq'] % $pp->qty) == 0){
						$itm->mdata['cq'] = $itm->mdata['uq'] / $pp->qty;
					}
				}

				$seb = $stock->getStockEB($eb);
				if (empty($rows[$seb])) {
					$rows[$seb] = [$stock->prod->name, $stock->prod->brand, $stock->prod->model, '="' . $stock->prod->ean . '"', $itm->mdata['ex'], $stock->batch, floatval(trim($itm->mdata['cq'])), floatval(trim($itm->mdata['uq'])), 0, 0, 0, 0, 0, 0, ''];
				} else {
					$rows[$seb][6] += floatval(trim($itm->mdata['cq']));
					$rows[$seb][7] += floatval(trim($itm->mdata['uq']));
				}
			}

			$plts = [];
			$mplts = [];
			foreach ($model->actionTask->items as $k => $itm) {
				if (empty($itm->mdata['cq']) && empty($itm->mdata['uq']) && empty($itm->stockLedgers)) {
					continue;
				}

				if (empty($itm->mdata['uq'])) {
					$itm->mdata['uq'] = 0;
					foreach ($itm->stockLedgers as $ledger) {
						if ($ledger->location_id > WmsLocation::WMS_LOCATION_MAX_MAGIC_ID) {
							$itm->mdata['uq'] += intval($ledger->qty_out);
						}
					}
				}

				if (!empty($itm->mdata['si'])) {
					$stock = WmsStock::model()->findByPk($itm->mdata['si']);
				} else {
					$stock = WmsStock::creget($model->job->org_id, $itm->mdata);
				}

				if(!empty($itm->mdata['uq']) && empty($itm->mdata['cq'])){
					$pp = WmsProdPack::model()->find('type = 10 AND prod_id = :pid', [':pid' => $stock->prod_id]);
					if(!empty($pp) && $pp->qty > 0 && ($itm->mdata['uq'] % $pp->qty) == 0){
						$itm->mdata['cq'] = $itm->mdata['uq'] / $pp->qty;
					}
				}
				
				if ($eb == 9) {
					$seb = $stock->org_id . '-' . $stock->prod_id;
				} else {
					$seb = $stock->org_id . '-' . $stock->prod_id . $itm->mdata['ex'] . $stock->batch;
				}
				if (empty($rows[$seb])) {
					$rows[$seb] = [$stock->prod->name, $stock->prod->brand, $stock->prod->model, '="' . $stock->prod->ean . '"', $itm->mdata['ex'], $stock->batch, 0, 0, floatval(trim($itm->mdata['cq'])), floatval(trim($itm->mdata['uq'])), 0, 0, 1, 0, $itm->mdata['nt']];
				} else {
					$rows[$seb][8] += floatval(trim($itm->mdata['cq']));
					$rows[$seb][9] += floatval(trim($itm->mdata['uq']));
					$rows[$seb][14] .= $itm->mdata['nt'];
				}
				if (!isset($plts[$seb])) {
					$plts[$seb] = [];
				}

				$plts[$seb][] = $itm->mdata['pl'];
				if (WmsStockLocation::isMixedPallet($itm->mdata['pl'])) {
					if (!isset($plts[$seb])) {
						$mplts[$seb] = [];
					}

					$mplts[$seb][] = $itm->mdata['pl'];
				}
			}
			ksort($rows);
			$diffs = [];
			foreach ($rows as $seb => $r) {
				if ($r[7] == $r[9]) continue;
				$diffs[] = $r;
			}
			$model->mdata['email_sent'] = true;
			$model->updateMeta();
			if (empty($diffs)) {
				continue;
			}
			$model->bwf |= 512;
			$model->update('bwf');

			foreach ($diffs as $seb => $r) {
				$r[10] = '=I' . $i . '-G' . $i;
				$r[11] = '=J' . $i . '-H' . $i;
				$r[12] = empty($plts[$seb]) ? 0 : sizeof(array_unique($plts[$seb]));
				$r[13] = empty($mplts[$seb]) ? 0 : sizeof(array_unique($mplts[$seb]));
				$xls->addRow($i++, $r);
			}
			$li = $i - 1;
			$xls->addRow($i++, ['', '', '', '', '', '', '=SUM(G4:G' . $li . ')', '=SUM(H4:H' . $li . ')', '=SUM(I4:I' . $li . ')', '=SUM(J4:J' . $li . ')', '=SUM(K4:K' . $li . ')', '=SUM(L4:L' . $li . ')', sizeof(md_array_unique($plts)), sizeof(md_array_unique($mplts))]);
			$xls->output('comparison_' . $model->job->no . '-' . $model->getNo() . '.xlsx', null, false);

			$table = '<table class="chart" border="1" cellspacing="0"><tr><th>Prod. Name</th><th>Prod. Brand</th><th>Prod. Model</th><th>Prod. EAN</th><th>Expiry Date</th><th>Batch</th><th>Request Cartons</th><th>Request Unit</th><th>Actual Cartons</th><th>Actual Unit</th><th>Carton Diff</th><th>Unit Diff</th><th>Pallets</th><th>Mixed Pallets</th></tr>';
			$total = ['G' => 0, 'H' => 0, 'I' => 0, 'J' => 0, 'K' => 0, 'L' => 0];
			foreach ($diffs as $seb => $r) {
				$r[10] = $r[8] - $r[6];
				$r[11] = $r[9] - $r[7];
				$r[12] = empty($plts[$seb]) ? 0 : sizeof(array_unique($plts[$seb]));
				$r[13] = empty($mplts[$seb]) ? 0 : sizeof(array_unique($mplts[$seb]));
				$total['G'] += $r[6];
				$total['H'] += $r[7];
				$total['I'] += $r[8];
				$total['J'] += $r[9];
				$total['K'] += $r[10];
				$total['L'] += $r[11];
				$table .= '<tr><td>' . $r[0] . '</td><td>' . $r[1] . '</td><td>' . $r[2] . '</td><td>' . $r[3] . '</td><td>' . $r[4] . '</td><td>' . $r[5] . '</td><td>' . $r[6] . '</td><td>' . $r[7] . '</td><td>' . $r[8] . '</td><td>' . $r[9] . '</td><td>' . $r[10] . '</td><td>' . $r[11] . '</td><td>' . $r[12] . '</td><td>' . $r[13] . '</td></tr>';
			}
			$table .= '<tr><td></td><td></td><td></td><td></td><td></td><td></td><td>' . $total['G'] . '</td><td>' . $total['H'] . '</td><td>' . $total['I'] . '</td><td>' . $total['J'] . '</td><td>' . $total['K'] . '</td><td>' . $total['L'] . '</td></tr></table>';

			$emailLog = new Emailog();
			$emailLog->type = Emailog::WMS_COMPARISON_REPORT;
			$emailLog->fid = $model->id;
			$emailLog->dt = date('Y-m-d H:i:s');
			$emailLog->to_id = 0;
			$emailLog->status = 10;
			$emailLog->prepTemplate();
			$emailLog->tpl->assignThese([
				'DETAIL_TABLE' => $table,
			]);
			$emailLog->subject = $emailLog->tpl->subject;
			$emailLog->body = $emailLog->tpl->getContent();
			$emailLog->sendWmsComparisonReportEmail('comparison_' . $model->job->no . '-' . $model->getNo() . '.xlsx');

			unlink('comparison_' . $model->job->no . '-' . $model->getNo() . '.xlsx');
		}
	}

	public function checkStockRecord()
	{
		$table = '';

		// task item vs ledger
		$sql = 'select wti.task_id, json_value(wti.meta, "$.uq") as item_qty, qty_in, qty_out from wms_task_item wti join wms_stock_ledger wsl on wti.id = wsl.ti_id and wsl.location_id = 4 where json_value(wti.meta, "$.uq") != wsl.qty_in and json_value(wti.meta, "$.uq") != wsl.qty_out and wti.task_id > 100000 and wti.del = 0 and wti.task_id not in (select id from wms_task where status = 10)';
		$rs = Yii::app()->db->createCommand($sql)->queryAll();
		if (!empty($rs)) {
			$table .= '<table class="chart" border="1" cellspacing="0"><tr><th>Task/ACT ID</th><th>Item Qty</th><th>Qty In</th><th>Qty Out</th></tr>';
			foreach ($rs as $r) {
				$table .= '<tr><td>' . $r['task_id'] . '</td><td>' . $r['item_qty'] . '</td><td>' . $r['qty_in'] . '</td><td>' . $r['qty_out'] . '</td></tr>';
			}
			$table .= '</table>';
		}

		// ledger vs stock
		$sql = 'SELECT stock_id, wp.name, ws.qty as ws_qty, sum(wsl.qty_in - wsl.qty_out) as wsl_qty FROM wms_stock ws join wms_stock_ledger wsl on ws.id = wsl.stock_id and wsl.location_id > 10 join wms_prod wp on ws.prod_id = wp.id group by ws.id having ws_qty != wsl_qty';
		$rs = Yii::app()->db->createCommand($sql)->queryAll();
		if (!empty($rs)) {
			$table .= '<table class="chart" border="1" cellspacing="0"><tr><th>Stock ID</th><th>Prod Name</th><th>Stock Qty</th><th>Ledger Qty</th></tr>';
			foreach ($rs as $r) {
				$table .= '<tr><td>' . $r['stock_id'] . '</td><td>' . $r['name'] . '</td><td>' . $r['ws_qty'] . '</td><td>' . $r['wsl_qty'] . '</td></tr>';
			}
			$table .= '</table>';
		}

		// ledger reserve vs stock reserve
		$sql = 'SELECT stock_id, wp.name, ws.qty_res as ws_qty, sum(wsl.qty_in - wsl.qty_out) as wsl_qty FROM wms_stock ws join wms_stock_ledger wsl on ws.id = wsl.stock_id and wsl.location_id = 4 join wms_prod wp on ws.prod_id = wp.id group by ws.id having ws_qty != wsl_qty and ws_qty > 0';
		$rs = Yii::app()->db->createCommand($sql)->queryAll();
		if (!empty($rs)) {
			$table .= '<table class="chart" border="1" cellspacing="0"><tr><th>Stock ID</th><th>Prod Name</th><th>Stock Res Qty</th><th>Ledger Res Qty</th></tr>';
			foreach ($rs as $r) {
				$table .= '<tr><td>' . $r['stock_id'] . '</td><td>' . $r['name'] . '</td><td>' . $r['ws_qty'] . '</td><td>' . $r['wsl_qty'] . '</td></tr>';
			}
			$table .= '</table>';
		}

		// location vs stock
		$sql = 'SELECT stock_id, wp.name, ws.qty as ws_qty, sum(wsl.qty) as wsl_qty FROM wms_stock ws join wms_stock_location wsl on ws.id = wsl.stock_id and wsl.location_id > 10 join wms_prod wp on ws.prod_id = wp.id group by ws.id having ws_qty != wsl_qty';
		$rs = Yii::app()->db->createCommand($sql)->queryAll();
		if (!empty($rs)) {
			$table .= '<table class="chart" border="1" cellspacing="0"><tr><th>Stock ID</th><th>Prod Name</th><th>Stock Qty</th><th>Location Qty</th></tr>';
			foreach ($rs as $r) {
				$table .= '<tr><td>' . $r['stock_id'] . '</td><td>' . $r['name'] . '</td><td>' . $r['ws_qty'] . '</td><td>' . $r['wsl_qty'] . '</td></tr>';
			}
			$table .= '</table>';
		}

		// location reserve vs stock reserve
		$sql = 'SELECT stock_id, wp.name, ws.qty_res as ws_qty, sum(wsl.qty) as wsl_qty FROM wms_stock ws join wms_stock_location wsl on ws.id = wsl.stock_id and wsl.location_id = 4 join wms_prod wp on ws.prod_id = wp.id group by ws.id having ws_qty != wsl_qty';
		$rs = Yii::app()->db->createCommand($sql)->queryAll();
		if (!empty($rs)) {
			$table .= '<table class="chart" border="1" cellspacing="0"><tr><th>Stock ID</th><th>Prod Name</th><th>Stock Res Qty</th><th>Ledger Res Qty</th></tr>';
			foreach ($rs as $r) {
				$table .= '<tr><td>' . $r['stock_id'] . '</td><td>' . $r['name'] . '</td><td>' . $r['ws_qty'] . '</td><td>' . $r['wsl_qty'] . '</td></tr>';
			}
			$table .= '</table>';
		}

		$emailog = new Emailog;
		$emailog->type = Emailog::WMS_STOCK_CHECK_REPORT;
		$emailog->fid = 0;
		$emailog->dt = date('Y-m-d H:i:s');
		$emailog->to_id = 0;
		$emailog->status = 10;
		$emailog->prepTemplate();
		$emailog->tpl->assignThese([
			'DETAIL_TABLE' => $table,
		]);
		$emailog->subject = $emailog->tpl->subject;
		$emailog->body = $emailog->tpl->getContent();
		$emailog->sendWmsStockCheckEmail();
	}

	public function sendWmsReport($test = false)
	{
		if (!empty($this->args[1])) {
			$test = $this->args[1];
		}
		$lists = array(
			array('feq' => 'consumer-backorder-feq', 'rec' => 'consumer-backorder-rec', 'flag' => 'consumer-backorder-sent', 'function' => 'getConsumerBackorder', 'email_type' => Emailog::WMS_CONSUMER_BACKORDER, 'subject' => 'Consumer Backorder '),

			array('feq' => 'retailer-backorder-feq', 'rec' => 'retailer-backorder-rec', 'flag' => 'retailer-backorder-sent', 'function' => 'getRetailerBackorder', 'email_type' => Emailog::WMS_RETAILER_BACKORDER, 'subject' => 'Retailer Backorder '),

			array('feq' => 'minimum-stock-alert-feq', 'rec' => 'minimum-stock-alert-rec', 'flag' => 'minimum-stock-alert-sent', 'function' => 'getMinimumStockAlert', 'email_type' => Emailog::WMS_MINIMUM_STOCK_ALERT, 'subject' => 'Minimum Stock Alert '),

			array('feq' => 'delivery-despatch-consumer-feq', 'rec' => 'delivery-despatch-consumer-rec', 'flag' => 'delivery-despatch-consumer-sent', 'function' => 'getDeliveryDespatchConsumer', 'email_type' => Emailog::WMS_DELIVERY_DESPATCH_CONSUMER, 'subject' => 'Delivery Despatch Consumer '),

			array('feq' => 'delivery-despatch-retailer-feq', 'rec' => 'delivery-despatch-retailer-rec', 'flag' => 'delivery-despatch-retailer-sent', 'function' => 'getDeliveryDespatchRetailer', 'email_type' => Emailog::WMS_DELIVERY_DESPATCH_RETAILER, 'subject' => 'Delivery Despatch Retailer '),

			array('feq' => 'inbound-delivery-advice-feq', 'rec' => 'inbound-delivery-advice-rec', 'flag' => 'inbound-delivery-advice-sent', 'function' => 'getInboundDeliveryAdvice', 'email_type' => Emailog::WMS_INBOUND_DELIVERY_ADVICE, 'subject' => 'Inbound Delivery Advice '),

			array('feq' => 'inbound-delivery-report-feq', 'rec' => 'inbound-delivery-report-rec', 'flag' => 'inbound-delivery-report-sent', 'function' => 'getInboundDeliveryReport', 'email_type' => Emailog::WMS_INBOUND_DELIVERY_REPORT, 'subject' => 'Inbound Delivery Report '),

			array('feq' => 'stock-on-hand-feq', 'rec' => 'stock-on-hand-rec', 'flag' => 'stock-on-hand-sent', 'function' => 'getStockOnHand', 'email_type' => Emailog::WMS_STOCK_ON_HAND, 'subject' => 'Stock On Hand Report '),

			array('feq' => 'hold-task-feq', 'rec' => 'hold-task-rec', 'flag' => 'hold-task-sent', 'function' => 'getHoldTask', 'email_type' => Emailog::WMS_HOLD_TASK, 'subject' => 'Hold Task Report '),
		);

		foreach ($lists as $v) {
			$orgs = Org::model()->findAll('JSON_VALUE(meta, "$.' . $v['feq'] . '") IS NOT NULL AND JSON_VALUE(meta, "$.' . $v['rec'] . '") IS NOT NULL');
			foreach ($orgs as $org) {
				if ($org->extra[$v['feq']] == 'daily' || ($org->extra[$v['feq']] == 'weekly' && in_array(date('N'), [1])) || ($org->extra[$v['feq']] == 'monthly' && in_array(date('d'), [1]))) {
					if (!empty($org->extra[$v['flag']]) && $org->extra[$v['flag']] == date('Y-m-d')) {
						continue;
					}
					$org->extra[$v['flag']] = date('Y-m-d');
					$org->updateMeta();

					$fn = Pcaw::{$v['function']}($org->id, false);
					$emailog = new Emailog;
					$emailog->type = $v['email_type'];
					$emailog->fid = 0;
					$emailog->dt = date('Y-m-d H:i:s');
					$emailog->to_id = $org->id;
					$emailog->status = 10;
					$emailog->prepTemplate();
					$emailog->subject = $v['subject'] . Pcaw::$feqs[$org->extra[$v['feq']]];
					$emailog->body = $emailog->tpl->getContent();
					$emailog->mdata['to'] = $test ? 'gero@toplogistics.com.au' : $org->extra[$v['rec']];
					if (file_exists($fn)) {
						$r = $emailog->sendWmsReport($fn);
						unlink($fn);
					} else {
						throw new Exception($fn . ' not found');
					}
				} else if ($org->extra[$v['feq']] == 'event') {
					$fns = Pcaw::{$v['function']}($org->id, false, null, true);
					foreach ($fns as $fn) {
						$emailog = new Emailog;
						$emailog->type = $v['email_type'];
						$emailog->fid = 0;
						$emailog->dt = date('Y-m-d H:i:s');
						$emailog->to_id = $org->id;
						$emailog->status = 10;
						$emailog->prepTemplate();
						$emailog->subject = $v['subject'] . $fn[1];
						$emailog->body = $emailog->tpl->getContent();
						$emailog->mdata['to'] = $test ? 'gero@toplogistics.com.au' : $org->extra[$v['rec']];
						if (file_exists($fn[0])) {
							$r = $emailog->sendWmsReport($fn[0]);
							unlink($fn[0]);
						} else {
							throw new Exception($fn[0] . ' not found');
						}
					}
				}
			}
		}
	}

	public function generate_3pl_dashboard_data($date = null, $to = null)
	{
		function filter($task) {
			if ((!empty($task->job->customer->extra['op_id']) && in_array($task->job->customer->extra['op_id'], WmsTask::$op)) || (!empty($task->job->customer->extra['sp_id']) && in_array($task->job->customer->extra['sp_id'], WmsTask::$op))) {
				return false;
			} else {
				return true;
			}
		}

		if (empty($date)) {
			$date = $this->prompt('From: ');
		}
		if (empty($to)) {
			$to = $this->prompt('To: ');
		}
		while (strtotime($date) < strtotime($to)) {
			// calculate create before 12 o'clock and complete after 0 o'clock
			$tasks1 = WmsTask::model()->with('createlog')->findAll('createlog.time <= :time1 AND t.is_request = 1 AND t.compl_time >= :time2 AND t.type IN (1010,1020,3020,3030)', [':time1' => date('Y-m-d 12:00:00', strtotime($date)), ':time2' => date('Y-m-d 00:00:00', strtotime($date))]);
			// calculate create after 12 o'clock and complete after 12 o'clock
			$tasks2 = WmsTask::model()->with('createlog')->findAll('createlog.time > :time1 AND createlog.time <= :time2 AND t.is_request = 1 AND t.compl_time > :time1 AND t.compl_time <= :time2 AND t.type IN (1010,1020,3020,3030)', [':time1' => date('Y-m-d 12:00:00', strtotime($date)), ':time2' => date('Y-m-d 23:59:59', strtotime($date))]);

			if (!empty(array_merge($tasks1, $tasks2))) {
				foreach (array_merge($tasks1, $tasks2) as $task) {
					if (filter($task)) continue;

					if (in_array($task->type, [1010,1020])) {
						$type = 'in';
					} else if (in_array($task->type, [3020,3030])) {
						$type = 'out';
					}

					if (empty($list[$date][$type . '_schd_task'])) {
						$list[$date][$type . '_schd_task'] = 0;
					}
					$list[$date][$type . '_schd_task'] += 1;

					foreach ($task->items as $item) {
						if (empty($list[$date][$type . '_schd_unit'])) {
							$list[$date][$type . '_schd_unit'] = 0;
						}
						$list[$date][$type . '_schd_unit'] += intval($item->mdata['uq']);
					}
				}
			}

			// calculate complete today
			$tasks = WmsTask::model()->findAll('t.is_request = 1 AND t.compl_time >= :time1 AND t.compl_time <= :time2 AND t.type IN (1010,1020,3020,3030)', [':time1' => date('Y-m-d 00:00:00', strtotime($date)), ':time2' => date('Y-m-d 23:59:59', strtotime($date))]);

			foreach ($tasks as $task) {
				if (filter($task)) continue;

				if (in_array($task->type, [1010,1020])) {
					$type = 'in';
				} else if (in_array($task->type, [3020,3030])) {
					$type = 'out';
				}

				if (empty($list[$date][$type . '_compl_task'])) {
					$list[$date][$type . '_compl_task'] = 0;
				}
				$list[$date][$type . '_compl_task'] += 1;

				foreach ($task->items as $item) {
					if (empty($list[$date][$type . '_compl_unit'])) {
						$list[$date][$type . '_compl_unit'] = 0;
					}
					$list[$date][$type . '_compl_unit'] += intval($item->mdata['uq']);
				}

				if (!empty($task->deliveryTask->mdata['shipment_id'])) {
					foreach ($task->deliveryTask->mdata['shipment_id'] as $id) {
						$shipment = Shipment::model()->findByPk($id);
						if (empty($list[$date]['out_compl_weight'])) {
							$list[$date]['out_compl_weight'] = 0;
						}
						$list[$date]['out_compl_weight'] += floatval($shipment->weight);
					}
				}
			}

			if (!empty($list[$date])) {
				foreach ($list[$date] as $key => $value) {
					$model = WmsDashboard::model()->find('date = :date', [':date' => $date]);
					if (empty($model)) {
						$model = new WmsDashboard;
						$model->date = $date;
					}
					$model->{$key} = $value;
					$model->save();
				}
			}

			$date = date('Y-m-d', strtotime($date . ' + 1 day'));
		}
	}

	public function prepareDeconciliationTimes()
	{

		$allScans = ShipmentScan::model()->with(['imparcel','imparcel.deconciliation'])->findAll(['condition' => 'to_days(t.scan_time) = to_days(:dt) and t.type <5 and deconciliation.id is null', 'params' => [":dt"=>date('Y-m-d')], 'group' => 't.pid']);
		$doArr = [];
		foreach ($allScans as $key => $scan) 
		{
		 	if (!empty($scan->imparcel->mdata['scan_time'])) 
		 	{
				$t = Tracking::model()->find('pid=:pid and type=61 ORDER BY id DESC', [':pid' => $scan->imparcel->id]);
				if (empty($t)) {
					$doArr[] = $scan;
				}
			}
		}

		$transaction = Yii::app()->db->beginTransaction();
		try
		{
			foreach ($doArr as $key => $scan) 
			{
				if(empty($scan->imparcel)) continue;
				$scan->imparcel->updateDeconsolidationTime(false,true);
			}
			$transaction->commit();
		} catch (Exception $ex) {
			$transaction->rollback();
			throw $ex;
		}
	}

	public function checkMissManifestParcel()
	{

		$parcels = [];
		$gatepass = [];
		$todayAllGatepass = GatepassShipment::model()->with('imparcel')->findAll('to_days(gate_pass_time) = to_days(:dt) and json_value(t.meta,"$.is_check_manifest") is null',[":dt"=>date('Y-m-d')]);
		$check = false;
		foreach ($todayAllGatepass as $key => $todayGatepass) {
			if (!empty($todayGatepass->imparcel->trans)) 
			{
				foreach ($todayGatepass->imparcel->trans as $ts) {
					if ($ts->connote != $todayGatepass->imparcel->ref) {
						continue;
						}
					if (!empty($ts->mdata['oid'])) {
						$check = true;
						}
					}
				}
			if (!empty($todayGatepass->imparcel->mdata['aupost_return']) && !empty($todayGatepass->imparcel->mdata['manifest_weight'])) {
				$check = true;
			}
			if (!empty($todayGatepass->imparcel->mdata['direct_courier']) && $todayGatepass->imparcel->status != 31) {
				$check = true;
			}
			if (!empty($todayGatepass->imparcel->cargo_process)) {
				$check = true;
			}
			if(!$check)
			{
				$parcels[$todayGatepass->imparcel->hbn] = $todayGatepass->imparcel;
				$gatepass[] = $todayGatepass;
			}
		}

		$transaction = Yii::app()->db->beginTransaction();
		try 
		{
			foreach ($gatepass as $key => $todayGatepass) {
				$todayGatepass->mdata['is_check_manifest'] = 1;
				$todayGatepass->save();
			}
			$transaction->commit();
		} catch (Exception $ex) {
			$transaction->rollback();
			throw $ex;
		}

		if(!empty($parcels))
		{
			$refs = array_column($parcels, 'hbn');
			$emailService = new EmailService();
			$toEmail = 'imports@toplogistics.com.au';
			$str = "Unmanifested parcel:   ";
			$str .= join(',',$refs);
			$subject = date("Y-m-d")." unmanifested parcels";
			$emailService->sendNormalEmail($toEmail,$subject,$str);
		}
	}

	public function generatingTLAInvoiceForPCAE3PL()
	{
		$imcoConsols = ImcoConsol::model()->findAll('no like "3PL%" and (to_days(eta) >= to_days("2020-08-01") or to_days(created)>=to_days("2020-08-01")) and json_value(t.meta,"$.3pl_invoice_generated") is null and to_id = 3441');
		foreach ($imcoConsols as $key => $consol)
		{
			$owner = Org::model()->findByPk(Org::ORGID_CLIENT_PCAE);
			// in case invoice existing , we just update
			$inv = Invoice::model()->find('consol_id = :cid and type = 10', [':cid' => $consol->id]);

			$inv = new Invoice;
			$inv->type = 10;
			$inv->dpmt = Invoice::DPMT_IMPORT;
			$inv->to_id = Org::ORGID_CLIENT_PCAE;
			$inv->dpt_id = Org::PCAE_DEPARTMENT_SYDNEY; // default set Sydney as warehouse
			$inv->ref = '3PL' . date('Ymd', strtotime($consol->created));
			$inv->currency = 1;
			$inv->consol_id = $consol->id;
			$inv->status = Invoice::INVOICE_STATUS_PENDING;
			$inv->date = date('Y-m-d', strtotime($consol->created));
			$inv->mdata['name'] = $owner->name;
			$inv->mdata['address'] = $owner->getAddress();
			$inv->mdata['payterm'] = empty($owner->extra['payterm']) ? '2 days' : $owner->extra['payterm'] . ' days';
			$inv->due = Invoice::calcDue($inv->date, $inv->mdata['payterm']);
			if(!$inv->save())
			{
				Log::log2file("3PL create Invoice".$consol->no."=>".json_encode($inv->getErrors()), "transaction_err_log", "transaction");
				continue;
			}

			$items = [];
			$tot = 0;

			$transaction = Yii::app()->db->beginTransaction();
			try {
				foreach ($consol->shipments as $i => $p)
				{
					if(empty($p->mdata["chargecode"])) continue;
					$pc = trim($p->cnee->postcode);
					
					// currently we hardcode here , we always use charge code 5813
					// so we create invoice by charge code now
					$amt = $p->getChargeByChargecode('', true);
					$p->mdata['charge_client_amount']= number_format($amt, 4, '.', '');
					$p->mdata['charge_client_weight']= number_format($p->weight, 2, '.', '');
					$p->updateMeta();
					$chargeCodeId = ImportChargeCode::model()->find('chargecode = :chargecode',[":chargecode"=>$p->mdata["chargecode"]]);
					$zoneMap = ZoneMap::model()->find('chargecode_id = :chargeCodeId AND zone_id = 1 AND pc_lo <= :p AND pc_hi >= :p', [':chargeCodeId'=>$chargeCodeId->id,':p' => $pc]);
					$zoneCode = 'N1';
					if (!empty($zoneMap) && !empty($zoneMap['z1'])) {
						$zoneCode = $zoneMap['z1'];
					}
					if (!empty($p->tempChargeweight)) {
						$p->weight=$p->tempChargeweight;
					}  //to record the break weight
					$items[] = [$p->ref, $p->getDesc().'    ' . $zoneCode, $p->pkg, $p->weight, $p->cbm, $amt,$p->cnee->postcode];
					$tot += $amt;
				}
				$transaction->commit();
			} catch (Exception $ex) {
				$transaction->rollback();
				Log::log2file("3PL create Invoice".$consol->no."=>".$ex->getMessage(), "transaction_err_log", "transaction");
				throw $ex;
			}

			$inv->refresh();
			if(empty($inv->id))
			{
				continue;
			}
			$il = new InvLine;
			$il->inv_id = $inv->id;
			$il->ccode = 'EPA';
			$il->mdata['items'] = $items;
			$il->det = $consol->no;
			$il->fid = $consol->id;
			$il->model = 'ImcoConsol'; // invoice connected with console directly
			$il->amount = round($tot * 1000) / 1000;
			$il->qty = 1;
			if(!$il->save())
			{
				Log::log2file("3PL create Invoice".$consol->no."=>".json_encode($il->getErrors()), "transaction_err_log", "transaction");
				continue;
			}

			$inv->refresh();

			$inv->getTotal();
			$inv->save();
			// update console related aupost courier cost
			ImcoConsol::updateImportConsoleBilling([$consol->id]);
			$consol->mdata['3pl_invoice_generated'] = 1;
			$consol->save();
		}
	}

	public function generateCogsLineByManifest()
	{
		$datet = date("Y-m-d");
		$datef = HolidayHelper::getLastDay($datet);
		$manifests = Manifest::model()->findAll("type = 90 and created >= :datef and created <= :datet",[":datef"=>$datef,":datet"=>$datet]);
		$aupostInfoArr = [];
		foreach ($manifests as $key => $manifest) {
			$pids = array_column($manifest->lines, 'fid');
			if($manifest->fwd_id == 101)
			{
				$allAPTranships = Tranship::model()->with('shipment')->findAll('shipment.status<=90 and json_value(t.meta,"$.oid") = :apmanifest and org_id = 101',[":apmanifest"=>$manifest->ref]);
				if(!empty($allAPTranships))
				{
					foreach (AusPostAPI::$api_accounts_info as $key => $api_accounts) {
						if(preg_match('/^'.$api_accounts['id'].'/', $allAPTranships[0]->connote))
						{
							$auType = $key;
						}
					}
				}

				/******************* get the eparcel info from auspost api***************************/
				$aus = new AusPostAPI($auType);
				$batchShipments=[];
				$idSidRe = [];
				foreach ($allAPTranships as $key => $apTranship) 
				{
					if($key%200==0)
					{
						$batchShipments[]=[];
					}
					$batchShipments[count($batchShipments)-1][]=$apTranship->mdata['sid'];
					$idSidRe[$apTranship->mdata['sid']] = $apTranship->pid;
				}
				$auShipmentArr = [];
				foreach ($batchShipments as $key => $bs) {
					$thisShipmentArr = $aus->getShipments(join(',',$bs))->shipments;
					if(!empty($thisShipmentArr))
					{
						$auShipmentArr = array_merge($auShipmentArr, $aus->getShipments(join(',',$bs))->shipments);
					}
				}
				
				foreach ($auShipmentArr as $key => $auShipment) {
					$itemArr = [];
					foreach ($auShipment->items as $key => $item) {
						$itemArr[] = [$item->weight,$item->postage_details->price->calculated_price_ex_gst,$item->tracking_details->article_id];
					}
					$fuelSurcharge = isset($auShipment->shipment_summary->fuel_surcharge)?$auShipment->shipment_summary->fuel_surcharge:0;
					$aupostInfoArr[$idSidRe[$auShipment->shipment_id]] = ['itemArr'=>$itemArr,'fuelSurcharge'=>$fuelSurcharge];
				}
				echo "2";
			}
		}


		foreach ($manifests as $key => $manifest) {
			$transaction=Yii::app()->db->beginTransaction();
			try {
				foreach ($manifest->lines as $key => $mani) 
				{
					$p = ImParcel::model()->findByPk($mani->fid);
					$cost = 0;
					foreach ($p->trans as $key => $t) {
						if($t->org_id==$manifest->fwd_id)
						{
							$cost = $t->cost;
							break;
						}
					}
					if(empty($cost))
					{
						continue;
					}
					$cogs = CogsLine::model()->find("charge_code = '91031' and item_code='item' and fid = :fid and model = 'ImParcel'",[":fid"=>$p->id]);
					if(empty($cogs))
					{
						$cogs = new CogsLine();
						$cogs->type = 1;
						$cogs->charge_code = '91031';
						$cogs->status = 1;
						$cogs->org_id = $manifest->fwd_id;
						$cogs->fid = $p->id;
						$cogs->model = 'ImParcel';
						$cogs->created = $p->created;
						$cogs->dpmt = 10;
						$cogs->gst = "INPUT";
						$cogs->desc = "";
						$cogs->qty = 1;
						$cogs->price = 0;
						$cogs->dpt_id = $p->ddpt_id;
						$cogs->currency = 1;
						$cogs->actual_amount = 0;
						if(!empty($aupostInfoArr[$p->id]))
						{
							foreach ($aupostInfoArr[$p->id]['itemArr'] as $key => $item) {
								$cogs->actual_amount += $item[1];
							}
						}
						$cogs->accrual_amount = $cost;
						$cogs->accrual_gst_amount  = $cost*0.1;
						$cogs->actual_gst_amount = 0;
						$cogs->item_code = 'item';
						$cogs->save();
					}else
					{
						if($cogs->actual_amount == 0)
						{
							if(!empty($aupostInfoArr[$p->id]))
							{
								foreach ($aupostInfoArr[$p->id]['itemArr'] as $key => $item) {
									$cogs->actual_amount += $item[1];
								}
								$cogs->actual_gst_amount =$cogs->actual_amount*0.1;
							}
							$cogs->save();
						}
					}
				}
				echo "1";
				$transaction->commit();
			} catch (Exception $ex) {
				$transaction->rollback();
				throw $ex;
			}
		}
	}

	public function updateAuspostCogsLineAccrual()
	{
		Yii::app()->name = 'TLA';
		$lines = SiReconcileLine::model()->with(['parent'])->findAll('parent.org_id = 101 and parent.status != 100 and json_value(t.meta,"$.iscogs") is null and rec_id != 508901 and item_code ="item" and model="ImParcel"');
		$i = 0;
		$transaction=Yii::app()->db->beginTransaction();
		$transaction_tla=Yii::app()->db_tla->beginTransaction();
		try {
			foreach ($lines as $key => $value) {
				if(!empty($value->fid))
				{
					echo "x";
					$co = CogsLine::model()->find("fid = :fid and model='ImParcel' and item_code = 'item'",[":fid"=>$value->fid]);
					$p = ImParcel::model()->findByPk($value->fid);
					if(empty($co))
					{
						$cogs = new CogsLine();
						$cogs->type = 1;
						$cogs->charge_code = '91031';
						$cogs->status = 1;
						$cogs->org_id = $manifest->fwd_id;
						$cogs->fid = $value->fid;
						$cogs->model = 'ImParcel';
						$cogs->created = $p->created;
						$cogs->dpmt = 10;
						$cogs->gst = "INPUT";
						$cogs->desc = "";
						$cogs->qty = 1;
						$cogs->price = 0;
						$cogs->dpt_id = $p->ddpt_id;
						$cogs->currency = 1;
						$cogs->actual_amount = $value->value;
						$cogs->accrual_amount = $value->my_value;
						$cogs->accrual_gst_amount  = $value->my_value*0.1;
						$cogs->actual_gst_amount = 0;
						$cogs->item_code = 'item';
						$cogs->save();
					}else
					{
						$co->accrual_amount = $value->my_value;
						$co->accrual_gst_amount = 0;
						$co->save();
					}
					$value->mdata['iscogs'] = 1;
					$value->save();
				}
				$i++;
				if($i>5000) break;
			}
			echo "1";
			$transaction_tla->commit();
			$transaction->commit();
		} catch (Exception $ex) {
			$transaction->rollback();
			$transaction_tla->rollback();
			throw $ex;
		}
	}

	public function putting3PLShipmentIntoConsol()
	{
		Yii::app()->name = "TLA";
		//$isDebug = true;
		$shipments = ImParcel::model()->findAll('status!=100 and (cbwf & '.ImParcel::CBWF_FOR_3PL.')>0 and consol_id = 0 and agent_id='.Org::ORGID_CLIENT_PCAE);
		if(!empty($shipments))
		{
			$transaction = Yii::app()->db->beginTransaction();
			$consol = null;
			try 
			{
				$consol = new ImcoConsol();
				$consol->owner_id = Org::ORGID_CLIENT_PCAE;
				$consol->dpt_id = Org::PCAE_DEPARTMENT_SYDNEY;
				$consol->pol = 'AUSYD';
				$consol->pod = 'AUSYD';
				$consol->eta = date("Y-m-d");
				$consol->created = date('Y-m-d');
				$consol->service = ImcoConsol::AIRCONSOL;
				$consol->status = 60;
				$consol->mdata['for3PL'] = 1;
				$consol->save();

				foreach ($shipments as $key => $p) {
					$p->status = ImParcel::STATE_LOCAL_ARRIVAL;
					$p->consol_id = $consol->id;
					$p->scan_data[50] = [];
					$p->scan_data[50]['SCAN_ALL'] = "3PLconsol";
					$p->save();
				}

				$transaction->commit();
			} catch (Exception $ex) {
				$transaction->rollback();
				throw $ex;
			}
		}
		// if(!empty($consol)&&$isDebug==false)
		// {
		// 	Yii::import('application.controllers.ImcoConsolController');
		// 	$cc = new ImcoConsolController('default');
		// 	$cc->actionAupost($consol->id);
		// 	$cc->actionAupostInt($consol->id);
		// 	$consol->genSpecialInvoice(false, false, []);
		// }

		$consols = ImcoConsol::model()->findAll(" owner_id= ".Org::ORGID_CLIENT_PCAE." and no like 'TS%' and json_value(t.meta,'$.is_generate_3pl') is null ");
		foreach ($consols as $key => $consol) {
			if(empty($consol->mdata['awb_wt']))
			{
				$consol->mdata['awb_wt'] = 1;
			}
			$consol->genSpecialInvoice(false, false, [Org::ORGID_CLIENT_PCAE]);
			$consol->mdata['is_generate_3pl'] = 1;
			$consol->save();
			echo $consol->id;
		}


		//handling 3pl shipment split fee
		$wdtConsols = ImcoConsol::model()->findAll('no like "WDT%" and (json_value(meta,"$.isGen3PLSplitInvoice") is null or json_value(meta,"$.isGen3PLSplitInvoice")=0) and status!=100');
		foreach ($wdtConsols as $key => $consol)
		{
			$check = false;
			$ss = $consol->shipments;
			if(empty($consol->dpt_id))
			{
				foreach ($ss as $key => $s) {
					if($s->status!=ImParcel::STATE_CANCELLED&&!empty($s->ddpt_id))
					{
						$consol->dpt_id = $s->ddpt_id;
						$consol->save();
						break;
					}
				}
			}
			
			foreach ($ss as $key => $s) {
					if($s->status!=ImParcel::STATE_CANCELLED)
					{
						$check = true;
						break;
					}
			}

			if(empty($consol->dpt_id)||empty($consol->shipments)||$check===false)
			{
				$consol->status = Imcoconsol::Status_Cancelled;
				$consol->save();
				echo $consol->no;
				continue;
			}
			$consol->mdata['cgb_wt'] = 1;
			$msgs = $consol->genSpecialInvoice(false,false,[]);
			$checkMsg = join(',',$msgs);
			if($checkMsg=='Invoice created')
			{
				$consol->mdata['isGen3PLSplitInvoice'] = 1;
				$consol->save();
			}else
			{
				if($checkMsg!='Total Amount is 0')
				{
					Emailog::sendEmailTo('gero@toplogistics.com.au', json_encode($consol->no.":".$checkMsg),$consol->no." generate 3PL split invoice error");
				}
			}
		}
	}

