	public function getBorderLocationReport()
	{
		$provide = [];
		$wmsLocatins = WmsLocation::model()->findAll('code in ("SLCLAWAY","MELCAWAY","BLCLAWAY")');
		foreach ($wmsLocatins as $key => $wmsLocation)
		{
			$provide[$wmsLocation->code] = ["OutStock"=>[],"ReturnToday"=>[]];

			$wmsRackShipments = WmsRackShipment::model()->findAll('rack_id=:rack_id',[':rack_id'=>$wmsLocation->id]);
			foreach ($wmsRackShipments as $key2 => $wmsRackShipment)
			{
				if($wmsRackShipment->shipment->status==ImParcel::STATE_HELD||$wmsRackShipment->shipment->status==ImParcel::STATE_CLEAR)
				{
					if($wmsRackShipment->status==WmsRackShipment::REMOVED)
					{
						$changedLocation = WmsRackShipment::model()->with(['location'])->findAll('to_days(created)=to_days(:date) and shipment_id = :pid and sno =:sno and status=:status and rack_id !=:rack_id',[':date'=>date('Y-m-d'),':pid'=>$wmsRackShipment->shipment_id,':sno'=>$wmsRackShipment->sno,':status'=>WmsRackShipment::ACTIVE,':rack_id'=>$wmsRackShipment->rack_id]);
						if(!empty($changedLocation))
						{
							$provide[$wmsLocation->code]["ReturnToday"][] = [$wmsRackShipment->shipment->hbn."[".$changedLocation->code."]",$wmsRackShipment->sno,$wmsRackShipment->created];
						}
					}else
					{
						$provide[$wmsLocation->code]["OutStock"][] = [$wmsRackShipment->shipment->hbn,$wmsRackShipment->sno,$wmsRackShipment->created];
					}
				}
			}
		}

		$wmsLocatins = WmsLocation::model()->findAll('meta like "%SLCLAWAY%" or meta like "%MELCAWAY%" or meta like "%BLCLAWAY%"');
		foreach ($wmsLocatins as $key => $wmsLocation)
		{
			$code = $wmsLocation->extra['ground_label'];
			if(empty($provide[$code]))
			{
				$provide[$code] = ["OutStock"=>[],"ReturnToday"=>[]];
			}

			$wmsRackShipments = WmsRackShipment::model()->findAll('rack_id=:rack_id',[':rack_id'=>$wmsLocation->id]);
			foreach ($wmsRackShipments as $key2 => $wmsRackShipment)
			{
				if($wmsRackShipment->shipment->status==ImParcel::STATE_HELD||$wmsRackShipment->shipment->status==ImParcel::STATE_CLEAR)
				{
					if($wmsRackShipment->status==WmsRackShipment::REMOVED)
					{
						$changedLocation = WmsRackShipment::model()->with(['location'])->findAll('to_days(created)=to_days(:date) and shipment_id = :pid and sno =:sno and status=:status and rack_id !=:rack_id',[':date'=>date('Y-m-d'),':pid'=>$wmsRackShipment->shipment_id,':sno'=>$wmsRackShipment->sno,':status'=>WmsRackShipment::ACTIVE,':rack_id'=>$wmsRackShipment->rack_id]);
						if(!empty($changedLocation)&&strtotime($changedLocation->created)>strtotime($wmsRackShipment->created))
						{
							$provide[$code]["ReturnToday"][] = [$wmsRackShipment->shipment->hbn."[".$changedLocation->code."]",$wmsRackShipment->sno,$wmsRackShipment->created];
						}
					}else
					{
						$provide[$code]["OutStock"][] = [$wmsRackShipment->shipment->hbn,$wmsRackShipment->sno,$wmsRackShipment->created];
					}
				}
			}
		}

		$wmsLocationGroundLabels = WmsLocationGroundLabel::model()->findAll('ground_label in ("SLCLAWAY","MELCAWAY","BLCLAWAY")');
		foreach ($wmsLocationGroundLabels as $key => $wmsLocationGroundLabel)
		{
			$wmsLocation = $wmsLocationGroundLabel->location;
			$code = $wmsLocationGroundLabel->ground_label;
			if(empty($provide[$code]))
			{
				$provide[$code] = ["OutStock"=>[],"ReturnToday"=>[]];
			}
			$changedLocation = WmsLocationGroundLabel::model()->find('location_id = :locationId and ground_label not in ("SLCLAWAY","MELCAWAY","BLCLAWAY") and ground_label_in_time>:time and ground_label_in_time>:time1 and ground_label_in_time<:time2',[":locationId"=>$wmsLocationGroundLabel->location_id,":time"=>$wmsLocationGroundLabel->ground_label_in_time,":time1"=>date("Y-m-d 06:59:00"),":time2"=>date("Y-m-d 23:59:00")]);
			if(!empty($changedLocation))
			{
				$wmsRackShipments = WmsRackShipment::model()->findAll('rack_id=:rack_id and status!=:status',[':rack_id'=>$wmsLocation->id,':status'=>WmsRackShipment::REMOVED]);
				foreach ($wmsRackShipments as $key2 => $wmsRackShipment)
				{
					if($wmsRackShipment->shipment->status==ImParcel::STATE_HELD||$wmsRackShipment->shipment->status==ImParcel::STATE_CLEAR)
					{
						$provide[$code]["ReturnToday"][] = [$wmsRackShipment->shipment->hbn."[".$changedLocation->ground_label."]",$wmsRackShipment->sno,$wmsRackShipment->created];
					}
				}
			}
		}




		$wmsLocatins = WmsLocation::model()->findAll('code in ("SDH","SAQIS","SBorder","MDH","MAQIS","MBorder","BDH","BAQIS","BBorder")');
		foreach ($wmsLocatins as $key => $wmsLocation)
		{
			$provide[$wmsLocation->code] = ["InStock"=>[]];

			$wmsRackShipments = WmsRackShipment::model()->findAll('rack_id=:rack_id and status = :status',[':rack_id'=>$wmsLocation->id,':status'=>WmsRackShipment::ACTIVE]);
			foreach ($wmsRackShipments as $key2 => $wmsRackShipment)
			{
				if($wmsRackShipment->shipment->status==ImParcel::STATE_HELD)
				{
					$provide[$wmsLocation->code]["InStock"][] = [$wmsRackShipment->shipment->hbn,$wmsRackShipment->sno,$wmsRackShipment->created];
				}
			}
		}

		$str = "";
		foreach ($provide as $code => $codeTypeArr)
		{
			foreach ($codeTypeArr as $codeType => $shipmentDetails) {
				foreach ($shipmentDetails as $key => $shipmentDetail) {
					$str.="<tr><td>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;{$code}&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</td><td>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;{$codeType}&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</td><td>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;{$shipmentDetail[0]}&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</td><td>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;{$shipmentDetail[1]}&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</td><td>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;{$shipmentDetail[2]}&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</td></tr>";
				}
			}
		}
		$emailService = new EmailService();
		$toEmail = 'gero@toplogistics.com.au';
		$ccEmail = "michelle@toplogistics.com.au;frank.liu@toplogistics.com.au;carmen.teh@toplogistics.com.au;op@toplogistics.com.au;gero@toplogistics.com.au;op2@toplogistics.com.au";
		$body = "<table><tr><th>Location</th><th>Type</th><th>HBN</th><th>sno</th><th>Record Time</th></tr>".$str."</table>";
		$subject = date("Y-m-d")." Held Shipment In/Out Report";
		$emailService->sendNormalEmail($toEmail,$subject,$body,$ccEmail);

	}

	public function releaseAccountHeldShipments()
	{
		$ps = ImParcel::model()->findAll("status = :status ",[":status"=>ImParcel::STATE_ACCOUNT_HELD]);
		$orgBalance = [];
		foreach ($ps as $key => $p)
		{
			if(empty($orgBalance[$p->agent_id]))
			{
				$orgBalance[$p->agent_id] = $p->agent->getAccBalanceDetails();
			}

			if($orgBalance[$p->agent_id]>0)
			{
				$orgBalance[$p->agent_id] = $orgBalance[$p->agent_id]-$p->getValue();
				if($p->mdata['acc_held_before_status']!=ImParcel::STATE_HELD)
				{
					if($p->mdata['acc_held_before_status']==ImParcel::STATE_CLEAR)
					{
						if($p->scanCount()>0)
						{
							$p->status = ImParcel::STATE_CLEAR_WAIT;
						}else
						{
							$p->status = ImParcel::STATE_CLEAR;
						}
						$p->update(['status']);
					}else
					{
						$p->status = $p->mdata['acc_held_before_status'];
						$p->update(['status']);
					}
				}
			}
		}
	}

	public function getDeconsoliationListPre(){
		$arrDepots = [106,218,530];
		foreach($arrDepots as $dpt_id){
			$model=new ImParcel('search');
			$model->unsetAttributes();
			$model->ref = "?PICKUP8";
			$model->clear = 1;
			$model->ddpt_id = $dpt_id;
			$cacheKey = "getDeconsolidation".$dpt_id;
			$dataProvider = $model->search(true, 10, false, false);
			Yii::app()->cache->set($cacheKey,$dataProvider,43200);
			
		}
	}

	public function upDateShipmentPlt(){
		$shipmentSql = 'SELECT shipment_id FROM `wms_rack_shipment` where status = 0 and created like "'.date('Y-m-d').'%" group by shipment_id';
		$arrShipments = Yii::app()->db->createCommand($shipmentSql)->queryAll();
		if(!empty($arrShipments)){
			foreach($arrShipments as $strShipment){
				if(!empty($arrAssign['shipment_id'])){
					$objShipment = ImParcel::model()->findByPk($arrAssign['shipment_id']);
					if(!empty($objShipment->mdata['amzon_pallet'])){
						$numPlt = $objShipment->getRackNumber()[1];
						if(is_numeric($numPlt)){
							$objShipment->mdata['amzon_pallet'] = $numPlt;
							$objShipment->save();
						}
					}
				}
			}
		}
	}

	public function manifestToGV()
	{
		$allGVManifest = Manifest::model()->with('lines')->findAll('fwd_id = 3937 and ref !="" and (to_days(created)=to_days(NOW()) or to_days(created)=(to_days(NOW())-1) ) and json_value(lines.meta,"$.isPushGV") is null');
		foreach($allGVManifest as $manifest)
		{
			foreach($manifest->lines as $line)
			{
				if($line->shipment->agent_id!=Org::ORGID_CLIENT_GLOBAVEND)
				{
					$gvapi = GvApi::getAPIInstance($line->shipment->mdata['org_rate_id']);
					$result = $gvapi->createShipment($line->shipment);
					if($result['status']=="succeed"&&$result['orderResult'][0]['status']=="succeed")
					{
						$line->mdata['isPushGV'] = 1;
						$line->save();
					}else
					{
						Emailog::sendEmailTo('gero@toplogistics.com.au', json_encode($result),$line->shipment->ref." GV manifest error");
						echo $result->status;
						echo $result->orderResult[0]->status;
						echo $line->shipment->id;
						Yii::app()->end();
					}
				}
			}
		}
	}


	public function sendRTSRecordEmailToOP()
	{
		$shipmentRtsRecords = ShipmentRtsRecord::model()->with(["shipment"])->findAll("to_days(record_time) = to_days(:today)",[":today"=>date("Y-m-d")]);
				$provide = [];
		$str1 = "";
		$str2 = "";
		$provide = [];
		foreach ($shipmentRtsRecords as $key => $record) {
			if(!isset($provide[$record->type]))
			{
				$provide[$record->type] = [];
			}

			if($record->type==ShipmentRtsRecord::KNOWN)
			{
				$wmsRackShipment = WmsRackShipment::model()->find("shipment_id =:sid and status = 0 and sno=:sno",[":sid"=>$record->shipment_id,":sno"=>$record->sn]);
				$code = empty($wmsRackShipment)?"":$wmsRackShipment->location->code;
				$shipment = $record->shipment;
				$provide[$record->type][] = [$code, $shipment->hbn,$shipment->ref,$record->barcode,$record->sn,$record->record_time,$record->reason];
			}else
			{
				$provide[$record->type][] = [$record->barcode,$record->record_time,$record->getUrl()];
			}
		}

		if(!empty($provide[ShipmentRtsRecord::KNOWN]))
		{
			foreach ($provide[ShipmentRtsRecord::KNOWN] as $row)
			{
				$str1.="<tr>";
				foreach ($row as $key2 => $col) {
					$str1.="<td>&nbsp;&nbsp;&nbsp;{$col}&nbsp;&nbsp;&nbsp;</td>";
				}
				$str1.="</tr>";
			}
		}

		$body = "<h1>Recorded Shipments</h1><table><tr><th>Location</th><th>HBN</th><th>Ref</th><th>Barcode</th><th>sno</th><th>Record Time</th><th>RTS Reason</th></tr>".$str1."</table>";

		if(!empty($provide[ShipmentRtsRecord::UNKNOWN]))
		{
			foreach ($provide[ShipmentRtsRecord::UNKNOWN] as $row)
			{
				$str2.="<tr>";
				foreach ($row as $key2 => $col) {
					$str2.="<td>&nbsp;&nbsp;&nbsp;{$col}&nbsp;&nbsp;&nbsp;</td>";
				}
				$str2.="</tr>";
			}
		}

		$emailService = new EmailService();
		$toEmail = 'gero@toplogistics.com.au';
		$ccEmail = "";//"importscs@toplogistics.com.au;michelle@toplogistics.com.au;frank.liu@toplogistics.com.au;david.ren@toplogistics.com.au;";
		$body .= "<h1>Unknown Shipments</h1><table><tr><th>Barcode</th><th>Record Time</th><th>File Url</th></tr>".$str2."</table>";
		$subject = date("Y-m-d")." RTS Report";
		$emailService->sendNormalEmail($toEmail,$subject,$body,$ccEmail);
	}

	public function pushUnknownRTSRecordToDiscard()
	{
		$allRecords = ShipmentRtsRecord::model()->findAll("type = 0 and (to_days(NOW())-to_days(record_time))>14 and status = :status",[":status"=>ShipmentRtsRecord::NEW]);
		foreach($allRecords as $record)
		{
			$record->status = ShipmentRtsRecord::WAITING_UNKNOWN_DISCARD;
			$record->update(['status']);
		}
	}

	public function noticeKnownRTSRecordWillBeDiscard()
	{
		$allRecords = ShipmentRtsRecord::model()->findAll(["condition"=>"type = 1 and (to_days(NOW())-to_days(record_time))>20 and status = :status and is_notice=0","params"=>[":status"=>ShipmentRtsRecord::NEW],"order"=>"t.record_time"]);
		$provideShipment = [];
		$provide = [];
		foreach($allRecords as $record)
		{
			if(!empty($provideShipment[$record->shipment->agent_id])&&!empty($provideShipment[$record->shipment->agent_id][$record->shipment_id]))
			{
				continue;
			}

			$shipmentRecordes = ShipmentRtsRecord::model()->findAll("type = 1 and (to_days(NOW())-to_days(record_time))>20 and status = :status and shipment_id = :shipmentId",[":status"=>ShipmentRtsRecord::NEW,":shipmentId"=>$record->shipment_id]);

			$barcode = "";
			$hbn = $record->shipment->hbn;
			$ref = $record->shipment->ref;
			$reason = "";
			$rtsTime = "";
			$fileUrl = "";
			
			foreach($shipmentRecordes as $k2=>$shipmentRecorde)
			{
				$barcode.="<p>{$shipmentRecorde->barcode}</p>";
				$reason.="<p>{$shipmentRecorde->reason}</p>";
				$rtsTime.="<p>{$shipmentRecorde->record_time}</p>";
				$fileUrl.="<p>{$shipmentRecorde->getUrl()}</p>";
			}

			if(!empty($provideShipment[$record->shipment->agent_id]))
			{
				$provideShipment[$record->shipment->agent_id]=[$record->shipment_id=>[$hbn,$ref,$barcode,$reason,$rtsTime,$fileUrl]];
			}else
			{
				$provideShipment[$record->shipment->agent_id][$record->shipment_id]=[$hbn,$ref,$barcode,$reason,$rtsTime,$fileUrl];
			}
		}

		foreach ($provideShipment as $orgId => $rows)
		{
			$str2 = "";
			foreach ($rows as $key => $row) {
				$str2.="<tr>";
				foreach ($row as $key2 => $col) {
					$str2.="<td>&nbsp;&nbsp;&nbsp;{$col}&nbsp;&nbsp;&nbsp;</td>";
				}
				$str2.="</tr>";
			}
			$emailService = new EmailService();
			//$toEmail = $org->mdata['outturn_email'];
			$toEmail = 'gero@toplogistics.com.au';
			$ccEmail = "";//"importscs@toplogistics.com.au;michelle@toplogistics.com.au;frank.liu@toplogistics.com.au;david.ren@toplogistics.com.au;";
			$body .= "<h1>RTS Shipment will be discarded</h1><table><tr><th>HBN</th><th>REF</th><th>Barcode</th><th>Reason</th><th>RTS Time</th><th>File Url</th></tr>".$str2."</table>";
			$subject = date("Y-m-d")." RTS Notice";
			$emailService->sendNormalEmail($toEmail,"RTS Shipment will be discarded",$body,$ccEmail);
		}


		$transaction = Yii::app()->db->beginTransaction();
		try {

			foreach($allRecords as $record)
			{
				$record->is_notice=1;
				$record->save();
			}
			$transaction->commit();
		} catch (Exception $ex) {
			$transaction->rollback();
			throw $ex;
		}


		
	}

	public function pushknownRTSRecordToDiscard()
	{
		$allRecords = ShipmentRtsRecord::model()->findAll("type = 1 and (to_days(NOW())-to_days(record_time))>30 and status = :status and is_notice = 1",[":status"=>ShipmentRtsRecord::NEW]);
		foreach($allRecords as $record)
		{
			$record->status = ShipmentRtsRecord::WAITING_KNOWN_DISCARD;
			$record->update(['status']);
		}
	}


	public function cancelUnpaidBooking()
	{
		$due = date('Y-m-d H:i:s', strtotime('-30 minutes'));
		$bookings = PickupBooking::model()->findAllBySql('SELECT * FROM pickup_booking WHERE `status` = 1 AND `create_date` < "'.$due.'"');
		foreach($bookings as $booking) {
			$booking->status = 3;
			$booking->save();
		}
	}

