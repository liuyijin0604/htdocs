	public function checkUnmanifested(){
		$rs = ImParcel::model()->with(['consol','trans'])->together(true)->findAll("consol.eta > DATE_SUB(CURDATE(), INTERVAL 30 DAY) AND consol.eta < DATE_SUB(CURDATE(), INTERVAL 1 DAY) AND ((trans.id IS NULL AND t.status IN (42,60)) || (t.scan_no > 0 AND t.status IN (70,90) AND consol.no NOT LIKE '3PL%')) AND ref REGEXP '^(AMQ|33EVH|33EVJ|7RFZ|4XHZ|33A8Y|ZK6)'");
		$refs = [];
		$consols = [];
		$tracking = new trackingCommand('ubm', null);
		foreach($rs as $r){
			if($r->status == 60 && $r->pkg == $r->scan_no) continue;
			if($r->agent_id == 1656) continue; //d2z sub
			if(strtotime($r->mdata['scan_time']) > time() - 172800) continue;
			$data = $tracking->auPost($r->ref);
			if(!empty($data)){
				$refs[] = $r->ref;
				$consols[$r->consol_id] = $r->consol;
				if($this->debug) echo $r->ref.' unmanifested', PHP_EOL;
			}
		}

		if(!empty($refs)){
			$msg = 'Please check the following '.count($refs).' shipments:'."\n".implode("\n", $refs). "\n\nConsols:\n";
			foreach($consols as $c){
				$msg .= $c->no."\n";
			}
			// $this->log($msg);
			include_once('PHPMailer/class.phpmailer.php');
			$mail = new PHPMailer();
			$mail->CharSet = 'UTF-8';
			$mail->IsHTML(false);
			$mail->From     = 'imports@toplogistics.com.au';
			$mail->FromName = 'TLA Imports';
			$mail->Subject  = 'Unmanifested shipment report';
			$mail->Body = $msg;
			$mail->AddAddress('imports@toplogistics.com.au');
			$mail->AddBCC('gero@toplogistics.com.au');
			$mail->Send();
		}
	}

	public function syncInvoiceToXero()
	{
		$invoices = Invoice::model()->findAll('sync_xero = 0 AND status IN (2,3) AND total > 0');
		foreach ($invoices as $invoice) {
			$invoice->saveInvoice2xero();
			sleep(1);
		}

		// invoice mark as paid by paypal or supay ...
		$invoices = Invoice::model()->findAll('sync_xero = 0 AND status IN (9,11) AND total > 0 AND date >= "2020-07-01"');
		foreach ($invoices as $invoice) {
			$invoice->saveInvoice2xero();
			sleep(1);
		}

		$creditnotes = Payment::model()->findAll('type = 5 AND status = 6 AND ata > 0 AND date >= "2019-06-01" AND bank = 91 AND xero_id = ""');
		foreach ($creditnotes as $creditnote) {
			$creditnote->saveCreditNote2xero();
			sleep(1);
		}

		// allocate before post
		$creditnotes = Payment::model()->findAll('type = 5 AND status = 6 AND ata = 0 AND date >= "2020-07-01" AND bank = 91 AND xero_id = ""');
		foreach ($creditnotes as $creditnote) {
			$creditnote->saveCreditNote2xero();
			sleep(1);
		}
	}

