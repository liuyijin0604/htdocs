	public function updateCargoProcessOTInvoice(){
		$tempDate = date('Y-m-d H:i:s', strtotime('-30 days'));
		$cargoProcessModels = CargoProcess::model()->findAll('started >= :started',[':started' => $tempDate]);
		foreach($cargoProcessModels as $cargoProcessModel){
			$numOTInvoice = $cargoProcessModel->getRelatedOTFee();
			if(!empty($cargoProcessModel->mdata['systemRevenue'])){
				$cargoProcessModel->mdata['systemOt'] = $numOTInvoice;
				$cargoProcessModel->mdata['systemTotalRevenue'] = $cargoProcessModel->mdata['systemRevenue']+$numOTInvoice;
				$cargoProcessModel->save();
			}
		}
	}

	public function sendTimeUpCargoReport()
	{
		$allheldShipments = Shipment::model()->findAll(["condition"=>'status = 55 and consol_id !=0',"order"=>"created desc"]);
		$allheldShipmentsArchive = ImParcelArchive::model()->findAll(["condition"=>'status = 55 and consol_id !=0 and created>="2021-01-01"',"order"=>"created desc"]);


		$emailService = new EmailService();
		$i = 1;
		$xls = new oExcel;
        $xls->addRow($i++, ['POD','connote','ref','agent_id','MAWB/Container#','PKG','WEIGHT','TOTAL CBM','ETA','CHECKIN DATE TIME','EXTRA INFO(扣件原因)','MEMO','archive']);
		
		foreach ($allheldShipments as $agentId => $p)
		{
			if(empty($p->mdata['scan_time'])) continue;
			if(strtotime($p->mdata['scan_time'])>strtotime(date("Y-m-01 00:00:00"))) continue;
			if(empty($p->consol->service)) continue;
			$row = [];
			$row[] = $p->consol->pod;
			$row[] = $p->hbn;
			$row[] = $p->ref;
			$row[] = $p->agent_id;
			$row[] = ($p->consol->service==ImcoConsol::AIRCONSOL)?$p->consol->awb:@$p->consol->mdata["container_no"];
			$row[] = $p->pkg;
			$row[] = $p->weight;
			$row[] = $p->cbm*$p->pkg;
			$row[] = $p->consol->eta;
			$row[] = @$p->mdata['scan_time'];
			$row[] = join(',',$p->getWarnings(false));
			$row[] = $p->can;

			$xls->addRow($i++,$row);
        }

        foreach ($allheldShipmentsArchive as $agentId => $p)
		{
			if(empty($p->mdata['scan_time'])) continue;
			if(strtotime($p->mdata['scan_time'])>strtotime(date("Y-m-01 00:00:00"))) continue;
			if(empty($p->consol->service)) continue;
			$row = [];
			$row[] = $p->consol->pod;
			$row[] = $p->hbn;
			$row[] = $p->ref;
			$row[] = ($p->consol->service==ImcoConsol::AIRCONSOL)?$p->consol->awb:@$p->consol->mdata["container_no"];
			$row[] = $p->pkg;
			$row[] = $p->weight;
			$row[] = $p->cbm*$p->pkg;
			$row[] = $p->consol->eta;
			$row[] = @$p->mdata['scan_time'];
			$row[] = join(',',$p->getWarnings(false));
			$row[] = $p->can;
			$row[] = 1;

			$xls->addRow($i++,$row);
        }

        $filename = "time_up_cargo_report".date("Y-m-d").".xls";
        $path = Yii::app()->basePath.DIRECTORY_SEPARATOR.'runtime'.DIRECTORY_SEPARATOR;
        $fullFilename = $path.$filename;
        $xls->output($fullFilename, null, false);
       $result = $emailService->funcSendEmailTpl(0,'imports@toplogistics.com.au','TLA Imports','imports@toplogistics.com.au','carmen.teh@toplogistics.com.au;op2@toplogistics.com.au;frank.liu@toplogistics.com.au;michelle@toplogistics.com.au','',$filename,' Time up report',Emailog::OP_REPORT,$fullFilename,$filename);

    }

    public function sendPierFileDaily()//port file
	{
		$files = FileRepo::model()->findAll('(name like "%INV.pdf" or name like "%inv.pdf") and date_format(date,"%Y-%m-%d") = :day and type = :type and status=:status',[":day"=>date("Y-m-d"),":type"=>FileRepo::CONSOL_ATTACHMENT,":status"=>FileRepo::ACTIVE]);
		$sendSchedule = [];
		$emailService = new EmailService();
		foreach ($files as $key => $file) {
			$consolId = $file->fid;
			$consol = Consol::model()->findByPk($consolId);
			if(empty($consol)) continue;
			if(!empty($consol->mdata['container_no'])&&$consol->service==Consol::SEACONSOL&&preg_match('/'.$consol->mdata['container_no'].'/i', $file->name))
			{
				if(!empty($this->owner_id))
				{
					$agentIds = [$this->owner_id];
				}else
				{
					$agentIds = $consol->getAllAgentId();
				}

				foreach ($agentIds as $key => $agentId)
				{
					if(in_array($agentId, [Org::ORGID_CLIENT_ZHONGWAI,Org::ORGID_CLIENT_AUSTWAY,Org::ORGID_CLIENT_4PX]))
					{
						$emailService->sendPireFileToAgent($agentId,$file);
					}
					
				}
			}
		}
		
	}

