	public function log($m)
	{
		$lf = Yii::app()->basePath.DIRECTORY_SEPARATOR.'runtime'.DIRECTORY_SEPARATOR.'cron_cmd.log';
		@file_put_contents($lf, date('Y-m-d H:i:s').' '.$m." " . Yii::app()->name . "\n", FILE_APPEND);
	}

	public function funcConsolReport()
	{
			$listStatus = [];
			$objModelReport = new ModelReport(date("Y-m-d",strtotime("-2 week")),date("Y-m-d"),[],[],'','','','',null);
			$listRecord = $objModelReport->funcRecords();
			
			// $objModelReport = new ModelReport(date("Y-m-d",strtotime("-12 month")),date("Y-m-d",strtotime("-13 day")),$listStatus,[],'','','','',false);
			// $listRecordsExceptional = $objModelReport->funcRecords();
			// foreach($listRecordsExceptional as $i=>$objRecordsExceptional){
			// 	$listRecord[] = $objRecordsExceptional;
			// }
			
			
			$listRecordsAir =[];
			$listRecordsSea =[];
			foreach ($listRecord as $i => $objRecord) {
				if($objRecord->service == Imcoconsol::AIRCONSOL){
					$listRecordsAir[] =$objRecord;
				}
				else{
					$listRecordsSea[] = $objRecord;
				}
			}
			
			$listRecordsAirNoUnpack =[];
			foreach ($listRecordsAir as $i => $objRecord) {
				if( empty ($objRecord->unpack)){
					$listRecordsAirNoUnpack[] =$objRecord;
				}
			}
			$listRecordSeaNoUnpack =[];
			foreach ($listRecordsSea as $i => $objRecord) {
				if( empty ($objRecord->unpack)){
					$listRecordSeaNoUnpack[] =$objRecord;
				}
			}
			
			$listRecordAir3Days =[];
			foreach ($listRecordsAir as $i => $objRecord) {
				$numDaysTodayAndEta = floor((strtotime(date("Y-m-d") )-strtotime(date("Y-m-d", strtotime($objRecord->eta))))/86400);
				if($numDaysTodayAndEta <=3){
					$listRecordAir3Days[] = $objRecord;
				}
			}
			
			
			
			$strHtml ='';
			$strHtml .='<style>.odd{background: #E5F1F4;}.even {background: #F8F8F8;}table {background: white;width: 100%;border: 1px #D0E3EF solid;}th {color: white;background-color:rgb(107, 157, 207);text-align: center;}</style>';
	
			$strHtml .='<h1>Air Consol Report (Empty Unpack)</h1>';
			$strHtml .= $objModelReport->funcListRecords2HTML($listRecordsAirNoUnpack);
			$strHtml .='<h1>Sea Consol Report (Empty Unpack)</h1>';
			$strHtml .= $objModelReport->funcListRecords2HTML($listRecordSeaNoUnpack);
			
			// $strHtml .='<h1>Air Consol Report</h1>';
			// $strHtml .= $objModelReport->funcListRecords2HTML($listRecordsAir);
			// $strHtml .='<h1>Sea Consol Report</h1>';
			// $strHtml .= $objModelReport->funcListRecords2HTML($listRecordsSea);
			
			$strHtml .='<h1>Air Consol Report (ETA 3 Days)</h1>';
			$strHtml .= $objModelReport->funcListRecords2HTML($listRecordAir3Days);
				
			// echo $strHtml;
			// return;
			
			// email
			$objEmailService = new EmailService;
			// $objEmailService->sendNormalEmail('lwj55555@live.cn','Consol Report',$strHtml) ;
			$objEmailService->sendNormalEmail('peter@toplogistics.com.au;michelle@toplogistics.com.au;david.ren@toplogistics.com.au;frank.liu@toplogistics.com.au;carmen.teh@toplogistics.com.au;op@toplogistics.com.au;gero@toplogistics.com.au;op2@toplogistics.com.au','Consol Report',$strHtml) ;
		}

	public function funcSendGoogleReviewEmail(){
		$numTimeNow = time();
		$numTimeFrom = strtotime('-1 day',$numTimeNow);

		$strTimeNow = date("Y-m-d H:i:s", $numTimeNow);
		$strTimeFrom = date("Y-m-d H:i:s", $numTimeFrom);
		
		$numLimitHours = 72;

