	public function checkNormalCargoIsError()
	{
		$emailService = new EmailService();
		$cargoProcesses1 = CargoProcess::model()->with('shipment')->findAll("shipment.ddpt_id in (106,218,530,0) and hbn not like '%JBCD123025%' and shipment.agent_id !=4045 and (sub_type = 0 or sub_type = :smsSentType or sub_type =:smsReceivedType) and t.type = :type and t.status = :status",[":type"=>CargoProcess::NORMAL_CARGO,":status"=>CargoProcess::COLLECTINFO,":smsSentType"=>CargoProcess::SENT_SMS_STYPE,":smsReceivedType"=>CargoProcess::RECEIVED_SMS_STYPE]);

		//$cargoProcesses2 = CargoProcess::model()->with('shipment')->findAll("shipment.ddpt_id in (106,218,530) and hbn not like '%JBCD123025%' and shipment.agent_id !=4045 and sub_type =:smsReceivedType and t.type = :type and t.status = :status",[":type"=>CargoProcess::NORMAL_CARGO,":status"=>CargoProcess::WAITINGERRORCHECKING,":smsReceivedType"=>CargoProcess::RECEIVED_SMS_STYPE]);
		$cargoProcesses = $cargoProcesses1;//array_merge($cargoProcesses1,$cargoProcesses2);
		foreach ($cargoProcesses as $key => $c)
		{
			// if($c->shipment->scanCount()==0&&!$c->shipment->is3PL())
			// {
			// 	continue;
			// }
			$sTypes = 0;
			$strIsNotReplay = 0;
			if($c->sub_type ==0)
			{
				if(empty(Addr::auTelValid($c->shipment->cnee->tel)))
				{
					$sTypes += CargoProcess::WPN_STYPE;
				}

				$distanceCheck = ZoneMapService::checkIsLongDistance($c->shipment);
				if($distanceCheck==1)
				{
					$sTypes += CargoProcess::LD_STYPE;
				}else if($distanceCheck==2)
				{
					$sTypes += CargoProcess::WA_STYPE;
				}
			}else
			{
				if(!empty($c->mdata['other_inquery']))
				{
					$sTypes+=CargoProcess::OI_STYPE;
				}

				if(!empty($c->mdata['sent_confirm_sms_date'])&&HolidayHelper::checkBetweenHours(date("Y-m-d H:i:s"),$c->mdata['sent_confirm_sms_date'])>24&&$c->sub_type==CargoProcess::SENT_SMS_STYPE)
				{
					$strIsNotReplay = 1;
					$sTypes+=CargoProcess::W24R_STYPE;
					// -----------add cargo into cjob-----------------
					// if($c->setCargoProcessInToAvailableCJob()){
					// 	//Do Something like send email;
					// }
				}
			}
			if($c->sub_type ==0)//for the cargos are new
			{
				if($sTypes==0&&$c->sub_type ==0)
				{
					$sentSmsResult = $emailService->sendNormalCargoSmsEmail($c);
					if($sentSmsResult===true)
					{
						$sTypes=CargoProcess::SENT_SMS_STYPE;
					}else if(in_array($sentSmsResult,["send email and SMS failed","send email failed and phone number is wrong","empty email and phone number consignee"]))
					{
						$sTypes=CargoProcess::SENT_SMS_FAILED_STYPE;
						$c->status =CargoProcess::WAITINGERRORCHECKING;
						$c->log($sentSmsResult);
					}else
					{
						$sTypes=CargoProcess::SENT_SMS_STYPE;
					}
				}else
				{
					$c->status =CargoProcess::WAITINGERRORCHECKING;
				}
				$c->sub_type = $sTypes;
				$c->save();
			}else if($c->sub_type ==CargoProcess::SENT_SMS_STYPE)// for the cargos sent sms
			{
				if($sTypes!=0)
				{
					if($strIsNotReplay == 1){
						if($c->setCargoProcessInToAvailableCJob()){
							if(!empty($c->job_relation->job)){
								$sentSmsAutoCJob = $emailService->send24HoursNotReplySms($c);
								$link = "https://book.toplogistics.com.au/cargoConfirm?caref=".$c->getRef();
								$href = '<a target = "_blank" href="' . $link .'">Here</a>';
								$time = date('d-m-Y',strtotime($c->job_relation->job->created));
								$c->shipment->addTrackingLimited(100,'Didn’t receive your confirmation in 24 hours. will delivery on'.$time);
							}else{
								$sentSmsAutoCJob = $emailService->send24HoursnotinCjob($c);
								$link = "https://book.toplogistics.com.au/cargoConfirm?caref=".$c->getRef();
								$href = '<a target = "_blank" href="' . $link .'">Here</a>';
								$c->shipment->addTrackingLimited(100,'Didn’t receive your confirmation in 24 hours. will delivery in next 5 business days base on'.$href);
								$c->status =CargoProcess::WAITINGASSIGNDRIVER;
								//$c->log('sent sms error');
								$c->save();
							}
						}else{
							$sentSmsAutoCJob = $emailService->send24HoursnotinCjob($c);
							$link = "https://book.toplogistics.com.au/cargoConfirm?caref=".$c->getRef();
							$href = '<a target = "_blank" href="' . $link .'">Here</a>';
							$c->shipment->addTrackingLimited(100,'Didn’t receive your confirmation in 24 hours. will delivery in next 5 business days base on'.$href);
							$c->status =CargoProcess::WAITINGASSIGNDRIVER;
							//$c->log('sent sms error');
							$c->save();
						}
					}else{
						$c->sub_type = $sTypes+$c->sub_type;
						$c->status =CargoProcess::WAITINGERRORCHECKING;
						$c->log('sent sms error');
						$c->save();
					}
				}

			}else if($c->sub_type ==CargoProcess::RECEIVED_SMS_STYPE)// for the cargos sent sms
			{
				if($sTypes!=0)
				{
					$c->sub_type = $sTypes+$c->sub_type;
					$c->status =CargoProcess::WAITINGERRORCHECKING;
					$c->log('sent sms error');
					$c->save();
				}else
				{
					$c->status = CargoProcess::WAITINGASSIGNDRIVER;
					$c->save();
				}
			}
		}

		$objPrecargoProcesses = CargoProcess::model()->with('shipment')->findAll("hbn not like '%JBCD123025%' and shipment.agent_id !=4045 and (sub_type = 0 or sub_type = :smsSentType or sub_type =:smsReceivedType) and t.type = :type and t.status = :status",[":type"=>CargoProcess::NORMAL_CARGO,":status"=>CargoProcess::PREPROCESS,":smsSentType"=>CargoProcess::SENT_SMS_STYPE,":smsReceivedType"=>CargoProcess::RECEIVED_SMS_STYPE]);

		if(!empty($objPrecargoProcesses)){
			foreach($objPrecargoProcesses as $c){

				$sTypes = 0;
				$strIsNotReplay = 0;
				if($c->sub_type ==0)
				{
					if(empty(Addr::auTelValid($c->shipment->cnee->tel)))
					{
						$sTypes += CargoProcess::WPN_STYPE;
					}
					$distanceCheck = ZoneMapService::checkIsLongDistance($c->shipment);
					if($distanceCheck==1)
					{
						$sTypes += CargoProcess::LD_STYPE;
					}else if($distanceCheck==2)
					{
						$sTypes += CargoProcess::WA_STYPE;
					}
				}else{
					if(!empty($c->mdata['other_inquery']))
					{
						$sTypes+=CargoProcess::OI_STYPE;
					}

					if(!empty($c->mdata['sent_confirm_sms_date'])&&HolidayHelper::checkBetweenHours(date("Y-m-d H:i:s"),$c->mdata['sent_confirm_sms_date'])>24&&$c->sub_type==CargoProcess::SENT_SMS_STYPE)
					{
						$strIsNotReplay = 1;
						$sTypes+=CargoProcess::W24R_STYPE;
					}
				}
				if($c->sub_type ==0){
					if($sTypes==0&&$c->sub_type ==0)
					{
						$sentSmsResult = $emailService->sendNormalCargoSmsEmail($c);
						if($sentSmsResult===true)
						{
							$sTypes=CargoProcess::SENT_SMS_STYPE;
						}else if(in_array($sentSmsResult,["send email and SMS failed","send email failed and phone number is wrong","empty email and phone number consignee"]))
						{
							$sTypes=CargoProcess::SENT_SMS_FAILED_STYPE;
							$c->status =CargoProcess::WAITINGERRORCHECKING;
							$c->log($sentSmsResult);
						}else
						{
							$sTypes=CargoProcess::SENT_SMS_STYPE;
						}
					}else{
						$c->status =CargoProcess::WAITINGERRORCHECKING;
					}
					$c->sub_type = $sTypes;
					$c->save();
				}else if($c->sub_type ==CargoProcess::SENT_SMS_STYPE){
					if($sTypes!=0){
						$c->sub_type = $sTypes+$c->sub_type;
						$sentSmsPreNotReply = $emailService->sendPreNotReply($c);
						$link = "https://book.toplogistics.com.au/cargoConfirm?caref=".$c->getRef();
						$href = '<a target = "_blank" href="' . $link .'">Here</a>';
						$unloadingDate = $c->shipment->mdata['ContainerUnloadDate'];
						if(!empty($unloadingDate)&&strtotime($unloadingDate)>=strtotime(date('Y-m-d'))){
							$preStrDate = date('d-m-Y',strtotime($unloadingDate) + (2 * 24 * 3600));
							//$preEndDate = date('d-m-y',strtotime($unloadingDate) + (6 * 24 * 3600));
						}else{
							$preStrDate = date('d-m-Y',strtotime(date('d-m-Y')) + (2 * 24 * 3600));
							//$preEndDate = date('d-m-Y',strtotime(date('d-m-Y')) + (6 * 24 * 3600));
						}
						$c->shipment->addTrackingLimited(100,'Didn’t receive your confirmation in 24 hours. will delivery from '.$preStrDate.' 4 business days base on '.$href);
						if($strIsNotReplay == 1){
							$c->status =CargoProcess::WAITINGASSIGNDRIVER;
						}else{
							$c->status =CargoProcess::WAITINGERRORCHECKING;
						}
						$c->save();
					}
				}
			}
		}
	}


