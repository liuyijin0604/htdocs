	/*delete exconnsol zip package after 8 days;
	*
	*/

	public function delete_zip()
	{
		$rs=TaskToRun::model()->findAll('finish=1 and date >:stdate AND date<:eddate', [':stdate'=>date("Y-m-d", strtotime("-14 day", strtotime(date('Y-m-d')))), ':eddate'=>date("Y-m-d", strtotime("-7 day", strtotime(date('Y-m-d'))))]);
		if (!empty($rs)) {
			foreach ($rs as $r) {
				$files=FileRepo::model()->findAll('type=80 AND fid=:fid', [':fid'=>$r->pid]);
				$consol=Consol::model()->find('id=:id ', [':id'=>$r->pid]);
				if (!empty($files)&&!empty($consol)) {
					foreach ($files as $file) {
						if (preg_match("/$consol->no-$consol->awb/i", $file->name)) {
							if (!empty($file->hash)) {
								$dir=Yii::app()->basePath.DIRECTORY_SEPARATOR.'filerepo'.DIRECTORY_SEPARATOR.substr($file->hash, 0, 2).DIRECTORY_SEPARATOR.$file->hash;
								unlink($dir);
								$file->delete();
							}
						}
					}
					$r->finish=2;
					$r->save();
				}
			}
		}
	}


