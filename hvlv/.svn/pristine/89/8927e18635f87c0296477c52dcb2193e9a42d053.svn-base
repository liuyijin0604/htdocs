	public function syncCatchOrder()
	{
		$mirakl = new MiraklAPI();
		$client = $mirakl->getClient();
		$orders = $mirakl->getOrders();

		$this->_processCatchOrder($orders,$mirakl);
	}

	public function _processCatchOrder($orders,$mirakl)
	{
		$transaction = Yii::app()->db->beginTransaction();
		try {

			foreach($orders as $order){
				$orderStatus = $order->getStatus()->getData()['state'];
	
				if($orderStatus !='SHIPPING'){
					continue ;
				}
				
				$orderId = $order->getId();
				$task_map = WmsTaskMap::model()->find('fid = :fid AND platform = "shopify"', [':fid' => $orderId]);
				if (empty($task_map)) {
					$job = WmsJob::model()->find('org_id=:oid AND type = 20 and week(`created`,1)=:week', array(':oid' => $mirakl->org_id, ':week' => intval(date('W'))));
					if (empty($job)) {
						$job = new WmsJob;
						$job->org_id = $mirakl->org_id;
						$job->type = 20;
						$job->status = 10;
						$job->ref = '3PL_' . date('Y-m-d');
						$job->dpt_id = 106;
						if ($mirakl->org_id == Org::ORGID_3PL_SUBEMO) {
							$job->dpt_id = 106;
						}
						$job->save();
					}
					if ($job->getErrors()) {
						foreach ($job->getErrors() as $error) {
							$this->shopifyLog($error[0]);
							$errors[] = $error[0];
						}
					}

					// Create pick&pack task
					$task_errors = [];
					$task = new WmsTask;
					$task->job_id = $job->id;
					$task->type = 3030;
					$task->is_request = 1;
					$task->op_id = 0;
					$task->status = 20;
					$task->bwf = 256;
					$task->dpt_id = $job->dpt_id;
					$task->schd_time = date("Y-m-d H:i:s");
					$customershippingaddress=$order->getCustomer()->getShippingAddress();
					//$temp = $orderId . ' ' . $customershippingaddress->getData()['firstname'] . ' ' . $customershippingaddress->getData()['lastname'] . ' ' . $customershippingaddress->getData()['zip_code'];
					$task->ref = 'Catch '. $customershippingaddress->getData()['firstname'] . ' ' . $customershippingaddress->getData()['lastname'] . ' ' . $customershippingaddress->getData()['zip_code'];
					$prods = [];
					$backorder = false;
					$not_exist = [];

					$orderlines=$order->getOrderLines();
					foreach ($orderlines as $item) {
						
						$prod = null;
						// Get prod
						$prodSku=$item->getOffer()->getProduct()->getSku();
						$ProdTitle = $item->getOffer()->getProduct()->getTitle();
						$prodQty=$item->getQuantity();

						//$prodSku='6945372102386';
						if (!empty($prodSku)){
							$prod = WmsProd::model()->find('ean = :ean AND status = 1', [':ean' => $prodSku]);
						}

						if (empty($prod)) {
							$task_errors[] = $ProdTitle . ' ' . $orderId . ' does not exist in TLA';
							continue;
						}

						if (empty($prods[$prod->id])) $prods[$prod->id] = 0;
						if ($prod->type != WmsProd::WMS_PROD_KIT) {
							$prods[$prod->id] += $prodQty;
						}
					}

					$items = [];
					foreach ($prods as $prod_id => $qty) {
						$temp_qty = $qty;
						// Get stocks
						$stocks = WmsStock::model()->findAll('prod_id = :prod_id AND org_id = :org_id AND dpt_id =106 AND qty - qty_res > 0', [':prod_id' => $prod_id, ':org_id' => $mirakl->org_id]);
						if(empty($stocks)){
							$backorder = false;
							$task_errors[] = $prod->name . ' in ' . $orderId . ' quantity is less than ' . $temp_qty . ', only ' . (intval($temp_qty) - intval($qty)) . '.';
						}
						foreach ($stocks as $stock) {
							if ($qty > 0) {
								$items[] = [
									'si' => $stock->id,
									'sn' => $stock->prod->name,
									'pq' => '',
									'cq' => '',
									'uq' => min($qty, $stock->availQty()),
									'pli' => '',
									'pl' => '',
									'nt' => '',
								];
								$qty -= min($qty, $stock->availQty());
							} else {
								break;
							}
						}

						$prod = WmsProd::model()->findByPk($prod_id);
						if ($qty > 0) {
							$task_errors[] = $prod->name . ' in ' . $orderId . ' quantity is less than ' . $temp_qty . ', only ' . (intval($temp_qty) - intval($qty)) . '.';

							$stock = WmsStock::model()->find('prod_id = :prod_id AND org_id = :org_id AND dpt_id =106', [':prod_id' => $prod_id, ':org_id' => $mirakl->org_id]);
							$items[] = [
								'si' => $stock->id,
								'sn' => $stock->prod->name,
								'pq' => '',
								'cq' => '',
								'uq' => $qty,
								'pli' => '',
								'pl' => '',
								'nt' => '',
							];
							$backorder = false;
						}
						if (!empty($not_exist)) {
							foreach ($not_exist as $name => $qty) {
								$items[] = [
									'si' => '',
									'sn' => $name,
									'pq' => '',
									'cq' => '',
									'uq' => $qty,
									'pli' => '',
									'pl' => '',
									'nt' => '',
								];
							}
						}
					}

					if ($task->getErrors()) {
						foreach ($task->getErrors() as $error) {
							$errors[] = $error[0];
						}
					}else {
						if (!empty($task_errors)) {
							foreach ($task_errors as $error) {
								$this->shopifyLog($error);
								$errors[] = $error;
							}
							if ($backorder) {
								$task->status = 10;
							} else {
								$task->status = 40;
							}
						}
						$task->mdata['note'] = implode('; ', $task_errors);
						$task->new_items = $items;
						$task->save();

						// Delivery
						$task->pickupTask->type = 2120;
						$delivery_task = $task->pickupTask;
						//$delivery_task->mdata['cnee']['company'] = "";
						$delivery_task->mdata['cnee']['name'] = @$customershippingaddress->getData()['firstname'] . ' ' . @$customershippingaddress->getData()['lastname'];
						$delivery_task->mdata['cnee']['tel'] = !empty(@$customershippingaddress->getData()['phone'])? @$customershippingaddress->getData()['phone']: "0423101775";
						$delivery_task->mdata['cnee']['address'] = @$customershippingaddress->getData()['street_1'] . ' ' . @$customershippingaddress->getData()['street_2'];
						$delivery_task->mdata['cnee']['city'] = @$customershippingaddress->getData()['city'];
						$delivery_task->mdata['cnee']['suburb'] = @$customershippingaddress->getData()['city'];
						$delivery_task->mdata['cnee']['state'] = Addr::checkAuState(@$customershippingaddress->getData()['state']);
						$delivery_task->mdata['cnee']['postcode'] = @$customershippingaddress->getData()['zip_code'];
						$delivery_task->mdata['cnee']['country'] = (@$customershippingaddress->getData()['country_iso_code']=='AUS')? "AU": @$customershippingaddress->getData()['country_iso_code'];
						//$delivery_task->mdata['cnee']['email'] = "";

						$delivery_task->chooseCourier();
						$delivery_task->save();

						// Create task map
						$task_map = new WmsTaskMap;
						$task_map->fid = $orderId;
						$task_map->platform = 'catch';
						$task_map->task_id = $task->id;
						$task_map->save();
					}
				}
				$transaction->commit();
			}
		}catch (Exception $ex) {
			$transaction->rollback();
			$this->log('Sync Catch order fail');
			throw $ex;
		}

	}

	public function syncShopifyProd($prior = 'ean')
	{
		if (!empty($this->args[1])) {
			$prior = $this->args[1];
		}

		$custs = WmsAPI::model()->findAll('type = :type AND status = :status', [':type' => WmsAPI::WMS_API_TYPE_SHOPIFY, ':status' => WmsAPI::WMS_API_STATUS_ALL]);
		foreach ($custs as $cust) {
			$config = array(
				'store_domain' => $cust->domain,
				'api_key' => $cust->api_key,
				'api_secret' => $cust->api_secret,
				'org_id' => $cust->org_id,
			);
			$shopify = new ShopifyAPI($config);
			$this->_syncShopifyProd($shopify, $prior);
		}

	}

	public function _syncShopifyProd($shopify, $prior)
	{
		// Count products
		$r = $shopify->countProducts();

		$transaction = Yii::app()->db->beginTransaction();
		try {
			if ($r['done'] == true) {
				while ($r['count'] > 0) {
					$page = ceil($r['count'] / 250);
					$r['count'] -= 250;

					// Get products
					$products = $shopify->getProducts($page);
					if ($products['done'] == true) {
						foreach ($products['products'] as $product) {
							foreach ($product['variants'] as $variant) {
								// if already exist map, then skip
								$prod_map = WmsProdMap::model()->find('fid = :fid AND platform = "shopify"', [':fid' => $variant['id']]);
								if (!empty($prod_map)) continue;

								// extract barcode or sku
								if ($prior == 'ean') {
									if (!empty($variant['barcode'])) {
										$code = $variant['barcode'];
									} else if (!empty($variant['sku'])) {
										$code = $variant['sku'];
									} else {
										continue;
									}
								} else {
									if (!empty($variant['sku'])) {
										$code = $variant['sku'];
									} else if (!empty($variant['barcode'])) {
										$code = $variant['barcode'];
									} else {
										continue;
									}
								}

								// probably only have sku, then search sku first
								$prod = WmsProd::model()->with('orgs')->find('orgs.sku = :sku AND orgs.org_id = :org_id AND t.status = 1', [':sku' => $code, ':org_id' => $shopify->org_id]);
								// elekzon may change their sku format
								if (empty($prod)) {
									$prod = WmsProd::model()->with('orgs')->find('orgs.sku = :sku AND orgs.org_id = :org_id AND t.status = 1', [':sku' => str_replace('_', ' ', $code), ':org_id' => $shopify->org_id]);
								}
								if (empty($prod)) {
									$prod = WmsProd::model()->find('ean = :ean AND status = 1', [':ean' => $code]);
								}
								if (empty($prod)) {
									$prod = new WmsProd;
									$prod->type = 10;
									$prod->status = 1;
									$prod->name = $product['title'] . ' ' . $variant['title'];
									$prod->ean = $code;
									$prod->brand = $product['vendor'];
									$prod->weight = $variant['weight'];
									$prod->save();
								}

								$prod_org = WmsProdOrg::model()->find('prod_id = :prod_id AND org_id = :org_id', [':prod_id' => $prod->id, ':org_id' => $shopify->org_id]);
								if (empty($prod_org)) {
									$prod_org = new WmsProdOrg;
									$prod_org->prod_id = $prod->id;
									$prod_org->org_id = $shopify->org_id;
									$prod_org->sku = $variant['sku'];
									$prod_org->save();
								}

								$prod_map = WmsProdMap::model()->find('fid = :fid AND platform = "shopify" AND prod_id = :prod_id', [':fid' => $variant['id'], ':prod_id' => $prod->id]);
								if (empty($prod_map)) {
									$prod_map = new WmsProdMap;
									$prod_map->fid = $variant['id'];
									$prod_map->platform = 'shopify';
									$prod_map->prod_id = $prod->id;
									$prod_map->save();
								}

								$stock = WmsStock::model()->find('prod_id = :prod_id', [':prod_id' => $prod->id]);
								if (empty($stock)) {
									$stock = new WmsStock;
									$stock->org_id = $shopify->org_id;
									$stock->prod_id = $prod->id;
									$stock->qty = 0;
									$stock->qty_res = 0;
									$stock->save();
								}

								// if ($shopify->org_id == Org::ORGID_3PL_ELEKZON) {
								// 	$stocks = WmsStock::model()->findAll('prod_id = :prod_id AND org_id = :org_id', [':prod_id' => $prod->id, ':org_id' => $shopify->org_id]);
								// 	$qty = 0;
								// 	foreach ($stocks as $stock) {
								// 		$qty += $stock->qty - $stock->qty_res;
								// 	}

								// 	if ($qty == $inventory_level['available']) continue;
								// 	$inventories = $shopify->getInventoryLevels($variant['inventory_item_id']);
								// 	foreach ($inventories['inventory_levels'] as $inventory_level) {
								// 		$result = $shopify->editInventoryLevel($variant['inventory_item_id'], $inventory_level['location_id'], $qty - $inventory_level['available']);
								// 	}
								// }
							}
						}
					}
				}
				$transaction->commit();
			}
		} catch (Exception $ex) {
			$transaction->rollback();
			$this->log('Sync Shopify product fail');
			throw $ex;
		}
	}

	public function syncShopifyOrder()
	{
		$custs = WmsAPI::model()->findAll('type = :type AND status = :status', [':type' => WmsAPI::WMS_API_TYPE_SHOPIFY, ':status' => WmsAPI::WMS_API_STATUS_ALL]);
		foreach ($custs as $cust) {
			// elekzon only sync at 9:00 and 12:00
			if ($this->mn == 25 && $cust->org_id == Org::ORGID_3PL_ELEKZON) continue;

			$config = array(
				'store_domain' => $cust->domain,
				'api_key' => $cust->api_key,
				'api_secret' => $cust->api_secret,
				'org_id' => $cust->org_id,
			);
			$shopify = new ShopifyAPI($config);
			$this->_syncShopifyOrder($shopify);
			// $this->_cancelShopifyOrder($shopify);
		}

	}

	public function _syncShopifyOrder($shopify)
	{
		foreach (['pending', 'partially_refunded', 'paid', 'partially_paid'] as $status) {
			if (in_array($status, ['pending', 'partially_paid']) && !in_array($shopify->org_id, [Org::ORGID_3PL_ELEKZON])) continue;
			// Count orders
			$r = $shopify->countOrders('open', $status);

			$transaction = Yii::app()->db->beginTransaction();
			try {
				if ($r['done'] == true) {
					while ($r['count'] > 0) {
						$page = ceil($r['count'] / 250);
						$r['count'] -= 250;

						// Get orders
						$orders = $shopify->getOrders($page, 'open', $status);
						if ($orders['done'] == true) {
							$this->_processShopifyOrder($orders, $shopify);
						}
					}
					$transaction->commit();
				}
			} catch (Exception $ex) {
				$transaction->rollback();
				$this->log('Sync Shopify order fail');
				throw $ex;
			}
		}
	}

	public function _cancelShopifyOrder($shopify)
	{
		$r = $shopify->countOrders('cancelled');

		$transaction = Yii::app()->db->beginTransaction();
		try {
			if ($r['done'] == true) {
				while ($r['count'] > 0) {
					$page = ceil($r['count'] / 250);
					$r['count'] -= 250;

					// Get orders
					$orders = $shopify->getOrders($page, 'cancelled');
					if ($orders['done'] == true) {
						foreach ($orders['orders'] as $order) {
							$task_map = WmsTaskMap::model()->find('fid = :fid AND platform = "shopify"', [':fid' => $order['id']]);
							if (empty($task_map)) {
								continue;
							}

							if (!empty($order['cancelled_at'])) {
								if ($task_map->task->status <= 20) {
									$task_map->task->status = 100;
									$task_map->task->save();
								} else if ($task_map->task->status != 100) {
									$this->shopifyLog($task_map->task->getNo() . ' could not cancel in ' . $task_map->task->getStatus() . ' at ' . $order['cancelled_at']);
								} else {
									$this->shopifyLog($task_map->task->getNo() . ' already cancelled at ' . $order['cancelled_at']);
								}
								$task_map->task->mdata['cancelled_at'] = date('Y-m-d H:i:s', strtotime($order['cancelled_at']));
								$task_map->task->update('meta');
							}
						}
					}
				}
				$transaction->commit();
			}
		} catch (Exception $ex) {
			$transaction->rollback();
			$this->log('Cancel Shopify order fail');
			throw $ex;
		}
	}

	public function _processShopifyOrder($orders, $shopify)
	{
		$errors = [];
		$orders['orders'] = array_reverse($orders['orders']);
		foreach ($orders['orders'] as $order) {

			if ($order['fulfillment_status'] == 'fulfilled') {
				continue;
			}

			if ($order['financial_status'] == 'pending') {
				continue;
			}

			$task_map = WmsTaskMap::model()->find('fid = :fid AND platform = "shopify"', [':fid' => $order['id']]);
			if (empty($task_map)) {
				// Get job
				$job = WmsJob::model()->find('org_id=:oid AND type = 20 and week(`created`,1)=:week', array(':oid' => $shopify->org_id, ':week' => intval(date('W'))));
				//$job = WmsJob::model()->find(['condition' => 'org_id = :org_id AND type = 30 AND week(`created`, 1) = :week', 'params' => [':org_id' => $shopify->org_id, ':week' => intval(date('W'))], 'order' => 'id desc']);
				if (empty($job)) {
					$job = new WmsJob;
					$job->org_id = $shopify->org_id;
					$job->type = 20;
					$job->status = 10;
					$job->ref = '3PL_' . date('Y-m-d');
					$job->dpt_id = 106;
					if ($shopify->org_id == Org::ORGID_3PL_SUBEMO) {
						$job->dpt_id = 106;
					}
					$job->save();
				}
				if ($job->getErrors()) {
					foreach ($job->getErrors() as $error) {
						$this->shopifyLog($error[0]);
						$errors[] = $error[0];
					}
				}
				// Create pick&pack task
				$task_errors = [];
				$task = new WmsTask;
				$task->job_id = $job->id;
				$task->type = 3030;
				$task->is_request = 1;
				$task->op_id = 0;
				$task->status = 20;
				$task->bwf = 256;
				$task->dpt_id = $job->dpt_id;
				$task->schd_time = date("Y-m-d H:i:s");

				$task->ref = 'Shopify '.$order['name'] . ' ' . @$order['shipping_address']['zip'];
				$prods = [];
				$backorder = false;
				$not_exist = [];
				foreach ($order['line_items'] as $item) {
					$prod = null;
					// Get prod
					$prod_map = WmsProdMap::model()->with('prod')->find('t.fid = :fid AND t.platform = "shopify" AND prod.status = 1', [':fid' => $item['variant_id']]);
					if (!empty($prod_map)) {
						$prod = $prod_map->prod;
					} else if (!empty($item['barcode'])) {
						$prod = WmsProd::model()->find('ean = :ean AND status = 1', [':ean' => $item['barcode']]);
					} else if (!empty($item['sku'])) {
						$prod = WmsProd::model()->with('orgs')->find('orgs.sku = :sku AND orgs.org_id = :org_id AND status = 1', [':sku' => $item['sku'], ':org_id' => $shopify->org_id]);
						// 2020-04-22
						if (empty($prod)) {
							$prod = WmsProd::model()->with('orgs')->find('orgs.sku = :sku AND orgs.org_id = :org_id AND status = 1', [':sku' => str_replace('_', ' ', $item['sku']), ':org_id' => $shopify->org_id]);
						}
					}

					// 2020-06-22
					// if ($prod->ean == 'LIP004') {
					// 	$prod = WmsProd::model()->find('ean = "LIP004X2"');
					// }

					// 2020-04-22
					if (empty($prod) && !empty($item['barcode'])) {
						$pack = WmsProdPack::model()->with('prod')->find('barcode = :barcode AND prod.status = 1', [':barcode' => $item['barcode']]);
						if (!empty($pack)) {
							$prod = $pack->prod;
							$item['quantity'] *= $pack->qty;
						}
					}
					if (empty($prod) && !empty($item['sku'])) {
						$pack = WmsProdPack::model()->with('prod')->find('barcode = :barcode AND prod.status = 1', [':barcode' => $item['sku']]);
						if (!empty($pack)) {
							$prod = $pack->prod;
							$item['quantity'] *= $pack->qty;
						}
					}

					if (empty($prod)) {
						$task_errors[] = $item['name'] . ' ' . $item['variant_id'] .' '.$item['sku']. ' does not exist in PCAE';
						if (!isset($not_exist[$item['name']])) $not_exist[$item['name']] = 0;
						$not_exist[$item['name']] += $item['quantity'];
						continue;
					}

					// special product filter
					if (in_array($item['name'], ['FREE POSTAGE'])) {
						continue;
					}

					// if (empty($prods[$prod->id])) $prods[$prod->id] = 0;
					// $prods[$prod->id] += $item['quantity'];
					// accept pack/kit sku
					if (empty($prods[$prod->id])) $prods[$prod->id] = 0;
					if ($prod->type != WmsProd::WMS_PROD_KIT) {
						$prods[$prod->id] += $item['quantity'];
					} else if ($prod->type == WmsProd::WMS_PROD_KIT) {
						// don't record kit, cause backorder
						// $prods[$prod->id] += $item['quantity'];
						foreach ($prod->items as $prod_item) {
							if (!isset($prods[$prod_item->item->id])) $prods[$prod_item->item->id] = 0;
							$prods[$prod_item->item->id] += intval($item['quantity']) * $prod_item->qty;
						}
					}
				}
				$items = [];
				foreach ($prods as $prod_id => $qty) {
					$temp_qty = $qty;
					// Get stocks
					$stocks = WmsStock::model()->findAll('prod_id = :prod_id AND org_id = :org_id AND dpt_id = 106 AND qty - qty_res > 0', [':prod_id' => $prod_id, ':org_id' => $shopify->org_id]);
					if(empty($stocks)){
						$backorder = false;
						$task_errors[] = $prod->name . ' in ' . $order['name'] . ' quantity is less than ' . $temp_qty . ', only ' . (intval($temp_qty) - intval($qty)) . '.';
						//continue;
					}
					foreach ($stocks as $stock) {
						if ($qty > 0) {
							$items[] = [
								'si' => $stock->id,
								'sn' => $stock->prod->name,
								'pq' => '',
								'cq' => '',
								'uq' => min($qty, $stock->availQty()),
								'pli' => '',
								'pl' => '',
								'nt' => '',
							];
							$qty -= min($qty, $stock->availQty());
						} else {
							break;
						}
					}

					$prod = WmsProd::model()->findByPk($prod_id);
					if ($qty > 0) {
						$task_errors[] = $prod->name . ' in ' . $order['name'] . ' quantity is less than ' . $temp_qty . ', only ' . (intval($temp_qty) - intval($qty)) . '.';

						// 2020-06-22 still record item
						$stock = WmsStock::model()->find('prod_id = :prod_id AND org_id = :org_id and dpt_id = 106', [':prod_id' => $prod_id, ':org_id' => $shopify->org_id]);
						$items[] = [
							'si' => $stock->id,
							'sn' => $stock->prod->name,
							'pq' => '',
							'cq' => '',
							'uq' => $qty,
							'pli' => '',
							'pl' => '',
							'nt' => '',
						];
						$backorder = false;
					}

					if (!empty($not_exist)) {
						foreach ($not_exist as $name => $qty) {
							$items[] = [
								'si' => '',
								'sn' => $name,
								'pq' => '',
								'cq' => '',
								'uq' => $qty,
								'pli' => '',
								'pl' => '',
								'nt' => '',
							];
						}
						$backorder = false;
					}
				}

				if ($task->getErrors()) {
					foreach ($task->getErrors() as $error) {
						$this->shopifyLog($error[0]);
						$errors[] = $error[0];
					}
				} else {
					if (!empty($task_errors)) {
						foreach ($task_errors as $error) {
							$this->shopifyLog($error);
							$errors[] = $error;
						}
						if ($backorder) {
							$task->status = 10;
						} else {
							$task->status = 40;
						}
					}
					$task->mdata['note'] = implode('; ', $task_errors);
					$task->new_items = $items;
					if($task->save()){
						// Delivery
					$task->pickupTask->type = 2120;
					$delivery_task = $task->pickupTask;
					$delivery_task->mdata['cnee']['company'] = @$order['shipping_address']['company'];
					$delivery_task->mdata['cnee']['name'] = @$order['shipping_address']['first_name'] . ' ' . @$order['shipping_address']['last_name'];
					$delivery_task->mdata['cnee']['tel'] = !empty(@$order['shipping_address']['phone'])? @$order['shipping_address']['phone']: "0423101775";
					$delivery_task->mdata['cnee']['address'] = @$order['shipping_address']['address1'] . ' ' . @$order['shipping_address']['address2'];
					$delivery_task->mdata['cnee']['city'] = @$order['shipping_address']['city'];
					$delivery_task->mdata['cnee']['suburb'] = @$order['shipping_address']['city'];
					$delivery_task->mdata['cnee']['state'] = Addr::checkAuState(@$order['shipping_address']['province']);
					$delivery_task->mdata['cnee']['postcode'] = @$order['shipping_address']['zip'];
					$delivery_task->mdata['cnee']['country'] = @$order['shipping_address']['country_code'];
					$delivery_task->mdata['cnee']['email'] = $order['email'];
					// elekzon default tnt
					//if ($shopify->org_id == Org::ORGID_3PL_ELEKZON) {
						// $delivery_task->mdata['courier'] = Org::ORGID_COURIER_TNT;
						//if (!empty($order['shipping_lines']) && preg_match('/Standard Shipping|Australia Free Shipping/i', $order['shipping_lines'][0]['code'])) {
							//$delivery_task->mdata['shopify_standard'] = true;
						//}
					//}

					$delivery_task->chooseCourier();
					$delivery_task->save();


					// Create task map
					$task_map = new WmsTaskMap;
					$task_map->fid = $order['id'];
					$task_map->platform = 'shopify';
					$task_map->task_id = $task->id;
					$task_map->save();
					}
				}
			} else {
				if (!empty($order['cancelled_at']) || (!empty($order['financial_status']) && $order['financial_status'] == 'voided')) {
					$task_map->task->status = 100;
					$task_map->task->save();
				}
			}
		}

		/*if ($shopify->org_id == Org::ORGID_3PL_ELEKZON && !empty($errors)) {
			$emailLog = new Emailog();
			$emailLog->type = Emailog::SHOPIFY_SYNC_REPORT;
			$emailLog->fid = 0;
			$emailLog->dt = date('Y-m-d H:i:s');
			$emailLog->to_id = $shopify->org_id;
			$emailLog->status = 10;
			$emailLog->prepTemplate();
			$emailLog->tpl->assignThese([
				'DETAIL' => implode('<br />', $errors),
			]);
			$emailLog->subject = $emailLog->tpl->subject;
			$emailLog->body = $emailLog->tpl->getContent();
			$emailLog->mdata['to'] = 'gero@toplogistics.com.au';
			if (!empty($emailLog->to_id)) {
				$org = Org::model()->findByPk($emailLog->to_id);
				if (!empty($org->email)) {
					$emailLog->mdata['to'] .= ';' . $org->email;
				}
				if ($emailLog->to_id == Org::ORGID_3PL_ELEKZON) {
					$emailLog->mdata['cc'] = 'gero@toplogistics.com.au';
				}
			}
			$emailLog->sendShopifySyncReport();
		}*/
	}

	public function syncShopifyStock()
	{
		$custs = WmsAPI::model()->findAll('type = :type AND status = :status', [':type' => WmsAPI::WMS_API_TYPE_SHOPIFY, ':status' => WmsAPI::WMS_API_STATUS_STOCK]);
		foreach ($custs as $cust) {
			$config = array(
				'store_domain' => $cust->domain,
				'api_key' => $cust->api_key,
				'api_secret' => $cust->api_secret,
				'org_id' => $cust->org_id,
			);
			$shopify = new ShopifyAPI($config);
			echo $shopify->org_id . PHP_EOL;
			$this->_syncShopifyStock($shopify);
		}
	}

	public function _syncShopifyStock($shopify)
	{
		$prods = [];
		$stocks = WmsStock::model()->with('prod')->findAll('t.org_id = :org_id AND prod.status = 1', [':org_id' => $shopify->org_id]);
		foreach ($stocks as $stock) {
			if (empty($prods[$stock->prod_id])) $prods[$stock->prod_id] = 0;
			$prods[$stock->prod_id] += $stock->getQty();
		}

		$location = $shopify->getPCALocation();

		foreach ($prods as $id => $qty) {
			$prod_map = WmsProdMap::model()->find('platform = "shopify" AND prod_id = :prod_id', array(':prod_id' => $id));
			if (!empty($prod_map)) {
				$variant = $shopify->getVariant($prod_map->fid);
				if (!empty($variant['variant']['inventory_item_id'])) {
					$inventories = $shopify->getInventoryLevels($variant['variant']['inventory_item_id']);
					foreach ($inventories['inventory_levels'] as $inventory_level) {
						if ($inventory_level['location_id'] != $location['id']) continue;
						$result = $shopify->editInventoryLevel($variant['variant']['inventory_item_id'], $inventory_level['location_id'], $qty - $inventory_level['available']);
					}
				}
			}
		}
	}

	public function shopifyLog($m)
	{
		$lf = Yii::app()->basePath . DIRECTORY_SEPARATOR . 'runtime' . DIRECTORY_SEPARATOR . 'shopify' . DIRECTORY_SEPARATOR;
		$lf .= 'shopify_' . date('Y-m-d H') . '.log';
		return file_put_contents($lf, date('Y-m-d H:i:s') . ' ' . $m . "\n", FILE_APPEND);
	}

	public function syncCin7Prod()
	{
		$custs = WmsAPI::model()->findAll('type = :type AND status = :status', [':type' => WmsAPI::WMS_API_TYPE_CIN7, ':status' => WmsAPI::WMS_API_STATUS_ALL]);
		foreach ($custs as $cust) {
			$config = array(
				'user' => $cust->api_key,
				'key' => $cust->api_secret,
				'org_id' => $cust->org_id,
			);
			$cin7 = new Cin7API($config);
			$this->_syncCin7Prod($cin7);
		}
	}

	public function _syncCin7Prod($cin7)
	{
		$r = $cin7->getProducts();

		$transaction = Yii::app()->db->beginTransaction();
		try {
			if ($r['done'] == true && empty($r['items']['message'])) {
				foreach ($r['items'] as $item) {
					if (empty($item['productOptions'])) {
						continue;
					}

					foreach ($item['productOptions'] as $option) {
						$prod = null;
						if (!empty($option['barcode'])) {
							$prod = WmsProd::model()->find('ean = :ean AND status = 1', [':ean' => $option['barcode']]);
						}
						if (empty($prod) && !empty($option['code'])) {
							$prod = WmsProd::model()->with('orgs')->find('orgs.sku = :sku AND orgs.org_id = :org_id AND status = 1', [':sku' => $option['code'], ':org_id' => $cin7->org_id]);
						}
						if (empty($prod) && !empty($item['name'])) {
							$prod = WmsProd::model()->find('name = :name AND status = 1', [':name' => $item['name'] . ' ' . $option['code']]);
						}

						if (empty($prod)) {
							$prod = new WmsProd;
							$prod->type = 10;
							$prod->status = 1;
							$prod->name = $item['name'] . ' ' . $option['code'];
							if (!empty($option['barcode'])) {
								$prod->ean = $option['barcode'];
							} else if (!empty($option['code'])) {
								$prod->ean = $option['code'];
							}
							$prod->brand = $item['brand'];
							$prod->weight = $option['optionWeight'];
							$prod->save();
						}

						$prod_map = WmsProdMap::model()->find('fid = :fid AND platform = "cin7" AND prod_id = :prod_id', [':fid' => $item['id'] . '_' . $option['id'], ':prod_id' => $prod->id]);
						if (empty($prod_map)) {
							$prod_map = new WmsProdMap;
							$prod_map->fid = $item['id'] . '_' . $option['id'];
							$prod_map->platform = 'cin7';
							$prod_map->prod_id = $prod->id;
							$prod_map->save();
						}

						if (!empty($option['code'])) {
							$prod_org = WmsProdOrg::model()->find('prod_id = :prod_id AND sku = :sku AND org_id = :org_id', [':prod_id' => $prod->id, ':sku' => $option['code'], ':org_id' => $cin7->org_id]);
							if (empty($prod_org)) {
								$prod_org = new WmsProdOrg;
								$prod_org->prod_id = $prod->id;
								$prod_org->sku = $option['code'];
								$prod_org->org_id = $cin7->org_id;
								$prod_org->save();
							}
						}
					}
				}
				$transaction->commit();
			}
		} catch (Exception $ex) {
			$transaction->rollback();
			$this->log('Sync CIN7 product fail');
			throw $ex;
		}
	}

