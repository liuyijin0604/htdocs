	/**
	* close all opened manifests for Fastway
	* we should close them every night according Fastway advice
	*/
	/**
	* close all opened manifests for Fastway
	* we should close them every night according Fastway advice
	*/
	public function closeFWOpenedManifest()
	{
		$fwApi = new FastwayAPI();
		$allOpenedManifest = $fwApi->getOpenedManifests();
		if (!empty($allOpenedManifest) && is_array($allOpenedManifest)) {
			foreach ($allOpenedManifest as $manifest) {
				// only close having consignments manifest
				if (isset($manifest->Consignments) && !empty($manifest->Consignments)) {
					$fwApi->closeManifest($manifest->ManifestID);
				}
			}
		}
	}

	/**
	* every day lodge all wms related parcels to local courier service system
	* currently only for Australia Post
	*/
	public function wmsParcelsCourierLodge()
	{

		// get all ready wms tasks firstly
		$tasks =  WmsTask::model()->findAll('type = 2120 AND bwf & 64 > 0');

		// get related all shipment ids
		// we need save shipment id to get task map as well
		// so that we can modify task bwf status once lodge successfully
		$shipments = [];
		$mapTasks = [];
		foreach ($tasks as $task) {
			if ($task->mainTask->status == 100 || ($task->mainTask->status != 99 && $task->mainTask->type != WmsTask::TYPE_RETURN)) continue;
			if (isset($task->mdata['shipment_id']) && !empty($task->mdata['shipment_id'])) {
				if (is_array($task->mdata['shipment_id'])) {
					foreach ($task->mdata['shipment_id'] as $sid) {
						$shipmentId = $sid;
						$shipments[] = Shipment::model()->findByPk($shipmentId);
						$mapTasks[$shipmentId] = $task;
					}
				} elseif (is_numeric($task->mdata['shipment_id'])) {
					$shipmentId = $task->mdata['shipment_id'];
					$shipments[] = Shipment::model()->findByPk($shipmentId);
					$mapTasks[$shipmentId] = $task;
				}
			} else if (isset($task->mdata['return_shipment_id']) && !empty($task->mdata['return_shipment_id'])) {
				if (is_array($task->mdata['return_shipment_id'])) {
					foreach ($task->mdata['return_shipment_id'] as $sid) {
						$shipmentId = $sid;
						$shipments[] = Shipment::model()->findByPk($shipmentId);
						$mapTasks[$shipmentId] = $task;
					}
				} elseif (is_numeric($task->mdata['return_shipment_id'])) {
					$shipmentId = $task->mdata['return_shipment_id'];
					$shipments[] = Shipment::model()->findByPk($shipmentId);
					$mapTasks[$shipmentId] = $task;
				}
			}
		}

		// lodge 1308 parcels
		$parcels_1308 = Shipment::model()->findAll('agent_id = 1308 AND id >= 6303117 AND consol_id = 0 AND status < 100');
		if (!empty($parcels_1308)) {
			$job = WmsJob::model()->find('org_id = 1308');
			if (empty($job)) {
				$job = new WmsJob;
				$job->type = 90;
				$job->org_id = 1308;
				$job->status = 10;
				$job->save();
			}
			$task = new WmsTask;
			$task->job_id = $job->id;
			$task->ref = date('Y-m-d');
			$task->type = 3030;
			$task->status = 99;
			$task->is_request = 1;
			$task->schd_time = date("Y-m-d H:i:s");
			$task->save();

			$task->pickupTask->type = array_search('Delivery', WmsTask::$types);
			$task->pickupTask->mdata['shipment_id'] = [];
			$task->pickupTask->update('type', 'meta');

			foreach ($parcels_1308 as $parcel) {
				$task->pickupTask->mdata['shipment_id'][] = $parcel->id;
				$task->pickupTask->update('meta');
			}
		}

		$shipments = array_merge($shipments, $parcels_1308);

		foreach ($shipments as $k => $shipment) {
			if(empty($shipment)){
				echo $k;
				unset($shipments[$k]);
				continue;
			}
			if ($shipment->status == ImParcel::STATE_CANCELLED) unset($shipments[$k]);
		}

		if (!empty($shipments)) {
			$con = new ImcoConsol;
			$con->owner_id = Org::ORGID_CLIENT_TLA; // currently set as top logistics
			$con->pol = 'AUSYD';
			$con->pod = 'AUSYD';
			$con->dpt_id = 106;
			$con->eta = date('Y-m-d');
			$con->created = date('Y-m-d');
			$con->status = 60; // set as reported , we have reported to aupost
			$con->save();

			$transaction=Yii::app()->db->beginTransaction();
			try {
				foreach($shipments as $s){
					if(empty($s)) continue;
					if (isset($mapTasks[$s->id])) {
						$task = $mapTasks[$s->id];
						$task->bwf = ($task->bwf^64)&$task->bwf;
						$task->update('bwf');
					}
					// connect console with shipments
					$s->consol_id = $con->id;
					if($s->status < 42) $s->status = 42;
					$s->update(['consol_id', 'status']);
				}
				$transaction->commit();
			} catch (Exception $ex) {
				$transaction->rollback();
				throw $ex;
			}
			Yii::import('application.controllers.ImcoConsolController');
			$cc = new ImcoConsolController('default');
			$cc->actionAllManifest($con->id);
		} else {
			$this->log('no matched WMS lodge shipments this time');
			return;
		}

		$aupost = [];
		$fastway = [];
		foreach ($shipments as $s) {
			if (preg_match('/^AMQ\d{7}/', $s->ref)) {
				$aupost[] = $s;
			}
			if (preg_match('/^33EVH\d{7}/', $s->ref)) {//aupost melbourne 33EVH
				$aupost[] = $s;
			}
			if (isset($s->trans) && !empty($s->trans) && $s->trans[0]->org_id == Org::ORGID_COURIER_FASTWAY) {
				$fastway[] = $s;
			}
		}

		if (!empty($aupost)) {
			$modelGatePass = new GatePass('create');
			$modelGatePass->dpt_id = 106;
			$modelGatePass->type = 50;
			$modelGatePass->status = 60;
			$modelGatePass->created = date('Y-m-d H:i:s');
			$modelGatePass->ref = $con->no;
			$modelGatePass->company = 'AUPOST';
			$modelGatePass->save();

			foreach ($aupost as $s) {
				$s->man_id = $modelGatePass->id;
				$s->update('man_id');

				$mm = new ManiMap;
				$mm->mani_id = $modelGatePass->id;
				$mm->fid = $s->id;
				$mm->status = 10;
				$mm->save();
			}
		}

		if (!empty($fastway)) {
			$modelGatePass = new GatePass('create');
			$modelGatePass->dpt_id = 106;
			$modelGatePass->type = 50;
			$modelGatePass->status = 60;
			$modelGatePass->created = date('Y-m-d H:i:s');
			$modelGatePass->ref = $con->no;
			$modelGatePass->company = 'FASTWAY';
			$modelGatePass->save();

			foreach ($fastway as $s) {
				$s->man_id = $modelGatePass->id;
				$s->update('man_id');

				$mm = new ManiMap;
				$mm->mani_id = $modelGatePass->id;
			}
		}
	}

		/**
	* every day lodge all wms related parcels to local courier service system
	* currently only for Australia Post
	*/
	public function wmsSFParcelsCourierLodge()
	{

		// get all ready wms tasks firstly
		$tasks =  WmsTask::model()->findAll('type = 2120 AND bwf & 64 > 0');

		// get related all shipment ids
		// we need save shipment id to get task map as well
		// so that we can modify task bwf status once lodge successfully
		$shipments = [];
		$mapTasks = [];
		foreach ($tasks as $task) {
			if ($task->mainTask->status == 100 || ($task->mainTask->status != 99 && $task->mainTask->type != WmsTask::TYPE_RETURN)) continue;
			if (isset($task->mdata['shipment_id']) && !empty($task->mdata['shipment_id'])) {
				if (is_array($task->mdata['shipment_id'])) {
					foreach ($task->mdata['shipment_id'] as $sid) {
						$shipmentId = $sid;
						$shipments[] = Shipment::model()->findByPk($shipmentId);
						$mapTasks[$shipmentId] = $task;
					}
				} elseif (is_numeric($task->mdata['shipment_id'])) {
					$shipmentId = $task->mdata['shipment_id'];
					$shipments[] = Shipment::model()->findByPk($shipmentId);
					$mapTasks[$shipmentId] = $task;
				}
			} else if (isset($task->mdata['return_shipment_id']) && !empty($task->mdata['return_shipment_id'])) {
				if (is_array($task->mdata['return_shipment_id'])) {
					foreach ($task->mdata['return_shipment_id'] as $sid) {
						$shipmentId = $sid;
						$shipments[] = Shipment::model()->findByPk($shipmentId);
						$mapTasks[$shipmentId] = $task;
					}
				} elseif (is_numeric($task->mdata['return_shipment_id'])) {
					$shipmentId = $task->mdata['return_shipment_id'];
					$shipments[] = Shipment::model()->findByPk($shipmentId);
					$mapTasks[$shipmentId] = $task;
				}
			}
		}

		foreach ($shipments as $k => $shipment) {
			if(empty($shipment)){
				echo $k;
				unset($shipments[$k]);
				continue;
			}
			if ($shipment->status == ImParcel::STATE_CANCELLED) unset($shipments[$k]);
			$trans = $shipment->trans;
			$tran = end($trans);
			if (!((!isset($tran->mdata['oid'])||(isset($tran->mdata['oid'])&&$tran->mdata['oid']!=Org::ORGID_COURIER_SF))&&($tran->org_id==Org::ORGID_COURIER_SF)&&$tran->connote==$shipment->ref)) unset($shipments[$k]);
		}

		if (!empty($shipments)) {
			$con = new ImcoConsol;
			$con->owner_id = Org::ORGID_CLIENT_TLA; // currently set as top logistics
			$con->pol = 'AUSYD';
			$con->pod = 'AUSYD';
			$con->dpt_id = 106;
			$con->eta = date('Y-m-d');
			$con->created = date('Y-m-d');
			$con->status = 60; // set as reported , we have reported to aupost
			$con->save();

			$transaction=Yii::app()->db->beginTransaction();
			try {
				foreach($shipments as $s){
					echo $s->ref;
					if(empty($s)) continue;

					if (isset($mapTasks[$s->id])) {
						$task = $mapTasks[$s->id];
						$task->bwf = ($task->bwf^64)&$task->bwf;
						$task->update('bwf');
					}
					// connect console with shipments
					$s->consol_id = $con->id;
					if($s->status < 42) $s->status = 42;
					$s->update(['consol_id', 'status']);
				}
				$transaction->commit();
			} catch (Exception $ex) {
				$transaction->rollback();
				throw $ex;
			}
			Yii::import('application.controllers.ImcoConsolController');
			$cc = new ImcoConsolController('default');
			$cc->actionSfManifest($con->id);
		} else {
			$this->log('no matched WMS lodge shipments this time');
			return;
		}

		
	}

	public function wmsDFEShipments()
	{
		$shipments = Shipment::model()->findAll('status < 100 AND status = 42 and ot_id = 10 and consol_id = 0');
		if (!empty($shipments))
		{
			$con = new ImcoConsol;
			$con->owner_id = Org::ORGID_CLIENT_TLA; // currently set as top logistics
			$con->pol = 'AUSYD';
			$con->pod = 'AUSYD';
			$con->dpt_id = 106;
			$con->eta = date('Y-m-d');
			$con->created = date('Y-m-d');
			$con->status = 60; // set as reported , we have reported to aupost
			$con->save();
			$transaction=Yii::app()->db->beginTransaction();
			try
			{
				foreach($shipments as $s)
				{
					$s->consol_id = $con->id;
					$s->update(['consol_id', 'status']);
					$courier_id = null;
					$courier_id=$s->getCourierId();
					$action = "3PL Auto";
					GatepassShipment::gatepassScan($s, $courier_id, 1, $s->consol->dpt_id,$action);
				}
				$transaction->commit();
			} catch (Exception $ex) {
				$transaction->rollback();
				throw $ex;
			}

			Yii::import('application.controllers.ImcoConsolController');
			$cc = new ImcoConsolController('default');
			$cc->actionAoutScanAll($con->id);
			$cc->actionAupost($con->id);
			//$cc->actionStartrack($con->id, true);
			$cc->actionTntManifest($con->id);
			$cc->actionFastway($con->id);
			$cc->actionAupostInt($con->id);
			$cc->actionDfeManifest($con->id);
			$cc->actionSFManifest($con->id);
			$cc->actionEizTollManifest($con->id);
		} else {
			$this->log('no matched WMS DFE shipments this time');
			return;
		}
	}

	public function manifestWmsDeliveryTask()
	{
		$shipments = Shipment::model()->with('consol','trans')->findAll('(
			(trans.id is null) or 
			(trans.org_id != 114 and json_value(trans.meta,"$.oid") is null and json_value(trans.meta,"$.non_manifest") is null)
			) and consol.no like "WDT%" and t.status < 100 and ot_id = 10 and scan_no != pkg');
		$consols = [];
		foreach ($shipments as $key => $shipment) {
			$consols[$shipment->consol_id] = $shipment->consol_id;
		}
		foreach ($consols as $key => $consolId) {
			Yii::import('application.controllers.ImcoConsolController');
			$cc = new ImcoConsolController('default');
			$cc->actionAupost($consolId);
			//$cc->actionStartrack($con->id, true);
			$cc->actionTntManifest($consolId);
			$cc->actionFastway($consolId);
			$cc->actionSFManifest($consolId);
			$cc->actionEizTollManifest($consolId);
			$cc->actionBorderManifest($consolId);
		}
	
	}

	public function doStartrackManifest($api, $ss, &$consolIds, $cn)
	{
		$err = [];
		$r = $api->createOrderFromShipments($ss, $cn->no);
		if (!empty($r->order)) {
			$cn->mdata['startracksent'] = 1;
			$cn->save();
			$oid = $r->order->order_id;
			// because aupost returned shipment is not the same order with our sending order
			// so here we need to order by HBN again
			$auPostShipments = [];
			foreach ($r->order->shipments as $aushipment) {
				$auPostShipments[$aushipment->shipment_reference] = $aushipment;
			}
			$transaction = Yii::app()->db->beginTransaction();
			try {
				foreach ($ss as $i => $s) {
					$aushipment = $auPostShipments[$s->hbn];
					// check to see if tranship existing
					// in case existing , just update it
					$ts = Tranship::model()->find('pid = :pid AND org_id = :oid AND status = 19', [':pid' => $s->id,':oid' => Org::ORGID_COURIER_STARTRACK]);
					if (empty($ts)) {
						$ts = new Tranship;
						$ts->pid = $s->id;
						$ts->org_id = Org::ORGID_COURIER_STARTRACK;  // for startrack post office
						$ts->man_id = $s->man_id;
						$ts->type = 80;  // shipment transfer to a different delivery courier
						$ts->status = 19; // in finally moving status
						$ts->connote = $s->ref;
						// currently we save cost with a single field

						$ts->mdata['cost'] = $aushipment->shipment_summary->total_cost;
						$costValue = floatval($aushipment->shipment_summary->total_cost - $aushipment->shipment_summary->total_gst);
						$ts->cost = round($costValue, 2);
					}
					$ts->time = date('Y-m-d H:i:s');
					$ts->mdata['oid'] = $oid;
					$ts->mdata['sid'] = $aushipment->shipment_id;
					$ts->save();
					if ($s->consol_id  > 0) {
						array_push($consolIds, $s->consol_id);
					}
				}
				$consolIds=array_unique($consolIds);
				$transaction->commit();
			} catch (Exception $ex) {
				$transaction->rollback();
				Log::log2file("Startrack Manifest=>".$cn->no."=>".$ex->getMessage(), "transaction_err_log", "transaction");
				throw $ex;
			}
		} else {
			foreach ($api->err as $e) {
				$msg = $e->message;
				if (!empty($e->field) && preg_match('/shipments\[(\d+)\]/', $e->field, $m)) {
					$msg .= ': '.$ss[$m[1]]->hbn;
				}
				$err[] = $msg;
			}
		}
		return $err;
	}

	public function cleanWrongHbn()
	{
		$sql = 'UPDATE shipment SET status = 100 WHERE type = 20 AND status = 14 AND ((created > DATE_SUB(NOW(), INTERVAL 1 DAY) AND (hbn regexp "[^0-9A-z\-]+" OR CHAR_LENGTH(hbn) < 6)) OR created < DATE_SUB(NOW(), INTERVAL 30 DAY))';
		$this->db->createCommand($sql)->execute();

		//move out storage
		$sql = 'SELECT DISTINCT(sid) AS sid FROM `storage_log` l INNER JOIN shipment s ON l.fid = s.id WHERE l.model = "ExParcel" AND l.out_dt IS NULL AND (s.id IS NULL OR s.status IN (100, 104))';
		$cmd = $this->db->createCommand($sql);

		$sql = 'UPDATE `storage_log` l INNER JOIN shipment s ON l.fid = s.id SET out_dt = "'.date('Y-m-d H:i:s').'" WHERE l.model = "ExParcel" AND l.out_dt IS NULL AND (s.id IS NULL OR s.status IN (100, 104))';
		$this->db->createCommand($sql)->execute();

		$trans = Yii::app()->db->beginTransaction();
		try {
			foreach ($cmd->queryAll() as $r) {
				$s = Storage::model()->findByPk($r['sid']);
				$s->updateCap();
			}
			$trans->commit();
		} catch (Exception $ex) {
			$trans->rollback();
			throw $ex;
		}

		//cancel new older than 6 months
		$this->db->createCommand('UPDATE `shipment` SET status = 100 WHERE type = 20 AND status = 10 AND created < DATE_SUB(NOW(), INTERVAL 180 DAY)')->execute();
	}

	public function CneeAddressCheck()
	{
		$rs = Addr::model()->findAll("acc = 0 AND country = 'PR China' AND city != ''");
		$i = 0;
		foreach ($rs as $r) {
			if ($this->debug) {
				echo 'Checking address: '.$r->getCnFullAddress();
			}
			$acc = $r->checkCnAddr();
			if ($this->debug) {
				echo ': '.$acc."\n";
			}
			$r->save();
			if ($acc < 25) {//set warning flag
				$ps = ExParcel::model()->findAll('cnee_id = :id', [':id' => $r->id]);
				foreach ($ps as $p) {
					$p->bwf = $p->bwf | 4;
					$p->save();
				}
			}
			$i++;
			if ($i > 99) {
				break;
			}
		}
		if ($this->debug) {
			echo $i.' Addresses Checked';
		}
	}

	public function checkMultiID()
	{
		$rs = ExParcel::model()->findAll('status IN (12, 15)');
		foreach ($rs as $r) {
			if (empty($r->cnee->name) || !empty($r->cnee->cnid_id)) {
				continue;
			}
			$ds = CnID::model()->findAll('status IN (15,18,20) AND bwf = 0 AND name = :n', [':n' => $r->cnee->name]);
			if (empty($ds)) {
				continue;
			}
			//match any of the matched id;
			$r->cnee->cnid_id = $ds[$r->id % sizeof($ds)]->id;
			$r->cnee->save();
			$r->save();
			if ($this->debug) {
				echo $r->hbn." matched\n";
			}
			/*
			$r->bwf = $r->bwf | 32;
			$r->nolog = true;
			$r->update(['bwf']);
			*/
		}

		if ($this->debug) {
			echo "Done CheckMultiID\n";
		}
	}

	public function fix0wt()
	{
		$rs = ExParcel::model()->findAll('status IN (18,20) AND weight = 0');
		foreach ($rs as $r) {
			$cw = $r->chargeWeight();
			if ($cw > 1) {
				$r->weight = $cw;
				$r->save();
			} else {
				if (!empty($r->eitems['g']) && preg_match('/UGG|鞋/', implode($r->eitems['g']))) {
					$tq = array_sum($r->eitems['q']);
					$r->weight = (empty($tq)? 1: $tq) * 1.5;
					$r->save();
				}
			}
		}
		if ($this->debug) {
			echo "Done fix0wt\n";
		}
	}

	public function cleanCnID()
	{
		$sql = "SELECT t1.* FROM `cn_id` t1 INNER JOIN (SELECT no, max(id) as mid, count(id) as c FROM `cn_id` WHERE status < 98 GROUP BY no HAVING c > 1) t2 ON t1.id = t2.mid AND t1.created > DATE_SUB(NOW(), INTERVAL 1 DAY)";
		$cmd = $this->db->createCommand($sql);
		
		$trans = Yii::app()->db->beginTransaction();
		try {
			foreach ($cmd->queryAll() as $r) {
				//all good
				if ($r['bwf'] == 0 and in_array($r['status'], [10, 15 ,18, 20]) and $r['joint'] > 0) {
					//blacklist carry over
					if (CnID::model()->count('no = :no AND bwf & 16 > 0 AND status = 20', [':no' => $r['no']]) > 0) {
						$sql = "UPDATE cn_id SET bwf = 16 WHERE id = ".$r['id'];
						$this->db->createCommand($sql)->execute();
					}
					//invalid all other
					$sql = "UPDATE cn_id SET status = 99 WHERE no = '".$r['no']."' AND (status < 20 OR (status = 20 AND bwf > 0)) AND id < ".$r['id'];
					$this->db->createCommand($sql)->execute();
				} else {
					$rs = CnID::model()->findAll('no = :no AND status = 14', [':no' => $r['no']]);
					if (sizeof($rs) > 1) {
						$hss = [];
						foreach ($rs as $r) {
							if (!empty($r->front)) {
								$hss[] = $r->photo_front->hash;
							}
							if (!empty($r->back)) {
								$hss[] = $r->photo_back->hash;
							}
						}
						$hss = array_unique($hss);
						if (sizeof($hss) > 1) {
							foreach ($rs as $i => $r) {
								if ($i == 0) {
									$f1 = FileRepo::model()->find('hash = :h', [':h' => $hss[0]]);
									$f2 = FileRepo::model()->find('hash = :h', [':h' => $hss[1]]);
									$r->front = $f1->id;
									$r->back = $f2->id;
									$r->save();
								} else {
									$r->status = 99;
									$r->save();
								}
							}
						} else {
							foreach ($rs as $i => $r) {
								if ($i > 0) {
									$r->status = 99;
									$r->save();
								}
							}
						}
					}

					//invalid any other same condition or status < 15
					$sql = "UPDATE cn_id SET status = 99 WHERE no = '".$r['no']."' AND ((status != 20 AND status = ".$r['status']." AND bwf = ".$r['bwf'].") OR (status = ".$r['status']." AND bwf = ".$r['bwf']." AND bwf > 0) OR status < 15) AND id < ".$r['id'];
					$this->db->createCommand($sql)->execute();

					//newest is not the best
					if (CnID::model()->count('no = :no AND (status > :s OR (status = :s AND bwf = 0)) AND status < 98', [':no' => $r['no'], ':s' => $r['status']]) > 0) {
						$sql = "UPDATE cn_id SET status = 99 WHERE id = ".$r['id'];
						$this->db->createCommand($sql)->execute();
					}
				}
			}
			$trans->commit();
		} catch (Exception $ex) {
			$trans->rollback();
			throw $ex;
		}
		if ($this->debug) {
			echo "Done CleanCnID\n";
		}
	}
	public function openChaseIdTickets()
	{
		$rs = ExParcel::model()->findAll("status IN (12, 15) AND agent_id NOT IN (121, 462, 482, 758, 794, 1010,861)");
		$clientShipments = [];
		foreach ($rs as $r) {
			$rcvd = false;
			if ($r->cnee->cnid_id > 0 || !empty($r->cnee->cnid_no) || ($r->bwf & 32) > 0) {
				continue;
			}
			foreach ($r->tracks as $t) {
				if (in_array($t->type, [14, 15])) {
					if (!empty($rcvd)&&$rcvd>$t->dt) {
						$rcvd=$t->dt;
					} elseif (empty($rcvd)) {
						$rcvd = $t->dt;
					}
				}
			}
			$dd = empty($rcvd) ? 0 : ceil((time() - strtotime($rcvd)) / 86400);
			if ($dd >2) {
				if (Sms::checkIdMsg($r->cnee->tel, $r->hbn, $r->id)) { //this part is for open chasing id tickets.
					$clientShipments[trim($r->cnee->tel)][] = $r->id;
				}
			}
		}
		foreach ($clientShipments as $tel => $shipIds) {
			ExCrm::chaseIdTicket($shipIds, $tel);
		}
	}

	public function smsCnee($send=false)
	{
		$send = $send || (isset($this->args[1]) && $this->args[1] == 'send');
		$rs = ExParcel::model()->findAll("status IN (12, 15) AND agent_id NOT IN (121, 462, 482, 758, 794, 1010, 800, 861)");
		$smsee = [];
		$err = [];
		$clientShipments=[];
		foreach ($rs as $r) {
			if ($r->cnee->cnid_id > 0 || !empty($r->cnee->cnid_no) || ($r->bwf & 32) > 0) {
				continue;
			}
			if (Sms::model()->count('no = :n AND msg LIKE :r', [':n' => $r->cnee->tel, ':r' => '%'.$r->hbn.'%']) > 0) {
				continue;
			}
			$rcvd = false;
			foreach ($r->tracks as $t) {
				if (in_array($t->type, [14,15])) {
					$rcvd = $t->dt;
					break;
				}
			}
			$dd = empty($rcvd)? 0 : ceil((time() - strtotime($rcvd)) / 86400);
			if (!in_array($dd, [2, 4])) {
				continue;
			}
			if (empty($r->cnee->name)) {
				if ($this->debug) {
					echo 'No Cnee Name for: '.$r->hbn."\n";
				}
				continue;
			}
			if (preg_match('/^1\d{10}$/', $r->cnee->tel)) {
				if (!isset($ns[$r->cnee->tel.'|'.$r->cnee->name])) {
					$ns[$r->cnee->tel.'|'.$r->cnee->name] = [];
				}
				$smsee[$r->cnee->tel.'|'.$r->cnee->name][] = $r->hbn;
			} else {
				$err[] = $r->hbn.': Cnor: '.$r->cnor->tel.', Cnee: '.$r->cnee->tel."\n";
			}
		}
		$i = 0;
		foreach ($smsee as $n=>$r) {
			list($no, $name) = explode('|', $n);
			$sms = new Sms;
			$sms->type = 10;
			$sms->no = $no;//电邮 id@pca168.com  或微信公众号 wz0577td
			$sms->msg = $name."您好！您来自澳洲的包裹 ".implode(' ', $r)." 至今未成功匹配身份证，请通过网站 http://t.cn/RwBkisk 上传，如有疑问请联系客服电话 95040315891";
			if ($send) {
				$sms->send_yp();
			}
			if ($this->debug) {
				echo 'Sent: '.$no."\n";
			}
			$i++;
		}
		//push the chasing id to crm tickets

		if ($this->debug) {
			foreach ($err as $e) {
				echo $e;
			}
			echo "Total ".$i." SMS sent\n";
		}

		$sms = new Sms;
		$sms->type = 10;
		$sms->no = '0414583962';
		$sms->msg = $i." consignee SMS sent";
		if ($send) {
			$sms->sendLocal();
		}
	}

	public function closeIdTickets()
	{
		$tickets=ExCrm::model()->findAll('status<90 AND type=10');
		foreach ($tickets as $ticket) {
			if (!empty($ticket->shipments)) {
				$isClose=false;
				$r= $ticket->shipments[0];
				if (!empty($r->cnee)) {
					if ($r->cnee->cnid_id > 0 || !empty($r->cnee->cnid_no) || ($r->bwf & 32) > 0) {
						//close the ticket as the id already ready
						$ticket->status=90;
						$ticket->last_update_time=date('Y-m-d H:i:s');
						$ticket->close_time=date('Y-m-d H:i:s');
						$ticket->addNotes("Id already uploaded", 0, false);
						$ticket->update(['status','last_update_time','close_time']);
						$isClose=true;
					}
				}
				if (!$isClose) {
					$allManifest=true;
					foreach ($ticket->shipments as $shipment) {
						if ($shipment->status<18) {
							$allManifest=false;
						}
					}
					if ($allManifest) {
						$ticket->status=90;
						$ticket->last_update_time=date('Y-m-d H:i:s');
						$ticket->close_time=date('Y-m-d H:i:s');
						$ticket->addNotes("Shipments already Manifest", 0, false);
						$ticket->update(['status','last_update_time','close_time']);
					}
				}
			}
		}
	}


	public function smsCnor($send=false)
	{
		$send = $send || (isset($this->args[1]) && $this->args[1] == 'send');
		$rs = ExParcel::model()->findAll("status IN (12, 15) AND agent_id NOT IN (121, 462, 482, 758, 794, 1010, 800, 861)");
		$smsor = [];
		$err = [];
		foreach ($rs as $r) {
			if ($r->cnee->cnid_id > 0 || !empty($r->cnee->cnid_no) || ($r->bwf & 32) > 0) {
				continue;
			}
			$rcvd = false;
			foreach ($r->tracks as $t) {
				if (in_array($t->type, [14,15])) {
					$rcvd = $t->dt;
					break;
				}
			}
			$dd = empty($rcvd)? 0 : ceil((time() - strtotime($rcvd)) / 86400);
			if (!in_array($dd, [3, 5])) {
				continue;
			}

			if (empty($r->cnee->name)) {
				if ($this->debug) {
					echo 'No Cnee Name for: '.$r->hbn."\n";
				}
				continue;
			}
			$mno = preg_replace('/\s+/', '', $r->cnor->tel);
			if (preg_match('/^04\d{8}$/', $mno)) {
				$add = true;
				if (!isset($ns[$mno])) {
					$ns[$mno] = [];
				} else {
					foreach ($ns[$mno] as $nn) {
						if ($nn[1] == $r->cnee->name) {
							$add = false;
							break;
						}
					}
				}
				if ($add) {
					$smsor[$mno][] = [$r->hbn, $r->cnee->name];
				}
			} else {
				$err[] = $r->hbn.': Cnor: '.$mno.', Cnee: '.$r->cnee->tel."\n";
			}
		}

		$i = 0;
		foreach ($smsor as $n=>$r) {
			$ms = ceil(sizeof($r) / 10);

			for ($j = 0; $j < $ms; $j++) {
				$sms = new Sms;
				$sms->type = 10;
				$sms->no = $n;
				$dl = [];
				foreach (array_slice($r, $j*10, 10) as $d) {
					$dl[] = $d[0].' '.$d[1];
				}//或微信公众号 wz0577td
				$sms->msg = "您好！您通过PCA Express寄往中国的包裹 ".implode(', ', $dl)." 至今未成功匹配身份证，请通过网站 http://x.co/8Clvi 上传，如有疑问请联系客服电话 0299257100";
				if ($send) {
					$sms->sendLocal();
				}
				if ($this->debug) {
					echo 'Sent: '.$n."\n";
				}
				$i++;
			}
		}

		if ($this->debug) {
			foreach ($err as $e) {
				echo $e;
			}
			echo "Total ".$i." SMS sent\n";
		}
		$sms = new Sms;
		$sms->type = 10;
		$sms->no = '0414583962';
		$sms->msg = $i." consignor SMS sent";
		if ($send) {
			$sms->sendLocal();
		}
	}


	/**
	* sync flight information for UBM message
	*/
	private function syncUBM()
	{
		$pid = Yii::app()->basePath.DIRECTORY_SEPARATOR.'runtime'.DIRECTORY_SEPARATOR.'ubm_sync.pid';
		if (is_file($pid) && filectime($pid) > time() - 600) {
			return false;
		}
		file_put_contents($pid, '1');

		$this->_sendUbm();

		// delete temporary file , for next time running again
		@unlink($pid);
	}

	/**
	* sync flight information for UBM message
	*/
	private function _sendUbm()
	{
		// get ubm message from message queue
		$rs = Edimsg::model()->findAll('status = 18'); // get all schedule UBM message
		$this->echo_debug('=== Found '.sizeof($rs)." UBM message to update flight info. ===");

		// call flight tracking logic
		include(Yii::app()->basePath.DIRECTORY_SEPARATOR.'commands/trackingCommand.php');
		$tracking = new trackingCommand('ubm', null);
		foreach ($rs as $r) {
			if (!isset($r->mdata['flight'])) {
				continue;
			}
			if (!isset($r->mdata['eta'])) {
				continue;
			}

			// use ETA to test instead of ETD in order to avoid 2 steps airline fright
			// $d = $tracking->flight($r->mdata['flight'], $r->mdata['etd']);
			$d = $tracking->flight($r->mdata['flight'], $r->mdata['eta'], false, true);
			// $d[7] flight status
			// $d[5] flight arrival time
			if (!empty($d)) {
				if (isset($d[7]) && isset($d[5])) {
					if ($this->canSendUbm($d[7], $d[5])) {
						$r->status = 20; // push to sending queue
						$r->save();

						// set underbond movement sent flag for the console
						$model = ImcoConsol::model()->findByPk($r->fid);
						if (!empty($model)) {
							$model->mdata['ubmsent'] = 1;
							$model->updateMeta();
						}
					}
				}
			}
		}

		$this->echo_debug('=== ALL DONE ===');
	}

	private function canSendUbm($flightStatus, $arriveTime)
	{
		$bCanSendUbm = false;
		$sArriveTime = strtotime($arriveTime . ' Australia/Sydney');

		// get my local time by time zone : Australia / Sydney
		$tz = 'Australia/Sydney';
		$timestamp = time();
		$dt = new DateTime("now", new DateTimeZone($tz)); //first argument "must" be a string
		$dt->setTimestamp($timestamp); //adjust the object to correct timestamp
		$curtime = strtotime($dt->format('d.m.Y, H:i:s'));

		switch ($flightStatus) {
			case 2:// arrived
			{
				// we set arrived , so that we can send UBM message
				// get real arrived time
				$laterTime = $sArriveTime;
				if ($curtime > $laterTime) {
					$bCanSendUbm = true;
				}
			}
				break;
			case 1: // is flying
			{
				// flight is on the schedule
				// we check to see if flight will arrival at two hours late
				// if yes, we can send UBM in advance now
				$advanceTime = $sArriveTime - 2 * 60 * 60;
				if ($curtime > $advanceTime) {
					$bCanSendUbm = true;
				}
			}
				break;

			case 0: // on schedule only
				break;
		}

		return $bCanSendUbm;
	}

