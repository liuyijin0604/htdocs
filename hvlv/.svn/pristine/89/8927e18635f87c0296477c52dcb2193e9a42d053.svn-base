<?php


class CronCommand extends CConsoleCommand
{
	private $db;
	private $args;
	private $debug = false;
	public $ts;
	public $day;
	public $hr;
	public $mn;
	public $d;

	public function run($args)
	{
		Yii::app()->name = 'TLA';
		$this->db = Yii::app()->getDb();
		$this->args = $args;
		$this->ts = time();
		$this->day = date('N');
		$this->hr = date('G');
		$this->mn = intval(date('i'));
