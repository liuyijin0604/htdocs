	}

	public function syncCin7SaleOrder()
	{
		$custs = WmsAPI::model()->findAll('type = :type AND status = :status', [':type' => WmsAPI::WMS_API_TYPE_CIN7, ':status' => WmsAPI::WMS_API_STATUS_ALL]);
		foreach ($custs as $cust) {
			$config = array(
				'user' => $cust->api_key,
				'key' => $cust->api_secret,
				'org_id' => $cust->org_id,
			);
			$cin7 = new Cin7API($config);
			$this->_syncCin7SaleOrder($cin7);
		}
	}

	public function _syncCin7SaleOrder($cin7)
	{
		$r = $cin7->getSalesOrders();

		$transaction = Yii::app()->db->beginTransaction();
		try {
			if ($r['done'] == true && empty($r['items']['message'])) {
				foreach ($r['items'] as $order) {
					$this->_processCin7SaleOrder($order, $cin7);
				}
			}
			$transaction->commit();
		} catch (Exception $ex) {
			$transaction->rollback();
			$this->log('Sync CIN7 order fail');
			throw $ex;
		}
	}

	public function _processCin7SaleOrder($order, $cin7)
	{
		if ($order['id'] <= 19777) { // biophysics #19777
			return;
		}
		$task_map = WmsTaskMap::model()->find('fid = :fid AND platform = "cin7"', [':fid' => $order['id']]);
		if (!empty($task_map)) {
			// TODO
			return;
		}

		// Get job
		$job = WmsJob::model()->find(['condition' => 'org_id = :org_id AND type = 30 AND week(`created`, 1) = :week', 'params' => [':org_id' => $cin7->org_id, ':week' => intval(date('W'))], 'order' => 'id desc']);
		if (empty($job)) {
			$job = new WmsJob;
			$job->org_id = $cin7->org_id;
			$job->type = 30;
			$job->status = 10;
			$job->ref = '3PL_' . date('Y-m-d');
			$job->save();
		}
		if ($job->getErrors()) {
			foreach ($job->getErrors() as $error) {
				$this->cin7Log($error[0]);
			}
			return;
		}

		// Create pick&pack task
		$task = new WmsTask;
		$task->job_id = $job->id;
		$task->type = 3030;
		$task->is_request = 1;
		$task->op_id = 0;
		$task->status = 20;
		$task->ref = $order['reference'];
		$task->schd_time = date("Y-m-d H:i:s");
		$items = [];
		$backorder = false;
		foreach ($order['lineItems'] as $item) {
			// Get prod
			// $prod_map = WmsProdMap::model()->find('fid = :fid AND platform = "cin7"', [':fid' => $item['productId'] . '_' . $item['productOptionId']]);
			// if (!empty($prod_map)) {
			// 	$prod = $prod_map->prod;
			// }
			if (!empty($item['code'])) {
				$prod = WmsProd::model()->with('orgs')->find('orgs.sku = :sku AND orgs.org_id = :org_id AND status = 1', [':sku' => $item['code'], ':org_id' => $cin7->org_id]);
			} else if (!empty($item['barcode'])) {
				$prod = WmsProd::model()->find('ean = :ean AND status = 1', [':ean' => $item['barcode']]);
			}

			// biophysics skip kit
			if (!empty($prod) && $prod->type == WmsProd::WMS_PROD_KIT) {
				continue;
			}

			if (empty($prod)) {
				// $task->addError('id', $item['name'] . ' in ' . $order['reference'] . ' does not exist in PCAE');
				$items[] = [
					'si' => '',
					'sn' => $item['name'],
					'pq' => '',
					'cq' => '',
					'uq' => $item['qty'],
					'pli' => '',
					'pl' => '',
					'nt' => '',
					'pi' => '',
				];
				$backorder = false;
				continue;
			}

			$prods = [];
			if (!isset($prods[$prod->id])) $prods[$prod->id] = 0;
			if ($prod->type != WmsProd::WMS_PROD_KIT) {
				$prods[$prod->id] += $item['qty'];
			} else if ($prod->type == WmsProd::WMS_PROD_KIT) {
				$prods[$prod->id] += $item['qty'];
				foreach ($prod->items as $prod_item) {
					if (!isset($prods[$prod_item->item->id])) $prods[$prod_item->item->id] = 0;
					$prods[$prod_item->item->id] += intval($item['qty']) * $prod_item->qty;
				}
			}

			// Get stocks
			foreach ($prods as $pid => $qty) {
				$qty_store = $qty;
				$prod = WmsProd::model()->findByPk($pid);
				$stocks = WmsStock::model()->findAll('prod_id = :prod_id AND org_id = :org_id AND qty - qty_res > 0', [':prod_id' => $pid, ':org_id' => $cin7->org_id]);
				foreach ($stocks as $stock) {
					if ($qty > 0) {
						$items[] = [
							'si' => $stock->id,
							'sn' => $stock->prod->name,
							'pq' => '',
							'cq' => '',
							'uq' => min($qty, $stock->availQty()),
							'pli' => '',
							'pl' => '',
							'nt' => '',
							'pi' => $stock->prod->id,
						];
						$qty -= min($qty, $stock->availQty());
					} else {
						break;
					}
				}

				if ($qty > 0) {
					// $task->addError('id', $prod->name . ' in ' . $order['reference'] . ' quantity is less than ' . $qty_store . ', only ' . ($qty_store - $qty));
					if ($prod->type != 50) {
						$items[] = [
							'si' => '',
							'sn' => $prod->name,
							'pq' => '',
							'cq' => '',
							'uq' => $qty,
							'pli' => '',
							'pl' => '',
							'nt' => '',
							'pi' => $prod->id,
						];
						$backorder = false;
					} else {
						$items[] = [
							'si' => '',
							'sn' => $prod->name,
							'pq' => '',
							'cq' => '',
							'uq' => 0,
							'pli' => '',
							'pl' => '',
							'nt' => '',
							'pi' => $prod->id,
							'kituq' => $qty,
						];
					}
				}
			}
		}

		if ($backorder) {
			$task->status = 10;
		}

		if ($task->getErrors()) {
			foreach ($task->getErrors() as $error) {
				$this->cin7Log($error[0]);
			}
			return;
		}
		if (empty($items)) {
			$this->cin7Log('empty task');
			return;
		}

		$task->new_items = $items;
		// set B2B or B2C
		$contact = $cin7->getContact($order['memberId']);
		if ($contact['done'] == true && !empty($contact['items'][0]['group']) && $contact['items'][0]['group'] == 'AU Retail' && !empty($contact['items'][0]['subGroup']) && $contact['items'][0]['subGroup'] == 'PCA, NSW') {
			$task->mdata['b2'] = 'b';
		} else {
			$task->mdata['b2'] = 'c';
		}
		$task->bwf = 256;
		$task->save();

		if (!empty($task->getErrors())) {
			foreach ($task->getErrors() as $error) {
				$this->cin7Log($error[0]);
			}
			$task->status = 100;
			$task->save();
			return;
		}

		// Create task map
		$task_map = new WmsTaskMap;
		$task_map->fid = $order['id'];
		$task_map->platform = 'cin7';
		$task_map->task_id = $task->id;
		$task_map->save();

		// Delivery
		$task->pickupTask->type = 2120;
		$delivery_task = $task->pickupTask;
		$delivery_task->mdata['cnee']['company'] = @$order['deliveryCompany'];
		$delivery_task->mdata['cnee']['name'] = @$order['deliveryFirstName'] . ' ' . @$order['deliveryLastName'];
		$delivery_task->mdata['cnee']['tel'] = !empty(@$order['phone']) ? @$order['phone'] : @$order['mobile'];
		$delivery_task->mdata['cnee']['address'] = @$order['deliveryAddress1'] . ' ' . @$order['deliveryAddress2'];
		$delivery_task->mdata['cnee']['city'] = @$order['deliveryCity'];
		$delivery_task->mdata['cnee']['suburb'] = @$order['deliveryCity'];
		$delivery_task->mdata['cnee']['state'] = @$order['deliveryState'];
		$delivery_task->mdata['cnee']['postcode'] = @$order['deliveryPostalCode'];
		$delivery_task->mdata['cnee']['country'] = @$order['deliveryCountry'];
		if (in_array(@$order['deliveryCountry'], Unloco::$countries)) {
			$delivery_task->mdata['cnee']['country'] = array_search(@$order['deliveryCountry'], Unloco::$countries);
		}
		$delivery_task->mdata['cnee']['email'] = @$order['email'];
		$delivery_task->save();
	}

	public function syncCin7PurchaseOrder()
	{
		$custs = WmsAPI::model()->findAll('type = :type AND status = :status', [':type' => WmsAPI::WMS_API_TYPE_CIN7, ':status' => WmsAPI::WMS_API_STATUS_ALL]);
		foreach ($custs as $cust) {
			$config = array(
				'user' => $cust->api_key,
				'key' => $cust->api_secret,
				'org_id' => $cust->org_id,
			);
			$cin7 = new Cin7API($config);
			$this->_syncCin7PurchaseOrder($cin7);
		}
	}

	public function _syncCin7PurchaseOrder($cin7)
	{
		$r = $cin7->getPurchaseOrders();

		$transaction = Yii::app()->db->beginTransaction();
		try {
			if ($r['done'] == true && empty($r['items']['message'])) {
				foreach ($r['items'] as $order) {
					$this->_processCin7PurchaseOrder($order, $cin7);
				}
			}
			$transaction->commit();
		} catch (Exception $ex) {
			$transaction->rollback();
			$this->log('Sync CIN7 order fail');
			throw $ex;
		}
	}

	public function _processCin7PurchaseOrder($order, $cin7)
	{
		if ($order['id'] <= 19777) {
			return;
		}
		$task_map = WmsTaskMap::model()->find('fid = :fid AND platform = "cin7"', [':fid' => $order['id']]);
		if (!empty($task_map)) {
			// TODO
			return;
		}

		// Get job
		$job = WmsJob::model()->find(['condition' => 'org_id = :org_id AND type = 30 AND week(`created`, 1) = :week', 'params' => [':org_id' => $cin7->org_id, ':week' => intval(date('W'))], 'order' => 'id desc']);
		if (empty($job)) {
			$job = new WmsJob;
			$job->org_id = $cin7->org_id;
			$job->type = 30;
			$job->status = 10;
			$job->ref = '3PL_' . date('Y-m-d');
			$job->save();
		}
		if ($job->getErrors()) {
			foreach ($job->getErrors() as $error) {
				$this->cin7Log($error[0]);
			}
		}

		// Create pallet task
		$task = new WmsTask;
		$task->job_id = $job->id;
		$task->type = 1010;
		$task->is_request = 1;
		$task->op_id = 0;
		$task->status = 20;
		$task->ref = $order['reference'];
		$items = [];
		foreach ($order['lineItems'] as $item) {
			// Get prod
			$prod_map = WmsProdMap::model()->find('fid = :fid AND platform = "cin7"', [':fid' => $item['productId'] . '_' . $item['productOptionId']]);
			if (!empty($prod_map)) {
				$prod = $prod_map->prod;
			} else if (!empty($item['barcode'])) {
				$prod = WmsProd::model()->find('ean = :ean AND status = 1', [':ean' => $item['barcode']]);
			} else if (!empty($item['code'])) {
				$prod = WmsProd::model()->with('orgs')->find('orgs.sku = :sku AND orgs.org_id = :org_id AND status = 1', [':sku' => $item['code'], ':org_id' => $cin7->org_id]);
			}

			if (empty($prod)) {
				$items[] = [
					'gi' => '',
					'gn' => $item['name'],
					'uq' => $item['qty'],
					'cq' => '',
					'ex' => '',
					'bn' => '',
					'nt' => '',
					'pl' => '',
					'pli' => '',
				];
				continue;
			} else {
				$items[] = [
					'gi' => $prod->id,
					'gn' => $prod->name,
					'uq' => $item['qty'],
					'cq' => '',
					'ex' => '',
					'bn' => '',
					'nt' => '',
					'pl' => '',
					'pli' => '',
				];
			}
		}

		if ($task->getErrors()) {
			foreach ($task->getErrors() as $error) {
				$this->cin7Log($error[0]);
			}
		} else if (!empty($items)) {
			$task->new_items = $items;
			$task->save();

			if (!empty($task->getErrors())) {
				foreach ($task->getErrors() as $error) {
					$this->cin7Log($error[0]);
				}
				return;
			}

			// Create task map
			$task_map = new WmsTaskMap;
			$task_map->fid = $order['id'];
			$task_map->platform = 'cin7';
			$task_map->task_id = $task->id;
			$task_map->save();
		} else {
			$this->cin7Log('empty task');
		}
	}

	public function cin7Log($m)
	{
		$lf = Yii::app()->basePath . DIRECTORY_SEPARATOR . 'runtime' . DIRECTORY_SEPARATOR . 'cin7' . DIRECTORY_SEPARATOR;
		$lf .= 'cin7_' . date('Y-m') . '.log';
		return file_put_contents($lf, date('Y-m-d H:i:s') . ' ' . $m . "\n", FILE_APPEND);
	}

