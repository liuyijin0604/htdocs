	public function createAutoInvoice()
	{
		Yii::app()->name = 'TLA';
		$ios = InvTempOrg::model()->with('template')->findAll('t.status = 1 AND template.status = 1 AND t.start <= NOW() AND t.end >= NOW()');
		foreach ($ios as $io) {
			if (($io->getFreq() == 'By Month'||$io->getFreq() == 'By Next Month') && date('d') != date('d', strtotime($io->start))) {
				echo date('d', strtotime($io->start));
				continue;
			} elseif ($io->getFreq() == 'By Week' && date('N') != date('N', strtotime($io->start))) {
				continue;
			} elseif ($io->getFreq() == 'By Day' && (date('N') == 6 || date('N') == 7)) {
				continue;
			} elseif ($io->getFreq() == '') {
				continue;
			}
			$template = $io->template;

			$invoice = new Invoice;
			$invoice->to_id = $io->org_id;
			$invoice->dpt_id = $template->dpt_id;
			$invoice->dpmt = $template->dpmt;
			$invoice->type = $template->type;
			$invoice->currency = $template->currency;
			$invoice->ref = $template->ref;
			$invoice->date = date('Y-m-d');
			$invoice->due = date('Y-m-d');
			$invoice->posted = date('Y-m-d');
			$invoice->total = $template->total + $template->gst;
			$invoice->gst = $template->gst;
			$invoice->status = 1;
			$invoice->mdata['payterm'] = 'COD';
			$invoice->save();
			$lines = $template->lines;
			foreach ($lines as $line) {
				$invline = new InvLine;
				$invline->inv_id = $invoice->id;
				$invline->ccode = $line->ccode;
				$invline->gst = $line->getGSTValue() / $line->qty;
				$invline->det = $line->desc;
				$invline->qty = $line->qty;
				if (preg_match('/rent|internet/i', $invline->det)) {
					if($io->getFreq() == 'By Next Month')
					{
						$invline->det .= " ".date('M Y', strtotime(date('Y-m-d') . ' + 1 month'));
					}else
					{
						$invline->det .= ' 12 ' . date('M') . ' - 11 ' . date('M', strtotime(date('Y-m-d') . ' + 1 month'));
					}
				}else
				{
					if($io->getFreq() == 'By Next Month')
					{
						$invline->det .= " ".date('M Y', strtotime(date('Y-m-d') . ' + 1 month'));
					}else
					{
						$invline->det .= " ".date('M Y');
					}
				}
				if (preg_match('/包裹收费/', $invline->det)) {
					$invline->det .= ' 1 ' . date('M') . ' - ' . date('d M', strtotime(date('Y-m-d')));
				}
				if (preg_match('/Software Development Service/', $invline->det)) {
					$monthCapital = date('M', strtotime(date('Y-m-d') . ' - 1 month'));
					$month = date('m', strtotime(date('Y-m-d') . ' - 1 month'));
					$year = date('Y', strtotime(date('Y-m-d') . ' - 1 month'));
					$days = date('d', strtotime(date('Y-m-1') . ' - 1 day'));
					$invline->det = $monthCapital . ' ' . $year . ' ' . $invline->det;
					for ($i = 1; $i <= $days; $i++) {
						if (date('N', strtotime($year . '-' . $month . '-' . $i)) == 1) {
							$invline->qty = ceil(($days - $i + 1) / 7) * $line->qty;
							break;
						}
					}
				}
				$invline->tax = $line->gst;
				$invline->amount = $line->rate + $invline->gst;
				$invline->save();
			}
			$invoice->total = $invoice->getTotal();
			$invoice->update('total');
		}
	}

	public function archiveDB()
	{
		$db = $this->db;
		$transArch = function ($ss, $m=[]) use ($db) {
			$trans = $db->beginTransaction();
			try {
				foreach ($ss as $sql) {
					//echo $sql, PHP_EOL;
					$cmd = $db->createCommand($sql);
					if(!empty($m)) $cmd->bindValues($m);
					$cmd->execute();
				}
				$trans->commit();
			} catch (Exception $ex) {
				$trans->rollback();
				throw $ex;
			}
		};

		$arcShip = function ($m, $c, $days) use ($transArch) {
			$min_days = $this->db->createCommand($m)->bindValues([':d' => $days])->queryScalar();
			if(empty($min_days)) return;

			$sq = 'SELECT `id` FROM `shipment` s WHERE '.$c;

			for($d = $min_days; $d > $days; $d--){
				//tracking
				$transArch([
					'INSERT INTO `tracking_archive` SELECT * FROM `tracking` WHERE pid IN ('.$sq.')',
					'DELETE t FROM `tracking` t LEFT JOIN `shipment` s ON s.id = t.pid WHERE '.$c,
				], [':d' => $d - 1]);

				//address
				foreach (['cnor_id', 'cnee_id', 'receiver_id', 'notify_id'] as $f) {
					$transArch([
						'INSERT INTO `addr_archive` SELECT * FROM `addr` WHERE `id` IN ('.preg_replace('/^SELECT `id`/', 'SELECT `'.$f.'`', $sq).' AND `'.$f.'` > 0)',
						'DELETE a FROM `addr` a LEFT JOIN `shipment` s ON s.`'.$f.'` = a.id WHERE '.$c.' AND s.`'.$f.'` > 0',
					], [':d' => $d - 1]);
				}

				//shipment
				$transArch([
					'INSERT INTO `shipment_archive` SELECT * FROM `shipment` s WHERE '.$c,
					'DELETE s FROM `shipment` s WHERE '.$c,
				], [':d' => $d - 1]);
			}
		};

		//cancelled
		// $sq = '`status` = 100 AND `created` < DATE_SUB(CURRENT_DATE(), INTERVAL 60 DAY)';
		// $arcShip($sq);

		//no consol
		$days = 200;
		$mdq = 'SELECT DATEDIFF(CURRENT_DATE(), MIN(`created`)) FROM `shipment` WHERE consol_id = 0 AND status != 55 AND created < DATE_SUB(CURRENT_DATE(), INTERVAL :d DAY)';
		$sq = 's.consol_id = 0 AND s.created < DATE_SUB(CURRENT_DATE(), INTERVAL :d DAY)';
		if ($this->debug) {
			echo 'Archive >'.$days.' old no consol shipments', PHP_EOL;
		}
		$arcShip($mdq, $sq, $days);

		//old consol
		$days = 400;
		$mdq = 'SELECT DATEDIFF(CURRENT_DATE(), MIN(c.`created`)) FROM `shipment` s INNER JOIN consol c on s.consol_id = c.id WHERE s.status != 55 and s.created < DATE_SUB(CURRENT_DATE(), INTERVAL :d DAY)';
		$sq = 's.consol_id IN (SELECT id FROM consol WHERE created < DATE_SUB(CURRENT_DATE(), INTERVAL :d DAY)) AND `created` < DATE_SUB(CURRENT_DATE(), INTERVAL 90 DAY)';
		if ($this->debug) {
			echo 'Archive >'.$days.' old consol shipments', PHP_EOL;
		}
		$arcShip($mdq, $sq, $days);

		if ($this->debug) {
			echo 'Archive >'.$days.' old logs', PHP_EOL;
		}
		$min_days = $this->db->createCommand('SELECT DATEDIFF(CURRENT_DATE(), MIN(`time`)) FROM `log`')->queryScalar();
		for($d = $min_days; $d > $days; $d--){
			$transArch([
				'INSERT INTO `log_archive` SELECT * FROM `log` WHERE `time` < DATE_SUB(CURRENT_DATE(), INTERVAL :d DAY)',
				'DELETE FROM `log` WHERE `time` < DATE_SUB(CURRENT_DATE(), INTERVAL :d DAY)',
			], [':d' => $d - 1]);
		}

		if ($this->debug) {
			echo 'Archive >'.$days.' old edimsgs', PHP_EOL;
		}
		$min_days = $this->db->createCommand('SELECT DATEDIFF(CURRENT_DATE(), MIN(`dt`)) FROM `edimsg`')->queryScalar();
		for($d = $min_days; $d > $days; $d--){
			$transArch([
				'INSERT INTO `edimsg_archive` SELECT * FROM `edimsg` where dt < DATE_SUB(CURRENT_DATE, INTERVAL :d DAY)',
				'DELETE FROM `edimsg` WHERE `dt` < DATE_SUB(CURRENT_DATE(), INTERVAL :d DAY)',
			], [':d' => $d - 1]);
		}

		//$db->createCommand('OPTIMIZE TABLE `tracking`, `log`, `addr`, `shipment`, `edimsg`')->execute();
		if ($this->debug) {
			echo 'Done', PHP_EOL;
		}
	}

	public function archiveICS()
	{
		$db = $this->db;
		$transArch = function ($ss, $m=[]) use ($db) {
			$trans = $db->beginTransaction();
			try {
				foreach ($ss as $sql) {
					//echo $sql, PHP_EOL;
					$cmd = $db->createCommand($sql);
					if(!empty($m)) $cmd->bindValues($m);
					$cmd->execute();
				}
				$trans->commit();
			} catch (Exception $ex) {
				$trans->rollback();
				throw $ex;
			}
		};

		$days = 100;

		if ($this->debug) {
			echo 'Archive >'.$days.' old contrl edimsgs', PHP_EOL;
		}
		$transArch([
				'INSERT INTO `edimsg_archive` SELECT * FROM `edimsg` where type= "CONTRL" and dt < DATE_SUB(CURRENT_DATE, INTERVAL :d DAY) limit 20000',
				'DELETE FROM `edimsg` WHERE type= "CONTRL" and `dt` < DATE_SUB(CURRENT_DATE(), INTERVAL :d DAY) limit 20000',
			], [':d' => $days]);

		//$db->createCommand('OPTIMIZE TABLE `tracking`, `log`, `addr`, `shipment`, `edimsg`')->execute();
		if ($this->debug) {
			echo 'Done', PHP_EOL;
		}
	}

	public function fetchTurtleID()
	{
		$rs = ExParcel::model()->findAll('agent_id = 861 AND status > 10 AND status < 18');
		$ns = [];
		foreach ($rs as $p) {
			if (!empty($p->cnee->cnid_id)) {
				continue;
			}
			$ns[] = $p->cnee->name;
		}
		$ns = array_unique($ns);
		$a = new TurtleAPI;
		$cs = ceil(sizeof($ns) / 20);
		if ($this->debug) {
			echo sizeof($ns).' no id', PHP_EOL;
		}
		for ($j = 0; $j < $cs; $j++) {
			$a->fetchByName(array_slice($ns, $j*20, 20, true));
			if ($this->debug) {
				echo 'Fetching '.($j*20).' - '.($j*20 + 20), PHP_EOL;
			}
		}
		if ($this->debug) {
			echo 'Done', PHP_EOL;
		}
	}

	public function fetchTurtleIDDaily()
	{
		$a = new TurtleAPI;
		$date = date('Y-m-d');
		if ($this->debug) {
			echo 'Fetching '.$date.' IDs', PHP_EOL;
		}
		$a->fetchByDate($date, $date);
		if ($this->debug) {
			echo 'Done', PHP_EOL;
		}
	}

	public function sfamk()
	{
		$smap = ['2234' => 'HM', '2225' => 'PM', '2222' => 'EW', '2228' => 'HV', '2213' => 'TH', '2216' => 'HB', '2237' => 'BW', '2240' => 'KF', '2246' => 'UL', '2402' => 'CW', '2231' => 'AB', '2243' => 'KWS', '2249' => 'KH', '2452' => 'CS'];
		$c = 0;
		$rs = ExParcel::model()->with('cnee')->findAll('hbn LIKE "0800%" AND created > DATE_SUB(CURRENT_DATE(), INTERVAL 2 DAY) AND status < 100 AND cnee.name = ""');
		$pickupTime = function ($p) {
			$pl = PickupList::model()->with('lines')->find('lines.fid = :id', [':id' => $p->id]);
			if (empty($pl)) {
				$l = Log::model()->find('model = "ExParcel" AND lid = :lid AND user_id = 0 AND meta REGEXP :t', [':lid' => $p->id, ':t' => 'Received|Rcvd|Info Ready']);
				return strtotime(empty($l)? $pl->created : $l->time);
			} else {
				return strtotime($pl->created);
			}
		};

		foreach ($rs as $p) {
			$q = 'http://wxappapi.aumake.com/index.php/API/Collect/CollectPackage?mail='.$p->hbn.'&code=turtle&timestamp='.$pickupTime($p).'&store='.$smap[$p->agent_id];
			$d = file_get_contents($q);
			if ($this->debug) {
				echo $q, PHP_EOL, $d, PHP_EOL;
			}
			$d = json_decode($d, true);
			if (empty($d) || empty($d['return_data'])) {
				continue;
			}
			$cnee = $d['return_data']['consignee'];
			$p->cnee->name = $cnee['realname'];
			$p->cnee->tel = $cnee['mobile'];
			$p->cnee->state = $cnee['province'];
			$p->cnee->city = $cnee['city'];
			$p->cnee->suburb = $cnee['area'];
			$p->cnee->address = $cnee['address'];
			$p->cnee->save();
			$cnor = $d['return_data']['sender'];
			$p->cnor->name = $cnor['sendername'];
			$p->cnor->tel = $cnor['senderdphone'];
			$p->cnor->save();
			if (!empty($d['return_data']['packagegoods'])) {
				foreach ($d['return_data']['packagegoods'] as $i => $g) {
					$p->eitems['g'][$i] = $g['name'];
					$p->eitems['q'][$i] = $g['total'];
					$p->eitems['sku'][$i] = $g['barcode'];
					$p->eitems['type'][$i] = preg_match('/幼儿奶粉/', $g['name'])? 'B' : (preg_match('/奶粉/', $g['name'])? 'M' : 'O');
				}
				$p->save();
				if ($this->debug) {
					echo $p->hbn.' saved', PHP_EOL;
				}
				$c++;
			}
		}
		if ($this->debug) {
			echo $c.'Done', PHP_EOL;
		}
	}

	public function updateDDUStorage()
	{
		$shipments = ImParcel::model()->with('process')->findAll('t.status >= :from AND t.status < :to AND process.status >= :pfrom AND process.status < :pto', [':from' => ImParcel::STATE_REPORTED, ':to' => ImParcel::STATE_CLEAR_WAIT, ':pfrom' => ShipmentProcess::ENTRY_CONFIRM, ':pto' => ShipmentProcess::CONFIRM_PAYMENT]);
		foreach ($shipments as $p) {
			if(!empty($p->consol)&&(!$p->consol->isOurWarehouse()||$p->consol->service==Consol::SEACONSOL))//this generating is for the shipment which is not allocated in our warehouse
			{
				$result = $p->createStorageInvoiceWhenDdu();
				if($result['status']!=1)
				{
					$this->log($p->ref . ' update DDU Storage invoice err ' . $result['msg']);
				}
				continue;
			}

			$inTime = new DateTime($p->findTheStorageDate(), new DateTimeZone('Australia/Sydney'));
			$outTime = new DateTime('now', new DateTimeZone('Australia/Sydney'));
			$storeDays = $outTime->diff($inTime)->format('%a');
			if ($storeDays % 7 != 0) {
				continue;
			}

			$result = $p->createStorageInvoiceWhenDdu();
			if ($result['status'] != 1) {
				$this->log($p->ref . ' update DDU Storage invoice err: ' . $result['msg']);
			}
		}
	}

	public function sendCustomProcessInvoiceRemind()
	{
		$processes = ShipmentProcess::model()->findAll('status IN (18,20)');
		foreach ($processes as $p) {
			ShipmentProcess::sendInvoiceToInform($p->shipment);
		}
	}

	public function sendBorderOtherDduNotice()
	{
		$shipments = ImParcel::model()->findAll('bwf & 16 > 0 AND bwf & 128 > 0 AND bwf & 1024 > 0');
		foreach ($shipments as $shipment) {
			$first_email = Emailog::model()->find('type = :type AND fid = :fid', [':type' => Emailog::BORDER_OTHER_DDU, ':fid' => $shipment->id]);

			if (empty($first_email)) {
				$email = '';
				if (($shipment->bwf & ImParcel::CUSTOM_DDU) > 0) {
					$email = isset($shipment->cnee->email) ? $shipment->cnee->email : '';
				}
				if (empty($email)) {
					// $org = Org::model()->findByPk($shipment->agent_id);
					// if (!empty($org->extra['outturn_email'])) {
					// 	$email = $org->extra['outturn_email'];
					// }
					continue;
				}

				$emailLog = new Emailog();
				$emailLog->type = Emailog::BORDER_OTHER_DDU;
				$emailLog->fid = $shipment->id;
				$emailLog->dt = date('Y-m-d H:i:s');
				$emailLog->to_id = $shipment->agent_id;
				$emailLog->status = 10;
				$emailLog->prepTemplate();
				$emailLog->subject = $emailLog->tpl->subject;
				$emailLog->body = $emailLog->tpl->getContent();
				$emailLog->mdata['to'] = $email;
				$emailLog->mdata['fromName'] = 'TLA Imports';
				$emailLog->mdata['from'] = 'imports@toplogistics.com.au';
				$emailLog->mdata['cc'] = 'imports@toplogistics.com.au';
				$result = $emailLog->sendEmail();
				echo json_encode($result);
			}
		}
	}

	public function sendBorderOtherDduRemindNotice()
	{
		$shipments = ImParcel::model()->findAll('bwf & 16 > 0 AND bwf & 128 > 0 AND bwf & 1024 > 0 AND status <60');
		foreach ($shipments as $shipment) {
			$first_email = Emailog::model()->find('type = :type AND fid = :fid AND DATE_FORMAT(dt, "%Y-%m-%d") <= DATE_SUB(CURDATE(), INTERVAL 7 DAY)', [':type' => Emailog::BORDER_OTHER_DDU, ':fid' => $shipment->id]);
			$second_email = Emailog::model()->find('type = :type AND fid = :fid', [':type' => Emailog::BORDER_OTHER_DDU_REMIND, ':fid' => $shipment->id]);

			if (!empty($first_email) && empty($second_email)) {
				$email = '';
				if (($shipment->bwf & ImParcel::CUSTOM_DDU) > 0) {
					$email = isset($shipment->cnee->email) ? $shipment->cnee->email : '';
				}
				if (empty($email)) {
					// $org = Org::model()->findByPk($shipment->agent_id);
					// if (!empty($org->extra['outturn_email'])) {
					// 	$email = $org->extra['outturn_email'];
					// }
					continue;
				}

				$emailLog = new Emailog();
				$emailLog->type = Emailog::BORDER_OTHER_DDU_REMIND;
				$emailLog->fid = $shipment->id;
				$emailLog->dt = date('Y-m-d H:i:s');
				$emailLog->to_id = $shipment->agent_id;
				$emailLog->status = 10;
				$emailLog->prepTemplate();
				$emailLog->subject = $emailLog->tpl->subject;
				$emailLog->body = $emailLog->tpl->getContent();
				$emailLog->mdata['to'] = $email;
				$emailLog->mdata['fromName'] = 'TLA Imports';
				$emailLog->mdata['from'] = 'imports@toplogistics.com.au';
				$emailLog->mdata['cc'] = 'imports@toplogistics.com.au';
				$result = $emailLog->sendEmail();
				echo json_encode($result);
			}
		}
	}

