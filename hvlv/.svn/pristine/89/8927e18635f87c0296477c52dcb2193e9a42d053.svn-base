	/* this is used to send storage invoice to client daily
		*
		*/
	public function sendStorageInvoiceDaily()
	{
		$tempDirectory = Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR.'zip'.time();
		if (!file_exists($tempDirectory)) {
			mkdir($tempDirectory);
		}
		$invoices = Invoice::model()->findAll(
			'type = :type AND status = :status',
		[':type' => Invoice::INVOICE_TYPE_STORAGE_FEE, ':status' => Invoice::INVOICE_STATUS_PENDING]
		);
		foreach ($invoices as $invoice) {
			$fileName=$tempDirectory.DIRECTORY_SEPARATOR.'Invoice_'.$invoice->no.'.pdf';
			oPDF::renderPDF('invoice', ['inv'=>$invoice], 2, $fileName);
			$emailLog = new Emailog();
			$emailLog->type = Emailog::INVOICE;
			$emailLog->fid = $invoice->id;
			$emailLog->dt = date('Y-m-d H:i:s');
			$emailLog->to_id = $invoice->to_id;
			$emailLog->status = 10;
			$emailLog->prepTemplate();
			$emailLog->subject = $emailLog->tpl->subject;
			$emailLog->body = $emailLog->tpl->getContent();
			if ($emailLog->storageSend($fileName)) {
				$invoice->status = Invoice::INVOICE_STATUS_POSTED;
				$invoice->posted = date('Y-m-d');
				$invoice->update('status');
				$this->log('Storage Invoice '.$invoice->no.'send!');
			}
		}
		AppHelper::unlinkRecursive($tempDirectory);
	}

	public function sendInvoiceDaily()
	{
		$tempDirectory = Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR.'zip'.time();
		if (!file_exists($tempDirectory)) {
			mkdir($tempDirectory);
		}
		
		//exclude air/sea
		$invoices = Invoice::model()->findAll(
			'dpmt in (10,40,50) AND status = :status',
		[':status' => Invoice::INVOICE_STATUS_PENDING]
		);//,40,36,37,35,39IM28634
		foreach ($invoices as $invoice) {
			// 3pl cust set statement feq
			// and pcaw set not send invoice
			if ($invoice->dpmt == 40 && !empty($invoice->cust->extra['3pl_statement_feq']) && (empty($invoice->cust->extra['invoice-feq']) || $invoice->cust->extra['invoice-feq'] == 'no')) {
				$invoice->status = Invoice::INVOICE_STATUS_POSTED;
				$invoice->posted = date('Y-m-d');
				$invoice->update(['status', 'posted']);
				$invoice->closeInvoice();
				$this->_sendInvoice($invoice, $tempDirectory);
				continue;
			}

			$this->_sendInvoice($invoice, $tempDirectory);
			$oldInvoiceNo = Invoice::checkNewInvoiceNo($invoice->no);
			$oldInvoice = Invoice::model()->find('no = :no', [':no' => trim($oldInvoiceNo)]);
			if (!empty($oldInvoice) && $oldInvoice->to_id != $invoice->to_id) {
				$this->_sendInvoice($invoice, $tempDirectory, false, true);
			}
		}
		AppHelper::unlinkRecursive($tempDirectory);
	}

	private function _sendInvoice($invoice, $tempDirectory, $includeOld = true, $showBalance = false)
	{
		$fileName = $tempDirectory.DIRECTORY_SEPARATOR.'Invoice_'.$invoice->no.'.pdf';
		$excelFile = $invoice->exportExcelInvoice($tempDirectory.DIRECTORY_SEPARATOR,false);
		$fileName2 = '';
		// echo $invoice->no;
		if ($invoice->type != 60) {
			oPDF::renderPDF('invoice', ['inv'=>$invoice], 2, $fileName);
		} else {
			if ($showBalance) $_GET['bal'] = true;
			$f1 = tempnam(Yii::app()->basePath."/runtime", "ivp");
			$f2 = tempnam(Yii::app()->basePath."/runtime", "ivp");
			oPDF::renderPDF('invoice', ['inv'=>$invoice], 2, $f1);
			oPDF::renderPDF('invoice_detail', ['inv'=>$invoice], 2, $f2);
			oPDF::mergePDF([$f1, $f2], 2, true, $fileName);
		}
		$emailLog = new Emailog();
		$emailLog->type = Emailog::INVOICE;
		$emailLog->fid = $invoice->id;
		$emailLog->dt = date('Y-m-d H:i:s');
		$emailLog->to_id = $invoice->to_id;
		$emailLog->status = 10;

		$oldInvoiceNo = Invoice::checkNewInvoiceNo($invoice->no);
		// echo $oldInvoiceNo."\n";
		if (!empty($oldInvoiceNo) && $includeOld) {
			$emailLog->isNewInvoice = false;
			$fileName2=$tempDirectory.DIRECTORY_SEPARATOR.'Old_Invoice_'.$oldInvoiceNo.'.pdf';
			$oldInvoice=Invoice::model()->find('no=:no', [":no"=>trim($oldInvoiceNo)]);
			if ($oldInvoice->type != 60) {
				oPDF::renderPDF('invoice', ['inv'=>$oldInvoice], 2, $fileName2);
			} else {
				$f1 = tempnam(Yii::app()->basePath."/runtime", "ivp");
				$f2 = tempnam(Yii::app()->basePath."/runtime", "ivp");
				oPDF::renderPDF('invoice', ['inv'=>$oldInvoice], 2, $f1);
				oPDF::renderPDF('invoice_detail', ['inv'=>$oldInvoice], 2, $f2);
				oPDF::mergePDF([$f1, $f2], 2, true, $fileName2);
			}
			$emailLog->prepTemplate();
			$addingNotice="<p><b>This Invoice is to replace the old Invoice:".$oldInvoiceNo."</b></p>";
			$emailLog->tpl->assignThese([
				// 'OLD_INVOICE' => $addingNotice,
				'OLD_INVOICE' => '',
			]);
		} else {
			$emailLog->prepTemplate();
		}
		$emailLog->subject = $emailLog->tpl->subject;
		$emailLog->body = $emailLog->tpl->getContent();
		if ($emailLog->InvoiceSend($fileName, $fileName2, $excelFile) && $includeOld) {
			$invoice->status = Invoice::INVOICE_STATUS_POSTED;
			$invoice->posted = date('Y-m-d');
			$invoice->update(['status', 'posted']);
			$invoice->closeInvoice();
			$this->log2file('Invoice '.$invoice->no.'send!', 'invoice_sending');
		} else {
			$this->log2file('Invoice '.$invoice->no.'fail!', 'invoice_sending');
		}
	}

	public function postEdInvoice(){
		$invoices = Invoice::model()->findAll(
			'dpmt = 30 AND type = 50 AND status = :status AND date < DATE_SUB(CURDATE(), INTERVAL 1 WEEK)',
		[':status' => Invoice::INVOICE_STATUS_PENDING]
		);

		foreach ($invoices as $invoice) {
			$invoice->status = Invoice::INVOICE_STATUS_POSTED;
			$invoice->posted = date('Y-m-d');
			$invoice->closeInvoice(false);
			$invoice->save();
		}
	}

	public function send3PLStatement()
	{
		if (date('N') != 7 && date('d') != 1) return;
		$sql = 'SELECT DISTINCT to_id FROM invoice WHERE dpmt = 40 AND status IN (2,3,7)';
		// $rs = Yii::app()->db->createCommand($sql)->queryAll();
		$rs = Yii::app()->db_tla->createCommand($sql)->queryAll();
		foreach ($rs as $r) {
			$org = Org::model()->findByPk($r['to_id']);
			if (empty($org) || empty($org->extra['3pl_statement_feq'])) continue;
			if ($org->extra['3pl_statement_feq'] == 'weekly' && date('N') != 7) continue;
			if ($org->extra['3pl_statement_feq'] == 'monthly' && date('d') != 1) continue;
			if ($org->extra['3pl_statement_feq'] == 'stop') continue;
			$emailLog = new Emailog();
			$emailLog->type = Emailog::INVOICE_STATEMENT_3PL;
			$emailLog->fid = $r['to_id'];
			$emailLog->dt = date('Y-m-d H:i:s');
			$emailLog->scheduled = date('Y-m-d H:i:s');
			$emailLog->to_id = $r['to_id'];
			$emailLog->status = 10;
			$emailLog->prepTemplate();
			$emailLog->subject = $emailLog->tpl->subject;
			$emailLog->body = $emailLog->tpl->getContent();
			if (!empty($emailLog->mdata['to'])) {
				// $emailLog->mdata['to'] = 'jerry.fang@toplogistics.com.au;eva@toplogistics.com.au';
				$emailLog->mdata['to'] = 'gero@toplogistics.com.au';
				$emailLog->send3PLStatement();
			}
		}
	}

	public function createHeshengyuanCredit()
	{
		$transaction = Yii::app()->db->beginTransaction();
		try {
			$tasks = WmsTask::model()->findAll('JSON_VALUE(meta, "$.pcae_arrange") = 1 AND JSON_VALUE(meta, "$.crn") IS NULL');
			$data = [];
			foreach ($tasks as $task) {
				foreach ($task->items as $item) {
					$loc = WmsLocation::model()->find('name = :name', [':name' => $item->mdata['pl']]);
					$in = WmsStockLedger::model()->with('stock.customer')->find(['condition' => 'location_id = :lid AND customer.id = :oid AND qty_in > 0', 'params' => [':lid' => $loc->id, ':oid' => $task->job->org_id], 'order' => 't.id DESC']);
					$out = WmsStockLedger::model()->with('stock.customer')->find(['condition' => 'location_id = :lid AND customer.id = :oid AND qty_out > 0', 'params' => [':lid' => $loc->id, ':oid' => $task->job->org_id], 'order' => 't.id DESC']);
					if (strtotime(date('Y-m-d', strtotime($out->ts))) - strtotime(date('Y-m-d', strtotime($in->ts))) > 5 * 24 * 60 * 60) {
						// $il = InvLine::model()->with('invoice')->find('JSON_VALUE(invoice.meta, "$.billfrom") >= :ts AND JSON_VALUE(invoice.meta, "$.billto") <= :ts AND t.meta LIKE :n', [':ts' => $out->ts, ':n' => '%' . $out->stock->stockName() . '%']);
						// if (empty($il)) continue;
						if (empty($data[$task->job->org_id][$task->id])) {
							$data[$task->job->org_id][$task->id] = 0;
						}
						$data[$task->job->org_id][$task->id] += ceil((strtotime(date('Y-m-d', strtotime($out->ts))) - strtotime(date('Y-m-d', strtotime($in->ts))) - 5 * 24 * 60 * 60) / (7 * 24 * 60 * 60));
					}
				}
			}

			if (!empty($data)) {
				foreach ($data as $org_id => $data_org) {
					$owner = Org::model()->findByPk($org_id);
					$quotes = WmsOrgQuote::model()->find('org_id = :org_id AND status = 1 AND (JSON_VALUE(meta, "$.whole_sale") IS NULL OR JSON_VALUE(meta, "$.whole_sale") = 0)', [':org_id' => $org_id]);
					if (empty($quotes) && $owner->by != 1) {
						$quotes = WmsOrgQuote::model()->find('org_id = :org_id and status = 1', [':org_id' => $owner->by]);
					}

					$charge_rate = 0;
					if (!empty($quotes->mdata)) {
						if (!empty($owner->extra['storage_charge_type']) || !empty($owner->owner->extra['storage_charge_type'])) {
							if (empty($owner->extra['storage_charge_type'])) {
								$owner->extra['storage_charge_type'] = $owner->owner->extra['storage_charge_type'];
							}
							if (array_key_exists($owner->extra['storage_charge_type'], $quotes->mdata)) {
								$charge_rate = $quotes->mdata[$owner->extra['storage_charge_type']];
							}
						}
					}

					$credit = new Payment;
					$credit->org_id = Org::ORGID_AIRSEA_PW;
					$credit->amount = 0;
					$credit->ata = 0;
					$credit->ref = 'Credit for WMS Storage';
					$credit->type = Payment::PAYMENT_TYPE_CREDIT_NOTE;
					$credit->bank = 91;
					$credit->currency = 1;
					$credit->status = Payment::PAYMENT_STATUS_PENDING;
					$credit->date = date('Y-m-d');
					$credit->mdata['suborg'] = $org_id;
					$credit->save();
					$credit->genNo();

					$total = 0;
					foreach ($data_org as $task_id => $qty) {
						$task = WmsTask::model()->findByPk($task_id);
						$task->mdata['crn'] = $credit->id;
						$task->updateMeta();

						$total += $qty;

						$il = new CreditLine;
						$il->pid = $credit->id;
						$il->description = $task->getNo();
						$il->tax = 'EXEMPTOUTPUT';
						$il->rate = $charge_rate;
						$il->qty = $qty;
						$il->amount = $qty * $charge_rate;
						$il->save();
						if ($il->getErrors()) {
							echo json_encode($il->getErrors()) . PHP_EOL;
						}
					}

					$credit->amount = $total * $charge_rate;
					$credit->save();
					if ($credit->getErrors()) {
						echo json_encode($credit->getErrors()) . PHP_EOL;
					}
				}
			}
			$transaction->commit();
		} catch (Exception $ex) {
			$transaction->rollback();
			throw $ex;
		}
	}
		
	/**
	 * this function is used to generate storage invoice for DDU parcels when the customer not paid money on time.
	 * we will send this invoice directly to the client.
	 */
	public function genDduStorageWhenNotPaid()
	{
		$processes= ShipmentProcess::model()->findAll('status=:status AND DATEDIFF(NOW(),`date`)>=0', [':status'=> ShipmentProcess::INFROM_CUSTOMER_PAY]);
		foreach ($processes as $process) {
			$shipment=$process->shipment;
			echo $shipment->ref;
			if (($shipment->bwf&ImParcel::CUSTOM_DDU)==0) {
				continue;
			}

			if(!empty($shipment->consol)&&(!$shipment->consol->isOurWarehouse()||$shipment->consol->service==Consol::SEACONSOL))//this generating is for the shipment which is not allocated in our warehouse
			{
				$result = $shipment->createStorageInvoiceWhenDdu();
				if($result['status']==1)
				{
					$invoice = Invoice::model()->findByPk($result['invoiceId']);
					$this->sendDduStorageInvoice($invoice, $shipment);
				}
			}
		}


		$processes= ShipmentProcess::model()->findAll('status=:status AND DATEDIFF(NOW(),`date`)>=7', [':status'=> ShipmentProcess::INFROM_CUSTOMER_PAY]);
		foreach ($processes as $process) {
			$shipment=$process->shipment;
			if (($shipment->bwf&ImParcel::CUSTOM_DDU)==0) {
				continue;
			}

			if(!empty($shipment->consol)&&(!$shipment->consol->isOurWarehouse()||$shipment->consol->service==Consol::SEACONSOL))//this generating is for the shipment which is not allocated in our warehouse
			{
				continue;
			}

			if (empty($shipment->mdata['ddu_storage_invoice_date'])) {
				$shipment->mdata['ddu_storage_invoice_date'] = $shipment->findTheStorageDate();
			}
			$inTime = new DateTime($shipment->mdata['ddu_storage_invoice_date'], new DateTimeZone('Australia/Sydney'));
			$outTime = new DateTime('now', new DateTimeZone('Australia/Sydney'));
			$storedDays = $outTime->diff($inTime)->format("%a");
			$week=floor($storedDays/7);
			if ($week>0) {
				$invoice=new Invoice();
				$dueDay=($week+1)*7-1;

				$isair = empty($shipment->consol) || $shipment->consol->service= 10;
				$rate=$isair? 1.4 : 0.8;
				$amount=$rate*$week*$shipment->weight; //currently $1.4/week
				$invoice->date = date('Y-m-d'); // for update we shouldn't change invoice data
				//$invoice->status = Invoice::INVOICE_STATUS_PENDING; // set as pending which means will send to client for paying via email at night

				$invoice->status = Invoice::INVOICE_STATUS_PENDING; // set as pending which means will send to client for paying via email at night

				$invoice->type = Invoice::INVOICE_TYPE_DDU_STORAGE; // for custom casual client /DDU
				$invoice->dpmt = Invoice::DPMT_IMPORT;
				$invoice->currency = 1;
				$invoice->pid= $shipment->id;
				$invoice->to_id = 3494;//casual client org
				$invoice->consol_id = $shipment->consol_id;
				$invoice->mdata['name'] = !empty($shipment->cnee->company) ? $shipment->cnee->company : $shipment->cnee->name;
				$invoice->mdata['address'] = $shipment->cnee->fullAddress();
				$invoice->mdata['payterm'] = 'COD';
				$invoice->mdata['awb'] = isset($shipment->consol->awb) ? $shipment->consol->awb : '';
				$invoice->due =date('Y-m-d', strtotime("+$dueDay day", strtotime($shipment->mdata['ddu_storage_invoice_date'])));//we need a due day...
				$invoice->gst = 0;
				$invoice->total=0;
				$items = [];
				$items[] = [$shipment->consol->awb, $shipment->hbn, $shipment->getDesc(), $shipment->pkg, $shipment->weight, $shipment->cbm, $amount, $shipment->ref,$rate, 0, $week, $shipment->mdata['ddu_storage_invoice_date'], date('Y-m-d')];
				$gst = 0;
				$org = Org::model()->findByPk(3494);
				if (isset($org) && isset($org->extra['incl_gst'])) {
					if ($org->extra['incl_gst'] == 1) {
						$gst = round($amount * 10 / 100, 2);
					}
				}
				if ($amount>0) {
					$invoice->total += $amount;
					$invoice->gst += $gst;
					$invoice->total += $gst;
					$invoice->save();
					$shipment->mdata['ddu_storage_invoice_date']=date('Y-m-d');
					$shipment->updateMeta(true);
					$il = new InvLine;
					$il->inv_id = $invoice->id;
					$il->amount = $amount;
					$il->amount += $gst;
					$il->gst = $gst;
					$il->qty = 1;
					$il->mdata['items'] = $items;
					//$il->model = 'Manifest';
					$il->fid = 0;
					$il->save();
					$invoice->refresh();
					$this->sendDduStorageInvoice($invoice, $shipment);
				}
			}
		}
	}
	public function sendDduStorageInvoice($invoice, $shipment)
	{
		$email=isset($shipment->cnee->email)?$shipment->cnee->email:'';
		if (empty($email)) {
			Log::log2file("Storage Invoice Shipment not having email:".$invoice->no."==>shipment".$shipment->ref, "st_ddu_invoice_shipment", "account");
			return;
		}
		$tempDirectory = Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR.'zip'.time();
		if (!file_exists($tempDirectory)) {
			mkdir($tempDirectory);
		}
		$fileName=$tempDirectory.DIRECTORY_SEPARATOR.'Invoice_'.$invoice->no.'.pdf';
		oPDF::renderPDF('invoice', ['inv'=>$invoice], 2, $fileName);
		$files[]=[$fileName,'Invoice_'.$invoice->no.'.pdf'];
		$emailLog = new Emailog();
		$emailLog->fid = $shipment->id;
		$emailLog->type= Emailog::INVOICE_DDU_STORAGE_INVOICE_NOTICE;
		$emailLog->dt = date('Y-m-d H:i:s');
		$emailLog->status = 10;
		$emailLog->prepTemplate();
		$emailLog->tpl->assignThese([
			'INVOICE_AMOUNT'=>$invoice->total,
		]);
		$emailLog->subject = $emailLog->tpl->subject;
		$emailLog->body = $emailLog->tpl->getContent();
		$emailLog->mdata['to']=$email;
		$emailLog->mdata['fromName']='TLA Imports';
		$emailLog->mdata['from']='imports@toplogistics.com.au';
		$emailLog->mdata['cc']='imports@toplogistics.com.au';
		$o=$emailLog->sendEmail($files);
		if ($o['status']) {
			$invoice->status= Invoice::INVOICE_STATUS_POSTED;
			$invoice->update('status');
			// Log::log2file("Storage Invoice send:".$invoice->no, "st_ddu_invoice_success", "account");
		} else {
			Log::log2file("Storage Invoice Not send correctly:".$invoice->no, "st_ddu_invoice_failed", "account");
		}
		AppHelper::unlinkRecursive($tempDirectory);
	}

	public function SendManualCreditNoteDaily()
	{
		[$app_name, Yii::app()->name] = [Yii::app()->name, 'TLA'];
		$tempDirectory = Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR.'zip'.time();
		if (!file_exists($tempDirectory)) {
			mkdir($tempDirectory);
		}
		$creditNotes=Payment::model()->findAll('bank=91 AND type=5 AND status=6 AND flag&1>0');
		foreach ($creditNotes as $credit) {
			$amount = 0;
			
			foreach ($credit->credit_lines as $line)
			{
				$amount += $line->amount;
			}

			if($amount>0&&$amount!=$credit->amount)
			{
				$credit->amount = $amount;
				$credit->update(['amount']);
			}



			$fileName=$tempDirectory.DIRECTORY_SEPARATOR.'CreditNOte_'.$credit->no.'.pdf';

			oPDF::renderPDF('credit_note', ['credit' => $credit], 2, $fileName);
			$emailLog = new Emailog();
			$emailLog->type = 60;
			$emailLog->fid = $credit->id;
			$emailLog->dt = date('Y-m-d H:i:s');
			$emailLog->to_id = $credit->org_id;
			$emailLog->status = 10;
			$emailLog->prepTemplate();
			$emailLog->subject = $emailLog->tpl->subject;
			$emailLog->body = $emailLog->tpl->getContent();
			if ($emailLog->InvoiceSend($fileName)) {
				$credit->flag=($credit->flag&1)^$credit->flag;
				$credit->flag=$credit->flag|2;
				$credit->update('flag');
				// $this->log2file('Credit '.$credit->no.'send!', 'Credit_sending');
			}
		}
		AppHelper::unlinkRecursive($tempDirectory);
	}



	public function sendInvoiceTermDue()
	{
		$sql='SELECT to_id FROM `invoice` where status in(2,3,7) AND dpmt in(10,30,40) AND date>"2018-01-29" group by to_id';
		$rs=Yii::app()->db->createCommand($sql)->queryAll();
		$orgIds=[];
		foreach ($rs as $r) {
			// eva customer
			$org = Org::model()->findByPk($r['to_id']);
			if (!empty($org->extra['sp_id']) && $org->extra['sp_id'] == 305) {
				if (empty($org->extra['statement_invs'])) {
					continue;
				}

				foreach ($org->extra['statement_invs'] as $k => $inv) {
					$inv = Invoice::model()->findByPk($inv);
					if (in_array($inv->status, [6, 8, 9, 10])) {
						$changed = true;
						unset($org->extra['statement_invs'][$k]);
					}
				}
				if (!empty($changed)) {
					$org->update('meta');
				}
				if (empty($org->extra['statement_invs'])) {
					continue;
				}
			}

			$orgIds[]=$r['to_id'];
		}
		if (!empty($orgIds)) {
			foreach ($orgIds as $oid) {
				$inv_no=[];
				$term='';
				$org= Org::model()->find('id=:oid and status=1', [':oid'=>$oid]);
				if (empty($org)||!empty($org->extra['credit_payment_method'])) {
					continue;
				}
				$a=$org->getCurrentCreditOfLimit();
				$limit =floor($org->extra['creditlimit']);
				$term =empty($org->extra['creditterms'])? 0 : intval($org->extra['creditterms']);
				if (empty($term)) {
					continue;
				}
				for ($i=($term>3?3:$term);$i>=0;$i--) {
					if ($term-$i>=0) {
						$invoices= Invoice::model()->findAll('status in(2,3,7) AND dpmt in(10,30,40) AND date=DATE_SUB(CURDATE(), INTERVAL :day DAY) AND to_id=:oid AND date>"2018-01-29"', [':day'=>$term-$i,':oid'=>$oid]);
						$inv_no[$i]=$invoices;
					}
				}
				$invoices= Invoice::model()->findAll('status in(2,3,7) AND dpmt in(10,30,40) AND date<DATE_SUB(CURDATE(), INTERVAL :day DAY) AND to_id=:oid AND date>"2018-01-29"', [':day'=>$term,':oid'=>$oid]);
				$inv_no['OverDue']=$invoices;
				$term='<table class="chart"><tr><th>Day To OverDue</th><th>Invoices</th><th>Amount-AUD</th></tr>';
				$main_total=0;
				foreach ($inv_no as $index=>$invs) {
					$total=0;
					$inv_term='';
					foreach ($invs as $k=> $inv) {
						$inv_term.=$inv->no.'($'.($inv->total-$inv->paid()).');';
						if ($k%4==0) {
							$inv_term.='<br/>';
						}
						$total+=$inv->total-$inv->paid();
					}
					$main_total+=$total;
					$term.='<tr><td>'.$index.'</td><td>$'.$inv_term.'</td><td>'.$total.'</td></tr>';
				}

				$term.='<tfoot><tr><th colspan="2" align="right">Total:</th><th>$'.$main_total.'</th></tr></tfoot></table>';

				if ($main_total>0) {
					$this->sendInvoiceTermDueEmail($org, $a, $limit, $term);
				}
			}
		}
	}

	/* this is used to send credit limit notice
	*
	*/
	public function sendCreditNotice()
	{
		$emailService = new EmailService();
		$orgs = Org::model()->findAll("(json_value(meta,'$.credit_action')=1 or json_value(meta,'$.credit_notice')=1)  and status = 1");
		$orgIds = array_column($orgs, "id");
		Yii::app()->name = 'TLA';
		$sql='SELECT to_id FROM `invoice` where status in(2,3,7) and to_id in ('.join(",",$orgIds).') group by to_id;';
		$rs=Yii::app()->db_tla->createCommand($sql)->queryAll();
		$orgIds=[];
		$limitOrgs = [];
		foreach ($rs as $r) {
			$orgIds[]=$r['to_id'];
		}
		if (!empty($orgIds)) {
			foreach ($orgIds as $oid) {
				$limit = $this->checkTheLimit($oid);
				if($limit>0.001)
				{
					$limit = ($limit*100)."%";
					if(!empty($org[$limit]))
					{
						$limitOrgs[$limit] = [];
					}
					$limitOrgs[$limit][] = $oid;
				}
			}
		}
	}


	/* this is used to send credit limit notice
	*
	*/
	public function sendCreditNoticeSummary()
	{
		$emailService = new EmailService();
		$orgs = Org::model()->findAll("(json_value(meta,'$.credit_action')=1 or json_value(meta,'$.credit_notice')=1) and status = 1");
		$orgIds = array_column($orgs, "id");
		Yii::app()->name = 'TLA';
		$sql='SELECT to_id FROM `invoice` where status in(2,3,7) and to_id in ('.join(",",$orgIds).') group by to_id;';
		$rs=Yii::app()->db_tla->createCommand($sql)->queryAll();
		$orgIds=[];
		$limitOrgs = [];
		foreach ($rs as $r) {
			$orgIds[]=$r['to_id'];
		}
		if (!empty($orgIds)) {
			foreach ($orgIds as $oid) {
				$limit = $this->checkTheLimit($oid,false);
				if($limit>0.001)
				{
					$limit = number_format($limit*100,0,'.','');
					if(!empty($org[$limit]))
					{
						$limitOrgs[$limit] = [];
					}
					$limitOrgs[$limit][] = $oid;
				}
			}
		}

		if(!isset($limitOrgs[100]))$limitOrgs[100] = [];
		if(!isset($limitOrgs[90]))$limitOrgs[90] = [];
		if(!isset($limitOrgs[80]))$limitOrgs[80] = [];
		ksort($limitOrgs);
		$emailService->sendCreditNoticeSummary($limitOrgs);
	}

	/*This is used to check the credit Limit for every org,
		* When the limit is over 80%, 90%, 100%, we will send email to
		* Notice them.
		* Params $oid
		*/

	public function checkTheLimit($oid,$isSend = true)
	{
		$org=Org::model()->findByPk($oid);//$id
		if (empty($org)) {
			return 0;
		}
		if (!isset($org->extra['last_send_percent'])) {
			$org->extra['last_send_percent']=0;
			$org->updateMeta();
		}
		if (!isset($org->extra['client_billing_email'])||empty($org->extra['creditlimit'])) {
			return 0;
		}
		$limit =floor($org->extra['creditlimit']);
		$a=$org->getCurrentCreditOfLimit();
		if (!empty($a)) {
			if ($a>=1) {
				//if (isset($org->extra['last_send_percent'])&&$org->extra['last_send_percent']!=1.0&&) {
				if($isSend)
				{
					if ($this->sendCreditLimit($org, $a, $limit)) {
						$org->extra['last_send_percent']=1.0;
						$org->updateMeta();
						$this->log2file($org->id.'=>percent:'.$a, "credit_notice");
						return 1;
					}
				}
				return 1;
			} elseif ($a>=0.9) {
				//if (isset($org->extra['last_send_percent'])&&$org->extra['last_send_percent']!=0.9) {
				if($isSend)
				{
					if ($this->sendCreditLimit($org, $a, $limit)) {
						$org->extra['last_send_percent']=0.9;
						$org->updateMeta();
						$this->log2file($org->id.'=>percent:'.$a, "credit_notice");
						return 0.9;
					}
				}
				return 0.9;
			} elseif ($a>=0.8) {
				//if (isset($org->extra['last_send_percent'])&&$org->extra['last_send_percent']!=0.8) {
				if($isSend)
				{
					if ($this->sendCreditLimit($org, $a, $limit)) {
						$org->extra['last_send_percent']=0.8;
						$org->updateMeta();
						$this->log2file($org->id.'=>percent:'.$a, "credit_notice");
						return 0.8;
					}
				}
				return 0.8;
			}
		}
		return 0;
	}
	public function sendCreditLimit($org, $percent, $creditLimit, $term='')
	{
		$emailLog = new Emailog();
		$percent = min($percent, 1);
		$percent = $percent * 100 . '%';
		$creditLimit = $creditLimit == 1 ? 0 : $creditLimit;
		$emailLog->type = Emailog::CREDIT_NOTICE;
		$emailLog->fid = $org->id;
		$emailLog->dt = date('Y-m-d H:i:s');
		$emailLog->to_id = $org->id;
		$emailLog->status = 10;
		$emailLog->prepTemplate();
		$emailLog->tpl->assignThese([
			'CLIENT_NAME' => $org->name,
			'PERCENT' => $percent,
			'CREDIT_LIMIT' => $creditLimit,
			'INVOICE_TERM' => $term,
		]);
		$emailLog->subject = $emailLog->tpl->subject;
		$emailLog->body = $emailLog->tpl->getContent();
		if ($emailLog->creditNoticeSend()) {
			return true;
		}
		return  false;
	}

	public function sendInvoiceTermDueEmail($org, $percent, $creditLimit, $term='')
	{
		$emailLog = new Emailog();
		$percent = min($percent, 1);
		$percent = $percent * 100 . '%';
		$creditLimit = $creditLimit == 1 ? 0 : $creditLimit;
		$emailLog->type = Emailog::INVOICE_TERM_DUE;
		$emailLog->fid = $org->id;
		$emailLog->dt = date('Y-m-d H:i:s');
		$emailLog->to_id = $org->id;
		$emailLog->status = 10;
		$emailLog->prepTemplate();
		$emailLog->tpl->assignThese([
			'CLIENT_NAME' => $org->name,
			'PERCENT' => $percent,
			'CREDIT_LIMIT' => $creditLimit,
			'INVOICE_TERM' => $term,
		]);
		$emailLog->subject = $emailLog->tpl->subject;
		$emailLog->body = $emailLog->tpl->getContent();
		if ($emailLog->creditNoticeSendToCustomer()) {
			return true;
		}
		return  false;
	}

