	public function updateD2Zweight(){
		$ps = ImParcel::model()->findAll('status < 25 AND cbwf & 65536 > 0');
		if(empty($ps)) return;
		$max_ppg = 300;
		$pgs = ceil(count($ps) / $max_ppg);
		$d2z = new D2zShipAPI('local', false);
		for($pg = 0; $pg < $pgs; $pg++){
			$ss = array_slice($ps, $pg * $max_ppg, $max_ppg);
			$rs = $d2z->updateConsignments($ss);
			if(is_array($rs)){
				if(!empty($rs['errorMessage'])){
					include_once('PHPMailer/class.phpmailer.php');
					$mail = new PHPMailer();
					$mail->CharSet = 'UTF-8';
					$mail->IsHTML(true);
					$mail->From     = 'hvlv@toplogistics.com.au';
					$mail->FromName = 'HVLV';
					$mail->Subject  = 'Problem updating D2z local shipments';
					$mail->Body = $rs['errorMessage'].'<br />'.implode('<br />', $rs['errorDetails']);
					$mail->AddAddress('gero@toplogistics.com.au');
					$mail->Send();
					continue;
				}
				if(in_array($rs['responseMessage'], ['Weight updated successfully', 'Partially updated'])){
					$transaction=Yii::app()->db->beginTransaction();
					try {
						foreach ($ss as $s) {
							$s->cbwf = $s->cbwf & (~ 65536);
							$s->update(['cbwf']);
						}
						$transaction->commit();
					} catch (Exception $ex) {
						$transaction->rollback();
						throw $ex;
					}
				}
			}
		}
	}

	public function pushD2Zlocal(){
		$ps = ImParcel::model()->with('trans')->together(true)->findAll('trans.org_id = 1426 AND trans.status = 10');
		if(empty($ps)) return;
		$max_ppg = 300;
		$pgs = ceil(count($ps) / $max_ppg);
		$d2z = new D2zShipAPI('local', false);
		for($pg = 0; $pg < $pgs; $pg++){
			$ss = array_slice($ps, $pg * $max_ppg, $max_ppg);
			$rs = $d2z->createConsignments($ss, true);
			if(is_array($rs)){
				if(!empty($rs['errorMessage'])){
					include_once('PHPMailer/class.phpmailer.php');
					$mail = new PHPMailer();
					$mail->CharSet = 'UTF-8';
					$mail->IsHTML(true);
					$mail->From     = 'hvlv@toplogistics.com.au';
					$mail->FromName = 'HVLV';
					$mail->Subject  = 'Problem lodging D2z local shipments';
					$mail->Body = $rs['errorMessage'].'<br />'.implode('<br />', $rs['errorDetails']);
					$mail->AddAddress('gero@toplogistics.com.au');
					$mail->Send();
					if($this->debug) echo $rs['errorMessage'], PHP_EOL;
					continue;
				}
				$transaction=Yii::app()->db->beginTransaction();
				try {
					foreach ($rs as $r) {
						if(!empty($r['referenceNumber'])){
							$s = ImParcel::model()->find('hbn = :n', [':n' => $r['referenceNumber']]);
							if(!empty($s)){
								$s->trans[0]->status = 11;
								$s->trans[0]->save();
							}
						}
					}
					$transaction->commit();
				} catch (Exception $ex) {
					$transaction->rollback();
					throw $ex;
				}
			}
		}
	}

	public function pushUbi(){
		$ps = ImParcel::model()->with('trans')->together(true)->findAll('t.status < 100 AND trans.org_id = 3079 AND trans.status = 10');
		if(empty($ps)) return;

		$errs = [];
		$max_ppg = 300;
		$pgs = ceil(count($ps) / $max_ppg);
		$ubi=new UbiAPI(false,false,0);
		for($pg = 0; $pg < $pgs; $pg++){
			$ss = array_slice($ps, $pg * $max_ppg, $max_ppg);
			$rs=$ubi->createShipment($ss);
			if(is_object($rs)){
				$transaction=Yii::app()->db->beginTransaction();
				try {
					foreach($rs->data as $result){
						if($result->status=="Success"){
							if(!empty($result->referenceNo)){
								$s = ImParcel::model()->find('hbn = :n', [':n' => $result->referenceNo]);
								if(!empty($s)){
									$s->nolog = true;
									$s->mdata['etower_shipment_orderid'] = $result->orderId;
									$s->update('meta');
									$s->nolog = false;
									$s->trans[0]->status = 11;
									$s->trans[0]->save();
								}
							}
						}else{
							if(!empty($result->referenceNo) && !empty($result->errors)){
								$errs[] = $result->referenceNo.': '.json_encode($result->errors);
							}
						}
					}
					$transaction->commit();
				} catch (Exception $ex) {
					$transaction->rollback();
					throw $ex;
				}
			}
		}

		if(!empty($errs)){
			include_once('PHPMailer/class.phpmailer.php');
			$mail = new PHPMailer();
			$mail->CharSet = 'UTF-8';
			$mail->IsHTML(true);
			$mail->From     = 'hvlv@toplogistics.com.au';
			$mail->FromName = 'HVLV';
			$mail->Subject  = 'Problem lodging UBI shipments';
			$mail->Body = implode('<br />', $errs);
			$mail->AddAddress('gero@toplogistics.com.au');
			$mail->Send();
			if($this->debug) echo implode($errs), PHP_EOL;
		}
	}

	public function sentSMSToNoticeBooking()
	{
		//date_default_timezone_set('Australia/Sydney');
		$criteria = new CDbCriteria();
		$time = date('Y-m-d H:i:00',strtotime('+30 minute', strtotime(date('Y-m-d H:i:00'))));
		$criteria->addCondition(" booking_time = '".$time."'");
		$criteria->addCondition(" status = ".DeliveryRecord::NEWSTATE);
		$drs = DeliveryRecord::model()->findAll($criteria);
		$err = [];
		$i = 0;
		$transaction = Yii::app()->db->beginTransaction();
		try 
		{
			foreach ($drs as $key => $dr) 
			{
					if (!empty($dr->mdata['sent_sms'])) {
						continue;
					}

					if (Sms::model()->count('no = :n AND msg LIKE :r', [':n' => $dr->mobile, ':r' => '%'.$dr->no.'%']) > 0) {
						continue;
					}

					$sms = new Sms;
					$sms->type = 30;
					$sms->no = $dr->mobile;
					$sms->msg = "TLA Booking notice:  Your booking {$dr->no} is at {$dr->booking_time}. Please check the detail in https://book.toplogistics.com.au";
					$sms->sendLocal();

					$dr->mdata['sent_sms'] = 1;
					$dr->save();
					$i++;
			}
		 	$transaction->commit();
		} catch (Exception $ex) {
			$transaction->rollback();
			Log::log2file("mobile=>".$dr->mobile."=>".$ex->getMessage(), "sms_err_log", "sms");
			throw $ex;
		}

		echo "Total ".$i." SMS sent\n";
		if($i>0)
		{
			$sms = new Sms;
			$sms->type = 30;
			$sms->no = '0414583962';
			$sms->msg = $i." booking SMS sent";
			$sms->sendLocal();
		}

	}

	public function autoCompleteWmsTask()
	{
		$tasks = WmsTask::model()->findAll('status = 30 AND link_id = 0');
		foreach ($tasks as $task) {
			if (strtotime($task->lastlog->time) > time() - 86400 * 7) {
				continue;
			}
			if (empty($task->actionTask->items)) {
				continue;
			}

			$task->status = 99;
			$task->compl_time = date('Y-m-d H:i:s', strtotime($task->lastlog->time) + 3600);
			if (strtotime($task->createlog->time) < strtotime('2019-07-01 00:00:00')) {
				$task->bwf |= 4;
			}
			$task->bwf |= 2;
			$task->save();
		}
	}

	public function rtsInvoice(){
		Yii::app()->name = 'TLA';
		function getStartrackInvAmount($p){
			// $il = InvLine::model()->with('invoice')->find('invoice.type = :it AND t.meta LIKE :t', [':it' => 10, ':t' => '%'.$p->ref.'%']);
			// if (empty($il)) {
			// 	[$app_name, Yii::app()->name] = [Yii::app()->name, 'TLA'];
			// 	$il = InvLine::model()->with('invoice')->find('invoice.type = :it AND t.meta LIKE :t', [':it' => 10, ':t' => '%'.$p->ref.'%']);
			// 	Yii::app()->name = $app_name;
			// }
			// if(empty($il)){
			// 	return 999;
			// }else{
			// 	foreach($il->mdata['items'] as $itm){
			// 		if($itm[0] == $p->ref){
			// 			return $itm[5];
			// 		}
			// 	}
			// }
			// return 999;

			$orgRate = OrgRate::model()->find('org_id = :oid AND type = 40', [':oid' => $p->agent_id]);
			$rate = $p->getChargePro($p->agent, $orgRate, false);
			if (is_numeric($rate) && $rate > 0) {
				return $rate;
			} else {
				return 999;
			}
		}

		function getRtsRate($orgId, $p = null)
		{

			$courier = getCourier($p);

			// get organizaton price rate
			$orgRate = OrgRate::model()->find('org_id = :oid AND type = 40', [':oid' => $orgId]);
			if (empty($orgRate)) {
				return 0;
			}

			// get org rate details
			$rateInfo = json_decode($orgRate['meta']);
			$code = 'AU'; // RTS fee belongs to Australia local
			$rtsFee = 0;
			$feeDescription = '';
			if ($courier == 'fastway') {
				if (isset($rateInfo->$code->rts_rate_fast)) {
					$rtsFee = floatval($rateInfo->$code->rts_rate_fast);
					$feeDescription = '$'.$rtsFee.' /Shipment';
				}
			} elseif (in_array($courier, ['startrack', 'tnt','dfe','eiz','mytoll'])) {
				if (isset($rateInfo->$code->rts_rate_star)) {
					$rtsFee = floatval($rateInfo->$code->rts_rate_star) * getStartrackInvAmount($p) / 100;
					$feeDescription = floatval($rateInfo->$code->rts_rate_star)."% * $".getStartrackInvAmount($p);
				}else
				{
					$rtsFee = 90 * getStartrackInvAmount($p) / 100;
					$feeDescription = "90% * $".getStartrackInvAmount($p);
				}
			} elseif ($courier == 'letter') {
				$rtsFee = 0;
			} elseif (isset($rateInfo->$code->rts_rate)) {
				$rtsFee = floatval($rateInfo->$code->rts_rate) * $p->pkg;
				$feeDescription = '$'.floatval($rateInfo->$code->rts_rate)." * ".$p->pkg;
			}else{
				$rtsFee = 10 * $p->pkg;
				$feeDescription = '$10 * '.$p->pkg;
			}
			return [$rtsFee,$feeDescription];
		};

		function getCourier($p){
			$courier = 'aus';

			if (preg_match('/LET\d{7}/i', $p->ref)) {
				$courier = 'letter';
			}else{
				$sql = 'SELECT org_id FROM `tranship` WHERE pid = '.$p->id.' AND connote = "'.$p->ref.'" ORDER BY id DESC LIMIT 1';
				$t = Yii::app()->getDb()->createCommand($sql)->queryScalar();
				if(!empty($t)){
					switch($t){
						case Org::ORGID_COURIER_FASTWAY:
							$courier = 'fastway';
						break;
						case Org::ORGID_COURIER_STARTRACK:
							$courier = 'startrack';
						break;
						case Org::ORGID_COURIER_TNT:
							$courier = 'tnt';
						break;
						case Org::ORGID_COURIER_TNT_TOP:
							$courier = 'tnt';
						break;
						case Org::ORGID_COURIER_DFE:
							$courier = 'dfe';
						break;
						case Org::ORGID_COURIER_DFE_TOP:
							$courier = 'dfe';
						break;
						case Org::ORGID_COURIER_EIZ_TOLL:
							$courier = 'eiz';
						break;
						case Org::ORGID_COURIER_UBI:
							$courier = 'mytoll';
							
						case Org::ORGID_COURIER_TOLL_IPEC:
							$courier = 'mytoll';
						break;
					}
				}
			}
			return $courier;
		}

		$rs = ShipmentScan::model()->findAll('type = 4 AND scan_time > DATE_SUB(CURRENT_DATE(), INTERVAL 5 WEEK)');
		if($this->debug) echo 'Found '.count($rs).' RTS shipments', PHP_EOL;
		$trs = [];
		foreach($rs as $r){
			// [$app_name, Yii::app()->name] = [Yii::app()->name, 'HVLV APP'];
			// $pcae = InvLine::model()->with('invoice')->together(true)->count('model=:m AND fid=:fid AND invoice.type = 36 AND invoice.status < 10', [':m' => 'ImParcel', ':fid' => $r->pid]) == 0;
			// Yii::app()->name = $app_name;

			[$app_name, Yii::app()->name] = [Yii::app()->name, 'TLA'];
			$tla = InvLine::model()->with('invoice')->together(true)->count('model=:m AND fid=:fid AND invoice.type = 36 AND invoice.status < 10', [':m' => 'ImParcel', ':fid' => $r->pid]) == 0;
			Yii::app()->name = $app_name;

			if ($tla) {
				// $trs[$r->shipment->agent_id][] = $r->shipment;
				$trs[$r->shipment->agent_id][$r->shipment->id] = $r->shipment;
			}
		}
		ksort($trs);

		$norates = [];
		$trans = Yii::app()->db->beginTransaction();
		try{
			foreach($trs as $k=>$ps){
				$tc = 0;
				$tt = 0;
				$items = [];
				foreach($ps as $p){
					if($p->isTopCourierServiceDelivery(true)||$p->checkIsCargoProcessWithRef())
					{
						$norates[$k][] = $p;
						continue;
					}
					// get RTS fee
					[$rtsFee,$feeDescription] = getRtsRate($k, $p);
					if($rtsFee > 0){
						$tc++;
						$tt+= $rtsFee;
						$items[] = [empty($p->cref) ? $p->hbn : $p->cref, $p->ref, $p->mdata['rts_scan_date'], 'Returned to Sender Receiving Fee</br>'.$feeDescription, $rtsFee, $p->id];
					}else{
						//filter fastway
						if($p->trans[0]->org_id != 115){
							$norates[$k][] = $p;
						}
					}
				}

				if($tt > 0){
					$owner = Org::model()->findByPk($k);
					$invoice = new Invoice();
					$invoice->type = Invoice::INVOICE_TYPE_RTS_FEE; // for RTS scan fee invoice
					$invoice->to_id = $k;
					$invoice->man_id = 0; // in case manifest id means nothing
					$invoice->dpt_id = Org::PCAE_DEPARTMENT_SYDNEY;
					$invoice->dpmt = Invoice::DPMT_IMPORT;
					$invoice->status = Invoice::INVOICE_STATUS_PENDING;
					$invoice->date = date('Y-m-d');
					$invoiceCurrency = 1;
					$orgRate = OrgRate::model()->find('org_id = :oid AND type = 40', [':oid' => $k]);
					if (!empty($orgRate)) {
						$invoice->currency = $orgRate['currency'];
					}
					$chargeGST = !empty($owner->extra['incl_gst']);
					$invoice->mdata['payterm'] = empty($owner->extra['payterm']) ? '2 days' : $owner->extra['payterm'] . ' days';
					$invoice->due = Invoice::calcDue($invoice->date, $invoice->mdata['payterm']);
					$invoice->total = $tt;
					if ($chargeGST) {
						$invoice->gst = $tt * 0.1;
						// 2020-06-03 RTS Invoice Total not include GST
						$invoice->total += $invoice->gst;
					}
					Yii::app()->name = 'TLA';
					$invoice->save();

					foreach($items as $itm){
						$il = new InvLine;
						$il->inv_id = $invoice->id;
						$il->amount = $itm[4];
						if ($chargeGST) {
							$il->gst = $il->amount * 0.1;
							// 2020-06-03 RTS InvLine Amount not include GST
							$il->amount += $il->gst;
						}
						$il->model = 'ImParcel';
						$il->fid = array_pop($itm);
						$il->mdata['items'] = [$itm];
						if ($il->amount > 0) {
							Yii::app()->name = 'TLA';
							$il->save();
						}
					}
					if($this->debug) echo $k.' '.count($items).' items, invoice $'.$tt, PHP_EOL;
				}
			}
			$trans->commit();
		} catch (Exception $ex) {
			$trans->rollback();
			throw $ex;
		}
		if(!empty($norates)){
			$body = '';
			foreach($norates as $k=>$ps){
				$body .= '<h3>'.$k.'</h3><ol>';
				foreach($ps as $p){
					$body .= '<li>'.$p->hbn.' '.$p->ref.'</li>';
				}
				$body .= '</ol><br />';
			}
			include_once('PHPMailer/class.phpmailer.php');
			$mail = new PHPMailer();
			$mail->CharSet = 'UTF-8';
			$mail->IsHTML(true);
			$mail->From     = 'imports@toplogistics.com.au';
			$mail->FromName = 'TLA imports';
			$mail->Subject  = 'RTS Invoice rates problem';
			$mail->Body = $body;
			$mail->AddAddress('gero@toplogistics.com.au');
			$mail->AddCC('imports@toplogistics.com.au');
			$mail->Send();
		}
	}

	public function rtsInvoiceNew(){
		Yii::app()->name = 'TLA';
		function getStartrackInvAmount($p){
			// $il = InvLine::model()->with('invoice')->find('invoice.type = :it AND t.meta LIKE :t', [':it' => 10, ':t' => '%'.$p->ref.'%']);
			// if (empty($il)) {
			// 	[$app_name, Yii::app()->name] = [Yii::app()->name, 'TLA'];
			// 	$il = InvLine::model()->with('invoice')->find('invoice.type = :it AND t.meta LIKE :t', [':it' => 10, ':t' => '%'.$p->ref.'%']);
			// 	Yii::app()->name = $app_name;
			// }
			// if(empty($il)){
			// 	return 999;
			// }else{
			// 	foreach($il->mdata['items'] as $itm){
			// 		if($itm[0] == $p->ref){
			// 			return $itm[5];
			// 		}
			// 	}
			// }
			// return 999;

			$orgRate = OrgRate::model()->find('org_id = :oid AND type = 40', [':oid' => $p->agent_id]);
			$rate = $p->getChargePro($p->agent, $orgRate, false);
			if (is_numeric($rate) && $rate > 0) {
				return $rate;
			} else {
				return 999;
			}
		}

		function getRtsRate($orgId, $p = null,$packages)
		{

			$courier = getCourier($p);
			// get organizaton price rate
			$orgRate = OrgRate::model()->find('org_id = :oid AND type = 40', [':oid' => $orgId]);
			if (empty($orgRate)) {
				return 0;
			}

			// get org rate details
			$rateInfo = json_decode($orgRate['meta']);
			$code = 'AU'; // RTS fee belongs to Australia local
			$rtsFee = 0;
			$feeDescription = '';
			if ($courier == 'fastway') {
				if (isset($rateInfo->$code->rts_rate_fast)) {
					$rtsFee = floatval($rateInfo->$code->rts_rate_fast);
					$feeDescription = '$'.$rtsFee.' /Shipment';
				}
			} elseif (in_array($courier, ['startrack', 'tnt','dfe','eiz','mytoll'])) {
				if (isset($rateInfo->$code->rts_rate_star)) {
					$rtsFee = (floatval($rateInfo->$code->rts_rate_star) * getStartrackInvAmount($p) / 100)*($packages/$p->pkg);
					$feeDescription = "$".getStartrackInvAmount($p)." * (".$packages."/".$p->pkg.")";
				}else
				{
					$rtsFee = 100 * getStartrackInvAmount($p) / 100;
					$feeDescription = "$".getStartrackInvAmount($p)." * (".$packages."/".$p->pkg.")";
				}
			} elseif ($courier == 'letter') {
				$rtsFee = 0;
			} elseif (isset($rateInfo->$code->rts_rate)) {
				$rtsFee = floatval($rateInfo->$code->rts_rate)*$packages;
				$feeDescription = '$'.floatval($rateInfo->$code->rts_rate)." * ".$packages;
			}else{
				$rtsFee = 10 * $p->pkg;
				$feeDescription = '$10';
			}
			return [$rtsFee,$feeDescription];
		};

		function getCourier($p){
			$courier = 'aus';

			if (preg_match('/LET\d{7}/i', $p->ref)) {
				$courier = 'letter';
			}else{
				$sql = 'SELECT org_id FROM `tranship` WHERE pid = '.$p->id.' AND connote = "'.$p->ref.'" ORDER BY id DESC LIMIT 1';
				$t = Yii::app()->getDb()->createCommand($sql)->queryScalar();
				if(!empty($t)){
					switch($t){
						case Org::ORGID_COURIER_FASTWAY:
							$courier = 'fastway';
						break;
						case Org::ORGID_COURIER_STARTRACK:
							$courier = 'startrack';
						break;
						case Org::ORGID_COURIER_TNT:
							$courier = 'tnt';
						break;
						case Org::ORGID_COURIER_TNT_TOP:
							$courier = 'tnt';
						break;
						case Org::ORGID_COURIER_DFE:
							$courier = 'dfe';
						break;
						case Org::ORGID_COURIER_DFE_TOP:
							$courier = 'dfe';
						break;
						case Org::ORGID_COURIER_EIZ_TOLL:
							$courier = 'eiz';
						break;
						case Org::ORGID_COURIER_UBI:
							$courier = 'mytoll';
							
						case Org::ORGID_COURIER_TOLL_IPEC:
							$courier = 'mytoll';
						break;
					}
				}
			}
			return $courier;
		}

		$rs = ShipmentRTSRecord::model()->findAll('rts_invoice_id = 0 and record_time > DATE_SUB(CURRENT_DATE(), INTERVAL 5 WEEK) and type = :type',[":type"=>ShipmentRtsRecord::KNOWN]);
		if($this->debug) echo 'Found '.count($rs).' RTS shipments', PHP_EOL;
		$trs = [];

		foreach($rs as $r){
			$trs[$r->shipment->agent_id][$r->shipment->id][$r->barcode] = $r;
		}

		ksort($trs);

		$norates = [];
		$trans = Yii::app()->db->beginTransaction();
		try{
			foreach($trs as $k=>$po){
				$tc = 0;
				$tt = 0;
				$items = [];
				foreach($po as $pid=> $rs){
					$p = Shipment::model()->findByPk($pid);
					$packages = count($rs);
					$barcodes = "";
					foreach ($rs as $k2 => $r)
					{
						$barcodes .="</br>".$p->ref."-".$r->sn;
						if($p->isTopCourierServiceDelivery(true)||$p->checkIsCargoProcessWithRef())
						{
							$norates[$k][] = [$p,$r->barcode];
							continue;
						}
					}
					// get RTS fee
					[$rtsFee,$feeDescription] = getRtsRate($k, $p,$packages);
					if($rtsFee > 0){
						$tc++;
						$tt+= $rtsFee;
						$items[] = [empty($p->cref) ? $p->hbn : $p->cref, $p->ref, $p->mdata['rts_scan_date'], 'Returned to Sender Receiving Fee</br>'.$feeDescription.$barcodes, $rtsFee, $p->id];
					}else{
						//filter fastway
						if($p->trans[0]->org_id != 115){
							$norates[$k][] = [$p,$r->barcode];
						}
					}
				}

				if($tt > 0){
					$owner = Org::model()->findByPk($k);
					$invoice = new Invoice();
					$invoice->type = Invoice::INVOICE_TYPE_RTS_FEE; // for RTS scan fee invoice
					$invoice->to_id = $k;
					$invoice->man_id = 0; // in case manifest id means nothing
					$invoice->dpt_id = Org::PCAE_DEPARTMENT_SYDNEY;
					$invoice->dpmt = Invoice::DPMT_IMPORT;
					$invoice->status = Invoice::INVOICE_STATUS_PENDING;
					$invoice->date = date('Y-m-d');
					$invoiceCurrency = 1;
					$orgRate = OrgRate::model()->find('org_id = :oid AND type = 40', [':oid' => $k]);
					if (!empty($orgRate)) {
						$invoice->currency = $orgRate['currency'];
					}
					$chargeGST = !empty($owner->extra['incl_gst']);
					$invoice->mdata['payterm'] = empty($owner->extra['payterm']) ? '2 days' : $owner->extra['payterm'] . ' days';
					$invoice->due = Invoice::calcDue($invoice->date, $invoice->mdata['payterm']);
					$invoice->total = $tt;
					if ($chargeGST) {
						$invoice->gst = $tt * 0.1;
						// 2020-06-03 RTS Invoice Total not include GST
						$invoice->total += $invoice->gst;
					}
					Yii::app()->name = 'TLA';
					$invoice->save();

					foreach($items as $itm){
						$il = new InvLine;
						$il->inv_id = $invoice->id;
						$il->amount = $itm[4];
						if ($chargeGST) {
							$il->gst = $il->amount * 0.1;
							// 2020-06-03 RTS InvLine Amount not include GST
							$il->amount += $il->gst;
						}
						$il->model = 'ImParcel';
						$il->fid = array_pop($itm);
						$il->mdata['items'] = [$itm];
						if ($il->amount > 0) {
							Yii::app()->name = 'TLA';
							$il->save();
						}
					}
					if($this->debug) echo $k.' '.count($items).' items, invoice $'.$tt, PHP_EOL;
				}
			}
			$trans->commit();
		} catch (Exception $ex) {
			$trans->rollback();
			throw $ex;
		}
		// if(!empty($norates)){
		// 	$body = '';
		// 	foreach($norates as $k=>$ps){
		// 		$body .= '<h3>'.$k.'</h3><ol>';
		// 		foreach($ps as $p){
		// 			$body .= '<li>'.$p->hbn.' '.$p->ref.'</li>';
		// 		}
		// 		$body .= '</ol><br />';
		// 	}
		// 	include_once('PHPMailer/class.phpmailer.php');
		// 	$mail = new PHPMailer();
		// 	$mail->CharSet = 'UTF-8';
		// 	$mail->IsHTML(true);
		// 	$mail->From     = 'imports@toplogistics.com.au';
		// 	$mail->FromName = 'TLA imports';
		// 	$mail->Subject  = 'RTS Invoice rates problem';
		// 	$mail->Body = $body;
		// 	$mail->AddAddress('gero@toplogistics.com.au');
		// 	$mail->AddCC('imports@toplogistics.com.au');
		// 	$mail->Send();
		// }
	}

	public function sendWmsAPIemail()
	{
		$tasks = WmsTask::model()->with('job', 'createlog')->findAll('t.type IN (3020,3030) AND t.is_request = 1 AND job.org_id IN (' . implode(',', Org::$easyships) . ') AND createlog.time >= :time AND JSON_VALUE(t.meta, "$.api_hook") = "ufl"', [':time' => date('Y-m-d H:i:s', strtotime(date('Y-m-d H:i:00') . ' - 35 minutes'))]);
		if (empty($tasks)) return;
		$table = '<table class="chart" border="1" cellspacing="0"><tr><th>Ref</th><th>Cust</th><th>Time</th><th>Cosignee</th><th>Result</th><th>Note</th></tr>';
		foreach ($tasks as $task) {
			$msg = '';
			if (!empty($task->mdata['errs'])) {
				foreach ($task->mdata['errs'] as $err) {
					$msg .= '&nbsp;&nbsp;' . $err['message'] . '<br />';
				}
			}
			$table .= '<tr><td>' . $task->ref . '</td><td>&nbsp;&nbsp;' . $task->job->customer->name . '</td><td>&nbsp;&nbsp;' . $task->createlog->time . '</td><td>&nbsp;&nbsp;' . @$task->deliveryTask->mdata['cnee']['name'] . '</td><td>&nbsp;&nbsp;' . ($task->status == 10 ? 'Pending' : 'Confirmed') . '</td><td>' . $msg . '</td></tr>';
		}
		$table .= '</table>';

		$emailog = new Emailog;
		$emailog->type = Emailog::WMS_API_EMAIL;
		$emailog->fid = 0;
		$emailog->dt = date('Y-m-d H:i:00');
		$emailog->to_id = 0;
		$emailog->status = 10;
		$emailog->prepTemplate();
		$emailog->tpl->assignThese([
			'TIME_FROM' => date('Y-m-d H:i:s', strtotime($emailog->dt . ' - 30 minutes')),
			'TIME_TO' => $emailog->dt,
			'DETAIL_TABLE' => $table,
		]);
		$emailog->subject = $emailog->tpl->subject;
		$emailog->body = $emailog->tpl->getContent();
		$emailog->sendWmsAPIemail();
	}

	public function syncTaskToPlatform()
	{
		$tasks =  WmsTask::model()->findAll('bwf & 256 > 0 and status="99"');
		foreach ($tasks as $task) {
			$this->doShopifyOut($task);
			$this->doCatchOut($task);
			$this->doEbayOut($task);
			//$this->doCin7Out($task);
			//$this->doUflOut($task);
		}
	}

	public function doEbayOut($task){
		$task->refresh();
		try{
			$ebay_task = WmsTaskMap::model()->find('task_id = :id AND platform = "ebay"', [':id' => $task->id]);
			if (!empty($ebay_task)) {
				$model = new EbayAPI();
				if (!empty($task->deliveryTask->mdata['shipment_id'])) {
					foreach ($task->deliveryTask->mdata['shipment_id'] as $id) {
						$shipment = Shipment::model()->findByPk($id);
						if (!empty($shipment) && !empty($shipment->ref)) {
							if ($task->deliveryTask->mdata['courier'] == Org::ORGID_COURIER_AUPOST) {
								$model->createShippingFulfillmentDetail($ebay_task->fid,'AustraliaPost', $shipment->ref);
							} else if ($task->deliveryTask->mdata['courier'] == Org::ORGID_COURIER_FASTWAY) {
								$model->createShippingFulfillmentDetail($ebay_task->fid,'FASTWAYCOURIERS', $shipment->ref);
							} else if ($task->deliveryTask->mdata['courier'] == Org::ORGID_COURIER_TLA && $shipment->agent_id != Org::ORGID_3PL_IGEA) {
								$model->createShippingFulfillmentDetail($ebay_task->fid,'Other', $shipment->ref);
							} else if ($task->deliveryTask->mdata['courier'] == Org::ORGID_COURIER_UBI_AP) {
								$model->createShippingFulfillmentDetail($ebay_task->fid,'AustraliaPost', $shipment->mdata['article_id']);
							} 
							//ebay not current support for tnt
							// else if ($task->deliveryTask->mdata['courier'] == Org::ORGID_COURIER_TNT) {
							// 	$model->createShippingFulfillmentDetail($ebay_task->fid,'TNT','TNT Express', $shipment->ref, 'https://www.tnt.com/express/en_au/site/home.html'.$shipment->ref);
							// }
						}else {
							$task->status = 30;
							$task->update('status');
						}
					}
				}	
				$task->mdata['synced' . $task->status] = true;
				$task->bwf = ($task->bwf ^ 256) & $task->bwf;
				$task->update('meta', 'bwf');
			}
		}catch (Exception $ex) {
			throw $ex;
		}
	}

	public function doCatchOut($task){
		$task->refresh();

		try{
			$catch_task = WmsTaskMap::model()->find('task_id = :id AND platform = "catch"', [':id' => $task->id]);
			if (!empty($catch_task)) {
				$mirakl = new MiraklAPI();
				if (!empty($task->deliveryTask->mdata['shipment_id'])) {
					foreach ($task->deliveryTask->mdata['shipment_id'] as $id) {
						$shipment = Shipment::model()->findByPk($id);
						if (!empty($shipment) && !empty($shipment->ref)) {
							if ($task->deliveryTask->mdata['courier'] == Org::ORGID_COURIER_AUPOST) {
								$mirakl->setTracking($catch_task->fid,'AUSPOST','Australia Post', $shipment->ref, 'https://auspost.com.au/mypost/track/#/details/' . $shipment->ref);
							} else if ($task->deliveryTask->mdata['courier'] == Org::ORGID_COURIER_FASTWAY) {
								$mirakl->setTracking($catch_task->fid,'FC','Fastway Couriers', $shipment->ref, 'https://www.fastway.com.au/tools/track/?l=' . $shipment->ref);
							} else if ($task->deliveryTask->mdata['courier'] == Org::ORGID_COURIER_TLA && $shipment->agent_id != Org::ORGID_3PL_IGEA) {
								$mirakl->setTracking($catch_task->fid,'OTHER','TLA', $shipment->ref, 'http://www.kuaidi100.com/all/ems.shtml?mscomnu=' . $shipment->ref);
							} else if ($task->deliveryTask->mdata['courier'] == Org::ORGID_COURIER_TNT) {
								$mirakl->setTracking($catch_task->fid,'TNT','TNT Express', $shipment->ref, 'https://www.tnt.com/express/en_au/site/home.html'.$shipment->ref);
							}
						}else {
							$task->status = 30;
							$task->update('status');
						}
					}
				}	
				$task->mdata['synced' . $task->status] = true;
				$task->bwf = ($task->bwf ^ 256) & $task->bwf;
				$task->update('meta', 'bwf');
			}
		}catch (Exception $ex) {
			throw $ex;
		}
	}

	public function doShopifyOut($task)
	{
		$task->refresh();
		// $task->mdata['synced' . $task->status] = true;
		// $task->bwf = ($task->bwf ^ 256) & $task->bwf;
		// $task->update('meta', 'bwf');

		// shopify out
		// write back tracking no
		$shopify_task = WmsTaskMap::model()->find('task_id = :id AND platform = "shopify"', [':id' => $task->id]);
		if (!empty($shopify_task)) {
			if (!in_array($task->job->org_id, [1])) {
				$cust = WmsAPI::model()->find('org_id = :org_id', [':org_id' => $task->job->org_id]);
				$config = array(
					'store_domain' => $cust->domain,
					'api_key' => $cust->api_key,
					'api_secret' => $cust->api_secret,
					'org_id' => $cust->org_id,
				);
				$shopify = new ShopifyAPI($config);
				if (!empty($task->deliveryTask->mdata['shipment_id'])) {
					foreach ($task->deliveryTask->mdata['shipment_id'] as $id) {
						$shipment = Shipment::model()->findByPk($id);
						if (!empty($shipment) && !empty($shipment->ref)) {
							if ($task->deliveryTask->mdata['courier'] == Org::ORGID_COURIER_AUPOST) {
								$result = $shopify->postFulfillment($shopify_task->fid, $shipment->ref, ['https://auspost.com.au/mypost/track/#/details/' . $shipment->ref]);
							} else if ($task->deliveryTask->mdata['courier'] == Org::ORGID_COURIER_FASTWAY) {
								$result = $shopify->postFulfillment($shopify_task->fid, $shipment->ref, ['https://www.fastway.com.au/tools/track/?l=' . $shipment->ref]);
							} else if ($task->deliveryTask->mdata['courier'] == Org::ORGID_COURIER_PCA && $shipment->agent_id != Org::ORGID_3PL_IGEA) {
								$result = $shopify->postFulfillment($shopify_task->fid, $shipment->ref, ['http://www.kuaidi100.com/all/ems.shtml?mscomnu=' . $shipment->ref]);
							} else if ($task->deliveryTask->mdata['courier'] == Org::ORGID_COURIER_STARTRACK) {
								$result = $shopify->postFulfillment($shopify_task->fid, $shipment->ref, ['https://msto.startrack.com.au/track-trace/?id=' . $shipment->ref]);
							} else if ($task->deliveryTask->mdata['courier'] == Org::ORGID_COURIER_SENDLE) {
								$result = $shopify->postFulfillment($shopify_task->fid, $shipment->ref, ['https://track.sendle.com/tracking?ref=' . $shipment->ref]);
							} else if ($task->deliveryTask->mdata['courier'] == Org::ORGID_COURIER_TNT) {
								$result = $shopify->postFulfillment($shopify_task->fid, $shipment->ref, ['https://www.tnt.com/express/en_au/site/home.html'.$shipment->ref]);
							} else if ($task->deliveryTask->mdata['courier'] == Org::ORGID_COURIER_UBI_AP) {
								$result = $shopify->postFulfillment($shopify_task->fid, $shipment->mdata['article_id'], ['https://auspost.com.au/mypost/track/#/details/' . $shipment->mdata['article_id']]);
							}
						} else {
							$task->status = 30;
							$task->update('status');
