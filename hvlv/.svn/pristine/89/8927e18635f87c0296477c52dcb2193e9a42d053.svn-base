	public function cleanDuplicatedCargoProcess()
	{
		$sql = 'SELECT c.shipment_id FROM `cargo_process` c join shipment s on c.shipment_id =s.id group by c.shipment_id,c.caref having count(c.shipment_id) >1';
		$cmd = Yii::app()->db->createCommand($sql);
		$shipmentIds = $cmd->queryAll();
		$cids = [];
		foreach ($shipmentIds as $key => $shipmentId) {
			$cpModel = CargoProcess::model()->find(' shipment_id = :shipment_id and status in (10,11) ',[":shipment_id"=>$shipmentId['shipment_id']]);
			if(!empty($cpModel))
			{
				$cids[] = $cpModel->id;
			}
		}
		if(!empty($cids))
		{
			$delSql = 'DELETE From `cargo_process` where id in ('.join(',',$cids).')';
			$cmd =  Yii::app()->db->createCommand($delSql);
			$cmd->execute();
		}
	}

	public function syncPCAEShipmentStatus()
	{
		$sql = 'SELECT s.* FROM `shipment` s join consol c on c.id =s.consol_id where consol_id>0 and s.status in (55,57,58,60) and created > "2020-08-01"';
		$cmd = Yii::app()->db_pcae->createCommand($sql);
		$shipments = $cmd->queryAll();
	}

