	public function createConsolForDirect()
	{
		$rs=ImParcel::model()->findAll('(cbwf&64>0 OR json_value(meta, "$.direct_courier") = 1) AND consol_id=0 AND created<=DATE_SUB(NOW(), INTERVAL 30 DAY)');
		if (!empty($rs)) {
			$consol=new ImcoConsol();
			$consol->dpt_id=106;
			$consol->awb='Direct'.date('Ym');
			$consol->pol = 'AUSYD';
			$consol->pod = 'AUSYD';
			$consol->eta = date('Y-m-d');
			$consol->created = date('Y-m-d');
			$consol->status = 60;
			$consol->save();
			$wt=0;
			foreach ($rs as $s) {
				$s->consol_id=$consol->id;
				$wt+=$s->weight;
				$s->update(['consol_id']);
			}
			$consol->mdata['awb_wt']=$wt+1;
			$consol->mdata['cgb_wt']=$wt+1;
			$consol->updateMeta();
			//             $errors = $consol->genSpecialInvoice();
			if (!empty($errors)) {
				$this->log2file(json_encode($errors));
			}
		}
	}

	public function genWmsStorageInvoice()
	{
		$org_ids=[];
		$sql="SELECT org_id FROM `wms_stock` where qty>0 OR updated>=DATE_SUB(NOW(), INTERVAL 32 DAY) group by org_id";
		$rs=Yii::app()->db->createCommand($sql)->queryAll();
		if (!empty($rs)) {
			foreach ($rs as $r) {
				$org_ids[]=$r['org_id'];
			}

			foreach ($org_ids as $oid) {
				$org=Org::model()->findByPk($oid);
				if (!empty($org)) {
					$wmsOrgQuote= WmsOrgQuote::model()->find("org_id=:org_id AND status=1", [':org_id'=>$oid]);
					//if not exist OrgQuote, we need to find their parent org quotes, through by_id
					if (empty($wmsOrgQuote)&&$org->by>1) {
						$wmsOrgQuote=WmsOrgQuote::model()->find("org_id=:org_id AND status=1", [':org_id'=>$org->by]);
					}
					if (empty($wmsOrgQuote)) {
						//we need to make an error log;
						$this->log2file('100001-WMS ORG Rate Not set UP for'.$org->id, 'wms_err');
						continue;
					}

					//1030 By pallet per week     1035 by CBM per week
					if (!empty($org->extra['storage_charge_type'])) {
						$chargeType=($org->extra['storage_charge_type']==1030)?1030:(($org->extra['storage_charge_type']==1035)?1035:'');
					} else {
						$chargeType='';
					}
					$rate=0;
					// echo $oid."\t".$chargeType."\n";
					if (empty($chargeType)) {
						//when empty, we need to check if the OrgQuote set up 1030 or 1035;
						if (!empty($wmsOrgQuote->mdata[1030])) {
							$rate=$wmsOrgQuote->mdata[1030];
							$org->extra['storage_charge_type']=1030;
							$chargeType=1030;
						} elseif (!empty($wmsOrgQuote->mdata[1035])) {
							$rate=$wmsOrgQuote->mdata[1035];
							$org->extra['storage_charge_type']=1035;
							$chargeType=1035;
						} else if (!empty($wmsOrgQuote->mdata[1032])) {
							$rate=$wmsOrgQuote->mdata[1032];
							$org->extra['storage_charge_type']=1032;
							$chargeType=1032;
						} else {
							//make an eroor log that rate(1030,1035) not set up
							$this->log2file('100002-WMS ORG Rate(1030,1035,1032) Not set UP for'.$org->id, 'wms_err');
							continue;
						}
					} else {
						if (!empty($wmsOrgQuote->mdata[$chargeType])) {
							$rate=$wmsOrgQuote->mdata[$chargeType];
						} else {
							//make an eroor log that rate(1030,1035) not set up
							$this->log2file('100003-WMS ORG Rate(1030,1035,1032) Not set UP for'.$org->id, 'wms_err');
							continue;
						}
					}

					//to here we already get the rate, so we need to get the start date
					$start_date=date('Y-m-d', strtotime('-6 day'));
					$end_date=(date('Y-m-d'));
					// cause re-generate last week storage invoice
					// if (!empty($org->extra['wms_from_date'])) {
					// 	$start_date=$org->extra['wms_from_date'];
					// }
					$errors = WmsInvoice::genWmsStorage($org, $start_date, $end_date);
					if (!empty($errors)) {
						$this->log2file('100004-'. implode(";", $errors)." org_id: ".$org->id, 'wms_err');
					} else {
						//update the wms_from_date
						$org->extra['wms_from_date']=$end_date;
						$org->updateMeta();
					}
				}
			}
		}
	}

	public function genWmsInvoice()
	{
		$org_ids = [];
		$sql = "SELECT org_id FROM `wms_stock` where qty>0 OR updated>=DATE_SUB(NOW(), INTERVAL 32 DAY) group by org_id";
		$rs = Yii::app()->db->createCommand($sql)->queryAll();
		if (!empty($rs)) {
			foreach ($rs as $r) {
				$org_ids[] = $r['org_id'];
			}
			$org_ids[] = 1308;

			foreach ($org_ids as $oid) {
				$org = Org::model()->findByPk($oid);
				if (!empty($org) && !empty($org->extra['wms_invoice'])) {
					$wmsOrgQuote = WmsOrgQuote::model()->find("org_id=:org_id AND status=1", [':org_id'=>$oid]);
					//if not exist OrgQuote, we need to find their parent org quotes, through by_id
					if (empty($wmsOrgQuote)&&$org->by>1) {
						$wmsOrgQuote = WmsOrgQuote::model()->find("org_id=:org_id AND status=1", [':org_id'=>$org->by]);
					}
					if (empty($wmsOrgQuote)) {
						//we need to make an error log;
						$this->log2file('100001-WMS ORG Rate Not set UP for'.$org->id, 'wms_err');
						continue;
					}

					//to here we already get the rate, so we need to get the start date
					$start_date = date('Y-m-d', strtotime('-7 day'));
					$end_date = date('Y-m-d', strtotime('-1 day'));
					// if (!empty($org->extra['wms_from_date'])) {
					// 	$start_date = $org->extra['wms_from_date'];
					// }
					$errors = WmsInvoice::genWmsService($org, $start_date, $end_date);
					if (!empty($errors)) {
						$this->log2file('100004-'.implode(";", $errors)." org_id: ".$org->id, 'wms_err');
						// if (!in_array($org->id, Org::$airsea_heshengyuan)) {
						// 	throw new Exception('wms service invoice - '.implode(";", $errors)." org_id: ".$org->id);
						// }
					} else {
						//update the wms_from_date
						$org->extra['wms_from_date']=$end_date;
						$org->updateMeta();
					}
				}
			}
		}
	}

	// this function is used to create rts storage invoice and discard fees.
	public function RTSdiscard()
	{
		$rs=ImParcel::model()->findAll('status=80');
		foreach ($rs as $r) {
			if (isset($r->mdata['rts_scan_date'])&&date('Y-m-d')>date('Y-m-d', strtotime('31 day', strtotime($r->mdata['rts_scan_date'])))) {
				$this->createRTSStorageInvoice($r);
				$this->createDiscardInvoice($r);
				$r->status=86;
				$r->update('status');
			}
		}
	}
	private function createRTSStorageInvoice(&$shipment)
	{
		// not existing yet , just create a new one
		$invoice = new Invoice();
		$invoice->type = Invoice::INVOICE_TYPE_STORAGE_FEE; // for storage fee invoice
		$invoice->to_id = $shipment->agent_id;
		$invoice->man_id = 0; // in case manifest id means nothing
		$invoice->dpt_id = $shipment->ddpt_id;
		$invoice->dpmt = Invoice::DPMT_IMPORT;

		// if department not set , we set as sydney warehouse
		if (empty($invoice->dpt_id)) {
			$invoice->dpt_id = Org::PCAE_DEPARTMENT_SYDNEY;
		}

		$invoice->status = Invoice::INVOICE_STATUS_PENDING;

		// get invoice currency
			$invoiceCurrency = 1; // default as AUD
			$orgRate = OrgRate::model()->find('org_id = :oid AND type = 40', [':oid' => $shipment->agent_id]);
		if (!empty($orgRate)) {
			$invoiceCurrency = $orgRate['currency'];
		}
		$invoice->currency = $invoiceCurrency;

		// set invoice name , address and pay terms information
		$owner = $shipment->agent;
		$invoice->mdata['name'] = $owner->name;
		$invoice->mdata['address'] = $owner->getAddress();
		$invoice->mdata['payterm'] = empty($owner->extra['payterm']) ? '2 days' : $owner->extra['payterm'] . ' days';

		// here just dummy date , once accounting change to posted , should create new date for the invoice
		$invoice->due = Invoice::calcDue($invoice->date, $invoice->mdata['payterm']);



		$invoice->date = date('Y-m-d');

		// calculate all price based on weight for the shipment
		$items = [];
		$rt = $this->getRTSStorageFee($shipment);
		if ($rt[0] > 0) { // only save in case charge fee more than zero

			// we save charge days ,in and out date at the last two positions
			$items[] = [isset($shipment->consol->awb)?$shipment->consol->awb:$shipment->ref, $shipment->hbn, $shipment->getDesc(), $shipment->pkg, $shipment->weight, $shipment->cbm, $rt[0],$shipment->ref, 0, 0, $rt[1], $shipment->mdata['rts_scan_date'], date('Y-m-d')];

			// save or update invoice

			// check org setting to see if storage has GST
			$gst = 0;
			$org = Org::model()->findByPk($shipment->agent_id);
			if (isset($org) && isset($org->extra['incl_gst'])) {
				if ($org->extra['incl_gst'] == 1) {
					$gst = round($rt[0] * 10 / 100, 2);
				}
			}
			$invoice->total += $rt[0];
			$invoice->gst += $gst;
			$invoice->total += $gst;
			$invoice->save();

			// create related invoice line and attached it to the invoice
			$il = new InvLine;
			$il->inv_id = $invoice->id;
			$il->amount = $rt[0];
			$il->amount += $gst;
			$il->gst = $gst;
			$il->qty = 1;
			$il->mdata['items'] = $items;
			$il->model = 'Manifest';
			//            $il->fid = $mid;
			$il->save();
		}
	}

	private function getRTSStorageFee(&$shipment)
	{
		$ss = new OrgRate('search');
		$cus_services = $ss->getCustomerServicePlans($shipment->agent_id);
		$storage_rate = $storage_terms = 0;
		if (isset($cus_services['services']->AU->rts_strrate)) {
			$storage_rate = $cus_services['services']->AU->rts_strrate;
		}
		if (isset($cus_services['services']->AU->rts_strterms)) {
			$storage_terms = $cus_services['services']->AU->rts_strterms;
		}

		$amount = 0;
		// calculate how many days we have stored
		$inTime = new DateTime($shipment->mdata['rts_scan_date'], new DateTimeZone('Australia/Sydney'));
		$outTime = new DateTime('now', new DateTimeZone('Australia/Sydney'));
		$storedDays = $outTime->diff($inTime)->format("%a");
		$chargeDays = $storedDays - $storage_terms;
		if ($chargeDays > 0) {
			// how much we should charge
			$amount = $chargeDays * $shipment->weight * $storage_rate;
		}


		return [$amount, $chargeDays];
	}


	/**
	* create RTS scan fee
	* @param $parcel
	*/
	private function createDiscardInvoice(&$parcel)
	{

		// check to see if RTS scan invoice with pending status existing or not
		// if existing , we just update it
		// otherwise create a new one with pending status
		// Normally only account change status from pending to posted
		// check to see if related pending invoice existing
		$invoice = Invoice::model()->find('to_id = :tid AND type = :itype AND status = 1', [':tid' => $parcel->agent_id,':itype' => Invoice::INVOICE_TYPE_DISCARD]);
		$orgRate = OrgRate::model()->find('org_id = :oid AND type = 40', [':oid' => $parcel->agent_id]);
		if (empty($invoice)) {
			// not existing yet , just create a new one
			$invoice = new Invoice();
			$invoice->type = Invoice::INVOICE_TYPE_DISCARD; // for RTS scan fee invoice
			$invoice->to_id = $parcel->agent_id;
			$invoice->man_id = 0; // in case manifest id means nothing
			$invoice->dpt_id = $parcel->ddpt_id;
			$invoice->dpmt= Invoice::DPMT_IMPORT;

			// if department not set , we set as Sydney warehouse
			if (empty($invoice->dpt_id)) {
				$invoice->dpt_id = Org::PCAE_DEPARTMENT_SYDNEY;
			}
			$invoice->status = Invoice::INVOICE_STATUS_PENDING; // set as pending status
			$invoice->date = date('Y-m-d'); // here just dummy date , once accounting change to posted , should create new date for the invoice

			// get invoice currency
			$invoiceCurrency = 1; // default as AUD

			if (!empty($orgRate)) {
				$invoiceCurrency =  $orgRate['currency'];
			}
			$invoice->currency = $invoiceCurrency;

			// set invoice name , address and pay terms information
			$owner = $parcel->agent;
			$invoice->mdata['name'] = $owner->name;
			$invoice->mdata['address'] = $owner->getAddress();
		}

		// get discard fee
		$discardRate = (isset($orgRate->mdata['AU']['rts_discard_rate'])?floatval($orgRate->mdata['AU']['rts_discard_rate']):0);
		$discardFee=$discardRate*(isset($parcel->pkg)?$parcel->pkg:1);
		if ($discardFee>0) {
			// check to see if we should including GST (default 10%)
			$gst = 0;
			if (isset($parcel->agent->extra['incl_gst']) && $parcel->agent->extra['incl_gst'] == 1) {
				$gst = round($discardFee * 10 / 100, 2);
				$discardFee += $gst;
			}

			$invoice->total += $discardFee;
			if ($gst > 0) {
				$invoice->gst += $gst;
			}
			$invoice->mdata['payterm'] = empty($owner->extra['payterm'])? '2 days' : $owner->extra['payterm'].' days';
			// here just dummy date , once accounting change to posted , should create new date for the invoice
			$invoice->due = Invoice::calcDue($invoice->date, $invoice->mdata['payterm']);

			//if some couries resend not charge, we don't need create  invoice
			if ($invoice->total>0) {
				$invoice->save();
				// create related invoice line and attached it to the invoice
				$il = new InvLine;
				$il->inv_id = $invoice->id;
				$il->amount = $discardFee;
				if ($gst > 0) {
					$il->gst = $gst;
				}
				// save receiving date,shipment ref No. and customer ref No.
				$il->mdata['items'][] =[empty($parcel->cref) ? $parcel->hbn : $parcel->cref , $parcel->ref,date('Y-m-d') ,'Discard Fee',(isset($parcel->pkg)?$parcel->pkg:1),$discardRate,$il->amount-$il->gst];
				$il->model = 'ImParcel';
				$il->fid = $parcel->id;
				if ($il->amount>0) {
					$il->save();
				}
			}
		}
	}

