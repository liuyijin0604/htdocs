				$this->recordCustomDoneByDaily();
				$this->log('End Record Custom Done Report');

				$this->log('Start Consol Daily Report');
				$this->recordConsolProcessDaily();
				$this->log('End Consol Daily Report');
			}

			if ($this->hr == 3 && $this->mn == 0) {
				$this->log('Start Generate 3PL Dashboard Data');
				$this->generate_3pl_dashboard_data(date('Y-m-d', strtotime(date('Y-m-d') . ' - 2 day')), date('Y-m-d', strtotime(date('Y-m-d') . ' + 1 day')));
				$this->log('End Generate 3PL Dashboard Data');
			}

			if ($this->hr == 3 && $this->mn == 15) {
				$this->log('Start Recalculate Billing Accrual');
				$this->recalculateBillingAccrual();
				$this->log('End Recalculate Billing Accrual');
			}

			if(date("m-d H:i")=="-01-01 00:00")
			{
				$this->log('StartrefreshHolidayCache');
				$this->refreshHolidayCache();
				$this->log('End refreshHolidayCache');
			}

			

			// // call PCAE cron
			// $this->pcaeCrons();

			// //call TLA cron
			$this->tlaCrons();

			} catch( Exception $e) {
				$trace = $e->getTrace();
				Emailog::sendEmailTo('dev@toplogistics.com.au', $e->getCode().PHP_EOL.$e->getMessage().PHP_EOL.print_r($trace, true)," Cron error");
			}
		}
	}


