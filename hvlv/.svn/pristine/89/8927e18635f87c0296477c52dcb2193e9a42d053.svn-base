	public function funcResend4PXTrace()
	{
		$date = strtotime("");
		$this->funcSync4pxTrace();
	}
	private function funcSync4pxTrace($date=false,$days = 0){
		include_once dirname(__DIR__).DIRECTORY_SEPARATOR.'components'.DIRECTORY_SEPARATOR.'Factory4PXOpenPlatform.php';

		if(!empty($date))
		{
			$numNow = time();
		}else
		{
			$numNow = $date;
		}

		$strNow = date('Y-m-d H:i:s',$numNow);

		if(!empty($days))
		{
			$strYesterday = date('Y-m-d H:i:s',$numNow-(86400*$days));
		}else
		{
			$strYesterday = date('Y-m-d H:i:s',$numNow-86400);
		}

		$strSql = 'select id_tracking,pid,dt,t_tracking.type,hbn,ref from (select id as id_tracking,pid,dt,type from tracking where type in (55,60,61,68) and dt> "'.$strYesterday.'" and dt<"'.$strNow.'" ) t_tracking inner join shipment on t_tracking.pid = shipment.id and shipment.agent_id = 2619';

		$listRows =Yii::app()->db->createCommand($strSql)->queryAll();
		foreach($listRows as $objRow){
			$numIdTracking = $objRow['id_tracking'];
			$numType = $objRow['type'];
			$strHbn = $objRow['hbn'];
			// $strDate = $objRow['dt'];
			$strDate = date('Y-m-d H:i:s', strtotime('-2 hour', strtotime($objRow['dt'])));

			$obj4px = Factory4pxOpenPlatform::funcCreate();

			if($numType == Tracking::TYPE_HELD){
				$obj4px->funcHeld($strHbn,$strDate);
			}
			else if($numType == Tracking::TYPE_CLEARED){
				$obj4px->funcClearance($strHbn,$strDate);
			}
			else if($numType == Tracking::TYPE_DECONSOLIDATION){
				$obj4px->funcDeconsolidation($strHbn,$strDate);
			}
			else if($numType == Tracking::TYPE_HAND_OVER){
				$obj4px->funcHandover2Courier($strHbn,$strDate);
			}

			$objTracking = Tracking::model()->findByPk($numIdTracking);
			$objTracking->mdata['sync_4px_trace'] = [];
			$isSuccess = $obj4px->getIsSuccess();
			if($isSuccess){
				$objTracking->activity .= '(sync_4px_trace-successed)';
			}
			else{
				$objTracking->activity .= '(sync_4px_trace-failed)';
			}
			$objTracking->mdata['sync_4px_trace']['is_success'] = $isSuccess;
			$objTracking->mdata['sync_4px_trace']['responce'] = $obj4px->getStrRespond();

			$objTracking->save();
		}
	}

