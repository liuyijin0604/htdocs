		$listRecord = $objCGoogleReview->funcCreateListRecord($strTimeFrom,$strTimeNow,$numLimitHours);

		$objCGoogleReview->funcSendEmial($listRecord);
	}
		
	

	
	
	
	
	public function eizCancel()
	{
		$cancelledEizPs = ImParcel::model()->with(['trans'])->findAll(' trans.org_id = :orgId and t.status = :status and json_value(t.meta,"$.sync_cancel") is null',[":orgId"=>Org::ORGID_COURIER_EIZ_TOLL,":status"=>ImParcel::STATE_CANCELLED]);
		$eizAPI = new EizAPI('syd');
		foreach ($cancelledEizPs as $key => $p)
		{
			$result = $eizAPI->cancelShipment([$p]);
			if(($result->status==200&&$result->result)||($result->status==400&&$result->message=='Consignment does not exist'))
			{
				$p->mdata['sync_cancel'] = 1;
				$p->save();
			}
		}
	}


	public function splitCustomerSFShipmentBarcode()
	{
		$shipments = ImParcel::model()->findAll('status >0 and consol_id>0 and ref like "%,%" and ref like "SF%" and hbn like "SF%" and json_value(meta,"$.splitParcel") is null ');
		foreach ($shipments as $key => $p)
		{
			$refArr = explode(',', $p->ref);
			foreach ($refArr as $key => $sub_ref) {
				if(empty($sub_ref)) continue;
				$pb = new ParcelBarcode();
				$pb->main_ref = $p->ref;
				$pb->fid = $p->id;
				$pb->sub_ref = $sub_ref;
				$pb->sn = $key+1;
				$pb->save();
			}
			
			$p->mdata['splitParcel'] = 1;
			$p->mdata['barcode'] = join(',',$refArr);
			$p->save();
		}

		$shipments = ImParcel::model()->findAll('status >0 and consol_id>0 and ref like "%;%" and ref like "SF%" and hbn like "SF%" and json_value(meta,"$.splitParcel") is null ');
		foreach ($shipments as $key => $p)
		{
			$refArr = explode(';', $p->ref);
			foreach ($refArr as $key => $sub_ref) {
				if(empty($sub_ref)) continue;
				$pb = new ParcelBarcode();
				$pb->main_ref = $p->ref;
				$pb->fid = $p->id;
				$pb->sub_ref = $sub_ref;
				$pb->sn = $key+1;
				$pb->save();
			}
			
			$p->mdata['splitParcel'] = 1;
			$p->mdata['barcode'] = join(',',$refArr);
			$p->save();
		}


		$shipments = ImParcel::model()->findAll('status >0 and consol_id>0 and ref like "0800%" and ref like "%;%" and json_value(meta,"$.splitParcel") is null ');
		foreach ($shipments as $key => $p)
		{
			$refArr = explode(';', $p->ref);
			foreach ($refArr as $key => $sub_ref) {
				if(empty($sub_ref)) continue;
				$pb = new ParcelBarcode();
				$pb->main_ref = $p->ref;
				$pb->fid = $p->id;
				$pb->sub_ref = $sub_ref;
				$pb->sn = $key+1;
				$pb->save();
			}
			
			$p->mdata['splitParcel'] = 1;
			$p->mdata['barcode'] = join(',',$refArr);
			$p->save();
		}
	}

	public function combineCustomerBarcode()
	{
		$pbs = ParcelBarcode::model()->findAll('id>0');
		$checked = [];
		foreach ($pbs as $key => $pb)
		{
			if(!in_array($pb->fid, $checked))
			{
				$p = ImParcel::model()->findByPk($pb->fid);
				if(empty($p->mdata['barcode']))
				{
					$barcode = [];
					$mypbs = ParcelBarcode::model()->findAll('fid = :fid',[":fid"=>$pb->fid]);
					foreach($mypbs as $key => $mypb)
					{
						$barcode[] = $mypb->sub_ref;
					}
					$p->mdata['barcode'] = join(',',$barcode);
					$p->save();
				}
				$checked[] = $pb->fid;
			}
		}
	}

