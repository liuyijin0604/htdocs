	/*
	* send empp requrie doc
	*/
	public function sendEmppRequireDocuments()
	{
		$processes= ShipmentProcess::model()->findAll('status=1 AND (type&1)>0');
		foreach ($processes as $process) {
			$shipment= ImParcel::model()->findByPk($process->pid);
			//if has op put file, we don't send empp
			$files=FileRepo::model()->findAll('type in (19) AND fid=:fid AND status!=0', [':fid'=>$process->pid]);
			if (!empty($files)&&sizeof($files)>=1) {
				$process->status= ShipmentProcess::DOC_RECEIVED;
				$process->date=date('Y-m-d H:i:s');
				$process->update(['status','date']);
			} else {
				$o= ShipmentProcess::requireEmppDocument($shipment);
			}
		}
	}

	public function sendAqisRequireDocuments()
	{
		$processes= ShipmentProcess::model()->findAll('status=1 AND (type&2)>0');
		foreach ($processes as $process) {
			$shipment= ImParcel::model()->findByPk($process->pid);
			//if has op put file, we don't send empp
			$files=FileRepo::model()->findAll('type in (19) AND fid=:fid AND status!=0', [':fid'=>$process->pid]);
			if (!empty($files)&&sizeof($files)>=1) {
				$process->status= ShipmentProcess::DOC_RECEIVED;
				$process->date=date('Y-m-d H:i:s');
				$process->update(['status','date']);
			} else {
				$o= ShipmentProcess::requireAqisDocument($shipment);
			}
		}
	}
	
	/*this is used to check if received document from sender or customer.
	* runs every 20 minutes
	*/
	public function checkDocument()
	{
		$shipments= ShipmentProcess::model()->findAll('status=2 AND date>DATE_SUB(NOW(), INTERVAL 30 DAY)');
		foreach ($shipments as $p) {
			$files=FileRepo::model()->findAll('type in (20) AND fid=:fid AND status in (20) AND DATE_FORMAT(date,"%Y-%m-%d")>=:date', [':fid'=>$p->pid,':date'=>date('Y-m-d',strtotime($p->started))]);
			if (sizeof($files)>=1) {
				$shipment= ImParcel::model()->findByPk($p->pid);
				$shipment->mdata['event_msg']="<b>Document Received from consignor!</b>";
				$shipment->updateMeta();
				ShipmentProcess::sendOpNotice($shipment);
				$p->changeStatus(ShipmentProcess::DOC_RECEIVED);
			}
		}
		$shipments= ShipmentProcess::model()->findAll('status=3 AND date>DATE_SUB(NOW(), INTERVAL 30 DAY)');
		foreach ($shipments as $p) {
			$files=FileRepo::model()->findAll('type in (18) AND fid=:fid AND status in (20) AND DATE_FORMAT(date,"%Y-%m-%d")>=:date', [':fid'=>$p->pid,':date'=>date('Y-m-d',strtotime($p->started))]);
			if (sizeof($files)>=1) {
				$shipment= ImParcel::model()->findByPk($p->pid);
				$shipment->mdata['event_msg']="<b>Document Received from consignee!</b>";
				$shipment->updateMeta();
				ShipmentProcess::sendOpNotice($shipment);
				$p->changeStatus(ShipmentProcess::DOC_RECEIVED);
			}
		}
	}


	public function checkDocumentAtNight()
	{
		$shipments= ShipmentProcess::model()->findAll('status=2 AND date>DATE_SUB(NOW(), INTERVAL 90 DAY)');
		foreach ($shipments as $p) {
			$files=FileRepo::model()->findAll('type in (20) AND fid=:fid AND status in (20) AND DATE_FORMAT(date,"%Y-%m-%d")>=:date', [':fid'=>$p->pid,':date'=>date('Y-m-d',strtotime($p->started))]);
			if (sizeof($files)>=1) {
				$shipment= ImParcel::model()->findByPk($p->pid);
				$shipment->mdata['event_msg']="<b>Document Received from consignor!</b>";
				$shipment->updateMeta();
				ShipmentProcess::sendOpNotice($shipment);
				$p->changeStatus(ShipmentProcess::DOC_RECEIVED);
			}
		}
		$shipments= ShipmentProcess::model()->findAll('status=3 AND date>DATE_SUB(NOW(), INTERVAL 90 DAY)');
		foreach ($shipments as $p) {
			$files=FileRepo::model()->findAll('type in (18) AND fid=:fid AND status in (20) AND DATE_FORMAT(date,"%Y-%m-%d")>=:date', [':fid'=>$p->pid,':date'=>date('Y-m-d',strtotime($p->started))]);
			if (sizeof($files)>=1) {
				$shipment= ImParcel::model()->findByPk($p->pid);
				$shipment->mdata['event_msg']="<b>Document Received from consignee!</b>";
				$shipment->updateMeta();
				ShipmentProcess::sendOpNotice($shipment);
				$p->changeStatus(ShipmentProcess::DOC_RECEIVED);
			}
		}
	}

	/*
	* EMPP or AQIS when clear means finished
	*/

	public function checkHeldDone()
	{
		$otherProcess= ShipmentProcess::model()->findAll('status <24 AND (type=8 or type = 16)');
		foreach ($otherProcess as $process) {
			$shipment= ImParcel::model()->findByPk($process->pid);
			if (!empty($shipment)) {
				if ($shipment->status>=60) {
					$process->status= ShipmentProcess::CUSTOM_DONE;
					$process->date=date('Y-m-d H:i:s');
					$process->update(['status','date']);
				}
			}
		}
		if ($this->day>5||($this->day==5&&date("H:i")>"18:00")) {
			return;
		}
		$processes= ShipmentProcess::model()->findAll('status in (1,2,3,4,5,6) AND type&2>0');
		foreach ($processes as $process) {
			$shipment= ImParcel::model()->findByPk($process->pid);
			if (!empty($shipment)) {
				if ($shipment->status>=60) {// shipment cleared  empp
					$process->status= ShipmentProcess::CUSTOM_DONE;
					$process->date=date('Y-m-d H:i:s');
					$process->update(['status','date']);
				}
			}
		}
	}

	/*this is used to check if received document from sender or customer.
	* runs every 20 minutes
	*/
	public function checkCustomReceipt()
	{
		return;
		$shipments= ShipmentProcess::model()->findAll('status=18 AND date>DATE_SUB(NOW(), INTERVAL 30 DAY)');
		foreach ($shipments as $p) {
			$files=FileRepo::model()->findAll('type in (21) AND fid=:fid AND status in (20)', [':fid'=>$p->pid]);
			if (sizeof($files)>=1) {
				$shipment= ImParcel::model()->findByPk($p->pid);
				$shipment->mdata['event_msg']="<b>Payment Receipt Received!</b>";
				$shipment->updateMeta();
				ShipmentProcess::sendOpNotice($shipment);
				$p->changeStatus(ShipmentProcess::PAYMENT_RECEIVED);
			}
		}
	}



	/**
	 *  Sea Process with bwf 2048 to push to Sea Proccess.
	 */
	public function pushShipmentsToSeaProcess()
	{
		$sql="SELECT id from `shipment` s WHERE type=10 AND bwf&2048>0 AND id not in(SELECT pid from `sea_process` t where t.status>0)";
		$rs=Yii::app()->db->createCommand($sql)->queryAll();
		foreach ($rs as $r) {
			$shipment= ImParcel::model()->findByPk($r['id']);
			if (empty($shipment->sea_process)) {
				$shipment->newSeaProcess();
			}
		}
	}

	/**
	 * send sea email based eta,etd and process status.
	 */
	public function doSeaProcessForward()
	{
		$processes= SeaProcess::model()->findAll('status in (10,20,30)');
		if (!empty($processes)) {
			foreach ($processes as $pro) {
				$pro->doProcessForward();
			}
		}
	}

	public function sendRtsNotice()
	{
		$rs=ImParcel::model()->findAll('(cbwf&256)>0');
		$org_shipments=[];
		foreach ($rs as $p) {
			if (empty($p->mdata['rts_scan_date'])) {
				continue;
			}
			$org_shipments[$p->agent_id][]=$p;
		}
		foreach ($org_shipments as $oid=>$shipments) {
			$emailLog = new Emailog();
			$emailLog->type = Emailog::RTS_RETURN_NOTICE;
			$emailLog->fid = $shipments[0]->id;
			$emailLog->dt = date('Y-m-d H:i:s');
			$emailLog->to_id = $oid;
			$emailLog->status = 10;

			$emailLog->prepTemplate();
			$note='<p>The following parcels have been returned to our warehouse.</p>
			<table cellpadding="5" width="400" cellspacing="0">
			<thead><tr><th>Connote</th><th>Cust Ref</th><th>Tracking No.</th></tr></thead>
			<tbody>';
			foreach ($shipments as $shipment) {
				$note.="<tr><td>".$shipment->hbn." </td><td>".$shipment->cref." </td><td>".(empty($shipment->ref)?$shipment->hbn:$shipment->ref)." </td></tr>";
			}
			$note .= '</tbody></table>';

			$emailLog->tpl->assignThese([
				'SHIPMENT_RETURN' => $note,
			]);
			$emailLog->subject = $emailLog->tpl->subject;
			$emailLog->body = $emailLog->tpl->getContent();
			$org = Org::model()->findByPk($oid);
			if (!empty($org->extra['outturn_email'])) {
				$emailLog->mdata['to']=$org->extra['outturn_email'];
				if (!empty($org->extra['goods-return-rec'])) $emailLog->mdata['to'] = $org->extra['goods-return-rec'];
				$emailLog->mdata['from']='imports@toplogistics.com.au';
				$emailLog->mdata['fromName']='TLA Imports';
				$emailLog->mdata['cc']='importscs@toplogistics.com.au';
				$o=$emailLog->sendEmail();
				if ($o['status']) {
					foreach ($shipments as $shipment) {
						$shipment->cbwf=$shipment->cbwf&256^$shipment->cbwf;
						$shipment->update('cbwf');
						Log::log2file($shipment->ref.'=>'.$shipment->hbn.' send RTS notice to'.$org->name, 'rts_notice');

						// update wmstask flag
						if (preg_match('/^T(\d{6,7})$/', $shipment->cref, $matches)) {
							$task = WmsTask::model()->findByPk($matches[1]);
						}
						if (empty($task)) {
							$task = WmsTask::model()->with('deliveryTask')->find('JSON_QUERY(deliveryTask.meta, "$.shipment_id") LIKE "%' . $shipment->id . '%"');
						}
						if (!empty($task) && $task->job->org_id == $shipment->agent_id && !empty($task->deliveryTask->mdata['shipment_id']) && in_array($shipment->id, $task->deliveryTask->mdata['shipment_id'])) {
							$task->bwf |= 128;
							$task->update('bwf');
						}
					}
				}
			}
		}
	}

	public function sendRtsRemindNotice()
	{
		$rs = ImParcel::model()->findAll('status = 80');

		$org_shipments = [];
		$endDate = new DateTime(date('Y-m-d'), new DateTimeZone('Australia/Sydney'));
		foreach ($rs as $p) {
			if (empty($p->mdata['rts_scan_date'])) {
				continue;
			}

			$startDate = new DateTime($p->mdata['rts_scan_date'], new DateTimeZone('Australia/Sydney'));
			if (in_array($startDate->diff($endDate)->days / 7, [1,2,3])) {
				$org_shipments[$p->agent_id][$startDate->diff($endDate)->days][] = $p;
			}
		}

		foreach ($org_shipments as $oid => $day_shipments) {
			$emailLog = new Emailog();
			$emailLog->type = Emailog::RTS_RETURN_NOTICE;
			$emailLog->fid = current($day_shipments)[0]->id;
			$emailLog->dt = date('Y-m-d H:i:s');
			$emailLog->to_id = $oid;
			$emailLog->status = 10;

			$emailLog->prepTemplate();

			$note = '';
			foreach ($day_shipments as $days => $shipments) {
				$note .= '<p>The following parcels have been returned to our warehouse for ' . $days . ' days. 以下快递退回我司已满' . $days . '天。</p>
					<table cellpadding="5" width="400" cellspacing="0">
					<thead><tr><th>Connote</th><th>Cust Ref</th><th>Tracking No.</th></tr></thead>
					<tbody>';
				foreach ($shipments as $shipment) {
					$note .= '<tr><td>' . $shipment->hbn . ' </td><td>' . $shipment->cref . ' </td><td>' . (empty($shipment->ref) ? $shipment->hbn : $shipment->ref) . ' </td></tr>';
				}
				$note .= '</tbody></table>';
			}
			$note .= '<p>Please note that any parcel has been returned for more than 30 days will be discarded. 请注意退回我司满30个自然日之后将会自动作弃件处理。</p>';

			$emailLog->tpl->assignThese([
				'SHIPMENT_RETURN' => $note,
			]);
			$emailLog->subject = $emailLog->tpl->subject;
			$emailLog->body = $emailLog->tpl->getContent();
			$org = Org::model()->findByPk($oid);
			if (!empty($org->extra['outturn_email'])) {
				$emailLog->mdata['to'] = $org->extra['outturn_email'];
				if (!empty($org->extra['goods-return-rec'])) $emailLog->mdata['to'] = $org->extra['goods-return-rec'];
				$emailLog->mdata['from'] = 'imports@toplogistics.com.au';
				$emailLog->mdata['fromName'] = 'TLA Imports';
				$emailLog->mdata['cc'] = 'importscs@toplogistics.com.au';
				if (current($day_shipments)[0]->is3PL()) {
					$emailLog->mdata['from'] = '3pl@toplogistics.com.au';
					$emailLog->mdata['fromName'] = 'TLA 3PL';
				}
				$o = $emailLog->sendEmail();
				if ($o['status']) {
					foreach ($shipments as $shipment) {
						$shipment->cbwf = $shipment->cbwf & 256 ^ $shipment->cbwf;
						$shipment->update('cbwf');
						Log::log2file($shipment->ref . '=>' . $shipment->hbn . ' send RTS notice to' . $org->name, 'rts_notice');
					}
				}
			}
		}
	}

	public function checkScanFinish()
	{
		$rs=ConsolProcess::model()->findAll('status=:status', [':status'=> ConsolProcess::STATE_WAITING_WH_SCAN]);
		if (!empty($rs)) {
			foreach ($rs as $process) {
				$consol= ImcoConsol::model()->findByPk($process->fid);
				if (!empty($consol)&&$consol->totLeftPacks()<=0) {
					$process->updateStatus(ConsolProcess::STATE_WAITING_AIR_MANI);
				}
			}
		}
	}
	/*this function is used to check the DDP HV  org have  enough credit to pay the invoice,
	* if it have enough money, we will change the process status to PaymentReceived.
	* if(duty-held) change shipment status to clear-wait;
	*
	*/
	public function checkDdpPaymentPass()
	{
		$processes=ShipmentProcess::model()->findAll('status=:status', [':status'=> ShipmentProcess::INFROM_CUSTOMER_PAY]);
		foreach ($processes as $process) {
			$shipment= ImParcel::model()->findByPk($process->pid);
			if (($shipment->bwf&ImParcel::CUSTOM_DDP)>0) {
				//change the process status to Inform_customer_pay
				//change the status_to wait-clear when duty-held
				$org= Org::model()->findByPk($shipment->agent_id);
				$inv= Invoice::model()->find('pid=:pid AND type=41', [':pid'=>$shipment->id]);
				if (!empty($inv)&&$inv->total>0) {
					if ($inv->total<$org->getCurrentCreditLeft()) {
						$process->custom_log_note='DDP Agent have enough Credit';
						$process->changeStatus(ShipmentProcess::CONFIRM_PAYMENT);
						if ($shipment->status==57) {//duty held,so we change the status to wait-clear
//                           $shipment->status=58;
//                           $shipment->update('status');
						}
					}
				}
			}
		}
	}

	public function sendInvoiceNotPaidNotice()
	{
		if (date('d')=='06'||date('d')=='21') {
			$end=(date('d')<16?(date('Y-m', strtotime("-1 month")).'-'.date('t', strtotime('last month'))):date('Y-m-15'));
			$sql='SELECT to_id FROM `invoice` where status in(2,3,7) AND date<="'.$end.'" group by to_id;';
			$rs=Yii::app()->db->createCommand($sql)->queryAll();
			$orgIds=[];
			foreach ($rs as $r) {
				$orgIds[]=$r['to_id'];
			}
			foreach ($orgIds as $oid) {
				$org=Org::model()->findByPk($oid);
				if (empty($org->extra['credit_payment_method'])) {
					continue;
				}
				if ((!empty($org->extra['invoice_warning_send_time'])&&(ceil((time()-$org->extra['invoice_warning_send_time'])/86400)>1))||empty($org->extra['invoice_warning_send_time'])) {
					$this->doSendInvoiceWarning($org);
				}
			}
		}
	}

	public function doSendInvoiceWarning($org)
	{
		$oid= $org->id;
		$emailLog=new Emailog();
		$emailLog->type= Emailog::INVOICE_NOT_PAID_NOTICE;
		$emailLog->status=10;
		$emailLog->to_id=$oid;
		$emailLog->dt = date('Y-m-d H:i:s');
		$emailLog->prepTemplate();
		$emailLog->subject = $emailLog->tpl->subject;
		$emailLog->body = $emailLog->tpl->getContent();
		$cc="";
		if (!empty($org->extra['op_email'])) {
			$cc.=$org->extra['op_email'];
		}
		$emailLog->mdata['from']="imports@toplogistics.com.au";
		$emailLog->mdata['fromName']='TLA Imports';
		$emailLog->mdata['to']=trim($org->extra['client_billing_email']);
		$emailLog->mdata['cc']=$cc;
		$o=$emailLog->sendEmail();
		if ($o['status']) {
			Log::log2file($org->id." : ".$org->name.implode(" ", $o), 'invoice_warning_send', 'account');
			$org->extra['invoice_warning_send_time']=time();
			$org->updateMeta();
		}
	}


	public function sendInvoiceStatmentHalfMonth()
	{
		if (date('d') == '01' || date('d') == '16') {
			$end = (date('d') < 16 ? (date('Y-m', strtotime("-1 month")) . '-' . date('t', strtotime('last month'))) : date('Y-m-15'));
			$sql = 'SELECT to_id FROM `invoice` where status in(2,3,7) AND date<="' . $end . '" group by to_id;';
			$rs = Yii::app()->db->createCommand($sql)->queryAll();
			$orgIds = [];
			foreach ($rs as $r) {
				$orgIds[] = $r['to_id'];
			}
			foreach ($orgIds as $oid) {
				$org = Org::model()->findByPk($oid);
				if (empty($org->extra['credit_payment_method'])) {
					continue;
				}
				if ((!empty($org->extra['invoice_statement_send_time']) && (ceil((time() - $org->extra['invoice_statement_send_time']) / 86400) > 1)) || empty($org->extra['invoice_statement_send_time'])) {
					$this->doSendStatement($org);
				}
			}
		}
	}

	public function doSendStatement($org)
	{
		$oid= $org->id;
		$file=Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR.'zip'.time();
		if (!file_exists($file)) {
			mkdir($file);
		}
		$org=Org::model()->findByPk($oid);
		$files=[];
		$csv=[];
		if (isset($org->extra['credit_payment_method'])&&$org->extra['credit_payment_method']==1) {
			$start=(date('d')<16?date('Y-m-16', strtotime("-1 month")):date('Y-m-01'));
			$end=(date('d')<16?(date('Y-m', strtotime("-1 month")).'-'.date('t', strtotime('last month'))):date('Y-m-15'));
			$csv[]='Unpaid Inovice Summary before '.$end;
			$csv[]='';
			$csv[]='Unpaid Invoices from '.$start.' To '.$end;
			$csv[]='Invoice,Date,Status,amount,paid,credit,unpaid';
			$invoices= Invoice::model()->findAll('to_id=:org_id AND date<=:end AND date>=:start AND status IN(2,3,7) ORDER BY date', [':org_id'=>$oid,':end'=>$end,':start'=>$start]);
			$total=0;
			$subTotal1=0;
			foreach ($invoices as $inv) {
				$csv[]=$inv->no.','.$inv->date.','.$inv->getStatus().','.$inv->total.','.$inv->realPaid().','.$inv->getCredit().','.$inv->getBalance();
				$subTotal1+=$inv->getBalance();
			}
			$csv[]='subTotal,,,,,,'.$subTotal1;
			$csv[]='';
			$csv[]='';
			$subTotal2=0;
			$csv[]='Unpaid Invoices before '.$start;
			$invoices= Invoice::model()->findAll('to_id=:org_id AND date<:start AND status IN(2,3,7) ORDER BY date', [':org_id'=>$oid,':start'=>$start]);
			foreach ($invoices as $inv) {
				$csv[]=$inv->no.','.$inv->date.','.$inv->getStatus().','.$inv->total.','.$inv->realPaid().','.$inv->getCredit().','.$inv->getBalance();
				$subTotal2+=$inv->getBalance();
			}
			$csv[]='subTotal,,,,,,'.$subTotal2;
			$total=$subTotal1+$subTotal2;
			$csv[]='Total,,,,,,'.$total;
		}
		$fileName=$file.DIRECTORY_SEPARATOR.$org->name.'_'.date('Y-m-d').'_invoice_statment.csv';
		file_put_contents($fileName, implode("\n", $csv));
		$files[]=[$fileName, basename($fileName)];
		$this->genStatement($oid, $end, $file, $files);
		$emailLog=new Emailog();
		$emailLog->type= Emailog::INVOICE_STATEMENT;
		$emailLog->status=10;
		$emailLog->to_id=$oid;
		$emailLog->dt = date('Y-m-d H:i:s');
		$emailLog->prepTemplate();
		$emailLog->subject = $emailLog->tpl->subject;
		$emailLog->body = $emailLog->tpl->getContent();
		$cc="imports@toplogistics.com.au";
		if (!empty($org->extra['op_email'])) {
			$cc.=$org->extra['op_email'];
		}
		$emailLog->mdata['from']="imports@toplogistics.com.au";
		$emailLog->mdata['fromName']='TOP Logistics';
		$emailLog->mdata['to']=trim($org->extra['client_billing_email']);
		$emailLog->mdata['cc']=$cc;
		$o=$emailLog->sendEmail($files);
		if ($o['status']) {
			Log::log2file($org->id." : ".$org->name.implode(" ", $o), 'invoice_statment_half_monthly', 'account');
			$org->extra['invoice_statement_send_time']=time();
			$org->updateMeta();
		}
		AppHelper::unlinkRecursive($file);
	}
		
	private function genStatement($oid, $end, $td, &$files)
	{
		$model=new Invoice('search');
		$model->unsetAttributes();
		$ec = new CDbCriteria;
		$ec->condition = "status IN (2,3,7) AND to_id=".$oid;
		$ec->condition .= " AND date <= '" . $end . "'";
		$dp = $model->search(false, 0, 't.due ASC', $ec);
		$invgroup=[];
		foreach ($dp->data as $r) {
			$invgroup[]=$r;
		}
		if (!empty($invgroup)) {
			$ps = [];
			$tf = tempnam($td, "stmt");
			oPDF::renderPDF('statement', ['invs'=>$invgroup, 'ata' => 0,'ps' => Payment::orgAtaDetails($oid)], 2, $tf);
			$ps[] = $tf;
			foreach ($invgroup as $r) {
				$tf = tempnam($td, "stmt");
				oPDF::renderPDF('invoice', ['inv'=>$r], 2, $tf);
				$ps[] = $tf;
				if ($r->type == 60) {
					$tf2 = tempnam($td, "stmt");
					oPDF::renderPDF('invoice_detail', ['inv'=>$r], 2, $tf2);
					$ps[] = $tf2;
				}
			}
			$pdf_file=$td.DIRECTORY_SEPARATOR.'invoice_statement_'.$oid.'.pdf';
			oPDF::mergePDF($ps, 2, true, $pdf_file);
			$files[]=[$pdf_file, basename($pdf_file)];
		}
		//excel
		$xls = new oExcel;
		$i = 1;
		$rs = Invoice::model()->findAll(['condition' => 'id in (select distinct id from invoice where (id in (select inv_id from pay_inv pi join payment p on pi.pay_id = p.id '
					. 'where p.org_id = :org_id and p.date > :date) or (to_id = :org_id and status in (2,3,7))) '
					. ' and date <= :date order by due asc, id asc)', 'params' => [':org_id' => $oid, ':date' => $end], 'order' => 'due asc, id asc']);
		$cus = [];
		foreach ($rs as $r) {
			$cus[] = $r;
		}
		$xls->addRow($i++, [$oid, $cus[0]->cust->name]);
		$xls->addRow($i, ['No', 'Type','AWB', 'Date', 'Due', 'Total', 'Paid', 'Balance']);
		$xls->setFont('A'.$i.':H'.$i, ['bold' => true]);
		$i++;
		$tot = [0,0,0];
		foreach ($cus as $r) {
			$paid = $r->paidBefore($end);
			if ($r->type == 10) { // for import invoice
				$awb = '';
				if (!empty($r->mdata['awb'])) {
					$awb = $r->mdata['awb'];
				}
				if (isset($r->lines[0]) && isset($r->lines[0]->mdata['items'])) {
					foreach ($r->lines[0]->mdata['items'] as $si => $ri) {
						// $awb = $ri[0];
						break;
					}
				}
				$xls->addRow($i++, [$r->no, $r->getType(),$awb, $r->date, ($r->type != 100 ? $r->due : $r->posted), AppHelper::money_format('%i', $r->total), AppHelper::money_format('%i', $paid), AppHelper::money_format('%i', $r->total - $paid)]);
			} else {
				$awb='';
				if (!empty($r->mdata['awb'])) {
					$awb = $r->mdata['awb'];
				}
				if (empty($awb)&&$r->type==40&&!empty($r->consol_id)) {
					$consol= Consol::model()->find("id=:id", [':id'=>$r->consol_id]);
					if (!empty($consol)) {
						$awb=$consol->no;
					}
				}
				$xls->addRow($i++, [$r->no, $r->getType(),$awb, $r->date, $r->due, AppHelper::money_format('%i', $r->total), AppHelper::money_format('%i', $paid), AppHelper::money_format('%i', $r->total - $paid)]);
			}
			$tot[0] += $r->total;
			$tot[1] += $paid;
			$tot[2] += $r->total - $paid;
		}
	
		$xls->addRow($i++, ['', '', '','', 'Total:', AppHelper::money_format('%i', $tot[0]), AppHelper::money_format('%i', $tot[1]), AppHelper::money_format('%i', $tot[2])]);
		$xls->addRow($i++, []);
		foreach ($cus as $r) {
			$awb_to=[];
			if (!empty($r->mdata['awb'])) {
				$awb_to = ['MAWB',$r->mdata['awb']];
			} elseif ($r->type==40&&!empty($r->consol_id)) {
				$consol= Consol::model()->find("id=:id", [':id'=>$r->consol_id]);
				if (!empty($consol)) {
					$awb_to= ['MAWB',$consol->no];
				}
			}
			$xls->addRow($i++, array_merge([$r->no, $r->date], $awb_to));
			if ($r->type != 100 && $r->type != 50) {
				$xls->addRow($i, ['HBN', 'Shipper', 'Packages', 'Weight', 'Type', 'Rate', 'Amount']);
				$xls->setFont('A'.$i.':G'.$i, ['bold' => true]);
				$i++;
				$qty = 0;
				$wei = 0;
				$cbm = 0;
				$tot = 0;
				foreach ($r->lines as $il) {
					if ($r->type==40) {
						$xls->addRow($i++, [$il->det, $il->ccode, $il->qty, '', '', '', ($il->amount - $il->gst) * $il->qty]);
						$tot += ($il->amount - $il->gst) * $il->qty;
						$qty+=$il->qty;
					} else {
						if (empty($il->mdata['items'])) {
							continue;
						}
						foreach ($il->mdata['items'] as $si=>$ri) {
							// import has different data format with export invoice
							if ($r->type == 10) { // for import invoice
									$charge_wei=round(empty($ri[9])?$ri[3]:$ri[9], 2);
								if (preg_match('/LET\d{7}/i', $ri[0])) {
									$p= ImParcel::model()->find('ref=:ref', [':ref'=>$ri[0]]);
									if (!empty($p)) {
										$ri[0].='('.$p->hbn.')';
									}
								}
								$xls->addRow($i++, [$ri[0], $ri[1], 1, $charge_wei, '', '', $ri[5]]);
								$tot += floatval($ri[5]);
								$qty ++;
								$wei += $charge_wei;
							} elseif ($r->type==37) {//rts invoice
								$shipment= Shipment::model()->find('hbn=:hbn', [':hbn'=>trim($ri[0])]);
								if (!empty($shipment)) {
									$ri[3]=$shipment->ref;
									if (!empty($shipment->mdata['rts_org_no'])) {
										$shipment_orig= Shipment::model()->find('hbn=:hbn', [':hbn'=>trim($shipment->mdata['rts_org_no'])]);
										if (isset($shipment_orig)) {
											$ri[3].='//'.$shipment_orig->ref;
										}
									}
								}
								$xls->addRow($i++, [$ri[0].'('.$ri[3].')', $ri[1], 1, '', '', '', $ri[2]]);
								$wei +=0;
								$qty ++;
								$tot += floatval($ri[2]);
							} elseif ($r->type==36) { // for rts scan fee
								$xls->addRow($i++, [$ri[0], $ri[1], 1, '', $ri[3], $ri[2], isset($ri[4])?$ri[4]:'']);
								$tot += isset($ri[4])?floatval($ri[4]):0;
								$qty ++;
								$wei += 0;
							} elseif ($r->type==60) {
								$xls->addRow($i++, ['Storage',$ri[0],$ri[1],$ri[2],'','',$ri[2]*$ri[3]]);
								$tot+= floatval($ri[2])*floatval($ri[3]);
							} else { // for export invoice
								$xls->addRow($i++, [$ri[0], $ri[1], 1, $ri[2], $ri[4].'('.(empty($ri[5])? '' : $ri[5]).')', isset($ri[6])?$ri[6]:'', isset($ri[7])?$ri[7]:'']);
								$tot += isset($ri[7])?floatval($ri[7]):0;
								$qty ++;
								$wei += floatval($ri[2]);
							}
						}
					}
				}
				$xls->addRow($i, ['', 'Total:', $qty, $wei, '', '', $tot]);
				$xls->setFont('A'.$i.':G'.$i, ['bold' => true]);
				$i++;
				$xls->addRow($i++, []);
			} elseif ($r->type == 100) {
				$xls->addRow($i, ['HBN', 'Description', 'Unit Price', 'Qty', 'Amount']);
				$xls->setFont('A'.$i.':E'.$i, ['bold' => true]);
				$i++;
				$description = '';
				$qty = 0;
				$tot = 0;
				foreach ($r->lines as $il) {
					if (empty($il->mdata['items'])) {
						continue;
					}
					foreach ($il->mdata['items'] as $si => $ri) {
						$xls->addRow($i++, [$ri[0], $ri[3], $ri[4], $ri[5], $ri[6]]);
						$qty += intval($ri[5]);
						$tot += floatval($ri[6]);
					}
				}
				$xls->addRow($i, ['', 'Total:', '', $qty, $tot]);
				$xls->setFont('A'.$i.':E'.$i, ['bold' => true]);
				$i++;
				$xls->addRow($i++, []);
			} elseif ($r->type == 50) {
				$xls->addRow($i, ['Desc', 'GLCode', 'Qty', 'Price', 'Subtotal', 'Gst', 'Total']);
				$xls->setFont('A'.$i.':G'.$i, ['bold' => true]);
				$i++;
				$qty = 0;
				$tot = 0;
				foreach ($r->lines as $il) {
					$xls->addRow($i++, [$il->det, $il->ccode, $il->qty, $il->amount, ($il->amount - $il->gst) * $il->qty, $il->gst * $il->qty, $il->amount * $il->amount]);
					$tot += ($il->amount - $il->gst) * $il->qty;
					$qty+=$il->qty;
				}
				$xls->addRow($i, ['', 'Total:', $qty, '', '', '', $tot]);
				$xls->setFont('A'.$i.':G'.$i, ['bold' => true]);
				$i++;
				$xls->addRow($i++, []);
			}
		}
		$file_execel=$td.DIRECTORY_SEPARATOR.'invoie_statement_'.$oid.'.xlsx';
		$xls->output($file_execel, false, false);
		$files[]=[$file_execel, basename($file_execel)];
	}
		


	public function sendHeldShipmentsReport()
	{
		$file=Yii::app()->basePath.DIRECTORY_SEPARATOR."runtime".DIRECTORY_SEPARATOR.'zip'.time();
		if (!file_exists($file)) {
			mkdir($file);
		}
		$sql='SELECT agent_id FROM `shipment` WHERE type=10 AND status=55 GROUP BY agent_id';
		$rs=Yii::app()->db->createCommand($sql)->queryAll();
		foreach ($rs as $r) {
			if (!in_array($r['agent_id'], [838,1002,1222,1427,1316,1303,1436,1484])) {
				continue;
			}
			$shipments= ImParcel::model()->findAll('agent_id=:agent_id AND status=55 AND type=10', [':agent_id'=>$r['agent_id']]);
			$org=Org::model()->findByPk($r['agent_id']);
			$files=[];
			$csv=[];
			$csv[]=date('Y-m-d').' Shipments Held information,Agent:,'.$org->name;
			$csv[]='';
			$csv[]='tracking No,cust Ref,Hbn,awb,Held Reason,ETA,value,packs';
			foreach ($shipments as $p) {
				if (preg_match("/DW\d{8}/i", $p->hbn)) {
					continue;
				}
				$csv[]=$p->ref.','.$p->cref.','.$p->hbn.','.(!empty($p->consol->awb)?$p->consol->awb:'').','.$p->getHeldReasons().','.(!empty($p->consol->eta)?$p->consol->eta:'').','.$p->dvalue.','.$p->pkg;
			}
			$fileName=$file.DIRECTORY_SEPARATOR.$org->name.'_'.date('Y-m-d').'_held_report.csv';
			file_put_contents($fileName, "\xEF\xBB\xBF".implode("\n", $csv));
			$files[]=[$fileName, basename($fileNamFe)];
			$emailLog=new Emailog();
			$emailLog->type= Emailog::HIGH_VALUE_NOTICE;
			$emailLog->status=10;
			$emailLog->to_id=$r['agent_id'];
			$org = Org::model()->findByPk($r['agent_id']);
			$emailLog->dt = date('Y-m-d H:i:s');
			$emailLog->prepTemplate();
			$emailLog->subject = $emailLog->tpl->subject;
			$emailLog->body = $emailLog->tpl->getContent();
			$emailLog->mdata['from']='imports@toplogistics.com.au';
			$emailLog->mdata['fromName']='TLA Imports';
			$emailLog->mdata['to']=$org->extra['outturn_email'];
			$emailLog->mdata['cc']='imports@toplogistics.com.au';
			$o=$emailLog->sendEmail($files);
			// Log::log2file($org->id." : ".$org->name.implode(" ", $o), 'held_reason_email', 'customs');
		}
		AppHelper::unlinkRecursive($file);
	}

	public function genIDPhoto()
	{
		//462 //1274 Ugg
		$rs = ExParcel::model()->with('cnee')->findAll('agent_id IN (462,482,1274) AND cnee.cnid_id = 0 AND cnee.cnid_no != "" AND status IN (12, 15)');
		$nos = [];
		foreach ($rs as $p) {
			$gen = false;
			switch ($p->agent_id) {
				case 462:
				case 482:
					$gen = true;
				break;
				case 1274:
					$gm = implode('', $p->eitems['g']);
					if ($p->goodsType() == 'O' && preg_match('/UGG|鞋|靴|围巾|Scarf/i', $gm)) {
						$gen = true;
					}
				break;
			}
			if ($gen) {
				$nos[strtoupper($p->cnee->cnid_no)] = $p;
			}
		}
		$invalids = [];
		foreach (file(Yii::app()->basePath.DIRECTORY_SEPARATOR.'data/invalid_id.bsv') as $l) {
			$r = explode('|', trim($l));
			$invalids[$r[1]] = $r[0];
		}

		$errs = [];

		foreach ($nos as $no => $p) {
			if (isset($invalids[$no]) && $invalids[$no] == $p->cnee->name) {
				if ($this->debug) {
					echo $p->agent_id,'|',$p->hbn,'|',$p->cnee->name, '|', $no,'|does not match', PHP_EOL;
				}
				$errs[$p->agent_id][] = $p->hbn.'|'.$p->cnee->name. '|'. $no;
				continue;
			}
			$cnid = new CnID;
			$cnid->no = $no;
			$cnid->name = trim($p->cnee->name);
			if ($cnid->genPhoto()) {
				if ($this->debug) {
					echo $p->cnee->name, '|', $no,' done', PHP_EOL;
				}
			} else {
				if ($this->debug) {
					echo $p->agent_id,'|',$p->hbn,'|',$p->cnee->name, '|', $no,'|does not match', PHP_EOL;
				}
				if ($p->agent_id == 482) {
					$p->agent_id = 462;
				}
				$errs[$p->agent_id][] = $p->hbn.'|'.$p->cnee->name. '|'. $no;
			}
		}

		if (!empty($errs[462])) {
			$msg = '';
			foreach ($errs[462] as $e) {
				$msg .= $e.'<br />'.PHP_EOL;
			}
			include_once('PHPMailer/class.phpmailer.php');
			$mail = new PHPMailer();
			$mail->CharSet = 'UTF-8';
			$mail->IsHTML(true);
			$mail->From     = 'nero@toplogistics.com.au';
			$mail->FromName = 'Customer Service';
			$mail->Subject  = '身份证匹配问题';
			$mail->Body = $msg;
			$addrs = [
				'caohaiming@juyouaopin.com',
				'panqi@juyouaopin.com',
				'liwei@juyouaopin.com',
				'gina@juyouaopin.com',
				'zjmark1989@gmail.com',
			];
			foreach ($addrs as $add) {
				$mail->AddAddress($add);
			}
			$mail->AddBCC('test@orite.com');
			$mail->Send();
		}

		if ($this->debug) {
			echo 'Done', PHP_EOL;
		}
	}

	public function invoiceStatusToOverdue()
	{
		$rs= Invoice::model()->findAll(['condition'=>'status=2 AND due<CURDATE() AND date>"2018-05-01"']);
		foreach ($rs as $invoice) {
			$invoice->status=3;
			$invoice->update('status');
		}
	}
		
	public function checkSubAcrReturned()
	{
		$processes=ConsolProcess::model()->findAll('main_type=1 AND type=0 AND status=4');
		if (!empty($processes)) {
			foreach ($processes as $pro) {
				if (isset($pro->consol->mdata['acr_stat'])&&$pro->consol->mdata['acr_stat']==1) {
					$pro->consol->mdata['acr_stat']=5;
					$pro->consol->updateMeta();
				}
			}
		}
	}

