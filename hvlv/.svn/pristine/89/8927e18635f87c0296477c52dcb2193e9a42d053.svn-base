	public function autoCreateCargoProcessJob(){
		$weekarray=array('Sunday', 'Monday', 'Tuesday', 'Wednesday','Thursday','Friday', 'Saturday');
		$cdls = CargoProcessJob::$cargoDirectionList;
		$arrayDirection = CargoProcessJob::$arrayDirectionSchedules;
		$arrayVechicle = CargoProcessJob::$arrayVechicleSchedules;
		$arrayTime = CargoProcessJob::$cargoTimes;
		$arratDistance = CargoProcessJob::$arrayDirectionDistance;
		$arrayDriver = CargoProcessJob::$arrayDriverSchedules;
		$limitDate = 3;
		for($i=1;$i<=$limitDate;$i++){
			$dateCreated = date('Y-m-d',strtotime("".$i." day"));
			if(HolidayHelper::checkDateIsHoliday($dateCreated)){
				$limitDate++;
				continue;
			}
			$numWeekday=date("w",strtotime($dateCreated));
			if($numWeekday!=0 && $numWeekday!=6){
				$objCPJmodel = CargoProcessJob::model()->findAllBySql('select * from cargo_process_job where job_name like "%Auto%" and dpt_id = 106 and status = 30 and  datediff(created,"'.$dateCreated.'") = 0');
				if(empty($objCPJmodel)){
					foreach($arrayTime as $k=>$time){
						foreach($arrayVechicle as $vK => $vID){
							$vehicle = CargoProcessVehicle::model()->findByPk($vID);
							$directiondescription ="";
							$model = new CargoProcessJob();
							$model->job_name = $dateCreated." ".$vehicle->vehicle_name." Auto";
							$model->vehicle_id = $vID[0];
							foreach ($arrayDirection[$numWeekday.$k.$vK] as $direction){
								$model->mdata[$cdls[$direction]] = 1;
								$directiondescription .= $cdls[$direction]." ";
							}
							$model->mdata['time']=$k;
							$model->mdata['distance']=$arratDistance[$numWeekday.$k.$vK][0];
							$model->status = CargoProcessJob::STATE_WAITING_WAREHOUSE_PREPARATION;
							$model->dpt_id = 106;
							$model->description = $weekarray[$numWeekday]." ".$time." ".$directiondescription;
							$model->created = $dateCreated;
							$model->driver_id = $arrayDriver[$numWeekday.$k.$vK][0];
							$model->user_id = 0;
							$model->type = 1;
							$model->save();
							if (empty($model->job_no)) {
								$model->job_no = $model->genNo();
								$model->update(['job_no']);
							}
						}
					}
				}
			}else{
				$limitDate++;
			}
		}
	}

