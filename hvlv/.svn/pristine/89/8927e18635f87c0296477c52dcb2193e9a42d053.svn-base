	public function syncEbayOrder(){
		$model = new EbayAPI();
		
		$objorders = $model->getOrderInformation();

		$transaction = Yii::app()->db->beginTransaction();
		try {
			if ($objorders->getTotal() > 0) {
				$this->_syncEbayOrder($objorders->getOrders(),$model);
			}
			$transaction->commit();
		} catch (Exception $ex) {
			$transaction->rollback();
			$this->log('Sync Shopify order fail');
			throw $ex;
		}
		
	}

	public function _syncEbayOrder($orders,$ebay){
		$errors = [];
		foreach ($orders as $order) {
			$order->getOrderFulfillmentStatus();
			if($order->getOrderFulfillmentStatus()=='FULFILLED'){
				continue;
			}
			if ($order->getOrderPaymentStatus() != 'PAID') {
				continue;
			}

			$orderId = $order->getOrderId();
			$name = $order->getFulfillmentStartInstructions()[0]->getShippingStep()->getShipTo()->getFullName();
			$phone = $order->getFulfillmentStartInstructions()[0]->getShippingStep()->getShipTo()->getPrimaryPhone()->getPhoneNumber();
			$addressLine1 = $order->getFulfillmentStartInstructions()[0]->getShippingStep()->getShipTo()->getContactAddress()->getAddressLine1();
			$addressLine2 = $order->getFulfillmentStartInstructions()[0]->getShippingStep()->getShipTo()->getContactAddress()->getAddressLine2();
			$city = $order->getFulfillmentStartInstructions()[0]->getShippingStep()->getShipTo()->getContactAddress()->getCity();
			$state = $order->getFulfillmentStartInstructions()[0]->getShippingStep()->getShipTo()->getContactAddress()->getStateOrProvince();
			$county = $order->getFulfillmentStartInstructions()[0]->getShippingStep()->getShipTo()->getContactAddress()->getCountryCode();
			$postalCode = $order->getFulfillmentStartInstructions()[0]->getShippingStep()->getShipTo()->getContactAddress()->getPostalCode();
			$stateOrProvince = $order->getFulfillmentStartInstructions()[0]->getShippingStep()->getShipTo()->getContactAddress()->getStateOrProvince();

			$task_map = WmsTaskMap::model()->find('fid = :fid AND platform = "ebay"', [':fid' => $orderId]);

			if (empty($task_map)) {
				$job = WmsJob::model()->find('org_id=:oid AND type = 20 and week(`created`,1)=:week', array(':oid' => $ebay->org_id, ':week' => intval(date('W'))));
				//$job = WmsJob::model()->find(['condition' => 'org_id = :org_id AND type = 30 AND week(`created`, 1) = :week', 'params' => [':org_id' => $shopify->org_id, ':week' => intval(date('W'))], 'order' => 'id desc']);
				if (empty($job)) {
					$job = new WmsJob;
					$job->org_id = $ebay->org_id;
					$job->type = 20;
					$job->status = 10;
					$job->ref = '3PL_' . date('Y-m-d');
					$job->dpt_id = 106;
					if ($ebay->org_id == Org::ORGID_3PL_SUBEMO) {
						$job->dpt_id = 106;
					}
					$job->save();
				}
				if ($job->getErrors()) {
					foreach ($job->getErrors() as $error) {
						$this->shopifyLog($error[0]);
						$errors[] = $error[0];
					}
				}

				// Create pick&pack task
				$task_errors = [];
				$task = new WmsTask;
				$task->job_id = $job->id;
				$task->type = 3030;
				$task->is_request = 1;
				$task->op_id = 0;
				$task->status = 20;
				$task->bwf = 256;
				$task->dpt_id = $job->dpt_id;
				$task->schd_time = date("Y-m-d H:i:s");
				$task->ref = 'Ebay ' . $name . ' ' .  $postalCode;
				$prods = [];
				$backorder = false;
				$not_exist = [];

				foreach ($order->getLineItems() as $item) {
					$prod = null;
					// Get prod
					$prodSku=$item->getSku();
					//$prodSku='6945372102386';
					$prodTitle = $item->getTitle();
					$prodQty=$item->getQuantity();
					$prodLineItemId=$item->getLineItemId();

					if (!empty($prodSku)){
						$prod = WmsProd::model()->find('ean = :ean AND status = 1', [':ean' => $prodSku]);
					}

					if (empty($prod)) {
						$task_errors[] = $prodTitle .' '. $prodSku .' ' . $orderId . ' does not exist in TLA';
						continue;
					}

					if (empty($prods[$prod->id])) $prods[$prod->id] = 0;
						if ($prod->type != WmsProd::WMS_PROD_KIT) {
							$prods[$prod->id] += $prodQty;
						}
				}

				$items = [];
				foreach ($prods as $prod_id => $qty) {
					$temp_qty = $qty;
					// Get stocks
					$stocks = WmsStock::model()->findAll('prod_id = :prod_id AND org_id = :org_id AND dpt_id = 106 AND qty - qty_res > 0', [':prod_id' => $prod_id, ':org_id' => $ebay->org_id]);
					if(empty($stocks)){
						$backorder = false;
						$task_errors[] = $prod->name . ' in ' . $orderId . ' quantity is less than ' . $temp_qty . ', only ' . (intval($temp_qty) - intval($qty)) . '.';
					}
					foreach ($stocks as $stock) {
						if ($qty > 0) {
							$items[] = [
								'si' => $stock->id,
								'sn' => $stock->prod->name,
								'pq' => '',
								'cq' => '',
								'uq' => min($qty, $stock->availQty()),
								'pli' => '',
								'pl' => '',
								'nt' => $prodLineItemId,
							];
							$qty -= min($qty, $stock->availQty());
						} else {
							break;
						}
					}

					$prod = WmsProd::model()->findByPk($prod_id);

					if ($qty > 0) {
						$task_errors[] = $prod->name . ' in ' . $orderId . ' quantity is less than ' . $temp_qty . ', only ' . (intval($temp_qty) - intval($qty)) . '.';

						$stock = WmsStock::model()->find('prod_id = :prod_id AND org_id = :org_id AND dpt_id = 106', [':prod_id' => $prod_id, ':org_id' => $ebay->org_id]);
						$items[] = [
							'si' => $stock->id,
							'sn' => $stock->prod->name,
							'pq' => '',
							'cq' => '',
							'uq' => $qty,
							'pli' => '',
							'pl' => '',
							'nt' => $prodLineItemId,
						];
						$backorder = false;
					}						
					if (!empty($not_exist)) {
						foreach ($not_exist as $name => $qty) {
							$items[] = [
								'si' => '',
								'sn' => $name,
								'pq' => '',
								'cq' => '',
								'uq' => $qty,
								'pli' => '',
								'pl' => '',
								'nt' => $prodLineItemId,
							];
						}
					}
				}

				if ($task->getErrors()) {
					foreach ($task->getErrors() as $error) {
						$errors[] = $error[0];
					}
				}else {
					if (!empty($task_errors)) {
						foreach ($task_errors as $error) {
							$this->shopifyLog($error);
							$errors[] = $error;
						}
						if ($backorder) {
							$task->status = 10;
						} else {
							$task->status = 40;
						}
					}
					$task->mdata['note'] = implode('; ', $task_errors);
					$task->new_items = $items;
					if($task->save()){
						// Delivery
					$task->pickupTask->type = 2120;
					$delivery_task = $task->pickupTask;
					//$delivery_task->mdata['cnee']['company'] = "";
					$delivery_task->mdata['cnee']['name'] = @$name;
					$delivery_task->mdata['cnee']['tel'] = !empty(@$phone)? @$phone: "0423101775";
					$delivery_task->mdata['cnee']['address'] = @$addressLine1 . ' ' . @$addressLine2;
					$delivery_task->mdata['cnee']['city'] = @$city;
					$delivery_task->mdata['cnee']['suburb'] = @$city;
					$delivery_task->mdata['cnee']['state'] = Addr::checkAuState(@$state);
					$delivery_task->mdata['cnee']['postcode'] = @$postalCode;
					$delivery_task->mdata['cnee']['country'] = @$county;
					//$delivery_task->mdata['cnee']['email'] = "";

					$delivery_task->chooseCourier();
					$delivery_task->save();

					// Create task map
					$task_map = new WmsTaskMap;
					$task_map->fid = $orderId;
					$task_map->platform = 'ebay';
					$task_map->task_id = $task->id;
					$task_map->save();
					}
				}
			}
		}
	}




	public function freshPlCache()
	{
		Yii::import('application.controllers.ReportController');
		$cc = new ReportController('default');
		$dptIdArr = ["","all","106","218","530","811","2936"];
		$dateArr = [['2021-06-01','2021-06-30'],['2021-07-01','2021-07-31'],['2021-08-01','2021-08-31'],['2021-09-01','2021-09-30'],['2021-10-01','2021-10-31'],['2021-11-01','2021-11-30'],['2021-12-01','2021-12-31'],['2022-01-01','2022-01-31'],['2022-02-01','2022-02-28'],['2022-03-01','2022-03-31'],['2022-04-01','2022-04-30'],['2022-05-01','2022-05-31'],['2022-06-01','2022-06-30'],['2022-07-01','2022-07-31'],['2022-08-01','2022-08-31'],['2022-09-01','2022-09-30'],['2022-10-01','2022-10-31'],['2022-11-01','2022-11-30'],['2022-12-01','2022-12-31']];
		$dpmtArr = ["10"=>['csl'=>['grp1',''],'clt'=>['org_id', 'rev DESC'],'cor'=>['grp2', 'rev DESC']],"40"=>['clt'=>['org_id', 'grs DESC']],"50"=>['csl'=>['grp1',''],'clt'=>['org_id', 'rev DESC'],'cor'=>['grp2', 'rev DESC']]];

		foreach ($dptIdArr as $key1 => $dptId) {
			foreach ($dateArr as $key2 => $date) {
				$pt=[$dptId,$date[0],$date[1],""];
				if($pt[0]=='all')
				{
					$pt[0] = '';
					$cc->_plQuery($pt, '','dpt_id', '',true);
					continue;
				}
				$pt[4] = "";
				$cc->_plQuery($pt, '', 'dpmt', '',true);
				foreach ($dpmtArr as $key3 => $dpmt) {
					$pt[5] = "".$key3;
					foreach ($dpmt as $key4 => $ptValue) {
						$pt[6] = "".$key4;
						$cc->_plQuery($pt, '', $ptValue[0], $ptValue[1],true);
						echo "1";
					}
				}
			}
		}
	}

	public function autoCalculate3PLInvoice(){
		Yii::app()->name = 'TLA';
		//org id
		$orgs = [3817,3596,3820,3739,3841,3838,3832,3835,3898,3715];
		//$orgs = [3560];
		//dpt_id
		$dpts = [106,218];
		//Op user id
		$ops = [3424,3412];
		//from date
		$date_from = date('Y-m-d', strtotime('-2 sunday', time()));
		//to date
		$date_to = date('Y-m-d', strtotime('-1 saturday', time()));
		

		foreach($orgs as $org){
			$model = Org::model()->findByPk($org);
			foreach($dpts as $dpt_id){	
				$total_Error = [];
				$storageErrors = WmsInvoice::genWmsStorage($model, $date_from, $date_to,$dpt_id);
				if(!empty($storageErrors)){
					array_unshift($storageErrors,"WmsStorage Error".$org." ".$dpt_id." ".$date_from." to ".$date_to);
				}

				$serviceErrors = WmsInvoice::genWmsService($model, $date_from, $date_to,$dpt_id);
				if(!empty($serviceErrors)){
					array_unshift($serviceErrors,"WmsService Error".$org." ".$dpt_id." ".$date_from." to ".$date_to);
				}

				$total_Error = array_merge($storageErrors,$serviceErrors);
				if(!empty($total_Error)){
					foreach($ops as $op){
						//MessageService::createNewMessage(3237,$total_Error,3237);
						MessageService::createNewMessage($op,$total_Error);
					}
				}
			}
		}
	}

