	public function update_tranship()
	{
		 $org_id = Org::ORGID_COURIER_AUPOST;
		$ors = [];
		$or = OrgRate::model()->find('code = "FWSYD2020"');
		if (!empty($or)) $ors['FWSYD2020'] = $or;
		$or = OrgRate::model()->find('code = "FWSYD"');
		if (!empty($or)) $ors['FWSYD'] = $or;

		$or = OrgRate::model()->find('name = "StarTrack Road"');
		if (!empty($or)) $ors['StarTrack Road'] = $or;
		$or = OrgRate::model()->find('name = "StarTrack Mel"');
		if (!empty($or)) $ors['StarTrack Mel'] = $or;

		$or = OrgRate::model()->find('name = "TNT_TOP"');
		if (!empty($or)) $ors['TNT_TOP'] = $or;
		$or = OrgRate::model()->find('code = "TNT Melbourne_TOP"');
		if (!empty($or)) $ors['TNT Melbourne_TOP'] = $or;
		$or = OrgRate::model()->find('name = "TNT Brisbane_TOP"');
		if (!empty($or)) $ors['TNT Brisbane_TOP'] = $or;

		$or = OrgRate::model()->find('name = "TNT Perth_TOP"');
		if (!empty($or)) $ors['TNT Perth_TOP'] = $or;

		if (empty($org_id) || $org_id == Org::ORGID_COURIER_FASTWAY) {
			$ts = Tranship::model()->findAll('org_id = :org_id AND cost = 0 AND time >= "2019-01-01"', [':org_id' => Org::ORGID_COURIER_FASTWAY]);
			foreach ($ts as $t) {
				if (!empty($no) && ($t->id % 5 != $no)) continue;
				if (strtotime($t->time) >= strtotime('2020-07-01')) $rate_id = $ors['FWSYD2020']->id;
				else $rate_id = $ors['FWSYD']->id;
				if (empty($t->shipment)) {
					$sql = 'select weight from shipment_archive WHERE hbn = :n OR ref = :n';
					$weight = Yii::app()->db->createCommand($sql)->bindValues([':n' => $t->connote])->queryScalar();
				} else {
					$weight = $t->shipment->weight;
				}
				$t->cost = Shipment::getCourierCostByShipment($t->connote, $rate_id, $weight)['price'];
				$t->update('cost');
			}
		}

		if (empty($org_id) || $org_id == Org::ORGID_COURIER_AUPOST) {
			$ts = Tranship::model()->findAll('org_id = :org_id AND man_id != 0 AND time >= "2021-06-01"', [':org_id' => Org::ORGID_COURIER_AUPOST]);
			foreach ($ts as $t) {
				if (!empty($no) && ($t->id % 5 != $no)) continue;
				if (preg_match('/AMQ/', $no)) {
					$or = OrgRate::model()->find('org_id = 101 AND JSON_VALUE(meta, "$.mlids") LIKE :mlid AND vfrom <= :time AND vto > :time', [':mlid' => '%AMQ%', ':time' => $t->time]);
				} else {
					$or = OrgRate::model()->find('org_id = 101 AND JSON_VALUE(meta, "$.mlids") LIKE :mlid AND vfrom <= :time AND vto > :time', [':mlid' => '%' . substr($no, 0, 5) . '%', ':time' => $t->time]);
				}
				if (empty($or)) continue;
				if (empty($t->shipment)) {
					$sql = 'select weight from shipment_archive WHERE hbn = :n OR ref = :n';
					$weight = Yii::app()->db->createCommand($sql)->bindValues([':n' => $t->connote])->queryScalar();
				} else {
					$weight = $t->shipment->weight;
				}
				$t->cost = Shipment::getCourierCostByShipment($t->connote, $or->id, $weight)['price'];
				$t->update('cost');
			}
		}

		if (empty($org_id) || $org_id == Org::ORGID_COURIER_STARTRACK) {
			$ts = Tranship::model()->findAll('org_id = :org_id AND cost = 0 AND man_id != 0 AND time >= "2019-01-01"', [':org_id' => Org::ORGID_COURIER_STARTRACK]);
			foreach ($ts as $t) {
				if (!empty($no) && ($t->id % 5 != $no)) continue;
				if (preg_match('/7RFZ/', $t->connote)) $rate_id = $ors['StarTrack Road']->id;
				else $rate_id = $ors['StarTrack Mel']->id;
				if (empty($t->shipment)) {
					$sql = 'select weight from shipment_archive WHERE hbn = :n OR ref = :n';
					$weight = Yii::app()->db->createCommand($sql)->bindValues([':n' => $t->connote])->queryScalar();
				} else {
					$weight = $t->shipment->getCubeWeight();
				}
				$t->cost = Shipment::getCourierCostByShipment($t->connote, $rate_id, $weight)['price'];
				$t->update('cost');
			}
		}

		if (empty($org_id) || in_array($org_id,[Org::ORGID_COURIER_TNT,Org::ORGID_COURIER_TNT_TOP])) {
			$ts = Tranship::model()->findAll('org_id = :org_id AND man_id != 0 AND time >= "2019-01-01"', [':org_id' => Org::ORGID_COURIER_TNT]);
			$ts = array_merge($ts, Tranship::model()->findAll('org_id = :org_id AND man_id != 0 AND time >= "2019-01-01"', [':org_id' => Org::ORGID_COURIER_TNT_TOP]));

			foreach ($ts as $t) {
				if (!empty($no) && ($t->id % 5 != $no)) continue;
				if (preg_match('/TLS/', $t->connote)) $rate_id = $ors['TNT_TOP']->id;
				else if (preg_match('/LMA/', $t->connote)) $rate_id = $ors['TNT Melbourne_TOP']->id;
				else if (preg_match('/TBC/', $t->connote)) $rate_id = $ors['TNT Brisbane_TOP']->id;
				else if (preg_match('/LPC/', $t->connote)) $rate_id = $ors['TNT Perth_TOP']->id;
				else continue;
				if (empty($t->shipment)) {
					$sql = 'select weight from shipment_archive WHERE hbn = :n OR ref = :n';
					$weight = Yii::app()->db->createCommand($sql)->bindValues([':n' => $t->connote])->queryScalar();
				} else {
					$weight = $t->shipment->getCubeWeight();
				}
				$t->cost = Shipment::getCourierCostByShipment($t->connote, $rate_id, $weight)['price'];
				$t->update('cost');
				$cl = CogsLine::model()->find('fid = :fid and model = "ImParcel" and item_code = "item"',[":fid"=>$t->pid]);
				if(!empty($cl))
				{
					$cl->accrual_amount = $t->cost;
					$cl->accrual_gst_amount = 0;
					$cl->save();
				}
			}
		}
	}

	private function update_tranship_dfe()
	{
		$ts = Tranship::model()->findAll('org_id = :org_id AND time >= "2019-01-01"', [':org_id' => Org::ORGID_COURIER_DFE]);
		$ts = array_merge($ts, Tranship::model()->findAll('org_id = :org_id AND time >= "2019-01-01"', [':org_id' => Org::ORGID_COURIER_DFE_TOP]));
		foreach ($ts as $t) {
			$orgRate = OrgRate::model()->find('org_id = :org_id', [':org_id' => $t->org_id]);
			if (empty($orgRate)) continue;
			$srl = SiReconcileLine::model()->find('t.ref = :ref AND weight > 0 AND item_code = "item"', [':ref' => $t->connote]);
			// if (empty($srl)) {
			// 	[$app_name, Yii::app()->name] = [Yii::app()->name, 'HVLV APP'];
			// 	$srl = SiReconcileLine::model()->find('t.ref = :ref AND weight > 0 AND item_code = "item"', [':ref' => $t->connote]);
			// 	Yii::app()->name = $app_name;
			// }
			if (empty($srl)) {
				[$app_name, Yii::app()->name] = [Yii::app()->name, 'TLA'];
				$srl = SiReconcileLine::model()->find('t.ref = :ref AND weight > 0 AND item_code = "item"', [':ref' => $t->connote]);
				Yii::app()->name = $app_name;
			}
			if (!empty($srl)) {
				$t->cost = $srl->my_value;
				$t->update('cost');
			}
		}
	}

	private function manifest_map()
	{
		$ts = Tranship::model()->findAll('org_id = :org_id AND man_id = 0 AND time >= "2020-01-01"', [':org_id' => Org::ORGID_COURIER_AUPOST]);
		foreach ($ts as $t) {
			if (empty($t->mdata['oid']) || !preg_match('/^AP/i', $t->mdata['oid'])) continue;

			$manifest = Manifest::model()->find('ref = :ap', [':ap' => $t->mdata['oid']]);
			if (empty($manifest)) {
				$manifest = new Manifest;
				$manifest->fwd_id = Org::ORGID_COURIER_AUPOST;
				$manifest->consol_id = 0;
				$manifest->dpt_id = 0;
				$manifest->by_id = 0;
				$manifest->type = 90;
				$manifest->status = 10;
				$manifest->created = $t->time;
				$manifest->ref = $t->mdata['oid'];
				$manifest->save();
			}

			$mm = ManiMap::model()->find('mani_id = :mani_id AND model = "ImParcel" AND fid = :fid', [':mani_id' => $manifest->id, ':fid' => $t->pid]);
			if (empty($mm)) {
				$mm = new ManiMap;
				$mm->mani_id = $manifest->id;
				$mm->model = 'ImParcel';
				$mm->fid = $t->pid;
				$mm->bwf = 0;
				$mm->meta = '';
				$mm->status = 10;
				$mm->save();
			}

			if (empty($manifest->getErrors()) && empty($mm->getErrors())) {
				$t->man_id = $manifest->id;
				$t->update('man_id');
			}
		}
	}

	public function update_courier()
	{
		$from = '2022-06-01';

		$to = date('Y-m-d');

		$cond = 'type IN (15,70,80) AND created >= :from AND created < :to';
		$params = [':from' => $from, ':to' => $to];

		$consols = Consol::model()->findAll($cond,$params);
		foreach ($consols as $consol) {
			echo $consol->no . ' ' . memory_get_usage() . PHP_EOL;
			if ($consol->isTLA()) [$app_name, Yii::app()->name] = [Yii::app()->name, 'TLA'];
			else [$app_name, Yii::app()->name] = [Yii::app()->name, 'HVLV APP'];//, Org::ORGID_COURIER_AUPOST, Org::ORGID_COURIER_STARTRACK, Org::ORGID_COURIER_TNT,Org::ORGID_COURIER_TNT_TOP, Org::ORGID_COURIER_DFE, Org::ORGID_COURIER_DFE_TOP
			foreach ([Org::ORGID_COURIER_FASTWAY] as $crid) {
				$lines = BillingLine::model()->findAll('org_id = :crid AND status != 11 AND (`desc` LIKE "%total shipment%" OR `desc` LIKE "%import%" OR `desc` LIKE "%3pl%") AND billing_ref = :ref', [':ref' => $consol->no, ':crid' => $crid]);
				foreach ($lines as $line) {
					$sql = 'SELECT id FROM shipment WHERE consol_id = :cid AND JSON_VALUE(meta, "$.import_billing_id") = :bid';
					$rs = Yii::app()->db->createCommand($sql)->bindValues([':cid' => $consol->id, ':bid' => $line->id])->queryAll();
					if (empty($rs)) {
						$line->status = 11;
						$line->mdata['courier_dup'] = true;
						$line->update('status', 'meta');
					} else {
						if ($line->actual_amount != 0) {
							$line->accrual_amount = 0;
							foreach ($rs as $r) {
								$shipment = Shipment::model()->findByPk($r['id']);
								// si_reconcile_line
								$srLine = SiReconcileLine::model()->find('fid = :fid AND model = "ImParcel" AND item_code = "item"', [':fid' => $shipment->id]);
								if (!empty($srLine)) {
									$line->accrual_amount += $srLine->my_value;
									continue;
								}
								// cogs_line
								$cogsLine = CogsLine::model()->find('fid = :fid AND model = "ImParcel" AND item_code = "item"', [':fid' => $shipment->id]);
								if (!empty($cogsLine)) {
									$line->accrual_amount += $cogsLine->accrual_amount;
									continue;
								}
								// tranship
								foreach ($shipment->trans as $tran) {
									if ($tran->org_id == $crid) {
										$line->accrual_amount += $tran->cost;
										break;
									}
								}
							}
							$line->accrual_amount = number_format($line->accrual_amount, 2, '.', '');
							$line->update('accrual_amount');
						} else {
							$line->status = 11;
							$line->mdata['courier_dup'] = true;
							$line->update('status', 'meta');
							foreach ($rs as $r) {
								$shipment = Shipment::model()->findByPk($r['id']);
								unset($shipment->mdata['import_billing_id']);
								$shipment->update('meta');
							}
						}
					}
				}

				$lines = BillingLine::model()->findAll('org_id = :crid AND status != 11 AND (`desc` LIKE "%left shipment%" OR `desc` = "") AND actual_amount = 0 AND accrual_amount >= 0 AND billing_ref = :ref', [':ref' => $consol->no, ':crid' => $crid]);
				foreach ($lines as $k => $line) {
					$line->status = 11;
					$line->mdata['courier_left_dup'] = true;
					$line->update('status', 'meta');
				}

				$left = ['no' => 0, 'amount' => 0];
				foreach ($consol->shipments as $p) {
					$flag = false;
					foreach ($p->trans as $tran) {
						if ($tran->org_id == $crid) {
							$flag = true;
						}
					}
					if (!$flag) continue;

					if (isset($p->mdata['import_billing_id_aupost'])) {
						$billingline = BillingLine::model()->findByPk($p->mdata['import_billing_id_aupost']);
						if (!empty($billingline) && $billingline->status != 11 && $billingline->actual_amount != 0 && $billingline->org_id == $crid) {
							continue;
						}
					} else if (isset($p->mdata['import_billing_id'])) {
						$billingline = BillingLine::model()->findByPk($p->mdata['import_billing_id']);
						if (!empty($billingline) && $billingline->status != 11 && $billingline->actual_amount != 0 && $billingline->org_id == $crid) {
							continue;
						}
					}

					$left['no'] += 1;

					// si_reconcile_line
					$srLine = SiReconcileLine::model()->find('fid = :fid AND model = "ImParcel" AND item_code = "item"', [':fid' => $p->id]);
					if (!empty($srLine)) {
						$left['amount'] += $srLine->my_value;
						continue;
					}
					// cogs_line
					$cogsLine = CogsLine::model()->find('fid = :fid AND model = "ImParcel" AND item_code = "item"', [':fid' => $p->id]);
					if (!empty($cogsLine)) {
						$left['amount'] += $cogsLine->accrual_amount;
						continue;
					}
					// tranship
					foreach ($p->trans as $ts) {
						if ($ts->org_id == $crid) {
							$left['amount'] += $ts->cost;
							break;
						}
					}
				}
				if (number_format($left['amount'], 2, '.', '') == 0) continue;
				
				$newBilling = BillingLine::model()->find('org_id = :crid AND status != 11 AND (`desc` LIKE "%left shipment%" OR `desc` = "") AND actual_amount = 0 AND accrual_amount >= 0 AND billing_ref = :ref', [':ref' => $consol->no, ':crid' => $crid]);
				if (empty($newBilling)) $newBilling = new BillingLine;
				$newBilling->status = 1; // initial pending status
				$newBilling->link_id = 0;
				$newBilling->org_id = $crid;
				$newBilling->charge_code = Consol::AU_LOCAL_DELIVERY_COST_GL_CODE;
				$newBilling->billing_cref = $consol->no;
				$newBilling->currency = 1; // AUD default
				$newBilling->weight = 0;
				$newBilling->charge_weight = 0;
				$newBilling->billing_ref = $consol->no;
				$newBilling->awb = $consol->awb;
				$newBilling->dpt_id = empty($consol->dpt_id) ? Org::PCAE_DEPARTMENT_SYDNEY : $consol->dpt_id;
				$newBilling->date = date('Y-m-d');
				$newBilling->created = date('Y-m-d');
				$newBilling->transaction_date = date('Y-m-d');
				$newBilling->due = date('Y-m-d');
				$newBilling->type = BillingLine::BILLING_TYPE_IMPORT; // for import type
				$newBilling->dpmt = Invoice::DPMT_IMPORT;
				$newBilling->actual_amount = 0;
				$newBilling->gst = 'INPUT';
				$newBilling->desc = 'left shipment ' . $left['no'];
				$newBilling->accrual_amount = number_format($left['amount'], 2, '.', '');
				$newBilling->mdata['jrf_update_consol'] = true;
				$newBilling->save();
			}

			unset($lines);
			unset($consol->shipments);
			unset($consol);
		}
	}

	private function update_terminal()
	{
		$from = '2020-07-01';

		$to = date('Y-m-d');

		$cond = 'type IN (15,70,80) AND created >= :from AND created < :to';
		$params = [':from' => $from, ':to' => $to];

		$consols = Consol::model()->findAll($cond, $params);
		foreach ($consols as $consol) {
			if ($consol->isTLA()) [$app_name, Yii::app()->name] = [Yii::app()->name, 'TLA'];
			else [$app_name, Yii::app()->name] = [Yii::app()->name, 'HVLV APP'];
			$bls = BillingLine::model()->findAll('org_id IN (' . implode(',', Org::$airports) . ') AND status != 11 AND billing_ref = :no', [':no' => $consol->no]);
			if (count($bls) > 1) {
				$accrual = BillingLine::model()->find('org_id = :org_id AND status != 11 AND billing_ref = :no', [':no' => $consol->no, ':org_id' => Org::ORGID_AIRPORT_PCAETEMP]);
				$actual = BillingLine::model()->find('org_id IN (' . implode(',', Org::$airports) . ') AND org_id != :org_id AND status != 11 AND billing_ref = :no', [':no' => $consol->no, ':org_id' => Org::ORGID_AIRPORT_PCAETEMP]);
				if (!empty($accrual) && !empty($actual)) {
					$actual->accrual_amount = $accrual->accrual_amount;
					$actual->update('accrual_amount');

					$accrual->status = 11;
					$accrual->update('status');
				}
			}
		}
	}

	private function reToPays()
	{
		$query = '(confirm_status & 16) > 0 AND status < 100 AND supplier_invoice_id IN (SELECT id FROM supplier_invoice WHERE type IN (1,2,3,4)) AND JSON_VALUE(meta, "$.reToPay") IS NULL';
		[$app_name, Yii::app()->name] = [Yii::app()->name, 'TLA'];
		$srs = SiReconcile::model()->findAll($query);
		foreach ($srs as $sr) {
			$this->_reToPay($sr->parent->inv_no);
		}
		Yii::app()->name = $app_name;
	}

	public function _reToPay($no)
	{
		$sr = SiReconcile::model()->with('parent')->find('parent.inv_no = :no AND t.status < 100', [':no' => $no]);
		if (!empty($sr)) {
			$bls = BillingLine::model()->findAll('billing_cref = :no AND org_id = :org_id AND billing_ref = ""', [':no' => $sr->parent->inv_no, ':org_id' => $sr->parent->org_id]);
			foreach ($bls as $bl) {
				$bl->status = 11;
				$bl->update('status');
			}
			$sr->toPay(true);

			if ($sr->parent->type == 1) {
				$bls = [];
				foreach ($sr->lines as $line) {
					if ($line->item_code != 'item') continue;
					if (!empty($line->imparcel->mdata['import_billing_id'])) continue;
					if (empty($line->imparcel->consol->no)) continue;
					if (empty($bls[$line->imparcel->consol->no])) {
						$bls[$line->imparcel->consol->no] = BillingLine::model()->find('billing_cref = :no AND org_id = :org_id AND billing_ref = :consol AND status != 11', [':no' => $sr->parent->inv_no, ':org_id' => $sr->parent->org_id, ':consol' => $line->imparcel->consol->no]);
					}
					if (empty($bls[$line->imparcel->consol->no])) echo $line->id . PHP_EOL;
					else {
						$line->imparcel->mdata['import_billing_id'] = $bls[$line->imparcel->consol->no]->id;
						$line->imparcel->update('meta');
					}
					unset($line->imparcel->consol);
					unset($line->imparcel);
					unset($line);
				}
			}

			$bls = BillingLine::model()->findAll('billing_cref = :no AND org_id = :org_id AND billing_ref = "" AND status < 11', [':no' => $sr->parent->inv_no, ':org_id' => $sr->parent->org_id]);
			if (empty($bls)) {
				$sr->mdata['reToPay'] = true;
				$sr->update('meta');
			}
		}
	}

