	private function mailOpAccountingAlert($email, $msg)
	{
		include_once('PHPMailer/class.phpmailer.php');

		$mail = new PHPMailer();
		$mail->CharSet = 'UTF-8';
		$mail->IsHTML(true);
		$mail->From     = 'admin@system';
		$mail->FromName = 'Admin';
		$mail->Subject  = 'Missing OP need to be done!';
		$mail->Body = $msg;
		$mail->AddAddress(trim($email));
		$mail->AddCC('gero@toplogistics.com.au');
		// $mail->AddCC('michael.yue@toplogistics.com.au');

		if ($mail->Send()) {
			$this->log('mailOpAccountingAlert to ' . $email . 'done');
		} else {
			$this->log('mailOpAccountingAlert ' . $email . ' failed : ' . $mail->ErrorInfo);
		}
	}

