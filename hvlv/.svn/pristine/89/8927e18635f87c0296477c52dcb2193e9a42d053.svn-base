	public function fixMissGatepassShipmentRecordForTruckDeliveryAndPickup()
	{
		$cargoProcesses = CargoProcess::model()->with(['shipment','shipment.gatepass_shipment'])->findAll(' t.status <100 and gatepass_shipment.id is null and (shipment.status =60 or shipment.status = 42 or shipment.status = 59) ');
		try {
			
			foreach ($cargoProcesses as $key => $ca) {
				$p = $ca->shipment;
				$scanTime = null;
				if(!empty($p->mdata['scan_time']))
				{
					$scanTime = $p->mdata['scan_time'];
				}
				if(empty($p->consol)) continue;
				$scaned = GatepassShipment::gatepassScan($p, Org::ORGID_COURIER_TLA, 0, $p->consol->dpt_id,null,$ca->caref,false,$scanTime);
			}
		} catch (Exception $ex) {
			throw $ex;
		}
	}

	public function generateAllInvLineWithRebateToBeRebateInvLine()
	{
		Yii::app()->name = "TLA";
		$invLines = InvLine::model()->findAll("rebate = 1 and json_value(meta,'$.isGenRebate') is null");
		foreach ($invLines as $key => $invLine) {
			$invLineRebate = new InvLineRebate();
			$invLineRebate->inv_id = $invLine->inv_id;
			$invLineRebate->model = $invLine->model;
			$invLineRebate->fid = $invLine->fid;
			$invLineRebate->ccode = $invLine->ccode;
			$invLineRebate->amount = $invLine->amount;
			$invLineRebate->gst = $invLine->gst;
			$invLineRebate->det = $invLine->det;
			$invLineRebate->qty = $invLine->qty;
			$invLineRebate->tax = $invLine->tax;
			$invLineRebate->rebate = $invLine->rebate;
			if(!empty($invLine->mdata['items']))
			{
				$thisItems = [];
				$newAmount = 0;
				$newGst = 0;
				foreach ($invLine->mdata['items'] as $k2 => $item)
				{
					$thisItemRebate = false;
					if(!empty($item['rebate']))
					{
						$thisItems[] = $item;
						$newAmount+= $item[5];
					}
				}

				$invLineRebate->mdata['items'] = $thisItems;
				if($invLine->gst>0)
				{
					$newGst = number_format($newAmount*0.1,2,'.','');
				}

				$invLineRebate->amount = $newAmount;
				$invLineRebate->gst = $newGst;
			}
			$invLine->mdata['isGenRebate'] = 1;
			if($invLineRebate->save())
			{
				$invLine->save();
			}else
			{
				print_r($invLineRebate);
			}
		}
	}
	public function packageInfoRequiring()
	{
		// searching all cargoprocess shipments that without package info, of consol
		//stage 1

		$allConsol = Consol::model()->findAll("created >= '2022-03-17' and eta < :date and no not like 'WDT%' and (json_value(t.meta,'$.checked_cargprocess_stage1') is null or json_value(t.meta,'$.checked_cargprocess_stage1')=0)",[":date"=>date('Y-m-d')]);
		$shipmentArr = $this->getPackageInfoRequiringShipmentArr($allConsol);
		

		$this->packageInfoRequiringStages($shipmentArr,Emailog::PACKAGE_INFO_REQUIRING);


		$allConsol = Consol::model()->findAll("created >= '2022-03-17' and eta >= :date and no not like 'WDT%' and (json_value(t.meta,'$.checked_cargprocess_stage2') is null or json_value(t.meta,'$.checked_cargprocess_stage1')=0)");
		$shipmentArr2 = $this->getPackageInfoRequiringShipmentArr($allConsol);

		$this->packageInfoRequiringStages($shipmentArr2,Emailog::PACKAGE_INFO_REQUIRING2);

    }

    public function getPackageInfoRequiringShipmentArr(&$allConsol)
    {
    	$shipmentArr = [];
    	foreach ($allConsol as $ck => $consol) 
		{
			foreach ($consol->shipments as $sk => $shipment) {
				if($shipment->checkIsCargoProcessWithRef()&&$shipment->status!=ImParcel::STATE_CANCELLED&&empty($shipment->packages))
				{
					$relations = ImportsShipmentRelations::model()->findAll('pid = :pid',[":pid"=>$shipment->id]);
					if(!empty($relations))
					{
						foreach ($relations as $rek => $re) {
							$subShipment = &$re->sub_shipment;
							if($subShipment->checkIsCargoProcessWithRef()&&$subShipment->status!=ImParcel::STATE_CANCELLED&&empty($subShipment->packages))
							{
								if(empty($shipmentArr[$subShipment->agent_id]))
								{
									$shipmentArr[$subShipment->agent_id] = [];
								}
								$shipmentArr[$subShipment->agent_id][] = $subShipment;
							}
						}
						continue;
					}
					if(empty($shipmentArr[$shipment->agent_id]))
					{
						$shipmentArr[$shipment->agent_id] = [];
					}
					$shipmentArr[$shipment->agent_id][] = $shipment;
				}
			}
			$consol->mdata['checked_cargprocess_stage1'] = 1;
			$consol->save();
			unset($consol[$ck]);
		}
		return $shipmentArr;
    }
    public function packageInfoRequiringStages($shipmentArr,$emailType)
	{
		if(empty($shipmentArr)) return false;
		$emailService = new EmailService();
		foreach ($shipmentArr as $agentId => $agentData)
		{
			$i = 1;
			$xls = new oExcel;
            $xls->addRow($i++, ['Reference Number', 'Customer Reference Number', 'Weight','total cbm','pcs']);
			foreach ($agentData as $j => $shipment) {
				 $xls->addRow($i++, [$shipment->ref, $shipment->cref,$shipment->weight,$shipment->getTotalCBM(),$shipment->pkg]);
			}

			$filename = $agentId."_packages_info_requiring.xls";
            $path = Yii::app()->basePath.DIRECTORY_SEPARATOR.'runtime'.DIRECTORY_SEPARATOR;
            $fullFilename = $path.$filename;
            $xls->output($fullFilename, null, false);
            $result = $emailService->funcSendEmailTpl($agentId,'imports@toplogistics.com.au','TLA Imports','','','','','',$emailType,$fullFilename,$filename);
            if(!$result)
            {
            	$result = $emailService->funcSendEmailTpl(0,'imports@toplogistics.com.au','TLA Imports','dev@toplogistics.com.au','','','','',$emailType,$fullFilename,$filename);
            }
        }
	}

