<?php

/**
 * This is the model class for table "consol_process".
 *
 * The followings are the available columns in table 'consol_process':
 * @property integer $id
 * @property integer $fid
 * @property integer $type
 * @property integer $status
 * @property integer $main_type
 * @property string $started
 * @property string $to_warehouse
 * @property string $date
 * @property string $airport
 * @property string $pick_dead_date
 * @property string $meta
 */
class ConsolProcess extends CActiveRecord
{
	public $mdata;
	public $nolog=false;
	public $custom_log_note='';
		
	const TYPE_FULL_PROCESS=0;
	const TYPE_LOCAL_PROCESS=1;
	const TYPE_NO_PROCESS=2;
	const TYPE_NZ=3;
	const TYPE_DIRECT_AIR_CONSOL=4;
	const TYPE_DIRECT_SEA_CONSOL=5;
	const TYPE_CONSOL_SEA=6;
		 
	const STATE_NEW=1;
	const STATE_WAITING_MAIN_ACR=2;
	const STATE_MAIN_ACR_SENT=3;
	const STATE_WAITING_SUB_ACR=4;
	const STATE_WAITING_SEND_UBM=8;
	const STATE_UB_ON_SCHEDULE=9;
	const STATE_UB_REJECT=11;
	const STATE_WAITING_AIRPORT_CKIN=16;
	const STATE_WAITING_NOTIFY_DRIVER_PICKUP=20;
	const STATE_NOTIFIED_DRIVER=21;
	const STATE_WAITING_WH_SCAN=24;
	const STATE_WAITING_AIR_MANI=28;
	const STATE_WAITING_CREATE_INVOICE=32;
	const STATE_CONSOL_PROCESS_DONE=80;
		
	const SEA_TODO_MBL_HBL=2;
	const SEA_MANIFEST=4;
	const SEA_PRE_ALERT=8;
	const SEA_ARRIVAL_NOTICE=16;
	const SEA_PORT_CHARGES_INVOICE=32;
	const SEA_DELIVERY_ORDER=64;
	const SEA_SWB_TELEX_RELEASE=128;
		
	const SEA_FINISH_STATES=255;
		
	public static $airport_types=[
		'Dnata T1'=>'Dnata T1',
		'Dnata T2'=>'Dnata T2',
		'Menzies'=>'Menzies',
		'Qantas T1'=>'Qantas T1',
		'Qantas T3'=>'Qantas T3',
	];
	public static $pmc_type=[
		'ULD'=>'ULD',
		'LOOSE'=>'LOOSE',
	];
		
	public static $driver_tel_no=[
		'0000000000' =>'Test',
	];
	/**
	 * @return string the associated database table name
	 */
	public static $states=[
		1=>'New',
		2=>'Waiting send Main ACR',
		3=>'Main ACR sent',
		4=>'Waiting send Sub ACR',
		8=>'Waiting Send UB Move',
		9=>'UB On Schedule',
		11=>'UB Reject',
		16=>'Waiting Airport Checked in',
		20=>'Waiting to Notify Driver Pick Up',
		21=>'Notified Driver',
		24=>'Wating for WH scan',
		28=>'Waiting for AirOut/Manifest',
		32=>'Waiting for created Invoice',
		80=>'Consol Process done',
	];
		
	public static $seaStates=[
		1=>'New',
		2=>'Waiting send Main ACR',
		3=>'Main ACR sent',
		4=>'Waiting send Sub ACR',
		8=>'Waiting Send UB Move',
		9=>'UB On Schedule',
		11=>'UB Reject',
		16=>'Waiting Airport Checked in',
		20=>'Waiting to Notify Driver Pick Up',
		21=>'Notified Driver',
		24=>'Wating for WH scan',
		28=>'Waiting for AirOut/Manifest',
		32=>'Waiting for created Invoice',
		80=>'Consol Process done',
		128=>'SWB/TELEX RELEASE/ORIGINAL'
	];
		
	public static $seaStatesShort=[
		2=>'MBL',
		4=>'MAN',
		8=>'PRE',
		16=>'ARR',
		32=>'POR',
		64=>'DEL',
		128=>'SWB',
	];
		
	public static $types=[
		0=>'full process',
		1=>'local',
		2=>'NO_PROCESS',
		3=>'NZ type',
		4=>'Direct AIR Consol',
		5=>'Direct Sea Consol',
		6 => 'Sea Consol'
	];

	public static $main_types=[
		1=>'Air Process',
		2=>'Sea Process',
	];
	public function tableName()
	{
		return 'consol_process';
	}

	/**
	 * @return array validation rules for model attributes.
	 */
	public function rules()
	{
		// NOTE: you should only define rules for those attributes that
		// will receive user inputs.
		return [
			['fid, type, status, started, date', 'required'],
			['fid, type, status,main_type', 'numerical', 'integerOnly'=>true],
			// The following rule is used by search().
			// @todo Please remove those attributes that should not be searched.
			['id, fid, type, status, started,airport,to_warehouse,pick_dead_date,date,main_type, meta', 'safe', 'on'=>'search'],
		];
	}

	/**
	 * @return array relational rules.
	 */
	public function relations()
	{
		// NOTE: you may need to adjust the relation name and the related
		// class name for the relations automatically generated below.
		return [
			'consol'=>[self::BELONGS_TO,'Consol','fid'],
		];
	}

	/**
	 * @return array customized attribute labels (name=>label)
	 */
	public function attributeLabels()
	{
		return [
			'id' => 'ID',
			'fid' => 'Fid',
			'type' => 'Type',
			'status' => 'Status',
			'started' => 'Started',
			'date' => 'Date',
			'meta' => 'Meta',
		];
	}
	public function getStatus()
	{
		if ($this->main_type==1) {
			return isset(static::$states[$this->status])? Yii::t(strtolower(__CLASS__), static::$states[$this->status]) : $this->status;
		} elseif ($this->main_type==2) {
			return $this->seaTypeStatus();
		}
	}
	public function seaTypeStatus()
	{
		$status='';
		foreach (self::$seaStatesShort as $key=>$value) {
			if (($this->status&$key)==0) {
				$status.=$value."|";
			}
		}
		return $status;
	}
		
	public function beforeSave()
	{
		if (!empty($this->mdata)) {
			$this->meta= json_encode($this->mdata);
		}
		return true;
	}
	public function updateMeta($nolog=true)
	{
		$this->nolog = $nolog;
		$this->meta = json_encode($this->mdata);
		$this->update(['meta']);
	}
		
	public function afterFind()
	{
		if (!empty($this->meta)) {
			$this->mdata= json_decode($this->meta, true);
		}
		return true;
	}
		
	public function addTrack()
	{
		if (isset($this->consol->type)&&$this->consol->type==70) {
			if ($this->status== self::STATE_NOTIFIED_DRIVER) {
				$shipment= $this->consol->linkShipment(false);
				if (!$shipment->hasTracking(12)) {
					$shipment->addTracking(12, 'Parcels picked up', 'Botany');
				}
			}
		}
	}
	public function afterSave()
	{
		$this->addTrack();
		//add log
		if (!$this->nolog&&!empty($this)) {
			$extra=empty($this->custom_log_note)?[]:['note'=>$this->custom_log_note];
			Log::add($this, $this->isNewRecord? 3 : 4, array_merge(['status' => $this->getStatus()], $extra));
		}
		if (isset($this->consol->type)&&$this->consol->type==70&&$this->status== ConsolProcess::STATE_WAITING_WH_SCAN) {
			foreach ($this->consol->shipments as $shipment) {
				if (!$shipment->hasTracking(ImParcel::STATE_DRIVER_PICK_UP)) {
					$shipment->addTracking(ImParcel::STATE_DRIVER_PICK_UP, 'The parcel has already been picked up to the warehouse', 'Botany');
				}
			}
		}
	}
		
	public function updateStatus($status, $type=false)
	{
		if ($status == ConsolProcess::STATE_WAITING_WH_SCAN)
		{
			if(!Acl::hasAccess("C:consolProcess/sendToWarehouseScan"))
			{
				return 'Access denied';
			}

			$agentIds = $this->consol->getAllAgentId();
			$creditLimitValue = SystemSetting::getCreditLimitValue();
			//check account limit

			foreach ($agentIds as $key => $agentId) {
				$agt = Org::model()->findByPk($agentId);
				if($agt->overCreditLimit()  && !in_array($agt->type, [60, 65])){
					//return '联系财务确认客人付款情况';
					$balance = $agt->getAccBalanceDetails();
					
					$thisTotal = 0;
					foreach ($this->consol->shipments as $key => $p) {
						if($p->status==ImParcel::STATE_CLEAR&&$p->getValue()>=$creditLimitValue)
						{
							if(($balance+$thisTotal)<0)
							{
								$thisTotal+=$p->getValue();
								if($p->status!=ImParcel::STATE_ACCOUNT_HELD)
								{
									$p->mdata['acc_held_before_status']=$p->status;
								}
								$p->status = ImParcel::STATE_ACCOUNT_HELD;
								$p->update(['status','meta']);
							}
						}
					}
				}
			}
		}


		$update=false;
		if (key_exists($status, self::$states)) {
			$this->status=$status;
			if ($status == ConsolProcess::STATE_WAITING_WH_SCAN) {
				if (empty($this->to_warehouse) || $this->to_warehouse<='2015-08-01') {
					$this->to_warehouse=date('Y-m-d H:i:s');
				}
			}elseif($status == ConsolProcess::STATE_NOTIFIED_DRIVER && !empty($this->to_warehouse)){
				$this->to_warehouse = null;
			}

			$update=true;
		}
		if (!empty($type) && key_exists($type, self::$types)) {
			$this->type=$type;
			$update=true;
		}
		$this->date=date('Y-m-d H:i:s');
		if ($update) {
			$this->update(['status','date','type','to_warehouse']);
		}
		return 1;
	}

	/**
	 * Retrieves a list of models based on the current search/filter conditions.
	 *
	 * Typical usecase:
	 * - Initialize the model fields with values from filter form.
	 * - Execute this method to get CActiveDataProvider instance which will filter
	 * models according to data in model fields.
	 * - Pass data provider to CGridView, CListView or any similar widget.
	 *
	 * @return CActiveDataProvider the data provider that can return the models
	 * based on the search/filter conditions.
	 */
	public function search()
	{
		// @todo Please modify the following code to remove attributes that should not be searched.

		$criteria=new CDbCriteria;

		$criteria->compare('id', $this->id);
		$criteria->compare('fid', $this->fid);
		$criteria->compare('type', $this->type);
		$criteria->compare('main_type', $this->main_type);
		$criteria->compare('status', $this->status);
		$criteria->compare('started', $this->started, true);
		$criteria->compare('date', $this->date, true);
		$criteria->compare('to_warehouse', $this->to_warehouse, true);
		$criteria->compare('airport', $this->airport, true);
		$criteria->compare('pick_dead_date', $this->pick_dead_date, true);
		$criteria->compare('meta', $this->meta, true);

		return new CActiveDataProvider($this, [
			'criteria'=>$criteria,
		]);
	}
 
	/**
	 * Returns the static model of the specified AR class.
	 * Please note that you should have this exact method in all your CActiveRecord descendants!
	 * @param string $className active record class name.
	 * @return ConsolProcess the static model class
	 */
	public static function model($className=__CLASS__)
	{
		return parent::model($className);
	}
}
