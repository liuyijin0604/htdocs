<script>
$(function() {
	var tab = $('#<?=$_GET["tabid"]?>');
	var panel = tab.data('panel');

	$(panel).on('success', '#to_pay', function(e, r) {
		if (r.done) {
			myApp.alert(r.msg, false);
		} else {
			myApp.alert(r.msg, false);
		}
	});
});
</script>