    <script type="text/javascript">
        var numCountItem = 1;
        var strHtmlItem = "";
        var questionsArray = [];
        var answersArray = [];


        function submitForm() {

            let email = $('#email').val();
            let valid = email.match(
                /^(([^<>()[\]\\.,;:\s@\"]+(\.[^<>()[\]\\.,;:\s@\"]+)*)|(\".+\"))@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/
              );

              if (!valid) {
                alert("email is not valid");
                return false;
              }
              
            // alert("");

            var form = new FormData(document.getElementById("customer_detail_form"));
             $.ajax({
                        url: '<?=$url?>',
                        type: "post",
                        data: form,
                        processData: false,
                        contentType: false,
                        success: function(r) {

                            var response = JSON.parse(r);
                            if(!response.done)
                            {
                                console.log(response);
                                alert(response.msg);
                            }else
                            {
                                var submit_id = response['submit_id'];  
                                // console.log(submit_id); 
                                // debugger;                       
                                window.location.replace("<?=$this->createUrl('salesfunnelRequirements/requirement')?>"+"?submit_id="+submit_id);
                            }
                         },
                        error: function(e) {
                            console.log(e);
                        }
                    });
             return false;

        }


    </script>
