<!doctype html>
<html>
<head>
<meta charset="utf-8">
<title>QR Code print</title>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/1/jquery.min.js" type="text/javascript"></script>
<style type="text/css">
* { box-sizing:border-box; }
body { margin: 0; padding: 4mm; font-family: Arial, sans-serif; }
.qbox {	width: 33.3%; padding-top: 30px; float: left; text-align: center; height: 67.3mm; }
#tpl{ display: none; }
.barcode{ font-family: "IDAutomationC39M"; font-size: 16px; height: 10mm; overflow: hidden; }
.l1 { font-size: 28px; font-weight: bold; }
.clear{	clear:both;	page-break-after: always; }
@media print {
	@page {
		size: 210mm 297mm;
		margin: 0;
		padding: 4mm;
	}
}
</style>
</head>
<body>
<div id="tpl" class="qbox">
<div class="barcode"></div>
<div class="barcode"></div>
<div class="barcode"></div>
<div class="barcode"></div>
<div class="l1"></div>
</div>
</body>
