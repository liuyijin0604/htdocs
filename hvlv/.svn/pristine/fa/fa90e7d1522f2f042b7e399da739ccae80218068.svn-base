	'columns'=>[
		['header' => 'GL Code','name' => 'ccode', 'class' => 'CEditableColumn', 'type' => 'list', 'filter'=> ['CUSTOMS DUTY/GST' => 'CUSTOMS DUTY/GST', 'PROCESSING FEE' => 'PROCESSING FEE', 'OTHER' => 'OTHER']],
		['header' => 'Detail','name' => 'det', 'class' => 'CEditableColumn'],
		['header' => 'Amount','name' => 'amount', 'class' => 'CEditableColumn', 'inputOptions' => ['size' => 5]],
		['header' => 'Qty','name' => 'qty', 'class' => 'CEditableColumn', 'inputOptions' => ['size' => 5]],
		['header' => 'Tax Rate', 'name' => 'tax','class' => 'CEditableColumn','type' => 'list',
