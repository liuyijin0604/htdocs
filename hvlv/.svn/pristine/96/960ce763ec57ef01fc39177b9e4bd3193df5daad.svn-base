		return "";
	}

	public static function getArrayMondayAndThursday()
	{
		$result = [];
		$today = date("w", time());
		switch ($today) {
			case 0:
			case 1:
			case 2:
				$result[date('Y-m-d', strtotime("this week Thursday"))] = date('Y-m-d', strtotime("this week Thursday"));
				$result[date('Y-m-d', strtotime("next week Monday"))] = date('Y-m-d', strtotime("next week Monday"));
				break;
			case 3:
			case 4:
				$result[date('Y-m-d', strtotime("next week Monday"))] = date('Y-m-d', strtotime("next week Monday"));
				$result[date('Y-m-d', strtotime("next week Thursday"))] = date('Y-m-d', strtotime("next week Thursday"));
				break;
			case 5:
			case 6:
				$result[date('Y-m-d', strtotime("next week Thursday"))] = date('Y-m-d', strtotime("next week Thursday"));
				$result[date('Y-m-d', strtotime('+2 week last monday'))] = date('Y-m-d', strtotime('+2 week last monday'));
				break;
		}
		return $result;
	}

