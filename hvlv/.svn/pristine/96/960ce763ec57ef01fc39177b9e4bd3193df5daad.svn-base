	public function getPickupAddress($type = false)
	{
		if (!empty($this->mdata['pickup_address'])) {
			return $this->mdata['pickup_address'];
		} else {
			$pods = SystemSetting::getCargoProcessPodSetting();
			$podId = 0;
			foreach ($pods as $key => $pod) {
				$postcode = @$pod['postcode'];
				if (!empty($postcode)) {
					if (preg_match("/" . explode('%', $postcode)[0] . "\d{3}/i", $this->shipment->cnee->postcode)) {
						$podId = $pod['pod_id'];
						break;
					}
				}

				$state = @$pod['state'];
				if (!empty($state)) {
					if ($state == $this->shipment->cnee->state) {
						$podId = $pod['pod_id'];
						break;
					}
				}
			}
			$warehouse = Org::model()->findByPk($podId);

			$address = "";
			if ($type) {
				$address = "&nbsp;";
			}

			if ($warehouse != null) {
				if ($type) {
					$address = $warehouse->address . ", <br>" . $warehouse->suburb . ", " . $warehouse->state . ", <br>" . $warehouse->country . ", " . $warehouse->postcode;
				} else {
					$address = $warehouse->address . ", " . $warehouse->suburb . ", " . $warehouse->state . ", " . $warehouse->country . ", " . $warehouse->postcode;
				}
			}
			return $address;
		}
	}
	public function isDriverDeliveried()
	{
		if (isset($this->mdata["driverDeliveryStatus"])) {
			return $this->mdata["driverDeliveryStatus"];
		} else {
			if ($this->status == self::WAITINGDELIVERY || $this->status == self::WAITINGAGENTDELIVERY) {
				return self::UNDELIVERIED;
			} else if ($this->status == self::AGENTDELIVERYDONE || $this->status == self::PROCESSDONE) {
				return self::DELIVERIED;
			} else if ($this->status == self::DELIVERYFAILED) {
				return self::ERROR;
			} else {
				return self::UNDELIVERIED;
			}
		}
	}

	public static function updateUploadSingleFile($filesize, $date, $fileHash, $finfo, $mime, $filename, $name, $thisHash, $move = false, $isCargoProcess = false, $cargoProcessId = false, $isFullPod = false, $active = FileRepo::PENDING, $ismove = false)
	{
		$fr = new FileRepo;
		$fr->name = $name;
		$fr->size = $filesize;
		$fr->date = $date;
		$fr->hash = $fileHash;
		$sup = Yii::app()->session['uploads'][$thisHash];
		$fr->type = $sup[0];
		$fr->mime = empty($mime) ? 'application/octet-stream' : $mime;
		$fr->status = $active;
		$fr->user_id = User::currentUserID();
		$fr->org_id = User::currentUserOrgId();
		$d = Yii::app()->params['fileRepoPath'] . DIRECTORY_SEPARATOR . substr($fr->hash, 0, 2);
		if (!is_dir($d)) mkdir($d);
		if ($move) {
			copy($filename, $d . DIRECTORY_SEPARATOR . $fr->hash);
			unlink($filename);
		} else {
			if($ismove){

			}else{
				move_uploaded_file($filename, $d . DIRECTORY_SEPARATOR . $fr->hash);
			}
		}
		if (empty($sup[1])) {
			$fr->fid = 0;
			$fr->save();
			if (!isset($sup[2])) $sup[2] = array();
			$sup[2][] = $fr->id;
			$su = Yii::app()->session['uploads'];
			$su[$thisHash] = $sup;
			Yii::app()->session['uploads'] = $su;
		} else {
			$fr->fid = $sup[1];
			if ($isCargoProcess) {
				$cargoProcess = CargoProcess::model()->findByPk($fr->fid);
				$fr->fid = $cargoProcess->shipment_id;
				$fr->mdata = ["cargo_process_id" => $cargoProcess->id];

				if ($isFullPod) {
					$fr->fid =  $sup[1];

					$fr2 = new FileRepo;
					$fr2->name = $name;
					$fr2->size = $filesize;
					$fr2->date = $date;
					$fr2->hash = $fileHash;
					$fr2->type = 25;
					$fr2->mime = empty($mime) ? 'application/octet-stream' : $mime;
					$fr2->status = FileRepo::PENDING;
					$fr2->fid = $cargoProcess->shipment_id;
					$fr2->mdata = ["cargo_process_id" => $cargoProcess->id];
					$fr2->save();
				}
			} else if (!empty($cargoProcessId)) {
				$fr->mdata = ["cargo_process_id" => $cargoProcessId];
			}
			$fr->save();
			if (!isset($sup[2])) $sup[2] = array();
			$sup[2][] = $fr->id;
		}
		return $fr;
	}

	public function getPrepareLog()
	{
		return ShipmentWhPrepare::model()->find("cargo_process_id = :id", [":id" => $this->id]);
	}
	public function noticeWarehouseToPrepare()
	{
		$prepareLog = $this->getPrepareLog();
		if ($prepareLog != null) {
			return false;
			// $prepareLog->status = ShipmentWhPrepare::NOTPREPARED;
			// $prepareLog->save();
		}
		$this->mdata["canBePrepared"] = 1;
		$this->save();
		$this->log("noticeWarehouseToPrepare");
		return true;
	}



	public function getNeedPrepareParcel($pgn = true, $ps = 30, $ec = false, $defaultOrder = true, $podId = 106, $cargo_type = null, $selectedCargoProcessIds = null,$isPrepared = false)
	{
		$pickupType = self::PICKUP_CARGO;
		$criteria = new CDbCriteria;
		$criteria->compare('t.type', $this->type);
		$criteria->compare('shipment_id', $this->shipment_id);
		$criteria->compare('driver_id', $this->driver_id);
		$criteria->compare('s.pkg', $this->pkg, true);
		$criteria->compare('s.weight', $this->weight, true);
		if (!empty($this->cbm)) {
			if (preg_match('/[>|<|=]/', $this->cbm)) {
				$criteria->addCondition(' (s.pkg*s.cbm) ' . $this->cbm);
			} else {
				$criteria->addCondition(' (s.pkg*s.cbm) = ' . $this->cbm);
			}
		}

		if (!empty($this->plt)) {
			if (preg_match('/[>|<|=]/', $this->cbm)) {
				$criteria->addCondition(' json_value(s.meta,"$.amzon_pallet") ' . $this->plt);
			} else {
				$criteria->addCondition(' json_value(s.meta,"$.amzon_pallet") = ' . $this->plt);
			}
		}

		$criteria->compare('s.can', $this->memo, true);
		$criteria->compare('ad.name', $this->cname, true);
		$criteria->compare('ad.tel', $this->tel, true);
		$criteria->compare('ad.address', $this->address, true);
		$criteria->compare('ad.suburb', $this->suburb, true);
		$criteria->compare('ad.state', $this->state, true);
		$criteria->compare('ad.postcode', $this->postcode, true);
		$criteria->compare('c.no', $this->consol_no, true);

		if (!empty($this->status)) {
			$criteria->compare('t.status', $this->status);
		} else {
			$criteria->addCondition("t.status < " . self::PROCESSDONE);
		}

		if (!empty($this->note)) {
			$criteria->addCondition("t.note like '%{$this->note}%'");
		}

		if (!empty($this->ids)) {
			$criteria->addCondition("t.id in ({$this->ids})");
		}


		$criteria->join = ' join shipment s on s.id = shipment_id left join consol c on c.id = s.consol_id left join amazon_info ai on ai.fid = t.id and ai.model="CargoProcess" left join cargo_delivery_info cdi on cdi.shipment_id = t.shipment_id left join addr ad on ad.id = s.cnee_id left join shipment_wh_prepare swp on t.id = swp.cargo_process_id';

		if (!empty($selectedCargoProcessIds)) {
			$criteria->addInCondition("t.id", $selectedCargoProcessIds);
		}

		if ($podId != null) {

			$pod = SystemSetting::getCargoProcessPodSetting($podId);
			$state = @$pod["postcode"];
			$selectStateStr = "postcode like ";
			$sql = "";
			if (empty($state)) {
				$state = @$pod["state"];
				$selectStateStr = "state = ";
			}

			$state = "'" . $state . "'";
			$criteria->addCondition(" (t.type != {$pickupType} and (ad.{$selectStateStr} {$state} or json_value(t.meta,'$.goods_state') = {$state}) ) or (t.type = {$pickupType} and c.dpt_id = {$podId}) ");
		}

		$search_hbns = $this->hbn;
		$hbns = [];
		foreach (preg_split("/[;,\s\n]/", $search_hbns) as $hbn) {
			if (empty(trim($hbn))) {
				continue;
			}
			$hbns[] = trim($hbn); // for fuzzy searching hbns
		}

		$search_refs = $this->ref;
		$refs = [];
		foreach (preg_split("/[;,\s\n]/", $search_refs) as $ref) {
			if (empty(trim($ref))) {
				continue;
			}
			$refs[] = trim($ref); // for fuzzy searching refs
		}
		if (sizeof($hbns) > 1) {
			$likeHbnArr = [];
			foreach ($hbns as $key => $value) {
				$likeHbnArr[] = " s.hbn like \"%{$value}%\" ";
			}
			$likeHbnStr = join($likeHbnArr, ' or ');
			$criteria->addCondition($likeHbnStr); // combinning the like-str
		} else {
			if (!empty($this->hbn)) {
				$this->hbn = trim($this->hbn);
				$criteria->addCondition("s.hbn like '%{$this->hbn}%'"); // if there is only one hbn then~~~
			}
		}

		if (sizeof($refs) > 1) {
			$likeRefArr = [];
			foreach ($refs as $key => $value) {
				$likeRefArr[] = " s.ref like \"%{$value}%\" ";
			}
			$likeRefArr = join($likeRefArr, ' or ');
			$criteria->addCondition($likeRefArr); // combinning the like-str
		} else {
			if (!empty($this->ref)) {
				$this->ref = trim($this->ref);
				$criteria->addCondition("s.ref like '%{$this->ref}%'"); // if there is only one ref then~~~
			}
		}

		if ($cargo_type != null || $this->type != null) {
			if ($cargo_type == self::NORMAL_CARGO || $this->type == self::NORMAL_CARGO) {
				$criteria->addCondition("t.type =" . self::NORMAL_CARGO);
				if ($this->_deliveryBookingTime != null) {
					$criteria->addCondition(" cargo_delivery_info.delivery_booking_time like binary '%{$this->_deliveryBookingTime}%'  ");
				}
			} else if ($cargo_type == self::FBA_CARGO || $this->type == self::FBA_CARGO) {
				$criteria->addCondition("t.type =" . self::FBA_CARGO);
				if ($this->_deliveryBookingTime != null) {
					$criteria->addCondition(" ai.amazon_booking_time like binary '%{$this->_deliveryBookingTime}%'  ");
				}
			} else if ($cargo_type == self::B2B_CARGO || $this->type == self::B2B_CARGO) {
				$criteria->addCondition("t.type =" . self::B2B_CARGO);
				if ($this->_deliveryBookingTime != null) {
					$criteria->addCondition(" cargo_delivery_info.delivery_booking_time like binary '%{$this->_deliveryBookingTime}%'  ");
				}
			} else if ($cargo_type == self::PICKUP_CARGO || $this->type == self::PICKUP_CARGO) {
				$criteria->addCondition("t.type =" . self::PICKUP_CARGO);
			}
		}

		// else
		// {
		// 	$criteria->addCondition("t.type in (2,3,4) or (t.type = 1 and json_value(s.meta,'$.pickup_booking_time') > '2020-01-01')");
		// }

		$nextWorkingDate = HolidayHelper::getNextWeekday(date('Y-m-d'), 'AUSYD'); // get next working date for filtering the cargos

		// $criteria->addCondition(" (cargo_delivery_info.delivery_booking_time is not null and TO_DAYS(cargo_delivery_info.delivery_booking_time)<=TO_DAYS('{$nextWorkingDate}')) or (ai.amazon_booking_time is not null and TO_DAYS(ai.amazon_booking_time)<=TO_DAYS('{$nextWorkingDate}'))  or t.type ={$pickupType}  ");

		if (!empty($this->pickupDate)) {
			if ($this->pickupDate == "today") {
				$date = 0;
			} elseif ($this->pickupDate == "tomorrow") {
				$date = 1;
			} elseif ($this->pickupDate == "after tomorrow") {
				$date = 2;
			}

			if ($this->pickupDate != "all" && $this->pickupDate != "future_date") {
				$criteria->addCondition(" ((to_days(json_value(s.meta,'$.pickup_booking_time')) - to_days(now())) <= $date) or ((to_days(json_value(t.meta,'$.pickup_booking_time')) - to_days(now())) <= $date)  ");
			}
		}

		if (!empty($this->pickupBookingTime)) {
			$criteria->addCondition(" (json_value(s.meta,'$.pickup_booking_time') like '%{$this->pickupBookingTime}%') or (json_value(t.meta,'$.pickup_booking_time') like '%{$this->pickupBookingTime}%')  ");
		}

		if ($this->agentId != null) {
			$criteria->addCondition("s.agent_id = " . $this->_agentId);
		}

		if (!empty($this->gatepassNo)) {
			$gateIds = [0];
			$gatepass = GatePass::model()->findByPk($this->gatepassNo);
			if (!empty($gatepass)) {
				$ids = array_column($gatepass->lines(), "fid");
				$gateIds = array_merge($gateIds, $ids);
			}
			$criteria->addInCondition('s.id',$gateIds);
		}

		if($isPrepared)
		{
			$criteria->addCondition("swp.status = ".ShipmentWhPrepare::PREPARED." and to_days(swp.operate_time)=to_days(now())");
			$criteria->addCondition("s.status !=".ImParcel::STATE_CANCELLED);
		}else
		{
			$criteria->addCondition(" (swp.id is null) or (swp.status = ".ShipmentWhPrepare::NOTPREPARED.") ");
			$criteria->addCondition(" ((t.type != ".CargoProcess::PICKUP_CARGO." and t.status >".self::COLLECTINFO.") or t.type = ".CargoProcess::PICKUP_CARGO.")  and t.status <".self::PROCESSDONE);
			$criteria->addCondition("(s.status >= ".ImParcel::STATE_CLEAR." or s.status=".ImParcel::STATE_LOCAL_ARRIVAL." or s.status=".ImParcel::STATE_TRANSHIP." or s.status=".ImParcel::STATE_CONCLEAR.") and s.status <".ImParcel::DELIVERED);
		}
		//$criteria->addCondition(" t.meta like '%\"canBePrepared\"%' ");

		$criteria->with = array(
			'shipment',
			'shipment.receiver',
			'amazon_info',
			'cargo_delivery_info',
		);
		$criteria->together = true;
		$sort = new CSort();
		$sort->defaultOrder = 'c.no';
		if ($cargo_type == self::FBA_CARGO || $this->type == self::FBA_CARGO) {
			$sort->attributes = [
				'deliveryBookingTime' => [
					'asc' => 'c.no,ai.amazon_booking_time',
					'desc' => 'c.no,ai.amazon_booking_time DESC',
				], 'status' => [
					'asc' => 't.status ASC',
					'desc' => 't.status DESC',
				],
			];
			$sort->defaultOrder = 'c.no,ai.amazon_booking_time DESC';
		} else if ($cargo_type == self::NORMAL_CARGO || $this->type == self::NORMAL_CARGO || $cargo_type == self::B2B_CARGO || $this->type == self::B2B_CARGO) {
			$sort->attributes = [
				'deliveryBookingTime' => [
					'asc' => 'c.no,cargo_delivery_info.delivery_booking_time',
					'desc' => 'c.no,cargo_delivery_info.delivery_booking_time DESC',
				], 'status' => [
					'asc' => 't.status ASC',
					'desc' => 't.status DESC',
				],
			];
			$sort->defaultOrder = 'c.no,cargo_delivery_info.delivery_booking_time DESC';
		}


		// in case sub-gridview, we need consol_id set by parent grid view
		$pagerparams = $_GET;
		return new CActiveDataProvider($this, array(
			'criteria' => $criteria,
			'sort' => $sort,
			'pagination' => $pgn ? [
				'pageSize' => $ps,
				'params' => $pagerparams,
			] : false,
		));
	}


	public function isSydney()
	{
		if ($this->getShipmentPod() ==  Org::SYDNEY_CARGO_DRIVER) {
			return true;
		}
	}

	public function getCRuleInvoice($driverId = null)
	{
		$ruleKey = "";
		if ($driverId == null) {
			$ruleKey = @$this->driver->extra['cargoProcessCRules'];
		} else {
			$ruleKey = Org::model()->findByPk($driverId)->extra['cargoProcessCRules'];
		}

		if (!empty($this->mdata['driverDeliveryFee']) && $driverId == null) //if the job is accepted and the deliveryFee is calculated
		{
			return $this->mdata['driverDeliveryFee'];
		}

		if (!empty($ruleKey)) {
			$rule = SystemSetting::getCargoProcessRuleSetting($ruleKey);
			$totalCBM = $this->shipment->getTotalCBM();
			$amount = 0;
			$minimum = $rule['minimum'];
			$deliveryFee = 0;
			$distanceFee = 0;

			if (empty($rule['minimumIncludeCBM'])) //if do not set minimumIncludeCBM
			{
				$deliveryFee += $rule['costCBM'] * $totalCBM;
			} else {
				if ($totalCBM < $rule['minimumIncludeCBM']) //if set minimumIncludeCBM and minimumIncludeCBM > $totalCBM
				{
					$deliveryFee += $minimum;
				} else {
					$deliveryFee += $minimum + $rule['costCBM'] * ($totalCBM - $rule['minimumIncludeCBM']);
				}
			}

			// Calculate extra distance fee
			$distance = $this->shipment->getDeliveryDistance();
			$extraDistance = $distance - $rule['freeKM'];
			if ($extraDistance > 0) {
				$distanceFee += ceil($extraDistance) * $rule['extraFeeKM']; //0.1km->1 1.1km->2 
			}

			$amount = $deliveryFee + $distanceFee;

			if ($amount <= $minimum) {
				$amount = $minimum;
				$deliveryFee = $amount;
				$distanceFee = 0;
			}

			$fuelChargeFee = ($rule['fuelCharge'] / 100) * $amount;
			$amount = $amount + $fuelChargeFee;

			if ($amount != 0 && empty($this->mdata['driverDeliveryFee']) && $driverId == null) //if the job is accepted and the deliveryFee is not calculated
			{
				$this->mdata['driverDeliveryFee'] = [];
				$this->mdata['driverDeliveryFee']['deliveryFee'] = $deliveryFee;
				$this->mdata['driverDeliveryFee']['distanceFee'] = $distanceFee;
				$this->mdata['driverDeliveryFee']['fuelCharge'] = $fuelChargeFee;
				$this->mdata['driverDeliveryFee']['amount'] = $amount;
				$this->save();
			}

			return ['deliveryFee' => $deliveryFee, 'distanceFee' => $distanceFee, 'fuelCharge' => $fuelChargeFee, 'amount' => $amount];
		}

		return ['deliveryFee' => 0, 'distanceFee' => 0, 'fuelCharge' => 0, 'amount' => 0];
	}

	public function exportInvoiceList($exportType = 'my')
	{
		$jobList = $this->getJobList($exportType, false)->data;
		$csv = [];
		$csv[] = 'CONNOTE NO.,REFERENCE,WEIGHT,CBM,DISTANCE,DELIVERY FEE,DISTANCE FEE,FUEL CHARGE,AMOUNT';
		$amount = 0;
		foreach ($jobList as $job) {
			$r = $job->shipment;
			$csv[] = "\"{$r->hbn}\",\"{$r->ref}\",\"{$r->weight}\",\"{$r->getTotalCBM()}\",\"{$r->getDeliveryDistance()}KM\",\"\${$job->getCRuleInvoice()['deliveryFee']}\",\"\${$job->getCRuleInvoice()['distanceFee']}\",\"\${$job->getCRuleInvoice()['fuelCharge']}\",\"\${$job->getCRuleInvoice()['amount']}\"";
			$amount += $job->getCRuleInvoice()['amount'];
		}
		$csv[] = ",,,,,,,\"amount = \",\"\${$amount}\"";

		header("Content-type: text/csv");
		header("Content-Disposition: attachment; filename=consol_manifest_check.csv");
		header("Pragma: no-cache");
		header("Expires: 0");
		echo implode("\n", $csv);
	}

	public function getDigitalGatePass()
	{
		$gatepassInfo = [];
		$rs = GatepassShipment::model()->findAll('fid=:fid AND status=10 ORDER BY parent_id', array(':fid' => $this->shipment_id));
		foreach ($rs as $r) {
			if ($r->parent_id > 0) {
				return $r->parent_id;
			}
		}
		return null;
	}

	public function processDone($upload_consol = 0)
	{
		$shipment = $this->shipment;
		if ($upload_consol != 0) {
			$thisConsol = $shipment->consol;
			$thisConsolShipments = $thisConsol->shipments;
			if (count($thisConsolShipments) > 1) {
				echo "this shipment's consol have more than one shipment";
				return;
			} else {
				if ($shipment->consol->type == Consol::DMAWBCONSOLTYPE) {
					$thisConsol->status = DmawbConsol::STATE_DELIVERY;
					$thisConsol->update(["status"]);
					$thisConsol->addTrack($shipment);
				} else {
					echo "this shipment's consol is not dmwabconsol";
					return;
				}
			}
		}

		if ($this->status == CargoProcess::WAITINGAGENTDELIVERY) {
			$this->updateStatus(CargoProcess::AGENTDELIVERYDONE);
		}

		if ($this->status == CargoProcess::WAITINGAGENTDELIVERY || $this->status == CargoProcess::WAITINGDELIVERY || $this->status == CargoProcess::AGENTDELIVERYDONE || $this->status == CargoProcess::PROCESSDONE || ($this->type == CargoProcess::PICKUP_CARGO)) {
			$this->updateStatus(CargoProcess::PROCESSDONE);
			if($this->type==1){
				EmailService::sendSuccessfulDeliverySms($this);
			}
			$this->comp_date = date('Y-m-d H:i:s');
			$this->shipment->updateAllFiles();
			if ($this->isSub()) {
				$this->shipment->updatePodTrackingUrl($this->id);
			} else {
				if (empty($this->mdata['caref'])) {
					$this->shipment->updatePodTrackingUrl();
				} else {
					$this->shipment->updatePodTrackingUrl($this->id);
				}
			}

			if ($this->isSub()) {
				$this->shipment->updateDeliveryTracking($this->id, $this->mdata['caref'], $this->mdata['left_packages']);
			} else {
				if (empty($this->mdata['caref'])) {
					$this->shipment->updateDeliveryStatus();
				} else {
					$this->shipment->updateDeliveryTracking($this->id, $this->mdata['caref'], $this->mdata['left_packages'], true);
				}
			}
			/**
			 * Update Cargo Booking status to 'FINISHED' while cargo process is done
			 */
			$cargoBooking = CargoBooking::model()->findByAttributes(['cargo_process_id' => $this->id, 'status' => CargoBooking::CONFIRMED]);
			if (!empty($cargoBooking)) {
				$cargoBooking->status = CargoBooking::FINISHED;
				$cargoBooking->save();
			}
		}
	}

	public function processReturn($upload_consol = 0)
	{
		if ($this->status == CargoProcess::WAITINGAGENTDELIVERY || $this->status == CargoProcess::WAITINGDELIVERY || $this->status == CargoProcess::AGENTDELIVERYDONE || $this->status == CargoProcess::PROCESSDONE || ($this->type == CargoProcess::PICKUP_CARGO)) {
			$this->updateStatus(CargoProcess::RTSDELIVERY);
			//$this->comp_date = date('Y-m-d H:i:s');
			$this->shipment->updateAllFiles();
			//$this->mdata['Redelivery']=1;
			//$this->save();

			$jobRelation = $this->job_relation;
			$this->note = $this->note . " Last Driver: " . Org::model()->findByPk($jobRelation->job->driver_id)->name;
			if (!empty($jobRelation)) {
				$jobRelation->active = 0;
				//$jobRelation->cargo_process_id = 0;
				$jobRelation->save();
			}
		}

		$emailService = new EmailService();
		$emailService->sendErrorDeliverySms($this);

		//$this->shipment->addCargoTracking(101,'Fail delivery notice');
		$this->shipment->addCargoTracking(103,'Delivery failed, waiting for reschedule.');
	}

	public function pickupProcessDone()
	{
		if ($this->type == self::PICKUP_CARGO) {
			$this->processDone();
		} elseif ($this->type == self::NORMAL_CARGO) {
			//EmailService::sendSuccessfulDeliverySms($this);
		}
	}

	public function getOnlyDay()
	{
		// if($this->isNotSub())
		// {
		// 	$obj = $this->shipment;
		// }else
		// {
		$obj = $this;
		// }
		$aTime = @$obj->amazon_info->amazon_booking_time;
		$cTime = @$obj->cargo_delivery_info->delivery_booking_time;
		if (!empty($cTime)) {
			return date("Y-m-d H:i", strtotime($cTime));
		}

		if (!empty($aTime)) {
			return date("Y-m-d H:i", strtotime($aTime));
		}

		return "";
	}

	public function getLastProcessTime()
	{
		$log = Log::model()->find(" model = :model and lid = :lid  order by id desc", [":model" => get_class($this), ":lid" => $this->id]);
		return @$log->time;
	}

	public function getFirstProcessTime()
	{
		$log = Log::model()->find(" model = :model and lid = :lid  order by id asc", [":model" => get_class($this), ":lid" => $this->id]);
		return @$log->time;
	}

	public static function getCargoProcesPodList()
	{
		$provide = SystemSetting::getCargoProcessPodSetting();
		$result = [];
		foreach ($provide as $key => $value) {
			$result[$key] = $value['pod'];
		}
		return $result;
	}

	public function getPltStr()
	{
		$str = "";
		if (!empty($this->shipment->mdata['amzon_pallet'])) {
			$rN = $this->shipment->getRackNumber();
			if (!empty($rN)) {
				$str = $this->getPlt() . " " . @$this->shipment->mdata['amzon_pallet_type'] . "{" . $rN[0] . "/" . $rN[1] . "}";
			} else {
				$str = $this->getPlt() . " " . @$this->shipment->mdata['amzon_pallet_type'];
			}
		} else {
			$rN = $this->shipment->getRackNumber();
			if (!empty($rN)) {
				$str = "{" . $rN[0] . "/" . $rN[1] . "}";
			}
		}

		if (!empty($this->mdata['left_packages'])) {
			$str .= "</br> split ";
		}

		return $str;
	}

	public function getPackages()
	{
		return empty($this->mdata['left_packages']) ? $this->shipment->pkg : $this->mdata['left_packages'];
	}

	public function getPlt()
	{
		if (!empty($this->mdata['job_pallet_no'])) {
			return $this->mdata['job_pallet_no'];
		} else {
			if (!empty($this->shipment->mdata['amzon_pallet'])) {
				$mainPlt = $this->shipment->mdata['amzon_pallet'];
				if (!empty($this->mdata['left_packages'])) {
					$plt = round(($this->shipment->mdata['amzon_pallet'] * $this->mdata['left_packages']) / $this->shipment->pkg);
					return $plt;
				} else {
					return $mainPlt;
				}
			}
		}
		return '';
	}

	public function getWeight($type = false)
	{
		$mainWeight = $this->shipment->weight;
		if (!empty($this->mdata['left_packages'])) {
			$weight = round(($this->shipment->weight * $this->mdata['left_packages']) / $this->shipment->pkg, 2);
			if ($type) {
				$weight = !empty($this->mdata['sub_shipments']) ? $weight . "(${mainWeight})" : $weight;
			}
			return $weight;
		} else {
			return $mainWeight;
		}
	}

	public function getChargeWieght()
	{
		return $this->shipment->chargeWeight();
	}

	public function getIsOverSize()
	{
		$packages = json_decode($this->shipment->packages);
		if (!empty($packages)) {
			foreach ($packages as $package) {
				if (($package->height) >= 120) {
					return true;
				}
				if (($package->width) >= 120) {
					return true;
				}
				if (($package->length) >= 120) {
					return true;
				}
			}
		}
		return false;
	}

	//cuntomerconfirm 
	public function getHasForklift()
	{
		$stringResidential = "";
		if (!empty($this->mdata['customer_confirmed']['business_unloading'])) {
			$stringResidential = $this->mdata['customer_confirmed']['business_unloading'];
		} else if (!empty($this->mdata['customer_confirmed']['residential_unloading'])) {
			$stringResidential = $this->mdata['customer_confirmed']['residential_unloading'];
		}
		//$stringResidential = $this->mdata['customer_confirmed']['business_unloading'];
		if (!empty($stringResidential)) {
			if (strpos($stringResidential, 'have forklift')) {
				return true;
			}
		}
		return false;
	}

	//opconfirm in cargoprocess operation
	public function getOPHasForklift(){
		if(isset($this->mdata['custconfirmforklift'])&&$this->mdata['custconfirmforklift']==1){
			return "✓";
		}else{
			return "✕";
		}
	}

	public function getTotalCBM()
	{
		$pkcbm = $this->shipment->cbm;
		if (!empty($this->mdata['left_packages'])) {
			$weight = round(($pkcbm * $this->mdata['left_packages']), 2);
			return $weight;
		} else {
			return round($pkcbm * $this->shipment->pkg, 2);
		}
	}

	public function isNotSub()
	{
		if (empty($this->mdata['caref']) || !empty($this->mdata['sub_shipments'])) {
			return true;
		} else {
			return false;
		}
	}

	public function isSub()
	{
		if (!empty($this->mdata['caref']) && empty($this->mdata['sub_shipments'])) {
			return true;
		} else {
			return false;
		}
	}

	public function getAmazonInfo()
	{
		if (empty($this->amazon_info)) {
			$amazonInfo = new AmazonInfo();
			$amazonInfo->fid = $this->id;
			$amazonInfo->model = get_class($this);
			$amazonInfo->save();
			return $amazonInfo;
		}
		return $this->amazon_info;
	}

	public function saveNormalDeliveryInfo($deliveryBookingTime)
	{
		if (empty($deliveryBookingTime)) {
			$deliveryBookingTime = null;
		}
		$cargoDeliveryInfo = $this->getCargoDeliveryInfo();
		if (empty($cargoDeliveryInfo)) {
			$cargoDeliveryInfo = new CargoDeliveryInfo();
			$cargoDeliveryInfo->shipment_id = $this->id;
			$cargoDeliveryInfo->delivery_booking_time = $deliveryBookingTime;
			$cargoDeliveryInfo->model = 'CargoProcess';
			$cargoDeliveryInfo->save();

			$this->mdata['delivery_booking_time'] = $deliveryBookingTime;
			// if ($this->status<90) {
			// 	$this->updateDeliveryBookingTime();
			// }
		} else {
			$cargoDeliveryInfo->delivery_booking_time = $deliveryBookingTime;
			$this->mdata['delivery_booking_time'] = $deliveryBookingTime;
			// $this->updateDeliveryBookingTime(true);
			$cargoDeliveryInfo->update('delivery_booking_time');
		}
	}

	public function getCargoDeliveryInfo()
	{
		return $this->cargo_delivery_info;
	}

	public function copyAmazonAndCargoDeliveryInfo($type = false)
	{

		if ($type == 1) {
			$obj = $this;
			$objc = $this->shipment;
		} else {
			$obj = $this->shipment;
			$objc = $this;
		}

		$osc = $obj->getCargoDeliveryInfo();
		if (!empty($osc)) {
			$oc = $objc->getCargoDeliveryInfo();
			if (empty($oc)) {
				$oc = new CargoDeliveryInfo();
			}
			$oc->shipment_id = $objc->id;
			$oc->model = get_class($objc);
			$oc->delivery_booking_time = $osc->delivery_booking_time;
			$objc->mdata['delivery_booking_time'] = $oc->delivery_booking_time;
			$objc->updateMeta();
			$oc->save();
		}

		$osa = $obj->amazon_info;
		if (!empty($osa)) {
			$oa = $objc->amazon_info;
			if (empty($oa)) {
				$oa = new AmazonInfo();
			}
			$oa->fid = $objc->id;
			$oa->model = get_class($objc);
			$oa->amazon_booking_time = $osa->amazon_booking_time;
			$oa->booking_ref = $osa->booking_ref;
			$oa->meta = $osa->meta;
			$objc->mdata['amazon_booking_time'] = $oa->amazon_booking_time;
			$objc->mdata['booking_ref'] = $oa->booking_ref;
			$objc->updateMeta();
			$oa->save();
		}
	}

	public function updateAmazonBookingTime()
	{
		if (!empty($this->mdata['amazon_booking_time'])) {
			if ($this->isNotSub()) {
				$t = $this->shipment->getCargoTracking(70);
			} else {
				$t = $this->shipment->getCargoTracking(70, $this->id);
			}
			if ($t != false) {
				$packageStr = "";
				if (!empty($this->mdata["caref"])) {
					$packageStr = " with " . $this->mdata['left_packages'] . " packages, ";
				}

				$t->activity = $this->getRef() . $packageStr . " Amazon Booking Time: " . $this->mdata['amazon_booking_time'] . ",Booking ref:" . @$this->mdata['booking_ref'];
				$t->depot = "amazon";
				$t->update(["activity", "dpt"]);
			}

			if ($this->status == self::WAITINGDELIVERY && empty($t)) {
				$this->addAmazonBookingTime();
			}
		}
	}

	public function addAmazonBookingTime()
	{
		if (!empty($this->mdata['amazon_booking_time'])) {
			$packageStr = "";
			if (!empty($this->mdata["caref"])) {
				$packageStr = " with " . $this->mdata['left_packages'] . " packages, ";
			}
			if ($this->isNotSub()) {
				$t = $this->shipment->getCargoTracking(70);
				if ($t == false) {
					$this->shipment->addTracking(70, $this->getRef() . $packageStr . " Amazon Booking Time: " . $this->mdata['amazon_booking_time'] . ",Booking ref:" . @$this->mdata['booking_ref'], "amazon", date('Y-m-d h:i:s', time()));
				}
			} else {
				$t = $this->shipment->getCargoTracking(70, $this->id);
				if ($t == false) {
					$this->shipment->addTracking(70, $this->getRef() . $packageStr . " Amazon Booking Time: " . $this->mdata['amazon_booking_time'] . ",Booking ref:" . @$this->mdata['booking_ref'], "amazon", date('Y-m-d h:i:s', time()), 0, 0, '{"cargo_process_id":"' . $this->id . '"}', $this->id);
				}
			}
		}
	}

