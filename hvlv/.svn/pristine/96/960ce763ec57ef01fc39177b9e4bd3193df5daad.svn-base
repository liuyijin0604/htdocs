	public function copyAttributes($newObj)
	{
		$newObj->shipment_id = $this->shipment_id;
		$newObj->status = $this->status;
		$newObj->cargo_receipt = $this->cargo_receipt;
		$newObj->gate_pass_id = $this->gate_pass_id;
		$newObj->driver_id = $this->driver_id;
		$newObj->agg_pod_id = $this->agg_pod_id;
		$newObj->type = $this->type;
		$newObj->started = $this->started;
		$newObj->note = $this->note;
		$newObj->meta = $this->meta;
		$newObj->mdata = $this->mdata;
		$newObj->started = $this->started;
   		$newObj->type = $this->type;
		$newObj->sub_type = $this->sub_type;
		$newObj->dpt_id = $this->dpt_id;
		$newObj->was_interstate = $this->was_interstate;
		$newObj->date = date('Y-m-d H:i:s');
		return $newObj;
	}

	public function getFullStatus()
	{
		$subStatus = "";
		$shipmentPre = ShipmentWhPrepare::model()->find(" shipment_id = :sid", [":sid" => $this->shipment_id]);
		if (isset($this->mdata['NotPickUp']) && $this->mdata['NotPickUp'] == 1) {
			$subStatus = $subStatus . "<font color=\"red\">[RE]</font>";
		}

		if (($this->status == self::WAITINGDELIVERY || $this->status == self::WAITINGAGENTDELIVERY) && $this->isDriverDeliveried() == self::DELIVERIED) {
			$subStatus = $subStatus . "<font color=\"green\">[D]</font>";
		}

		if (!empty($shipmentPre)) {

			if ($shipmentPre->status == ShipmentWhPrepare::PREPARED) {
				$subStatus = $subStatus . "<font color=\"green\">[P]</font>";
			} else if ($shipmentPre->status == ShipmentWhPrepare::CANCELED) {
				$subStatus = $subStatus . "<font color=\"BLUE\">[C]</font>";
			}
		}

		if (!empty($this->mdata['confirm_winit_booking'])) {
			$subStatus = $subStatus . "<font color=\"green\">[W]</font>";
		}

		if (!empty($this->mdata['sendEmailNotie']) || !empty($this->mdata['sendSmsNotie'])) {
			$subStatus = $subStatus . "<font color=\"BLUE\">[N]</font>";
		}
		if (!empty($this->mdata['responsed_notice'])) {
			$subStatus = $subStatus . "<font color=\"green\">[R]</font>";
		}

		if (isset($this->mdata['customer_confirmed']['surcharge_invoice'])) {
			$objInvoice = Invoice::model()->findByPk($this->mdata['customer_confirmed']['surcharge_invoice']);
			if ($objInvoice->status == Invoice::INVOICE_STATUS_PAID) {
				$subStatus = $subStatus . "<font color=\"orange\">[I]</font>";
				$subStatus = $subStatus . "<font color=\"mediumpurple\">[P]</font>";
			}
		}

		return self::$processTypes_courier_service[$this->status] . $subStatus;
	}

	public function calculateDptId()
	{
		if (!empty($this->dpt_id)) {
			return $this->dpt_id;
		}
		if (!empty($this->shipment->consol)) {
			$this->dpt_id = $this->shipment->consol->dpt_id;
			return $this->dpt_id;
		} else if (!empty($this->shipment->ddpt_id)) {
			$this->dpt_id = $this->shipment->ddpt_id;
			return $this->dpt_id;
		} else {
			$podSetting = SystemSetting::getCargoProcessPodSetting();
			foreach ($podSetting as $key => $pod) {
				if (!empty($pod['postcode'])) {
					if (preg_match('/^' . explode('%', $pod['postcode'])[0] . '/', $this->shipment->cnee->postcode)) {
						$this->dpt_id = $pod['pod_id'];
						return $this->dpt_id;
					}
				} else if (!empty($pod['state'])) {
					if (($pod['state'] == $this->shipment->cnee->state)) {
						$this->dpt_id = $pod['pod_id'];
						return $this->dpt_id;
					}
				}
			}
		}
		return $this->dpt_id;
	}

	public function getDepot()
	{
		return Org::model()->findbypk($this->dpt_id)->name;
	}



	/**
	 * Retrieves a list of models based on the current search/filter conditions.
	 *
	 * Typical usecase:
	 * - Initialize the model fields with values from filter form.
	 * - Execute this method to get CActiveDataProvider instance which will filter
	 * models according to data in model fields.
	 * - Pass data provider to CGridView, CListView or any similar widget.
	 *
	 * @return CActiveDataProvider the data provider that can return the models
	 * based on the search/filter conditions.
	 */
	public function search($pgn = true, $ps = 50, $ec = false, $defaultOrder = true, $podId = 106, $cargo_type = null,$isBackend = false)
	// @todo Please modify the following code to remove attributes that should not be searched.
	{
		$criteria = new CDbCriteria;
		if (!$isBackend&&User::getCurrentUserType() == User::IMPORT_TRUCK_DELIVERY) {
			$this->assignedUser = User::currentUserID();
		}

		$criteria->compare('shipment_id', $this->shipment_id);
		$criteria->compare('driver_id', $this->driver_id);
		$criteria->compare('shipment.pkg', $this->pkg, true);
		$criteria->compare('shipment.weight', $this->weight, true);
		$criteria->compare('comp_date', $this->comp_date, true);
		$criteria->compare('was_interstate',$this->was_interstate);
		if (!empty($this->cbm)) {
			if (preg_match('/[>|<|=]/', $this->cbm)) {
				$criteria->addCondition(' (shipment.pkg*shipment.cbm) ' . $this->cbm);
			} else {
				$criteria->addCondition(' (shipment.pkg*shipment.cbm) = ' . $this->cbm);
			}
		}

		if (!empty($this->region)) {
			$criteria->addCondition(' json_value(t.meta,"$.region") = "' . $this->region . '"');
		}

		if (!empty($this->plt)) {
			if (preg_match('/[>|<|=]/', $this->cbm)) {
				$criteria->addCondition(' json_value(shipment.meta,"$.amzon_pallet") ' . $this->plt);
			} else {
				$criteria->addCondition(' json_value(shipment.meta,"$.amzon_pallet") = ' . $this->plt);
			}
		}

		if (!empty($this->outturn)) {
			//2022-04-26 not need outtrun just need scan
			//$criteria->addCondition(' json_value(t.meta,"$.outturn") = 1');

			$criteria->addCondition("shipment.scan != '' and LENGTH(shipment.ref) < 15");
		}

		if (!empty($this->clear)) {
			$criteria->addCondition("shipment.status = 60");
		}

		if (!empty($this->isProblemApprove)) {
			$criteria->addCondition("t.status != 98");
			$criteria->addCondition(' json_value(t.meta,"$.problemcargo") = 1');
		}


		if ($this->exInfo == ImParcel::DGBWFCODE) {
			$criteria->addCondition('json_value(shipment.meta,"$.is_dg") = 1');
		}

		if ($this->isFBA == 1 || $this->isB2B == 1 || $this->isB2C == 1 || $this->isInterState) {
			$strType = "";
			if ($this->isFBA == 1) {
				$strType .= "2,";
			}
			if ($this->isB2B == 1) {
				$strType .= "4,";
			}
			if ($this->isB2C == 1) {
				$strType .= "1,";
			}
			if ($this->isInterState == 1) {
				$strType .= "6,";
			}
			$strType = rtrim($strType, ",");
			$criteria->addCondition('t.type in (' . $strType . ')');
		}

		if ($this->isSyd == 1 || $this->isMel == 1 || $this->isBne == 1) {
			$strDepot = "";
			if ($this->isSyd == 1) {
				$strDepot .= "106,";
			}
			if ($this->isMel == 1) {
				$strDepot .= "218,";
			}
			if ($this->isBne == 1) {
				$strDepot .= "530,";
			}
			$strDepot = rtrim($strDepot, ",");
			$criteria->addCondition('t.dpt_id in (' . $strDepot . ')');
		}

		if (!empty($this->skipPickUp)) {
			$criteria->addCondition('t.type != 3 and t.type != 5');
		}

		// if(!empty($this->dpt_id)){
		// 	$criteria->addCondition("t.dpt_id = 106");
		// }

		if (!empty($this->staDate)) {//started -> comp_date
			$criteria->addCondition('t.comp_date >= "' . $this->staDate . ' 00:00:00"');
		}

		if (!empty($this->endDate)) {
			$criteria->addCondition('t.comp_date <= "' . $this->endDate . ' 23:59:59"');
		}

		if(!empty($this->fromDate)){
			$criteria->addCondition('t.started >= "' . $this->fromDate . ' 00:00:00"');
		}

		if(!empty($this->toDate)){
			$criteria->addCondition('t.started <= "' . $this->toDate . ' 23:59:59"');
		}

		if (!empty($this->sub_type)) {
			$criteria->addCondition('t.sub_type & ' . $this->sub_type . ' > 0');
		}

		$criteria->compare('shipment.can', $this->memo, true);
		$criteria->compare('cnee.name', $this->cname, true);
		$criteria->compare('cnee.tel', $this->tel, true);
		$criteria->compare('cnee.address', $this->address, true);
		$criteria->compare('cnee.suburb', $this->suburb, true);
		$criteria->compare('cnee.state', $this->state, true);
		$criteria->compare('cnee.postcode', $this->postcode, true);

		if (!empty($this->is_3pl)) {
			$criteria->addCondition('json_value(shipment.meta,"$.wmstask_id") is not null');
		}


		if (!empty($this->status)) {
			$criteria->compare('t.status', $this->status);
		} else {
			if (empty($this->isSearchJob)) {
				$criteria->addCondition("t.status < " . self::PROCESSDONE);
			}
		}

		if (!empty($this->note)) {
			$criteria->addCondition("t.note like '%{$this->note}%'");
		}

		$criteria->join = ' join shipment s on s.id = shipment_id left join consol c on c.id = s.consol_id';
		if (!empty($this->consol_no)) {
			$criteria->compare('c.no', $this->consol_no, true);
		}
		//
		$criteria->compare('c.awb', $this->awb, true);

		$criteria->addCondition("shipment.status != 100");
		if (!empty($this->goodsAvailableAddress)) {
			$criteria->addCondition(' json_value(c.meta,"$.arrival_cfs") like "%' . $this->goodsAvailableAddress . '%"');
		}

		if (!empty($this->hbn)) {
			$criteria->addCondition("s.hbn like '%{$this->hbn}%'");
		}

		if (!empty($this->ref)) {
			$criteria->addCondition("s.ref like '%{$this->ref}%'");
		}

		if (!empty($this->assignedUser)) {
			$criteria->addCondition(" t.meta like '%\"assigned_user\":\"{$this->assignedUser}\"%'");
		}

		if(!empty($this->interstate_type)){
			if($this->interstate_type==1){
				$criteria->compare('t.dpt_id',$podId, true);
			}elseif($this->interstate_type==2){
				if($podId==106){
					$criteria->compare('upper(cnee.state)','NSW', true);
				}elseif($podId==218){
					$criteria->compare('upper(cnee.state)','VIC', true);
				}elseif($podId==530){
					$criteria->compare('upper(cnee.state)','QLD', true);
				}
			}
		}else{
			if ($podId != null) {
				$pod = SystemSetting::getCargoProcessPodSetting($podId);
				$state = @$pod["postcode"];
				$selectStateStr = "postcode like ";
				$sql = "";
				if (empty($state)) {
					$state = @$pod["state"];
					$selectStateStr = "state = ";
				}
	
				$state = "'" . $state . "'";
	
	
				if ($cargo_type == self::PICKUP_CARGO || $this->type == self::PICKUP_CARGO) {
					$criteria->addCondition("c.dpt_id = {$podId} or t.dpt_id = {$podId}");
				} else {
					//$criteria->addCondition("(cnee.{$selectStateStr} " . $state . " or json_value(t.meta,'$.goods_state') = " . $state . ") or t.dpt_id = {$podId}");
					$criteria->addCondition("(json_value(t.meta,'$.goods_state') = " . $state . ") or t.dpt_id = {$podId}");
				}
			}
		}

		if(!empty($this->paid_interstate)){
			$criteria->addCondition(' ((json_value(t.meta,"$.interstateotno") is not null and json_value(t.meta,"$.interstateotno") !="") or json_value(t.meta,"$.need_invoice")=0) and json_value(t.meta,"$.inputcostinterstate") is not null and json_value(t.meta,"$.inputcostinterstate") !=""  and json_value(t.meta,"$.third_part_label_no") is not null and json_value(t.meta,"$.third_part_label_no") !=""');
		}

		$criteria->compare('shipment.agent_id', $this->agent_id, true);

		if ($cargo_type != null || $this->type != null) {
			if ($cargo_type == self::NORMAL_CARGO || $this->type == self::NORMAL_CARGO) {

				// $criteria->addCondition("ad.postcode not in ( ".self::FBAPOSTCODE.")");
				$criteria->addCondition("t.type =" . self::NORMAL_CARGO);
				if ($this->_deliveryBookingTime != null) {
					$criteria->addCondition(" cargo_delivery_info.delivery_booking_time like binary '%{$this->_deliveryBookingTime}%'  ");
				}
			} else if ($cargo_type == self::PALLET_CARGO || $this->type == self::PALLET_CARGO) {

				// $criteria->addCondition("ad.postcode not in ( ".self::FBAPOSTCODE.")");
				$criteria->addCondition("t.type =" . self::PALLET_CARGO);
				if ($this->_deliveryBookingTime != null) {
					$criteria->addCondition(" cargo_delivery_info.delivery_booking_time like binary '%{$this->_deliveryBookingTime}%'  ");
				}
			} else if ($cargo_type == self::FBA_CARGO || $this->type == self::FBA_CARGO) {
				// $criteria->addCondition("ad.postcode in ( ".self::FBAPOSTCODE.")");
				$criteria->addCondition("t.type =" . self::FBA_CARGO);
				if ($this->_deliveryBookingTime != null) {
					$criteria->addCondition(" amazon_info.amazon_booking_time like binary '%{$this->_deliveryBookingTime}%'  ");
				}
			} else if ($cargo_type == self::B2B_CARGO || $this->type == self::B2B_CARGO) {

				// $criteria->addCondition("ad.postcode not in ( ".self::FBAPOSTCODE.")");
				$criteria->addCondition("t.type =" . self::B2B_CARGO);
				if ($this->_deliveryBookingTime != null) {
					$criteria->addCondition(" cargo_delivery_info.delivery_booking_time like binary '%{$this->_deliveryBookingTime}%'  ");
				}
			} else if ($cargo_type == self::PICKUP_CARGO || $this->type == self::PICKUP_CARGO) {
				// $criteria->addCondition("ad.postcode in ( ".self::FBAPOSTCODE.")");
				$criteria->addCondition("t.type =" . self::PICKUP_CARGO);
			} else if ($cargo_type == self::INTERSTATE_CARGO || $this->type == self::INTERSTATE_CARGO) {
				// $criteria->addCondition("ad.postcode in ( ".self::FBAPOSTCODE.")");
				$criteria->addCondition("t.type =" . self::INTERSTATE_CARGO);
				if ($this->_deliveryBookingTime != null) {
					$criteria->addCondition(" amazon_info.amazon_booking_time like binary '%{$this->_deliveryBookingTime}%'  ");
				}
			}
		}

		if ($this->agentId != null) {
			$criteria->addCondition("s.agent_id = " . $this->_agentId);
		}

		


		$with = array(
			'shipment',
			'shipment.receiver',
			'amazon_info',
			'cargo_delivery_info',
			'shipment.cnee',
			'shipment.cnor',
			'shipment.consol',
		);

		if(!empty($this->hasBidding)){
			if($this->hasBidding == 1){
				$with[]='cargo_process_bidding';
				$criteria->addCondition('cargo_process_bidding.count = 0');
			}elseif($this->hasBidding == 2){
				$with[]='cargo_process_bidding';
				$criteria->addCondition('cargo_process_bidding.count > 0');
			}
		}

		if (!empty($this->isCreateJob)) {
			$with[] = 'job_relation';
			$criteria->addCondition('(t.status = ' . self::WAITINGASSIGNDRIVER . ' or (t.status = ' . self::RTSDELIVERY . ' and json_value(t.meta,"$.redeliverypaid")=1)) and job_relation.id is null');
		}

		if (!empty($this->isSearchJob)) {
			if(!empty($this->isInterStateJob)){
				$with[] = 'job_relation_all';
				$criteria->addCondition('job_relation_all.job_id = ' . $this->jobId,);
			}else{
				$with[] = 'job_relation';
				$criteria->addCondition('job_relation.job_id = ' . $this->jobId);
			}
		}

		$criteria->with = $with;
		$criteria->together = true;
		$sort = new CSort();
		
		if ($cargo_type == self::FBA_CARGO || $this->type == self::FBA_CARGO) {
			$sort->attributes = [
				'deliveryBookingTime' => [
					'asc' => 'amazon_info.amazon_booking_time ASC, cnee.postcode DESC, t.started ASC',
					'desc' => 'amazon_info.amazon_booking_time DESC, cnee.postcode DESC , t.started ASC',
				], 'status' => [
					'asc' => 't.status ASC, t.started ASC',
					'desc' => 't.status DESC, t.started ASC',
				],
			];
			$sort->defaultOrder = 'amazon_info.amazon_booking_time ASC, cnee.postcode DESC, t.started ASC';
		} else if ($cargo_type == self::NORMAL_CARGO || $this->type == self::NORMAL_CARGO || $cargo_type == self::B2B_CARGO || $this->type == self::B2B_CARGO || $cargo_type == self::PALLET_CARGO || $this->type == self::PALLET_CARGO) {
			$sort->attributes = [
				'deliveryBookingTime' => [
					'asc' => 'cargo_delivery_info.delivery_booking_time',
					'desc' => 'cargo_delivery_info.delivery_booking_time DESC',
				], 'status' => [
					'asc' => 't.status ASC',
					'desc' => 't.status DESC',
				], 'comp_date' =>[
					'asc' => 't.comp_date ASC',
					'desc' => 't.comp_date DESC',
				],
			];
			$sort->defaultOrder = 'cargo_delivery_info.delivery_booking_time,t.started DESC';
		}

		if (!empty($this->isSearchJob)) {
			if(!empty($this->isInterStateJob)){
				$sort->defaultOrder = 'job_relation_all.sequence,t.id';
			}else{
				$sort->defaultOrder = 'job_relation.sequence,t.id';
			}
			
		}

		if (!empty($this->clear)) {
			$sort->defaultOrder = 'shipment.status DESC';
		}

		// 	'*',
		// ];
		// if ($defaultOrder) {
		// 	$sort->defaultOrder = 't.bwf DESC, t.id DESC';
		// } else {
		// 	$sort->defaultOrder = 't.id DESC';
		// }
		// $sob = $sort->getOrderBy();
		// $sobs = preg_split('/, */', $sob);
		// foreach ($sobs as $ob) {
		// 	if (!strpos($ob, '.')) {
		// 		continue;
		// 	}
		// 	list($m, $f) = explode('.', $ob);
		// 	if (str_replace('`', '', $m) == 't') {
		// 		continue;
		// 	}
		// 	$with[] = $m;
		// }



		// in case sub-gridview, we need consol_id set by parent grid view
		$pagerparams = $_GET;

		return new CActiveDataProvider($this, array(
			'criteria' => $criteria,
			'sort' => $sort,
			'pagination' => $pgn ? [
				'pageSize' => $ps,
				'params' => $pagerparams,
			] : false,
		));
	}



	/**
	 * Retrieves a list of models based on the current search/filter conditions.
	 *
	 * Typical usecase:
	 * - Initialize the model fields with values from filter form.
	 * - Execute this method to get CActiveDataProvider instance which will filter
	 * models according to data in model fields.
	 * - Pass data provider to CGridView, CListView or any similar widget.
	 *
	 * @return CActiveDataProvider the data provider that can return the models
	 * based on the search/filter conditions.
	 */
	public function getJobList($type, $pgn = true, $ps = 30)
	// @todo Please modify the following code to remove attributes that should not be searched.
	{
		$criteria = new CDbCriteria;
		if ($type != 'global') {
			if (!empty($this->isSearchJob)) {
				$criteria->compare('driver_id', $this->driver_id);
			}
		}

		$criteria->join = ' join shipment s on s.id = shipment_id left join consol c on c.id = s.consol_id left join amazon_info ai on ai.fid = t.id and ai.model="CargoProcess" left join cargo_delivery_info cdi on cdi.shipment_id = t.id and cdi.model="CargoProcess" left join addr ad on ad.id = s.cnee_id ';

		if (!User::checkIsNotTruckUser() && $type != 'fba' && $type != 'b2b') {
			$criteria->addCondition("t.type =" . self::NORMAL_CARGO);
		} else {
			$criteria->addCondition("t.type =" . self::FBA_CARGO . " or t.type=" . self::B2B_CARGO);
		}

		if ($type == 'global') {
			$criteria->addCondition("t.status = " . self::AGENTWAITINGASSIGNDRIVER . " or t.status = " . self::WAITINGAGENTDELIVERY);
			$regionStr = "";
			$allSetting = SystemSetting::getCargoProcessPodSetting();
			$regionStr = "";
			$selectStateStr = "postcode like ";
			foreach ($allSetting as $key => $value) {
				if ((User::getCurrentUser()->org->cargo_driver_type & $value['cargo_driver']) > 0) {
					$state = $value["postcode"];
					if (empty($state)) {
						$state = @$value["state"];
						$selectStateStr = "state = ";
					}

					$state = "'" . $state . "'";

					if (empty($regionStr)) {
						$regionStr = "ad.{$selectStateStr} " . $state;
					} else {
						$regionStr .= " or ad.{$selectStateStr} " . $state;
					}
				}
			}

			if (!empty($regionStr)) {
				$criteria->addCondition($regionStr);
			}
		}

		if ($type == 'my') {
			$criteria->addCondition("t.driver_id = " . $this->driver_id);
			if (!empty($this->deliveriedStatus) || ($this->deliveriedStatus == 0 && $this->deliveriedStatus != "")) {
				if ($this->deliveriedStatus == self::DELIVERIED) {
					$criteria->addCondition('t.meta like \'%"driverDeliveryStatus":' . self::DELIVERIED . '%\'  or t.status >' . self::WAITINGAGENTDELIVERY);
				} else {
					$criteria->addCondition('t.meta not like \'%"driverDeliveryStatus":' . self::DELIVERIED . '%\' and t.status <' . self::AGENTDELIVERYDONE);
				}
			}
		}
		if ($type == 'fba' || $type == 'b2b') {
			$criteria->addCondition("t.driver_id = " . $this->driver_id);
			if (!empty($this->deliveriedStatus) || ($this->deliveriedStatus == 0 && $this->deliveriedStatus !== "")) {
				if ($this->deliveriedStatus == self::DELIVERIED) {
					$criteria->addCondition('t.meta like \'%"driverDeliveryStatus":' . self::DELIVERIED . '%\'  or t.status >' . self::WAITINGAGENTDELIVERY);
				} else {
					$criteria->addCondition('t.meta not like \'%"driverDeliveryStatus":' . self::DELIVERIED . '%\' and t.status <' . self::AGENTDELIVERYDONE);
				}
			}
		}


		if ($type == 'all') {
			if (!$isBackend&&User::getCurrentUserType() == User::IMPORT_TRUCK_DELIVERY) {
				$this->assignedUser = User::currentUserID();
			}

			if (!empty($this->assignedUser)) {
				$criteria->addCondition(" t.meta like '%\"assigned_user\":\"{$this->assignedUser}\"%'");
			}

			if (!empty($this->status)) {
				$criteria->compare('t.status', $this->status);
			} else {
				$criteria->addCondition("t.status = " . self::WAITINGDELIVERY . " or t.status = " . self::WAITINGAGENTDELIVERY . " or t.status =" . self::AGENTDELIVERYDONE . " or t.status =" . self::PROCESSDONE);
			}

			$criteria->addCondition("t.driver_id > 0");
		}


		if (!empty($this->hbn)) {
			$criteria->addCondition("s.hbn like '%{$this->hbn}%'");
		}

		if (!empty($this->ref)) {
			$criteria->addCondition("s.ref like '%{$this->ref}%'");
		}

		if ($this->_deliveryBookingTime != null) {
			$criteria->addCondition(" (cargo_delivery_info.delivery_booking_time is not null and cargo_delivery_info.delivery_booking_time like binary '%{$this->_deliveryBookingTime}%' ) or (ai.amazon_booking_time is not null and ai.amazon_booking_time like binary '%{$this->_deliveryBookingTime}%')  ");
		}

		if (!empty($this->searchFrom)) {
			$criteria->addCondition(" cargo_delivery_info.delivery_booking_time >= '{$this->searchFrom}'  ");
		}

		if (!empty($this->searchTo != null)) {
			$criteria->addCondition("cargo_delivery_info.delivery_booking_time <= '{$this->searchTo}'  ");
		}

		$criteria->compare("t.type", $this->type);
		$with = array(
			'shipment',
			'shipment.receiver',
			'cargo_delivery_info',
		);

		if (!empty($this->isSearchJob)) {
			$with[] = 'job_relation';
			$criteria->addCondition('job_relation.job_id = ' . $this->jobId);
		}

		$criteria->with = $with;
		$criteria->together = true;
		$sort = new CSort();

		if ($type != 'fba') {
			$sort->attributes = [
				'deliveryBookingTime' => [
					'asc' => 'cargo_delivery_info.delivery_booking_time',
					'desc' => 'cargo_delivery_info.delivery_booking_time DESC',
				], 'status' => [
					'asc' => 't.status ASC',
					'desc' => 't.status DESC',
				],
			];
			if (!empty($this->isSearchJob)) {
				$sort->defaultOrder = 'job_relation.sequence,t.id';
			} else {
				$sort->defaultOrder = 'cargo_delivery_info.delivery_booking_time DESC';
			}
		} else {
			$sort->attributes = [
				'deliveryBookingTime' => [
					'asc' => 'ai.amazon_booking_time',
					'desc' => 'ai.amazon_booking_time  DESC',
				], 'status' => [
					'asc' => 't.status ASC',
					'desc' => 't.status DESC',
				],
			];
			$sort->defaultOrder = 'ai.amazon_booking_time';
		}

		if ($type == 'fba') {
			$criteria->group = "ai.amazon_booking_time,json_value(shipment.meta,'$.delivery_address')";
		}

		// in case sub-gridview, we need consol_id set by parent grid view
		$pagerparams = $_GET;
		return new CActiveDataProvider($this, array(
			'criteria' => $criteria,
			'sort' => $sort,
			'pagination' => $pgn ? [
				'pageSize' => $ps,
				'params' => $pagerparams,
			] : false,
		));
	}


	/**
	 * Retrieves a list of models based on the current search/filter conditions.
	 *
	 * Typical usecase:
	 * - Initialize the model fields with values from filter form.
	 * - Execute this method to get CActiveDataProvider instance which will filter
	 * models according to data in model fields.
	 * - Pass data provider to CGridView, CListView or any similar widget.
	 *
	 * @return CActiveDataProvider the data provider that can return the models
	 * based on the search/filter conditions.
	 */
	public function getJobCargosList($type, $pgn = true, $ps = 30)
	// @todo Please modify the following code to remove attributes that should not be searched.
	{
		$criteria = new CDbCriteria;

		$criteria->join = ' join shipment s on s.id = shipment_id left join consol c on c.id = s.consol_id left join amazon_info ai on ai.fid = t.id and ai.model="CargoProcess" left join cargo_delivery_info cdi on cdi.shipment_id = t.id and cdi.model="CargoProcess" left join addr ad on ad.id = s.cnee_id ';

		if (!empty($this->hbn)) {
			$criteria->addCondition("s.hbn like '%{$this->hbn}%'");
		}

		if (!empty($this->ref)) {
			$criteria->addCondition("s.ref like '%{$this->ref}%'");
		}


		if ($this->_deliveryBookingTime != null) {
			$criteria->addCondition(" (cargo_delivery_info.delivery_booking_time is not null and cargo_delivery_info.delivery_booking_time like binary '%{$this->_deliveryBookingTime}%' ) or (ai.amazon_booking_time is not null and ai.amazon_booking_time like binary '%{$this->_deliveryBookingTime}%')  ");
		}
		if (!empty($this->deliveriedStatus) || ($this->deliveriedStatus == 0 && $this->deliveriedStatus != "")) {
			if ($this->deliveriedStatus == self::DELIVERIED) {
				$criteria->addCondition('t.meta like \'%"driverDeliveryStatus":' . self::DELIVERIED . '%\'  or t.status >' . self::WAITINGAGENTDELIVERY);
			} else {
				$criteria->addCondition('t.meta not like \'%"driverDeliveryStatus":' . self::DELIVERIED . '%\' and t.status <' . self::AGENTDELIVERYDONE);
			}
		}

		$with = array(
			'shipment',
			'shipment.receiver',
			'cargo_delivery_info',
		);

		if (!empty($this->isSearchJob)) {
			$with[] = 'job_relation';
			$criteria->addCondition('job_relation.job_id = ' . $this->jobId);
		}

		$criteria->with = $with;
		$criteria->together = true;
		$sort = new CSort();
		$sort->defaultOrder = 'job_relation.sequence';

		if ($type == 'fba') {
			$criteria->group = "ai.amazon_booking_time,json_value(shipment.meta,'$.delivery_address')";
		}

		// in case sub-gridview, we need consol_id set by parent grid view
		$pagerparams = $_GET;
		return new CActiveDataProvider($this, array(
			'criteria' => $criteria,
			'sort' => $sort,
			'pagination' => $pgn ? [
				'pageSize' => $ps,
				'params' => $pagerparams,
			] : false,
		));
	}

	public function getAssignedAgent()
	{
		$userId = isset($this->mdata['assigned_user']) ? $this->mdata['assigned_user'] : "";
		return @User::model()->findByPk($userId)->fname;
	}

	public function getShowColor($type = false)
	{
		if ($type == "held") {
			if ($this->shipment->status < ImParcel::STATE_CLEAR && $this->shipment->status != ImParcel::STATE_LOCAL_ARRIVAL) {
				if ($this->status > CargoProcess::AGENTCOLLECTINFO) {
					return "cloumn_red_1";
				} else {
					return "";
				}
			}elseif($this->shipment->status == ImParcel::STATE_CLEAR){
				return "column_direct";
			}
		}

		if($type == "clear"){
			if ($this->shipment->status != ImParcel::STATE_CLEAR){
				return "cloumn_red_1";
			}
		}

		if ($type == "last_process_time") {
			if (strtotime($this->getLastProcessTime()) <= strtotime("-3 day", strtotime(date("Y-m-d")))) {
				return "cloumn_red_1";
			} else {
				return "";
			}
		}

		if ($type == "first_process_time") {
			if (strtotime($this->getLastProcessTime()) <= strtotime("+3 day", strtotime($this->getFirstProcessTime()))) {
				return "cloumn_red_1";
			} else {
				return "";
			}
		}

		if ($type == "pickup") {
			if (strpos(@$this->shipment->mdata['pickup_booking_time'], date("Y-m-d")) !== false) {
				return "cloumn_orange_1";
			}
			if (strpos(@$this->shipment->mdata['pickup_booking_time'], date("Y-m-d", strtotime("-1 day"))) !== false) {
				return "cloumn_red_1";
			}
		}

		if ($type == "pkg") {
			if (($this->shipment->scan_no != 0) && empty($p->mdata['acu'])) {
				return "cloumn_red_1";
			} else {
				return "";
			}
		}

		if($type == "unpacking"){
			if(!empty($this->shipment->consol))
			{
				if ($this->shipment->scanCount()>0){
					return "";
				}else{
					if(strtotime($this->shipment->consol->mdata['ContainerUnloadDate'])>=strtotime(date('Y-m-d H:i:s',strtotime("1 day")))){
						return "cloumn_orange_1";
					}else{
						return "cloumn_red_1";
					}
					
				}
			}
		}

		if($type == "bookingtime"){
			if ($this->shipment->scanCount()>0){
				return "";
			}else{
				if(strtotime($this->getDeliveryBookingTime())>=strtotime(date('Y-m-d H:i:s',strtotime("1 day")))){
					return "cloumn_orange_1";
				}else{
					return "cloumn_red_1";
				}
				
			}
		}

		if($type == "forklift"){
			if(isset($this->mdata['custconfirmforklift'])&&$this->mdata['custconfirmforklift']==1){
				return "column_direct";
			}
			return "cloumn_red_1";
		}


		if (strpos($this->getDeliveryBookingTime(), date("Y-m-d")) !== false) {
			return "cloumn_orange_1";
		}
		if (strpos($this->getDeliveryBookingTime(), date("Y-m-d", strtotime("-1 day"))) !== false) {
			return "cloumn_red_1";
		}

		
	}
	public function getShipmentPod()
	{
		$pods = SystemSetting::getCargoProcessPodSetting();
		foreach ($pods as $key => $pod) {
			$postcode = @$pod['postcode'];
			if (!empty($postcode)) {
				if (!empty($this->mdata['goods_state'])) {
					if ($postcode == $this->mdata['goods_state']) {
						return $pod['cargo_driver'];
					}
				} else {
					if (preg_match("/" . explode('%', $postcode)[0] . "\d{3}/i", $this->shipment->cnee->postcode)) {
						return $pod['cargo_driver'];
					}
				}
			}

			$state = @$pod['state'];
			if (!empty($state)) {
				if ($state == $this->shipment->cnee->state) {
					return $pod['cargo_driver'];
				}
			}
		}
		// if(preg_match("/".self::SYDHEAD."\d{3}/i", $this->shipment->cnee->postcode))
		// {
		// 	return Org::SYDNEY_CARGO_DRIVER;
		// }else if(preg_match("/".self::MELHEAD."\d{3}/i", $this->shipment->cnee->postcode))
		// {
		// 	return Org::MELBOURNE_CARGO_DRIVER;
		// }
	}

