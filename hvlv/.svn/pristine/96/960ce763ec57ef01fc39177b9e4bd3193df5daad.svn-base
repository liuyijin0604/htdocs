	public function noticeClientBookingWinit()
	{
		if ($this->status == self::WAITINGWINITBOOKING && !empty($this->mdata['delivery_booking_time'])) {
			$email = '';
			$org = Org::model()->findByPk($this->shipment->agent_id);
			if (!empty($org->extra['outturn_email'])) {
				$email = trim($org->extra['outturn_email']);
			}
			$date = $this->mdata['delivery_booking_time'];
			$YEAR = date('Y', strtotime($date));
			$MONTH = date('m', strtotime($date));
			$DAY = date('d', strtotime($date));
			$HOUR = date('H', strtotime($date));
			$MINUTE = date('i', strtotime($date));

			$lastworkingDay = HolidayHelper::getLastWeekday($date, $this->shipment->consol->pod);

			$YEAR2 = date('Y', strtotime($lastworkingDay));
			$MONTH2 = date('m', strtotime($lastworkingDay));
			$DAY2 = date('d', strtotime($lastworkingDay));

			$emailLog = new Emailog();
			$emailLog->to_id = $this->shipment->agent_id;
			$emailLog->fid = $this->shipment->id;

			if ($this->is4PX()) {
				$emailLog->type = Emailog::FOURPX_NOTICE;
			} elseif ($this->isWinit()) {
				$emailLog->type = Emailog::WINIT_NOTICE;
			} elseif ($this->isPadstow()) {
				$emailLog->type = Emailog::PADSTOW_NOTICE;
			} elseif ($this->isGC()) {
				$emailLog->type = Emailog::GC_NOTICE;
			} else {
				$emailLog->type = Emailog::OTHER_NOTICE;
			}
			$emailLog->dt = date('Y-m-d H:i:s');
			$emailLog->status = 10;
			$emailLog->prepTemplate();
			$emailLog->tpl->assignSubject('SHIPMENT_NO', $this->getRef());
			$emailLog->tpl->assignThese([
				'SHIPMENT_NO' => $this->getRef(),
				'BOOKING_TIME' => $this->mdata['delivery_booking_time'],
				'PKG' => $this->shipment->pkg,
				'WEIGHT' => $this->shipment->weight,
				'CBM' => $this->shipment->getTotalCBM(),
				'ADDRESS' => $this->shipment->cnee->fullAddress(),
				'YEAR' => $YEAR,
				'MONTH' => $MONTH,
				'DAY' => $DAY,
				'HOUR' => $HOUR,
				'MINUTE' => $MINUTE,
				'YEAR2' => $YEAR2,
				'MONTH2' => $MONTH2,
				'DAY2' => $DAY2,
			]);
			$emailLog->subject = $emailLog->tpl->subject;
			$emailLog->body = $emailLog->tpl->getContent();
			$emailLog->mdata['to'] = $email;
			$emailLog->mdata['fromName'] = Org::IM_COMPANY_NAME;
			$emailLog->mdata['from'] = Org::IM_EMAIL;
			$emailLog->mdata['cc'] = Org::IM_EMAIL;
			$o = $emailLog->sendEmail();
			if ($o["status"]) {
				$this->mdata['is_send_winit_notice'] = 1;
				$this->save();
			} else {
				echo $o['msg'];
				Log::log2file("Winit Booking notice not send correctly:" . $this->shipment->hbn, "available_notice_failed", "account");
			}
		}
	}

	public function getStorageFee($type, $front = false)
	{
		if (empty($this->shipment->consol)) {
			return "";
		}
		if (($this->shipment->consol->service == Consol::AIRCONSOL && $this->type == CargoProcess::PICKUP_CARGO) || !($this->shipment->consol->isSYDMELWarehouse())) {
			return "";
		} else {
			if ($front) {
				if ($this->getStorageFee(0) != "" && $this->getStorageFee(0) > 0) {
					return "<p class='cloumn_red_1'>" . $this->shipment->getStorageFee()[$type] . "</p>";
				} else {
					return  $this->shipment->getStorageFee()[$type];
				}
			} else {
				return $this->shipment->getStorageFee()[$type];
			}
		}
	}
	public function getFirstTime()
	{
		return $this->logs[0]->time;
	}

	public function getPodName()
	{
		$pods = SystemSetting::getCargoProcessPodSetting();
		foreach ($pods as $key => $pod) {
			if (!empty($pod['postcode'])) {
				$postcodeHead = explode('%', $pod['postcode'])[0];
				if (preg_match("/^$postcodeHead/", $this->shipment->cnee->postcode)) {
					return $pod['pod'];
				}
			}

			if (!empty($pod['state'])) {
				if ($pod['state'] == $this->shipment->cnee->state) {
					return $pod['pod'];
				}
			}
		}
	}

	public function getCustomerResponse($key2 = false)
	{
		$str = "";
		if (!empty($this->mdata['customer_confirmed'])) {
			if(!empty($this->mdata['customer_confirmed']['surcharge_invoice'])){
				$strAppName = Yii::app()->name;
				Yii::app()->name = 'TLA';
				$objInvoice = Invoice::model()->findByPk($this->mdata['customer_confirmed']['surcharge_invoice']);
				Yii::app()->name = $strAppName;
				if(!empty($objInvoice)){
					if($objInvoice->status!=9){
						$key2 = ['address_type','business_unloading','OtherInquery'];
					}
				}
			}
			foreach ($this->mdata['customer_confirmed'] as $key => $value) {
				if (!empty($key2)) {
					if (!in_array($key, $key2)) {
						continue;
					}
				}
				if (is_array($value)) {
					$str .= join(',', $value) . "\n";
				} else {
					if ($value == 'Yes') {
						continue;
					}
					if ($key == 'OtherInquery') {
						$str .= $key . ": " . $value . "\n";
					} else if ($key == 'surcharge_invoice') {
						$strAppName = Yii::app()->name;
						Yii::app()->name = 'TLA';
						$objInvoice = Invoice::model()->findByPk($value);
						Yii::app()->name = $strAppName;
						$str .= $objInvoice->no . ' - ' . Invoice::$states[$objInvoice->status] . "\n";
					} else {
						$str .= $value . "\n";
					}
				}
			}
		}
		return $str;
	}

	public function getCustomerResponseForDriverPart()
	{
		$arrayList = array('leave_at_address', 'OtherInquery');
		$str = "";
		//$str = array('address_type','residential_unloading','unloading_street','OtherInquery','surcharge_invoice');
		$key2 = $arrayList;
		if (!empty($this->mdata['customer_confirmed'])) {
			foreach ($this->mdata['customer_confirmed'] as $key => $value) {
				if (!empty($key2)) {
					if (!in_array($key, $key2)) {
						continue;
					}
				}
				if (is_array($value)) {
					$str .= join(',', $value) . "\n";
				} else {
					$unloadingFee = "";
					if ($value == 'Yes') {
						continue;
					}
					if ($key == 'OtherInquery') {
						$str .= $key . ": " . $value . "\n";
					} else if ($key == 'surcharge_invoice') {
						$strAppName = Yii::app()->name;
						Yii::app()->name = 'TLA';
						$objInvoice = Invoice::model()->findByPk($value);
						$objInvoiceLines = InvLine::model()->findAll('inv_id = :inv_id', [':inv_id' => $objInvoice->id]);
						foreach ($objInvoiceLines as $objInvoiceLine) {
							if ($objInvoiceLine->ccode = 'Unloading Service') {
								$unloadingFee = round((($objInvoiceLine->amount) / 2), 2);
							}
						}
						Yii::app()->name = $strAppName;
						if (!empty($unloadingFee)) {
							$str .= 'Unloading Fee: ' . $unloadingFee . "\n";
						}
					} else {
						$str .= $value . "\n";
					}
				}
			}
		}
		return $str;
	}

	public function getUnloadingFee()
	{
		if (!empty($this->mdata['customer_confirmed'])) {
			foreach ($this->mdata['customer_confirmed'] as $key => $value) {
				if ($key == 'surcharge_invoice') {
					$strAppName = Yii::app()->name;
					Yii::app()->name = 'TLA';
					$objInvoice = Invoice::model()->findByPk($value);
					$objInvoiceLines = InvLine::model()->findAll('inv_id = :inv_id', [':inv_id' => $objInvoice->id]);
					foreach ($objInvoiceLines as $objInvoiceLine) {
						if ($objInvoiceLine->ccode = 'Unloading Service') {
							$unloadingFee = round((($objInvoiceLine->amount - $objInvoiceLine->gst) / 2), 2) - 5;
						}
					}
					Yii::app()->name = $strAppName;
					if (!empty($unloadingFee)) {
						return $unloadingFee;
					}
				}
			}
		}
		return "";
	}

	public function getRelatedOTFee()
	{
		$amount = 0;
		$modelShipment = $this->shipment;
		if (!empty($modelShipment)) {
			$strHbn = $modelShipment->hbn;
			$strRef = $modelShipment->ref;
			$strAppName = Yii::app()->name;
			Yii::app()->name = 'TLA';
			$modelInvoiceLines = InvLine::model()->with('invoice')->findAll('(invoice.status != 8 and invoice.status != 10) and (t.linkto like "%' . $strHbn . '%" or t.linkto like "%' . $strRef . '%")');
			if (!empty($modelInvoiceLines)) {
				foreach ($modelInvoiceLines as $modelInvoiceLine) {
					$arrTask = $modelInvoiceLine->getLinktoCount();
					$amount += ($modelInvoiceLine->amount - $modelInvoiceLine->gst) * $modelInvoiceLine->qty;
					if ($arrTask != 0) {
						$amount = number_format($amount / $arrTask, 2, '.', '');
					}
				}
			}
			Yii::app()->name = $strAppName;
		}
		return $amount;
	}

	public function getRelatedCredit(){
		$amount = 0;
