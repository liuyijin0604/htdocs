			$modelInvoiceLines = InvLine::model()->with('invoice')->findAll('(invoice.status = 6 or invoice.status = 7) and (t.linkto like "%' . $strHbn . '%" or t.linkto like "%' . $strRef . '%")');
			if (!empty($modelInvoiceLines)) {
				foreach ($modelInvoiceLines as $modelInvoiceLine) {
					$arrTask = $modelInvoiceLine->getLinktoCount();
				}
			}
			
		}
	}

	public function getSubTypes()
	{
		$info = '';
		foreach (self::$sTypeList as $k => $v) {
			if (($this->sub_type & $k) > 0) {
				$info .= empty($info) ? $v : ';' . $v;
			}
		}
		return $info;
	}

	public function getSentTime()
	{
		$smsNotices = OrmSmsNotice::model()->findAll('cargo_process_id =:cargo_process_id', [':cargo_process_id'=>$this->id]);

		if ($smsNotices==null)
			return "";
			//return $this->id."'s' SMS hasn't been sent yet.";
		else{
			$notices = " ";
			foreach ($smsNotices as $smsNotice) {
				switch ($smsNotice->is_processed) {
					case OrmSmsNotice::ONSCHEDULED:
						$notices .= " -scheduled SMS: ".$smsNotice->phone." ";
						break;
					case OrmSmsNotice::ONRECEIVED:
						$notices .= " -received SMS: ".$smsNotice->phone." ";
						break;
					case OrmSmsNotice::SENT:
						$notices .= " -sent SMS: ".$smsNotice->phone." ".$smsNotice->sent_time;
						break;
					case OrmSmsNotice::FALLSENT:
						$notices .= " -falled SMS: ".$smsNotice->phone." ".$smsNotice->sent_time;
						break;
					
					default:
						// code...
						break;
				}
					
			}
			return $notices;
		}
		
	}

