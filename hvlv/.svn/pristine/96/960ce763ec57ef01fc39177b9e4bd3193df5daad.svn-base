	public function setCargoType()
	{
		if (!empty($this->shipment->cnee->postcode)) {
			if (strpos(self::FBAPOSTCODE, $this->shipment->cnee->postcode) !== false) {
				$match = false;
				if (strpos(self::PUREFBAPOSTCODE, $this->shipment->cnee->postcode) !== false) {
					$this->type = self::FBA_CARGO;
					$regionData = SystemSetting::getFBARegionSetting("FBA");
					$regionData = $regionData[$this->shipment->cnee->postcode];
					if (!empty($regionData)) {
						foreach ($regionData as $key => $value) {
							$words = explode(' ', $value[0]);
							$thisMatch = true;
							foreach ($words as $key => $word) {
								$word = str_replace('/', '\/', $word);
								if (!empty($word)) {
									if (!(preg_match("/" . strtoupper($word) . "/",  strtoupper($this->shipment->cnee->address)) && (strtoupper(trim($value[1])) == strtoupper(trim($this->shipment->cnee->suburb))))) {
										$thisMatch = false;
										break;
									}
								}
							}
							if ($thisMatch) {
								$match = true;
								break;
							}
						}
						if (!$match) {
							// if (!empty($this->shipment->mdata['isPalletRequest']) && $this->shipment->mdata['isPalletRequest'] == 1) {
							// 	$this->type = self::PALLET_CARGO;
							// } else {
								$this->type = self::NORMAL_CARGO;
								if(!$this->shipment->scanCount()>0){
									$this->status = self::PREPROCESS;
									$this->mdata['AutoIntoJob']=1;
									$this->mdata['PreB2c']=1;
									$this->mdata['PreB2cSendSMS']=0;
								}
							//}
						}
					}
				}

				if (strpos(self::OVERSEAPOSTCODE, $this->shipment->cnee->postcode) !== false && !$match) {
					$this->type = self::B2B_CARGO;
					if(!$this->shipment->scanCount()>0 ){
						$this->status = self::PREPROCESS;
						$this->mdata['PreB2b']=1;
					}
					$regionData = SystemSetting::getFBARegionSetting("B2B");
					$regionData = $regionData[$this->shipment->cnee->postcode];
					if (!empty($regionData)) {
						$match = false;
						foreach ($regionData as $key => $value) {
							$words = explode(' ', $value[0]);
							$thisMatch = true;
							foreach ($words as $key => $word) {
								$word = str_replace('/', '\/', $word);
								if (!(preg_match("/" . strtoupper($word) . "/",  strtoupper($this->shipment->cnee->address)) && (strtoupper(trim($value[1])) == strtoupper(trim($this->shipment->cnee->suburb))))) {
									$thisMatch = false;
									break;
								}
							}
							if ($thisMatch) {
								$match = true;
								break;
							}
						}
						if (!$match) {
							$this->type = self::NORMAL_CARGO;
							if(!$this->shipment->scanCount()>0){
								$this->status = self::PREPROCESS;
								$this->mdata['AutoIntoJob']=1;
								$this->mdata['PreB2c']=1;
								$this->mdata['PreB2cSendSMS']=0;
							}
						}
					}
				}
			} else {
				$this->type = self::NORMAL_CARGO;
				if(!$this->shipment->scanCount()>0){
					$this->status = self::PREPROCESS;
					$this->mdata['AutoIntoJob']=1;
					$this->mdata['PreB2c']=1;
					$this->mdata['PreB2cSendSMS']=0;
				}
			}
		}
		//Interstate
		if(!empty($this->shipment->cnee->state) && $this->was_interstate != 1){
			$state = "";
			if(!empty($this->shipment->consol->dpt_id)){
				$state = Org::model()->findByPk($this->shipment->consol->dpt_id)->state;
			}else{
				$state = $this->shipment->cnor->state;
			}
			if(!empty($state)){
				if(strtoupper($state)!=strtoupper($this->shipment->cnee->state)){
					$this->type = self::INTERSTATE_CARGO;
					$this->status = CargoProcess::COLLECTINFO;
					$this->was_interstate = 1;
				}
			}
		}
	}


	public function getNote($isDplatform = false)
	{
		$str = "";
		if (empty($this->note)) {
			$str = "&nbsp;";
		} else {
			$str = $this->note;
		}

		if ($isDplatform) {
			$customs = $this->getCustomerResponse(["address_type"]);
			$str = $str . "</br>" . $customs;
		}
		return $str;
	}

	public function updateStatus($status, $type = false)
	{
		$update = false;
		if ($this->status != CargoProcess::PROCESSDONE && $status == CargoProcess::PROCESSDONE && $this->type != self::PICKUP_CARGO) {
			$this->status = $status;
			$this->processDone();
		}
		if (key_exists($status, self::$processTypes_courier_service)) {
			$this->status = $status;
			$update = true;
		}

		if ($update) {
			$this->save();
			$this->refresh();
		}
	}

	public function getStatus()
	{
		return isset(static::$processTypes[$this->status]) ? Yii::t(strtolower(__CLASS__), static::$processTypes[$this->status]) : $this->status;
	}

	public function afterSave()
	{
		//add log
		if (!empty($this)) {
			$extra = empty($this->note) ? [] : ['note' => $this->note];
			if ($this->status == self::PAPERWORK) {
				if (isset($this->gate_pass_id) && $this->gate_pass_id > 0) {
					$extra["generated_gate_pass"] = $this->gate_pass_id;
				}

				if (isset($this->cargo_receipt) && $this->cargo_receipt) {
					$extra["generated_cargo_receipt"] = true;
				}
			}

			if ($this->status == self::WAITINGWINITBOOKING) {
				if (!empty($this->mdata['confirm_winit_booking'])) {
					$extra["confirm_winit_booking"] = true;
				}
			}


			Log::add($this, $this->isNewRecord ? 3 : 4, array_merge(['status' => $this->getStatus()], $extra));
		}
	}
	public function log($action)
	{
		$extra = ["action" => $action];
		Log::add($this, $this->isNewRecord ? 3 : 4, array_merge(['status' => $this->getStatus()], $extra));
	}

	/**
	 * Returns the static model of the specified AR class.
	 * Please note that you should have this exact method in all your CActiveRecord descendants!
	 * @param string $className active record class name.
	 * @return CargoProcess the static model class
	 */
	public static function model($className = __CLASS__)
	{
		return parent::model($className);
	}

	public function assignUserAuto()
	{
		if ($this->getCargoType() == self::NORMAL_CARGO && $this->shipment->ddpt_id != Org::PCAE_DEPARTMENT_SYDNEY) {
			if ($this->status == self::COLLECTINFO && (empty($this->mdata['assigned_user']) || $this->mdata['assigned_user'] != "")) {
				$userList = User::getTruckUsers();
				if ($userList != null && sizeof($userList) > 0) {
					foreach ($userList as $key => $value) {
						$this->mdata['assigned_user'] = "{$key}";
						$this->status = CargoProcess::AGENTCOLLECTINFO;
						return true;
					}
				}
			}
		}
		return false;
	}
