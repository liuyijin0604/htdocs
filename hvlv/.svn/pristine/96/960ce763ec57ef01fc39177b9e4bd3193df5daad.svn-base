	public function getFBAConnote($type = false)
	{
		$criteria = new CDbCriteria();
		$criteria->with = array("shipment", "amazon_info", "cargo_delivery_info");

		if (!empty(@$this->amazon_info->amazon_booking_time)) {
			$criteria->addCondition(" (amazon_info.amazon_booking_time = '" . @$this->amazon_info->amazon_booking_time . "') or (cargo_delivery_info.delivery_booking_time = '" . @$this->amazon_info->amazon_booking_time . "') ");
		} else {
			$criteria->addCondition(" (amazon_info.amazon_booking_time = '" . @$this->cargo_delivery_info->delivery_booking_time . "') or (cargo_delivery_info.delivery_booking_time = '" . @$this->cargo_delivery_info->delivery_booking_time . "') ");
		}

		$criteria->addCondition(" json_value(shipment.meta,'$.delivery_address') = '" . @$this->shipment->mdata['delivery_address'] . "'");
		$criteria->addCondition(" t.driver_id = " . $this->driver_id);
		$criteria->addCondition(" t.type = " . $this->type);

		$results = CargoProcess::model()->findAll($criteria);
		$finalResult = [];
		foreach ($results as $key => $result) {
			if (!empty($finalResult[$result->shipment_id])) {
				$finalResult[$result->shipment_id]["packages"] += $result->getPackages();
			} else {
				$finalResult[$result->shipment_id] = ["hbn" => $result->shipment->hbn, "pallet" => @$result->shipment->mdata['amzon_pallet'], "packages" => $result->getPackages(), 'allPackages' => $result->shipment->pkg];
			}
		}

		$lastArr = [];
		foreach ($finalResult as $key => $value) {
			$thisPallet = empty($value['pallet']) ? "" : $value['pallet'] * ($value['packages'] / $value['allPackages']);
			$lastArr[] = $value['hbn'] . "(" . round($thisPallet, 1) . " pallet)";
		}

		if ($type) {
			return join("<br/>", $lastArr);
		} else {
			return join(", ", $lastArr);
		}
	}

	public function getFBARef($type = false)
	{
		$criteria = new CDbCriteria();
		$criteria->with = array("shipment", "amazon_info", "cargo_delivery_info");

		if (!empty(@$this->amazon_info->amazon_booking_time)) {
			$criteria->addCondition(" (amazon_info.amazon_booking_time = '" . @$this->amazon_info->amazon_booking_time . "') or (cargo_delivery_info.delivery_booking_time = '" . @$this->amazon_info->amazon_booking_time . "') ");
		} else {
			$criteria->addCondition(" (amazon_info.amazon_booking_time = '" . @$this->cargo_delivery_info->delivery_booking_time . "') or (cargo_delivery_info.delivery_booking_time = '" . @$this->cargo_delivery_info->delivery_booking_time . "') ");
		}

		$criteria->addCondition(" json_value(shipment.meta,'$.delivery_address') = '" . @$this->shipment->mdata['delivery_address'] . "'");
		$criteria->addCondition(" t.driver_id = " . $this->driver_id);
		$criteria->addCondition(" t.type = " . $this->type);

		$results = CargoProcess::model()->findAll($criteria);
		$finalResult = [];
		foreach ($results as $key => $result) {
			$packages = empty($result->mdata['caref']) ? " ({$result->shipment->pkg} packages)" : ' (' . $result->mdata['left_packages'] . " packages)";
			$finalResult[] = $result->getRef() . $packages;
		}

		if ($type) {
			return join("<br/>", $finalResult);
		} else {
			return join(", ", $finalResult);
		}
	}

	public function getCargos()
	{
		if ($this->type == CargoProcess::FBA_CARGO || $this->type == CargoProcess::B2B_CARGO) {
			$criteria = new CDbCriteria();
			$criteria->with = array("shipment", "amazon_info", "cargo_delivery_info");
			if (!empty(@$this->amazon_info->amazon_booking_time)) {
				$criteria->addCondition(" (amazon_info.amazon_booking_time = '" . @$this->amazon_info->amazon_booking_time . "') or (cargo_delivery_info.delivery_booking_time = '" . @$this->amazon_info->amazon_booking_time . "') ");
			} else {
				$criteria->addCondition(" (amazon_info.amazon_booking_time = '" . @$this->shipment->cargo_delivery_info->delivery_booking_time . "') or (cargo_delivery_info.delivery_booking_time = '" . @$this->cargo_delivery_info->delivery_booking_time . "') ");
			}



			$criteria->addCondition(" json_value(shipment.meta,'$.delivery_address') = '" . @$this->shipment->mdata['delivery_address'] . "'");
			$criteria->addCondition(" t.driver_id = " . $this->driver_id);
			$criteria->addCondition(" t.type = " . $this->type);
			$results = CargoProcess::model()->findAll($criteria);

			return $results;
		} else {
			return [$this];
		}
	}

