	public function getZone()
	{
		if (!empty($this->mdata['zone'])) {
			return $this->mdata['zone'];
		} else {
			$orgRate = OrgRate::model()->findByPk(ImportChargeCode::AUSTWAY_TRUCK_DELIVERY);
			$zoneMaps = ZoneMap::model()->findAll("org_id = :orgId and zone_id = :zoneId and pc_hi>=:postcode and pc_lo<=:postcode", [":orgId" => $orgRate->org_id, ":zoneId" => $orgRate->zone_id, ":postcode" => $this->shipment->cnee->postcode]);
			foreach ($zoneMaps as $key => $z) {
				$this->mdata['zone'] = $z->z1;
				$this->updateMeta();
				return $z->z1;
			}
			return "";
		}
	}

	public function getChargeCode()
	{
		if (!empty($this->shipment->mdata["chargecode"])) {
			return $this->shipment->mdata["chargecode"];
		} else {
			if ($this->shipment->ot_id == 10) {
				$dpt_id = $this->dpt_id;
				$quote = WmsOrgQuote::model()->find(['condition' => 'org_id = :org_id AND status = 1 AND (JSON_VALUE(meta, "$.whole_sale") IS NULL OR JSON_VALUE(meta, "$.whole_sale") = 0)', 'params' => [':org_id' => $this->shipment->agent_id], 'order' => 'id DESC']);
				if ($dpt_id == Org::TLA_DEPARTMENT_SYDNEY) {
					$numCourierChargeCode = $quote->mdata[WmsOrgQuote::QUOTE_COURIER_CHARGECODE_TLACARGO];
				} else if ($dpt_id == Org::TLA_DEPARTMENT_MELBOURNE) {
					$numCourierChargeCode = $quote->mdata[WmsOrgQuote::QUOTE_COURIER_MEL_CHARGECODE_TLACARGO];
				} else if ($dpt_id == Org::TLA_DEPARTMENT_BRISBANE) {
					$numCourierChargeCode = $quote->mdata[WmsOrgQuote::QUOTE_COURIER_BNE_CHARGECODE_TLACARGO];
				}
				if (!empty($numCourierChargeCode)) {
					return $numCourierChargeCode;
				}
			}
			return "";
		}
	}

