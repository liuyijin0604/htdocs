	public function getRegion($dptId = 106)
	{
		if (!empty($this->mdata['region'])) {
			return $this->mdata['region'];
		} else {
			$orgRate = OrgRate::model()->find("code = :code and json_value(meta,'$.ddpt_id') = :dptId", [":code" => ImportChargeCode::AUSTWAY_TRUCK_ZONE_CODE, ":dptId" => $dptId]);
			if (!empty($orgRate)) {
				$zoneMaps = ZoneMap::model()->findAll("org_id = :orgId and zone_id = :zoneId  and pc_hi>=:postcode and pc_lo<=:postcode", [":orgId" => $orgRate->org_id, ":zoneId" => $orgRate->zone_id, ":postcode" => $this->shipment->cnee->postcode]);
				foreach ($zoneMaps as $key => $z) {
					$this->mdata['region'] = $z->z1;
					$this->updateMeta();
					return $z->z1;
				}
			}
			return "";
		}
	}

	public function getCostInOperation()
	{
		$numInputCost = !empty($this->mdata['inputcost']) ? $this->mdata['inputcost'] : 0;
		$numSystemCost = !empty($this->mdata['systemCost']) ? $this->mdata['systemCost'] : 0;
		if ($numInputCost != 0) {
			return $numInputCost;
		}
		if ($numSystemCost != 0) {
			return $numSystemCost;
		}
	}

	public function getCargoProcessFee($orgRateId = "")
	{
		if (!empty(@$this->mdata['inputcost'])||!empty(@$this->mdata['inputcostinterstate'])) {
			$numInputCost = !empty($this->mdata['inputcost'])?$this->mdata['inputcost']:0;
			$numInputcostinterstate = !empty($this->mdata['inputcostinterstate'])?$this->mdata['inputcostinterstate']:0;
			$this->mdata['systemCost'] =  $numInputCost + $numInputcostinterstate;
			$this->save();
			return $this->mdata['systemCost'];
		}

		if (!empty($this->mdata['systemCost'])) {
			return $this->mdata['systemCost'];
		}
		if (empty($orgRateId)) {
			if (!empty($this->mdata['orgRateId'])) {
				$orgRateId = $this->mdata['orgRateId'];
			} else {
				$isHistory = $hasForkLift = 0;
				$chargeCodeId = CargoProcessJobService::getChargeCodeByCargoProcessId($this->id);

				//NEW 2022/08/01
				if(preg_match('/' . CargoProcess::$newNoForkliftRegular . '/i', $chargeCodeId)){
					if($this->mdata['custconfirmforklift'] == 1){
						$hasForkLift = 1;
					}
				}
				
				//OLD 
				// if (!preg_match('/' . CargoProcess::$hasForkliftRegular . '/i', $chargeCodeId)) {
				// 	$hasForkLift = 1;
				// }

				if (strtotime($this->job_relation->job->created) < strtotime("2022-04-01 00:00:00")) {
					$isHistory = 1;
				}
				$driverId = $this->job_relation->job->driver_id;
				if (empty($driverId)) {
					$driverId = $this->driver_id;
				}
				$orgRateId = CargoProcessJobService::getDriverOrgRateIdByCDriverId($this->type, $driverId, $isHistory, $hasForkLift);
			}

			if (!empty($orgRateId)) {
				$this->mdata['orgRateId'] = $orgRateId;
				$this->save();
			}
		}

		//for those cargoprocess has other firstdelivery Fee
		$numFirstDelivery = 0;
		if (!empty($this->job_relation_inactive)) {
			$numFirstDelivery = self::getFirstDeliveryCost();
		}

		$cost = CargoProcessJobService::getCargoProcessCostInCJobByCargoProcessIdAndOrgrateId($this->id, $orgRateId) + $numFirstDelivery;
		if ($cost != 0) {
			$this->mdata['systemCost'] = $cost;
			$this->save();
			return $cost;
		}
		return "n/a";
	}

	public function getFirstDeliveryCost($orgRateId = "")
	{
		$cost = 0;
		if (empty($orgRateId)) {
			if (!empty($this->mdata['orgRateId'])) {
				$orgRateId = $this->mdata['orgRateId'];
			} else {
				$isHistory = $hasForkLift = 0;
				$chargeCodeId = CargoProcessJobService::getChargeCodeByCargoProcessId($this->id);
				//NEW 2022/08/01
				if(preg_match('/' . CargoProcess::$newNoForkliftRegular . '/i', $chargeCodeId)){
					if($this->mdata['custconfirmforklift'] == 1){
						$hasForkLift = 1;
					}
				}
				
				//OLD 
				// if (!preg_match('/' . CargoProcess::$hasForkliftRegular . '/i', $chargeCodeId)) {
				// 	$hasForkLift = 1;
				// }
				if (strtotime($this->job_relation->job->created) < strtotime("2022-04-01 00:00:00")) {
					$isHistory = 1;
				}
				if (!empty($this->job_relation_inactive)) {
					foreach ($this->job_relation_inactive as $r) {
						if ($r->isredelivery == 1) {
							$driverId = $r->job->driver_id;
							$orgRateId = CargoProcessJobService::getDriverOrgRateIdByCDriverId($this->type, $driverId, $isHistory, $hasForkLift);
							$cost += CargoProcessJobService::getCargoProcessCostInCJobByCargoProcessIdAndOrgrateId($this->id, $orgRateId);
						}
					}
				}
			}
		}
		return $cost;
	}

	public function getCargoProcessFeeReCal()
	{
		if(empty($this->job_relation))
		{
			return "n/a";
		}
		$isHistory = $hasForkLift = 0;
		$chargeCodeId = CargoProcessJobService::getChargeCodeByCargoProcessId($this->id);
		//NEW 2022/08/01
		if(preg_match('/' . CargoProcess::$newNoForkliftRegular . '/i', $chargeCodeId)){
			if($this->mdata['custconfirmforklift'] == 1){
				$hasForkLift = 1;
			}
		}

		//OLD 
		// if (!preg_match('/' . CargoProcess::$hasForkliftRegular . '/i', $chargeCodeId)) {
		// 	$hasForkLift = 1;
		// }
		if (strtotime($this->job_relation->job->created) < strtotime("2022-04-01 00:00:00")) {
			$isHistory = 1;
		}
		$driverId = $this->job_relation->job->driver_id;
		if (empty($driverId)) {
			$driverId = $this->driver_id;
		}
		$orgRateId = CargoProcessJobService::getDriverOrgRateIdByCDriverId($this->type, $driverId, $isHistory, $hasForkLift);
		if (!empty($orgRateId)) {
			$this->mdata['orgRateId'] = $orgRateId;
			$this->save();
		}

		//for those cargoprocess has other firstdelivery Fee
		$numFirstDelivery = 0;
		if (!empty($this->job_relation_inactive)) {
			$numFirstDelivery = self::getFirstDeliveryCost();
		}

		if (!empty(@$this->mdata['inputcost'])||!empty(@$this->mdata['inputcostinterstate'])) {
			$numInputCost = !empty($this->mdata['inputcost'])?$this->mdata['inputcost']:0;
			$numInputcostinterstate = !empty($this->mdata['inputcostinterstate'])?$this->mdata['inputcostinterstate']:0;
			$this->mdata['systemCost'] =  $numInputCost + $numInputcostinterstate;
			$this->save();
			return $this->mdata['systemCost'];
		}
		
		$cost = CargoProcessJobService::getCargoProcessCostInCJobByCargoProcessIdAndOrgrateId($this->id, $orgRateId) + $numFirstDelivery;
		if ($cost != 0) {
			$this->mdata['systemCost'] = $cost;
			$this->save();
			return $cost;
		}
		return "n/a";
	}

	public function getCargoProcessRevenueFee()
	{
		if (!empty($this->mdata['systemTotalRevenue'])) {
			return $this->mdata['systemTotalRevenue'];
		}
		$numRevenue = $numrelatedOTInvoice = 0;
		$chargeCodeId = CargoProcessJobService::getChargeCodeByCargoProcessId($this->id);
		$arrRevenue = CargoProcessJobService::getRevenueByCargoProcessIdAndChargeCodeId($this->id, $chargeCodeId);
		if(!empty($arrRevenue)){
			$numbase = $arrRevenue[0];
			$arrsurcharge = $arrRevenue[1];
			$numRevenue = $arrRevenue[2];
		}
		$numrelatedOTInvoice = $this->getRelatedOTFee();

		if ($numRevenue != 0 || $numrelatedOTInvoice != 0) {
			$this->mdata['systemTotalRevenue'] = $numRevenue + $numrelatedOTInvoice;
			$this->mdata['systemRevenue'] = $numRevenue;
			$this->mdata['systemOt'] = $numrelatedOTInvoice; //OT revenue
			$this->mdata['MHCharge'] = $arrsurcharge['MHCharge']; //MH?
			$this->mdata['OSCharge'] = $arrsurcharge['OSCharge']; //Oversize
			$this->mdata['RECharge'] = $arrsurcharge['RECharge']; //remote
			$this->mdata['LevyCharge'] = $arrsurcharge['LevyCharge']; //levy
			$this->mdata['FuelCharge'] = $arrsurcharge['FuelCharge']; //fuel
			$this->mdata['systemRevenueBase'] = $numbase; //base

			$this->save();
			return $numRevenue + $numrelatedOTInvoice; //total
		}
		return "n/a";
	}

