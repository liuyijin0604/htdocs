	public function getDateDiff()
	{
		if (!empty($this->comp_date)) {
			if($this->dpt_id == 218){
				$pod = 'AUMEL';
			}elseif($this->dpt_id == 530){
				$pod = 'AUBNE';
			}else{
				$pod = 'AUSYD';
			}
			$dateTemp = $this->started;
			if(!empty($this->shipment->mdata['scan_time'])){
				if(strtotime($this->shipment->mdata['scan_time'])<strtotime($this->started)){
					$dateTemp = $this->started;
				}else{
					$dateTemp = $this->shipment->mdata['scan_time'];
				}
			}
			$dateTemp = date('Y-m-d',strtotime($dateTemp))." 23:59:59";
			return HolidayHelper::getWeekdaysBetweenTwoDates($dateTemp,$this->comp_date,$pod) - 1;
			//return floor((strtotime($this->comp_date) - strtotime($this->started)) / 3600 / 24);
		}
		return "";
	}

	public function getDriver()
	{
		return Org::model()->findByPk($this->job_relation->job->driver_id)->name;
	}

	public function getSupplierCost()
	{
		$numSupplierCost = 0;
		$modelShipment = $this->shipment;
		$strHbn = $modelShipment->hbn;
		[$app_name, Yii::app()->name] = [Yii::app()->name, 'TLA'];
		$modelSupplierInvLines = SiReconcileLine::model()->findAll('ref = :ref and confirm_status >= 31', [':ref' => $strHbn]);
		if (!empty($modelSupplierInvLines)) {
			foreach ($modelSupplierInvLines as $modelSupplierInvLine) {
				if (preg_match('/item|UNLOADING|WAITING/i', $modelSupplierInvLine->item_code)) {
					$numSupplierCost += $modelSupplierInvLine->value;
				}
			}
		}
		Yii::app()->name = $app_name;
		return $numSupplierCost;
	}

	public function getAwb()
	{
		if(!empty($this->shipment->consol))
		{
			if (preg_match('/WDT/i', $this->shipment->consol->no)) {
				$mainShipment = str_replace("WDT", "PICKUP", $this->shipment->consol->no);
				$mainShipmentModel = ImParcel::model()->find('ref = :ref', [':ref' => $mainShipment]);
				if (!empty($mainShipmentModel)) {
					if ($mainShipmentModel->consol->service == 10) {
						return $mainShipmentModel->consol->awb;
					} else {
						return empty($mainShipmentModel->consol->mdata["container_no"]) ? "" : $mainShipmentModel->consol->mdata["container_no"];
					}
				}
				return "";
			} elseif ($this->shipment->consol->service == 10) {
				return $this->shipment->consol->awb;
			} else {
				return @$this->shipment->consol->mdata["container_no"];
			}
		}
	}

	public function isSignGatePassOnTime()
	{
		$gatepassInfo = [];
		$rs = GatepassShipment::model()->findAll('fid=:fid AND parent_id !=0 ORDER BY parent_id', array(':fid' => $this->shipment->id));
		foreach ($rs as $r) {
			$gatepassInfo[$r->parent_id][] = $r;
		}
		if (!empty($gatepassInfo)) {
			return true;
		}
		return false;
	}

	public function isUploadPodOnTime()
	{
		if (isset($this->mdata['sig']) && !empty($this->mdata['sig'])) {
			$modelCJob = $this->job_relation->job;
			if (!empty($modelCJob)) {
				if ($this->mdata['sdate'] < date("Y-m-d", strtotime("+1 day", strtotime($modelCJob->created)))) {
					return true;
				}
			}
		}
		return false;
	}

	public function isSignGatePassOnTimeHtml()
	{
		if ($this->isSignGatePassOnTime()) {
			$subStatus = "✔";
		} else {
			$subStatus = "✘";
		}
		return $subStatus;
	}

	public function isGoodDelivery()
	{
		if (!empty($this->mdata['goodDelivery'])) {
			if ($this->mdata['goodDelivery'] == 1) {
				return "True";
			} else {
				return "False";
			}
		}
		if ($this->isUploadPodOnTime() && $this->isSignGatePassOnTime()) {
			$this->mdata['goodDelivery'] = 1;
			$this->save();
			return "True";
		}
		return "False";
	}

