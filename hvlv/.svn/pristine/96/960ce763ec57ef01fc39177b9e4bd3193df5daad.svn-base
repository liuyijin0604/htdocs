	//Auto Choose c job 
	public function setCargoProcessInToAvailableCJob()
	{
		if (empty($this->job_relation->job)) {
			$modelCJob = new CargoProcessJob;
			$listJob = $modelCJob->getAvailableJob($this->id);
			$numCJobId = 0;
			if (!empty($listJob)) {
				foreach ($listJob as $key => $value) {
					if(!empty($key)){
						$numCJobId = $key;
						if ($numCJobId != 0) {
							break;
						}
					}
				}
				if ($numCJobId != 0 && !empty($numCJobId)) {
					$objCargoProcessJobRelations = new CargoProcessJobRelations;
					$objCargoProcessJobRelations->job_id = $numCJobId;
					$objCargoProcessJobRelations->cargo_process_id = $this->id;
					$objCargoProcessJobRelations->created = date('Y-m-d h:i:s');
					$objCargoProcessJobRelations->sequence = 1;
					if($objCargoProcessJobRelations->save()){
						$this->mdata['AutoIntoJob']=1;
						$this->status = 40;
						$this->note = $this->note . "Auto choose C-Job";
						if(!empty($this->mdata['customer_confirmed']['surcharge_invoice'])){
							$strAppName = Yii::app()->name;
							Yii::app()->name = 'TLA';
							$objInvoice = Invoice::model()->findByPk($this->mdata['customer_confirmed']['surcharge_invoice']);
							Yii::app()->name = $strAppName;
							if(!empty($objInvoice)){
								if($objInvoice->status == 2){
									$objInvoice->createCreditForMe();
								}
							}
						}
						$this->save();
						return "True";
					}else{
						$this->status = 5;
						$this->note = $this->note . " No available C-Job can be choose."; 
						$this->save();
						return "False";
					}
				}
			}else{
				$this->status = 5;
				$this->note = $this->note . " No available C-Job can be choose."; 
				$this->save();
				return "False";
			}
		}
		return "False";
	}

	public function isOurWarehouse(){
		$match = false;
		$address = $this->shipment->cnee->address;
		$postcode = $this->shipment->cnee->postcode;
		$suburb = $this->shipment->cnee->suburb;
		$arrOrgids=[106,218,530];
		foreach($arrOrgids as $arrOrgid){
			$modelOrg = Org::model()->findByPk($arrOrgid);
			if($address == $modelOrg->address && $postcode == $modelOrg->postcode){
				$match = true;
				break;
			}
		}
		if(!$match){
			return true;
		}else{
			return false;
		}
	}

	public function getInterstateRevenue(){
		$revenue = 0;
		if($this->was_interstate == 1){
			if(!empty($this->mdata['interstateotno'])){
				return 0 ;
			}
			elseif(!empty($this->mdata['interstatechargecode'])){
				$numplt = !empty($this->mdata['job_pallet_no'])? $this->mdata['job_pallet_no']:$this->shipment->getRackNumber()[1];
				return $this->shipment->getChargeByChargecode($this->mdata['interstatechargecode'],true,$numplt);
			}
		}
		return $revenue;
	}

