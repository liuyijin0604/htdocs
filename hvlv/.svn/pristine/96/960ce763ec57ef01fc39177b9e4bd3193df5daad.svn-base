		$obj = $this;
		// }
		if (empty(@$obj->cargo_delivery_info->delivery_booking_time)) {
			if (empty(@$obj->amazon_info->amazon_booking_time)) {
				$this->_deliveryBookingTime = "";
			} else {

				$this->_deliveryBookingTime = $obj->amazon_info->amazon_booking_time;
			}
