		return $result;
	}

	public function getPaidInvoice(){
		//$arrOTInvoiceNo = [];
		$strOTInvoice = 0;
		[$app_name, Yii::app()->name] = [Yii::app()->name, 'TLA'];
		$modelOTinvoices = Invoice::model()->with('lines')->findAll('(t.status = 9) and (lines.linkto like "%' . $this->shipment->hbn . '%" or lines.linkto like "%' . $this->shipment->ref . '%")');
		if(!empty($modelOTinvoices)){
			foreach($modelOTinvoices as $modelOTinvoice){
				$strOTInvoice += $modelOTinvoice->total - $modelOTinvoice->gst;
				//$arrOTInvoiceNo[$modelOTinvoice->id] = $modelOTinvoice->no.":".$modelOTinvoice->total;
			}
		}
		Yii::app()->name = $app_name;
		//return implode(', ', $arrOTInvoiceNo);
		return $strOTInvoice;
	}

	public function sendBiddingInfoToDriver(){
		$driverType = $this->getShipmentPod();
		$orgModel= new Org();
		$emailService = new EmailService();
		if(!empty($driverType)){
			$orgs = $orgModel->findAll(["condition"=>"(cargo_driver_type & ".$driverType.") > 0 and status = 1 ","order"=>'`by` desc']);
			foreach ($orgs as $key => $org) {
				if($org->status==1){
					if(!empty(Addr::auTelValid($org->phone))){
						$emailService->sendBiddingInfo($org->phone);
					}
				}
			}
		}
	}

	public function sendSuccessfulBidding($driverID,$sendDate,$lastDate){
		if(!empty($driverID)){
			$objDriver = Org::model()->findByPk($driverID);
			if(!empty($objDriver)){
				$phone = $objDriver->phone;
				if(!empty(Addr::auTelValid($phone))){
					$emailService = new EmailService();
					$emailService->sendCongratulationSmsBidding($phone,$sendDate." 11am",$lastDate." 7pm");
				}
			}
		}
	}

	public function getOPBiddingCost(){
		if(!empty($this->cargo_process_bidding->op_cost)){
			return $this->cargo_process_bidding->op_cost;
		}
	}

	public function  getReferenceCost(){
		if(!empty($this->cargo_process_bidding)){
			return $this->cargo_process_bidding->getBestBiddingDetailCost();
		}
		return "0";
	}

	public function getSystemBaseCost(){
		$numSystemBaseCost = !empty($this->mdata['systemCost'])? $this->mdata['systemCost']:0;
		$numSystemInterstateCost = !empty($this->mdata['inputcostinterstate'])? $this->mdata['inputcostinterstate']:0;
		return $numSystemBaseCost- $numSystemInterstateCost;
	}

	public function getSystemInterstateCost(){
		return !empty($this->mdata['inputcostinterstate'])? $this->mdata['inputcostinterstate']:0;
	}
}
