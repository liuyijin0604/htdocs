	/**
	 * @return string the associated database table name
	 */
	public function tableName()
	{
		return 'cargo_process';
	}

	/**
	 * @return array validation rules for model attributes.
	 */
	public function rules()
	{
		// NOTE: you should only define rules for those attributes that
		// will receive user inputs.
		return array(
			['shipment_id', 'required'],
			['shipment_id, status', 'numerical', 'integerOnly' => true],
			// The following rule is used by search().
			// @todo Please remove those attributes that should not be searched.
			['exInfo,sub_type', 'safe'],
			['hbn,ref,shipment_id, status, deliveryBookingTime,agentId,cargoType,note,type,driver_id,consol_no,awb,assignedUser,searchFrom,searchTo,pkg,postcode,memo,cname,weight,tel,address,suburb,state,cbm,plt,region,goodsAvailableAddress,agent_id,sub_type,is_3pl,outturn,clear,comp_date,isSyd,isMel,isBne,staDate,endDate,fromDate,toDate,isB2C,isFBA,isB2B,isInterState,skipPickUp,isProblemApprove,was_interstate,dpt_id,hasBidding', 'safe', 'on' => 'search'],
		);
	}

	/**
	 * @return array relational rules.
	 */
	public function relations()
	{
		// NOTE: you may need to adjust the relation name and the related
		// class name for the relations automatically generated below.
		return [
			'shipment' => [self::BELONGS_TO, 'ImParcel', 'shipment_id'],
			'job_relation' => [self::HAS_ONE, 'CargoProcessJobRelations', 'cargo_process_id', 'on' => 'job_relation.active = 1'],
			'job_relation_inactive' => [self::HAS_MANY, 'CargoProcessJobRelations', 'cargo_process_id', 'on' => 'job_relation_inactive.active = 0'],
			'job_relation_all' => [self::HAS_MANY, 'CargoProcessJobRelations', 'cargo_process_id'],
			'logs' => [self::HAS_MANY, 'Log', 'lid', 'on' => "logs.model = '" . get_called_class() . "'", 'order' => 'logs.time ASC'],
			'driver' => [self::BELONGS_TO, 'Org', 'driver_id'],
			'amazon_info' => [self::HAS_ONE, 'AmazonInfo', 'fid', 'on' => "amazon_info.model='" . get_called_class() . "'"],
			'cargo_delivery_info' => [self::HAS_ONE, 'CargoDeliveryInfo', 'shipment_id', 'on' => "cargo_delivery_info.model='" . get_called_class() . "'"],
			'cargo_process_bidding' => [self::HAS_ONE,'CargoProcessBidding','cargo_process_id','on' =>'cargo_process_bidding.status = 10']
		];
	}

