						$provide[]=['id'=>$key1,'date'=>$date,'weight'=>$total_weight,'packs'=>$total_packs,'out_weight'=>$scaninfo->mdata['todayScanInfo']['weight'],'out_packs'=>$scaninfo->mdata['todayScanInfo']['packs'],'rate_weight'=>round($scaninfo->mdata['todayScanInfo']['weight']/$hrs, 2),'rate_packs'=>round($scaninfo->mdata['todayScanInfo']['packs']/$hrs, 2),'time'=>$hrs,'resorting_weight'=>$scaninfo->mdata['todayResortingInfo']['weight'],'resorting_packs'=>$scaninfo->mdata['todayResortingInfo']['packs']];
