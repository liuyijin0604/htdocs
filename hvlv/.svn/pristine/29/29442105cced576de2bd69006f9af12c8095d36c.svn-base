						// $provide[]=['id'=>$rs[0]->user->id,'user'=>$rs[0]->user->getFullName(),'pcs_packs' => $pcs_packs,'pcs_weight' => $pcs_weight,'carton_packs'=>$carton_packs,'carton_weight'=>$carton_weight,'scan_date'=>$scan_date,'time'=>$hrs];
