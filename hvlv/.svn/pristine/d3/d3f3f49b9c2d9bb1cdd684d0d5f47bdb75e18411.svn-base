	}
	
	public function actionDeleteZoneMapImport()
	{
		$importId =$_POST["id"];
		$type =$_POST["type"];
		ZoneMapTestImport::model()->deleteAll(" id  = {$importId}");
		ZoneMapTest::model()->deleteAll(" import_id  = {$importId}");
		if ($type ==0) {
			$zoneMapTestArr = ZoneMapTestImport::model()->findAll(" type = 0 ");
			$pcaZoneTestArr = [];
			foreach ($zoneMapTestArr as $key => $value) {
				$pcaZoneTestArr[$value->id] = $value->name;
			}
			echo $this->renderPartial('_testPCA', ['pcaZoneTestArr'=>$pcaZoneTestArr], true);
		} elseif ($type ==1) {
			$weightMaps = ZoneMapTestImport::model()->findAll(" type = 1 ");
			$weightMapArr = [];
			foreach ($weightMaps as $key => $value) {
				$weightMapArr[$value->id] = $value->name;
			}
			echo $this->renderPartial('_testWeightMap', ['weightMapArr'=>$weightMapArr], true);
		}
	}
