	/**
	 * @param $orgId
	 * @param $data
	 */
	private function importOrgZoneMapData(&$data)
	{
		$index = 0;
		$zoneId = 0;
		$orgRate = new OrgRate();
		$orgRateId = null;
		$rateArr = [];
		foreach ($data as $row) {
			$index++;
			if ($index == 1) {
				$testName =  $row[1];
				$orgRate->org_id=0;
				$orgRate->zone_id=$zoneId;
				$orgRate->name=$testName;
				$orgRate->code="test";
				$orgRate->type=OrgRate::COSTRATETESTTYPE;
				$orgRate->vfrom= date("Y-m-d");
				$orgRate->vto= "0000-00-00";
				$orgRate->currency= 1;
				$orgRate->meta = '';
				$orgRate->updated = date('Y-m-d h:i:s');
				$orgRate->mdata['ddpt_id'] = Org::$warehouse_list_re[$row[2]];
				$orgRate->save();
				$orgRateId = $orgRate->id;
			}
			if ($index == 3) {
				foreach ($row as $key => $column) {
					if ($column!="") {
						$rateArr[] = $column;
					}
				}
				continue;
			}
			if (empty($row[1])||$index<=4) {
				continue;
			}
			$code = $row[1];
			$name = $row[2];
			$postcodes = explode(',', $row[3]);
			foreach ($postcodes as $postcode) {
		// try to find -
				$postCodesSpan = explode('-', $postcode);
				if (count($postCodesSpan) == 2) {
					$start = intval($postCodesSpan[0]);
					$end = intval($postCodesSpan[1]);
				} else {
					// only one post code
					$start = $end = intval($postCodesSpan[0]);
				}
				// if existing , do nothing
				//$zoneMap = ZoneMap::model()->find('org_id = :oid and z1 = :code and pc_lo = :pclo and pc_hi = :pchi',[':oid' => $orgId,':code' => $code,':pclo' => $start,':pchi' => $end]);
				//if ( empty($zoneMap) )
				$zoneMapTest = new ZoneMapTest();
				$zoneMapTest->setAttributes([
					'rate_id' => $orgRateId,
					'zone_id' => intval($zoneId),
					'z1' => $code,
					'z2' => '',
					'zone_name' => $name,
					'pc_lo' => $start,
					'pc_hi' => $end,
					'meta' => ''
				]);
				$zoneMapTest->save();
			}
			$rateIndex = 4;
			foreach ($rateArr as $key => $rateName) {
				$rateNameArr = explode("-", $rateName);
				$zoneRateTest = new ZoneRate();
				$rateNameArr[0] = floatval($rateNameArr[0]);
				if ($rateNameArr[0]!=0) {
					$rateNameArr[0] = floatval($rateNameArr[0]);
					$rateNameArr[0] += 0.001;
				}
				$weight_lo=floatval($rateNameArr[0]);
				$weight_hi=floatval(floatval($rateNameArr[1]));
				$base=floatval($row[$rateIndex+2]);
				$item=floatval($row[$rateIndex]);
				$perkg=floatval($row[$rateIndex+1]);
				$nkg=floatval($row[$rateIndex+4]);
				$minimum=floatval($row[$rateIndex+3]);
				$zoneRateTest->setAttributes([
					'rate_id' => $orgRateId,
					'chargecode_id' => 0,
					'zone' =>$row[1],
					'zone_name' => $row[2],
					'weight_lo' => $weight_lo,
					'weight_hi' => $weight_hi,
					'base' => number_format($base,3,'.',''),
					'item' => number_format($item,3,'.',''),
					'perkg' => number_format($perkg,3,'.',''),
					'nkg' => $nkg,
					'minimum' => number_format($minimum,3,'.',''),
					'gst' => 1,
					'levy' => 0
				]);
				$zoneRateTest->save();
				$rateIndex = $rateIndex + 5;
			}
		}
	}
	/**
	 * @param $orgId
	 * @param $data
	 */
	private function importWeightZoneMapData(&$data)
	{
		$index = 0;
		$zoneId = 0;
		$zoneMapTestImport = new ZoneMapTestImport();
		$zmtiId = null;
		foreach ($data as $row) {
			$index++;
			if ($index == 1) {
				if ($row[1]=="") {
					break;
				}
				$testName =  $row[1];
				$zoneMapTestImport->name = $testName;
				$zoneMapTestImport->meta = '{"type":"weightMap"}';
				$zoneMapTestImport->type = 1;
				$zoneMapTestImport->save();
				$zmtiId = $zoneMapTestImport->id;
			}
			if (empty($row[1])||$index<=2) {
				continue;
			}
			if ($zmtiId==null) {
				break;
			}
			$code = $row[1];
			$name = "";
			$weight = $row[3];
			$postcodes = explode(',', $row[2]);
			$pcNum = 0;
			foreach ($postcodes as $key => $postcode) {
				$postCodesSpan = explode('-', $postcode);
				if (count($postCodesSpan) == 2) {
					$start = intval($postCodesSpan[0]);
					$end = intval($postCodesSpan[1]);
					$pcNum+= $end- $start+1;
				} else {
					$pcNum++;
				}
			}
			foreach ($postcodes as $postcode) {
		// try to find -
				$postCodesSpan = explode('-', $postcode);
				if (count($postCodesSpan) == 2) {
					$start = intval($postCodesSpan[0]);
					$end = intval($postCodesSpan[1]);
				} else {
					// only one post code
					$start = $end = intval($postCodesSpan[0]);
				}
				// if existing , do nothing
				//$zoneMap = ZoneMap::model()->find('org_id = :oid and z1 = :code and pc_lo = :pclo and pc_hi = :pchi',[':oid' => $orgId,':code' => $code,':pclo' => $start,':pchi' => $end]);
				//if ( empty($zoneMap) )
				$zoneMapTest = new ZoneMapTest();
				$zoneMapTest->setAttributes([
					'rate_id' => 0,
					'zone_id' => intval($zoneId),
					'z1' => $code,
					'z2' => '',
					'zone_name' => $name,
					'pc_lo' => $start,
					'pc_hi' => $end,
					'meta' => json_encode(["weight"=>$weight,"singleWeight"=>$weight/$pcNum]),
					'import_id'=>$zmtiId
				]);
				$zoneMapTest->save();
			}
		}
	}
	/**
	 * @param $orgId
	 * @param $data
	 */
	private function importPCATestOrgZoneMapData(&$data)
	{
		$index = 0;
		$zoneId = 0;
		$zoneMapTestImport = new ZoneMapTestImport();
		$zmtiId = null;
		foreach ($data as $row) {
			$index++;
			if ($index == 2) {
				$testName =  $row[1];
				$zoneMapTestImport->name = $testName;
				$zoneMapTestImport->meta = "";
				if ($row[2]!="") {
					$per = explode(",", $row[2])[0];
					$max = explode(",", $row[2])[1];
					$zoneMapTestImport->meta = json_encode(["per"=>$per,"max"=>$max]);
				} elseif ($row[3]!="") {
					$zoneMapTestImport->meta = json_encode(["range"=>$row[3]]);
				}
				$zoneMapTestImport->save();
				$zmtiId = $zoneMapTestImport->id;
			}
			if (empty($row[1])||$index<=4) {
				continue;
			}
			$code = $row[1];
			$name = $row[2];
			$postcodes = explode(',', $row[3]);
			$transaction=Yii::app()->db->beginTransaction();
			try {
					foreach ($postcodes as $postcode) {
					// try to find -
					$postCodesSpan = explode('-', $postcode);
					if (count($postCodesSpan) == 2) {
						$start = intval($postCodesSpan[0]);
						$end = intval($postCodesSpan[1]);
					} else {
						// only one post code
						$start = $end = intval($postCodesSpan[0]);
					}
					// if existing , do nothing
					//$zoneMap = ZoneMap::model()->find('org_id = :oid and z1 = :code and pc_lo = :pclo and pc_hi = :pchi',[':oid' => $orgId,':code' => $code,':pclo' => $start,':pchi' => $end]);
					//if ( empty($zoneMap) )
					$zoneMapTest = new ZoneMapTest();
					$zoneMapTest->setAttributes([
						'rate_id' => 0,
						'zone_id' => intval($zoneId),
						'z1' => $code,
						'z2' => '',
						'zone_name' => $name,
						'pc_lo' => $start,
						'pc_hi' => $end,
						'meta' => '',
						'import_id'=>$zmtiId
					]);
					$zoneMapTest->save();
				}
				$transaction->commit();
			} catch (Exception $ex) {
				$transaction->rollback();
				throw $ex;
			}

		}
	}
}
