	public function actionDeleteTestCouriers()
	{
		$orgRateId =$_POST["id"];
		OrgRate::model()->deleteAll(" id  = {$orgRateId}");
		ZoneMapTest::model()->deleteAll(" rate_id  = {$orgRateId}");
		ZoneRate::model()->deleteAll(" rate_id  = {$orgRateId}");
