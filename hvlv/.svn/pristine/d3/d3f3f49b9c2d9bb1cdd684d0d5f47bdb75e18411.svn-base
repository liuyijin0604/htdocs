	/**
	 * save org rate related zone map
	 */
	
	public function actionAjaxSaveTestZonemap()
	{
		$resp = ['success' => 1,'msg' => 'import successfully'];
		$template_file = empty($_FILES['test-zonemap']) ? [] : $_FILES['test-zonemap'];
		if (empty($template_file['tmp_name']) || !is_uploaded_file($template_file['tmp_name'])) {
			$resp['msg'] = 'Invalid template file';
			echo json_encode($resp);
			return;
		} else {
			$xls = new oExcel;
			$xls->load($template_file['tmp_name']);
			$data = $xls->getAll();
			// import org zone map data
			$this->importOrgZoneMapData($data);
			$orgRateTestArr = OrgRate::model()->findAll(" type = ".OrgRate::COSTRATETESTTYPE." order by name ");
			$couriersTestArr = [];
			foreach ($orgRateTestArr as $key => $value) {
				$couriersTestArr[$value->id] = $value->name;
			}
			$resp['msg'] = $this->renderPartial('_testCouriers', ['couriersTestArr'=>$couriersTestArr], true);
		}
		echo json_encode($resp);
	}
