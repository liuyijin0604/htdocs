	public function generateEWEInvoice()
	{
		function funcGenerateEWEInvoice()
		{
			Yii::app()->name = "TLA";
			$sis = SiReconcile::model()->findAll("type = :type and status = :status and `create`>'2023-01-01'",[":type"=>SiReconcile::TYPE_TERMINAL,":status"=>SiReconcile::SI_RECONCILE_DONE_STATUS]);
			foreach ($sis as $key => $si) {
				$si->mdata['generatedEWE'] = 1;
				$si->update();
				foreach ($si->lines as $key => $li)
				{
					if(!empty($li->fid)&&($li->model=="Consol"||$li->model=="ImcoConsol"||$li->model=="DmawbConsol"))
					{
						if(in_array($li->ref,["160-52614995","999-68164692","618-63068294","160-56233015","828-54727750"])) continue;

						$consol = ImcoConsol::model()->find('awb = :awb and status != 100',[":awb"=>$li->ref]);
						if(empty($consol))
						{
							$consol = DmawbConsol::model()->find('awb = :awb and status != 100',[":awb"=>$li->ref]);
							if(!empty($consol))
							{
								$log = Log::model()->find("model=:model and lid =:lid and json_value(meta,'$.NOA_Email') is not null",[":model"=>get_class($consol),":lid"=>$consol->id]);
								if(!empty($log))
								{
									$importsMail = ImportsMail::model()->find("no = :no and plain_body like '%EWE%'",[":no"=>$log->extra['NOA_Email']]);
									if(!empty($importsMail))
									{
										$imConsol = new ImcoConsol('create');
							            $imConsol->owner_id = Org::ORGID_CLIENT_EWE_GROUP;
							            $imConsol->service = Consol::AIRCONSOL;
							            $imConsol->eta = $consol->eta;
							            $imConsol->awb = $consol->awb;
							            $imConsol->dpt_id = $consol->dpt_id;
							            $imConsol->pod = $consol->pod;
							            $imConsol->pol = "HKHKG";
							            $imConsol->flight = $consol->flight;
							            $imConsol->airline = $consol->airline;
							            $imConsol->save();
							            $consol = $imConsol;
									}else
									{
										$consol = null;
									}
								}else
								{
									$consol = null;
								}
							}

						}



						if(empty($consol)) continue;
						$orgs = $consol->totOrg();
						if(empty($orgs))
						{
							$orgId = $consol->owner_id;
						}else
						{
							$orgId = $orgs[0]['org_id'];
						}
						

						if(!in_array($orgId,[Org::ORGID_CLIENT_EWE_GROUP,Org::ORGID_CLIENT_EWE_ITEM,Org::ORGID_CLIENT_EWE_KG])||!preg_match("/(International Terminal Fee|Import Terminal Handling Fee|ULD Per Kg Fee|terminal handling)/",$li->item_code))
						{
							continue;
						}





						$docli = SiReconcileLine::model()->find("rec_id = :recId and fid = :fid and item_code like :itemcode",[":itemcode"=>"Import Document Fee%",":recId"=>$li->rec_id,":fid"=>$li->fid]);
						if(empty($docli))
						{
							Emailog::sendEmailTo('dev@toplogistics.com.au', $li->ref," Empty Import Document Fee",$li->item_code);
							continue;
						}

						$consols = Consol::model()->findAll("awb = :awb and status != 100",[":awb"=>$li->ref]);
						$sql = 'select id from inv_line where inv_id in (select id from invoice where consol_id in ('.join(',',array_column($consols,'id')).')  and status !=10 and status !=8) and ccode = "AIRPORT DOC FEE" ';
						$data = Yii::app()->db_tla->createCommand($sql)->queryAll();
						if(count($data)>0)continue;



						$org = Org::model()->findByPk($orgId);
						$invoice = new Invoice;
						$invoice->to_id = $orgId;
						$invoice->consol_id = $consol->id;
						$invoice->dpt_id = $consol->dpt_id;
						$invoice->dpmt = Invoice::DPMT_IMPORT;
						$invoice->type = Invoice::INVOICE_TYPE_OTHERS;
						$invoice->currency = 1;
						$invoice->ref = "";
						$invoice->date = date('Y-m-d');
						$invoice->due = date('Y-m-d');
						$invoice->total = 0;
						$invoice->gst = 0;
						$invoice->status = 1;
						$invoice->mdata['awb'] = $consol->awb;
						$invoice->save();
						$invoice->mdata['name'] = $org->name;
						$invoice->mdata['address'] = $org->getAddress();
						$invoice->mdata['payterm'] = empty($invoice->cust->extra['payterm']) ? 'COD' : $invoice->cust->extra['payterm'] . ' days';
						$invoice->save();
						$il = new InvLine;
						$il->ccode = "AIRPORT DOC FEE";
						$il->det = "AIRPORT DOC FEE";
						$il->tax = 'OUTPUT';
						$il->rebate = 0;
						$il->amount = $docli->value;
						$gst = floatval($docli->value) * 10 / 100;
						$il->amount += $gst;
						$il->gst = $gst;
						$il->qty = 1;
						$il->inv_id = $invoice->id;
						$il->save();


						$il = new InvLine;
						$il->ccode = "AIRPORT THC FEE";
						$il->det = "AIRPORT THC FEE";
						$il->tax = 'OUTPUT';
						$il->rebate = 0;
						$il->amount = $li->value;
						$gst = floatval($il->amount) * 10 / 100;
						$il->amount += $gst;
						$il->gst = $gst;
						$il->qty = 1;
						$il->inv_id = $invoice->id;
						$il->save();
						$invoice->total = $invoice->getTotal();
						$invoice->update('total');
						$si->mdata['generatedEWEInvoice'] = 1;
					}
				}
				$si->mdata['generatedEWE'] = 1;
				$si->update();
			}
		}
		$this->funcDoMQ('funcGenerateEWEInvoice','funcGenerateEWEInvoice',7200);
	}


	public function funcDoMQ($key,$func,$time = 3600)
	{
		sleep(rand(1,20));
		$status = $this->checkMQProcessing($key);
		if(!empty($status))
		{
			echo "processing";
			return;
		}

		$this->setMQProcessing($key,$time);

		$func();

		$this->deleteMQProcessing($key);
	}

	private function checkMQProcessing($key)
	{
		$mqRecord = Yii::app()->cache->get('MQRecord:'.$key);
		if(!empty($mqRecord))
		{
			echo "xxxxxx";
			return 1;
		}
		return 0;
	}

	private function setMQProcessing($key,$expired=null)
	{
		if(!empty($expired))
		{
			$mqRecord = Yii::app()->cache->set('MQRecord:'.$key,'MQRecord:'.$key,$expired);
		}else
		{
			$mqRecord = Yii::app()->cache->set('MQRecord'.$key,'MQRecord:'.$key);
		}
		return 1;
	}

	private function deleteMQProcessing($key)
	{
		$this->setMQProcessing($key,1);
		return 1;
	}

	public function deleteMQProcessingGo()
	{
		$key = $this->prompt("MQKey");
		$this->setMQProcessing($key,1);
		return 1;
	}

