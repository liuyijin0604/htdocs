	public function createAutoInvoice()
	{
		function funcCreateAutoInvoice()
		{
			Yii::app()->name = 'TLA';
			$ios = InvTempOrg::model()->with('template')->findAll('t.status = 1 AND template.status = 1 AND t.start <= NOW() AND t.end >= NOW()');
			foreach ($ios as $io) {
				if (($io->getFreq() == 'By Month'||$io->getFreq() == 'By Next Month') && date('d') != date('d', strtotime($io->start))) {
					echo date('d', strtotime($io->start));
					continue;
				} elseif ($io->getFreq() == 'By Week' && date('N') != date('N', strtotime($io->start))) {
					continue;
				} elseif ($io->getFreq() == 'By Day' && (date('N') == 6 || date('N') == 7)) {
					continue;
				} elseif ($io->getFreq() == '') {
					continue;
				}
				$template = $io->template;

				$invoice = new Invoice;
				$invoice->to_id = $io->org_id;
				$invoice->dpt_id = $template->dpt_id;
				$invoice->dpmt = $template->dpmt;
				$invoice->type = $template->type;
				$invoice->currency = $template->currency;
				$invoice->ref = $template->ref;
				$invoice->date = date('Y-m-d');
				$invoice->due = date('Y-m-d');
				$invoice->posted = date('Y-m-d');
				$invoice->total = $template->total + $template->gst;
				$invoice->gst = $template->gst;
				$invoice->status = 1;
				$invoice->mdata['payterm'] = 'COD';
				$invoice->save();
				$lines = $template->lines;
				foreach ($lines as $line) {
					$invline = new InvLine;
					$invline->inv_id = $invoice->id;
					$invline->ccode = $line->ccode;
					$invline->gst = $line->getGSTValue() / $line->qty;
					$invline->det = $line->desc;
					$invline->qty = $line->qty;
					if (preg_match('/rent|internet/i', $invline->det)) {
						if($io->getFreq() == 'By Next Month')
						{
							$invline->det .= " ".date('M Y', strtotime(date('Y-m-d') . ' + 1 month'));
						}else
						{
							$invline->det .= ' 12 ' . date('M') . ' - 11 ' . date('M', strtotime(date('Y-m-d') . ' + 1 month'));
						}
					}else
					{
						if($io->getFreq() == 'By Next Month')
						{
							$invline->det .= " ".date('M Y', strtotime(date('Y-m-d') . ' + 1 month'));
						}else
						{
							$invline->det .= " ".date('M Y');
						}
					}
					if (preg_match('/包裹收费/', $invline->det)) {
						$invline->det .= ' 1 ' . date('M') . ' - ' . date('d M', strtotime(date('Y-m-d')));
					}
					if (preg_match('/Software Development Service/', $invline->det)) {
						$monthCapital = date('M', strtotime(date('Y-m-d') . ' - 1 month'));
						$month = date('m', strtotime(date('Y-m-d') . ' - 1 month'));
						$year = date('Y', strtotime(date('Y-m-d') . ' - 1 month'));
						$days = date('d', strtotime(date('Y-m-1') . ' - 1 day'));
						$invline->det = $monthCapital . ' ' . $year . ' ' . $invline->det;
						for ($i = 1; $i <= $days; $i++) {
							if (date('N', strtotime($year . '-' . $month . '-' . $i)) == 1) {
								$invline->qty = ceil(($days - $i + 1) / 7) * $line->qty;
								break;
							}
						}
					}
					$invline->tax = $line->gst;
					$invline->amount = $line->rate + $invline->gst;
					$invline->save();
				}
				$invoice->total = $invoice->getTotal();
				$invoice->update('total');
			}
		}
		$this->funcDoMQ('funcCreateAutoInvoice','funcCreateAutoInvoice');
	}

