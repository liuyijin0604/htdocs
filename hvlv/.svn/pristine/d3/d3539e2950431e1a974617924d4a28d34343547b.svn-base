<?php

class MQCommand extends CConsoleCommand
{
	private $db;
	private $args;
	private $debug = false;
	public $ts;
	public $day;
	public $d;
	public $hr;
	public $mn;

	public function run($args)
	{
		Yii::app()->name = 'TLA';
		$this->db = Yii::app()->getDb();
		$this->args = $args;
		$this->ts = time();
		$this->day = date('N');
		$this->hr = date('G');
		$this->mn = intval(date('i'));
		$this->d = date('d');
		Yii::app()->request->hostInfo = 'https://os.toplogistics.com.au';
		
		if (empty($this->mn)) {
			$this->mn = 0;
		}

		foreach ($this->args as $ag) {
			if ($ag == '-d') {
				$this->debug = true;
			}
		}

		if (!empty($args[0]) && method_exists($this, $args[0])) {
			$this->{$args[0]}();
		} else {
			set_error_handler(function($errno, $errstr, $errfile, $errline, $errcontext) {
				if (!(error_reporting() & $errno)) return false;
				throw new ErrorException($errstr, 0, $errno, $errfile, $errline);
			});
			try{
			// if ($this->mn % 25 == 0) {
			// 	$this->log('Start checkMultiID');
			// 	$this->checkMultiID();
			// 	$this->openChaseIdTickets();
			// 	$this->closeIdTickets();
			// 	$this->log('Finish checkMultiID');
			// }

			// if ($this->mn % 25 == 0) {
			// 	$this->log('Start fix0wt');
			// 	$this->fix0wt();
			// 	$this->log('Finish fix0wt');
			// }

			// currently send UBM by checking status: DCLALLOWED return by CARST command
			// so don't call this function now

			// //call TLA cron
			$this->tlaMQ();

			} catch( Exception $e) {
				$trace = $e->getTrace();
				Emailog::sendEmailTo('dev@toplogistics.com.au', $e->getCode().PHP_EOL.$e->getMessage().PHP_EOL.print_r($trace, true)," MQ error");
			}
		}
	}


