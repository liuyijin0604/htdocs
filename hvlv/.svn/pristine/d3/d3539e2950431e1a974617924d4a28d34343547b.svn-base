	public function sendCustompdfEmail()
	{
		function funcSendCustompdfEmail()
		{
			$pdfTypes = [ReportCache::DoNotMoveSumMailTotalByDaily,ReportCache::ReleasedDirectionMailTotalByDaily];
			$titles = ["Do Not Move", "Released Direction"];
			$i = 0;

			foreach ($pdfTypes as $key => $type) {
				$doNotMovereportCache = ReportCache::model()->find('create_time = :today and type=:type and status=1',[':today'=>date('Y-m-d')." 00:00:00",":type"=>$type]);
				$str1 = "";
				if (!empty($doNotMovereportCache)) {
					$total = $doNotMovereportCache->mdata['total'];
					$dnmShipments = $doNotMovereportCache->mdata['shipments'];

					foreach ($dnmShipments as $key => $shipment)
					{
						$str1.="<tr>";
						$str1.="<td>&nbsp;&nbsp;&nbsp;".$shipment['hbn']."&nbsp;&nbsp;&nbsp;</td>";
						$str1.="<td>&nbsp;&nbsp;&nbsp;".$shipment['can']."&nbsp;&nbsp;&nbsp;</td>";
						$str1.="<td>&nbsp;&nbsp;&nbsp;".date('H:i:s ',strtotime($shipment['time']))."&nbsp;&nbsp;&nbsp;</td>";
						$str1.="</tr>";
					}

					$body = "<h1>".date('Y-m-d')." ".$titles[$i]." Shipments Total:".$total."</h1>";

					$emailService = new EmailService();
					$toEmail = 'imports@toplogistics.com.au';
					$ccEmail = "christy.yu@toplogistics.com.au;cc01@toplogistics.com.au;cc02@toplogistics.com.au";//"importscs@toplogistics.com.au;michelle@toplogistics.com.au;frank.liu@toplogistics.com.au;david.ren@toplogistics.com.au;";
					$body .= "<h1>Record Detail</h1><table><tr><th>HBN</th><th>Memo</th><th>Record Time</th></tr>".$str1."</table>";
					$subject = date("Y-m-d")." ".$titles[$i++]." Report";
					$emailService->sendNormalEmail($toEmail,$subject,$body,$ccEmail);
					echo "Done";
				}
			}
					
		}
		$this->funcDoMQ('funcSendCustompdfEmail','funcSendCustompdfEmail');

	}


	public function sendCustomhtmlEmail()
	{
		function funcSendCustomhtmlEmail()
		{
			$doNotMovereportCache = ReportCache::model()->find('create_time = :today and type=:type and status=1',[':today'=>date('Y-m-d')." 00:00:00",":type"=>ReportCache::CustomAttHtmlMailTotalByDaily]);
			$str1 = "";
			if (!empty($doNotMovereportCache)) {
				$total = $doNotMovereportCache->mdata['total'];
				$dnmShipments = $doNotMovereportCache->mdata['shipments'];

				foreach ($dnmShipments as $key => $shipment)
				{
					$str1.="<tr>";
					$str1.="<td>&nbsp;&nbsp;&nbsp;".$shipment['hbn']."&nbsp;&nbsp;&nbsp;</td>";
					$str1.="<td>&nbsp;&nbsp;&nbsp;".$shipment['can']."&nbsp;&nbsp;&nbsp;</td>";
					$str1.="<td>&nbsp;&nbsp;&nbsp;".$shipment['key']."&nbsp;&nbsp;&nbsp;</td>";
					$str1.="<td>&nbsp;&nbsp;&nbsp;".date('H:i:s ',strtotime($shipment['time']))."&nbsp;&nbsp;&nbsp;</td>";
					$str1.="</tr>";
				}

				$body = "<h1>".date('Y-m-d')."Mutil Direction Total Shipments:".$total."</h1>";

				$emailService = new EmailService();
				$toEmail = 'imports@toplogistics.com.au';
				$ccEmail = "christy.yu@toplogistics.com.au;cc01@toplogistics.com.au;cc02@toplogistics.com.au";//"importscs@toplogistics.com.au;michelle@toplogistics.com.au;frank.liu@toplogistics.com.au;david.ren@toplogistics.com.au;";
				$body .= "<h1>Record Detail</h1><table><tr><th>HBN</th><th>Memo</th><th>Key Word</th><th>Record Time</th></tr>".$str1."</table>";
				$subject = date("Y-m-d")." Multi Direction Report";
				$emailService->sendNormalEmail($toEmail,$subject,$body,$ccEmail);
				echo "Done";
			}
		}
		$this->funcDoMQ('funcSendCustomhtmlEmail','funcSendCustomhtmlEmail');
	}

	public function cleanCustomProcessBorders()
	{
		function funcCleanCustomProcessBorders()
		{
			$shipmentProcesses = ShipmentProcess::model()->with("shipment")->findAll(" t.status = :status1 and (shipment.status >= :status2  and shipment.status!=98)
			and (shipment.bwf = 16 or shipment.bwf = 1040 or shipment.bwf=80 or shipment.bwf=144 or shipment.bwf=1104 or shipment.bwf=1168) and DATE_SUB(CURRENT_DATE(), INTERVAL 3 DAY)",[":status1"=>ShipmentProcess::MSG_NEW,":status2"=>ImParcel::STATE_CLEAR]);

			$transaction = Yii::app()->db->beginTransaction();
			try {
				foreach ($shipmentProcesses as $key => $value) {
					$value->status = ShipmentProcess::CUSTOM_DONE;
					$value->update(['status']);
				}
				$transaction->commit();
			}catch (Exception $ex) {
				$transaction->rollback();
				throw $ex;
			}
		}
		$this->funcDoMQ('funcCleanCustomProcessBorders','funcCleanCustomProcessBorders');
	}

	public function sendLateHeldList()
	{
		$service = new Service();
		$cacheData = $service->getCacheData("lateHeldList");
		if(empty($cacheData)) return;
		$sendResult = [];
		foreach ($cacheData as $key => $value)
		{
			if((strtotime(date("Y-m-d H:i:s"))-strtotime($value[2]))>10800)
			{
				if(empty($sendResult[$value[1]]))
				{
					$sendResult[$value[1]] = [$value[0]];
				}else
				{
					$sendResult[$value[1]][] = $value[0];
				}
				unset($cacheData[$key]);
			}
		}

		foreach ($sendResult as $key => $value) {
			Emailog::sendEmailTo('imports@toplogistics.com.au', join(",",$value),"TLA internally late held warning letter".$key);
		}

		$service->setCacheData("lateHeldList",$cacheData,86400);

	}

	public function sendConfirmedShipmentAQISEmail()
	{
		$shipmentProcesses = ShipmentProcess::model()->findAll("status = :status and (type &2)>0",[":status"=>ShipmentProcess::DOC_CONFIRMED]);
		foreach ($shipmentProcesses as $key => $process)
		{
			$o = ShipmentProcess::sendAqisToCustom($process->shipment);
			if ($o['status']) {
				echo 'done';
			} else {
				echo $o['msg'];
			}
		}
	}

	public function generateLoginLog()
	{
		function funcGenerateLoginLog()
		{
			$service = new Service();
			$loginUsers = $service->getCacheData("LoginUsers");
			if(!empty($loginUsers))
			{
				foreach ($loginUsers as $userId => $time) {
					$userLastActionTime = $service->getCacheData($userId."lastAction");
					if(empty($userLastActionTime))
					{
						unset($loginUsers[$userId]);
						$service->setCacheData("LoginUsers",$loginUsers);
					}else
					{
						$lastLoginLog = TlaLog::model()->find(["condition"=>"lid=:lid and model = 'User' and type in(1,255) ","params"=>[":lid"=>$userId],"order"=>"id desc"]);
						if(empty($lastLoginLog)||$lastLoginLog->type==255)
						{
							$log = new TlaLog;
							$log->attributes = array(
								'type' => 1,
								'model' => "User",
								'lid' => $userId,
							);
							if(!empty($extra)){
								$log->extra = $extra;
							}
							$log->user_id = $userId;
							$log->time = date("Y-m-d H:i:s",$time);
							$log->save();
						}else
						{
							if(!empty($userLastActionTime["action"]))
							{
								echo $userLastActionTime["action"]."|".$userId;
							}

							if((time()-$userLastActionTime["time"])>600)
							{
								$log = new TlaLog;
								$log->attributes = array(
									'type' => 255,
									'model' => "User",
									'lid' => $userId,
								);
								if(!empty($extra)){
									$log->extra = $extra;
								}
								$log->user_id = $userId;
								$log->time = date("Y-m-d H:i:s");
								$log->save();
								unset($loginUsers[$userId]);
								$service->setCacheData("LoginUsers",$loginUsers);
							}
						}
					}
				}
			}
		}
		$this->funcDoMQ('funcGenerateLoginLog','funcGenerateLoginLog',100);

	}

	public function fixSiReconcile()
	{
		function funcFixSiReconcile()
		{
			$reconcileService = new ReconcileService();
			$reconcileService->appName = 'TLA';
			Yii::app()->name = 'TLA';
			$siReconciles = SiReconcile::model()->find('json_value(meta,"$.command_run")=1');
			if(!empty($siReconciles))
			{
				foreach ([$siReconciles] as $key => $siReconcile)
				{
					$supplierInvoice = $siReconcile->parent;
					$allSupplierInvoiceLines = $supplierInvoice->lines;
					if($supplierInvoice->org_id==Org::ORGID_COURIER_AUPOST)
					{
						set_time_limit(0);
						$reconcileService->saveAuspostSupplierInvoiceToSiReconcile($supplierInvoice,$allSupplierInvoiceLines,true);
					}elseif($supplierInvoice->mdata['template']=='TLD-supplier')
					{
						set_time_limit(0);
						$reconcileService->saveTLDSupplierInvoiceToSiReconcile($supplierInvoice,$allSupplierInvoiceLines,true);

					}else
					{
						$reconcileService->saveSupplierInvoiceToSiReconcile($supplierInvoice,$allSupplierInvoiceLines,true,true);
					}

					Emailog::sendEmailTo('finance@toplogistics.com.au', json_encode($siReconcile->parent->inv_no." is completed"),$siReconcile->parent->inv_no." is completed");
					break;
				}
			}
		}
		$this->funcDoMQ('funcFixSiReconcile','funcFixSiReconcile',7200);
	}

	public function saveTldReportDaily()
	{
		$depots = [106, 218, 530, 811];
		$from = date('Y-m-d 17:55:00', strtotime('-1 days'));
		$to = date('Y-m-d 17:55:00');
		$firstDayMonth = date('Y-m-01 00:00:00');
		$report = ReportCache::model()->findByAttributes(array('type' => ReportCache::TLD_REPORT, 'status' => ReportCache::Active));
		if(empty($report)) {
			$report = new ReportCache();
			$report->type = ReportCache::TLD_REPORT;
			$report->status = ReportCache::Active;
			$report->create_time = date('Y-m-d H:i:s');
			$report->creater = 1;
			$report->modifyer = 1;
		}
		$report->modify_time = date('Y-m-d H:i:s');
		foreach ($depots as $depot) {
			
			$temp = new stdClass;
			$temp->booking = new stdClass;
			$temp->pallet_request = new stdClass;
			$temp->price_enquiry = new stdClass;
			$temp->deconsolidation = new stdClass;

			/**
			 * Booking data
			 */
			$newBookings = CargoBooking::model()->count('create_date < :to AND create_date >= :from AND status != :status AND depot = :depot', array(':to' => $to, ':from' => $from, ':status' => CargoBooking::PRE_PENDING, ':depot' => $depot));
			$completeBookings = CargoBooking::model()->count('status IN (3, 4, 6) AND update_time < :to AND update_time >= :from AND depot = :depot', array(':to' => $to, ':from' => $from, ':depot' => $depot));
			$leftBookings = CargoBooking::model()->count('create_date < :from AND status = :status AND depot = :depot', array(':from' => $from, ':status' => CargoBooking::PENDING, ':depot' => $depot));
			$newBookingsMTD = CargoBooking::model()->count('create_date < :to AND create_date >= :firstDayMonth AND status != :status AND depot = :depot', array(':to' => $to, ':firstDayMonth' => $firstDayMonth, ':status' => CargoBooking::PRE_PENDING, ':depot' => $depot));
			$completeBookingsMTD = CargoBooking::model()->count('status IN (3, 4, 6) AND update_time < :to AND update_time >= :firstDayMonth AND depot = :depot', array(':to' => $to, ':firstDayMonth' => $firstDayMonth, ':depot' => $depot));
			$leftBookingsMTD = CargoBooking::model()->count('create_date < :firstDayMonth AND status = :status AND depot = :depot', array(':firstDayMonth' => $firstDayMonth, ':status' => CargoBooking::PENDING, ':depot' => $depot));
			$temp->booking->todayNew = $newBookings;
			$temp->booking->todayComplete = $completeBookings;
			$temp->booking->todayLeft = $leftBookings;
			$temp->booking->newMTD = $newBookingsMTD;
			$temp->booking->completeMTD = $completeBookingsMTD;
			$temp->booking->leftMTD = $leftBookingsMTD;

			/**
			 * Pallet Request
			 */
			$newToday = CargoProcessPlan::model()->count('create_time >= :from AND create_time < :to AND dpt_id = :depot AND status IN (20, 30)', array(':from' => $from, ':to' => $to, ':depot' => $depot));
			$completeToday = CargoProcessPlan::model()->count('modify_time >= :from AND modify_time < :to AND dpt_id = :depot AND status = 30', array(':from' => $from, ':to' => $to, ':depot' => $depot));
			$leftToday = CargoProcessPlan::model()->count('create_time < :from AND dpt_id = :depot AND status = 20', array(':from' => $from, ':depot' => $depot));
			$newMTD = CargoProcessPlan::model()->count('create_time >= :firstDayMonth AND create_time < :to AND dpt_id = :depot AND status IN (20, 30)', array(':firstDayMonth' => $firstDayMonth, ':to' => $to, ':depot' => $depot));
			$completeMTD = CargoProcessPlan::model()->count('modify_time >= :firstDayMonth AND modify_time < :to AND dpt_id = :depot AND status = 30', array(':firstDayMonth' => $firstDayMonth, ':to' => $to, ':depot' => $depot));
			$leftMTD = CargoProcessPlan::model()->count('create_time < :firstDayMonth AND dpt_id = :depot AND status = 20', array(':firstDayMonth' => $firstDayMonth, ':depot' => $depot));
			$temp->pallet_request->todayNew = $newToday;
			$temp->pallet_request->todayComplete = $completeToday;
			$temp->pallet_request->todayLeft = $leftToday;
			$temp->pallet_request->newMTD = $newMTD;
			$temp->pallet_request->completeMTD = $completeMTD;
			$temp->pallet_request->leftMTD = $leftMTD;
			/**
			 * Price Enquiry
			 */
			$priceEnquiryDepot = PriceEnquiry::listDepotIdToDepotName[$depot];
			$newPriceEnquiry = PriceEnquiry::model()->count('`date` >= :from AND `date` < :to AND depot = :depot AND `status` != :status', array(':from' => $from, ':to' => $to, ':depot' => $priceEnquiryDepot, ':status' => PriceEnquiry::status_canceled));
			$completePriceEnquiry = PriceEnquiry::model()->count('update_time >= :from AND update_time < :to AND depot = :depot AND `status` IN (20, 25, 30)', array(':from' => $from, ':to' => $to, ':depot' => $priceEnquiryDepot));
			$leftPriceEnquiry = PriceEnquiry::model()->count('`date` < :from AND depot = :depot AND `status` = 10', array(':from' => $from, ':depot' => $priceEnquiryDepot));
			$newPriceEnquiryMTD = PriceEnquiry::model()->count('`date` >= :firstDayMonth AND `date` < :to AND depot = :depot AND `status` != :status', array(':firstDayMonth' => $firstDayMonth, ':to' => $to, ':depot' => $priceEnquiryDepot, ':status' => PriceEnquiry::status_canceled));
			$completePriceEnquiryMTD = PriceEnquiry::model()->count('update_time >= :firstDayMonth AND update_time < :to AND depot = :depot AND `status` IN (20, 25, 30)', array(':firstDayMonth' => $firstDayMonth, ':to' => $to, ':depot' => $priceEnquiryDepot));
			$leftPriceEnquiryMTD = PriceEnquiry::model()->count('`date` < :firstDayMonth AND depot = :depot AND `status` = 10', array(':firstDayMonth' => $firstDayMonth, ':depot' => $priceEnquiryDepot));
			$temp->price_enquiry->todayNew = $newPriceEnquiry;
			$temp->price_enquiry->todayComplete = $completePriceEnquiry;
			$temp->price_enquiry->todayLeft = $leftPriceEnquiry;
			$temp->price_enquiry->newMTD = $newPriceEnquiryMTD;
			$temp->price_enquiry->completeMTD = $completePriceEnquiryMTD;
			$temp->price_enquiry->leftMTD = $leftPriceEnquiryMTD;

			/**
			 * Deconsolidation
			 */
			$newDeconsolidation = Deconsolidation::model()->count("create_time >= :from AND create_time < :to AND `status` IN (1, 2, 5) AND depot = :depot", array(':from' => $from, ':to' => $to, ':depot' => $depot));
			$completeDeconsolidation = Deconsolidation::model()->count("task_complete_time >= :from AND task_complete_time < :to AND `status` IN (99, 101) AND depot = :depot AND task_complete_time <= due_time", array(':from' => $from, ':to' => $to, ':depot' => $depot));
			$leftDeconsolidation = Deconsolidation::model()->count("create_time < :from AND `status` IN (1, 2, 5) AND depot = :depot", array(':from' => $from, ':depot' => $depot));
			$newDeconsolidationMTD = Deconsolidation::model()->count("create_time >= :firstDayThisMonth AND create_time < :to AND `status` IN (1, 2, 5) AND depot = :depot", array(':firstDayThisMonth' => $firstDayMonth, ':to' => $to, ':depot' => $depot));
			$completeDeconsolidationMTD = Deconsolidation::model()->count("task_complete_time >= :firstDayThisMonth AND task_complete_time < :to AND `status` IN (99, 101) AND depot = :depot AND task_complete_time <= due_time", array(':firstDayThisMonth' => $firstDayMonth, ':to' => $to, ':depot' => $depot));
			$leftDeconsolidationMTD = Deconsolidation::model()->count("create_time < :firstDayThisMonth AND `status` IN (1, 2, 5) AND depot = :depot", array(':firstDayThisMonth' => $firstDayMonth, ':depot' => $depot));
			$temp->deconsolidation->todayNew = $newDeconsolidation;
			$temp->deconsolidation->todayComplete = $completeDeconsolidation;
			$temp->deconsolidation->todayLeft = $leftDeconsolidation;
			$temp->deconsolidation->newMTD = $newDeconsolidationMTD;
			$temp->deconsolidation->completeMTD = $completeDeconsolidationMTD;
			$temp->deconsolidation->leftMTD = $leftDeconsolidationMTD;

			$report->mdata[$depot] = $temp;
		}
		$report->save();
	}
}
