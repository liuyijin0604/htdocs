	public function shipmentLogFix()
	{
		$relations = ImportsShipmentRelations::model()->with("original","original.consol","sub_shipment")->findAll("consol.id is not null and consol.status!=100 and original.status <=70  and sub_shipment.status=42 and is_changed_log=0 ");

		// $relations = ImportsShipmentRelations::model()->with("original")->findAll("original.id = 39423630");
		foreach($relations as $k1 => $rel)
		{
			$p = $rel->original;
			if(empty($p->consol->eta)) continue;
			if((strtotime("+ 1 day", strtotime($p->consol->eta))<=strtotime(date("Y-m-d")))==false)
			{
				continue;
			}

			if($p->consol->service==ImcoConsol::AIRCONSOL)
			{
				$fromDate = date("Y-m-d",strtotime("+ 1 day",strtotime($p->created)));
				$toDate = date("Y-m-d",strtotime("+ 1 day",strtotime($p->consol->eta)));
				if(strtotime($fromDate)>strtotime($toDate))
				{
					$fromDate = $p->consol->eta;
				}

			}elseif($p->consol->service==ImcoConsol::SEACONSOL)
			{
				$fromDate = date("Y-m-d",strtotime("+ 10 day",strtotime($p->created)));
				$toDate = date("Y-m-d",strtotime("+ 2 day",strtotime($p->consol->eta)));
				if(strtotime($fromDate)>strtotime($toDate))
				{
					$fromDate = $p->consol->eta;
				}
			}
			if(strtotime($fromDate)>strtotime($toDate))
			{
				continue;
			}

			$datesArr = HolidayHelper::getDatesBetweenTwoDays($fromDate,$toDate);
			if(empty($datesArr)) continue;
			$index = rand(0,count($datesArr)-1);
			print_r($datesArr);
			$newLogDate = $datesArr[$index];
			$rel->sub_shipment->nolog = true;
			$rel->sub_shipment->created = $newLogDate;
			$rel->sub_shipment->update(['created']);
			$createTime = "";
			foreach ($rel->sub_shipment->logs as $k2 => $log)
			{
				$dtArr = explode(" ", $log->time);
				$logDate = $dtArr[0];

				if($log->type==3)
				{
					if(strToTime($logDate)<strtotime($newLogDate))
					{
						$otime = $log->time;
						$log->time = $newLogDate." ".rand(10,20).":".rand(10,59).":".rand(10,59);
						ChangedLog::add($log->id,"log",$otime,$log->time);
						$log->update('time');
					}
					$createTime = $log->time;
					echo $createTime.":c";
				}else
				{
					if(strToTime($logDate)<strtotime($newLogDate))
					{
						$otime = $log->time;
						$log->time = $newLogDate." ".rand(20,22).":".rand(10,59).":".rand(10,59);
						ChangedLog::add($log->id,"log",$otime,$log->time);
						echo $log->time.":l";
						$log->update('time');
					}
				}
			}

			foreach ($rel->sub_shipment->tracks as $k2 => $track)
			{
				$dtArr = explode(" ", $track->dt);
				$logDate = $dtArr[0];
				if($track->type==10)
				{
					$otime = $track->dt;
					$track->dt = $createTime;
					$track->update('dt');
					ChangedLog::add($track->id,"tracking",$otime,$track->dt);
				}else
				{
					if(strToTime($logDate)<strtotime($newLogDate))
					{
						$otime = $track->dt;
						$track->dt = $newLogDate." ".rand(10,22).":".rand(10,59).":".rand(10,59);
						$track->update('dt');
						echo $track->dt.":t";
						ChangedLog::add($track->id,"tracking",$otime,$track->dt);
					}
				}
				
			}

			$rel->is_changed_log = 1;
			$rel->update(['is_changed_log']);
		}

	}

	public function handlingAQISDonotMove()
	{
		$shipmentProcesses=ShipmentProcess::model()->findAll("status =:status",[":status"=>ShipmentProcess::STATE_AQIS_DONOT_MOVE]);
		foreach($shipmentProcesses as $key =>$shipmentProcess)
		{
			if(!empty($shipmentProcess->mdata['donot_move_due_date'])&&(strtotime($shipmentProcess->mdata['donot_move_due_date'])<=strtotime(date("Y-m-d"))))
			{
				$shipmentProcess->status = ShipmentProcess::STATE_CONFIRM_INS;
				$shipmentProcess->mdata['customer_confirm'] = "Inspection";
				$shipmentProcess->mdata['customer_confirm_date'] = date("Y-m-d H:i:s");
				$shipmentProcess->custom_log_note="Due Date Auto Push AQIS Status:Inspection";
				$shipmentProcess->update(['status','meta']);
				$shipmentProcess->shipment->bwf  = $shipment->bwf|ImParcel::INSCODE;
				$shipmentProcess->shipment->update('bwf');
				echo $shipmentProcess->shipment->ref."push";
			}else
			{
				if(!empty($shipmentProcess->mdata['lastEmailId']))
				{
					$files = [];
					$tfiles = FileRepo::model()->findAll('status = 30 and fid = :fid ',["fid" => $shipmentProcess->pid]);
	                foreach ($tfiles as $key => $value) {
	                    $files[] = [$value->getFile(),$value->name];
	                }
					$emailog = Emailog::model()->findByPk($shipmentProcess->mdata['lastEmailId']);
					$emailog->sendEmail($files);
					echo $shipmentProcess->shipment->ref."resend1";
				}else
				{
					$customsProcessService = new CustomsProcessService();
					$model = $customsProcessService->getAqisEmail($shipmentProcess->pid,"aqis_do_not_move");
					$_POST['extra']['from'] = empty($model->mdata['from'])? '' : $model->mdata['from'];
					$_POST['extra']['to'] = empty($model->mdata['to'])? '' : $model->mdata['to'];
					$_POST['extra']['cc'] = empty($model->mdata['cc'])? '' : $model->mdata['cc'];
					$_POST['Emailog']['subject'] = $model->subject;
					$_POST['Emailog']['body'] = $model->body;
					$customsProcessService->sendAQISEmail($shipmentProcess->pid,$_POST,"aqis_do_not_move","AQIS Do Not Move");
					echo $shipmentProcess->shipment->ref."resend1";
				}
			}
		}

		$shipmentProcesses=ShipmentProcess::model()->findAll("status in (".ShipmentProcess::STATE_CONFIRM_DIS.")");
		foreach($shipmentProcesses as $key =>$shipmentProcess)
		{
			if(!empty($shipmentProcess->mdata['request_for_inv_date'])&&(strtotime(date("Y-m-d"))>=strtotime("+2 day",strtotime($shipmentProcess->mdata['request_for_inv_date']))))
			{
				if(!empty($shipmentProcess->mdata['lastConfirmEmailId']))
				{
					$files = [];
					$tfiles = FileRepo::model()->findAll('status = 30 and fid = :fid ',["fid" => $shipmentProcess->pid]);
	                foreach ($tfiles as $key => $value) {
	                    $files[] = [$value->getFile(),$value->name];
	                }
					$emailog = Emailog::model()->findByPk($shipmentProcess->mdata['lastConfirmEmailId']);
					$emailog->sendEmail($files);
					echo $shipmentProcess->shipment->ref."resend1";
					$shipmentProcess->mdata['request_for_inv_date'] = date('Y-m-d');
                    $shipmentProcess->update(['meta']);
				}
			}
		}


	}


	public function handlingAQISConfirmIns()
	{

		$shipmentProcesses=ShipmentProcess::model()->findAll("status in (".ShipmentProcess::STATE_CONFIRM_INS.")");
		foreach($shipmentProcesses as $key =>$shipmentProcess)
		{
			if(!empty($shipmentProcess->mdata['request_for_inv_date']))
			{
				if(!empty($shipmentProcess->mdata['lastConfirmEmailId'])&&(strtotime(date("Y-m-d"))>=strtotime("+2 day",strtotime($shipmentProcess->mdata['request_for_inv_date']))))
				{
					$files = [];
					$tfiles = FileRepo::model()->findAll('status = 30 and fid = :fid ',["fid" => $shipmentProcess->pid]);
	                foreach ($tfiles as $key => $value) {
	                    $files[] = [$value->getFile(),$value->name];
	                }
					$emailog = Emailog::model()->findByPk($shipmentProcess->mdata['lastConfirmEmailId']);
					$emailog->sendEmail($files);
					echo $shipmentProcess->shipment->ref."resend1";
					$shipmentProcess->mdata['request_for_inv_date'] = date('Y-m-d');
                    $shipmentProcess->update(['meta']);
				}
			}else
			{
				$customsProcessService = new CustomsProcessService();
				$model = $customsProcessService->getAqisEmail($shipmentProcess->pid,"request_for_invoice");
				$_POST['extra']['from'] = empty($model->mdata['from'])? '' : $model->mdata['from'];
				$_POST['extra']['to'] = 'sacncc@agriculture.gov.au';
				$_POST['extra']['cc'] = empty($model->mdata['cc'])? '' : $model->mdata['cc'];
				$_POST['Emailog']['subject'] = $model->subject;
				$_POST['Emailog']['body'] = $model->body;
				$customsProcessService->sendAQISEmail($shipmentProcess->pid,$_POST,"request_for_invoice","Request For Invoice");
				echo $shipmentProcess->shipment->ref."resend1";
			}
		}

	}


	public function saveAllSurplus()
	{
		$allis = ImportsUnknownShipment::model()->findAll("type = 1 and status !=100 and status !=80 and sent_surplus_outturn>=1");
		$transaction = Yii::app()->db->beginTransaction();
		try {
			foreach ($allis as $key => $value)
			{
				if(!empty($value->sent_surplus_outturn)&&$value->status==ImportsUnknownShipment::NEWSTATUS)
				{
					$value->status = ImportsUnknownShipment::PROCESSING;
				}

				if(!empty($value->shipment_id)&&$value->shipment->getOutPkg()>0&&$value->status!=ImportsUnknownShipment::PROCESSDONE)
				{
					$value->status = ImportsUnknownShipment::PROCESSDONE;
				}

				if($value->shipment_id>0&&$value->shipment->consol_id!=$value->consol_id&&$value->consol_id>0&&$value->shipment->consol_id)
				{
					$value->shipment->consol_id = $value->consol_id;
					$value->shipment->update(['consol_id']);
				}

				$value->save();
			}
			$transaction->commit();
		}catch (Exception $ex) {
			$transaction->rollback();
			throw $ex;
		}
	}


	public function GVShipmentSendSurplusOutturn()// and copy shipment and resend ACR and send surplus outturn
	{
		$consolIds = [];
		$today = date("Y-m-d 23:59:50");
		$sql = "select distinct(consol_id) as id from imports_unknown_shipment where consol_id !=0 and type = 1 and create_time<='{$today}' and sent_surplus_outturn = 0  and status!=100 and status!=80 and dpt_id=530 and (barcode like 'WQF%' or barcode like '33G7M%' or barcode like '34KHY%' )";
		$data = Yii::app()->db->createCommand($sql)->queryAll();
		foreach ($data as $key => $value) {
			$cn = ImcoConsol::model()->findByPk($value['id']);
			if(empty($cn)) continue;
			$pp = ImParcel::model()->find("consol_id=:cid and status = 60",[":cid"=>$cn->id]);
			if(!in_array($pp->agent_id,[Org::ORGID_CLIENT_GLOBAVEND,Org::ORGID_COURIER_UBI_CLIENT,Org::ORGID_CLIENT_EWE_ITEM,Org::ORGID_CLIENT_EWE_KG,Org::ORGID_CLIENT_EWE_GROUP])) continue;
			$icsService = new IcsService();
			$hasLetter=false;
			$errors = $icsService->airoutSurplus($cn->id,null,$hasLetter,true);
			$icsService->cusout($cn->id);
		}


		$today = date("Y-m-d 23:59:50");
		$notBelongShipments = ImportsUnknownShipment::model()->findAll("consol_id !=0 and type = 1 and create_time<='{$today}' and shipment_id = 0 and exist_shipment_id!=0 and status!=100  and dpt_id=530");
		foreach ($notBelongShipments as $key => $notBelongShipment) {
			if(!preg_match("/^(WQF|33G7M|34KHY)/",$notBelongShipment->barcode)) continue;

			$pp= ImParcel::model()->findByPk($notBelongShipment->exist_shipment_id);
			if(!in_array($pp->agent_id,[Org::ORGID_CLIENT_GLOBAVEND,Org::ORGID_COURIER_UBI_CLIENT,Org::ORGID_CLIENT_EWE_ITEM,Org::ORGID_CLIENT_EWE_KG,Org::ORGID_CLIENT_EWE_GROUP])) continue;
			$newShipment = ImParcelService::copyNotBelongShipment($pp,$notBelongShipment->consol_id);
			if(!empty($newShipment))
			{
				Yii::import('application.controllers.ImParcelController');
				$cc = new ImParcelController('default');
		 		$cc->actionResendACR($newShipment->id);
			}
		}

		$today = date("Y-m-d 23:59:50");
		$newShipments = ImportsUnknownShipment::model()->with('shipment')->findAll("t.consol_id !=0 and t.type = 1 and t.create_time<='{$today}' and shipment_id != 0 and t.status!=100 and shipment.status=10  and dpt_id=530");
		foreach ($newShipments as $key => $newShipment) {
			if(!preg_match("/^(WQF|33G7M|34KHY)/",$newShipment->barcode)) continue;

			$newShipment->shipment->consol_id = $newShipment->consol_id;
			$newShipment->shipment->status=ImParcel::STATE_REPORTED;
			$newShipment->shipment->update(['status','consol_id']);
			if(!empty($newShipment))
			{
				Yii::import('application.controllers.ImParcelController');
				$cc = new ImParcelController('default');
		 		$cc->actionResendACR($newShipment->shipment->id);
			}
		}
	}

	public function daipostShipmentSendSurplusOutturn()// and copy shipment and resend ACR and send surplus outturn
	{
		$consolIds = [];
		$today = date("Y-m-d 23:59:50");
		$sql = "select distinct(consol_id) as id from imports_unknown_shipment where consol_id !=0 and type = 1 and create_time<='{$today}' and sent_surplus_outturn = 0  and status!=100 and status!=80 and (barcode like '0039%' or barcode like 'M%' or barcode like '33Y%' or barcode like '33Y%')";
		$data = Yii::app()->db->createCommand($sql)->queryAll();
		foreach ($data as $key => $value) {
			$cn = ImcoConsol::model()->findByPk($value['id']);
			if(empty($cn)) continue;
			$icsService = new IcsService();
			$hasLetter=false;
			$errors = $icsService->airoutSurplus($cn->id,null,$hasLetter);
			$icsService->cusout($cn->id);
		}


		$today = date("Y-m-d 23:59:50");
		$notBelongShipments = ImportsUnknownShipment::model()->findAll("consol_id !=0 and type = 1 and create_time<='{$today}' and shipment_id = 0 and exist_shipment_id!=0 and status!=100");
		foreach ($notBelongShipments as $key => $notBelongShipment) {
			if(!preg_match("/^(0039|M|33Y|0019)/",$notBelongShipment->barcode)) continue;

			$pp= ImParcel::model()->findByPk($notBelongShipment->exist_shipment_id);
			if($pp->agent_id!=Org::ORGID_CLIENT_DAIPOST) continue;
			$newShipment = ImParcelService::copyNotBelongShipment($pp,$notBelongShipment->consol_id);
			if(!empty($newShipment))
			{
				Yii::import('application.controllers.ImParcelController');
				$cc = new ImParcelController('default');
		 		$cc->actionResendACR($newShipment->id);
			}
		}

		$today = date("Y-m-d 23:59:50");
		$newShipments = ImportsUnknownShipment::model()->with('shipment')->findAll("t.consol_id !=0 and t.type = 1 and t.create_time<='{$today}' and shipment_id != 0 and t.status!=100 and shipment.status=10");
		foreach ($newShipments as $key => $newShipment) {
			if(!preg_match("/^(0039|M|33Y|0019)/",$newShipment->barcode)) continue;

			$newShipment->shipment->consol_id = $newShipment->consol_id;
			$newShipment->shipment->status=ImParcel::STATE_REPORTED;
			$newShipment->shipment->update(['status','consol_id']);
			if(!empty($newShipment))
			{
				Yii::import('application.controllers.ImParcelController');
				$cc = new ImParcelController('default');
		 		$cc->actionResendACR($newShipment->shipment->id);
			}
		}
	}

	public function daipostShipmentResendOutturn()// and copy shipment and resend ACR and send surplus outturn
	{

		$from = date("Y-m-d 00:00:00");
		$to = date("Y-m-d 23:59:50");

		$this->daipostShipmentSendSurplusOutturn();
		$sql = "select id from consol where id in (select distinct(consol_id) from shipment_scan ss join shipment s on ss.pid =s.id where ss.type=0 and scan_time >'{$from}' and scan_time<'{$to}')  and service = 10 and eta>'2023-07-01'";
		$data = Yii::app()->db->createCommand($sql)->queryAll();
		foreach ($data as $key => $value) {
			$cn = ImcoConsol::model()->findByPk($value['id']);
			if(empty($cn)) continue;
			$icsService = new IcsService();
			$hasLetter=false;
			$errors = $icsService->airout($cn->id,null,$hasLetter);
		}
	}

	public function generateAllInvLineWithRebateToBeRebateInvLine()
	{
		function funcGenerateAllInvLineWithRebateToBeRebateInvLine()
		{
			Yii::app()->name = "TLA";
			$invLines = InvLine::model()->findAll("rebate = 1  and json_value(meta,'$.isGenRebate') is null");
			foreach ($invLines as $key => $invLine) {
				$invLineRebate = new InvLineRebate();
				$invLineRebate->inv_id = $invLine->inv_id;
				$invLineRebate->model = $invLine->model;
				$invLineRebate->fid = $invLine->fid;
				$invLineRebate->ccode = $invLine->ccode;
				$invLineRebate->amount = number_format($invLine->amount,3,'.','');
				$invLineRebate->gst = number_format($invLine->gst,3,'.','');
				$invLineRebate->det = $invLine->det;
				$invLineRebate->qty = $invLine->qty;
				$invLineRebate->tax = $invLine->tax;
				$invLineRebate->rebate = $invLine->rebate;
				if(!empty($invLine->mdata['items']))
				{
					$thisItems = [];
					$newAmount = 0;
					$newGst = 0;
					foreach ($invLine->mdata['items'] as $k2 => $item)
					{
						$thisItemRebate = false;
						if(!empty($item['rebate']))
						{
							$thisItems[] = $item;
							$newAmount+= $item[5];
						}
					}

					$invLineRebate->mdata['items'] = $thisItems;
					if($invLine->gst>0)
					{
						$newGst = number_format($newAmount*0.1,2,'.','');
					}

					$invLineRebate->amount = number_format($newAmount,3,'.','');
					$invLineRebate->gst = $newGst;
				}
				$invLine->mdata['isGenRebate'] = 1;
				if($invLineRebate->save())
				{
					$invLine->save();
				}else
				{
					print_r($invLineRebate);
				}
			}
		}
		$this->funcDoMQ('funcGenerateAllInvLineWithRebateToBeRebateInvLine','funcGenerateAllInvLineWithRebateToBeRebateInvLine');
	}

