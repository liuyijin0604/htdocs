	public function getWhscanDetailReport(){
		 function funGetWhscanDetailReport(){		 	
            $timestamp = time();
            $date = date('Y-m-d H:i:s', $timestamp);
		 	$date = date('Y-m-d', strtotime($date . ' -1 day'));
			$serviceAir = new WarehouseProcessService();
			$serviceAir->getWhscanDetailReport($date, $date, 0, false, Consol::AIRCONSOL, 1);
			$serviceSea = new WarehouseProcessService();
			$serviceSea->getWhscanDetailReport($date, $date, 0, false, Consol::SEACONSOL, 1);
		}
		funGetWhscanDetailReport();
	}

	public function getWhscanDetailReport1()
	{
		$serviceAir = new WarehouseProcessService();
		$serviceSea = new WarehouseProcessService();
		$startDate = $this->prompt('Start');
		$endDate = $this->prompt('End');
		$currentDate = $startDate;
		while (strtotime($currentDate) <= strtotime($endDate)) {
		$serviceAir->getWhscanDetailReport1($currentDate,$currentDate, 0, false, Consol::AIRCONSOL, 1);		     
		$serviceSea->getWhscanDetailReport1($currentDate, $currentDate, 0, false, Consol::SEACONSOL, 1);		    
		$currentDate = date("Y-m-d", strtotime($currentDate . " +1 day"));
		}
	}

