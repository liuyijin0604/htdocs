<script type="text/javascript">
$(function(){
	var tab = $('#<?=$_GET["tabid"];?>');
	var pane = tab.data('panel');
	$($('.item_qty', pane).get(0)).trigger('change');

    $('.ajax_link', pane).on('success', function(e, r) {
        if (r.done) {
            myApp.notice(r.msg, 5000);
        } else {
            myApp.alert(r.msg, false);
        }
    });
});
</script>