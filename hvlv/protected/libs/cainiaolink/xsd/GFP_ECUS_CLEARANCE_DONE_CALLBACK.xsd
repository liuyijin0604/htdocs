<xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:element name="request">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="orderCode" type="xs:string" minOccurs="1" />
                <xs:element name="operateTime" type="xs:string" minOccurs="1" />
                <xs:element name="operateTimezone" type="xs:string" minOccurs="1" />
                <xs:element name="operator" type="xs:string" minOccurs="0" />
                <xs:element name="country" type="xs:string" minOccurs="0" />
                <xs:element name="state" type="xs:string" minOccurs="0" />
                <xs:element name="city" type="xs:string" minOccurs="0" />
                <xs:element name="address" type="xs:string" minOccurs="0" />
                <xs:element name="hscodeNum" type="xs:unsignedInt" minOccurs="1" />
                <xs:element name="remark" minOccurs="0">
                    <xs:simpleType>
                        <xs:restriction base="xs:string">
                            <xs:maxLength value="256" />
                        </xs:restriction>
                    </xs:simpleType>
                </xs:element>
                <xs:element name="cargoValue" type="xs:decimal" minOccurs="1" />
                <xs:element name="currency" type="xs:string" minOccurs="1" />
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>